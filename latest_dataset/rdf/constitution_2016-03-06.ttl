<https://legal.dz/resource/law/2016-03-06/16-01#version_art_187> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخطر المجلس الدستوري رئيس الجمهورية أو رئيس مجلس الأمة أو رئيس المجلس الشعبي الوطني أو الوزير الأول . كما يمكن إخطاره من خمسين (50) نائبا أو ثلاثين (30) عضوا في مجلس الأمة . لا تمتد ممارسة الإخطار المبين في الفقرتين السابقتين إلى الإخطار بالدفع بعدم الدستورية المبين في المادة 188 أدناه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_187_20160307_OpEnact_7e5d428897> ;
    dzdoc:replacementText "يخطر المجلس الدستوري رئيس الجمهورية أو رئيس مجلس الأمة أو رئيس المجلس الشعبي الوطني أو الوزير الأول . كما يمكن إخطاره من خمسين (50) نائبا أو ثلاثين (30) عضوا في مجلس الأمة . لا تمتد ممارسة الإخطار المبين في الفقرتين السابقتين إلى الإخطار بالدفع بعدم الدستورية المبين في المادة 188 أدناه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
