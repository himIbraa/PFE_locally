<https://legal.dz/resource/law/2016-03-06/16-01#version_art_148> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن البرلمان أن يفتح مناقشة حول السياسة الخارجية بناء على طلب رئيس الجمهورية أو رئيس إحدى الغرفتين. يمكن أن تتوج هذه المناقشة، عند الاقتضاء، بإصدار البرلمان، المنعقد بغرفتيه المجتمعتين معا، لائحة يبلغها إلى رئيس الجمهورية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
