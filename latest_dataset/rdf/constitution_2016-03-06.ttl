<https://legal.dz/resource/law/2016-03-06/16-01#version_art_186> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "بالإضافة إلى الاختصاصات الأخرى التي خولتها إياه صراحة أحكام أخرى في الدستور ، يفصل المجلس الدستوري برأي في دستورية المعاهدات والقوانين والتنظيمات . يبدي المجلس الدستوري ، بعد أن يخطره رئيس الجمهورية ، رأيه وجوبا في دستورية القوانين العضوية بعد أن يصادق عليها البرلمان . كما يفصل المجلس الدستوري في مطابقة النظام الداخلي لكل من غرفتي البرلمان للدستور ، حسب الإجراءات المذكورة في الفقرة السابقة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_186_20160307_OpEnact_fe5fd085a4> ;
    dzdoc:replacementText "بالإضافة إلى الاختصاصات الأخرى التي خولتها إياه صراحة أحكام أخرى في الدستور ، يفصل المجلس الدستوري برأي في دستورية المعاهدات والقوانين والتنظيمات . يبدي المجلس الدستوري ، بعد أن يخطره رئيس الجمهورية ، رأيه وجوبا في دستورية القوانين العضوية بعد أن يصادق عليها البرلمان . كما يفصل المجلس الدستوري في مطابقة النظام الداخلي لكل من غرفتي البرلمان للدستور ، حسب الإجراءات المذكورة في الفقرة السابقة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_186> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
