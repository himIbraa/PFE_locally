<https://legal.dz/resource/law/2016-03-06/16-01#version_art_85> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينتخب رئيس الجمهورية عن طريق الاقتراع العام المباشر والسري. يتم الفوز في الانتخاب بالحصول على الأغلبية المطلقة من أصوات الناخبين المعبر عنها. ويحدد القانون العضوي الكيفيات الأخرى للانتخابات الرئاسية."@ar ;
