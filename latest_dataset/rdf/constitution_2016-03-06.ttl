<https://legal.dz/resource/law/2016-03-06/16-01#version_art_78> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل المواطنين متساوون في أداء الضريبة. ويجب على كل واحد أن يشارك في تمويل التكاليف العمومية، حسب قدرته الضريبية . لا يجوز أن تحدث أية ضريبة إلا بمقتضى القانون . ولا يجوز أن تحدث بأثر رجعي، أية ضريبة، أو جباية، أو رسم، أو أي حق كيفما كان نوعه. كل عمل يهدف إلى التحايل في المساواة بين المواطنين والأشخاص المعنويين في أداء الضريبة يعتبر مساسا بمصالح المجموعة الوطنية ويقمعه القانون. يعاقب القانون على التهرب الجبائي وتهريب رؤوس الأموال."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_78_20160307_OpEnact_a5a19558e0> ;
    dzdoc:replacementText "كل المواطنين متساوون في أداء الضريبة. ويجب على كل واحد أن يشارك في تمويل التكاليف العمومية، حسب قدرته الضريبية . لا يجوز أن تحدث أية ضريبة إلا بمقتضى القانون . ولا يجوز أن تحدث بأثر رجعي، أية ضريبة، أو جباية، أو رسم، أو أي حق كيفما كان نوعه. كل عمل يهدف إلى التحايل في المساواة بين المواطنين والأشخاص المعنويين في أداء الضريبة يعتبر مساسا بمصالح المجموعة الوطنية ويقمعه القانون. يعاقب القانون على التهرب الجبائي وتهريب رؤوس الأموال."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_78> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
