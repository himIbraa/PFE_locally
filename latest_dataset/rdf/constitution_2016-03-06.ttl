<https://legal.dz/resource/law/2016-03-06/16-01#version_art_113> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يراقب البرلمان عمل الحكومة وفقا للشروط المحددة في المواد 94 و 98 و 151 و 152 من الدستور. يمارس المجلس الشعبي الوطني الرقابة المنصوص عليها في المواد من 153 إلى 155 من الدستور."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
