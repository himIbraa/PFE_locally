    dzdoc:evidenceText "يمكن رئيس الجمهورية أن يقرر حل المجلس الشعبي الوطني، أو إجراء انتخابات تشريعية قبل أوانها ، بعد استشارة رئيس مجلس الأمة، ورئيس المجلس الشعبي الوطني، ورئيس المجلس الدستوري، والوزير الأول . وتجري هذه الانتخابات في كلتا الحالتين في أجل أقصاه ثلاثة (3) أشهر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_147_20160307_OpEnact_97d3d52343> ;
