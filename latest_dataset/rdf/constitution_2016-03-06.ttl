    dzdoc:eId "art_206" ;
    dzdoc:fullText "يحدث مجلس وطني للبحث العلمي والتكنولوجيا، يدعى في صلب النص ”المجلس”."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_206> ;
