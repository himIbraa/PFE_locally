<https://legal.dz/resource/law/2016-03-06/16-01#art_91> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الأول__السلطة_التنفيذية> ;
    dzdoc:eId "art_91" ;
    dzdoc:fullText "يضطلع رئيس الجمهورية ، بالإضافة إلى السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور ، بالسلطات والصلاحيات الآتية: 1 – هو القائد الأعلى للقوات المسلحة للجمهورية، 2 – يتولى مسؤولية الدفاع الوطني، 3 – يقرر السياسة الخارجية للأمة ويوجهها، 4 – يرأس مجلس الوزراء، 5 – يعين الوزير الأول بعد استشارة الأغلبية البرلمانية، وينهي مهامه، 6 – يوقع المراسيم الرئاسية، 7 – له حق إصدار العفو وحق تخفيض العقوبات أو استبدالها ، 8 – يمكنه أن يستشير الشعب في كل قضية ذات أهمية وطنية عن طريق الاستفتاء، 9 – يبرم المعاهدات الدولية ويصادق عليها، 10 – يسلم أوسمة الدولة ونياشينها وشهاداتها التشريفية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_91_right_0_0076b7ee> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_91> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_91_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_91_20160307_OpEnact_276c413d3e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 91" ;
    dzdoc:position 88 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2016-03-06/16-01#art_91_extref_47ad022e> ;
    dzdoc:usesTerm dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/law/2016-03-06/16-01#art_126> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_126" ;
    dzdoc:fullText "الحصانة البرلمانية معترف بها للنواب ولأعضاء مجلس الأمة مدة نيابتهم ومهمتهم البرلمانية . ولا يمكن أن يتابعوا أو يوقفوا . وعلى العموم لا يمكن أن ترفع عليهم أية دعوى مدنية أو جزائية أو يسلط عليهم أي ضغط بسبب ما عبروا عنه من آراء أو ما تلفظوا به من كلام، أو بسبب تصويتهم خلال ممارسة مهامهم البرلمانية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_126_permission_0_82c49e6b> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_126_right_0_4ee0ccde> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_126> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_126_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_126_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_126_20160307_OpEnact_0d20d981f6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_126_obligation_0_77a785d3>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_126_obligation_1_7d950591> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 126" ;
    dzdoc:position 122 ;
    dzdoc:usesTerm dzterm:parliamentary_immunity .

