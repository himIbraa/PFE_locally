<https://legal.dz/resource/law/2016-03-06/16-01#version_art_72> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحظى الأسرة بحماية الدولة والمجتمع . تحمي الأسرة والمجتمع والدولة حقوق الطفل . تكفل الدولة الأطفال المتخلى عنهم أو مجهولي النسب . يقمع القانون العنف ضد الأطفال . تعمل الدولة على تسهيل استفادة الفئات الضعيفة ذات الاحتياجات الخاصة من الحقوق المعترف بها لجميع المواطنين، وإدماجها في الحياة الاجتماعية . تحمي الأسرة والدولة الأشخاص المسنين . يحدد القانون شروط وكيفيات تطبيق هذه الأحكام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_72_20160307_OpEnact_558c53de54> ;
    dzdoc:replacementText "تحظى الأسرة بحماية الدولة والمجتمع . تحمي الأسرة والمجتمع والدولة حقوق الطفل . تكفل الدولة الأطفال المتخلى عنهم أو مجهولي النسب . يقمع القانون العنف ضد الأطفال . تعمل الدولة على تسهيل استفادة الفئات الضعيفة ذات الاحتياجات الخاصة من الحقوق المعترف بها لجميع المواطنين، وإدماجها في الحياة الاجتماعية . تحمي الأسرة والدولة الأشخاص المسنين . يحدد القانون شروط وكيفيات تطبيق هذه الأحكام."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_72> ;
