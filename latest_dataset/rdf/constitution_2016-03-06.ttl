<https://legal.dz/resource/law/2016-03-06/16-01#art_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الأول__السلطة_التنفيذية> ;
    dzdoc:eId "art_109" ;
    dzdoc:fullText "يعلن رئيس الجمهورية الحرب ، إذا وقع عدوان فعلي على البلاد أو يوشك أن يقع حسبما نصت عليه الترتيبات الملائمة لميثاق الأمم المتحدة ، بعد اجتماع مجلس الوزراء والاستماع إلى المجلس الأعلى للأمن واستشارة رئيس مجلس الأمة ورئيس المجلس الشعبي الوطني ورئيس المجلس الدستوري . ويجتمع البرلمان وجوبا . ويوجه رئيس الجمهورية خطابا للأمة يعلمها بذلك ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_109_right_0_8a74f45a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_109> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_109_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_109_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_109_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_109_20160307_OpEnact_da3a872a95> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_109_obligation_0_5a7e9308>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_109_obligation_1_c9ecb72c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 109" ;
    dzdoc:position 106 ;
    dzdoc:usesTerm dzterm:president,
        dzterm:war .

<https://legal.dz/resource/law/2016-03-06/16-01#art_152> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_152" ;
    dzdoc:fullText "يمكن أعضاء البرلمان أن يوجهوا أي سؤال شفوي أو كتابي إلى أي عضو في الحكومة . ويكون الجواب عن السؤال الكتابي كتابيا خلال أجل أقصاه ثلاثون (30) يوما . بالنسبة للأسئلة الشفوية، يجب ألا يتعدى أجل الجواب ثلاثين (30) يوما . يعقد كل من المجلس الشعبي الوطني و مجلس الأمة ، بالتداول، جلسة أسبوعية تخصص لأجوبة الحكومة على الأسئلة الشفوية للنواب وأعضاء مجلس الأمة . إذا رأت أي من الغرفتين أن جواب عضو الحكومة، شفويا كان أو كتابيا، يبرر إجراء مناقشة ، تجري المناقشة حسب الشروط التي ينص عليها النظام الداخلي للمجلس الشعبي الوطني ومجلس الأمة . تنشر الأسئلة والأجوبة طبقا للشروط التي يخضع لها نشر محاضر مناقشات البرلمان ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_152_permission_0_045869cf> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_152_right_0_d52d66c9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_152> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_152_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_152_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_152_para_2>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_152_para_3>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_152_para_4>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_152_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_152_20160307_OpEnact_7a414f92d2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_152_obligation_0_953c7847>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_152_obligation_1_f4c3c549>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_152_obligation_2_7f9e82fd>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_152_obligation_3_07220a21> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "152" ;
    dzdoc:position 147 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_152_condition_0_88850564> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation,
        dzterm:government,
        dzterm:internal_rules,
        dzterm:parliament,
        dzterm:parliament_members .

<https://legal.dz/resource/law/2016-03-06/16-01#art_105> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الأول__السلطة_التنفيذية> ;
    dzdoc:eId "art_105" ;
    dzdoc:fullText "يقرر رئيس الجمهورية ، إذا دعت الضرورة الملحة ، حالة الطوارئ أو الحصار ، لمدة معينة بعد اجتماع المجلس الأعلى للأمن، واستشارة رئيس مجلس الأمة، ورئيس المجلس الشعبي الوطني، والوزير الأول، ورئيس المجلس الدستوري ، ويتخذ كل التدابير اللازمة لاستتباب الوضع. ولا يمكن تمديد حالة الطوارئ أو الحصار ، إلا بعد موافقة البرلمان المنعقد بغرفتيه المجتمعتين معا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_105_permission_0_da428cda> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_105_right_0_db477c4c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_105> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_105_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_105_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_105_20160307_OpEnact_94c1a833fa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_105_obligation_0_609642df> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 105" ;
    dzdoc:position 102 ;
    dzdoc:usesTerm dzterm:emergency_state,
        dzterm:president,
        dzterm:siege_state .

<https://legal.dz/resource/law/2016-03-06/16-01#art_135> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_135" ;
    dzdoc:fullText "يجتمع البرلمان في دورة عادية واحدة كل سنة، مدتها عشرة (10) أشهر على الأقل، وتبتدئ في اليوم الثاني من أيام العمل في شهر سبتمبر . يمكن الوزير الأول طلب تمديد الدورة العادية لأيام معدودة لغرض الانتهاء من دراسة نقطة في جدول الأعمال . يمكن أن يجتمع البرلمان في دورة غير عادية بمبادرة من رئيس الجمهورية . ويمكن كذلك أن يجتمع باستدعاء من رئيس الجمهورية بطلب من الوزير الأول ، أو بطلب من ثلثي (2/3) أعضاء المجلس الشعبي الوطني . تختتم الدورة غير العادية بمجرد ما يستنفد البرلمان جدول الأعمال الذي استدعي من أجله."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_135_permission_0_52bf247e>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_135_permission_1_055b0e92> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_135_right_0_5cd60f26>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_135_right_1_cf93f051>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_135_right_2_1bb0b063> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_135> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_135_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_135_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_135_para_2>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_135_para_3>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_135_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_135_20160307_OpEnact_5648ec07ee> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_135_obligation_0_bc394135> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
