<https://legal.dz/resource/law/2016-03-06/16-01#version_art_151> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أعضاء البرلمان استجواب الحكومة في إحدى قضايا الساعة . ويكون الجواب خلال أجل أقصاه ثلاثون (30) يوما . يمكن لجان البرلمان أن تستمع إلى أعضاء الحكومة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_151_20160307_OpEnact_783f298ff2> ;
    dzdoc:replacementText "يمكن أعضاء البرلمان استجواب الحكومة في إحدى قضايا الساعة . ويكون الجواب خلال أجل أقصاه ثلاثون (30) يوما . يمكن لجان البرلمان أن تستمع إلى أعضاء الحكومة ."@ar ;
