    dzdoc:position 163 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_177> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_177" ;
    dzdoc:fullText "تؤسس محكمة عليا للدولة ، تختص بمحاكمة رئيس الجمهورية عن الأفعال التي يمكن وصفها بالخيانة العظمى، و الوزير الأول عن الجنايات والجنح، التي يرتكبانها بمناسبة تأديتهما مهامهما. يحدد قانون عضوي تشكيلة المحكمة العليا للدولة وتنظيمها وسيرها وكذلك الإجراءات المطبقة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_177_permission_0_7d06a70e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_177> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_177_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_177_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_177_20160307_OpEnact_2e2c7e1e61> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 177" ;
    dzdoc:position 171 ;
    dzdoc:usesTerm dzterm:high_court_of_state,
        dzterm:organic_law,
        dzterm:president_of_republic,
        dzterm:prime_minister .

<https://legal.dz/resource/law/2016-03-06/16-01#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:definesTerm dzterm:public_property ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "الملكية العامة هي ملك المجموعة الوطنية . وتشمل باطن الأرض، والمناجم، والمقالع، والموارد الطبيعية للطاقة، والثروات المعدنية الطبيعية والحية، في مختلف مناطق الأملاك الوطنية البحرية، والمياه، والغابات. كما تشمل النقل بالسكك الحديدية، والنقل البحري والجوي، والبريد والمواصلات السلكية واللاسلكية، وأملاكا أخرى محددة في القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_18> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2016-03-06/16-01#art_18_defocc_85b4af2cce3b> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_18_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_18_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_18_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_18_20160307_OpEnact_df75213d3d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "18" ;
    dzdoc:position 17 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_193> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثالث__الرقابة_ومراقبة_الانتخابات_والمؤسسات_الاستشارية_sec_الثاني__مراقبة_الانتخابات> ;
    dzdoc:eId "art_193" ;
    dzdoc:fullText "تلزم السلطات العمومية المكلفة بتنظيم الانتخابات بإحاطاتها بالشفافية والحياد . وبهذه الصفة، توضع القائمة الانتخابية عند كل انتخاب تحت تصرف المترشحين. يحدد القانون العضوي المتعلق بنظام الانتخابات كيفيات تطبيق هذا الحكم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_193> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_193_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_193_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_193_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_193_20160307_OpEnact_e3d8b3d0bb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_193_obligation_0_9dcdcb9f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "193" ;
    dzdoc:position 187 ;
    dzdoc:usesTerm dzterm:public_authorities .

<https://legal.dz/resource/law/2016-03-06/16-01#art_212> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الرابع__التعديل_الدستوري> ;
    dzdoc:eId "art_212" ;
    dzdoc:fullText "لا يمكن أي تعديل دستوري أن يمس: الطابع الجمهوري للدولة، النظام الديمقراطي القائم على التعددية الحزبية، الإسلام باعتباره دين الدولة، العربية باعتبارها اللغة الوطنية والرسمية، الحريات الأساسية وحقوق الإنسان والمواطن، سلامة التراب الوطني ووحدته، العلم الوطني والنشيد الوطني باعتبارهما من رموز الثورة والجمهورية. إعادة إنتخاب رئيس الجمهورية مرة واحدة فقط"@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_212_permission_0_52b98f23> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_212> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_212_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_212_20160307_OpEnact_75f6d429e6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 212" ;
    dzdoc:position 206 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_22> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_22" ;
    dzdoc:fullText "لا يتم نزع الملكية إلا في إطار القانون . ويترتب عليه تعويض عادل ومنصف ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_22_right_0_402cdd92> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_22> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_22_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_22_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_22_20160307_OpEnact_f08cdabed2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "22" ;
    dzdoc:position 21 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_22_condition_0_40ffbb0b> .

<https://legal.dz/resource/law/2016-03-06/16-01#art_32> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_32" ;
    dzdoc:fullText "كل المواطنين سواسية أمام القانون . ولا يمكن أن يتذرع بأي تمييز يعود سببه إلى المولد، أو العرق، أو الجنس، أو الرأي، أو أي شرط أو ظرف آخر، شخصي أو اجتماعي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_32_permission_0_46111fec> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_32_right_0_9952cfc0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_32> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_32_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_32_20160307_OpEnact_6d0a3f3846> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "32" ;
    dzdoc:position 30 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "الشباب قوة حية في بناء الوطن. تسهر الدولة على توفير كل الشروط الكفيلة بتنمية قدراته وتفعيل طاقاته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_37_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_37_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_37_20160307_OpEnact_ae34a80748> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_37_obligation_0_8350a6f7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "37" ;
    dzdoc:position 35 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "تضمن الدولة عدم انتهاك حرمة الإنسان . ويحظر أي عنف بدني أو معنوي أو أي مساس بالكرامة. المعاملة القاسية أو اللاإنسانية أو المهينة يقمعها القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_40_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_40_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_40_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_40_20160307_OpEnact_544476846a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_40_obligation_0_6ae6c4df> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "40" ;
    dzdoc:position 38 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "لا يتابع أحد، ولا يوقف أو يحتجز إلا ضمن الشروط المحددة بالقانون، وطبقا للأشكال التي نص عليها . الحبس المؤقت إجراء استثنائي يحدد القانون أسبابه ومدته وشروط تمديده. يعاقب القانون على أعمال وأفعال الاعتقال التعسفي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_59_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_59_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_59_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_59_20160307_OpEnact_24f674df87> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 59" ;
    dzdoc:position 57 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_59_condition_0_57c989d3> .

<https://legal.dz/resource/law/2016-03-06/16-01#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "يمارس كل واحد جميع حرياته ، في إطار احترام الحقوق المعترف بها للغير في الدستور ، لا سيما احترام الحق في الشرف، وستر الحياة الخاصة، وحماية الأسرة والشبيبة والطفولة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_77_right_0_b6436772> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_77_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_77_20160307_OpEnact_8aa44424b4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 77" ;
    dzdoc:position 74 ;
    dzdoc:references <https://legal.dz/resource/law/2016-03-06/16-01#constitution> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2016-03-06/16-01#constitution> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_77_condition_0_7f772293>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_77_condition_1_ff3e9daf> .

<https://legal.dz/resource/law/2016-03-06/16-01#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "تحت طائلة المتابعات، يلزم الأولياء، بضمان تربية أبنائهم وعلى الأبناء واجب القيام بالإحسان إلى آبائهم ومساعدتهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_79_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_79_20160307_OpEnact_162c69c580> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_79_obligation_0_dc5010ff>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_79_obligation_1_9c310807> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 79" ;
    dzdoc:position 76 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثاني__الشعب> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "السلطة التأسيسية ملك للشعب . يمارس الشعب سيادته بواسطة المؤسسات الدستورية التي يختارها. يمارس الشعب هذه السيادة أيضا عن طريق الاستفتاء وبواسطة ممثليه المنتخبين. لـ رئيس الجمهورية أن يلتجئ إلى إرادة الشعب مباشرة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_8_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_8_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_8_para_2>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_8_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_8_20160307_OpEnact_fbcc4654d0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "8" ;
    dzdoc:position 7 ;
    dzdoc:usesTerm dzterm:constituent_power,
        dzterm:constitutional_institutions,
        dzterm:people,
        dzterm:president,
        dzterm:referendum .

<https://legal.dz/resource/law/2016-03-06/16-01#art_80> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_80" ;
    dzdoc:fullText "يجب على كل مواطن أن يحمي الملكية العامة، ومصالح المجموعة الوطنية، ويحترم ملكية الغير ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_80> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_80_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_80_20160307_OpEnact_7d05a8f821> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_80_obligation_0_382414ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 80" ;
    dzdoc:position 77 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_83> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_83" ;
    dzdoc:fullText "لا يمكن بأي حال من الأحوال أن يسلم أو يطرد لاجئ سياسي يتمتع قانونا بحق اللجوء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_83_permission_0_64b66745> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_83> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_83_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_83_20160307_OpEnact_8cffcaaea4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 83" ;
    dzdoc:position 80 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_83_condition_0_d333510c> ;
    dzdoc:usesTerm dzterm:political_refugee .

<https://legal.dz/resource/law/2016-03-06/16-01#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الأول__السلطة_التنفيذية> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "مدة المهمة الرئاسية خمس (5) سنوات. يمكن تجديد انتخاب رئيس الجمهورية مرة واحدة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_88_permission_0_476d8ddc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_88_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_88_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_88_20160307_OpEnact_e959891cf8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "88" ;
    dzdoc:position 85 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2016-03-06/16-01#art_89> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الأول__السلطة_التنفيذية> ;
    dzdoc:eId "art_89" ;
    dzdoc:fullText "يؤدي رئيس الجمهورية اليمين أمام الشعب بحضور جميع الهيئات العليا في الأمة، خلال الأسبوع الموالي لانتخابه . ويباشر مهمته فور أدائه اليمين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_89> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_89_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_89_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_89_20160307_OpEnact_16f2d896fd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_89_obligation_0_8c54f6d2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "89" ;
    dzdoc:position 86 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_95> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الأول__السلطة_التنفيذية> ;
    dzdoc:eId "art_95" ;
    dzdoc:fullText "يقدم الوزير الأول استقالة الحكومة ل رئيس الجمهورية في حالة عدم موافقة المجلس الشعبي الوطني على مخطط عمل الحكومة . يعين رئيس الجمهورية من جديد وزيرا أول حسب الكيفيات نفسها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_95> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_95_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_95_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_95_20160307_OpEnact_71ada3da92> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_95_obligation_0_d2ed97d5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 95" ;
    dzdoc:position 92 ;
    dzdoc:usesTerm dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/law/2016-03-06/16-01#art_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_114" ;
    dzdoc:fullText "تتمتع المعارضة البرلمانية بحقوق تمكنها من المشاركة الفعلية في الأشغال البرلمانية وفي الحياة السياسية ، لا سيما منها: 1- حرية الرأي والتعبير والاجتماع، 2- الاستفادة من الإعانات المالية الممنوحة للمنتخبين في البرلمان، 3- المشاركة الفعلية في الأشغال التشريعية، 4- المشاركة الفعلية في مراقبة عمل الحكومة، 5- تمثيل مناسب في أجهزة غرفتي البرلمان، 6- إخطار المجلس الدستوري، طبقا لأحكام المادة 187 (الفقرتان 2 و3) من الدستور، بخصوص القوانين التي صوت عليها البرلمان، 7- المشاركة في الدبلوماسية البرلمانية. تخصص كل غرفة من غرفتي البرلمان جلسة شهرية لمناقشة جدول أعمال تقدمه مجموعة أو مجموعات برلمانية من المعارضة . يوضح النظام الداخلي لكل غرفة من غرفتي البرلمان كيفيات تطبيق هذه المادة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_114_right_0_0e22dcf2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_114> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_114_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_114_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_114_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_114_20160307_OpEnact_7af77cf6b8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_114_obligation_0_e7ed854a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 114" ;
    dzdoc:position 111 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2016-03-06/16-01#art_114_extref_b9c4b9e5> ;
    dzdoc:usesTerm dzterm:parliamentary_opposition .

<https://legal.dz/resource/law/2016-03-06/16-01#art_116> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_116" ;
    dzdoc:fullText "يتفرغ النائب أو عضو مجلس الأمة كليا لممارسة عهدته . ينص النظامان الداخليان للمجلس الشعبي الوطني ومجلس الأمة على أحكام تتعلق بوجوب المشاركة الفعلية لأعضائهما في أشغال اللجان وفي الجلسات العامة، تحت طائلة العقوبات المطبقة في حالة الغياب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_116> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_116_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_116_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_116_20160307_OpEnact_a2c381c955> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_116_obligation_0_480fbdb1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_116_obligation_1_2fda0fb3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 116" ;
    dzdoc:position 113 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_117> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_117" ;
    dzdoc:fullText "يجرد المنتخب في المجلس الشعبي الوطني أو في مجلس الأمة، المنتمي إلى حزب سياسي، الذي يغير طوعا الانتماء الذي انتخب على أساسه، من عهدته الانتخابية بقوة القانون . يعلن المجلس الدستوري شغور المقعد بعد إخطاره من رئيس الغرفة المعنية ويحدد القانون كيفيات استخلافه. يحتفظ النائب الذي استقال من حزبه أو أبعد منه بعهدته بصفة نائب غير منتم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_117> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_117_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_117_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_117_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_117_20160307_OpEnact_707e6fd688> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 117" ;
    dzdoc:position 114 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_117_condition_0_2980b816> .

<https://legal.dz/resource/law/2016-03-06/16-01#art_122> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_122" ;
    dzdoc:fullText "مهمة النائب وعضو مجلس الأمة وطنية، قابلة للتجديد، و لا يمكن الجمع بينها وبين مهام أو وظائف أخرى ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_122_permission_0_b699b6cf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_122> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_122_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_122_20160307_OpEnact_45180218aa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_122_obligation_0_230f594d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 122" ;
    dzdoc:position 118 ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:deputy .

<https://legal.dz/resource/law/2016-03-06/16-01#art_198> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:definesTerm dzterm:human_rights_council ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثالث__الرقابة_ومراقبة_الانتخابات_والمؤسسات_الاستشارية_sec_الثالث__المؤسسات> ;
    dzdoc:eId "art_198" ;
    dzdoc:fullText "يؤسس مجلس وطني لحقوق الإنسان ، يدعى في صلب النص ”المجلس” ويوضع لدى رئيس الجمهورية ، ضامن الدستور. يتمتع المجلس بالاستقلالية الإدارية والمالية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_198> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2016-03-06/16-01#art_198_defocc_52280cd9fa09> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_198_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_198_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_198_20160307_OpEnact_acca788783> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "198" ;
    dzdoc:position 192 ;
    dzdoc:usesTerm dzterm:human_rights_council,
        dzterm:president .

<https://legal.dz/resource/law/2016-03-06/16-01#art_203> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثالث__الرقابة_ومراقبة_الانتخابات_والمؤسسات_الاستشارية_sec_الثالث__المؤسسات> ;
    dzdoc:eId "art_203" ;
    dzdoc:fullText "تتولى الهيئة على الخصوص مهمة اقتراح سياسة شاملة للوقاية من الفساد، تكرس مبادئ دولة الحق والقانون وتعكس النزاهة والشفافية والمسؤولية في تسيير الممتلكات والأموال العمومية، والمساهمة في تطبيقها. ترفع الهيئة إلى رئيس الجمهورية تقريرا سنويا عن تقييم نشاطاتها المتعلقة بالوقاية من الفساد ومكافحته، والنقائص التي سجلتها في هذا المجال، والتوصيات المقترحة عند الاقتضاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_203> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_203_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_203_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_203_20160307_OpEnact_218c57cc71> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_203_obligation_0_656d10a1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_203_obligation_1_415f89b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 203" ;
    dzdoc:position 197 ;
    dzdoc:usesTerm dzterm:authority .

<https://legal.dz/resource/law/2016-03-06/16-01#art_207> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثالث__الرقابة_ومراقبة_الانتخابات_والمؤسسات_الاستشارية_sec_الثالث__المؤسسات> ;
    dzdoc:eId "art_207" ;
    dzdoc:fullText "يتولى المجلس على الخصوص المهام الآتية: ترقية البحث الوطني في مجال الابتكار التكنولوجي والعلمي، اقتراح التدابير الكفيلة بتنمية القدرات الوطنية في مجال البحث والتطوير، تقييم فعالية الأجهزة الوطنية المتخصصة في تثمين نتائج البحث لفائدة الاقتصاد الوطني في إطار التنمية المستدامة. ترأس المجلس كفاءة وطنية معترف بها، يعينها رئيس الجمهورية. يحدد القانون المهام الأخرى للمجلس وتنظيمه وتشكيلته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_207> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_207_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_207_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_207_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_207_20160307_OpEnact_06eaf1bc14> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_207_obligation_0_224b6995> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 207" ;
    dzdoc:position 201 ;
    dzdoc:usesTerm dzterm:scientific_council .

<https://legal.dz/resource/law/2016-03-06/16-01#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "تعمل الدولة على ترقية التناصف بين الرجال والنساء في سوق التشغيل . تشجع الدولة ترقية المرأة في مناصب المسؤولية في الهيئات والإدارات العمومية وعلى مستوى المؤسسات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_36_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_36_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_36_20160307_OpEnact_fb65d4bed2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_36_obligation_0_9ba04d52>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_36_obligation_1_3f7f68fa> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "36" ;
    dzdoc:position 34 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "الحريات الأساسية وحقوق الإنسان والمواطن مضمونة . وتكون تراثا مشتركا بين جميع الجزائريين والجزائريات، واجبهم أن ينقلوه من جيل إلى جيل كي يحافظوا على سلامته، وعدم انتهاك حرمته ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_38_right_0_d0e243e4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_38_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_38_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_38_20160307_OpEnact_1ebd710e4b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_38_obligation_0_55609b7d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "38" ;
    dzdoc:position 36 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "لا مساس بحرمة حرية المعتقد، وحرمة حرية الرأي . حرية ممارسة العبادة مضمونة في ظل احترام القانون."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_42_right_0_b740d761>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_42_right_1_1baf140b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_42> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_42_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_42_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_42_20160307_OpEnact_fb4105d14a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "42" ;
    dzdoc:position 40 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_45" ;
    dzdoc:fullText "الحق في الثقافة مضمون للمواطن . تحمي الدولة التراث الثقافي الوطني المادي وغير المادي وتعمل على الحفاظ عليه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_45_right_0_951d6e21> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_45> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_45_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_45_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_45_20160307_OpEnact_1b96215d83> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_45_obligation_0_dd54e8d1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "45" ;
    dzdoc:position 43 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "تضمن الدولة عدم انتهاك حرمة المسكن . فلا تفتيش إلا بمقتضى القانون، وفي إطار احترامه. ولا تفتيش إلا بأمر مكتوب صادر عن السلطة القضائية المختصة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_47_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_47_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_47_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_47_20160307_OpEnact_e44b80990e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_47_obligation_0_dad5edad> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "47" ;
    dzdoc:position 45 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_47_condition_0_cc2d3ff0> .

<https://legal.dz/resource/law/2016-03-06/16-01#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "تستفيد الأحزاب السياسية المعتمدة دون أي تمييز، في ظل احترام أحكام المادة 52 أعلاه، من الحقوق التالية على الخصوص : حرية الرأي والتعبير والاجتماع، حيز زمني في وسائل الإعلام العمومية يتناسب مع تمثليها على المستوى الوطني، تمويل عمومي، عند الاقتضاء ، يرتبط بتمثيلها في البرلمان كما يحدده القانون، ممارسة السلطة على الصعيدين المحلي والوطني من خلال التداول الديمقراطي وفي إطار أحكام هذا الدستور. يحدد القانون كيفيات تطبيق هذا الحكم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_53_right_0_eb7f0bf4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_53_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_53_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_53_20160307_OpEnact_5238c841de> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 53" ;
    dzdoc:position 51 ;
    dzdoc:references <https://legal.dz/resource/law/2016-03-06/16-01#art_52> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2016-03-06/16-01#art_52> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_53_condition_0_1b1645cd> ;
    dzdoc:usesTerm dzterm:political_parties .

<https://legal.dz/resource/law/2016-03-06/16-01#art_54> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_54" ;
    dzdoc:fullText "حق إنشاء الجمعيات مضمون . تشجع الدولة ازدهار الحركة الجمعوية . يحدد القانون العضوي شروط و كيفيات إنشاء الجمعيات."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_54_right_0_e925bf61> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_54> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_54_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_54_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_54_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_54_20160307_OpEnact_7c1627332f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_54_obligation_0_94cd5930> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 54" ;
    dzdoc:position 52 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_63> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_63" ;
    dzdoc:fullText "يتساوى جميع المواطنين في تقلد المهام والوظائف في الدولة دون أية شروط أخرى غير الشروط التي يحددها القانون. التمتع بالجنسية الجزائرية دون سواها شرط لتولي المسؤوليات العليا في الدولة والوظائف السياسية. يحدد القانون قائمة المسؤوليات العليا في الدولة والوظائف السياسية المذكورة أعلاه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_63_right_0_9b39a61d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_63> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_63_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_63_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_63_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_63_20160307_OpEnact_ba70999060> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 63" ;
    dzdoc:position 61 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_63_condition_0_08e47f44> .

<https://legal.dz/resource/law/2016-03-06/16-01#art_74> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_74" ;
    dzdoc:fullText "لا يعذر بجهل القانون. يجب على كل شخص أن يحترم الدستور وقوانين الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_74> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_74_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_74_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_74_20160307_OpEnact_1e9fbbd9da> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_74_obligation_0_baafbb6d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 74" ;
    dzdoc:position 71 ;
    dzdoc:usesTerm dzterm:constitution .

<https://legal.dz/resource/law/2016-03-06/16-01#art_75> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_75" ;
    dzdoc:fullText "يجب على كل مواطن أن يحمي ويصون استقلال البلاد وسيادتها وسلامة ترابها الوطني ووحدة شعبها وجميع رموز الدولة . يعاقب القانون بكل صرامة على الخيانة والتجسس والولاء للعدو، وعلى جميع الجرائم المرتكبة ضد أمن الدولة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_75> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_75_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_75_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_75_20160307_OpEnact_f9ab91e4d7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_75_obligation_0_7ca07c71> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 75" ;
    dzdoc:position 72 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_84> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الأول__السلطة_التنفيذية> ;
    dzdoc:eId "art_84" ;
    dzdoc:fullText "يجسد رئيس الجمهورية ، رئيس الدولة، وحدة الأمة. وهو حامي الدستور . ويجسد الدولة داخل البلاد وخارجها. له أن يخاطب الأمة مباشرة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_84_right_0_bdaf7158> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_84> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_84_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_84_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_84_para_2>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_84_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_84_20160307_OpEnact_2325d187cf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "84" ;
    dzdoc:position 81 ;
    dzdoc:usesTerm dzterm:constitution,
        dzterm:president .

dzterm:apn a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المجلس الشعبي الوطني"@ar .

dzterm:parliament a skos:Concept,
        dzdoc:LegalTerm ;
