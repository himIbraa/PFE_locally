<https://legal.dz/resource/law/2016-03-06/16-01#version_art_98> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على الحكومة أن تقدم سنويا إلى المجلس الشعبي الوطني بيانا عن السياسة العامة . تعقب بيان السياسة العامة مناقشة عمل الحكومة . يمكن أن تختتم هذه المناقشة بلائحة. كما يمكن أن يترتب على هذه المناقشة إيداع ملتمس رقابة يقوم به المجلس الشعبي الوطني طبقا لأحكام المواد 153 و 154 و 155 أدناه. للوزير الأول أن يطلب من المجلس الشعبي الوطني تصويتا بالثقة. وفي حالة عدم الموافقة على لائحة الثقة يقدم الوزير الأول استقالة الحكومة . في هذه الحالة، يمكن رئيس الجمهورية أن يلجأ، قبل قبول الاستقالة، إلى أحكام المادة"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_98_20160307_OpEnact_70879eca8d> ;
    dzdoc:replacementText "يجب على الحكومة أن تقدم سنويا إلى المجلس الشعبي الوطني بيانا عن السياسة العامة . تعقب بيان السياسة العامة مناقشة عمل الحكومة . يمكن أن تختتم هذه المناقشة بلائحة. كما يمكن أن يترتب على هذه المناقشة إيداع ملتمس رقابة يقوم به المجلس الشعبي الوطني طبقا لأحكام المواد 153 و 154 و 155 أدناه. للوزير الأول أن يطلب من المجلس الشعبي الوطني تصويتا بالثقة. وفي حالة عدم الموافقة على لائحة الثقة يقدم الوزير الأول استقالة الحكومة . في هذه الحالة، يمكن رئيس الجمهورية أن يلجأ، قبل قبول الاستقالة، إلى أحكام المادة 147 أدناه. يمكن الحكومة أن تقدم إلى مجلس الأمة بيانا عن السياسة العامة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_98> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_98> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2016-03-07"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2016-03-06/16-01#version_art_99> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمارس الوزير الأول ، زيادة على السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور، الصلاحيات الآتية : يوزع الصلاحيات بين أعضاء الحكومة مع احترام الأحكام الدستورية، يسهر على تنفيذ القوانين والتنظيمات، يرأس اجتماعات الحكومة ، يوقع المراسيم التنفيذية، يعين في وظائف الدولة بعد موافقة رئيس الجمهورية، ودون المساس بأحكام المادتين 91 و 92 السابقتي الذكر، يسهر على حسن سير الإدارة العمومية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_99_20160307_OpEnact_44edd312fa> ;
    dzdoc:replacementText "يمارس الوزير الأول ، زيادة على السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور، الصلاحيات الآتية : يوزع الصلاحيات بين أعضاء الحكومة مع احترام الأحكام الدستورية، يسهر على تنفيذ القوانين والتنظيمات، يرأس اجتماعات الحكومة ، يوقع المراسيم التنفيذية، يعين في وظائف الدولة بعد موافقة رئيس الجمهورية، ودون المساس بأحكام المادتين 91 و 92 السابقتي الذكر، يسهر على حسن سير الإدارة العمومية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_99> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_99> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2016-03-07"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

