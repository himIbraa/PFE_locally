<https://legal.dz/resource/law/2016-03-06/16-01#version_art_133> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "جلسات البرلمان علانية. وتدون مداولاته في محاضر تنشر طبقا للشروط التي يحددها القانون العضوي . يجوز للمجلس الشعبي الوطني و مجلس الأمة أن يعقدا جلسات مغلقة بطلب من رئيسيهما، أو من أغلبية أعضائهما الحاضرين، أو بطلب من الوزير الأول ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_133_20160307_OpEnact_8bdb967a21> ;
