<https://legal.dz/resource/law/2016-03-06/16-01#version_art_166> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "القاضي محمي من كل أشكال الضغوط والتدخلات والمناورات التي قد تضر بأداء مهمته، أو تمس نزاهة حكمه . يحظر أي تدخل في سير العدالة. يجب على القاضي أن يتفادى أي موقف من شأنه المساس بنزاهته . قاضي الحكم غير قابل للنقل حسب الشروط المحددة في القانون الأساسي للقضاء . يحدد القانون العضوي كيفيات تطبيق هذه المادة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
