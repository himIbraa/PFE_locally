<https://legal.dz/resource/law/2016-03-06/16-01#version_art_177> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تؤسس محكمة عليا للدولة ، تختص بمحاكمة رئيس الجمهورية عن الأفعال التي يمكن وصفها بالخيانة العظمى، و الوزير الأول عن الجنايات والجنح، التي يرتكبانها بمناسبة تأديتهما مهامهما. يحدد قانون عضوي تشكيلة المحكمة العليا للدولة وتنظيمها وسيرها وكذلك الإجراءات المطبقة."@ar ;
