<https://legal.dz/resource/law/2016-03-06/16-01#version_art_207> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتولى المجلس على الخصوص المهام الآتية: ترقية البحث الوطني في مجال الابتكار التكنولوجي والعلمي، اقتراح التدابير الكفيلة بتنمية القدرات الوطنية في مجال البحث والتطوير، تقييم فعالية الأجهزة الوطنية المتخصصة في تثمين نتائج البحث لفائدة الاقتصاد الوطني في إطار التنمية المستدامة. ترأس المجلس كفاءة وطنية معترف بها، يعينها رئيس الجمهورية. يحدد القانون المهام الأخرى للمجلس وتنظيمه وتشكيلته."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_207_20160307_OpEnact_06eaf1bc14> ;
    dzdoc:replacementText "يتولى المجلس على الخصوص المهام الآتية: ترقية البحث الوطني في مجال الابتكار التكنولوجي والعلمي، اقتراح التدابير الكفيلة بتنمية القدرات الوطنية في مجال البحث والتطوير، تقييم فعالية الأجهزة الوطنية المتخصصة في تثمين نتائج البحث لفائدة الاقتصاد الوطني في إطار التنمية المستدامة. ترأس المجلس كفاءة وطنية معترف بها، يعينها رئيس الجمهورية. يحدد القانون المهام الأخرى للمجلس وتنظيمه وتشكيلته."@ar ;
