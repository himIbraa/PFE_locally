<https://legal.dz/resource/law/2016-03-06/16-01#art_90_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_90> ;
    dzdoc:position 0 ;
    dzdoc:text "يؤدي رئيس الجمهورية اليمين حسب النص الآتي :"@ar .

<https://legal.dz/resource/law/2016-03-06/16-01#art_90_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_90> ;
    dzdoc:position 1 ;
    dzdoc:text "“بسم الله الرحمن الرحيم، وفاء للتضحيات الكبرى، ولأرواح شهدائنا الأبرار، وقيم ثورة نوفمبر الخالدة، أقسم بالله العلي العظيم، أن أحترم الدين الإسلامي وأمجده، وأدافع عن الدستور، وأسهر على استمرارية الدولة، وأعمل على توفير الشروط اللازمة للسير العادي للمؤسسات والنظام الدستوري، وأسعى من أجل تدعيم المسار الديمقراطي، وأحترم حرية اختيار الشعب، ومؤسسات الجمهورية وقوانينها، وأحافظ على سلامة التراب الوطني، ووحدة الشعب والأمة، وأحمي الحريات والحقوق الأساسية للإنسان والمواطن، وأعمل بدون هوادة من أجل تطور الشعب وازدهاره، وأسعى بكل قواي في سبيل تحقيق المثل العليا للعدالة والحرية والسلم في العالم. والله على ما أقول شهيد”."@ar .

<https://legal.dz/resource/law/2016-03-06/16-01#art_90_right_0_68fdef30> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_90> ;
    dznorm:position 0 ;
    dznorm:provisionText "الحريات والحقوق الأساسية للإنسان والمواطن"@ar ;
    dznorm:sourceArticle "art_90" .

<https://legal.dz/resource/law/2016-03-06/16-01#art_91_extref_47ad022e> a dzdoc:ExternalReference ;
    rdfs:label "الدستور"@ar ;
    dzdoc:frbrUri "/akn/dz/act/constitution/2020-12-30"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/constitution/2020-12-30"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/constitution/2020-12-30" ;
    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" .

<https://legal.dz/resource/law/2016-03-06/16-01#art_91_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_91> ;
    dzdoc:position 0 ;
    dzdoc:text """يضطلع رئيس الجمهورية، بالإضافة إلى السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور، بالسلطات والصلاحيات الآتية:
            
            
            1 – هو القائد الأعلى للقوات المسلحة للجمهورية،
            
            
            2 – يتولى مسؤولية الدفاع الوطني،
            
            
            3 – يقرر السياسة الخارجية للأمة ويوجهها،
            
            
            4 – يرأس مجلس الوزراء،
            
            
            5 – يعين الوزير الأول بعد استشارة الأغلبية البرلمانية، وينهي مهامه،
            
            
            6 – يوقع المراسيم الرئاسية،
            
            
            7 – له حق إصدار العفو وحق تخفيض العقوبات أو استبدالها،
            
            
            8 – يمكنه أن يستشير الشعب في كل قضية ذات أهمية وطنية عن طريق الاستفتاء،
            
            
            9 – يبرم المعاهدات الدولية ويصادق عليها،
            
            
            10 – يسلم أوسمة الدولة ونياشينها وشهاداتها التشريفية. 1 – هو القائد الأعلى للقوات المسلحة للجمهورية، 2 – يتولى مسؤولية الدفاع الوطني، 3 – يقرر السياسة الخارجية للأمة ويوجهها، 4 – يرأس مجلس الوزراء، 5 – يعين الوزير الأول بعد استشارة الأغلبية البرلمانية، وينهي مهامه، 6 – يوقع المراسيم الرئاسية، 7 – له حق إصدار العفو وحق تخفيض العقوبات أو استبدالها، 8 – يمكنه أن يستشير الشعب في كل قضية ذات أهمية وطنية عن طريق الاستفتاء، 9 – يبرم المعاهدات الدولية ويصادق عليها، 10 – يسلم أوسمة الدولة ونياشينها وشهاداتها التشريفية."""@ar .

<https://legal.dz/resource/law/2016-03-06/16-01#art_91_right_0_0076b7ee> a dznorm:Right ;
