<https://legal.dz/resource/law/2016-03-06/16-01#art_139_condition_0_2893db1a> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/2016-03-06/16-01#art_139_condition_0_2893db1a_role_e205d556f1> ;
    dznorm:conditionText "إلا إذا كان مرفوقا بتدابير تستهدف الزيادة في إيرادات الدولة، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي على الأقل المبالغ المقترح إنفاقها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_139> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_139_condition_0_2893db1a_role_e205d556f1> a dznorm:Role ;
    rdfs:label "الأقل المبالغ المقترح إنفاقها"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "إلا إذا كان مرفوقا بتدابير تستهدف الزيادة في إيرادات الدولة، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي على الأقل المبالغ المقترح إنفاقها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_139> .

<https://legal.dz/resource/law/2016-03-06/16-01#art_139_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_139> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يقبل اقتراح أي قانون، مضمونه أو نتيجته تخفيض الموارد العمومية، أو زيادة النفقات العمومية، إلا إذا كان مرفوقا بتدابير تستهدف الزيادة في إيرادات الدولة، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي على الأقل المبالغ المقترح إنفاقها."@ar .

<https://legal.dz/resource/law/2016-03-06/16-01#art_13_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_13> ;
    dzdoc:position 0 ;
    dzdoc:text "تمارس سيادة الدولة على مجالها البري، ومجالها الجوي، وعلى مياهها."@ar .

<https://legal.dz/resource/law/2016-03-06/16-01#art_13_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_13> ;
    dzdoc:position 1 ;
    dzdoc:text "كما تمارس الدولة حقها السيد الذي يقره القانون الدولي على كل منطقة من مختلف مناطق المجال البحري التي ترجع إليها."@ar .

<https://legal.dz/resource/law/2016-03-06/16-01#art_13_right_0_dd5059e9> a dznorm:Right ;
