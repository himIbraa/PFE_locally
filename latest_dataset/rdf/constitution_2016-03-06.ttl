        <https://legal.dz/resource/law/2016-03-06/16-01#art_78_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_78_20160307_OpEnact_a5a19558e0> ;
