<https://legal.dz/resource/law/2016-03-06/16-01#art_120_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_120> ;
    dzdoc:position 0 ;
    dzdoc:text "تحدد كيفيات انتخاب النواب وكيفيات انتخاب أعضاء مجلس الأمة أو تعيينهم، وشروط قابليتهم للانتخاب، ونظام عدم قابليتهم للانتخاب، وحالات التنافي، ونظام التعويضات البرلمانية، بموجب قانون عضوي."@ar .

<https://legal.dz/resource/law/2016-03-06/16-01#art_121_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_121> ;
    dzdoc:position 0 ;
    dzdoc:text "إثبات عضوية النواب وأعضاء مجلس الأمة من اختصاص كل من الغرفتين على حدة."@ar .

<https://legal.dz/resource/law/2016-03-06/16-01#art_122_obligation_0_230f594d> a dznorm:Obligation ;
