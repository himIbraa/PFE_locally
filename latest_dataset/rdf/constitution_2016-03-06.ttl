<https://legal.dz/resource/law/2016-03-06/16-01#art_213_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_213> ;
    dzdoc:position 0 ;
    dzdoc:text "يستمر سريان مفعول القوانين العادية التي حولها هذا الدستور إلى قوانين عضوية، إلى أن تعدل أو تستبدل وفق الإجراءات الدستورية."@ar .

