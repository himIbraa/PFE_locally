<https://legal.dz/resource/law/2016-03-06/16-01#version_art_212> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن أي تعديل دستوري أن يمس: الطابع الجمهوري للدولة، النظام الديمقراطي القائم على التعددية الحزبية، الإسلام باعتباره دين الدولة، العربية باعتبارها اللغة الوطنية والرسمية، الحريات الأساسية وحقوق الإنسان والمواطن، سلامة التراب الوطني ووحدته، العلم الوطني والنشيد الوطني باعتبارهما من رموز الثورة والجمهورية. إعادة إنتخاب رئيس الجمهورية مرة واحدة فقط"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_212_20160307_OpEnact_75f6d429e6> ;
    dzdoc:replacementText "لا يمكن أي تعديل دستوري أن يمس: الطابع الجمهوري للدولة، النظام الديمقراطي القائم على التعددية الحزبية، الإسلام باعتباره دين الدولة، العربية باعتبارها اللغة الوطنية والرسمية، الحريات الأساسية وحقوق الإنسان والمواطن، سلامة التراب الوطني ووحدته، العلم الوطني والنشيد الوطني باعتبارهما من رموز الثورة والجمهورية. إعادة إنتخاب رئيس الجمهورية مرة واحدة فقط"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_212> ;
