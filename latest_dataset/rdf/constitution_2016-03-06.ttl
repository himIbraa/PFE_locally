<https://legal.dz/resource/law/2016-03-06/16-01#version_art_171> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تمثل المحكمة العليا الهيئة المقومة لأعمال المجالس القضائية والمحاكم. يمثل مجلس الدولة الهيئة المقومة لأعمال الجهات القضائية الإدارية. تضمن المحكمة العليا و مجلس الدولة توحيد الاجتهاد القضائي في جميع أنحاء البلاد ويسهران على احترام القانون . تفصل محكمة التنازع في حالات تنازع الاختصاص بين هيئات القضاء العادي وهيئات القضاء الإداري."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_171_20160307_OpEnact_a366149e71> ;
    dzdoc:replacementText "تمثل المحكمة العليا الهيئة المقومة لأعمال المجالس القضائية والمحاكم. يمثل مجلس الدولة الهيئة المقومة لأعمال الجهات القضائية الإدارية. تضمن المحكمة العليا و مجلس الدولة توحيد الاجتهاد القضائي في جميع أنحاء البلاد ويسهران على احترام القانون . تفصل محكمة التنازع في حالات تنازع الاختصاص بين هيئات القضاء العادي وهيئات القضاء الإداري."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_171> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
