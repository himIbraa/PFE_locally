<https://legal.dz/resource/law/2016-03-06/16-01#version_art_52> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "حق إنشاء الأحزاب السياسية معترف به ومضمون . ولا يمكن التذرع بهذا الحق لضرب الحريات الأساسية، والقيم والمكونات الأساسية للهوية الوطنية، والوحدة الوطنية، وأمن التراب الوطني وسلامته، واستقلال البلاد، وسيادة الشعب، وكذا الطابع الديمقراطي والجمهوري للدولة . وفي ظل احترام أحكام هذا الدستور، لا يجوز تأسيس الأحزاب السياسية على أساس ديني أو لغوي أو عرقي أو جنسي أو مهني أو جهوي . ولا يجوز للأحزاب السياسية اللجوء إلى الدعاية الحزبية التي تقوم على العناصر المبينة في الفقرة السابقة . يحظر على الأحزاب السياسي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_52_20160307_OpEnact_dea497bd6d> ;
    dzdoc:replacementText "حق إنشاء الأحزاب السياسية معترف به ومضمون . ولا يمكن التذرع بهذا الحق لضرب الحريات الأساسية، والقيم والمكونات الأساسية للهوية الوطنية، والوحدة الوطنية، وأمن التراب الوطني وسلامته، واستقلال البلاد، وسيادة الشعب، وكذا الطابع الديمقراطي والجمهوري للدولة . وفي ظل احترام أحكام هذا الدستور، لا يجوز تأسيس الأحزاب السياسية على أساس ديني أو لغوي أو عرقي أو جنسي أو مهني أو جهوي . ولا يجوز للأحزاب السياسية اللجوء إلى الدعاية الحزبية التي تقوم على العناصر المبينة في الفقرة السابقة . يحظر على الأحزاب السياسية كل شكل من أشكال التبعية للمصالح أو الجهات الأجنبية . لا يجوز أن يلجأ أي حزب سياسي إلى استعمال العنف أو الإكراه مهما كانت طبيعتهما أو شكلهما . تحدد التزامات وواجبات أخرى بموجب قانون عضوي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_52> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_52> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2016-03-07"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2016-03-06/16-01#version_art_53> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تستفيد الأحزاب السياسية المعتمدة دون أي تمييز، في ظل احترام أحكام المادة 52 أعلاه، من الحقوق التالية على الخصوص : حرية الرأي والتعبير والاجتماع، حيز زمني في وسائل الإعلام العمومية يتناسب مع تمثليها على المستوى الوطني، تمويل عمومي، عند الاقتضاء ، يرتبط بتمثيلها في البرلمان كما يحدده القانون، ممارسة السلطة على الصعيدين المحلي والوطني من خلال التداول الديمقراطي وفي إطار أحكام هذا الدستور. يحدد القانون كيفيات تطبيق هذا الحكم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_53_20160307_OpEnact_5238c841de> ;
    dzdoc:replacementText "تستفيد الأحزاب السياسية المعتمدة دون أي تمييز، في ظل احترام أحكام المادة 52 أعلاه، من الحقوق التالية على الخصوص : حرية الرأي والتعبير والاجتماع، حيز زمني في وسائل الإعلام العمومية يتناسب مع تمثليها على المستوى الوطني، تمويل عمومي، عند الاقتضاء ، يرتبط بتمثيلها في البرلمان كما يحدده القانون، ممارسة السلطة على الصعيدين المحلي والوطني من خلال التداول الديمقراطي وفي إطار أحكام هذا الدستور. يحدد القانون كيفيات تطبيق هذا الحكم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_53> ;
