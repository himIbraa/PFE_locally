<https://legal.dz/resource/law/2016-03-06/16-01#version_art_101> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز بأي حال من الأحوال أن يفوض رئيس الجمهورية سلطته في تعيين الوزير الأول وأعضاء الحكومة وكذا رؤساء المؤسسات الدستورية وأعضائها الذين لم ينص الدستور على طريقة أخرى لتعيينهم . كما لا يجوز أن يفوض سلطته في اللجوء إلى الاستفتاء، وحل المجلس الشعبي الوطني، وتقرير إجراء الانتخابات التشريعية قبل أوانها، وتطبيق الأحكام المنصوص عليها في المواد 91 و 92 و 105 ومن 107 إلى 109 و 111 و 142 و 144 و 145 و 146 من الدستور ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_101_20160307_OpEnact_2479da9188> ;
    dzdoc:replacementText "لا يجوز بأي حال من الأحوال أن يفوض رئيس الجمهورية سلطته في تعيين الوزير الأول وأعضاء الحكومة وكذا رؤساء المؤسسات الدستورية وأعضائها الذين لم ينص الدستور على طريقة أخرى لتعيينهم . كما لا يجوز أن يفوض سلطته في اللجوء إلى الاستفتاء، وحل المجلس الشعبي الوطني، وتقرير إجراء الانتخابات التشريعية قبل أوانها، وتطبيق الأحكام المنصوص عليها في المواد 91 و 92 و 105 ومن 107 إلى 109 و 111 و 142 و 144 و 145 و 146 من الدستور ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_101> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_101> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
