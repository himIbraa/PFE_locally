<https://legal.dz/resource/law/2016-03-06/16-01#version_art_3> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "اللغة العربية هي اللغة الوطنية والرسمية. تظل العربية اللغة الرسمية للدولة. يحدث لدى رئيس الجمهورية مجلس أعلى للغة العربية . يكلف المجلس الأعلى للغة العربية على الخصوص بالعمل على ازدهار اللغة العربية وتعميم استعمالها في الميادين العلمية والتكنولوجية والتشجيع على الترجمة إليها لهذه الغاية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_3_20160307_OpEnact_decd38be97> ;
    dzdoc:replacementText "اللغة العربية هي اللغة الوطنية والرسمية. تظل العربية اللغة الرسمية للدولة. يحدث لدى رئيس الجمهورية مجلس أعلى للغة العربية . يكلف المجلس الأعلى للغة العربية على الخصوص بالعمل على ازدهار اللغة العربية وتعميم استعمالها في الميادين العلمية والتكنولوجية والتشجيع على الترجمة إليها لهذه الغاية ."@ar ;
