<https://legal.dz/resource/law/2016-03-06/16-01#version_art_47> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تضمن الدولة عدم انتهاك حرمة المسكن . فلا تفتيش إلا بمقتضى القانون، وفي إطار احترامه. ولا تفتيش إلا بأمر مكتوب صادر عن السلطة القضائية المختصة ."@ar ;
