<https://legal.dz/resource/law/2016-03-06/16-01#art_56_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_56> ;
    dzdoc:position 0 ;
    dzdoc:text "كل شخص يعتبر بريئا حتى تثبت جهة قضائية نظامية إدانته في إطار محاكمة عادلة تؤمن له الضمانات اللازمة للدفاع عنه."@ar .

<https://legal.dz/resource/law/2016-03-06/16-01#art_57_para_0> a dzdoc:Paragraph ;
