<https://legal.dz/resource/law/2016-03-06/16-01#art_193_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_193> ;
    dzdoc:position 1 ;
    dzdoc:text "وبهذه الصفة، توضع القائمة الانتخابية عند كل انتخاب تحت تصرف المترشحين."@ar .

<https://legal.dz/resource/law/2016-03-06/16-01#art_193_para_2> a dzdoc:Paragraph ;
