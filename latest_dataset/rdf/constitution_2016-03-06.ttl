    dzdoc:number "المادة 30" ;
    dzdoc:position 28 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "الجنسية الجزائرية ، معرفة بالقانون. شروط اكتساب الجنسية الجزائرية ، والاحتفاظ بها، أو فقدانها، أو إسقاطها، محددة بالقانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_33_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_33_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_33_20160307_OpEnact_ccf1840c22> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "33" ;
    dzdoc:position 31 ;
    dzdoc:usesTerm dzterm:nationality .

<https://legal.dz/resource/law/2016-03-06/16-01#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "تستهدف المؤسسات ضمان مساواة كل المواطنين والمواطنات في الحقوق والواجبات بإزالة العقبات التي تعوق تفتح شخصية الإنسان، وتحول دون مشاركة الجميع الفعلية في الحياة السياسية، والاقتصادية، والاجتماعية، والثقافية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_34_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_34_20160307_OpEnact_bffc5bbc1b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_34_obligation_0_3a23e927> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "34" ;
    dzdoc:position 32 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_39" ;
    dzdoc:fullText "الدفاع الفردي أو عن طريق الجمعية عن الحقوق الأساسية للإنسان وعن الحريات الفردية والجماعية، مضمون ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_39_right_0_e6b93c58> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_39> ;
