<https://legal.dz/resource/law/2016-03-06/16-01#version_art_137> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تودع مشاريع القوانين المتعلقة بالتنظيم المحلي وتهيئة الإقليم والتقسيم الإقليمي مكتب مجلس الأمة . وباستثناء الحالات المبينة في الفقرة أعلاه، تودع كل مشاريع القوانين الأخرى مكتب المجلس الشعبي الوطني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_137_20160307_OpEnact_a28d6d162e> ;
    dzdoc:replacementText "تودع مشاريع القوانين المتعلقة بالتنظيم المحلي وتهيئة الإقليم والتقسيم الإقليمي مكتب مجلس الأمة . وباستثناء الحالات المبينة في الفقرة أعلاه، تودع كل مشاريع القوانين الأخرى مكتب المجلس الشعبي الوطني ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_137> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_137> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
