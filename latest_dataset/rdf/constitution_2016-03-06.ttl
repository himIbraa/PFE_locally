<https://legal.dz/resource/law/2016-03-06/16-01#art_101_obligation_0_71ff974c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2016-03-06/16-01#art_101_obligation_0_71ff974c_action_0423be74ab> ;
