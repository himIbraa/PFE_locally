    dzdoc:position 131 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_135_condition_0_97b6d6b3>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_135_condition_1_6da32258> ;
