<https://legal.dz/resource/law/2016-03-06/16-01#version_art_116> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتفرغ النائب أو عضو مجلس الأمة كليا لممارسة عهدته . ينص النظامان الداخليان للمجلس الشعبي الوطني ومجلس الأمة على أحكام تتعلق بوجوب المشاركة الفعلية لأعضائهما في أشغال اللجان وفي الجلسات العامة، تحت طائلة العقوبات المطبقة في حالة الغياب ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
