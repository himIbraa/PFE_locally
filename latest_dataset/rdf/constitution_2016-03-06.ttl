    dznorm:expressedIn <https://legal.dz/resource/law/2016-03-06/16-01#art_194> ;
    dznorm:position 0 ;
    dznorm:provisionText "تسهر اللجنة العليا على شفافية الانتخابات الرئاسية والتشريعية والمحلية وكذا الاستفتاء ونزاهتها، منذ استدعاء الهيئة الناخبة حتى إعلان النتائج المؤقتة للاقتراع"@ar ;
    dznorm:sourceArticle "art_194" .

<https://legal.dz/resource/law/2016-03-06/16-01#art_194_obligation_0_640eaf50_role_14dab07997> a dznorm:Role ;
