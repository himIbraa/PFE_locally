<https://legal.dz/resource/law/2016-03-06/16-01#version_art_77> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمارس كل واحد جميع حرياته ، في إطار احترام الحقوق المعترف بها للغير في الدستور ، لا سيما احترام الحق في الشرف، وستر الحياة الخاصة، وحماية الأسرة والشبيبة والطفولة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_77_20160307_OpEnact_8aa44424b4> ;
