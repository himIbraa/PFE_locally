dzterm:national_peoples_assembly a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المجلس الشعبي الوطني"@ar,
        "للمجلس الشعبي الوطني"@ar .

<https://legal.dz/resource/law/2016-03-06/16-01#art_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الأول__السلطة_التنفيذية> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "يمكن الوزير الأول أن يقدم استقالة الحكومة لرئيس الجمهورية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_100_permission_0_8dbd40aa> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_100> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_100_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_100_20160307_OpEnact_2dc6479063> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "100" ;
    dzdoc:position 97 ;
    dzdoc:usesTerm dzterm:government,
        dzterm:prime_minister .

<https://legal.dz/resource/law/2016-03-06/16-01#art_118> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_118" ;
    dzdoc:fullText "ينتخب أعضاء المجلس الشعبي الوطني عن طريق الاقتراع العام المباشر والسري. ينتخب ثلثا (2/3) أعضاء مجلس الأمة عن طريق الاقتراع غير المباشر والسري، بمقعدين عن كل ولاية، من بين أعضاء المجالس الشعبية البلدية وأعضاء المجالس الشعبية الولائية. ويعين رئيس الجمهورية الثلث الآخر من أعضاء مجلس الأمة من بين الشخصيات والكفاءات الوطنية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_118> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_118_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_118_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_118_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_118_20160307_OpEnact_6b7f6e1bdc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 118" ;
    dzdoc:position 115 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "تستمد الدولة مشروعيتها وسبب وجودها من إرادة الشعب. شعارها: ” بالشعب وللشعب “. وهي في خدمته وحده."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_12_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_12_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_12_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_12_20160307_OpEnact_cbbd9e142c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "12" ;
    dzdoc:position 11 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/law/2016-03-06/16-01#art_123> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_123" ;
    dzdoc:fullText "كل نائب أو عضو مجلس الأمة لا يستوفي شروط قابلية انتخابه أو يفقدها ، يتعرض لسقوط مهمته البرلمانية. ويقرر المجلس الشعبي الوطني أو مجلس الأمة ، حسب الحالة، هذا السقوط بأغلبية أعضائه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_123> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_123_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_123_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_123_20160307_OpEnact_c769a95aa9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 123" ;
    dzdoc:position 119 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_123_condition_0_dc471d50> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation .

<https://legal.dz/resource/law/2016-03-06/16-01#art_130> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_130" ;
    dzdoc:fullText "تبتدئ الفترة التشريعية، وجوبا، في اليوم الخامس عشر (15) الذي يلي تاريخ إعلان المجلس الدستوري النتائج، تحت رئاسة أكبر النواب سنا وبمساعدة أصغر نائبين منهم. ينتخب المجلس الشعبي الوطني مكتبه ويشكل لجانه. تطبق الأحكام السابقة الذكر على مجلس الأمة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_130> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_130_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_130_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_130_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_130_20160307_OpEnact_d19e5ccd7e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 130" ;
    dzdoc:position 126 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:constitutional_council,
        dzterm:council_of_nation .

<https://legal.dz/resource/law/2016-03-06/16-01#art_139> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_139" ;
    dzdoc:fullText "لا يقبل اقتراح أي قانون، مضمونه أو نتيجته تخفيض الموارد العمومية، أو زيادة النفقات العمومية، إلا إذا كان مرفوقا بتدابير تستهدف الزيادة في إيرادات الدولة، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي على الأقل المبالغ المقترح إنفاقها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_139> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_139_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_139_20160307_OpEnact_866f0abda4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "139" ;
    dzdoc:position 135 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_139_condition_0_2893db1a> .

<https://legal.dz/resource/law/2016-03-06/16-01#art_143> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_143" ;
    dzdoc:fullText "يمارس رئيس الجمهورية السلطة التنظيمية في المسائل غير المخصصة للقانون . يندرج تطبيق القوانين في المجال التنظيمي الذي يعود للوزير الأول ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_143_right_0_070719c4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_143> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_143_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_143_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_143_20160307_OpEnact_16ce3d0006> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 143" ;
    dzdoc:position 138 ;
    dzdoc:usesTerm dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/law/2016-03-06/16-01#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "تقوم الدولة على مبادىء التنظيم الديمقراطي والفصل بين السلطات والعدالة الاجتماعية. المجلس المنتخب هو الإطار الذي يعبر فيه الشعب عن إرادته، ويراقب عمل السلطات العمومية. تشجع الدولة الديمقراطية التشاركية على مستوى الجماعات المحلية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_15_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_15_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_15_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_15_20160307_OpEnact_a590525e16> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "15" ;
    dzdoc:position 14 ;
    dzdoc:usesTerm dzterm:elected_council,
        dzterm:state .

<https://legal.dz/resource/law/2016-03-06/16-01#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "تحمي السلطة القضائية المجتمع والحريات، وتضمن للجميع ولكل واحد المحافظة على حقوقهم الأساسية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_157_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_157_20160307_OpEnact_6afc1659f2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_157_obligation_0_c8564567> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 157" ;
    dzdoc:position 151 ;
    dzdoc:usesTerm dzterm:judicial_authority .

<https://legal.dz/resource/law/2016-03-06/16-01#art_164> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_164" ;
    dzdoc:fullText "يختص القضاة بإصدار الأحكام. ويمكن أن يعينهم في ذلك مساعدون شعبيون حسب الشروط التي يحددها القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_164> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_164_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_164_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_164_20160307_OpEnact_2db652083c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 164" ;
    dzdoc:position 158 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_164_condition_0_732c65d3> .

<https://legal.dz/resource/law/2016-03-06/16-01#art_170> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_170" ;
    dzdoc:fullText "يستفيد المحامي من الضمانات القانونية التي تكفل له الحماية من كل أشكال الضغوط وتمكنه من ممارسة مهنته بكل حرية في إطار القانون ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_170_right_0_fd128455> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_170> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_170_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_170_20160307_OpEnact_2cf1b817e1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 170" ;
    dzdoc:position 164 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_179> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثالث__الرقابة_ومراقبة_الانتخابات_والمؤسسات_الاستشارية_sec_الأول__الرقابة> ;
    dzdoc:eId "art_179" ;
    dzdoc:fullText "تقدم الحكومة لكل غرفة من البرلمان عرضا عن استعمال الاعتمادات المالية التي أقرتها لكل سنة مالية . تختتم السنة المالية فيما يخص البرلمان ، بالتصويت على قانون يتضمن تسوية ميزانية السنة المالية المعنية من قبل كل غرفة من البرلمان ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_179> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_179_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_179_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_179_20160307_OpEnact_9ac76062b9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_179_obligation_0_a8e0b597> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 179" ;
    dzdoc:position 173 ;
    dzdoc:usesTerm dzterm:government,
        dzterm:parliament .

<https://legal.dz/resource/law/2016-03-06/16-01#art_190> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثالث__الرقابة_ومراقبة_الانتخابات_والمؤسسات_الاستشارية_sec_الأول__الرقابة> ;
    dzdoc:eId "art_190" ;
    dzdoc:fullText "إذا ارتأى المجلس الدستوري عدم دستورية معاهدة أو اتفاق، أو اتفاقية ، فلا يتم التصديق عليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_190> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_190_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_190_20160307_OpEnact_eeb4d4ddde> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_190_obligation_0_a7e41b08> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 190" ;
    dzdoc:position 184 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_190_condition_0_d1ff0c88> ;
    dzdoc:usesTerm dzterm:constitutional_council .

<https://legal.dz/resource/law/2016-03-06/16-01#art_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_20" ;
    dzdoc:fullText "الأملاك الوطنية يحددها القانون. وتتكون من الأملاك العمومية والخاصة التي تملكها كل من الدولة ، و الولاية ، و البلدية . يتم تسيير الأملاك الوطنية طبقا للقانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_20> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_20_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_20_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_20_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_20_20160307_OpEnact_c11bfa5de8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "20" ;
    dzdoc:position 19 ;
    dzdoc:usesTerm dzterm:municipality,
        dzterm:state,
        dzterm:wilaya .

<https://legal.dz/resource/law/2016-03-06/16-01#art_200> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:definesTerm dzterm:youth_council ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثالث__الرقابة_ومراقبة_الانتخابات_والمؤسسات_الاستشارية_sec_الثالث__المؤسسات> ;
    dzdoc:eId "art_200" ;
    dzdoc:fullText "يحدث مجلس أعلى للشباب ، وهو هيئة استشارية توضع لدى رئيس الجمهورية . يضم المجلس ممثلين عن الشباب وممثلين عن الحكومة وعن المؤسسات العمومية المكلفة بشؤون الشباب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_200> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2016-03-06/16-01#art_200_defocc_d7d84431cce4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_200_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_200_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_200_20160307_OpEnact_e501957c4c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "200" ;
    dzdoc:position 194 ;
    dzdoc:usesTerm dzterm:president,
        dzterm:youth_council .

<https://legal.dz/resource/law/2016-03-06/16-01#art_204> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:definesTerm dzterm:council ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثالث__الرقابة_ومراقبة_الانتخابات_والمؤسسات_الاستشارية_sec_الثالث__المؤسسات> ;
    dzdoc:eId "art_204" ;
    dzdoc:fullText "المجلس الوطني الاقتصادي والاجتماعي، الذي يدعى في صلب النص ”المجلس”، إطار للحوار والتشاور والاقتراح في المجالين الاقتصادي والاجتماعي. وهو مستشار الحكومة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_204> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2016-03-06/16-01#art_204_defocc_7a725df5c2a9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_204_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_204_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_204_20160307_OpEnact_9ac50c795e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 204" ;
    dzdoc:position 198 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_205> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثالث__الرقابة_ومراقبة_الانتخابات_والمؤسسات_الاستشارية_sec_الثالث__المؤسسات> ;
    dzdoc:eId "art_205" ;
    dzdoc:fullText "يتولى المجلس على الخصوص مهمة : توفير إطار لمشاركة المجتمع المدني في التشاور الوطني حول سياسات التنمية الاقتصادية والاجتماعية، ضمان ديمومة الحوار والتشاور بين الشركاء الاقتصاديين والاجتماعيين الوطنيين، تقييم المسائل ذات المصلحة الوطنية في المجال الاقتصادي والاجتماعي والتربوي والتكويني والتعليم العالي، ودراستها، عرض اقتراحات وتوصيات على الحكومة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_205> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_205_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_205_20160307_OpEnact_2977ee19fe> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_205_obligation_0_33e3e84a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 205" ;
    dzdoc:position 199 ;
    dzdoc:usesTerm dzterm:council .

<https://legal.dz/resource/law/2016-03-06/16-01#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "تنتظم الطاقة الدفاعية للأمة، ودعمها، وتطويرها، حول الجيش الوطني الشعبي . تتمثل المهمة الدائمة للجيش الوطني الشعبي في المحافظة على الاستقلال الوطني، والدفاع عن السيادة الوطنية. كما يضطلع بالدفاع عن وحدة البلاد، وسلامتها الترابية، وحماية مجالها البري والجوي، ومختلف مناطق أملاكها البحرية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_28_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_28_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_28_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_28_20160307_OpEnact_77629aabad> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 28" ;
    dzdoc:position 26 ;
    dzdoc:usesTerm dzterm:anp .

<https://legal.dz/resource/law/2016-03-06/16-01#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث__الدولة> ;
    dzdoc:eId "art_29" ;
    dzdoc:fullText "تمتنع الجزائر عن اللجوء إلى الحرب من أجل المساس بالسيادة المشروعة للشعوب الأخرى وحريتها . وتبذل جهدها لتسوية الخلافات الدولية بالوسائل السلمية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_29_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_29_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_29_20160307_OpEnact_c98b003022> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_29_obligation_0_ed4a40d0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 29" ;
    dzdoc:position 27 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الأول__الجزائر> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "العلم الوطني والنشيد الوطني من مكاسب ثورة أول نوفمبر 1954 وهما غير قابلين للتغيير. هذان الرمزان من رموز الثورة، هما رمزان للجمهورية بالصفات التالية : 1 – علم الجزائر أخضر وأبيض تتوسطه نجمة وهلال أحمرا اللون. 2 – النشيد الوطني هو ” قسما ” بجميع مقاطعه. يحدد القانون خاتم الدولة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_6_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_6_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_6_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_6_20160307_OpEnact_41bc706c16> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "6" ;
    dzdoc:position 5 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_61> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_61" ;
    dzdoc:fullText "يترتب على الخطأ القضائي تعويض من الدولة . ويحدد القانون شروط التعويض وكيفياته."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_61_right_0_8f3eec6f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_61> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_61_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_61_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_61_20160307_OpEnact_99e03e9449> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 61" ;
    dzdoc:position 59 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "لكل مواطن تتوفر فيه الشروط القانونية أن ينتخب وينتخب ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_62_right_0_f8970ca3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_62_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_62_20160307_OpEnact_46574e9860> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 62" ;
