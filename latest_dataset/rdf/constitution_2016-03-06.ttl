        <https://legal.dz/resource/law/2016-03-06/16-01#art_211_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_211_20160307_OpEnact_0944ed75ce> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 211" ;
    dzdoc:position 205 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2016-03-06/16-01#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "حرية الابتكار الفكري والفني والعلمي مضمونة للمواطن . حقوق المؤلف يحميها القانون . لا يجوز حجز أي مطبوع أو تسجيل أو أية وسيلة أخرى من وسائل التبليغ والإعلام إلا بمقتضى أمر قضائي. الحريات الأكاديمية وحرية البحث العلمي مضمونة وتمارس في إطار القانون. تعمل الدولة على ترقية البحث العلمي وتثمينه خدمة للتنمية المستدامة للأمة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_44_permission_0_e572d87b> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_44_right_0_aa355506>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_44_right_1_b4af3016>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_44_right_2_754d851f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_44_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_44_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_44_para_2>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_44_para_3>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_44_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_44_20160307_OpEnact_7d94363b72> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_44_obligation_0_eb96a92f> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2016-03-06/16-01#art_44_prohibition_0_e572d87b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "44" ;
    dzdoc:position 42 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "حرية الصحافة المكتوبة والسمعية البصرية وعلى الشبكات الإعلامية مضمونة و لا تقيد بأي شكل من أشكال الرقابة القبلية . لا يمكن استعمال هذه الحرية للمساس بكرامة الغير وحرياتهم وحقوقهم . نشر المعلومات والأفكار والصور والآراء بكل حرية مضمون في إطار القانون واحترام ثوابت الأمة وقيمها الدينية والأخلاقية والثقافية. لا يمكن أن تخضع جنحة الصحافة لعقوبة سالبة للحرية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_50_permission_0_2e6631b3>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_50_permission_1_5d42a3fa> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_50_right_0_152db42f>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_50_right_1_67559bf9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_50> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_50_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_50_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_50_para_2>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_50_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_50_20160307_OpEnact_25a8bbf8c7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_50_obligation_0_b7e5eb78>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_50_obligation_1_a889caaf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "50" ;
    dzdoc:position 48 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "لكل المواطنين الحق في العمل . يضمن القانون في أثناء العمل الحق في الحماية، والأمن، والنظافة . الحق في الراحة مضمون ، ويحدد القانون كيفيات ممارسته. يضمن القانون حق العامل في الضمان الاجتماعي . تشغيل الأطفال دون سن 16 سنة يعاقب عليه القانون . تعمل الدولة على ترقية التمهين وتضع سياسات للمساعدة على استحداث مناصب الشغل ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_69_right_0_8388195d>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_69_right_1_36fc38c2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_69_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_69_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_69_para_2>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_69_para_3>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_69_para_4>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_69_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_69_20160307_OpEnact_81b8a4240e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_69_obligation_0_f5ab5423>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_69_obligation_1_22cde555>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_69_obligation_2_25d3f7be>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_69_obligation_3_571313ee> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "69" ;
    dzdoc:position 66 ;
    dzdoc:usesTerm dzterm:work .

<https://legal.dz/resource/law/2016-03-06/16-01#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع__الحقوق_والحريات> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "تحظى الأسرة بحماية الدولة والمجتمع . تحمي الأسرة والمجتمع والدولة حقوق الطفل . تكفل الدولة الأطفال المتخلى عنهم أو مجهولي النسب . يقمع القانون العنف ضد الأطفال . تعمل الدولة على تسهيل استفادة الفئات الضعيفة ذات الاحتياجات الخاصة من الحقوق المعترف بها لجميع المواطنين، وإدماجها في الحياة الاجتماعية . تحمي الأسرة والدولة الأشخاص المسنين . يحدد القانون شروط وكيفيات تطبيق هذه الأحكام."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_72_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_72_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_72_para_2>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_72_para_3>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_72_para_4>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_72_para_5>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_72_para_6> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_72_20160307_OpEnact_558c53de54> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_72_obligation_0_777169bb>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_72_obligation_1_e4cde47b>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_72_obligation_2_3e461421>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_72_obligation_3_8c4977b4>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_72_obligation_4_0e4be8b1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_72_obligation_5_01b3a4c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "72" ;
    dzdoc:position 69 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الأول__السلطة_التنفيذية> ;
    dzdoc:eId "art_87" ;
    dzdoc:fullText "لا يحق أن ينتخب لرئاسة الجمهورية إلا المترشح الذي : لم يتجنس بجنسية أجنبية ، يتمتع بالجنسية الجزائرية الأصلية فقط، ويثبت الجنسية الجزائرية الأصلية للأب والأم ، يدين بالإسلام ، يكون عمره أربعين (40) سنة كاملة يوم الانتخاب ، يتمتع بكامل حقوقه المدنية والسياسية ، يثبت أن زوجه يتمتع بالجنسية الجزائرية الأصلية فقط ، يثبت إقامة دائمة بالجزائر دون سواها لمدة عشر (10) سنوات على الأقل قبل إيداع الترشح ، يثبت مشاركته في ثورة أول نوفمبر 1954 إذا كان مولودا قبل يوليو 1942 ، يثبت عدم تورط أبويه في أعمال ضد ثورة أول نوفمبر 1954 إذا كان مولودا بعد يوليو 1942 ، يقدم التصريح العلني بممتلكاته العقارية والمنقولة داخل الوطن وخارجه . تحدد شروط أخرى بموجب القانون العضوي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_87> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_87_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_87_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_87_20160307_OpEnact_fb12a2bde9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "87" ;
    dzdoc:position 84 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_87_condition_0_c0b7d334>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_87_condition_1_e1295ae8>,
