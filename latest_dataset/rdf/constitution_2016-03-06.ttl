<https://legal.dz/resource/law/2016-03-06/16-01#version_art_194> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحدث هيئة عليا مستقلة لمراقبة الانتخابات . ترأس الهيئة شخصية وطنية يعينها رئيس الجمهورية، بعد استشارة الأحزاب السياسية. للهيئة العليا لجنة دائمة. وتنشر الهيئة العليا أعضاءها الآخرين فور استدعاء الهيئة الانتخابية. تتكون الهيئة العليا بشكل متساو من: قضاة يقترحهم المجلس الأعلى للقضاء، ويعينهم رئيس الجمهورية، وكفاءات مستقلة يتم اختيارها من ضمن المجتمع المدني، يعينها رئيس الجمهورية. تسهر اللجنة العليا على شفافية الانتخابات الرئاسية والتشريعية والمحلية وكذا الاستفتاء ونزاهتها، منذ استدعاء الهيئة الناخ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_194_20160307_OpEnact_9c7ef06e46> ;
    dzdoc:replacementText "تحدث هيئة عليا مستقلة لمراقبة الانتخابات . ترأس الهيئة شخصية وطنية يعينها رئيس الجمهورية، بعد استشارة الأحزاب السياسية. للهيئة العليا لجنة دائمة. وتنشر الهيئة العليا أعضاءها الآخرين فور استدعاء الهيئة الانتخابية. تتكون الهيئة العليا بشكل متساو من: قضاة يقترحهم المجلس الأعلى للقضاء، ويعينهم رئيس الجمهورية، وكفاءات مستقلة يتم اختيارها من ضمن المجتمع المدني، يعينها رئيس الجمهورية. تسهر اللجنة العليا على شفافية الانتخابات الرئاسية والتشريعية والمحلية وكذا الاستفتاء ونزاهتها، منذ استدعاء الهيئة الناخبة حتى إعلان النتائج المؤقتة للاقتراع . تسهر اللجنة الدائمة للهيئة العليا على الخصوص على ما يأتي: الإشراف على عمليات مراجعة الإدارة للقوائم الانتخابية، صياغة التوصيات لتحسين النصوص التشريعية والتنظيمية التي تحكم العمليات الانتخابية. تنظيم دورة في التكوين المدني لفائدة التشكيلات السياسية حول مراقبة الانتخابات وصياغة الطعون. يحدد القانون العضوي كيفيات تطبيق هذه المادة"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_194> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_194> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2016-03-07"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2016-03-06/16-01#version_art_195> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤسس لدى رئيس الجمهورية مجلس إسلامي أعلى ، يتولى على الخصوص ما يأتي: الحث على الاجتهاد وترقية، إبداء الحكم الشرعي فيما يعرض عليه، رفع تقرير دوري عن نشاطه إلى رئيس الجمهورية ."@ar ;
