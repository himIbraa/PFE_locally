<https://legal.dz/resource/law/2016-03-06/16-01#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الأول__الجزائر> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "الجزائر جمهورية ديمقراطية شعبية. وهي وحدة لا تتجزأ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_1_20160307_OpEnact_b29af7a157> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "الأولى" ;
    dzdoc:position 0 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_120> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_120" ;
    dzdoc:fullText "تحدد كيفيات انتخاب النواب وكيفيات انتخاب أعضاء مجلس الأمة أو تعيينهم، وشروط قابليتهم للانتخاب، ونظام عدم قابليتهم للانتخاب، وحالات التنافي، ونظام التعويضات البرلمانية، بموجب قانون عضوي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_120> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_120_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_120_20160307_OpEnact_48039c534d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 120" ;
    dzdoc:position 116 ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:deputies,
        dzterm:organic_law .

<https://legal.dz/resource/law/2016-03-06/16-01#art_121> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_121" ;
    dzdoc:fullText "إثبات عضوية النواب وأعضاء مجلس الأمة من اختصاص كل من الغرفتين على حدة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_121> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_121_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_121_20160307_OpEnact_6ba845d9c5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 121" ;
    dzdoc:position 117 ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:deputies .

<https://legal.dz/resource/law/2016-03-06/16-01#art_125> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_125" ;
    dzdoc:fullText "يحدد قانون عضوي الحالات التي يقبل فيها البرلمان استقالة أحد أعضائه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_125> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_125_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_125_20160307_OpEnact_b13330b5ee> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 125" ;
    dzdoc:position 121 ;
    dzdoc:usesTerm dzterm:organic_law .

<https://legal.dz/resource/law/2016-03-06/16-01#art_129> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_129" ;
    dzdoc:fullText "يحدد قانون عضوي شروط استخلاف النائب أو عضو مجلس الأمة في حالة شغور مقعده."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_129> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_129_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_129_20160307_OpEnact_9fbf352d74> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 129" ;
    dzdoc:position 125 ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:organic_law .

<https://legal.dz/resource/law/2016-03-06/16-01#art_150> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_150" ;
    dzdoc:fullText "المعاهدات التي يصادق عليها رئيس الجمهورية ، حسب الشروط المنصوص عليها في الدستور، تسمو على القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_150> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_150_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_150_20160307_OpEnact_074808c688> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 150" ;
    dzdoc:position 145 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2016-03-06/16-01#art_159> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_159" ;
    dzdoc:fullText "يصدر القضاء أحكامه باسم الشعب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_159> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_159_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_159_20160307_OpEnact_d956cac0c7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 159" ;
    dzdoc:position 153 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_161> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_161" ;
    dzdoc:fullText "ينظر القضاء في الطعن في قرارات السلطات الإدارية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_161> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_161_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_161_20160307_OpEnact_eabf60f4a9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 161" ;
    dzdoc:position 155 .

<https://legal.dz/resource/law/2016-03-06/16-01#art_165> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
