    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_181_obligation_0_d9d73e4b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 181" ;
    dzdoc:position 175 ;
    dzdoc:usesTerm dzterm:constitutional_institutions,
        dzterm:control_bodies .

<https://legal.dz/resource/law/2016-03-06/16-01#art_197> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثالث__الرقابة_ومراقبة_الانتخابات_والمؤسسات_الاستشارية_sec_الثالث__المؤسسات> ;
    dzdoc:eId "art_197" ;
    dzdoc:fullText "يؤسس مجلس أعلى للأمن يرأسه رئيس الجمهورية ، مهمته تقديم الآراء إلى رئيس الجمهورية في كل القضايا المتعلقة بالأمن الوطني. يحدد رئيس الجمهورية كيفيات تنظيم المجلس الأعلى للأمن وعمله."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_197> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_197_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_197_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_197_20160307_OpEnact_ec4ff683fb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "197" ;
    dzdoc:position 191 ;
    dzdoc:usesTerm dzterm:high_security_council,
        dzterm:president .

<https://legal.dz/resource/law/2016-03-06/16-01#art_201> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثالث__الرقابة_ومراقبة_الانتخابات_والمؤسسات_الاستشارية_sec_الثالث__المؤسسات> ;
    dzdoc:eId "art_201" ;
    dzdoc:fullText "يقدم المجلس الأعلى للشباب آراء وتوصيات حول المسائل المتعلقة بحاجات الشباب وازدهاره في المجال الاقتصادي والاجتماعي والثقافي والرياضي. كما يساهم المجلس في ترقية القيم الوطنية والضمير الوطني والحس المدني والتضامن الاجتماعي في أوساط الشباب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_201> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_201_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_201_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_201_20160307_OpEnact_4e166538ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "201" ;
    dzdoc:position 195 ;
    dzdoc:usesTerm dzterm:youth_council .

