<https://legal.dz/resource/law/2016-03-06/16-01#art_108> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الأول__السلطة_التنفيذية> ;
    dzdoc:eId "art_108" ;
    dzdoc:fullText "يقرر رئيس الجمهورية التعبئة العامة في مجلس الوزراء بعد الاستماع إلى المجلس الأعلى للأمن واستشارة رئيس مجلس الأمة ورئيس المجلس الشعبي الوطني ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_108_right_0_d3794e56> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_108> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_108_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_108_20160307_OpEnact_88bff8f5c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 108" ;
    dzdoc:position 105 ;
    dzdoc:usesTerm dzterm:general_mobilization,
        dzterm:president .

<https://legal.dz/resource/law/2016-03-06/16-01#art_128> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_128" ;
    dzdoc:fullText "في حالة تلبس أحد النواب أو أحد أعضاء مجلس الأمة بجنحة أو جناية ، يمكن توقيفه. ويخطر بذلك مكتب المجلس الشعبي الوطني ، أو مكتب مجلس الأمة ، حسب الحالة، فورا. يمكن المكتب المخطر أن يطلب إيقاف المتابعة وإطلاق سراح النائب أو عضو مجلس الأمة، على أن يعمل فيما بعد بأحكام المادة 127 أعلاه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_128_permission_0_f624be32>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_128_permission_1_f69712be> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_128> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_128_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_128_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_128_20160307_OpEnact_c54c24fdd0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 128" ;
    dzdoc:position 124 ;
    dzdoc:references <https://legal.dz/resource/law/2016-03-06/16-01#art_127> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2016-03-06/16-01#art_127> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2016-03-06/16-01#art_128_condition_0_69fbc225> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation .

<https://legal.dz/resource/law/2016-03-06/16-01#art_132> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_132" ;
    dzdoc:fullText "يحدد قانون عضوي تنظيم المجلس الشعبي الوطني و مجلس الأمة ، وعملهما، وكذا العلاقات الوظيفية بينهما وبين الحكومة . يحدد القانون ميزانية الغرفتين . يعد المجلس الشعبي الوطني و مجلس الأمة نظامهما الداخلي ويصادقان عليهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_132> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_132_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_132_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_132_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_132_20160307_OpEnact_eff36bf7eb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2016-03-06/16-01#art_132_obligation_0_0788c150>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_132_obligation_1_b59af54e>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_132_obligation_2_ef0f8bc6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "132" ;
    dzdoc:position 128 ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:government,
        dzterm:national_peoples_assembly .

<https://legal.dz/resource/law/2016-03-06/16-01#art_182> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:definesTerm dzterm:constitutional_council ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثالث__الرقابة_ومراقبة_الانتخابات_والمؤسسات_الاستشارية_sec_الأول__الرقابة> ;
    dzdoc:eId "art_182" ;
    dzdoc:fullText "المجلس الدستوري هيئة مستقلة تكلف بالسهر على احترام الدستور . كما يسهر المجلس الدستوري على صحة عمليات الاستفتاء، وانتخاب رئيس الجمهورية، والانتخابات التشريعية. وينظر في جوهر الطعون التي يتلقاها حول النتائج المؤقتة للانتخابات الرئاسية والانتخابات التشريعية ويعلن النتائج النهائية لكل العمليات المنصوص عليها في الفقرة السابقة . يتمتع المجلس الدستوري بالاستقلالية الإدارية والمالية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_182_right_0_450ab3a6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_182> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2016-03-06/16-01#art_182_defocc_6d483696c620> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_182_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_182_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_182_para_2>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_182_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_182_20160307_OpEnact_7ea2fde145> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:introducedOn "2016-03-07"^^xsd:date ;
    dzdoc:number "المادة 182" ;
    dzdoc:position 176 ;
    dzdoc:references <https://legal.dz/resource/law/2016-03-06/16-01#art_182> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2016-03-06/16-01#art_182> ;
    dzdoc:usesTerm dzterm:constitutional_council .

<https://legal.dz/resource/law/2016-03-06/16-01#art_192> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثالث__الرقابة_ومراقبة_الانتخابات_والمؤسسات_الاستشارية_sec_الأول__الرقابة> ;
    dzdoc:eId "art_192" ;
    dzdoc:fullText "يتمتع مجلس المحاسبة بالاستقلالية ويكلف بالرقابة البعدية لأموال الدولة والجماعات الإقليمية والمرافق العمومية، وكذلك رؤوس الأموال التجارية التابعة للدولة . يساهم مجلس المحاسبة في تطوير الحكم الراشد والشفافية في تسيير الأموال العمومية . يعد مجلس المحاسبة تقريرا سنويا يرفعه إلى رئيس الجمهورية وإلى رئيس مجلس الأمة و رئيس المجلس الشعبي الوطني و الوزير الأول . يحدد القانون صلاحيات مجلس المحاسبة ويضبط تنظيمه وعمله وجزاء تحقيقاته وكذا علاقاته بالهياكل الأخرى في الدولة المكلفة بالرقابة والتفتيش ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_192> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2016-03-06/16-01#art_192_para_0>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_192_para_1>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_192_para_2>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_192_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_192_20160307_OpEnact_c989cd0805> ;
