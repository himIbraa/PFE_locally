<https://legal.dz/resource/law/2016-03-06/16-01#version_art_10> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للمؤسسات أن تقوم بما يأتي : الممارسات الإقطاعية، والجهوية، والمحسوبية، إقامة علاقات الاستغلال والتبعية، السلوك المخالف للخلق الإسلامي وقيم ثورة نوفمبر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_10_20160307_OpEnact_d659ef0f5a> ;
    dzdoc:replacementText "لا يجوز للمؤسسات أن تقوم بما يأتي : الممارسات الإقطاعية، والجهوية، والمحسوبية، إقامة علاقات الاستغلال والتبعية، السلوك المخالف للخلق الإسلامي وقيم ثورة نوفمبر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
