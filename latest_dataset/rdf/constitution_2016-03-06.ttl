<https://legal.dz/resource/law/2016-03-06/16-01#version_art_11> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الشعب حر في اختيار ممثليه. لا حدود لتمثيل الشعب ، إلا ما نص عليه الدستور وقانون الانتخابات"@ar ;
