<https://legal.dz/resource/law/2016-03-06/16-01#version_art_94> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقدم الوزير الأول مخطط عمل الحكومة إلى المجلس الشعبي الوطني للموافقة عليه . ويجري المجلس الشعبي الوطني لهذا الغرض مناقشة عامة. ويمكن الوزير الأول أن يكيف مخطط العمل هذا، على ضوء هذه المناقشة، بالتشاور مع رئيس الجمهورية . يقدم الوزير الأول عرضا حول مخطط عمل الحكومة لمجلس الأمة مثلما وافق عليه المجلس الشعبي الوطني. يمكن مجلس الأمة أن يصدر لائحة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_94_20160307_OpEnact_ea3f517e4f> ;
    dzdoc:replacementText "يقدم الوزير الأول مخطط عمل الحكومة إلى المجلس الشعبي الوطني للموافقة عليه . ويجري المجلس الشعبي الوطني لهذا الغرض مناقشة عامة. ويمكن الوزير الأول أن يكيف مخطط العمل هذا، على ضوء هذه المناقشة، بالتشاور مع رئيس الجمهورية . يقدم الوزير الأول عرضا حول مخطط عمل الحكومة لمجلس الأمة مثلما وافق عليه المجلس الشعبي الوطني. يمكن مجلس الأمة أن يصدر لائحة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_94> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
