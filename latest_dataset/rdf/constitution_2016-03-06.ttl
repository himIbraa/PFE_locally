<https://legal.dz/resource/law/2016-03-06/16-01#version_art_124> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "النائب أو عضو مجلس الأمة مسؤول أمام زملائه الذين يمكنهم تجريده من مهمته النيابية إن إقترف فعلا يخل بشرف مهمته . يحدد النظام الداخلي لكل واحدة من الغرفتين، الشروط التي يتعرض فيها أي نائب أو عضو مجلس الأمة للإقصاء. ويقرر هذا الإقصاء، حسب الحالة، المجلس الشعبي الوطني أو مجلس الأمة بأغلبية أعضائه، دون المساس بجميع المتابعات الأخرى الواردة في القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_124_20160307_OpEnact_a3908824a4> ;
    dzdoc:replacementText "النائب أو عضو مجلس الأمة مسؤول أمام زملائه الذين يمكنهم تجريده من مهمته النيابية إن إقترف فعلا يخل بشرف مهمته . يحدد النظام الداخلي لكل واحدة من الغرفتين، الشروط التي يتعرض فيها أي نائب أو عضو مجلس الأمة للإقصاء. ويقرر هذا الإقصاء، حسب الحالة، المجلس الشعبي الوطني أو مجلس الأمة بأغلبية أعضائه، دون المساس بجميع المتابعات الأخرى الواردة في القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_124> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
