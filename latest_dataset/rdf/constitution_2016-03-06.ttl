    dzdoc:eId "art_65" ;
    dzdoc:fullText "الحق في التعليم مضمون . التعليم العمومي مجاني حسب الشروط التي يحددها القانون . التعليم الأساسي إجباري . تنظم الدولة المنظومة التعليمية الوطنية . تسهر الدولة على التساوي في الالتحاق بالتعليم، والتكوين المهني ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_65_right_0_777dfa7e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_65> ;
