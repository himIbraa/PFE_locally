<https://legal.dz/resource/law/2016-03-06/16-01#version_art_123> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل نائب أو عضو مجلس الأمة لا يستوفي شروط قابلية انتخابه أو يفقدها ، يتعرض لسقوط مهمته البرلمانية. ويقرر المجلس الشعبي الوطني أو مجلس الأمة ، حسب الحالة، هذا السقوط بأغلبية أعضائه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_123_20160307_OpEnact_c769a95aa9> ;
    dzdoc:replacementText "كل نائب أو عضو مجلس الأمة لا يستوفي شروط قابلية انتخابه أو يفقدها ، يتعرض لسقوط مهمته البرلمانية. ويقرر المجلس الشعبي الوطني أو مجلس الأمة ، حسب الحالة، هذا السقوط بأغلبية أعضائه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_123> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
