<https://legal.dz/resource/law/2016-03-06/16-01#art_142> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2016-03-06/16-01#chp_الثاني_تنظيم_السلطات_sec_الثاني__السلطة_التشريعية> ;
    dzdoc:eId "art_142" ;
    dzdoc:fullText "لرئيس الجمهورية أن يشرع بأوامر في مسائل عاجلة في حالة شغور المجلس الشعبي الوطني أو خلال العطل البرلمانية ، بعد رأي مجلس الدولة . ويعرض رئيس الجمهورية النصوص التي اتخذها على كل غرفة من البرلمان في أول دورة له لتوافق عليها . تعد لاغية الأوامر التي لا يوافق عليها البرلمان . يمكن رئيس الجمهورية أن يشرع بأوامر في الحالة الاستثنائية المذكورة في المادة 107 من الدستور . تتخذ الأوامر في مجلس الوزراء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2016-03-06/16-01#art_142_permission_0_22f31fcf> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2016-03-06/16-01#art_142_right_0_15e0183a>,
        <https://legal.dz/resource/law/2016-03-06/16-01#art_142_right_1_4f483027> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2016-03-06/16-01#version_art_142> ;
