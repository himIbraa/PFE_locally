<https://legal.dz/resource/law/2016-03-06/16-01#version_art_128> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة تلبس أحد النواب أو أحد أعضاء مجلس الأمة بجنحة أو جناية ، يمكن توقيفه. ويخطر بذلك مكتب المجلس الشعبي الوطني ، أو مكتب مجلس الأمة ، حسب الحالة، فورا. يمكن المكتب المخطر أن يطلب إيقاف المتابعة وإطلاق سراح النائب أو عضو مجلس الأمة، على أن يعمل فيما بعد بأحكام المادة 127 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_128_20160307_OpEnact_c54c24fdd0> ;
    dzdoc:replacementText "في حالة تلبس أحد النواب أو أحد أعضاء مجلس الأمة بجنحة أو جناية ، يمكن توقيفه. ويخطر بذلك مكتب المجلس الشعبي الوطني ، أو مكتب مجلس الأمة ، حسب الحالة، فورا. يمكن المكتب المخطر أن يطلب إيقاف المتابعة وإطلاق سراح النائب أو عضو مجلس الأمة، على أن يعمل فيما بعد بأحكام المادة 127 أعلاه."@ar ;
