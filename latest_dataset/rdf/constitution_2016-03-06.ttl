<https://legal.dz/resource/law/2016-03-06/16-01#version_art_51> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الحصول على المعلومات والوثائق والإحصائيات ونقلها مضمونان للمواطن . لا يمكن أن تمس ممارسة هذا الحق بحياة الغير الخاصة وبحقوقهم وبالمصالح المشروعة للمقاولات وبمقتضيات الأمن الوطني . يحدد القانون كيفيات ممارسة هذا الحق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_51_20160307_OpEnact_544078adee> ;
    dzdoc:replacementText "الحصول على المعلومات والوثائق والإحصائيات ونقلها مضمونان للمواطن . لا يمكن أن تمس ممارسة هذا الحق بحياة الغير الخاصة وبحقوقهم وبالمصالح المشروعة للمقاولات وبمقتضيات الأمن الوطني . يحدد القانون كيفيات ممارسة هذا الحق."@ar ;
    dzdoc:resolutionStatus "resolved" ;
