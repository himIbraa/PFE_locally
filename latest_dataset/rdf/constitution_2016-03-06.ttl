<https://legal.dz/resource/law/2016-03-06/16-01#art_194_obligation_0_640eaf50> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
