<https://legal.dz/resource/law/2016-03-06/16-01#version_art_198> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤسس مجلس وطني لحقوق الإنسان ، يدعى في صلب النص ”المجلس” ويوضع لدى رئيس الجمهورية ، ضامن الدستور. يتمتع المجلس بالاستقلالية الإدارية والمالية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_198_20160307_OpEnact_acca788783> ;
    dzdoc:replacementText "يؤسس مجلس وطني لحقوق الإنسان ، يدعى في صلب النص ”المجلس” ويوضع لدى رئيس الجمهورية ، ضامن الدستور. يتمتع المجلس بالاستقلالية الإدارية والمالية."@ar ;
