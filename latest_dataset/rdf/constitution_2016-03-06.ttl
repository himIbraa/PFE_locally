<https://legal.dz/resource/law/2016-03-06/16-01#version_art_43> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "حرية الاستثمار والتجارة معترف بها ، وتمارس في إطار القانون. تعمل الدولة على تحسين مناخ الأعمال ، وتشجع على ازدهار المؤسسات دون تمييز خدمة للتنمية الاقتصادية الوطنية. تكفل الدولة ضبط السوق . ويحمي القانون حقوق المستهلكين . يمنع القانون الاحتكار والمنافسة غير النزيهة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_43_20160307_OpEnact_a0095b8512> ;
    dzdoc:replacementText "حرية الاستثمار والتجارة معترف بها ، وتمارس في إطار القانون. تعمل الدولة على تحسين مناخ الأعمال ، وتشجع على ازدهار المؤسسات دون تمييز خدمة للتنمية الاقتصادية الوطنية. تكفل الدولة ضبط السوق . ويحمي القانون حقوق المستهلكين . يمنع القانون الاحتكار والمنافسة غير النزيهة."@ar ;
