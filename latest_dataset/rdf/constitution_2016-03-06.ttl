<https://legal.dz/resource/law/2016-03-06/16-01#version_art_60> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخضع التوقيف للنظر في مجال التحريات الجزائية للرقابة القضائية، ولا يمكن أن يتجاوز مدة ثمان وأربعين (48) ساعة. يملك الشخص الذي يوقف للنظر حق الاتصال فورا بأسرته . يجب إعلام الشخص الذي يوقف للنظر بحقه أيضا في الاتصال بمحاميه ، ويمكن القاضي أن يحد من ممارسة هذا الحق في إطار ظروف استثنائية ينص عليها القانون. ولا يمكن تمديد مدة التوقيف للنظر، إلا استثناء، ووفقا للشروط المحددة بالقانون. ولدى انتهاء مدة التوقيف للنظر، يجب أن يجرى فحص طبي على الشخص الموقوف، إن طلب ذلك، على أن يعلم بهذه الإمكانية، في كل "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_60_20160307_OpEnact_931e408132> ;
    dzdoc:replacementText "يخضع التوقيف للنظر في مجال التحريات الجزائية للرقابة القضائية، ولا يمكن أن يتجاوز مدة ثمان وأربعين (48) ساعة. يملك الشخص الذي يوقف للنظر حق الاتصال فورا بأسرته . يجب إعلام الشخص الذي يوقف للنظر بحقه أيضا في الاتصال بمحاميه ، ويمكن القاضي أن يحد من ممارسة هذا الحق في إطار ظروف استثنائية ينص عليها القانون. ولا يمكن تمديد مدة التوقيف للنظر، إلا استثناء، ووفقا للشروط المحددة بالقانون. ولدى انتهاء مدة التوقيف للنظر، يجب أن يجرى فحص طبي على الشخص الموقوف، إن طلب ذلك، على أن يعلم بهذه الإمكانية، في كل الحالات. الفحص الطبي إجباري بالنسبة للقصر. يحدد القانون كيفيات تطبيق هذه المادة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_60> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_60> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2016-03-07"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

