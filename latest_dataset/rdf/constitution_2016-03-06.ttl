<https://legal.dz/resource/law/2016-03-06/16-01#version_art_117> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجرد المنتخب في المجلس الشعبي الوطني أو في مجلس الأمة، المنتمي إلى حزب سياسي، الذي يغير طوعا الانتماء الذي انتخب على أساسه، من عهدته الانتخابية بقوة القانون . يعلن المجلس الدستوري شغور المقعد بعد إخطاره من رئيس الغرفة المعنية ويحدد القانون كيفيات استخلافه. يحتفظ النائب الذي استقال من حزبه أو أبعد منه بعهدته بصفة نائب غير منتم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_117_20160307_OpEnact_707e6fd688> ;
    dzdoc:replacementText "يجرد المنتخب في المجلس الشعبي الوطني أو في مجلس الأمة، المنتمي إلى حزب سياسي، الذي يغير طوعا الانتماء الذي انتخب على أساسه، من عهدته الانتخابية بقوة القانون . يعلن المجلس الدستوري شغور المقعد بعد إخطاره من رئيس الغرفة المعنية ويحدد القانون كيفيات استخلافه. يحتفظ النائب الذي استقال من حزبه أو أبعد منه بعهدته بصفة نائب غير منتم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_117> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_117> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2016-03-07"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2016-03-06/16-01#version_art_118> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينتخب أعضاء المجلس الشعبي الوطني عن طريق الاقتراع العام المباشر والسري. ينتخب ثلثا (2/3) أعضاء مجلس الأمة عن طريق الاقتراع غير المباشر والسري، بمقعدين عن كل ولاية، من بين أعضاء المجالس الشعبية البلدية وأعضاء المجالس الشعبية الولائية. ويعين رئيس الجمهورية الثلث الآخر من أعضاء مجلس الأمة من بين الشخصيات والكفاءات الوطنية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
