<https://legal.dz/resource/law/2016-03-06/16-01#version_art_23> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن أن تكون الوظائف والعهدات في مؤسسات الدولة مصدرا للثراء، ولا وسيلة لخدمة المصالح الخاصة . يجب على كل شخص يعين في وظيفة سامية في الدولة، أو ينتخب في مجلس محلي، أو ينتخب أو يعين في مجلس وطني أو في هيئة وطنية، أن يصرح بممتلكاته في بداية وظيفته أو عهدته وفي نهايتهما . يحدد القانون كيفيات تطبيق هذه الأحكام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_23_20160307_OpEnact_164b475545> ;
    dzdoc:replacementText "لا يمكن أن تكون الوظائف والعهدات في مؤسسات الدولة مصدرا للثراء، ولا وسيلة لخدمة المصالح الخاصة . يجب على كل شخص يعين في وظيفة سامية في الدولة، أو ينتخب في مجلس محلي، أو ينتخب أو يعين في مجلس وطني أو في هيئة وطنية، أن يصرح بممتلكاته في بداية وظيفته أو عهدته وفي نهايتهما . يحدد القانون كيفيات تطبيق هذه الأحكام."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_23> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
