<https://legal.dz/resource/law/2016-03-06/16-01#version_art_214> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يستمر المجلس الدستوري بتمثيله الحالي في ممارسة الصلاحيات المخولة له بموجب هذا الدستور، وتنتهي عهدة أعضائه الحاليين بانقضاء عهدة كل منهم. كل تغيير أو إضافة يجب أن يتم وفق الشروط والإجراءات المنصوص عليها في هذا الدستور في أجل أقصاه ستة (6) أشهر من صدوره . يجدد نصف أعضاء المجلس الدستوري المعينين أو المنتخبين في إطار هذا الدستور بعد السنة الرابعة (4) من العهدة، عن طريق القرعة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_214_20160307_OpEnact_d1b6b3bf04> ;
    dzdoc:replacementText "يستمر المجلس الدستوري بتمثيله الحالي في ممارسة الصلاحيات المخولة له بموجب هذا الدستور، وتنتهي عهدة أعضائه الحاليين بانقضاء عهدة كل منهم. كل تغيير أو إضافة يجب أن يتم وفق الشروط والإجراءات المنصوص عليها في هذا الدستور في أجل أقصاه ستة (6) أشهر من صدوره . يجدد نصف أعضاء المجلس الدستوري المعينين أو المنتخبين في إطار هذا الدستور بعد السنة الرابعة (4) من العهدة، عن طريق القرعة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
