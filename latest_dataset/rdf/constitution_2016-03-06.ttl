<https://legal.dz/resource/law/2016-03-06/16-01#version_art_138> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مع مراعاة أحكام الفقرة الأولى من المادة 137 أعلاه ، يجب أن يكون كل مشروع أو اقتراح قانون موضوع مناقشة من طرف المجلس الشعبي الوطني و مجلس الأمة ، على التوالي، حتى تتم المصادقة عليه . تنصب مناقشة مشاريع القوانين من طرف المجلس الشعبي الوطني على النص الذي يعرضه عليه الوزير الأول أو على النص الذي صادق عليه مجلس الأمة في المسائل المنصوص عليها في المادة 137 أعلاه. تعرض الحكومة على إحدى الغرفتين النص الذي صوتت عليه الغرفة الأخرى. وتناقش كل غرفة النص الذي صوتت عليه الغرفة الأخرى وتصادق عليه. وفي كل الحال"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_138_20160307_OpEnact_d54efeee77> ;
    dzdoc:replacementText "مع مراعاة أحكام الفقرة الأولى من المادة 137 أعلاه ، يجب أن يكون كل مشروع أو اقتراح قانون موضوع مناقشة من طرف المجلس الشعبي الوطني و مجلس الأمة ، على التوالي، حتى تتم المصادقة عليه . تنصب مناقشة مشاريع القوانين من طرف المجلس الشعبي الوطني على النص الذي يعرضه عليه الوزير الأول أو على النص الذي صادق عليه مجلس الأمة في المسائل المنصوص عليها في المادة 137 أعلاه. تعرض الحكومة على إحدى الغرفتين النص الذي صوتت عليه الغرفة الأخرى. وتناقش كل غرفة النص الذي صوتت عليه الغرفة الأخرى وتصادق عليه. وفي كل الحالات، يصادق مجلس الأمة على النص الذي صوت عليه المجلس الشعبي الوطني بأغلبية أعضائه الحاضرين بالنسبة لمشاريع القوانين العادية أو بالأغلبية المطلقة بالنسبة لمشاريع القوانين العضوية. وفي حالة حدوث خلاف بين الغرفتين ، يطلب الوزير الأول اجتماع لجنة متساوية الأعضاء تتكون من أعضاء في كلتا الغرفتين، في أجل أقصاه خمسة عشر (15) يوما، لاقتراح نص يتعلق بالأحكام محل الخلاف. وتنهي اللجنة نقاشاتها في أجل أقصاه خمسة عشر (15) يوما. تعرض الحكومة هذا النص على الغرفتين للمصادقة عليه، ولا يمكن إدخال أي تعديل عليه إلا بموافقة الحكومة. وفي حالة استمرار الخلاف بين الغرفتين ، يمكن الحكومة أن تطلب من المجلس الشعبي الوطني الفصل نهائيا. وفي هذه الحالة يأخذ المجلس الشعبي الوطني بالنص الذي أعدته اللجنة المتساوية الأعضاء، أو، إذا تعذر ذلك، بالنص الأخير الذي صوت عليه. ويسحب النص إذا لم تخطر الحكومة المجلس الشعبي الوطني طبقا للفقرة السابقة. يصادق البرلمان على قانون المالية في مدة أقصاها خمسة وسبعون يوما (75) من تاريخ إيداعه، طبقا للفقرات السابقة. وفي حالة عدم المصادقة عليه في الأجل المحدد سابقا ، يصدر رئيس الجمهورية مشروع الحكومة بأمر . تحدد الإجراءات الأخرى بموجب القانون العضوي المذكور في المادة 132 من الدستور."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_138> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2016-03-06/16-01#art_138> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2016-03-07"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2016-03-06/16-01#version_art_139> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2016-03-06/16-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يقبل اقتراح أي قانون، مضمونه أو نتيجته تخفيض الموارد العمومية، أو زيادة النفقات العمومية، إلا إذا كان مرفوقا بتدابير تستهدف الزيادة في إيرادات الدولة، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي على الأقل المبالغ المقترح إنفاقها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2016-03-06/16-01#version_art_139_20160307_OpEnact_866f0abda4> ;
    dzdoc:replacementText "لا يقبل اقتراح أي قانون، مضمونه أو نتيجته تخفيض الموارد العمومية، أو زيادة النفقات العمومية، إلا إذا كان مرفوقا بتدابير تستهدف الزيادة في إيرادات الدولة، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي على الأقل المبالغ المقترح إنفاقها ."@ar ;
