<https://legal.dz/resource/law/1983-07-02/83-11#version_art_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تشمل الاداءات العينية للتأمين على المرض المصاريف التالية : العلاج الجراحة، الادوية الاقامة بالمستشفى. الفحوص البيولوجية والكهروديوغرافية. والمجوافية، والنظيرية علاج الاسنان واستغلافها الاصطناعي النظارات الطبية المعالجات بالمياه المعدنية والمتخصصة الاجهزة والاعضاء الاصطناعية ب الجبارة الفكية والوجهية اعادة التدريب الوظيفي للاعضاء اعادة التأهيل المهني النقل بسيارة الاسعاف أو غيرها من وسائل النقل عندما تستلزم حالة المريض ذلك ، ويمكن اتمام قائمة المصاريف الواردة في هذه المادة بموجب مرسوم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_8_19830702_OpEnact_1eee5899ca> ;
    dzdoc:replacementText "تشمل الاداءات العينية للتأمين على المرض المصاريف التالية : العلاج الجراحة، الادوية الاقامة بالمستشفى. الفحوص البيولوجية والكهروديوغرافية. والمجوافية، والنظيرية علاج الاسنان واستغلافها الاصطناعي النظارات الطبية المعالجات بالمياه المعدنية والمتخصصة الاجهزة والاعضاء الاصطناعية ب الجبارة الفكية والوجهية اعادة التدريب الوظيفي للاعضاء اعادة التأهيل المهني النقل بسيارة الاسعاف أو غيرها من وسائل النقل عندما تستلزم حالة المريض ذلك ، ويمكن اتمام قائمة المصاريف الواردة في هذه المادة بموجب مرسوم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_8> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_8> ;
