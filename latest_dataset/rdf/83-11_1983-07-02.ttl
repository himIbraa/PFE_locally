<https://legal.dz/resource/law/1983-07-02/83-11#version_art_37> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يساوى المبلغ السنوى للمعاش المدفوع للعجزة من الصنف الأول %60 منع الاجر السنوي المتوسط للمنصب الذي يحسب بالرجوع الى : اما إلى أخر أجر سنوى تم تقاضيه واما إلى الاجر السنوى المتوسط للثلاث سنوات حيث بلغ أجر المعنى بالأمر أقصاء خلال حياته المهنية، اذا كان هذا الاجر هو أحسن مواتاة له . وعندما لا تتم للمعنى بالامر ثلاث سنوات من التأمين ، يحسب المعاش حسب الاجر السنوى المتوسط المناسب لفترات العمل التي أداها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_37_19830702_OpEnact_ed7cf7e00b> ;
    dzdoc:replacementText "يساوى المبلغ السنوى للمعاش المدفوع للعجزة من الصنف الأول %60 منع الاجر السنوي المتوسط للمنصب الذي يحسب بالرجوع الى : اما إلى أخر أجر سنوى تم تقاضيه واما إلى الاجر السنوى المتوسط للثلاث سنوات حيث بلغ أجر المعنى بالأمر أقصاء خلال حياته المهنية، اذا كان هذا الاجر هو أحسن مواتاة له . وعندما لا تتم للمعنى بالامر ثلاث سنوات من التأمين ، يحسب المعاش حسب الاجر السنوى المتوسط المناسب لفترات العمل التي أداها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_37> ;
