    dzdoc:references <https://legal.dz/resource/law/1983-07-02/83-11#art_22> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1983-07-02/83-11#art_22> ;
    dzdoc:usesTerm dzterm:maternity_allowance .

<https://legal.dz/resource/law/1983-07-02/83-11#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_3_subsec_الاول> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "يقدر مدى العجز باعتبار ما بقي من قدرة المؤمع له على العمل وحالته العامة وعمره وقواه البدنية والعقلية وكذا مؤهلاته وتكوينه المهني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_33_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_33_19830702_OpEnact_c6d5c9c426> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "33" ;
    dzdoc:position 23 ;
    dzdoc:usesTerm dzterm:insured .

<https://legal.dz/resource/law/1983-07-02/83-11#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_3_subsec_2> ;
