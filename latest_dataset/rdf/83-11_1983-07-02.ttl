    dznorm:provisionText "كما يستفيد الاشخاص المذكورين أعلاه من الاداءات التقديم المتمثلة في منحة الوفاة والعجز"@ar ;
    dznorm:sourceArticle "chp_2_chp_2_sec_3_chp_2_sec_3_subsec_2_art_4" .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_4_art_30_para_0> a dzdoc:Paragraph ;
