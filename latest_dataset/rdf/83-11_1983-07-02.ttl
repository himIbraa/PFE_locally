<https://legal.dz/resource/law/1983-07-02/83-11#version_art_65> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد مبلغ المشاركة الجزافية لهيئات الضمان الاجتماعي في نفقات القطاعات الصحية والمؤسسات الاستشفائية المتخصصة بموجب مرسوم يتخذ بناء على تقرير مشترك من الوزير المكلف بالضمان الاجتماعي و الوزير المكلف بالصحة و الوزير المكلف بالمالية ، في اطار قانون المالية السنوى. يحدد المبلغ المشار اليه في الفقرة أعلاه حسب تطور التكاليف الصحية وعدد المؤمنين لهم اجتماعيا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_65_19830702_OpEnact_2ffd594446> ;
    dzdoc:replacementText "يحدد مبلغ المشاركة الجزافية لهيئات الضمان الاجتماعي في نفقات القطاعات الصحية والمؤسسات الاستشفائية المتخصصة بموجب مرسوم يتخذ بناء على تقرير مشترك من الوزير المكلف بالضمان الاجتماعي و الوزير المكلف بالصحة و الوزير المكلف بالمالية ، في اطار قانون المالية السنوى. يحدد المبلغ المشار اليه في الفقرة أعلاه حسب تطور التكاليف الصحية وعدد المؤمنين لهم اجتماعيا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_65> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
