    dzdoc:number "المادة 49" ;
    dzdoc:position 39 ;
    dzdoc:usesTerm dzterm:death_grant .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:definesTerm dzterm:beneficiaries ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_5_subsec_3> ;
    dzdoc:eId "chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67" ;
    dzdoc:fullText "يقصد بذوى الحقوق : (1) زوج المؤمن له، غير أنه لا تغول الاستفادة من الاداءات العينية للزوج اذا كان يمارس نشاطا مهنيا مأجورا ، اذا كان الزوج نفسه أجيرا يمكن أن يستفيد من الاداءات بصفته صاحب الحق ان كان لا يستوفى شروط تحويل الحقوق بحكم نشاطه . (2) الاولاد المكفولين كما هم محدودن في التنظيم المتعلق بالضمان الاجتماعي والذين يقل عمرهم عن الثامنة عشرة سنة. و يعتبر أيضا أولاد مكفولون : الاولاد الذين يقل عمرهم عن الواحد- والعشرين سنة وأبرم بشأنهم عقد تمهين يقضى بمنحهم أجرا يقل عن نصف الاجر الوطني الادني المضمون. الاولاد الذين يقل عمرهم عن الواحد- والعشرين سنة ويواصلون الدراسة، وفي حالة اذا بدأ العلاج الطبي قبل سن الواحدة والعشرين لا يعتد بشرط السن قبل نهاية العلاج . البنات دون دخل أيا كان عمر هن. الاولاد أيا كان عمرهم والذين تتعذر عليهم ممارسة نشاط ما مأجور بسبب عامة أو مرض مزمن. ويعد باقين على صفة ذوى الحقوق الاولاد الذين يستوفون شروط السه المطلوبة ووجب عليهم الانقطاع عن التمهين أو الدراسة بحكم حالتهم الصحية. (3) أصول المؤمن له أو أصول زوجه المكفولين لما لا تتجاوز مواردهم الشخصية المبلخ الادنى معاش التقاعد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_permission_0_bda6e371> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_defocc_f37f7ad356ea> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_para_1>,
        <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_para_2>,
        <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_19830702_OpEnact_c2b908502f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 67" ;
    dzdoc:position 55 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_condition_0_b13a56ff>,
        <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_condition_1_233c0468>,
        <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_condition_2_2ba08135>,
        <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_condition_3_bfc1bf02> .

<https://legal.dz/resource/law/1983-07-02/83-11#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_2> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "لا يجوز منح أداءات التأمين على الولادة مالم يتم الوضع على يد طبيب أو مساعدين طبيين مؤهليه ، ما عدا ما خالف ذلك الاسباب قاهرة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1983-07-02/83-11#art_24_permission_0_8ffb3b81> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_24_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_24_19830702_OpEnact_ddfca8cdcd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1983-07-02/83-11#art_24_obligation_0_d1a863f7> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/1983-07-02/83-11#art_24_prohibition_0_8ffb3b81> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 24" ;
    dzdoc:position 17 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_24_condition_0_e6f28bdf> ;
    dzdoc:usesTerm dzterm:maternity_insurance_benefits .

<https://legal.dz/resource/law/1983-07-02/83-11#art_85> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_5> ;
    dzdoc:eId "art_85" ;
    dzdoc:fullText "لا يجوز لهيئات الضمان الاجتماعي أن تعتد بعدم وفاء أصحاب العملى بالالتزامات الملقاة على هاتفهم، لرفض تقديم الاداءات للمؤمرع له الذي يستوفى الشروط المنشئة للحقوق . عندما لا يعفى اصحاب العمل بالتزاماتهم ، يتعين على هيئات الصمان الاجتماعي تقديم الاداءات للمؤمن له ثم تتولى مطالية هؤلاء بعد ذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1983-07-02/83-11#art_85_permission_0_630c86e6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_85> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_85_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_85_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_85_19830702_OpEnact_802d7a7852> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1983-07-02/83-11#art_85_obligation_0_1e77c6fa>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_85_obligation_1_74c1931f> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/1983-07-02/83-11#art_85_prohibition_0_630c86e6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "85" ;
    dzdoc:position 73 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_85_condition_0_3ef9663d> .

<https://legal.dz/resource/law/1983-07-02/83-11#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_الاول_subsec_الاول> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "تشمل الاداءات العينية للتأمين على المرض المصاريف التالية : العلاج الجراحة، الادوية الاقامة بالمستشفى. الفحوص البيولوجية والكهروديوغرافية. والمجوافية، والنظيرية علاج الاسنان واستغلافها الاصطناعي النظارات الطبية المعالجات بالمياه المعدنية والمتخصصة الاجهزة والاعضاء الاصطناعية ب الجبارة الفكية والوجهية اعادة التدريب الوظيفي للاعضاء اعادة التأهيل المهني النقل بسيارة الاسعاف أو غيرها من وسائل النقل عندما تستلزم حالة المريض ذلك ، ويمكن اتمام قائمة المصاريف الواردة في هذه المادة بموجب مرسوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_8_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_8_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_8_19830702_OpEnact_1eee5899ca> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 8" ;
    dzdoc:position 6 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_8_condition_0_a4c546b2> ;
    dzdoc:usesTerm dzterm:benefits .

<https://legal.dz/resource/law/1983-07-02/83-11#art_26> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_26" ;
    dzdoc:fullText "تعوض المصاريف المتعلقة بالتأمين على الولادة وفقا للشروط التالية : (1) تعوض المصاريف الطبية والصيدلية على أساس %100 من التعريفات المحددة عن طريق التنظيم . (2) تعوض مصاريف اقامة الام والمولود في المستشفى على نفس الاساس لمدة أقصاها ثمانية أيام ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_26> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_26_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_26_19830702_OpEnact_4b464d4ab4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1983-07-02/83-11#art_26_obligation_0_ded16ac5>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_26_obligation_1_ea7699d4>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_26_obligation_2_28671381> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 26" ;
    dzdoc:position 18 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_26_condition_0_9c4a1d98> .

<https://legal.dz/resource/law/1983-07-02/83-11#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_4> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "يقدر مبلغ منحة الوفاة بأثني عشرة مرة مبلغ آخر أجر شهرى في المنصب. لا يجوز في أي حال من الاحوال أن يقل هذا المبلغ اثني عشرة مرة قيمة المبلغ الشهري للأجر الوطني الأدنى المضمون . تدفع منحة الوفاة دفعة واحدة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1983-07-02/83-11#art_48_permission_0_29851f04> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_48_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_48_para_1>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_48_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_48_19830702_OpEnact_0738b346db> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1983-07-02/83-11#art_48_obligation_0_87da49c7> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/1983-07-02/83-11#art_48_prohibition_0_29851f04> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 48" ;
    dzdoc:position 38 ;
    dzdoc:usesTerm dzterm:death_grant .

<https://legal.dz/resource/law/1983-07-02/83-11#art_67> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:definesTerm dzterm:beneficiaries ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_5_subsec_2> ;
    dzdoc:eId "art_67" ;
    dzdoc:fullText "يقصد بذوى الحقوق : (1) زوج المؤمن له، غير أنه لا تغول الاستفادة من الاداءات العينية للزوج اذا كان يمارس نشاطا مهنيا مأجورا ، اذا كان الزوج نفسه أجيرا يمكن أن يستفيد من الاداءات بصفته صاحب الحق ان كان لا يستوفى شروط تحويل الحقوق بحكم نشاطه . (2) الاولاد المكفولين كما هم محدودن في التنظيم المتعلق بالضمان الاجتماعي والذين يقل عمرهم عن الثامنة عشرة سنة. و يعتبر أيضا أولاد مكفولون : الاولاد الذين يقل عمرهم عن الواحد- والعشرين سنة وأبرم بشأنهم عقد تمهين يقضى بمنحهم أجرا يقل عن نصف الاجر الوطني الادني المضمون. الاولاد الذين يقل عمرهم عن الواحد- والعشرين سنة ويواصلون الدراسة، وفي حالة اذا بدأ العلاج الطبي قبل سن الواحدة والعشرين لا يعتد بشرط السن قبل نهاية العلاج . البنات دون دخل أيا كان عمر هن. الاولاد أيا كان عمرهم والذين تتعذر عليهم ممارسة نشاط ما مأجور بسبب عامة أو مرض مزمن. ويعد باقين على صفة ذوى الحقوق الاولاد الذين يستوفون شروط السه المطلوبة ووجب عليهم الانقطاع عن التمهين أو الدراسة بحكم حالتهم الصحية. (3) أصول المؤمن له أو أصول زوجه المكفولين لما لا تتجاوز مواردهم الشخصية المبلخ الادنى معاش التقاعد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1983-07-02/83-11#art_67_permission_0_bda6e371> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_67> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1983-07-02/83-11#art_67_defocc_386307f5598e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_67_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_67_para_1>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_67_para_2>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_67_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_67_19830702_OpEnact_c607361312> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 67" ;
    dzdoc:position 50 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_67_condition_0_b13a56ff>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_67_condition_1_233c0468>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_67_condition_2_2ba08135>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_67_condition_3_bfc1bf02> .

