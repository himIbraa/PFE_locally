    dzdoc:sourceTextSpan "يستفيد من الاداءات العينية : الاشخاص الطبيعيون غير الاجراء الذين يمارسون بالفعل الحسابهم الخاص نشاطا حرا صناعيا أو تجاريا أو حرفيا أو فلاحيا أو أي نشاط آخر مماثل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_3_chp_2_sec_3_subsec_2_art_4> .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_3_chp_2_sec_3_subsec_2_art_4_right_1_e6f4f32b> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_3_chp_2_sec_3_subsec_2_art_4> ;
