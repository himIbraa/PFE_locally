    dzdoc:eId "art_30" ;
    dzdoc:fullText "تطبق أحكام المادة 22 أعلاه، على التعويضة اليومية للتأمين على الولادة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_30> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_30_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
