<https://legal.dz/resource/law/1983-07-02/83-11#art_18_obligation_0_3f36e1b3> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/1983-07-02/83-11#art_18_obligation_0_3f36e1b3_action_71afc6395c> ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_18> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب أن تشعن هيئة الضمان الاجتماعي في ظرف أجل يحدد عن طريق التنظيم بكل مرض يمترى العامل من شأنه أن يخول له الحق في تعويضة يومية"@ar ;
    dznorm:sourceArticle "art_18" .

