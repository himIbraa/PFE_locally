    dzdoc:position 13 .

<https://legal.dz/resource/law/1983-07-02/83-11#art_35> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_3_subsec_الاول> ;
    dzdoc:eId "art_35" ;
    dzdoc:fullText "عند القضاء المدة التي قدمت خلالها الاداءات النقدية للتأميع على المرض تتولى هيئة الضمان الاجتماعي تلقائيا النظر في الحقوق من باب التأمين على العجز دون انتظار الطلب من المعنى بالامر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_35> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_35_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_35_19830702_OpEnact_b77c7e018f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1983-07-02/83-11#art_35_obligation_0_8fe4f659> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "35" ;
    dzdoc:position 25 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_35_condition_0_b1d7c3f3> ;
    dzdoc:usesTerm dzterm:social_security_body .

<https://legal.dz/resource/law/1983-07-02/83-11#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "يصنف العجزة من حيث تحضير مبلغ المعاش الى ثلاثة أصناف : الصنف الأول : العجزة الذين ما زالوا قادرين على ممارسة نشاط ماجور الصنف الثاني : العجزة الذين يتعذر عليهم اطلاقا القيام بأي نشاط مأجور الصنف الثالث : العجزة الذين يتعذر عليهم اطلاق القيام بأي نشاط ماجور ويحتاجون الى مساعدة من غيرهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_36_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_36_19830702_OpEnact_90e9a6d4cb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "36" ;
    dzdoc:position 26 ;
    dzdoc:usesTerm dzterm:disabled,
        dzterm:disabled_class_1,
        dzterm:disabled_class_2,
        dzterm:disabled_class_3 .

<https://legal.dz/resource/law/1983-07-02/83-11#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_39" ;
    dzdoc:fullText "يساوى المبلغ السنوي لمعاش المجزة من الصنف الثالث /80 من الاجر المحدد في المادة 37 أعلاه، ويضاعف بنسبة %40 دون أن نقل الزيادة عن قدر أدنى يحدد عن المريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_39> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_39_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_39_19830702_OpEnact_29e78996eb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "39)" ;
    dzdoc:position 29 ;
    dzdoc:references <https://legal.dz/resource/law/1983-07-02/83-11#art_37> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1983-07-02/83-11#art_37> ;
    dzdoc:usesTerm dzterm:disabled_class_3 .

<https://legal.dz/resource/law/1983-07-02/83-11#art_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_الاول_subsec_الاول> ;
    dzdoc:eId "art_13" ;
    dzdoc:fullText "يجب ارسال الملف الطبي أو تقديمه الى هيئة الضمان الاجتماعي في ظرف الاشهر الثلاثة التالية للاجراء الطبي الاول ما لم يتعلق الامن بعلاج طبی مستمر، وفي هذه الحالة يجب تقديم الملف في ظرف ثلاثة أشهر بعد انتهاء هذا العلاج . يترتب عن عدم استيفاء الاجراءات المنصوص عليها في الفقرة السابقة سقوط الحق في الاداءات بالنسبة للفترة التي منعت خلالها هيئة الضمان الاجتماعي من ممارسة مراقبتها وذلك ما لم يثبت المستفيد حدوث أسباب قاهرة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_13> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_13_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_13_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_13_19830702_OpEnact_a777013ea8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1983-07-02/83-11#art_13_obligation_0_35a6dac3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 13" ;
    dzdoc:position 9 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_13_condition_0_d8985303>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_13_condition_1_e4f0f084> ;
    dzdoc:usesTerm dzterm:social_security_body .

<https://legal.dz/resource/law/1983-07-02/83-11#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_الاول_subsec_2> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "تدفع التعويضات المشار اليها في المادة 15 أعلاه، طوال مدة فترة أقصاها ثلاث (3) سنوات محسوبة، وفقا للشروط التالية : (1) اذا تعلق الامر بعلل طويلة الامد ، يجوز دفع التعويضة اليومية طوال فترة مدتها ثلاث (3) سنوات ومحسوية من تاريخ الى تاريخ عن كل علة . و في حالة توقف يتبعه استئناف للعمل يتاح أجل جديد مدته ثلاث (3) سنوات على أن تمن على هذا الاستئناف سنة على الاقل. (2) اذا تعلق الامر يعلل من غير العلل الطويلة الامد تدفع التعويضة اليومية ، على نحو يضمه طوال فترة ما مدتها سنتان متتالیتان يتقاضى فيها العامل ثلاثمائة تعويضة يومية على الأكثر وذلك على علة أو عدة علل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1983-07-02/83-11#art_16_permission_0_fdf18b50> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_16_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_16_para_1>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_16_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_16_19830702_OpEnact_21203a5777> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 16" ;
    dzdoc:position 11 ;
    dzdoc:references <https://legal.dz/resource/law/1983-07-02/83-11#art_15> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1983-07-02/83-11#art_15> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_16_condition_0_9d3ebced>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_16_condition_1_18be891b> ;
    dzdoc:usesTerm dzterm:daily_allowance .

<https://legal.dz/resource/law/1983-07-02/83-11#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_الاول> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "يستفيد من الاداءات العينية : الاشخاص الطبيعيون غير الاجراء الذين يمارسون بالفعل الحسابهم الخاص نشاطا حرا صناعيا أو تجاريا أو حرفيا أو فلاحيا أو أي نشاط آخر مماثل وفقا للشروط المحددة في التنظيم المعمول به . كما يستفيد الاشخاص المذكورين أعلاه من الاداءات التقديم المتمثلة في منحة الوفاة و العجز . وتحدد قائمة المستفيدين وكذا الشروط الخاصة لتطبيق هذه المادة بموجب مرسوم"@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1983-07-02/83-11#art_4_right_0_66a97b35>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_4_right_1_e6f4f32b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_4_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_4_para_1>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_4_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_4_19830702_OpEnact_3c79dbe48a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 4" ;
    dzdoc:position 2 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_4_condition_0_d9f452d6> ;
    dzdoc:usesTerm dzterm:benefits_in_kind,
        dzterm:death_grant,
        dzterm:disability_grant,
        dzterm:natural_persons .

<https://legal.dz/resource/law/1983-07-02/83-11#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_4> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "يستهدف التأمين على الوفاة افادة ذوي حقوق المؤمن له المتوفي المعرفين في المادة 67 أدناه، من منحة الوفاة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1983-07-02/83-11#art_47_right_0_f00ed131> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_47_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_47_19830702_OpEnact_8c2bb51ca0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 47" ;
    dzdoc:position 37 ;
    dzdoc:references <https://legal.dz/resource/law/1983-07-02/83-11#art_67> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1983-07-02/83-11#art_67> ;
    dzdoc:usesTerm dzterm:death_grant,
        dzterm:insurance_death,
        dzterm:insured .

<https://legal.dz/resource/law/1983-07-02/83-11#art_56> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_5_subsec_1> ;
    dzdoc:eId "art_56" ;
    dzdoc:fullText "يجب على المؤمن له لكي يؤول له الحق في التعويضات اليومية ل لتأمين على المرض فيما بعد الشهر السادس وكذا معاش المجز أن يكون قد عمل : اما ستة وثلاثين يوما أو أربعين ومانتي ساعة على الاقل أثناء الاثنتي عشر شهرا التي سبقت الانقطاع عن العمل وثبوت المجزء اما ثمانية ومائة يوما أو عشرين وسبعمائة ساعة على الاقل أثناء الثلاث سنوات التي سبقت الانقطاع من العمل أو ثبوت العجز."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_56> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_56_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_56_19830702_OpEnact_c7661bd870> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1983-07-02/83-11#art_56_obligation_0_b89be867> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 56" ;
    dzdoc:position 45 ;
    dzdoc:usesTerm dzterm:disability_pension,
        dzterm:insured,
        dzterm:sickness_insurance .

<https://legal.dz/resource/law/1983-07-02/83-11#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_5_subsec_2> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "يستفيد من نظام الدفع من قبل الغير، كل المؤمنين لهم اجتماعيا وذوي حقوقهم الذين يقصدون الاطباء ومؤدو الخدمات شبه الطبية والمؤسسات الصحية الخاصة والصيدليات الخاصة أو العمومية الذين تربطهم اتفاقيات مع هيئات الضمان الاجتماعي . ويجب على الصيدليات العمومية أن تبرم اتفاقيات مع هيئات الضمان الاجتماعي . وتحدد اتفاقيات نموذجية عن طريق التنظيم لكي تتقيد بأحكامها الاتفاقيات المنصوص عليها في هذه المادة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1983-07-02/83-11#art_60_right_0_82e8ebd6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_60_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_60_para_1>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_60_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_60_19830702_OpEnact_588efea314> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1983-07-02/83-11#art_60_obligation_0_3272d2a0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 60" ;
    dzdoc:position 49 ;
    dzdoc:usesTerm dzterm:insured,
        dzterm:social_security_body .

<https://legal.dz/resource/law/1983-07-02/83-11#art_مو> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:definesTerm dzterm:assistance_fund ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_5> ;
    dzdoc:eId "art_مو" ;
    dzdoc:fullText "ينشأ صندوق للمساعدة والاسعاف يخصص المنح في بعض الحالات الاستثنائية امتيازات للمؤمنة لهم اجتماعيا ولذوى حقوقهم : هندما لا يستوفي المعنيون الشروط التي تخول لهم الاستفادة من أداءات التأمين الاجتماعي عندما يكون من ذوي الدخل المحدود . يول صندوق المساعدة والاسعاف يجزء من اشتركات الضمان الاجتماعي. تمنح الامتيازات من طرف لجنة تعمل ضمي هيئات الضمان الاجتماعي وتسالف من ممثلى المؤمنين لهم اجتماعيا. تحدد طبيعة الامتيازات الممنوحة من صندوق المساعدة والاسعاف ومبلنها وقواعد منحها بموجب"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_مو> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1983-07-02/83-11#art_مو_defocc_da2987b76d02> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_مو_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_مو_para_1>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_مو_para_2>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_مو_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_19830702_OpEnact_a2f5ec9353> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "90" ;
    dzdoc:position 77 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_مو_condition_0_af576550>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_مو_condition_1_07fa6ce1> ;
    dzdoc:usesTerm dzterm:social_security_bodies .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_3_chp_2_sec_3_subsec_2_art_4> a dzdoc:Article ;
