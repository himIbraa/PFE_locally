<https://legal.dz/resource/law/1983-07-02/83-11#version_art_56> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المؤمن له لكي يؤول له الحق في التعويضات اليومية ل لتأمين على المرض فيما بعد الشهر السادس وكذا معاش المجز أن يكون قد عمل : اما ستة وثلاثين يوما أو أربعين ومانتي ساعة على الاقل أثناء الاثنتي عشر شهرا التي سبقت الانقطاع عن العمل وثبوت المجزء اما ثمانية ومائة يوما أو عشرين وسبعمائة ساعة على الاقل أثناء الثلاث سنوات التي سبقت الانقطاع من العمل أو ثبوت العجز."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_56_19830702_OpEnact_c7661bd870> ;
    dzdoc:replacementText "يجب على المؤمن له لكي يؤول له الحق في التعويضات اليومية ل لتأمين على المرض فيما بعد الشهر السادس وكذا معاش المجز أن يكون قد عمل : اما ستة وثلاثين يوما أو أربعين ومانتي ساعة على الاقل أثناء الاثنتي عشر شهرا التي سبقت الانقطاع عن العمل وثبوت المجزء اما ثمانية ومائة يوما أو عشرين وسبعمائة ساعة على الاقل أثناء الثلاث سنوات التي سبقت الانقطاع من العمل أو ثبوت العجز."@ar ;
