<https://legal.dz/resource/law/1983-07-02/83-11#version_art_54> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المؤمن له لكي يؤول له الحق في أداءات التأمين على الولادة وليتشنه في اطار المادة 20 أعلاه أن يكون قد عمل : اما تسعة أيام أو ستين ساعة على الأقل أثناء الثلاثة أشهر التي سبقت تاريخ الاداءات العينية المطلوب تعويضها. اما ستة وثلاثين يوما أو أربعين ومائتي ساعة على الاقل أثناء الاثنتي عشن شهرا التي سبقت تاريخ الاداءات العينية المطلوب تعويضها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_54_19830702_OpEnact_67b1ccd121> ;
    dzdoc:replacementText "يجب على المؤمن له لكي يؤول له الحق في أداءات التأمين على الولادة وليتشنه في اطار المادة 20 أعلاه أن يكون قد عمل : اما تسعة أيام أو ستين ساعة على الأقل أثناء الثلاثة أشهر التي سبقت تاريخ الاداءات العينية المطلوب تعويضها. اما ستة وثلاثين يوما أو أربعين ومائتي ساعة على الاقل أثناء الاثنتي عشن شهرا التي سبقت تاريخ الاداءات العينية المطلوب تعويضها."@ar ;
