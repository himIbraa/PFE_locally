<https://legal.dz/resource/law/1983-07-02/83-11#art_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_الاول_subsec_2> ;
    dzdoc:eId "art_20" ;
    dzdoc:fullText "تحدد قائمة الملل الطويلة الأمد عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_20> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_20_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_20_19830702_OpEnact_7a1ff6cf8d> ;
