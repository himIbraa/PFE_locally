<https://legal.dz/resource/law/1983-07-02/83-11#version_art_92> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتولى هيئات الضمان الاجتماعي القيام بأعمال تتمثل في اقامة مرافق ذات النفع الصحي والاجتماعي لافادة العمال وذوى حقوقهم بالاداءات الجماعية ويتم ذلك في اطار المخطط الستوى وطبقا للاجراءات الجارى بها العمل في مجال الاستثمارات المخططة. وتحدد مختلف اشکال الخدمة الصحية والاجتماعية الهيئات المسمان الاجتماعي بموجب مرسوم."@ar ;
    dzdoc:isAuthoritative true ;
