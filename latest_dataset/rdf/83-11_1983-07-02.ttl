    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_chp_2_chp_2_sec_3_chp_2_sec_3_subsec_2_art_4_19830702_OpEnact_941abf5812> ;
