<https://legal.dz/resource/law/1983-07-02/83-11#version_art_و> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكفل مصاريف تنقل المؤمع له أو دوی حقوقه أو مرافقه اذا ما اقتضى الأمر ذلك حسب الشروط المحددة بموجب التنظيم في حالة استدعاء من المراقبة الطبية لهيئة الضمان الاجتماعي أو طبيب خبير أو عندما يجب تقديم العلاج في مؤسسة صحية غير التي توجد في مقر اقامته ."@ar ;
