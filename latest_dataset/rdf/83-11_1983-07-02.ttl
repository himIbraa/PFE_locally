<https://legal.dz/resource/law/1983-07-02/83-11#version_art_60> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يستفيد من نظام الدفع من قبل الغير، كل المؤمنين لهم اجتماعيا وذوي حقوقهم الذين يقصدون الاطباء ومؤدو الخدمات شبه الطبية والمؤسسات الصحية الخاصة والصيدليات الخاصة أو العمومية الذين تربطهم اتفاقيات مع هيئات الضمان الاجتماعي . ويجب على الصيدليات العمومية أن تبرم اتفاقيات مع هيئات الضمان الاجتماعي . وتحدد اتفاقيات نموذجية عن طريق التنظيم لكي تتقيد بأحكامها الاتفاقيات المنصوص عليها في هذه المادة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_60_19830702_OpEnact_588efea314> ;
    dzdoc:replacementText "يستفيد من نظام الدفع من قبل الغير، كل المؤمنين لهم اجتماعيا وذوي حقوقهم الذين يقصدون الاطباء ومؤدو الخدمات شبه الطبية والمؤسسات الصحية الخاصة والصيدليات الخاصة أو العمومية الذين تربطهم اتفاقيات مع هيئات الضمان الاجتماعي . ويجب على الصيدليات العمومية أن تبرم اتفاقيات مع هيئات الضمان الاجتماعي . وتحدد اتفاقيات نموذجية عن طريق التنظيم لكي تتقيد بأحكامها الاتفاقيات المنصوص عليها في هذه المادة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
