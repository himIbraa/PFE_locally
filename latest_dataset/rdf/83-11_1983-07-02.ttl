    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يقصد بذوى الحقوق :
              
              
              (1) زوج المؤمن له، غير أنه لا تغول الاستفادة من الاداءات العينية للزوج اذا كان يمارس نشاطا مهنيا مأجورا، اذا كان الزوج نفسه أجيرا يمكن أن يستفيد من الاداءات بصفته صاحب الحق ان كان لا يستوفى شروط تحويل الحقوق بحكم نشاطه.
              
              
              (2) الاولاد المكفولين كما هم محدودن في التنظيم المتعلق بالضمان الاجتماعي والذين يقل عمرهم عن الثامنة عشرة سنة."""@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> ;
    dzdoc:position 0 ;
    dzdoc:text "يقصد بذوى الحقوق : (1) زوج المؤمن له، غير أنه لا تغول الاستفادة من الاداءات العينية للزوج اذا كان يمارس نشاطا مهنيا مأجورا، اذا كان الزوج نفسه أجيرا يمكن أن يستفيد من الاداءات بصفته صاحب الحق ان كان لا يستوفى شروط تحويل الحقوق بحكم نشاطه. (2) الاولاد المكفولين كما هم محدودن في التنظيم المتعلق بالضمان الاجتماعي والذين يقل عمرهم عن الثامنة عشرة سنة."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#preamble_segment_0> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#preamble> ;
    dzdoc:position 0 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "ان رئيس الجمهورية"@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#preamble_segment_1> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#preamble> ;
    dzdoc:position 1 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "بناء على الميثاق الوطني، ولاسيما الباب السادس - خامسا - 7 منه،"@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#preamble_segment_2> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#preamble> ;
    dzdoc:position 2 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبناء على الدستور، لاسيما المواد 15 و 154 و 155 منه ،"@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#preamble_segment_3> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#preamble> ;
    dzdoc:position 3 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "و بمقتضى القانون رقم 78 - 12 المؤرخ في أول رمضان عام 1398 الموافق 5 غشت سنة 1978 المتضمن القانون الأساسي العام للعامل، ولاسيما المواد 9 و 129 و 143 و 146 ومن 187 الى 198 و 212 و 216"@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#preamble_segment_4> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#preamble> ;
    dzdoc:position 4 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبمقتضى الأمر رقم 74 - 8 المؤرخ في 6 محرم عام 1394 الموافق 30 يناير سنة 1974 والمتعلق بوصاية هيئات الضمان الاجتماعي"@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#preamble_segment_5> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#preamble> ;
    dzdoc:position 5 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "و بناء على ما أقره المجلس الشعبي الوطني،"@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_13_19830702_OpEnact_a777013ea8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_13> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_13> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_13> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يجب ارسال الملف الطبي أو تقديمه الى هيئة الضمان الاجتماعي في ظرف الاشهر الثلاثة التالية للاجراء الطبي الاول ما لم يتعلق الامن بعلاج طبی مستمر، وفي هذه الحالة يجب تقديم الملف في ظرف ثلاثة أشهر بعد انتهاء هذا العلاج . يترتب عن عدم استيفاء الاجراءات المنصوص عليها في الفقرة السابقة سقوط الحق في الاداءات بالنسبة للفترة التي منعت خلالها هيئة الضمان الاجتماعي من ممارسة مراقبتها وذلك ما لم يثبت المستفيد حدوث أسباب قاهرة ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_15_19830702_OpEnact_6e485a6e76> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_15> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_15> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_15> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تستحق التعويضة اليومية عن كل يوم عمل أو راحة ، على ألا تتجاوز قدر واحد من ثلاثين من أجر المنصب الشهري، المتقاضي ، وهو ما يؤخذ أساسا لحساب أداءات التأمينات الاجتماعية ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_16_19830702_OpEnact_21203a5777> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_16> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_16> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_16> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تدفع التعويضات المشار اليها في المادة 15 أعلاه، طوال مدة فترة أقصاها ثلاث (3) سنوات محسوبة، وفقا للشروط التالية : (1) اذا تعلق الامر بعلل طويلة الامد ، يجوز دفع التعويضة اليومية طوال فترة مدتها ثلاث (3) سنوات ومحسوية من تاريخ الى تاريخ عن كل علة . و في حالة توقف يتبعه استئناف للعمل يتاح أجل جديد مدته ثلاث (3) سنوات على أن تمن على هذا الاستئناف سنة على الاقل. (2) اذا تعلق الامر يعلل من غير العلل الطويلة الامد تدفع التعويضة اليومية ، على نحو يضمه طوال فترة ما مدتها سنتان متتالیتان يتقاضى فيها العامل ثلاثمائة تعويضة يومية على الأكثر وذلك على علة أو عدة علل."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_18_19830702_OpEnact_70e7123f0f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_18> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_18> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_18> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يجب أن تشعن هيئة الضمان الاجتماعي في ظرف أجل يحدد عن طريق التنظيم بكل مرض يمترى العامل من شأنه أن يخول له الحق في تعويضة يومية ، الا اذا حالت أسباب قاهرة دون ذلك . و يمكن أن تترتب عن عدم مراعاة هذا الاجراء عقوبات قد تؤدى الى سقوط الحق في التعويضات اليومية بالنسبة للمدة التي منعت أثناءها هيئة الفتمان الاجتماعي من اجراء المراقبة بسبب عدم التصريح."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_19830702_OpEnact_21e90f2002> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_و> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_و> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_و> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تكفل مصاريف تنقل المؤمع له أو دوی حقوقه أو مرافقه اذا ما اقتضى الأمر ذلك حسب الشروط المحددة بموجب التنظيم في حالة استدعاء من المراقبة الطبية لهيئة الضمان الاجتماعي أو طبيب خبير أو عندما يجب تقديم العلاج في مؤسسة صحية غير التي توجد في مقر اقامته ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_19830702_OpEnact_8935a30fad> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_الاولى> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_الاولى> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_الاولى> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يهدف هذا القانون الى انشاء نظام وحيد للتأمينات الاجتماعية ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_19830702_OpEnact_a2f5ec9353> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_مو> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_مو> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_مو> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "ينشأ صندوق للمساعدة والاسعاف يخصص المنح في بعض الحالات الاستثنائية امتيازات للمؤمنة لهم اجتماعيا ولذوى حقوقهم : هندما لا يستوفي المعنيون الشروط التي تخول لهم الاستفادة من أداءات التأمين الاجتماعي عندما يكون من ذوي الدخل المحدود . يول صندوق المساعدة والاسعاف يجزء من اشتركات الضمان الاجتماعي. تمنح الامتيازات من طرف لجنة تعمل ضمي هيئات الضمان الاجتماعي وتسالف من ممثلى المؤمنين لهم اجتماعيا. تحدد طبيعة الامتيازات الممنوحة من صندوق المساعدة والاسعاف ومبلنها وقواعد منحها بموجب"@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_19830702_OpEnact_df266cb721> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_هو> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_هو> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_هو> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تحدد كيفيات تطبيق هذا القانون عند الحاجة بموجب مرسوم"@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_20_19830702_OpEnact_7a1ff6cf8d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_20> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_20> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_20> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تحدد قائمة الملل الطويلة الأمد عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_21_19830702_OpEnact_722ae41c34> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_21> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_21> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_21> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يعاد النظر في قيمة التعويضات اليومية حسب تطور أجر منصب العمل."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_22_19830702_OpEnact_13ca2be03d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_22> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_22> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_22> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "لا يمكن أن يكون مبلغ التعويضة اليومية بنسية /100 أدني من 8 أضعاف المبلغ الصافي المعدل الساعات للاجر الوطني الادني المضمون ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_23_19830702_OpEnact_b6e5ca95d4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_23> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_23> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_23> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تشمل أداءات التأمين على الولادة : (1) الاداءات العينية : كفالة المصاريف المترتبة من الحمل والوضع وتبعاته. (2) الاداءات النقدية : دفع تعويضة يومية للمرأة العاملة التي تضطر بسبب الولادة الى الانقطاع من العمل."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_24_19830702_OpEnact_ddfca8cdcd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_24> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_24> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_24> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "لا يجوز منح أداءات التأمين على الولادة مالم يتم الوضع على يد طبيب أو مساعدين طبيين مؤهليه ، ما عدا ما خالف ذلك الاسباب قاهرة ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_26_19830702_OpEnact_4b464d4ab4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_26> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_26> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_26> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تعوض المصاريف المتعلقة بالتأمين على الولادة وفقا للشروط التالية : (1) تعوض المصاريف الطبية والصيدلية على أساس %100 من التعريفات المحددة عن طريق التنظيم . (2) تعوض مصاريف اقامة الام والمولود في المستشفى على نفس الاساس لمدة أقصاها ثمانية أيام ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_27_19830702_OpEnact_e552eb02e7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_27> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_27> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_27> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تحدد الشروط التي تجري وفقها الفحوص قبل الوضع وبعده وكذا المراقبة التي قد تجريها هيئة الضمان الاجتماعي قبل الولادة وبعدها، عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_30_19830702_OpEnact_7c5f49cbd9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_30> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_30> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_30> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تطبق أحكام المادة 22 أعلاه، على التعويضة اليومية للتأمين على الولادة ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_31_19830702_OpEnact_6c30d5c4c5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_31> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_31> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_31> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يستهدف التأمين على العجز ، منح معاش للمؤمن له الذي يضطره العجز إلى الانقطاع عن عمله ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_32_19830702_OpEnact_324588c086> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_32> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_32> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_32> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يكون ل لمؤمن له الحق في معاش العجز عندما يكون مصابا بعجز ذهب بنصف قدرته على العمل أو الكسب على الأقل ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_33_19830702_OpEnact_c6d5c9c426> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_33> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_33> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_33> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يقدر مدى العجز باعتبار ما بقي من قدرة المؤمع له على العمل وحالته العامة وعمره وقواه البدنية والعقلية وكذا مؤهلاته وتكوينه المهني."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_34_19830702_OpEnact_8c646fbf83> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_34> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_34> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_34> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "لا يقبل طلب معاش العجز الا اذا كان عمر المؤمن له أقل من السن التي تخول له الحق في التقاعد . غير أنه لا يعتد بشرط السن في حق المؤمن الذي لا يستوفي شروط مدة العمل للاستفادة من معاش التقاعد ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_35_19830702_OpEnact_b77c7e018f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_35> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_35> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_35> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "عند القضاء المدة التي قدمت خلالها الاداءات النقدية للتأميع على المرض تتولى هيئة الضمان الاجتماعي تلقائيا النظر في الحقوق من باب التأمين على العجز دون انتظار الطلب من المعنى بالامر ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_36_19830702_OpEnact_90e9a6d4cb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_36> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_36> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_36> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يصنف العجزة من حيث تحضير مبلغ المعاش الى ثلاثة أصناف : الصنف الأول : العجزة الذين ما زالوا قادرين على ممارسة نشاط ماجور الصنف الثاني : العجزة الذين يتعذر عليهم اطلاقا القيام بأي نشاط مأجور الصنف الثالث : العجزة الذين يتعذر عليهم اطلاق القيام بأي نشاط ماجور ويحتاجون الى مساعدة من غيرهم ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_37_19830702_OpEnact_ed7cf7e00b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_37> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_37> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_37> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يساوى المبلغ السنوى للمعاش المدفوع للعجزة من الصنف الأول %60 منع الاجر السنوي المتوسط للمنصب الذي يحسب بالرجوع الى : اما إلى أخر أجر سنوى تم تقاضيه واما إلى الاجر السنوى المتوسط للثلاث سنوات حيث بلغ أجر المعنى بالأمر أقصاء خلال حياته المهنية، اذا كان هذا الاجر هو أحسن مواتاة له . وعندما لا تتم للمعنى بالامر ثلاث سنوات من التأمين ، يحسب المعاش حسب الاجر السنوى المتوسط المناسب لفترات العمل التي أداها."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_38_19830702_OpEnact_5840027875> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_38> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_38> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_38> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يساوى المبلغ السنوى المعاش العجزة من الصنف الثاني 80% من الأجر المحدد في المادة السابقة ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_39_19830702_OpEnact_29e78996eb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_39> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_39> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_39> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يساوى المبلغ السنوي لمعاش المجزة من الصنف الثالث /80 من الاجر المحدد في المادة 37 أعلاه، ويضاعف بنسبة %40 دون أن نقل الزيادة عن قدر أدنى يحدد عن المريق التنظيم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_3_19830702_OpEnact_7a2452d9a7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_3> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_3> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_3> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يستفيد من أحكام هذا القانون، كل العمال سواء أكانوا أجراء أم ملحقي بالاجراء أيا كان قطاع النشاط الذي ينتمون اليه، والنظام الذي كان يسرى عليهم قبل تاريخ دخول هذا القانون حيز التطبيق . تطبق أحكام هذه المادة بموجب مرسوم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_40_19830702_OpEnact_8ec5b19646> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_40> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_40> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_40> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يستفيد كل من زوج صاحب معاش عجز توفي وأولاده وأصوله من معاش عجز منقول اليهم . و تطبق على ذوى الحقوق المذكورين في الفقرة أعلاه الاحكام المتملقة بمعاشات ذوى الحقوق في مجال التقاعد."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_42_19830702_OpEnact_6d09f66ae0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_42> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_42> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_42> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تراجع معاشات المجز حسب تطور النقطة الاستدلالية المعتمدة كأساس لحساب الاجر الاساسي للعمال."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_43_19830702_OpEnact_69c3ed5ad0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_43> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_43> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_43> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تدفع معاشات العجز والمعاشات المنقولة شهرها وعند حلول اجل الاستحقاق ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_44_19830702_OpEnact_f899de1393> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_44> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_44> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_44> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يمنح معاش العجز بصفة مؤقتة ويمكن أن يراجع أثر حدوث تغيير في حالة العجز ويلغى إذا ما ثبت بأن نسبة قدرة المستفيد على العمل تفوق 50 % ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_45_19830702_OpEnact_35320174da> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_45> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_45> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_45> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تلغى مستحقات معاش العجز المدفوع للمستفيدين المذكورين في المادتين 36 و 39 أعلاه، عند انقضاء شهر الاستحقاق الذي مارس خلاله المستفيدون نشاطا مأجورا ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_46_19830702_OpEnact_5e1baa6e70> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_46> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_46> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_46> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يستبدل معاش العجز عند بلوغ سن التقاعد ، بـ معاش تقاعد يعادل مبلغه معاش العجز على الأقل وتضاف إليه عند الاقتضاء الزيادة عن الزوج المكفول ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_47_19830702_OpEnact_8c2bb51ca0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_47> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_47> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_47> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يستهدف التأمين على الوفاة افادة ذوي حقوق المؤمن له المتوفي المعرفين في المادة 67 أدناه، من منحة الوفاة ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_48_19830702_OpEnact_0738b346db> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_48> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_48> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_48> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يقدر مبلغ منحة الوفاة بأثني عشرة مرة مبلغ آخر أجر شهرى في المنصب. لا يجوز في أي حال من الاحوال أن يقل هذا المبلغ اثني عشرة مرة قيمة المبلغ الشهري للأجر الوطني الأدنى المضمون . تدفع منحة الوفاة دفعة واحدة."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_49_19830702_OpEnact_b2ca1898ae> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_49> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_49> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_49> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تدفع منحة الوفاة لذوى حقوق الهالك ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_4_19830702_OpEnact_3c79dbe48a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_4> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_4> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_4> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يستفيد من الاداءات العينية : الاشخاص الطبيعيون غير الاجراء الذين يمارسون بالفعل الحسابهم الخاص نشاطا حرا صناعيا أو تجاريا أو حرفيا أو فلاحيا أو أي نشاط آخر مماثل وفقا للشروط المحددة في التنظيم المعمول به . كما يستفيد الاشخاص المذكورين أعلاه من الاداءات التقديم المتمثلة في منحة الوفاة و العجز . وتحدد قائمة المستفيدين وكذا الشروط الخاصة لتطبيق هذه المادة بموجب مرسوم"@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_53_19830702_OpEnact_d5d2d4cf10> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_53> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_53> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_53> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "ينشأ الحق في منحة الوفاة لذوى حقوق العامل ابتداء من اليوم الأول من مباشرة حمله الفعلي ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_54_19830702_OpEnact_67b1ccd121> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_54> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_54> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_54> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يجب على المؤمن له لكي يؤول له الحق في أداءات التأمين على الولادة وليتشنه في اطار المادة 20 أعلاه أن يكون قد عمل : اما تسعة أيام أو ستين ساعة على الأقل أثناء الثلاثة أشهر التي سبقت تاريخ الاداءات العينية المطلوب تعويضها. اما ستة وثلاثين يوما أو أربعين ومائتي ساعة على الاقل أثناء الاثنتي عشن شهرا التي سبقت تاريخ الاداءات العينية المطلوب تعويضها."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_55_19830702_OpEnact_b60f724724> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_55> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_55> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_55> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يجب على المؤم لها لكي يؤول لها الحق في الاداءات النقدية ل لتأمين على الولادة في إطار المادة 28 أعلاه أن تكون قد عملت : اما تسعة أيام أو ستين ساعة على الأقل أثناء الثلاثة أشهر التي سبقت تاريخ المعاينة الطبية الأولى للحمل اما ستة وثلاثين يوما أو أربعين ومائتي ساحة على الاقل أثناء الاثنتي عشر شهرا التي سبقت المعاينة الطبية الأولى للحمل."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_56_19830702_OpEnact_c7661bd870> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_56> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_56> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_56> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يجب على المؤمن له لكي يؤول له الحق في التعويضات اليومية ل لتأمين على المرض فيما بعد الشهر السادس وكذا معاش المجز أن يكون قد عمل : اما ستة وثلاثين يوما أو أربعين ومانتي ساعة على الاقل أثناء الاثنتي عشر شهرا التي سبقت الانقطاع عن العمل وثبوت المجزء اما ثمانية ومائة يوما أو عشرين وسبعمائة ساعة على الاقل أثناء الثلاث سنوات التي سبقت الانقطاع من العمل أو ثبوت العجز."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_57_19830702_OpEnact_c03bd8f6b4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_57> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_57> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_57> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "لا تطبق الشروط المحددة في المادة 56 أعلاه على المؤمه له في حالة مرض أو عجز ناتج عن اصابته بحادث."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_58_19830702_OpEnact_fb338706e8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_58> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_58> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_58> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تمد بمثابة ثماني ساعات منع العمل المأجور التقدير الحق في الاداءات : (1) كل يوم تقاضى فيه المؤمن له التعويضات اليومية ل لتأمين على المرض والولادة وحوادث العمل والامراض المهنية (2)كل يوم انقطع فيه من العمل بسبب مرض عندما يكون المؤمن له قد استنفذ حقوقه في التعويض كما جاء تعريفها في المادة 15 أعلاه، شريطة أن تقر هيئة الضمان الاجتماعي عدم قدرته البدنية على مواصلة عمله أو استئنافه . (3) كل يوم من أيام المعطلة القانونية المدفوعة う (4) كل يوم قضى في أداء التزامات الخدمة الوطنية أو في حالة التعبئة العامة."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_59_19830702_OpEnact_dcae8ff86c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_59> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_59> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_59> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "(1) مع مراعاة أحكام المادة 6 أدناه وفي القطاعات غير الهياكل الصحية العمومية يدفع مبلغ المصاريف المنصوص عليها في المادتين 8 و 26 مع هذا القانون من طرف المؤمن له وتسددها له هيئة الضمان الاجتماعي ، على أساس نسبة %80 من التعريفات المحددة عن طريق التنظيم . (2) تطبق أيضا هذه النسبة على الاستجمام والحمامات والاستجمامات المتخصصة مهما كانت طبيعة المؤسسة التي يتم فيها الاستجمام. (3) يتم تسديد المنتوجات الصيدلية القابلة للتسديد على أساس نسبة أقصاها %80، تحدد قائمة المنتوجات القابلة للتسديد وكذا نسب التسديد المماثلة عن طريق التنظيم. وفي انتظار صدور النصوص المشار إليها في الفقرة السابقة يتم التسديد بنسبة 50 %. (4) تحول نسب التسديد المنصوص عليها في الفقرتين 1 و 3 الى %100 في بعض الحالات باعتبار على الخصوص أما نوعية، أو أهمية، أو هدة العلاج المطلوب واما صفة صاحب المعاش أو الريع للضمان الاجتماعي. (5) تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_5_19830702_OpEnact_e43c515a3d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_5> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_5> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_5> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يستفيد ذوو حقوق صاحب معاش عجز أو تقاعد أو ريع حادث عمل كما جاء تعريفهم في المادة 67 أدناه، وفقا للشروط المنصوص عليها في المادتين 49 و 50 أعلاه من منحة وفاة يساوى مبلغها قيمة المبلغ السنوى لمعاش العجز أو معاش التقاعد أو ريع حادث عمل على ألا يقل هذا المبلغ من القيمة الدنيا المنصوص عليها في المادة 48 من هذا القانون ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_60_19830702_OpEnact_588efea314> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_60> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_60> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_60> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يستفيد من نظام الدفع من قبل الغير، كل المؤمنين لهم اجتماعيا وذوي حقوقهم الذين يقصدون الاطباء ومؤدو الخدمات شبه الطبية والمؤسسات الصحية الخاصة والصيدليات الخاصة أو العمومية الذين تربطهم اتفاقيات مع هيئات الضمان الاجتماعي . ويجب على الصيدليات العمومية أن تبرم اتفاقيات مع هيئات الضمان الاجتماعي . وتحدد اتفاقيات نموذجية عن طريق التنظيم لكي تتقيد بأحكامها الاتفاقيات المنصوص عليها في هذه المادة."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_62_19830702_OpEnact_fce477f3b3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_62> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_62> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_62> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تحدد القائمة العامة للاعمال المهنية عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_64_19830702_OpEnact_0f7e1ff993> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_64> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_64> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_64> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يمكن لهيئات الضمان الاجتماعي أن تقرر مع تحملها المصاريف اجراء فحوص طبية على المؤمنين لهم بواسطة طبيب. كما يمكن لها أن تجرى مراقبة على المؤمنين لهم بواسطة أحد ممثليها. واذا امتنع المؤمن له عن هذه الفحوص الطبية أو المراقبة المطلوبة أو عندما لا يمتثل للاستدعاء تسقط حقوقه في الاداءات بالنسبة للفترة حيث أعيقت المراقبة. تحدد الشروط التي تجرى وفقها المراقبة الطبية على المؤمنين لهم اجتماعيا عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_65_19830702_OpEnact_2ffd594446> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_65> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_65> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_65> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يحدد مبلغ المشاركة الجزافية لهيئات الضمان الاجتماعي في نفقات القطاعات الصحية والمؤسسات الاستشفائية المتخصصة بموجب مرسوم يتخذ بناء على تقرير مشترك من الوزير المكلف بالضمان الاجتماعي و الوزير المكلف بالصحة و الوزير المكلف بالمالية ، في اطار قانون المالية السنوى. يحدد المبلغ المشار اليه في الفقرة أعلاه حسب تطور التكاليف الصحية وعدد المؤمنين لهم اجتماعيا ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_66_19830702_OpEnact_5cd02e8e36> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_66> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_66> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_66> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يستفيد ذوو الحقوق المؤمن لهم اجتماعيا من الاداءات المشار اليها في المادتين 8 و 26 أعلاه، بالنسبة للزوج فقط، وفي المادة 8 أعلاه، بالنسبة للأولاد والاصول."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_67_19830702_OpEnact_c607361312> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_67> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_67> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_67> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يقصد بذوى الحقوق : (1) زوج المؤمن له، غير أنه لا تغول الاستفادة من الاداءات العينية للزوج اذا كان يمارس نشاطا مهنيا مأجورا ، اذا كان الزوج نفسه أجيرا يمكن أن يستفيد من الاداءات بصفته صاحب الحق ان كان لا يستوفى شروط تحويل الحقوق بحكم نشاطه . (2) الاولاد المكفولين كما هم محدودن في التنظيم المتعلق بالضمان الاجتماعي والذين يقل عمرهم عن الثامنة عشرة سنة. و يعتبر أيضا أولاد مكفولون : الاولاد الذين يقل عمرهم عن الواحد- والعشرين سنة وأبرم بشأنهم عقد تمهين يقضى بمنحهم أجرا يقل عن نصف الاجر الوطني الادني المضمون. الاولاد الذين يقل عمرهم عن الواحد- والعشرين سنة ويواصلون الدراسة، وفي حالة اذا بدأ العلاج الطبي قبل سن الواحدة والعشرين لا يعتد بشرط السن قبل نهاية العلاج . البنات دون دخل أيا كان عمر هن. الاولاد أيا كان عمرهم والذين تتعذر عليهم ممارسة نشاط ما مأجور بسبب عامة أو مرض مزمن. ويعد باقين على صفة ذوى الحقوق الاولاد الذين يستوفون شروط السه المطلوبة ووجب عليهم الانقطاع عن التمهين أو الدراسة بحكم حالتهم الصحية. (3) أصول المؤمن له أو أصول زوجه المكفولين لما لا تتجاوز مواردهم الشخصية المبلخ الادنى معاش التقاعد ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_68_19830702_OpEnact_ddd0046c7c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_68> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_68> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_68> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يستفيد ذوو حقوق مسجون ، يقوم بعمل أثناء تنفيذ عقوبة جزائية كما جاء تعريفهم في المادة 67 أعلاه، من الاداءات العينية للتأمين على المرض ومنحة الوفاة المنصوص عليها في المادتين 8 و 47 أعلاه."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_69_19830702_OpEnact_77303e5ffb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_69> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_69> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_69> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يتمتع بالحق في الاداءات العينية للتأمينات عن المرض وينشته من أجرى له : معاش مباشرة للعجسن من التأمينات الاجتماعية عجزا 2 ريع عن حادث عمل أو مرض مهني يناسب عن العمل يساوى 50 % على الاقل 3 معاش تقاعد 4 معاش تقاعد منقول 5 - معاش تقاعد بدل معاش عجز، 6 - منحة تقاعد 7 - منحة تقاعد منقولة ، 8 - منحة للعمال المسنين الاجراء 9 - مساعدة عمرية 10 - معاش عجز منقول 11 - معاش تقاعد منقول بدل معاش عجز منقول 12 - ريع عن حادث أو مرض مهني للزوج أو الولد اليتيم أو الوالد أو الوالدة."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_6_19830702_OpEnact_756b79299e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_6> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_6> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_6> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "ينطوى وجوبا تحت التأمينات الاجتماعية الاشخاص الذين يشتغلون في التراب الوطني أيا كانت جنسيتهم سواء كانوا يعملون بأية صفة من الصفات وحيثما كان الصالح فرد أو جماعة من أصحاب العمل، ومهما كان مبلسغ أو طبيعة أجرهم وشكل وطبيعة أو صلاحية عقد عملهم أو علاقتهم فيه . تطبق أحكام هذه المادة بموجب مرسوم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_70_19830702_OpEnact_207f2666a8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_70> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_70> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_70> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يتمتع بالحق في الاداءات العينية للتأمين عن الولادة وينشئه من أجرى له : (1) معاش مباشر للعجز من التأمينات الاجتماعية. (2) ريع عن حادث عمل أو مرض مهني يناسب عجزا عن العمل يساوى /50 على الأقل. (3) معاش تقاعد مباشر وفقا للمشروط التي يحددها التنظيم ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_72_19830702_OpEnact_3b0734a2f8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_72> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_72> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_72> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يتم تمويل نفقات التأمينات الاجتماعية اعتمادا على قسط اشتراك اجباري على نفقة أصحاب العمل وكذا المستفيدين المشار اليهم في الباب الأول من هذا القانون ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_73_19830702_OpEnact_e4491516f3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_73_يعفى_من_دفع_الاشتراكات> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_73_يعفى_من_دفع_الاشتراكات> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_73_يعفى_من_دفع_الاشتراكات> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يعفى من دفع الاشتراكات : المجاهدون وأصحاب المعاشات المشار اليهم في المادة 5-أ الاشخاص المعوقون بدنيا أو عقليا المشار اليهم في المادة 5 ب ، الطلبة الاشخاص المشار اليهم في المواد 89 و 70 و 71 أعلاه، عندما يساوى مبلغ دخلهم الاجر الوطني الادنى المضمون أو يقل عنه ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_74_19830702_OpEnact_3c31af3d5f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_74> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_74> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_74> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يشكل قسط اشتراك التأمينات الاجتماعية جزءا من اشتراك الضمان الاجتماعي الذي يحدد بموجب القانون. ویرصد لتمويل الاداءات ذات الطابع الفردي ولنفقات الخدمة الصحية والاجتماعية المشار اليها في المادة 92 أدناه، وكذا نفقات سير وتسيير هيئات الضمان الاجتماعي ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_75_19830702_OpEnact_dd3a60e3c7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_75> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_75> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_75> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يؤسس الاشتراك في التأمينات الاجتماعية على أجر منصب العمل. يحدد معدل قسط الاشتراك في التأمينات الاجتماعية وكذلك الحصة التي يكملها صاحب العمل والمستفيد بموجب مرسوم. ويمكن في مرحلة انتقالية أن يختلف معدل قسط الاشتراك الذي يكفله صاحب العمل في القطاع الفلاحي الاشتراكي."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_76_19830702_OpEnact_55220093d8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_76> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_76> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_76> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يحدد مبلغ قسط الاشتراك في التأمينات الاجتماعية وكذا كيفيات دفعه بالنسبة البعض الفئات من العمال ولاسيما الاشخاص المستخدمين من طرف الحواص، بموجب مرسوم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_77_19830702_OpEnact_09db92d596> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_77> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_77> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_77> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يمنع الجمع بين الاداءات التالية : التعويضات اليومية للتأمين عن المرض ، التعويضات اليومية للتأمين عن الولادة ، التعويضات اليومية للتأمين عن حوادث العمل والامراض المهنية ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_78_19830702_OpEnact_1854db7ed6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_78> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_78> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_78> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تسير تبعات المخاطر المنصوص عليها في هذا القانون من طرف هيئات الضمان الاجتماعي موضوعة تحت وصاية الوزير المكلف بالشؤون الاجتماعية . تحدد كيفيات تطبيق هذه المادة بموجب مرسوم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_79_19830702_OpEnact_cccee80c78> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_79> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_79> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_79> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تحدد صلاحيات هيئات الضمان الاجتماعي وكذا تنظيمها الاداري والمالي رسير ها بموجب مرسوم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_7_19830702_OpEnact_6b0db425d0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_7_تشمل_أداءات_التأمين_على_المرض> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_7_تشمل_أداءات_التأمين_على_المرض> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_7_تشمل_أداءات_التأمين_على_المرض> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تشمل أداءات التأمين على المرض : 1) الاداءات العينية : التكفل بمصاريف العناية الطبية والوقائية والعلاجية الصالح المؤمن له و دوی حقوقه . 2) الاداءات النقدية : منح تعويضة يومية للعامل الذي يضطره المرض إلى الانقطاع مؤقتا من عمله ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_80_19830702_OpEnact_e9137daa1a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_80> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_80> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_80> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يبطل العمل بنظم التأمينات الاجتماعية الجارى بها العمل عند تاريخ دخول أحكام هذا القانون حيز التطبيق."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_82_19830702_OpEnact_8fca9c60fc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_82> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_82> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_82> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تبقى مبالغ التعويضات اليومية ومعاشات العجز المدفوعة في تاريخ دخول هذا القانون حيز التطبيق على حالها وتراجع من حيث القيمة طبقا لاحكام المادتين 21 و 42 اعلام. يتم فتح الحقوق الخاصة بمعاش العر المنقول وكذا حسابه، على أساس مبلغ المعاش المباشر وتطبيقا لاحكام التشريع الجديد."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_83_19830702_OpEnact_9293935eb0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_83> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_83> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_83> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "لا يجوز دفع الاداءات المنصوص عليها في هذا القانون خارج التراب الوطني . غير أنه تحدد الشروط التي تمنح فيها الاداءات العينية أو النقدية في حالة استعجال او عند ضرورة التحويل الى الخارج بموجب التنظيم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_84_19830702_OpEnact_44969b48d5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_84> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_84> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_84> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تكفل الاداءات المستحقة للاعوان العاملين في البعثات الدبلوماسية والتمثيليات الجزائرية والطلبة والمتربصين وذوى حقوفهم من قبل هيئات الضمان الاجتماعي وفقا لشروط تحدد بموجب مرسوم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_85_19830702_OpEnact_802d7a7852> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_85> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_85> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_85> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "لا يجوز لهيئات الضمان الاجتماعي أن تعتد بعدم وفاء أصحاب العملى بالالتزامات الملقاة على هاتفهم، لرفض تقديم الاداءات للمؤمرع له الذي يستوفى الشروط المنشئة للحقوق . عندما لا يعفى اصحاب العمل بالتزاماتهم ، يتعين على هيئات الصمان الاجتماعي تقديم الاداءات للمؤمن له ثم تتولى مطالية هؤلاء بعد ذلك ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_87_19830702_OpEnact_8903489ff9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_87> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_87> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_87> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يمنع على كل صاحب عمل أن يتحمل كليا أو جزئيا نفقة اشتراكات أو علاوات التأمين الصالح عماله سواء أكانت فردية أم جماعية لدى شركة تأمين أو أي هيئة أخرى للتأمين وسواء أكان ذلك على سبيل تكميل الاداءات المنصوص عليها في هذا القانون أو الاضافة اليها. تفسخ قانونا العقود السارية المفعول والمتعلقة بالتأمينات المشار اليها في الفقرة أعلاه اعتبارا من دخول هذا القانون حيز التطبيق."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_88_19830702_OpEnact_f8537cf67c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_88> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_88> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_88> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تعد الاداءات العينية والتمويضات اليومية ومعاشات العجز ومنحة الوفاة غير قابلة للتنازل عنها وغير قابلة للحجز ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_89_19830702_OpEnact_4b9199d723> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_89> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_89> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_89> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تسرى الاحكام المتعلقة بأخطاء الغير في مجال حوادث العمل على الاداءات المنصوص عليها في هذا القانون."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_8_19830702_OpEnact_1eee5899ca> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_8> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_8> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_8> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تشمل الاداءات العينية للتأمين على المرض المصاريف التالية : العلاج الجراحة، الادوية الاقامة بالمستشفى. الفحوص البيولوجية والكهروديوغرافية. والمجوافية، والنظيرية علاج الاسنان واستغلافها الاصطناعي النظارات الطبية المعالجات بالمياه المعدنية والمتخصصة الاجهزة والاعضاء الاصطناعية ب الجبارة الفكية والوجهية اعادة التدريب الوظيفي للاعضاء اعادة التأهيل المهني النقل بسيارة الاسعاف أو غيرها من وسائل النقل عندما تستلزم حالة المريض ذلك ، ويمكن اتمام قائمة المصاريف الواردة في هذه المادة بموجب مرسوم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_92_19830702_OpEnact_4804b4cc3f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_92> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_92> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_92> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تتولى هيئات الضمان الاجتماعي القيام بأعمال تتمثل في اقامة مرافق ذات النفع الصحي والاجتماعي لافادة العمال وذوى حقوقهم بالاداءات الجماعية ويتم ذلك في اطار المخطط الستوى وطبقا للاجراءات الجارى بها العمل في مجال الاستثمارات المخططة. وتحدد مختلف اشکال الخدمة الصحية والاجتماعية الهيئات المسمان الاجتماعي بموجب مرسوم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_96_19830702_OpEnact_bc450c7e5d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_96> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_96> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_96> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تستمد الاحكام المتعلقة بالتأمينات الاجتماعية والخاصة بالعسكريين والملحقين بهم من هذا القانون."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_97_19830702_OpEnact_e81f304963> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_97> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_97> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_97> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يمكن تقديم مكملات للاداءات المنصوص عليها في هذا القانون، في اطار تأمين اختیاری ضمن تعاضديات ، وذلك وفقا لشروط تحدد بمقتضى التشريع."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_98_19830702_OpEnact_0c595fc5f5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_98> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_98> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_98> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يدخل هذا القانون حين التطبيق ابتداء من أول يناير سنة 1984."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_99_19830702_OpEnact_fd2f233f00> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_99> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_99> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_99> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية . حرر بالجزائر في 27 رمضان عام 1403 الموافق 2 يوليو سنة 1983. الشاذلي بن جديد"@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_r_19830702_OpEnact_ca73139a94> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_r> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#art_r> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_r> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "لا تشمل مصاريف الاسنان الاصطناعية سوى الاجهزة الوظيفية أو العلاجية أو تلك الضرورية لممارسة بعض المهن. و تحدد هذه المهن عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_chp_2_chp_2_sec_3_chp_2_sec_3_subsec_2_art_4_19830702_OpEnact_941abf5812> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_chp_2_chp_2_sec_3_chp_2_sec_3_subsec_2_art_4> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_3_chp_2_sec_3_subsec_2_art_4> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_3_chp_2_sec_3_subsec_2_art_4> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يستفيد من الاداءات العينية : الاشخاص الطبيعيون غير الاجراء الذين يمارسون بالفعل الحسابهم الخاص نشاطا حرا صناعيا أو تجاريا أو حرفيا أو فلاحيا أو أي نشاط آخر مماثل وفقا للشروط المحددة في التنظيم المعمول به . كما يستفيد الاشخاص المذكورين أعلاه من الاداءات التقديم المتمثلة في منحة الوفاة و العجز . وتحدد قائمة المستفيدين وكذا الشروط الخاصة لتطبيق هذه المادة بموجب مرسوم"@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_chp_2_chp_2_sec_4_art_30_19830702_OpEnact_8b40e3e6e1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_chp_2_chp_2_sec_4_art_30> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_4_art_30> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_4_art_30> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تطبق أحكام المادة 22 أعلاه، على التعويضة اليومية للتأمين على الولادة ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_chp_2_chp_2_sec_4_art_5_19830702_OpEnact_ed6559d5b4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_chp_2_chp_2_sec_4_art_5> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_4_art_5> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_4_art_5> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يستفيد ذوو حقوق صاحب معاش عجز أو تقاعد أو ريع حادث عمل كما جاء تعريفهم في المادة 67 أدناه، وفقا للشروط المنصوص عليها في المادتين 49 و 50 أعلاه من منحة وفاة يساوى مبلغها قيمة المبلغ السنوى لمعاش العجز أو معاش التقاعد أو ريع حادث عمل على ألا يقل هذا المبلغ من القيمة الدنيا المنصوص عليها في المادة 48 من هذا القانون ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_19830702_OpEnact_c2b908502f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يقصد بذوى الحقوق : (1) زوج المؤمن له، غير أنه لا تغول الاستفادة من الاداءات العينية للزوج اذا كان يمارس نشاطا مهنيا مأجورا ، اذا كان الزوج نفسه أجيرا يمكن أن يستفيد من الاداءات بصفته صاحب الحق ان كان لا يستوفى شروط تحويل الحقوق بحكم نشاطه . (2) الاولاد المكفولين كما هم محدودن في التنظيم المتعلق بالضمان الاجتماعي والذين يقل عمرهم عن الثامنة عشرة سنة. و يعتبر أيضا أولاد مكفولون : الاولاد الذين يقل عمرهم عن الواحد- والعشرين سنة وأبرم بشأنهم عقد تمهين يقضى بمنحهم أجرا يقل عن نصف الاجر الوطني الادني المضمون. الاولاد الذين يقل عمرهم عن الواحد- والعشرين سنة ويواصلون الدراسة، وفي حالة اذا بدأ العلاج الطبي قبل سن الواحدة والعشرين لا يعتد بشرط السن قبل نهاية العلاج . البنات دون دخل أيا كان عمر هن. الاولاد أيا كان عمرهم والذين تتعذر عليهم ممارسة نشاط ما مأجور بسبب عامة أو مرض مزمن. ويعد باقين على صفة ذوى الحقوق الاولاد الذين يستوفون شروط السه المطلوبة ووجب عليهم الانقطاع عن التمهين أو الدراسة بحكم حالتهم الصحية. (3) أصول المؤمن له أو أصول زوجه المكفولين لما لا تتجاوز مواردهم الشخصية المبلخ الادنى معاش التقاعد ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_chp_3_art_77_19830702_OpEnact_f0874dc7d8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_chp_3_art_77> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#chp_3_art_77> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#chp_3_art_77> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "يمنع الجمع بين الاداءات التالية : التعويضات اليومية للتأمين عن المرض ، التعويضات اليومية للتأمين عن الولادة ، التعويضات اليومية للتأمين عن حوادث العمل والامراض المهنية ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#version_chp_5_art_8_19830702_OpEnact_476ad3855c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_chp_5_art_8> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1983-07-02/83-11#chp_5_art_8> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#chp_5_art_8> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:versionText "تشمل الاداءات العينية للتأمين على المرض المصاريف التالية : العلاج الجراحة، الادوية الاقامة بالمستشفى. الفحوص البيولوجية والكهروديوغرافية. والمجوافية، والنظيرية علاج الاسنان واستغلافها الاصطناعي النظارات الطبية المعالجات بالمياه المعدنية والمتخصصة الاجهزة والاعضاء الاصطناعية ب الجبارة الفكية والوجهية اعادة التدريب الوظيفي للاعضاء اعادة التأهيل المهني النقل بسيارة الاسعاف أو غيرها من وسائل النقل عندما تستلزم حالة المريض ذلك ، ويمكن اتمام قائمة المصاريف الواردة في هذه المادة بموجب مرسوم."@ar .

