<https://legal.dz/resource/law/1983-07-02/83-11#version_art_مو> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينشأ صندوق للمساعدة والاسعاف يخصص المنح في بعض الحالات الاستثنائية امتيازات للمؤمنة لهم اجتماعيا ولذوى حقوقهم : هندما لا يستوفي المعنيون الشروط التي تخول لهم الاستفادة من أداءات التأمين الاجتماعي عندما يكون من ذوي الدخل المحدود . يول صندوق المساعدة والاسعاف يجزء من اشتركات الضمان الاجتماعي. تمنح الامتيازات من طرف لجنة تعمل ضمي هيئات الضمان الاجتماعي وتسالف من ممثلى المؤمنين لهم اجتماعيا. تحدد طبيعة الامتيازات الممنوحة من صندوق المساعدة والاسعاف ومبلنها وقواعد منحها بموجب"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_19830702_OpEnact_a2f5ec9353> ;
    dzdoc:replacementText "ينشأ صندوق للمساعدة والاسعاف يخصص المنح في بعض الحالات الاستثنائية امتيازات للمؤمنة لهم اجتماعيا ولذوى حقوقهم : هندما لا يستوفي المعنيون الشروط التي تخول لهم الاستفادة من أداءات التأمين الاجتماعي عندما يكون من ذوي الدخل المحدود . يول صندوق المساعدة والاسعاف يجزء من اشتركات الضمان الاجتماعي. تمنح الامتيازات من طرف لجنة تعمل ضمي هيئات الضمان الاجتماعي وتسالف من ممثلى المؤمنين لهم اجتماعيا. تحدد طبيعة الامتيازات الممنوحة من صندوق المساعدة والاسعاف ومبلنها وقواعد منحها بموجب"@ar ;
