<https://legal.dz/resource/law/1983-07-02/83-11#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_3> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "يحدد مبلغ قسط الاشتراك في التأمينات الاجتماعية وكذا كيفيات دفعه بالنسبة البعض الفئات من العمال ولاسيما الاشخاص المستخدمين من طرف الحواص، بموجب مرسوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_76_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_76_19830702_OpEnact_55220093d8> ;
