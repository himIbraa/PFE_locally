<https://legal.dz/resource/law/1983-07-02/83-11#art_13_condition_0_d8985303> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/law/1983-07-02/83-11#art_13_condition_0_d8985303_action_bbf2adc84d> ;
    dznorm:conditionText "ما لم يتعلق الامن بعلاج طبی مستمر، وفي هذه الحالة يجب تقديم الملف في ظرف ثلاثة أشهر بعد انتهاء هذا العلاج"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_13> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1983-07-02/83-11#art_13_condition_0_d8985303_action_bbf2adc84d> a dznorm:Action ;
    rdfs:label "تقديم الملف في ظرف ثلاثة"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "ما لم يتعلق الامن بعلاج طبی مستمر، وفي هذه الحالة يجب تقديم الملف في ظرف ثلاثة أشهر بعد انتهاء هذا العلاج"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_13> .

<https://legal.dz/resource/law/1983-07-02/83-11#art_13_condition_1_e4f0f084> a dznorm:Condition ;
    dznorm:conditionText "ما لم يثبت المستفيد حدوث أسباب قاهرة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_13> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1983-07-02/83-11#art_13_obligation_0_35a6dac3> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/1983-07-02/83-11#art_13_obligation_0_35a6dac3_action_e306a1ac86> ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_13> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب ارسال الملف الطبي أو تقديمه الى هيئة الضمان الاجتماعي في ظرف الاشهر الثلاثة التالية للاجراء الطبي الاول"@ar ;
    dznorm:sourceArticle "art_13" .

<https://legal.dz/resource/law/1983-07-02/83-11#art_13_obligation_0_35a6dac3_action_e306a1ac86> a dznorm:Action ;
    rdfs:label "ارسال الملف الطبي أو تقديمه"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب ارسال الملف الطبي أو تقديمه الى هيئة الضمان الاجتماعي في ظرف الاشهر الثلاثة التالية للاجراء الطبي الاول"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_13> .

<https://legal.dz/resource/law/1983-07-02/83-11#art_13_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_13> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب ارسال الملف الطبي أو تقديمه الى هيئة الضمان الاجتماعي في ظرف الاشهر الثلاثة التالية للاجراء الطبي الاول ما لم يتعلق الامن بعلاج طبی مستمر، وفي هذه الحالة يجب تقديم الملف في ظرف ثلاثة أشهر بعد انتهاء هذا العلاج."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_13_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_13> ;
    dzdoc:position 1 ;
    dzdoc:text "يترتب عن عدم استيفاء الاجراءات المنصوص عليها في الفقرة السابقة سقوط الحق في الاداءات بالنسبة للفترة التي منعت خلالها هيئة الضمان الاجتماعي من ممارسة مراقبتها وذلك ما لم يثبت المستفيد حدوث أسباب قاهرة."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_15_condition_0_8d705517> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/1983-07-02/83-11#art_15_condition_0_8d705517_role_e062a4c001> ;
    dznorm:conditionText "على ألا تتجاوز قدر واحد من ثلاثين من أجر المنصب الشهري، المتقاضي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_15> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1983-07-02/83-11#art_15_condition_0_8d705517_role_e062a4c001> a dznorm:Role ;
    rdfs:label "ألا تتجاوز قدر واحد"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "على ألا تتجاوز قدر واحد من ثلاثين من أجر المنصب الشهري، المتقاضي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_15> .

<https://legal.dz/resource/law/1983-07-02/83-11#art_15_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_15> ;
    dzdoc:position 0 ;
    dzdoc:text "تستحق التعويضة اليومية عن كل يوم عمل أو راحة، على ألا تتجاوز قدر واحد من ثلاثين من أجر المنصب الشهري، المتقاضي، وهو ما يؤخذ أساسا لحساب أداءات التأمينات الاجتماعية."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_15_right_0_eec89cac> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_15> ;
    dznorm:position 0 ;
    dznorm:provisionText "تستحق التعويضة اليومية عن كل يوم عمل أو راحة"@ar ;
    dznorm:sourceArticle "art_15" .

<https://legal.dz/resource/law/1983-07-02/83-11#art_16_condition_0_9d3ebced> a dznorm:Condition ;
    dznorm:conditionText "اذا تعلق الامر بعلل طويلة الامد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_16> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1983-07-02/83-11#art_16_condition_1_18be891b> a dznorm:Condition ;
    dznorm:conditionText "اذا تعلق الامر يعلل من غير العلل الطويلة الامد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_16> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1983-07-02/83-11#art_16_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_16> ;
    dzdoc:position 0 ;
    dzdoc:text "تدفع التعويضات المشار اليها في المادة 15 أعلاه، طوال مدة فترة أقصاها ثلاث (3) سنوات محسوبة، وفقا للشروط التالية : (1) اذا تعلق الامر بعلل طويلة الامد، يجوز دفع التعويضة اليومية طوال فترة مدتها ثلاث (3) سنوات ومحسوية من تاريخ الى تاريخ عن كل علة ."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_16_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_16> ;
    dzdoc:position 1 ;
    dzdoc:text "و في حالة توقف يتبعه استئناف للعمل يتاح أجل جديد مدته ثلاث (3) سنوات على أن تمن على هذا الاستئناف سنة على الاقل."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_16_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_16> ;
    dzdoc:position 2 ;
    dzdoc:text "(2) اذا تعلق الامر يعلل من غير العلل الطويلة الامد تدفع التعويضة اليومية، على نحو يضمه طوال فترة ما مدتها سنتان متتالیتان يتقاضى فيها العامل ثلاثمائة تعويضة يومية على الأكثر وذلك على علة أو عدة علل."@ar .

