    dzdoc:position 67 ;
    dzdoc:usesTerm dzterm:social_security_bodies .

<https://legal.dz/resource/law/1983-07-02/83-11#art_84> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_5> ;
    dzdoc:eId "art_84" ;
    dzdoc:fullText "تكفل الاداءات المستحقة للاعوان العاملين في البعثات الدبلوماسية والتمثيليات الجزائرية والطلبة والمتربصين وذوى حقوفهم من قبل هيئات الضمان الاجتماعي وفقا لشروط تحدد بموجب مرسوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_84> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_84_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_84_19830702_OpEnact_44969b48d5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "84" ;
    dzdoc:position 72 ;
    dzdoc:usesTerm dzterm:social_security_bodies .

<https://legal.dz/resource/law/1983-07-02/83-11#art_96> a dzdoc:Article ;
