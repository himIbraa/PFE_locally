    dznorm:sourceArticle "art_35" .

<https://legal.dz/resource/law/1983-07-02/83-11#art_35_obligation_0_8fe4f659_role_d08c018f62> a dznorm:Role ;
    rdfs:label "العجز دون انتظار الطلب"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "تتولى هيئة الضمان الاجتماعي تلقائيا النظر في الحقوق من باب التأمين على العجز دون انتظار الطلب من المعنى بالامر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_35> .

<https://legal.dz/resource/law/1983-07-02/83-11#art_35_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_35> ;
    dzdoc:position 0 ;
    dzdoc:text "عند القضاء المدة التي قدمت خلالها الاداءات النقدية للتأميع على المرض تتولى هيئة الضمان الاجتماعي تلقائيا النظر في الحقوق من باب التأمين على العجز دون انتظار الطلب من المعنى بالامر."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_36_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_36> ;
    dzdoc:position 0 ;
    dzdoc:text "يصنف العجزة من حيث تحضير مبلغ المعاش الى ثلاثة أصناف : الصنف الأول : العجزة الذين ما زالوا قادرين على ممارسة نشاط ماجور الصنف الثاني : العجزة الذين يتعذر عليهم اطلاقا القيام بأي نشاط مأجور الصنف الثالث : العجزة الذين يتعذر عليهم اطلاق القيام بأي نشاط ماجور ويحتاجون الى مساعدة من غيرهم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_37_condition_0_11e14145> a dznorm:Condition ;
    dznorm:conditionText "اذا كان هذا الاجر هو أحسن مواتاة له"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_37> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1983-07-02/83-11#art_37_condition_1_490c30aa> a dznorm:Condition ;
    dznorm:conditionText "وعندما لا تتم للمعنى بالامر ثلاث سنوات من التأمين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_37> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1983-07-02/83-11#art_37_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_37> ;
    dzdoc:position 0 ;
    dzdoc:text "يساوى المبلغ السنوى للمعاش المدفوع للعجزة من الصنف الأول %60 منع الاجر السنوي المتوسط للمنصب الذي يحسب بالرجوع الى : اما إلى أخر أجر سنوى تم تقاضيه واما إلى الاجر السنوى المتوسط للثلاث سنوات حيث بلغ أجر المعنى بالأمر أقصاء خلال حياته المهنية، اذا كان هذا الاجر هو أحسن مواتاة له."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_37_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_37> ;
    dzdoc:position 1 ;
    dzdoc:text "وعندما لا تتم للمعنى بالامر ثلاث سنوات من التأمين، يحسب المعاش حسب الاجر السنوى المتوسط المناسب لفترات العمل التي أداها."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_38_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_38> ;
    dzdoc:position 0 ;
    dzdoc:text "يساوى المبلغ السنوى المعاش العجزة من الصنف الثاني 80% من الأجر المحدد في المادة السابقة."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_39_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_39> ;
    dzdoc:position 0 ;
    dzdoc:text "يساوى المبلغ السنوي لمعاش المجزة من الصنف الثالث /80 من الاجر المحدد في المادة 37 أعلاه، ويضاعف بنسبة %40 دون أن نقل الزيادة عن قدر أدنى يحدد عن المريق التنظيم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_3_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_3> ;
    dzdoc:position 0 ;
    dzdoc:text "يستفيد من أحكام هذا القانون، كل العمال سواء أكانوا أجراء أم ملحقي بالاجراء أيا كان قطاع النشاط الذي ينتمون اليه، والنظام الذي كان يسرى عليهم قبل تاريخ دخول هذا القانون حيز التطبيق."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_3_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_3> ;
    dzdoc:position 1 ;
    dzdoc:text "تطبق أحكام هذه المادة بموجب مرسوم."@ar .

