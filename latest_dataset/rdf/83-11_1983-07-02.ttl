<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_condition_0_b13a56ff> a dznorm:Condition ;
    dznorm:conditionText "غير أنه لا تغول الاستفادة من الاداءات العينية للزوج اذا كان يمارس نشاطا مهنيا مأجورا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_condition_1_233c0468> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_condition_1_233c0468_action_a1141a7e05> ;
    dznorm:conditionText "اذا كان الزوج نفسه أجيرا يمكن أن يستفيد من الاداءات بصفته صاحب الحق ان كان لا يستوفى شروط تحويل الحقوق بحكم نشاطه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_condition_1_233c0468_action_a1141a7e05> a dznorm:Action ;
    rdfs:label "أن يستفيد من الاداءات بصفته"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "اذا كان الزوج نفسه أجيرا يمكن أن يستفيد من الاداءات بصفته صاحب الحق ان كان لا يستوفى شروط تحويل الحقوق بحكم نشاطه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_condition_2_2ba08135> a dznorm:Condition ;
    dznorm:conditionText "اذا بدأ العلاج الطبي قبل سن الواحدة والعشرين لا يعتد بشرط السن قبل نهاية العلاج"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_condition_3_bfc1bf02> a dznorm:Condition ;
    dznorm:conditionText "لما لا تتجاوز مواردهم الشخصية المبلخ الادنى معاش التقاعد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> ;
    dznorm:position 3 .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> ;
    dzdoc:position 1 ;
    dzdoc:text "و يعتبر أيضا أولاد مكفولون : الاولاد الذين يقل عمرهم عن الواحد- والعشرين سنة وأبرم بشأنهم عقد تمهين يقضى بمنحهم أجرا يقل عن نصف الاجر الوطني الادني المضمون. الاولاد الذين يقل عمرهم عن الواحد- والعشرين سنة ويواصلون الدراسة، وفي حالة اذا بدأ العلاج الطبي قبل سن الواحدة والعشرين لا يعتد بشرط السن قبل نهاية العلاج. البنات دون دخل أيا كان عمر هن. الاولاد أيا كان عمرهم والذين تتعذر عليهم ممارسة نشاط ما مأجور بسبب عامة أو مرض مزمن."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> ;
    dzdoc:position 2 ;
    dzdoc:text "ويعد باقين على صفة ذوى الحقوق الاولاد الذين يستوفون شروط السه المطلوبة ووجب عليهم الانقطاع عن التمهين أو الدراسة بحكم حالتهم الصحية."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> ;
    dzdoc:position 3 ;
    dzdoc:text "(3) أصول المؤمن له أو أصول زوجه المكفولين لما لا تتجاوز مواردهم الشخصية المبلخ الادنى معاش التقاعد."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_permission_0_bda6e371> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_permission_0_bda6e371_action_945d603bba> ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> ;
    dznorm:position 0 ;
    dznorm:provisionText "يقصد بذوى الحقوق : (1) زوج المؤمن له، غير أنه لا تغول الاستفادة من الاداءات العينية للزوج اذا كان يمارس نشاطا مهنيا مأجورا، اذا كان الزوج نفسه أجيرا يمكن أن يستفيد من الاداءات بصفته صاحب الحق ان كان لا يستوفى شروط تحويل الحقوق بحكم نشاطه. (2) الاولاد المكفولين كما هم محدودن في التنظيم المتعلق بالضمان الاجتماعي والذين يقل عمرهم عن الثامنة عشرة سنة."@ar ;
    dznorm:sourceArticle "chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67" .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_permission_0_bda6e371_action_945d603bba> a dznorm:Action ;
    rdfs:label "أن يستفيد من الاداءات بصفته"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يقصد بذوى الحقوق : (1) زوج المؤمن له، غير أنه لا تغول الاستفادة من الاداءات العينية للزوج اذا كان يمارس نشاطا مهنيا مأجورا، اذا كان الزوج نفسه أجيرا يمكن أن يستفيد من الاداءات بصفته صاحب الحق ان كان لا يستوفى شروط تحويل الحقوق بحكم نشاطه. (2) الاولاد المكفولين كما هم محدودن في التنظيم المتعلق بالضمان الاجتماعي والذين يقل عمرهم عن الثامنة عشرة سنة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67> .

