<https://legal.dz/resource/law/1983-07-02/83-11#version_art_82> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبقى مبالغ التعويضات اليومية ومعاشات العجز المدفوعة في تاريخ دخول هذا القانون حيز التطبيق على حالها وتراجع من حيث القيمة طبقا لاحكام المادتين 21 و 42 اعلام. يتم فتح الحقوق الخاصة بمعاش العر المنقول وكذا حسابه، على أساس مبلغ المعاش المباشر وتطبيقا لاحكام التشريع الجديد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
