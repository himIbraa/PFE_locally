<https://legal.dz/resource/law/1983-07-02/83-11#version_art_13> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب ارسال الملف الطبي أو تقديمه الى هيئة الضمان الاجتماعي في ظرف الاشهر الثلاثة التالية للاجراء الطبي الاول ما لم يتعلق الامن بعلاج طبی مستمر، وفي هذه الحالة يجب تقديم الملف في ظرف ثلاثة أشهر بعد انتهاء هذا العلاج . يترتب عن عدم استيفاء الاجراءات المنصوص عليها في الفقرة السابقة سقوط الحق في الاداءات بالنسبة للفترة التي منعت خلالها هيئة الضمان الاجتماعي من ممارسة مراقبتها وذلك ما لم يثبت المستفيد حدوث أسباب قاهرة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_13_19830702_OpEnact_a777013ea8> ;
    dzdoc:replacementText "يجب ارسال الملف الطبي أو تقديمه الى هيئة الضمان الاجتماعي في ظرف الاشهر الثلاثة التالية للاجراء الطبي الاول ما لم يتعلق الامن بعلاج طبی مستمر، وفي هذه الحالة يجب تقديم الملف في ظرف ثلاثة أشهر بعد انتهاء هذا العلاج . يترتب عن عدم استيفاء الاجراءات المنصوص عليها في الفقرة السابقة سقوط الحق في الاداءات بالنسبة للفترة التي منعت خلالها هيئة الضمان الاجتماعي من ممارسة مراقبتها وذلك ما لم يثبت المستفيد حدوث أسباب قاهرة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_13> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_13> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_15> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تستحق التعويضة اليومية عن كل يوم عمل أو راحة ، على ألا تتجاوز قدر واحد من ثلاثين من أجر المنصب الشهري، المتقاضي ، وهو ما يؤخذ أساسا لحساب أداءات التأمينات الاجتماعية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_15_19830702_OpEnact_6e485a6e76> ;
    dzdoc:replacementText "تستحق التعويضة اليومية عن كل يوم عمل أو راحة ، على ألا تتجاوز قدر واحد من ثلاثين من أجر المنصب الشهري، المتقاضي ، وهو ما يؤخذ أساسا لحساب أداءات التأمينات الاجتماعية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_15> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_15> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_16> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تدفع التعويضات المشار اليها في المادة 15 أعلاه، طوال مدة فترة أقصاها ثلاث (3) سنوات محسوبة، وفقا للشروط التالية : (1) اذا تعلق الامر بعلل طويلة الامد ، يجوز دفع التعويضة اليومية طوال فترة مدتها ثلاث (3) سنوات ومحسوية من تاريخ الى تاريخ عن كل علة . و في حالة توقف يتبعه استئناف للعمل يتاح أجل جديد مدته ثلاث (3) سنوات على أن تمن على هذا الاستئناف سنة على الاقل. (2) اذا تعلق الامر يعلل من غير العلل الطويلة الامد تدفع التعويضة اليومية ، على نحو يضمه طوال فترة ما مدتها سنتان متتالیتان يتقاضى فيها العا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_16_19830702_OpEnact_21203a5777> ;
    dzdoc:replacementText "تدفع التعويضات المشار اليها في المادة 15 أعلاه، طوال مدة فترة أقصاها ثلاث (3) سنوات محسوبة، وفقا للشروط التالية : (1) اذا تعلق الامر بعلل طويلة الامد ، يجوز دفع التعويضة اليومية طوال فترة مدتها ثلاث (3) سنوات ومحسوية من تاريخ الى تاريخ عن كل علة . و في حالة توقف يتبعه استئناف للعمل يتاح أجل جديد مدته ثلاث (3) سنوات على أن تمن على هذا الاستئناف سنة على الاقل. (2) اذا تعلق الامر يعلل من غير العلل الطويلة الامد تدفع التعويضة اليومية ، على نحو يضمه طوال فترة ما مدتها سنتان متتالیتان يتقاضى فيها العامل ثلاثمائة تعويضة يومية على الأكثر وذلك على علة أو عدة علل."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_16> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_16> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_18> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن تشعن هيئة الضمان الاجتماعي في ظرف أجل يحدد عن طريق التنظيم بكل مرض يمترى العامل من شأنه أن يخول له الحق في تعويضة يومية ، الا اذا حالت أسباب قاهرة دون ذلك . و يمكن أن تترتب عن عدم مراعاة هذا الاجراء عقوبات قد تؤدى الى سقوط الحق في التعويضات اليومية بالنسبة للمدة التي منعت أثناءها هيئة الفتمان الاجتماعي من اجراء المراقبة بسبب عدم التصريح."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_18_19830702_OpEnact_70e7123f0f> ;
    dzdoc:replacementText "يجب أن تشعن هيئة الضمان الاجتماعي في ظرف أجل يحدد عن طريق التنظيم بكل مرض يمترى العامل من شأنه أن يخول له الحق في تعويضة يومية ، الا اذا حالت أسباب قاهرة دون ذلك . و يمكن أن تترتب عن عدم مراعاة هذا الاجراء عقوبات قد تؤدى الى سقوط الحق في التعويضات اليومية بالنسبة للمدة التي منعت أثناءها هيئة الفتمان الاجتماعي من اجراء المراقبة بسبب عدم التصريح."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_18> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_18> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

