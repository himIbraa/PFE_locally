<https://legal.dz/resource/law/1983-07-02/83-11#art_67_defocc_386307f5598e> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 16 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:beneficiaries ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_67> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_67_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يقصد بذوى الحقوق :
              
              
              (1) زوج المؤمن له، غير أنه لا تغول الاستفادة من الاداءات العينية للزوج اذا كان يمارس نشاطا مهنيا مأجورا، اذا كان الزوج نفسه أجيرا يمكن أن يستفيد من الاداءات بصفته صاحب الحق ان كان لا يستوفى شروط تحويل الحقوق بحكم نشاطه.
              
              
              (2) الاولاد المكفولين كما هم محدودن في التنظيم المتعلق بالضمان الاجتماعي والذين يقل عمرهم عن الثامنة عشرة سنة."""@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_67_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_67> ;
    dzdoc:position 0 ;
    dzdoc:text "يقصد بذوى الحقوق : (1) زوج المؤمن له، غير أنه لا تغول الاستفادة من الاداءات العينية للزوج اذا كان يمارس نشاطا مهنيا مأجورا، اذا كان الزوج نفسه أجيرا يمكن أن يستفيد من الاداءات بصفته صاحب الحق ان كان لا يستوفى شروط تحويل الحقوق بحكم نشاطه. (2) الاولاد المكفولين كما هم محدودن في التنظيم المتعلق بالضمان الاجتماعي والذين يقل عمرهم عن الثامنة عشرة سنة."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_7_تشمل_أداءات_التأمين_على_المرض_defocc_36211ae0a8d3> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 29 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:sick_insurance_benefits ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_7_تشمل_أداءات_التأمين_على_المرض> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_7_تشمل_أداءات_التأمين_على_المرض_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """تشمل أداءات التأمين على المرض :
            
            
            1) الاداءات العينية : التكفل بمصاريف العناية الطبية والوقائية والعلاجية الصالح المؤمن له و دوی حقوقه.
            
            
            2) الاداءات النقدية : منح تعويضة يومية للعامل الذي يضطره المرض إلى الانقطاع مؤقتا من عمله."""@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_7_تشمل_أداءات_التأمين_على_المرض_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_7_تشمل_أداءات_التأمين_على_المرض> ;
    dzdoc:position 0 ;
    dzdoc:text "تشمل أداءات التأمين على المرض : 1) الاداءات العينية : التكفل بمصاريف العناية الطبية والوقائية والعلاجية الصالح المؤمن له و دوی حقوقه. 2) الاداءات النقدية : منح تعويضة يومية للعامل الذي يضطره المرض إلى الانقطاع مؤقتا من عمله."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_مو_defocc_da2987b76d02> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 28 ;
    dzdoc:charStart 5 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:assistance_fund ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_مو> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_مو_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """ينشأ صندوق للمساعدة والاسعاف يخصص المنح في بعض الحالات الاستثنائية امتيازات للمؤمنة لهم اجتماعيا ولذوى حقوقهم :
          
          
          هندما لا يستوفي المعنيون الشروط التي تخول لهم الاستفادة من أداءات التأمين الاجتماعي
          
          
          عندما يكون من ذوي الدخل المحدود."""@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_مو_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_مو> ;
    dzdoc:position 0 ;
    dzdoc:text "ينشأ صندوق للمساعدة والاسعاف يخصص المنح في بعض الحالات الاستثنائية امتيازات للمؤمنة لهم اجتماعيا ولذوى حقوقهم : هندما لا يستوفي المعنيون الشروط التي تخول لهم الاستفادة من أداءات التأمين الاجتماعي عندما يكون من ذوي الدخل المحدود."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_و_obligation_0_7e07b9ee> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/1983-07-02/83-11#art_و_obligation_0_7e07b9ee_action_fea38d0c18> ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_و> ;
    dznorm:hasCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_و_obligation_0_7e07b9ee_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "تكفل مصاريف تنقل المؤمع له أو دوی حقوقه أو مرافقه اذا ما اقتضى الأمر ذلك حسب الشروط المحددة بموجب التنظيم في حالة استدعاء من المراقبة الطبية لهيئة الضمان الاجتماعي أو طبيب خبير أو عندما يجب تقديم العلاج في مؤسسة صحية غير التي توجد في مقر اقامته"@ar ;
    dznorm:sourceArticle "art_و" .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_5_chp_2_sec_5_subsec_3_art_67_defocc_f37f7ad356ea> a dzdoc:DefinitionOccurrence ;
