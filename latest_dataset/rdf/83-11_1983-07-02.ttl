    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_5_art_8> ;
    dzdoc:position 0 ;
    dzdoc:text "تشمل الاداءات العينية للتأمين على المرض المصاريف التالية : العلاج الجراحة، الادوية الاقامة بالمستشفى. الفحوص البيولوجية والكهروديوغرافية. والمجوافية، والنظيرية علاج الاسنان واستغلافها الاصطناعي النظارات الطبية المعالجات بالمياه المعدنية والمتخصصة الاجهزة والاعضاء الاصطناعية ب الجبارة الفكية والوجهية اعادة التدريب الوظيفي للاعضاء اعادة التأهيل المهني النقل بسيارة الاسعاف أو غيرها من وسائل النقل عندما تستلزم حالة المريض ذلك،"@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#chp_5_art_8_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_5_art_8> ;
    dzdoc:position 1 ;
    dzdoc:text "ويمكن اتمام قائمة المصاريف الواردة في هذه المادة بموجب مرسوم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#preamble_segment_6> a dzdoc:PreambleSegment ;
