<https://legal.dz/resource/law/1983-07-02/83-11#version_art_66> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يستفيد ذوو الحقوق المؤمن لهم اجتماعيا من الاداءات المشار اليها في المادتين 8 و 26 أعلاه، بالنسبة للزوج فقط، وفي المادة 8 أعلاه، بالنسبة للأولاد والاصول."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_66_19830702_OpEnact_5cd02e8e36> ;
