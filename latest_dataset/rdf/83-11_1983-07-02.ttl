<https://legal.dz/resource/law/1983-07-02/83-11#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_الاول_subsec_2> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "تستحق التعويضة اليومية عن كل يوم عمل أو راحة ، على ألا تتجاوز قدر واحد من ثلاثين من أجر المنصب الشهري، المتقاضي ، وهو ما يؤخذ أساسا لحساب أداءات التأمينات الاجتماعية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1983-07-02/83-11#art_15_right_0_eec89cac> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_15_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_15_19830702_OpEnact_6e485a6e76> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 15" ;
    dzdoc:position 10 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_15_condition_0_8d705517> ;
    dzdoc:usesTerm dzterm:daily_allowance,
        dzterm:social_insurance .

<https://legal.dz/resource/law/1983-07-02/83-11#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_الاول_subsec_2> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "يجب أن تشعن هيئة الضمان الاجتماعي في ظرف أجل يحدد عن طريق التنظيم بكل مرض يمترى العامل من شأنه أن يخول له الحق في تعويضة يومية ، الا اذا حالت أسباب قاهرة دون ذلك . و يمكن أن تترتب عن عدم مراعاة هذا الاجراء عقوبات قد تؤدى الى سقوط الحق في التعويضات اليومية بالنسبة للمدة التي منعت أثناءها هيئة الفتمان الاجتماعي من اجراء المراقبة بسبب عدم التصريح."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1983-07-02/83-11#art_18_permission_0_ad55dd07> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_18_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_18_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_18_19830702_OpEnact_70e7123f0f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1983-07-02/83-11#art_18_obligation_0_3f36e1b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 18" ;
    dzdoc:position 12 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_18_condition_0_31dd9753> ;
    dzdoc:usesTerm dzterm:social_security_body .

<https://legal.dz/resource/law/1983-07-02/83-11#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "يساوى المبلغ السنوى للمعاش المدفوع للعجزة من الصنف الأول %60 منع الاجر السنوي المتوسط للمنصب الذي يحسب بالرجوع الى : اما إلى أخر أجر سنوى تم تقاضيه واما إلى الاجر السنوى المتوسط للثلاث سنوات حيث بلغ أجر المعنى بالأمر أقصاء خلال حياته المهنية، اذا كان هذا الاجر هو أحسن مواتاة له . وعندما لا تتم للمعنى بالامر ثلاث سنوات من التأمين ، يحسب المعاش حسب الاجر السنوى المتوسط المناسب لفترات العمل التي أداها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_37_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_37_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_37_19830702_OpEnact_ed7cf7e00b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "37" ;
    dzdoc:position 27 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_37_condition_0_11e14145>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_37_condition_1_490c30aa> ;
    dzdoc:usesTerm dzterm:disabled_class_1 .

<https://legal.dz/resource/law/1983-07-02/83-11#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "يمنح معاش العجز بصفة مؤقتة ويمكن أن يراجع أثر حدوث تغيير في حالة العجز ويلغى إذا ما ثبت بأن نسبة قدرة المستفيد على العمل تفوق 50 % ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1983-07-02/83-11#art_44_right_0_a25dc1f8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_44_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_44_para_1>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_44_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_44_19830702_OpEnact_f899de1393> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1983-07-02/83-11#art_44_obligation_0_b97689a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 44" ;
    dzdoc:position 34 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_44_condition_0_daf42aca> ;
    dzdoc:usesTerm dzterm:disability_pension .

<https://legal.dz/resource/law/1983-07-02/83-11#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_الاول> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "ينطوى وجوبا تحت التأمينات الاجتماعية الاشخاص الذين يشتغلون في التراب الوطني أيا كانت جنسيتهم سواء كانوا يعملون بأية صفة من الصفات وحيثما كان الصالح فرد أو جماعة من أصحاب العمل، ومهما كان مبلسغ أو طبيعة أجرهم وشكل وطبيعة أو صلاحية عقد عملهم أو علاقتهم فيه . تطبق أحكام هذه المادة بموجب مرسوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_6_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_6_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_6_19830702_OpEnact_756b79299e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1983-07-02/83-11#art_6_obligation_0_56a6c261> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 6" ;
    dzdoc:position 4 ;
    dzdoc:usesTerm dzterm:social_insurance .

