    dzdoc:eId "chp_2_chp_2_sec_3_chp_2_sec_3_subsec_2_art_4" ;
    dzdoc:fullText "يستفيد من الاداءات العينية : الاشخاص الطبيعيون غير الاجراء الذين يمارسون بالفعل الحسابهم الخاص نشاطا حرا صناعيا أو تجاريا أو حرفيا أو فلاحيا أو أي نشاط آخر مماثل وفقا للشروط المحددة في التنظيم المعمول به . كما يستفيد الاشخاص المذكورين أعلاه من الاداءات التقديم المتمثلة في منحة الوفاة و العجز . وتحدد قائمة المستفيدين وكذا الشروط الخاصة لتطبيق هذه المادة بموجب مرسوم"@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_3_chp_2_sec_3_subsec_2_art_4_right_0_66a97b35>,
