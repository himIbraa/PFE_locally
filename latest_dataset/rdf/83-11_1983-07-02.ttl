<https://legal.dz/resource/law/1983-07-02/83-11#version_art_4> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يستفيد من الاداءات العينية : الاشخاص الطبيعيون غير الاجراء الذين يمارسون بالفعل الحسابهم الخاص نشاطا حرا صناعيا أو تجاريا أو حرفيا أو فلاحيا أو أي نشاط آخر مماثل وفقا للشروط المحددة في التنظيم المعمول به . كما يستفيد الاشخاص المذكورين أعلاه من الاداءات التقديم المتمثلة في منحة الوفاة و العجز . وتحدد قائمة المستفيدين وكذا الشروط الخاصة لتطبيق هذه المادة بموجب مرسوم"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_4_19830702_OpEnact_3c79dbe48a> ;
    dzdoc:replacementText "يستفيد من الاداءات العينية : الاشخاص الطبيعيون غير الاجراء الذين يمارسون بالفعل الحسابهم الخاص نشاطا حرا صناعيا أو تجاريا أو حرفيا أو فلاحيا أو أي نشاط آخر مماثل وفقا للشروط المحددة في التنظيم المعمول به . كما يستفيد الاشخاص المذكورين أعلاه من الاداءات التقديم المتمثلة في منحة الوفاة و العجز . وتحدد قائمة المستفيدين وكذا الشروط الخاصة لتطبيق هذه المادة بموجب مرسوم"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_4> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
