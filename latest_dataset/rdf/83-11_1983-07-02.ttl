<https://legal.dz/resource/law/1983-07-02/83-11#chp_2_chp_2_sec_4_art_5_obligation_0_3b96044f_ref_c6bb4516dbb2> a dzdoc:Reference ;
    rdfs:label "المادة 48"@ar ;
