<https://legal.dz/resource/law/1983-07-02/83-11#art_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_27" ;
    dzdoc:fullText "تحدد الشروط التي تجري وفقها الفحوص قبل الوضع وبعده وكذا المراقبة التي قد تجريها هيئة الضمان الاجتماعي قبل الولادة وبعدها، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_27_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
