<https://legal.dz/resource/law/1983-07-02/83-11#version_art_74> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يشكل قسط اشتراك التأمينات الاجتماعية جزءا من اشتراك الضمان الاجتماعي الذي يحدد بموجب القانون. ویرصد لتمويل الاداءات ذات الطابع الفردي ولنفقات الخدمة الصحية والاجتماعية المشار اليها في المادة 92 أدناه، وكذا نفقات سير وتسيير هيئات الضمان الاجتماعي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_74_19830702_OpEnact_3c31af3d5f> ;
