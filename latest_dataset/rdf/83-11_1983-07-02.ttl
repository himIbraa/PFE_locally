<https://legal.dz/resource/law/1983-07-02/83-11#version_art_23> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تشمل أداءات التأمين على الولادة : (1) الاداءات العينية : كفالة المصاريف المترتبة من الحمل والوضع وتبعاته. (2) الاداءات النقدية : دفع تعويضة يومية للمرأة العاملة التي تضطر بسبب الولادة الى الانقطاع من العمل."@ar ;
