    dznorm:conditionText "مع مراعاة أحكام المادة 6 أدناه وفي القطاعات غير الهياكل الصحية العمومية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_59> ;
    dznorm:position 0 .

