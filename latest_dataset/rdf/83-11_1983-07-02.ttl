    dzdoc:fullText "يساوى المبلغ السنوى المعاش العجزة من الصنف الثاني 80% من الأجر المحدد في المادة السابقة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_38_para_0> ;
