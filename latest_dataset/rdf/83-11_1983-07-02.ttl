<https://legal.dz/resource/law/1983-07-02/83-11#art_59_obligation_0_d9dfa695_role_0f8eba16d9> a dznorm:Role ;
    rdfs:label "أساس نسبة %80 من"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يدفع مبلغ المصاريف المنصوص عليها في المادتين 8 و26 مع هذا القانون من طرف المؤمن له وتسددها له هيئة الضمان الاجتماعي، على أساس نسبة %80 من التعريفات المحددة عن طريق التنظيم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_59> .

<https://legal.dz/resource/law/1983-07-02/83-11#art_59_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_59> ;
    dzdoc:position 0 ;
    dzdoc:text "(1) مع مراعاة أحكام المادة 6 أدناه وفي القطاعات غير الهياكل الصحية العمومية يدفع مبلغ المصاريف المنصوص عليها في المادتين 8 و26 مع هذا القانون من طرف المؤمن له وتسددها له هيئة الضمان الاجتماعي، على أساس نسبة %80 من التعريفات المحددة عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_59_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_59> ;
    dzdoc:position 1 ;
    dzdoc:text "(2) تطبق أيضا هذه النسبة على الاستجمام والحمامات والاستجمامات المتخصصة مهما كانت طبيعة المؤسسة التي يتم فيها الاستجمام."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_59_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_59> ;
    dzdoc:position 2 ;
    dzdoc:text "(3) يتم تسديد المنتوجات الصيدلية القابلة للتسديد على أساس نسبة أقصاها %80، تحدد قائمة المنتوجات القابلة للتسديد وكذا نسب التسديد المماثلة عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_59_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_59> ;
    dzdoc:position 3 ;
    dzdoc:text "وفي انتظار صدور النصوص المشار إليها في الفقرة السابقة يتم التسديد بنسبة 50 %."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_59_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_59> ;
    dzdoc:position 4 ;
    dzdoc:text "(4) تحول نسب التسديد المنصوص عليها في الفقرتين 1 و 3 الى %100 في بعض الحالات باعتبار على الخصوص أما نوعية، أو أهمية، أو هدة العلاج المطلوب واما صفة صاحب المعاش أو الريع للضمان الاجتماعي."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_59_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_59> ;
    dzdoc:position 5 ;
    dzdoc:text "(5) تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/1983-07-02/83-11#art_5_obligation_0_3b96044f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/law/1983-07-02/83-11#art_5_obligation_0_3b96044f_ref_c6bb4516dbb2> ;
    dzdoc:references <https://legal.dz/resource/law/1983-07-02/83-11#art_48> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1983-07-02/83-11#art_48> ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_5> ;
    dznorm:position 0 ;
    dznorm:provisionText "ألا يقل هذا المبلغ من القيمة الدنيا المنصوص عليها في المادة 48 من هذا القانون"@ar ;
    dznorm:sourceArticle "art_5" .

<https://legal.dz/resource/law/1983-07-02/83-11#art_5_obligation_0_3b96044f_ref_c6bb4516dbb2> a dzdoc:Reference ;
    rdfs:label "المادة 48"@ar ;
    dzdoc:frbrUri "#art_48"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/1983-07-02/83-11#art_48> ;
    dzdoc:sourceEId "art_5" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "ألا يقل هذا المبلغ من القيمة الدنيا المنصوص عليها في المادة 48 من هذا القانون"@ar ;
    dzdoc:targetEId "art_48" .

<https://legal.dz/resource/law/1983-07-02/83-11#art_5_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_5> ;
    dzdoc:position 0 ;
    dzdoc:text "يستفيد ذوو حقوق صاحب معاش عجز أو تقاعد أو ريع حادث عمل كما جاء تعريفهم في المادة 67 أدناه، وفقا للشروط المنصوص عليها في المادتين 49 و 50 أعلاه من منحة وفاة يساوى مبلغها قيمة المبلغ السنوى لمعاش العجز أو معاش التقاعد أو ريع حادث عمل على ألا يقل هذا المبلغ من القيمة الدنيا المنصوص عليها في المادة 48 من هذا القانون."@ar .

