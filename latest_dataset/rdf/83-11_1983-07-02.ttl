<https://legal.dz/resource/law/1983-07-02/83-11#version_art_85> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز لهيئات الضمان الاجتماعي أن تعتد بعدم وفاء أصحاب العملى بالالتزامات الملقاة على هاتفهم، لرفض تقديم الاداءات للمؤمرع له الذي يستوفى الشروط المنشئة للحقوق . عندما لا يعفى اصحاب العمل بالتزاماتهم ، يتعين على هيئات الصمان الاجتماعي تقديم الاداءات للمؤمن له ثم تتولى مطالية هؤلاء بعد ذلك ."@ar ;
