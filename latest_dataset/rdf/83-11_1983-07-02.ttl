<https://legal.dz/resource/law/1983-07-02/83-11#art_67_condition_0_b13a56ff> a dznorm:Condition ;
    dznorm:conditionText "غير أنه لا تغول الاستفادة من الاداءات العينية للزوج اذا كان يمارس نشاطا مهنيا مأجورا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_67> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1983-07-02/83-11#art_67_condition_1_233c0468> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/law/1983-07-02/83-11#art_67_condition_1_233c0468_action_e2793b0a97> ;
    dznorm:conditionText "اذا كان الزوج نفسه أجيرا يمكن أن يستفيد من الاداءات بصفته صاحب الحق ان كان لا يستوفى شروط تحويل الحقوق بحكم نشاطه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1983-07-02/83-11#art_67> ;
