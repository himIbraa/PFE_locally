<https://legal.dz/resource/law/1983-07-02/83-11#version_art_58> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تمد بمثابة ثماني ساعات منع العمل المأجور التقدير الحق في الاداءات : (1) كل يوم تقاضى فيه المؤمن له التعويضات اليومية ل لتأمين على المرض والولادة وحوادث العمل والامراض المهنية (2)كل يوم انقطع فيه من العمل بسبب مرض عندما يكون المؤمن له قد استنفذ حقوقه في التعويض كما جاء تعريفها في المادة 15 أعلاه، شريطة أن تقر هيئة الضمان الاجتماعي عدم قدرته البدنية على مواصلة عمله أو استئنافه . (3) كل يوم من أيام المعطلة القانونية المدفوعة う (4) كل يوم قضى في أداء التزامات الخدمة الوطنية أو في حالة التعبئة العامة"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_58_19830702_OpEnact_fb338706e8> ;
    dzdoc:replacementText "تمد بمثابة ثماني ساعات منع العمل المأجور التقدير الحق في الاداءات : (1) كل يوم تقاضى فيه المؤمن له التعويضات اليومية ل لتأمين على المرض والولادة وحوادث العمل والامراض المهنية (2)كل يوم انقطع فيه من العمل بسبب مرض عندما يكون المؤمن له قد استنفذ حقوقه في التعويض كما جاء تعريفها في المادة 15 أعلاه، شريطة أن تقر هيئة الضمان الاجتماعي عدم قدرته البدنية على مواصلة عمله أو استئنافه . (3) كل يوم من أيام المعطلة القانونية المدفوعة う (4) كل يوم قضى في أداء التزامات الخدمة الوطنية أو في حالة التعبئة العامة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_58> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_58> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_59> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "(1) مع مراعاة أحكام المادة 6 أدناه وفي القطاعات غير الهياكل الصحية العمومية يدفع مبلغ المصاريف المنصوص عليها في المادتين 8 و 26 مع هذا القانون من طرف المؤمن له وتسددها له هيئة الضمان الاجتماعي ، على أساس نسبة %80 من التعريفات المحددة عن طريق التنظيم . (2) تطبق أيضا هذه النسبة على الاستجمام والحمامات والاستجمامات المتخصصة مهما كانت طبيعة المؤسسة التي يتم فيها الاستجمام. (3) يتم تسديد المنتوجات الصيدلية القابلة للتسديد على أساس نسبة أقصاها %80، تحدد قائمة المنتوجات القابلة للتسديد وكذا نسب التسديد"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_59_19830702_OpEnact_dcae8ff86c> ;
    dzdoc:replacementText "(1) مع مراعاة أحكام المادة 6 أدناه وفي القطاعات غير الهياكل الصحية العمومية يدفع مبلغ المصاريف المنصوص عليها في المادتين 8 و 26 مع هذا القانون من طرف المؤمن له وتسددها له هيئة الضمان الاجتماعي ، على أساس نسبة %80 من التعريفات المحددة عن طريق التنظيم . (2) تطبق أيضا هذه النسبة على الاستجمام والحمامات والاستجمامات المتخصصة مهما كانت طبيعة المؤسسة التي يتم فيها الاستجمام. (3) يتم تسديد المنتوجات الصيدلية القابلة للتسديد على أساس نسبة أقصاها %80، تحدد قائمة المنتوجات القابلة للتسديد وكذا نسب التسديد المماثلة عن طريق التنظيم. وفي انتظار صدور النصوص المشار إليها في الفقرة السابقة يتم التسديد بنسبة 50 %. (4) تحول نسب التسديد المنصوص عليها في الفقرتين 1 و 3 الى %100 في بعض الحالات باعتبار على الخصوص أما نوعية، أو أهمية، أو هدة العلاج المطلوب واما صفة صاحب المعاش أو الريع للضمان الاجتماعي. (5) تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_59> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1983-07-02/83-11#art_59> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1983-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/1983-07-02/83-11#version_art_6> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينطوى وجوبا تحت التأمينات الاجتماعية الاشخاص الذين يشتغلون في التراب الوطني أيا كانت جنسيتهم سواء كانوا يعملون بأية صفة من الصفات وحيثما كان الصالح فرد أو جماعة من أصحاب العمل، ومهما كان مبلسغ أو طبيعة أجرهم وشكل وطبيعة أو صلاحية عقد عملهم أو علاقتهم فيه . تطبق أحكام هذه المادة بموجب مرسوم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_6_19830702_OpEnact_756b79299e> ;
    dzdoc:replacementText "ينطوى وجوبا تحت التأمينات الاجتماعية الاشخاص الذين يشتغلون في التراب الوطني أيا كانت جنسيتهم سواء كانوا يعملون بأية صفة من الصفات وحيثما كان الصالح فرد أو جماعة من أصحاب العمل، ومهما كان مبلسغ أو طبيعة أجرهم وشكل وطبيعة أو صلاحية عقد عملهم أو علاقتهم فيه . تطبق أحكام هذه المادة بموجب مرسوم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
