    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 76" ;
    dzdoc:position 64 ;
    dzdoc:usesTerm dzterm:social_insurance .

<https://legal.dz/resource/law/1983-07-02/83-11#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_4> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "تحدد صلاحيات هيئات الضمان الاجتماعي وكذا تنظيمها الاداري والمالي رسير ها بموجب مرسوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_79_para_0> ;
