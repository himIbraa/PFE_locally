<https://legal.dz/resource/law/1983-07-02/83-11#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_الاول_subsec_2> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "يعاد النظر في قيمة التعويضات اليومية حسب تطور أجر منصب العمل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_21_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_21_19830702_OpEnact_722ae41c34> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 21" ;
    dzdoc:position 14 .

<https://legal.dz/resource/law/1983-07-02/83-11#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_3> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "يستهدف التأمين على العجز ، منح معاش للمؤمن له الذي يضطره العجز إلى الانقطاع عن عمله ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1983-07-02/83-11#art_31_right_0_9b77d344> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_31_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_31_19830702_OpEnact_6c30d5c4c5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "31" ;
    dzdoc:position 21 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_31_condition_0_0a513c04> ;
    dzdoc:usesTerm dzterm:insurance_against_disability .

<https://legal.dz/resource/law/1983-07-02/83-11#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_3_subsec_الاول> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "لا يقبل طلب معاش العجز الا اذا كان عمر المؤمن له أقل من السن التي تخول له الحق في التقاعد . غير أنه لا يعتد بشرط السن في حق المؤمن الذي لا يستوفي شروط مدة العمل للاستفادة من معاش التقاعد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_34_para_0>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_34_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_34_19830702_OpEnact_8c646fbf83> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "34" ;
    dzdoc:position 24 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_34_condition_0_42f15942> ;
    dzdoc:usesTerm dzterm:disability_pension,
        dzterm:insured,
        dzterm:retirement_pension .

<https://legal.dz/resource/law/1983-07-02/83-11#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "تراجع معاشات المجز حسب تطور النقطة الاستدلالية المعتمدة كأساس لحساب الاجر الاساسي للعمال."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_42> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_42_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_42_19830702_OpEnact_6d09f66ae0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "42" ;
    dzdoc:position 32 .

<https://legal.dz/resource/law/1983-07-02/83-11#art_46> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_46" ;
    dzdoc:fullText "يستبدل معاش العجز عند بلوغ سن التقاعد ، بـ معاش تقاعد يعادل مبلغه معاش العجز على الأقل وتضاف إليه عند الاقتضاء الزيادة عن الزوج المكفول ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_46> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_46_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_46_19830702_OpEnact_5e1baa6e70> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1983-07-02/83-11#art_46_obligation_0_664ddc68> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 46" ;
    dzdoc:position 36 ;
    dzdoc:usesTerm dzterm:disability_pension,
        dzterm:retirement_pension .

<https://legal.dz/resource/law/1983-07-02/83-11#art_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_الاول> ;
    dzdoc:eId "art_5" ;
    dzdoc:fullText "يستفيد ذوو حقوق صاحب معاش عجز أو تقاعد أو ريع حادث عمل كما جاء تعريفهم في المادة 67 أدناه، وفقا للشروط المنصوص عليها في المادتين 49 و 50 أعلاه من منحة وفاة يساوى مبلغها قيمة المبلغ السنوى لمعاش العجز أو معاش التقاعد أو ريع حادث عمل على ألا يقل هذا المبلغ من القيمة الدنيا المنصوص عليها في المادة 48 من هذا القانون ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1983-07-02/83-11#art_5_right_0_64583196> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_5_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_5_19830702_OpEnact_e43c515a3d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1983-07-02/83-11#art_5_obligation_0_3b96044f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 5" ;
    dzdoc:position 3 ;
    dzdoc:references <https://legal.dz/resource/law/1983-07-02/83-11#art_48>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_49>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_50>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_67> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1983-07-02/83-11#art_48>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_49>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_50>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_67> ;
    dzdoc:usesTerm dzterm:death_grant .

<https://legal.dz/resource/law/1983-07-02/83-11#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_5_subsec_1> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "ينشأ الحق في منحة الوفاة لذوى حقوق العامل ابتداء من اليوم الأول من مباشرة حمله الفعلي ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1983-07-02/83-11#art_53_right_0_40a38aaa> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_53_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_53_19830702_OpEnact_d5d2d4cf10> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 53" ;
    dzdoc:position 42 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_53_condition_0_3426bcd7> ;
    dzdoc:usesTerm dzterm:death_grant .

<https://legal.dz/resource/law/1983-07-02/83-11#art_58> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_5_subsec_1> ;
    dzdoc:eId "art_58" ;
    dzdoc:fullText "تمد بمثابة ثماني ساعات منع العمل المأجور التقدير الحق في الاداءات : (1) كل يوم تقاضى فيه المؤمن له التعويضات اليومية ل لتأمين على المرض والولادة وحوادث العمل والامراض المهنية (2)كل يوم انقطع فيه من العمل بسبب مرض عندما يكون المؤمن له قد استنفذ حقوقه في التعويض كما جاء تعريفها في المادة 15 أعلاه، شريطة أن تقر هيئة الضمان الاجتماعي عدم قدرته البدنية على مواصلة عمله أو استئنافه . (3) كل يوم من أيام المعطلة القانونية المدفوعة う (4) كل يوم قضى في أداء التزامات الخدمة الوطنية أو في حالة التعبئة العامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_58> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_58_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_58_19830702_OpEnact_fb338706e8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 58" ;
    dzdoc:position 47 ;
    dzdoc:references <https://legal.dz/resource/law/1983-07-02/83-11#art_15> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1983-07-02/83-11#art_15> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1983-07-02/83-11#art_58_condition_0_ad25f7f0> ;
    dzdoc:usesTerm dzterm:insured,
        dzterm:sickness_insurance .

<https://legal.dz/resource/law/1983-07-02/83-11#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_2_sec_5_subsec_3> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "يستفيد ذوو حقوق مسجون ، يقوم بعمل أثناء تنفيذ عقوبة جزائية كما جاء تعريفهم في المادة 67 أعلاه، من الاداءات العينية للتأمين على المرض ومنحة الوفاة المنصوص عليها في المادتين 8 و 47 أعلاه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1983-07-02/83-11#art_68_right_0_da3ee761> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_68_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_68_19830702_OpEnact_ddd0046c7c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 68" ;
    dzdoc:position 56 ;
    dzdoc:references <https://legal.dz/resource/law/1983-07-02/83-11#art_47>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_67>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_8> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1983-07-02/83-11#art_47>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_67>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_8> ;
    dzdoc:usesTerm dzterm:beneficiaries .

<https://legal.dz/resource/law/1983-07-02/83-11#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_3> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "يتم تمويل نفقات التأمينات الاجتماعية اعتمادا على قسط اشتراك اجباري على نفقة أصحاب العمل وكذا المستفيدين المشار اليهم في الباب الأول من هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_72_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_72_19830702_OpEnact_3b0734a2f8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1983-07-02/83-11#art_72_obligation_0_124eca00> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة 72" ;
    dzdoc:position 60 ;
    dzdoc:usesTerm dzterm:social_insurance .

<https://legal.dz/resource/law/1983-07-02/83-11#art_73_يعفى_من_دفع_الاشتراكات> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1983-07-02/83-11#chp_3> ;
    dzdoc:eId "art_73_يعفى_من_دفع_الاشتراكات" ;
    dzdoc:fullText "يعفى من دفع الاشتراكات : المجاهدون وأصحاب المعاشات المشار اليهم في المادة 5-أ الاشخاص المعوقون بدنيا أو عقليا المشار اليهم في المادة 5 ب ، الطلبة الاشخاص المشار اليهم في المواد 89 و 70 و 71 أعلاه، عندما يساوى مبلغ دخلهم الاجر الوطني الادنى المضمون أو يقل عنه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1983-07-02/83-11#art_73_يعفى_من_دفع_الاشتراكات_right_0_00d4f2d1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1983-07-02/83-11#version_art_73_يعفى_من_دفع_الاشتراكات> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1983-07-02/83-11#art_73_يعفى_من_دفع_الاشتراكات_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1983-07-02/83-11#version_art_73_19830702_OpEnact_e4491516f3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1983-07-02/83-11> ;
    dzdoc:introducedOn "1983-07-02"^^xsd:date ;
    dzdoc:number "المادة :73 يعفى من دفع الاشتراكات" ;
    dzdoc:position 61 ;
    dzdoc:references <https://legal.dz/resource/law/1983-07-02/83-11#art_5-أ>,
        <https://legal.dz/resource/law/1983-07-02/83-11#art_5-ب>,
