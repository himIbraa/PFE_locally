<https://legal.dz/resource/executive-decree/2006-01-09/06-05#art_1_extref_e684ed22> a dzdoc:ExternalReference ;
    rdfs:label "المادة 20 ( الفقرة 4 ) من القانون رقم 05-01 المؤرخ في 27 ذي الحجة عام 1425 الموافق 6 فبراير سنة 2005"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/2005-02-06/05-01#art_20_para_4"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/2005-02-06/05-01#art_20_para_4"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/2005-02-06/05-01#art_20_para_4" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/2005-02-06/05-01"^^xsd:anyURI ;
    dzdoc:targetEId "art_20_para_4" .

<https://legal.dz/resource/executive-decree/2006-01-09/06-05#art_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/executive-decree/2006-01-09/06-05#art_1> ;
    dzdoc:position 0 ;
    dzdoc:text "يحدد هذا المرسوم شكل الإخطار بالشبهة ونموذجه ومحتواه ووصل استلامه كما هو منصوص عليه في المادة 20 ( الفقرة 4 ) من القانون رقم 05-01 المؤرخ في 27 ذي الحجة عام 1425 الموافق 6 فبراير سنة 2005 والمذكور أعلاه."@ar .

<https://legal.dz/resource/executive-decree/2006-01-09/06-05#art_2_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/executive-decree/2006-01-09/06-05#art_2> ;
    dzdoc:position 0 ;
    dzdoc:text "ينشأ نموذج وحيد للإخطار بالشبهة ووصل استلام الإخطار بالشبهة."@ar .

<https://legal.dz/resource/executive-decree/2006-01-09/06-05#art_3_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/executive-decree/2006-01-09/06-05#art_3> ;
    dzdoc:position 0 ;
    dzdoc:text "يحرر الإخطار بالشبهة ووصل الاستلام المذكوران في المادة 2 أعلاه على المطبوعين المطابقين لنموذج المحفوظ لدى الهيئة المختصة \"خلية معالجة الاستعلام المالي\" المرفقين بالملحقين الأول والثاني."@ar .

