    dzdoc:introducedBy <https://legal.dz/resource/executive-decree/2006-01-09/06-05> ;
    dzdoc:introducedOn "2006-01-09"^^xsd:date ;
    dzdoc:number "المادة الأولى" ;
    dzdoc:position 0 ;
    dzdoc:referencesExternal <https://legal.dz/resource/executive-decree/2006-01-09/06-05#art_1_extref_e684ed22> ;
    dzdoc:usesTerm dzterm:suspicion_notification .

<https://legal.dz/resource/executive-decree/2006-01-09/06-05#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/executive-decree/2006-01-09/06-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/executive-decree/2006-01-09/06-05#body> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "يحرر الإخطار بالشبهة ووصل الاستلام المذكوران في المادة 2 أعلاه على المطبوعين المطابقين لنموذج المحفوظ لدى الهيئة المختصة \" خلية معالجة الاستعلام المالي \" المرفقين بالملحقين الأول والثاني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/executive-decree/2006-01-09/06-05#version_art_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/executive-decree/2006-01-09/06-05#art_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/executive-decree/2006-01-09/06-05#version_art_3_20060109_OpEnact_d36e66fe91> ;
    dzdoc:introducedBy <https://legal.dz/resource/executive-decree/2006-01-09/06-05> ;
    dzdoc:introducedOn "2006-01-09"^^xsd:date ;
    dzdoc:number "المادة 3" ;
    dzdoc:position 2 ;
    dzdoc:references <https://legal.dz/resource/executive-decree/2006-01-09/06-05#art_2> ;
    dzdoc:referencesInternal <https://legal.dz/resource/executive-decree/2006-01-09/06-05#art_2> ;
    dzdoc:usesTerm dzterm:ctrf,
        dzterm:suspicion_notification .

