<https://legal.dz/resource/executive-decree/2006-01-09/06-05#version_art_7> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/executive-decree/2006-01-09/06-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يوقع الإخطار بالشبهة ، حسب الحالات، ممثل المؤسسة البنكية أو المالية لدى خلية معالجة الاستعلام المالي ، أو أحد الخاضعين لواجب الإخطار المذكورين في المادة 19 الفقرة (2) من القانون رقم 05-01 المؤرخ في 6 فبراير سنة 2005 والمذكور علاه. يجب أن يكون التوقيع خطيا دون اللجوء إلى الاستنساخ أو التأشير."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/executive-decree/2006-01-09/06-05#version_art_7_20060109_OpEnact_909ca8e852> ;
    dzdoc:replacementText "يجب أن يوقع الإخطار بالشبهة ، حسب الحالات، ممثل المؤسسة البنكية أو المالية لدى خلية معالجة الاستعلام المالي ، أو أحد الخاضعين لواجب الإخطار المذكورين في المادة 19 الفقرة (2) من القانون رقم 05-01 المؤرخ في 6 فبراير سنة 2005 والمذكور علاه. يجب أن يكون التوقيع خطيا دون اللجوء إلى الاستنساخ أو التأشير."@ar ;
