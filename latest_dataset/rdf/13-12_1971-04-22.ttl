    dznorm:sourceArticle "art_106" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_106_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_106> ;
    dzdoc:position 0 ;
    dzdoc:text "يناط بـ وكيل الدولة العسكري تنفيذ أمر الإفراج المؤقت، وعلاوة على ذلك، فإنه يعلم به السلطة العسكرية المعنية."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_107_condition_0_c109138f> a dznorm:Condition ;
    dznorm:conditionText "إذا تخلف المتهم المتروك حرا أو المفرج عنه مؤقتا، عن الحضور رغم تكليفه بذلك، أو إذا اقتضت ظروف جديدة وخطيرة اعتقاله"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_107> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_107_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_107> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا تخلف المتهم المتروك حرا أو المفرج عنه مؤقتا، عن الحضور رغم تكليفه بذلك، أو إذا اقتضت ظروف جديدة وخطيرة اعتقاله، فـ لـ قاضي التحقيق العسكري، بعد استطلاع رأي وكيل الدولة العسكري، أن يصدر أمرا جديدا بإيداعه السجن."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_107_right_0_73e221b3> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
