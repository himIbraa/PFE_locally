    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_194> ;
    dznorm:conditionText "إذا كانت مدة غيابه غير محدودة، أو كان تبليغ الورقة لا يمكن أن يتم ضمن المهلتين المذكورتين في المادة 194"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_197> ;
    dznorm:position 0 .

