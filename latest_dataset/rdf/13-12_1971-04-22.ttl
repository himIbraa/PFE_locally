<https://legal.dz/resource/order/1971-04-22/71-28#version_art_183> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرفع الطعن بتصريح يقدم لكتابة ضبط المحكمة العسكرية التي أصدرت الحكم المطعون فيه. ويجب توقيع التصريح من كاتب الضبط وطالب الطعن بنفسه أو المدافع عن المحكوم عليه والمزود بتوكيل خاص . وفي هذه الحالة يرفق التوكيل بالمحضر المحرر من كاتب الضبط. وإذا كان الطاعن لا يستطيع التوقيع أو يجهل التوقيع، أشار كاتب الضبط إلى ذلك. ويقيد التصريح بالطعن في السجل المخصص لذلك طبقا ل المادة 98 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_183_19710422_OpEnact_77dc565c0d> ;
    dzdoc:replacementText "يرفع الطعن بتصريح يقدم لكتابة ضبط المحكمة العسكرية التي أصدرت الحكم المطعون فيه. ويجب توقيع التصريح من كاتب الضبط وطالب الطعن بنفسه أو المدافع عن المحكوم عليه والمزود بتوكيل خاص . وفي هذه الحالة يرفق التوكيل بالمحضر المحرر من كاتب الضبط. وإذا كان الطاعن لا يستطيع التوقيع أو يجهل التوقيع، أشار كاتب الضبط إلى ذلك. ويقيد التصريح بالطعن في السجل المخصص لذلك طبقا ل المادة 98 من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_183> ;
