<https://legal.dz/resource/order/1971-04-22/71-28#art_99_obligation_1_7bfe4ff6> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1971-04-22/71-28#art_99_obligation_1_7bfe4ff6_action_fc04c7bf7b> ;
