<https://legal.dz/resource/order/1971-04-22/71-28#art_173> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_3_subsec_2> ;
    dzdoc:eId "art_173" ;
    dzdoc:fullText "إذا تبين من الأوراق المقدمة أو من الشهادات المدلى بها من قبل الشهود أثناء المرافعات بأنه يجوز ملاحقة المتهم عن أفعال أخرى ، أمر الرئيس بوضع محضر بذلك . يجوز للمحكمة أن توقف النظر في الوقائع المرفوعة إليها وتؤجل القضية إلى جلسة تالية أو أن تحيل المحكوم عليه بعد إصدار الحكم ، مع الأوراق إلى السلطة المختصة للنظر في إصدار أمر جديد بالملاحقة إذا لزم الأمر، أو بالإحالة للمحكمة المختصة . وإذا صدر الحكم بالبراءة أو الإعفاء من العقاب ، فـ تأمر المحكمة بتسليم العسكري المقررة براءته أو المعفى من العقاب، بواسطة القوة العمومية للسلطة العسكرية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_173_permission_0_7ce51845>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_173_permission_1_7eb35406> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_173_right_0_afd15722>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_173_right_1_11491308> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_173> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_173_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_173_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_173_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_173_19710422_OpEnact_4f1079b6e8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_173_obligation_0_f2a6cd93>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_173_obligation_1_f51f97ec> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 173" ;
    dzdoc:position 172 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_173_condition_0_5694dc32>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_173_condition_1_466b7280> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/order/1971-04-22/71-28#art_313> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_313" ;
    dzdoc:fullText "كل عسكري أو كل شخص منتقل يقدم على إهانة رئيسه بالكلام أو بالكتابات أو بالحركات أو بالتهديد يعاقب بالحبس من ستة أشهر إلى خمس سنوات . وإذا كان المجرم ضابطا فإنه يعاقب بالحبس من سنة إلى خمس سنوات وبعقوبة العزل أو بإحدى هاتين العقوبتين . وإذا ارتكب الجرم على ظهر سفينة من قبل عسكري أو كل شخص منتقل عليها فيعتبر كأنه مرتكب أثناء الخدمة. ويعاقب في الحالات الأخرى بالحبس من شهرين إلى سنتين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_313> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_313_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_313_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_313_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_313_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_313_19710422_OpEnact_b449405637> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_313_obligation_0_4bca526a>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_313_obligation_1_d21d621e>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_313_obligation_2_985f8315> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "313" ;
    dzdoc:position 312 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_313_condition_0_1ad633a0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_313_condition_1_9fe340f7>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_313_condition_2_64943e29> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_316> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_316" ;
    dzdoc:fullText "كل عسكري أو كل شخص منتقل يرتكب أعمال العنف وهو مسلح بخفير أو حارس ، يعاقب بالسجن المؤقت مع الأشغال من عشر سنوات إلى عشرين سنة . وإذا لم تقع أعمال العنف بالسلاح، وإنما وقعت فقط من قبل عسكري أو شخص منتقل بصحبة شخص أو عدة أشخاص ، فيعاقب المجرم بالحبس من سنة إلى حمس سنوات . وإذا وقع العنف من عسكري أو شخص وحيد وغير مسلح ، فيعاقب بالحبس من ستة أشهر إلى ثلاث سنوات . وإذا حصلت أعمال العنف أمام العدو أو عصابة مسلحة أو في زمن الحرب أو في أرض أعلنت فيها حالة الحكم العرفي أو حالة الطوارئ أو داخل محزن للأسلحة أو حصن أو مخزن للبارود أو قاعدة أو على جوانب هذه الأماكن فيمكن أن ترفع العقوبات إلى السجن المؤبد مع الأشغال في الحالتين المذكورتين في الفقرة 1 و2 أعلاه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_316> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_316_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_316_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_316_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_316_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_316_19710422_OpEnact_bbfaed1995> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_316_obligation_0_0c0c7dbb>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_316_obligation_1_e4d64ce2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_316_obligation_2_dc4dbcf9>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_316_obligation_3_8180f4d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "316" ;
    dzdoc:position 315 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_316> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_316> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_316_condition_0_1227f0f2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_316_condition_1_15bf98fc>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_316_condition_2_3f67c805>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_316_condition_3_d76533b8> ;
    dzdoc:usesTerm dzterm:military .

<https://legal.dz/resource/order/1971-04-22/71-28#art_324> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_4> ;
    dzdoc:eId "art_324" ;
    dzdoc:fullText "يعاقب بالسجن من شهرين إلى سنتين كل عسكري يخالف أمرا عاما صادرا للجند، أو التعليمات التي أوكل إليه شخصيا أمر تنفيذها أو يتمرد على التعليمات المعطاة لعسكري سواه. ويمكن أن ترفع عقوبة الحبس إلى خمس سنوات، إذا ارتكب الجرم في زمن الحرب أو في أراض أعلنت فيها حالة الحكم العرفي أو حالة الطوارئ أو عندما يتعرض لتهديد أمن مؤسسة أو تشكيلة عسكرية أو سفينة بحرية أو طائرة عسكرية . ويمكن كذلك أن ترفع عقوبة الحبس إلى خمس سنوات، إذا حصل الفعل أمام عصابة مسلحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_324> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_324_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_324_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_324_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_324_19710422_OpEnact_60bd9a557a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_324_obligation_0_f846c5e7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "324" ;
    dzdoc:position 323 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_324_condition_0_34807a18>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_324_condition_1_727f7bae> ;
    dzdoc:usesTerm dzterm:military_personnel .

<https://legal.dz/resource/order/1971-04-22/71-28#art_97> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_12> ;
    dzdoc:eId "art_97" ;
    dzdoc:fullText "يمكن وكيل الدولة العسكري في جميع الأحوال، أن يستأنف الأوامر الصادرة عن قاضي التحقيق العسكري . ويمكن للمتهم أن يستأنف الأوامر التي يقرر فيها قاضي التحقيق العسكري اختصاصه بنظر الدعوى إما من تلقاء نفسه أو بناء على الدفع بعدم الاختصاص، أو التي يقرر فيها رد سبب يتعلق بسقوط الدعوى العمومية وكذلك الأوامر المنصوص عليها في الفقرة 2 من المادة 143 و الفقرة 2 من المادة 154 من قانون الاجراءات الجزائية و المادتين 85 و 105 من هذا القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_97_permission_0_28a12e2c> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_97_right_0_c376905b>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_97_right_1_7db8c7c9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_97> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_97_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_97_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_97_19710422_OpEnact_d620b10e07> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 97" ;
    dzdoc:position 96 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_105>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_85> ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_97_extref_10008642>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_97_extref_abace2f4> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_105>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_85> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:prosecutor .

dzterm:military a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "العسكري"@ar,
        "العسكريون"@ar,
        "عسكري"@ar,
        "عسكريا"@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_7> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "إذا وقع من المدافع في الجلسة أي إخلال بالالتزامات التي يوجبها عليه يمينه ، جاز عقابه فورا من المحكمة المطروح أمامها النزاع، بناء على طلب النيابة العامة. وأن العقوبات التي يجوز تطبيقها هي: الإنذار، التوبيخ، المنع المؤقت لمدة لا تتجاوز ثلاث سنوات، الشطب من جدول المحامين. وفضلا عن ذلك يجوز أن يتضمن القرار التأديبي، الذي يقضي بالإنذار أو المنع المؤقت، الحرمان من حق العضوية في مجلس النقابة خلال مدة لا تتجاوز عشر سنوات. إذا أبدت النيابة العامة طلباتها في الدعوى التأديبية بغياب المدافع ، فتؤجل الدعوى بحكم القانون أمام نفس المحكمة، ولأول جلسة تعقد غداة ذلك اليوم، دون حاجة لإجراءات أخرى. وكل حكم يصدر تطبيقا لهذه المادة يكون نافذا بمجرد إصداره بقطع النظر عن ممارسة طرق الطعن. إذا وجب خروج المحامي المختار أوليا، من الجلسة ، جاز ل لمتهم اختيار مدافع جديد عنه ، وإلا اختار له رئيس المحكمة من تلقاء نفسه مدافعا ،آخر، ويجوز لهذا الأخير في هذه الحالة أن يطلب مهلة لا تتجاوز 48 ساعة لدراسة الملف."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_157_permission_0_589a7e7a>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_157_permission_1_1f3de27b> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_157_right_0_f3439696> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_157_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_157_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_157_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_157_para_3>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_157_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_157_19710422_OpEnact_0e3119e761> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 157" ;
    dzdoc:position 156 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_157> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_157> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_157_condition_0_36926be4>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_157_condition_1_e91d45b1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_157_condition_2_f69ef252> ;
    dzdoc:usesTerm dzterm:accused .

<https://legal.dz/resource/order/1971-04-22/71-28#art_181> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_181" ;
    dzdoc:fullText "يجوز للمحكوم عليه في زمن السلم، وحتى في حالة الحكم المعتبر حضوريا أن يصرح لدى كتابة الضبط بالطعن بالنقض في الحكم ، بعد 8 أيام كاملة من إطلاعه عليه . كما يجوز لوكيل الدولة العسكري أن يصرح لدى كتابة الضبط بطلب نقض الحكم الصادر ، وذلك في نفس المهلة من تاريخ إصدار الحكم. وفي زمن الحرب تقصر هذه المهل إلى يوم كامل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_181_permission_0_b9b7e87c>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_181_permission_1_2ead761b> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_181_right_0_ade37041>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_181_right_1_00ab5ea7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_181> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_181_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_181_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_181_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_181_19710422_OpEnact_b7b4d0c9aa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
