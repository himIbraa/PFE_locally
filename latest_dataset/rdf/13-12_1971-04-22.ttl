<https://legal.dz/resource/order/1971-04-22/71-28#version_art_194> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون المهلة الواقعة بين يوم تسليم التكليف بالحضور للمتهم واليوم المحدد لمثوله، 8 أيام كاملة على الأقل. وتخفض هذه المهلة في زمن الحرب إلى 24 ساعة. ولا تضاف أية مهلة خاصة بالمسافة إلى المهلتين المذكورتين."@ar ;
