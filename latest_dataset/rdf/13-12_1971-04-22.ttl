<https://legal.dz/resource/order/1971-04-22/71-28#art_210_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_210> ;
    dzdoc:position 0 ;
