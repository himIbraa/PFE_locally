<https://legal.dz/resource/order/1971-04-22/71-28#version_art_248> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن كل عقوبة صادرة من أية محكمة كانت ضد ضابط أو ضابط صف محترف أو ضابط صف قائم بالخدمة بموجب عقد، يترتب عليها فقدان الرتبة تلقائيا، وإن لم تؤد هذه العقوبة إلى التجريد من الحقوق الوطنية أو العزل، إذا كانت صادرة عن جناية . إن كل حكم بعقوبة حبس لمدة ثلاثة أشهر فأكثر ، مع وقف التنفيذ أو بدونه، صادرة ضد ضابط أو ضابط صف محترف أو ضابط قائم بالخدمة بموجب عقد، يترتب عليه فقدان الرتبة، في حالة ارتكاب أحد الأفعال التالية: الجنح المنصوص عليها في المادة 126 وما يليها من قانون العقوبات، الجنح المنصوص عليها في ا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_248_19710422_OpEnact_be0677c919> ;
    dzdoc:replacementText "إن كل عقوبة صادرة من أية محكمة كانت ضد ضابط أو ضابط صف محترف أو ضابط صف قائم بالخدمة بموجب عقد، يترتب عليها فقدان الرتبة تلقائيا، وإن لم تؤد هذه العقوبة إلى التجريد من الحقوق الوطنية أو العزل، إذا كانت صادرة عن جناية . إن كل حكم بعقوبة حبس لمدة ثلاثة أشهر فأكثر ، مع وقف التنفيذ أو بدونه، صادرة ضد ضابط أو ضابط صف محترف أو ضابط قائم بالخدمة بموجب عقد، يترتب عليه فقدان الرتبة، في حالة ارتكاب أحد الأفعال التالية: الجنح المنصوص عليها في المادة 126 وما يليها من قانون العقوبات، الجنح المنصوص عليها في المادة 350 وما يليها و المواد 372 و 373 ومن 376 إلى 382 و 387 من قانون العقوبات، العقوبات المشار إليها في القانون الخاص بحرية الصحافة. ويجري مثل ذلك، حتى ولو كانت العقوبة صادرة بالحبس أقل من ثلاثة أشهر ، لكنها تتضمن إما المنع من الإقامة أو الحرمان كليا أو جزئيا من الحقوق الوطنية أو المدنية والعائلية، أو إذا تضمنت العقوبة الحكم بعدم أهلية المحكوم عليه من ممارسة أية وظيفة عمومية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_248> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_248> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1971-04-22/71-28#version_art_249> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
