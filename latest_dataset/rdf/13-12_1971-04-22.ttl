<https://legal.dz/resource/order/1971-04-22/71-28#version_art_58> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينبغي على الرؤساء السلميين تلبية طلب ضباط الشرطة القضائية العسكرية، الرامي لأن يوضع تحت تصرفهم عسكري قائم بالخدمة ، عندما تقتضي ذلك ضرورات التحقيق الابتدائي أو الجرم المتلبس به أو تنفيذ إنابة قضائية . ولا يجوز لضباط الشرطة القضائية العسكرية المذكورين الاحتفاظ بالعسكريين الموضوعين تحت تصرفهم أكثر من 3 أيام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_58_19710422_OpEnact_a178cf277d> ;
    dzdoc:replacementText "ينبغي على الرؤساء السلميين تلبية طلب ضباط الشرطة القضائية العسكرية، الرامي لأن يوضع تحت تصرفهم عسكري قائم بالخدمة ، عندما تقتضي ذلك ضرورات التحقيق الابتدائي أو الجرم المتلبس به أو تنفيذ إنابة قضائية . ولا يجوز لضباط الشرطة القضائية العسكرية المذكورين الاحتفاظ بالعسكريين الموضوعين تحت تصرفهم أكثر من 3 أيام."@ar ;
    dzdoc:resolutionStatus "resolved" ;
