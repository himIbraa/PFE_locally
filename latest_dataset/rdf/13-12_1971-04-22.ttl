<https://legal.dz/resource/order/1971-04-22/71-28#version_art_63> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز ل ضباط الشرطة القضائية العسكرية و ضباط الشرطة القضائية المدنية الاحتفاظ بالأشخاص الأجانب عن الجيش إلا في نطاق الأوضاع والكيفيات المحددة في المواد من 51 إلى 53 و المادتين 65 و 141 من قانون الاجراءات الجزائية المعدلة ب المادة 45 من هذا القانون . ويتولى مراقبة الوضع تحت المراقبة وكيل الدولة العسكري أو قاضي التحقيق العسكري المختصان إقليميا، واللذان يمكنهما أن يفوضا سلطاتهما إلى كل من وكيل الدولة أو قاضي التحقيق لدى المحكمة التي حصل في دائرة اختصاصها الوضع تحت المراقبة. ويجب سوق الأشخاص الأجا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_63_19710422_OpEnact_6a96b40ab1> ;
    dzdoc:replacementText "لا يجوز ل ضباط الشرطة القضائية العسكرية و ضباط الشرطة القضائية المدنية الاحتفاظ بالأشخاص الأجانب عن الجيش إلا في نطاق الأوضاع والكيفيات المحددة في المواد من 51 إلى 53 و المادتين 65 و 141 من قانون الاجراءات الجزائية المعدلة ب المادة 45 من هذا القانون . ويتولى مراقبة الوضع تحت المراقبة وكيل الدولة العسكري أو قاضي التحقيق العسكري المختصان إقليميا، واللذان يمكنهما أن يفوضا سلطاتهما إلى كل من وكيل الدولة أو قاضي التحقيق لدى المحكمة التي حصل في دائرة اختصاصها الوضع تحت المراقبة. ويجب سوق الأشخاص الأجانب عن الجيش الذين تقوم ضدهم أدلة خطيرة ومطابقة للجرم في مهلة أقصاها حلول أجال المهل المنصوص عليها في القانون، وتقديمهم إلى وكيل الدولة العسكري أو قاضي التحقيق العسكري المحالة عليه القضية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_63> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_63> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

