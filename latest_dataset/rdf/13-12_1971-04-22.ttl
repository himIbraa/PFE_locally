<https://legal.dz/resource/order/1971-04-22/71-28#version_art_302> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد في حالة تمرد : 1- العسكريون تحت السلاح والأشخاص المنتقلون الذين يجتمعون وعددهم أربعة على الأقل فيرفضون بالاتفاق الإذعان لأوامر رؤسائهم لدى أول إنذار. 2- العسكريون والأشخاص المنتقلون الذين يجتمعون وعددهم أربعة على الأقل فيحملون الأسلحة من دون إذن ويعملون خلافا لأوامر رؤسائهم. 3- العسكريون والأشخاص المنتقلون الذين يجتمعون وعددهم ثمانية على الأقل، ويقدمون على العنف مع استعمال السلاح ويرفضون نداء السلطة المختصة بأن يتفرقوا ويعودوا إلى النظام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_302_19710422_OpEnact_e28ebe239d> ;
    dzdoc:replacementText "يعد في حالة تمرد : 1- العسكريون تحت السلاح والأشخاص المنتقلون الذين يجتمعون وعددهم أربعة على الأقل فيرفضون بالاتفاق الإذعان لأوامر رؤسائهم لدى أول إنذار. 2- العسكريون والأشخاص المنتقلون الذين يجتمعون وعددهم أربعة على الأقل فيحملون الأسلحة من دون إذن ويعملون خلافا لأوامر رؤسائهم. 3- العسكريون والأشخاص المنتقلون الذين يجتمعون وعددهم ثمانية على الأقل، ويقدمون على العنف مع استعمال السلاح ويرفضون نداء السلطة المختصة بأن يتفرقوا ويعودوا إلى النظام."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_302> ;
