    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_182> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_182_condition_0_fe9ef3a7_ref_aa2604428dc8> a dzdoc:Reference ;
    rdfs:label "المادة 169"@ar ;
    dzdoc:frbrUri "#art_169"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1971-04-22/71-28#art_169> ;
    dzdoc:sourceEId "art_182" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "الشروط المنصوص عليها في المادة 169 من هذا القانون"@ar ;
    dzdoc:targetEId "art_169" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_182_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_182> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز أيضا لوكيل الدولة العسكري أن يطعن بالنقض ضد : أحكام البراءة، الأحكام القاضية بمنع المحاكمة، الأحكام الفاصلة برد الأشياء المحجوزة ضمن الشروط المنصوص عليها في المادة 169 من هذا القانون."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_182_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_182> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا يجوز أن تمس هذه الطعون في حقوق المتهم ، إلا في الحالة الأولى، عندما يكون الحكم قد أغفل الفصل في أحد عناصر الاتهام، أو في الحالة الثانية، إذا حصل في الحكم تطبيق خاطئ في دعوى شملها انقضاء الدعوى العمومية."@ar .

