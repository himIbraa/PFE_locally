    dznorm:position 0 ;
    dznorm:provisionText "كل عسكري جعل نفسه قصدا غير صالح للخدمة مؤقتا أو مؤبدا، ليتهرب من واجباته العسكرية يعاقب على الشكل التالي :"@ar ;
    dznorm:sourceArticle "art_273" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_273_obligation_0_3530432e_role_0c6bc4188e> a dznorm:Role ;
    rdfs:label "الشكل التالي"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "كل عسكري جعل نفسه قصدا غير صالح للخدمة مؤقتا أو مؤبدا، ليتهرب من واجباته العسكرية يعاقب على الشكل التالي :"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_273> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_273_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_273> ;
    dzdoc:position 0 ;
    dzdoc:text "كل عسكري جعل نفسه قصدا غير صالح للخدمة مؤقتا أو مؤبدا، ليتهرب من واجباته العسكرية يعاقب على الشكل التالي : 1 - في زمن السلم، بالحبس من سنة واحدة إلى خمس سنوات، وبمنعه من ممارسة الحقوق المنصوص عليها في المدة 8 من قانون العقوبات لمدة تتراوح بين خمس سنوات إلى عشر سنوات، وإذا كان المجرم ضابطا يحكم عليه بعقوبة العزل. 2 - في زمن الحرب، بالسجن المؤقت مع الأشغال من خمس سنوات إلى عشر سنوات. 3 - بنفس العقوبة إذا وجد في أرض بحالة الحكم العرفي أو بحالة الطوارئ أو أمام عصابة مسلحة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_273_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_273> ;
    dzdoc:position 1 ;
    dzdoc:text "ويعاقب بالإعدام إذا كان أمام العدو."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_273_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_273> ;
    dzdoc:position 2 ;
    dzdoc:text "ويعاقب عن المحاولة كما يعاقب عن الجرم نفسه."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_273_right_0_50c57160> a dznorm:Right ;
