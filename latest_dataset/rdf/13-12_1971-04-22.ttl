    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_93> ;
    dznorm:position 0 ;
    dznorm:provisionText "يفرج عن المتهم بعد انقضاء مهلة شهر واحد من تاريخ أمر الإحالة"@ar ;
    dznorm:sourceArticle "art_93" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_94_condition_0_34cdc2c6> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/order/1971-04-22/71-28#art_94_condition_0_34cdc2c6_action_8ce739bee4> ;
