<https://legal.dz/resource/order/1971-04-22/71-28#version_art_154> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يشرع الرئيس في استنطاق المتهم ويتلقى شهادات الشهود . ومتى انتهى التحقيق في الجلسة سمعت طلبات وكيل الدولة العسكري ودفاع المتهم والمدافع عنه. ل وكيل الدولة العسكري أن يرد على أوجه الدفاع إذا رأى ذلك ضروريا، إنما تبقى الكلمة الأخيرة دائما ل لمتهم والمدافع عنه. ويسأل الرئيس المتهم إذا لم يبق لديه ما يزيده لدفاعه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_154_19710422_OpEnact_594e971a43> ;
    dzdoc:replacementText "يشرع الرئيس في استنطاق المتهم ويتلقى شهادات الشهود . ومتى انتهى التحقيق في الجلسة سمعت طلبات وكيل الدولة العسكري ودفاع المتهم والمدافع عنه. ل وكيل الدولة العسكري أن يرد على أوجه الدفاع إذا رأى ذلك ضروريا، إنما تبقى الكلمة الأخيرة دائما ل لمتهم والمدافع عنه. ويسأل الرئيس المتهم إذا لم يبق لديه ما يزيده لدفاعه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_154> ;
