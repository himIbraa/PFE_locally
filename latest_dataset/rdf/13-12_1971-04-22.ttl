    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_47> ;
    dznorm:conditionText "عندما يطلع وزير الدفاع الوطني على محضر أو تقرير ضابط الشرطة القضائية العسكرية أو إحدى السلطات المذكورة في المادة 47 أو بعد استلامه شكوى أو اتهام وحتى بصفة تلقائية، ويرى بأنه ينبغي إجراء الملاحقات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_71> ;
    dznorm:position 0 .

