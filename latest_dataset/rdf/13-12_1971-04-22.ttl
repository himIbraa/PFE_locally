    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1971-04-22/71-28#version_art_328> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات كل عسكري يترك مركز وظيفته أو لا ينفذ التعليمات الصادرة إليه، عندما يكون قائما بالحراسة أو المراقبة أو الخفر أو الخدمة الربعية زمن السلم . وإذا وجد العسكري نائما وهو في مركز وظيفته يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات . وتكون عقوبة الحبس في مطلق الأحوال، من خمس سنوات إلى عشر سنوات إذا كان المجرم في إحدى الحالات الواردة في الفقرة 2 من المادة 324 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_328_19710422_OpEnact_fa7367cab6> ;
    dzdoc:replacementText "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات كل عسكري يترك مركز وظيفته أو لا ينفذ التعليمات الصادرة إليه، عندما يكون قائما بالحراسة أو المراقبة أو الخفر أو الخدمة الربعية زمن السلم . وإذا وجد العسكري نائما وهو في مركز وظيفته يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات . وتكون عقوبة الحبس في مطلق الأحوال، من خمس سنوات إلى عشر سنوات إذا كان المجرم في إحدى الحالات الواردة في الفقرة 2 من المادة 324 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_328> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
