    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يعتبر فارا إلى خارج البلاد، كل عسكري يتخلف بدون رخصة عن الالتحاق بالسفينة أو الطائرة حين المغادرة، وهو خارج التراب الوطني، حتى ولو حضر أمام السلطة قبل انقضاء الميعاد المحدد في المادة 258."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_260_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_260> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر فارا إلى خارج البلاد، كل عسكري يتخلف بدون رخصة عن الالتحاق بالسفينة أو الطائرة حين المغادرة، وهو خارج التراب الوطني، حتى ولو حضر أمام السلطة قبل انقضاء الميعاد المحدد في المادة 258."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_268_defocc_032eaf3c6321> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 214 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:front_of_enemy ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_268> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_268_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يجب أن يعتبر كأنه موجود \"أمام العدو\" كل عسكري أو غير عسكري ضمن وحدة أو تشكيلة عسكرية أو هيئة ملاحي سفينة بحرية أو طائرة عسكرية أو سفينة تجارية محروسة، يمكن أن يشتبك بسرعة مع العدو أو يكون اشتبك معه أو تعرض لهجماته."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_268_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_268> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب أن يعتبر كأنه موجود \"أمام العدو\" كل عسكري أو غير عسكري ضمن وحدة أو تشكيلة عسكرية أو هيئة ملاحي سفينة بحرية أو طائرة عسكرية أو سفينة تجارية محروسة، يمكن أن يشتبك بسرعة مع العدو أو يكون اشتبك معه أو تعرض لهجماته."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_26_defocc_8c58ef5761c9> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 247 ;
    dzdoc:charStart 0 ;
