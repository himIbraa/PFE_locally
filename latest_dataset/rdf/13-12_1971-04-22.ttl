    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يعتبر كعسكريين في مفهوم هذا القانون الأشخاص القائمون بالخدمة أو المعدودون في حالة حضور أو استيداع أو غياب نظامي أو غياب غير نظامي خلال مدة العفو السابقة للقرار، أو الأشخاص غير القائمين بالخدمة وهم باقون تحت تصرف وزارة الدفاع الوطني ويتقاضون الراتب."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_26_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_26> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر كعسكريين في مفهوم هذا القانون الأشخاص القائمون بالخدمة أو المعدودون في حالة حضور أو استيداع أو غياب نظامي أو غياب غير نظامي خلال مدة العفو السابقة للقرار، أو الأشخاص غير القائمين بالخدمة وهم باقون تحت تصرف وزارة الدفاع الوطني ويتقاضون الراتب."@ar .

