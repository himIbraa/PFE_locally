<https://legal.dz/resource/order/1971-04-22/71-28#version_art_96> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تخضع الأوامر الصادرة من قاضي التحقيق العسكري لأحكام المادة 169 من قانون الاجراءات الجزائية . ويبلغ المدافع عن المتهم جميع الأوامر القضائية خلال 24 ساعة بموجب رسالة مضمونة . ويبلغ المتهم من قبل وكيل الدولة العسكري في نفس المهلة بالأوامر التي يمكنه استئنافها بمقتضى أحكام المادة 97 ، تبعا للأوضاع المنصوص عليها في المادة 191 وما يليها. وفي زمن الحرب يمكن أن يجري تبليغ المدافع عن المتهم بكل أمر صادر، بموجب رسالة أو بأية وسيلة أخرى."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_96_19710422_OpEnact_2d24a6ec8d> ;
    dzdoc:replacementText "تخضع الأوامر الصادرة من قاضي التحقيق العسكري لأحكام المادة 169 من قانون الاجراءات الجزائية . ويبلغ المدافع عن المتهم جميع الأوامر القضائية خلال 24 ساعة بموجب رسالة مضمونة . ويبلغ المتهم من قبل وكيل الدولة العسكري في نفس المهلة بالأوامر التي يمكنه استئنافها بمقتضى أحكام المادة 97 ، تبعا للأوضاع المنصوص عليها في المادة 191 وما يليها. وفي زمن الحرب يمكن أن يجري تبليغ المدافع عن المتهم بكل أمر صادر، بموجب رسالة أو بأية وسيلة أخرى."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_96> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
