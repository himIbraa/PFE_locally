    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_186> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_186_condition_1_0697faf1> a dznorm:Condition ;
    dznorm:conditionText "وإذا أبطل الحكم لأي سبب آخر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_186> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_186_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_186> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا أبطل المجلس الأعلى الحكم لعدم الاختصاص، فإنه يقضي بإحالة القضية إلى المحكمة المختصة ويعينها."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_186_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_186> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا أبطل الحكم لأي سبب آخر، فيحيل القضية إلى محكمة عسكرية، لم يسبق لها أن نظرت فيها ما لم يكن الإبطال مقررا، إما لأن الواقعة لا تكون جناية أو جنحة أو مخالفة، وإما لأن الواقعة مشمولة بالتقادم أو العفو، ولم يبق بتاتا ما يمكن أن يحكم فيه."@ar .

