    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_86> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_86_obligation_0_4de0172c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1971-04-22/71-28#art_86_obligation_0_4de0172c_role_a9f6be472c> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_86> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتعين على هذا الأخير، أن يرفع الأمر بموجب عريضة إلى المحكمة العسكرية لتنظر فيها في أقرب جلسة لها"@ar ;
    dznorm:sourceArticle "art_86" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_86_obligation_0_4de0172c_role_a9f6be472c> a dznorm:Role ;
    rdfs:label "هذا الأخير"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يتعين على هذا الأخير، أن يرفع الأمر بموجب عريضة إلى المحكمة العسكرية لتنظر فيها في أقرب جلسة لها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_86> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_86_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_86> ;
    dzdoc:position 0 ;
    dzdoc:text "إن قاضي التحقيق العسكري له السلطة باتهام أي شخص خاضع للمحاكم العسكرية، ساهم كفاعل أو شريك في الأفعال المنسوبة إليه وذلك بعد صدور الرأي الموافق من وكيل الدولة العسكري، كما يمكنه تعديل الاتهام عندما يجب إعطاء وصف جديد لهذه الأفعال يؤدي لعقوبة أشد."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_86_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_86> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي حالة عدم الاتفاق بين قاضي التحقيق ووكيل الدولة العسكري، يتعين على هذا الأخير، أن يرفع الأمر بموجب عريضة إلى المحكمة العسكرية لتنظر فيها في أقرب جلسة لها."@ar .

