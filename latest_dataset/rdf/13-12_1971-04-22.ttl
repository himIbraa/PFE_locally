<https://legal.dz/resource/order/1971-04-22/71-28#version_art_322> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين إلى سنتين كل عسكري أساء استعمال السلطات المعطاة له بالمصادرة العسكرية، أو رفض أن يعطي وصلا بالكميات التي تسلمها. وكل عسكري مارس المصادرة وهو غير متمتع بهذه السلطة يعاقب بالحبس من سنة إلى خمس سنوات إذا حصلت المصادرة بدون عنف. وإذا حصلت المصادرة بعنف يعاقب بالسجن المؤقت مع الأشغال من خمس سنوات إلى عشر سنوات. ولا يحول الحكم بهذه العقوبات دون الحكم على المجرم بإعادة الأشياء المصادرة. وإذا كان المجرم ضابطا فيعاقب، فضلا عن ذلك بفقدان الرتبة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_322_19710422_OpEnact_6ee6820f40> ;
    dzdoc:replacementText "يعاقب بالحبس من شهرين إلى سنتين كل عسكري أساء استعمال السلطات المعطاة له بالمصادرة العسكرية، أو رفض أن يعطي وصلا بالكميات التي تسلمها. وكل عسكري مارس المصادرة وهو غير متمتع بهذه السلطة يعاقب بالحبس من سنة إلى خمس سنوات إذا حصلت المصادرة بدون عنف. وإذا حصلت المصادرة بعنف يعاقب بالسجن المؤقت مع الأشغال من خمس سنوات إلى عشر سنوات. ولا يحول الحكم بهذه العقوبات دون الحكم على المجرم بإعادة الأشياء المصادرة. وإذا كان المجرم ضابطا فيعاقب، فضلا عن ذلك بفقدان الرتبة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_322> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_322> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1971-04-22/71-28#version_art_323> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن المؤقت مع الأشغال من عشر سنوات إلى عشرين سنة كل رئيس عسكري برتبة ضابط يرتكب بدون استفزاز أو أمر أو إذن، عملا عدائيا بعد أن يكون تلقى الإعلان الرسمي بالسلم أو الهدنة أو وقف القتال ويعاقب فوق ذلك بالعزل."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_323_19710422_OpEnact_9a24a2b6ba> ;
    dzdoc:replacementText "يعاقب بالسجن المؤقت مع الأشغال من عشر سنوات إلى عشرين سنة كل رئيس عسكري برتبة ضابط يرتكب بدون استفزاز أو أمر أو إذن، عملا عدائيا بعد أن يكون تلقى الإعلان الرسمي بالسلم أو الهدنة أو وقف القتال ويعاقب فوق ذلك بالعزل."@ar ;
    dzdoc:resolutionStatus "resolved" ;
