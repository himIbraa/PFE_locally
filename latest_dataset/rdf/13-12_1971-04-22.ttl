        dzterm:military_investigating_judge .

<https://legal.dz/resource/order/1971-04-22/71-28#art_143> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_3> ;
    dzdoc:eId "art_143" ;
    dzdoc:fullText "يجوز للرئيس أن يأمر بإبعاد المتهم عن قاعة الجلسة وإيداعه السجن أو وضعه في حراسة القوة العمومية إلى نهاية المرافعات أو وضعه تحت تصرف المحكمة ، إذا شوش أو سبب الضجيج بأية طريقة أخرى لعرقلة سير العدالة . ويمكن أن يحكم في الحال على المتهم من جراء هذا الفعل وحده بالعقوبات المنصوص عليها في المادة 305 من هذا القانون. ويستمر في إجراءات المرافعات والحكم كما لو كان المتهم حاضرا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_143_permission_0_71a24280> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_143_right_0_b94dc272> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_143> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_143_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_143_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_143_19710422_OpEnact_9bddeaada7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 143" ;
    dzdoc:position 142 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_305> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_305> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_143_condition_0_0f3df3a1> ;
    dzdoc:usesTerm dzterm:accused,
        dzterm:president .

<https://legal.dz/resource/order/1971-04-22/71-28#art_146> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_4> ;
    dzdoc:eId "art_146" ;
    dzdoc:fullText "يوعز الرئيس لكاتب الضبط بتلاوة أمر التكليف بالحضور وقائمة الشهود الذين يجب الاستماع إليهم ، إما بناء على طلب النيابة العامة وإما بناء على طلب المتهم. ولا يمكن أن تتضمن هذه القائمة إلا الشهود المبلغ اسمهم من قبل وكيل الدولة العسكري للمتهم ومن هذا الأخير للنيابة العامة طبقا لاحدى المادتين 192 أو 193 ، دون الإخلال ب الحق الممنوح للرئيس بموجب المادة 152 . ويجوز بالتالي لوكيل الدولة العسكري والمتهم، أن يعارضا في الاستماع لشاهد لم يبلغ اسمه لهما، أو لم يعين بوضوح في التبليغ . وتبت المحكمة حالا في هذه المعارضة . ويأمر الرئيس الشهود بالانسحاب للغرفة المخصصة لهم، ولا يخرجون منها إلا للإدلاء بالشهادة . ويتخذ الرئيس عند الضرورة كل الاجراءات اللازمة لمنع الشهود من التحدث فيما بينهم قبل أداء الشهادة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_146_permission_0_9d9a3c43> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_146_right_0_27850625>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_146_right_1_8e5b4993> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_146> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_146_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_146_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_146_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_146_para_3>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_146_para_4>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_146_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_146_19710422_OpEnact_526ef4f113> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_146_obligation_0_eddf1829>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_146_obligation_1_073e1cd4>,
