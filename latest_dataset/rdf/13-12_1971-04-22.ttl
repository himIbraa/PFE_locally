<https://legal.dz/resource/order/1971-04-22/71-28#version_art_70> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يبدأ سريان مفعول تقادم الدعوى العمومية الناجمة عن العصيان أو الفرار، إلا ابتداء من اليوم الذي يبلغ فيه العاصي أو الفار سن الخمسين . ولا تنقضي الدعوى العمومية في الأحوال المذكورة في المواد 265 و 266 و 267 ، أو عندما يلجأ العاصي أو الفار في زمن الحرب، لبلاد أجنبية أو يبقى فيها هربا من أداء واجباته العسكرية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_70_19710422_OpEnact_d0274aeaec> ;
    dzdoc:replacementText "لا يبدأ سريان مفعول تقادم الدعوى العمومية الناجمة عن العصيان أو الفرار، إلا ابتداء من اليوم الذي يبلغ فيه العاصي أو الفار سن الخمسين . ولا تنقضي الدعوى العمومية في الأحوال المذكورة في المواد 265 و 266 و 267 ، أو عندما يلجأ العاصي أو الفار في زمن الحرب، لبلاد أجنبية أو يبقى فيها هربا من أداء واجباته العسكرية ."@ar ;
