<https://legal.dz/resource/order/1971-04-22/71-28#art_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_12> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "في حالة استئناف النيابة العامة ، يستمر في توقيف المتهم لحين البت في الاستئناف، وفي جميع الأحوال لغاية انقضاء مهلة استئناف وكيل الدولة العسكري ، ما لم يقرر هذا الأخير الإفراج عنه فورا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_100> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_100_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_100_19710422_OpEnact_7342cc35ad> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_100_obligation_0_7de41041> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 100" ;
    dzdoc:position 99 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_100_condition_0_0e3677f5>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_100_condition_1_45c903f9> ;
    dzdoc:usesTerm dzterm:prosecutor .

<https://legal.dz/resource/order/1971-04-22/71-28#art_117> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_3> ;
    dzdoc:eId "art_117" ;
    dzdoc:fullText "يتولى وكيل الدولة العسكري تهيئة القضية وتقديمها مع طلبه للمحكمة العسكرية ، فتبت هذه الجهة القضائية فيها وفقا لأوضاع كل من الأحوال المنصوص عليها في المواد 86 و 88 و 90 و 101 و 105 و 108 و 122 من هذا القانون. وفي زمن الحرب والأحوال المنصوص عليها في المواد 86 و 101 و 105 و 122 ينقص من المهل ثلثاها دون أن تقل عن 5 أيام إلا إذا صدر أمر بتحقيق إضافي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_117> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_117_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_117_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_117_19710422_OpEnact_5a3d2665fb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_117_obligation_0_f69b915b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 117" ;
    dzdoc:position 116 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_101>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_105>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_108>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_122>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_86>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_88>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_90> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_101>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_105>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_108>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_122>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_86>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_88>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_90> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_117_condition_0_e7f80600> ;
    dzdoc:usesTerm dzterm:military_state_prosecutor .

<https://legal.dz/resource/order/1971-04-22/71-28#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_1_chp_1_subsec_1> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "يجوز إلحاق العسكريين من غير الضباط والتابعين لأسلاك الجند أو المصالح، ليمارسوا بصفتهم مساعدين، وظائف مستكتبي الضبط أو محضرين. فيقوم هؤلاء بأعمال الجلسات."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_12_permission_0_79bd18aa> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_12_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_12_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_12_19710422_OpEnact_a2a505e520> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "12" ;
    dzdoc:position 11 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_130> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_1> ;
    dzdoc:eId "art_130" ;
    dzdoc:fullText "إذا صدرت عدة أحكام إحالة أو تقديم مباشر للمحاكمة، ضد متهمين مختلفين عن الجريمة نفسها ، فيجوز للرئيس إما تلقائيا أو بناء على طلب النيابة العامة أو المدافع ، أن يأمر بضمها جميعا. وكذلك الشأن ، إذا صدرت عدة أحكام إحالة أو تقديم مباشر للمحاكمة ، عن جرائم مختلفة ضد المتهم نفسه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_130> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_130_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_130_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_130_19710422_OpEnact_a05a2cb940> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "130" ;
    dzdoc:position 129 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_130_condition_0_95ff25c8>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_130_condition_1_1ca7de4e> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_139> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_139" ;
    dzdoc:fullText "عندما ترتكب جنايات أو جنح من غير ما هو منصوص عليه في المادتين 137 و 138 ، في مكان انعقاد الجلسات ، فإن الرئيس يحرر محضرا بالوقائع وشهادات الشهود ويحيل مرتكب الجريمة أمام السلطة المختصة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_139> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_139_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_139_19710422_OpEnact_f6af0e2ec6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "139" ;
    dzdoc:position 138 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_137>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_138> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_137>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_138> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_139_condition_0_abf296a0> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/order/1971-04-22/71-28#art_147> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_4> ;
    dzdoc:eId "art_147" ;
    dzdoc:fullText "يأمر الرئيس كاتب الضبط بتلاوة الحكم بإحالة المتهم إلى المحكمة أو تقديمه مباشرة أمامها، والأوراق التي يرى من الضروري إطلاع المحكمة عليها . ويذكر المتهم بالجريمة التي يلاحق من أجلها وينبهه بأن القانون يبيح له كل ما هو لازم للدفاع عن نفسه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_147> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_147_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_147_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_147_19710422_OpEnact_a5d41add26> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_147_obligation_0_621b7b99>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_147_obligation_1_7ab70ae7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "147" ;
    dzdoc:position 146 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_153> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_6> ;
    dzdoc:eId "art_153" ;
    dzdoc:fullText "يجوز للرئيس في جميع الأحوال التي يكون فيها وحده مختصا للبت في دفع أو طلب عارض، أن يرفع الأمر للمحكمة لتبت فيه بحكم إذا رأى ذلك مناسبا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_153_permission_0_19246538> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_153> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_153_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_153_19710422_OpEnact_33734fc67c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 153" ;
    dzdoc:position 152 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_153_condition_0_a7faac6d> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/order/1971-04-22/71-28#art_162> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_8> ;
    dzdoc:eId "art_162" ;
    dzdoc:fullText "يجري مثل ما سبق في الإحالة بالنسبة للمثول المباشر، ولكن إذا كشفت المرافعات بأن الأفعال الملاحقة تقتضي في زمن السلم وصفا جنائيا يستوجب عقوبة الإعدام في زمن الحرب ، فعلى المحكمة أن تأمر بناء على طلب النيابة العامة، تأجيل القضية لتطبيق أحكام المادة 75 وما يليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_162> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_162_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_162_19710422_OpEnact_367dddbfb3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_162_obligation_0_b727cfd6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "162" ;
    dzdoc:position 161 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_75> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_75> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_162_condition_0_9cf9eb4f> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_188> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_188" ;
    dzdoc:fullText "إذا صدر إبطال الحكم بسبب الخطأ في تطبيق العقوبة على الأفعال التي اعتبر المحكوم عليه مذنبا عنها ، فيبقى الوضع على حاله بالنسبة للاتهام ووجود الظروف المشددة أو المخففة، و لا تبت المحكمة الجديدة الناظرة في القضية إلا بشأن تطبيق العقوبة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_188> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_188_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_188_19710422_OpEnact_cd314957f8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_188_obligation_0_af9bf307> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "188" ;
    dzdoc:position 187 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_188_condition_0_0ed9b4bd> ;
    dzdoc:usesTerm dzterm:court .

<https://legal.dz/resource/order/1971-04-22/71-28#art_207> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_3> ;
    dzdoc:eId "art_207" ;
    dzdoc:fullText "إن تحقق المحكمة العسكرية من هوية الشخص المحكوم عليه، في حالة النزاع عليها ، يجري من قبل المحكمة التي أصدرت الحكم أو المحكمة التي أوقف في دائرة اختصاصها المحكوم عليه. وتفصل المحكمة في مسألة التحقق من الهوية، في جلسة علنية، بحضور الشخص الموقوف، بعد الاستماع إلى الشهود المدعوين للشهادة من قبل النيابة العامة ومن قبل الموقوف ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_207> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_207_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_207_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_207_19710422_OpEnact_1682326437> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_207_obligation_0_cf173789> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "207" ;
    dzdoc:position 206 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_207_condition_0_4a3022ab> ;
    dzdoc:usesTerm dzterm:military_court .

<https://legal.dz/resource/order/1971-04-22/71-28#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_1_chp_1_subsec_2> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "يمكن أن يدعى القضاة التابعون لسلك القضاء العسكري المخصص للاحتياط والمستنفرون وكتاب الضبط التابعون للاحتياط والمستنفرون وكذلك المماثلون لهم والمختصون بمصلحة القضاء العسكري والمحدد قانونهم الأساسي بموجب مرسوم صادر بناء على تقرير مشترك من وزير العدل حامل الأختام و وزير الدفاع الوطني ، لتكميل النقص الحاصل في موظفي هذه المحاكم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_21_permission_0_455fe882> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_21_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_21_19710422_OpEnact_3458ae3633> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "21" ;
    dzdoc:position 20 ;
    dzdoc:usesTerm dzterm:judges,
        dzterm:minister_defense,
        dzterm:minister_justice .

<https://legal.dz/resource/order/1971-04-22/71-28#art_214> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_5> ;
    dzdoc:eId "art_214" ;
    dzdoc:fullText "إذا تعلق الحكم بعسكري ، فيتعين على وكيل الدولة العسكري ، أن يرسل خلال 3 أيام من التنفيذ ملخص الحكم إلى رئيس القطعة أو التشكيلة أو المصلحة التي ينتمي إليها المحكوم عليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_214> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_214_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_214_19710422_OpEnact_620442cc32> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_214_obligation_0_7fe086d6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 214" ;
    dzdoc:position 213 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_214_condition_0_3f4ebd60> ;
    dzdoc:usesTerm dzterm:prosecutor .

<https://legal.dz/resource/order/1971-04-22/71-28#art_215> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_5> ;
    dzdoc:eId "art_215" ;
    dzdoc:fullText "يحتوي ملخص كل حكم أو كل نسخة من الحكم بالعقوبة على بيان مدة الحبس الاحتياطي المنفذ، وعند الاقتضاء على تاريخ البدء في تنفيذ الحكم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_215> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_215_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_215_19710422_OpEnact_55063c710e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_215_obligation_0_f88baedd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 215" ;
    dzdoc:position 214 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_217> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_5> ;
    dzdoc:eId "art_217" ;
    dzdoc:fullText "إذا طرأت صعوبات في تنفيذ حكم اكتسب قوة الشيء المقضي به، لجهة تفسير ما قضي به ، فيجوز للمحكوم عليه تقديم عريضة بذلك إلى وكيل الدولة العسكري لدى المحكمة التي أصدرت الحكم . فيبت وكيل الدولة العسكري في الطلب، ويمكن أن يترتب على قراره عند الاقتضاء، نزاع عارض."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_217_right_0_96da5259> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_217> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_217_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_217_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_217_19710422_OpEnact_d7c7c255fc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 217" ;
    dzdoc:position 216 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_217_condition_0_45acc5ad> ;
    dzdoc:usesTerm dzterm:prosecutor .

<https://legal.dz/resource/order/1971-04-22/71-28#art_230> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_9> ;
    dzdoc:eId "art_230" ;
    dzdoc:fullText "إذا صدر الحكم بالحبس أو الغرامة فللمحكمة العسكرية أن تقرر وقف التنفيذ ضمن الشروط الواردة في المواد من 592 إلى 594 من قانون الاجراءات الجزائية، مع مراعاة التحفظات الواردة بعده."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_230> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_230_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_230_19710422_OpEnact_e9de8d5f7c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 230" ;
    dzdoc:position 229 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_230_extref_80f529d2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_230_extref_ee9a00f5> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_230_condition_0_0688c584> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_236> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_11> ;
    dzdoc:eId "art_236" ;
    dzdoc:fullText "إن تقادم العقوبات الصادرة عن العصيان أو الفرار ، لا يسري إلا ابتداء من اليوم الذي يبلغ فيه العاصي أو الفار سن الخمسين . بيد أن العقوبات لا تتقادم عندما يكون الحكم الغيابي صادرا عن الجرائم المشار إليها في المواد 265 و 266 و 267 أو عند ما يلتجئ فار أو عاص إلى بلد أجنبي ويبقى فيه زمن الحرب ليتخلص من التزاماته العسكرية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_236> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_236_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_236_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_236_19710422_OpEnact_6baad7de36> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_236_obligation_0_22f6c22c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 236" ;
    dzdoc:position 235 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_265>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_266>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_267> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_265>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_266>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_267> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_236_condition_0_10a63784> ;
    dzdoc:usesTerm dzterm:desertion,
        dzterm:insubordination,
        dzterm:punishments .

<https://legal.dz/resource/order/1971-04-22/71-28#art_239> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_12> ;
    dzdoc:eId "art_239" ;
    dzdoc:fullText "تكون المحاكم العسكرية التي بتت في الموضوع مختصة بتطبيق الأحكام المنصوص عليها في المادة 639 وما يليها من قانون الاجراءات الجزائية . يحيل رئيس المحكمة العسكرية ، أو في حالة إلغاء هذه الأخيرة، رئيس المحكمة المعينة من قبل وزير الدفاع الوطني ، العريضة إلى وكيل الدولة العسكري ويضع تقريرا بذلك أو يندب قاضيا مساعدا لهذا الغرض. وتجري المرافعات ويصدر الحكم في غرفة المشورة ويجوز للمحكمة أن تكلف المحكوم عليه للحضور أمامها. ويؤشر بالقرار الصادر، على هامش الحكم المشار إليه بطلب التصحيح."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_239> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_239_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_239_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_239_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_239_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_239_19710422_OpEnact_82f47c6ae8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 239" ;
    dzdoc:position 238 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_239_extref_ea36b66a>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_239_extref_f3db5452> ;
    dzdoc:usesTerm dzterm:military_courts,
        dzterm:military_state_prosecutor,
        dzterm:minister_national_defense,
        dzterm:president_military_court .

<https://legal.dz/resource/order/1971-04-22/71-28#art_251> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_1> ;
    dzdoc:eId "art_251" ;
    dzdoc:fullText "عندما تصدر عقوبة بالغرامة عن جرم تابع للقانون العام ضد العسكريين أو المماثلين لهم، وليسوا في رتبة الضباط فيجوز للمحكمة أن تقرر بموجب نص خاص، عقوبة الحبس من 6 أيام إلى 6 أشهر مكان عقوبة الغرامة، بالنسبة للجرم ومن يومين إلى خمسة عشر يوما بالنسبة للمخالفة، و للمحكوم عليه أن يختار دفع الغرامة مكان قضاء مدة الحبس . ويلازم العقوبة الصادرة، طابع الغرامة، دون أن تختلط مع العقوبات الأخرى الصادرة، وتنفذ بصفة مستقلة عن هذه الأخيرة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_251_right_0_0d6018bb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_251> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_251_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_251_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_251_19710422_OpEnact_5cc82c233a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 251" ;
    dzdoc:position 250 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_251_condition_0_11a2123f> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_252> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_1> ;
    dzdoc:eId "art_252" ;
    dzdoc:fullText "عندما يتعلق الأمر بجرم منصوص عليه في هذا القانون، مع الأخذ بالظروف المخففة ، فلا يمكن بأي حال أن تحل عقوبة الحبس محل الغرامة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_252_permission_0_e92ad427> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_252> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_252_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_252_19710422_OpEnact_d62867b61a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 252" ;
    dzdoc:position 251 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_252_condition_0_13211f58> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_253> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_1> ;
    dzdoc:eId "art_253" ;
    dzdoc:fullText "إن المخالفات المرتكبة بحق الأنظمة المتعلقة بالتأديب والخارجة عن اختصاص المحاكم العسكرية، تخضع لقمع السلطة العسكرية وتطبق عليها العقوبات التأديبية، التي لا يمكن أن تتجاوز الستين يوما إذا كانت سالبة للحرية. يحدد سلم العقوبات التأديبية بموجب مرسوم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_253_permission_0_904864e8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_253> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_253_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_253_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_253_19710422_OpEnact_8a6ed04690> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 253" ;
    dzdoc:position 252 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_269> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_1_subsec_2> ;
    dzdoc:eId "art_269" ;
    dzdoc:fullText "يمكن أن يلاحق الأشخاص المذكورون في المادة 28 بجرم الفرار عندما ينطبق عملهم على إحدى الحالات المنصوص عليها في المواد 266 و 267 و 268 ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_269_permission_0_09c23ca4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_269> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_269_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_269_19710422_OpEnact_af5a1c0c6c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 269" ;
    dzdoc:position 268 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_266>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_267>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_268>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_28> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_266>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_267>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_268>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_28> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_283> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_283" ;
    dzdoc:fullText "يعاقب بالإعدام كل عسكري أو كل شخص منتقل على ظهر سفينة بحرية أو طائرة أو على سفينة تجارية محروسة ويقوم بالأعمال التالية : يحرض على الهزيمة أمام العدو أو العصابة المسلحة أو يعرقل جمع الجنود أو ينزل الراية، يحرض على وقف القتال بدون أمر من القائد، يتسبب عن قصد في استيلاء العدو على التشكيلة العسكرية أو السفينة البحرية أو الطائرة الموضوعة تحت أمرته أو الموجود على متنها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_283> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_283_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_283_19710422_OpEnact_01b57c6572> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_283_obligation_0_7779331e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "283" ;
    dzdoc:position 282 ;
    dzdoc:usesTerm dzterm:soldier .

<https://legal.dz/resource/order/1971-04-22/71-28#art_303> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_303" ;
    dzdoc:fullText "يعاقب على أعمال التمرد : 1- بالحبس من ثلاث سنوات إلى خمس سنوات في الظروف المنصوص عليها في الفقرة الأولى من المادة 302 2- بالسجن المؤقت مع الأشغال من خمس سنوات إلى عشر سنوات، في الظروف المنصوص عليها في الفقرة 2 من نفس المادة. 3- بالسجن المؤقت مع الأشغال من عشر سنوات إلى عشرين سنة، في الظروف المنصوص عليها في الفقرة 3 من نفس المادة. ويمكن تطبيق عقوبة السجن المؤبد مع الأشغال على العسكريين الأعلى رتبة وعلى المحرضين على العصيان."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_303> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_303_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_303_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_303_19710422_OpEnact_34d3fe2a76> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_303_obligation_0_eeac8007> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "303" ;
    dzdoc:position 302 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_302> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_302> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_314> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_314" ;
    dzdoc:fullText "إذا تبين للمحكمة أن أعمال العنف أو الإهانة الحاصلة ضمن الأحوال المذكورة في المادتين 311 و 313 ، قد ارتكبها المرؤوس وهو على غير علم بصفة رئيسه ، فإنه يحكم عليه بالعقوبات المنصوص عليها في قانون العقوبات والقوانين العادية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_314> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_314_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_314_19710422_OpEnact_6f5f47fef3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_314_obligation_0_017b99a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "314" ;
    dzdoc:position 313 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_311>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_313> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_311>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_313> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_314_condition_0_dc939e34> ;
    dzdoc:usesTerm dzterm:penal_code .

<https://legal.dz/resource/order/1971-04-22/71-28#art_330> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_4> ;
    dzdoc:eId "art_330" ;
    dzdoc:fullText "كل ملاح في سفينة بحرية عسكرية أو سفينة تجارية محروسة ، يرتكب جرم التخلي عن السفينة المكلف بقيادتها، يعاقب بالحبس من سنتين إلى خمس سنوات . وإذا حصل التخلي أمام العدو أو في حالة الخطر المحدق فيعاقب بالسجن مع الأشغال من عشر سنوات إلى عشرين سنة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_330> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_330_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_330_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_330_19710422_OpEnact_d96743f226> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_330_obligation_0_62b38e39>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_330_obligation_1_573325f6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "330" ;
    dzdoc:position 329 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_1_chp_1_subsec_1> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "تنشأ محاكم عسكرية دائمة لدى النواحي العسكرية الأولى والثانية والخامسة. ويمتد الاختصاص الإقليمي للمحكمة العسكرية الدائمة الخاصة بالناحية العسكرية الثانية، إلى الناحية العسكرية الثالثة كما يمتد الاختصاص الإقليمي للمحكمة العسكرية الدائمة الخاصة بالناحية العسكرية الخامسة، إلى الناحية العسكرية الرابعة. وتعين المحاكم العسكرية بإسم المكان المحدد لانعقادها، ويمكن أن تعقد جلساتها في كل مكان من دائرة اختصاصها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_4_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_4_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_4_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_4_19710422_OpEnact_c7ab224819> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_4_obligation_0_7bf952d5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "4" ;
    dzdoc:position 3 ;
    dzdoc:usesTerm dzterm:military_courts .

<https://legal.dz/resource/order/1971-04-22/71-28#art_43> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_43" ;
    dzdoc:fullText "يناط ب ضباط الشرطة القضائية العسكرية التحقيق في الجرائم وجمع الأدلة والبحث عن الفاعلين الأصليين ما دام لم يفتح التحقيق . وعندما يشرع في تحقيق تحضيري ، فإنهم ينفذون تفويضات قضاء التحقيق ويحيلونها حسب طلبه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_43> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_43_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_43_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_43_19710422_OpEnact_8105641bc1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_43_obligation_0_3c7a722c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "43" ;
    dzdoc:position 42 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_43_condition_0_e4363e91> ;
    dzdoc:usesTerm dzterm:police_officer .

<https://legal.dz/resource/order/1971-04-22/71-28#art_46> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_46" ;
    dzdoc:fullText "يتمتع العسكريون التابعون للدرك، لأجل ممارسة أعمال الشرطة القضائية العسكرية، سواء كانوا حائزين لصفة ضباط الشرطة القضائية أم لا، بالسلطات المخصصة في قانون الاجراءات الجزائية لضباط الشرطة القضائية أو أعوان الشرطة القضائية المذكورين في المادة 19 من القانون المذكور . إن العسكريين غير المحلفين والذين يدعون للخدمة في الدرك، يعاونون ضباط الشرطة القضائية العسكرية الموضوعين تحت أمرتهم ويطلعونهم على الجرائم التي يقفون عليها."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_46_right_0_944addbd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_46> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_46_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_46_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_46_19710422_OpEnact_d56402a1c0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "46" ;
    dzdoc:position 45 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_46_extref_615139b8>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_46_extref_ea36b66a> ;
    dzdoc:usesTerm dzterm:police_officer .

<https://legal.dz/resource/order/1971-04-22/71-28#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "يجوز ل وكلاء الدولة العسكريين و قضاة التحقيق العسكريين ، في حالة الجناية أو الجرم المتلبس به والمرتكب بحضورهم ، أن يباشروا إجراءات التحقيق وفقا لنص المادتين 38 و 56 من قانون الاجراءات الجزائية مع مراعاة الأحكام المنصوص عليها في المواد من 57 إلى 64 من هذا القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_48_permission_0_15f2e9e0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_48_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_48_19710422_OpEnact_c74a8f944d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 48" ;
    dzdoc:position 47 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_57>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_64> ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_48_extref_3cdea807>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_48_extref_b0e703d5> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_57>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_64> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_48_condition_0_fbc28e91> ;
    dzdoc:usesTerm dzterm:military_investigating_judges,
        dzterm:state_military_agents .

<https://legal.dz/resource/order/1971-04-22/71-28#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "يبادر ضابط الشرطة القضائية العسكرية ضمن الأحوال المنصوص عليها في المادة 41 من قانون الاجراءات الجزائية بالانتقال فورا إلى مكان الجناية أو الجنحة عند إخباره بذلك أو بناء على طلب رئيس المؤسسة. فيشرع في جميع التحقيقات الضرورية وإجراءات التفتيش اللازمة والحجز والاستنطاقات والتحريات اللازمة لجمع الأدلة والكشف عن مرتكبي تلك الجرائم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_51_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_51_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_51_19710422_OpEnact_7c7daae1e8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "51" ;
    dzdoc:position 50 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_51_extref_01844c86> ;
    dzdoc:usesTerm dzterm:military_judicial_police_officers .

<https://legal.dz/resource/order/1971-04-22/71-28#art_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_70" ;
    dzdoc:fullText "لا يبدأ سريان مفعول تقادم الدعوى العمومية الناجمة عن العصيان أو الفرار، إلا ابتداء من اليوم الذي يبلغ فيه العاصي أو الفار سن الخمسين . ولا تنقضي الدعوى العمومية في الأحوال المذكورة في المواد 265 و 266 و 267 ، أو عندما يلجأ العاصي أو الفار في زمن الحرب، لبلاد أجنبية أو يبقى فيها هربا من أداء واجباته العسكرية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_70_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_70_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_70_19710422_OpEnact_d0274aeaec> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 70" ;
    dzdoc:position 69 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_265>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_266>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_267> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_265>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_266>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_267> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_70_condition_0_e991f4a4>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_70_condition_1_ea444e19> ;
    dzdoc:usesTerm dzterm:public_action .

<https://legal.dz/resource/order/1971-04-22/71-28#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_3> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "خلال سير التحقيق التحضيري و باستثناء الأحكام الخاصة الواردة في هذا القانون ، يتولى وكيل الدولة العسكري تجاه قاضي التحقيق العسكري اختصاصات وكيل الدولة تجاه قاضي التحقيق التابع للقانون العام."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_78> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_78_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_78_19710422_OpEnact_e37c84d7f5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "78" ;
    dzdoc:position 77 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_78_condition_0_a6c188e4> ;
    dzdoc:usesTerm dzterm:تحقيق_تحضيري,
        dzterm:قاضي_التحقيق,
        dzterm:قاضي_التحقيق_العسكري,
        dzterm:وكيل_الدولة,
        dzterm:وكيل_الدولة_العسكري .

