<https://legal.dz/resource/order/1971-04-22/71-28#version_art_162> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجري مثل ما سبق في الإحالة بالنسبة للمثول المباشر، ولكن إذا كشفت المرافعات بأن الأفعال الملاحقة تقتضي في زمن السلم وصفا جنائيا يستوجب عقوبة الإعدام في زمن الحرب ، فعلى المحكمة أن تأمر بناء على طلب النيابة العامة، تأجيل القضية لتطبيق أحكام المادة 75 وما يليها ."@ar ;
