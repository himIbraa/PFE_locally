<https://legal.dz/resource/order/1971-04-22/71-28#version_art_83> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تطبق أحكام قانون الاجراءات الجزائية المتعلقة بالخبرة أمام الجهات القضائية العسكرية الخاصة بالتحقيق والمحاكمة. وان القضاة المدعوين لإجراء الخبرة يمكنهم أيضا أن يختاروا بكل حرية، خبراء من بين جميع الموظفين المتخصصين التابعين لوزارة الدفاع الوطني."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_83_19710422_OpEnact_fadfbce989> ;
    dzdoc:replacementText "تطبق أحكام قانون الاجراءات الجزائية المتعلقة بالخبرة أمام الجهات القضائية العسكرية الخاصة بالتحقيق والمحاكمة. وان القضاة المدعوين لإجراء الخبرة يمكنهم أيضا أن يختاروا بكل حرية، خبراء من بين جميع الموظفين المتخصصين التابعين لوزارة الدفاع الوطني."@ar ;
    dzdoc:resolutionStatus "resolved" ;
