<https://legal.dz/resource/order/1971-04-22/71-28#art_227_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_227> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر كل مستفيد من قرار بإيقاف تنفيذ الحكم كأنه قضى عقوبته خلال كل الوقت الذي يبقى فيه في الخدمة العسكرية بعد الحكم عليه تلبية لالتزاماته العسكرية القانونية أو التعاقدية في الجيش العامل، أو الالتزامات المفروضة عليه في الاستدعاء الموجه إليه في حالة النفير."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_228_extref_49c229d8> a dzdoc:ExternalReference ;
