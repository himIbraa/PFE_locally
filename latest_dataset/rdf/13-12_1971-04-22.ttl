<https://legal.dz/resource/order/1971-04-22/71-28#version_art_140> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يأمر الرئيس بإحضار المتهم ، فيحضر هذا الأخير مطلقا من كل قيد تحرسه قوة الحرس ويحضر معه المدافع عنه . وإذا لم يحضر المدافع المختار عنه عين الرئيس مدافعا عنه بصفة تلقائية . ويسأل الرئيس المتهم عن اسمه وعمره ومهنته ومسكنه ومحل ولادته . فإذا رفض المتهم الإجابة صرف النظر عن ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
