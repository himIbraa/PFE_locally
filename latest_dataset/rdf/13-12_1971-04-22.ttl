<https://legal.dz/resource/order/1971-04-22/71-28#version_art_184> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان المحكوم عليه معتقلا ، يمكنه كذلك أن يعلم السلطة المكلفة بالإشراف على المؤسسة المعتقل فيها، عن رغبته في الطعن بموجب رسالة يوجهها إليها . وتسلمه هذه السلطة إيصالا، وتقيد على الرسالة ذاتها ما يشير إلى أنها سلمت من المعني وتبين فيها تاريخ التسليم. ثم يحال الطلب فورا إلى كتابة ضبط المحكمة التي أصدرت الحكم المطعون فيه ، ويسجل بعدئذ في السجل المنصوص عليه في المادة 98 ويرفق بالمحضر الموضوع من قبل كاتب الضبط."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_184_19710422_OpEnact_5e2f556cd4> ;
    dzdoc:replacementText "إذا كان المحكوم عليه معتقلا ، يمكنه كذلك أن يعلم السلطة المكلفة بالإشراف على المؤسسة المعتقل فيها، عن رغبته في الطعن بموجب رسالة يوجهها إليها . وتسلمه هذه السلطة إيصالا، وتقيد على الرسالة ذاتها ما يشير إلى أنها سلمت من المعني وتبين فيها تاريخ التسليم. ثم يحال الطلب فورا إلى كتابة ضبط المحكمة التي أصدرت الحكم المطعون فيه ، ويسجل بعدئذ في السجل المنصوص عليه في المادة 98 ويرفق بالمحضر الموضوع من قبل كاتب الضبط."@ar ;
    dzdoc:resolutionStatus "resolved" ;
