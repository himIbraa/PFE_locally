<https://legal.dz/resource/order/1971-04-22/71-28#version_art_145> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتلو كاتب الضبط في الأحوال المنصوص عليها في المواد 137 و 138 و 142 و 143 ، على المحكوم عليه نص الحكم الصادر ، ثم ينبهه عن حقه بالطعن فيه بالنقض، ضمن المهلة المحددة في المادة 181 ويحرر محضرا بذلك تحت طائلة البطلان ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_145_19710422_OpEnact_fbd90823a1> ;
    dzdoc:replacementText "يتلو كاتب الضبط في الأحوال المنصوص عليها في المواد 137 و 138 و 142 و 143 ، على المحكوم عليه نص الحكم الصادر ، ثم ينبهه عن حقه بالطعن فيه بالنقض، ضمن المهلة المحددة في المادة 181 ويحرر محضرا بذلك تحت طائلة البطلان ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
