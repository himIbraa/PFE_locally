<https://legal.dz/resource/order/1971-04-22/71-28#version_art_155> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يمكن إنهاء المرافعات خلال نفس الجلسة ، يأمر الرئيس بإرجاء النظر في الدعوى لليوم والساعة المحددين منه ، ويجري مثل ذلك بالنسبة للقضايا المسجلة في الجدول والتي لم ينظر فيها في اليوم المعين. فيدعو للاجتماع أعضاء المحكمة، وعند اللزوم، القضاة المساعدين الاحتياطيين و وكيل الدولة العسكري وكاتب الضبط والمترجم إذا كان له محل وكذا المدافعين. فيكلف المتهمين والشهود غير المستنطقين أو الذين كلفوا للبقاء تحت تصرف المحكمة ، بالمثول أمامها دون تبليغ جديد بالحضور، في اليوم والساعة المحددين. و إذا كان شاهد "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_155_19710422_OpEnact_baed81fe09> ;
    dzdoc:replacementText "إذا لم يمكن إنهاء المرافعات خلال نفس الجلسة ، يأمر الرئيس بإرجاء النظر في الدعوى لليوم والساعة المحددين منه ، ويجري مثل ذلك بالنسبة للقضايا المسجلة في الجدول والتي لم ينظر فيها في اليوم المعين. فيدعو للاجتماع أعضاء المحكمة، وعند اللزوم، القضاة المساعدين الاحتياطيين و وكيل الدولة العسكري وكاتب الضبط والمترجم إذا كان له محل وكذا المدافعين. فيكلف المتهمين والشهود غير المستنطقين أو الذين كلفوا للبقاء تحت تصرف المحكمة ، بالمثول أمامها دون تبليغ جديد بالحضور، في اليوم والساعة المحددين. و إذا كان شاهد متغيبا ، جاز للمحكمة تطبيق أحكام المادة 148 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_155> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_155> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1971-04-22/71-28#version_art_156> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز قطع التحقيق في القضية والمرافعات فيها. ولا يجوز ل الرئيس إيقافها إلا للوقت الضروري لراحة القضاة والشهود والمتهمين، ولكي يمكن النيابة العامة والدفاع من تهيئة جميع الإيضاحات التي تستلزمها مدة المرافعات وعدد الشهود. ويجوز للمحكمة في كل الأحوال أن تأمر من تلقاء نفسها أو بناء على طلب النيابة العامة تأجيل النظر في الدعوى لجلسة لاحقة. ويجوز للمحكمة أيضا، ضمن نفس الأوضاع أو بناء على طلب الدفاع أو المتهم ، أن تأمر، متى وجدت واقعة هامة تستوجب الإيضاح ، بتحقيق إضافي يشرع فيه طبقا لأحكام المادة 129 "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_156_19710422_OpEnact_02e22d9e20> ;
    dzdoc:replacementText "لا يجوز قطع التحقيق في القضية والمرافعات فيها. ولا يجوز ل الرئيس إيقافها إلا للوقت الضروري لراحة القضاة والشهود والمتهمين، ولكي يمكن النيابة العامة والدفاع من تهيئة جميع الإيضاحات التي تستلزمها مدة المرافعات وعدد الشهود. ويجوز للمحكمة في كل الأحوال أن تأمر من تلقاء نفسها أو بناء على طلب النيابة العامة تأجيل النظر في الدعوى لجلسة لاحقة. ويجوز للمحكمة أيضا، ضمن نفس الأوضاع أو بناء على طلب الدفاع أو المتهم ، أن تأمر، متى وجدت واقعة هامة تستوجب الإيضاح ، بتحقيق إضافي يشرع فيه طبقا لأحكام المادة 129 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_156> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
