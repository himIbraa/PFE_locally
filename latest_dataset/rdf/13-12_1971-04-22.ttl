    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين إلى سنتين، كل عسكري أو كل شخص منتقل يقدم علانية وبدون حق على حمل أوسمة أو مداليات أو شارات أو رتب أو على ارتداء بذلة أو لباس عسكري. ويقضى بنفس العقوبة على كل عسكري أو كل شخص منتقل يحمل أوسمة أو مداليات أو شارات أو رتب أجنبية، بدون أن يؤذن له بحملها مسبقا من طرف السلطة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
