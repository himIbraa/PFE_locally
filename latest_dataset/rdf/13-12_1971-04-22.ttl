<https://legal.dz/resource/order/1971-04-22/71-28#version_art_315> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن الشتائم المتبادلة بين العسكريين والمماثلين للعسكريين أو بين المماثلين للعسكريين، مع مراعاة أحكام المادة 317 أدناه ، لا يجرى قمعها جزائيا اذ كانوا جميعهم من نفس الرتبة، ما لم تقم بينهم صلة التبعية الناجمة عن الوظيفة أو العمل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_315_19710422_OpEnact_15204db461> ;
