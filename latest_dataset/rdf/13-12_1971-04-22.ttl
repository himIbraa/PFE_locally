<https://legal.dz/resource/order/1971-04-22/71-28#version_art_251> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما تصدر عقوبة بالغرامة عن جرم تابع للقانون العام ضد العسكريين أو المماثلين لهم، وليسوا في رتبة الضباط فيجوز للمحكمة أن تقرر بموجب نص خاص، عقوبة الحبس من 6 أيام إلى 6 أشهر مكان عقوبة الغرامة، بالنسبة للجرم ومن يومين إلى خمسة عشر يوما بالنسبة للمخالفة، و للمحكوم عليه أن يختار دفع الغرامة مكان قضاء مدة الحبس . ويلازم العقوبة الصادرة، طابع الغرامة، دون أن تختلط مع العقوبات الأخرى الصادرة، وتنفذ بصفة مستقلة عن هذه الأخيرة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_251_19710422_OpEnact_5cc82c233a> ;
    dzdoc:replacementText "عندما تصدر عقوبة بالغرامة عن جرم تابع للقانون العام ضد العسكريين أو المماثلين لهم، وليسوا في رتبة الضباط فيجوز للمحكمة أن تقرر بموجب نص خاص، عقوبة الحبس من 6 أيام إلى 6 أشهر مكان عقوبة الغرامة، بالنسبة للجرم ومن يومين إلى خمسة عشر يوما بالنسبة للمخالفة، و للمحكوم عليه أن يختار دفع الغرامة مكان قضاء مدة الحبس . ويلازم العقوبة الصادرة، طابع الغرامة، دون أن تختلط مع العقوبات الأخرى الصادرة، وتنفذ بصفة مستقلة عن هذه الأخيرة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
