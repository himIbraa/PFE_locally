<https://legal.dz/resource/order/1971-04-22/71-28#version_art_112> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز طلب الإفراج المؤقت من رئيس الجهة العسكرية المختصة، ابتداء من اختتام التحقيق التحضيري لغاية انتهاء المحاكمة . بيد أن المحكمة عندما تنعقد للاطلاع على القضية ، فتكون وحدها مختصة للنظر في الإفراج المؤقت. وتكون القرارات الصادرة في هذا الموضوع غير قابلة لأي طريق من طرق الطعن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_112_19710422_OpEnact_33705a82e3> ;
    dzdoc:replacementText "يجوز طلب الإفراج المؤقت من رئيس الجهة العسكرية المختصة، ابتداء من اختتام التحقيق التحضيري لغاية انتهاء المحاكمة . بيد أن المحكمة عندما تنعقد للاطلاع على القضية ، فتكون وحدها مختصة للنظر في الإفراج المؤقت. وتكون القرارات الصادرة في هذا الموضوع غير قابلة لأي طريق من طرق الطعن."@ar ;
