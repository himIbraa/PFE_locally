<https://legal.dz/resource/order/1971-04-22/71-28#version_art_307> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من سنة إلى سنتين كل عسكري أو كل شخص منتقل يرتكب جريمة رفض الطاعة، أو لا ينفذ خارج حالة القوة القاهرة الأوامر التي تلقاها . ويمكن رفع الحبس إلى خمس سنوات إذا ارتكبت الجريمة في زمن الحرب أو على أرض أعلنت فيها حالة الحكم العرفي أو حالة الطوارئ أو على متن سفينة بحرية عسكرية أو أثناء الحريق أو التصادم أو الجنوح أو أثناء القيام بمناورة تمس أمن السفينة البحرية أو على متن طائرة عسكرية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_307_19710422_OpEnact_6ef5e4db66> ;
    dzdoc:replacementText "يعاقب بالحبس من سنة إلى سنتين كل عسكري أو كل شخص منتقل يرتكب جريمة رفض الطاعة، أو لا ينفذ خارج حالة القوة القاهرة الأوامر التي تلقاها . ويمكن رفع الحبس إلى خمس سنوات إذا ارتكبت الجريمة في زمن الحرب أو على أرض أعلنت فيها حالة الحكم العرفي أو حالة الطوارئ أو على متن سفينة بحرية عسكرية أو أثناء الحريق أو التصادم أو الجنوح أو أثناء القيام بمناورة تمس أمن السفينة البحرية أو على متن طائرة عسكرية ."@ar ;
