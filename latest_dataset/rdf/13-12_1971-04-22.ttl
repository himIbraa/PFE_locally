<https://legal.dz/resource/order/1971-04-22/71-28#art_69_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_69> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق أمام المحكمة العسكرية، قواعد انقضاء الدعوى العمومية المنصوص عليها في المواد من 6 إلى 9 من قانون الاجراءات الجزائية مع مراعاة التحفظات المتعلقة بالتقادم والواردة بعده."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_6_condition_0_d79a4241> a dznorm:Condition ;
    dznorm:conditionText "وعندما تكون إحدى القضايا من النوع التي تطول المرافعات فيها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_6> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_6_obligation_0_145719f0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/order/1971-04-22/71-28#art_6_obligation_0_145719f0_period_dbbeca70cd> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_6> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتم تعيين القضاة الرسميين والاحتياطيين لمدة سنة واحدة، بموجب قرار مشترك صادر عن وزير العدل حامل الأختام ووزير الدفاع الوطني."@ar ;
    dznorm:sourceArticle "art_6" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_6_obligation_0_145719f0_period_dbbeca70cd> a dznorm:Period ;
    rdfs:label "لمدة سنة واحدة"@ar ;
    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "يتم تعيين القضاة الرسميين والاحتياطيين لمدة سنة واحدة، بموجب قرار مشترك صادر عن وزير العدل حامل الأختام ووزير الدفاع الوطني."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_6> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_6_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_6> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم تعيين القضاة الرسميين والاحتياطيين لمدة سنة واحدة، بموجب قرار مشترك صادر عن وزير العدل حامل الأختام ووزير الدفاع الوطني."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_6_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_6> ;
    dzdoc:position 1 ;
    dzdoc:text "ويمارس هؤلاء القضاة مهامهم ما لم تصدر تعيينات جديدة ولحين انتهاء الجلسات الخاصة بقضية شاركوا في جلستها الأولى."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_6_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_6> ;
    dzdoc:position 2 ;
    dzdoc:text "وعندما تكون إحدى القضايا من النوع التي تطول المرافعات فيها، يجوز تكليف الأعضاء الاحتياطيين لحضور الجلسات بقصد الحلول عند الاقتضاء، محل الأعضاء الحاصل لهم عذر مشروع."@ar .

