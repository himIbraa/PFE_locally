<https://legal.dz/resource/order/1971-04-22/71-28#version_art_57> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في الأحوال التي ترتكب فيها الجناية المتلبس بها أو الجريمة المتلبس بها التي يعاقب عليها بالحبس ، ومع عدم المساس بحق السلطات التأديبية العائدة للرؤساء السلميين، فإنه يجوز لكل ضابط الشرطة القضائية العسكرية أن يوقف تلقائيا العسكريين المرتكبين للجناية أو الجريمة أو شركائهم . ويمكن بالتالي وضع العسكريين الموقوفين على الشكل المذكور بسبب جرم متلبس به، في غرفة الأمن التابعة لثكنة الدرك أو أية مؤسسة أخرى. ولا يمكن أن تتجاوز مدة الوضع تحت المراقبة ثلاثة أيام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_57_19710422_OpEnact_2cc1063a0e> ;
    dzdoc:replacementText "في الأحوال التي ترتكب فيها الجناية المتلبس بها أو الجريمة المتلبس بها التي يعاقب عليها بالحبس ، ومع عدم المساس بحق السلطات التأديبية العائدة للرؤساء السلميين، فإنه يجوز لكل ضابط الشرطة القضائية العسكرية أن يوقف تلقائيا العسكريين المرتكبين للجناية أو الجريمة أو شركائهم . ويمكن بالتالي وضع العسكريين الموقوفين على الشكل المذكور بسبب جرم متلبس به، في غرفة الأمن التابعة لثكنة الدرك أو أية مؤسسة أخرى. ولا يمكن أن تتجاوز مدة الوضع تحت المراقبة ثلاثة أيام."@ar ;
    dzdoc:resolutionStatus "resolved" ;
