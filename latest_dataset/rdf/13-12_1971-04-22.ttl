    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يعتبر بمثابة فرار مع التآمر ، كل فرار حاصل بتواطؤ أكثر من شخصين."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_257_para_0> a dzdoc:Paragraph ;
