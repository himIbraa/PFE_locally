    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_136_condition_1_d6658fe8> a dznorm:Condition ;
    dznorm:conditionText "عصوا أوامره"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_136> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_136_obligation_0_557521d1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_136> ;
    dznorm:position 0 ;
    dznorm:provisionText "إن ضبط نظام الجلسة منوط بالرئيس"@ar ;
    dznorm:sourceArticle "art_136" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_136_obligation_1_cf6323cf> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_136> ;
    dznorm:position 1 ;
    dznorm:provisionText "يكون الحاضرون بدون سلاح ومكشوفي الرأس احتراما وملازمين الصمت"@ar ;
    dznorm:sourceArticle "art_136" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_136_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_136> ;
    dzdoc:position 0 ;
    dzdoc:text "إن ضبط نظام الجلسة منوط بالرئيس، ويكون الحاضرون بدون سلاح ومكشوفي الرأس احتراما وملازمين الصمت، فإذا صدرت منهم إشارات الرضا أو عدم الرضاء أمر الرئيس بطردهم. وإذا عصوا أوامره، أمر الرئيس بتوقيفهم مهما كانت صفتهم وبحبسهم في أحد الأمكنة المذكورة في المادة 102 من هذا القانون لمدة لا يمكن أن تتجاوز 24 ساعة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_136_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_136> ;
    dzdoc:position 1 ;
    dzdoc:text "ويدرج أمر الرئيس في المحضر ، ويحبس المشوشون بناء على تقديم هذا الأمر."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_136_permission_0_af0c86c7> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
