    dzdoc:evidenceText "يعاقب بالسجن من ستة أيام إلى ستة أشهر كل عسكري أو كل شخص يشتم خفيرا أو حارسا بالكلام أو بالحركات أو بالتهديد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
