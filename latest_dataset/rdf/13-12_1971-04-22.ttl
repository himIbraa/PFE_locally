    dzdoc:sourceTextSpan "إذا كانت مدة غيابه غير محدودة، أو كان تبليغ الورقة لا يمكن أن يتم ضمن المهلتين المذكورتين في المادة 194"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_197> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_197_condition_0_bbf940ce_ref_b5e8f2a9d00d> a dzdoc:Reference ;
    rdfs:label "المادة 194"@ar ;
    dzdoc:frbrUri "#art_194"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1971-04-22/71-28#art_194> ;
    dzdoc:sourceEId "art_197" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "إذا كانت مدة غيابه غير محدودة، أو كان تبليغ الورقة لا يمكن أن يتم ضمن المهلتين المذكورتين في المادة 194"@ar ;
    dzdoc:targetEId "art_194" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_197_obligation_0_9307fe0b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_197> ;
    dznorm:position 0 ;
    dznorm:provisionText "ويضع أعوان القوة العمومية محاضر بالأعمال المطلوبة ضمن الأوضاع العادية"@ar ;
    dznorm:sourceArticle "art_197" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_197_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_197> ;
    dzdoc:position 0 ;
    dzdoc:text "يثبت غياب المرسل إليه بموجب محضر ، إذا كانت مدة غيابه غير محدودة، أو كان تبليغ الورقة لا يمكن أن يتم ضمن المهلتين المذكورتين في المادة 194."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_197_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_197> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا أفضت الاستعلامات إلى الوقوف على المكان الذي يسكن فيه المرسل إليه، جرى قيد ذلك في محضر تثبيت الغياب."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_197_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_197> ;
    dzdoc:position 2 ;
    dzdoc:text "وفي حالة انعدام المعلومات اللازمة، يجوز لـ وكيل الدولة العسكري أن يطلب من جميع أعوان القوة العمومية الشروع في التحريات لاكتشاف عنوان المعني."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_197_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_197> ;
    dzdoc:position 3 ;
    dzdoc:text "ويضع أعوان القوة العمومية محاضر بالأعمال المطلوبة ضمن الأوضاع العادية، حتى ولو بقيت دون جدوى، ثم تحال المحاضر مرفقة بنسخة مصدقة إلى وكيل الدولة العسكري."@ar .

