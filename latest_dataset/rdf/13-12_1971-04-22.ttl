<https://legal.dz/resource/order/1971-04-22/71-28#version_art_179> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعتبر جميع الأحكام الصادرة عن المحاكم العسكرية حضورية، ولا يجوز المعارضة فيها ما عدا الأحكام الغيابية الصادرة ضمن الشروط المنصوص عليها في المادة 199 وما يليها. كما لا يجوز للمتهم الحاضر أن يصرح باعتباره غائبا، ويجب أن تعتبر المرافعات كحضورية، فإذا رفض المثول أمام المحكمة أو رفض الحضور مطلقا، بعد أن سبق له الحضور، تجرى المرافعات ويصدر الحكم بحق المتهم كما لو كان حاضرا، مع مراعاة الاجراءات المنصوص عليها في المادة 145 عند الاقتضاء."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_179_19710422_OpEnact_e021cf5e06> ;
    dzdoc:replacementText "تعتبر جميع الأحكام الصادرة عن المحاكم العسكرية حضورية، ولا يجوز المعارضة فيها ما عدا الأحكام الغيابية الصادرة ضمن الشروط المنصوص عليها في المادة 199 وما يليها. كما لا يجوز للمتهم الحاضر أن يصرح باعتباره غائبا، ويجب أن تعتبر المرافعات كحضورية، فإذا رفض المثول أمام المحكمة أو رفض الحضور مطلقا، بعد أن سبق له الحضور، تجرى المرافعات ويصدر الحكم بحق المتهم كما لو كان حاضرا، مع مراعاة الاجراءات المنصوص عليها في المادة 145 عند الاقتضاء."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_179> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
