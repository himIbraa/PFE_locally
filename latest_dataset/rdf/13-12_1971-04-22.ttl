    dzdoc:position 0 ;
    dzdoc:text "يجوز لوكلاء الدولة العسكريين وقضاة التحقيق العسكريين، في حالة الجناية أو الجرم المتلبس به والمرتكب بحضورهم، أن يباشروا إجراءات التحقيق وفقا لنص المادتين 38 و 56 من قانون الاجراءات الجزائية مع مراعاة الأحكام المنصوص عليها في المواد من 57 إلى 64 من هذا القانون."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_48_permission_0_15f2e9e0> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1971-04-22/71-28#art_48_permission_0_15f2e9e0_action_84cfd85d8e> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_48> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجوز لوكلاء الدولة العسكريين وقضاة التحقيق العسكريين، في حالة الجناية أو الجرم المتلبس به والمرتكب بحضورهم، أن يباشروا إجراءات التحقيق وفقا لنص المادتين 38 و 56 من قانون الاجراءات الجزائية مع مراعاة الأحكام المنصوص عليها في المواد من 57 إلى 64 من هذا القانون."@ar ;
    dznorm:sourceArticle "art_48" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_48_permission_0_15f2e9e0_action_84cfd85d8e> a dznorm:Action ;
