<https://legal.dz/resource/order/1971-04-22/71-28#art_13_obligation_1_601fb6c3> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
