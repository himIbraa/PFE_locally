    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_22> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_22_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_22> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق الأحكام الأخرى المقررة لسير وخدمة المحاكم العسكرية الدائمة وقت السلم، على المحاكم العسكرية الدائمة وقت الحرب."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_230_condition_0_0688c584> a dznorm:Condition ;
    dznorm:conditionText "إذا صدر الحكم بالحبس أو الغرامة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_230> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_230_extref_80f529d2> a dzdoc:ExternalReference ;
    rdfs:label "594"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/criminal_procedure#art_594"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/code/criminal_procedure#art_594"^^xsd:anyURI ;
