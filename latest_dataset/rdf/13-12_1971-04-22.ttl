<https://legal.dz/resource/order/1971-04-22/71-28#version_art_167> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحكم بالعقوبة الأشد في حالة ارتكاب عدة جنايات أو جنح. وإذا كانت العقوبة الأصلية موضوع عفو ، فينبغي لتطبيق تعدد العقوبات، مراعاة العقوبة الناجمة عن التخفيف وليس العقوبة المقررة أوليا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_167_19710422_OpEnact_cbae7f670e> ;
