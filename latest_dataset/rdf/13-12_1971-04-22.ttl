<https://legal.dz/resource/order/1971-04-22/71-28#art_54_extref_e800c7d7> a dzdoc:ExternalReference ;
    rdfs:label "قانون الاجراءات الجزائية"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-155"^^xsd:anyURI ;
