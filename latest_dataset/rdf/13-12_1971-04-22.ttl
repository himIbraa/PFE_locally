<https://legal.dz/resource/order/1971-04-22/71-28#version_art_299> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من سنة إلى خمس سنوات، كل شخص، عسكريا كان أم لا ، يستعمل بدون حق، في زمن الحرب أو في منطقة العمليات لقوة أو تشكيلة مخالفا بذلك القوانين والأعراف الحربية، الشارات المميزة والشعارات المحددة في الاتفاقات الدولية الآيلة لمراعاة الأشخاص أو الأموال وكذلك الأماكن الواقعة تحت حماية هذه الاتفاقات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_299_19710422_OpEnact_5a75aa219a> ;
    dzdoc:replacementText "يعاقب بالحبس من سنة إلى خمس سنوات، كل شخص، عسكريا كان أم لا ، يستعمل بدون حق، في زمن الحرب أو في منطقة العمليات لقوة أو تشكيلة مخالفا بذلك القوانين والأعراف الحربية، الشارات المميزة والشعارات المحددة في الاتفاقات الدولية الآيلة لمراعاة الأشخاص أو الأموال وكذلك الأماكن الواقعة تحت حماية هذه الاتفاقات."@ar ;
