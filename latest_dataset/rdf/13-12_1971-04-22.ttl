<https://legal.dz/resource/order/1971-04-22/71-28#art_71_obligation_0_87677021> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_71> ;
    dznorm:position 0 ;
    dznorm:provisionText "يصدر أمرا بالملاحقة يوجهه لوكيل الدولة العسكري لدى المحكمة المختصة ويرفق به التقارير والمحاضر والأوراق والأشياء المحجوزة وغير ذلك من الوثائق المؤيدة"@ar ;
    dznorm:sourceArticle "art_71" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_71_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_71> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما يطلع وزير الدفاع الوطني على محضر أو تقرير ضابط الشرطة القضائية العسكرية أو إحدى السلطات المذكورة في المادة 47 أو بعد استلامه شكوى أو اتهام وحتى بصفة تلقائية، ويرى بأنه ينبغي إجراء الملاحقات، فله أن يصدر أمرا بالملاحقة يوجهه لوكيل الدولة العسكري لدى المحكمة المختصة ويرفق به التقارير والمحاضر والأوراق والأشياء المحجوزة وغير ذلك من الوثائق المؤيدة."@ar .

