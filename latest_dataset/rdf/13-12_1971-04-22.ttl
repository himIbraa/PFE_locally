    dznorm:sourceArticle "art_196" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_196_obligation_2_b0f2bfcc> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
