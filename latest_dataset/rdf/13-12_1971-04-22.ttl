<https://legal.dz/resource/order/1971-04-22/71-28#art_81_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_81> ;
    dzdoc:position 0 ;
    dzdoc:text "يستدعي قاضي التحقيق العسكري كل شخص يرى فائدة في الاستماع لشهادته للمثول أمامه، بواسطة أحد أعوان القوة العمومية."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_81_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_81> ;
    dzdoc:position 1 ;
    dzdoc:text "وتطبق أحكام المادة 97 من قانون الاجراءات الجزائية على الشاهد الممتنع عن الحضور أو الشاهد الذي يمتنع عن أداء اليمين والإدلاء بشهادته رغم حضوره."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_82_condition_0_c2bd4bec> a dznorm:Condition ;
    dznorm:conditionText "مع مراعاة الأحكام الخاصة المنصوص عليها في الاتفاقات الدولية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_82> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_82_condition_1_4682a831> a dznorm:Condition ;
    dznorm:conditionText "إذا كان الشهود مقيمين في بلد أجنبي وكان معينا فيه قنصل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_82> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_82_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_82> ;
    dzdoc:position 0 ;
    dzdoc:text "مع مراعاة الأحكام الخاصة المنصوص عليها في الاتفاقات الدولية، تحال أوراق التكليف بالحضور الخاصة بالشهود إلى السلطات المحلية المختصة بواسطة القنصل، إذا كان الشهود مقيمين في بلد أجنبي وكان معينا فيه قنصل، أو ترسل مباشرة لهم في حالة عدم وجود قنصل."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_83_extref_3631af11> a dzdoc:ExternalReference ;
    rdfs:label "قانون الاجراءات الجزائية"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/1966-06-08/66-155"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-155"^^xsd:anyURI ;
