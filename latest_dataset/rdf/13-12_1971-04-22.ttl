<https://legal.dz/resource/order/1971-04-22/71-28#art_80_obligation_0_17353af7_role_fd2c436005> a dznorm:Role ;
    rdfs:label "هذا الأخير"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "عندما يشرع قاضي التحقيق العسكري في استجواب المتهم لأول مرة في زمن الحرب، ينبه على هذا الأخير، إذا لم يكن قد اختار مدافعا ، بأنه سيعين له مدافع بصفة تلقائية في ورقة التكليف بالحضور، ويذكر ذلك في المحضر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_80> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_80_obligation_1_bcd520d4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_80> ;
    dznorm:position 1 ;
    dznorm:provisionText "وفي حالة اختيار المدافع، يوجه القاضي لهذا الأخير إخبارا عن تاريخ أول استجواب أو مواجهة للمتهم، وذلك بواسطة رسالة أو أية وسيلة أخرى"@ar ;
    dznorm:sourceArticle "art_80" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_80_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_80> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما يشرع قاضي التحقيق العسكري في استجواب المتهم لأول مرة في زمن الحرب، ينبه على هذا الأخير، إذا لم يكن قد اختار مدافعا ، بأنه سيعين له مدافع بصفة تلقائية في ورقة التكليف بالحضور، ويذكر ذلك في المحضر."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_80_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_80> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي حالة اختيار المدافع، يوجه القاضي لهذا الأخير إخبارا عن تاريخ أول استجواب أو مواجهة للمتهم، وذلك بواسطة رسالة أو أية وسيلة أخرى. ويذكر في محضر الاستجواب أو المواجهة بأن استكمال هذا الإجراء قد تم."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_81_extref_20228db4> a dzdoc:ExternalReference ;
    rdfs:label "المادة 97 من قانون الاجراءات الجزائية"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-155#art_97"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-155#art_97"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-155#art_97" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
