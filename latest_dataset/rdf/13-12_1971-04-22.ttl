<https://legal.dz/resource/order/1971-04-22/71-28#version_art_232> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن العقوبات الصادرة عن جناية أو جنحة عسكرية لا يمكن أن تجعل المحكوم عليه في حالة العود. وتطبق المحاكم العسكرية أحكام المادة 54 وما يليها من قانون العقوبات على الحكم في الجرائم التابعة للقانون العام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_232_19710422_OpEnact_5a3fba8dcd> ;
