<https://legal.dz/resource/order/1971-04-22/71-28#version_art_192> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتضمن التكليف بالحضور الخاص بالمتهم ما يلي: 1 - اسم وصفة السلطة الطالبة، 2 - حكم الإحالة المستند إليه أو التقديم المباشر وأمر التكليف الصادر من المحكمة، وتعيين مكان انعقاد الجلسة مع بيان التاريخ والساعة، 3 - الواقعة موضوع المتابعة مع بيان النص القانوني المطبق وأسماء الشهود والخبراء الذين طلب وكيل الدولة العسكري الاستماع إليهم، 4 - إخبار المتهم تحت طائلة البطلان أنه في حال امتناعه عن اختيار مدافع عنه ، يصار إلى تعيين مدافع عنه تلقائيا ، 5 - إخطار المتهم، بأنه ينبغي عليه إبلاغ وكيل الدولة العسكري "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_192_19710422_OpEnact_ca4c5f1e94> ;
    dzdoc:replacementText "يتضمن التكليف بالحضور الخاص بالمتهم ما يلي: 1 - اسم وصفة السلطة الطالبة، 2 - حكم الإحالة المستند إليه أو التقديم المباشر وأمر التكليف الصادر من المحكمة، وتعيين مكان انعقاد الجلسة مع بيان التاريخ والساعة، 3 - الواقعة موضوع المتابعة مع بيان النص القانوني المطبق وأسماء الشهود والخبراء الذين طلب وكيل الدولة العسكري الاستماع إليهم، 4 - إخبار المتهم تحت طائلة البطلان أنه في حال امتناعه عن اختيار مدافع عنه ، يصار إلى تعيين مدافع عنه تلقائيا ، 5 - إخطار المتهم، بأنه ينبغي عليه إبلاغ وكيل الدولة العسكري بقائمة الشهود الذين يطلب الاستماع إليهم وذلك بموجب تصريح يقدم لكتابة الضبط قبل 8 أيام من الجلسة. وتكون ورقة التكليف بالحضور مؤرخة وموقعة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_192> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_192> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1971-04-22/71-28#version_art_193> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب فضلا عما تقدم، أن يتضمن التكليف بالحضور الخاص بالمتهم ، في زمن الحرب ، وتحت طائلة البطلان، ما يلي: 1 - اسم المدافع المكلف تلقائيا، 2 – تنبيه المتهم بأنه في إمكانه أن يختار مدافعا بدلا منه لحين افتتاح المرافعات . كما يجب أن يتضمن هذا التكليف ما يشير إلى إمكانية المتهم من الاستفادة كذلك من أحكام الفقرة 5 من المادة 131 بالنسبة لاستدعاء الشهود ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_193_19710422_OpEnact_387a66a886> ;
    dzdoc:replacementText "يجب فضلا عما تقدم، أن يتضمن التكليف بالحضور الخاص بالمتهم ، في زمن الحرب ، وتحت طائلة البطلان، ما يلي: 1 - اسم المدافع المكلف تلقائيا، 2 – تنبيه المتهم بأنه في إمكانه أن يختار مدافعا بدلا منه لحين افتتاح المرافعات . كما يجب أن يتضمن هذا التكليف ما يشير إلى إمكانية المتهم من الاستفادة كذلك من أحكام الفقرة 5 من المادة 131 بالنسبة لاستدعاء الشهود ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
