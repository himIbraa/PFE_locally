<https://legal.dz/resource/order/1971-04-22/71-28#version_art_320> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين إلى سنة كل عسكري يهين أثناء الخدمة أو خلال الخدمة مرؤوسا إهانة جسيمة وبدون استفزاز وذلك بالكلام أو بالحركات أو بالتهديد أو بالكتابة. تعتبر أعمال الإهانة التي يرتكبها عسكري وهو على ظهر سفينة بحرية أو طائرة عسكرية كأنها مرتكبة أثناء الخدمة، وإذا لم يرتكب الجرم أثناء الخدمة أو بمناسبة الخدمة، فيعاقب بالحبس من شهرين إلى ستة أشهر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_320_19710422_OpEnact_8953b8b85a> ;
