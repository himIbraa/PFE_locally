<https://legal.dz/resource/order/1971-04-22/71-28#art_126_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_126> ;
    dzdoc:position 0 ;
    dzdoc:text "إن أمر قاضي التحقيق العسكري المطعون فيه بالاستئناف، ينتج أثره الكامل إن أكدته المحكمة العسكرية."@ar .

