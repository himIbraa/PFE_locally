<https://legal.dz/resource/order/1971-04-22/71-28#version_art_34> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يحدد في هذا القانون أو ينص فيه على قمع الجرائم المنسوبة للمتقاضين الأجانب عن الجيش ، فتكون المحاكم العسكرية مختصة بالنسبة للفاعل الأصلي أو المشترك في الجريمة ما عدا حالة الاستثناء الخاص."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_34_19710422_OpEnact_54a14ec90b> ;
