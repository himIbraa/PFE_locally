<https://legal.dz/resource/order/1971-04-22/71-28#version_art_273> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل عسكري جعل نفسه قصدا غير صالح للخدمة مؤقتا أو مؤبدا، ليتهرب من واجباته العسكرية يعاقب على الشكل التالي : 1 - في زمن السلم ، بالحبس من سنة واحدة إلى خمس سنوات، وبمنعه من ممارسة الحقوق المنصوص عليها في المدة 8 من قانون العقوبات لمدة تتراوح بين خمس سنوات إلى عشر سنوات، وإذا كان المجرم ضابطا يحكم عليه بعقوبة العزل. 2 - في زمن الحرب ، بالسجن المؤقت مع الأشغال من خمس سنوات إلى عشر سنوات. 3 - بنفس العقوبة إذا وجد في أرض بحالة الحكم العرفي أو بحالة الطوارئ أو أمام عصابة مسلحة . ويعاقب بالإعدام إذا كان"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_273_19710422_OpEnact_7658390073> ;
    dzdoc:replacementText "كل عسكري جعل نفسه قصدا غير صالح للخدمة مؤقتا أو مؤبدا، ليتهرب من واجباته العسكرية يعاقب على الشكل التالي : 1 - في زمن السلم ، بالحبس من سنة واحدة إلى خمس سنوات، وبمنعه من ممارسة الحقوق المنصوص عليها في المدة 8 من قانون العقوبات لمدة تتراوح بين خمس سنوات إلى عشر سنوات، وإذا كان المجرم ضابطا يحكم عليه بعقوبة العزل. 2 - في زمن الحرب ، بالسجن المؤقت مع الأشغال من خمس سنوات إلى عشر سنوات. 3 - بنفس العقوبة إذا وجد في أرض بحالة الحكم العرفي أو بحالة الطوارئ أو أمام عصابة مسلحة . ويعاقب بالإعدام إذا كان أمام العدو . ويعاقب عن المحاولة كما يعاقب عن الجرم نفسه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_273> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_273> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1971-04-22/71-28#version_art_274> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان الشركاء في الجريمة أطباء أو صيادلة ، فيمكن أن تضاعف عقوبة الحبس أو السجن المؤقت مع الأشغال، فضلا عن الغرامة البالغة 5.000 دج إلى 20.000 دج بالنسبة للفاعلين غير العسكريين أو غير المماثلين للعسكريين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_274_19710422_OpEnact_cab901d305> ;
