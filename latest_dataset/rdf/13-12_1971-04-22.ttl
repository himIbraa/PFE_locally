<https://legal.dz/resource/order/1971-04-22/71-28#version_art_224> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعتبر المدة التي حرم فيها الشخص من حريته بالنسبة لتنفيذ العقوبات الصادرة بحق العسكريين أو المماثلين لهم، من قبل المحاكم العسكرية أو المحاكم التابعة للقانون العام كحبس احتياطي، حتى ولو كان ذلك من قبل التدبير التأديبي في حال حصول السبب . يكلف الوكلاء العسكريون للدولة مؤقتا بتطبيق الأحكام الجزائية، ويقومون لهذا الغرض بتشخيص العقوبات والمعاملات ويراقبون شروط تطبيقها على الأشخاص المحكوم عليهم من طرف المحكمة العسكرية الدائمة التابعة لدائرة اختصاصهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_224_19710422_OpEnact_e525f35c1c> ;
    dzdoc:replacementText "تعتبر المدة التي حرم فيها الشخص من حريته بالنسبة لتنفيذ العقوبات الصادرة بحق العسكريين أو المماثلين لهم، من قبل المحاكم العسكرية أو المحاكم التابعة للقانون العام كحبس احتياطي، حتى ولو كان ذلك من قبل التدبير التأديبي في حال حصول السبب . يكلف الوكلاء العسكريون للدولة مؤقتا بتطبيق الأحكام الجزائية، ويقومون لهذا الغرض بتشخيص العقوبات والمعاملات ويراقبون شروط تطبيقها على الأشخاص المحكوم عليهم من طرف المحكمة العسكرية الدائمة التابعة لدائرة اختصاصهم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_224> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
