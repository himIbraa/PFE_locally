<https://legal.dz/resource/order/1971-04-22/71-28#version_art_6> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم تعيين القضاة الرسميين والاحتياطيين لمدة سنة واحدة، بموجب قرار مشترك صادر عن وزير العدل حامل الأختام و وزير الدفاع الوطني . ويمارس هؤلاء القضاة مهامهم ما لم تصدر تعيينات جديدة ولحين انتهاء الجلسات الخاصة بقضية شاركوا في جلستها الأولى. وعندما تكون إحدى القضايا من النوع التي تطول المرافعات فيها ، يجوز تكليف الأعضاء الاحتياطيين لحضور الجلسات بقصد الحلول عند الاقتضاء، محل الأعضاء الحاصل لهم عذر مشروع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_6_19710422_OpEnact_2fd3efd83a> ;
    dzdoc:replacementText "يتم تعيين القضاة الرسميين والاحتياطيين لمدة سنة واحدة، بموجب قرار مشترك صادر عن وزير العدل حامل الأختام و وزير الدفاع الوطني . ويمارس هؤلاء القضاة مهامهم ما لم تصدر تعيينات جديدة ولحين انتهاء الجلسات الخاصة بقضية شاركوا في جلستها الأولى. وعندما تكون إحدى القضايا من النوع التي تطول المرافعات فيها ، يجوز تكليف الأعضاء الاحتياطيين لحضور الجلسات بقصد الحلول عند الاقتضاء، محل الأعضاء الحاصل لهم عذر مشروع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_6> ;
