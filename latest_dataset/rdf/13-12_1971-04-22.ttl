    dzdoc:position 0 ;
    dzdoc:text "يعتبر بمثابة فرار مع التآمر ، كل فرار حاصل بتواطؤ أكثر من شخصين."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_258_defocc_8f7b6b077eb8> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 39 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:desertion_external ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_258> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_258_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يعتبر فارا إلى خارج البلاد في زمن السلم بعد ثلاثة أيام من التحقق من غيابه، كل عسكري يجتاز بدون إذن حدود أرض الجمهورية أو يترك وهو خارج هذه الأراضي القطعة أو المفرزة أو القاعدة أو التشكيلة التي ينتمي إليها، أو السفينة البحرية أو الطائرة المنتقل عليها."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_258_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_258> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر فارا إلى خارج البلاد في زمن السلم بعد ثلاثة أيام من التحقق من غيابه، كل عسكري يجتاز بدون إذن حدود أرض الجمهورية أو يترك وهو خارج هذه الأراضي القطعة أو المفرزة أو القاعدة أو التشكيلة التي ينتمي إليها، أو السفينة البحرية أو الطائرة المنتقل عليها."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_259_defocc_cc5a40d199ee> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 39 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:desertion_external ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_259> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_259_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يعتبر فارا إلى خارج البلاد في زمن السلم، كل عسكري لا يلتحق، وهو خارج التراب الوطني بالقطعة أو المفرزة أو القاعدة أو التشكيلة التي ينتمي إليها أو السفينة أو الطائرة التي ينتقل عليها، وذلك بعد انقضاء مهلة ستة أيام من المدة المحددة لعودته من الرخصة أو العطلة أو المهمة أو السفر."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_259_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_259> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر فارا إلى خارج البلاد في زمن السلم، كل عسكري لا يلتحق، وهو خارج التراب الوطني بالقطعة أو المفرزة أو القاعدة أو التشكيلة التي ينتمي إليها أو السفينة أو الطائرة التي ينتقل عليها، وذلك بعد انقضاء مهلة ستة أيام من المدة المحددة لعودته من الرخصة أو العطلة أو المهمة أو السفر."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_260_defocc_b68eacde4843> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 26 ;
