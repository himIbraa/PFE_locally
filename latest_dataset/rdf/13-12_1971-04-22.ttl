    dznorm:provisionText "يحكم على المتهم بالمصاريف الواجبة الأداء للدولة في حالة الحكم أو العفو"@ar ;
    dznorm:sourceArticle "art_240" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_240_obligation_0_6ce1be1b_role_5f834b90e3> a dznorm:Role ;
