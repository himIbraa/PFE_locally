<https://legal.dz/resource/order/1971-04-22/71-28#art_273_obligation_0_3530432e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
