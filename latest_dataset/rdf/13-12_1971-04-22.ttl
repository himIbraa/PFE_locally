<https://legal.dz/resource/order/1971-04-22/71-28#art_45_defocc_f5a154b980fb> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 36 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:police_officer ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_45> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_45_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يعتبر ضباطا للشرطة القضائية العسكرية :
                
                
                1 - كل العسكريين التابعين للدرك الوطني والحائزين لصفة ضباط الشرطة القضائية، حسب التعريف الوارد في قانون الاجراءات الجزائية،
                
                
                2 - كل ضباط للقطع العسكرية أو المصلحة والمعينين خصيصا لهذا الغرض، بموجب قرار وزير الدفاع الوطني."""@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_45_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_45> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر ضباطا للشرطة القضائية العسكرية : 1 - كل العسكريين التابعين للدرك الوطني والحائزين لصفة ضباط الشرطة القضائية، حسب التعريف الوارد في قانون الاجراءات الجزائية، 2 - كل ضباط للقطع العسكرية أو المصلحة والمعينين خصيصا لهذا الغرض، بموجب قرار وزير الدفاع الوطني."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_46_right_0_944addbd_ref_615139b85cdc> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "المادة 19"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/criminal_procedure#art_19"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/code/criminal_procedure#art_19"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/criminal_procedure#art_19" ;
    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" ;
    dzdoc:sourceEId "art_46" ;
    dzdoc:sourceElementType "right" ;
    dzdoc:sourceTextSpan "يتمتع العسكريون التابعون للدرك، لأجل ممارسة أعمال الشرطة القضائية العسكرية، سواء كانوا حائزين لصفة ضباط الشرطة القضائية أم لا، بالسلطات المخصصة في قانون الاجراءات الجزائية لضباط الشرطة القضائية أو أعوان الشرطة القضائية المذكورين في المادة 19 من القانون المذكور"@ar ;
    dzdoc:targetEId "art_19" .

