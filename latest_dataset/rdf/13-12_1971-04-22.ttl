<https://legal.dz/resource/order/1971-04-22/71-28#version_art_289> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من سنة إلى خمس سنوات كل عسكري أو كل شخص منتقل يرتكب عن قصد جريمة التسبب في إتلاف سلاح أو أي شئ آخر خاص بخدمة الجيش، أو في جعله غير صالح للاستعمال نهائيا أو مؤقتا، حتى ولو كان مملوكا للفاعل، وسواء كان في حيازته للخدمة أو معدا لاستعمال غيره من العسكريين لنفس الغاية . ويقضى بعقوبة السجن المؤقت مع الأشغال من عشر سنوات إلى عشرين سنة ، إذا أصبح الشئ غير صالح للخدمة المعنية في تشغيل سفينة بحرية أو طائرة عسكرية، أو إذا كان الفعل حاصلا في زمن الحرب أو أثناء حريق أو جنوح سفينة أو تصادمها أو أ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_289_19710422_OpEnact_d485de7ff1> ;
    dzdoc:replacementText "يعاقب بالحبس من سنة إلى خمس سنوات كل عسكري أو كل شخص منتقل يرتكب عن قصد جريمة التسبب في إتلاف سلاح أو أي شئ آخر خاص بخدمة الجيش، أو في جعله غير صالح للاستعمال نهائيا أو مؤقتا، حتى ولو كان مملوكا للفاعل، وسواء كان في حيازته للخدمة أو معدا لاستعمال غيره من العسكريين لنفس الغاية . ويقضى بعقوبة السجن المؤقت مع الأشغال من عشر سنوات إلى عشرين سنة ، إذا أصبح الشئ غير صالح للخدمة المعنية في تشغيل سفينة بحرية أو طائرة عسكرية، أو إذا كان الفعل حاصلا في زمن الحرب أو أثناء حريق أو جنوح سفينة أو تصادمها أو أثناء مناورة تهم أمن السفينة البحرية أو الطائرة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_289> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_289> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1971-04-22/71-28#version_art_29> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعتبر مماثلة للمؤسسات العسكرية، جميع المنشآت المحدثة بصفة نهائية ومؤقتة والمستعملة من طرف الجيش والسفن البحرية والطائرات العسكرية أينما كانت ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_29_19710422_OpEnact_23d2a0f50c> ;
    dzdoc:replacementText "تعتبر مماثلة للمؤسسات العسكرية، جميع المنشآت المحدثة بصفة نهائية ومؤقتة والمستعملة من طرف الجيش والسفن البحرية والطائرات العسكرية أينما كانت ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_29> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_29> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
