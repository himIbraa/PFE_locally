<https://legal.dz/resource/order/1971-04-22/71-28#version_art_28> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحاكم أيضا أمام المحاكم العسكرية الدائمة : الأشخاص المعتبرون موجودين بأية صفة كانت، ضمن جدول ملاحي سفينة بحرية أو طائرة عسكرية، الأشخاص المقيدون في جدول الخدمة والقائمون بها، دون أن يكونوا مرتبطين قانونيا أو تعاقديا بالجيش، الأشخاص المطرودون من الجيش والمعتبرون تابعين لأحد الأوضاع الخاصة بالعسكريين المشار إليهم في المادتين 26 و 27 ، أفراد ملاحي القيادة، أسرى الحرب."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
