<https://legal.dz/resource/order/1971-04-22/71-28#version_art_60> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينبغي سوق العسكريين الموقوفين بالجرم المتلبس به أو الذين تقوم ضدهم أدلة خطيرة ومطابقة للجرم، لتقديمهم لوكيل الدولة العسكري أو السلطة القضائية العسكرية أو المدنية المختصة في مهل أقصاها، حلول آجال المهل المحددة في المواد 57 و 58 أو 59 بحسب الحالة. ويجب إخبار الرؤساء السلميين بالنقل. وفي انتظار سوق العسكريين المذكورين في الفقرة السابقة، فإنه يجوز وضعهم في أحد الأماكن المذكورة في الفقرة 2 من المادة 57 أو في مكان خاص بالشرطة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_60_19710422_OpEnact_f70937058c> ;
    dzdoc:replacementText "ينبغي سوق العسكريين الموقوفين بالجرم المتلبس به أو الذين تقوم ضدهم أدلة خطيرة ومطابقة للجرم، لتقديمهم لوكيل الدولة العسكري أو السلطة القضائية العسكرية أو المدنية المختصة في مهل أقصاها، حلول آجال المهل المحددة في المواد 57 و 58 أو 59 بحسب الحالة. ويجب إخبار الرؤساء السلميين بالنقل. وفي انتظار سوق العسكريين المذكورين في الفقرة السابقة، فإنه يجوز وضعهم في أحد الأماكن المذكورة في الفقرة 2 من المادة 57 أو في مكان خاص بالشرطة."@ar ;
