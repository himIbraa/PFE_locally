<https://legal.dz/resource/order/1971-04-22/71-28#version_art_82> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مع مراعاة الأحكام الخاصة المنصوص عليها في الاتفاقات الدولية ، تحال أوراق التكليف بالحضور الخاصة بالشهود إلى السلطات المحلية المختصة بواسطة القنصل، إذا كان الشهود مقيمين في بلد أجنبي وكان معينا فيه قنصل ، أو ترسل مباشرة لهم في حالة عدم وجود قنصل."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_82_19710422_OpEnact_8f90050231> ;
