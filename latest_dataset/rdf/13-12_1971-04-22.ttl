<https://legal.dz/resource/order/1971-04-22/71-28#art_67> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_67" ;
    dzdoc:fullText "تحرك الدعوى العمومية لدى المحاكم العسكرية من قبل السلطات وضمن الشروط المحددة بعده ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_67> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_67_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_67_19710422_OpEnact_ac94af69a8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_67_obligation_0_257a4f05> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 67" ;
    dzdoc:position 66 ;
    dzdoc:usesTerm dzterm:public_action .

<https://legal.dz/resource/order/1971-04-22/71-28#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "إن أمر الملاحقة غير قابل للطعن فيه، و ينبغي أن يتضمن الوقائع التي يستند إليها، ووصف هذه الوقائع وبيان النصوص القانونية المطبقة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_72_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_72_19710422_OpEnact_1f7ba1307b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_72_obligation_0_94c92fd3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 72" ;
    dzdoc:position 71 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_81> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_5> ;
    dzdoc:eId "art_81" ;
    dzdoc:fullText "يستدعي قاضي التحقيق العسكري كل شخص يرى فائدة في الاستماع لشهادته للمثول أمامه، بواسطة أحد أعوان القوة العمومية. وتطبق أحكام المادة 97 من قانون الاجراءات الجزائية على الشاهد الممتنع عن الحضور أو الشاهد الذي يمتنع عن أداء اليمين والإدلاء بشهادته رغم حضوره."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_81> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_81_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_81_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_81_19710422_OpEnact_e6985cd55c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 81" ;
    dzdoc:position 80 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_81_extref_20228db4> ;
    dzdoc:usesTerm dzterm:military_investigating_judge .

<https://legal.dz/resource/order/1971-04-22/71-28#art_83> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_6> ;
    dzdoc:eId "art_83" ;
    dzdoc:fullText "تطبق أحكام قانون الاجراءات الجزائية المتعلقة بالخبرة أمام الجهات القضائية العسكرية الخاصة بالتحقيق والمحاكمة. وان القضاة المدعوين لإجراء الخبرة يمكنهم أيضا أن يختاروا بكل حرية، خبراء من بين جميع الموظفين المتخصصين التابعين لوزارة الدفاع الوطني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_83> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_83_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_83_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_83_19710422_OpEnact_fadfbce989> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "83" ;
    dzdoc:position 82 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_83_extref_3631af11> ;
    dzdoc:usesTerm dzterm:judges,
        dzterm:judicial_authorities .

