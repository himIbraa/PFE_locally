<https://legal.dz/resource/order/1971-04-22/71-28#art_122_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_122> ;
    dzdoc:position 0 ;
    dzdoc:text "إن المحكمة العسكرية الناظرة تلقائيا في القضية طبقا للفقرة 2 من المادة 86 تقدر بالنسبة لحالة القضية أو بعد التحقيق الإضافي، إذا كان ينبغي أم لا ، إصدار الأمر بالملاحقات ضد المتهمين الذين حققت هويتهم أو ضد مرتكبي الأفعال الآخرين أو الشركاء في الأفعال الواردة في أمر الملاحقات أو الأخذ بأفعال تحت وصف تنطبق عليه العقوبة الأشد."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_123_condition_0_d9f15427> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1971-04-22/71-28#art_123_condition_0_d9f15427_ref_3632e966c7cd> ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_122> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_122> ;
    dznorm:conditionText "عندما تصدر المحكمة العسكرية، حكما بإلغاء أمر قاضي التحقيق العسكري في أي موضوع مما ذكر في المادة 122"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_123> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_123_condition_0_d9f15427_ref_3632e966c7cd> a dzdoc:Reference ;
    rdfs:label "المادة 122"@ar ;
    dzdoc:frbrUri "#art_122"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1971-04-22/71-28#art_122> ;
    dzdoc:sourceEId "art_123" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "عندما تصدر المحكمة العسكرية، حكما بإلغاء أمر قاضي التحقيق العسكري في أي موضوع مما ذكر في المادة 122"@ar ;
    dzdoc:targetEId "art_122" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_123_condition_1_432508b5> a dznorm:Condition ;
    dznorm:conditionText "وعندما تأمر المحكمة العسكرية المنعقدة بهيئة غرفة الاتهام بإحالة القضية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_123> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_123_condition_2_7cec47f6> a dznorm:Condition ;
    dznorm:conditionText "فإذا كان الفعل يكون مخالفة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_123> ;
    dznorm:position 2 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_123_obligation_0_8503f151> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_123> ;
    dznorm:position 0 ;
    dznorm:provisionText "فينبغي أن يتضمن هذا الأمر، تحت طائلة البطلان، بيان الوقائع والوصف القانوني للأفعال المنسوبة للمتهم"@ar ;
    dznorm:sourceArticle "art_123" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_123_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_123> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما تصدر المحكمة العسكرية، حكما بإلغاء أمر قاضي التحقيق العسكري في أي موضوع مما ذكر في المادة 122، فيمكنها أن تقرر ما يلي : إما إعادة الملف إلى قاضي التحقيق العسكري لمتابعة التحقيق، وإما إحالة القضية إلى قضاء الحكم، بعد أن تكون قد أجرت تحقيقا إضافيا أم لا."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_123_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_123> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي هاتين الحالتين يستمر في حبس المتهم ما لم تقرر المحكمة العسكرية خلاف ذلك."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_123_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_123> ;
    dzdoc:position 2 ;
    dzdoc:text "وعندما تأمر المحكمة العسكرية المنعقدة بهيئة غرفة الاتهام بإحالة القضية، فينبغي أن يتضمن هذا الأمر، تحت طائلة البطلان، بيان الوقائع والوصف القانوني للأفعال المنسوبة للمتهم."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_123_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_123> ;
    dzdoc:position 3 ;
    dzdoc:text "فإذا كان الفعل يكون مخالفة، أفرج عن المتهم."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_123_right_0_20c613cd> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_123> ;
    dznorm:position 0 ;
    dznorm:provisionText "أفرج عن المتهم"@ar ;
    dznorm:sourceArticle "art_123" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_124_condition_0_369f8cf2> a dznorm:Condition ;
    dznorm:conditionText "إذا رأت المحكمة العسكرية المنعقدة بهيئة غرفة الاتهام، أن الوقائع لا تكون جناية أو جنحة أو مخالفة، أو كان مرتكب الجريمة لا يزال مجهولا ، أو لا تتوفر دلائل كافية ضد المتهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_124> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_124_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_124> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا رأت المحكمة العسكرية المنعقدة بهيئة غرفة الاتهام، أن الوقائع لا تكون جناية أو جنحة أو مخالفة، أو كان مرتكب الجريمة لا يزال مجهولا ، أو لا تتوفر دلائل كافية ضد المتهم، فتصرح بعدم وجوب الملاحقة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_124_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_124> ;
    dzdoc:position 1 ;
    dzdoc:text "ويفرج عن المتهمين المعتقلين احتياطيا وتفصل المحكمة في رد الأشياء المحجوزة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_124_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_124> ;
    dzdoc:position 2 ;
    dzdoc:text "وتبقى هذه المحكمة مختصة بالفصل في هذا الرد بعد صدور حكمها بمنع المحاكمة. أما إذا ألغيت المحكمة فلوزير الدفاع الوطني أن يعين المحكمة التي تكلف بالفصل في هذا الرد."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_124_right_0_102cc16e> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_124> ;
    dznorm:position 0 ;
    dznorm:provisionText "ويفرج عن المتهمين المعتقلين احتياطيا"@ar ;
    dznorm:sourceArticle "art_124" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_125_condition_0_c3672d53> a dznorm:Condition ;
    dznorm:conditionText "عندما تصدر المحكمة العسكرية حكما بمنع المحاكمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_125> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_125_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_125> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما تصدر المحكمة العسكرية حكما بمنع المحاكمة، فلوزير الدفاع الوطني عند الاقتضاء أو وكيل الدولة العسكري، أن يأمر بتجديد إجراءات الملاحقة استنادا لأدلة جديدة ضمن الشروط المنصوص عليها في المادة 71 وما يليها."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_125_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_125> ;
    dzdoc:position 1 ;
    dzdoc:text "وبمجرد رفع القضية أمام المحكمة العسكرية المنعقدة بهيئة غرفة الاتهام طبقا للفقرة 7 من المادة 74، يجوز لرئيس هذه المحكمة بناء على طلب وكيل الدولة العسكري أن يصدر أمرا بالإيداع في السجن أو التوقيف لغاية انعقاد هذه المحكمة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_125_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_125> ;
    dzdoc:position 2 ;
    dzdoc:text "وتباشر المحكمة العسكرية إجراءات التحقيق التحضيري وتفصل في كل طلب بالإفراج المؤقت وفقا لأحكام هذا الفصل وطبقا للنصوص المتعلقة بالتحقيق التحضيري."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_125_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_125> ;
    dzdoc:position 3 ;
    dzdoc:text "ويمكنها أن تصدر أي قرار بالملاحقة وأن تأمر بالإحالة، فيما يتعلق بجميع القضايا، أمام قضاء الحكم."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_125_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_125> ;
    dzdoc:position 4 ;
    dzdoc:text "وفيما يتعلق بالإجراء المتبع بموجب هذه المادة، فإن سلطات وكيل الدولة العسكري تبقى نفس السلطات المنصوص عليها في المادة 78."@ar .

