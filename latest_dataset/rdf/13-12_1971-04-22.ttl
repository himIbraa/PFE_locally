    dznorm:conditionText "إذا أبطل المجلس الأعلى الحكم لعدم الاختصاص"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_186> ;
    dznorm:position 0 .

