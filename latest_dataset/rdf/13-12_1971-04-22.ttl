<https://legal.dz/resource/order/1971-04-22/71-28#version_art_160> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للرئيس أيضا أن يطرح من تلقاء نفسه أسئلة احتياطية إذا تبين من خلال المرافعات بأن الفعل الأصلي يمكن اعتباره إما فعلا معاقبا عليه بعقوبة أخرى، وإما جناية أو جنحة تابعة للقانون العام ، ولكنه يجب عليه في هذه الحالة، أن يعبر عن نواياه في الجلسة العلنية قبل إقفال باب المرافعات ، ليتسنى للنيابة العامة والمتهم والدفاع من الإدلاء بملاحظاتهم في الوقت اللازم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_160_19710422_OpEnact_5dcbd9307f> ;
    dzdoc:replacementText "يجوز للرئيس أيضا أن يطرح من تلقاء نفسه أسئلة احتياطية إذا تبين من خلال المرافعات بأن الفعل الأصلي يمكن اعتباره إما فعلا معاقبا عليه بعقوبة أخرى، وإما جناية أو جنحة تابعة للقانون العام ، ولكنه يجب عليه في هذه الحالة، أن يعبر عن نواياه في الجلسة العلنية قبل إقفال باب المرافعات ، ليتسنى للنيابة العامة والمتهم والدفاع من الإدلاء بملاحظاتهم في الوقت اللازم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
