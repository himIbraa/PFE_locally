    dznorm:position 0 ;
    dznorm:provisionText "في إمكانه أن يختار مدافعا بدلا منه لحين افتتاح المرافعات"@ar ;
    dznorm:sourceArticle "art_193" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_193_right_1_3fea2962> a dznorm:Right ;
