        <https://legal.dz/resource/order/1971-04-22/71-28#art_46_right_0_944addbd_ref_ea36b66acccd> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_46> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتمتع العسكريون التابعون للدرك، لأجل ممارسة أعمال الشرطة القضائية العسكرية، سواء كانوا حائزين لصفة ضباط الشرطة القضائية أم لا، بالسلطات المخصصة في قانون الاجراءات الجزائية لضباط الشرطة القضائية أو أعوان الشرطة القضائية المذكورين في المادة 19 من القانون المذكور"@ar ;
    dznorm:sourceArticle "art_46" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_46_right_0_944addbd_activity_12b6e7de41> a dznorm:Activity ;
    rdfs:label "ممارسة أعمال الشرطة القضائية العسكرية"@ar ;
    dzdoc:confidenceScore 0.6 ;
    dzdoc:extractionMethod "lexical_activity_pattern" ;
    dzdoc:sourceTextSpan "يتمتع العسكريون التابعون للدرك، لأجل ممارسة أعمال الشرطة القضائية العسكرية، سواء كانوا حائزين لصفة ضباط الشرطة القضائية أم لا، بالسلطات المخصصة في قانون الاجراءات الجزائية لضباط الشرطة القضائية أو أعوان الشرطة القضائية المذكورين في المادة 19 من القانون المذكور"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_46> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_47_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_47> ;
    dzdoc:position 0 ;
    dzdoc:text "إن قادة الجيوش وقادة القواعد البحرية والجوية وقادة السفن البحرية ورؤساء القطع ورؤساء المستودعات والمفارز ورؤساء مختلف مصالح الجيش، يؤهلون شخصيا لجميع الأعمال الضرورية داخل مؤسساتهم العسكرية للتحقيق في الجرائم التابعة للقضاء العسكري وجمع الأدلة والبحث عن مرتكبي الجرائم."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_47_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_47> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجوز لهذه السلطات أن تفوض إلى ضابط تابع لأوامرها السلطات الآيلة لها بموجب الفقرة السابقة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_47_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_47> ;
    dzdoc:position 2 ;
    dzdoc:text "ويمكنها أيضا أن تطلب إلى أي ضابط للشرطة القضائية العسكرية المختصة إقليميا القيام بالإجراءات المنصوص عليها في المادتين 50 و 51 أدناه."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_48_condition_0_fbc28e91> a dznorm:Condition ;
    dznorm:conditionText "في حالة الجناية أو الجرم المتلبس به والمرتكب بحضورهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_48> ;
    dznorm:position 0 .

