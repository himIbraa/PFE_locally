    dznorm:position 0 ;
    dznorm:provisionText "يجب أن يقدم الاستئناف في مهلة ال24 ساعة"@ar ;
    dznorm:sourceArticle "art_99" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_99_obligation_0_870157c6_action_c0972810cb> a dznorm:Action ;
