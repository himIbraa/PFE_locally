<https://legal.dz/resource/order/1971-04-22/71-28#version_art_181> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمحكوم عليه في زمن السلم، وحتى في حالة الحكم المعتبر حضوريا أن يصرح لدى كتابة الضبط بالطعن بالنقض في الحكم ، بعد 8 أيام كاملة من إطلاعه عليه . كما يجوز لوكيل الدولة العسكري أن يصرح لدى كتابة الضبط بطلب نقض الحكم الصادر ، وذلك في نفس المهلة من تاريخ إصدار الحكم. وفي زمن الحرب تقصر هذه المهل إلى يوم كامل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_181_19710422_OpEnact_b7b4d0c9aa> ;
    dzdoc:replacementText "يجوز للمحكوم عليه في زمن السلم، وحتى في حالة الحكم المعتبر حضوريا أن يصرح لدى كتابة الضبط بالطعن بالنقض في الحكم ، بعد 8 أيام كاملة من إطلاعه عليه . كما يجوز لوكيل الدولة العسكري أن يصرح لدى كتابة الضبط بطلب نقض الحكم الصادر ، وذلك في نفس المهلة من تاريخ إصدار الحكم. وفي زمن الحرب تقصر هذه المهل إلى يوم كامل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_181> ;
