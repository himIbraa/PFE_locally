    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_45> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_45_condition_2_c8b0ef0a> a dznorm:Condition ;
    dznorm:conditionText "وعندما يقومون بأعمال التفتيش الخاصة بالجنايات أو الجرائم المتلبس بها خارج مؤسسة عسكرية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_45> ;
    dznorm:position 2 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_45_extref_ea36b66a> a dzdoc:ExternalReference ;
    rdfs:label "قانون الاجراءات الجزائية"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/criminal_procedure"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/code/criminal_procedure"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/criminal_procedure" ;
    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_45_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_45> ;
    dzdoc:position 1 ;
    dzdoc:text "إن ضباط الشرطة القضائية العسكرية يتبعون سلميا ومباشرة سلطة وكيل الدولة العسكري، الذي يكون بدوره خاضعا لسلطة وزير الدفاع الوطني."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_45_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_45> ;
    dzdoc:position 2 ;
    dzdoc:text "مع مراعاة عدم التعارض مع أحكام هذا القانون، فإن ضباط الشرطة القضائية العسكرية يتصرفون طبقا لأحكام قانون الاجراءات الجزائية."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_45_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_45> ;
    dzdoc:position 3 ;
    dzdoc:text "بيد أن المهل الخاصة بالوضع تحت المراقبة لضرورات التحقيق الابتدائي ترفع إلى 3 أيام. ويجوز مد هذه المهلة 48 ساعة . بموجب مقرر من وكيل الدولة العسكري."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_45_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_45> ;
    dzdoc:position 4 ;
    dzdoc:text "وتضاعف هذه المهل عندما يتعلق الأمر بالاعتداء على أمن الدولة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_45_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_45> ;
    dzdoc:position 5 ;
    dzdoc:text "وعندما يقومون بأعمال التفتيش الخاصة بالجنايات أو الجرائم المتلبس بها خارج مؤسسة عسكرية، فيتعين عليهم إخبار وكيل الدولة لدى المحكمة المدنية المختصة التي يمكنها أن تحضر عملياتهم أو توفد من يمثلها."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_46_extref_615139b8> a dzdoc:ExternalReference ;
    rdfs:label "المادة 19"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/criminal_procedure#art_19"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/code/criminal_procedure#art_19"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/criminal_procedure#art_19" ;
    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" ;
    dzdoc:targetEId "art_19" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_46_extref_ea36b66a> a dzdoc:ExternalReference ;
    rdfs:label "قانون الاجراءات الجزائية"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/criminal_procedure"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/code/criminal_procedure"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/criminal_procedure" ;
    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_46_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_46> ;
    dzdoc:position 0 ;
    dzdoc:text "يتمتع العسكريون التابعون للدرك، لأجل ممارسة أعمال الشرطة القضائية العسكرية، سواء كانوا حائزين لصفة ضباط الشرطة القضائية أم لا، بالسلطات المخصصة في قانون الاجراءات الجزائية لضباط الشرطة القضائية أو أعوان الشرطة القضائية المذكورين في المادة 19 من القانون المذكور."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_46_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_46> ;
    dzdoc:position 1 ;
    dzdoc:text "إن العسكريين غير المحلفين والذين يدعون للخدمة في الدرك، يعاونون ضباط الشرطة القضائية العسكرية الموضوعين تحت أمرتهم ويطلعونهم على الجرائم التي يقفون عليها."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_46_right_0_944addbd> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
