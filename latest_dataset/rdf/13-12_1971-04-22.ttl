<https://legal.dz/resource/order/1971-04-22/71-28#version_art_84> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبلغ أوامر الإحضار والتوقيف في جميع الظروف بواسطة أعوان القوة العمومية الذين يجب عليهم مراعاة أحكام قانون الاجراءات الجزائية من هذه الناحية . وعلاوة على ذلك، يجري إطلاع السلطات العسكرية عن أوامر التوقيف و الإيداع في السجن بواسطة الجهة القضائية التي أصدرتها . تنفذ أوامر الإحضار والتوقيف و الإيداع في السجن ضمن الشروط المحددة في قانون الاجراءات الجزائية ، باستثناء ما يخالف ذلك من أحكام هذا القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_84_19710422_OpEnact_687579af8f> ;
    dzdoc:replacementText "تبلغ أوامر الإحضار والتوقيف في جميع الظروف بواسطة أعوان القوة العمومية الذين يجب عليهم مراعاة أحكام قانون الاجراءات الجزائية من هذه الناحية . وعلاوة على ذلك، يجري إطلاع السلطات العسكرية عن أوامر التوقيف و الإيداع في السجن بواسطة الجهة القضائية التي أصدرتها . تنفذ أوامر الإحضار والتوقيف و الإيداع في السجن ضمن الشروط المحددة في قانون الاجراءات الجزائية ، باستثناء ما يخالف ذلك من أحكام هذا القانون ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_84> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
