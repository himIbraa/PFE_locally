    dznorm:conditionText "ضمن الشروط وتحت طائلة العقوبات المنصوص عليها في المادة 301 من قانون العقوبات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_41> ;
    dznorm:position 1 .

