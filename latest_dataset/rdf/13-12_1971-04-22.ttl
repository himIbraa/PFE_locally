<https://legal.dz/resource/order/1971-04-22/71-28#version_art_142> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رفض المعتقل الحضور أمام المحكمة ، يوجه إليه إنذار بلزوم الامتثال لأمر العدالة باسم القانون، وذلك بواسطة عون من القوة العمومية يعينه الرئيس لهذا الغرض . ويضع هذا العون محضرا بتبليغ الإنذار وتلاوة هذه المادة وجواب المتهم ، وإذا أبى هذا الأخير الإذعان للإنذار ، أمر الرئيس ، بعد تلاوة المحضر في الجلسة والمثبت للرفض، باتخاذ إجراءات المرافعة رغم تخلف المتهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_142_19710422_OpEnact_593b03c887> ;
    dzdoc:replacementText "إذا رفض المعتقل الحضور أمام المحكمة ، يوجه إليه إنذار بلزوم الامتثال لأمر العدالة باسم القانون، وذلك بواسطة عون من القوة العمومية يعينه الرئيس لهذا الغرض . ويضع هذا العون محضرا بتبليغ الإنذار وتلاوة هذه المادة وجواب المتهم ، وإذا أبى هذا الأخير الإذعان للإنذار ، أمر الرئيس ، بعد تلاوة المحضر في الجلسة والمثبت للرفض، باتخاذ إجراءات المرافعة رغم تخلف المتهم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_142> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
