<https://legal.dz/resource/order/1971-04-22/71-28#version_art_55> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحال محاضر التحقيق الابتدائية أو الخاصة بالجرائم المتلبس بها والموضوعة من قبل ضباط الشرطة القضائية العسكرية بدون تمهل ومع الوثائق والمستندات المرفقة بها إلى وكيل الدولة العسكري المختص إقليميا ، كما توضع الأشياء المحجوزة تحت تصرفه، ثم ترسل نسخة من أوراق الاجراءات إلى كل من السلطات العسكرية المختصة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_55_19710422_OpEnact_17bd1e7889> ;
    dzdoc:replacementText "تحال محاضر التحقيق الابتدائية أو الخاصة بالجرائم المتلبس بها والموضوعة من قبل ضباط الشرطة القضائية العسكرية بدون تمهل ومع الوثائق والمستندات المرفقة بها إلى وكيل الدولة العسكري المختص إقليميا ، كما توضع الأشياء المحجوزة تحت تصرفه، ثم ترسل نسخة من أوراق الاجراءات إلى كل من السلطات العسكرية المختصة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_55> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_55> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1971-04-22/71-28#version_art_56> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تبين لـ وكيل الدولة العسكري بأن إجراءات التحقيق الابتدائية أو الخاصة بالجرم المتلبس به المرفوعة إليه تتعلق بجرم خارج عن اختصاص المحاكم العسكرية ، فيرسل الأوراق إلى النيابة العامة لدى المحكمة المختصة ويضع الشخص الموقوف إذا لزم الأمر، تحت تصرفه . وإذا كان الجرم تابعا للقضاء العسكري ، فيقدر وكيل الدولة العسكري إذا كان ينبغي الشروع في الملاحقات أم لا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_56_19710422_OpEnact_6146f19f9f> ;
    dzdoc:replacementText "إذا تبين لـ وكيل الدولة العسكري بأن إجراءات التحقيق الابتدائية أو الخاصة بالجرم المتلبس به المرفوعة إليه تتعلق بجرم خارج عن اختصاص المحاكم العسكرية ، فيرسل الأوراق إلى النيابة العامة لدى المحكمة المختصة ويضع الشخص الموقوف إذا لزم الأمر، تحت تصرفه . وإذا كان الجرم تابعا للقضاء العسكري ، فيقدر وكيل الدولة العسكري إذا كان ينبغي الشروع في الملاحقات أم لا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_56> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
