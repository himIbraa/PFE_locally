<https://legal.dz/resource/order/1971-04-22/71-28#version_art_203> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعتبر المعارضة في تنفيذ الحكم الغيابي، كأن لم تكن، إذا لم يحضر المعارض، رغم تكليفه بالحضور، ضمن الأوضاع والمهل المقررة، سواء إلى شخصه أو إلى محل الإقامة المعين من قبله في التصريح بالمعارضة . ولا يجوز للمحكوم عليه أن يطعن في الحكم الصادر من المحكمة إلا بطريق الطعن بالنقض في المهلة المنصوص عليها في المادة 181 ، ابتداء من تاريخ تبليغه الحكم شخصيا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_203_19710422_OpEnact_569d20ec48> ;
    dzdoc:replacementText "تعتبر المعارضة في تنفيذ الحكم الغيابي، كأن لم تكن، إذا لم يحضر المعارض، رغم تكليفه بالحضور، ضمن الأوضاع والمهل المقررة، سواء إلى شخصه أو إلى محل الإقامة المعين من قبله في التصريح بالمعارضة . ولا يجوز للمحكوم عليه أن يطعن في الحكم الصادر من المحكمة إلا بطريق الطعن بالنقض في المهلة المنصوص عليها في المادة 181 ، ابتداء من تاريخ تبليغه الحكم شخصيا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_203> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
