<https://legal.dz/resource/order/1971-04-22/71-28#version_art_51> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يبادر ضابط الشرطة القضائية العسكرية ضمن الأحوال المنصوص عليها في المادة 41 من قانون الاجراءات الجزائية بالانتقال فورا إلى مكان الجناية أو الجنحة عند إخباره بذلك أو بناء على طلب رئيس المؤسسة. فيشرع في جميع التحقيقات الضرورية وإجراءات التفتيش اللازمة والحجز والاستنطاقات والتحريات اللازمة لجمع الأدلة والكشف عن مرتكبي تلك الجرائم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_51_19710422_OpEnact_7c7daae1e8> ;
    dzdoc:replacementText "يبادر ضابط الشرطة القضائية العسكرية ضمن الأحوال المنصوص عليها في المادة 41 من قانون الاجراءات الجزائية بالانتقال فورا إلى مكان الجناية أو الجنحة عند إخباره بذلك أو بناء على طلب رئيس المؤسسة. فيشرع في جميع التحقيقات الضرورية وإجراءات التفتيش اللازمة والحجز والاستنطاقات والتحريات اللازمة لجمع الأدلة والكشف عن مرتكبي تلك الجرائم."@ar ;
