<https://legal.dz/resource/order/1971-04-22/71-28#art_155_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_155> ;
    dzdoc:position 1 ;
    dzdoc:text "فيدعو للاجتماع أعضاء المحكمة، وعند اللزوم، القضاة المساعدين الاحتياطيين ووكيل الدولة العسكري وكاتب الضبط والمترجم إذا كان له محل وكذا المدافعين."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_155_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_155> ;
    dzdoc:position 2 ;
    dzdoc:text "فيكلف المتهمين والشهود غير المستنطقين أو الذين كلفوا للبقاء تحت تصرف المحكمة ، بالمثول أمامها دون تبليغ جديد بالحضور، في اليوم والساعة المحددين. وإذا كان شاهد متغيبا، جاز للمحكمة تطبيق أحكام المادة 148."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_155_permission_0_1d5780d5> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1971-04-22/71-28#art_155_permission_0_1d5780d5_action_ccd60c1d7e> ;
    dzdoc:hasPeriod <https://legal.dz/resource/order/1971-04-22/71-28#art_155_permission_0_1d5780d5_period_bf846337e3> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_155> ;
    dznorm:position 0 ;
    dznorm:provisionText "إذا لم يمكن إنهاء المرافعات خلال نفس الجلسة، يأمر الرئيس بإرجاء النظر في الدعوى لليوم والساعة المحددين منه، ويجري مثل ذلك بالنسبة للقضايا المسجلة في الجدول والتي لم ينظر فيها في اليوم المعين."@ar ;
    dznorm:sourceArticle "art_155" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_155_permission_0_1d5780d5_action_ccd60c1d7e> a dznorm:Action ;
