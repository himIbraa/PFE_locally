<https://legal.dz/resource/order/1971-04-22/71-28#version_art_209> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تطبق في قضاء التحقيق العسكري أو قضاء الحكم ، أحكام المادة 548 وما يليها من قانون الاجراءات الجزائية المتعلقة بإحالة النظر في القضية من محكمة إلى أخرى في الأحوال الواردة بعده: لداعي الأمن العمومي أو الشبهة المشروعة، لحسن سير القضاء، بصفة استثنائية، وبناء على طلب وزير الدفاع الوطني ، عندما يتعذر إيجاد مساعدين عسكريين من الرتبة المطلوبة، لتشكيل محكمة عسكرية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_209_19710422_OpEnact_5f92b96047> ;
    dzdoc:replacementText "تطبق في قضاء التحقيق العسكري أو قضاء الحكم ، أحكام المادة 548 وما يليها من قانون الاجراءات الجزائية المتعلقة بإحالة النظر في القضية من محكمة إلى أخرى في الأحوال الواردة بعده: لداعي الأمن العمومي أو الشبهة المشروعة، لحسن سير القضاء، بصفة استثنائية، وبناء على طلب وزير الدفاع الوطني ، عندما يتعذر إيجاد مساعدين عسكريين من الرتبة المطلوبة، لتشكيل محكمة عسكرية ."@ar ;
