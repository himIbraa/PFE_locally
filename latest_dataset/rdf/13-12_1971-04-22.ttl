<https://legal.dz/resource/order/1971-04-22/71-28#art_277_obligation_1_78b48bbb> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_277> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_277_obligation_1_78b48bbb_condition_0> ;
    dznorm:position 1 ;
    dznorm:provisionText "يعاقب بالحبس من ثلاث سنوات إلى خمس سنوات، كل عسكري في خدمة الجزائر، وقع في قبضة العدو واستعاد منه حريته بشرط أن لا يحمل السلاح أبدا ضده."@ar ;
    dznorm:sourceArticle "art_277" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_277_obligation_2_772a0aad> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_277> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_277_obligation_2_772a0aad_condition_0> ;
    dznorm:position 2 ;
    dznorm:provisionText "وإذا حكم المجرم ضابطا فإنه يعاقب فوق ذلك بالعزل، ويقضى في مطلق الأحوال بحرمانه من الحقوق المدنية والوطنية والعائلية."@ar ;
    dznorm:sourceArticle "art_277" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_278_defocc_0bc4653e08c3> a dzdoc:DefinitionOccurrence ;
