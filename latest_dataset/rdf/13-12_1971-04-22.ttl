<https://legal.dz/resource/order/1971-04-22/71-28#version_art_182> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز أيضا لوكيل الدولة العسكري أن يطعن بالنقض ضد : أحكام البراءة، الأحكام القاضية بمنع المحاكمة، الأحكام الفاصلة برد الأشياء المحجوزة ضمن الشروط المنصوص عليها في المادة 169 من هذا القانون . ولا يجوز أن تمس هذه الطعون في حقوق المتهم ، إلا في الحالة الأولى، عندما يكون الحكم قد أغفل الفصل في أحد عناصر الاتهام، أو في الحالة الثانية، إذا حصل في الحكم تطبيق خاطئ في دعوى شملها انقضاء الدعوى العمومية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_182_19710422_OpEnact_9ca5c98744> ;
    dzdoc:replacementText "يجوز أيضا لوكيل الدولة العسكري أن يطعن بالنقض ضد : أحكام البراءة، الأحكام القاضية بمنع المحاكمة، الأحكام الفاصلة برد الأشياء المحجوزة ضمن الشروط المنصوص عليها في المادة 169 من هذا القانون . ولا يجوز أن تمس هذه الطعون في حقوق المتهم ، إلا في الحالة الأولى، عندما يكون الحكم قد أغفل الفصل في أحد عناصر الاتهام، أو في الحالة الثانية، إذا حصل في الحكم تطبيق خاطئ في دعوى شملها انقضاء الدعوى العمومية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_182> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
