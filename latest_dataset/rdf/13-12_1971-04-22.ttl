<https://legal.dz/resource/order/1971-04-22/71-28#art_130_condition_1_1ca7de4e> a dznorm:Condition ;
    dznorm:conditionText "إذا صدرت عدة أحكام إحالة أو تقديم مباشر للمحاكمة ، عن جرائم مختلفة ضد المتهم نفسه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_130> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_130_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_130> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا صدرت عدة أحكام إحالة أو تقديم مباشر للمحاكمة، ضد متهمين مختلفين عن الجريمة نفسها، فيجوز للرئيس إما تلقائيا أو بناء على طلب النيابة العامة أو المدافع ، أن يأمر بضمها جميعا."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_130_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_130> ;
    dzdoc:position 1 ;
    dzdoc:text "وكذلك الشأن ، إذا صدرت عدة أحكام إحالة أو تقديم مباشر للمحاكمة ، عن جرائم مختلفة ضد المتهم نفسه."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_131_condition_0_5d8cf627> a dznorm:Condition ;
    dznorm:conditionText "وفي زمن الحرب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_131> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_131_obligation_0_1fbac9d9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1971-04-22/71-28#art_131_obligation_0_1fbac9d9_role_a15a71beb7>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_131_obligation_0_1fbac9d9_role_ce92f0c00d> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_131> ;
    dznorm:position 0 ;
    dznorm:provisionText "ويقوم المتهم أو المدافع عنه باطلاع وكيل الدولة العسكري على أسماء وعناوين الشهود الذين يرى من الضروري الاستماع إليهم وذلك قبل 8 أيام على الأقل من الجلسة"@ar ;
    dznorm:sourceArticle "art_131" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_131_obligation_0_1fbac9d9_role_a15a71beb7> a dznorm:Role ;
