<https://legal.dz/resource/order/1971-04-22/71-28#version_art_265> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن المؤقت مع الأشغال، من عشر سنوات إلى عشرين سنة كل عسكري يركن إلى الفرار مع عصابة مسلحة. وإذا كان المجرم ضابطا ، يحكم عليه بالحد الأقصى من العقوبة. وإذا وقع الفرار بمؤامرة يعاقب المجرمون بالسجن المؤبد مع الأشغال. ويعاقب المجرمون بالإعدام إذا أخذوا معهم أسلحة أو ذخائر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
