<https://legal.dz/resource/order/1971-04-22/71-28#art_228_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_228> ;
    dzdoc:position 0 ;
    dzdoc:text "تتقادم العقوبات المقضى بها في الأحكام الموقف تنفيذها ضمن المهل المنصوص عليها في المواد من 612 إلى 615 من قانون الاجراءات الجزائية، وذلك ابتداء من تاريخ الإيقاف."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_condition_0_f0d7e6fc> a dznorm:Condition ;
    dznorm:conditionText "في حالة تعرض المحكوم عليه لعقوبة شديدة أو حكم جديد، قبل تحرره نهائيا من عقوبته"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_229> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_condition_1_3c27f783> a dznorm:Condition ;
    dznorm:conditionText "وبالنسبة للمحكوم عليهم الذين لم يصدر بحقهم قرار بالرجوع عن الإفراج المشروط لتاريخ تحررهم من الخدمة العسكرية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_229> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_condition_2_4bb30e73> a dznorm:Condition ;
    dznorm:conditionText "أما الذين يتعرضون لقرار الرجوع عن الإفراج المشروط بعد عودتهم إلى مساكنهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_229> ;
    dznorm:position 2 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_extref_ea36b66a> a dzdoc:ExternalReference ;
    rdfs:label "قانون الاجراءات الجزائية"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/criminal_procedure"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/code/criminal_procedure"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/criminal_procedure" ;
    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_obligation_0_cb430abc> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_229> ;
    dznorm:position 0 ;
    dznorm:provisionText "ويوضع العسكريون حين الإفراج المشروط عنهم، تحت تصرف وزير الدفاع الوطني لإكمال مدة الخدمة الملزمين بها للدولة"@ar ;
    dznorm:sourceArticle "art_229" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_obligation_1_0dd01758> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/order/1971-04-22/71-28#art_229_obligation_1_0dd01758_period_d0e529ebae> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_229> ;
    dznorm:position 1 ;
    dznorm:provisionText "فيلزمون بقضاء كامل العقوبة غير المنفذة، دون أي تخفيض من المدة التي قضوها في الخدمة العسكرية"@ar ;
    dznorm:sourceArticle "art_229" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_obligation_1_0dd01758_period_d0e529ebae> a dznorm:Period ;
    rdfs:label "لمدة التي قضوها في الخدمة العسكرية"@ar ;
    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "فيلزمون بقضاء كامل العقوبة غير المنفذة، دون أي تخفيض من المدة التي قضوها في الخدمة العسكرية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_229> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_229> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق أحكام قانون الاجراءات الجزائية المتعلقة بـالإفراج المشروط على كل شخص محكوم عليه من قبل المحاكم العسكرية، وعلى العسكريين أو المماثلين للعسكريين، المحكوم عليهم من قبل المحاكم العادية مع مراعاة الأحكام الواردة بعده."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_229> ;
    dzdoc:position 1 ;
    dzdoc:text "يعود الحق بمنح الإفراج المشروط لوزير الدفاع الوطني بناء على اقتراح رئيس المؤسسة التي يقضي فيها المعني عقوبته، وذلك بعد أخذ رأي وكيل الدولة العسكري وقائد الناحية العسكرية."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_229> ;
    dzdoc:position 2 ;
    dzdoc:text "ويوضع العسكريون حين الإفراج المشروط عنهم، تحت تصرف وزير الدفاع الوطني لإكمال مدة الخدمة الملزمين بها للدولة، ويلحقون بوحدة يختارها لهذا الغرض ويخضعون بصفة كلية للسلطة العسكرية."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_229> ;
    dzdoc:position 3 ;
    dzdoc:text "ويمكن أن يقرر وزير الدفاع الوطني الرجوع عن الإفراج المشروط بناء على اقتراح قائد الناحية العسكرية في حالة تعرض المحكوم عليه لعقوبة شديدة أو حكم جديد، قبل تحرره نهائيا من عقوبته."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_229> ;
    dzdoc:position 4 ;
    dzdoc:text "فيرسل المحكوم عليه عندئذ إلى السجن لإكمال جميع مدة العقوبة الأولى غير المنفذة حين الإفراج، مع العقوبة الصادرة بحقه إذا اقتضى الأمر ، وتخفض مدة الخدمة العسكرية التي أداها المحكوم عليه في القطعة قبل العزل من مدة الخدمة العسكرية الباقية عليه."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_229> ;
    dzdoc:position 5 ;
    dzdoc:text "وبالنسبة للمحكوم عليهم الذين لم يصدر بحقهم قرار بالرجوع عن الإفراج المشروط لتاريخ تحررهم من الخدمة العسكرية، فإن المدة التي قضوها في الخدمة العسكرية تحتسب ضمن مدة العقوبة الصادرة بحقهم."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_para_6> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_229> ;
    dzdoc:position 6 ;
    dzdoc:text "ويجري مثل ذلك بالنسبة للذين أكملوا خدمتهم العسكرية دون أن يتحرروا من كامل عقوبتهم، ولم يتعرضوا لقرار الرجوع عن الإفراج المشروط بعد التحاقهم بمساكنهم."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_para_7> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_229> ;
    dzdoc:position 7 ;
    dzdoc:text "أما الذين يتعرضون لقرار الرجوع عن الإفراج المشروط بعد عودتهم إلى مساكنهم، فيلزمون بقضاء كامل العقوبة غير المنفذة، دون أي تخفيض من المدة التي قضوها في الخدمة العسكرية."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_229_right_0_6b05bf19> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
