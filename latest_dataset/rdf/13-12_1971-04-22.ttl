<https://legal.dz/resource/order/1971-04-22/71-28#version_art_286> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن المؤبد مع الأشغال العسكريون أو الأفراد المنتقلون الذين يؤلفون عصابة ويرتكبون جريمة النهب أو إتلاف المواد الغذائية والبضائع أو الأشياء، سواء حصل ذلك بالسلاح أم باستعمال القوة الظاهرة أم بواسطة كسر الأبواب والحواجز الخارجية، أم باستعمال العنف على الأشخاص . ويعاقبون في جميع الأحوال الأخرى بالسجن المؤقت مع الشغل من خمس سنوات إلى عشر سنوات من أعمال النهب والإتلاف الواقعة منهم وهم يؤلفون عصابة. و مع ذلك إذا وجد بين المجرمين في الأحوال الواردة في الفقرة الأولى من هذه المادة ، محرض أو عدة م"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_286_19710422_OpEnact_768a40f79c> ;
    dzdoc:replacementText "يعاقب بالسجن المؤبد مع الأشغال العسكريون أو الأفراد المنتقلون الذين يؤلفون عصابة ويرتكبون جريمة النهب أو إتلاف المواد الغذائية والبضائع أو الأشياء، سواء حصل ذلك بالسلاح أم باستعمال القوة الظاهرة أم بواسطة كسر الأبواب والحواجز الخارجية، أم باستعمال العنف على الأشخاص . ويعاقبون في جميع الأحوال الأخرى بالسجن المؤقت مع الشغل من خمس سنوات إلى عشر سنوات من أعمال النهب والإتلاف الواقعة منهم وهم يؤلفون عصابة. و مع ذلك إذا وجد بين المجرمين في الأحوال الواردة في الفقرة الأولى من هذه المادة ، محرض أو عدة محرضين أو واحد أو أكثر من العسكريين ذوي الرتب ، فلا يقضي بالسجن المؤبد مع الشغل إلا على المحرضين والعسكريين الأعلى رتبة. أما بقية المجرمين فيحكم عليهم بالسجن المؤقت من عشر سنوات إلى عشرين سنة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_286> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_286> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
