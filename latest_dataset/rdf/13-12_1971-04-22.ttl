    dzdoc:sourceTextSpan "إلا في الأحوال التي ينص القانون على خلاف ذلك"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_41> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_41_condition_1_11d957e2> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1971-04-22/71-28#art_41_condition_1_11d957e2_ref_2de66e19b738> ;
