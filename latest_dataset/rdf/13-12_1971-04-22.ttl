<https://legal.dz/resource/order/1971-04-22/71-28#version_art_146> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوعز الرئيس لكاتب الضبط بتلاوة أمر التكليف بالحضور وقائمة الشهود الذين يجب الاستماع إليهم ، إما بناء على طلب النيابة العامة وإما بناء على طلب المتهم. ولا يمكن أن تتضمن هذه القائمة إلا الشهود المبلغ اسمهم من قبل وكيل الدولة العسكري للمتهم ومن هذا الأخير للنيابة العامة طبقا لاحدى المادتين 192 أو 193 ، دون الإخلال ب الحق الممنوح للرئيس بموجب المادة 152 . ويجوز بالتالي لوكيل الدولة العسكري والمتهم، أن يعارضا في الاستماع لشاهد لم يبلغ اسمه لهما، أو لم يعين بوضوح في التبليغ . وتبت المحكمة حالا في هذه "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_146_19710422_OpEnact_526ef4f113> ;
    dzdoc:replacementText "يوعز الرئيس لكاتب الضبط بتلاوة أمر التكليف بالحضور وقائمة الشهود الذين يجب الاستماع إليهم ، إما بناء على طلب النيابة العامة وإما بناء على طلب المتهم. ولا يمكن أن تتضمن هذه القائمة إلا الشهود المبلغ اسمهم من قبل وكيل الدولة العسكري للمتهم ومن هذا الأخير للنيابة العامة طبقا لاحدى المادتين 192 أو 193 ، دون الإخلال ب الحق الممنوح للرئيس بموجب المادة 152 . ويجوز بالتالي لوكيل الدولة العسكري والمتهم، أن يعارضا في الاستماع لشاهد لم يبلغ اسمه لهما، أو لم يعين بوضوح في التبليغ . وتبت المحكمة حالا في هذه المعارضة . ويأمر الرئيس الشهود بالانسحاب للغرفة المخصصة لهم، ولا يخرجون منها إلا للإدلاء بالشهادة . ويتخذ الرئيس عند الضرورة كل الاجراءات اللازمة لمنع الشهود من التحدث فيما بينهم قبل أداء الشهادة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_146> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_146> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1971-04-22/71-28#version_art_147> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يأمر الرئيس كاتب الضبط بتلاوة الحكم بإحالة المتهم إلى المحكمة أو تقديمه مباشرة أمامها، والأوراق التي يرى من الضروري إطلاع المحكمة عليها . ويذكر المتهم بالجريمة التي يلاحق من أجلها وينبهه بأن القانون يبيح له كل ما هو لازم للدفاع عن نفسه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_147_19710422_OpEnact_a5d41add26> ;
    dzdoc:replacementText "يأمر الرئيس كاتب الضبط بتلاوة الحكم بإحالة المتهم إلى المحكمة أو تقديمه مباشرة أمامها، والأوراق التي يرى من الضروري إطلاع المحكمة عليها . ويذكر المتهم بالجريمة التي يلاحق من أجلها وينبهه بأن القانون يبيح له كل ما هو لازم للدفاع عن نفسه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_147> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
