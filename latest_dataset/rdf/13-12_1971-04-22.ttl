<https://legal.dz/resource/order/1971-04-22/71-28#art_174_obligation_2_a5440a82_ref_a72a1d2fe33f> a dzdoc:Reference ;
    rdfs:label "المادة 232"@ar ;
    dzdoc:frbrUri "#art_232"^^xsd:anyURI ;
