<https://legal.dz/resource/order/1971-04-22/71-28#version_art_326> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان عدم إكمال المهمة ناجما عن الإهمال أو تراخى المجرم لمباغتة العدو أو انفصل بإهماله عن قائده أمام العدو أو كان سببا في انتزاع العدو للسفينة البحرية أو الطائرة السكرية الموضوعة تحت أمرته أو التي ينتقل عليها ، فيعاقب بالسجن من ستة أشهر إلى ثلاث سنوات، وإذا كان المجرم ضابطا فيعاقب فوق ذلك بالعزل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_326_19710422_OpEnact_fb5edc0609> ;
    dzdoc:replacementText "إذا كان عدم إكمال المهمة ناجما عن الإهمال أو تراخى المجرم لمباغتة العدو أو انفصل بإهماله عن قائده أمام العدو أو كان سببا في انتزاع العدو للسفينة البحرية أو الطائرة السكرية الموضوعة تحت أمرته أو التي ينتقل عليها ، فيعاقب بالسجن من ستة أشهر إلى ثلاث سنوات، وإذا كان المجرم ضابطا فيعاقب فوق ذلك بالعزل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_326> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
