<https://legal.dz/resource/order/1971-04-22/71-28#version_art_45> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتبر ضباطا للشرطة القضائية العسكرية : 1 - كل العسكريين التابعين للدرك الوطني والحائزين لصفة ضباط الشرطة القضائية، حسب التعريف الوارد في قانون الاجراءات الجزائية ، 2 - كل ضباط للقطع العسكرية أو المصلحة والمعينين خصيصا لهذا الغرض، بموجب قرار وزير الدفاع الوطني . إن ضباط الشرطة القضائية العسكرية يتبعون سلميا ومباشرة سلطة وكيل الدولة العسكري ، الذي يكون بدوره خاضعا لسلطة وزير الدفاع الوطني . مع مراعاة عدم التعارض مع أحكام هذا القانون ، فإن ضباط الشرطة القضائية العسكرية يتصرفون طبقا لأحكام قانون الا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_45_19710422_OpEnact_64eb42c50e> ;
    dzdoc:replacementText "يعتبر ضباطا للشرطة القضائية العسكرية : 1 - كل العسكريين التابعين للدرك الوطني والحائزين لصفة ضباط الشرطة القضائية، حسب التعريف الوارد في قانون الاجراءات الجزائية ، 2 - كل ضباط للقطع العسكرية أو المصلحة والمعينين خصيصا لهذا الغرض، بموجب قرار وزير الدفاع الوطني . إن ضباط الشرطة القضائية العسكرية يتبعون سلميا ومباشرة سلطة وكيل الدولة العسكري ، الذي يكون بدوره خاضعا لسلطة وزير الدفاع الوطني . مع مراعاة عدم التعارض مع أحكام هذا القانون ، فإن ضباط الشرطة القضائية العسكرية يتصرفون طبقا لأحكام قانون الاجراءات الجزائية . بيد أن المهل الخاصة بالوضع تحت المراقبة لضرورات التحقيق الابتدائي ترفع إلى 3 أيام. ويجوز مد هذه المهلة 48 ساعة . بموجب مقرر من وكيل الدولة العسكري . وتضاعف هذه المهل عندما يتعلق الأمر بالاعتداء على أمن الدولة . وعندما يقومون بأعمال التفتيش الخاصة بالجنايات أو الجرائم المتلبس بها خارج مؤسسة عسكرية ، فيتعين عليهم إخبار وكيل الدولة لدى المحكمة المدنية المختصة التي يمكنها أن تحضر عملياتهم أو توفد من يمثلها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_45> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_45> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1971-04-22/71-28#version_art_46> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتمتع العسكريون التابعون للدرك، لأجل ممارسة أعمال الشرطة القضائية العسكرية، سواء كانوا حائزين لصفة ضباط الشرطة القضائية أم لا، بالسلطات المخصصة في قانون الاجراءات الجزائية لضباط الشرطة القضائية أو أعوان الشرطة القضائية المذكورين في المادة 19 من القانون المذكور . إن العسكريين غير المحلفين والذين يدعون للخدمة في الدرك، يعاونون ضباط الشرطة القضائية العسكرية الموضوعين تحت أمرتهم ويطلعونهم على الجرائم التي يقفون عليها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_46_19710422_OpEnact_d56402a1c0> ;
    dzdoc:replacementText "يتمتع العسكريون التابعون للدرك، لأجل ممارسة أعمال الشرطة القضائية العسكرية، سواء كانوا حائزين لصفة ضباط الشرطة القضائية أم لا، بالسلطات المخصصة في قانون الاجراءات الجزائية لضباط الشرطة القضائية أو أعوان الشرطة القضائية المذكورين في المادة 19 من القانون المذكور . إن العسكريين غير المحلفين والذين يدعون للخدمة في الدرك، يعاونون ضباط الشرطة القضائية العسكرية الموضوعين تحت أمرتهم ويطلعونهم على الجرائم التي يقفون عليها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
