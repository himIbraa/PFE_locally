<https://legal.dz/resource/order/1971-04-22/71-28#art_101_obligation_0_48a29a00_ref_8a5174f83dc9> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "للمادة 68"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-155#art_68"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-155#art_68"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-155#art_68" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:sourceEId "art_101" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يسلم أو يحال ملف التحقيق أو نسخته المعدة طبقا للمادة 68 من قانون الاجراءات الجزائية، مصحوبا برأي وكيل الدولة العسكري إلى كتابة ضبط المحكمة العسكرية التي تنظر فيه في أقرب جلسة لها"@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-155"^^xsd:anyURI ;
    dzdoc:targetEId "art_68" .

