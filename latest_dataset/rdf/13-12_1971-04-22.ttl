<https://legal.dz/resource/order/1971-04-22/71-28#version_art_85> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن إحالة قرار قاضي التحقيق العسكري الخاص بطلب استرداد الأشياء المحجوزة، إلى المحكمة العسكرية ضمن الأشكال والأوضاع المنصوص عليها في المادة 86 من قانون الاجراءات الجزائية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_85_19710422_OpEnact_cd9ede16bf> ;
    dzdoc:replacementText "يمكن إحالة قرار قاضي التحقيق العسكري الخاص بطلب استرداد الأشياء المحجوزة، إلى المحكمة العسكرية ضمن الأشكال والأوضاع المنصوص عليها في المادة 86 من قانون الاجراءات الجزائية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
