    dzdoc:targetEId "art_594" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_230_extref_ee9a00f5> a dzdoc:ExternalReference ;
    rdfs:label "المواد من 592"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/criminal_procedure#art_592"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/code/criminal_procedure#art_592"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/criminal_procedure#art_592" ;
    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" ;
    dzdoc:targetEId "art_592" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_230_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_230> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا صدر الحكم بالحبس أو الغرامة فللمحكمة العسكرية أن تقرر وقف التنفيذ ضمن الشروط الواردة في المواد من 592 إلى 594 من قانون الاجراءات الجزائية، مع مراعاة التحفظات الواردة بعده."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_231_condition_0_2d11d3a0> a dznorm:Condition ;
    dznorm:conditionText "إذا كانت العقوبة الصادرة عن الجريمة التابعة للقانون العام المذكور موقوفا تنفيذها طبقا لهذا المقتضى"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_231> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_231_obligation_0_0330a26e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_231> ;
    dznorm:position 0 ;
    dznorm:provisionText "يترتب عليه فقدان المحكوم عليه للاستفادة من وقف التنفيذ، الممنوح له سابقا عن جريمة تابعة للقانون العام"@ar ;
    dznorm:sourceArticle "art_231" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_231_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_231> ;
    dzdoc:position 0 ;
    dzdoc:text "إن الحكم الذي يصدر عن جناية أو جنحة عسكرية : يترتب عليه فقدان المحكوم عليه للاستفادة من وقف التنفيذ، الممنوح له سابقا عن جريمة تابعة للقانون العام، ولا يحول دون منح المحكوم عليه فيما بعد، وقف التنفيذ عن جريمة تابعة للقانون العام، وذلك إذا كانت العقوبة الصادرة عن الجريمة التابعة للقانون العام المذكور موقوفا تنفيذها طبقا لهذا المقتضى، فتبقى بالتالي منفعة وقف التنفيذ الممنوح حين الحكم بالعقوبة عن الجريمة العسكرية حقا مكتسبا للمحكوم عليه."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_231_right_0_09c9481c> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_231> ;
    dznorm:position 0 ;
    dznorm:provisionText "حقا مكتسبا للمحكوم عليه"@ar ;
    dznorm:sourceArticle "art_231" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_232_extref_bb772452> a dzdoc:ExternalReference ;
    rdfs:label "المادة 54"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/penal#art_54"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/code/penal#art_54"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/penal#art_54" ;
    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" ;
    dzdoc:targetEId "art_54" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_232_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_232> ;
    dzdoc:position 0 ;
    dzdoc:text "إن العقوبات الصادرة عن جناية أو جنحة عسكرية لا يمكن أن تجعل المحكوم عليه في حالة العود."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_232_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_232> ;
    dzdoc:position 1 ;
    dzdoc:text "وتطبق المحاكم العسكرية أحكام المادة 54 وما يليها من قانون العقوبات على الحكم في الجرائم التابعة للقانون العام."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_232_permission_0_ff154309> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1971-04-22/71-28#art_232_permission_0_ff154309_action_a998a83a70> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_232> ;
    dznorm:position 0 ;
    dznorm:provisionText "إن العقوبات الصادرة عن جناية أو جنحة عسكرية لا يمكن أن تجعل المحكوم عليه في حالة العود."@ar ;
    dznorm:sourceArticle "art_232" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_232_permission_0_ff154309_action_a998a83a70> a dznorm:Action ;
    rdfs:label "أن تجعل المحكوم عليه في"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "إن العقوبات الصادرة عن جناية أو جنحة عسكرية لا يمكن أن تجعل المحكوم عليه في حالة العود."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_232> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_233_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_233> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق أحكام قانون الاجراءات الجزائية المتعلقة بـ رد الاعتبار القانوني أو القضائي على الأشخاص المحكوم عليهم من قبل المحاكم العسكرية."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_233_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_233> ;
    dzdoc:position 1 ;
    dzdoc:text "وتوجه عريضة رد الاعتبار إلى وكيل الدولة العسكري، الذي يرتب لها ملفا بالإجراءات يرفعه إلى المحكمة العسكرية التابعة لمحل إقامة مقدم العريضة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_233_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_233> ;
    dzdoc:position 2 ;
    dzdoc:text "ويذكر بيان الحكم بـ رد الاعتبار على هامش الحكم بالعقوبة، من قبل كاتب ضبط المحكمة العسكرية."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_234_condition_0_1bea1233> a dznorm:Condition ;
    dznorm:conditionText "إذا التحقوا ثانية بالجيش"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_234> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_234_obligation_0_740f3efb> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_234> ;
    dznorm:position 0 ;
    dznorm:provisionText "فقدان الرتبة والأوسمة الجزائرية عن الخدمات السابقة والناجم عن الحكم في حالة رد الاعتبار ساري المفعول"@ar ;
    dznorm:sourceArticle "art_234" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_234_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_234> ;
    dzdoc:position 0 ;
    dzdoc:text "يبقى فقدان الرتبة والأوسمة الجزائرية عن الخدمات السابقة والناجم عن الحكم في حالة رد الاعتبار ساري المفعول على العسكريين أو الأشخاص المماثلين لهم، من أية رتبة كانوا ، وإنما يجوز لهم اكتساب رتب وأوسمة جديدة إذا التحقوا ثانية بالجيش."@ar .

