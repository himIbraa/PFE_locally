<https://legal.dz/resource/order/1971-04-22/71-28#version_art_168> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعود المحكمة بعد ذلك إلى قاعة الجلسة ، و إذا سبق أن أخليت القاعة ، يعاد فتح أبواب هذه الأخيرة من جديد . ثم يستحضر الرئيس المتهم ، و يتلو أمام الحرس المسلح الأجوبة المعطاة عن الأسئلة ، و ينطق بالحكم بالإدانة أو بالإعفاء من العقاب أو بالبراءة و يعين المواد القانونية وأحكام القوانين الجزائية التي جرى تطبيقها . وفي حالة البراءة أو الإعفاء من العقاب ، يفرج عن المتهم فورا ما لم يكن محبوسا لسبب آخر، ومع مراعاة التحفظات الواردة في المادة 173 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_168_19710422_OpEnact_4c7ddd48d9> ;
    dzdoc:replacementText "تعود المحكمة بعد ذلك إلى قاعة الجلسة ، و إذا سبق أن أخليت القاعة ، يعاد فتح أبواب هذه الأخيرة من جديد . ثم يستحضر الرئيس المتهم ، و يتلو أمام الحرس المسلح الأجوبة المعطاة عن الأسئلة ، و ينطق بالحكم بالإدانة أو بالإعفاء من العقاب أو بالبراءة و يعين المواد القانونية وأحكام القوانين الجزائية التي جرى تطبيقها . وفي حالة البراءة أو الإعفاء من العقاب ، يفرج عن المتهم فورا ما لم يكن محبوسا لسبب آخر، ومع مراعاة التحفظات الواردة في المادة 173 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_168> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_168> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1971-04-22/71-28#version_art_169> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يضمن الحكم إلزام المتهم بالمصاريف لصالح الدولة وينص فيه على الإكراه البدني وذلك في حالة الإدانة أو الإعفاء من العقاب . ويؤمر في الحكم علاوة على ذلك، في الأحوال المنصوص عليها بالقانون بمصادرة الأشياء المحجوزة، وبرد جميع الأشياء المحجوزة أو المقدمة في الدعوى كوثائق مؤدية للتهمة، إما لصالح الدولة أو لصالح مالكيها . وإذا لم يحكم برد الأشياء الموضوعة تحت يد القضاء، في حكم الإدانة فيمكن طلب ردها بعريضة ترفع للمحكمة العسكرية التي أصدرت الحكم . و إذا ألغيت هذه الأخيرة ، فـ لـ وزير الدفاع الوطني أن يعين "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_169_19710422_OpEnact_0425b62e27> ;
    dzdoc:replacementText "يضمن الحكم إلزام المتهم بالمصاريف لصالح الدولة وينص فيه على الإكراه البدني وذلك في حالة الإدانة أو الإعفاء من العقاب . ويؤمر في الحكم علاوة على ذلك، في الأحوال المنصوص عليها بالقانون بمصادرة الأشياء المحجوزة، وبرد جميع الأشياء المحجوزة أو المقدمة في الدعوى كوثائق مؤدية للتهمة، إما لصالح الدولة أو لصالح مالكيها . وإذا لم يحكم برد الأشياء الموضوعة تحت يد القضاء، في حكم الإدانة فيمكن طلب ردها بعريضة ترفع للمحكمة العسكرية التي أصدرت الحكم . و إذا ألغيت هذه الأخيرة ، فـ لـ وزير الدفاع الوطني أن يعين المحكمة التي يطلب إليها أن تبت في الطلب ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_169> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_169> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

