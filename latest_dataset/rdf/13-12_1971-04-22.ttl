    dzdoc:occursInParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_27_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يعتبر أيضا كعسكريين علاوة عن المماثلين للعسكريين في الأحوال المنصوص عليها في المادة 26، الجنود الشبان والمجندون قيد التوقف والمتطوعون المجددون والمعفون من الخدمة والمحالون على الاستيداع والاحتياطيون بما فيهم المماثلون للعسكريين والمدعون للخدمة أو الذين دعوا إليها ثانية منذ انضمامهم للفرز للالتحاق أو إذا التحقوا منفردين منذ وصولهم للجهة المخصصة لهم لغاية يوم صرفهم لمنازلهم، ويسري ذلك أيضا على الأشخاص المعينين بصفة عسكريين في مستشفى أو سجن أو حرس القوة العمومية، قبل تجنيدهم أو المفرزين إداريا إلى إحدى الوحدات."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_27_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_27> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر أيضا كعسكريين علاوة عن المماثلين للعسكريين في الأحوال المنصوص عليها في المادة 26، الجنود الشبان والمجندون قيد التوقف والمتطوعون المجددون والمعفون من الخدمة والمحالون على الاستيداع والاحتياطيون بما فيهم المماثلون للعسكريين والمدعون للخدمة أو الذين دعوا إليها ثانية منذ انضمامهم للفرز للالتحاق أو إذا التحقوا منفردين منذ وصولهم للجهة المخصصة لهم لغاية يوم صرفهم لمنازلهم، ويسري ذلك أيضا على الأشخاص المعينين بصفة عسكريين في مستشفى أو سجن أو حرس القوة العمومية، قبل تجنيدهم أو المفرزين إداريا إلى إحدى الوحدات."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_280_defocc_da5fce484595> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 10 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:spy ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_280> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_280_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يعد جاسوسا ويعاقب بالإعدام مع التجريد العسكري :
                
                
                كل عسكري يدخل إلى موقع حربي أو إلى مركز عسكري أو مؤسسة عسكرية أو إلى ورشة عسكرية أو إلى معسكر أو مخيم أو أماكن الجيش لكي يحصل على وثائق أو معلومات لفائدة العدو.
                
                
                كل عسكري يعطي العدو وثائق أو معلومات من شأنها أن تضر عمليات الجيش أو تمس أمن الوقائع أو المراكز أو المؤسسات العسكرية الأخرى.
                
                
                كل عسكري يخفي بنفسه أو بواسطة غيره الجواسيس أو الأعداء المرسلين للكشف، وهو على علم بذلك."""@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_280_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_280> ;
    dzdoc:position 0 ;
    dzdoc:text "يعد جاسوسا ويعاقب بالإعدام مع التجريد العسكري : كل عسكري يدخل إلى موقع حربي أو إلى مركز عسكري أو مؤسسة عسكرية أو إلى ورشة عسكرية أو إلى معسكر أو مخيم أو أماكن الجيش لكي يحصل على وثائق أو معلومات لفائدة العدو. كل عسكري يعطي العدو وثائق أو معلومات من شأنها أن تضر عمليات الجيش أو تمس أمن الوقائع أو المراكز أو المؤسسات العسكرية الأخرى. كل عسكري يخفي بنفسه أو بواسطة غيره الجواسيس أو الأعداء المرسلين للكشف، وهو على علم بذلك."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_284_defocc_58530452065a> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 66 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:conspiracy ;
