<https://legal.dz/resource/order/1971-04-22/71-28#art_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_109" ;
    dzdoc:fullText "إذا منحت المحكمة العسكرية الإفراج المؤقت معدلة بذلك أمر قاضي التحقيق العسكري ، فيجوز لهذا الأخير، إذا طرأت عناصر اتهام جديدة وخطيرة بحق المتهم وكان هذا الأخير يستطيع الهرب أو الإفلات بأسرع وقت من يد العدالة، أن يصدر أمر توقيف جديد ، و ينبغي عليه إذ ذاك أن يعرض هذا الأمر فورا على المحكمة العسكرية للبت فيه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_109> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_109_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_109_19710422_OpEnact_e4624872e7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_109_obligation_0_01749fec> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "109" ;
    dzdoc:position 108 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_109_condition_0_519e83b4> ;
    dzdoc:usesTerm dzterm:military_court,
        dzterm:military_investigating_judge .

<https://legal.dz/resource/order/1971-04-22/71-28#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "عندما ترفض المحكمة العسكرية طلبا بالإفراج المؤقت ، فلا يجوز للمتهم، قبل انقضاء مهلة شهر واحد من تاريخ هذا القرار ، أن يقدم استئنافا جديدا ضد قرار قاضي التحقيق العسكري في هذا الموضوع."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_110_permission_0_5f697518> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_110_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_110_19710422_OpEnact_0187a16fbb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "110" ;
    dzdoc:position 109 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_110_condition_0_77343c6f>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_110_condition_1_8ba76f4a> ;
    dzdoc:usesTerm dzterm:military_court,
        dzterm:military_investigating_judge .

<https://legal.dz/resource/order/1971-04-22/71-28#art_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_3> ;
    dzdoc:eId "art_114" ;
    dzdoc:fullText "إن المحكمة العسكرية المنعقدة بهيئة غرفة الاتهام تختص بحسب نوع الدعوى المحددة في هذا القانون بالاستئنافات والعرائض التي يمكن أن ترفع إليها خلال التحقيق التحضيري، وعلى كل لغاية افتتاح المرافعات أمام قضاء الحكم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_114_permission_0_392fecd8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_114> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_114_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_114_19710422_OpEnact_0e3f2cdaa4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 114" ;
    dzdoc:position 113 ;
    dzdoc:usesTerm dzterm:military_court .

<https://legal.dz/resource/order/1971-04-22/71-28#art_124> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_3> ;
    dzdoc:eId "art_124" ;
    dzdoc:fullText "إذا رأت المحكمة العسكرية المنعقدة بهيئة غرفة الاتهام، أن الوقائع لا تكون جناية أو جنحة أو مخالفة، أو كان مرتكب الجريمة لا يزال مجهولا ، أو لا تتوفر دلائل كافية ضد المتهم ، فتصرح بعدم وجوب الملاحقة. ويفرج عن المتهمين المعتقلين احتياطيا وتفصل المحكمة في رد الأشياء المحجوزة. وتبقى هذه المحكمة مختصة بالفصل في هذا الرد بعد صدور حكمها بمنع المحاكمة. أما إذا ألغيت المحكمة فلوزير الدفاع الوطني أن يعين المحكمة التي تكلف بالفصل في هذا الرد."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_124_right_0_102cc16e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_124> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_124_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_124_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_124_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_124_19710422_OpEnact_1c8b6791cb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "124" ;
    dzdoc:position 123 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_124_condition_0_369f8cf2> ;
    dzdoc:usesTerm dzterm:military_court .

<https://legal.dz/resource/order/1971-04-22/71-28#art_141> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_3> ;
    dzdoc:eId "art_141" ;
    dzdoc:fullText "ينبغي للمتهم المبلغ شخصيا عن مخالفة، أن يحضر أمام المحكمة ، فإذا لم يحضر ولم يقدم عذرا صحيحا تقبل به المحكمة التي دعته للحضور ، فيحكم عليه بحكم يعتبر بمثابة حضوري."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_141> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_141_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_141_19710422_OpEnact_51c4e2a8e9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_141_obligation_0_b888de1c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 141" ;
    dzdoc:position 140 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_141_condition_0_4c2db606> ;
    dzdoc:usesTerm dzterm:accused .

<https://legal.dz/resource/order/1971-04-22/71-28#art_154> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_7> ;
    dzdoc:eId "art_154" ;
    dzdoc:fullText "يشرع الرئيس في استنطاق المتهم ويتلقى شهادات الشهود . ومتى انتهى التحقيق في الجلسة سمعت طلبات وكيل الدولة العسكري ودفاع المتهم والمدافع عنه. ل وكيل الدولة العسكري أن يرد على أوجه الدفاع إذا رأى ذلك ضروريا، إنما تبقى الكلمة الأخيرة دائما ل لمتهم والمدافع عنه. ويسأل الرئيس المتهم إذا لم يبق لديه ما يزيده لدفاعه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_154> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_154_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_154_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_154_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_154_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_154_19710422_OpEnact_594e971a43> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_154_obligation_0_d44f97a4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 154" ;
    dzdoc:position 153 ;
    dzdoc:usesTerm dzterm:accused,
        dzterm:military_prosecutor,
        dzterm:president,
        dzterm:witnesses .

<https://legal.dz/resource/order/1971-04-22/71-28#art_158> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_8> ;
    dzdoc:eId "art_158" ;
    dzdoc:fullText "يقرر الرئيس إقفال باب المرافعات . ويتلو الأسئلة التي ينبغي على المحكمة أن تجيب عليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_158> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_158_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_158_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_158_19710422_OpEnact_00776a338a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_158_obligation_0_a58cb50e>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_158_obligation_1_b008c7b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "158" ;
    dzdoc:position 157 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/order/1971-04-22/71-28#art_161> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_8> ;
    dzdoc:eId "art_161" ;
    dzdoc:fullText "إذا تبين من خلال المرافعات وجود ظرف أو ظروف مشددة غير مذكورة في حكم الإحالة ، جاز للرئيس أن يطرح سؤالا واحدا أو عدة أسئلة خاصة ضمن الشروط المنصوص عليها في المادة 160 ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_161_right_0_e96579ab> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_161> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_161_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_161_19710422_OpEnact_333b3e0a00> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "161" ;
    dzdoc:position 160 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_160> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_160> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_161_condition_0_7f35d158>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_161_condition_1_82cbc135> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/order/1971-04-22/71-28#art_167> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_167" ;
    dzdoc:fullText "يحكم بالعقوبة الأشد في حالة ارتكاب عدة جنايات أو جنح. وإذا كانت العقوبة الأصلية موضوع عفو ، فينبغي لتطبيق تعدد العقوبات، مراعاة العقوبة الناجمة عن التخفيف وليس العقوبة المقررة أوليا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_167> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_167_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_167_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_167_19710422_OpEnact_cbae7f670e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_167_obligation_0_6b3c0cc6>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_167_obligation_1_dd91c9bd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "167" ;
    dzdoc:position 166 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_167_condition_0_70a1b88a> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_171> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_3_subsec_2> ;
    dzdoc:eId "art_171" ;
    dzdoc:fullText "إذا اعتبر المتهم مذنبا تضمن الحكم الإدانة والنص على العقوبة الأصلية، ثم على العقوبات التبعية والتكميلية إذا لزم الأمر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_171> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_171_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_171_19710422_OpEnact_3e0ad6a773> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_171_obligation_0_f4a7e93f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 171" ;
    dzdoc:position 170 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_171_condition_0_fd8ed93a> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_172> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_3_subsec_2> ;
    dzdoc:eId "art_172" ;
    dzdoc:fullText "إذا قضي بحبس المتهم المفرج عنه مؤقتا دون توقيف التنفيذ، أو بعقوبة أشد ، جاز للمحكمة أن تصدر بحقه أمر إيداع في السجن ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_172_right_0_6374fbed> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_172> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_172_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_172_19710422_OpEnact_bd4080d10b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 172" ;
    dzdoc:position 171 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_172_condition_0_7dd65b87> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_176> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_3_subsec_3> ;
    dzdoc:eId "art_176" ;
    dzdoc:fullText "الحكم في الموضوع لا يسبب بتاتا. وهو يتضمن قرارات مسببة صادرة لجهة الدفاع المتعلقة بعدم الاختصاص والطلبات العارضة. ويشتمل، تحت طائلة البطلان على ما يلي: 1 - اسم المحكمة التي أصدرت الحكم، 2 - تاريخ إصدار الحكم، 3 - أسماء القضاة وصفاتهم، وأسماء ورتب أو درجة القضاة المساعدين، ثم أسماء القضاة الاحتياطيين، إن وجدوا، 4 - اسم ولقب المتهم وعمره ونسبه ومهنته، وموطنه، 5 - الجنايات والجنح أو المخالفات التي أحيل المتهم لأجلها أمام المحكمة العسكرية، 6 - اسم المدافع عنه، 7 - أداء اليمين من قبل الشهود والخبراء، وعند اللزوم، دواعي عدم أدائها من أحدهم، 8 - الإشارة إلى مذكرات الدفاع وطلبات وكيل الدولة العسكري، 9 - الأسئلة المطروحة والأحكام الصادرة طبقا للمادتين 165 و 166 من هذا القانون، 10 - منح أو رفض الظروف المخففة، بأغلبية الأصوات، 11 - العقوبات المحكوم بها، مع بيان ما إذا كانت صادرة بأغلبية الأصوات، وعند اللزوم التدابير الأخرى المقررة من المحكمة، 12 - المواد القانونية المطبقة، دون حاجة لإيراد نصها، 13 - إيقاف تنفيذ العقوبة إذ أمرت به المحكمة بأغلبية الأصوات وبأن المحكوم عليه يستفيد من أحكام المادة 230 وما يليها، 14 - علنية الجلسات أو القرار القاضي بسريتها، 15 - تلاوة الحكم علنا من قبل الرئيس. ولا تذكر في الحكم أجوبة المتهم ولا شهادات الشهود."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_176> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_176_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_176_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_176_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_176_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_176_19710422_OpEnact_5bd0c8a017> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "176" ;
    dzdoc:position 175 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_165>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_166>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_230> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_165>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_166>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_230> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_176_condition_0_ba330737> ;
    dzdoc:usesTerm dzterm:judgment .

<https://legal.dz/resource/order/1971-04-22/71-28#art_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_1_chp_1_subsec_2> ;
    dzdoc:eId "art_20" ;
    dzdoc:fullText "يحدد مقر المحاكم المقرر إحداثها بموجب مرسوم يصدر بناء على تقرير وزير الدفاع الوطني . إن القضاة الملحقين بـ المحاكم العسكرية الدائمة في وظائف تابعة للنيابة والتحقيق، والذين يدعون للقضاء في المحاكم المنشأة حديثا تطبيقا للفقرة السابقة، يعتبرون مجندين ضمن الشروط المنصوص عليها في القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_20> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_20_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_20_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_20_19710422_OpEnact_e0e238dd3c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_20_obligation_0_b336e012>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_20_obligation_1_e559c14c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "20" ;
    dzdoc:position 19 ;
    dzdoc:usesTerm dzterm:judges,
        dzterm:military_courts,
        dzterm:minister_defense .

<https://legal.dz/resource/order/1971-04-22/71-28#art_203> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_1_subsec_3> ;
    dzdoc:eId "art_203" ;
    dzdoc:fullText "تعتبر المعارضة في تنفيذ الحكم الغيابي، كأن لم تكن، إذا لم يحضر المعارض، رغم تكليفه بالحضور، ضمن الأوضاع والمهل المقررة، سواء إلى شخصه أو إلى محل الإقامة المعين من قبله في التصريح بالمعارضة . ولا يجوز للمحكوم عليه أن يطعن في الحكم الصادر من المحكمة إلا بطريق الطعن بالنقض في المهلة المنصوص عليها في المادة 181 ، ابتداء من تاريخ تبليغه الحكم شخصيا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_203_permission_0_55c06fa0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_203> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_203_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_203_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_203_19710422_OpEnact_569d20ec48> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 203" ;
    dzdoc:position 202 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_181> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_181> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_203_condition_0_3a1051d0> ;
    dzdoc:usesTerm dzterm:cassation_appeal,
        dzterm:opposition .

<https://legal.dz/resource/order/1971-04-22/71-28#art_221> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_6> ;
    dzdoc:eId "art_221" ;
    dzdoc:fullText "يخبر وزير الدفاع الوطني و وزير العدل عن كل حكم بالإعدام صادر نهائيا من محكمة عسكرية . ينفذ الحكم بالإعدام على المحكوم عليهم من المحاكم العسكرية رميا بالرصاص في المكان المعين من السلطة العسكرية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_221> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_221_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_221_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_221_19710422_OpEnact_87beda7c67> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_221_obligation_0_1feb3034>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_221_obligation_1_a926ceb2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "221" ;
    dzdoc:position 220 ;
    dzdoc:usesTerm dzterm:minister_defense,
        dzterm:minister_justice .

<https://legal.dz/resource/order/1971-04-22/71-28#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_1_chp_1_subsec_2> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "يمكن أن تطبق أحكام هذا القسم في حالة النفير العام ، بموجب مرسوم صادر عن مجلس الوزراء، وذلك بناء على تقرير وزير الدفاع الوطني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_23_permission_0_c86a9b1a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_23_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_23_19710422_OpEnact_1370584d47> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "23" ;
    dzdoc:position 22 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_23_condition_0_9a50cd34> ;
    dzdoc:usesTerm dzterm:minister_defense .

<https://legal.dz/resource/order/1971-04-22/71-28#art_263> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_1_subsec_2> ;
    dzdoc:eId "art_263" ;
    dzdoc:fullText "يعاقب بالحبس من خمس سنوات إلى عشر سنوات كل عسكري فر إلى الخارج في أحد الظروف التالية: إذا أخذ المجرم معه سلاحا أو عتادا عائدا للدولة ، إذا فر أثناء قيامه بالخدمة ، إذا فر بطريقة التآمر ، وإذا كان المجرم ضابطا ، عوقب بالسجن مع الأشغال."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_263> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_263_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_263_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_263_19710422_OpEnact_5338e910f8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 263" ;
    dzdoc:position 262 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_263_condition_0_cb87a946>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_263_condition_1_a99c756d>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_263_condition_2_1e07afcf> ;
    dzdoc:usesTerm dzterm:officer,
        dzterm:soldier .

<https://legal.dz/resource/order/1971-04-22/71-28#art_264> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_1_subsec_2> ;
    dzdoc:eId "art_264" ;
    dzdoc:fullText "إذا تم الفرار إلى خارج البلاد في زمن الحرب أو إلى أراض أعلنت فيها حالة الحكم العرفي أو حالة الطوارئ فتكون العقوبة السجن المؤقت مع الأشغال من عشر سنوات إلى عشرين سنة. وتكون العقوبة بالسجن المؤبد مع الأشغال إذا وقع الفرار إلى خارج البلاد مع التآمر زمن الحرب . إذا كان المجرم بالحالة الواردة في الفقرة السابقة ضابطا يحكم عليه بالحد الأقصى من العقوبة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_264> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_264_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_264_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_264_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_264_19710422_OpEnact_9cf8de2f42> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 264" ;
    dzdoc:position 263 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_264_condition_0_5edf9ce3>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_264_condition_1_91879788> ;
    dzdoc:usesTerm dzterm:officer .

<https://legal.dz/resource/order/1971-04-22/71-28#art_277> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_277" ;
    dzdoc:fullText "يعاقب بالإعدام مع التجريد العسكري ، كل عسكري في خدمة الجزائر ويحمل السلاح ضد الجزائر. يعاقب بالحبس من ثلاث سنوات إلى خمس سنوات، كل عسكري في خدمة الجزائر، وقع في قبضة العدو واستعاد منه حريته بشرط أن لا يحمل السلاح أبدا ضده . وإذا حكم المجرم ضابطا فإنه يعاقب فوق ذلك بالعزل، ويقضى في مطلق الأحوال بحرمانه من الحقوق المدنية والوطنية والعائلية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_277> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_277_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_277_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_277_19710422_OpEnact_a2b6e8250c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_277_obligation_0_2fad7e1f>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_277_obligation_1_78b48bbb>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_277_obligation_2_772a0aad> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "277" ;
    dzdoc:position 276 ;
    dzdoc:usesTerm dzterm:military_degradation,
        dzterm:soldier .

<https://legal.dz/resource/order/1971-04-22/71-28#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "يحاكم أيضا أمام المحاكم العسكرية الدائمة : الأشخاص المعتبرون موجودين بأية صفة كانت، ضمن جدول ملاحي سفينة بحرية أو طائرة عسكرية، الأشخاص المقيدون في جدول الخدمة والقائمون بها، دون أن يكونوا مرتبطين قانونيا أو تعاقديا بالجيش، الأشخاص المطرودون من الجيش والمعتبرون تابعين لأحد الأوضاع الخاصة بالعسكريين المشار إليهم في المادتين 26 و 27 ، أفراد ملاحي القيادة، أسرى الحرب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_28_19710422_OpEnact_90b6c25ffe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 28" ;
    dzdoc:position 27 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_26>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_27> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_26>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_27> ;
    dzdoc:usesTerm dzterm:military_courts .

<https://legal.dz/resource/order/1971-04-22/71-28#art_282> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_282" ;
    dzdoc:fullText "يجوز للمحكمة العسكرية، في جميع الأحوال التي تقضى فيها بعقوبة الخيانة أو التجسس، أن تأمر بمصادرة أموال المحكوم عليه وفقا للكيفيات المنصوص عليها في المادة 205 وما يليها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_282_permission_0_2fd01aa6> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_282_right_0_2fd01aa6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_282> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_282_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_282_19710422_OpEnact_19fc05595a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "282" ;
    dzdoc:position 281 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_205> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_205> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_285> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_285" ;
    dzdoc:fullText "يعاقب بالسجن المؤقت مع الأشغال من عشر سنوات إلى عشرين سنة، كل عسكري أو أي شخص منتقل يستولي على القيادة بدون أمر أو سبب مشروع أو يحتفظ بها خلافا لأمر رؤسائه. وإذا كان المجرم ضابطا يحكم عليه فوق ذلك بعقوبة العزل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_285> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_285_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_285_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_285_19710422_OpEnact_4ebae05390> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_285_obligation_0_1eacabee> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 285" ;
    dzdoc:position 284 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_285_condition_0_9fe340f7> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_288> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_288" ;
    dzdoc:fullText "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات، كل عسكري أو ملاح في سفينة بحرية عسكرية أو في سفينة تجارية محروسة، أو كل شخص راكب فيها اعتبر مرتكبا ، بتهاونه جريمة التسبب في هدم أو إتلاف بناء أو إنشاء أو سفينة بحرية أو طائرة أو مواد حربية أو مؤن أو أدوات أو تركيبات معدة لاستعمال الجيش أو من وسائل الدفاع الوطني، أو جعلها غير صالحة للاستعمال نهائيا أو مؤقتا . وإذا كان المجرم ضابطا، يحكم عليه بالحد الأقصى من العقوبة. يعاقب بالحبس من سنة إلى خمس سنوات، كل قائد سفينة بحرية أو طائرة عسكرية ارتكب بتهاونه جريمة التسبب في تدمير أو إتلاف سفينة بحرية أو طائرة عسكرية أو جعلها غير صالحة للاستعمال نهائيا أو مؤقتا ، إذا كان ضابطا فيعاقب بالعزل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_288> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_288_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_288_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_288_19710422_OpEnact_683e0aa8dd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_288_obligation_0_b7351020>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_288_obligation_1_1f656ab2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 288" ;
    dzdoc:position 287 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_288_condition_0_1b75bda7> ;
    dzdoc:usesTerm dzterm:military .

<https://legal.dz/resource/order/1971-04-22/71-28#art_289> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_289" ;
    dzdoc:fullText "يعاقب بالحبس من سنة إلى خمس سنوات كل عسكري أو كل شخص منتقل يرتكب عن قصد جريمة التسبب في إتلاف سلاح أو أي شئ آخر خاص بخدمة الجيش، أو في جعله غير صالح للاستعمال نهائيا أو مؤقتا، حتى ولو كان مملوكا للفاعل، وسواء كان في حيازته للخدمة أو معدا لاستعمال غيره من العسكريين لنفس الغاية . ويقضى بعقوبة السجن المؤقت مع الأشغال من عشر سنوات إلى عشرين سنة ، إذا أصبح الشئ غير صالح للخدمة المعنية في تشغيل سفينة بحرية أو طائرة عسكرية، أو إذا كان الفعل حاصلا في زمن الحرب أو أثناء حريق أو جنوح سفينة أو تصادمها أو أثناء مناورة تهم أمن السفينة البحرية أو الطائرة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_289> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_289_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_289_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_289_19710422_OpEnact_d485de7ff1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_289_obligation_0_d0bffd51>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_289_obligation_1_77f7c7a8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 289" ;
    dzdoc:position 288 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_289_condition_0_67f957b2> ;
    dzdoc:usesTerm dzterm:military .

<https://legal.dz/resource/order/1971-04-22/71-28#art_294> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_2_subsec_5> ;
    dzdoc:eId "art_294" ;
    dzdoc:fullText "يعاقب بالحبس من سنة إلى خمس سنوات : 1 - كل عسكري يغش أو يعمل على غش المواد الأساسية أو المواد الغذائية أو السائلة المعهود بها إليه أو الموضوعة تحت رقابته أو يقوم عن قصد بتوزيع أو بالعمل على توزيع تلك المواد الأساسية أو المواد الغذائية أو السائلة المغشوشة. 2 - كل عسكري يوزع قصدا أو يعمل على توزيع اللحوم الناتجة من حيوانات مصابة بأمراض معدية، أو المواد الأساسية أو المواد الغذائية أو السائلة وهي فاسدة أو نتنة. وإذا جنى الفاعل من الأعمال الموصوفة أعلاه أرباحا أو مكاسب ، تقضي المحكمة فضلا عن ذلك بمصادرتها. وإذا كان المجرم ضابطا أو برتبة ضابط ، فإنه يحكم عليه فوق ذلك بفقدان الرتبة. ويتبع للتحقيق في هذه الجرائم الإجراء المنصوص عليه في كل حالة بموجب التشريع الخاص بالغش."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_294> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_294_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_294_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_294_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_294_19710422_OpEnact_ab0059315c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 294" ;
    dzdoc:position 293 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_294_condition_0_5b83d9b3>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_294_condition_1_0831d1ac> ;
    dzdoc:usesTerm dzterm:military .

<https://legal.dz/resource/order/1971-04-22/71-28#art_295> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_2_subsec_5> ;
    dzdoc:eId "art_295" ;
    dzdoc:fullText "يعاقب بالحبس من سنة إلى خمس سنوات، كل عسكري يبيع أو يختلس أو يبدد أو يسترهن حصانا أو دابة للحمولة أو للجر أو مركبة أو أي شئ آخر مخصص للجيش، أو أسلحة أو ذخائر حربية أو أجهزة أو ألبسة أو ذخائر أو أي شئ آخر معهود إليه لأجل الخدمة . ويحكم بنفس العقوبة على كل شخص يقوم قصدا بشراء أو إخفاء تلك الأشياء، خارجا عن الحالات التي تجيز فيها الأنظمة عرضها للبيع، أو بسرقة الأسلحة والذخائر الخاصة بالدولة أو أموال الإطعام أو الراتب أو الأموال أو الأشياء الأخرى المملوكة للدولة. وإذا كان المتهم بارتكاب الأفعال المذكورة أعلاه ضابطا ، يحكم عليه فوق ذلك بفقدان الرتبة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_295> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_295_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_295_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_295_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_295_19710422_OpEnact_d99126db7c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_295_obligation_0_9542f699> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 295" ;
    dzdoc:position 294 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_295_condition_0_2e7d8074> ;
    dzdoc:usesTerm dzterm:military .

<https://legal.dz/resource/order/1971-04-22/71-28#art_297> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_2_subsec_5> ;
    dzdoc:eId "art_297" ;
    dzdoc:fullText "يقضى بالعقوبات المقررة في هذا القسم دون الإخلال بما يمكن أن يحكم على المجرم برده."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_297_permission_0_e87a0556> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_297> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_297_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_297_19710422_OpEnact_668e9414af> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 297" ;
    dzdoc:position 296 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_300> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_2_subsec_7> ;
    dzdoc:eId "art_300" ;
    dzdoc:fullText "يعاقب بالحبس من ستة أشهر إلى خمس سنوات، كل عسكري أو كل شخص منتقل يرتكب جريمة إهانة العلم أو الجيش . وإذا كان المجرم ضابطا ، فيعاقب، فضلا عن ذلك بفقدان رتبته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_300> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_300_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_300_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_300_19710422_OpEnact_bf6c6da455> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_300_obligation_0_a0efa898>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_300_obligation_1_23bd0ce4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "300" ;
    dzdoc:position 299 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_300_condition_0_9fe340f7> ;
    dzdoc:usesTerm dzterm:army,
        dzterm:flag,
        dzterm:military .

<https://legal.dz/resource/order/1971-04-22/71-28#art_328> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_4> ;
    dzdoc:eId "art_328" ;
    dzdoc:fullText "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات كل عسكري يترك مركز وظيفته أو لا ينفذ التعليمات الصادرة إليه، عندما يكون قائما بالحراسة أو المراقبة أو الخفر أو الخدمة الربعية زمن السلم . وإذا وجد العسكري نائما وهو في مركز وظيفته يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات . وتكون عقوبة الحبس في مطلق الأحوال، من خمس سنوات إلى عشر سنوات إذا كان المجرم في إحدى الحالات الواردة في الفقرة 2 من المادة 324 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_328> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_328_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_328_para_1> ;
