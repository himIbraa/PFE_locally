<https://legal.dz/resource/order/1971-04-22/71-28#version_art_258> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتبر فارا إلى خارج البلاد في زمن السلم بعد ثلاثة أيام من التحقق من غيابه ، كل عسكري يجتاز بدون إذن حدود أرض الجمهورية أو يترك وهو خارج هذه الأراضي القطعة أو المفرزة أو القاعدة أو التشكيلة التي ينتمي إليها، أو السفينة البحرية أو الطائرة المنتقل عليها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
