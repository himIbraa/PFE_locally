    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_25_extref_a134b0df> a dzdoc:ExternalReference ;
    rdfs:label "المادة 248 من قانون الاجراءات الجزائية"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/1966-06-08/66-155#art_248"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-155#art_248"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/1966-06-08/66-155#art_248" ;
    dzdoc:resolutionReason "unindexed_text_pattern" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-155"^^xsd:anyURI ;
    dzdoc:targetEId "art_248" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_25_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_25> ;
    dzdoc:position 0 ;
    dzdoc:text "تنظر المحاكم العسكرية الدائمة في المخالفات الخاصة بالنظام العسكري والمنصوص عليها في الكتاب الثالث الوارد بعده فيحال إليها كل فاعل أصلي للجريمة وكل فاعل مشترك آخر وكل شريك في الجريمة، سواء كان عسكريا أم لا."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_25_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_25> ;
    dzdoc:position 1 ;
    dzdoc:text "يحاكم كذلك أمام المحاكم العسكرية الدائمة الفاعلون الأصلين للجريمة والفاعلون المشتركون الآخرون والشركاء في أية جريمة كانت مرتكبة في الخدمة أو ضمن مؤسسات عسكرية ولدى المضيف."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_25_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_25> ;
    dzdoc:position 2 ;
    dzdoc:text "وتختص المحاكم العسكرية الدائمة خلافا لأحكام المادة 248 من قانون الاجراءات الجزائية بالفصل في الجرائم المرتكبة ضد أمن الدولة وفقا للنص الوارد في قانون العقوبات وذلك عندما تزيد عقوبة الحبس على مدة خمس سنوات. وعندما تكون الجريمة من نوع الجنحة فلا تختص المحاكم العسكرية الدائمة بها إلا إذا كان الفاعل عسكريا أو مماثلا له."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_25_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_25> ;
    dzdoc:position 3 ;
    dzdoc:text "وعلى كل، يحال الفاعل الأصلي العسكري والفاعل الآخر المشترك أو الشريك في الجريمة التي لم ينص عليها في الفقرات 1 و 2 و 3 أعلاه، أمام محاكم القمع للقانون العام."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_25_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_25> ;
    dzdoc:position 4 ;
    dzdoc:text "ويحال على المحاكم العسكرية ضمن الشروط الواردة في هذه المادة العسكريون التابعون لمختلف الرتب والأسلحة وكل شخص مماثل للعسكريين بموجب القانون."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_261_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_261> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يعتبر العسكري الذي لم تنقض على خدمته مدة ثلاثة أشهر كعسكري ،فار، في زمن السلم وفي الأحوال المشار إليها في المادتين 258 و 259، إلا بعد خمسة عشر يوما من الغياب."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_261_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_261> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي زمن الحرب، تخفض المهل المنصوص عليها في المادتين 258 و 259 وفي الفقرة السابقة، على وجه الترتيب إلى يوم واحد ويومين وخمسة أيام."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_262_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_262> ;
    dzdoc:position 0 ;
    dzdoc:text "كل عسكري مرتكب جريمة الفرار إلى الخارج في زمن السلم يعاقب بالحبس من سنتين إلى عشر سنوات."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_262_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_262> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا كان المتهم ضابطا عوقب بالسجن المؤقت مع الأشغال من خمس سنوات إلى عشر سنوات."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_263_condition_0_cb87a946> a dznorm:Condition ;
    dznorm:conditionText "إذا أخذ المجرم معه سلاحا أو عتادا عائدا للدولة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_263> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_263_condition_1_a99c756d> a dznorm:Condition ;
    dznorm:conditionText "إذا فر أثناء قيامه بالخدمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_263> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_263_condition_2_1e07afcf> a dznorm:Condition ;
    dznorm:conditionText "إذا فر بطريقة التآمر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_263> ;
    dznorm:position 2 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_263_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_263> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من خمس سنوات إلى عشر سنوات كل عسكري فر إلى الخارج في أحد الظروف التالية: إذا أخذ المجرم معه سلاحا أو عتادا عائدا للدولة، إذا فر أثناء قيامه بالخدمة، إذا فر بطريقة التآمر،"@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_263_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_263> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا كان المجرم ضابطا، عوقب بالسجن مع الأشغال."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_264_condition_0_5edf9ce3> a dznorm:Condition ;
    dznorm:conditionText "إذا تم الفرار إلى خارج البلاد في زمن الحرب أو إلى أراض أعلنت فيها حالة الحكم العرفي أو حالة الطوارئ"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_264> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_264_condition_1_91879788> a dznorm:Condition ;
    dznorm:conditionText "إذا وقع الفرار إلى خارج البلاد مع التآمر زمن الحرب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_264> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_264_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_264> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا تم الفرار إلى خارج البلاد في زمن الحرب أو إلى أراض أعلنت فيها حالة الحكم العرفي أو حالة الطوارئ فتكون العقوبة السجن المؤقت مع الأشغال من عشر سنوات إلى عشرين سنة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_264_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_264> ;
    dzdoc:position 1 ;
    dzdoc:text "وتكون العقوبة بالسجن المؤبد مع الأشغال إذا وقع الفرار إلى خارج البلاد مع التآمر زمن الحرب."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_264_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_264> ;
    dzdoc:position 2 ;
    dzdoc:text "إذا كان المجرم بالحالة الواردة في الفقرة السابقة ضابطا يحكم عليه بالحد الأقصى من العقوبة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_265_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_265> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالسجن المؤقت مع الأشغال، من عشر سنوات إلى عشرين سنة كل عسكري يركن إلى الفرار مع عصابة مسلحة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_265_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_265> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا كان المجرم ضابطا ، يحكم عليه بالحد الأقصى من العقوبة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_265_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_265> ;
    dzdoc:position 2 ;
    dzdoc:text "وإذا وقع الفرار بمؤامرة يعاقب المجرمون بالسجن المؤبد مع الأشغال."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_265_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_265> ;
    dzdoc:position 3 ;
    dzdoc:text "ويعاقب المجرمون بالإعدام إذا أخذوا معهم أسلحة أو ذخائر."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_266_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_266> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالإعدام، كل عسكري أو أحد الأفراد من غير العسكريين، يكون ملاحا في سفينة بحرية أو طائرة أو سفينة تجارية محروسة ، يرتكب جريمة الهروب إلى العدو."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_267_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_267> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالسجن المؤقت مع الأشغال من عشر سنوات إلى عشرين سنة، كل فار أمام العدو."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_267_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_267> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا كان الفار ضابطا يحكم عليه بعقوبة السجن المؤبد مع الأشغال."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_267_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_267> ;
    dzdoc:position 2 ;
    dzdoc:text "وإذا وقع الفرار أمام العدو بمؤامرة، يعاقب بالإعدام."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_268_permission_0_58e25865> a dznorm:Permission ;
