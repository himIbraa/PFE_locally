<https://legal.dz/resource/order/1971-04-22/71-28#version_art_208> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما ترفع قضية أمام قضاء عسكري و قضاء تابع للقانون العام أو أمام قضائين عسكريين في وقت واحد، وتتعلق بنفس الجرم أو بجرائم مترابطة ، يبت المجلس الأعلى ، في حالة النزاع، بطلب تنازع القضاة الذي تقدمه النيابة العامة لدى إحدى الهيئات القضائية الناظرة في القضية، طبقا ل المادة 545 وما يليها من قانون الاجراءات الجزائية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_208_19710422_OpEnact_2c01df31bf> ;
    dzdoc:replacementText "عندما ترفع قضية أمام قضاء عسكري و قضاء تابع للقانون العام أو أمام قضائين عسكريين في وقت واحد، وتتعلق بنفس الجرم أو بجرائم مترابطة ، يبت المجلس الأعلى ، في حالة النزاع، بطلب تنازع القضاة الذي تقدمه النيابة العامة لدى إحدى الهيئات القضائية الناظرة في القضية، طبقا ل المادة 545 وما يليها من قانون الاجراءات الجزائية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
