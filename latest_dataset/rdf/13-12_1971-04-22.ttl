<https://legal.dz/resource/order/1971-04-22/71-28#version_art_7> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يكون المتهم جنديا أو ضابط صف ، يتعين أن يكون واحد من القاضيين المساعدين ضابط وعندما يكون المتهم ضابطا ، يتعين أن يكون القاضيان المساعدان، ضابطين على الأقل من نفس رتبته . وتراعي في تشكيل المحكمة رتبة المتهم ومرتبته وقت حصول الوقائع المنسوبة إليه. وفي حالة تعدد المتهمين من ذوي الرتب والمراتب المختلفة ، فيراعى في ذلك الحد الأعلى للرتبة والأقدمية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_7_19710422_OpEnact_0144674c4a> ;
    dzdoc:replacementText "عندما يكون المتهم جنديا أو ضابط صف ، يتعين أن يكون واحد من القاضيين المساعدين ضابط وعندما يكون المتهم ضابطا ، يتعين أن يكون القاضيان المساعدان، ضابطين على الأقل من نفس رتبته . وتراعي في تشكيل المحكمة رتبة المتهم ومرتبته وقت حصول الوقائع المنسوبة إليه. وفي حالة تعدد المتهمين من ذوي الرتب والمراتب المختلفة ، فيراعى في ذلك الحد الأعلى للرتبة والأقدمية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
