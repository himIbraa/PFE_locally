<https://legal.dz/resource/order/1971-04-22/71-28#version_art_173> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تبين من الأوراق المقدمة أو من الشهادات المدلى بها من قبل الشهود أثناء المرافعات بأنه يجوز ملاحقة المتهم عن أفعال أخرى ، أمر الرئيس بوضع محضر بذلك . يجوز للمحكمة أن توقف النظر في الوقائع المرفوعة إليها وتؤجل القضية إلى جلسة تالية أو أن تحيل المحكوم عليه بعد إصدار الحكم ، مع الأوراق إلى السلطة المختصة للنظر في إصدار أمر جديد بالملاحقة إذا لزم الأمر، أو بالإحالة للمحكمة المختصة . وإذا صدر الحكم بالبراءة أو الإعفاء من العقاب ، فـ تأمر المحكمة بتسليم العسكري المقررة براءته أو المعفى من العقاب، بو"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_173_19710422_OpEnact_4f1079b6e8> ;
    dzdoc:replacementText "إذا تبين من الأوراق المقدمة أو من الشهادات المدلى بها من قبل الشهود أثناء المرافعات بأنه يجوز ملاحقة المتهم عن أفعال أخرى ، أمر الرئيس بوضع محضر بذلك . يجوز للمحكمة أن توقف النظر في الوقائع المرفوعة إليها وتؤجل القضية إلى جلسة تالية أو أن تحيل المحكوم عليه بعد إصدار الحكم ، مع الأوراق إلى السلطة المختصة للنظر في إصدار أمر جديد بالملاحقة إذا لزم الأمر، أو بالإحالة للمحكمة المختصة . وإذا صدر الحكم بالبراءة أو الإعفاء من العقاب ، فـ تأمر المحكمة بتسليم العسكري المقررة براءته أو المعفى من العقاب، بواسطة القوة العمومية للسلطة العسكرية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_173> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_173> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1971-04-22/71-28#version_art_174> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "بعد أن يصدر الرئيس الحكم ، ينبه على المحكوم عليه ، إذا لزم الأمر ، بأن من حقه أن يطعن في الحكم بالنقض ويذكر له مهلة الطعن . وإذا تقرر منح المحكوم عليه توقيف التنفيذ ، فـ ينبغي كذلك على الرئيس أن ينبهه إلى أنه في حالة صدور عقوبة جديدة ضمن الأوضاع المنصوص عليها في المادة 231 ، يمكن تنفيذ العقوبة الأولى دون إمكان ضمها مع الثانية ، و عند اللزوم كذلك، بأن عقوبات العود يمكن أن تطبق ضمن تحفظات المادة 232 من هذا القانون أو المادتين 445 و 465 من قانون العقوبات . ويذكر في أصل الحكم ما يشير إلى استكمال الا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_174_19710422_OpEnact_ac99a12222> ;
    dzdoc:replacementText "بعد أن يصدر الرئيس الحكم ، ينبه على المحكوم عليه ، إذا لزم الأمر ، بأن من حقه أن يطعن في الحكم بالنقض ويذكر له مهلة الطعن . وإذا تقرر منح المحكوم عليه توقيف التنفيذ ، فـ ينبغي كذلك على الرئيس أن ينبهه إلى أنه في حالة صدور عقوبة جديدة ضمن الأوضاع المنصوص عليها في المادة 231 ، يمكن تنفيذ العقوبة الأولى دون إمكان ضمها مع الثانية ، و عند اللزوم كذلك، بأن عقوبات العود يمكن أن تطبق ضمن تحفظات المادة 232 من هذا القانون أو المادتين 445 و 465 من قانون العقوبات . ويذكر في أصل الحكم ما يشير إلى استكمال الاجراءات السابقة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_174> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
