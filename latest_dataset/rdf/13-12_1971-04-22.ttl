<https://legal.dz/resource/order/1971-04-22/71-28#version_art_318> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين إلى ستة أشهر ، كل عسكري يرفض أو يهمل بدون عذر مشروع، الاشتراك في جلسات المحاكم العسكرية التي يدعى للجلوس فيها . وإذا كان المجرم ضابطا ، فيمكن أن يعاقب في حالة الرفض، بفقدان الرتبة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_318_19710422_OpEnact_bb0c5d1ada> ;
