<https://legal.dz/resource/order/1971-04-22/71-28#art_101_obligation_0_48a29a00> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1971-04-22/71-28#art_101_obligation_0_48a29a00_ref_8a5174f83dc9> ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_101_obligation_0_48a29a00_ref_8a5174f83dc9> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_101> ;
    dznorm:position 0 ;
    dznorm:provisionText "يسلم أو يحال ملف التحقيق أو نسخته المعدة طبقا للمادة 68 من قانون الاجراءات الجزائية، مصحوبا برأي وكيل الدولة العسكري إلى كتابة ضبط المحكمة العسكرية التي تنظر فيه في أقرب جلسة لها"@ar ;
    dznorm:sourceArticle "art_101" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_101_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_101> ;
    dzdoc:position 0 ;
    dzdoc:text "يسلم أو يحال ملف التحقيق أو نسخته المعدة طبقا للمادة 68 من قانون الاجراءات الجزائية، مصحوبا برأي وكيل الدولة العسكري إلى كتابة ضبط المحكمة العسكرية التي تنظر فيه في أقرب جلسة لها."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_102_condition_0_3f7b61da> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1971-04-22/71-28#art_102_condition_0_3f7b61da_role_120b5b8ba1> ;
    dznorm:conditionText "الشروط المنصوص عليها في مرسوم يصدر بناء على تقرير وزير الدفاع الوطني"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_102> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_102_condition_0_3f7b61da_role_120b5b8ba1> a dznorm:Role ;
    rdfs:label "تقرير وزير الدفاع الوطني"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "الشروط المنصوص عليها في مرسوم يصدر بناء على تقرير وزير الدفاع الوطني"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_102> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_102_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_102> ;
    dzdoc:position 0 ;
    dzdoc:text "سواء كان التدبير مقررا بموجب أمر قضائي أو حكم غيابي، فيساق الضنين أو المتهم أو المحكوم عليه إما إلى سجن التوقيف فيعتقل في جناح خاص بالعسكريين أو إلى سجن عسكري، وإذا لم يمكن، فإلى مؤسسة تعينها السلطة العسكرية ضمن الشروط المنصوص عليها في مرسوم يصدر بناء على تقرير وزير الدفاع الوطني."@ar .

