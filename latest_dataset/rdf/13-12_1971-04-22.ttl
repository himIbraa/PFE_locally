    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_201_19710422_OpEnact_bb0c01fb6f> ;
    dzdoc:replacementText "لا يجوز لأي مدافع أن يحضر للدفاع عن المتهم . ويطلع الرئيس المحكمة على الوقائع وشهادات الشهود. ويصدر الحكم في الشكل العادي ويبلغ طبقا لـ المادة 199 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_201> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_201> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1971-04-22/71-28#version_art_202> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبقى المعارضة في الحكم الغيابي خاضعة لأحكام المادة 199 . وتنظر المحكمة في المعارضة ضمن الأوضاع المنصوص عليها في المادة 199 . وإذا قبلت المعارضة انعدم بحكم القانون، مفعول الحكم، والاجراءات الحاصلة منذ حكم الإحالة أو المثول المباشر وشرع في المحاكمة من حيث الموضوع. وإذا تقرر رفض الاتهام ، أقالت المحكمة المتخلف من مصروفات الدعوى."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_202_19710422_OpEnact_254d6c6b65> ;
    dzdoc:replacementText "تبقى المعارضة في الحكم الغيابي خاضعة لأحكام المادة 199 . وتنظر المحكمة في المعارضة ضمن الأوضاع المنصوص عليها في المادة 199 . وإذا قبلت المعارضة انعدم بحكم القانون، مفعول الحكم، والاجراءات الحاصلة منذ حكم الإحالة أو المثول المباشر وشرع في المحاكمة من حيث الموضوع. وإذا تقرر رفض الاتهام ، أقالت المحكمة المتخلف من مصروفات الدعوى."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_202> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
