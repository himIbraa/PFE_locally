        <https://legal.dz/resource/order/1971-04-22/71-28#art_138> ;
    dznorm:conditionText "ترتكب جنايات أو جنح من غير ما هو منصوص عليه في المادتين 137 و 138، في مكان انعقاد الجلسات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_139> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_139_condition_0_abf296a0_ref_05946fab0fed> a dzdoc:Reference ;
    rdfs:label "137"@ar ;
    dzdoc:frbrUri "#art_137"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1971-04-22/71-28#art_137> ;
    dzdoc:sourceEId "art_139" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "ترتكب جنايات أو جنح من غير ما هو منصوص عليه في المادتين 137 و 138، في مكان انعقاد الجلسات"@ar ;
    dzdoc:targetEId "art_137" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_139_condition_0_abf296a0_ref_5cc4557852ae> a dzdoc:Reference ;
    rdfs:label "138"@ar ;
    dzdoc:frbrUri "#art_138"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1971-04-22/71-28#art_138> ;
    dzdoc:sourceEId "art_139" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "ترتكب جنايات أو جنح من غير ما هو منصوص عليه في المادتين 137 و 138، في مكان انعقاد الجلسات"@ar ;
    dzdoc:targetEId "art_138" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_139_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_139> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما ترتكب جنايات أو جنح من غير ما هو منصوص عليه في المادتين 137 و 138، في مكان انعقاد الجلسات، فإن الرئيس يحرر محضرا بالوقائع وشهادات الشهود ويحيل مرتكب الجريمة أمام السلطة المختصة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_13_condition_0_f0324d37> a dznorm:Condition ;
    dznorm:conditionText "إذا كان صهرا أو قريبا للمتهم لغاية درجة ابن عم أو ابن خال شقيق"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_13> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_13_condition_1_2a0216a1> a dznorm:Condition ;
    dznorm:conditionText "إذا كان شاكيا أو مدليا بشهادة، أو فيما يخص فقط الرئيس والقاضيين، إذا كان شارك رسميا في التحقيق"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_13> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_13_condition_2_61339f89> a dznorm:Condition ;
    dznorm:conditionText "إذا كان خصما في دعوى ضد المتهم قبل خمس سنوات من إحالة الدعوى عليه كقاض للتحقيق أو من رفع القضية أمام المحكمة التي يكون عضوا فيها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_13> ;
