<https://legal.dz/resource/order/1971-04-22/71-28#art_174_permission_0_76090b2e_role_aab4a77dbb> a dznorm:Role ;
    rdfs:label "الرئيس أن ينبهه إلى"@ar ;
    dzdoc:confidenceScore 0.66 ;
