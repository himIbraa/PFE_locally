<https://legal.dz/resource/order/1971-04-22/71-28#version_art_105> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن يطلب المتهم أو المدافع عنه من قاضي التحقيق العسكري الإفراج المؤقت ، في أية حالة تكون عليها الدعوى وضمن الالتزامات المنصوص عليها في المادة 104 . وينبغي على قاضي التحقيق العسكري أن يرسلوا فورا الملف إلى وكيل الدولة العسكري لبيان طلباته خلال خمسة أيام من إرسال الملف . كما ينبغي على قاضي التحقيق العسكري أن يبت في الطلب بأمر خاص معلل في مدة عشرة أيام على الأكثر من إرسال الملف إلى وكيل الدولة العسكري . وإذا لم يبت قاضي التحقيق في الطلب في المهلة المحددة بالفقرة 3 ، جاز لـ للمتهم أن يرفع طلبه م"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_105_19710422_OpEnact_53209a691e> ;
    dzdoc:replacementText "يمكن أن يطلب المتهم أو المدافع عنه من قاضي التحقيق العسكري الإفراج المؤقت ، في أية حالة تكون عليها الدعوى وضمن الالتزامات المنصوص عليها في المادة 104 . وينبغي على قاضي التحقيق العسكري أن يرسلوا فورا الملف إلى وكيل الدولة العسكري لبيان طلباته خلال خمسة أيام من إرسال الملف . كما ينبغي على قاضي التحقيق العسكري أن يبت في الطلب بأمر خاص معلل في مدة عشرة أيام على الأكثر من إرسال الملف إلى وكيل الدولة العسكري . وإذا لم يبت قاضي التحقيق في الطلب في المهلة المحددة بالفقرة 3 ، جاز لـ للمتهم أن يرفع طلبه مباشرة إلى المحكمة العسكرية القائمة بأعمال غرفة الاتهام ، والتي تصدر قرارها فيه، بعد الاطلاع على الطلبات الكتابية المعللة والمقدمة من وكيل الدولة العسكري ، في ظرف خمسة وأربعين يوما من تاريخ الطلب، وإلا تعين الإفراج المؤقت تلقائيا عن المتهم ، ما لم يكن قد تقرر إجراء التحقيقات المتعلقة بطلبه، كما أن لـ وكيل الدولة العسكري الحق في رفع الطلب إلى المحكمة العسكرية ضمن نفس الشروط. ولا يجوز تجديد طلب الإفراج المؤقت من المتهم أو من المدافع عنه، في جميع الأحوال، إلا بعد انقضاء شهر واحد من تاريخ رفض الطلب السابق. ولا يخضع الإفراج المؤقت على أي حال، للالتزام بتقديم كفالة أو اختيار موطن."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_105> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_105> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

