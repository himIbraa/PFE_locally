<https://legal.dz/resource/order/1971-04-22/71-28#version_art_91> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تختص المحاكم العسكرية بالتحقيق في البطلان المشار إليه في المادة 87 وكذلك ما قد ينجم عن عدم مراعاة أحكام الفقرة الأولى من المادة 95 . إذا كان أمر إحالة الدعوى إليها مشوبا بمثل ذلك البطلان فتحيل المحاكم العسكرية أوراق الدعوى إلى وكيل الدولة العسكري لتمكنه من رفعها مجددا إلى قاضي التحقيق العسكري. ويجوز للمتهم أن يتنازل عن التمسك بالبطلان المشار إليه في هذه المادة ، و ينبغي تقديم هذا التنازل إلى المحكمة التي تفصل في القضية قبل كل دفاع في الموضوع وفقا لنص المادة 150 من هذا القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_91_19710422_OpEnact_69fc1d5970> ;
    dzdoc:replacementText "تختص المحاكم العسكرية بالتحقيق في البطلان المشار إليه في المادة 87 وكذلك ما قد ينجم عن عدم مراعاة أحكام الفقرة الأولى من المادة 95 . إذا كان أمر إحالة الدعوى إليها مشوبا بمثل ذلك البطلان فتحيل المحاكم العسكرية أوراق الدعوى إلى وكيل الدولة العسكري لتمكنه من رفعها مجددا إلى قاضي التحقيق العسكري. ويجوز للمتهم أن يتنازل عن التمسك بالبطلان المشار إليه في هذه المادة ، و ينبغي تقديم هذا التنازل إلى المحكمة التي تفصل في القضية قبل كل دفاع في الموضوع وفقا لنص المادة 150 من هذا القانون ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_91> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
