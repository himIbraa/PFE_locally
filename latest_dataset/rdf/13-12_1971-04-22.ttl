<https://legal.dz/resource/order/1971-04-22/71-28#version_art_144> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحرر محضر بالمرافعات الجارية بغير حضور المتهم ، في الأحول المنصوص عليها في المادتين 142 و 143 ويتلو كاتب الضبط على المتهم عقب كل جلسة ، المحضر الموضوع عن هذه المرافعات ، ويستلم المتهم التبليغ عن نسخة طلبات وكيل الدولة العسكري وعن الأحكام الصادرة التي تعتبر حضورية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_144_19710422_OpEnact_5d0c45098f> ;
