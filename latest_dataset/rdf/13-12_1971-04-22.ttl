    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن الحق في تحريك الدعوى العمومية يعود في جميع الأحوال إلى وزير الدفاع الوطني . ويمكن أيضا ممارسة هذا الحق تحت سلطة وزير الدفاع الوطني أمام المحاكم العسكرية الدائمة من قبل وكيل الدولة العسكري ."@ar ;
    dzdoc:isAuthoritative true ;
