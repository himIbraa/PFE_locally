<https://legal.dz/resource/order/1971-04-22/71-28#version_art_306> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل تمرد يرتكبه عسكريون مسلحون أو أفراد معينون في المادة 305 وعددهم ثمانية على الأقل يعاقب عنه بالسجن المؤقت من عشر سنوات إلى عشرين سنة . وتسري نفس العقوبة مهما كان عدد الفاعلين المتمردين إذا كان اثنان منهم على الأقل يحملان الأسلحة بشكل ظاهر . ويعاقب المحرضون أو قادة التمرد والعسكري الأعلى رتبة بالسجن المؤبد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_306_19710422_OpEnact_c36482ef13> ;
    dzdoc:replacementText "كل تمرد يرتكبه عسكريون مسلحون أو أفراد معينون في المادة 305 وعددهم ثمانية على الأقل يعاقب عنه بالسجن المؤقت من عشر سنوات إلى عشرين سنة . وتسري نفس العقوبة مهما كان عدد الفاعلين المتمردين إذا كان اثنان منهم على الأقل يحملان الأسلحة بشكل ظاهر . ويعاقب المحرضون أو قادة التمرد والعسكري الأعلى رتبة بالسجن المؤبد ."@ar ;
