    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_63_extref_1bb71173>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_63_extref_53838ab8>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_63_extref_82af350e>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_63_extref_ceae4bbb> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_45> ;
