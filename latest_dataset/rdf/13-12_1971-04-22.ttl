<https://legal.dz/resource/order/1971-04-22/71-28#version_art_180> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز في كل وقت الطعن في الأحكام الصادرة عن المحاكم العسكرية أمام المجلس الأعلى ، في نطاق القضايا و الشروط المنصوص عليها في المادة 495 وما يليها من قانون الاجراءات الجزائية ، مع مراعاة التحفظات الواردة بعده."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
