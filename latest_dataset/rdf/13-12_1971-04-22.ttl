<https://legal.dz/resource/order/1971-04-22/71-28#version_art_48> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز ل وكلاء الدولة العسكريين و قضاة التحقيق العسكريين ، في حالة الجناية أو الجرم المتلبس به والمرتكب بحضورهم ، أن يباشروا إجراءات التحقيق وفقا لنص المادتين 38 و 56 من قانون الاجراءات الجزائية مع مراعاة الأحكام المنصوص عليها في المواد من 57 إلى 64 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_48_19710422_OpEnact_c74a8f944d> ;
