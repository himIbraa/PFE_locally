<https://legal.dz/resource/order/1971-04-22/71-28#version_art_92> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم قاضي التحقيق العسكري بمجرد انتهاء إجراءات التحقيق بإرسال الملف لـ وكيل الدولة العسكري ، و على هذا الأخير أن يقدم طلباته إليه خلال ثمانية أيام ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_92_19710422_OpEnact_9d569d9baa> ;
    dzdoc:replacementText "يقوم قاضي التحقيق العسكري بمجرد انتهاء إجراءات التحقيق بإرسال الملف لـ وكيل الدولة العسكري ، و على هذا الأخير أن يقدم طلباته إليه خلال ثمانية أيام ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
