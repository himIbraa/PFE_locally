<https://legal.dz/resource/order/1971-04-22/71-28#art_255_defocc_876e66847331> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 39 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:desertion_internal ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_255> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_255_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يعتبر فارا إلى داخل البلاد في زمن السلم :
                
                
                1- كل عسكري يتغيب بدون إذن عن قطعته أو مفرزته، أو عن قاعدته أو تشكيلته أو السفينة التابع لها أو المستشفى العسكري أو المدني الذي يعالج فيه، وذلك بعد ستة أيام من الغياب المحقق.
                
                
                2- كل عسكري يسافر منفردا وينقضي أجل مهمته أو عطلته أو ترخيصه، ويمتنع خلال العشرة أيام التالية لليوم المحدد لوصوله، عن الالتحاق بقطعة أو مفرزة، أو الحضور إلى قاعدته أو تشكيلته أو السفينة التابع لها.
                
                
                3- كل عسكري، يتغيب في التراب الوطني، بدون ترخيص، عندما تغادر هذا التراب، السفينة أو الطائرة العسكرية التابع لها أو المنتقل عليها، حتى لو امتثل أمام السلطات قبل انقضاء الآجال المذكورة أعلاه."""@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_255_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_255> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر فارا إلى داخل البلاد في زمن السلم : 1- كل عسكري يتغيب بدون إذن عن قطعته أو مفرزته، أو عن قاعدته أو تشكيلته أو السفينة التابع لها أو المستشفى العسكري أو المدني الذي يعالج فيه، وذلك بعد ستة أيام من الغياب المحقق. 2- كل عسكري يسافر منفردا وينقضي أجل مهمته أو عطلته أو ترخيصه، ويمتنع خلال العشرة أيام التالية لليوم المحدد لوصوله، عن الالتحاق بقطعة أو مفرزة، أو الحضور إلى قاعدته أو تشكيلته أو السفينة التابع لها. 3- كل عسكري، يتغيب في التراب الوطني، بدون ترخيص، عندما تغادر هذا التراب، السفينة أو الطائرة العسكرية التابع لها أو المنتقل عليها، حتى لو امتثل أمام السلطات قبل انقضاء الآجال المذكورة أعلاه."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_257_defocc_7a4baf20352e> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 63 ;
    dzdoc:charStart 0 ;
