<https://legal.dz/resource/order/1971-04-22/71-28#version_art_325> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب في زمن الحرب بالإعدام، كل قائد تشكيلة أو سفينة بحرية أو طائرة عسكرية، وكل عسكري أو شخص منتقل ارتكب عن قصد جريمة عدم إكمال المهمة الموكولة إليه، وذلك فيما إذا كانت هذه الأخيرة تتعلق بعمليات الحرب."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_325_19710422_OpEnact_299a979e2e> ;
