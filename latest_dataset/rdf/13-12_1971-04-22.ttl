    rdfs:label "أن يذكر في المحضر ما"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "ويجب أن يذكر في المحضر ما يلي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_196> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_196_obligation_3_f70fdec6> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_196> ;
    dznorm:position 3 ;
    dznorm:provisionText "ويوقع المحضر من قبل العون وكذلك من قبل المرسل إليهم إذ حصل تبليغهم الورقة شخصيا"@ar ;
    dznorm:sourceArticle "art_196" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_196_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_196> ;
    dzdoc:position 0 ;
    dzdoc:text "تبلغ أوراق التكليف بالحضور والأحكام القضائية ضمن الأوضاع التالية :"@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_196_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_196> ;
    dzdoc:position 1 ;
    dzdoc:text "يرسل وكيل الدولة العسكري إلى العون المكلف بالتبليغ ما يلي : نسخة الورقة لتسليمها إلى المرسل إليه، محضر في ثلاث نسخ، مخصص لإثبات تبليغ المعني أو غيابه عن محل إقامته المعين."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_196_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_196> ;
    dzdoc:position 2 ;
    dzdoc:text "ويجب أن يذكر في المحضر ما يلي : اسم ومهمة أو صفة السلطة الطالبة، اسم ووظيفة أو صفة العون المكلف بالتبليغ، اسم ولقب وعنوان الشخص الذي أرسلت إليه الورقة، تاريخ وساعة تسليم الورقة، أو عدم إمكان الاتصال بالمرسل إليه في محل الإقامة المعين."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_196_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_196> ;
    dzdoc:position 3 ;
    dzdoc:text "ويوقع المحضر من قبل العون وكذلك من قبل المرسل إليهم إذ حصل تبليغهم الورقة شخصيا، وفي حالة رفض التوقيع أو عدم إمكانية التوقيع، يذكر ذلك في المحضر، فترسل نسختان من محضر التبليغ أو إثبات الغياب إلى وكيل الدولة العسكري. وفي حالة التبليغ شخصيا، تترك نسخة واحدة للمرسل إليه."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_197_condition_0_bbf940ce> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/order/1971-04-22/71-28#art_197_condition_0_bbf940ce_action_70a2364755> ;
