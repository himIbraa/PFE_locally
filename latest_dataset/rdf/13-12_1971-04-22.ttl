    rdfs:label "المادة 131"@ar ;
    dzdoc:frbrUri "#art_131"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1971-04-22/71-28#art_131> ;
    dzdoc:sourceEId "art_193" ;
    dzdoc:sourceElementType "right" ;
    dzdoc:sourceTextSpan "إمكانية المتهم من الاستفادة كذلك من أحكام الفقرة 5 من المادة 131 بالنسبة لاستدعاء الشهود"@ar ;
    dzdoc:targetEId "art_131" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_194_condition_0_d3f2c198> a dznorm:Condition ;
    dznorm:conditionText "في زمن الحرب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_194> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_194_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_194> ;
    dzdoc:position 0 ;
    dzdoc:text "تكون المهلة الواقعة بين يوم تسليم التكليف بالحضور للمتهم واليوم المحدد لمثوله، 8 أيام كاملة على الأقل. وتخفض هذه المهلة في زمن الحرب إلى 24 ساعة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_194_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_194> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا تضاف أية مهلة خاصة بالمسافة إلى المهلتين المذكورتين."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_195_condition_0_0ba4801e> a dznorm:Condition ;
    dznorm:conditionText "في حالة عدم مراعاته للتكليف بالحضور المسلم إليه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_195> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_195_obligation_0_2cacb570> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_195> ;
    dznorm:position 0 ;
    dznorm:provisionText "سيعاقب بمقتضى القانون في حالة عدم حضوره، أو رفضه الشهادة أو الشهادة بالزور"@ar ;
    dznorm:sourceArticle "art_195" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_195_obligation_1_c174a418> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_195> ;
    dznorm:position 1 ;
    dznorm:provisionText "يصار إلى استعمال الإكراه بواسطة القوة العمومية والحكم عليه"@ar ;
    dznorm:sourceArticle "art_195" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_195_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_195> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب أن يتضمن التكليف بالحضور الخاص بالشاهد والخبير ما يلي : 1 - اسم وصفة السلطة الطالبة 2 – اسم ولقب الشاهد أو الخبير وموطنه، 3 – تاريخ وساعة ومكان الجلسة التي يجب على الشخص المبلغ حضورها مع بيان صفته كشاهد أو خبير."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_195_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_195> ;
    dzdoc:position 1 ;
    dzdoc:text "يجب أن يتضمن التكليف بحضور الشاهد فضلا عن ذلك، ما يشير إلى أنه سيعاقب بمقتضى القانون في حالة عدم حضوره، أو رفضه الشهادة أو الشهادة بالزور، وأنه في حالة عدم مراعاته للتكليف بالحضور المسلم إليه، يصار إلى استعمال الإكراه بواسطة القوة العمومية والحكم عليه."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_195_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_195> ;
    dzdoc:position 2 ;
    dzdoc:text "وتكون أوراق التكليف بالحضور مؤرخة وموقعة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_196_obligation_0_1ce68cf9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_196> ;
    dznorm:position 0 ;
    dznorm:provisionText "تبلغ أوراق التكليف بالحضور والأحكام القضائية ضمن الأوضاع التالية"@ar ;
    dznorm:sourceArticle "art_196" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_196_obligation_1_ca2270bc> a dznorm:Obligation ;
