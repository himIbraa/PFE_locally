<https://legal.dz/resource/order/1971-04-22/71-28#version_art_152> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخول الرئيس السلطة التقديرية لإدارة المرافعات والكشف عن الحقيقة . وله أن يطلب خلال المرافعات إحضار أية ورقة يراها لازمة للكشف عن الحقيقة ودعوة أي شخص يرى من الضروري الاستماع لشهادته، حتى بواسطة أوامر الإحضار. إذا طلبت النيابة العامة أو المدافع خلال المرافعات الاستماع لشهود جدد فيقرر الرئيس إذ كان من الواجب الاستماع إلى هؤلاء الشهود. ولا يؤدي الشهود المدعوون على الشكل المذكور اليمين وإنما تعتبر تصريحاتهم مجرد معلومات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_152_19710422_OpEnact_11fe1743a2> ;
    dzdoc:replacementText "يخول الرئيس السلطة التقديرية لإدارة المرافعات والكشف عن الحقيقة . وله أن يطلب خلال المرافعات إحضار أية ورقة يراها لازمة للكشف عن الحقيقة ودعوة أي شخص يرى من الضروري الاستماع لشهادته، حتى بواسطة أوامر الإحضار. إذا طلبت النيابة العامة أو المدافع خلال المرافعات الاستماع لشهود جدد فيقرر الرئيس إذ كان من الواجب الاستماع إلى هؤلاء الشهود. ولا يؤدي الشهود المدعوون على الشكل المذكور اليمين وإنما تعتبر تصريحاتهم مجرد معلومات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_152> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
