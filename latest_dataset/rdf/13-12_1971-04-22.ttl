    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_131> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_131_obligation_0_1fbac9d9_role_ce92f0c00d> a dznorm:Role ;
    rdfs:label "الأقل من الجلسة"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "ويقوم المتهم أو المدافع عنه باطلاع وكيل الدولة العسكري على أسماء وعناوين الشهود الذين يرى من الضروري الاستماع إليهم وذلك قبل 8 أيام على الأقل من الجلسة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_131> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_131_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_131> ;
    dzdoc:position 0 ;
    dzdoc:text "يسلم التكليف بالحضور إلى المتهم ضمن المهل والأوضاع المنصوص عليها في الباب الخامس من هذا الكتاب."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_131_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_131> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجري التبليغ بالحضور للشهود والخبراء الذين يقترح وكيل الدولة العسكري الاستماع إليهم، طبقا للأحكام نفسها."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_131_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_131> ;
    dzdoc:position 2 ;
    dzdoc:text "ويقوم المتهم أو المدافع عنه باطلاع وكيل الدولة العسكري على أسماء وعناوين الشهود الذين يرى من الضروري الاستماع إليهم وذلك قبل 8 أيام على الأقل من الجلسة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_131_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_131> ;
    dzdoc:position 3 ;
    dzdoc:text "ويحق للمتهم أن يستحضر مباشرة الشهود الذين تخلف وكيل الدولة العسكري عن الأمر بتكليفهم بالحضور."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_131_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_131> ;
    dzdoc:position 4 ;
    dzdoc:text "وفي زمن الحرب، يحق للمتهم أن يطلب، قصد الدفاع عن نفسه، سماع أي ،شاهد، بدون إجراء أو تكليف مسبق بالحضور، بعد أن يذكره لوكيل الدولة العسكري قبل فتح الجلسة، ومع مراعاة السلطة التقديرية الخاصة بالرئيس."@ar .

