<https://legal.dz/resource/order/1971-04-22/71-28#version_art_166> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا اعتبر المتهم مذنبا ، طرح الرئيس السؤال فيما إذا كانت هناك ظروف مخففة. ثم تتداول المحكمة في تطبيق العقوبة التي تصدر بأغلبية الأصوات. ويدعى كل قاض للإدلاء برأيه ابتداء من القاضي الأدنى رتبة، ثم يدلي الرئيس برأيه في الأخير. وفي حالة الحكم بالغرامة أو الحبس ، يجوز للمحكمة أن تقرر بأغلبية الأصوات قابلية توقيف التنفيذ ، وتتداول المحكمة كذلك بشأن العقوبات التبعية أو التكميلية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_166_19710422_OpEnact_bcc3dcc83e> ;
    dzdoc:replacementText "إذا اعتبر المتهم مذنبا ، طرح الرئيس السؤال فيما إذا كانت هناك ظروف مخففة. ثم تتداول المحكمة في تطبيق العقوبة التي تصدر بأغلبية الأصوات. ويدعى كل قاض للإدلاء برأيه ابتداء من القاضي الأدنى رتبة، ثم يدلي الرئيس برأيه في الأخير. وفي حالة الحكم بالغرامة أو الحبس ، يجوز للمحكمة أن تقرر بأغلبية الأصوات قابلية توقيف التنفيذ ، وتتداول المحكمة كذلك بشأن العقوبات التبعية أو التكميلية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
