<https://legal.dz/resource/order/1971-04-22/71-28#version_art_40> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يكون المرؤوس ملاحقا كفاعل أصلي لإحدى الجرائم المنصوص عليها في المادة 39 ، وتعذر البحث عن رؤسائه السلميين كفاعلين آخرين متسببين ، فيعتبر هؤلاء الأخيرون كمشتركين في الجريمة إذا هم قاموا أو تساهلوا في أعمال مرؤوسهم الجنائية. أما في زمن السلم، وفي حالة إعلان الحكم العرفي أو حالة الطوارئ، فيمتد اختصاص المحاكم العسكرية الدائمة على جميع أنواع الجرائم المرتكبة من المتقاضين المبينين في المواد 26 و 27 و 28 مع مراعاة أحكام الفقرة 3 من المادة 25 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_40_19710422_OpEnact_88a02fa49f> ;
    dzdoc:replacementText "عندما يكون المرؤوس ملاحقا كفاعل أصلي لإحدى الجرائم المنصوص عليها في المادة 39 ، وتعذر البحث عن رؤسائه السلميين كفاعلين آخرين متسببين ، فيعتبر هؤلاء الأخيرون كمشتركين في الجريمة إذا هم قاموا أو تساهلوا في أعمال مرؤوسهم الجنائية. أما في زمن السلم، وفي حالة إعلان الحكم العرفي أو حالة الطوارئ، فيمتد اختصاص المحاكم العسكرية الدائمة على جميع أنواع الجرائم المرتكبة من المتقاضين المبينين في المواد 26 و 27 و 28 مع مراعاة أحكام الفقرة 3 من المادة 25 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
