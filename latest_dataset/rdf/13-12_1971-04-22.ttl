<https://legal.dz/resource/order/1971-04-22/71-28#version_art_327> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات، كل عسكري يترك مركز وظيفته في زمن السلم . يقصد بمركز الوظيفة المكان الذي يجب أن يكون فيه العسكري موجودا بوقت معين للقيام بالمهمة الموكلة إليه . وتكون عقوبة الحبس من سنتين إلى خمس سنوات إذا كان المجرم في إحدى الحالات المذكورة بالفقرة 2 من المادة 324 . ويمكن أن تضاف العقوبات إذا كان المجرم قائدا لتشكيلة أو سفينة بحرية عسكرية أو قائد طائرة عسكرية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_327_19710422_OpEnact_454d459506> ;
    dzdoc:replacementText "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات، كل عسكري يترك مركز وظيفته في زمن السلم . يقصد بمركز الوظيفة المكان الذي يجب أن يكون فيه العسكري موجودا بوقت معين للقيام بالمهمة الموكلة إليه . وتكون عقوبة الحبس من سنتين إلى خمس سنوات إذا كان المجرم في إحدى الحالات المذكورة بالفقرة 2 من المادة 324 . ويمكن أن تضاف العقوبات إذا كان المجرم قائدا لتشكيلة أو سفينة بحرية عسكرية أو قائد طائرة عسكرية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_327> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
