    dznorm:sourceArticle "art_289" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_289_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_289> ;
