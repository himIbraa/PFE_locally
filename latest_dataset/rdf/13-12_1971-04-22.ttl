    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_315> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يجرى قمعها جزائيا اذ كانوا جميعهم من نفس الرتبة، ما لم تقم بينهم صلة التبعية الناجمة عن الوظيفة أو العمل"@ar ;
