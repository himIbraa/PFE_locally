    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أبطل المجلس الأعلى الحكم لعدم الاختصاص ، فإنه يقضي بإحالة القضية إلى المحكمة المختصة ويعينها. وإذا أبطل الحكم لأي سبب آخر ، فيحيل القضية إلى محكمة عسكرية، لم يسبق لها أن نظرت فيها ما لم يكن الإبطال مقررا، إما لأن الواقعة لا تكون جناية أو جنحة أو مخالفة، وإما لأن الواقعة مشمولة بالتقادم أو العفو، ولم يبق بتاتا ما يمكن أن يحكم فيه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_186_19710422_OpEnact_8526ea6e00> ;
    dzdoc:replacementText "إذا أبطل المجلس الأعلى الحكم لعدم الاختصاص ، فإنه يقضي بإحالة القضية إلى المحكمة المختصة ويعينها. وإذا أبطل الحكم لأي سبب آخر ، فيحيل القضية إلى محكمة عسكرية، لم يسبق لها أن نظرت فيها ما لم يكن الإبطال مقررا، إما لأن الواقعة لا تكون جناية أو جنحة أو مخالفة، وإما لأن الواقعة مشمولة بالتقادم أو العفو، ولم يبق بتاتا ما يمكن أن يحكم فيه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_186> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
