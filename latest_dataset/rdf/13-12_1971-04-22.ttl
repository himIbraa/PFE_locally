<https://legal.dz/resource/order/1971-04-22/71-28#art_288_condition_0_1b75bda7> a dznorm:Condition ;
    dznorm:conditionText "إذا كان ضابطا فيعاقب بالعزل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_288> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_288_obligation_0_b7351020> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_288> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات، كل عسكري أو ملاح في سفينة بحرية عسكرية أو في سفينة تجارية محروسة، أو كل شخص راكب فيها اعتبر مرتكبا ، بتهاونه جريمة التسبب في هدم أو إتلاف بناء أو إنشاء أو سفينة بحرية أو طائرة أو مواد حربية أو مؤن أو أدوات أو تركيبات معدة لاستعمال الجيش أو من وسائل الدفاع الوطني، أو جعلها غير صالحة للاستعمال نهائيا أو مؤقتا"@ar ;
    dznorm:sourceArticle "art_288" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_288_obligation_1_1f656ab2> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_288> ;
    dznorm:position 1 ;
    dznorm:provisionText "يعاقب بالحبس من سنة إلى خمس سنوات، كل قائد سفينة بحرية أو طائرة عسكرية ارتكب بتهاونه جريمة التسبب في تدمير أو إتلاف سفينة بحرية أو طائرة عسكرية أو جعلها غير صالحة للاستعمال نهائيا أو مؤقتا"@ar ;
    dznorm:sourceArticle "art_288" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_288_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_288> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات، كل عسكري أو ملاح في سفينة بحرية عسكرية أو في سفينة تجارية محروسة، أو كل شخص راكب فيها اعتبر مرتكبا ، بتهاونه جريمة التسبب في هدم أو إتلاف بناء أو إنشاء أو سفينة بحرية أو طائرة أو مواد حربية أو مؤن أو أدوات أو تركيبات معدة لاستعمال الجيش أو من وسائل الدفاع الوطني، أو جعلها غير صالحة للاستعمال نهائيا أو مؤقتا. وإذا كان المجرم ضابطا، يحكم عليه بالحد الأقصى من العقوبة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_288_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_288> ;
    dzdoc:position 1 ;
    dzdoc:text "يعاقب بالحبس من سنة إلى خمس سنوات، كل قائد سفينة بحرية أو طائرة عسكرية ارتكب بتهاونه جريمة التسبب في تدمير أو إتلاف سفينة بحرية أو طائرة عسكرية أو جعلها غير صالحة للاستعمال نهائيا أو مؤقتا، إذا كان ضابطا فيعاقب بالعزل."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_289_condition_0_67f957b2> a dznorm:Condition ;
    dznorm:conditionText "إذا أصبح الشئ غير صالح للخدمة المعنية في تشغيل سفينة بحرية أو طائرة عسكرية، أو إذا كان الفعل حاصلا في زمن الحرب أو أثناء حريق أو جنوح سفينة أو تصادمها أو أثناء مناورة تهم أمن السفينة البحرية أو الطائرة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_289> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_289_obligation_0_d0bffd51> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_289> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من سنة إلى خمس سنوات كل عسكري أو كل شخص منتقل يرتكب عن قصد جريمة التسبب في إتلاف سلاح أو أي شئ آخر خاص بخدمة الجيش، أو في جعله غير صالح للاستعمال نهائيا أو مؤقتا، حتى ولو كان مملوكا للفاعل، وسواء كان في حيازته للخدمة أو معدا لاستعمال غيره من العسكريين لنفس الغاية"@ar ;
    dznorm:sourceArticle "art_289" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_289_obligation_1_77f7c7a8> a dznorm:Obligation ;
