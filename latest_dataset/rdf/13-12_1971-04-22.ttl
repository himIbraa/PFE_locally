<https://legal.dz/resource/order/1971-04-22/71-28#version_art_25> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنظر المحاكم العسكرية الدائمة في المخالفات الخاصة بالنظام العسكري والمنصوص عليها في الكتاب الثالث الوارد بعده فيحال إليها كل فاعل أصلي للجريمة وكل فاعل مشترك آخر وكل شريك في الجريمة، سواء كان عسكريا أم لا. يحاكم كذلك أمام المحاكم العسكرية الدائمة الفاعلون الأصلين للجريمة والفاعلون المشتركون الآخرون والشركاء في أية جريمة كانت مرتكبة في الخدمة أو ضمن مؤسسات عسكرية ولدى المضيف. وتختص المحاكم العسكرية الدائمة خلافا لأحكام المادة 248 من قانون الاجراءات الجزائية بالفصل في الجرائم المرتكبة ضد أمن الدول"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_25_19710422_OpEnact_3b7946092c> ;
    dzdoc:replacementText "تنظر المحاكم العسكرية الدائمة في المخالفات الخاصة بالنظام العسكري والمنصوص عليها في الكتاب الثالث الوارد بعده فيحال إليها كل فاعل أصلي للجريمة وكل فاعل مشترك آخر وكل شريك في الجريمة، سواء كان عسكريا أم لا. يحاكم كذلك أمام المحاكم العسكرية الدائمة الفاعلون الأصلين للجريمة والفاعلون المشتركون الآخرون والشركاء في أية جريمة كانت مرتكبة في الخدمة أو ضمن مؤسسات عسكرية ولدى المضيف. وتختص المحاكم العسكرية الدائمة خلافا لأحكام المادة 248 من قانون الاجراءات الجزائية بالفصل في الجرائم المرتكبة ضد أمن الدولة وفقا للنص الوارد في قانون العقوبات وذلك عندما تزيد عقوبة الحبس على مدة خمس سنوات. وعندما تكون الجريمة من نوع الجنحة فلا تختص المحاكم العسكرية الدائمة بها إلا إذا كان الفاعل عسكريا أو مماثلا له . وعلى كل، يحال الفاعل الأصلي العسكري والفاعل الآخر المشترك أو الشريك في الجريمة التي لم ينص عليها في الفقرات 1 و 2 و 3 أعلاه، أمام محاكم القمع للقانون العام. ويحال على المحاكم العسكرية ضمن الشروط الواردة في هذه المادة العسكريون التابعون لمختلف الرتب والأسلحة وكل شخص مماثل للعسكريين بموجب القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_25> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_25> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

