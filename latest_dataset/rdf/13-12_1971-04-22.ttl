<https://legal.dz/resource/order/1971-04-22/71-28#version_art_276> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالعزل كل قائد تشكيلة لسفينة بحرية أو طائرة عسكرية ، يمكنه أن يهاجم أو يقاتل عدوا في مثل قوته أو أقل، مساعدة لفرقة جزائرية أو سفينة بحرية أو طائرة جزائرية مطاردة من ذلك العدو أو مشتبكة معه، ولا يفعل ، و لا يكون ثمة عذر مانع بموجب تعليمات عامة أو أسباب خطيرة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_276_19710422_OpEnact_0cb720d016> ;
    dzdoc:replacementText "يعاقب بالعزل كل قائد تشكيلة لسفينة بحرية أو طائرة عسكرية ، يمكنه أن يهاجم أو يقاتل عدوا في مثل قوته أو أقل، مساعدة لفرقة جزائرية أو سفينة بحرية أو طائرة جزائرية مطاردة من ذلك العدو أو مشتبكة معه، ولا يفعل ، و لا يكون ثمة عذر مانع بموجب تعليمات عامة أو أسباب خطيرة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
