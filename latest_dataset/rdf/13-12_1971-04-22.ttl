<https://legal.dz/resource/order/1971-04-22/71-28#art_160_obligation_0_7339acef> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1971-04-22/71-28#art_160_obligation_0_7339acef_action_dfbe2bcf6c> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_160> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب عليه في هذه الحالة، أن يعبر عن نواياه في الجلسة العلنية قبل إقفال باب المرافعات"@ar ;
    dznorm:sourceArticle "art_160" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_160_obligation_0_7339acef_action_dfbe2bcf6c> a dznorm:Action ;
    rdfs:label "عليه في هذه الحالة"@ar ;
