<https://legal.dz/resource/order/1971-04-22/71-28#version_art_78> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "خلال سير التحقيق التحضيري و باستثناء الأحكام الخاصة الواردة في هذا القانون ، يتولى وكيل الدولة العسكري تجاه قاضي التحقيق العسكري اختصاصات وكيل الدولة تجاه قاضي التحقيق التابع للقانون العام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
