    dznorm:provisionText "يجوز لـ وزير الدفاع الوطني و وكيل الدولة العسكري أن يصدرا الأمر لـ ضباط الشرطة القضائية العسكرية، وبموجب تعليمات كتابية، لإجراء التفتيشات والحجوز في المؤسسات العسكرية وحتى في الليل."@ar ;
    dznorm:sourceArticle "art_53" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_53_permission_0_1ff33dc2_action_f94c741acf> a dznorm:Action ;
