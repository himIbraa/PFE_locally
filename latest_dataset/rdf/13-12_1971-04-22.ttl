<https://legal.dz/resource/order/1971-04-22/71-28#art_104> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_104" ;
    dzdoc:fullText "يمكن لـ قاضي التحقيق العسكري أن يأمر بالإفراج المؤقت في كل قضية من تلقاء نفسه ، عندما لا يكون ذلك بحكم القانون، وذلك بعد استطلاع رأي وكيل الدولة العسكري ، بشرط أن يتعهد المتهم بالمثول في جميع إجراءات الدعوى بمجرد الطلب، وبإخبار القاضي القائم بالتحقيق عن جميع تنقلاته كما يحق لـ وكيل الدولة العسكري أن يطلب هذا الإفراج في كل حين ، و يبت قاضي التحقيق في هذا الموضوع ضمن مهلة 48 ساعة من تاريخ هذه الطلبات ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_104_permission_0_26b535db> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_104_right_0_18cc382d>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_104_right_1_efd01315> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_104> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_104_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_104_19710422_OpEnact_aa8a673d6d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_104_obligation_0_9a742a3a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 104" ;
    dzdoc:position 103 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_104_condition_0_094e8f65> ;
    dzdoc:usesTerm dzterm:accused,
        dzterm:investigating_judge,
        dzterm:military_prosecutor .

<https://legal.dz/resource/order/1971-04-22/71-28#art_179> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_3_subsec_3> ;
    dzdoc:eId "art_179" ;
    dzdoc:fullText "تعتبر جميع الأحكام الصادرة عن المحاكم العسكرية حضورية، ولا يجوز المعارضة فيها ما عدا الأحكام الغيابية الصادرة ضمن الشروط المنصوص عليها في المادة 199 وما يليها. كما لا يجوز للمتهم الحاضر أن يصرح باعتباره غائبا، ويجب أن تعتبر المرافعات كحضورية، فإذا رفض المثول أمام المحكمة أو رفض الحضور مطلقا، بعد أن سبق له الحضور، تجرى المرافعات ويصدر الحكم بحق المتهم كما لو كان حاضرا، مع مراعاة الاجراءات المنصوص عليها في المادة 145 عند الاقتضاء."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_179_permission_0_d47104d8>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_179_permission_1_85e48126> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_179> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_179_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_179_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_179_19710422_OpEnact_e021cf5e06> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1971-04-22/71-28#art_179_prohibition_0_85e48126> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "179" ;
    dzdoc:position 178 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_145>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_199> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_145>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_199> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_1_chp_1_subsec_1> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "يتولى مهمة الدفاع أمام المحاكم العسكرية المحامون المقيدون في قائمة المحامين أو عسكري مقبول من السلطة العسكرية . أما القضايا المتعلقة بالجرائم الخاصة العسكرية المنصوص عليها في هذا القانون، فلا يجوز فيها للمدافع المختار من قبل المتهم أن يحضر مع المتهم أو يدافع عنه أو يمثله سواء كان أثناء التحقيق أو الجلسة ما لم يسمح له بذلك رئيس المحكمة العسكرية الدائمة الناظرة في القضية ، وإلا فيعين المدافع من قبل الرئيس."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_18_permission_0_1615fe6d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_18_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_18_19710422_OpEnact_3e91b19066> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_18_obligation_0_a82ff834> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "18" ;
    dzdoc:position 17 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_18_condition_0_365e47f1> ;
    dzdoc:usesTerm dzterm:lawyers,
        dzterm:military_courts .

<https://legal.dz/resource/order/1971-04-22/71-28#art_192> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_5> ;
    dzdoc:eId "art_192" ;
    dzdoc:fullText "يتضمن التكليف بالحضور الخاص بالمتهم ما يلي: 1 - اسم وصفة السلطة الطالبة، 2 - حكم الإحالة المستند إليه أو التقديم المباشر وأمر التكليف الصادر من المحكمة، وتعيين مكان انعقاد الجلسة مع بيان التاريخ والساعة، 3 - الواقعة موضوع المتابعة مع بيان النص القانوني المطبق وأسماء الشهود والخبراء الذين طلب وكيل الدولة العسكري الاستماع إليهم، 4 - إخبار المتهم تحت طائلة البطلان أنه في حال امتناعه عن اختيار مدافع عنه ، يصار إلى تعيين مدافع عنه تلقائيا ، 5 - إخطار المتهم، بأنه ينبغي عليه إبلاغ وكيل الدولة العسكري بقائمة الشهود الذين يطلب الاستماع إليهم وذلك بموجب تصريح يقدم لكتابة الضبط قبل 8 أيام من الجلسة. وتكون ورقة التكليف بالحضور مؤرخة وموقعة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_192> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_192_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_192_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_192_19710422_OpEnact_ca4c5f1e94> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_192_obligation_0_81a3db29>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_192_obligation_1_d3e72fab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 192" ;
    dzdoc:position 191 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_192_condition_0_468a5e7d> ;
    dzdoc:usesTerm dzterm:تكليف_بالحضور,
        dzterm:متهم,
        dzterm:وكيل_الدولة_العسكري .

<https://legal.dz/resource/order/1971-04-22/71-28#art_193> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_5> ;
    dzdoc:eId "art_193" ;
    dzdoc:fullText "يجب فضلا عما تقدم، أن يتضمن التكليف بالحضور الخاص بالمتهم ، في زمن الحرب ، وتحت طائلة البطلان، ما يلي: 1 - اسم المدافع المكلف تلقائيا، 2 – تنبيه المتهم بأنه في إمكانه أن يختار مدافعا بدلا منه لحين افتتاح المرافعات . كما يجب أن يتضمن هذا التكليف ما يشير إلى إمكانية المتهم من الاستفادة كذلك من أحكام الفقرة 5 من المادة 131 بالنسبة لاستدعاء الشهود ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_193_right_0_9dce049d>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_193_right_1_3fea2962> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_193> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_193_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_193_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_193_19710422_OpEnact_387a66a886> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 193" ;
    dzdoc:position 192 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_131> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_131> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_193_condition_0_d3f2c198> ;
    dzdoc:usesTerm dzterm:تكليف_بالحضور,
        dzterm:متهم .

<https://legal.dz/resource/order/1971-04-22/71-28#art_210> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_5> ;
    dzdoc:eId "art_210" ;
    dzdoc:fullText "ينفذ الحكم خلال الأربع والعشرين ساعة التالية لانقضاء المهلة المحددة للطعن ، إذا لم يقدم طعن فيه ، إلا في الحالة المنصوص عليها في المادة 222 إذا كانت العقوبة المحكوم بها هي الإعدام ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_210> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_210_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_210_19710422_OpEnact_b93bef8f19> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_210_obligation_0_3db3f92d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 210" ;
    dzdoc:position 209 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_222> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_222> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_210_condition_0_91195b9e>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_210_condition_1_53155e5e> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_212> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_5> ;
    dzdoc:eId "art_212" ;
    dzdoc:fullText "إذا رفض الطعن نفذ حكم العقوبة خلال أربع وعشرين ساعة من استلام حكم رفض الطعن إلا في الحالة المنصوص عليها في المادة 222 إذا كانت العقوبة المحكوم بها هي الإعدام ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_212> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_212_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_212_19710422_OpEnact_35d071c8b3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_212_obligation_0_f708815b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 212" ;
    dzdoc:position 211 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_222> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_222> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_212_condition_0_69384b8e>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_212_condition_1_53155e5e> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_213> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_5> ;
    dzdoc:eId "art_213" ;
    dzdoc:fullText "يشعر وكيل الدولة العسكري ، في جميع الأحوال، بحكم المجلس الأعلى أو بحكم المحكمة، السلطة التي أمرت أو طلبت إجراء الملاحقات، أو السلطة العسكرية لقيادة الدائرة الإقليمية، أو الوحدة الكبرى التي تنعقد في دائرة اختصاصها المحكمة العسكرية أو تكون قائمة فيها . وإذا أصبح الحكم نهائيا ، يأمر وكيل الدولة العسكري بتنفيذه ضمن المهل المحددة في المادتين 210 و 212 ، ولهذا الغرض يحق له أن يطلب القوة العمومية . بيد أنه في حالة عقوبة الإعدام، فلا يمكن أن تطلب قوة الدرك أو تطلب مؤازرتها إلا للمحافظة على النظام."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_213_permission_0_dffe7190> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_213_right_0_e2533b6b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_213> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_213_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_213_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_213_19710422_OpEnact_6483149dd9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_213_obligation_0_d0d2345d>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_213_obligation_1_ed2c7eb1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 213" ;
    dzdoc:position 212 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_210>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_212> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_210>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_212> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_213_condition_0_896f29ca> ;
    dzdoc:usesTerm dzterm:prosecutor .

<https://legal.dz/resource/order/1971-04-22/71-28#art_254> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_254" ;
    dzdoc:fullText "كل شخص يرتكب جرم العصيان المنصوص عليه في القوانين المتعلقة بالتجنيد، يعاقب في زمن السلم، بالحبس من 3 أشهر إلى 5 سنوات. وتكون العقوبة في زمن الحرب، الحبس من سنتين إلى 10 سنوات، ويمكن أن يحرم المحكوم عليه جزئيا أو كليا من ممارسة الحقوق المذكورة في المادة 8 من قانون العقوبات لمدة 5 سنوات على الأقل و20 سنة على الأكثر. إذا كان المجرم ضابطا فيمكن أن تطبق عليه في زمن الحرب عقوبة العزل. ولا يجوز فرض العقوبات الآنفة الذكر، دون تطبيق الأحكام المنصوص عليها في القوانين المتعلقة بالتجنيد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_254_permission_0_46740fe3> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_254_right_0_ac6a1fea> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_254> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_254_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_254_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_254_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_254_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_254_19710422_OpEnact_2521a9751f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_254_obligation_0_c48c393a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 254" ;
    dzdoc:position 253 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_254_extref_7722a5e6> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_254_condition_0_18a3137d> ;
    dzdoc:usesTerm dzterm:jorm_al_isyan .

<https://legal.dz/resource/order/1971-04-22/71-28#art_266> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_1_subsec_2> ;
    dzdoc:eId "art_266" ;
    dzdoc:fullText "يعاقب بالإعدام، كل عسكري أو أحد الأفراد من غير العسكريين، يكون ملاحا في سفينة بحرية أو طائرة أو سفينة تجارية محروسة ، يرتكب جريمة الهروب إلى العدو."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_266> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_266_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_266_19710422_OpEnact_8f7ef68bf6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 266" ;
    dzdoc:position 265 ;
    dzdoc:usesTerm dzterm:soldier .

<https://legal.dz/resource/order/1971-04-22/71-28#art_320> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_320" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى سنة كل عسكري يهين أثناء الخدمة أو خلال الخدمة مرؤوسا إهانة جسيمة وبدون استفزاز وذلك بالكلام أو بالحركات أو بالتهديد أو بالكتابة. تعتبر أعمال الإهانة التي يرتكبها عسكري وهو على ظهر سفينة بحرية أو طائرة عسكرية كأنها مرتكبة أثناء الخدمة، وإذا لم يرتكب الجرم أثناء الخدمة أو بمناسبة الخدمة، فيعاقب بالحبس من شهرين إلى ستة أشهر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_320> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_320_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_320_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_320_19710422_OpEnact_8953b8b85a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_320_obligation_0_097b88c2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "320" ;
    dzdoc:position 319 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_320_condition_0_eeca36e7> ;
    dzdoc:usesTerm dzterm:military .

<https://legal.dz/resource/order/1971-04-22/71-28#art_327> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:definesTerm dzterm:duty_station ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_4> ;
    dzdoc:eId "art_327" ;
    dzdoc:fullText "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات، كل عسكري يترك مركز وظيفته في زمن السلم . يقصد بمركز الوظيفة المكان الذي يجب أن يكون فيه العسكري موجودا بوقت معين للقيام بالمهمة الموكلة إليه . وتكون عقوبة الحبس من سنتين إلى خمس سنوات إذا كان المجرم في إحدى الحالات المذكورة بالفقرة 2 من المادة 324 . ويمكن أن تضاف العقوبات إذا كان المجرم قائدا لتشكيلة أو سفينة بحرية عسكرية أو قائد طائرة عسكرية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_327> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1971-04-22/71-28#art_327_defocc_ccca0fdf23bc> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_327_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_327_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_327_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_327_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_327_19710422_OpEnact_454d459506> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_327_obligation_0_d709af43>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_327_obligation_1_be22bf31> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "327" ;
    dzdoc:position 326 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_324> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_324> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_327_condition_0_ab3b5314> ;
    dzdoc:usesTerm dzterm:military_personnel .

<https://legal.dz/resource/order/1971-04-22/71-28#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "إن قادة الجيوش وقادة القواعد البحرية والجوية وقادة السفن البحرية ورؤساء القطع ورؤساء المستودعات والمفارز ورؤساء مختلف مصالح الجيش، يؤهلون شخصيا لجميع الأعمال الضرورية داخل مؤسساتهم العسكرية للتحقيق في الجرائم التابعة للقضاء العسكري وجمع الأدلة والبحث عن مرتكبي الجرائم. ويجوز لهذه السلطات أن تفوض إلى ضابط تابع لأوامرها السلطات الآيلة لها بموجب الفقرة السابقة. ويمكنها أيضا أن تطلب إلى أي ضابط للشرطة القضائية العسكرية المختصة إقليميا القيام بالإجراءات المنصوص عليها في المادتين 50 و 51 أدناه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_47_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_47_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_47_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_47_19710422_OpEnact_e71c17b00b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "47" ;
    dzdoc:position 46 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_50>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_51> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_50>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_51> ;
    dzdoc:usesTerm dzterm:police_officer .

<https://legal.dz/resource/order/1971-04-22/71-28#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "يمكن مد المهل المذكورة في المادتين 57 و 58 السابقتين ب 48 ساعة بموجب إذن كتابي صادر من السلطة التي سيسلم إليها طبقا لأحكام المادة 60 ، العسكريون الموقوفون بالجرم المتلبس به أو الذين توجد بحقهم أدلة خطيرة ومطابقة للجرم. وبالنسبة للعسكريين من غير الذين ذكروا في الفقرة 1 ، فيمكن مد المهلة المنصوص عليها في المادة 58 المذكورة مقدار 48 ساعة بموجب إذن كتابي صادر عن وكيل الدولة العسكري ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_59_permission_0_da0286f1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_59_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_59_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_59_19710422_OpEnact_344b0e437a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "59" ;
    dzdoc:position 58 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_57>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_58>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_60> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_57>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_58>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_60> ;
    dzdoc:usesTerm dzterm:military_prosecutor .

<https://legal.dz/resource/order/1971-04-22/71-28#art_80> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_4> ;
    dzdoc:eId "art_80" ;
    dzdoc:fullText "عندما يشرع قاضي التحقيق العسكري في استجواب المتهم لأول مرة في زمن الحرب، ينبه على هذا الأخير، إذا لم يكن قد اختار مدافعا ، بأنه سيعين له مدافع بصفة تلقائية في ورقة التكليف بالحضور، ويذكر ذلك في المحضر . وفي حالة اختيار المدافع، يوجه القاضي لهذا الأخير إخبارا عن تاريخ أول استجواب أو مواجهة للمتهم، وذلك بواسطة رسالة أو أية وسيلة أخرى . ويذكر في محضر الاستجواب أو المواجهة بأن استكمال هذا الإجراء قد تم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_80> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_80_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_80_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_80_19710422_OpEnact_771017d8ca> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_80_obligation_0_17353af7>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_80_obligation_1_bcd520d4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 80" ;
    dzdoc:position 79 ;
    dzdoc:usesTerm dzterm:military_investigating_judge .

<https://legal.dz/resource/order/1971-04-22/71-28#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_11> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "تخضع الأوامر الصادرة من قاضي التحقيق العسكري لأحكام المادة 169 من قانون الاجراءات الجزائية . ويبلغ المدافع عن المتهم جميع الأوامر القضائية خلال 24 ساعة بموجب رسالة مضمونة . ويبلغ المتهم من قبل وكيل الدولة العسكري في نفس المهلة بالأوامر التي يمكنه استئنافها بمقتضى أحكام المادة 97 ، تبعا للأوضاع المنصوص عليها في المادة 191 وما يليها. وفي زمن الحرب يمكن أن يجري تبليغ المدافع عن المتهم بكل أمر صادر، بموجب رسالة أو بأية وسيلة أخرى."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_96_permission_0_6e497758> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_96_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_96_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_96_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_96_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_96_19710422_OpEnact_2d24a6ec8d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_96_obligation_0_630d521b>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_96_obligation_1_6ae0cdc3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "96" ;
    dzdoc:position 95 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_97> ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_96_extref_584e13e1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_96_extref_63d17361> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_97> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_96_condition_0_5d8cf627> ;
    dzdoc:usesTerm dzterm:military_investigating_judge,
        dzterm:military_state_prosecutor .

