<https://legal.dz/resource/order/1971-04-22/71-28#version_art_102> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "سواء كان التدبير مقررا بموجب أمر قضائي أو حكم غيابي، فيساق الضنين أو المتهم أو المحكوم عليه إما إلى سجن التوقيف فيعتقل في جناح خاص بالعسكريين أو إلى سجن عسكري، وإذا لم يمكن، فإلى مؤسسة تعينها السلطة العسكرية ضمن الشروط المنصوص عليها في مرسوم يصدر بناء على تقرير وزير الدفاع الوطني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_102_19710422_OpEnact_ef7b06c344> ;
