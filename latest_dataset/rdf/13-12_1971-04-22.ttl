<https://legal.dz/resource/order/1971-04-22/71-28#version_art_247> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يترتب على عقوبة فقدان الرتبة نفس الآثار المطبقة على عقوبة العزل، ولكن بدون إضافة الحقوق بالمعاش والمكافأة عن الخدمة السابقة. وتطبق هذه العقوبة على الضباط كما تطبق على ضباط الصف المحترفين وضباط الصف القائمين بالخدمة بموجب عقد، في جميع الأحوال التي تسري فيها العقوبة المذكورة على الضباط."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_247_19710422_OpEnact_3d6ce17cd2> ;
    dzdoc:replacementText "يترتب على عقوبة فقدان الرتبة نفس الآثار المطبقة على عقوبة العزل، ولكن بدون إضافة الحقوق بالمعاش والمكافأة عن الخدمة السابقة. وتطبق هذه العقوبة على الضباط كما تطبق على ضباط الصف المحترفين وضباط الصف القائمين بالخدمة بموجب عقد، في جميع الأحوال التي تسري فيها العقوبة المذكورة على الضباط."@ar ;
