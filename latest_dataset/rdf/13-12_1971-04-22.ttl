<https://legal.dz/resource/order/1971-04-22/71-28#version_art_309> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل شخص في خدمة القوات المسلحة غير من ذكر أعلاه، يكون مستخدما في مؤسسة للقوات المسلحة ، ويرفض الطاعة عندما يصدر إليه الأمر بأداء خدمة، سواء كان أمام العدو أو عصابة مسلحة، أو أثناء حريق أو خطر يهدد أمن الدولة ، يعاقب بالحبس من شهرين إلى خمس سنوات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
