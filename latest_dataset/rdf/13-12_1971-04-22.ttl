<https://legal.dz/resource/order/1971-04-22/71-28#version_art_285> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن المؤقت مع الأشغال من عشر سنوات إلى عشرين سنة، كل عسكري أو أي شخص منتقل يستولي على القيادة بدون أمر أو سبب مشروع أو يحتفظ بها خلافا لأمر رؤسائه. وإذا كان المجرم ضابطا يحكم عليه فوق ذلك بعقوبة العزل."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
