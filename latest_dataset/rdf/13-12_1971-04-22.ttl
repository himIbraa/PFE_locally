<https://legal.dz/resource/order/1971-04-22/71-28#version_art_278> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتبر مجندا لصالح العدو و يعاقب بالإعدام كل شخص يحرض العسكريين على الانضمام إلى العدو أو يسهل لهم الوسائل لذلك مع علمه بالأمر ، أو يجند الأفراد لصالح دولة هي في حالة حرب مع الجزائر. وإذا كان الفاعل عسكريا ، يحكم عليه فوق ذلك بعقوبة التجريد العسكري ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_278_19710422_OpEnact_d743cbc571> ;
    dzdoc:replacementText "يعتبر مجندا لصالح العدو و يعاقب بالإعدام كل شخص يحرض العسكريين على الانضمام إلى العدو أو يسهل لهم الوسائل لذلك مع علمه بالأمر ، أو يجند الأفراد لصالح دولة هي في حالة حرب مع الجزائر. وإذا كان الفاعل عسكريا ، يحكم عليه فوق ذلك بعقوبة التجريد العسكري ."@ar ;
