<https://legal.dz/resource/order/1971-04-22/71-28#art_331> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_4> ;
    dzdoc:eId "art_331" ;
    dzdoc:fullText "يعاقب بالإعدام كل قائد سفينة بحرية عسكرية ، وكل ملاح طائرة عسكرية محلقة لا يتركها بعد آخر من فيها، عن قصد، وخلافا للتعليمات التي تلقاها، وذلك في حالة فقدان سفينته أو طائرته . وتطبق نفس العقوبة على القائد غير الملاح لطائرة عسكرية، الذي يترك طائرته ضمن نفس الأوضاع، قبل تفريغها من الركاب وما عدا الملاح ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_331> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_331_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_331_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_331_19710422_OpEnact_656cec9d58> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_331_obligation_0_dab1ffb6>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_331_obligation_1_7f19b81d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 331" ;
    dzdoc:position 330 ;
    dzdoc:usesTerm dzterm:commander,
        dzterm:pilot .

<https://legal.dz/resource/order/1971-04-22/71-28#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "يجوز لـ وزير الدفاع الوطني و وكيل الدولة العسكري أن يصدرا الأمر لـ ضباط الشرطة القضائية العسكرية ، وبموجب تعليمات كتابية، لإجراء التفتيشات والحجوز في المؤسسات العسكرية وحتى في الليل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_53_permission_0_1ff33dc2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_53_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_53_19710422_OpEnact_47b13f87f9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "53" ;
    dzdoc:position 52 ;
    dzdoc:usesTerm dzterm:military_judicial_police_officers,
        dzterm:military_prosecutor,
        dzterm:minister_of_defense .

<https://legal.dz/resource/order/1971-04-22/71-28#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "تطبق أيضا على العسكريين في زمن السلم الاجراءات الخاصة بالوضع تحت المراقبة فيما يتعلق بالاعتداء على أمن الدولة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_62_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_62_19710422_OpEnact_7a63409559> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "62" ;
    dzdoc:position 61 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_2> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "يمكن ل قاضي التحقيق العسكري في زمن الحرب أن ينفذ كل نوع من الإنابات القضائية المتعلقة بالعسكريين أو أفراد القوات المسلحة أو الأشخاص التابعين للجيش بموجب إذن ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_77_permission_0_23516018> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_77_right_0_b3bdef68> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_77_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_77_19710422_OpEnact_def8735671> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 77" ;
    dzdoc:position 76 ;
    dzdoc:usesTerm dzterm:military_investigating_judge .

<https://legal.dz/resource/order/1971-04-22/71-28#art_85> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_8> ;
    dzdoc:eId "art_85" ;
    dzdoc:fullText "يمكن إحالة قرار قاضي التحقيق العسكري الخاص بطلب استرداد الأشياء المحجوزة، إلى المحكمة العسكرية ضمن الأشكال والأوضاع المنصوص عليها في المادة 86 من قانون الاجراءات الجزائية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_85_permission_0_23356752> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_85> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_85_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_85_19710422_OpEnact_cd9ede16bf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "85" ;
    dzdoc:position 84 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_85_extref_4f891830> ;
    dzdoc:usesTerm dzterm:military_court,
        dzterm:military_investigating_judge .

<https://legal.dz/resource/order/1971-04-22/71-28#art_92> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_11> ;
    dzdoc:eId "art_92" ;
    dzdoc:fullText "يقوم قاضي التحقيق العسكري بمجرد انتهاء إجراءات التحقيق بإرسال الملف لـ وكيل الدولة العسكري ، و على هذا الأخير أن يقدم طلباته إليه خلال ثمانية أيام ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_92> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_92_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_92_19710422_OpEnact_9d569d9baa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_92_obligation_0_1ed286a3>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_92_obligation_1_b965bdd8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "92" ;
    dzdoc:position 91 ;
    dzdoc:usesTerm dzterm:military_investigating_judge,
        dzterm:military_state_prosecutor .

