<https://legal.dz/resource/order/1971-04-22/71-28#art_283_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_283> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالإعدام كل عسكري أو كل شخص منتقل على ظهر سفينة بحرية أو طائرة أو على سفينة تجارية محروسة ويقوم بالأعمال التالية : يحرض على الهزيمة أمام العدو أو العصابة المسلحة أو يعرقل جمع الجنود أو ينزل الراية، يحرض على وقف القتال بدون أمر من القائد، يتسبب عن قصد في استيلاء العدو على التشكيلة العسكرية أو السفينة البحرية أو الطائرة الموضوعة تحت أمرته أو الموجود على متنها."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_284_condition_0_f0eca9f2> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/order/1971-04-22/71-28#art_284_condition_0_f0eca9f2_action_0e804de605> ;
