<https://legal.dz/resource/order/1971-04-22/71-28#art_70_condition_0_e991f4a4> a dznorm:Condition ;
    dznorm:conditionText "لا يبدأ سريان مفعول تقادم الدعوى العمومية الناجمة عن العصيان أو الفرار، إلا ابتداء من اليوم الذي يبلغ فيه العاصي أو الفار سن الخمسين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_70> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_70_condition_1_ea444e19> a dznorm:Condition ;
    dznorm:conditionText "عندما يلجأ العاصي أو الفار في زمن الحرب، لبلاد أجنبية أو يبقى فيها هربا من أداء واجباته العسكرية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_70> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_70_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_70> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يبدأ سريان مفعول تقادم الدعوى العمومية الناجمة عن العصيان أو الفرار، إلا ابتداء من اليوم الذي يبلغ فيه العاصي أو الفار سن الخمسين."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_70_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_70> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا تنقضي الدعوى العمومية في الأحوال المذكورة في المواد 265 و 266 و 267، أو عندما يلجأ العاصي أو الفار في زمن الحرب، لبلاد أجنبية أو يبقى فيها هربا من أداء واجباته العسكرية."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_71_condition_0_260787db> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1971-04-22/71-28#art_71_condition_0_260787db_ref_ba2311e2cfc3> ;
