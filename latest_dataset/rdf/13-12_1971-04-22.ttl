    dznorm:sourceArticle "art_107" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_108_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_108> ;
    dzdoc:position 0 ;
    dzdoc:text "يقدم الاستئناف ويفصل فيه ضمن الشروط المعينة في القسم الثاني عشر من الفصل الأول والفصل الثاني من هذا الباب."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_108_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_108> ;
    dzdoc:position 1 ;
    dzdoc:text "ويستمر توقيف المتهم لغاية الفصل في الاستئناف، وفي جميع الأحوال، لغاية انقضاء مهلة الاستئناف."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_109_condition_0_519e83b4> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/order/1971-04-22/71-28#art_109_condition_0_519e83b4_action_22945d864d> ;
    dznorm:conditionText "إذا منحت المحكمة العسكرية الإفراج المؤقت معدلة بذلك أمر قاضي التحقيق العسكري، فيجوز لهذا الأخير، إذا طرأت عناصر اتهام جديدة وخطيرة بحق المتهم وكان هذا الأخير يستطيع الهرب أو الإفلات بأسرع وقت من يد العدالة، أن يصدر أمر توقيف جديد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_109> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_109_condition_0_519e83b4_action_22945d864d> a dznorm:Action ;
    rdfs:label "لهذا الأخير"@ar ;
