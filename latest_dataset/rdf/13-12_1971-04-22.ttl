<https://legal.dz/resource/order/1971-04-22/71-28#version_art_20> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد مقر المحاكم المقرر إحداثها بموجب مرسوم يصدر بناء على تقرير وزير الدفاع الوطني . إن القضاة الملحقين بـ المحاكم العسكرية الدائمة في وظائف تابعة للنيابة والتحقيق، والذين يدعون للقضاء في المحاكم المنشأة حديثا تطبيقا للفقرة السابقة، يعتبرون مجندين ضمن الشروط المنصوص عليها في القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
