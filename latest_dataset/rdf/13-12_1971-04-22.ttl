    dznorm:position 0 ;
    dznorm:provisionText "ويجب توقيع التصريح من كاتب الضبط وطالب الطعن بنفسه أو المدافع عن المحكوم عليه والمزود بتوكيل خاص"@ar ;
    dznorm:sourceArticle "art_183" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_183_obligation_0_55bc2f64_action_cb5b24bf20> a dznorm:Action ;
