<https://legal.dz/resource/order/1971-04-22/71-28#version_art_216> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يكون حكم محكمة عسكرية يقضي بعقوبة سالبة للحرية دون توقيف تنفيذ، لم يمكن تنفيذه ، يقوم وكيل الدولة العسكري بنشره. يتسلم عون القوة العمومية المكلف بتنفيذ الحكم ، ملخصا عن هذا الأخير يتضمن الصيغة التنفيذية، وهذا الملخص يشكل حتى في حالة المعارضة في الحكم الغيابي، السند القانوني للتوقيف والنقل والحبس في إحدى المؤسسات المحددة في المادة 102 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_216_19710422_OpEnact_f4cfa4b3c5> ;
    dzdoc:replacementText "عندما يكون حكم محكمة عسكرية يقضي بعقوبة سالبة للحرية دون توقيف تنفيذ، لم يمكن تنفيذه ، يقوم وكيل الدولة العسكري بنشره. يتسلم عون القوة العمومية المكلف بتنفيذ الحكم ، ملخصا عن هذا الأخير يتضمن الصيغة التنفيذية، وهذا الملخص يشكل حتى في حالة المعارضة في الحكم الغيابي، السند القانوني للتوقيف والنقل والحبس في إحدى المؤسسات المحددة في المادة 102 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_216> ;
