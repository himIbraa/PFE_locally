<https://legal.dz/resource/order/1971-04-22/71-28#version_art_151> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تصدر الأحكام المشار إليها في المادة السابقة بأغلبية الأصوات وفقا لمنطوق المادة 165 ، و لا يمكن الطعن فيها بالنقض إلا مع الحكم الصادر في الموضوع . وكل تصريح يقدم لكتابة الضبط يتعلق بطعن موجه ضد هذه الأحكام، يضم للدعوى ولا تنظر فيه المحكمة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_151_19710422_OpEnact_d400ac8df6> ;
