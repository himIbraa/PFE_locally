    dzdoc:usesTerm dzterm:military_investigating_judge .

<https://legal.dz/resource/order/1971-04-22/71-28#art_94> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_11> ;
    dzdoc:eId "art_94" ;
    dzdoc:fullText "إذا رأى قاضي التحقيق العسكري أن الفعل المنسوب للمتهم لا يكون جناية أو جنحة أو مخالفة، أو لم يمكن التعرف على المتهم، أو أنه لا توجد دلائل كافية ضده ، أصدر القاضي المذكور أمرا بعدم الملاحقة و أفرج عن المتهم إذا كان محبوسا ما لم يكن محبوسا لسبب آخر . ويمكن إصدار الأوامر بمنع المحاكمة بصفة جزئية أثناء سير التحقيق. ويبلغ الأمر فورا من قبل قاضي التحقيق العسكري إلى وكيل الدولة العسكري الذي ينفذها حالا ويتولى بنفس الوقت إطلاع وزير الدفاع الوطني عليها . ويعود لهذا الأخير حق إصدار الأمر عند اللزوم، باستئناف الملاحقات بناء على أدلة جديدة وفقا للتحديد الوارد في المادة 175 من قانون الاجراءات الجزائية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_94_permission_0_3bd5830b> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_94_right_0_744dd39a>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_94_right_1_2dae2da1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_94> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_94_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_94_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_94_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_94_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_94_19710422_OpEnact_1f7cbef5e3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_94_obligation_0_13694dea> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "94" ;
    dzdoc:position 93 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_94_extref_b83147be> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_94_condition_0_34cdc2c6> ;
    dzdoc:usesTerm dzterm:military_investigating_judge,
        dzterm:military_state_prosecutor,
        dzterm:minister_of_defense .

dzterm:military_investigating_judge a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "قاضي التحقيق العسكري"@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_166> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_166" ;
    dzdoc:fullText "إذا اعتبر المتهم مذنبا ، طرح الرئيس السؤال فيما إذا كانت هناك ظروف مخففة. ثم تتداول المحكمة في تطبيق العقوبة التي تصدر بأغلبية الأصوات. ويدعى كل قاض للإدلاء برأيه ابتداء من القاضي الأدنى رتبة، ثم يدلي الرئيس برأيه في الأخير. وفي حالة الحكم بالغرامة أو الحبس ، يجوز للمحكمة أن تقرر بأغلبية الأصوات قابلية توقيف التنفيذ ، وتتداول المحكمة كذلك بشأن العقوبات التبعية أو التكميلية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_166_permission_0_f6178aba> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_166_right_0_af2a14c9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_166> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_166_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_166_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_166_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_166_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_166_19710422_OpEnact_bcc3dcc83e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_166_obligation_0_4d888fb3>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_166_obligation_1_63fe9de6>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_166_obligation_2_f3d82cc2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "166" ;
    dzdoc:position 165 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_166_condition_0_fd8ed93a>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_166_condition_1_70a879f9> ;
    dzdoc:usesTerm dzterm:court .

<https://legal.dz/resource/order/1971-04-22/71-28#art_178> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_3_subsec_3> ;
    dzdoc:eId "art_178" ;
    dzdoc:fullText "لا يمكن إرسال أصول الأحكام الصادرة عن المحاكم العسكرية لأية جهة كانت للاطلاع عليها. إنما يجوز الأمر بإرسال هذه الأصول إلى كتابة ضبط المجلس الأعلى بموجب قرار هذا الأخير . كما يجوز تسليم نسخ أو خلاصات عن الحكم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_178_permission_0_6d222ad2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_178_permission_1_1a890028>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_178_permission_2_040c466b> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_178_right_0_5fee9b82>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_178_right_1_3559ae15> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_178> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_178_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_178_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_178_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_178_19710422_OpEnact_e85679ff3f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "178" ;
    dzdoc:position 177 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_301> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_2_subsec_8> ;
    dzdoc:eId "art_301" ;
    dzdoc:fullText "يعاقب بالحبس في زمن السلم من ستة أشهر إلى سنتين، كل عسكري أو كل شخص منتقل، يحرض بأية وسيلة كانت عسكريا أو أكثر لارتكاب أعمال مخالفة للواجب أو النظام. وإذا كان المجرم برتبة أعلى من رتبة العسكريين المحرضين لهذه الأفعال ، عوقب بالحبس من سنة إلى خمس سنوات . وإذا وقعت الأفعال في زمن الحرب أو في أرض أعلنت فيها حالة الحكم العرفي أو حالة الطوارئ ، يقضى بالحبس من سنة واحدة إلى خمس سنوات في الأحوال المشار إليها في الفقرة 1 من هذه المادة . وبالسجن المؤقت من خمس سنوات إلى عشر سنوات في الحالة المشار إليها في الفقرة الثانية منها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_301> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_301_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_301_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_301_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_301_19710422_OpEnact_8a2284a058> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_301_obligation_0_d3e20e50>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_301_obligation_1_f1a70943>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_301_obligation_2_ed2af7b5>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_301_obligation_3_eb7ae217> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 301" ;
    dzdoc:position 300 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_301> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_301> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_301_condition_0_e69c4e8b>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_301_condition_1_cfab56a2> ;
    dzdoc:usesTerm dzterm:military .

<https://legal.dz/resource/order/1971-04-22/71-28#art_58> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_58" ;
    dzdoc:fullText "ينبغي على الرؤساء السلميين تلبية طلب ضباط الشرطة القضائية العسكرية، الرامي لأن يوضع تحت تصرفهم عسكري قائم بالخدمة ، عندما تقتضي ذلك ضرورات التحقيق الابتدائي أو الجرم المتلبس به أو تنفيذ إنابة قضائية . ولا يجوز لضباط الشرطة القضائية العسكرية المذكورين الاحتفاظ بالعسكريين الموضوعين تحت تصرفهم أكثر من 3 أيام."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_58_permission_0_3d7b5a1a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_58> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_58_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_58_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_58_19710422_OpEnact_a178cf277d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_58_obligation_0_ac8fb954> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "58" ;
    dzdoc:position 57 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_58_condition_0_c7b3f494> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_131> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_1> ;
    dzdoc:eId "art_131" ;
    dzdoc:fullText "يسلم التكليف بالحضور إلى المتهم ضمن المهل والأوضاع المنصوص عليها في الباب الخامس من هذا الكتاب. ويجري التبليغ بالحضور للشهود والخبراء الذين يقترح وكيل الدولة العسكري الاستماع إليهم، طبقا للأحكام نفسها. ويقوم المتهم أو المدافع عنه باطلاع وكيل الدولة العسكري على أسماء وعناوين الشهود الذين يرى من الضروري الاستماع إليهم وذلك قبل 8 أيام على الأقل من الجلسة . ويحق للمتهم أن يستحضر مباشرة الشهود الذين تخلف وكيل الدولة العسكري عن الأمر بتكليفهم بالحضور . وفي زمن الحرب ، يحق للمتهم أن يطلب، قصد الدفاع عن نفسه، سماع أي ،شاهد، بدون إجراء أو تكليف مسبق بالحضور ، بعد أن يذكره ل وكيل الدولة العسكري قبل فتح الجلسة، ومع مراعاة السلطة التقديرية الخاصة بالرئيس."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_131_right_0_3733444d>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_131_right_1_ce022061> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_131> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_131_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_131_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_131_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_131_para_3>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_131_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_131_19710422_OpEnact_f0323b8ec9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_131_obligation_0_1fbac9d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "131" ;
    dzdoc:position 130 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_131_condition_0_5d8cf627> ;
    dzdoc:usesTerm dzterm:prosecutor .

<https://legal.dz/resource/order/1971-04-22/71-28#art_142> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_3> ;
    dzdoc:eId "art_142" ;
    dzdoc:fullText "إذا رفض المعتقل الحضور أمام المحكمة ، يوجه إليه إنذار بلزوم الامتثال لأمر العدالة باسم القانون، وذلك بواسطة عون من القوة العمومية يعينه الرئيس لهذا الغرض . ويضع هذا العون محضرا بتبليغ الإنذار وتلاوة هذه المادة وجواب المتهم ، وإذا أبى هذا الأخير الإذعان للإنذار ، أمر الرئيس ، بعد تلاوة المحضر في الجلسة والمثبت للرفض، باتخاذ إجراءات المرافعة رغم تخلف المتهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_142> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_142_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_142_19710422_OpEnact_593b03c887> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_142_obligation_0_b594d4ab>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_142_obligation_1_2adc5a81>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_142_obligation_2_27b07411> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 142" ;
    dzdoc:position 141 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_142_condition_0_18c15d95>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_142_condition_1_12c89c82> ;
    dzdoc:usesTerm dzterm:accused,
        dzterm:president .

<https://legal.dz/resource/order/1971-04-22/71-28#art_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:definesTerm dzterm:competent_military_court ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_30" ;
    dzdoc:fullText "إن المحكمة العسكرية المختصة، هي المحكمة التي وقع الجرم في دائرة اختصاصها، أو المحكمة التي أوقف المتهم أو المتهمون في دائرة اختصاصها أو المحكمة التي تخضع لها الوحدة التي يكون المتهم أو المتهمون تابعين لها. وفي حالة تنازع اختصاص المحاكم العسكرية ، تكون المحكمة المختصة هي المحكمة التي وقع الجرم في دائرة اختصاصها. عندما يكون المتهم بدرجة مساوية لنقيب فأعلى أو عندما يكون ضابطا له صفة ضابط للشرطة القضائية العسكرية وارتكب الجريمة أو الجنحة بصفته المذكورة ، فيعين وزير الدفاع الوطني المحكمة العسكرية المختصة التي لا يمكن أن تكون محكمة الناحية العسكرية التابع لها المتهم أو أحد المتهمين، إلا في حالة عدم الإمكانية المادية لذلك."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_30_permission_0_46eb381f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_30> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1971-04-22/71-28#art_30_defocc_a7c6544b295a> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_30_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_30_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_30_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_30_19710422_OpEnact_bd25a11afb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_30_obligation_0_2e4653fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 30" ;
    dzdoc:position 29 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_30_condition_0_0d0e23b2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_30_condition_1_20cc65ee> ;
    dzdoc:usesTerm dzterm:military_court,
        dzterm:minister_of_defense .

<https://legal.dz/resource/order/1971-04-22/71-28#art_310> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_310" ;
    dzdoc:fullText "إن أعمال العنف والإهانة التي يرتكبها عسكري أو كل شخص منتقل ضد رئيس أو سلطة مختصة أثناء الخدمة أو في معرض الخدمة، حتى ولو وقع ذلك خارج السفينة ، فيعاقب عن ذلك بالسجن المؤقت من خمس سنوات إلى عشر سنوات . وإذا كان المجرم ضابطا، أو عسكريا تحت السلاح ارتكب أعمال العنف فترفع العقوبة إلى عشرين سنة . وإذا وقعت أعمال العنف على متن مركبة من قبل عسكري أو كل شخص منتقل عليها ، ضد رئيس ، فتعتبر كأنها تمت أثناء الخدمة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_310> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_310_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_310_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_310_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_310_19710422_OpEnact_56c66b50ec> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_310_obligation_0_d1876b88>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_310_obligation_1_7d08ba9a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "310" ;
    dzdoc:position 309 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_310_condition_0_8096d8d5>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_310_condition_1_ff7239ee>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_310_condition_2_5d3f76cb> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_9> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "إن قاضي التحقيق العسكري له السلطة باتهام أي شخص خاضع للمحاكم العسكرية، ساهم كفاعل أو شريك في الأفعال المنسوبة إليه وذلك بعد صدور الرأي الموافق من وكيل الدولة العسكري ، كما يمكنه تعديل الاتهام عندما يجب إعطاء وصف جديد لهذه الأفعال يؤدي لعقوبة أشد . وفي حالة عدم الاتفاق بين قاضي التحقيق ووكيل الدولة العسكري ، يتعين على هذا الأخير، أن يرفع الأمر بموجب عريضة إلى المحكمة العسكرية لتنظر فيها في أقرب جلسة لها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_86_right_0_96cba79b>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_86_right_1_2ecf297e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_86_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_86_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_86_19710422_OpEnact_6a86afd43e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_86_obligation_0_4de0172c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "86" ;
    dzdoc:position 85 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_86_condition_0_bd673d64>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_86_condition_1_d559c8f9> ;
    dzdoc:usesTerm dzterm:military_investigating_judge .

<https://legal.dz/resource/order/1971-04-22/71-28#art_150> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_5> ;
    dzdoc:eId "art_150" ;
    dzdoc:fullText "يختص قضاء الحكم بتقدير المخالفات الشكلية التي كانت نتيجتها الحيلولة دون إظهار الحقيقة أو الإضرار جوهريا بحقوق الدفاع . وتنظر المحكمة في الدفوع المدلى بها في الجلسة عن طريق المذكرات، قبل قفل باب المرافعات، أو تقرر خلال المرافعات بأن يضم الطلب العارض للموضوع للبت فيه بحكم واحد إذا رأت ذلك مناسبا . إن الدفوع المتعلقة بتشكيل المحكمة العسكرية أو بصحة رفع الدعوى إليها، يجب أن تقدم لهذه الأخيرة بموجب مذكرة دفاع قبل المرافعة في الموضوع وإلا تكون غير مقبولة . وتبت المحكمة في الحال في هذه الدفوع بموجب حكم واحد، وتأمر بإحالة القضية إذا لزم الأمر ذلك ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_150_right_0_cc3698e3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_150> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_150_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_150_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_150_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_150_19710422_OpEnact_6a5c4f4b43> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_150_obligation_0_1af58330>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_150_obligation_1_1dd18cbe>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_150_obligation_2_c76b9081>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_150_obligation_3_3b48649d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "150" ;
    dzdoc:position 149 ;
    dzdoc:usesTerm dzterm:court,
        dzterm:judgment_judiciary,
        dzterm:military_court .

<https://legal.dz/resource/order/1971-04-22/71-28#art_169> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_3_subsec_2> ;
    dzdoc:eId "art_169" ;
    dzdoc:fullText "يضمن الحكم إلزام المتهم بالمصاريف لصالح الدولة وينص فيه على الإكراه البدني وذلك في حالة الإدانة أو الإعفاء من العقاب . ويؤمر في الحكم علاوة على ذلك، في الأحوال المنصوص عليها بالقانون بمصادرة الأشياء المحجوزة، وبرد جميع الأشياء المحجوزة أو المقدمة في الدعوى كوثائق مؤدية للتهمة، إما لصالح الدولة أو لصالح مالكيها . وإذا لم يحكم برد الأشياء الموضوعة تحت يد القضاء، في حكم الإدانة فيمكن طلب ردها بعريضة ترفع للمحكمة العسكرية التي أصدرت الحكم . و إذا ألغيت هذه الأخيرة ، فـ لـ وزير الدفاع الوطني أن يعين المحكمة التي يطلب إليها أن تبت في الطلب ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_169_right_0_4ad70039> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_169> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_169_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_169_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_169_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_169_19710422_OpEnact_0425b62e27> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_169_obligation_0_fd9757ef>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_169_obligation_1_12eb1323>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_169_obligation_2_6c3c566c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 169" ;
    dzdoc:position 168 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_169_condition_0_d25d42d6>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_169_condition_1_b1af23b2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_169_condition_2_6e7bd1c5> ;
    dzdoc:usesTerm dzterm:minister_of_defense .

<https://legal.dz/resource/order/1971-04-22/71-28#art_174> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_3_subsec_2> ;
    dzdoc:eId "art_174" ;
    dzdoc:fullText "بعد أن يصدر الرئيس الحكم ، ينبه على المحكوم عليه ، إذا لزم الأمر ، بأن من حقه أن يطعن في الحكم بالنقض ويذكر له مهلة الطعن . وإذا تقرر منح المحكوم عليه توقيف التنفيذ ، فـ ينبغي كذلك على الرئيس أن ينبهه إلى أنه في حالة صدور عقوبة جديدة ضمن الأوضاع المنصوص عليها في المادة 231 ، يمكن تنفيذ العقوبة الأولى دون إمكان ضمها مع الثانية ، و عند اللزوم كذلك، بأن عقوبات العود يمكن أن تطبق ضمن تحفظات المادة 232 من هذا القانون أو المادتين 445 و 465 من قانون العقوبات . ويذكر في أصل الحكم ما يشير إلى استكمال الاجراءات السابقة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_174_permission_0_76090b2e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_174> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_174_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_174_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_174_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_174_19710422_OpEnact_ac99a12222> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_174_obligation_0_b5a8765d>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_174_obligation_1_ae58daf0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_174_obligation_2_a5440a82>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_174_obligation_3_328cbea2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
