<https://legal.dz/resource/order/1971-04-22/71-28#version_art_293> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل عسكري مكلف بضبط محاسبة الأموال أو المواد يرتكب تزويرا في حساباته أو يستعمل أوراقا مزورة يعاقب بالسجن المؤقت من خمس سنوات إلى عشرين سنة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
