<https://legal.dz/resource/order/1971-04-22/71-28#version_art_37> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا طبقت أحكام المادة 35 أو المادة 36 عند صدور حكم بالإحالة ، يأمر وزير الدفاع الوطني بنقل الاختصاص. وفي زمن الحرب ، يجوز نقل ملفات الاجراءات القائمة أمام المحكمة العسكرية بناء على قرار معلل لوزير الدفاع الوطني إلى محكمة عسكرية أخرى، في الحالة التي تكون عليها، وعندما تستدعي الظروف ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_37_19710422_OpEnact_4c9dcf395a> ;
    dzdoc:replacementText "إذا طبقت أحكام المادة 35 أو المادة 36 عند صدور حكم بالإحالة ، يأمر وزير الدفاع الوطني بنقل الاختصاص. وفي زمن الحرب ، يجوز نقل ملفات الاجراءات القائمة أمام المحكمة العسكرية بناء على قرار معلل لوزير الدفاع الوطني إلى محكمة عسكرية أخرى، في الحالة التي تكون عليها، وعندما تستدعي الظروف ذلك."@ar ;
