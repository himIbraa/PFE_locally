<https://legal.dz/resource/order/1971-04-22/71-28#art_187_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_187> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا صدر الإبطال لعدم مراعاة الاجراءات الشكلية، يعاد السير في الدعوى وفقا للقواعد المنصوص عليها في هذا القانون."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_187_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_187> ;
    dzdoc:position 1 ;
    dzdoc:text "فتبت المحكمة الناظرة في الدعوى، دون أن تكون ملزمة بإتباع حكم المجلس الأعلى."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_187_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_187> ;
    dzdoc:position 2 ;
    dzdoc:text "بيد أنه، إذا صدر حكم ثان بالإبطال بناء على طعن جديد، لنفس الأسباب الواردة في الحكم الأول، فيجب على المحكمة التي تحال إليها القضية، أن تتقيد بحكم المجلس الأعلى فيما يتعلق بالنقطة القانونية، وإذا تعلق الأمر بتطبيق العقوبة، وجب عليها اعتماد ما يفسر على الوجه الأوفر لفائدة المحكوم عليه."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_188_condition_0_0ed9b4bd> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1971-04-22/71-28#art_188_condition_0_0ed9b4bd_role_307015bbb3> ;
    dznorm:conditionText "إذا صدر إبطال الحكم بسبب الخطأ في تطبيق العقوبة على الأفعال التي اعتبر المحكوم عليه مذنبا عنها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_188> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_188_condition_0_0ed9b4bd_role_307015bbb3> a dznorm:Role ;
    rdfs:label "الأفعال التي اعتبر المحكوم"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "إذا صدر إبطال الحكم بسبب الخطأ في تطبيق العقوبة على الأفعال التي اعتبر المحكوم عليه مذنبا عنها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_188> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_188_obligation_0_af9bf307> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_188> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا تبت المحكمة الجديدة الناظرة في القضية إلا بشأن تطبيق العقوبة"@ar ;
    dznorm:sourceArticle "art_188" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_188_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_188> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا صدر إبطال الحكم بسبب الخطأ في تطبيق العقوبة على الأفعال التي اعتبر المحكوم عليه مذنبا عنها، فيبقى الوضع على حاله بالنسبة للاتهام ووجود الظروف المشددة أو المخففة، ولا تبت المحكمة الجديدة الناظرة في القضية إلا بشأن تطبيق العقوبة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_189_extref_21947bb2> a dzdoc:ExternalReference ;
    rdfs:label "المادة 530 من قانون الاجراءات الجزائية"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/1966-06-08/66-155#art_530"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-155#art_530"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/1966-06-08/66-155#art_530" ;
    dzdoc:resolutionReason "unindexed_text_pattern" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-155"^^xsd:anyURI ;
    dzdoc:targetEId "art_530" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_189_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_189> ;
    dzdoc:position 0 ;
    dzdoc:text "تسري على أحكام المحاكم العسكرية، أحكام المادة 530 من قانون الاجراءات الجزائية المتعلقة بـ الطعن لصالح القانون."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_18_condition_0_365e47f1> a dznorm:Condition ;
    dznorm:conditionText "ما لم يسمح له بذلك رئيس المحكمة العسكرية الدائمة الناظرة في القضية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_18> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_18_obligation_0_a82ff834> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_18> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتولى مهمة الدفاع أمام المحاكم العسكرية المحامون المقيدون في قائمة المحامين أو عسكري مقبول من السلطة العسكرية"@ar ;
    dznorm:sourceArticle "art_18" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_18_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_18> ;
    dzdoc:position 0 ;
    dzdoc:text "يتولى مهمة الدفاع أمام المحاكم العسكرية المحامون المقيدون في قائمة المحامين أو عسكري مقبول من السلطة العسكرية. أما القضايا المتعلقة بالجرائم الخاصة العسكرية المنصوص عليها في هذا القانون، فلا يجوز فيها للمدافع المختار من قبل المتهم أن يحضر مع المتهم أو يدافع عنه أو يمثله سواء كان أثناء التحقيق أو الجلسة ما لم يسمح له بذلك رئيس المحكمة العسكرية الدائمة الناظرة في القضية، وإلا فيعين المدافع من قبل الرئيس."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_18_permission_0_1615fe6d> a dznorm:Permission ;
