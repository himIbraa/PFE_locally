<https://legal.dz/resource/order/1971-04-22/71-28#version_art_275> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالإعدام، كل قائد تشكيلة عسكرية أو قوة بحرية أو جوية أو سفينة بحرية أو طائرة عسكرية ، ثبت استسلامه للعدو أو إصداره الأمر بوقف القتال أو إنزال الراية بدون أن يستنفد جميع وسائل الدفاع المتوفرة لديه و بدون أن يعمل بكل ما يفرضه عليه الواجب والشرف ، وذلك بناء على إحالته للمحاكمة بعد أخذ رأي مجلس التحقيق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_275_19710422_OpEnact_eee7b497e2> ;
