<https://legal.dz/resource/order/1971-04-22/71-28#version_art_188> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا صدر إبطال الحكم بسبب الخطأ في تطبيق العقوبة على الأفعال التي اعتبر المحكوم عليه مذنبا عنها ، فيبقى الوضع على حاله بالنسبة للاتهام ووجود الظروف المشددة أو المخففة، و لا تبت المحكمة الجديدة الناظرة في القضية إلا بشأن تطبيق العقوبة ."@ar ;
