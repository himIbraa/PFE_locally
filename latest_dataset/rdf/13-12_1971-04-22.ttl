<https://legal.dz/resource/order/1971-04-22/71-28#version_art_139> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما ترتكب جنايات أو جنح من غير ما هو منصوص عليه في المادتين 137 و 138 ، في مكان انعقاد الجلسات ، فإن الرئيس يحرر محضرا بالوقائع وشهادات الشهود ويحيل مرتكب الجريمة أمام السلطة المختصة."@ar ;
    dzdoc:isAuthoritative true ;
