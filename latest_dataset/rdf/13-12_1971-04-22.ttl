    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد جاسوسا و يعاقب بالإعدام مع التجريد العسكري : كل عسكري يدخل إلى موقع حربي أو إلى مركز عسكري أو مؤسسة عسكرية أو إلى ورشة عسكرية أو إلى معسكر أو مخيم أو أماكن الجيش لكي يحصل على وثائق أو معلومات لفائدة العدو. كل عسكري يعطي العدو وثائق أو معلومات من شأنها أن تضر عمليات الجيش أو تمس أمن الوقائع أو المراكز أو المؤسسات العسكرية الأخرى. كل عسكري يخفي بنفسه أو بواسطة غيره الجواسيس أو الأعداء المرسلين للكشف، وهو على علم بذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_280_19710422_OpEnact_469c75bc1e> ;
    dzdoc:replacementText "يعد جاسوسا و يعاقب بالإعدام مع التجريد العسكري : كل عسكري يدخل إلى موقع حربي أو إلى مركز عسكري أو مؤسسة عسكرية أو إلى ورشة عسكرية أو إلى معسكر أو مخيم أو أماكن الجيش لكي يحصل على وثائق أو معلومات لفائدة العدو. كل عسكري يعطي العدو وثائق أو معلومات من شأنها أن تضر عمليات الجيش أو تمس أمن الوقائع أو المراكز أو المؤسسات العسكرية الأخرى. كل عسكري يخفي بنفسه أو بواسطة غيره الجواسيس أو الأعداء المرسلين للكشف، وهو على علم بذلك."@ar ;
