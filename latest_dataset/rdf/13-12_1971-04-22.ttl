<https://legal.dz/resource/order/1971-04-22/71-28#art_254_obligation_0_c48c393a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1971-04-22/71-28#art_254_obligation_0_c48c393a_action_ccab2c702a> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_254> ;
    dznorm:position 0 ;
    dznorm:provisionText "ولا يجوز فرض العقوبات الآنفة الذكر، دون تطبيق الأحكام المنصوص عليها في القوانين المتعلقة بالتجنيد"@ar ;
    dznorm:sourceArticle "art_254" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_254_obligation_0_c48c393a_action_ccab2c702a> a dznorm:Action ;
    rdfs:label "فرض العقوبات الآنفة الذكر"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "ولا يجوز فرض العقوبات الآنفة الذكر، دون تطبيق الأحكام المنصوص عليها في القوانين المتعلقة بالتجنيد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_254> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_254_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_254> ;
    dzdoc:position 0 ;
    dzdoc:text "كل شخص يرتكب جرم العصيان المنصوص عليه في القوانين المتعلقة بالتجنيد، يعاقب في زمن السلم، بالحبس من 3 أشهر إلى 5 سنوات."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_254_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_254> ;
    dzdoc:position 1 ;
    dzdoc:text "وتكون العقوبة في زمن الحرب، الحبس من سنتين إلى 10 سنوات، ويمكن أن يحرم المحكوم عليه جزئيا أو كليا من ممارسة الحقوق المذكورة في المادة 8 من قانون العقوبات لمدة 5 سنوات على الأقل و20 سنة على الأكثر."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_254_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_254> ;
    dzdoc:position 2 ;
    dzdoc:text "إذا كان المجرم ضابطا فيمكن أن تطبق عليه في زمن الحرب عقوبة العزل."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_254_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_254> ;
    dzdoc:position 3 ;
