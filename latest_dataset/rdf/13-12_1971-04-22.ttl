    dzdoc:evidenceText "تنفذ العقوبات السالبة للحرية التي تقضي بها المحاكم العسكرية طبقا لأحكام القانون العام مع مراعاة أحكام المادة 224 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
