<https://legal.dz/resource/order/1971-04-22/71-28#version_art_240> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحكم على المتهم بالمصاريف الواجبة الأداء للدولة في حالة الحكم أو العفو ، و تقضي المحكمة بالإكراه البدني إلا إذا طبقت أحكام المادة 199 . تحدد المصاريف التي تدخل تحت تسمية المصاريف القضائية أمام جميع المحاكم العسكرية، بموجب مرسوم يصدر بناء على تقرير وزير الدفاع الوطني و وزير المالية . فتنظم بموجبه عموما كافة ما يتعلق بالمصاريف القضائية، ولا سيما التعريفات وطرق الدفع والتحصيل وطرق الطعن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_240_19710422_OpEnact_31d3c7a2d6> ;
    dzdoc:replacementText "يحكم على المتهم بالمصاريف الواجبة الأداء للدولة في حالة الحكم أو العفو ، و تقضي المحكمة بالإكراه البدني إلا إذا طبقت أحكام المادة 199 . تحدد المصاريف التي تدخل تحت تسمية المصاريف القضائية أمام جميع المحاكم العسكرية، بموجب مرسوم يصدر بناء على تقرير وزير الدفاع الوطني و وزير المالية . فتنظم بموجبه عموما كافة ما يتعلق بالمصاريف القضائية، ولا سيما التعريفات وطرق الدفع والتحصيل وطرق الطعن."@ar ;
