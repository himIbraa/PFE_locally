<https://legal.dz/resource/order/1971-04-22/71-28#version_art_12> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز إلحاق العسكريين من غير الضباط والتابعين لأسلاك الجند أو المصالح، ليمارسوا بصفتهم مساعدين، وظائف مستكتبي الضبط أو محضرين. فيقوم هؤلاء بأعمال الجلسات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_12_19710422_OpEnact_a2a505e520> ;
    dzdoc:replacementText "يجوز إلحاق العسكريين من غير الضباط والتابعين لأسلاك الجند أو المصالح، ليمارسوا بصفتهم مساعدين، وظائف مستكتبي الضبط أو محضرين. فيقوم هؤلاء بأعمال الجلسات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
