<https://legal.dz/resource/order/1971-04-22/71-28#art_102> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_102" ;
    dzdoc:fullText "سواء كان التدبير مقررا بموجب أمر قضائي أو حكم غيابي، فيساق الضنين أو المتهم أو المحكوم عليه إما إلى سجن التوقيف فيعتقل في جناح خاص بالعسكريين أو إلى سجن عسكري، وإذا لم يمكن، فإلى مؤسسة تعينها السلطة العسكرية ضمن الشروط المنصوص عليها في مرسوم يصدر بناء على تقرير وزير الدفاع الوطني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_102_permission_0_f4da3467> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_102> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_102_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_102_19710422_OpEnact_ef7b06c344> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 102" ;
    dzdoc:position 101 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_102_condition_0_3f7b61da> ;
    dzdoc:usesTerm dzterm:accused,
        dzterm:convicted,
        dzterm:defendant,
        dzterm:minister_of_defense .

<https://legal.dz/resource/order/1971-04-22/71-28#art_187> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_187" ;
    dzdoc:fullText "إذا صدر الإبطال لعدم مراعاة الاجراءات الشكلية ، يعاد السير في الدعوى وفقا للقواعد المنصوص عليها في هذا القانون. فتبت المحكمة الناظرة في الدعوى، دون أن تكون ملزمة بإتباع حكم المجلس الأعلى . بيد أنه، إذا صدر حكم ثان بالإبطال بناء على طعن جديد، لنفس الأسباب الواردة في الحكم الأول ، فيجب على المحكمة التي تحال إليها القضية، أن تتقيد بحكم المجلس الأعلى فيما يتعلق بالنقطة القانونية ، و إذا تعلق الأمر بتطبيق العقوبة ، وجب عليها اعتماد ما يفسر على الوجه الأوفر لفائدة المحكوم عليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_187> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_187_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_187_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_187_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_187_19710422_OpEnact_de073a98fb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_187_obligation_0_2a22886d>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_187_obligation_1_fd36d600> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "187" ;
    dzdoc:position 186 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_187_condition_0_02ead71f>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_187_condition_1_08784c2e>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_187_condition_2_f4322e7d> ;
    dzdoc:usesTerm dzterm:court,
        dzterm:supreme_council .

<https://legal.dz/resource/order/1971-04-22/71-28#art_226> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_7> ;
    dzdoc:eId "art_226" ;
    dzdoc:fullText "يبقى الحكم على طابعه النهائي رغم صدور الأمر بإيقاف تنفيذه. وتقيد العقوبة في صحيفة السوابق القضائية مع ذكر الإيقاف الممنوح ما عدا الاستثناءات المنصوص عليها في المادة 238 . ويدرج أمر إيقاف التنفيذ على هامش أصل الحكم وينبغي إدراجه على كل نسخة أو ملخص من الحكم . ويسري مفعول الإيقاف الذي يمكن أن يشمل كلا أو جزء من مقتضيات الحكم، من تاريخ صدور القرار به. إن إسقاطات الحق والنفقات القضائية، لا يمكن أن تكون موضوع تدبير بالإيقاف."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_226_permission_0_01e26128>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_226_permission_1_b9e48b72> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_226> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_226_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_226_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_226_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_226_para_3>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_226_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_226_19710422_OpEnact_a0b51e005b> ;
