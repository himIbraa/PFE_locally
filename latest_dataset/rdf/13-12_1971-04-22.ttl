<https://legal.dz/resource/order/1971-04-22/71-28#art_160> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_8> ;
    dzdoc:eId "art_160" ;
    dzdoc:fullText "يجوز للرئيس أيضا أن يطرح من تلقاء نفسه أسئلة احتياطية إذا تبين من خلال المرافعات بأن الفعل الأصلي يمكن اعتباره إما فعلا معاقبا عليه بعقوبة أخرى، وإما جناية أو جنحة تابعة للقانون العام ، ولكنه يجب عليه في هذه الحالة، أن يعبر عن نواياه في الجلسة العلنية قبل إقفال باب المرافعات ، ليتسنى للنيابة العامة والمتهم والدفاع من الإدلاء بملاحظاتهم في الوقت اللازم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_160_permission_0_2af7ab80> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_160_right_0_d421b85c>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_160_right_1_bcc98431> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_160> ;
