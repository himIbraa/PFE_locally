    dzdoc:replacementText "كل عسكري مرتكب جريمة الفرار إلى الخارج في زمن السلم يعاقب بالحبس من سنتين إلى عشر سنوات. وإذا كان المتهم ضابطا عوقب بالسجن المؤقت مع الأشغال من خمس سنوات إلى عشر سنوات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_262> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_262> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1971-04-22"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1971-04-22/71-28#version_art_263> a dzdoc:AmendmentEvent,
