    dzdoc:position 145 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_152>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_192>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_193> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_152>,
