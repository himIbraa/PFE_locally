<https://legal.dz/resource/order/1971-04-22/71-28#art_252_permission_0_e92ad427_action_7f09789319> a dznorm:Action ;
    rdfs:label "بأي حال أن تحل عقوبة"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "عندما يتعلق الأمر بجرم منصوص عليه في هذا القانون، مع الأخذ بالظروف المخففة، فلا يمكن بأي حال أن تحل عقوبة الحبس محل الغرامة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_252> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_253_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_253> ;
    dzdoc:position 0 ;
    dzdoc:text "إن المخالفات المرتكبة بحق الأنظمة المتعلقة بالتأديب والخارجة عن اختصاص المحاكم العسكرية، تخضع لقمع السلطة العسكرية وتطبق عليها العقوبات التأديبية، التي لا يمكن أن تتجاوز الستين يوما إذا كانت سالبة للحرية."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_253_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_253> ;
    dzdoc:position 1 ;
    dzdoc:text "يحدد سلم العقوبات التأديبية بموجب مرسوم."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_253_permission_0_904864e8> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
