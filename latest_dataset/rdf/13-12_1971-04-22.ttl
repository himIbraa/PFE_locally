    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_20> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_20_obligation_1_e559c14c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_20> ;
    dznorm:position 1 ;
    dznorm:provisionText "يعتبرون مجندين ضمن الشروط المنصوص عليها في القانون"@ar ;
    dznorm:sourceArticle "art_20" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_20_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_20> ;
    dzdoc:position 0 ;
    dzdoc:text "يحدد مقر المحاكم المقرر إحداثها بموجب مرسوم يصدر بناء على تقرير وزير الدفاع الوطني."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_20_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_20> ;
    dzdoc:position 1 ;
    dzdoc:text "إن القضاة الملحقين بـ المحاكم العسكرية الدائمة في وظائف تابعة للنيابة والتحقيق، والذين يدعون للقضاء في المحاكم المنشأة حديثا تطبيقا للفقرة السابقة، يعتبرون مجندين ضمن الشروط المنصوص عليها في القانون."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_210_condition_0_91195b9e> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يقدم طعن فيه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_210> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_210_condition_1_53155e5e> a dznorm:Condition ;
    dznorm:conditionText "إذا كانت العقوبة المحكوم بها هي الإعدام"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_210> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_210_obligation_0_3db3f92d> a dznorm:Obligation ;
