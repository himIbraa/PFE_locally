<https://legal.dz/resource/order/1971-04-22/71-28#art_112> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_112" ;
    dzdoc:fullText "يجوز طلب الإفراج المؤقت من رئيس الجهة العسكرية المختصة، ابتداء من اختتام التحقيق التحضيري لغاية انتهاء المحاكمة . بيد أن المحكمة عندما تنعقد للاطلاع على القضية ، فتكون وحدها مختصة للنظر في الإفراج المؤقت. وتكون القرارات الصادرة في هذا الموضوع غير قابلة لأي طريق من طرق الطعن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_112_permission_0_d9e046e3> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_112_right_0_3ea46f8e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_112> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_112_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_112_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_112_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_112_19710422_OpEnact_33705a82e3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "112" ;
    dzdoc:position 111 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_112_condition_0_36312394> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_113> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_113" ;
    dzdoc:fullText "يكون قضاء التحقيق أو قضاء الحكم الذي يفرج عن متهم من جنسية أجنبية أو يقرر الإفراج المؤقت عنه أو عن ضنين أو مشتكي عليه، هو وحده المختص بتحديد محل إقامة له و يحظر عليه الابتعاد عنه إلا بإذن قبل صدور قرار بمنع المحاكمة أو حكم نهائي ، تحت طائلة الحبس من ثلاثة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 50.000 دينار أو بإحدى هاتين العقوبتين فقط، وفضلا عن ذلك يقرر وجوب سحب جواز السفر مؤقتا. ويبلغ قرار تحديد محل الإقامة لوزير الداخلية المختص باتخاذ إجراءات مراقبة محل الإقامة المحدد وتسليم الأذون المؤقتة بالتنقل داخل الأراضي الجزائرية عند الاقتضاء . ويجرى إخبار قضاء التحقيق بذلك. ويعاقب من تهرب من إجراءات المراقبة بالعقوبات المنصوص عليها في الفقرة الأولى من هذه المادة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_113> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_113_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_113_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_113_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_113_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_113_19710422_OpEnact_a8c4547375> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_113_obligation_0_36088354>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_113_obligation_1_8cd974df> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "113" ;
    dzdoc:position 112 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_113> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_113> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_123> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_3> ;
    dzdoc:eId "art_123" ;
    dzdoc:fullText "عندما تصدر المحكمة العسكرية ، حكما بإلغاء أمر قاضي التحقيق العسكري في أي موضوع مما ذكر في المادة 122 ، فيمكنها أن تقرر ما يلي : إما إعادة الملف إلى قاضي التحقيق العسكري لمتابعة التحقيق، وإما إحالة القضية إلى قضاء الحكم، بعد أن تكون قد أجرت تحقيقا إضافيا أم لا. وفي هاتين الحالتين يستمر في حبس المتهم ما لم تقرر المحكمة العسكرية خلاف ذلك. وعندما تأمر المحكمة العسكرية المنعقدة بهيئة غرفة الاتهام بإحالة القضية ، فينبغي أن يتضمن هذا الأمر، تحت طائلة البطلان، بيان الوقائع والوصف القانوني للأفعال المنسوبة للمتهم . فإذا كان الفعل يكون مخالفة ، أفرج عن المتهم ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_123_right_0_20c613cd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_123> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_123_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_123_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_123_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_123_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_123_19710422_OpEnact_82cf51f9e7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_123_obligation_0_8503f151> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "123" ;
    dzdoc:position 122 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_122> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_122> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_123_condition_0_d9f15427>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_123_condition_1_432508b5>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_123_condition_2_7cec47f6> ;
    dzdoc:usesTerm dzterm:military_court,
        dzterm:military_investigating_judge .

<https://legal.dz/resource/order/1971-04-22/71-28#art_135> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_135" ;
    dzdoc:fullText "يجوز للمحكمة أن تمنع ضبط المرافعات في القضية بصفة كلية أو جزئية ، ويجري هذا المنع بحكم القانون إذا تقرر إجراء المرافعات في جلسة سرية ، ولا يطبق هذا المنع على الحكم في الموضوع، و كل مخالفة لهذا المنع يعاقب عليها بالحبس من 10 أيام إلى 3 أشهر وبغرامة من 3.600 إلى 18.000 دج . وتجري الملاحقة طبقا لأحكام قانون الصحافة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_135_permission_0_3583ff83> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_135_right_0_257c9cba> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_135> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_135_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_135_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_135_19710422_OpEnact_169dbd79a8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_135_obligation_0_bf111979> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 135" ;
    dzdoc:position 134 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_135_condition_0_4018a741> ;
    dzdoc:usesTerm dzterm:press_law .

<https://legal.dz/resource/order/1971-04-22/71-28#art_148> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_3_sec_2_subsec_4> ;
    dzdoc:eId "art_148" ;
    dzdoc:fullText "إذا تخلف أحد الشهود عن الحضور ، جاز للمحكمة : أما صرف النظر عنه والسير بالمرافعات، ثم تلاوة شهادته المؤداة في التحقيق إذا كان محلا لذلك، فيما إذا طلب تلاوتها المدافع أو النيابة العامة، وأما تطبيق أحكام المادة 299 من قانون الاجراءات الجزائية . بيد أن التكليف بالحضور للمحكمة يبقى خاضعا للقواعد المنصوص عليها في المادة 128 ، وفي حالة الحكم على الشاهد المتخلف، يبقى طريق المعارضة فيه جائزا له أمام المحكمة العسكرية التي أصدرت الحكم، أو في حالة إلغاء هذه، أمام المحكمة المعينة من طرف وزير الدفاع الوطني. وفي زمن الحرب ، تقصر مهلة المعارضة ليومين بالنسبة للشاهد المحكوم عليه لتخلفه عن الحضور ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_148_right_0_bb006379> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_148> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_148_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_148_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_148_19710422_OpEnact_46d817ed12> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_148_obligation_0_b163f780> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "148" ;
    dzdoc:position 147 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_128> ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_148_extref_54cad1e0> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_128> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_148_condition_0_7a46bdb0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_148_condition_1_5d8cf627> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_182> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_182" ;
    dzdoc:fullText "يجوز أيضا لوكيل الدولة العسكري أن يطعن بالنقض ضد : أحكام البراءة، الأحكام القاضية بمنع المحاكمة، الأحكام الفاصلة برد الأشياء المحجوزة ضمن الشروط المنصوص عليها في المادة 169 من هذا القانون . ولا يجوز أن تمس هذه الطعون في حقوق المتهم ، إلا في الحالة الأولى، عندما يكون الحكم قد أغفل الفصل في أحد عناصر الاتهام، أو في الحالة الثانية، إذا حصل في الحكم تطبيق خاطئ في دعوى شملها انقضاء الدعوى العمومية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_182_permission_0_5e8f0917>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_182_permission_1_01b1be50> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_182_right_0_59693131> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_182> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_182_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_182_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_182_19710422_OpEnact_9ca5c98744> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "182" ;
    dzdoc:position 181 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_169> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_169> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_182_condition_0_fe9ef3a7> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_196> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_5> ;
    dzdoc:eId "art_196" ;
    dzdoc:fullText "تبلغ أوراق التكليف بالحضور والأحكام القضائية ضمن الأوضاع التالية : يرسل وكيل الدولة العسكري إلى العون المكلف بالتبليغ ما يلي : نسخة الورقة لتسليمها إلى المرسل إليه، محضر في ثلاث نسخ، مخصص لإثبات تبليغ المعني أو غيابه عن محل إقامته المعين. ويجب أن يذكر في المحضر ما يلي : اسم ومهمة أو صفة السلطة الطالبة، اسم ووظيفة أو صفة العون المكلف بالتبليغ، اسم ولقب وعنوان الشخص الذي أرسلت إليه الورقة، تاريخ وساعة تسليم الورقة، أو عدم إمكان الاتصال بالمرسل إليه في محل الإقامة المعين. ويوقع المحضر من قبل العون وكذلك من قبل المرسل إليهم إذ حصل تبليغهم الورقة شخصيا ، وفي حالة رفض التوقيع أو عدم إمكانية التوقيع، يذكر ذلك في المحضر، فترسل نسختان من محضر التبليغ أو إثبات الغياب إلى وكيل الدولة العسكري . وفي حالة التبليغ شخصيا، تترك نسخة واحدة للمرسل إليه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_196> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_196_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_196_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_196_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_196_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_196_19710422_OpEnact_e2b76f7b92> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_196_obligation_0_1ce68cf9>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_196_obligation_1_ca2270bc>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_196_obligation_2_b0f2bfcc>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_196_obligation_3_f70fdec6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "196" ;
    dzdoc:position 195 ;
    dzdoc:usesTerm dzterm:military_prosecutor .

<https://legal.dz/resource/order/1971-04-22/71-28#art_198> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_5> ;
    dzdoc:eId "art_198" ;
    dzdoc:fullText "إذا لم يتم تسليم أوراق التكليف بالحضور والتبليغات، إلى الشخص المطلوب تبليغه ، فتطبق القواعد التالية: إذا كان الأمر يتعلق بعسكري متغيب بصفة غير قانونية ، يتم التكليف بالحضور أو التبليغ إلى الهيئة العسكرية التي ينتمي إليها ، وتسلم نسخة الورقة ضمن ظرف مغلق لا تحتوي إلا على البيانات الخاصة بالاسم واللقب والرتبة والقطعة العسكرية التي يكون المرسل إليه تابعا لها. وإذا لم يكن للمرسل إليه، أيا كان موطن معلوم أو كان بحث عنه بدون جدوى أو كان مقيما في بلد أجنبي ، فيتم تكليفه بالحضور وتبليغه إلى النيابة التابعة للمحكمة العسكرية الناظرة في القضية . ويؤشر وكيل الدولة العسكري على النسخة الأصلية من الورقة ويرسل النسخة عند الاقتضاء إلى جميع السلطات المؤهلة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_198> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_198_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_198_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_198_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_198_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_198_19710422_OpEnact_bd152b290c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_198_obligation_0_1bffbea3>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_198_obligation_1_ffcc8bb1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "198" ;
    dzdoc:position 197 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_198_condition_0_36443953>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_198_condition_1_e1faeae4>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_198_condition_2_d3bd4823> ;
    dzdoc:usesTerm dzterm:military_prosecutor .

<https://legal.dz/resource/order/1971-04-22/71-28#art_201> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_1_subsec_2> ;
    dzdoc:eId "art_201" ;
    dzdoc:fullText "لا يجوز لأي مدافع أن يحضر للدفاع عن المتهم . ويطلع الرئيس المحكمة على الوقائع وشهادات الشهود. ويصدر الحكم في الشكل العادي ويبلغ طبقا لـ المادة 199 ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_201_permission_0_a373352a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_201> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_201_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_201_19710422_OpEnact_bb0c01fb6f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_201_obligation_0_2af44a3b> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1971-04-22/71-28#art_201_prohibition_0_a373352a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 201" ;
    dzdoc:position 200 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_199> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_199> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_231> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_9> ;
    dzdoc:eId "art_231" ;
    dzdoc:fullText "إن الحكم الذي يصدر عن جناية أو جنحة عسكرية : يترتب عليه فقدان المحكوم عليه للاستفادة من وقف التنفيذ، الممنوح له سابقا عن جريمة تابعة للقانون العام ، ولا يحول دون منح المحكوم عليه فيما بعد، وقف التنفيذ عن جريمة تابعة للقانون العام، وذلك إذا كانت العقوبة الصادرة عن الجريمة التابعة للقانون العام المذكور موقوفا تنفيذها طبقا لهذا المقتضى ، فتبقى بالتالي منفعة وقف التنفيذ الممنوح حين الحكم بالعقوبة عن الجريمة العسكرية حقا مكتسبا للمحكوم عليه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_231_right_0_09c9481c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_231> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_231_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_231_19710422_OpEnact_2ce9ae182b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_231_obligation_0_0330a26e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 231" ;
    dzdoc:position 230 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_231_condition_0_2d11d3a0> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_232> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_6_sec_9> ;
    dzdoc:eId "art_232" ;
    dzdoc:fullText "إن العقوبات الصادرة عن جناية أو جنحة عسكرية لا يمكن أن تجعل المحكوم عليه في حالة العود. وتطبق المحاكم العسكرية أحكام المادة 54 وما يليها من قانون العقوبات على الحكم في الجرائم التابعة للقانون العام."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_232_permission_0_ff154309> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_232> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_232_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_232_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_232_19710422_OpEnact_5a3fba8dcd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 232" ;
    dzdoc:position 231 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_232_extref_bb772452> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_256> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_1_subsec_2> ;
    dzdoc:eId "art_256" ;
    dzdoc:fullText "كل عسكري مرتكب جريمة الفرار في زمن السلم إلى داخل التراب، يعاقب بالحبس من ستة أشهر إلى خمس سنوات . وإذا وقع الفرار في زمن الحرب أو في أراض فرضت عليها حالة الحكم العرفي أو حالة الطوارئ يحكم عليه بالعقوبة من سنتين إلى عشر سنوات . وفي مطلق الأحوال، إذا كان المجرم ضابطا ، يحكم عليه علاوة على ذلك، بعقوبة العزل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_256> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_256_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_256_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_256_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_256_19710422_OpEnact_ac742afbfb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_256_obligation_0_4bca526a>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_256_obligation_1_0f0ec998>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_256_obligation_2_58fb9a14> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "256" ;
    dzdoc:position 255 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_256_condition_0_26d5cbf5>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_256_condition_1_18a3137d> ;
    dzdoc:usesTerm dzterm:desertion_crime,
        dzterm:military .

<https://legal.dz/resource/order/1971-04-22/71-28#art_257> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:definesTerm dzterm:desertion_conspiracy ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_1_subsec_2> ;
    dzdoc:eId "art_257" ;
    dzdoc:fullText "يعتبر بمثابة فرار مع التآمر ، كل فرار حاصل بتواطؤ أكثر من شخصين . ويعاقب على الفرار للداخل مع التآمر، بما يلي: أ - بالحبس من سنة واحدة إلى عشر سنوات، في زمن السلم ، ب - بالسجن المؤقت مع الأشغال من خمس سنوات إلى خمسة عشر سنة، في زمن الحرب ، و إذا كان المجرم ضابطا ، يحكم عليه علاوة على ذلك بعقوبة العزل . 2 - الفرار إلى خارج البلاد"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_257> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1971-04-22/71-28#art_257_defocc_7a4baf20352e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_257_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_257_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_257_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_257_19710422_OpEnact_292e567aa7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_257_obligation_0_e751c105>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_257_obligation_1_471b6f06>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_257_obligation_2_c69012b7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "257" ;
    dzdoc:position 256 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_257_condition_0_18a3137d> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_305> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_305" ;
    dzdoc:fullText "كل تعد أو مقاومة بالعنف مع استعمال الشدة يرتكبها عسكري أو شخص منتقل، ضد القوة المسلحة أو أعوان السلطة يعاقب عنه بالحبس من شهرين إلى سنة واحدة إذا حصل التمرد بدون أسلحة . وإذا حصل التمرد وكان الفاعل مسلحا، عوقب عنه بالحبس ذاته من سنة إلى ثلاث سنوات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_305> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_305_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_305_19710422_OpEnact_1d2aa3d805> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_305_obligation_0_cabd0a11>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_305_obligation_1_1b4be713> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "305" ;
    dzdoc:position 304 .

<https://legal.dz/resource/order/1971-04-22/71-28#art_322> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_3_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_322" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى سنتين كل عسكري أساء استعمال السلطات المعطاة له بالمصادرة العسكرية، أو رفض أن يعطي وصلا بالكميات التي تسلمها. وكل عسكري مارس المصادرة وهو غير متمتع بهذه السلطة يعاقب بالحبس من سنة إلى خمس سنوات إذا حصلت المصادرة بدون عنف. وإذا حصلت المصادرة بعنف يعاقب بالسجن المؤقت مع الأشغال من خمس سنوات إلى عشر سنوات. ولا يحول الحكم بهذه العقوبات دون الحكم على المجرم بإعادة الأشياء المصادرة. وإذا كان المجرم ضابطا فيعاقب، فضلا عن ذلك بفقدان الرتبة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_322> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_322_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_322_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_322_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_322_para_3>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_322_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_322_19710422_OpEnact_6ee6820f40> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_322_obligation_0_15b302e9>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_322_obligation_1_572301af>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_322_obligation_2_e25f21bf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "322" ;
    dzdoc:position 321 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_322_condition_0_9fe340f7> ;
    dzdoc:usesTerm dzterm:military .

<https://legal.dz/resource/order/1971-04-22/71-28#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_1_chp_2_sec_4> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "عندما يكون المتقاضي معتقلا لأي سبب كان، في دائرة اختصاص محكمة عسكرية ، يمكن لهذه الأخيرة أن تنظر في جميع الجرائم الداخلة في اختصاص القضاء العسكري."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1971-04-22/71-28#art_36_permission_0_39910fde> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_36_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_36_19710422_OpEnact_e380fe4a99> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "36" ;
    dzdoc:position 35 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_36_condition_0_dec5c5dc> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "يعمل ضباط الشرطة القضائية العسكرية في زمن الحرب طبقا للقواعد المحددة لكل حالة في المادة 57 و الفقرة 2 من المادة 58 و الفقرة 1 من المادة 59 و المادتين 60 و 62 عندما يرون أنه يجب الاحتفاظ بالأشخاص غير العسكريين المقدمين للمحاكم العسكرية، لضرورات التحقيق أو لتنفيذ إنابة قضائية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_64_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_64_19710422_OpEnact_c5561ac04f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "المادة 64" ;
    dzdoc:position 63 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_57>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_58>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_59>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_60>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_62> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_57>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_58>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_59>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_60>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_62> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_64_condition_0_e57ed11b> ;
    dzdoc:usesTerm dzterm:military_judicial_police_officers .

<https://legal.dz/resource/order/1971-04-22/71-28#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_1_chp_1_subsec_1> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "عندما يكون المتهم جنديا أو ضابط صف ، يتعين أن يكون واحد من القاضيين المساعدين ضابط وعندما يكون المتهم ضابطا ، يتعين أن يكون القاضيان المساعدان، ضابطين على الأقل من نفس رتبته . وتراعي في تشكيل المحكمة رتبة المتهم ومرتبته وقت حصول الوقائع المنسوبة إليه. وفي حالة تعدد المتهمين من ذوي الرتب والمراتب المختلفة ، فيراعى في ذلك الحد الأعلى للرتبة والأقدمية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_7_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_7_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_7_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_7_19710422_OpEnact_0144674c4a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_7_obligation_0_b690b9d2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_7_obligation_1_563a7910> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "7" ;
    dzdoc:position 6 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_7_condition_0_a50d8d31>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_7_condition_1_c5c6faa0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_7_condition_2_9cdc4069> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_10> ;
    dzdoc:eId "art_87" ;
    dzdoc:fullText "ينبغي مراعاة الأحكام المقررة في المادة 157 من قانون الاجراءات الجزائية والفقرة 1 من المادة 79 والفقرة 2 من المادة 80 من هذا القانون تحت طائلة بطلان الإجراء نفسه والاجراءات التالية له. وإن المتهم الذي لم تطبق عليه أحكام هذه المواد يمكنه أن يتنازل عن التمسك بالبطلان ويصحح بذلك الإجراء ، كما ينبغي أن يكون هذا التنازل صريحا وأن لا يتم إلا بحضور المدافع أو بعد دعوة هذا الأخير قانونا ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_87_right_0_6973d7d8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_87> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_87_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_87_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_87_19710422_OpEnact_50e593daca> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_87_obligation_0_48269c95>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_87_obligation_1_e0c24de6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "87" ;
    dzdoc:position 86 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_79>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_80> ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1971-04-22/71-28#art_87_extref_7cd7606f> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_79>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_80> ;
    dzdoc:usesTerm dzterm:accused .

<https://legal.dz/resource/order/1971-04-22/71-28#art_89> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_10> ;
    dzdoc:eId "art_89" ;
    dzdoc:fullText "يترتب البطلان كذلك، بصرف النظر عن البطلان المذكور في المادة 87 ، في حالة الإخلال بالأحكام الأساسية من هذا الباب ولا سيما في حالة الإخلال ب حقوق الدفاع . وتبت المحكمة العسكرية فيما إذا كان يجب حصر البطلان في الإجراء الفاسد أو مده على ما استتبعه من إجراءات بصفة كلية أو جزئية. ويجوز للمتهم التنازل عن التمسك بالبطلان المقرر لفائدته فقط ، و يجب أن يكون هذا التنازل صريحا . وتنظر المحكمة العسكرية في القضايا المرفوعة إليها وفقا لمآل المادة 88 ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_89_right_0_a36687fe>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_89_right_1_6bd7f090> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_89> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_89_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_89_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_89_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_89_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_89_19710422_OpEnact_9b1821e5ff> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1971-04-22/71-28#art_89_obligation_0_c553e65e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "89" ;
    dzdoc:position 88 ;
    dzdoc:references <https://legal.dz/resource/order/1971-04-22/71-28#art_87>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_88> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1971-04-22/71-28#art_87>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_88> .

<https://legal.dz/resource/order/1971-04-22/71-28#art_93> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#book_2_chp_2_sec_1_subsec_11> ;
    dzdoc:eId "art_93" ;
    dzdoc:fullText "إذا رأى قاضي التحقيق العسكري أن المحكمة العسكرية غير مختصة ، أصدر أمرا بإحالة أوراق الدعوى إلى وكيل الدولة العسكري لرفعها إلى المحكمة المختصة. ويستمر مفعول القوة التنفيذية لأمر التوقيف أو الإيداع في السجن الصادر ضد المتهم لحين استلام الأوراق من قبل المحكمة المختصة. غير أنه إذا لم ترفع الأوراق لأية محكمة ، يفرج عن المتهم بعد انقضاء مهلة شهر واحد من تاريخ أمر الإحالة . وتبقى أعمال الملاحقة والتحقيق والاجراءات السابقة صحيحة ولا ينبغي تجديدها."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1971-04-22/71-28#art_93_right_0_01874133> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1971-04-22/71-28#version_art_93> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_93_para_0>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_93_para_1>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_93_para_2>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_93_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_93_19710422_OpEnact_a4e09615af> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:introducedOn "1971-04-22"^^xsd:date ;
    dzdoc:number "93" ;
    dzdoc:position 92 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_93_condition_0_b7697a20>,
        <https://legal.dz/resource/order/1971-04-22/71-28#art_93_condition_1_35235b1f> ;
    dzdoc:usesTerm dzterm:military_court,
        dzterm:military_investigating_judge,
        dzterm:military_state_prosecutor .

