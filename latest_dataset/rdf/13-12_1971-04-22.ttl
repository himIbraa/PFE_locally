<https://legal.dz/resource/order/1971-04-22/71-28#version_art_47> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن قادة الجيوش وقادة القواعد البحرية والجوية وقادة السفن البحرية ورؤساء القطع ورؤساء المستودعات والمفارز ورؤساء مختلف مصالح الجيش، يؤهلون شخصيا لجميع الأعمال الضرورية داخل مؤسساتهم العسكرية للتحقيق في الجرائم التابعة للقضاء العسكري وجمع الأدلة والبحث عن مرتكبي الجرائم. ويجوز لهذه السلطات أن تفوض إلى ضابط تابع لأوامرها السلطات الآيلة لها بموجب الفقرة السابقة. ويمكنها أيضا أن تطلب إلى أي ضابط للشرطة القضائية العسكرية المختصة إقليميا القيام بالإجراءات المنصوص عليها في المادتين 50 و 51 أدناه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_47_19710422_OpEnact_e71c17b00b> ;
    dzdoc:replacementText "إن قادة الجيوش وقادة القواعد البحرية والجوية وقادة السفن البحرية ورؤساء القطع ورؤساء المستودعات والمفارز ورؤساء مختلف مصالح الجيش، يؤهلون شخصيا لجميع الأعمال الضرورية داخل مؤسساتهم العسكرية للتحقيق في الجرائم التابعة للقضاء العسكري وجمع الأدلة والبحث عن مرتكبي الجرائم. ويجوز لهذه السلطات أن تفوض إلى ضابط تابع لأوامرها السلطات الآيلة لها بموجب الفقرة السابقة. ويمكنها أيضا أن تطلب إلى أي ضابط للشرطة القضائية العسكرية المختصة إقليميا القيام بالإجراءات المنصوص عليها في المادتين 50 و 51 أدناه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_47> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_47> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetScope "whole_article" ;
