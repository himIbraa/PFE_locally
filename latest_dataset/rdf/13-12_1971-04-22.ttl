<https://legal.dz/resource/order/1971-04-22/71-28#version_art_150> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يختص قضاء الحكم بتقدير المخالفات الشكلية التي كانت نتيجتها الحيلولة دون إظهار الحقيقة أو الإضرار جوهريا بحقوق الدفاع . وتنظر المحكمة في الدفوع المدلى بها في الجلسة عن طريق المذكرات، قبل قفل باب المرافعات، أو تقرر خلال المرافعات بأن يضم الطلب العارض للموضوع للبت فيه بحكم واحد إذا رأت ذلك مناسبا . إن الدفوع المتعلقة بتشكيل المحكمة العسكرية أو بصحة رفع الدعوى إليها، يجب أن تقدم لهذه الأخيرة بموجب مذكرة دفاع قبل المرافعة في الموضوع وإلا تكون غير مقبولة . وتبت المحكمة في الحال في هذه الدفوع بموجب حكم"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_150_19710422_OpEnact_6a5c4f4b43> ;
    dzdoc:replacementText "يختص قضاء الحكم بتقدير المخالفات الشكلية التي كانت نتيجتها الحيلولة دون إظهار الحقيقة أو الإضرار جوهريا بحقوق الدفاع . وتنظر المحكمة في الدفوع المدلى بها في الجلسة عن طريق المذكرات، قبل قفل باب المرافعات، أو تقرر خلال المرافعات بأن يضم الطلب العارض للموضوع للبت فيه بحكم واحد إذا رأت ذلك مناسبا . إن الدفوع المتعلقة بتشكيل المحكمة العسكرية أو بصحة رفع الدعوى إليها، يجب أن تقدم لهذه الأخيرة بموجب مذكرة دفاع قبل المرافعة في الموضوع وإلا تكون غير مقبولة . وتبت المحكمة في الحال في هذه الدفوع بموجب حكم واحد، وتأمر بإحالة القضية إذا لزم الأمر ذلك ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_150> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_150> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
