    dznorm:provisionText "وإذا حصل التخلي أمام العدو أو في حالة الخطر المحدق فيعاقب بالسجن مع الأشغال من عشر سنوات إلى عشرين سنة"@ar ;
    dznorm:sourceArticle "art_330" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_331_obligation_0_dab1ffb6> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_331> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1971-04-22/71-28#art_331_obligation_0_dab1ffb6_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالإعدام كل قائد سفينة بحرية عسكرية، وكل ملاح طائرة عسكرية محلقة لا يتركها بعد آخر من فيها، عن قصد، وخلافا للتعليمات التي تلقاها، وذلك في حالة فقدان سفينته أو طائرته"@ar ;
    dznorm:sourceArticle "art_331" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_332_defocc_b90ec024514b> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 249 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:abandonment_of_post ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_332> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1971-04-22/71-28#art_332_para_1> ;
    dzdoc:paragraphPosition 1 ;
    dzdoc:snippet "يعد كذلك تاركا مركز وظيفته أمام العدو أو أمام عصابة مسلحة، كل قائد تشكيلة أو سفينة بحرية أو طائرة عسكرية لا يحافظ في المعركة عن قصد وفي زمن الحرب أو خلال العملية الحربية على تشكيلته أو سفينته أو طائرته أو ينفصل عن رئيسه أمام العدو أو العصابة المسلحة."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_332_para_1> a dzdoc:Paragraph ;
