<https://legal.dz/resource/order/1971-04-22/71-28#version_art_332> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالإعدام كل عسكري يترك مركز وظيفته أمام العدو أو أمام عصابة مسلحة . يعد كذلك تاركا مركز وظيفته أمام العدو أو أمام عصابة مسلحة، كل قائد تشكيلة أو سفينة بحرية أو طائرة عسكرية لا يحافظ في المعركة عن قصد وفي زمن الحرب أو خلال العملية الحربية على تشكيلته أو سفينته أو طائرته أو ينفصل عن رئيسه أمام العدو أو العصابة المسلحة . ويحكم بنفس العقوبة على كل عسكري أو أي شخص يتسبب في إحدى المخالفات المذكورة في الفقرة السابقة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_332_19710422_OpEnact_08b9f9e21f> ;
    dzdoc:replacementText "يعاقب بالإعدام كل عسكري يترك مركز وظيفته أمام العدو أو أمام عصابة مسلحة . يعد كذلك تاركا مركز وظيفته أمام العدو أو أمام عصابة مسلحة، كل قائد تشكيلة أو سفينة بحرية أو طائرة عسكرية لا يحافظ في المعركة عن قصد وفي زمن الحرب أو خلال العملية الحربية على تشكيلته أو سفينته أو طائرته أو ينفصل عن رئيسه أمام العدو أو العصابة المسلحة . ويحكم بنفس العقوبة على كل عسكري أو أي شخص يتسبب في إحدى المخالفات المذكورة في الفقرة السابقة ."@ar ;
