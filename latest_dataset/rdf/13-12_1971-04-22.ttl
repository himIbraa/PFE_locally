<https://legal.dz/resource/order/1971-04-22/71-28#art_148_extref_54cad1e0> a dzdoc:ExternalReference ;
    rdfs:label "المادة 299 من قانون الاجراءات الجزائية"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/1966-06-08/66-155#art_299"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-155#art_299"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/1966-06-08/66-155#art_299" ;
    dzdoc:resolutionReason "unindexed_text_pattern" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-155"^^xsd:anyURI ;
    dzdoc:targetEId "art_299" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_148_obligation_0_b163f780> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_148> ;
    dznorm:position 0 ;
    dznorm:provisionText "تقصر مهلة المعارضة ليومين بالنسبة للشاهد المحكوم عليه لتخلفه عن الحضور"@ar ;
    dznorm:sourceArticle "art_148" .

<https://legal.dz/resource/order/1971-04-22/71-28#art_148_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_148> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا تخلف أحد الشهود عن الحضور، جاز للمحكمة : أما صرف النظر عنه والسير بالمرافعات، ثم تلاوة شهادته المؤداة في التحقيق إذا كان محلا لذلك، فيما إذا طلب تلاوتها المدافع أو النيابة العامة، وأما تطبيق أحكام المادة 299 من قانون الاجراءات الجزائية. بيد أن التكليف بالحضور للمحكمة يبقى خاضعا للقواعد المنصوص عليها في المادة 128، وفي حالة الحكم على الشاهد المتخلف، يبقى طريق المعارضة فيه جائزا له أمام المحكمة العسكرية التي أصدرت الحكم، أو في حالة إلغاء هذه، أمام المحكمة المعينة من طرف وزير الدفاع الوطني."@ar .

<https://legal.dz/resource/order/1971-04-22/71-28#art_148_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1971-04-22/71-28#art_148> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي زمن الحرب، تقصر مهلة المعارضة ليومين بالنسبة للشاهد المحكوم عليه لتخلفه عن الحضور."@ar .

