<https://legal.dz/resource/order/1971-04-22/71-28#version_art_86> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن قاضي التحقيق العسكري له السلطة باتهام أي شخص خاضع للمحاكم العسكرية، ساهم كفاعل أو شريك في الأفعال المنسوبة إليه وذلك بعد صدور الرأي الموافق من وكيل الدولة العسكري ، كما يمكنه تعديل الاتهام عندما يجب إعطاء وصف جديد لهذه الأفعال يؤدي لعقوبة أشد . وفي حالة عدم الاتفاق بين قاضي التحقيق ووكيل الدولة العسكري ، يتعين على هذا الأخير، أن يرفع الأمر بموجب عريضة إلى المحكمة العسكرية لتنظر فيها في أقرب جلسة لها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_86_19710422_OpEnact_6a86afd43e> ;
    dzdoc:replacementText "إن قاضي التحقيق العسكري له السلطة باتهام أي شخص خاضع للمحاكم العسكرية، ساهم كفاعل أو شريك في الأفعال المنسوبة إليه وذلك بعد صدور الرأي الموافق من وكيل الدولة العسكري ، كما يمكنه تعديل الاتهام عندما يجب إعطاء وصف جديد لهذه الأفعال يؤدي لعقوبة أشد . وفي حالة عدم الاتفاق بين قاضي التحقيق ووكيل الدولة العسكري ، يتعين على هذا الأخير، أن يرفع الأمر بموجب عريضة إلى المحكمة العسكرية لتنظر فيها في أقرب جلسة لها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_86> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
