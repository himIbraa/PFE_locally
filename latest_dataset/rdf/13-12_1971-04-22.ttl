<https://legal.dz/resource/order/1971-04-22/71-28#version_art_257> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1971-04-22/71-28> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتبر بمثابة فرار مع التآمر ، كل فرار حاصل بتواطؤ أكثر من شخصين . ويعاقب على الفرار للداخل مع التآمر، بما يلي: أ - بالحبس من سنة واحدة إلى عشر سنوات، في زمن السلم ، ب - بالسجن المؤقت مع الأشغال من خمس سنوات إلى خمسة عشر سنة، في زمن الحرب ، و إذا كان المجرم ضابطا ، يحكم عليه علاوة على ذلك بعقوبة العزل . 2 - الفرار إلى خارج البلاد"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1971-04-22/71-28#version_art_257_19710422_OpEnact_292e567aa7> ;
    dzdoc:replacementText "يعتبر بمثابة فرار مع التآمر ، كل فرار حاصل بتواطؤ أكثر من شخصين . ويعاقب على الفرار للداخل مع التآمر، بما يلي: أ - بالحبس من سنة واحدة إلى عشر سنوات، في زمن السلم ، ب - بالسجن المؤقت مع الأشغال من خمس سنوات إلى خمسة عشر سنة، في زمن الحرب ، و إذا كان المجرم ضابطا ، يحكم عليه علاوة على ذلك بعقوبة العزل . 2 - الفرار إلى خارج البلاد"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1971-04-22/71-28#art_257> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1971-04-22/71-28> ;
