    dzdoc:eId "art_11" ;
    dzdoc:fullText "تلغى المادتان 197 و 198 من الدستور"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1979-07-01/79-06#version_art_11> ;
