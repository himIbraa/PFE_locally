<https://legal.dz/resource/law/1979-07-01/79-06#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1979-07-01/79-06#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "تعدل. الفقرتان الثانية والثالثة من المادة 18 من الدستور وتصاغان کما یلي: »لا يمكن أثناء فترتي الخمسة والأربعين (45) يوما، المشار اليهما في الفقرتين الثانية والخامسة من المادة 117 من الدستور ۰۰۰» (والباقي بدون تغییر) « »لا يمكن أثناء نفس الفترتين، انهاء مهام نائب ر نواب رئيس الجمهورية » ( والباقي بدون تغيير )"@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1979-07-01/79-06#art_10_permission_0_8b4a9d33>,
        <https://legal.dz/resource/law/1979-07-01/79-06#art_10_permission_1_fe5d2f2d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1979-07-01/79-06#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1979-07-01/79-06#art_10_para_0>,
        <https://legal.dz/resource/law/1979-07-01/79-06#art_10_para_1>,
        <https://legal.dz/resource/law/1979-07-01/79-06#art_10_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1979-07-01/79-06#version_art_10_19790701_OpEnact_67bb3f50ff> ;
