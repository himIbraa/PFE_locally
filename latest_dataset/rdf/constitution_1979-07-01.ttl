    dzdoc:position 9 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1979-07-01/79-06#art_10_extref_43c6042d>,
        <https://legal.dz/resource/law/1979-07-01/79-06#art_10_extref_b6f8319e> .

<https://legal.dz/resource/law/1979-07-01/79-06#art_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1979-07-01/79-06#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_2" ;
    dzdoc:fullText "تعدل المادة 103 من الدستور و تصاغ على النحو التالي : »المدة الرئاسية خمس (5) سنوات. يمكن تجديد انتخاب رئيس الجمهورية «"@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1979-07-01/79-06#art_2_permission_0_97834cb5> ;
