        <https://legal.dz/resource/law/1979-07-01/79-06#art_11_extref_a22a3916> .

<https://legal.dz/resource/law/1979-07-01/79-06#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1979-07-01/79-06#chp_الثالث_أحكام_مختلفة> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "تضاف الى الدستور (الباب الثالث أحكام مختلفة ) مادة 197 وتصاغ على النحو التالي : »ينطبق الاجراء المنصوص عليه في المادة 108 (الفقرة الأولى على المدة الرئاسية التي تعقب انعقاد المؤتمر الرابع لحزب جبهة التحرير الوطني. «"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1979-07-01/79-06#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1979-07-01/79-06#art_12_para_0>,
        <https://legal.dz/resource/law/1979-07-01/79-06#art_12_para_1>,
        <https://legal.dz/resource/law/1979-07-01/79-06#art_12_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1979-07-01/79-06#version_art_12_19790701_OpEnact_10cd729f33> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:introducedOn "1979-07-01"^^xsd:date ;
    dzdoc:number "المادة 12" ;
    dzdoc:position 11 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1979-07-01/79-06#art_12_extref_0906869a>,
        <https://legal.dz/resource/law/1979-07-01/79-06#art_12_extref_a22a3916> .

<https://legal.dz/resource/law/1979-07-01/79-06#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1979-07-01/79-06#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "تعدل المادة 113 من الدستور وتصاغ على النحو التالي : « يعين رئيس الجمهورية أعضاء الحكومة ومن بينهم وزيرا أول يساعده في تنسيق النشاط الحكومي وفي تطبيق القرارات المتخذة في مجلس الوزراء. » و يمارس الوزير الأول اختصاصاته في نطاق الصلاحيات التي يفرضها اليه رئيس الجمهورية طبقا ل المادة 111 (الفقرة 15) من الدستور. »"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1979-07-01/79-06#version_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1979-07-01/79-06#art_6_para_0>,
        <https://legal.dz/resource/law/1979-07-01/79-06#art_6_para_1>,
        <https://legal.dz/resource/law/1979-07-01/79-06#art_6_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1979-07-01/79-06#version_art_6_19790701_OpEnact_c022593143> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:introducedOn "1979-07-01"^^xsd:date ;
    dzdoc:number "المادة 6" ;
    dzdoc:position 5 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1979-07-01/79-06#art_6_extref_28c3292e>,
        <https://legal.dz/resource/law/1979-07-01/79-06#art_6_extref_b16095ac> ;
    dzdoc:usesTerm dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/law/1979-07-01/79-06#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1979-07-01/79-06#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "تعدل المادة 116 من الدستور وتصاغ على النحو التالي : » ولا يجوز بأي حال من الأحوال أن يفوض رئيس الجمهورية سلطته في تعيين نائب أو نواب رئيس الجمهورية ……… أو اعفائهم من مهامهم ……. » (والباقي بدون تغيير)."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1979-07-01/79-06#art_8_permission_0_9dd9fe36> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1979-07-01/79-06#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1979-07-01/79-06#art_8_para_0>,
        <https://legal.dz/resource/law/1979-07-01/79-06#art_8_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1979-07-01/79-06#version_art_8_19790701_OpEnact_ce3cc32450> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:introducedOn "1979-07-01"^^xsd:date ;
    dzdoc:number "المادة 8" ;
    dzdoc:position 7 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1979-07-01/79-06#art_8_extref_3098c6f1> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/1979-07-01/79-06#art_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1979-07-01/79-06#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_5" ;
    dzdoc:fullText "تعدل المادة 112 من الدستور وتصاغ على النحو التالي : « يمكن لرئيس الجمهورية أن يعين نائبا له أو أكثر يعينونه ويساعدونه في مهامه »"@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1979-07-01/79-06#art_5_permission_0_122a8af1> ;
