<https://legal.dz/resource/law/1979-07-01/79-06#version_art_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعدل المادة 116 من الدستور وتصاغ على النحو التالي : » ولا يجوز بأي حال من الأحوال أن يفوض رئيس الجمهورية سلطته في تعيين نائب أو نواب رئيس الجمهورية ……… أو اعفائهم من مهامهم ……. » (والباقي بدون تغيير)."@ar ;
    dzdoc:isAuthoritative true ;
