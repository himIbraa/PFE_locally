<https://legal.dz/resource/law/1979-07-01/79-06#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1979-07-01/79-06#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "تعدل الفقرة الثالثة من المادة 105 من الدستور وتصاع على النحو التالي : »ويقترحه مؤتمر حزب جبهة التحرير الوطني وفقا لقانونه الأساسي«"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1979-07-01/79-06#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1979-07-01/79-06#art_1_para_0>,
        <https://legal.dz/resource/law/1979-07-01/79-06#art_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1979-07-01/79-06#version_art_1_19790701_OpEnact_f0bc7a74bc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:introducedOn "1979-07-01"^^xsd:date ;
    dzdoc:number "المادة الأولى" ;
    dzdoc:position 0 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1979-07-01/79-06#art_1_extref_09773ad1> ;
    dzdoc:usesTerm dzterm:fln .

<https://legal.dz/resource/law/1979-07-01/79-06#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1979-07-01/79-06#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "يضاف في آخر المادة 110 : »والله على ما أقول شهيد »"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1979-07-01/79-06#version_art_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1979-07-01/79-06#art_3_para_0>,
        <https://legal.dz/resource/law/1979-07-01/79-06#art_3_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
