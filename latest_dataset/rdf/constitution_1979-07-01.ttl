<https://legal.dz/resource/law/1979-07-01/79-06#version_art_6> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعدل المادة 113 من الدستور وتصاغ على النحو التالي : « يعين رئيس الجمهورية أعضاء الحكومة ومن بينهم وزيرا أول يساعده في تنسيق النشاط الحكومي وفي تطبيق القرارات المتخذة في مجلس الوزراء. » و يمارس الوزير الأول اختصاصاته في نطاق الصلاحيات التي يفرضها اليه رئيس الجمهورية طبقا ل المادة 111 (الفقرة 15) من الدستور. »"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1979-07-01/79-06#version_art_6_19790701_OpEnact_c022593143> ;
    dzdoc:replacementText "تعدل المادة 113 من الدستور وتصاغ على النحو التالي : « يعين رئيس الجمهورية أعضاء الحكومة ومن بينهم وزيرا أول يساعده في تنسيق النشاط الحكومي وفي تطبيق القرارات المتخذة في مجلس الوزراء. » و يمارس الوزير الأول اختصاصاته في نطاق الصلاحيات التي يفرضها اليه رئيس الجمهورية طبقا ل المادة 111 (الفقرة 15) من الدستور. »"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1979-07-01/79-06#art_6> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1979-07-01/79-06> ;
