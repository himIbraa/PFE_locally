    dzdoc:referencesExternal <https://legal.dz/resource/law/1979-07-01/79-06#art_3_extref_b61ca8f8> .

<https://legal.dz/resource/law/1979-07-01/79-06#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1979-07-01/79-06> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1979-07-01/79-06#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "تعدل المادة 115 من الدستور وتصاغ على النحو التالي : »ونائب أو نواب رئيس الجمهورية ۰۰۰۰ و الباقي بدون تغيير«"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1979-07-01/79-06#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1979-07-01/79-06#art_7_para_0>,
        <https://legal.dz/resource/law/1979-07-01/79-06#art_7_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1979-07-01/79-06#version_art_7_19790701_OpEnact_3c979755c8> ;
