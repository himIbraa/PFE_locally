    dzdoc:introducedOn "1979-07-01"^^xsd:date ;
    dzdoc:number "المادة 7" ;
    dzdoc:position 6 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1979-07-01/79-06#art_7_extref_07241b53> .

<https://legal.dz/resource/law/1979-07-01/79-06#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1979-07-01/79-06> ;
