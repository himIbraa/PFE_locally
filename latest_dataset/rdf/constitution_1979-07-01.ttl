    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" ;
    dzdoc:targetEId "art_115" .

<https://legal.dz/resource/law/1979-07-01/79-06#art_7_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1979-07-01/79-06#art_7> ;
    dzdoc:position 0 ;
    dzdoc:text "تعدل المادة 115 من الدستور وتصاغ على النحو التالي :"@ar .

<https://legal.dz/resource/law/1979-07-01/79-06#art_7_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1979-07-01/79-06#art_7> ;
    dzdoc:position 1 ;
    dzdoc:text "»ونائب أو نواب رئيس الجمهورية ۰۰۰۰ و الباقي بدون تغيير«"@ar .

<https://legal.dz/resource/law/1979-07-01/79-06#art_8_extref_3098c6f1> a dzdoc:ExternalReference ;
    rdfs:label "المادة 116 من الدستور"@ar ;
