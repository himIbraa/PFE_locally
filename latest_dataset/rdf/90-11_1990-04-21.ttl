<https://legal.dz/resource/law/1990-04-21/90-11#version_art_31> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يكون اللجوء الى الساعات الاضافية استجابة لضرورة مطلقة في الخدمة ، كما يجب ان يكتسي هذا اللجوء طابعا استثنائيا . وفي هذه الحالة، يجوز للمستخدم ان يطلب من أي عامل أداء ساعات اضافية، زيادة على المدة القانونية للعمل، دون أن تتعدى 20 % من المدة القانونية المذكورة، مع مراعاة أحكام المادة 26 اعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_31_19900421_OpEnact_4df163fd1d> ;
    dzdoc:replacementText "يجب أن يكون اللجوء الى الساعات الاضافية استجابة لضرورة مطلقة في الخدمة ، كما يجب ان يكتسي هذا اللجوء طابعا استثنائيا . وفي هذه الحالة، يجوز للمستخدم ان يطلب من أي عامل أداء ساعات اضافية، زيادة على المدة القانونية للعمل، دون أن تتعدى 20 % من المدة القانونية المذكورة، مع مراعاة أحكام المادة 26 اعلاه."@ar ;
