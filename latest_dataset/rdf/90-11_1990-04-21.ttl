    dznorm:expressedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_98> .

<https://legal.dz/resource/law/1990-04-21/90-11#art_98_obligation_1_40dbe74a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_98> ;
    dznorm:position 1 ;
    dznorm:provisionText "تحدد كيفيات تنظيم الانتخابات عن طريق التنظيم بعد استشارة التنظيمات النقابية للعمال والمستخدمين الاكثر تمثيلا."@ar ;
    dznorm:sourceArticle "art_98" .

<https://legal.dz/resource/law/1990-04-21/90-11#art_98_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_98> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب ان تسمح طريقة الانتخاب بتمثيل عادل لمختلف الفئات الاجتماعية والمهنية داخل مكان العمل والهيئة المستخدمة المعنية."@ar .

<https://legal.dz/resource/law/1990-04-21/90-11#art_98_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_98> ;
    dzdoc:position 1 ;
    dzdoc:text "تحدد كيفيات تنظيم الانتخابات عن طريق التنظيم بعد استشارة التنظيمات النقابية للعمال والمستخدمين الاكثر تمثيلا."@ar .

<https://legal.dz/resource/law/1990-04-21/90-11#art_99_condition_0_07779763> a dznorm:Condition ;
    dznorm:conditionText "اذا تجاوز العدد 1000 عامل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_99> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1990-04-21/90-11#art_99_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_99> ;
    dzdoc:position 0 ;
    dzdoc:text "يحدد عدد مندوبي العمال كالتالي : من 20 الى 50 عاملا : مندوب ( 1 ) من 51 الى 150 عاملا : مندوبان ( 02 ) من 161 الى 400 عامل : أربعة ( 04 ) مندوبين من 401 الى 1000 عامل : ستة ( 06 ) مندوبين"@ar .

<https://legal.dz/resource/law/1990-04-21/90-11#art_99_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_99> ;
    dzdoc:position 1 ;
    dzdoc:text "ويخصص مندوب اضافي عن كل شريحة 500 عامل اذا تجاوز العدد 1000 عامل."@ar .

<https://legal.dz/resource/law/1990-04-21/90-11#art_9_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_9> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم عقد العمل حسب الاشكال التي تتفق عليها الاطراف المتعاقدة."@ar .

<https://legal.dz/resource/law/1990-04-21/90-11#legal_basis_354ca7cb079a> a dzdoc:LegalBasisAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/unknown/90-04> ;
    dzdoc:confidenceScore 0.45 ;
    dzdoc:evidenceText "وبمقتضى القانون رقم 90-04 المؤرخ في 10 رجب عام 1410 الموافق 6 فبراير سنة 1990، المتعلق بالنزاعات الفردية للعمل،"@ar ;
    dzdoc:extractionMethod "text_pattern_doc_type_number" ;
    dzdoc:isInferred true ;
    dzdoc:sourceSegment <https://legal.dz/resource/law/1990-04-21/90-11#preamble_segment_15> .

<https://legal.dz/resource/law/1990-04-21/90-11#lifecycle_15fe92c2e71d> a dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1981-02-21/81-03> ;
    dzdoc:confidenceScore 0.67 ;
    dzdoc:evidenceText "تلغى كل الاحكام المخالفة لهذا القانون لاسيما الامر رقم 71 - 74 المؤرخ في 16 نوفمبر سنة 1971 والمتعلق بالتسيير الاشتراكي للمؤسسات و الامر رقم 75 - 31 المؤرخ في 29 أبريل سنة 1975 المتعلق بالشروط العامة للعمل في القطاع الخاص و المواد من 1 الى 179 ومن 199 الى 216 من القانون رقم 78 - 12 المؤرخ في 5 غشت سنة 1978 والمتعلق بالقانون الاساسي العام للعامل و القانون رقم 81 - 03 المؤرخ في 21 فبراير سنة 1981، الذي يحدد المدة القانونية للعمل و القانون رقم 81 – 08 المؤرخ في 27يونيو سنة 1981 المتعلق بالعطل السنوية و القانون رقم 82 - 06 المؤرخ في 27 فبراير سنة 1982 والمتعلق بالعلاقات الفردية للعمل وكذا كل النصوص التنظيمية المتخذة لتطبيقها. غير أنه مع مراعاة أحكام المادة 3 اعلاه ، تظل علاقات العمل المبرمة عند تاريخ صدور هذا القانون تحدث اثرها الكامل، ماعدا احكامها المخالفة. وتكون تعديلاتها طبقا لاحكام هذا القانون."@ar ;
    dzdoc:isContradictory true ;
    dzdoc:lifecycleRelationType "amends" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:ruleId "lifecycle_explicit_amend_phrase" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_157> .

<https://legal.dz/resource/law/1990-04-21/90-11#lifecycle_2356e1e2e6a7> a dzdoc:LifecycleAssertion ;
