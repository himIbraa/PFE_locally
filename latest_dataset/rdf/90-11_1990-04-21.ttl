<https://legal.dz/resource/law/1990-04-21/90-11#version_art_77> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "النظام الداخلي هو وثيقة مكتوبة يحدد فيها المستخدم ، لزوما ، القواعد المتعلقة بالتنظيم التقني للعمل والوقاية الصحية والأمن والانضباط . يحدد النظام الداخلي في المجال التأديبي، طبيعة الأخطاء المهنية ودرجات العقوبات المطابقة واجراءات التنفيذ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_77_19900421_OpEnact_7208471829> ;
