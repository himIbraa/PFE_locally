<https://legal.dz/resource/law/1990-04-21/90-11#version_art_18> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن ان يخضع العامل الجديد توظيفه لمدة تجريبية لاتتعدى ستة (06) ،اشهر ، كما يمكن أن ترفع هذه المدة الى اثني عشر (12) شهرا لمناصب العمل ذات التأهيل العالي. تحدد المدة التجريبية لكل فئة من فئات العمال أو لمجموع العمال عن طريق التفاوض الجماعي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_18_19900421_OpEnact_3b44736c1e> ;
    dzdoc:replacementText "يمكن ان يخضع العامل الجديد توظيفه لمدة تجريبية لاتتعدى ستة (06) ،اشهر ، كما يمكن أن ترفع هذه المدة الى اثني عشر (12) شهرا لمناصب العمل ذات التأهيل العالي. تحدد المدة التجريبية لكل فئة من فئات العمال أو لمجموع العمال عن طريق التفاوض الجماعي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_18> ;
