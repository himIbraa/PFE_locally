        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يلزم تبليغ النقض الاطراف بالشروع في مفاوضات في ظرف ثلاثين يوما (30) لابرام اتفاقية جماعية جديدة . ولا يمكن في أي حال من الاحوال أن يؤثر نقض الاتفاقية على عقود العمل المبرمة في السابق والتي تبقى خاضعة للاحكام المعمول بها الى غاية ابرام اتفاقية جماعية جديدة."@ar ;
