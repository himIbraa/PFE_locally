<https://legal.dz/resource/law/1990-04-21/90-11#version_art_74> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "اذا حدث تغيير في الوضعية القانونية للهيئة المستخدمة ، تبقى جميع علاقات العمل المعمول بها يوم التغيير قائمة بين المستخدم الجديد والعمال . لا يمكن أن يطرأ أي تعديل في علاقات العمل الا ضمن الاشكال وحسب الشروط التي ينص عليها هذا القانون وعن طريق المفاوضات الجماعية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_74_19900421_OpEnact_d1e64adb14> ;
