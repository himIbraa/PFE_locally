<https://legal.dz/resource/law/1990-04-21/90-11#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_1> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "يمكن اثبات عقد العمل أو علاقته بأية وسيلة كانت."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1990-04-21/90-11#art_10_permission_0_6649e090> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_10_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_10_19900421_OpEnact_580feba317> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
