<https://legal.dz/resource/law/1990-04-21/90-11#version_art_67> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسلم للعامل، عند انهاء علاقة العمل، شهادة عمل تبين تاريخ التوظيف وتاريخ انهاء علاقة العمل وكذا المناصب التي شغلت والفترات المناسبة لها . لا يترتب عن تسليم شهادة العمل فقدان حقوق وواجبات المستخدم والعامل الناشئة عن عقد العمل أو عقود التكوين الا اذا اتفق الطرفان على عكس ذلك كتابة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_67_19900421_OpEnact_29ba0eebd6> ;
    dzdoc:replacementText "يسلم للعامل، عند انهاء علاقة العمل، شهادة عمل تبين تاريخ التوظيف وتاريخ انهاء علاقة العمل وكذا المناصب التي شغلت والفترات المناسبة لها . لا يترتب عن تسليم شهادة العمل فقدان حقوق وواجبات المستخدم والعامل الناشئة عن عقد العمل أو عقود التكوين الا اذا اتفق الطرفان على عكس ذلك كتابة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_67> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1990-04-21/90-11> ;
