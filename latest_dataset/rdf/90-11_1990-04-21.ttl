<https://legal.dz/resource/law/1990-04-21/90-11#version_art_43> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل فترة تساوى أربعة وعشرين (24) يوم عمل كامل أو أربعة أسابيع عمل تعادل شهر عمل فعلي، إذا تعلق الأمر بتحديد مدة العطلة السنوية المدفوعة الاجر . وتساوي هذه الفترة 180 ساعة عمل للعمال الموسميين أو العاملين بالتوقيت الجزئي."@ar ;
