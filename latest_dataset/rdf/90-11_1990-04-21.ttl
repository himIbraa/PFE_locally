    dzdoc:number "68" ;
    dzdoc:position 63 .

<https://legal.dz/resource/law/1990-04-21/90-11#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_7> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "يودع النظام الداخلي ، المنصوص عليه في المادة 75 أعلاه لدى مفتشية العمل المختصة اقليميا للمصادقة على مطابقته للتشريع والتنظيم المتعلقين بالعمل في أجل ثمانية ( 08 ) أيام . يسري مفعول النظام الداخلي فور ايداعه لدى كتابة الضبط للمحكمة المختصة اقليميا. ويضمن له المستخدم اشهارا واسعا في أوساط العمال المعنيين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_79_para_0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_79_para_1>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_79_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_79_19900421_OpEnact_bfa9c2e2cc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_79_obligation_0_45285a8e>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_79_obligation_1_95a9201f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "79" ;
    dzdoc:position 73 ;
    dzdoc:references <https://legal.dz/resource/law/1990-04-21/90-11#art_75> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1990-04-21/90-11#art_75> ;
    dzdoc:usesTerm dzterm:employer,
        dzterm:internal_regulation .

<https://legal.dz/resource/law/1990-04-21/90-11#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_5_sec_2> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "اذا كان للهيئة المستخدمة عدة أماكن عمل متمايزة يمارس مندوبو المستخدمين في كل مكان متمايز تحت مراقبة لجنة المشاركة صلاحيات هذه اللجنة المبينة في الفقرتين 1 و3 من المادة 94 أعلاه المتعلقة بمكان العمل المعني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_96_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_96_19900421_OpEnact_a603accd1d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "96" ;
    dzdoc:position 88 ;
    dzdoc:references <https://legal.dz/resource/law/1990-04-21/90-11#art_94> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1990-04-21/90-11#art_94> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1990-04-21/90-11#art_96_condition_0_55228869> .

