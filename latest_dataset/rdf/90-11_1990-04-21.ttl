<https://legal.dz/resource/law/1990-04-21/90-11#art_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_5_sec_3> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "يرفع كل اعتراض عن انتخاب مندوبي المستخدمين الى المحكمة المختصة اقليميا ، التي تبت في المسائل الاجتماعية وتصدر حكمها الاولي والنهائي في غضون ثلاثين (30) يوما من تلقي القضية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1990-04-21/90-11#art_100_right_0_350ab543> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_100> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_100_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_100_19900421_OpEnact_8f35d7d5d0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 100" ;
    dzdoc:position 92 ;
    dzdoc:usesTerm dzterm:employees_delegates .

<https://legal.dz/resource/law/1990-04-21/90-11#art_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_5_sec_4> ;
    dzdoc:eId "art_109" ;
    dzdoc:fullText "يضع المستخدم تحت تصرف لجنة المشاركة و مندوبي المستخدمين الوسائل الضرورية لعقد اجتماعاتهم ولانجاز أعمالهم السكرتارية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_109> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_109_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_109_19900421_OpEnact_82b6729df3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_109_obligation_0_feccebed> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 109" ;
    dzdoc:position 101 ;
    dzdoc:usesTerm dzterm:employer,
        dzterm:participation_committee,
        dzterm:workers_representatives .

<https://legal.dz/resource/law/1990-04-21/90-11#art_111> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_5_sec_4> ;
    dzdoc:eId "art_111" ;
    dzdoc:fullText "تطبيقا لاحكام المادة 110 أعلاه، تخصص الهيئة المستخدمة ميزانيات، حسب الكيفيات التي تحدد بالطرق التنظيمية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_111> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_111_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_111_19900421_OpEnact_da79a18277> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_111_obligation_0_fd99b801> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 111" ;
    dzdoc:position 103 ;
    dzdoc:references <https://legal.dz/resource/law/1990-04-21/90-11#art_110> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1990-04-21/90-11#art_110> ;
    dzdoc:usesTerm dzterm:employer_entity .

<https://legal.dz/resource/law/1990-04-21/90-11#art_112> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_5_sec_4> ;
    dzdoc:eId "art_112" ;
    dzdoc:fullText "يخضع مندوبو المستخدمين عند ممارستهم لاعمالهم المهنية للاحكام التشريعية والتنظيمية والتعاقدية المتعلقة بحقوق العمال وواجباتهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_112> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_112_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_112_19900421_OpEnact_bc63cd4507> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_112_obligation_0_22147d2b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 112" ;
    dzdoc:position 104 ;
    dzdoc:usesTerm dzterm:employee_delegates .

<https://legal.dz/resource/law/1990-04-21/90-11#art_122> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:definesTerm dzterm:higher_level_agreement ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_6_sec_3> ;
    dzdoc:eId "art_122" ;
    dzdoc:fullText "تعتبر الاتفاقيات الجماعية التي تتجاوز اطار الهيئة المستخدمة من درجة أعلى بمجرد ما تتفاوض في شأنها وتبرمها التنظيمات النقابية للعمال والمستخدمين المعترف بتمثيلها في مجال التطبيق القطاعي أو المهني أو الاقليمي لتلك الاتفاقيات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_122> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1990-04-21/90-11#art_122_defocc_d6e7a355abb1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_122_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_122_19900421_OpEnact_e168c87221> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 122" ;
    dzdoc:position 113 ;
    dzdoc:usesTerm dzterm:collective_agreement,
        dzterm:employer_body,
        dzterm:trade_unions .

<https://legal.dz/resource/law/1990-04-21/90-11#art_123> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_6_sec_4> ;
    dzdoc:eId "art_123" ;
    dzdoc:fullText "يكون التفاوض في الاتفاقيات الجماعية بناء على طلب أحد الطرفين المذكورين في المادة 114 أعلاه، وتقوم به لجان متساوية الاعضاء للتفاوض تتكون من عدد مساو من الممثلين النقابيين للعمال وعدد من المستخدمين ينتدبهم أولئك الذين يمثلونهم. ويختص كل واحد من الطرفين في التفاوض بتعيين من يمثلونه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_123> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_123_para_0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_123_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_123_19900421_OpEnact_3058931abc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 123" ;
    dzdoc:position 114 ;
    dzdoc:references <https://legal.dz/resource/law/1990-04-21/90-11#art_114> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1990-04-21/90-11#art_114> ;
    dzdoc:usesTerm dzterm:collective_agreements .

<https://legal.dz/resource/law/1990-04-21/90-11#art_125> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_6_sec_4> ;
    dzdoc:eId "art_125" ;
    dzdoc:fullText "يعين كل واحد من الطرفين في التفاوض السير المفاوضات الجماعية، رئيسا يعبر عن رأي اغلبية أعضاء الوفد الذي يقوده ويصبح ناطقه الرسمي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_125> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_125_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_125_19900421_OpEnact_3987df67c5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_125_obligation_0_3c694ba4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 125" ;
    dzdoc:position 116 .

<https://legal.dz/resource/law/1990-04-21/90-11#art_127> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_6_sec_5> ;
    dzdoc:eId "art_127" ;
    dzdoc:fullText "تلزم الاتفاقيات الجماعية كل من وقع عليها أو انضم اليها فور استكمال الاجراءات المنصوص عليها في المادة السابقة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_127> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_127_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_127_19900421_OpEnact_0d59e599ac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_127_obligation_0_e9511973> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 127" ;
    dzdoc:position 118 ;
    dzdoc:references <https://legal.dz/resource/law/1990-04-21/90-11#art_126> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1990-04-21/90-11#art_126> ;
    dzdoc:usesTerm dzterm:collective_agreement .

<https://legal.dz/resource/law/1990-04-21/90-11#art_132> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_6_sec_5> ;
    dzdoc:eId "art_132" ;
    dzdoc:fullText "يبلغ النقض برسالة مسجلة، الى الطرف المتعاقد الآخر، مع ارسال نسخة الى مفتشية العمل ، التي سجلت هذه الاتفاقية وتسلمها الى كتابة الضبط التابعة للمحكمة المودع لديها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_132> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_132_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_132_19900421_OpEnact_765e60054b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_132_obligation_0_38a3d2f0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 132" ;
    dzdoc:position 123 ;
    dzdoc:usesTerm dzterm:labor_inspectorate .

<https://legal.dz/resource/law/1990-04-21/90-11#art_137> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_7> ;
    dzdoc:eId "art_137" ;
    dzdoc:fullText "يكون باطلا وعديم الاثر كل بند في عقد العمل يخالف باستنقاصه حقوقا منحت للعمال بموجب التشريع والاتفاقيات أو الاتفاقات الجماعية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_137> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_137_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_137_19900421_OpEnact_4a14823d8e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "137" ;
    dzdoc:position 128 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1990-04-21/90-11#art_137_condition_0_6397368c> ;
    dzdoc:usesTerm dzterm:employment_contract .

<https://legal.dz/resource/law/1990-04-21/90-11#art_138> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_8> ;
    dzdoc:eId "art_138" ;
    dzdoc:fullText "يعاين مفتشو العمل ويسجلون المخالفات حيال أحكام هذا القانون طبقا لتشريع العمل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_138> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_138_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_138_19900421_OpEnact_6af4aa5c55> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_138_obligation_0_e7003800> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 138" ;
    dzdoc:position 129 ;
    dzdoc:usesTerm dzterm:labor_inspectors .

<https://legal.dz/resource/law/1990-04-21/90-11#art_141> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_8> ;
    dzdoc:eId "art_141" ;
    dzdoc:fullText "يعاقب كل من ارتكب مخالفة لاحكام هذا القانون المتعلقة بظروف استخدام الشبان والنسوة بغرامة مالية تتراوح من 2000 الى 4000 دج وتطبق كلما تكررت المخالفة المعاينة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_141> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_141_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_141_19900421_OpEnact_84013c8619> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_141_obligation_0_f1d4610f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 141" ;
    dzdoc:position 132 .

<https://legal.dz/resource/law/1990-04-21/90-11#art_143> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_8> ;
    dzdoc:eId "art_143" ;
    dzdoc:fullText "يعاقب كل من خالف احكام هذا القانون المتعلقة بمدة العمل القانونية الاسبوعية واتساع فترة العمل اليومية والحدود في مجال اللجوء الى الساعات الاضافية والعمل الليلي، فيما يخص الشبان والنسوة بغرامة مالية تتراوح من 500 دج إلى 1000 دج، وتطبق العقوبة عند كل مخالفة معاينة وتكرر بحسب عدد العمال المعنيين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_143> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_143_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_143_19900421_OpEnact_130241a1bd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_143_obligation_0_0d33ba24> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 143" ;
    dzdoc:position 134 .

<https://legal.dz/resource/law/1990-04-21/90-11#art_144> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_8> ;
    dzdoc:eId "art_144" ;
    dzdoc:fullText "يعاقب بغرامة مالية تتراوح من 1000 دج الى 2000 دج كل مستخدم يخالف أحكام هذا القانون المتعلقة بالراحة القانونية، ويتكرر تطبيقها حسب عدد العمال المعنيين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_144> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_144_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_144_19900421_OpEnact_0452e53120> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_144_obligation_0_410788f6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 144" ;
    dzdoc:position 135 .

<https://legal.dz/resource/law/1990-04-21/90-11#art_147> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_8> ;
    dzdoc:eId "art_147" ;
    dzdoc:fullText "يعاقب بغرامة مالية تتراوح من 1000 دج الى 2000 دج كل من خالف احكام هذا القانون المتعلقة بوجوب ايداع النظام الداخلي لدى مفتشية العمل ولدى كتابة الضبط للمحكمة المختصة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_147> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_147_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_147_19900421_OpEnact_e676907a43> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_147_obligation_0_25188a38> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 147" ;
    dzdoc:position 138 .

<https://legal.dz/resource/law/1990-04-21/90-11#art_148> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_8> ;
    dzdoc:eId "art_148" ;
    dzdoc:fullText "يعاقب بغرامة مالية تتراوح من 500 دج الى 1000 دج كل من دفع أجرا لعامل دون أن يسلمه قسيمة الراتب المطابقة للاجر المقبوض ، أو يغفل فيها عنصرا أو عدة عناصر يتكون منها الراتب المقبوض وتضاعف العقوبة حسب عدد المخالفات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_148> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_148_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_148_19900421_OpEnact_da4a18f6fe> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_148_obligation_0_1aefc792> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 148" ;
    dzdoc:position 139 .

<https://legal.dz/resource/law/1990-04-21/90-11#art_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:definesTerm dzterm:employees ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_1> ;
    dzdoc:eId "art_2" ;
    dzdoc:fullText "يعتبر عمالا اجراء، في مفهوم هذا القانون، كل الأشخاص الذين يؤدون عملا يدويا أو فكريا مقابل مرتب، في اطار التنظيم، ولحساب شخص آخر، طبيعي أو معنوي عمومي أو خاص يدعى \" المستخدم \" ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_2> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1990-04-21/90-11#art_2_defocc_e0c4847cbcac> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_2_19900421_OpEnact_d7f738384c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 2" ;
    dzdoc:position 1 ;
    dzdoc:usesTerm dzterm:employer .

<https://legal.dz/resource/law/1990-04-21/90-11#art_32> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_3> ;
    dzdoc:eId "art_32" ;
    dzdoc:fullText "يخول أداء ساعات اضافية الحق في زيادة لاتقل بأي حال من الاحوال عن 50% من الاجر العادي للساعة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1990-04-21/90-11#art_32_right_0_bc80b157> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_32> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_32_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_32_19900421_OpEnact_faf3aa1b05> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 32" ;
    dzdoc:position 29 .

<https://legal.dz/resource/law/1990-04-21/90-11#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_4> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "يعتمد الحق في العطلة السنوية على أساس العمل المتمم خلال فترة سنوية مرجعية تمتد من أول يوليو للسنة السابقة للعطلة الى غاية 30 يونيو من سنة العطلة. وتحسب الفترة المرجعية للعمال الجديد توظيفهم ابتداء من تاريخ التوظيف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_40_para_0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_40_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_40_19900421_OpEnact_e21d4fcff3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "40" ;
    dzdoc:position 37 .

<https://legal.dz/resource/law/1990-04-21/90-11#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_4> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "لايجوز، في أي حال من الاحوال، ان تحول العطلة المرضية الطويلة الأمد ، الحق في دفع أكثر من مرتب شهر واحد عطلة سنوية، وذلك مهما تكن مدة العطلة المرضية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_47_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_47_19900421_OpEnact_f981152da7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_47_obligation_0_7d063953> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "47" ;
    dzdoc:position 44 ;
    dzdoc:usesTerm dzterm:long_term_sick_leave .

<https://legal.dz/resource/law/1990-04-21/90-11#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_4> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "يحدد المستخدم برنامج العطل السنوية وتجزئتها، بعد استشارة لجنة المشاركة المحدثة بمقتضى هذا القانون، إن وجدت."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_51_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_51_19900421_OpEnact_c5ae469d4f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_51_obligation_0_7f27c7ad> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "51" ;
    dzdoc:position 47 ;
    dzdoc:usesTerm dzterm:employer,
        dzterm:participation_committee .

<https://legal.dz/resource/law/1990-04-21/90-11#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_6> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "يعدل عقد العمل اذا كان القانون أو التنظيم أو الاتفاقيات أو الاتفاقات الجماعية تملي قواعد أكثر نفعا للعمال من تلك التي نص عليها عقد العمل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_62_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_62_19900421_OpEnact_05f814433d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_62_obligation_0_795d3d06> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "62" ;
    dzdoc:position 58 ;
    dzdoc:usesTerm dzterm:labor_contract .

<https://legal.dz/resource/law/1990-04-21/90-11#art_65> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_6> ;
    dzdoc:eId "art_65" ;
    dzdoc:fullText "يعاد ادراج العمال المشار اليهم في المادة 64 أعلاه، قانونا في مناصب عملهم أو في مناصب ذات أجر مماثل، بعد انقضاء الفترات التي تسببت في تعليق علاقة العمل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_65> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_65_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_65_19900421_OpEnact_99f16f69ce> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_65_obligation_0_f67f9431> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "65" ;
    dzdoc:position 60 ;
    dzdoc:references <https://legal.dz/resource/law/1990-04-21/90-11#art_64> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1990-04-21/90-11#art_64> .

<https://legal.dz/resource/law/1990-04-21/90-11#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_7> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "تعد الشروط الواردة في النظام الداخلي التي قد تلغي حقوق العمال أو تحد منها ، كما تنص عليها القوانين والاتفاقيات الجماعية المعمول بها، لاغية وعديمة المفعول."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1990-04-21/90-11#art_78_right_0_4f8fcb60> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_78> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_78_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_78_19900421_OpEnact_71a8ba9ef6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "78" ;
    dzdoc:position 72 ;
    dzdoc:usesTerm dzterm:internal_regulation .

<https://legal.dz/resource/law/1990-04-21/90-11#art_82> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:definesTerm dzterm:proportional_income ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_4_sec_1> ;
    dzdoc:eId "art_82" ;
    dzdoc:fullText "يفهم من عبارة الدخل المتناسب مع نتائج العمل الاجرة حسب المردود، لاسيما العمل بالالتزام أو بالقطعة أو العمل بالحصة أو حسب رقم الاعمال."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_82> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1990-04-21/90-11#art_82_defocc_fd09f8252611> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_82_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_82_19900421_OpEnact_2137c097a6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "82" ;
    dzdoc:position 75 .

<https://legal.dz/resource/law/1990-04-21/90-11#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_4_sec_1> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "يدرج مبلغ الاجر وجميع عناصره بالتسمية في قسيمة الاجور الدوري التي يعدها المستخدم ولا يطبق هذا الحكم على تسديد المصاريف"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_86_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_86_19900421_OpEnact_a410236e14> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_86_obligation_0_b3715015> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "86" ;
    dzdoc:position 78 .

<https://legal.dz/resource/law/1990-04-21/90-11#art_93> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_5_sec_الاول> ;
    dzdoc:eId "art_93" ;
    dzdoc:fullText "يؤسس ضمن نفس الهيئة المستخدمة لجنة مشاركة تتشكل من مجموع مندوبي المستخدمين المنتخبين طبقا ل المواد 91 و 92 و 99 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_93> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_93_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_93_19900421_OpEnact_d4498216d3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_93_obligation_0_c0ffef33> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 93" ;
    dzdoc:position 85 ;
    dzdoc:references <https://legal.dz/resource/law/1990-04-21/90-11#art_91>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_92>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_99> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1990-04-21/90-11#art_91>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_92>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_99> ;
    dzdoc:usesTerm dzterm:employee_representatives,
        dzterm:employer_entity,
        dzterm:participation_committee .

<https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_2> a dzdoc:Section ;
