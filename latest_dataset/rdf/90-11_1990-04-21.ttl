<https://legal.dz/resource/law/1990-04-21/90-11#version_art_100> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرفع كل اعتراض عن انتخاب مندوبي المستخدمين الى المحكمة المختصة اقليميا ، التي تبت في المسائل الاجتماعية وتصدر حكمها الاولي والنهائي في غضون ثلاثين (30) يوما من تلقي القضية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_100_19900421_OpEnact_8f35d7d5d0> ;
    dzdoc:replacementText "يرفع كل اعتراض عن انتخاب مندوبي المستخدمين الى المحكمة المختصة اقليميا ، التي تبت في المسائل الاجتماعية وتصدر حكمها الاولي والنهائي في غضون ثلاثين (30) يوما من تلقي القضية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_100> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_100> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1990-04-21"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/1990-04-21/90-11#version_art_101> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تدوم عضوية مندوبي المستخدمين ثلاث (3) سنوات ويمكن أن تسحب هذه العضوية من مندوبي المستخدمين بناء على قرار أغلبية العمال الذين انتخبوهم خلال جمعية عامة يستدعيها رئيس مكتب لجنة المشاركة المنصوص عليها في المادة 102 ادناه أو المنعقدة بناء على طلب من ثلث العمال المعنيين على الاقل. في حالة الشغور لاي سبب كان يخلف مندوب المستخدمين العامل الذي حصل في الانتخابات على عدد من الأصوات يلي مباشرة عدد الاصوات التي تحصل عليها آخر شخص منتخب كمندوب للمستخدمين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_101_19900421_OpEnact_811c0aad16> ;
    dzdoc:replacementText "تدوم عضوية مندوبي المستخدمين ثلاث (3) سنوات ويمكن أن تسحب هذه العضوية من مندوبي المستخدمين بناء على قرار أغلبية العمال الذين انتخبوهم خلال جمعية عامة يستدعيها رئيس مكتب لجنة المشاركة المنصوص عليها في المادة 102 ادناه أو المنعقدة بناء على طلب من ثلث العمال المعنيين على الاقل. في حالة الشغور لاي سبب كان يخلف مندوب المستخدمين العامل الذي حصل في الانتخابات على عدد من الأصوات يلي مباشرة عدد الاصوات التي تحصل عليها آخر شخص منتخب كمندوب للمستخدمين."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_101> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_101> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1990-04-21"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/1990-04-21/90-11#version_art_102> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعد لجنة المشاركة نظامها الداخلي وتنتخب من بين اعضائها مكتبا يتكون من رئيس ونائب رئيس على الاقل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_102_19900421_OpEnact_e1e475e603> ;
    dzdoc:replacementText "تعد لجنة المشاركة نظامها الداخلي وتنتخب من بين اعضائها مكتبا يتكون من رئيس ونائب رئيس على الاقل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_102> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1990-04-21/90-11> ;
