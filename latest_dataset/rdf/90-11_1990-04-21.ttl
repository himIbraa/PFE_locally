<https://legal.dz/resource/law/1990-04-21/90-11#art_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:definesTerm dzterm:convention ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_6_sec_الاول> ;
    dzdoc:eId "art_114" ;
    dzdoc:fullText "الاتفاقية اتفاق مكتوب يتضمن شروط التشغيل والعمل فيما يخص فئة أو عدة فئات مهنية. وتبرم داخل الهيئة المستخدمة الواحدة بين المستخدم و الممثلين النقابيين للعمال . كما تبرم بين مجموعة مستخدمين أو تنظيم أو عدة تنظيمات نقابية تمثيلية للمستخدمين، من ناحية أو تنظيم أو عدة تنظيمات نقابية تمثيلية للعمال، من ناحية أخرى. تحدد شروط تمثيلية الاطراف المشاركة في التفاوض بموجب القانون المتعلق بكيفيات ممارسة الحق النقابي ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1990-04-21/90-11#art_114_right_0_1afd1b3c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_114> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1990-04-21/90-11#art_114_defocc_9cd130a5766a> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_114_para_0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_114_para_1>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_114_para_2>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_114_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_114_19900421_OpEnact_9f3cc9b495> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "114" ;
    dzdoc:position 106 ;
    dzdoc:usesTerm dzterm:employer,
        dzterm:employer_entity,
        dzterm:union_representatives .

<https://legal.dz/resource/law/1990-04-21/90-11#art_129> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_6_sec_5> ;
    dzdoc:eId "art_129" ;
    dzdoc:fullText "يمكن التنظيمات النقابية للعمال أو المستخدمين التي تربطهم اتفاقية جماعية ، أن تباشر كل الدعاوى الناشئة عن هذا السبب أمام القضاء لصالح أعضائها كما يمكنها أن ترفع دعوى لحسابها تستهدف الحصول على تنفيذ الالتزامات المتعاقد عليها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1990-04-21/90-11#art_129_permission_0_046394d9> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1990-04-21/90-11#art_129_right_0_bf9f66e0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_129_right_1_16543f42> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_129> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_129_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_129_19900421_OpEnact_12aa16eec5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 129" ;
    dzdoc:position 120 ;
    dzdoc:usesTerm dzterm:collective_agreement,
        dzterm:trade_unions .

<https://legal.dz/resource/law/1990-04-21/90-11#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_4> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "يمكن تأجيل الراحة الاسبوعية أو التمتع بها في يوم آخر اذا استدعت ذلك الضرورات الاقتصادية أو ضرورات تنظيم الانتاج . يحق للهيئات والمؤسسات الأخرى ان تجعل الراحة الاسبوعية تناوبية ، اذا كان التوقف عن العمل فيها يوم العطلة الاسبوعية يتعارض مع طبيعة نشاط الهيئة أو المؤسسة أو يضر العموم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1990-04-21/90-11#art_37_permission_0_0442b574> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1990-04-21/90-11#art_37_right_0_b5cfd5b8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_37_para_0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_37_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_37_19900421_OpEnact_38fd33e1a2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "37" ;
    dzdoc:position 34 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1990-04-21/90-11#art_37_condition_0_4b45d960>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_37_condition_1_92ecea15> .

<https://legal.dz/resource/law/1990-04-21/90-11#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_4> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "تمنح عطلة اضافية لا يمكن ان تقل عن عشرة (10) أيام في سنة العمل الواحدة في المناطق الجنوبية هي محددة عن طريق التنظيم. كما تحدد الاتفاقيات أو الاتفاقات الجماعية كيفيات تطبيق هذه المادة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1990-04-21/90-11#art_42_permission_0_859d7d2f> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1990-04-21/90-11#art_42_right_0_06402080> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_42> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_42_para_0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_42_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_42_19900421_OpEnact_3f9084c13f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "42" ;
    dzdoc:position 39 ;
    dzdoc:references <https://legal.dz/resource/law/1990-04-21/90-11#art_42> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1990-04-21/90-11#art_42> .

<https://legal.dz/resource/law/1990-04-21/90-11#art_54> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_4> ;
    dzdoc:eId "art_54" ;
    dzdoc:fullText "زيادة على حالات الغياب للاسباب المنصوص عليها في التشريع المتعلق بالضمان الاجتماعي يمكن العامل أن يتغيب، دون فقدان الاجر، اذا اعلم المستخدم بذلك وقدم له تبريرات مسبقا للاسباب التالية : تأدية مهام مرتبطة بتمثيل نقابي أو تمثيل المستخدمين حسب المدة التي حددتها الاحكام القانونية أو التعاقدية متابعة دورات التكوين المهني أو النقابي التي يسمح بها المستخدم والمشاركة في امتحانات اكاديمية أو مهنية وفي حدث من الاحداث العائلية التالية : زواج العامل وولادة مولود له زواج أحد فروع العامل، وفاة أحد الأصول أو الفروع أو الحواشي المباشرة للعامل أو لزوجه، وفاة زوج التعامل. وعطلة العامل في كل حالة من هذه الحالات ثلاثة أيام كاملة مدفوعة الأجر، تأدية فريضة الحج الى البقاع المقدسة، مرة واحدة خلال الحياة المهنية للعامل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1990-04-21/90-11#art_54_permission_0_22dc9aba> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1990-04-21/90-11#art_54_right_0_23c6946c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_54> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_54_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_54_19900421_OpEnact_c9376f9e0d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "54" ;
    dzdoc:position 50 ;
    dzdoc:usesTerm dzterm:employer .

