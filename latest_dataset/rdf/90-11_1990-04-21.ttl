<https://legal.dz/resource/law/1990-04-21/90-11#version_art_12> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن ابرام عقد العمل لمدة محدودة بالتوقيت الكامل أو التوقيت الجزئي في الحالات المنصوص عليها صراحة أدناه : عندما يوظف العامل لتنفيذ عمل مرتبط بعقود أشغال أو خدمات غير متجددة عندما يتعلق الأمر باستخلاف عامل مثبت في منصب تغيب عنه مؤقتا، و يجب على المستخدم أن يحتفظ بمنصب العمل لصاحبه ، عندما يتطلب الامر من الهيئة المستخدمة اجراء أشغال دورية ذات طابع متقطع عندما يبرر ذلك تزايد العمل أو أسباب موسمية. ويبين بدقة عقد العمل، في جميع هذه الحالات، مدة علاقة العمل وأسباب المدة المقررة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_12_19900421_OpEnact_f183437d37> ;
    dzdoc:replacementText "يمكن ابرام عقد العمل لمدة محدودة بالتوقيت الكامل أو التوقيت الجزئي في الحالات المنصوص عليها صراحة أدناه : عندما يوظف العامل لتنفيذ عمل مرتبط بعقود أشغال أو خدمات غير متجددة عندما يتعلق الأمر باستخلاف عامل مثبت في منصب تغيب عنه مؤقتا، و يجب على المستخدم أن يحتفظ بمنصب العمل لصاحبه ، عندما يتطلب الامر من الهيئة المستخدمة اجراء أشغال دورية ذات طابع متقطع عندما يبرر ذلك تزايد العمل أو أسباب موسمية. ويبين بدقة عقد العمل، في جميع هذه الحالات، مدة علاقة العمل وأسباب المدة المقررة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_12> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1990-04-21/90-11> ;
