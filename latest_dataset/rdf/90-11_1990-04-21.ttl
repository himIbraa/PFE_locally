    dznorm:sourceArticle "art_7" .

<https://legal.dz/resource/law/1990-04-21/90-11#art_7_obligation_5_f920e92d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
