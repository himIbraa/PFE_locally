<https://legal.dz/resource/law/1990-04-21/90-11#version_art_64> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعلق علاقة العمل قانونا للاسباب التالية : اتفاق الطرفين المتبادل عطل مرضية أو ما يماثلها كتلك التي ينص عليها التشريع والتنظيم المتعلقين بالضمان الاجتماعي اداء التزامات الخدمة الوطنية وفترات الابقاء ضمن قوات الاحتياط أو التدريب في اطارها ممارسة مهمة انتخابية عمومية، حرمان العامل من الحرية ما لم يصدر ضده حكم قضائي نهائي صدور قرار تأديبي يعلق ممارسة الوظيفة، ممارسة حق الاضراب عطلة بدون أجر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_64_19900421_OpEnact_73b54a0dba> ;
    dzdoc:replacementText "تعلق علاقة العمل قانونا للاسباب التالية : اتفاق الطرفين المتبادل عطل مرضية أو ما يماثلها كتلك التي ينص عليها التشريع والتنظيم المتعلقين بالضمان الاجتماعي اداء التزامات الخدمة الوطنية وفترات الابقاء ضمن قوات الاحتياط أو التدريب في اطارها ممارسة مهمة انتخابية عمومية، حرمان العامل من الحرية ما لم يصدر ضده حكم قضائي نهائي صدور قرار تأديبي يعلق ممارسة الوظيفة، ممارسة حق الاضراب عطلة بدون أجر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
