<https://legal.dz/resource/law/1990-04-21/90-11#version_art_140> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بغرامة مالية تتراوح من 1000 الى 2000 دج على كل توظيف عامل قاصر لم يبلغ السن المقررة، الا في حالة عقد التمهين المحرر، طبقا للتشريع والتنظيم المعمول بهما . وفي حالة العود ، يمكن اصدار عقوبة حبس تتراوح من 15 يوما الى شهرين دون المساس بالغرامة التي يمكن ان ترفع الى ضعف الغرامة المنصوص عليها في الفقرة السابقة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_140_19900421_OpEnact_7c96bd40ed> ;
    dzdoc:replacementText "يعاقب بغرامة مالية تتراوح من 1000 الى 2000 دج على كل توظيف عامل قاصر لم يبلغ السن المقررة، الا في حالة عقد التمهين المحرر، طبقا للتشريع والتنظيم المعمول بهما . وفي حالة العود ، يمكن اصدار عقوبة حبس تتراوح من 15 يوما الى شهرين دون المساس بالغرامة التي يمكن ان ترفع الى ضعف الغرامة المنصوص عليها في الفقرة السابقة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_140> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1990-04-21/90-11> ;
