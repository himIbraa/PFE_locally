<https://legal.dz/resource/law/1990-04-21/90-11#art_97_obligation_1_c721df34_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/law/1990-04-21/90-11#art_97_obligation_1_c721df34> ;
    dznorm:conditionText "شروط الناخب، البالغين 21 سنة كاملة والمثبتين لأقدمية أكثر من سنة في الهيئة المستخدمة"@ar .

<https://legal.dz/resource/law/1990-04-21/90-11#art_97_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_97> ;
    dzdoc:position 0 ;
    dzdoc:text "ينتخب العمال المعنيون بالاقتراع الفردي الحر والسري والمباشر مندوبي المستخدمين طبقا للمادتين 91 و92 أعلاه."@ar .

<https://legal.dz/resource/law/1990-04-21/90-11#art_97_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_97> ;
    dzdoc:position 1 ;
    dzdoc:text "ويعتبر غير قابل للانتخاب عليهم الاطارات القيادية في الهيئة المستخدمة، وأصول المستخدم وفروعه وحواشيه أو أقاربه بالنسب من الدرجة الاولى والاطارات المسيرة والعمال الذين يشغلون مناصب مسؤولية مع التمتع بسلطة تأديبية والعمال الذين لا يتمتعون بحقوقهم المدنية والوطنية."@ar .

<https://legal.dz/resource/law/1990-04-21/90-11#art_97_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_97> ;
    dzdoc:position 2 ;
    dzdoc:text "ينتخب مندوبو العمال من بين العمال المثبتين الذين تتوفر فيهم شروط الناخب، البالغين 21 سنة كاملة والمثبتين لأقدمية أكثر من سنة في الهيئة المستخدمة."@ar .

<https://legal.dz/resource/law/1990-04-21/90-11#art_98_obligation_0_3ee56a64> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
