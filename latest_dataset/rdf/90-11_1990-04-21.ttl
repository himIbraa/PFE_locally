<https://legal.dz/resource/law/1990-04-21/90-11#version_art_98> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب ان تسمح طريقة الانتخاب بتمثيل عادل لمختلف الفئات الاجتماعية والمهنية داخل مكان العمل و الهيئة المستخدمة المعنية. تحدد كيفيات تنظيم الانتخابات عن طريق التنظيم بعد استشارة التنظيمات النقابية للعمال والمستخدمين الاكثر تمثيلا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_98_19900421_OpEnact_5c8f7fadba> ;
