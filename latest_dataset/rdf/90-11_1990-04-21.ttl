<https://legal.dz/resource/law/1990-04-21/90-11#version_art_6> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحق للعمال أيضا، في اطار علاقة العمل ما التشغيل الفعلي احترام السلامة البدنية و المعنوية وكرامتهم، الحماية من أي تمييز لشغل منصب عمل غير المنصب القائم على أهليتهم واستحقاقهم، التكوين المهني والترقية في العمل الدفع المنتظم للاجر المستحق الخدمات الاجتماعية كل المنافع المرتبطة بعقد العمل ارتباطا نوعيا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_6_19900421_OpEnact_90d056943d> ;
