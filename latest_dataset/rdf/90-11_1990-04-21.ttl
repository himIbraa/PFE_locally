<https://legal.dz/resource/law/1990-04-21/90-11#version_art_128> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للأشخاص الذين تربطهم اتفاقية جماعية أن يرفعوا أية دعوى تستهدف الحصول على تنفيذ الالتزامات المتعاقد عليها دون المساس بالتعويضات التي قد يطلبونها بسبب خرق الاتفاقية المذكورة."@ar ;
