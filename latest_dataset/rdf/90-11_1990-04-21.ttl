    dzdoc:fullText "تحدد الاتفاقية الجماعية مجال تطبيقها المهني والاقليمي ويمكن أن تخص فئة واحدة أو عدة فئات اجتماعية مهنية أو عدة هيئات مستخدمة، كما يمكن أن تكتسي طابعا محليا أو جهويا أو وطنيا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1990-04-21/90-11#art_115_permission_0_99d83c70> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_115> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_115_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_115_19900421_OpEnact_f68a5b5186> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "115" ;
    dzdoc:position 107 ;
    dzdoc:usesTerm dzterm:collective_agreement .

<https://legal.dz/resource/law/1990-04-21/90-11#art_116> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_6_sec_الاول> ;
    dzdoc:eId "art_116" ;
    dzdoc:fullText "عندما تخص الاتفاقيات الجماعية عدة مؤسسات مستخدمة تلزم هذه الاخيرة ، شريطة أن يكون ممثلو العمال والمستخدمين لهذه المؤسسات أطرافا فيها أو أن ينضموا اليها باتفاق مشترك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_116> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_116_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_116_19900421_OpEnact_4e9971080c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_116_obligation_0_72af9e2a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "116" ;
    dzdoc:position 108 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1990-04-21/90-11#art_116_condition_0_abebe8fc>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_116_condition_1_f671c727> .

<https://legal.dz/resource/law/1990-04-21/90-11#art_134> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_6_sec_5> ;
    dzdoc:eId "art_134" ;
    dzdoc:fullText "اذا رأي مفتش العمل أن اتفاقية من الاتفاقيات الجماعية مخالفة للتشريع والتنظيم المعمول بهما، أو تلحق ضررا جسيما بمصالح الغير يعرضها تلقائيا على الجهة القضائية المختصة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_134> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_134_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_134_19900421_OpEnact_48d4d3f153> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_134_obligation_0_51aa59d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 134" ;
    dzdoc:position 125 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1990-04-21/90-11#art_134_condition_0_c835721f> ;
    dzdoc:usesTerm dzterm:labor_inspector .

<https://legal.dz/resource/law/1990-04-21/90-11#art_136> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_7> ;
    dzdoc:eId "art_136" ;
    dzdoc:fullText "يكون باطلا وعديم الاثر كل بند في عقد العمل مخالف للاحكام التشريعية والتنظيمية المعمول بهما . وتحل محله أحكام هذا القانون بقوة القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_136> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_136_para_0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_136_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_136_19900421_OpEnact_febb5bd1ad> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_136_obligation_0_5c827175> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "136" ;
    dzdoc:position 127 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1990-04-21/90-11#art_136_condition_0_7272f2cc> ;
    dzdoc:usesTerm dzterm:employment_contract .

<https://legal.dz/resource/law/1990-04-21/90-11#art_142> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_8> ;
    dzdoc:eId "art_142" ;
    dzdoc:fullText "يعاقب بغرامة مالية تتراوح من 2000 الى 5000 دج كل من يوقع اتفاقية جماعية أو اتفاقا جماعيا للعمل يكون من شأن احكامهما اقامة تمييز بين العمال في مجال الشغل أو الراتب وظروف العمل، كما وردت في المادة 17 من هذا القانون. ويعاقب في حالة العود بغرامة مالية تتراوح من 2000 دج الى 10.000 دج وبالحبس مدة ثلاثة أيام ( 03 ) أو باحدى هاتين العقوبتين فقط."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_142> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_142_para_0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_142_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_142_19900421_OpEnact_1f84efde66> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_142_obligation_0_01600d9f>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_142_obligation_1_e7d3616e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 142" ;
    dzdoc:position 133 ;
    dzdoc:references <https://legal.dz/resource/law/1990-04-21/90-11#art_17> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1990-04-21/90-11#art_17> .

<https://legal.dz/resource/law/1990-04-21/90-11#art_149> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_8> ;
    dzdoc:eId "art_149" ;
    dzdoc:fullText "يعاقب بغرامة مالية تتراوح من 1000 دج الى 2000 دج كل مستخدم يدفع لـ عامل أجرا يقل عن الاجر الوطني الأدنى المضمون أو الاجر الادنى المحدد في اتفاقية جماعية أو اتفاق جماعي للعمل وذلك دون الاخلال بالاحكام الأخرى الواردة في التشريع المعمول به، وتضاعف العقوبة حسب عدد المخالفات. وفي حالة العود ، تتراوح الغرامة المالية من 2000 دج الى 5000 دج وتضاعف حسب عدد المخالفات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_149> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_149_para_0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_149_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_149_19900421_OpEnact_afc0b5893c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_149_obligation_0_79958fae> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 149" ;
    dzdoc:position 140 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1990-04-21/90-11#art_149_condition_0_f24439c6> ;
    dzdoc:usesTerm dzterm:employer,
        dzterm:minimum_wage,
        dzterm:worker .

<https://legal.dz/resource/law/1990-04-21/90-11#art_158> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_8> ;
    dzdoc:eId "art_158" ;
    dzdoc:fullText "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 26 رمضان عام 1410 الموافق 21 ابريل سنة 1990. الشاذلي بن جديد"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_158> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_158_para_0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_158_para_1>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_158_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_158_19900421_OpEnact_43df7f9efd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_158_obligation_0_da3a9505> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 158" ;
    dzdoc:position 149 .

<https://legal.dz/resource/law/1990-04-21/90-11#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_2> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "يجب على المؤسسات المستخدمة ان تخصص مناصب عمل للاشخاص المعوقين وفق كيفيات تحدد عن طريق التنظيم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_16_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_16_19900421_OpEnact_92677a932d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_16_obligation_0_9ae2c09c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 16" ;
    dzdoc:position 14 ;
    dzdoc:usesTerm dzterm:disabled_persons,
        dzterm:employer_entities .

<https://legal.dz/resource/law/1990-04-21/90-11#art_22> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_3> ;
    dzdoc:eId "art_22" ;
    dzdoc:fullText "المدة القانونية للعمل أربع وأربعون (44) ساعة في الاسبوع اثناء ظروف العمل العادية. وتتوزع هذه الساعات على خمسة أيام كاملة على الاقل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_22> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_22_para_0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_22_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_22_19900421_OpEnact_685382b679> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 22" ;
    dzdoc:position 19 ;
    dzdoc:usesTerm dzterm:legal_working_hours .

<https://legal.dz/resource/law/1990-04-21/90-11#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_3> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "يجوز استثناء ل المادة 22 أعلاه أن تكون مدة العمل الاسبوعية كما يأتي : أن تخفض للاشخاص الذين يقومون بأشغال شاقة وخطيرة أو تترتب عليها متاعب بدنية أو عصبية. وان ترفع لبعض مناصب العمل المتضمنة فترات التوقف عن النشاط. وتحدد الاتفاقيات أو الاتفاقات الجماعية قائمة المناصب المعنية وتوضح لكل منصب مقدار تخفيض العمل أو رفعها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1990-04-21/90-11#art_23_permission_0_4c597154> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_23_para_0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_23_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_23_19900421_OpEnact_3f35b3e850> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "المادة 23" ;
    dzdoc:position 20 ;
    dzdoc:references <https://legal.dz/resource/law/1990-04-21/90-11#art_22> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1990-04-21/90-11#art_22> .

<https://legal.dz/resource/law/1990-04-21/90-11#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_7> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "يمكن المستخدم في المؤسسات التي تشغل أقل من عشرين ( 20 ) عاملا أن يعد نظاما داخليا ، حسب خصوصيات الأنشطة الممارسة. تحدد طبيعة هذه الأنشطة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1990-04-21/90-11#art_76_permission_0_201c332d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_76_para_0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_76_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_76_19900421_OpEnact_8f72f5e8bd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "76" ;
    dzdoc:position 70 ;
    dzdoc:usesTerm dzterm:employer,
        dzterm:internal_regulation .

<https://legal.dz/resource/law/1990-04-21/90-11#art_84> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_4_sec_1> ;
    dzdoc:eId "art_84" ;
    dzdoc:fullText "يجب على كل مستخدم ضمان المساواة في الاجور بين العمال لكل عمل مساوي القيمة بدون أي تمييز."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_84> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_84_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_84_19900421_OpEnact_a4f6d2a175> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_84_obligation_0_01eeb213> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "84" ;
    dzdoc:position 77 .

<https://legal.dz/resource/law/1990-04-21/90-11#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_4_sec_3> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "يجب على المستخدم دفع الأجور لكل عامل بانتظام عند حلول أجل استحقاقه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_88_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_88_19900421_OpEnact_d1e0f60c78> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1990-04-21/90-11#art_88_obligation_0_8c85d6bb> ;
