    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_112> ;
    dzdoc:position 0 ;
    dzdoc:text "يخضع مندوبو المستخدمين عند ممارستهم لاعمالهم المهنية للاحكام التشريعية والتنظيمية والتعاقدية المتعلقة بحقوق العمال وواجباتهم."@ar .

