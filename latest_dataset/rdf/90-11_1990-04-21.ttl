<https://legal.dz/resource/law/1990-04-21/90-11#version_art_68> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الاستقالة حق معترف به للعامل . على العامل الذي يبدى رغبته في انهاء علاقة العمل مع الهيئة المستخدمة أن يقدم استقالته كتابة . ويغادر منصب عمله بعد فترة اشعار مسبق وفقا للشروط التي تحددها الاتفاقيات أو الاتفاقات الجماعية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_68_19900421_OpEnact_5edf17721b> ;
    dzdoc:replacementText "الاستقالة حق معترف به للعامل . على العامل الذي يبدى رغبته في انهاء علاقة العمل مع الهيئة المستخدمة أن يقدم استقالته كتابة . ويغادر منصب عمله بعد فترة اشعار مسبق وفقا للشروط التي تحددها الاتفاقيات أو الاتفاقات الجماعية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
