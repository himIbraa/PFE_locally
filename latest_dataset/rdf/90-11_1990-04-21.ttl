<https://legal.dz/resource/law/1990-04-21/90-11#version_art_53> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن ان يتقاضى العامل أجر فترة لم يعمل فيها مهما تكن وضعيته في الترتيب السلمي، ما عدا في الحالات التي ينص عليها القانون أو التنظيم صراحة، وذلك دون الاخلال بالتدابير التأديبية الواردة في النظام الداخلي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_53_19900421_OpEnact_a71f129dbb> ;
    dzdoc:replacementText "لا يمكن ان يتقاضى العامل أجر فترة لم يعمل فيها مهما تكن وضعيته في الترتيب السلمي، ما عدا في الحالات التي ينص عليها القانون أو التنظيم صراحة، وذلك دون الاخلال بالتدابير التأديبية الواردة في النظام الداخلي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_53> ;
