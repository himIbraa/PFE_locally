<https://legal.dz/resource/law/1990-04-21/90-11#version_art_66> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنتهي علاقة العمل في الحالات التالية : البطلان أو الالغاء القانوني، انقضاء أجل عقد العمل ذي المدة المحدودة، الاستقالة، العزل، العجز الكامل عن العمل كما ورد تحديده في التشريع، التقاعد، التسريح للتقليص من عدد العمال، انهاء النشاط القانوني للهيئة المستخدمة . الوفاة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_66_19900421_OpEnact_f0a45a027f> ;
    dzdoc:replacementText "تنتهي علاقة العمل في الحالات التالية : البطلان أو الالغاء القانوني، انقضاء أجل عقد العمل ذي المدة المحدودة، الاستقالة، العزل، العجز الكامل عن العمل كما ورد تحديده في التشريع، التقاعد، التسريح للتقليص من عدد العمال، انهاء النشاط القانوني للهيئة المستخدمة . الوفاة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_66> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1990-04-21/90-11> ;
