        dzdoc:LegalTerm ;
    skos:prefLabel "النظام الداخلي"@ar,
        "النظام الداخلي هو وثيقة مكتوبة يحدد فيها المستخدم، لزوما ، القواعد المتعلقة بالتنظيم التقني للعمل والوقاية الصحية والأمن والانضباط"@ar,
        "نظاما داخليا"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1990-04-21/90-11#art_77_defocc_80b55efd8e92> .

