<https://legal.dz/resource/law/1990-04-21/90-11#version_art_117> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبرم الاتفاقية الجماعية لمدة محدودة أو غير محدودة. وان لم توجد شروط مغايرة تبقى الاتفاقية ذات المدة المحدودة التي حل أجلها سارية المفعول كاتفاقية أو اتفاق غير محدودي المدة حتى يتوصل الطرفان الى اتفاقية جديدة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_117_19900421_OpEnact_3eb86c9b6b> ;
    dzdoc:replacementText "تبرم الاتفاقية الجماعية لمدة محدودة أو غير محدودة. وان لم توجد شروط مغايرة تبقى الاتفاقية ذات المدة المحدودة التي حل أجلها سارية المفعول كاتفاقية أو اتفاق غير محدودي المدة حتى يتوصل الطرفان الى اتفاقية جديدة."@ar ;
