<https://legal.dz/resource/law/1990-04-21/90-11#art_46_obligation_0_007200c4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_46> ;
    dznorm:position 0 ;
    dznorm:provisionText "تعتبر فترات عمل لتحديد مدة العطلة السنوية ما يأتي :"@ar ;
    dznorm:sourceArticle "art_46" .

<https://legal.dz/resource/law/1990-04-21/90-11#art_46_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_46> ;
    dzdoc:position 0 ;
    dzdoc:text "تعتبر فترات عمل لتحديد مدة العطلة السنوية ما يأتي : فترات العمل المؤدى فترات العطل السنوية، فترات الغيابات الخاصة المدفوعة الاجر أو التي يرخص بها المستخدم فترات الراحة القانونية المنصوص عليها في المواد المذكورة اعلاه فترات الغيابات بسبب الأمومة والمرض وحوادث العمل، فترات البقاء في الجيش أو اعادة التجنيد."@ar .

