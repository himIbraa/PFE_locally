<https://legal.dz/resource/law/1990-04-21/90-11#version_art_57> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على كل مستخدم أن يباشر أعمالا تتعلق بالتكوين وتحسين المستوى لصالح العمال ، حسب برنامج يعرضه على لجنة المشاركة لابداء الرأي، كما يجب عليه، في اطار التشريع المعمول به أن ينظم أعمالا تتعلق بالتمهين لتمكين الشباب من اكتساب معارف نظرية وتطبيقية ضرورية لممارسة مهنة ما ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_57_19900421_OpEnact_81a0df83a7> ;
    dzdoc:replacementText "يجب على كل مستخدم أن يباشر أعمالا تتعلق بالتكوين وتحسين المستوى لصالح العمال ، حسب برنامج يعرضه على لجنة المشاركة لابداء الرأي، كما يجب عليه، في اطار التشريع المعمول به أن ينظم أعمالا تتعلق بالتمهين لتمكين الشباب من اكتساب معارف نظرية وتطبيقية ضرورية لممارسة مهنة ما ."@ar ;
