<https://legal.dz/resource/law/1990-04-21/90-11#version_art_119> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على الهيئات المستخدمة أن تقوم باشهار كل الاتفاقيات الجماعية التي تكون طرفا فيها في أوساط جماعات العمال المعنيين و توضع نسخة من الاتفاقيات الجماعية، دوما، تحت تصرف العمال وفي موضع مميز في كل مكان عمل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_119_19900421_OpEnact_93d02e48a0> ;
    dzdoc:replacementText "يجب على الهيئات المستخدمة أن تقوم باشهار كل الاتفاقيات الجماعية التي تكون طرفا فيها في أوساط جماعات العمال المعنيين و توضع نسخة من الاتفاقيات الجماعية، دوما، تحت تصرف العمال وفي موضع مميز في كل مكان عمل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_119> ;
