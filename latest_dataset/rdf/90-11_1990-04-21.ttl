<https://legal.dz/resource/law/1990-04-21/90-11#version_art_114> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الاتفاقية اتفاق مكتوب يتضمن شروط التشغيل والعمل فيما يخص فئة أو عدة فئات مهنية. وتبرم داخل الهيئة المستخدمة الواحدة بين المستخدم و الممثلين النقابيين للعمال . كما تبرم بين مجموعة مستخدمين أو تنظيم أو عدة تنظيمات نقابية تمثيلية للمستخدمين، من ناحية أو تنظيم أو عدة تنظيمات نقابية تمثيلية للعمال، من ناحية أخرى. تحدد شروط تمثيلية الاطراف المشاركة في التفاوض بموجب القانون المتعلق بكيفيات ممارسة الحق النقابي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_114_19900421_OpEnact_9f3cc9b495> ;
    dzdoc:replacementText "الاتفاقية اتفاق مكتوب يتضمن شروط التشغيل والعمل فيما يخص فئة أو عدة فئات مهنية. وتبرم داخل الهيئة المستخدمة الواحدة بين المستخدم و الممثلين النقابيين للعمال . كما تبرم بين مجموعة مستخدمين أو تنظيم أو عدة تنظيمات نقابية تمثيلية للمستخدمين، من ناحية أو تنظيم أو عدة تنظيمات نقابية تمثيلية للعمال، من ناحية أخرى. تحدد شروط تمثيلية الاطراف المشاركة في التفاوض بموجب القانون المتعلق بكيفيات ممارسة الحق النقابي ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_114> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_114> ;
