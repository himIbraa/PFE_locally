    dznorm:position 0 ;
    dznorm:provisionText "يعدل عقد العمل اذا كان القانون أو التنظيم أو الاتفاقيات أو الاتفاقات الجماعية تملي قواعد أكثر نفعا للعمال من تلك التي نص عليها عقد العمل"@ar ;
