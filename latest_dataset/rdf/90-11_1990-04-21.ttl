<https://legal.dz/resource/law/1990-04-21/90-11#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1990-04-21/90-11#chp_3_sec_6> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "يجوز للمستخدم تقليص عدد المستخدمين اذا بررت ذلك أسباب اقتصادية . واذا كان تقليص العدد ينبني على اجراء التسريح الجماعي ، فان ترجمته تتم في شكل تسريحات فردية متزامنة ويتخذ قراره بعد تفاوض جماعي. يمنع على أي مستخدم قام بتقليص عدد المستخدمين اللجوء في أماكن العمل نفسها الى توظيفات جديدة في الأصناف المهنية المعنية بالتقليص ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1990-04-21/90-11#art_69_permission_0_2fed0a1d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1990-04-21/90-11#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1990-04-21/90-11#art_69_para_0>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_69_para_1>,
        <https://legal.dz/resource/law/1990-04-21/90-11#art_69_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
