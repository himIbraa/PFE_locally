<https://legal.dz/resource/law/1990-04-21/90-11#version_art_156> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد التنظيم، قصد تطبيق هذا القانون الدفاتر والسجلات الخاصة التي يلزم بها كل مستخدم كما يحدد مضمونها. يقدم المستخدم هذه السجلات كلما يطلبها مفتش العمل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_156_19900421_OpEnact_9d935abd0c> ;
