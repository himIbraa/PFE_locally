<https://legal.dz/resource/law/1990-04-21/90-11#art_125_obligation_0_3c694ba4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/1990-04-21/90-11#art_125> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعين كل واحد من الطرفين في التفاوض السير المفاوضات الجماعية، رئيسا يعبر عن رأي اغلبية أعضاء الوفد الذي يقوده ويصبح ناطقه الرسمي."@ar ;
    dznorm:sourceArticle "art_125" .

<https://legal.dz/resource/law/1990-04-21/90-11#art_125_para_0> a dzdoc:Paragraph ;
