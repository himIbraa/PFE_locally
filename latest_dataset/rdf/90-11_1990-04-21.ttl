<https://legal.dz/resource/law/1990-04-21/90-11#version_art_129> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن التنظيمات النقابية للعمال أو المستخدمين التي تربطهم اتفاقية جماعية ، أن تباشر كل الدعاوى الناشئة عن هذا السبب أمام القضاء لصالح أعضائها كما يمكنها أن ترفع دعوى لحسابها تستهدف الحصول على تنفيذ الالتزامات المتعاقد عليها ."@ar ;
