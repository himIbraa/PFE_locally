<https://legal.dz/resource/law/1990-04-21/90-11#version_art_123> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون التفاوض في الاتفاقيات الجماعية بناء على طلب أحد الطرفين المذكورين في المادة 114 أعلاه، وتقوم به لجان متساوية الاعضاء للتفاوض تتكون من عدد مساو من الممثلين النقابيين للعمال وعدد من المستخدمين ينتدبهم أولئك الذين يمثلونهم. ويختص كل واحد من الطرفين في التفاوض بتعيين من يمثلونه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_123_19900421_OpEnact_3058931abc> ;
    dzdoc:replacementText "يكون التفاوض في الاتفاقيات الجماعية بناء على طلب أحد الطرفين المذكورين في المادة 114 أعلاه، وتقوم به لجان متساوية الاعضاء للتفاوض تتكون من عدد مساو من الممثلين النقابيين للعمال وعدد من المستخدمين ينتدبهم أولئك الذين يمثلونهم. ويختص كل واحد من الطرفين في التفاوض بتعيين من يمثلونه."@ar ;
