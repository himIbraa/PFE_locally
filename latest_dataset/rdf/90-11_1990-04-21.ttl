<https://legal.dz/resource/law/1990-04-21/90-11#version_art_42> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تمنح عطلة اضافية لا يمكن ان تقل عن عشرة (10) أيام في سنة العمل الواحدة في المناطق الجنوبية هي محددة عن طريق التنظيم. كما تحدد الاتفاقيات أو الاتفاقات الجماعية كيفيات تطبيق هذه المادة ."@ar ;
