    dzdoc:introducedOn "1990-04-21"^^xsd:date ;
    dzdoc:number "88" ;
    dzdoc:position 80 ;
    dzdoc:usesTerm dzterm:employer,
        dzterm:wage,
        dzterm:worker .

dzterm:collective_agreement a skos:Concept,
