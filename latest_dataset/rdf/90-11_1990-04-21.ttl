<https://legal.dz/resource/law/1990-04-21/90-11#version_art_79> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يودع النظام الداخلي ، المنصوص عليه في المادة 75 أعلاه لدى مفتشية العمل المختصة اقليميا للمصادقة على مطابقته للتشريع والتنظيم المتعلقين بالعمل في أجل ثمانية ( 08 ) أيام . يسري مفعول النظام الداخلي فور ايداعه لدى كتابة الضبط للمحكمة المختصة اقليميا. ويضمن له المستخدم اشهارا واسعا في أوساط العمال المعنيين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_79_19900421_OpEnact_bfa9c2e2cc> ;
    dzdoc:replacementText "يودع النظام الداخلي ، المنصوص عليه في المادة 75 أعلاه لدى مفتشية العمل المختصة اقليميا للمصادقة على مطابقته للتشريع والتنظيم المتعلقين بالعمل في أجل ثمانية ( 08 ) أيام . يسري مفعول النظام الداخلي فور ايداعه لدى كتابة الضبط للمحكمة المختصة اقليميا. ويضمن له المستخدم اشهارا واسعا في أوساط العمال المعنيين ."@ar ;
