<https://legal.dz/resource/law/1990-04-21/90-11#version_art_103> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تجتمع لجنة المشاركة مرة واحدة في كل ثلاثة ( 03 ) أشهر على الاقل و تجتمع اجباريا بطلب من رئيسها أو بطلب من أغلبية أعضائها ، و يجب ابلاغ المستخدم بجدول أعمال هذه الاجتماعات قبل 15 يوما من تاريخ اجتماعها . ويمكن المستخدم أن يفوض واحدا أو أكثر من مساعديه لحضور هذه الاجتماعات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_103_19900421_OpEnact_bbfc69f0cc> ;
    dzdoc:replacementText "تجتمع لجنة المشاركة مرة واحدة في كل ثلاثة ( 03 ) أشهر على الاقل و تجتمع اجباريا بطلب من رئيسها أو بطلب من أغلبية أعضائها ، و يجب ابلاغ المستخدم بجدول أعمال هذه الاجتماعات قبل 15 يوما من تاريخ اجتماعها . ويمكن المستخدم أن يفوض واحدا أو أكثر من مساعديه لحضور هذه الاجتماعات ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_103> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_103> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1990-04-21"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/1990-04-21/90-11#version_art_104> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجتمع مكتب لجنة المشاركة ، أيضا تحت رئاسة المستخدم أو ممثله المخول قانونا يساعده مساعدوه الاقربون مرة واحدة على الاقل كل ثلاثة أشهر . ويجب أن يبلغ جدول أعمال هذه الاجتماعات الى رئيس مكتب لجنة المشاركة قبل ثلاثين (30) يوما على الاقل كما يجب أن يتناول مواضيع تابعة لاختصاصات لجنة المشاركة . وتبلغ الملفات الخاصة بالمسائل المطلوب تناولها الى رئيس لجنة المشاركة . يمكن مكتب لجنة المشاركة أن يقترح اضافة نقاط لجدول أعمال الاجتماع ، شريطة أن تكون المسائل التي تثار داخلة في اختصاصه وأن تصل الملفات المطابقة"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_104_19900421_OpEnact_2a6ef5af70> ;
    dzdoc:replacementText "يجتمع مكتب لجنة المشاركة ، أيضا تحت رئاسة المستخدم أو ممثله المخول قانونا يساعده مساعدوه الاقربون مرة واحدة على الاقل كل ثلاثة أشهر . ويجب أن يبلغ جدول أعمال هذه الاجتماعات الى رئيس مكتب لجنة المشاركة قبل ثلاثين (30) يوما على الاقل كما يجب أن يتناول مواضيع تابعة لاختصاصات لجنة المشاركة . وتبلغ الملفات الخاصة بالمسائل المطلوب تناولها الى رئيس لجنة المشاركة . يمكن مكتب لجنة المشاركة أن يقترح اضافة نقاط لجدول أعمال الاجتماع ، شريطة أن تكون المسائل التي تثار داخلة في اختصاصه وأن تصل الملفات المطابقة التي أعدها مكتب لجنة المشاركة الى المستخدم قبل خمسة عشر (15) يوما على الاقل من التاريخ المقرر لعقد الاجتماع ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_104> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1990-04-21/90-11#art_104> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1990-04-21"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

