<https://legal.dz/resource/law/1990-04-21/90-11#version_art_46> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعتبر فترات عمل لتحديد مدة العطلة السنوية ما يأتي : فترات العمل المؤدى فترات العطل السنوية، فترات الغيابات الخاصة المدفوعة الاجر أو التي يرخص بها المستخدم فترات الراحة القانونية المنصوص عليها في المواد المذكورة اعلاه فترات الغيابات بسبب الأمومة والمرض وحوادث العمل، فترات البقاء في الجيش أو اعادة التجنيد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
