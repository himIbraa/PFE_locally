dzorg:parliament a dzdoc:Organization ;
    rdfs:label "البرلمان"@ar ;
    dzdoc:frbrUri "/ontology/organization/dz/parliament"^^xsd:anyURI .

dzterm:collective_agreements a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الاتفاقيات الجماعية"@ar .

dzterm:convention a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الاتفاقية اتفاق مكتوب يتضمن شروط التشغيل والعمل فيما يخص فئة أو عدة فئات مهنية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1990-04-21/90-11#art_114_defocc_9cd130a5766a> .

dzterm:employee_representatives a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "مندوبي المستخدمين"@ar .

dzterm:employer_body a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الهيئة المستخدمة"@ar,
        "هيئة مستخدمة"@ar .

dzterm:higher_level_agreement a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تعتبر الاتفاقيات الجماعية التي تتجاوز اطار الهيئة المستخدمة من درجة أعلى بمجرد ما تتفاوض في شأنها وتبرمها التنظيمات النقابية للعمال والمستخدمين المعترف بتمثيلها في مجال التطبيق القطاعي أو المهني أو الاقليمي لتلك الاتفاقيات."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1990-04-21/90-11#art_122_defocc_d6e7a355abb1> .

dzterm:labor_contract a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "عقد العمل"@ar .

dzterm:labor_inspectorate a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "مفتشية العمل"@ar .

dzterm:labor_inspectors a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "مفتشو العمل"@ar .

dzterm:leave_compensation a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يساوي تعويض العطلة السنوية الجزء الثاني عشر من الاجر الكامل الذي يتقاضاه العامل خلال السنة المرجعية للعطلة أو في ضوء السنة السابقة للعطلة ."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1990-04-21/90-11#art_52_defocc_4d791718d414> .

dzterm:minimum_wage a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الأجر الوطني الأدنى المضمون"@ar,
        "الاجر الوطني الأدنى المضمون"@ar .

dzterm:night_work a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يعتبر كل عمل ينفذ ما بين الساعة التاسعة ليلا والساعة الخامسة صباحا، عملا ليليا"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1990-04-21/90-11#art_27_defocc_a82e76cd9f3a> .

dzterm:promotion a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تتجسد الترقية في التدرج داخل سلم التأهيل أو داخل الترتيب السلمي المهني"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1990-04-21/90-11#art_61_defocc_aa1d22a64a7b> .

dzterm:proportional_income a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يفهم من عبارة الدخل المتناسب مع نتائج العمل الاجرة حسب المردود، لاسيما العمل بالالتزام أو بالقطعة أو العمل بالحصة أو حسب رقم الاعمال."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1990-04-21/90-11#art_82_defocc_fd09f8252611> .

dzterm:recidivism a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "ويعتبر عودا اذا أدين المخالف بسبب مخالفة مماثلة خلال الاثني عشر (12) شهرا السابقة للواقعة الملاحقة."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1990-04-21/90-11#art_139_defocc_1f94e43eeef9> .

dzterm:trade_unions a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التنظيمات النقابية للعمال"@ar,
        "التنظيمات النقابية للعمال والمستخدمين"@ar .

dzterm:workers_delegates a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "مندوبو العمال"@ar,
        "مندوبي العمال"@ar .

