    dzdoc:producesVersion <https://legal.dz/resource/law/1990-04-21/90-11#version_art_148_19900421_OpEnact_da4a18f6fe> ;
    dzdoc:replacementText "يعاقب بغرامة مالية تتراوح من 500 دج الى 1000 دج كل من دفع أجرا لعامل دون أن يسلمه قسيمة الراتب المطابقة للاجر المقبوض ، أو يغفل فيها عنصرا أو عدة عناصر يتكون منها الراتب المقبوض وتضاعف العقوبة حسب عدد المخالفات."@ar ;
