<https://legal.dz/resource/law/2009-02-25/09-03#version_art_55> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتمثل الإيداع في وقف منتوج معروض للاستهلاك ثبت بعد المعاينة المباشرة، أنه غير مطابق ، وذلك بقرار من الإدارة المكلفة بحماية المستهلك وقمع الغش . ويتقرر الإيداع قصد ضبط مطابقة المنتوج المشتبه فيه من طرف المتدخل المعني. يعلن عن رفع الإيداع من طرف الإدارة المكلفة بحماية المستهلك وقمع الغش بعد معاينة ضبط مطابقة المنتوج."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_55_20090225_OpEnact_16796b0c52> ;
    dzdoc:replacementText "يتمثل الإيداع في وقف منتوج معروض للاستهلاك ثبت بعد المعاينة المباشرة، أنه غير مطابق ، وذلك بقرار من الإدارة المكلفة بحماية المستهلك وقمع الغش . ويتقرر الإيداع قصد ضبط مطابقة المنتوج المشتبه فيه من طرف المتدخل المعني. يعلن عن رفع الإيداع من طرف الإدارة المكلفة بحماية المستهلك وقمع الغش بعد معاينة ضبط مطابقة المنتوج."@ar ;
