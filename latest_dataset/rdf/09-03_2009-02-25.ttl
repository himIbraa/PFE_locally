    dzdoc:targetEId "art_25" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_26_obligation_1_49e5894f_role_3bcbd58d7d> a dznorm:Role ;
    rdfs:label "الأعوان المذكورين في المادة"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يجب على الأعوان المذكورين في المادة 25 أعلاه، في إطار ممارسة مهامهم، تبيان وظيفتهم و تقديم تفويضهم بالعمل."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_26> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_26_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_26> ;
    dzdoc:position 0 ;
    dzdoc:text """يجب على أعوان قمع الغش المذكورين في المادة 25 أعلاه، أن يفوضوا بالعمل طبقا للأحكام التشريعية والتنظيمية السارية المفعول، وأن يؤدوا أمام محكمة إقامتهم الإدارية اليمين الآتية:
            "أقسم بالله العلي العظيم أن أقوم بأعمال وظيفتي بأمانة وصدق وأحافظ على السر المهني وأراعي في كل الأحوال الواجبات المفروضة علي ..\""""@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_26_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_26> ;
    dzdoc:position 1 ;
    dzdoc:text "تسلم المحكمة إشهادا بذلك يوضع على بطاقة التفويض بالعمل."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_26_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_26> ;
    dzdoc:position 2 ;
    dzdoc:text "لا تجدد اليمين ما لم يكن انقطاع نهائي عن الوظيفة."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_26_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_26> ;
    dzdoc:position 3 ;
    dzdoc:text "يجب على الأعوان المذكورين في المادة 25 أعلاه، في إطار ممارسة مهامهم، تبيان وظيفتهم و تقديم تفويضهم بالعمل."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_27_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_27> ;
    dzdoc:position 0 ;
    dzdoc:text "يتمتع الأعوان المذكورون في المادة 25 أعلاه، بالحماية القانونية من جميع أشكال الضغط أو التهديد التي من شأنها أن تشكل عائقا في أداء مهامهم طبقا للأحكام التشريعية السارية المفعول."@ar .

