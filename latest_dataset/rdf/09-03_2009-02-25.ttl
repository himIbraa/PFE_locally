    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_86> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_87_condition_0_5858150b> a dznorm:Condition ;
    dznorm:conditionText "إذا كانت المخالفة المسجلة تعرض صاحبها، إما إلى عقوبة أخرى غير العقوبة المالية وإما تتعلق بتعويض ضرر مسبب للأشخاص أو الأملاك"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_87> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2009-02-25/09-03#art_87_condition_1_a583353e> a dznorm:Condition ;
