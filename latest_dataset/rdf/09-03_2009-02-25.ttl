<https://legal.dz/resource/law/2009-02-25/09-03#version_art_18> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن تحرر بيانات الوسم وطريقة الاستخدام ودليل الاستعمال وشروط ضمان المنتوج وكل معلومة أخرى منصوص عليها في التنظيم الساري المفعول باللغة العربية أساسا ، وعلى سبيل الإضافة، يمكن استعمال لغة أو عدة لغات أخرى سهلة الفهم من المستهلكين، وبطريقة مرئية ومقروءة ومتعذر محوها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_18_20090225_OpEnact_21026ee85f> ;
    dzdoc:replacementText "يجب أن تحرر بيانات الوسم وطريقة الاستخدام ودليل الاستعمال وشروط ضمان المنتوج وكل معلومة أخرى منصوص عليها في التنظيم الساري المفعول باللغة العربية أساسا ، وعلى سبيل الإضافة، يمكن استعمال لغة أو عدة لغات أخرى سهلة الفهم من المستهلكين، وبطريقة مرئية ومقروءة ومتعذر محوها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2009-02-25/09-03#art_18> ;
