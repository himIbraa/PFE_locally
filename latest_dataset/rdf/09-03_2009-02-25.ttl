<https://legal.dz/resource/law/2009-02-25/09-03#version_art_62> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينفذ السحب النهائي من طرف الأعوان المذكورين في المادة 25 أعلاه، دون رخصة مسبقة من السلطة القضائية المختصة في الحالات الآتية: المنتوجات التي ثبت أنها مزورة أو مغشوشة أو سامة أو التي انتهت مدة صلاحيتها، المنتوجات التي ثبت عدم صلاحيتها للاستهلاك، حيازة المنتوجات دون سبب شرعي والتي يمكن استعمالها في التزوير، المنتوجات المقلدة، الأشياء أو الأجهزة التي تستعمل للقيام بالتزوير. يعلم وكيل الجمهورية بذلك فورا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_62_20090225_OpEnact_f4baa154a0> ;
    dzdoc:replacementText "ينفذ السحب النهائي من طرف الأعوان المذكورين في المادة 25 أعلاه، دون رخصة مسبقة من السلطة القضائية المختصة في الحالات الآتية: المنتوجات التي ثبت أنها مزورة أو مغشوشة أو سامة أو التي انتهت مدة صلاحيتها، المنتوجات التي ثبت عدم صلاحيتها للاستهلاك، حيازة المنتوجات دون سبب شرعي والتي يمكن استعمالها في التزوير، المنتوجات المقلدة، الأشياء أو الأجهزة التي تستعمل للقيام بالتزوير. يعلم وكيل الجمهورية بذلك فورا."@ar ;
