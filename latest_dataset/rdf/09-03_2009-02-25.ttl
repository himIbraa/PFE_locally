<https://legal.dz/resource/law/2009-02-25/09-03#version_art_87> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن فرض غرامة الصلح: إذا كانت المخالفة المسجلة تعرض صاحبها، إما إلى عقوبة أخرى غير العقوبة المالية وإما تتعلق بتعويض ضرر مسبب للأشخاص أو الأملاك ، في حالة تعدد المخالفات التي لا يطبق في إحداها على الأقل إجراء غرامة الصلح ، في حالة العود ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_87_20090225_OpEnact_f74fd764fa> ;
    dzdoc:replacementText "لا يمكن فرض غرامة الصلح: إذا كانت المخالفة المسجلة تعرض صاحبها، إما إلى عقوبة أخرى غير العقوبة المالية وإما تتعلق بتعويض ضرر مسبب للأشخاص أو الأملاك ، في حالة تعدد المخالفات التي لا يطبق في إحداها على الأقل إجراء غرامة الصلح ، في حالة العود ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
