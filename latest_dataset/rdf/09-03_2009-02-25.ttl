<https://legal.dz/resource/law/2009-02-25/09-03#version_art_14> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل ضمان آخر مقدم من المتدخل بمقابل أو مجانا، لا يلغي الاستفادة من الضمان القانوني المنصوص عليه في المادة 13 أعلاه. يجب أن تبين بنود وشروط تنفيذ هذه الضمانات في وثيقة مرافقة للمنتوج ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
