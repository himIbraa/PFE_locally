    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يتحمل المتدخل المصاريف والتكاليف لاسترجاع المنتوج المشتبه فيه أينما وجد في حالة السحب النهائي المنصوص عليه في المادة 62 أعلاه ، إذا كان هذا المنتوج قابلا للاستهلاك يوجه مجانا، حسب الحالة، إلى مركز ذي منفعة عامة، أو يوجه للإتلاف إذا كان مقلدا أو غير صالح للاستهلاك. ويعلم وكيل الجمهورية بذلك فورا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_63_20090225_OpEnact_808b7f032b> ;
    dzdoc:replacementText "يجب أن يتحمل المتدخل المصاريف والتكاليف لاسترجاع المنتوج المشتبه فيه أينما وجد في حالة السحب النهائي المنصوص عليه في المادة 62 أعلاه ، إذا كان هذا المنتوج قابلا للاستهلاك يوجه مجانا، حسب الحالة، إلى مركز ذي منفعة عامة، أو يوجه للإتلاف إذا كان مقلدا أو غير صالح للاستهلاك. ويعلم وكيل الجمهورية بذلك فورا."@ar ;
