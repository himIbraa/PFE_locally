<https://legal.dz/resource/law/2009-02-25/09-03#version_art_20> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "دون الإخلال بالأحكام التشريعية السارية المفعول ، يجب أن تستجيب عروض القرض للاستهلاك للرغبات المشروعة للمستهلك فيما يخص شفافية العرض المسبق وطبيعة ومضمون ومدة الالتزام وكذا أجال تسديده، ويحرر عقد بذلك . تحدد شروط وكيفيات العروض في مجال قروض الاستهلاك عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_20_20090225_OpEnact_9d26b2e93e> ;
