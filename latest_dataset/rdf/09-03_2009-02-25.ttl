<https://legal.dz/resource/law/2009-02-25/09-03#version_art_51> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تأخذ الجهة القضائية المختصة جميع التدابير قصد اقتطاع العينات وإجراء الخبرة فورا من طرف الخبراء في التاريخ الذي حددته. يقوم الخبيران بالفحص المشترك لهذه العينة ، و لا يمنع غياب أحدهما من إتمام الفحص واكتسابه الصبغة الحضورية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_51_20090225_OpEnact_d1fe3c289f> ;
