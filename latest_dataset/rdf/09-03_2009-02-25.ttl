dzterm:consumer a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المستهلك"@ar,
        "للمستهلك"@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_6> ;
    dzdoc:eId "art_19" ;
    dzdoc:fullText "يجب أن لا تمس الخدمة المقدمة للمستهلك بمصلحته المادية، وأن لا تسبب له ضررا معنويا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_19_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_19_20090225_OpEnact_510ac2b8f2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_19_obligation_0_ddd1b9ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "19" ;
    dzdoc:position 18 ;
    dzdoc:usesTerm dzterm:consumer .

<https://legal.dz/resource/law/2009-02-25/09-03#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_7> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "ينشأ مجلس وطني لحماية المستهلكين، يقوم بإبداء الرأي، واقتراح التدابير التي تساهم في تطوير وترقية سياسات حماية المستهلك . تحدد تشكيلة المجلس واختصاصاته عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_24_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_24_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_24_20090225_OpEnact_8694881aef> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_24_obligation_0_c17c8b19> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 24" ;
    dzdoc:position 23 .

<https://legal.dz/resource/law/2009-02-25/09-03#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_3> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "يتعين على المخابر المذكورة في المادتين 35 و 36 أعلاه، في إطار مهامها، استعمال المناهج المحددة عن طريق التنظيم . وفي حالة عدم وجودها، تستعمل المناهج المعترف بها على المستوى الدولي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_37_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_37_20090225_OpEnact_2cd07db235> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_37_obligation_0_cfaa0db7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 37" ;
    dzdoc:position 36 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_35>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_36> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_35>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_36> ;
    dzdoc:usesTerm dzterm:laboratories .

<https://legal.dz/resource/law/2009-02-25/09-03#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_4> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "في إطار الدراسات التي تنجزها المصالح المكلفة بحماية المستهلك وقمع الغش، يمكن الأعوان المذكورين في المادة 25 أعلاه، القيام باقتطاع عينة واحدة فقط."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2009-02-25/09-03#art_42_permission_0_746432d1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_42> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_42_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_42_20090225_OpEnact_5634c6b09e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 42" ;
    dzdoc:position 41 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:usesTerm dzterm:agents .

<https://legal.dz/resource/law/2009-02-25/09-03#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_2> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "دون الإخلال بالأحكام المنصوص عليها في المادة 155 من قانون العقوبات ، يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من خمسمائة ألف دينار ( 500.000 دج) إلى مليوني دينار (2.000.000 دج) أو بإحدى هاتين العقوبتين، كل من يبيع منتوجا مشمعا أو مودعا لضبط المطابقة أو سحبه مؤقتا من عملية عرضه للاستهلاك أو يخالف إجراء التوقيف المؤقت للنشاط."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_79_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_79_20090225_OpEnact_5cb51b6af7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 79" ;
    dzdoc:position 78 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2009-02-25/09-03#art_79_extref_5b0d70a2> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_1> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "يمكن إدماج المضافات الغذائية في المواد الغذائية الموجهة للاستهلاك البشري أو الحيواني. تحدد شروط وكيفيات استعمالها وكذا الحدود القصوى المرخص بها عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2009-02-25/09-03#art_8_permission_0_a23d7554> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_8_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_8_20090225_OpEnact_5b9dc94830> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 8" ;
    dzdoc:position 7 ;
    dzdoc:usesTerm dzterm:food_additives,
        dzterm:food_products .

<https://legal.dz/resource/law/2009-02-25/09-03#art_93> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_5> ;
    dzdoc:eId "art_93" ;
    dzdoc:fullText "إذا سدد المخالف مبلغ غرامة الصلح في الآجال والشروط المحددة المادة 92 أعلاه ، تنقضي الدعوى العمومية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2009-02-25/09-03#art_93_right_0_cde1b31b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_93> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_93_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_93_20090225_OpEnact_8ca1d386b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 93" ;
    dzdoc:position 92 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_92> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_92> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_93_condition_0_4cb19e1d> ;
    dzdoc:usesTerm dzterm:offender,
        dzterm:settlement_fine .

<https://legal.dz/resource/law/2009-02-25/09-03#art_95> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_6> ;
    dzdoc:eId "art_95" ;
    dzdoc:fullText "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 29 صفر عام 1430 الموافق 25 فبراير سنة 2009. عبد العزيز بوتفليقة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_95> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_95_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_95_para_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_95_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_95_20090225_OpEnact_c482180334> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 95" ;
    dzdoc:position 94 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2009-02-25/09-03#chp_2> a dzdoc:Chapter ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#body> ;
    dzdoc:directlyContains <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_2>,
        <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_3>,
        <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_4>,
        <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_5>,
        <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_6>,
        <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_7> ;
    dzdoc:eId "chp_2" ;
    dzdoc:hasSection <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_2>,
        <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_3>,
        <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_4>,
        <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_5>,
        <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_6>,
        <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_7> ;
    dzdoc:heading "حماية المستهلك"@ar ;
    dzdoc:number "الثاني" ;
    dzdoc:position 1 .

<https://legal.dz/resource/law/2009-02-25/09-03#art_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_4> ;
    dzdoc:eId "art_14" ;
    dzdoc:fullText "كل ضمان آخر مقدم من المتدخل بمقابل أو مجانا، لا يلغي الاستفادة من الضمان القانوني المنصوص عليه في المادة 13 أعلاه. يجب أن تبين بنود وشروط تنفيذ هذه الضمانات في وثيقة مرافقة للمنتوج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_14_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_14_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_14_20090225_OpEnact_88dcaf2bf7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_14_obligation_0_7ceaf66e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "14" ;
    dzdoc:position 13 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_13> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_13> ;
    dzdoc:usesTerm dzterm:intervener,
        dzterm:legal_guarantee .

<https://legal.dz/resource/law/2009-02-25/09-03#art_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_2> ;
    dzdoc:eId "art_30" ;
    dzdoc:fullText "تتم الرقابة المنصوص عليها في هذا القانون، عن طريق فحص الوثائق و/أو بواسطة سماع المتدخلين المعنيين، أو عن طريق المعاينات المباشرة بالعين المجردة أو بأجهزة القياس، وتتمم عند الاقتضاء ، باقتطاع العينات بغرض إجراء التحاليل أو الاختبارات أو التجارب. تتم رقابة مطابقة المنتوجات المستوردة عند الحدود، قبل جمركتها. تحدد شروط و كيفيات الرقابة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_30> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_30_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_30_para_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_30_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_30_20090225_OpEnact_03b9de8a6c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "30" ;
    dzdoc:position 29 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_30_condition_0_1b1645cd> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_2> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "للأعوان المذكورين في المادة 25 أعلاه، حرية الدخول نهارا أو ليلا، بما في ذلك أيام العطل، إلى المحلات التجارية والمكاتب والملحقات ومحلات الشحن والتخزين، وبصفة عامة إلى أي مكان ، باستثناء المحلات ذات الاستعمال السكني التي يتم الدخول إليها طبقا لأحكام قانون الإجراءات الجزائية . يمارس الأعوان أيضا مهامهم أثناء نقل المنتوجات."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2009-02-25/09-03#art_34_right_0_b2954ebf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_34_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_34_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_34_20090225_OpEnact_1dacad9d91> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "34" ;
    dzdoc:position 33 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_34_condition_0_1176442d> ;
    dzdoc:usesTerm dzterm:agents .

<https://legal.dz/resource/law/2009-02-25/09-03#art_55> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:definesTerm dzterm:deposit ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_1> ;
    dzdoc:eId "art_55" ;
    dzdoc:fullText "يتمثل الإيداع في وقف منتوج معروض للاستهلاك ثبت بعد المعاينة المباشرة، أنه غير مطابق ، وذلك بقرار من الإدارة المكلفة بحماية المستهلك وقمع الغش . ويتقرر الإيداع قصد ضبط مطابقة المنتوج المشتبه فيه من طرف المتدخل المعني. يعلن عن رفع الإيداع من طرف الإدارة المكلفة بحماية المستهلك وقمع الغش بعد معاينة ضبط مطابقة المنتوج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_55> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2009-02-25/09-03#art_55_defocc_17cd53347baa> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_55_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_55_para_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_55_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_55_20090225_OpEnact_16796b0c52> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 55" ;
    dzdoc:position 54 ;
    dzdoc:usesTerm dzterm:administration .

<https://legal.dz/resource/law/2009-02-25/09-03#art_57> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_1> ;
    dzdoc:eId "art_57" ;
    dzdoc:fullText "إذا ثبت عدم إمكانية ضبط مطابقة المنتوج، أو إذا رفض المتدخل المعني إجراء عملية ضبط مطابقة المنتوج المشتبه فيه ، يتم حجزه بغرض تغيير اتجاهه، أو إعادة توجيهه، أو إتلافه دون الإخلال بالمتابعة الجزائية المنصوص عليها في أحكام هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_57> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_57_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_57_20090225_OpEnact_1ef66a08ea> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_57_obligation_0_0b36acad> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 57" ;
    dzdoc:position 56 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_57_condition_0_b2cdb713> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_2> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "ترفع العقوبات المنصوص عليها في المادة 68 أعلاه ، إلى خمس (5) سنوات حبسا وغرامة قدرها خمسمائة ألف دينار (500.000 دج)، إذا كان الخداع أو محاولة الخداع قد ارتكبت سواء بواسطة: الوزن أو الكيل أو بأدوات أخرى مزورة أو غير مطابقة، طرق ترمي إلى التغليط في عمليات التحليل أو المقدار أو الوزن أو الكيل أو التغيير عن طريق الغش في تركيب أو وزن أو حجم المنتوج، إشارات أو ادعاءات تدليسية، كتيبات أو منشورات أو نشرات أو معلقات أو إعلانات أو بطاقات أو أية تعليمات أخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_69_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_69_20090225_OpEnact_c04215f89a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_69_obligation_0_a88c531d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 69" ;
    dzdoc:position 68 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_68> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_68> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_2> ;
    dzdoc:eId "art_70" ;
    dzdoc:fullText "يعاقب بالعقوبات المنصوص عليها في المادة 431 من قانون العقوبات كل من: يزور أي منتوج موجه للاستهلاك أو للاستعمال البشري أو الحيواني، يعرض أو يضع للبيع أو يبيع منتوجا يعلم أنه مزور أو فاسد أو سام أو خطير للاستعمال البشري أو الحيواني، يعرض أو يضع للبيع أو يبيع، مع عمله بوجهتها، مواد أو أدوات أو أجهزة أو كل مادة خاصة من شأنها أن تؤدي إلى تزوير أي منتوج موجه للاستعمال البشري أو الحيواني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_70_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_70_20090225_OpEnact_051b78a50b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_70_obligation_0_0c45a014> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 70" ;
    dzdoc:position 69 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2009-02-25/09-03#art_70_extref_f1f4a077> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_2> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "يعاقب بغرامة من خمسين ألف دينار (50.000 دج) إلى مليون دينار (1.000.000 د ج)، كل من يخالف إلزامية النظافة والنظافة الصحية المنصوص عليها في المادتين 6 و 7 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_72_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_72_20090225_OpEnact_1e9d166a50> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_72_obligation_0_f9c36156> ;
