<https://legal.dz/resource/law/2009-02-25/09-03#version_art_50> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقوم الجهة القضائية المختصة بندب الخبراء المعينين، في مجال الرقابة البكتريولوجية أو البيولوجية المحضة، قصد الفحص المشترك للعينة الجديدة المنصوص عليها في المادة 49 أعلاه. يختار أحد الخبيرين من طرف القاضي المختص من بين مسؤولي المخابر المؤهلة طبقا للأحكام المنصوص عليها في هذا القانون، ويختار الآخر من طرف المخالف المفترض في الاختصاص المعني. و يعين الخبيران طبقا للأحكام المنصوص عليها في المادة 46 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_50_20090225_OpEnact_3660336589> ;
    dzdoc:replacementText "تقوم الجهة القضائية المختصة بندب الخبراء المعينين، في مجال الرقابة البكتريولوجية أو البيولوجية المحضة، قصد الفحص المشترك للعينة الجديدة المنصوص عليها في المادة 49 أعلاه. يختار أحد الخبيرين من طرف القاضي المختص من بين مسؤولي المخابر المؤهلة طبقا للأحكام المنصوص عليها في هذا القانون، ويختار الآخر من طرف المخالف المفترض في الاختصاص المعني. و يعين الخبيران طبقا للأحكام المنصوص عليها في المادة 46 من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2009-02-25/09-03#art_50> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2009-02-25/09-03> ;
