<https://legal.dz/resource/law/2009-02-25/09-03#art_87_condition_2_f1e41b6f> a dznorm:Condition ;
    dznorm:conditionText "في حالة العود"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_87> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/2009-02-25/09-03#art_87_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_87> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يمكن فرض غرامة الصلح: إذا كانت المخالفة المسجلة تعرض صاحبها، إما إلى عقوبة أخرى غير العقوبة المالية وإما تتعلق بتعويض ضرر مسبب للأشخاص أو الأملاك، في حالة تعدد المخالفات التي لا يطبق في إحداها على الأقل إجراء غرامة الصلح ، في حالة العود."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_87_permission_0_64696a89> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
