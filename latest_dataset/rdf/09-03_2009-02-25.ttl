<https://legal.dz/resource/law/2009-02-25/09-03#art_70_obligation_0_0c45a014> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/law/2009-02-25/09-03#art_70_obligation_0_0c45a014_ref_f1f4a077072a> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2009-02-25/09-03#art_70_obligation_0_0c45a014_ref_f1f4a077072a> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_70> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالعقوبات المنصوص عليها في المادة 431 من قانون العقوبات كل من:"@ar ;
    dznorm:sourceArticle "art_70" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_70_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_70> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالعقوبات المنصوص عليها في المادة 431 من قانون العقوبات كل من: يزور أي منتوج موجه للاستهلاك أو للاستعمال البشري أو الحيواني، يعرض أو يضع للبيع أو يبيع منتوجا يعلم أنه مزور أو فاسد أو سام أو خطير للاستعمال البشري أو الحيواني، يعرض أو يضع للبيع أو يبيع، مع عمله بوجهتها، مواد أو أدوات أو أجهزة أو كل مادة خاصة من شأنها أن تؤدي إلى تزوير أي منتوج موجه للاستعمال البشري أو الحيواني."@ar .

