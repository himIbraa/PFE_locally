<https://legal.dz/resource/law/2009-02-25/09-03#art_44_obligation_0_a528a719> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_44> ;
    dznorm:position 0 ;
    dznorm:provisionText "يحيل وكيل الجمهورية الملف إلى القاضي المختص"@ar ;
    dznorm:sourceArticle "art_44" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_44_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_44> ;
    dzdoc:position 0 ;
    dzdoc:text "يحيل وكيل الجمهورية الملف إلى القاضي المختص إذا ما رأى بناء على التقارير أو المحاضر التي أحيلت إليه من طرف الأعوان المذكورين في المادة 25 أعلاه، أو طبقا لكشوفات أو تقارير المخابر المؤهلة، وعند الحاجة وبعد التحقيق المسبق، أنه يجب الشروع في المتابعة أو فتح تحقيق قضائي."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_45_condition_0_20465c66> a dznorm:Condition ;
    dznorm:conditionText "في حالة احتمال الغش أو التزوير الناتج عن تحاليل أو اختبارات أو تجارب المخابر المؤهلة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_45> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2009-02-25/09-03#art_45_obligation_0_66411d6d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2009-02-25/09-03#art_45_obligation_0_66411d6d_role_3148fa9ebd> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_45> ;
    dznorm:position 0 ;
    dznorm:provisionText "يشعر القاضي المختص المخالف المفترض أنه يمكنه الاطلاع على كشف أو تقرير المخبر"@ar ;
    dznorm:sourceArticle "art_45" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_45_obligation_0_66411d6d_role_3148fa9ebd> a dznorm:Role ;
    rdfs:label "كشف أو تقرير المخبر"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يشعر القاضي المختص المخالف المفترض أنه يمكنه الاطلاع على كشف أو تقرير المخبر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_45> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_45_obligation_1_a9bf17c9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_45> ;
    dznorm:position 1 ;
    dznorm:provisionText "تمنح له مهلة ثمانية (8) أيام عمل لتقديم ملاحظاته"@ar ;
    dznorm:sourceArticle "art_45" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_45_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_45> ;
    dzdoc:position 0 ;
    dzdoc:text "في حالة احتمال الغش أو التزوير الناتج عن تحاليل أو اختبارات أو تجارب المخابر المؤهلة، يشعر القاضي المختص المخالف المفترض أنه يمكنه الاطلاع على كشف أو تقرير المخبر، وتمنح له مهلة ثمانية (8) أيام عمل لتقديم ملاحظاته وعند الاقتضاء، يطلب إجراء الخبرة. ولا يمكن المخالف المفترض أن يطالب بالخبرة بعد انقضاء هذه المهلة."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_45_permission_0_b2cc4fca> a dznorm:Permission ;
