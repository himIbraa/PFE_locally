<https://legal.dz/resource/law/2009-02-25/09-03#version_art_34> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للأعوان المذكورين في المادة 25 أعلاه، حرية الدخول نهارا أو ليلا، بما في ذلك أيام العطل، إلى المحلات التجارية والمكاتب والملحقات ومحلات الشحن والتخزين، وبصفة عامة إلى أي مكان ، باستثناء المحلات ذات الاستعمال السكني التي يتم الدخول إليها طبقا لأحكام قانون الإجراءات الجزائية . يمارس الأعوان أيضا مهامهم أثناء نقل المنتوجات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_34_20090225_OpEnact_1dacad9d91> ;
    dzdoc:replacementText "للأعوان المذكورين في المادة 25 أعلاه، حرية الدخول نهارا أو ليلا، بما في ذلك أيام العطل، إلى المحلات التجارية والمكاتب والملحقات ومحلات الشحن والتخزين، وبصفة عامة إلى أي مكان ، باستثناء المحلات ذات الاستعمال السكني التي يتم الدخول إليها طبقا لأحكام قانون الإجراءات الجزائية . يمارس الأعوان أيضا مهامهم أثناء نقل المنتوجات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
