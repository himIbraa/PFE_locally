<https://legal.dz/resource/law/2009-02-25/09-03#version_art_16> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في إطار خدمة ما بعد البيع ، و بعد انقضاء فترة الضمان المحددة عن طريق التنظيم، أو في كل الحالات التي لا يمكن للضمان أن يلعب دوره ، يتعين على المتدخل المعني ضمان صيانة وتصليح المنتوج المعروض في السوق ."@ar ;
