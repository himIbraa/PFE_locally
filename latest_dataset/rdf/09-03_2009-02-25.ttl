<https://legal.dz/resource/law/2009-02-25/09-03#version_art_90> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبلغ المصالح المكلفة بحماية المستهلك وقمع الغش المخالف، في أجل لا يتعدى سبعة (7) أيام ابتداء من تاريخ تحرير المحضر إنذارا برسالة موصى عليها مع إشعار بالاستلام ، يبين فيه محل إقامته، ومكان وتاريخ، وسبب المخالفة، ومراجع النصوص المطبقة، ومبلغ الغرامة المفروضة عليه وكذا أجال وكيفيات التسديد المحددة في المادة 92 أدناه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_90_20090225_OpEnact_4e99f183b8> ;
    dzdoc:replacementText "تبلغ المصالح المكلفة بحماية المستهلك وقمع الغش المخالف، في أجل لا يتعدى سبعة (7) أيام ابتداء من تاريخ تحرير المحضر إنذارا برسالة موصى عليها مع إشعار بالاستلام ، يبين فيه محل إقامته، ومكان وتاريخ، وسبب المخالفة، ومراجع النصوص المطبقة، ومبلغ الغرامة المفروضة عليه وكذا أجال وكيفيات التسديد المحددة في المادة 92 أدناه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
