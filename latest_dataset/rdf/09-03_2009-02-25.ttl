<https://legal.dz/resource/law/2009-02-25/09-03#version_art_69> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ترفع العقوبات المنصوص عليها في المادة 68 أعلاه ، إلى خمس (5) سنوات حبسا وغرامة قدرها خمسمائة ألف دينار (500.000 دج)، إذا كان الخداع أو محاولة الخداع قد ارتكبت سواء بواسطة: الوزن أو الكيل أو بأدوات أخرى مزورة أو غير مطابقة، طرق ترمي إلى التغليط في عمليات التحليل أو المقدار أو الوزن أو الكيل أو التغيير عن طريق الغش في تركيب أو وزن أو حجم المنتوج، إشارات أو ادعاءات تدليسية، كتيبات أو منشورات أو نشرات أو معلقات أو إعلانات أو بطاقات أو أية تعليمات أخرى."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_69_20090225_OpEnact_c04215f89a> ;
    dzdoc:replacementText "ترفع العقوبات المنصوص عليها في المادة 68 أعلاه ، إلى خمس (5) سنوات حبسا وغرامة قدرها خمسمائة ألف دينار (500.000 دج)، إذا كان الخداع أو محاولة الخداع قد ارتكبت سواء بواسطة: الوزن أو الكيل أو بأدوات أخرى مزورة أو غير مطابقة، طرق ترمي إلى التغليط في عمليات التحليل أو المقدار أو الوزن أو الكيل أو التغيير عن طريق الغش في تركيب أو وزن أو حجم المنتوج، إشارات أو ادعاءات تدليسية، كتيبات أو منشورات أو نشرات أو معلقات أو إعلانات أو بطاقات أو أية تعليمات أخرى."@ar ;
    dzdoc:resolutionStatus "resolved" ;
