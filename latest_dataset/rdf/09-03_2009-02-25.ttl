<https://legal.dz/resource/law/2009-02-25/09-03#art_94_extref_c97aa465> a dzdoc:ExternalReference ;
    rdfs:label "القانون رقم 89 - 02 المؤرخ في أول رجب عام 1409 الموافق 7 فبراير سنة 1989 والمتعلق بالقواعد العامة لحماية المستهلك"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1989-02-07/89-02"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1989-02-07/89-02"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1989-02-07/89-02" ;
