    dzdoc:targetEId "art_25" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_35_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_35> ;
    dzdoc:position 0 ;
    dzdoc:text "تؤهل المخابر التابعة للوزارة المكلفة بـ حماية المستهلك وقمع الغش في إطار تطبيق أحكام هذا القانون للقيام بالتحاليل والاختبارات والتجارب قصد حماية المستهلك وقمع الغش."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_35_right_0_ac578e96> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_35> ;
    dznorm:position 0 ;
    dznorm:provisionText "حماية المستهلك وقمع الغش"@ar ;
    dznorm:sourceArticle "art_35" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_36_condition_0_2807c912> a dznorm:Condition ;
    dznorm:conditionText "شروط وكيفيات اعتماد المخابر عن طريق التنظيم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_36> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2009-02-25/09-03#art_36_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_36> ;
    dzdoc:position 0 ;
    dzdoc:text "إضافة إلى المخابر المذكورة في المادة 35 أعلاه، وطبقا للتشريع والتنظيم الساريي المفعول، يمكن أن تعتمد مخابر أخرى لإجراء التحاليل والاختبارات والتجارب المنصوص عليها في المادة 35 أعلاه."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_36_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_36> ;
    dzdoc:position 1 ;
    dzdoc:text "تحدد شروط وكيفيات اعتماد المخابر عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_36_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_36> ;
    dzdoc:position 2 ;
    dzdoc:text "لا تخضع لأحكام الفقرة أعلاه المخابر التي تتدخل في إطار النصوص المؤسسة لها أو في الميادين المسيرة بتنظيم خاص."@ar .

