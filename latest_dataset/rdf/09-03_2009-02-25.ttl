    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_46> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2009-02-25/09-03#art_46_extref_516ad9e7> a dzdoc:ExternalReference ;
    rdfs:label "المادة 144"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/criminal_procedure#art_144"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/code/criminal_procedure#art_144"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/criminal_procedure#art_144" ;
    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" ;
    dzdoc:targetEId "art_144" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_46_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_46> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما تطلب الخبرة من طرف المخالف المفترض أو عندما تأمر بها الجهة القضائية المختصة، يختار خبيران (2)، أحدهما من طرف الجهة القضائية المختصة والآخر من طرف المخالف المفترض."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_46_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_46> ;
    dzdoc:position 1 ;
    dzdoc:text "يتم تعيين الخبيرين (2) من طرف الجهة القضائية المختصة، طبقا للأحكام المنصوص عليها في قانون الإجراءات الجزائية."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_46_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_46> ;
    dzdoc:position 2 ;
    dzdoc:text "وبصفة استثنائية، وبعد موافقة الجهة القضائية المختصة، يمكن المخالف المفترض أن يختار خبيرا غير مقيد في القائمة المحررة طبقا لأحكام المادة 144 من قانون الإجراءات الجزائية."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_46_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_46> ;
    dzdoc:position 3 ;
    dzdoc:text "للخبيرين (2) المعينين نفس الالتزامات ونفس الحقوق ونفس المسؤوليات ويتقاضيان نفس الأتعاب طبقا للشروط المنصوص عليها في التشريع والتنظيم المعمول بهما."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_46_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_46> ;
    dzdoc:position 4 ;
    dzdoc:text "يمكن أن يعين مسؤول المخبر الذي قام بالتحليل الأول أو اختبار أو تجربة كخبير طبقا للشروط المحددة بموجب هذا القانون."@ar .

