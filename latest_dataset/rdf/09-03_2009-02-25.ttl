    dzdoc:position 0 ;
    dzdoc:text "يقوم الأعوان المذكورون في المادة 25 أعلاه، بأي وسيلة وفي أي وقت وفي جميع مراحل عملية العرض للاستهلاك، برقابة مطابقة المنتوجات بالنسبة للمتطلبات المميزة الخاصة بها."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_2_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_2> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق أحكام هذا القانون على كل سلعة أو خدمة معروضة للاستهلاك بمقابل أو مجانا وعلى كل متدخل وفي جميع مراحل عملية العرض للاستهلاك."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_30_condition_0_1b1645cd> a dznorm:Condition ;
    dznorm:conditionText "عند الاقتضاء"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_30> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2009-02-25/09-03#art_30_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_30> ;
    dzdoc:position 0 ;
    dzdoc:text "تتم الرقابة المنصوص عليها في هذا القانون، عن طريق فحص الوثائق و/أو بواسطة سماع المتدخلين المعنيين، أو عن طريق المعاينات المباشرة بالعين المجردة أو بأجهزة القياس، وتتمم عند الاقتضاء، باقتطاع العينات بغرض إجراء التحاليل أو الاختبارات أو التجارب."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_30_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_30> ;
    dzdoc:position 1 ;
    dzdoc:text "تتم رقابة مطابقة المنتوجات المستوردة عند الحدود، قبل جمركتها."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_30_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_30> ;
    dzdoc:position 2 ;
    dzdoc:text "تحدد شروط و كيفيات الرقابة عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_31_obligation_0_9f197f9a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
