<https://legal.dz/resource/law/2009-02-25/09-03#version_art_4> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على كل متدخل في عملية وضع المواد الغذائية للاستهلاك احترام إلزامية سلامة هذه المواد، والسهر على أن لا تضر بصحة المستهلك . تحدد الشروط والكيفيات المطبقة في مجال الخصائص المكروبيولوجية للمواد الغذائية عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_4_20090225_OpEnact_5241e080e7> ;
