    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:temporary_withdrawal ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2009-02-25/09-03#art_59> ;
