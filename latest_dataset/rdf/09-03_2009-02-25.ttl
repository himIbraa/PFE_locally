<https://legal.dz/resource/law/2009-02-25/09-03#art_34_condition_0_1176442d> a dznorm:Condition ;
    dznorm:conditionText "باستثناء المحلات ذات الاستعمال السكني التي يتم الدخول إليها طبقا لأحكام قانون الإجراءات الجزائية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_34> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2009-02-25/09-03#art_34_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_34> ;
    dzdoc:position 0 ;
    dzdoc:text "للأعوان المذكورين في المادة 25 أعلاه، حرية الدخول نهارا أو ليلا، بما في ذلك أيام العطل، إلى المحلات التجارية والمكاتب والملحقات ومحلات الشحن والتخزين، وبصفة عامة إلى أي مكان، باستثناء المحلات ذات الاستعمال السكني التي يتم الدخول إليها طبقا لأحكام قانون الإجراءات الجزائية."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_34_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_34> ;
    dzdoc:position 1 ;
    dzdoc:text "يمارس الأعوان أيضا مهامهم أثناء نقل المنتوجات."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_34_right_0_b2954ebf> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
