<https://legal.dz/resource/law/2009-02-25/09-03#version_art_58> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان المنتوج صالحا للاستهلاك وثبتت عدم مطابقته ، إما أن يغير المتدخل المعني اتجاهه بإرساله إلى هيئة ذات منفعة عامة لاستعماله في غرض مباشر وشرعي، وإما يعيد توجيهه بإرساله إلى هيئة لاستعماله في غرض شرعي بعد تحويله."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_58_20090225_OpEnact_2ae7b27a76> ;
