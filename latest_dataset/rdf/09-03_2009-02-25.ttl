<https://legal.dz/resource/law/2009-02-25/09-03#version_art_70> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالعقوبات المنصوص عليها في المادة 431 من قانون العقوبات كل من: يزور أي منتوج موجه للاستهلاك أو للاستعمال البشري أو الحيواني، يعرض أو يضع للبيع أو يبيع منتوجا يعلم أنه مزور أو فاسد أو سام أو خطير للاستعمال البشري أو الحيواني، يعرض أو يضع للبيع أو يبيع، مع عمله بوجهتها، مواد أو أدوات أو أجهزة أو كل مادة خاصة من شأنها أن تؤدي إلى تزوير أي منتوج موجه للاستعمال البشري أو الحيواني."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_70_20090225_OpEnact_051b78a50b> ;
    dzdoc:replacementText "يعاقب بالعقوبات المنصوص عليها في المادة 431 من قانون العقوبات كل من: يزور أي منتوج موجه للاستهلاك أو للاستعمال البشري أو الحيواني، يعرض أو يضع للبيع أو يبيع منتوجا يعلم أنه مزور أو فاسد أو سام أو خطير للاستعمال البشري أو الحيواني، يعرض أو يضع للبيع أو يبيع، مع عمله بوجهتها، مواد أو أدوات أو أجهزة أو كل مادة خاصة من شأنها أن تؤدي إلى تزوير أي منتوج موجه للاستعمال البشري أو الحيواني."@ar ;
    dzdoc:resolutionStatus "resolved" ;
