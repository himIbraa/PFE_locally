<https://legal.dz/resource/law/2009-02-25/09-03#version_art_64> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا قررت الإدارة المكلفة بحماية المستهلك وقمع الغش أو الجهة القضائية المختصة إتلاف المنتوجات ، يتم ذلك من طرف المتدخل بحضور الأعوان المذكورين في المادة 25 أعلاه. يمكن أن يتمثل الإتلاف أيضا في تشويه طبيعة المنتوج. يحرر محضر الإتلاف من طرف الأعوان ويوقعون عليه مع المتدخل المعني. تحدد شروط وكيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_64_20090225_OpEnact_738175c1dc> ;
    dzdoc:replacementText "إذا قررت الإدارة المكلفة بحماية المستهلك وقمع الغش أو الجهة القضائية المختصة إتلاف المنتوجات ، يتم ذلك من طرف المتدخل بحضور الأعوان المذكورين في المادة 25 أعلاه. يمكن أن يتمثل الإتلاف أيضا في تشويه طبيعة المنتوج. يحرر محضر الإتلاف من طرف الأعوان ويوقعون عليه مع المتدخل المعني. تحدد شروط وكيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar ;
