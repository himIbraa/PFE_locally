    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_26> ;
    dznorm:position 0 ;
    dznorm:provisionText """يجب على أعوان قمع الغش المذكورين في المادة 25 أعلاه، أن يفوضوا بالعمل طبقا للأحكام التشريعية والتنظيمية السارية المفعول، وأن يؤدوا أمام محكمة إقامتهم الإدارية اليمين الآتية:
            "أقسم بالله العلي العظيم أن أقوم بأعمال وظيفتي بأمانة وصدق وأحافظ على السر المهني وأراعي في كل الأحوال الواجبات المفروضة علي ..\""""@ar ;
    dznorm:sourceArticle "art_26" .

