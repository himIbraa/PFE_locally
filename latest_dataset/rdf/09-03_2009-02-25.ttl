<https://legal.dz/resource/law/2009-02-25/09-03#version_art_39> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجرى اقتطاع العينات قصد إجراء التحاليل أو الاختبارات أو التجارب المنصوص عليها في المادة 35 أعلاه، طبقا لأحكام هذا القانون. يحرر محضر فور اقتطاع العينات من طرف الأعوان المذكورين في المادة 25 أعلاه. تحدد شروط وكيفيات اقتطاع العينات عن طريق التنظيم."@ar ;
