dzterm:agents a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الأعوان"@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_4> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "يستفيد كل مقتن لأي منتوج مذكور في المادة 13 من هذا القانون من حق تجربة المنتوج المقتنى ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2009-02-25/09-03#art_15_right_0_510eb9ea> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_15_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_15_20090225_OpEnact_7e287980ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "15" ;
    dzdoc:position 14 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_13> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_13> ;
    dzdoc:usesTerm dzterm:product .

<https://legal.dz/resource/law/2009-02-25/09-03#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_2> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "يقوم الأعوان المذكورون في المادة 25 أعلاه، في إطار مهامهم الرقابية، وطبقا لأحكام هذا القانون، بتحرير محاضر تدون فيها تواريخ و أماكن الرقابة المنجزة وتبين فيها الوقائع المعاينة والمخالفات المسجلة والعقوبات المتعلقة بها . وبالإضافة إلى ذلك، تتضمن هذه المحاضر هوية وصفة الأعوان الذين قاموا بالرقابة وكذا هوية ونسب ونشاط وعنوان المتدخل المعني بالرقابة. يمكن أن ترفق المحاضر المحررة من قبل الأعوان المذكورين في المادة 25 أعلاه ، بكل وثيقة أو مستند إثبات. وتكون للمحاضر المنصوص عليها في الفقرات السابقة حجية قانونية حتى يثبت العكس."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2009-02-25/09-03#art_31_permission_0_724ee114> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_31_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_31_para_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_31_para_2>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_31_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_31_20090225_OpEnact_037a4ff3d6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_31_obligation_0_9f197f9a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "31" ;
    dzdoc:position 30 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:usesTerm dzterm:agents .

<https://legal.dz/resource/law/2009-02-25/09-03#art_32> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_2> ;
    dzdoc:eId "art_32" ;
    dzdoc:fullText "تحرر وتوقع المحاضر من طرف الأعوان الذين عاينوا المخالفة. يتم تحرير المحضر بحضور المتدخل الذي يوقعه. وعندما يحرر المحضر في غياب المتدخل أو في حالة الرفض ، يقيد فيه ذلك. تسجل المحاضر المحررة من طرف الأعوان المذكورين في المادة 25 أعلاه، في سجل مخصص لهذا الغرض مرقم ومؤشر عليه من طرف رئيس المحكمة المختصة إقليميا . يحدد شكل ومحتوى المحاضر عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_32> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_32_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_32_para_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_32_para_2>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_32_para_3>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_32_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_32_20090225_OpEnact_8e3bf7ba3b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_32_obligation_0_a926a2ec> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "32" ;
    dzdoc:position 31 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_32_condition_0_77a3c19b> ;
    dzdoc:usesTerm dzterm:agents .

<https://legal.dz/resource/law/2009-02-25/09-03#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_5> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "تمنح الجهة القضائية المختصة مهلة للمخالف المفترض قصد اختيار الخبير ، وله الحق في التنازل صراحة عن هذا الاختيار والاعتماد على استنتاجات الخبير الذي عينته الجهة القضائية . إذا لم يتنازل المعني عن هذا الحق ولم يختر خبيرا في الأجل الممنوح له ، تعين الجهة القضائية المختصة تلقائيا خبيرا ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2009-02-25/09-03#art_47_right_0_df8dde7a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_47_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_47_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_47_20090225_OpEnact_6d8a6bb658> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_47_obligation_0_03a4d568>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_47_obligation_1_a7d1d216> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 47" ;
    dzdoc:position 46 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_47_condition_0_ba57ab58> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_5> ;
    dzdoc:eId "art_52" ;
    dzdoc:fullText "تجرى التحاليل أو الاختبارات أو التجارب في إطار الإجراء الحضوري في المخابر المؤهلة طبقا للأحكام المنصوص عليها بموجب هذا القانون. يجب على الخبراء استخدام منهج أو مناهج التحاليل المستعملة من طرف المخابر المؤهلة والقيام بنفس التحاليل أو الاختبارات أو التجارب. كما يمكنهم استخدام مناهج أخرى على سبيل الإضافة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2009-02-25/09-03#art_52_right_0_34ebd1f3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_52_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_52_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_52_20090225_OpEnact_7892bb940d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_52_obligation_0_b3977485> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "52" ;
    dzdoc:position 51 ;
    dzdoc:usesTerm dzterm:experts .

<https://legal.dz/resource/law/2009-02-25/09-03#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_1> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "يتخذ الأعوان المذكورون في المادة 25 من هذا القانون، كافة التدابير التحفظية قصد حماية المستهلك وصحته وسلامته ومصالحه . وبهذه الصفة، يمكن الأعوان القيام برفض الدخول المؤقت أو النهائي للمنتوجات المستوردة عند الحدود والإيداع والحجز والسحب المؤقت أو النهائي للمنتوجات أو إتلافها والتوقيف المؤقت للنشاطات طبقا للأحكام المنصوص عليها في هذا القانون. تحدد شروط وكيفيات تطبيق أحكام هذه المادة عن طريق التنظيم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2009-02-25/09-03#art_53_permission_0_6e13797a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_53_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_53_para_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_53_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_53_20090225_OpEnact_e1d3fa9b58> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_53_obligation_0_f70b813c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 53" ;
    dzdoc:position 52 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_53_condition_0_c9ff0ef1> ;
    dzdoc:usesTerm dzterm:agents,
        dzterm:consumer .

<https://legal.dz/resource/law/2009-02-25/09-03#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_1> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "إذا ثبت عدم مطابقة المنتوج ، تسدد المصاريف الناتجة عن عمليات الرقابة أو التحاليل أو الاختبارات أو التجارب من طرف المتدخل المقصر . وإذا لم تثبت عدم المطابقة عن طريق التحاليل أو الاختبارات أو التجارب ، تعوض قيمة العينة للمتدخل المعني على أساس القيمة المسجلة في محضر الاقتطاع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2009-02-25/09-03#art_60_right_0_9ca3444a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_60_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_60_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_60_20090225_OpEnact_133c0cd4c3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_60_obligation_0_1a938089> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 60" ;
    dzdoc:position 59 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_60_condition_0_6152cdb0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_60_condition_1_1b95867d> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_1> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "إذا قررت الإدارة المكلفة بحماية المستهلك وقمع الغش أو الجهة القضائية المختصة إتلاف المنتوجات ، يتم ذلك من طرف المتدخل بحضور الأعوان المذكورين في المادة 25 أعلاه. يمكن أن يتمثل الإتلاف أيضا في تشويه طبيعة المنتوج. يحرر محضر الإتلاف من طرف الأعوان ويوقعون عليه مع المتدخل المعني. تحدد شروط وكيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2009-02-25/09-03#art_64_permission_0_cef93148> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_64_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_64_para_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_64_para_2>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_64_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_64_20090225_OpEnact_738175c1dc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "64" ;
    dzdoc:position 63 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_64_condition_0_c9cd0732> ;
    dzdoc:usesTerm dzterm:agents,
        dzterm:intervener .

<https://legal.dz/resource/law/2009-02-25/09-03#art_83> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_2> ;
    dzdoc:eId "art_83" ;
    dzdoc:fullText "يعاقب بالعقوبات المنصوص عليها في الفقرة الأولى من المادة 432 من قانون العقوبات ، كل من يغش أو يعرض أو يضع للبيع أو يبيع كل منتوج مزور أو فاسد أو سام أو لا يستجيب لـ إلزامية الأمن المنصوص عليها في المادة 10 من هذا القانون، إذا ألحق هذا المنتوج بالمستهلك مرضا أو عجزا عن العمل . ويعاقب المتدخلون المعنيون بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من مليون دينار (1.000.000 دج) إلى مليوني دينار ( 2.000.000 دج)، إذا تسبب هذا المنتوج في مرض غير قابل للشفاء أو في فقدان استعمال عضو أو في الإصابة بعاهة مستديمة . يتعرض هؤلاء المتدخلون لعقوبة السجن المؤبد إذا تسبب هذا المرض في وفاة شخص أو عدة أشخاص ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_83> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_83_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_83_para_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_83_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_83_20090225_OpEnact_8a769ebb93> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_83_obligation_0_11c6e15d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 83" ;
    dzdoc:position 82 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_10> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2009-02-25/09-03#art_83_extref_5976fae0> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_10> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_83_condition_0_4bdba4bb>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_83_condition_1_b7ead650>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_83_condition_2_5bb4d50a> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_5> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "يمكن الأعوان المنصوص عليهم في المادة 25 من هذا القانون، فرض غرامة صلح على مرتكب المخالفة المعاقب عليها طبقا لأحكام هذا القانون. وإذا لم تسدد غرامة الصلح في الأجل المحدد في المادة 92 أدناه ، يرسل المحضر إلى الجهة القضائية المختصة. وفي هذه الحالة، ترفع الغرامة إلى الحد الأقصى."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2009-02-25/09-03#art_86_permission_0_a06d22b5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_86_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_86_para_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_86_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_86_20090225_OpEnact_e2973c2b6e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 86" ;
    dzdoc:position 85 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_25>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_92> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_25>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_92> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_86_condition_0_9e17d191> ;
    dzdoc:usesTerm dzterm:agents,
        dzterm:fine .

<https://legal.dz/resource/law/2009-02-25/09-03#art_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_6> ;
    dzdoc:eId "art_20" ;
    dzdoc:fullText "دون الإخلال بالأحكام التشريعية السارية المفعول ، يجب أن تستجيب عروض القرض للاستهلاك للرغبات المشروعة للمستهلك فيما يخص شفافية العرض المسبق وطبيعة ومضمون ومدة الالتزام وكذا أجال تسديده، ويحرر عقد بذلك . تحدد شروط وكيفيات العروض في مجال قروض الاستهلاك عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_20> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_20_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_20_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_20_20090225_OpEnact_9d26b2e93e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_20_obligation_0_2eb07d60> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "20" ;
    dzdoc:position 19 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_20_condition_0_b2da4328> ;
    dzdoc:usesTerm dzterm:consumer,
        dzterm:consumer_loan .

<https://legal.dz/resource/law/2009-02-25/09-03#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_2> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "يمكن الأعوان المذكورين في المادة 25 أعلاه، في إطار أداء مهامهم و دون أن يحتج اتجاههم بالسر المهني، فحص كل وثيقة تقنية أو إدارية أو تجارية أو مالية أو محاسبية وكذا كل وسيلة مغناطيسية أو معلوماتية . ويمكنهم طلب الاطلاع على هذه الوثائق في أي يد وجدت والقيام بحجزها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2009-02-25/09-03#art_33_permission_0_08f3f5da> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2009-02-25/09-03#art_33_right_0_03a196ae>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_33_right_1_60285d10> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_33_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_33_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_33_20090225_OpEnact_2349a6ae19> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "33" ;
    dzdoc:position 32 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:usesTerm dzterm:agents .

<https://legal.dz/resource/law/2009-02-25/09-03#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_5> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "تسلم الجهة القضائية المختصة الخبراء العينتين الثانية والثالثة المقتطعتين طبقا لأحكام المادة 40 من هذا القانون . يعذر المخالف المفترض مسبقا من طرف الجهة القضائية المختصة ليقدم في أجل ثمانية (8) أيام، العينة الثالثة التي بحوزته كما هو منصوص عليه في المادة 40 من هذا القانون. إذا لم يقدم المخالف المفترض العينة الثالثة سليمة خلال هذا الأجل ، لا تؤخذ هذه العينة بعين الاعتبار، ويقوم الخبراء بالاستنتاج على أساس فحص العينة الثانية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_48_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_48_para_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_48_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_48_20090225_OpEnact_6ae577776c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_48_obligation_0_ba70fb0d>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_48_obligation_1_23aae91c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 48" ;
    dzdoc:position 47 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_40> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_40> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_48_condition_0_8c779a82> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_5> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "في حالة ما إذا اقتطعت عينة واحدة طبقا لأحكام المادة 41 من هذا القانون ، تقوم الجهة القضائية المختصة، فورا بندب الخبراء المعينين قصد القيام باقتطاع جديد حسب الأشكال المنصوص عليها في المادة 39 من هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_49_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_49_20090225_OpEnact_a4c3bdca86> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_49_obligation_0_479c65e2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 49" ;
    dzdoc:position 48 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_39>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_41> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_39>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_41> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_49_condition_0_6aca4756> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_5> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "تأخذ الجهة القضائية المختصة جميع التدابير قصد اقتطاع العينات وإجراء الخبرة فورا من طرف الخبراء في التاريخ الذي حددته. يقوم الخبيران بالفحص المشترك لهذه العينة ، و لا يمنع غياب أحدهما من إتمام الفحص واكتسابه الصبغة الحضورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_51_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_51_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_51_20090225_OpEnact_d1fe3c289f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_51_obligation_0_6f478026>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_51_obligation_1_d6d524d3> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2009-02-25/09-03#art_51_prohibition_0_33910955> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "51" ;
    dzdoc:position 50 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_51_condition_0_390704cb> ;
    dzdoc:usesTerm dzterm:experts,
        dzterm:judicial_authority .

<https://legal.dz/resource/law/2009-02-25/09-03#art_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_5> ;
    dzdoc:eId "art_87" ;
    dzdoc:fullText "لا يمكن فرض غرامة الصلح: إذا كانت المخالفة المسجلة تعرض صاحبها، إما إلى عقوبة أخرى غير العقوبة المالية وإما تتعلق بتعويض ضرر مسبب للأشخاص أو الأملاك ، في حالة تعدد المخالفات التي لا يطبق في إحداها على الأقل إجراء غرامة الصلح ، في حالة العود ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2009-02-25/09-03#art_87_permission_0_64696a89> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_87> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_87_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_87_20090225_OpEnact_f74fd764fa> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 87" ;
    dzdoc:position 86 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_87_condition_0_5858150b>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_87_condition_1_a583353e>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_87_condition_2_f1e41b6f> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_90> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_5> ;
    dzdoc:eId "art_90" ;
    dzdoc:fullText "تبلغ المصالح المكلفة بحماية المستهلك وقمع الغش المخالف، في أجل لا يتعدى سبعة (7) أيام ابتداء من تاريخ تحرير المحضر إنذارا برسالة موصى عليها مع إشعار بالاستلام ، يبين فيه محل إقامته، ومكان وتاريخ، وسبب المخالفة، ومراجع النصوص المطبقة، ومبلغ الغرامة المفروضة عليه وكذا أجال وكيفيات التسديد المحددة في المادة 92 أدناه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_90> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_90_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_90_20090225_OpEnact_4e99f183b8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_90_obligation_0_7a18dab9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 90" ;
    dzdoc:position 89 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_92> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_92> .

dzterm:intervener a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المتدخل"@ar,
        "متدخل"@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_5> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "يجب أن تحرر بيانات الوسم وطريقة الاستخدام ودليل الاستعمال وشروط ضمان المنتوج وكل معلومة أخرى منصوص عليها في التنظيم الساري المفعول باللغة العربية أساسا ، وعلى سبيل الإضافة، يمكن استعمال لغة أو عدة لغات أخرى سهلة الفهم من المستهلكين، وبطريقة مرئية ومقروءة ومتعذر محوها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2009-02-25/09-03#art_18_permission_0_91992f2a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_18_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_18_20090225_OpEnact_21026ee85f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_18_obligation_0_6cd58137> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "18" ;
    dzdoc:position 17 .

<https://legal.dz/resource/law/2009-02-25/09-03#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_4> ;
    dzdoc:eId "art_39" ;
    dzdoc:fullText "يجرى اقتطاع العينات قصد إجراء التحاليل أو الاختبارات أو التجارب المنصوص عليها في المادة 35 أعلاه، طبقا لأحكام هذا القانون. يحرر محضر فور اقتطاع العينات من طرف الأعوان المذكورين في المادة 25 أعلاه. تحدد شروط وكيفيات اقتطاع العينات عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_39> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_39_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_39_para_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_39_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_39_20090225_OpEnact_ae67d23b20> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_39_obligation_0_d621e6e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 39" ;
    dzdoc:position 38 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_25>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_35> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_25>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_35> ;
    dzdoc:usesTerm dzterm:agents .

<https://legal.dz/resource/law/2009-02-25/09-03#art_41> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_4> ;
    dzdoc:eId "art_41" ;
    dzdoc:fullText "إذا كان المنتوج سريع التلف أو بالنظر إلى طبيعته أو وزنه أو كميته أو حجمه أو قيمته ، تقتطع عينة واحدة وتشمع ثم ترسل فورا إلى المخبر المؤهل لإجراء التحاليل أو الاختبارات أو التجارب بموجب هذا القانون. تحدد كيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_41> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_41_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_41_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_41_20090225_OpEnact_a3a53600f4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_41_obligation_0_4ed515a7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 41" ;
    dzdoc:position 40 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_41_condition_0_4d7e693d> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_5> ;
    dzdoc:eId "art_45" ;
    dzdoc:fullText "في حالة احتمال الغش أو التزوير الناتج عن تحاليل أو اختبارات أو تجارب المخابر المؤهلة ، يشعر القاضي المختص المخالف المفترض أنه يمكنه الاطلاع على كشف أو تقرير المخبر ، و تمنح له مهلة ثمانية (8) أيام عمل لتقديم ملاحظاته وعند الاقتضاء، يطلب إجراء الخبرة . ولا يمكن المخالف المفترض أن يطالب بالخبرة بعد انقضاء هذه المهلة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2009-02-25/09-03#art_45_permission_0_b2cc4fca> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2009-02-25/09-03#art_45_right_0_15773df0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_45> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_45_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_45_20090225_OpEnact_93bca0dfc2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_45_obligation_0_66411d6d>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_45_obligation_1_a9bf17c9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 45" ;
    dzdoc:position 44 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_45_condition_0_20465c66> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:definesTerm dzterm:temporary_withdrawal ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_1> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "يتمثل السحب المؤقت في منع وضع كل منتوج للاستهلاك أينما وجد عند الاشتباه في عدم مطابقته وذلك في انتظار نتائج التحريات المعمقة لا سيما نتائج التحاليل أو الاختبارات أو التجارب. إذا لم تجر هذه التحريات في أجل سبعة (7) أيام عمل أو إذا لم يثبت عدم مطابقة المنتوج ، يرفع فورا تدبير السحب المؤقت . ويمكن تمديد هذا الأجل عندما تتطلب الشروط التقنية للرقابة والتحاليل أو الاختبارات أو التجارب ذلك. إذا ثبت عدم مطابقة منتوج ، يعلن عن حجزه، ويعلم فورا وكيل الجمهورية بذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_59> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2009-02-25/09-03#art_59_defocc_9d5ad7fb559d> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_59_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_59_para_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_59_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_59_20090225_OpEnact_77e9d5c096> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_59_obligation_0_408f919d>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_59_obligation_1_4f671393> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 59" ;
    dzdoc:position 58 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_59_condition_0_d7462ed3>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_59_condition_1_68da728c> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_2> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "يعاقب بالعقوبات المنصوص عليها في المادة 429 من قانون العقوبات ، كل من يخدع أو يحاول أن يخدع المستهلك بأية وسيلة أو طريقة كانت حول: كمية المنتوجات المسلمة، تسليم المنتوجات غير تلك المعينة مسبقا، قابلية استعمال المنتوج، تاريخ أو مدد صلاحية المنتوج، النتائج المنتظرة من المنتوج، طرق الاستعمال أو الاحتياطات اللازمة لاستعمال المنتوج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_68_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_68_20090225_OpEnact_3e44d9e57f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_68_obligation_0_aa25f8d1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 68" ;
    dzdoc:position 67 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2009-02-25/09-03#art_68_extref_6b367f7e> ;
    dzdoc:usesTerm dzterm:consumer .

<https://legal.dz/resource/law/2009-02-25/09-03#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_4> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "في إطار خدمة ما بعد البيع ، و بعد انقضاء فترة الضمان المحددة عن طريق التنظيم، أو في كل الحالات التي لا يمكن للضمان أن يلعب دوره ، يتعين على المتدخل المعني ضمان صيانة وتصليح المنتوج المعروض في السوق ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2009-02-25/09-03#art_16_permission_0_ecc0fe4c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_16_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_16_20090225_OpEnact_757cb1df66> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_16_obligation_0_ad619990> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "16" ;
    dzdoc:position 15 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2009-02-25/09-03#art_16_condition_0_60896481> ;
    dzdoc:usesTerm dzterm:after_sales_service,
        dzterm:intervener .

<https://legal.dz/resource/law/2009-02-25/09-03#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_1> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "ينفذ السحب النهائي من طرف الأعوان المذكورين في المادة 25 أعلاه، دون رخصة مسبقة من السلطة القضائية المختصة في الحالات الآتية: المنتوجات التي ثبت أنها مزورة أو مغشوشة أو سامة أو التي انتهت مدة صلاحيتها، المنتوجات التي ثبت عدم صلاحيتها للاستهلاك، حيازة المنتوجات دون سبب شرعي والتي يمكن استعمالها في التزوير، المنتوجات المقلدة، الأشياء أو الأجهزة التي تستعمل للقيام بالتزوير. يعلم وكيل الجمهورية بذلك فورا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2009-02-25/09-03#art_62_permission_0_d7578699> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_62_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_62_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_62_20090225_OpEnact_f4baa154a0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_62_obligation_0_7654cdee> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "62" ;
    dzdoc:position 61 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:usesTerm dzterm:agents,
        dzterm:final_withdrawal .

<https://legal.dz/resource/law/2009-02-25/09-03#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_1> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "يجب أن لا تحتوي التجهيزات واللوازم والعتاد والتغليف، وغيرها من الآلات المخصصة لملامسة المواد الغذائية ، إلا على اللوازم التي لا تؤدي إلى إفسادها . تحدد شروط وكيفيات استعمال المنتوجات واللوازم الموجهة لملامسة المواد الغذائية ، وكذا مستحضرات تنظيف هذه اللوازم عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_7_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_7_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_7_20090225_OpEnact_e3a6af32fd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_7_obligation_0_76263369> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 7" ;
    dzdoc:position 6 ;
    dzdoc:usesTerm dzterm:food_products .

<https://legal.dz/resource/law/2009-02-25/09-03#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_2> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "يتعين على كل متدخل احترام إلزامية أمن المنتوج الذي يضعه للاستهلاك فيما يخص: مميزاته وتركيبته وتغليفه وشروط تجميعه وصيانته، تأثير المنتوج على المنتوجات الأخرى عند توقع استعماله مع هذه المنتوجات، عرض المنتوج ووسمه والتعليمات المحتملة الخاصة باستعماله وإتلافه وكذا كل الإرشادات أو المعلومات الصادرة عن المنتج، فئات المستهلكين المعرضين لخطر جسيم نتيجة استعمال المنتوج ، خاصة الأطفال. تحدد القواعد المطبقة في مجال أمن المنتوجات عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_10_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_10_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_10_20090225_OpEnact_c35216d3e2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_10_obligation_0_a0992ab0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "10" ;
    dzdoc:position 9 ;
    dzdoc:usesTerm dzterm:consumers,
        dzterm:intervener,
        dzterm:product .

<https://legal.dz/resource/law/2009-02-25/09-03#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_3> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "يتعين على كل متدخل إجراء رقابة مطابقة المنتوج قبل عرضه للاستهلاك طبقا للأحكام التشريعية والتنظيمية السارية المفعول. تتناسب هذه الرقابة مع طبيعة العمليات التي يقوم بها المتدخل حسب حجم وتنوع المنتوجات التي يضعها للاستهلاك والوسائل التي يجب أن يمتلكها مراعاة لاختصاصه والقواعد والعادات المتعارف عليها في هذا المجال. لا تعفي الرقابة التي يجريها الأعوان المنصوص عليهم في المادة 25 من هذا القانون المتدخل من إلزامية التحري حول مطابقة المنتوج قبل عرضه للاستهلاك طبقا للأحكام التنظيمية السارية المفعول."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_12_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_12_para_1>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_12_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_12_20090225_OpEnact_016f481900> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_12_obligation_0_d5821a74>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_12_obligation_1_78561fa1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 12" ;
    dzdoc:position 11 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:usesTerm dzterm:intervener,
        dzterm:product .

<https://legal.dz/resource/law/2009-02-25/09-03#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_1> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "يجب على كل متدخل في عملية وضع المواد الغذائية للاستهلاك احترام إلزامية سلامة هذه المواد، والسهر على أن لا تضر بصحة المستهلك . تحدد الشروط والكيفيات المطبقة في مجال الخصائص المكروبيولوجية للمواد الغذائية عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_4_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_4_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_4_20090225_OpEnact_5241e080e7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_4_obligation_0_89b0d061> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 4" ;
    dzdoc:position 3 ;
    dzdoc:usesTerm dzterm:food_products,
        dzterm:intervener .

<https://legal.dz/resource/law/2009-02-25/09-03#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_2_sec_1> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "يجب على كل متدخل في عملية وضع المواد الغذائية للاستهلاك أن يسهر على احترام شروط النظافة والنظافة الصحية للمستخدمين، ولأماكن ومحلات التصنيع أو المعالجة أو التحويل أو التخزين، وكذا وسائل نقل هذه المواد وضمان عدم تعرضها للإتلاف بواسطة عوامل بيولوجية أو كيميائية أو فيزيائية . تحدد شروط عرض المواد الغذائية للاستهلاك عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_6_para_0>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_6_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_6_20090225_OpEnact_f000f37579> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2009-02-25/09-03#art_6_obligation_0_6206a009> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 6" ;
    dzdoc:position 5 ;
    dzdoc:usesTerm dzterm:food_products,
        dzterm:intervener .

