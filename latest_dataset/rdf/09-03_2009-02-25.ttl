        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يصرح بالرفض المؤقت لدخول منتوج مستورد عند الحدود في حالة الشك في عدم مطابقة المنتوج المعني وهذا لغرض إجراء تحريات مدققة أو لضبط مطابقته. ويصرح بالرفض النهائي لدخول منتوج مستورد عند الحدود في حالة إثبات عدم مطابقته بالمعاينة المباشرة، أو بعد إجراء التحريات المدققة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_54_20090225_OpEnact_981986f9de> ;
    dzdoc:replacementText "يصرح بالرفض المؤقت لدخول منتوج مستورد عند الحدود في حالة الشك في عدم مطابقة المنتوج المعني وهذا لغرض إجراء تحريات مدققة أو لضبط مطابقته. ويصرح بالرفض النهائي لدخول منتوج مستورد عند الحدود في حالة إثبات عدم مطابقته بالمعاينة المباشرة، أو بعد إجراء التحريات المدققة."@ar ;
