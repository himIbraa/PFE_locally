<https://legal.dz/resource/law/2009-02-25/09-03#art_79_extref_5b0d70a2> a dzdoc:ExternalReference ;
    rdfs:label "المادة 155 من قانون العقوبات"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-156#art_155"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-156#art_155"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-156#art_155" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:targetEId "art_155" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_79_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_79> ;
    dzdoc:position 0 ;
    dzdoc:text "دون الإخلال بالأحكام المنصوص عليها في المادة 155 من قانون العقوبات، يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من خمسمائة ألف دينار ( 500.000 دج) إلى مليوني دينار (2.000.000 دج) أو بإحدى هاتين العقوبتين، كل من يبيع منتوجا مشمعا أو مودعا لضبط المطابقة أو سحبه مؤقتا من عملية عرضه للاستهلاك أو يخالف إجراء التوقيف المؤقت للنشاط."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_7_obligation_0_76263369> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2009-02-25/09-03#art_7_obligation_0_76263369_action_ad02b83db1> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2009-02-25/09-03#art_7_obligation_0_76263369_role_4b1c5882e0> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_7> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب أن لا تحتوي التجهيزات واللوازم والعتاد والتغليف، وغيرها من الآلات المخصصة لملامسة المواد الغذائية، إلا على اللوازم التي لا تؤدي إلى إفسادها"@ar ;
    dznorm:sourceArticle "art_7" .

