<https://legal.dz/resource/law/2009-02-25/09-03#version_art_85> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "طبقا لأحكام المادة 36 من قانون العقوبات ، تضم الغرامات المنصوص عليها في هذا أحكام القانون. وفي حالة العود، تضاعف الغرامات ويمكن الجهة القضائية المختصة إعلان شطب السجل التجاري للمخالف."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_85_20090225_OpEnact_975ecd13c5> ;
    dzdoc:replacementText "طبقا لأحكام المادة 36 من قانون العقوبات ، تضم الغرامات المنصوص عليها في هذا أحكام القانون. وفي حالة العود، تضاعف الغرامات ويمكن الجهة القضائية المختصة إعلان شطب السجل التجاري للمخالف."@ar ;
    dzdoc:resolutionStatus "resolved" ;
