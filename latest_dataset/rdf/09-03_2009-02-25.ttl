<https://legal.dz/resource/law/2009-02-25/09-03#version_art_40> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لإجراء التحاليل أو الاختبارات أو التجارب، تقتطع ثلاث (3) عينات متجانسة وممثلة للحصة موضوع الرقابة وتشمع. ترسل العينة الأولى إلى المخبر المؤهل بموجب هذا القانون لإجراء التحاليل أو الاختبارات أو التجارب. وتشكل العينتان الثانية والثالثة عينتين شاهدتين، واحدة تحتفظ بها مصالح الرقابة التي قامت بالاقتطاع، والأخرى يحتفظ بها المتدخل المعني. تستعمل العينة التي يحتفظ بها المتدخل وتلك التي يحتفظ بها الأعوان الذين قاموا باقتطاع العينات في حالة إجراء الخبرة. تحفظ العينتان الشاهدتان ضمن شروط الحفظ المناسبة. ت"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_40_20090225_OpEnact_653ad7b3b7> ;
    dzdoc:replacementText "لإجراء التحاليل أو الاختبارات أو التجارب، تقتطع ثلاث (3) عينات متجانسة وممثلة للحصة موضوع الرقابة وتشمع. ترسل العينة الأولى إلى المخبر المؤهل بموجب هذا القانون لإجراء التحاليل أو الاختبارات أو التجارب. وتشكل العينتان الثانية والثالثة عينتين شاهدتين، واحدة تحتفظ بها مصالح الرقابة التي قامت بالاقتطاع، والأخرى يحتفظ بها المتدخل المعني. تستعمل العينة التي يحتفظ بها المتدخل وتلك التي يحتفظ بها الأعوان الذين قاموا باقتطاع العينات في حالة إجراء الخبرة. تحفظ العينتان الشاهدتان ضمن شروط الحفظ المناسبة. تحدد شروط وكيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2009-02-25/09-03#art_40> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2009-02-25/09-03> ;
