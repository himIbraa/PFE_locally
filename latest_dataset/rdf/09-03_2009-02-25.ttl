<https://legal.dz/resource/law/2009-02-25/09-03#version_art_86> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن الأعوان المنصوص عليهم في المادة 25 من هذا القانون، فرض غرامة صلح على مرتكب المخالفة المعاقب عليها طبقا لأحكام هذا القانون. وإذا لم تسدد غرامة الصلح في الأجل المحدد في المادة 92 أدناه ، يرسل المحضر إلى الجهة القضائية المختصة. وفي هذه الحالة، ترفع الغرامة إلى الحد الأقصى."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_86_20090225_OpEnact_e2973c2b6e> ;
    dzdoc:replacementText "يمكن الأعوان المنصوص عليهم في المادة 25 من هذا القانون، فرض غرامة صلح على مرتكب المخالفة المعاقب عليها طبقا لأحكام هذا القانون. وإذا لم تسدد غرامة الصلح في الأجل المحدد في المادة 92 أدناه ، يرسل المحضر إلى الجهة القضائية المختصة. وفي هذه الحالة، ترفع الغرامة إلى الحد الأقصى."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2009-02-25/09-03#art_86> ;
