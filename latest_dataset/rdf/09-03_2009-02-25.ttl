    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_80> ;
    dzdoc:position 0 ;
    dzdoc:text "إضافة إلى العقوبات المنصوص عليها في المادة 79 أعلاه، يدفع مبلغ بيع المنتوجات موضوع هذه المخالفات للخزينة العمومية ويقيم على أساس سعر البيع المطبق من طرف المخالف أو على أساس سعر السوق."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_81_obligation_0_b548f642> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_81> ;
    dznorm:position 0 ;
    dznorm:provisionText "الالتزامات المتعلقة بعرض القروض للاستهلاك"@ar ;
    dznorm:sourceArticle "art_81" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_81_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_81> ;
    dzdoc:position 0 ;
    dzdoc:text "مع مراعاة الأحكام المنصوص عليها في التشريع الساري المفعول، يعاقب بغرامة مالية من خمسمائة ألف دينار (500.000 دج) إلى مليون دينار ( 1.000.000 دج)، كل من يخالف الالتزامات المتعلقة بعرض القروض للاستهلاك المنصوص عليها في المادة 20 من هذا القانون."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_82_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_82> ;
    dzdoc:position 0 ;
    dzdoc:text "إضافة إلى العقوبات المنصوص عليها في المواد 68 و 69 و 70 و 71 و 73 و 78 أعلاه ، تصادر المنتوجات والأدوات وكل وسيلة أخرى استعملت لارتكاب المخالفات المنصوص عليها في هذا القانون."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_83_condition_0_4bdba4bb> a dznorm:Condition ;
    dznorm:conditionText "إذا ألحق هذا المنتوج بالمستهلك مرضا أو عجزا عن العمل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_83> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2009-02-25/09-03#art_83_condition_1_b7ead650> a dznorm:Condition ;
    dznorm:conditionText "إذا تسبب هذا المنتوج في مرض غير قابل للشفاء أو في فقدان استعمال عضو أو في الإصابة بعاهة مستديمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_83> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2009-02-25/09-03#art_83_condition_2_5bb4d50a> a dznorm:Condition ;
    dznorm:conditionText "إذا تسبب هذا المرض في وفاة شخص أو عدة أشخاص"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_83> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/2009-02-25/09-03#art_83_extref_5976fae0> a dzdoc:ExternalReference ;
    rdfs:label "المادة 432 من قانون العقوبات"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-156#art_432"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-156#art_432"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-156#art_432" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:targetEId "art_432" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_83_obligation_0_11c6e15d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_83> ;
    dznorm:position 0 ;
    dznorm:provisionText "إلزامية الأمن"@ar ;
    dznorm:sourceArticle "art_83" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_83_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_83> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالعقوبات المنصوص عليها في الفقرة الأولى من المادة 432 من قانون العقوبات، كل من يغش أو يعرض أو يضع للبيع أو يبيع كل منتوج مزور أو فاسد أو سام أو لا يستجيب لـ إلزامية الأمن المنصوص عليها في المادة 10 من هذا القانون، إذا ألحق هذا المنتوج بالمستهلك مرضا أو عجزا عن العمل."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_83_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_83> ;
    dzdoc:position 1 ;
    dzdoc:text "ويعاقب المتدخلون المعنيون بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من مليون دينار (1.000.000 دج) إلى مليوني دينار ( 2.000.000 دج)، إذا تسبب هذا المنتوج في مرض غير قابل للشفاء أو في فقدان استعمال عضو أو في الإصابة بعاهة مستديمة."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_83_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_83> ;
    dzdoc:position 2 ;
    dzdoc:text "يتعرض هؤلاء المتدخلون لعقوبة السجن المؤبد إذا تسبب هذا المرض في وفاة شخص أو عدة أشخاص."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_84_extref_b81dd823> a dzdoc:ExternalReference ;
    rdfs:label "المادة 435 من قانون العقوبات"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-156#art_435"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-156#art_435"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-156#art_435" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:targetEId "art_435" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_84_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_84> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالعقوبات المنصوص عليها في المادة 435 من قانون العقوبات كل من يعرقل أو يقوم بكل فعل آخر من شأنه أن يعيق إتمام مهام الرقابة التي يجريها الأعوان المنصوص عليهم في المادة 25 من هذا القانون."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_85_extref_ca336687> a dzdoc:ExternalReference ;
    rdfs:label "المادة 36 من قانون العقوبات"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-156#art_36"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-156#art_36"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-156#art_36" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:targetEId "art_36" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_85_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_85> ;
    dzdoc:position 0 ;
    dzdoc:text "طبقا لأحكام المادة 36 من قانون العقوبات، تضم الغرامات المنصوص عليها في هذا أحكام القانون. وفي حالة العود، تضاعف الغرامات ويمكن الجهة القضائية المختصة إعلان شطب السجل التجاري للمخالف."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_86_condition_0_9e17d191> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2009-02-25/09-03#art_86_condition_0_9e17d191_ref_5e9805529326> ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_92> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_92> ;
    dznorm:conditionText "وإذا لم تسدد غرامة الصلح في الأجل المحدد في المادة 92 أدناه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_86> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2009-02-25/09-03#art_86_condition_0_9e17d191_ref_5e9805529326> a dzdoc:Reference ;
    rdfs:label "المادة 92"@ar ;
    dzdoc:frbrUri "#art_92"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2009-02-25/09-03#art_92> ;
    dzdoc:sourceEId "art_86" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "وإذا لم تسدد غرامة الصلح في الأجل المحدد في المادة 92 أدناه"@ar ;
    dzdoc:targetEId "art_92" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_86_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_86> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن الأعوان المنصوص عليهم في المادة 25 من هذا القانون، فرض غرامة صلح على مرتكب المخالفة المعاقب عليها طبقا لأحكام هذا القانون."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_86_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_86> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا لم تسدد غرامة الصلح في الأجل المحدد في المادة 92 أدناه، يرسل المحضر إلى الجهة القضائية المختصة."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_86_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_86> ;
    dzdoc:position 2 ;
    dzdoc:text "وفي هذه الحالة، ترفع الغرامة إلى الحد الأقصى."@ar .

