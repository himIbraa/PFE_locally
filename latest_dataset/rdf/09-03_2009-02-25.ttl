<https://legal.dz/resource/law/2009-02-25/09-03#art_55_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_55> ;
    dzdoc:position 1 ;
    dzdoc:text "ويتقرر الإيداع قصد ضبط مطابقة المنتوج المشتبه فيه من طرف المتدخل المعني."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_55_para_2> a dzdoc:Paragraph ;
