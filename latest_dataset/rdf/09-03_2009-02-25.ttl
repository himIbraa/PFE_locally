<https://legal.dz/resource/law/2009-02-25/09-03#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_1_sec_1> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "يهدف هذا القانون إلى تحديد القواعد المطبقة في مجال حماية المستهلك و قمع الغش ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_1_20090225_OpEnact_032b1bdd50> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة الأولى" ;
    dzdoc:position 0 ;
    dzdoc:usesTerm dzterm:consumer_protection,
        dzterm:fraud_repression .

<https://legal.dz/resource/law/2009-02-25/09-03#art_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_1_sec_1> ;
    dzdoc:eId "art_2" ;
    dzdoc:fullText "تطبق أحكام هذا القانون على كل سلعة أو خدمة معروضة للاستهلاك بمقابل أو مجانا وعلى كل متدخل وفي جميع مراحل عملية العرض للاستهلاك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_2_20090225_OpEnact_094dc76a9a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 2" ;
    dzdoc:position 1 ;
    dzdoc:usesTerm dzterm:goods,
        dzterm:intervener,
        dzterm:service .

<https://legal.dz/resource/law/2009-02-25/09-03#art_43> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_3_sec_5> ;
    dzdoc:eId "art_43" ;
    dzdoc:fullText "تكون الخبرة التي تجرى في إطار هذا القانون، قابلة للطعن ويؤمر بها وتنفذ حسب الإجراءات والأشكال المنصوص عليها في المواد من 143 إلى 156 من قانون الإجراءات الجزائية ، مع مراعاة الأحكام المنصوص عليها أدناه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_43> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_43_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_43_20090225_OpEnact_20b33e70c5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 43" ;
    dzdoc:position 42 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2009-02-25/09-03#art_43_extref_39826842>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_43_extref_97a4859b> ;
    dzdoc:usesTerm dzterm:criminal_procedure_code,
        dzterm:expertise .

<https://legal.dz/resource/law/2009-02-25/09-03#art_61> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_1> ;
    dzdoc:eId "art_61" ;
    dzdoc:fullText "يؤدي الحجز و السحب المؤقت أو النهائي الذي يقوم به الأعوان المذكورون في المادة 25 من هذا القانون، إلى تحرير محاضر وتشمع المنتوجات المشتبه فيها وتوضع تحت حراسة المتدخل المعني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_61> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_61_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_61_20090225_OpEnact_4f7182a934> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "61" ;
    dzdoc:position 60 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:usesTerm dzterm:agents,
        dzterm:final_withdrawal,
        dzterm:intervener,
        dzterm:seizure,
        dzterm:temporary_withdrawal .

<https://legal.dz/resource/law/2009-02-25/09-03#art_82> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_2> ;
    dzdoc:eId "art_82" ;
    dzdoc:fullText "إضافة إلى العقوبات المنصوص عليها في المواد 68 و 69 و 70 و 71 و 73 و 78 أعلاه ، تصادر المنتوجات والأدوات وكل وسيلة أخرى استعملت لارتكاب المخالفات المنصوص عليها في هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_82> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_82_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_82_20090225_OpEnact_0138baec98> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 82" ;
    dzdoc:position 81 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_68>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_69>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_70>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_71>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_73>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_78> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_68>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_69>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_70>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_71>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_73>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_78> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_84> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_2> ;
    dzdoc:eId "art_84" ;
    dzdoc:fullText "يعاقب بالعقوبات المنصوص عليها في المادة 435 من قانون العقوبات كل من يعرقل أو يقوم بكل فعل آخر من شأنه أن يعيق إتمام مهام الرقابة التي يجريها الأعوان المنصوص عليهم في المادة 25 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_84> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_84_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_84_20090225_OpEnact_38e2845628> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 84" ;
    dzdoc:position 83 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_25> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2009-02-25/09-03#art_84_extref_b81dd823> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_25> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_85> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_4_sec_2> ;
    dzdoc:eId "art_85" ;
    dzdoc:fullText "طبقا لأحكام المادة 36 من قانون العقوبات ، تضم الغرامات المنصوص عليها في هذا أحكام القانون. وفي حالة العود، تضاعف الغرامات ويمكن الجهة القضائية المختصة إعلان شطب السجل التجاري للمخالف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_85> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_85_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_85_20090225_OpEnact_975ecd13c5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 85" ;
    dzdoc:position 84 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2009-02-25/09-03#art_85_extref_ca336687> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_5> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "يحدد مبلغ غرامة الصلح كما يأتي: انعدام سلامة المواد الغذائية المعاقب عليها في المادة 71 من هذا القانون: ثلاثمائة ألف دينار ( 300.000 دج)، انعدام النظافة والنظافة الصحية المعاقب عليها في المادة 72 من ه قانون : مائتا ألف دينار (200.000 دج)، انعدام أمن المنتوج المعاقب عليه في المادة 73 من هذا القانون : ثلاثمائة ألف دينار (300.000 دج)، انعدام رقابة المطابقة المسبقة المعاقب عليها في المادة 74 من هذا القانون : ثلاثمائة ألف دينار (300.000 دج)، انعدام الضمان أو عدم تنفيذه المعاقب عليه في المادة 75 من هذا القانون: ثلاثمائة ألف دينار (300.000 دج)، عدم تجربة المنتوج المعاقب عليها في المادة 76 من هذا القانون : خمسون ألف دينار ( 50.000 دج)، رفض تنفيذ الخدمة ما بعد البيع المعاقب عليها في المادة 77 من هذا القانون : (10%) من ثمن المنتوج المقتنى، غياب بيانات وسم المنتوج المعاقب عليها في المادة 78 من هذا القانون : مائتا ألف دينار ( 200.000 دج)."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2009-02-25/09-03#art_88_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_88_20090225_OpEnact_e6e1b22ddb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:introducedOn "2009-02-25"^^xsd:date ;
    dzdoc:number "المادة 88" ;
    dzdoc:position 87 ;
    dzdoc:references <https://legal.dz/resource/law/2009-02-25/09-03#art_71>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_72>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_73>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_74>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_75>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_76>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_77>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_78> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2009-02-25/09-03#art_71>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_72>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_73>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_74>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_75>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_76>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_77>,
        <https://legal.dz/resource/law/2009-02-25/09-03#art_78> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_91> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#chp_5> ;
    dzdoc:eId "art_91" ;
    dzdoc:fullText "لا يقبل الطعن في القرار الذي يحدد مبلغ غرامة الصلح."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2009-02-25/09-03#version_art_91> ;
