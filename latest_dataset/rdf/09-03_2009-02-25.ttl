<https://legal.dz/resource/law/2009-02-25/09-03#version_art_65> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن تقوم المصالح المكلفة بحماية المستهلك وقمع الغش طبقا للتشريع والتنظيم الساريي المفعول، بالتوقيف المؤقت لنشاط المؤسسات التي ثبت عدم مراعاتها للقواعد المحددة في هذا القانون، إلى غاية إزالة كل الأسباب التي أدت إلى اتخاذ هذا التدبير، دون الإخلال بالعقوبات الجزائية المنصوص عليها في أحكام هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_65_20090225_OpEnact_b2a03a4d91> ;
