<https://legal.dz/resource/law/2009-02-25/09-03#version_art_59> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتمثل السحب المؤقت في منع وضع كل منتوج للاستهلاك أينما وجد عند الاشتباه في عدم مطابقته وذلك في انتظار نتائج التحريات المعمقة لا سيما نتائج التحاليل أو الاختبارات أو التجارب. إذا لم تجر هذه التحريات في أجل سبعة (7) أيام عمل أو إذا لم يثبت عدم مطابقة المنتوج ، يرفع فورا تدبير السحب المؤقت . ويمكن تمديد هذا الأجل عندما تتطلب الشروط التقنية للرقابة والتحاليل أو الاختبارات أو التجارب ذلك. إذا ثبت عدم مطابقة منتوج ، يعلن عن حجزه، ويعلم فورا وكيل الجمهورية بذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_59_20090225_OpEnact_77e9d5c096> ;
    dzdoc:replacementText "يتمثل السحب المؤقت في منع وضع كل منتوج للاستهلاك أينما وجد عند الاشتباه في عدم مطابقته وذلك في انتظار نتائج التحريات المعمقة لا سيما نتائج التحاليل أو الاختبارات أو التجارب. إذا لم تجر هذه التحريات في أجل سبعة (7) أيام عمل أو إذا لم يثبت عدم مطابقة المنتوج ، يرفع فورا تدبير السحب المؤقت . ويمكن تمديد هذا الأجل عندما تتطلب الشروط التقنية للرقابة والتحاليل أو الاختبارات أو التجارب ذلك. إذا ثبت عدم مطابقة منتوج ، يعلن عن حجزه، ويعلم فورا وكيل الجمهورية بذلك ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2009-02-25/09-03#art_59> ;
