<https://legal.dz/resource/law/2009-02-25/09-03#version_art_7> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن لا تحتوي التجهيزات واللوازم والعتاد والتغليف، وغيرها من الآلات المخصصة لملامسة المواد الغذائية ، إلا على اللوازم التي لا تؤدي إلى إفسادها . تحدد شروط وكيفيات استعمال المنتوجات واللوازم الموجهة لملامسة المواد الغذائية ، وكذا مستحضرات تنظيف هذه اللوازم عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_7_20090225_OpEnact_e3a6af32fd> ;
    dzdoc:replacementText "يجب أن لا تحتوي التجهيزات واللوازم والعتاد والتغليف، وغيرها من الآلات المخصصة لملامسة المواد الغذائية ، إلا على اللوازم التي لا تؤدي إلى إفسادها . تحدد شروط وكيفيات استعمال المنتوجات واللوازم الموجهة لملامسة المواد الغذائية ، وكذا مستحضرات تنظيف هذه اللوازم عن طريق التنظيم."@ar ;
