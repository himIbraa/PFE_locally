<https://legal.dz/resource/law/2009-02-25/09-03#version_art_52> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تجرى التحاليل أو الاختبارات أو التجارب في إطار الإجراء الحضوري في المخابر المؤهلة طبقا للأحكام المنصوص عليها بموجب هذا القانون. يجب على الخبراء استخدام منهج أو مناهج التحاليل المستعملة من طرف المخابر المؤهلة والقيام بنفس التحاليل أو الاختبارات أو التجارب. كما يمكنهم استخدام مناهج أخرى على سبيل الإضافة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_52_20090225_OpEnact_7892bb940d> ;
    dzdoc:replacementText "تجرى التحاليل أو الاختبارات أو التجارب في إطار الإجراء الحضوري في المخابر المؤهلة طبقا للأحكام المنصوص عليها بموجب هذا القانون. يجب على الخبراء استخدام منهج أو مناهج التحاليل المستعملة من طرف المخابر المؤهلة والقيام بنفس التحاليل أو الاختبارات أو التجارب. كما يمكنهم استخدام مناهج أخرى على سبيل الإضافة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
