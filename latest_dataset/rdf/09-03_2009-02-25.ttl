    dzdoc:evidenceText "تلغى أحكام القانون رقم 89 - 02 المؤرخ في أول رجب عام 1409 الموافق 7 فبراير سنة 1989 والمتعلق بالقواعد العامة لحماية المستهلك ، وتبقى نصوصه التطبيقية سارية المفعول إلى حين صدورالنصوص التطبيقية لهذا القانون التي تحل محلها."@ar ;
    dzdoc:isContradictory false ;
    dzdoc:lifecycleRelationType "repeals" ;
