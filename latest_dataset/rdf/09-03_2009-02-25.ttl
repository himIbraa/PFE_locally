<https://legal.dz/resource/law/2009-02-25/09-03#version_art_6> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2009-02-25/09-03> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على كل متدخل في عملية وضع المواد الغذائية للاستهلاك أن يسهر على احترام شروط النظافة والنظافة الصحية للمستخدمين، ولأماكن ومحلات التصنيع أو المعالجة أو التحويل أو التخزين، وكذا وسائل نقل هذه المواد وضمان عدم تعرضها للإتلاف بواسطة عوامل بيولوجية أو كيميائية أو فيزيائية . تحدد شروط عرض المواد الغذائية للاستهلاك عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2009-02-25/09-03#version_art_6_20090225_OpEnact_f000f37579> ;
    dzdoc:replacementText "يجب على كل متدخل في عملية وضع المواد الغذائية للاستهلاك أن يسهر على احترام شروط النظافة والنظافة الصحية للمستخدمين، ولأماكن ومحلات التصنيع أو المعالجة أو التحويل أو التخزين، وكذا وسائل نقل هذه المواد وضمان عدم تعرضها للإتلاف بواسطة عوامل بيولوجية أو كيميائية أو فيزيائية . تحدد شروط عرض المواد الغذائية للاستهلاك عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2009-02-25/09-03#art_6> ;
