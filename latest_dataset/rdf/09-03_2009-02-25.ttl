<https://legal.dz/resource/law/2009-02-25/09-03#art_68_obligation_0_aa25f8d1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/law/2009-02-25/09-03#art_68_obligation_0_aa25f8d1_ref_6b367f7e668d> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2009-02-25/09-03#art_68_obligation_0_aa25f8d1_ref_6b367f7e668d> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_68> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالعقوبات المنصوص عليها في المادة 429 من قانون العقوبات، كل من يخدع أو يحاول أن يخدع المستهلك بأية وسيلة أو طريقة كانت حول:"@ar ;
    dznorm:sourceArticle "art_68" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_68_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_68> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالعقوبات المنصوص عليها في المادة 429 من قانون العقوبات، كل من يخدع أو يحاول أن يخدع المستهلك بأية وسيلة أو طريقة كانت حول: كمية المنتوجات المسلمة، تسليم المنتوجات غير تلك المعينة مسبقا، قابلية استعمال المنتوج، تاريخ أو مدد صلاحية المنتوج، النتائج المنتظرة من المنتوج، طرق الاستعمال أو الاحتياطات اللازمة لاستعمال المنتوج."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_69_obligation_0_a88c531d_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/law/2009-02-25/09-03#art_69_obligation_0_a88c531d> ;
    dznorm:conditionText "إذا كان الخداع أو محاولة الخداع قد ارتكبت سواء بواسطة:"@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_69_obligation_0_a88c531d_ref_a68ca8d863cb> a dzdoc:Reference ;
    rdfs:label "المادة 68 أعلاه"@ar ;
    dzdoc:frbrUri "#art_68"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2009-02-25/09-03#art_68> ;
    dzdoc:sourceEId "art_69" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "ترفع العقوبات المنصوص عليها في المادة 68 أعلاه، إلى خمس (5) سنوات حبسا وغرامة قدرها خمسمائة ألف دينار (500.000 دج)، إذا كان الخداع أو محاولة الخداع قد ارتكبت سواء بواسطة:"@ar ;
    dzdoc:targetEId "art_68" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_69_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_69> ;
    dzdoc:position 0 ;
    dzdoc:text "ترفع العقوبات المنصوص عليها في المادة 68 أعلاه، إلى خمس (5) سنوات حبسا وغرامة قدرها خمسمائة ألف دينار (500.000 دج)، إذا كان الخداع أو محاولة الخداع قد ارتكبت سواء بواسطة: الوزن أو الكيل أو بأدوات أخرى مزورة أو غير مطابقة، طرق ترمي إلى التغليط في عمليات التحليل أو المقدار أو الوزن أو الكيل أو التغيير عن طريق الغش في تركيب أو وزن أو حجم المنتوج، إشارات أو ادعاءات تدليسية، كتيبات أو منشورات أو نشرات أو معلقات أو إعلانات أو بطاقات أو أية تعليمات أخرى."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_6_obligation_0_6206a009> a dznorm:Obligation ;
