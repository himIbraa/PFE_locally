<https://legal.dz/resource/law/2009-02-25/09-03#art_40_obligation_0_641912ad> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_40> ;
    dznorm:position 0 ;
    dznorm:provisionText "لإجراء التحاليل أو الاختبارات أو التجارب، تقتطع ثلاث (3) عينات متجانسة وممثلة للحصة موضوع الرقابة وتشمع."@ar ;
    dznorm:sourceArticle "art_40" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_40_obligation_1_abf5864e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_40> ;
    dznorm:position 1 ;
    dznorm:provisionText "ترسل العينة الأولى إلى المخبر المؤهل بموجب هذا القانون لإجراء التحاليل أو الاختبارات أو التجارب."@ar ;
    dznorm:sourceArticle "art_40" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_40_obligation_2_eabb7901> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
