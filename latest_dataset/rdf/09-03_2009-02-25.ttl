    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_24> ;
    dznorm:position 0 ;
    dznorm:provisionText "ينشأ مجلس وطني لحماية المستهلكين، يقوم بإبداء الرأي، واقتراح التدابير التي تساهم في تطوير وترقية سياسات حماية المستهلك"@ar ;
    dznorm:sourceArticle "art_24" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_24_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_24> ;
