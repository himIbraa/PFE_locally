<https://legal.dz/resource/law/2009-02-25/09-03#art_12_obligation_0_d5821a74> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2009-02-25/09-03#art_12_obligation_0_d5821a74_role_666b00ddf3> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_12> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتعين على كل متدخل إجراء رقابة مطابقة المنتوج قبل عرضه للاستهلاك طبقا للأحكام التشريعية والتنظيمية السارية المفعول."@ar ;
    dznorm:sourceArticle "art_12" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_12_obligation_0_d5821a74_role_666b00ddf3> a dznorm:Role ;
    rdfs:label "كل متدخل إجراء رقابة"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يتعين على كل متدخل إجراء رقابة مطابقة المنتوج قبل عرضه للاستهلاك طبقا للأحكام التشريعية والتنظيمية السارية المفعول."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_12> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_12_obligation_1_78561fa1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_12> ;
    dznorm:position 1 ;
    dznorm:provisionText "إلزامية التحري حول مطابقة المنتوج قبل عرضه للاستهلاك طبقا للأحكام التنظيمية السارية المفعول."@ar ;
    dznorm:sourceArticle "art_12" .

<https://legal.dz/resource/law/2009-02-25/09-03#art_12_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_12> ;
    dzdoc:position 0 ;
    dzdoc:text "يتعين على كل متدخل إجراء رقابة مطابقة المنتوج قبل عرضه للاستهلاك طبقا للأحكام التشريعية والتنظيمية السارية المفعول."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_12_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_12> ;
    dzdoc:position 1 ;
    dzdoc:text "تتناسب هذه الرقابة مع طبيعة العمليات التي يقوم بها المتدخل حسب حجم وتنوع المنتوجات التي يضعها للاستهلاك والوسائل التي يجب أن يمتلكها مراعاة لاختصاصه والقواعد والعادات المتعارف عليها في هذا المجال."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_12_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_12> ;
    dzdoc:position 2 ;
    dzdoc:text "لا تعفي الرقابة التي يجريها الأعوان المنصوص عليهم في المادة 25 من هذا القانون المتدخل من إلزامية التحري حول مطابقة المنتوج قبل عرضه للاستهلاك طبقا للأحكام التنظيمية السارية المفعول."@ar .

<https://legal.dz/resource/law/2009-02-25/09-03#art_13_obligation_0_9b697dd9_action_4d62864144> a dznorm:Action ;
    rdfs:label "متدخل خلال فترة الضمان المحددة"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب على كل متدخل خلال فترة الضمان المحددة، في حالة ظهور عيب بالمنتوج، استبداله أو إرجاع ثمنه، أو تصليح المنتوج أو تعديل الخدمة على نفقته"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2009-02-25/09-03#art_13> .

<https://legal.dz/resource/law/2009-02-25/09-03#art_13_obligation_0_9b697dd9_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/law/2009-02-25/09-03#art_13_obligation_0_9b697dd9> ;
    dznorm:conditionText "في حالة ظهور عيب بالمنتوج"@ar .

