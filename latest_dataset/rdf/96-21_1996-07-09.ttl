    dznorm:position 0 ;
    dznorm:provisionText "يرفع كل احتجاج يتعلق بانتخابات مندوبي المستخدمين في أجل الثلاثين (30) يوما التالية للانتخابات أمام المحكمة المختصة إقليميا"@ar ;
    dznorm:sourceArticle "art_15" .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_15_right_0_1b782f4b_period_d290c6132f> a dznorm:Period ;
