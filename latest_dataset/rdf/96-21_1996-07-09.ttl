<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_5_obligation_0_1dfd98dd> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
