<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعدل ويتمم المقطع الثالث من الفقرة الأولى من المادة 54 من القانون رقم 90-11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، ويحرر كما يأتي : \"المادة 54 يستفيد العامل ثلاثة (3) أيام كاملة مدفوعة الأجر، بمناسبة حدث من الأحداث العائلية الآتية : زواج العامل وولادة مولود له، أو زواج أحد فروع العامل أو وفاة أحد الأصول أو الفروع أو الحواشي من الدرجة الأولى للعامل أو لزوجه، أو وفاة زوج العامل، أو ختان إبن العامل . غير أنه في حالتي الولادة أو الوفاة يكون التبرير لاحقا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_8_19960709_OpEnact_3d8c830a38> ;
    dzdoc:replacementText "يعدل ويتمم المقطع الثالث من الفقرة الأولى من المادة 54 من القانون رقم 90-11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، ويحرر كما يأتي : \"المادة 54 يستفيد العامل ثلاثة (3) أيام كاملة مدفوعة الأجر، بمناسبة حدث من الأحداث العائلية الآتية : زواج العامل وولادة مولود له، أو زواج أحد فروع العامل أو وفاة أحد الأصول أو الفروع أو الحواشي من الدرجة الأولى للعامل أو لزوجه، أو وفاة زوج العامل، أو ختان إبن العامل . غير أنه في حالتي الولادة أو الوفاة يكون التبرير لاحقا"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
