<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_5> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتمم المادة 31 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بفقرتين تحرران كما يأتي \"المادة 31 : غير أنه يجوز مخالفة الحدود المنصوص عليها في الفقرة 2 من هذه المادة في الحالات المذكورة صراحة وضمن الشروط المحددة في الاتفاقيات والاتفاقات الجماعية، وهي : الوقاية من الحوادث الوشيكة الوقوع أو إصلاح الأضرار الناجمة عن الحوادث إنهاء الأشغال التي يمكن أن يتسبب توقفها، بحكم طبيعتها في أضرار . يستشار وجوبا في هذه الحالات ممثلو العمال ويعلم إلزاما مفتش العمل المختص إقليميا \"."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_5_19960709_OpEnact_646cb22620> ;
    dzdoc:replacementText "تتمم المادة 31 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بفقرتين تحرران كما يأتي \"المادة 31 : غير أنه يجوز مخالفة الحدود المنصوص عليها في الفقرة 2 من هذه المادة في الحالات المذكورة صراحة وضمن الشروط المحددة في الاتفاقيات والاتفاقات الجماعية، وهي : الوقاية من الحوادث الوشيكة الوقوع أو إصلاح الأضرار الناجمة عن الحوادث إنهاء الأشغال التي يمكن أن يتسبب توقفها، بحكم طبيعتها في أضرار . يستشار وجوبا في هذه الحالات ممثلو العمال ويعلم إلزاما مفتش العمل المختص إقليميا \"."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_5> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
