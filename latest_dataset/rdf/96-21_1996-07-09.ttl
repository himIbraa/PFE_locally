<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "تتمم أحكام القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه ب المادة 93 مكرر ، تحرر كما يأتي : \" المادة 93 مكرر : يمارس مندوب المستخدمين المنتخب، طبقا ل المادتين 91 و 92 من هذا القانون، صلاحيات لجنة المشاركة المنصوص عليها في المادة 94 أدناه في الحالات التي تتوفر فيها الهيئة المستخدمة على مكان عمل متميز وحيد"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12_para_0>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_12_19960709_OpEnact_bf1153d773> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "12" ;
    dzdoc:position 11 ;
    dzdoc:references <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_91>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_92>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_93_bis>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_94> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12_extref_7dfc639f> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_91>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_92>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_93_bis>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_94> ;
