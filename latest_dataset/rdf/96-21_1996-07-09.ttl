<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8> ;
    dzdoc:position 0 ;
    dzdoc:text "يعدل ويتمم المقطع الثالث من الفقرة الأولى من المادة 54 من القانون رقم 90-11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، ويحرر كما يأتي :"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8> ;
    dzdoc:position 1 ;
    dzdoc:text "\"المادة 54 يستفيد العامل ثلاثة (3) أيام كاملة مدفوعة الأجر، بمناسبة حدث من الأحداث العائلية الآتية : زواج العامل وولادة مولود له، أو زواج أحد فروع العامل أو وفاة أحد الأصول أو الفروع أو الحواشي من الدرجة الأولى للعامل أو لزوجه، أو وفاة زوج العامل، أو ختان إبن العامل."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8> ;
    dzdoc:position 2 ;
    dzdoc:text "غير أنه في حالتي الولادة أو الوفاة يكون التبرير لاحقا"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8_right_0_268cb99f> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8> ;
    dznorm:position 0 ;
    dznorm:provisionText "يستفيد العامل ثلاثة (3) أيام كاملة مدفوعة الأجر، بمناسبة حدث من الأحداث العائلية الآتية : زواج العامل وولادة مولود له، أو زواج أحد فروع العامل أو وفاة أحد الأصول أو الفروع أو الحواشي من الدرجة الأولى للعامل أو لزوجه، أو وفاة زوج العامل، أو ختان إبن العامل"@ar ;
    dznorm:sourceArticle "art_8" .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_97_condition_0_2d44bf11> a dznorm:Condition ;
    dznorm:conditionText "إذا كانت الهيئة المستخدمة مؤسسة منذ أقل من سنة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_97> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_97_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_97> ;
    dzdoc:position 0 ;
    dzdoc:text "المادة 97 : لا تشترط الأقدمية المنصوص عليها في الفقرة الثالثة أعلاه، إذا كانت الهيئة المستخدمة مؤسسة منذ أقل من سنة\"."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#lifecycle_048f5b742e2e> a dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 0.92 ;
    dzdoc:evidenceText "يعدل هذ الأمر ويتمم أحكام القانون رقم 90-11 المؤرخ في 21 أبريل سنة 1990 والمتعلق ب علاقات العمل ."@ar ;
    dzdoc:isContradictory false ;
    dzdoc:lifecycleRelationType "amends" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:ruleId "lifecycle_explicit_amend_phrase" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_1> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#lifecycle_0c09b9406097> a dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 0.92 ;
    dzdoc:evidenceText "تتمم أحكام القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه ب المادة 93 مكرر ، تحرر كما يأتي : \" المادة 93 مكرر : يمارس مندوب المستخدمين المنتخب، طبقا ل المادتين 91 و 92 من هذا القانون، صلاحيات لجنة المشاركة المنصوص عليها في المادة 94 أدناه في الحالات التي تتوفر فيها الهيئة المستخدمة على مكان عمل متميز وحيد"@ar ;
    dzdoc:isContradictory false ;
    dzdoc:lifecycleRelationType "amends" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:ruleId "lifecycle_explicit_amend_phrase" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#lifecycle_24cce55af18a> a dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 0.79 ;
    dzdoc:evidenceText "تعدل وتتمم المادة 93 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 93 : ينتخب مندوبو المستخدمين، ضمن نفس الهيئة المستخدمة، المنتخبين طبقا لأحكام المادتين 91 و 92 من هذا القانون من بينهم لجنة مشاركة ويحدد عدد المندوبين فيها طبقا للشروط المنصوص عليها في المادة 99 أدناه \"."@ar ;
    dzdoc:isContradictory false ;
    dzdoc:lifecycleRelationType "amends" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:ruleId "lifecycle_explicit_amend_phrase" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_11> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#lifecycle_2ec05bb63235> a dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 0.79 ;
    dzdoc:evidenceText "تتمم المادة 12 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بمقطع خامس، يحرر كما يأتي: \"المادة 12 : عندما يتعلق الأمر بنشاطات أو أشغال ذات مدة محدودة أو مؤقتة بحكم طبيعتها \"."@ar ;
    dzdoc:isContradictory false ;
    dzdoc:lifecycleRelationType "amends" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:ruleId "lifecycle_explicit_amend_phrase" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_2> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#lifecycle_3121176e5018> a dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 0.79 ;
    dzdoc:evidenceText "تتمم المادة 13 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بفقرة 2، تحرر كما يأتي \"المادة 13 : تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم\"."@ar ;
    dzdoc:isContradictory false ;
    dzdoc:lifecycleRelationType "amends" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:ruleId "lifecycle_explicit_amend_phrase" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_4> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#lifecycle_3d014895eca7> a dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 0.79 ;
    dzdoc:evidenceText "تعدل المادة 134 من القانون رقم 90 – 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 134 : إذا لاحظ مفتش العمل أن اتفاقية جماعية أو اتفاقا جماعيا مخالف (ة) للتشريع والتنظيم المعمول بهما ، يعرضها ( يعرضه ) تلقائيا على الجهة القضائية المختصة"@ar ;
    dzdoc:isContradictory false ;
    dzdoc:lifecycleRelationType "amends" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:ruleId "lifecycle_explicit_amend_phrase" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_19> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#lifecycle_5df9fbb79b83> a dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 0.92 ;
    dzdoc:evidenceText "تتمم أحكام القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بالمادة 146 مكرر ، تحرر كما يأتي : \" المادة 146 مكرر : يعاقب على كل مخالفة لأحكام هذا القانون المتعلقة باللجوء إلى عقد العمل ذي المدة المحدودة خارج الحالات والشروط المنصوص عليها صراحة في المادتين 12 و 12 مكرر من هذا القانون، بغرامة مالية من 1000 دج إلى 2000 دج مطبقة حسب عدد المخالفات \"."@ar ;
    dzdoc:isContradictory false ;
    dzdoc:lifecycleRelationType "amends" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:ruleId "lifecycle_explicit_amend_phrase" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_21> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#lifecycle_5f02c33bb80d> a dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 0.79 ;
    dzdoc:evidenceText "تعدل وتتمم المادة 114 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 114 : الاتفاقية الجماعية اتفاق مدون يتضمن مجموع شروط التشغيل والعمل فيما يخص فئة أو عدة فئات مهنية . الاتفاق الجماعي اتفاق مدون يعالج عنصرا معينا أو عدة عناصر محددة من مجموع شروط التشغيل والعمل بالنسبة لفئة أو عدة فئات اجتماعية ومهنية . ويمكن أن يشكل ملحقا للاتفاقية الجماعية. تبرم الاتفاقيات والاتفاقات الجماعية ضمن نفس الهيئة المستخدمة بين المستخدم و الممثلين النقابيين للعمال . كما تبرم بين مجموعة مستخدمين أو منظمة أو عدة منظمات نقابية تمثيلية للمستخدمين، من جهة، أو منظمة أو عدة منظمات نقابية تمثيلية للعمال، من جهة أخرى. تحدد تمثيلية الأطراف في التفاوض طبقا للشروط المنصوص عليها في القانون"@ar ;
    dzdoc:isContradictory false ;
    dzdoc:lifecycleRelationType "amends" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:ruleId "lifecycle_explicit_amend_phrase" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#lifecycle_5f8976879dc8> a dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:confidenceScore 0.79 ;
    dzdoc:evidenceText "تعدل وتتمم المادة 114 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 114 : الاتفاقية الجماعية اتفاق مدون يتضمن مجموع شروط التشغيل والعمل فيما يخص فئة أو عدة فئات مهنية . الاتفاق الجماعي اتفاق مدون يعالج عنصرا معينا أو عدة عناصر محددة من مجموع شروط التشغيل والعمل بالنسبة لفئة أو عدة فئات اجتماعية ومهنية . ويمكن أن يشكل ملحقا للاتفاقية الجماعية. تبرم الاتفاقيات والاتفاقات الجماعية ضمن نفس الهيئة المستخدمة بين المستخدم و الممثلين النقابيين للعمال . كما تبرم بين مجموعة مستخدمين أو منظمة أو عدة منظمات نقابية تمثيلية للمستخدمين، من جهة، أو منظمة أو عدة منظمات نقابية تمثيلية للعمال، من جهة أخرى. تحدد تمثيلية الأطراف في التفاوض طبقا للشروط المنصوص عليها في القانون"@ar ;
    dzdoc:isContradictory false ;
    dzdoc:lifecycleRelationType "amends" ;
