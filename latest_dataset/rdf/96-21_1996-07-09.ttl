<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14_obligation_1_bdb6eddb> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14> ;
    dznorm:hasCondition <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14_obligation_1_bdb6eddb_condition_0> ;
    dznorm:position 1 ;
    dznorm:provisionText "تقدم المنظمات النقابية التمثيلية ضمن الهيئة المستخدمة مترشحين لانتخاب مندوبي المستخدمين من بين العمال الذين تتوفر فيهم معايير قابلية الانتخاب المحددة في المادة 97 أعلاه"@ar ;
    dznorm:sourceArticle "art_14" .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14_right_0_57dac827> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14_right_0_57dac827_action_01f024e6e6> ;
    dznorm:expressedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14> ;
    dznorm:hasCondition <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14_right_0_57dac827_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يمكن كل العمال الذين تتوفر فيهم معايير قابلية الانتخاب المحددة في المادة 97 أعلاه أن يرشحوا أنفسهم"@ar ;
    dznorm:sourceArticle "art_14" .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17_defocc_55d7ae82f9d7> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 107 ;
    dzdoc:charStart 15 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:collective_agreement ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17_para_1> ;
    dzdoc:paragraphPosition 1 ;
    dzdoc:snippet "\" المادة 114 : الاتفاقية الجماعية اتفاق مدون يتضمن مجموع شروط التشغيل والعمل فيما يخص فئة أو عدة فئات مهنية."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17_defocc_ea8cad5bcf6f> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 133 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:collective_accord ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17_para_2> ;
    dzdoc:paragraphPosition 2 ;
    dzdoc:snippet "الاتفاق الجماعي اتفاق مدون يعالج عنصرا معينا أو عدة عناصر محددة من مجموع شروط التشغيل والعمل بالنسبة لفئة أو عدة فئات اجتماعية ومهنية. ويمكن أن يشكل ملحقا للاتفاقية الجماعية."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17> ;
    dzdoc:position 1 ;
    dzdoc:text "\" المادة 114 : الاتفاقية الجماعية اتفاق مدون يتضمن مجموع شروط التشغيل والعمل فيما يخص فئة أو عدة فئات مهنية."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17> ;
    dzdoc:position 2 ;
    dzdoc:text "الاتفاق الجماعي اتفاق مدون يعالج عنصرا معينا أو عدة عناصر محددة من مجموع شروط التشغيل والعمل بالنسبة لفئة أو عدة فئات اجتماعية ومهنية. ويمكن أن يشكل ملحقا للاتفاقية الجماعية."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble_segment_0> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble> ;
    dzdoc:position 0 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "إن رئيس الجمهورية،"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble_segment_1> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble> ;
    dzdoc:position 1 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "بناء على الدستور، لا سيما المواد 52 ، 53، 54، 115 و 117 منه،"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble_segment_10> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble> ;
    dzdoc:position 10 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبمقتضى القانون رقم 90 - 11 المؤرخ في 26 رمضان عام 1410 الموافق 21 أبريل سنة 1990 والمتعلق بعلاقات العمل، المعدل والمتمم"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble_segment_11> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble> ;
    dzdoc:position 11 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبمقتضى القانون رقم 90 - 14 المؤرخ في 9 ذي القعدة عام 1410 الموافق 2 يونيو سنة 1990 والمتعلق بكيفيات ممارسة الحق النقابي، المعدل والمتمم."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble_segment_12> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble> ;
    dzdoc:position 12 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبمقتضى الأمر رقم 95 – 25 المؤرخ في 30 ربيع الثاني عام 1416 الموافق 25 سبتمبر سنة 1995 والمتعلق بتسيير رؤوس الأموال التجارية التابعة للدولة،"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble_segment_13> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble> ;
    dzdoc:position 13 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبعد مصادقة المجلس الوطني الانتقالي،"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble_segment_2> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble> ;
    dzdoc:position 2 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبناء على الأرضية المتضمنة الوفاق الوطني حول المرحلة الانتقالية،"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble_segment_3> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble> ;
    dzdoc:position 3 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبمقتضى الأمر رقم 66 – 154 المؤرخ في 18 صفر عام 1386 الموافق 8 يونيو سنة 1966 والمتضمن قانون الإجراءات المدنية، المعدل والمتمم"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble_segment_4> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble> ;
    dzdoc:position 4 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبمقتضى الأمر رقم 66 - 156 المؤرخ في 18 صفر عام 1386 الموافق 8 يونيو سنة 1966 والمتضمن قانون العقوبات، المعدل والمتمم"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble_segment_5> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble> ;
    dzdoc:position 5 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبمقتضى الأمر رقم 75- 58 المؤرخ في 20 رمضان عام 1395 الموافق 26 سبتمبر سنة 1975 والمتضمن القانون المدني، المعدل والمتمم"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble_segment_6> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble> ;
    dzdoc:position 6 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبمقتضى القانون رقم 90 - 02 المؤرخ في 10 رجب عام 1410 الموافق 6 فبراير سنة 1990 والمتعلق بالوقاية من النزاعات الجماعية في العمل وتسويتها وممارسة حق الإضراب، المعدل والمتمم"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble_segment_7> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble> ;
    dzdoc:position 7 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبمقتضى القانون رقم 90 – 03 المؤرخ في 10 رجب عام 1410 الموافق 6 فبراير سنة 1990 والمتعلق بمفتشية العمل، المعدل والمتمم،"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble_segment_8> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble> ;
    dzdoc:position 8 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبمقتضى القانون رقم 90 - 04 المؤرخ في 10 رجب عام 1410 الموافق 6 فبراير سنة 1990 والمتعلق بتسوية النزاعات الفردية فى العمل المعدل والمتمم"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble_segment_9> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#preamble> ;
    dzdoc:position 9 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبمقتضى القانون رقم 90 – 10 المؤرخ في 19 رمضان عام 1410 المواقق 14 أبريل سنة 1990 والمتعلق بالنقد والقرض، المعدل،"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_10_19960709_OpEnact_bc638becc8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_10> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_10> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_10> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تعدل المادة 91 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \"المادة . 91 تتم مشاركة العمال في الهيئة المستخدمة كما يأتي بواسطة مندوبي المستخدمين في مستوى كل مكان عمل متميز يحتوي على عشرين (20) عاملا على الأقل، بواسطة لجنة مشاركة تضم مندوبي المستخدمين، في مستوى مقر الهيئة المستخدمة المنتخبين طبقا ل المادة 93 أدناه"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_11_19960709_OpEnact_989e0a0f9b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_11> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_11> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_11> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تعدل وتتمم المادة 93 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 93 : ينتخب مندوبو المستخدمين، ضمن نفس الهيئة المستخدمة، المنتخبين طبقا لأحكام المادتين 91 و 92 من هذا القانون من بينهم لجنة مشاركة ويحدد عدد المندوبين فيها طبقا للشروط المنصوص عليها في المادة 99 أدناه \"."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_12_19960709_OpEnact_bf1153d773> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_12> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تتمم أحكام القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه ب المادة 93 مكرر ، تحرر كما يأتي : \" المادة 93 مكرر : يمارس مندوب المستخدمين المنتخب، طبقا ل المادتين 91 و 92 من هذا القانون، صلاحيات لجنة المشاركة المنصوص عليها في المادة 94 أدناه في الحالات التي تتوفر فيها الهيئة المستخدمة على مكان عمل متميز وحيد"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_13_19960709_OpEnact_0773137e10> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_13> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_13> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_13> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تتمم المادة 97 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي:"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_14_19960709_OpEnact_8c1efa50c5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_14> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تعدل وتتمم المادة 98 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 98 : يتم الاقتراع في دورين ، في الدور الأول تقدم المنظمات النقابية التمثيلية ضمن الهيئة المستخدمة مترشحين لانتخاب مندوبي المستخدمين من بين العمال الذين تتوفر فيهم معايير قابلية الانتخاب المحددة في المادة 97 أعلاه . إذا كان عدد المصوتين أقل من نصف عدد الناخبين يجري الدور الثاني من الاقتراع في مدة أقصاها ثلاثون (30) يوما . وفي هذه الحالة، يمكن كل العمال الذين تتوفر فيهم معايير قابلية الانتخاب المحددة في المادة 97 أعلاه أن يرشحوا أنفسهم وفي حالة عدم وجود منظمة أو منظمات نقابية تمثيلية، ضمن الهيئة المستخدمة، تنظم انتخابات مندوبي المستخدمين ضمن الشروط المحددة في الفقرة 3 السابقة، مع مراعاة النسبة الدنيا للمشاركة في الاقتراع كما هو في الفقرة 2 أعلاه . يجب زيادة على ذلك، أن يسمح نمط الاقتراع بالحصول على تمثيل عادل لمختلف الفئات الاجتماعية والمهنية في مكان العمل وفي الهيئة المستخدمة المعنية . يعتبر فائزا في الانتخابات المترشحون الذين يحصلون على أكبر عدد من الأصوات و عندما يحصل مترشحان أو عدة مترشحين على نفس عدد الأصوات ، تؤخذ الأقدمية ضمن الهيئة المستخدمة بعين الاعتبار من أجل الفصل بينهم . غير أنه في حالة ما إذا كان المترشحون الفائزون يتمتعون بنفس الأقدمية ضمن الهيئة المستخدمة يعتبر فائزا المترشح الأكبر سنا. تحدد كيفيات تطبيق هذه المادة، لا سيما المتعلقة منها بتنظيم الانتخابات عن طريق التنظيم، بعد استشارة المنظمات النقابية للعمال والمستخدمين الأكثر تمثيلا \"."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_15_19960709_OpEnact_e0ab9438b8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_15> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_15> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_15> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تعدل المادة 100 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 100 : يرفع كل احتجاج يتعلق بانتخابات مندوبي المستخدمين في أجل الثلاثين (30) يوما التالية للانتخابات أمام المحكمة المختصة إقليميا التي تبت بحكم ابتدائي ونهائي في أجل ثلاثين (30) يوما من إخطارها \"."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_17_19960709_OpEnact_469edc61e3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_17> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تعدل وتتمم المادة 114 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 114 : الاتفاقية الجماعية اتفاق مدون يتضمن مجموع شروط التشغيل والعمل فيما يخص فئة أو عدة فئات مهنية . الاتفاق الجماعي اتفاق مدون يعالج عنصرا معينا أو عدة عناصر محددة من مجموع شروط التشغيل والعمل بالنسبة لفئة أو عدة فئات اجتماعية ومهنية . ويمكن أن يشكل ملحقا للاتفاقية الجماعية. تبرم الاتفاقيات والاتفاقات الجماعية ضمن نفس الهيئة المستخدمة بين المستخدم و الممثلين النقابيين للعمال . كما تبرم بين مجموعة مستخدمين أو منظمة أو عدة منظمات نقابية تمثيلية للمستخدمين، من جهة، أو منظمة أو عدة منظمات نقابية تمثيلية للعمال، من جهة أخرى. تحدد تمثيلية الأطراف في التفاوض طبقا للشروط المنصوص عليها في القانون"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_18_19960709_OpEnact_2277e0c90d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_18> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_18> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_18> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "يدرج كل مرة بعد المصطلح \" اتفاقية جماعية \" مصطلح \" اتفاق جماعي \" في مستوى المواد 115 116 117 118 119 121 122 123 124 126 127 128 129 130 131 132 و 133 من هذا القانون."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_19_19960709_OpEnact_128213ddb8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_19> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_19> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_19> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تعدل المادة 134 من القانون رقم 90 – 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 134 : إذا لاحظ مفتش العمل أن اتفاقية جماعية أو اتفاقا جماعيا مخالف (ة) للتشريع والتنظيم المعمول بهما ، يعرضها ( يعرضه ) تلقائيا على الجهة القضائية المختصة"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_1_19960709_OpEnact_a6a0449532> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_1> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "يعدل هذ الأمر ويتمم أحكام القانون رقم 90-11 المؤرخ في 21 أبريل سنة 1990 والمتعلق ب علاقات العمل ."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_21_19960709_OpEnact_d7a58e5434> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_21> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_21> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_21> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تتمم أحكام القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بالمادة 146 مكرر ، تحرر كما يأتي : \" المادة 146 مكرر : يعاقب على كل مخالفة لأحكام هذا القانون المتعلقة باللجوء إلى عقد العمل ذي المدة المحدودة خارج الحالات والشروط المنصوص عليها صراحة في المادتين 12 و 12 مكرر من هذا القانون، بغرامة مالية من 1000 دج إلى 2000 دج مطبقة حسب عدد المخالفات \"."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_2_19960709_OpEnact_5787d90d15> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_2> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تتمم المادة 12 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بمقطع خامس، يحرر كما يأتي: \"المادة 12 : عندما يتعلق الأمر بنشاطات أو أشغال ذات مدة محدودة أو مؤقتة بحكم طبيعتها \"."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_3_19960709_OpEnact_90f2826547> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_3> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_3> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_3> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تتمم أحكام القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بالمادة 12 مكرر ، تحرر كما يأتي : \" المادة 12 مكرر : يتأكد مفتش العمل المختص إقليميا، بحكم الصلاحيات التي يخولها إياه التشريع والتنظيم المعمول بهما، من أن عقد العمل لمدة محدودة أبرم من أجل إحدى الحالات المنصوص عليها صراحة في المادة 12 من هذا القانون، وأن المدة المنصوص عليها في العقد موافقة للنشاط الذي وظف من أجله العامل \"."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_44_19960709_OpEnact_66c2af301c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_44> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_44> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_44> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تعادل الفترة التي تتعدى خمسة عشر (15) يوم عمل في الشهر الأول من تشغيل العامل شهر عمل لتحديد مدة العطلة السنوية المدفوعة الأجر"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_4_19960709_OpEnact_33bf2b0525> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_4> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_4> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_4> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تتمم المادة 13 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بفقرة 2، تحرر كما يأتي \"المادة 13 : تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم\"."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_5_19960709_OpEnact_646cb22620> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_5> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_5> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_5> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تتمم المادة 31 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بفقرتين تحرران كما يأتي \"المادة 31 : غير أنه يجوز مخالفة الحدود المنصوص عليها في الفقرة 2 من هذه المادة في الحالات المذكورة صراحة وضمن الشروط المحددة في الاتفاقيات والاتفاقات الجماعية، وهي : الوقاية من الحوادث الوشيكة الوقوع أو إصلاح الأضرار الناجمة عن الحوادث إنهاء الأشغال التي يمكن أن يتسبب توقفها، بحكم طبيعتها في أضرار . يستشار وجوبا في هذه الحالات ممثلو العمال ويعلم إلزاما مفتش العمل المختص إقليميا \"."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_6_19960709_OpEnact_03112e30f8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_6> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تعدل المادة 42 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 42 : يمنح العامل في ولايات الجنوب عطلة إضافية لا تقل عن عشرة (10) أيام عن سنة العمل الواحدة . تحدد الاتفاقيات أو الاتفاقات الجماعية كيفيات منح هذه العطلة"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_7_19960709_OpEnact_1d4139d1f1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_7> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_7> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_7> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "تعدل وتتمم المادة 44 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي :"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_8_19960709_OpEnact_3d8c830a38> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_8> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:versionText "يعدل ويتمم المقطع الثالث من الفقرة الأولى من المادة 54 من القانون رقم 90-11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، ويحرر كما يأتي : \"المادة 54 يستفيد العامل ثلاثة (3) أيام كاملة مدفوعة الأجر، بمناسبة حدث من الأحداث العائلية الآتية : زواج العامل وولادة مولود له، أو زواج أحد فروع العامل أو وفاة أحد الأصول أو الفروع أو الحواشي من الدرجة الأولى للعامل أو لزوجه، أو وفاة زوج العامل، أو ختان إبن العامل . غير أنه في حالتي الولادة أو الوفاة يكون التبرير لاحقا"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_97_19960709_OpEnact_4de9d1de09> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-07-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_97> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_97> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_97> ;
