        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_3_obligation_0_61a5416d_period_d5ef4545b9> ;
    dzdoc:hasReference <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_3_obligation_0_61a5416d_ref_b79579378438> ;
