<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_19> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعدل المادة 134 من القانون رقم 90 – 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 134 : إذا لاحظ مفتش العمل أن اتفاقية جماعية أو اتفاقا جماعيا مخالف (ة) للتشريع والتنظيم المعمول بهما ، يعرضها ( يعرضه ) تلقائيا على الجهة القضائية المختصة"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_19_19960709_OpEnact_128213ddb8> ;
    dzdoc:replacementText "تعدل المادة 134 من القانون رقم 90 – 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 134 : إذا لاحظ مفتش العمل أن اتفاقية جماعية أو اتفاقا جماعيا مخالف (ة) للتشريع والتنظيم المعمول بهما ، يعرضها ( يعرضه ) تلقائيا على الجهة القضائية المختصة"@ar ;
