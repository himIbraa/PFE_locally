<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_19_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_19> ;
    dzdoc:position 0 ;
    dzdoc:text "تعدل المادة 134 من القانون رقم 90 – 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي :"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_19_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_19> ;
    dzdoc:position 1 ;
    dzdoc:text "\" المادة 134 : إذا لاحظ مفتش العمل أن اتفاقية جماعية أو اتفاقا جماعيا مخالف (ة) للتشريع والتنظيم المعمول بهما، يعرضها ( يعرضه ) تلقائيا على الجهة القضائية المختصة"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_1_extref_7dfc639f> a dzdoc:ExternalReference ;
    rdfs:label "القانون رقم 90-11 المؤرخ في 21 أبريل سنة 1990"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1990-04-21/90-11"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1990-04-21/90-11"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1990-04-21/90-11" ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:resolutionReason "canonical_akn_path_alias" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1990-04-21/90-11"^^xsd:anyURI .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_1> ;
    dzdoc:position 0 ;
    dzdoc:text "يعدل هذ الأمر ويتمم أحكام القانون رقم 90-11 المؤرخ في 21 أبريل سنة 1990 والمتعلق بعلاقات العمل."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_21_extref_7dfc639f> a dzdoc:ExternalReference ;
    rdfs:label "القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1990-04-21/90-11"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1990-04-21/90-11"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1990-04-21/90-11" ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:resolutionReason "canonical_akn_path_alias" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1990-04-21/90-11"^^xsd:anyURI .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_21_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_21> ;
    dzdoc:position 0 ;
    dzdoc:text "تتمم أحكام القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بالمادة 146 مكرر، تحرر كما يأتي :"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_21_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_21> ;
    dzdoc:position 1 ;
    dzdoc:text "\" المادة 146 مكرر : يعاقب على كل مخالفة لأحكام هذا القانون المتعلقة باللجوء إلى عقد العمل ذي المدة المحدودة خارج الحالات والشروط المنصوص عليها صراحة في المادتين 12 و 12 مكرر من هذا القانون، بغرامة مالية من 1000 دج إلى 2000 دج مطبقة حسب عدد المخالفات \"."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_2_extref_55272d16> a dzdoc:ExternalReference ;
    rdfs:label "المادة 12 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1990-04-21/90-11#art_12"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1990-04-21/90-11#art_12"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1990-04-21/90-11#art_12" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1990-04-21/90-11"^^xsd:anyURI ;
    dzdoc:targetEId "art_12" .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_2_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_2> ;
    dzdoc:position 0 ;
    dzdoc:text "تتمم المادة 12 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بمقطع خامس، يحرر كما يأتي:"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_2_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_2> ;
    dzdoc:position 1 ;
    dzdoc:text "\"المادة 12 : عندما يتعلق الأمر بنشاطات أو أشغال ذات مدة محدودة أو مؤقتة بحكم طبيعتها \"."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_3_extref_7dfc639f> a dzdoc:ExternalReference ;
    rdfs:label "القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1990-04-21/90-11"^^xsd:anyURI ;
