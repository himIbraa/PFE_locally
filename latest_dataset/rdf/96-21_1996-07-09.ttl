    dzdoc:position 1 ;
    dzdoc:text "\"المادة 13 :"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_4_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_4> ;
    dzdoc:position 2 ;
    dzdoc:text "تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم\"."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_5_condition_0_1a26520f> a dznorm:Condition ;
