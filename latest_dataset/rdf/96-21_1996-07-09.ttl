<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_10_extref_d606cd77> a dzdoc:ExternalReference ;
    rdfs:label "المادة 91 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1990-04-21/90-11#art_91"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1990-04-21/90-11#art_91"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1990-04-21/90-11#art_91" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1990-04-21/90-11"^^xsd:anyURI ;
    dzdoc:targetEId "art_91" .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_10_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_10> ;
    dzdoc:position 0 ;
    dzdoc:text "تعدل المادة 91 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي :"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_10_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_10> ;
    dzdoc:position 1 ;
    dzdoc:text "\"المادة . 91 تتم مشاركة العمال في الهيئة المستخدمة كما يأتي بواسطة مندوبي المستخدمين في مستوى كل مكان عمل متميز يحتوي على عشرين (20) عاملا على الأقل، بواسطة لجنة مشاركة تضم مندوبي المستخدمين، في مستوى مقر الهيئة المستخدمة المنتخبين طبقا لالمادة 93 أدناه"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_11_extref_3c5958ec> a dzdoc:ExternalReference ;
    rdfs:label "المادة 93 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1990-04-21/90-11#art_93"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1990-04-21/90-11#art_93"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1990-04-21/90-11#art_93" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1990-04-21/90-11"^^xsd:anyURI ;
    dzdoc:targetEId "art_93" .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_11_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_11> ;
    dzdoc:position 0 ;
    dzdoc:text "تعدل وتتمم المادة 93 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي :"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_11_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_11> ;
    dzdoc:position 1 ;
    dzdoc:text "\" المادة 93 : ينتخب مندوبو المستخدمين، ضمن نفس الهيئة المستخدمة، المنتخبين طبقا لأحكام المادتين 91 و 92 من هذا القانون من بينهم لجنة مشاركة ويحدد عدد المندوبين فيها طبقا للشروط المنصوص عليها في المادة 99 أدناه \"."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12_condition_0_9e727da1> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12_condition_0_9e727da1_role_40fc471963> ;
    dznorm:conditionText "في الحالات التي تتوفر فيها الهيئة المستخدمة على مكان عمل متميز وحيد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12_condition_0_9e727da1_role_40fc471963> a dznorm:Role ;
    rdfs:label "مكان عمل متميز وحيد"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "في الحالات التي تتوفر فيها الهيئة المستخدمة على مكان عمل متميز وحيد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12_extref_7dfc639f> a dzdoc:ExternalReference ;
    rdfs:label "القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1990-04-21/90-11"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1990-04-21/90-11"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1990-04-21/90-11" ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:resolutionReason "canonical_akn_path_alias" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1990-04-21/90-11"^^xsd:anyURI .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12> ;
    dzdoc:position 0 ;
    dzdoc:text "تتمم أحكام القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بالمادة 93 مكرر ، تحرر كما يأتي :"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12> ;
    dzdoc:position 1 ;
    dzdoc:text "\" المادة 93 مكرر : يمارس مندوب المستخدمين المنتخب، طبقا لالمادتين 91 و 92 من هذا القانون، صلاحيات لجنة المشاركة المنصوص عليها في المادة 94 أدناه في الحالات التي تتوفر فيها الهيئة المستخدمة على مكان عمل متميز وحيد"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_13_extref_b12943cd> a dzdoc:ExternalReference ;
    rdfs:label "المادة 97 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1990-04-21/90-11#art_97"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1990-04-21/90-11#art_97"^^xsd:anyURI ;
