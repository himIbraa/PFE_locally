dzterm:collective_accord a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "اتفاق جماعي"@ar,
        "الاتفاق الجماعي اتفاق مدون يعالج عنصرا معينا أو عدة عناصر محددة من مجموع شروط التشغيل والعمل بالنسبة لفئة أو عدة فئات اجتماعية ومهنية"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17_defocc_ea8cad5bcf6f> .

dzterm:collective_agreement a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "اتفاقية جماعية"@ar,
        "الاتفاقية الجماعية اتفاق مدون يتضمن مجموع شروط التشغيل والعمل فيما يخص فئة أو عدة فئات مهنية"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_17_defocc_55d7ae82f9d7> .

