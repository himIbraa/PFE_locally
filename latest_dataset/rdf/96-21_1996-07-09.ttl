<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_13_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_13> ;
    dzdoc:position 0 ;
    dzdoc:text "تتمم المادة 97 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي:"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14_condition_0_159b5bff> a dznorm:Condition ;
    dznorm:conditionText "إذا كان عدد المصوتين أقل من نصف عدد الناخبين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14_condition_1_b773d014> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14_condition_1_b773d014_role_47688f89d1> ;
    dznorm:conditionText "عندما يحصل مترشحان أو عدة مترشحين على نفس عدد الأصوات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14_condition_1_b773d014_role_47688f89d1> a dznorm:Role ;
    rdfs:label "نفس عدد الأصوات"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "عندما يحصل مترشحان أو عدة مترشحين على نفس عدد الأصوات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14_condition_2_f68ff9c1> a dznorm:Condition ;
    dznorm:conditionText "غير أنه في حالة ما إذا كان المترشحون الفائزون يتمتعون بنفس الأقدمية ضمن الهيئة المستخدمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_14> ;
    dznorm:position 2 .

