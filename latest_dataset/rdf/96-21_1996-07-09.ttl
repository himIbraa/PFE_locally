<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6> ;
    dzdoc:position 0 ;
    dzdoc:text "تعدل المادة 42 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي :"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6> ;
    dzdoc:position 1 ;
    dzdoc:text "\" المادة 42 : يمنح العامل في ولايات الجنوب عطلة إضافية لا تقل عن عشرة (10) أيام عن سنة العمل الواحدة."@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6> ;
    dzdoc:position 2 ;
    dzdoc:text "تحدد الاتفاقيات أو الاتفاقات الجماعية كيفيات منح هذه العطلة"@ar .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6_right_0_5fafa278> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
