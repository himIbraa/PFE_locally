<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "تعادل الفترة التي تتعدى خمسة عشر (15) يوم عمل في الشهر الأول من تشغيل العامل شهر عمل لتحديد مدة العطلة السنوية المدفوعة الأجر"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_44_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_44_19960709_OpEnact_66c2af301c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "المادة 44" ;
    dzdoc:position 7 ;
    dzdoc:usesTerm dzterm:paid_leave .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_13" ;
    dzdoc:fullText "تتمم المادة 97 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي:"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_13> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_13_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_13_19960709_OpEnact_0773137e10> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "13" ;
    dzdoc:position 12 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_13_extref_b12943cd> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "يعدل هذ الأمر ويتمم أحكام القانون رقم 90-11 المؤرخ في 21 أبريل سنة 1990 والمتعلق ب علاقات العمل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_1_19960709_OpEnact_a6a0449532> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "المادة الأولى" ;
    dzdoc:position 0 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_1_extref_7dfc639f> ;
    dzdoc:usesTerm dzterm:labor_relations .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_2" ;
    dzdoc:fullText "تتمم المادة 12 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بمقطع خامس، يحرر كما يأتي: \"المادة 12 : عندما يتعلق الأمر بنشاطات أو أشغال ذات مدة محدودة أو مؤقتة بحكم طبيعتها \"."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_2_para_0>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_2_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_2_19960709_OpEnact_5787d90d15> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "المادة 2" ;
    dzdoc:position 1 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_2_extref_55272d16> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "تعدل وتتمم المادة 44 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي :"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_7_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_7_19960709_OpEnact_1d4139d1f1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "المادة 7" ;
    dzdoc:position 6 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_7_extref_c92028f7> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "تعدل المادة 91 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \"المادة . 91 تتم مشاركة العمال في الهيئة المستخدمة كما يأتي بواسطة مندوبي المستخدمين في مستوى كل مكان عمل متميز يحتوي على عشرين (20) عاملا على الأقل، بواسطة لجنة مشاركة تضم مندوبي المستخدمين، في مستوى مقر الهيئة المستخدمة المنتخبين طبقا ل المادة 93 أدناه"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_10_para_0>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_10_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_10_19960709_OpEnact_bc638becc8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "10" ;
    dzdoc:position 9 ;
    dzdoc:references <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_93> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_10_extref_d606cd77> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_93> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_11" ;
    dzdoc:fullText "تعدل وتتمم المادة 93 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 93 : ينتخب مندوبو المستخدمين، ضمن نفس الهيئة المستخدمة، المنتخبين طبقا لأحكام المادتين 91 و 92 من هذا القانون من بينهم لجنة مشاركة ويحدد عدد المندوبين فيها طبقا للشروط المنصوص عليها في المادة 99 أدناه \"."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_11> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_11_para_0>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_11_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_11_19960709_OpEnact_989e0a0f9b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "11" ;
    dzdoc:position 10 ;
    dzdoc:references <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_91>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_92>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_99> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_11_extref_3c5958ec> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_91>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_92>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_99> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "تتمم المادة 13 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بفقرة 2، تحرر كما يأتي \"المادة 13 : تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم\"."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_4_para_0>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_4_para_1>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_4_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_4_19960709_OpEnact_33bf2b0525> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "المادة 4" ;
    dzdoc:position 3 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_4_extref_22b1840b> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "تتمم أحكام القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بالمادة 146 مكرر ، تحرر كما يأتي : \" المادة 146 مكرر : يعاقب على كل مخالفة لأحكام هذا القانون المتعلقة باللجوء إلى عقد العمل ذي المدة المحدودة خارج الحالات والشروط المنصوص عليها صراحة في المادتين 12 و 12 مكرر من هذا القانون، بغرامة مالية من 1000 دج إلى 2000 دج مطبقة حسب عدد المخالفات \"."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_21_para_0>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_21_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_21_19960709_OpEnact_d7a58e5434> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "المادة 21" ;
    dzdoc:position 19 ;
    dzdoc:references <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12_bis>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_146_bis> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_21_extref_7dfc639f> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12_bis>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_146_bis> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "تعدل المادة 42 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 42 : يمنح العامل في ولايات الجنوب عطلة إضافية لا تقل عن عشرة (10) أيام عن سنة العمل الواحدة . تحدد الاتفاقيات أو الاتفاقات الجماعية كيفيات منح هذه العطلة"@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6_right_0_5fafa278> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6_para_0>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6_para_1>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_6_19960709_OpEnact_03112e30f8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "المادة 6" ;
    dzdoc:position 5 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_6_extref_46bb7c90> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "يعدل ويتمم المقطع الثالث من الفقرة الأولى من المادة 54 من القانون رقم 90-11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، ويحرر كما يأتي : \"المادة 54 يستفيد العامل ثلاثة (3) أيام كاملة مدفوعة الأجر، بمناسبة حدث من الأحداث العائلية الآتية : زواج العامل وولادة مولود له، أو زواج أحد فروع العامل أو وفاة أحد الأصول أو الفروع أو الحواشي من الدرجة الأولى للعامل أو لزوجه، أو وفاة زوج العامل، أو ختان إبن العامل . غير أنه في حالتي الولادة أو الوفاة يكون التبرير لاحقا"@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8_right_0_268cb99f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8_para_0>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8_para_1>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_8_19960709_OpEnact_3d8c830a38> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "8" ;
    dzdoc:position 8 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8_extref_3aa36bac> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_8_condition_0_0068707d> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "تعدل المادة 100 من القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 100 : يرفع كل احتجاج يتعلق بانتخابات مندوبي المستخدمين في أجل الثلاثين (30) يوما التالية للانتخابات أمام المحكمة المختصة إقليميا التي تبت بحكم ابتدائي ونهائي في أجل ثلاثين (30) يوما من إخطارها \"."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_15_right_0_1b782f4b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_15_para_0>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_15_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_15_19960709_OpEnact_e0ab9438b8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_15_obligation_0_da57e390> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "المادة 15" ;
    dzdoc:position 15 ;
    dzdoc:references <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_100> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_15_extref_29208b06> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_100> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_19" ;
    dzdoc:fullText "تعدل المادة 134 من القانون رقم 90 – 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 134 : إذا لاحظ مفتش العمل أن اتفاقية جماعية أو اتفاقا جماعيا مخالف (ة) للتشريع والتنظيم المعمول بهما ، يعرضها ( يعرضه ) تلقائيا على الجهة القضائية المختصة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_19_para_0>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_19_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_19_19960709_OpEnact_128213ddb8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_19_obligation_0_6aec9f55> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "المادة 19" ;
    dzdoc:position 18 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_19_extref_212f30cb> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_19_condition_0_c922d0ca> .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "تتمم أحكام القانون رقم 90 - 11 المؤرخ في 21 أبريل سنة 1990 والمذكور أعلاه بالمادة 12 مكرر ، تحرر كما يأتي : \" المادة 12 مكرر : يتأكد مفتش العمل المختص إقليميا، بحكم الصلاحيات التي يخولها إياه التشريع والتنظيم المعمول بهما، من أن عقد العمل لمدة محدودة أبرم من أجل إحدى الحالات المنصوص عليها صراحة في المادة 12 من هذا القانون، وأن المدة المنصوص عليها في العقد موافقة للنشاط الذي وظف من أجله العامل \"."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_3_para_0>,
        <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_3_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_3_19960709_OpEnact_90f2826547> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_3_obligation_0_61a5416d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "المادة 3" ;
    dzdoc:position 2 ;
    dzdoc:references <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_3_extref_7dfc639f> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_12> ;
    dzdoc:usesTerm dzterm:labor_inspector .

<https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_97> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#body> ;
    dzdoc:eId "art_97" ;
    dzdoc:fullText "المادة 97 : لا تشترط الأقدمية المنصوص عليها في الفقرة الثالثة أعلاه، إذا كانت الهيئة المستخدمة مؤسسة منذ أقل من سنة \"."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_97> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_97_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#version_art_97_19960709_OpEnact_4de9d1de09> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09> ;
    dzdoc:introducedOn "1996-07-09"^^xsd:date ;
    dzdoc:number "97" ;
    dzdoc:position 13 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1996-07-09/96-21_1996-07-09#art_97_condition_0_2d44bf11> .

