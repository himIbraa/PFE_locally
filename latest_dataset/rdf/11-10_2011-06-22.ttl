    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة الوفاة أو الاستقالة أو الإقصاء أو حصول مانع قانوني لمنتخب بالمجلس الشعبي البلدي ، يتم استخلافه في أجل لا يتجاوز شهرا واحدا ، بالمرشح الذي يلي مباشرة آخر منتخب من نفس القائمة بقرار من الوالي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
