<https://legal.dz/resource/law/2011-06-22/11-10#version_art_181> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يصوت المجلس الشعبي البلدي على ميزانية البلدية وتضبط وفقا للشروط المنصوص عليها في هذا القانون. يصوت على الميزانية الأولية قبل 31 أكتوبر من السنة المالية التي تسبق سنة تنفيذها. يصوت على الميزانية الإضافية قبل 15 يونيو من السنة المالية التي تنفذ فيها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_181_20110622_OpEnact_77c8db46c7> ;
    dzdoc:replacementText "يصوت المجلس الشعبي البلدي على ميزانية البلدية وتضبط وفقا للشروط المنصوص عليها في هذا القانون. يصوت على الميزانية الأولية قبل 31 أكتوبر من السنة المالية التي تسبق سنة تنفيذها. يصوت على الميزانية الإضافية قبل 15 يونيو من السنة المالية التي تنفذ فيها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_181> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
