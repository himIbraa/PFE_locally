<https://legal.dz/resource/law/2011-06-22/11-10#art_100_condition_0_923ef20e> a dznorm:Condition ;
    dznorm:conditionText "عندما لا تقوم السلطات البلدية بذلك ولا سيما منها التكفل بالعمليات الانتخابية والخدمة الوطنية والحالة المدنية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_100> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_100_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_100> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن الوالي أن يتخذ، بالنسبة لجميع بلديات الولاية أو بعضها كل الإجراءات المتعلقة بالحفاظ على الأمن والنظافة والسكينة العمومية وديمومة المرفق العام، عندما لا تقوم السلطات البلدية بذلك ولا سيما منها التكفل بالعمليات الانتخابية والخدمة الوطنية والحالة المدنية."@ar .

