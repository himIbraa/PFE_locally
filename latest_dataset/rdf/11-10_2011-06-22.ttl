<https://legal.dz/resource/law/2011-06-22/11-10#version_art_48> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة حل المجلس الشعبي البلدي ، يعين الوالي ، خلال العشرة (10) أيام التي تلي حل المجلس، متصرفا ومساعدين، عند الاقتضاء، توكل لهم مهمة تسيير شؤون البلدية. وتنتهي مهامهم بقوة القانون بمجرد تنصيب المجلس الجديد. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
