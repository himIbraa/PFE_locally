<https://legal.dz/resource/law/2011-06-22/11-10#version_art_191> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنشأ لجنة بلدية للمناقصة تتشكل كما يأتي : رئيس المجلس الشعبي البلدي ، رئيسا، منتخبان (2) يعينهما المجلس الشعبي البلدي ، عضوين، الأمين العام للبلدية، عضوا، ممثل مصالح أملاك الدولة. تتم المناقصة بناء على دفتر شروط تصادق علیه قانونا اللجنة البلدية للمناقصة وفقا للتشريع والتنظيم المعمول بهما. وتحدد مصالح أملاك الدولة السعر الافتتاحي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_191_20110622_OpEnact_8b5e67cc7f> ;
    dzdoc:replacementText "تنشأ لجنة بلدية للمناقصة تتشكل كما يأتي : رئيس المجلس الشعبي البلدي ، رئيسا، منتخبان (2) يعينهما المجلس الشعبي البلدي ، عضوين، الأمين العام للبلدية، عضوا، ممثل مصالح أملاك الدولة. تتم المناقصة بناء على دفتر شروط تصادق علیه قانونا اللجنة البلدية للمناقصة وفقا للتشريع والتنظيم المعمول بهما. وتحدد مصالح أملاك الدولة السعر الافتتاحي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_191> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
