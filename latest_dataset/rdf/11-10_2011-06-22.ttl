    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_80> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_80_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_80> ;
    dzdoc:position 0 ;
    dzdoc:text "يسهر رئيس المجلس الشعبي البلدي على تنفيذ مداولات المجلس الشعبي البلدي ويطلعه على ذلك."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_81_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_81> ;
    dzdoc:position 0 ;
    dzdoc:text "ينفذ رئيس المجلس الشعبي البلدي ميزانية البلدية وهو الأمر بالصرف."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_82_obligation_0_e752aa25> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2011-06-22/11-10#art_82_obligation_0_e752aa25_action_927d4e0b52> ;
