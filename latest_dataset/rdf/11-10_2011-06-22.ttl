<https://legal.dz/resource/law/2011-06-22/11-10#version_art_11> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تشكل البلدية الإطار المؤسساتي لممارسة الديمقراطية على المستوى المحلي والتسيير الجواري. يتخذ المجلس الشعبي البلدي كل التدابير لإعلام المواطنين بشؤونهم واستشارتهم حول خيارات وأولويات التهيئة والتنمية الاقتصادية والاجتماعية والثقافية حسب الشروط المحددة في هذا القانون . ويمكن في هذا المجال استعمال، على وجه الخصوص الوسائط والوسائل الإعلامية المتاحة. كما يمكن المجلس الشعبي البلدي تقديم عرض عن نشاطه السنوي أمام المواطنين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_11_20110622_OpEnact_e59a87430b> ;
    dzdoc:replacementText "تشكل البلدية الإطار المؤسساتي لممارسة الديمقراطية على المستوى المحلي والتسيير الجواري. يتخذ المجلس الشعبي البلدي كل التدابير لإعلام المواطنين بشؤونهم واستشارتهم حول خيارات وأولويات التهيئة والتنمية الاقتصادية والاجتماعية والثقافية حسب الشروط المحددة في هذا القانون . ويمكن في هذا المجال استعمال، على وجه الخصوص الوسائط والوسائل الإعلامية المتاحة. كما يمكن المجلس الشعبي البلدي تقديم عرض عن نشاطه السنوي أمام المواطنين."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_11> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
