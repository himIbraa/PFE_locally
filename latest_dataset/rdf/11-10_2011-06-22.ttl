        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد بموجب مرسوم عدد المندوبيات البلدية المنصوص عليها في المادة 134 أعلاه وحدودها بالنسبة لكل بلدية كبرى اعتمادا ، بصفة خاصة، على الطابع الجغرافي والحضري لإقليمها ومقتضيات المرفق العام. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
