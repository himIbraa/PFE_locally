    dzdoc:sourceTextSpan "يجب أن يعوض كل تخفيض في الإيرادات الجبائية البلدية ينجم عن إجراء تتخذه الدولة ويتضمن إعفاء جبائيا أو تخفيضا في نسب الضريبة أو إلغائها ، بناتج جبائي يساوي على الأقل مبلغ الفارق عند التحصيل."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_5> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_5_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_5> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب أن يعوض كل تخفيض في الإيرادات الجبائية البلدية ينجم عن إجراء تتخذه الدولة ويتضمن إعفاء جبائيا أو تخفيضا في نسب الضريبة أو إلغائها ، بناتج جبائي يساوي على الأقل مبلغ الفارق عند التحصيل."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_60_condition_0_1f3d8a03> a dznorm:Condition ;
    dznorm:conditionText "في حالة ما يكون رئيس المجلس الشعبي البلدي في وضعية تعارض مصالح متعلقة به"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_60> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_60_obligation_0_b7d753e0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2011-06-22/11-10#art_60_obligation_0_b7d753e0_action_6ddce5d6b7> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_60> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يمكن رئيس المجلس الشعبي البلدي أو أي عضو من المجلس في وضعية تعارض مصالحه مع مصالح البلدية، بأسمائهم الشخصية أو أزواجهم أو أصولهم أو فروعهم إلى الدرجة الرابعة أو كوكلاء، حضور المداولة التي تعالج هذا الموضوع"@ar ;
    dznorm:sourceArticle "art_60" .

<https://legal.dz/resource/law/2011-06-22/11-10#art_60_obligation_0_b7d753e0_action_6ddce5d6b7> a dznorm:Action ;
