<https://legal.dz/resource/law/2011-06-22/11-10#version_art_179> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحتوي ميزانية البلدية على قسمين : قسم التسيير، قسم التجهيز والاستثمار. وينقسم كل قسم إلى إيرادات ونفقات متوازنة وجوبا . يقتطع من إيرادات التسيير مبلغ يخصص لتغطية نفقات التجهيز والاستثمار. تحدد شروط وكيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
