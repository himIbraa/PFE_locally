<https://legal.dz/resource/law/2011-06-22/11-10#version_art_147> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة وقوع كارثة طبيعية لا تتحمل البلدية أية مسؤولية تجاه الدولة والمواطنين إذا أثبتت أنها اتخذت الاحتياطات التي تقع على عاتقها والمنصوص عليها بموجب التشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_147_20110622_OpEnact_faab1b75d5> ;
    dzdoc:replacementText "في حالة وقوع كارثة طبيعية لا تتحمل البلدية أية مسؤولية تجاه الدولة والمواطنين إذا أثبتت أنها اتخذت الاحتياطات التي تقع على عاتقها والمنصوص عليها بموجب التشريع والتنظيم المعمول بهما ."@ar ;
