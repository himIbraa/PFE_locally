<https://legal.dz/resource/law/2011-06-22/11-10#art_174> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_dup_3> ;
    dzdoc:eId "art_174" ;
    dzdoc:fullText "يمكن البلدية اللجوء إلى القرض لإنجاز مشاريع منتجة للمداخيل . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_174_permission_0_36c2904a> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2011-06-22/11-10#art_174_right_0_094fcb5f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_174> ;
