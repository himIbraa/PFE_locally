    dzdoc:text "توفر البلدية في مجال السكن الشروط التحفيزية للترقية العقارية، كما تبادر أو تساهم في ترقية برامج السكن."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_119_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_119> ;
    dzdoc:position 1 ;
    dzdoc:text "تشجع وتنظم بصفة خاصة كل جمعية سكان تهدف إلى حماية وصيانة وترميم المباني أو الأحياء."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_11_condition_0_8591033a> a dznorm:Condition ;
    dznorm:conditionText "حسب الشروط المحددة في هذا القانون"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_11> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_11_obligation_0_b75c80d9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_11> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتخذ المجلس الشعبي البلدي كل التدابير لإعلام المواطنين بشؤونهم واستشارتهم حول خيارات وأولويات التهيئة والتنمية الاقتصادية والاجتماعية والثقافية"@ar ;
    dznorm:sourceArticle "art_11" .

<https://legal.dz/resource/law/2011-06-22/11-10#art_11_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_11> ;
    dzdoc:position 1 ;
    dzdoc:text "يتخذ المجلس الشعبي البلدي كل التدابير لإعلام المواطنين بشؤونهم واستشارتهم حول خيارات وأولويات التهيئة والتنمية الاقتصادية والاجتماعية والثقافية حسب الشروط المحددة في هذا القانون."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_11_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_11> ;
