    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "عندما يخطر الوالي، قصد المصادقة، بالحالات المنصوص عليها في المادة 57 أعلاه، ولم يعلن قراره خلال مدة ثلاثين (30) يوما ابتداء من تاريخ إيداع المداولة بالولاية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_58> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_58_condition_0_ded5ae30_ref_9b95db4107ae> a dzdoc:Reference ;
    rdfs:label "المادة 57"@ar ;
    dzdoc:frbrUri "#art_57"^^xsd:anyURI ;
