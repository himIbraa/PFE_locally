<https://legal.dz/resource/law/2011-06-22/11-10#version_art_142> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في إطار احترام التشريع والتنظيم المعمول بهما ، يلزم رئيس المجلس الشعبي البلدي باتخاذ كافة الإجراءات اللازمة بالنسبة للوثائق التي تكتسي أهمية خاصة ، لا سيما سجلات الحالة المدنية والمخططات وسجلات مسح الأراضي، والوثائق المالية والمحاسبة التي تبين أن ظروف المحافظة عليها تعرضها للاتلاف. في حالة تقصير البلدية ، يقرر الوالي الإيداع التلقائي لهذه الوثائق في أرشيف الولاية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_142_20110622_OpEnact_052b1d901b> ;
    dzdoc:replacementText "في إطار احترام التشريع والتنظيم المعمول بهما ، يلزم رئيس المجلس الشعبي البلدي باتخاذ كافة الإجراءات اللازمة بالنسبة للوثائق التي تكتسي أهمية خاصة ، لا سيما سجلات الحالة المدنية والمخططات وسجلات مسح الأراضي، والوثائق المالية والمحاسبة التي تبين أن ظروف المحافظة عليها تعرضها للاتلاف. في حالة تقصير البلدية ، يقرر الوالي الإيداع التلقائي لهذه الوثائق في أرشيف الولاية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_142> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_142> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2011-06-22"^^xsd:date ;
