<https://legal.dz/resource/law/2011-06-22/11-10#art_104> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_dup_1> ;
    dzdoc:eId "art_104" ;
    dzdoc:fullText "يمارس المجلس الشعبي البلدي صلاحياته طبقا للمبادئ المحددة في المادتين 3 و 4 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_104> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_104_para_0> ;
