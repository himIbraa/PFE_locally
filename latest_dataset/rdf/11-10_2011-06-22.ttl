<https://legal.dz/resource/law/2011-06-22/11-10#version_art_24> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن عضو المجلس الشعبي البلدي الذي حصل له مانع لحضور جلسة أو دورة أن يوكل كتابيا عضوا آخر من المجلس من اختياره، ليصوت نيابة عنه . لا يمكن نفس العضو أن يكون حاملا لأكثر من وكالة واحدة . لا تصح الوكالة إلا لجلسة أو لدورة واحدة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
