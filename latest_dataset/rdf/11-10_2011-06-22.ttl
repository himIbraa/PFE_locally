dzterm:المجلس_الشعبي_البلدي a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المجلس الشعبي البلدي"@ar,
        "يشكل المجلس الشعبي البلدي إطارا للتعبير عن الديمقراطية، ويمثل قاعدة اللامركزية ومكان مشاركة المواطن في تسيير الشؤون العمومية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2011-06-22/11-10#art_103_defocc_7ed33b835a91> .

