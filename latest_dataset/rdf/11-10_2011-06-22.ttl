<https://legal.dz/resource/law/2011-06-22/11-10#version_art_141> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مع احترام التشريع والتنظيم المعمول بهما ، يمكن أن تودع الوثائق المذكورة في المادة 140 أعلاه المحفوظة بأرشيف البلديات التي يزيد عدد سكانها عن 20.000 نسمة بأرشيف الولاية بقرار من الوالي ، بعد مداولة المجلس الشعبي البلدي . وتودع هذه الوثائق إجباريا في مركز أرشيف الولاية إذا تبين بأنه من غير الممكن ضمان حفظها بصفة ملائمة من طرف البلدية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_141_20110622_OpEnact_e0817eeded> ;
    dzdoc:replacementText "مع احترام التشريع والتنظيم المعمول بهما ، يمكن أن تودع الوثائق المذكورة في المادة 140 أعلاه المحفوظة بأرشيف البلديات التي يزيد عدد سكانها عن 20.000 نسمة بأرشيف الولاية بقرار من الوالي ، بعد مداولة المجلس الشعبي البلدي . وتودع هذه الوثائق إجباريا في مركز أرشيف الولاية إذا تبين بأنه من غير الممكن ضمان حفظها بصفة ملائمة من طرف البلدية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_141> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
