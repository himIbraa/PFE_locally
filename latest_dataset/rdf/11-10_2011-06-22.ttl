<https://legal.dz/resource/law/2011-06-22/11-10#version_art_70> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعرض رئيس المجلس الشعبي البلدي قائمة المنتخبين الذين اختارهم لشغل وظائف نواب الرئيس، خلال الخمسة عشر (15) يوما على الأكثر التي تلي تنصيبه للمصادقة عليها بالأغلبية المطلقة للمجلس الشعبي البلدي في حدود ما تنص عليه المادة 69 أعلاه. يتم استخلاف نائب الرئيس المتوفى أو المستقيل أو المقصى أو الممنوع قانونا حسب نفس الأشكال. يمكن رئيس المجلس الشعبي البلدي تفويض إمضائه لصالح نواب الرئيس في حدود المهام الموكلة لهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_70_20110622_OpEnact_9651766e96> ;
    dzdoc:replacementText "يعرض رئيس المجلس الشعبي البلدي قائمة المنتخبين الذين اختارهم لشغل وظائف نواب الرئيس، خلال الخمسة عشر (15) يوما على الأكثر التي تلي تنصيبه للمصادقة عليها بالأغلبية المطلقة للمجلس الشعبي البلدي في حدود ما تنص عليه المادة 69 أعلاه. يتم استخلاف نائب الرئيس المتوفى أو المستقيل أو المقصى أو الممنوع قانونا حسب نفس الأشكال. يمكن رئيس المجلس الشعبي البلدي تفويض إمضائه لصالح نواب الرئيس في حدود المهام الموكلة لهم ."@ar ;
