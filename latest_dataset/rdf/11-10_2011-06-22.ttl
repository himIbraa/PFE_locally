<https://legal.dz/resource/law/2011-06-22/11-10#version_art_22> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يلصق مشروع جدول أعمال الاجتماعات عند مدخل قاعة المداولات وفي الأماكن المخصصة لإعلام الجمهور، بمجرد استدعاء أعضاء المجلس الشعبي البلدي . يوافق المجلس الشعبي البلدي على النقاط المسجلة في جدول أعمال الاجتماع و يمكنه إدراج نقاط إضافية ."@ar ;
