<https://legal.dz/resource/law/2011-06-22/11-10#art_145_condition_0_b126a934> a dznorm:Condition ;
    dznorm:conditionText "لا يأخذ بعين الاعتبار آراء المصالح التقنية المؤهلة قانونا ويحدث ضررا في حق المواطن والبلدية و/أو الدولة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_145> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_145_para_0> a dzdoc:Paragraph ;
