dzterm:abandonment_of_post a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يعتبر في حالة تخل عن المنصب، الغياب غير المبرر لرئيس المجلس الشعبي البلدي لأكثر من شهر"@ar,
        "يعد متخليا عن المنصب رئيس المجلس الشعبي البلدي المستقيل الذي لم يجمع المجلس طبقا لالمادة 73 أعلاه لتقديم استقالته أمامه، كما هو محدد في هذا القانون"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2011-06-22/11-10#art_74_defocc_0426c3ec3b22>,
