    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_82> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_82_obligation_0_e752aa25_role_1e8942aebc> a dznorm:Role ;
    rdfs:label "وجه الخصوص"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "ويجب عليه، على وجه الخصوص، القيام بما يأتي:"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_82> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_82_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_82> ;
    dzdoc:position 0 ;
    dzdoc:text "يقوم رئيس المجلس الشعبي البلدي وتحت رقابة المجلس الشعبي البلدي باسم البلدية، بجميع التصرفات الخاصة بالمحافظة على الأملاك والحقوق المكونة للممتلكات البلدية وإدارتها."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_82_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_82> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجب عليه، على وجه الخصوص، القيام بما يأتي: التقاضي باسم البلدية ولحسابها، إدارة مداخيل البلدية والأمر بصرف النفقات ومتابعة تطور المالية البلدية، إبرام عقود اقتناء الأملاك والمعاملات والصفقات والإيجارات وقبول الهبات والوصايا، القيام بمناقصات أشغال البلدية ومراقبة حسن تنفيذها، اتخاذ كل القرارات الموقفة للتقادم والإسقاط، ممارسة كل الحقوق على الأملاك العقارية والمنقولة التي تملكها البلدية بما في ذلك حق الشفعة، اتخاذ التدابير المتعلقة بشبكة الطرق البلدية، السهر على المحافظة على الأرشيف، اتخاذ المبادرات لتطوير مداخيل البلدية."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_83_obligation_0_99e0ea47> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
