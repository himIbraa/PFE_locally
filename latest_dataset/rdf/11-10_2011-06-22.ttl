<https://legal.dz/resource/law/2011-06-22/11-10#version_art_46> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم الحل والتجديد الكلي للمجلس الشعبي البلدي : في حالة خرق أحكام دستورية، في حالة إلغاء انتخاب جميع أعضاء المجلس، في حالة استقالة جماعية لأعضاء المجلس، عندما يكون الإبقاء على المجلس مصدر اختلالات خطيرة تم إثباتها في التسيير البلدي أو من طبيعته المساس بمصالح المواطنين وطمأنينتهم، عندما يصبح عدد المنتخبين أقل من الأغلبية المطلقة بالرغم من تطبيق أحكام المادة 41 أعلاه، في حالة خلافات خطيرة بين أعضاء المجلس الشعبي البلدي تعيق السير العادي لهيئات البلدية، وبعد إعذار يوجهه الوالي للمجلس دون الاستجابة ل"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_46_20110622_OpEnact_ea79ba1393> ;
    dzdoc:replacementText "يتم الحل والتجديد الكلي للمجلس الشعبي البلدي : في حالة خرق أحكام دستورية، في حالة إلغاء انتخاب جميع أعضاء المجلس، في حالة استقالة جماعية لأعضاء المجلس، عندما يكون الإبقاء على المجلس مصدر اختلالات خطيرة تم إثباتها في التسيير البلدي أو من طبيعته المساس بمصالح المواطنين وطمأنينتهم، عندما يصبح عدد المنتخبين أقل من الأغلبية المطلقة بالرغم من تطبيق أحكام المادة 41 أعلاه، في حالة خلافات خطيرة بين أعضاء المجلس الشعبي البلدي تعيق السير العادي لهيئات البلدية، وبعد إعذار يوجهه الوالي للمجلس دون الاستجابة له، في حالة اندماج بلديات أو ضمها أو تجزئتها، في حالة حدوث ظروف استثنائية تحول دون تنصيب المجلس المنتخب."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_46> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_46> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2011-06-22"^^xsd:date ;
