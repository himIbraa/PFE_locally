<https://legal.dz/resource/law/2011-06-22/11-10#version_art_67> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينصب الرئيس المنتخب في مهامه بمقر البلدية في حفل رسمي بحضور منتخبي المجلس الشعبي البلدي أثناء جلسة علنية يرأسها الوالي أو ممثله خلال الخمسة عشر (15) يوما على الأكثر التي تلي إعلان نتائج الانتخابات. عند حدوث حالة استثنائية تعيق تنصيب رئيس المجلس الشعبي البلدي بمقر البلدية تطبق أحكام المادة 19 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_67_20110622_OpEnact_773df3eff9> ;
    dzdoc:replacementText "ينصب الرئيس المنتخب في مهامه بمقر البلدية في حفل رسمي بحضور منتخبي المجلس الشعبي البلدي أثناء جلسة علنية يرأسها الوالي أو ممثله خلال الخمسة عشر (15) يوما على الأكثر التي تلي إعلان نتائج الانتخابات. عند حدوث حالة استثنائية تعيق تنصيب رئيس المجلس الشعبي البلدي بمقر البلدية تطبق أحكام المادة 19 من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
