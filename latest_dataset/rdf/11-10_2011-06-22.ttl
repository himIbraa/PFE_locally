<https://legal.dz/resource/law/2011-06-22/11-10#version_art_33> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن المجلس الشعبي البلدي أن يشكل من بين أعضائه لجنة خاصة لدراسة موضوع محدد يدخل في مجال اختصاصه كما هو مبين في هذا القانون. تتشكل اللجنة خاصة بناء على اقتراح من رئيس المجلس الشعبي البلدي عن طريق مداولة المجلس مصادق عليها بأغلبية أعضائه. تقدم اللجنة نتائج أعمالها لرئيس المجلس الشعبي البلدي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_33_20110622_OpEnact_0744a519f9> ;
