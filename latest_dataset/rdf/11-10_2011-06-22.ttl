<https://legal.dz/resource/law/2011-06-22/11-10#version_art_176> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ميزانية البلدية هي جدول تقديرات الإيرادات والنفقات السنوية للبلدية. وهي عقد ترخيص وإدارة يسمح بسير المصالح البلدية وتنفيذ برنامجها للتجهيز والاستثمار. يحدد شكل ميزانية البلدية ومضمونها عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_176_20110622_OpEnact_bdb64e67ab> ;
    dzdoc:replacementText "ميزانية البلدية هي جدول تقديرات الإيرادات والنفقات السنوية للبلدية. وهي عقد ترخيص وإدارة يسمح بسير المصالح البلدية وتنفيذ برنامجها للتجهيز والاستثمار. يحدد شكل ميزانية البلدية ومضمونها عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_176> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
