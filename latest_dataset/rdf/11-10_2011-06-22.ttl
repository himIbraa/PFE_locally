<https://legal.dz/resource/law/2011-06-22/11-10#art_164> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_3_sec_5> ;
    dzdoc:eId "art_164" ;
    dzdoc:fullText "لا يمكن القيام بأي نفقة متعلقة بملك بلدي إلا إذا تم تطهير وضعيته وتسجيله في سجل جرد الأملاك البلدية . تحدد عن طريق التنظيم كيفيات التسيير والاستغلال الذي يسمح ف النفقات على الأملاك التي توجد في طور الإدماج ضمن الأملاك البلدية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_164_permission_0_02a892c4>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_164_permission_1_1a4f21cf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_164> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_164_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_164_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_164_20110622_OpEnact_ab4c1be6d5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 164" ;
    dzdoc:position 163 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_164_condition_0_1955e0eb> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_184> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1_dup_1> ;
    dzdoc:eId "art_184" ;
    dzdoc:fullText "عندما يترتب على تنفيذ ميزانية البلدية عجز ، فإنه يجب على المجلس الشعبي البلدي اتخاذ جميع اللازمة لامتصاصه وضمان توازن الميزانية الإضافية . إذا لم يتخذ المجلس الشعبي البلدي الإجراءات التصحيحية الضرورية ، فإنه يتم اتخاذها من الوالي الذي يمكنه أن يأذن بامتصاص العجز على سنتين ماليتين أو أكثر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_184> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_184_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_184_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_184_20110622_OpEnact_2e8ff3b82c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_184_obligation_0_bfdc858b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 184" ;
    dzdoc:position 183 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_184_condition_0_e98720a7>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_184_condition_1_3d89f6ae> ;
    dzdoc:usesTerm dzterm:council,
        dzterm:wali .

<https://legal.dz/resource/law/2011-06-22/11-10#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "يجب على البلدية أن تتأكد من توفر الموارد المالية الضرورية للتكفل بالأعباء والمهام المخولة لها قانونا في كل میدان. يرافق كل مهمة جديدة يعهد بها إلى البلدية أو تحول لها من قبل الدولة التوفير المتلازم للموارد المالية الضرورية للتكفل بهذه المهمة بصفة دائمة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_4_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_4_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_4_20110622_OpEnact_6a751406e4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_4_obligation_0_a4d1363f>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_4_obligation_1_1ed3413a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "4" ;
    dzdoc:position 3 ;
    dzdoc:usesTerm dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_99> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2> ;
    dzdoc:eId "art_99" ;
    dzdoc:fullText "تصبح القرارات البلدية المتعلقة بالتنظيمات العامة قابلة للتنفيذ بعد شهر (1) من تاريخ إرسالها إلى الوالي . وفي حالة الاستعجال ، يمكن رئيس المجلس الشعبي البلدي أن ينفذ فورا القرار أو القرارات البلدية المتعلقة بها بعد إعلام الوالي بذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_99_permission_0_829ea36e> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2011-06-22/11-10#art_99_right_0_0177f6a0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_99> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_99_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_99_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_99_20110622_OpEnact_18c15c79ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "99" ;
    dzdoc:position 98 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_99_condition_0_8bdb8333>,
