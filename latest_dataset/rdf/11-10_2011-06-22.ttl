<https://legal.dz/resource/law/2011-06-22/11-10#version_art_4> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على البلدية أن تتأكد من توفر الموارد المالية الضرورية للتكفل بالأعباء والمهام المخولة لها قانونا في كل میدان. يرافق كل مهمة جديدة يعهد بها إلى البلدية أو تحول لها من قبل الدولة التوفير المتلازم للموارد المالية الضرورية للتكفل بهذه المهمة بصفة دائمة."@ar ;
