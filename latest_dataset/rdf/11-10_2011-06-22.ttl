<https://legal.dz/resource/law/2011-06-22/11-10#version_art_87> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في إطار أحكام المادة 86 أعلاه، يمكن رئيس المجلس الشعبي البلدي وتحت مسؤوليته، تفويض إمضائه للمندوبين البلديين والمندوبين الخاصين وإلى كل موظف بلدي قصد: استقبال التصريحات بالولادة والزواج والوفيات، تدوين كل العقود والأحكام في سجلات الحالة المدنية، إعداد وتسليم كل العقود المتعلقة بالتصريحات المذكورة أعلاه، التصديق على كل توقيع يقوم به أي مواطن أمامهم بموجب تقديم وثيقة هوية، التصديق بالمطابقة على كل نسخة وثيقة بتقديم النسخة الأصلية منها. يرسل القرار المتضمن التفويض بالإمضاء إلى الوالي وإلى النائب ال"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_87_20110622_OpEnact_98c7e381a7> ;
    dzdoc:replacementText "في إطار أحكام المادة 86 أعلاه، يمكن رئيس المجلس الشعبي البلدي وتحت مسؤوليته، تفويض إمضائه للمندوبين البلديين والمندوبين الخاصين وإلى كل موظف بلدي قصد: استقبال التصريحات بالولادة والزواج والوفيات، تدوين كل العقود والأحكام في سجلات الحالة المدنية، إعداد وتسليم كل العقود المتعلقة بالتصريحات المذكورة أعلاه، التصديق على كل توقيع يقوم به أي مواطن أمامهم بموجب تقديم وثيقة هوية، التصديق بالمطابقة على كل نسخة وثيقة بتقديم النسخة الأصلية منها. يرسل القرار المتضمن التفويض بالإمضاء إلى الوالي وإلى النائب العام المختص إقليميا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_87> ;
