<https://legal.dz/resource/law/2011-06-22/11-10#version_art_37> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مع مراعاة أحكام المادة 76 من هذا القانون ، تكون العهدة الانتخابية مجانية. يستفيد المنتخبون من علاوات وتعويضة ملائمة بمناسبة انعقاد دورات المجلس . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_37_20110622_OpEnact_56d1d2e6f0> ;
    dzdoc:replacementText "مع مراعاة أحكام المادة 76 من هذا القانون ، تكون العهدة الانتخابية مجانية. يستفيد المنتخبون من علاوات وتعويضة ملائمة بمناسبة انعقاد دورات المجلس . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_37> ;
