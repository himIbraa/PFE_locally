<https://legal.dz/resource/law/2011-06-22/11-10#version_art_45> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتبر مستقيلا تلقائيا من المجلس الشعبي البلدي ، كل عضو منتخب تغيب بدون عذر مقبول لأكثر من ثلاث (3) دورات عادية خلال نفس السنة. في حالة تخلف المنتخب عن حضور جلسة السماع رغم صحة التبليغ يعتبر قرار المجلس حضوريا. يعلن الغياب من طرف المجلس الشعبي البلدي بعد سماع المنتخب المعني، ويخطر الوالي بذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_45_20110622_OpEnact_452d1b8a72> ;
    dzdoc:replacementText "يعتبر مستقيلا تلقائيا من المجلس الشعبي البلدي ، كل عضو منتخب تغيب بدون عذر مقبول لأكثر من ثلاث (3) دورات عادية خلال نفس السنة. في حالة تخلف المنتخب عن حضور جلسة السماع رغم صحة التبليغ يعتبر قرار المجلس حضوريا. يعلن الغياب من طرف المجلس الشعبي البلدي بعد سماع المنتخب المعني، ويخطر الوالي بذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_45> ;
