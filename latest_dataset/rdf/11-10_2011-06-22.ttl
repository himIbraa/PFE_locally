    dzdoc:position 1 ;
    dzdoc:text "يثبت الوالي هذا الإقصاء بموجب قرار."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_45_condition_0_44ebaa1a> a dznorm:Condition ;
