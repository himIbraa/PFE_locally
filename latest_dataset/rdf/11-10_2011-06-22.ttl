<https://legal.dz/resource/law/2011-06-22/11-10#version_art_26> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "جلسات المجلس الشعبي البلدي علنية. وتكون مفتوحة لمواطني البلدية ولكل مواطن معني بموضوع المداولة. غير أن المجلس الشعبي البلدي يداول في جلسة مغلقة من أجل: دراسة الحالات التأديبية للمنتخبين، دراسة المسائل المرتبطة بالحفاظ على النظام العام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
