    dznorm:position 0 ;
    dznorm:provisionText "يسهر المجلس الشعبي البلدي على وضع إطار ملائم للمبادرات المحلية التي تهدف إلى تحفيز المواطنين وحثهم على المشاركة في تسوية مشاكلهم وتحسين ظروف معيشتهم"@ar ;
    dznorm:sourceArticle "art_12" .

<https://legal.dz/resource/law/2011-06-22/11-10#art_12_obligation_0_143d94cd_role_b510999ead> a dznorm:Role ;
    rdfs:label "وضع إطار ملائم للمبادرات"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يسهر المجلس الشعبي البلدي على وضع إطار ملائم للمبادرات المحلية التي تهدف إلى تحفيز المواطنين وحثهم على المشاركة في تسوية مشاكلهم وتحسين ظروف معيشتهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_12> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_12_obligation_0_143d94cd_role_d9fd0022a9> a dznorm:Role ;
    rdfs:label "المشاركة في تسوية مشاكلهم"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يسهر المجلس الشعبي البلدي على وضع إطار ملائم للمبادرات المحلية التي تهدف إلى تحفيز المواطنين وحثهم على المشاركة في تسوية مشاكلهم وتحسين ظروف معيشتهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_12> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_12_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_12> ;
    dzdoc:position 0 ;
    dzdoc:text "قصد تحقيق أهداف الديمقراطية المحلية في إطار التسيير الجواري المذكور في المادة 11 أعلاه، يسهر المجلس الشعبي البلدي على وضع إطار ملائم للمبادرات المحلية التي تهدف إلى تحفيز المواطنين وحثهم على المشاركة في تسوية مشاكلهم وتحسين ظروف معيشتهم."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_12_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_12> ;
    dzdoc:position 1 ;
    dzdoc:text "يتم تنظيم هذا الإطار طبقا للتشريع والتنظيم المعمول بهما."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_130_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_130> ;
    dzdoc:position 0 ;
    dzdoc:text "يزود مستخدمو المصالح والمؤسسات البلدية غير الخاضعين للقانون الأساسي العام للوظيفة العمومية، بقانون أساسي خاص."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_131_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_131> ;
    dzdoc:position 0 ;
    dzdoc:text "يستفيد مستخدمو المصالح والمؤسسات البلدية من التكوين وتحسين المستوى طبقا للتشريع والتنظيم المعمول بهما. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_131_right_0_59aae93d> a dznorm:Right ;
