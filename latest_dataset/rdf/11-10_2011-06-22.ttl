    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يعد المجلس الشعبي البلدي برامجه السنوية والمتعددة السنوات الموافقة لمدة عهدته ويصادق عليها ويسهر على تنفيذها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_107> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_107_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_107> ;
    dzdoc:position 0 ;
    dzdoc:text "يعد المجلس الشعبي البلدي برامجه السنوية والمتعددة السنوات الموافقة لمدة عهدته ويصادق عليها ويسهر على تنفيذها، تماشيا مع الصلاحيات المخولة له قانونا، وفي إطار المخطط الوطني للتهيئة والتنمية المستدامة للإقليم وكذا المخططات التوجيهية القطاعية."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_107_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_107> ;
    dzdoc:position 1 ;
    dzdoc:text "يكون اختيار العمليات التي تنجز في إطار المخطط البلدي للتنمية من صلاحيات المجلس الشعبي البلدي."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_108_obligation_0_ae543774> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_108> ;
    dznorm:position 0 ;
    dznorm:provisionText "يشارك المجلس الشعبي البلدي في إجراءات إعداد عمليات تهيئة الإقليم والتنمية المستدامة وتنفيذها"@ar ;
    dznorm:sourceArticle "art_108" .

<https://legal.dz/resource/law/2011-06-22/11-10#art_108_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_108> ;
    dzdoc:position 0 ;
    dzdoc:text "يشارك المجلس الشعبي البلدي في إجراءات إعداد عمليات تهيئة الإقليم والتنمية المستدامة وتنفيذها طبقا للتشريع والتنظيم المعمول بهما."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_109_condition_0_f62ca205> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/2011-06-22/11-10#art_109_condition_0_f62ca205_role_d3842b1b29> ;
    dznorm:conditionText "تخضع إقامة أي مشروع استثمار و/أو تجهيز على إقليم البلدية أو أي مشروع يندرج في إطار البرامج القطاعية للتنمية، إلى الرأي المسبق للمجلس الشعبي البلدي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_109> ;
    dznorm:position 0 .

