<https://legal.dz/resource/law/2011-06-22/11-10#version_art_69> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يساعد رئيس المجلس الشعبي البلدي نائبان (2) أو عدة نواب الرئيس يكون عددهم كما يأتي : نائبان (2) بالنسبة للبلديات ذات المجلس الشعبي البلدي المتكون من سبعة (7) إلى تسعة (9) مقاعد، ثلاثة (3) نواب بالنسبة للبلديات ذات المجلس الشعبي البلدي المتكون من أحد عشر (11) مقعدا، أربعة (4) نواب بالنسبة للبلديات ذات المجلس الشعبي البلدي المتكون من خمسة عشر (15) مقعدا، خمسة (5) نواب بالنسبة للبلديات ذات المجلس الشعبي البلدي المتكون من ثلاثة وعشرين (23) مقعدا، ستة (6) نواب بالنسبة للبلديات ذات المجلس الشعبي البلدي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_69_20110622_OpEnact_0b0be3036c> ;
    dzdoc:replacementText "يساعد رئيس المجلس الشعبي البلدي نائبان (2) أو عدة نواب الرئيس يكون عددهم كما يأتي : نائبان (2) بالنسبة للبلديات ذات المجلس الشعبي البلدي المتكون من سبعة (7) إلى تسعة (9) مقاعد، ثلاثة (3) نواب بالنسبة للبلديات ذات المجلس الشعبي البلدي المتكون من أحد عشر (11) مقعدا، أربعة (4) نواب بالنسبة للبلديات ذات المجلس الشعبي البلدي المتكون من خمسة عشر (15) مقعدا، خمسة (5) نواب بالنسبة للبلديات ذات المجلس الشعبي البلدي المتكون من ثلاثة وعشرين (23) مقعدا، ستة (6) نواب بالنسبة للبلديات ذات المجلس الشعبي البلدي المتكون من ثلاثة وثلاثين (33) مقعدا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
