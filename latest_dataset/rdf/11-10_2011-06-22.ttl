<https://legal.dz/resource/law/2011-06-22/11-10#version_art_109> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تخضع إقامة أي مشروع استثمار و/أو تجهيز على إقليم البلدية أو أي مشروع يندرج في إطار البرامج القطاعية للتنمية، إلى الرأي المسبق للمجلس الشعبي البلدي ولا سيما في مجال حماية الأراضي الفلاحية والتأثير في البيئة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_109_20110622_OpEnact_cd051b5d01> ;
    dzdoc:replacementText "تخضع إقامة أي مشروع استثمار و/أو تجهيز على إقليم البلدية أو أي مشروع يندرج في إطار البرامج القطاعية للتنمية، إلى الرأي المسبق للمجلس الشعبي البلدي ولا سيما في مجال حماية الأراضي الفلاحية والتأثير في البيئة."@ar ;
