<https://legal.dz/resource/law/2011-06-22/11-10#version_art_21> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ترسل الاستدعاءات لدورات المجلس الشعبي البلدي من رئيسه، وتدون بسجل مداولات البلدية . تسلم الاستدعاءات، مرفقة بمشروع جدول الأعمال بواسطة ظرف محمول إلى أعضاء المجلس الشعبي البلدي بمقر سكناهم قبل عشرة (10) أيام كاملة على الأقل من تاريخ افتتاح الدورة مقابل وصل استلام . يمكن تخفيض هذا الأجل في حالة الاستعجال، على ألا يقل عن يوم واحد كامل . وفي هذه الحالة، يتخذ رئيس المجلس الشعبي البلدي التدابير اللازمة لتسليم الاستدعاءات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_21_20110622_OpEnact_ccf4615145> ;
    dzdoc:replacementText "ترسل الاستدعاءات لدورات المجلس الشعبي البلدي من رئيسه، وتدون بسجل مداولات البلدية . تسلم الاستدعاءات، مرفقة بمشروع جدول الأعمال بواسطة ظرف محمول إلى أعضاء المجلس الشعبي البلدي بمقر سكناهم قبل عشرة (10) أيام كاملة على الأقل من تاريخ افتتاح الدورة مقابل وصل استلام . يمكن تخفيض هذا الأجل في حالة الاستعجال، على ألا يقل عن يوم واحد كامل . وفي هذه الحالة، يتخذ رئيس المجلس الشعبي البلدي التدابير اللازمة لتسليم الاستدعاءات ."@ar ;
