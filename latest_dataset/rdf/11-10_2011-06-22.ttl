<https://legal.dz/resource/law/2011-06-22/11-10#art_103_defocc_7ed33b835a91> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 125 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:المجلس_الشعبي_البلدي ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_103> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_103_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يشكل المجلس الشعبي البلدي إطارا للتعبير عن الديمقراطية، ويمثل قاعدة اللامركزية ومكان مشاركة المواطن في تسيير الشؤون العمومية."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_103_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_103> ;
