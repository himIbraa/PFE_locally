dzterm:municipal_council a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المجلس الشعبي البلدي"@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_106> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_dup_1> ;
    dzdoc:eId "art_106" ;
    dzdoc:fullText "تخضع توأمة بلدية ما مع بلدية أو أي جماعة إقليمية أجنبية أخرى إلى الموافقة المسبقة للوزير المكلف بالداخلية بعد أخذ رأي وزير الشؤون الخارجية . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_106> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_106_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_106_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_106_20110622_OpEnact_a8bb07727d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 106" ;
    dzdoc:position 105 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_106_condition_0_9c2d35e6> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1> ;
    dzdoc:eId "art_109" ;
    dzdoc:fullText "تخضع إقامة أي مشروع استثمار و/أو تجهيز على إقليم البلدية أو أي مشروع يندرج في إطار البرامج القطاعية للتنمية، إلى الرأي المسبق للمجلس الشعبي البلدي ولا سيما في مجال حماية الأراضي الفلاحية والتأثير في البيئة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_109> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_109_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_109_20110622_OpEnact_cd051b5d01> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 109" ;
    dzdoc:position 108 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_109_condition_0_f62ca205> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "يسهر المجلس الشعبي البلدي على حماية الأراضي الفلاحية والمساحات الخضراء ولا سيما عند إقامة مختلف المشاريع على إقليم البلدية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_110_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_110_20110622_OpEnact_46f2955355> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_110_obligation_0_217a8038> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 110" ;
    dzdoc:position 109 ;
    dzdoc:usesTerm dzterm:council .

<https://legal.dz/resource/law/2011-06-22/11-10#art_112> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1> ;
    dzdoc:eId "art_112" ;
    dzdoc:fullText "تساهم البلدية في حماية التربة والموارد المائية وتسهر على الاستغلال الأفضل لهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_112> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_112_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_112_20110622_OpEnact_30d935a8c9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_112_obligation_0_66e7ff81> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 112" ;
    dzdoc:position 111 ;
    dzdoc:usesTerm dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_113> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_2> ;
    dzdoc:eId "art_113" ;
    dzdoc:fullText "تتزود البلدية بكل أدوات التعمير المنصوص عليها في التشريع والتنظيم المعمول بهما بعد المصادقة عليها بموجب مداولة المجلس الشعبي البلدي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_113> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_113_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_113_20110622_OpEnact_5ac63af9da> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_113_obligation_0_32e398a4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "113" ;
    dzdoc:position 112 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_113_condition_0_a4a826ea> ;
    dzdoc:usesTerm dzterm:municipal_council,
        dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_2> ;
    dzdoc:eId "art_114" ;
    dzdoc:fullText "يقتضي إنشاء أي مشروع يحتمل الإضرار بـ البيئة و الصحة العمومية على إقليم البلدية موافقة المجلس الشعبي البلدي ، باستثناء المشاريع ذات المنفعة الوطنية التي تخضع للأحكام المتعلقة بحماية البيئة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_114> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_114_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_114_20110622_OpEnact_dc13790d09> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_114_obligation_0_cf5e355b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "114" ;
    dzdoc:position 113 ;
    dzdoc:usesTerm dzterm:environment,
        dzterm:municipal_council,
        dzterm:municipality,
        dzterm:public_health .

<https://legal.dz/resource/law/2011-06-22/11-10#art_115> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_2> ;
    dzdoc:eId "art_115" ;
    dzdoc:fullText "ضمن الشروط المحددة في التشريع والتنظيم المعمول بهما وبمساهمة المصالح التقنية للدولة ، تتولى البلدية : التأكد من احترام تخصيصات الأراضي وقواعد استعمالها، السهر على المراقبة الدائمة لمطابقة عمليات البناء، ذات العلاقة ببرامج التجهيز والسكن، السهر على احترام الأحكام في مجال مكافحة السكنات الهشة غير القانونية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_115> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_115_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_115_20110622_OpEnact_e2b637be1a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_115_obligation_0_26efa7e7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "115" ;
    dzdoc:position 114 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_115_condition_0_d5cc059b> ;
    dzdoc:usesTerm dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_123> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_4> ;
    dzdoc:eId "art_123" ;
    dzdoc:fullText "تسهر البلدية بمساهمة المصالح التقنية للدولة على احترام التشريع والتنظيم المعمول بهما المتعلقين بحفظ الصحة والنظافة العمومية ولاسيما في مجالات : توزيع المياه الصالحة للشرب، صرف المياه المستعملة ومعالجتها، جمع النفايات الصلبة ونقلها ومعالجتها، مكافحة نواقل الأمراض المتنقلة، الحفاظ على صحة الأغذية والأماكن والمؤسسات المستقبلة للجمهور، صيانة طرقات البلدية، إشارات المرور التابعة لشبكة طرقاتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_123> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_123_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_123_20110622_OpEnact_3f1ce0a5e2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_123_obligation_0_4e3615ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 123" ;
    dzdoc:position 122 ;
    dzdoc:usesTerm dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_156> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_3_sec_4> ;
    dzdoc:eId "art_156" ;
    dzdoc:fullText "يمكن البلدية أن تفوض تسيير المصالح العمومية المنصوص عليها في المادة 149 أعلاه عن طريق عقد برنامج أو صفقة طلبية طبقا للأحكام التشريعية والتنظيمية المعمول بها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_156_permission_0_4f0961d4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_156> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_156_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_156_20110622_OpEnact_73b0b16538> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 156" ;
    dzdoc:position 155 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_149> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_149> ;
    dzdoc:usesTerm dzterm:municipality,
        dzterm:order_contract,
        dzterm:program_contract,
        dzterm:public_services .

<https://legal.dz/resource/law/2011-06-22/11-10#art_158> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_3_sec_5> ;
    dzdoc:eId "art_158" ;
    dzdoc:fullText "تتشكل الأملاك العمومية للبلدية من الأملاك العمومية الطبيعية والأملاك العمومية الاصطناعية طبقا لأحكام القانون المنظم للأملاك الوطنية. إن الأملاك البلدية التابعة للأملاك العمومية للبلدية غير قابلة للتنازل ولا التقادم ولا الحجز ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_158> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_158_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_158_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_158_20110622_OpEnact_05d441bc74> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 158" ;
    dzdoc:position 157 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_158_condition_0_d2c30d5f> ;
    dzdoc:usesTerm dzterm:public_domain .

<https://legal.dz/resource/law/2011-06-22/11-10#art_162> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_3_sec_5> ;
    dzdoc:eId "art_162" ;
    dzdoc:fullText "يسهر المجلس الشعبي البلدي تحت مسؤولية رئيس المجلس على مسك وتحيين سجل الأملاك العقارية وسجل جرد الأملاك المنقولة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_162> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_162_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_162_20110622_OpEnact_8b7afcc625> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_162_obligation_0_4f06c129> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 162" ;
    dzdoc:position 161 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_163> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_3_sec_5> ;
    dzdoc:eId "art_163" ;
    dzdoc:fullText "يتعين على المجلس الشعبي البلدي القيام بصفة دورية باتخاذ التدابير اللازمة من أجل تثمين الأملاك البلدية المنتجة للمداخيل وجعلها أكثر مردودية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_163> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_163_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_163_20110622_OpEnact_5a843b2a67> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_163_obligation_0_2fea357e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 163" ;
    dzdoc:position 162 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_181> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1_dup_1> ;
    dzdoc:eId "art_181" ;
    dzdoc:fullText "يصوت المجلس الشعبي البلدي على ميزانية البلدية وتضبط وفقا للشروط المنصوص عليها في هذا القانون. يصوت على الميزانية الأولية قبل 31 أكتوبر من السنة المالية التي تسبق سنة تنفيذها. يصوت على الميزانية الإضافية قبل 15 يونيو من السنة المالية التي تنفذ فيها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_181> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_181_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_181_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_181_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_181_20110622_OpEnact_77c8db46c7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 181" ;
    dzdoc:position 180 ;
    dzdoc:usesTerm dzterm:additional_budget,
        dzterm:initial_budget,
        dzterm:municipal_budget,
        dzterm:municipal_council .

<https://legal.dz/resource/law/2011-06-22/11-10#art_191> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1_dup_1> ;
    dzdoc:eId "art_191" ;
    dzdoc:fullText "تنشأ لجنة بلدية للمناقصة تتشكل كما يأتي : رئيس المجلس الشعبي البلدي ، رئيسا، منتخبان (2) يعينهما المجلس الشعبي البلدي ، عضوين، الأمين العام للبلدية، عضوا، ممثل مصالح أملاك الدولة. تتم المناقصة بناء على دفتر شروط تصادق علیه قانونا اللجنة البلدية للمناقصة وفقا للتشريع والتنظيم المعمول بهما. وتحدد مصالح أملاك الدولة السعر الافتتاحي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_191> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_191_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_191_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_191_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_191_20110622_OpEnact_8b5e67cc7f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 191" ;
    dzdoc:position 190 ;
    dzdoc:usesTerm dzterm:council,
        dzterm:mayor .

<https://legal.dz/resource/law/2011-06-22/11-10#art_192> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1_dup_1> ;
    dzdoc:eId "art_192" ;
    dzdoc:fullText "عندما يقوم رئيس المجلس الشعبي البلدي بإجراء مناقصة عمومية لحساب البلدية ، يساعده أعضاء اللجنة البلدية للمناقصة . كل مناقصة يحرر بشأنها محضر يتضمن جميع الملاحظات، ويوقعه جميع أعضاء اللجنة البلدية للمناقصة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_192> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_192_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_192_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_192_20110622_OpEnact_bb375585bb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "192" ;
    dzdoc:position 191 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_192_condition_0_4c63fb44> ;
    dzdoc:usesTerm dzterm:mayor,
        dzterm:municipality,
        dzterm:tender_committee .

<https://legal.dz/resource/law/2011-06-22/11-10#art_193> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1_dup_1> ;
    dzdoc:eId "art_193" ;
    dzdoc:fullText "عندما تقوم السلطة المكلفة بتسيير مؤسسة عمومية بلدية بإجراء مناقصة عمومية ، يساعدها أعضاء اللجنة البلدية للمناقصة . يحرر مدير المؤسسة محضر المناقصة الذي يتضمن مجموع الملاحظات، ويوقعه جميع أعضاء اللجنة البلدية للمناقصة وكذا مدير المؤسسة المعنية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_193> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_193_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_193_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_193_20110622_OpEnact_ff48045b81> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "193" ;
    dzdoc:position 192 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_193_condition_0_86e3b011> ;
    dzdoc:usesTerm dzterm:tender_committee .

<https://legal.dz/resource/law/2011-06-22/11-10#art_194> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1_dup_1> ;
    dzdoc:eId "art_194" ;
    dzdoc:fullText "يصادق على محضر المناقصة والصفقة العمومية عن طريق مداولة المجلس الشعبي البلدي . يرسل محضر المناقصة والصفقة العمومية إلى الوالي مرفقان بالمداولة المتعلقة بهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_194> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_194_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_194_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_194_20110622_OpEnact_06435d5fb7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_194_obligation_0_dc3af8e3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "194" ;
    dzdoc:position 193 ;
    dzdoc:usesTerm dzterm:municipal_council,
        dzterm:wali .

<https://legal.dz/resource/law/2011-06-22/11-10#art_202> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_2_dup_1> ;
    dzdoc:eId "art_202" ;
    dzdoc:fullText "تقدم حسابات السنة المالية السابقة من رئيس المجلس الشعبي البلدي قبل التداول على الميزانية الإضافية للسنة الجارية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_202> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_202_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_202_20110622_OpEnact_80777774e1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_202_obligation_0_3d1ef4df> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "202" ;
    dzdoc:position 201 ;
    dzdoc:usesTerm dzterm:mayor .

<https://legal.dz/resource/law/2011-06-22/11-10#art_206> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_2_dup_1> ;
    dzdoc:eId "art_206" ;
    dzdoc:fullText "يتولى أمين خزينة البلدية تحصيل الإيرادات وتصفية نفقات البلدية ، و هو مكلف وحده وتحت مسؤوليته بمتابعة تحصيل مداخيل البلدية وكل المبالغ العائدة لها وصرف النفقات المأمور بدفعها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_206> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_206_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_206_20110622_OpEnact_c8f476c853> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_206_obligation_0_9566b338>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_206_obligation_1_5b72313a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "206" ;
    dzdoc:position 205 ;
    dzdoc:usesTerm dzterm:municipal_treasurer .

<https://legal.dz/resource/law/2011-06-22/11-10#art_35> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_35" ;
    dzdoc:fullText "يجب أن تضمن تشكيلة اللجان المنصوص عليها في المادتين 32 و 33 أعلاه تمثيلا نسبيا يعكس التركيبة السياسية للمجلس الشعبي البلدي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_35> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_35_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_35_20110622_OpEnact_3ab9777da3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_35_obligation_0_665ee8db> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "35" ;
    dzdoc:position 34 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_32>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_33> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_32>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_33> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "تنتخب كل لجنة رئيسا من بين أعضائها. تجتمع اللجان بناء على استدعاء من رئيسها بعد إعلام رئيس المجلس الشعبي البلدي . ويمكنها اللجوء إلى الاستشارة طبقا لأحكام المادة 13 أعلاه. توكل أمانة الجلسة إلى موظف من البلدية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_36_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_36_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_36_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_36_20110622_OpEnact_5dccfc70fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 36" ;
    dzdoc:position 35 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_13> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_13> ;
    dzdoc:usesTerm dzterm:mayor .

<https://legal.dz/resource/law/2011-06-22/11-10#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "تزول صفة المنتخب بالوفاة أو الاستقالة أو الإقصاء أو حصول مانع قانوني. ويقر المجلس الشعبي البلدي ذلك بموجب مداولة، و يخطر الوالي بذلك وجوبا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_40_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_40_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_40_20110622_OpEnact_71a984f792> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_40_obligation_0_5c088b4c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 40" ;
    dzdoc:position 39 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "يجب أن تجري وتحرر مداولات وأشغال المجلس الشعبي البلدي باللغة العربية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_53_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_53_20110622_OpEnact_f724673852> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_53_obligation_0_4682dc1e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "53" ;
    dzdoc:position 52 ;
    dzdoc:usesTerm dzterm:council .

<https://legal.dz/resource/law/2011-06-22/11-10#art_58> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_58" ;
    dzdoc:fullText "عندما يخطر الوالي، قصد المصادقة، بالحالات المنصوص عليها في المادة 57 أعلاه، ولم يعلن قراره خلال مدة ثلاثين (30) يوما ابتداء من تاريخ إيداع المداولة بالولاية ، تعتبر هذه الأخيرة مصادقا عليها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_58> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_58_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_58_20110622_OpEnact_f3dca2a160> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "58" ;
    dzdoc:position 57 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_57> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_57> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_58_condition_0_ded5ae30> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "يستدعي الوالي المنتخبين قصد تنصيب المجلس الشعبي البلدي خلال الخمسة عشر (15) يوما التي تلي إعلان نتائج الانتخابات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_64_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_64_20110622_OpEnact_b12f8b9715> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_64_obligation_0_ca18b369> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "64" ;
    dzdoc:position 63 ;
    dzdoc:usesTerm dzterm:wali .

<https://legal.dz/resource/law/2011-06-22/11-10#art_67> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2> ;
    dzdoc:eId "art_67" ;
    dzdoc:fullText "ينصب الرئيس المنتخب في مهامه بمقر البلدية في حفل رسمي بحضور منتخبي المجلس الشعبي البلدي أثناء جلسة علنية يرأسها الوالي أو ممثله خلال الخمسة عشر (15) يوما على الأكثر التي تلي إعلان نتائج الانتخابات. عند حدوث حالة استثنائية تعيق تنصيب رئيس المجلس الشعبي البلدي بمقر البلدية تطبق أحكام المادة 19 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_67> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_67_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_67_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_67_20110622_OpEnact_773df3eff9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "67" ;
    dzdoc:position 66 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_19> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_19> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_67_condition_0_a9fd2868> ;
    dzdoc:usesTerm dzterm:wali .

<https://legal.dz/resource/law/2011-06-22/11-10#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "يساعد رئيس المجلس الشعبي البلدي نائبان (2) أو عدة نواب الرئيس يكون عددهم كما يأتي : نائبان (2) بالنسبة للبلديات ذات المجلس الشعبي البلدي المتكون من سبعة (7) إلى تسعة (9) مقاعد، ثلاثة (3) نواب بالنسبة للبلديات ذات المجلس الشعبي البلدي المتكون من أحد عشر (11) مقعدا، أربعة (4) نواب بالنسبة للبلديات ذات المجلس الشعبي البلدي المتكون من خمسة عشر (15) مقعدا، خمسة (5) نواب بالنسبة للبلديات ذات المجلس الشعبي البلدي المتكون من ثلاثة وعشرين (23) مقعدا، ستة (6) نواب بالنسبة للبلديات ذات المجلس الشعبي البلدي المتكون من ثلاثة وثلاثين (33) مقعدا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_69_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_69_20110622_OpEnact_0b0be3036c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "69" ;
    dzdoc:position 68 ;
    dzdoc:usesTerm dzterm:mayor .

<https://legal.dz/resource/law/2011-06-22/11-10#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "يمثل رئيس المجلس الشعبي البلدي البلدية في جميع المراسم التشريفية والتظاهرات الرسمية. وينبغي عليه المشاركة فيها حسب التزاماته المحددة في هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_77_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_77_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_77_20110622_OpEnact_c90f774b65> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_77_obligation_0_0f2cb02a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "77" ;
    dzdoc:position 76 ;
    dzdoc:usesTerm dzterm:mayor .

<https://legal.dz/resource/law/2011-06-22/11-10#art_83> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2> ;
    dzdoc:eId "art_83" ;
    dzdoc:fullText "يسهر رئيس المجلس الشعبي البلدي على وضع المصالح والمؤسسات العمومية البلدية وحسن سيرها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_83> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_83_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_83_20110622_OpEnact_1a2a2deb52> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_83_obligation_0_99e0ea47> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "83" ;
    dzdoc:position 82 ;
    dzdoc:usesTerm dzterm:mayor .

<https://legal.dz/resource/law/2011-06-22/11-10#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "لـ رئيس المجلس الشعبي البلدي صفة ضابط الحالة المدنية . وبهذه الصفة، يقوم بجميع العقود المتعلقة بالحالة المدنية طبقا للتشريع الساري المفعول تحت رقابة النائب العام المختص إقليميا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_86_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_86_20110622_OpEnact_e318079afe> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "86" ;
    dzdoc:position 85 ;
    dzdoc:usesTerm dzterm:civil_registrar,
        dzterm:mayor .

<https://legal.dz/resource/law/2011-06-22/11-10#art_97> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2> ;
    dzdoc:eId "art_97" ;
    dzdoc:fullText "لا تصبح قرارات رئيس المجلس الشعبي البلدي قابلة للتنفيذ إلا بعد إعلام المعنيين بها عن طريق النشر إذا كان محتواها يتضمن أحكاما عامة أو بعد إشعار فردي بأي وسيلة قانونية في الحالات الأخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_97> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_97_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_97_20110622_OpEnact_76fab15a22> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 97" ;
    dzdoc:position 96 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_97_condition_0_71c90415>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_97_condition_1_4e874063> .

