<https://legal.dz/resource/law/2011-06-22/11-10#art_84_condition_0_e2b69460> a dznorm:Condition ;
    dznorm:conditionText "عندما تتعارض مصالح رئيس المجلس الشعبي البلدي مع مصالح البلدية باسمه الشخصي أو باسم زوجه أو أصوله أو فروعه إلى الدرجة الرابعة أو بصفته وكيلا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_84> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_84_obligation_0_22e6bfb0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2011-06-22/11-10#art_84_obligation_0_22e6bfb0_action_0c21db4033> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_84> ;
    dznorm:position 0 ;
    dznorm:provisionText "ولا يمكن رئيس المجلس الشعبي البلدي أن يتولى تنفيذ قرارات ناجمة عن المداولة ولا يحق له تمثيل البلدية في جميع القضايا المتنازع فيها ذات الصلة بموضوع المداولة."@ar ;
    dznorm:sourceArticle "art_84" .

<https://legal.dz/resource/law/2011-06-22/11-10#art_84_obligation_0_22e6bfb0_action_0c21db4033> a dznorm:Action ;
    rdfs:label "رئيس المجلس الشعبي البلدي أن"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "ولا يمكن رئيس المجلس الشعبي البلدي أن يتولى تنفيذ قرارات ناجمة عن المداولة ولا يحق له تمثيل البلدية في جميع القضايا المتنازع فيها ذات الصلة بموضوع المداولة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_84> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_84_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_84> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما تتعارض مصالح رئيس المجلس الشعبي البلدي مع مصالح البلدية باسمه الشخصي أو باسم زوجه أو أصوله أو فروعه إلى الدرجة الرابعة أو بصفته وكيلا، يعين المجلس الشعبي البلدي المجتمع تحت رئاسة منتخب آخر غير رئيس المجلس الشعبي البلدي، أحد أعضائه لتمثيل البلدية سواء أمام القضاء أو عند إبرام العقود."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_84_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_84> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا يمكن رئيس المجلس الشعبي البلدي أن يتولى تنفيذ قرارات ناجمة عن المداولة ولا يحق له تمثيل البلدية في جميع القضايا المتنازع فيها ذات الصلة بموضوع المداولة."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_84_permission_0_22e6bfb0> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2011-06-22/11-10#art_84_permission_0_22e6bfb0_action_48032d07dd> ;
