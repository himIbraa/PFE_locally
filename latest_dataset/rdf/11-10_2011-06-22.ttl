    dzdoc:position 1 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_3> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "يمكن الوالي أن يتخذ، بالنسبة لجميع بلديات الولاية أو بعضها كل الإجراءات المتعلقة بالحفاظ على الأمن و النظافة و السكينة العمومية و ديمومة المرفق العام ، عندما لا تقوم السلطات البلدية بذلك ولا سيما منها التكفل بالعمليات الانتخابية والخدمة الوطنية والحالة المدنية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_100_permission_0_2e0570cd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_100> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_100_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_100_20110622_OpEnact_53e140d6a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 100" ;
    dzdoc:position 99 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_100_condition_0_923ef20e> ;
    dzdoc:usesTerm dzterm:hygiene,
        dzterm:public_order,
        dzterm:public_service_continuity,
        dzterm:public_tranquility,
        dzterm:wali .

<https://legal.dz/resource/law/2011-06-22/11-10#art_107> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1> ;
    dzdoc:eId "art_107" ;
    dzdoc:fullText "يعد المجلس الشعبي البلدي برامجه السنوية والمتعددة السنوات الموافقة لمدة عهدته ويصادق عليها ويسهر على تنفيذها ، تماشيا مع الصلاحيات المخولة له قانونا، وفي إطار المخطط الوطني للتهيئة والتنمية المستدامة للإقليم وكذا المخططات التوجيهية القطاعية. يكون اختيار العمليات التي تنجز في إطار المخطط البلدي للتنمية من صلاحيات المجلس الشعبي البلدي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_107> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_107_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_107_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_107_20110622_OpEnact_24f2377b46> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_107_obligation_0_e1b3cd49> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 107" ;
    dzdoc:position 106 ;
    dzdoc:usesTerm dzterm:council .

<https://legal.dz/resource/law/2011-06-22/11-10#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_3> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "قصد تحقيق أهداف الديمقراطية المحلية في إطار التسيير الجواري المذكور في المادة 11 أعلاه، يسهر المجلس الشعبي البلدي على وضع إطار ملائم للمبادرات المحلية التي تهدف إلى تحفيز المواطنين وحثهم على المشاركة في تسوية مشاكلهم وتحسين ظروف معيشتهم . يتم تنظيم هذا الإطار طبقا للتشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_12_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_12_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_12_20110622_OpEnact_a9c8b18535> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_12_obligation_0_143d94cd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "12" ;
    dzdoc:position 11 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_11> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_11> ;
    dzdoc:usesTerm dzterm:apc .

<https://legal.dz/resource/law/2011-06-22/11-10#art_132> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1_dup_1> ;
    dzdoc:eId "art_132" ;
    dzdoc:fullText "يمكن البلدية أن تلجأ إلى خدمات خبراء ومستشارين عن طريق التعاقد من أجل إنجاز مهام ظرفية وفق الشروط المحددة في التشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_132_permission_0_771034a1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_132> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_132_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_132_20110622_OpEnact_09dfeba037> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 132" ;
    dzdoc:position 131 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_132_condition_0_9b8ecd9e> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_138> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2_dup_1> ;
    dzdoc:eId "art_138" ;
    dzdoc:fullText "عندما يكون من الصعب الاتصال بين المقر الرئيسي للبلدية وجزء منها لبعد المسافة أو للضرورة ، يحدث المجلس الشعبي البلدي بموجب مداولة ملحقة إدارية ويحدد مجال اختصاصها، ويعين لها مندوبا خاصا . يعين المندوب الخاص من بين أعضاء المجلس الشعبي البلدي ويراعى قدر الإمكان في تعيينه أن يكون من المقيمين في ذلك الجزء المعني من البلدية ويتصرف تحت مسؤولية رئيس المجلس الشعبي البلدي ، ويتلقى باسمه تفويضا بالإمضاء. يتولى المندوب الخاص وظائف ضابط الحالة المدنية في هذا الجزء من البلدية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_138> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_138_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_138_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_138_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_138_20110622_OpEnact_67e0918bcd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_138_obligation_0_2501e76d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "138" ;
    dzdoc:position 137 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_138_condition_0_99c8dbec> ;
    dzdoc:usesTerm dzterm:administrative_annex,
        dzterm:apc,
        dzterm:civil_status_officer,
        dzterm:mayor,
        dzterm:special_delegate .

<https://legal.dz/resource/law/2011-06-22/11-10#art_139> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_3_dup_1> ;
    dzdoc:eId "art_139" ;
    dzdoc:fullText "البلدية مسؤولة على حماية أرشيفها والاحتفاظ به . يضمن الأمين العام للبلدية تحت سلطة رئيس المجلس الشعبي البلدي تسيير أرشيف البلدية طبقا للتشريع والتنظيم المعمول بهما. تشكل أعباء حفظ أرشيف البلدية وتسييره وحمايته نفقات إجبارية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_139> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_139_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_139_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_139_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_139_20110622_OpEnact_133f72e608> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_139_obligation_0_4cc8feba> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 139" ;
    dzdoc:position 138 ;
    dzdoc:usesTerm dzterm:mayor,
        dzterm:municipality,
        dzterm:secretary_general .

<https://legal.dz/resource/law/2011-06-22/11-10#art_143> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_3_dup_1> ;
    dzdoc:eId "art_143" ;
    dzdoc:fullText "في إطار احترام التشريع والتنظيم المعمول بهما ، تبقى الوثائق المودعة تطبيقا لأحكام المواد 140 و 141 و 142 أعلاه بأرشيف الولاية ملكا للبلدية. يتم ضمان حفظ أرشيف البلدية وتصنيفه وتبليغه وفق نفس الشروط المطبقة على أرشيف الولاية. لا يمكن إتلاف محتوى أرشيف البلدية المودع بأرشيف الولاية بدون ترخيص من المجلس الشعبي البلدي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_143_permission_0_eb91ba96> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_143> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_143_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_143_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_143_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_143_20110622_OpEnact_98503d165c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 143" ;
    dzdoc:position 142 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_140>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_141>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_142> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_140>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_141>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_142> ;
    dzdoc:usesTerm dzterm:apc .

<https://legal.dz/resource/law/2011-06-22/11-10#art_152> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_3_sec_2> ;
    dzdoc:eId "art_152" ;
    dzdoc:fullText "يمكن البلدية أن تقرر منح ميزانية مستقلة لبعض المصالح العمومية المستغلة مباشرة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_152_permission_0_6f29f9de> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_152> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_152_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_152_20110622_OpEnact_45075a3755> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "152" ;
    dzdoc:position 151 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_152_condition_0_425b7ed6> ;
    dzdoc:usesTerm dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_154> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_3_sec_3> ;
    dzdoc:eId "art_154" ;
    dzdoc:fullText "تكون المؤسسات العمومية البلدية ذات طابع إداري أو ذات طابع صناعي وتجاري و يجب على المؤسسة العمومية البلدية ذات الطابع الصناعي والتجاري أن توازن بين إيراداتها ونفقاتها . تحدد قواعد تنظيم المؤسسات العمومية البلدية وسيرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_154> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_154_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_154_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_154_20110622_OpEnact_0e2fd04d73> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_154_obligation_0_bbfa392f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 154" ;
    dzdoc:position 153 ;
    dzdoc:usesTerm dzterm:public_institution .

<https://legal.dz/resource/law/2011-06-22/11-10#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "يجتمع المجلس الشعبي البلدي في دورة عادية كل شهرين (2) ولا تتعدى مدة كل دورة خمسة (5) أيام. يعد المجلس الشعبي البلدي نظامه الداخلي ويصادق عليه في أول دورة . يحدد النظام الداخلي النموذجي ومحتواه عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_16_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_16_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_16_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_16_20110622_OpEnact_bee9f3dd48> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_16_obligation_0_f0c7e6d9>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_16_obligation_1_726bc2a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "16" ;
    dzdoc:position 15 ;
    dzdoc:usesTerm dzterm:council .

<https://legal.dz/resource/law/2011-06-22/11-10#art_172> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_dup_3> ;
    dzdoc:eId "art_172" ;
    dzdoc:fullText "تتلقى البلدية إعانات ومخصصات تسيير بالنظر على وجه الخصوص، لما يأتي : عدم كفاية مداخيلها مقارنة بمهامها وصلاحياتها كما هي محددة في هذا القانون، عدم كفاية التغطية المالية للنفقات الإجبارية، التبعات المرتبطة بالتكفل بحالات القوة القاهرة ولا سيما منها الكوارث الطبيعية أو النكبات كما هي محددة في هذا القانون، أهداف المستوى المطلوب فيما يتعلق بتلبية الاحتياجات المخولة لها قانونا، نقص القيمة للإيرادات الجبائية للبلدية، في إطار تشجيع الاستثمار المنصوص عليه في قانون المالية. توجه الإعانات الممنوحة للبلدية من الدولة للغرض الذي منحت من أجله . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2011-06-22/11-10#art_172_right_0_08800146> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_172> ;
