<https://legal.dz/resource/law/2011-06-22/11-10#version_art_74> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد متخليا عن المنصب رئيس المجلس الشعبي البلدي المستقيل الذي لم يجمع المجلس طبقا ل المادة 73 أعلاه لتقديم استقالته أمامه، كما هو محدد في هذا القانون . يتم إثبات تخلي رئيس المجلس الشعبي البلدي عن المنصب في أجل عشرة (10) أيام بعد شهر من غيابه خلال دورة غير عادية للمجلس بحضور الوالي أو ممثله. ويستخلف في مهامه طبقا لأحكام المادة 65 أعلاه. تلصق المداولة المتضمنة إثبات تخلي رئيس المجلس الشعبي البلدي عن المنصب بمقر البلدية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_74_20110622_OpEnact_2dda4361cf> ;
    dzdoc:replacementText "يعد متخليا عن المنصب رئيس المجلس الشعبي البلدي المستقيل الذي لم يجمع المجلس طبقا ل المادة 73 أعلاه لتقديم استقالته أمامه، كما هو محدد في هذا القانون . يتم إثبات تخلي رئيس المجلس الشعبي البلدي عن المنصب في أجل عشرة (10) أيام بعد شهر من غيابه خلال دورة غير عادية للمجلس بحضور الوالي أو ممثله. ويستخلف في مهامه طبقا لأحكام المادة 65 أعلاه. تلصق المداولة المتضمنة إثبات تخلي رئيس المجلس الشعبي البلدي عن المنصب بمقر البلدية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_74> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
