<https://legal.dz/resource/law/2011-06-22/11-10#art_188_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_188> ;
    dzdoc:position 1 ;
    dzdoc:text "تتم المصادقة على الحساب الإداري وإعداد حساب التسيير وكذا التقريب الدوري للكتابات طبقا للتشريع والتنظيم المعمول بهما."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_189_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_189> ;
