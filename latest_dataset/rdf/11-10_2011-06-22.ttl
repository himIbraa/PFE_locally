<https://legal.dz/resource/law/2011-06-22/11-10#version_art_134> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتولى المندوبية البلدية ضمان مهام المرفق العام وتوفير الوسائل الضرورية للتكفل بها . وينشط المندوبية البلدية منتخب يدعى المندوب البلدي ويعين بموجب مداولة المجلس الشعبي البلدي بناء على اقتراح من رئيس المجلس . ويساعده متصرف يعينه رئيس المجلس الشعبي البلدي بناء على اقتراح من الأمين العام للبلدية ."@ar ;
