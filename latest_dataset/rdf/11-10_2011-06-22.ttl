<https://legal.dz/resource/law/2011-06-22/11-10#version_art_158> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتشكل الأملاك العمومية للبلدية من الأملاك العمومية الطبيعية والأملاك العمومية الاصطناعية طبقا لأحكام القانون المنظم للأملاك الوطنية. إن الأملاك البلدية التابعة للأملاك العمومية للبلدية غير قابلة للتنازل ولا التقادم ولا الحجز ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_158_20110622_OpEnact_05d441bc74> ;
    dzdoc:replacementText "تتشكل الأملاك العمومية للبلدية من الأملاك العمومية الطبيعية والأملاك العمومية الاصطناعية طبقا لأحكام القانون المنظم للأملاك الوطنية. إن الأملاك البلدية التابعة للأملاك العمومية للبلدية غير قابلة للتنازل ولا التقادم ولا الحجز ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
