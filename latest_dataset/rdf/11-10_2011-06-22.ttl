    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_127_20110622_OpEnact_f39a6cd511> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 127" ;
    dzdoc:position 126 ;
    dzdoc:usesTerm dzterm:secretary_general .

<https://legal.dz/resource/law/2011-06-22/11-10#art_128> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1_dup_1> ;
    dzdoc:eId "art_128" ;
    dzdoc:fullText "تحدد حقوق الأمين العام للبلدية وواجباته عن طريق التنظيم."@ar ;
