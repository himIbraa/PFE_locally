<https://legal.dz/resource/law/2011-06-22/11-10#version_art_42> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرسل عضو المجلس الشعبي البلدي استقالته إلى رئيس المجلس الشعبي البلدي بواسطة ظرف محمول مقابل وصل استلام. يقر المجلس الشعبي البلدي ذلك بموجب مداولة في أول دورة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_42_20110622_OpEnact_9ffcef8c8c> ;
