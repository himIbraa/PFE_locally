<https://legal.dz/resource/law/2011-06-22/11-10#art_11_defocc_5327b39e422f> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 86 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
