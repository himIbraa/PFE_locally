<https://legal.dz/resource/law/2011-06-22/11-10#version_art_86> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لـ رئيس المجلس الشعبي البلدي صفة ضابط الحالة المدنية . وبهذه الصفة، يقوم بجميع العقود المتعلقة بالحالة المدنية طبقا للتشريع الساري المفعول تحت رقابة النائب العام المختص إقليميا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
