dzterm:secretary_general a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الأمين العام للبلدية"@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:definesTerm dzterm:municipality ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "البلدية هي الجماعة الإقليمية القاعدية للدولة. وتتمتع بالشخصية المعنوية والذمة المالية المستقلة. وتحدث بموجب القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_1> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2011-06-22/11-10#art_1_defocc_4bb86a3ef411> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_1_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_1_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_1_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_1_20110622_OpEnact_e41bea1c7a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "الأولى" ;
    dzdoc:position 0 ;
    dzdoc:usesTerm dzterm:financial_autonomy,
        dzterm:legal_personality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_105> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_dup_1> ;
    dzdoc:eId "art_105" ;
    dzdoc:fullText "يتعين على المصالح التقنية للدولة تقديم مساهمتها للبلدية وفق الشروط المحددة عن طريق القوانين والتنظيمات المعمول بها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_105> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_105_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_105_20110622_OpEnact_13f144f568> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_105_obligation_0_bf4479d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 105" ;
    dzdoc:position 104 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_105_condition_0_25dc01a0> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_116> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_2> ;
    dzdoc:eId "art_116" ;
    dzdoc:fullText "في إطار حماية التراث المعماري وطبقا للتشريع والتنظيم المعمول بهما المتعلقين بالسكن والتعمير والمحافظة على التراث الثقافي وحمايته تسهر البلدية بمساهمة المصالح التقنية المؤهلة على المحافظة وحماية الأملاك العقارية الثقافية والحماية والحفاظ على الانسجام الهندسي للتجمعات السكنية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_116> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_116_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_116_20110622_OpEnact_0ee2684312> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_116_obligation_0_06e2d59f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "116" ;
    dzdoc:position 115 ;
    dzdoc:usesTerm dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_118> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_2> ;
    dzdoc:eId "art_118" ;
    dzdoc:fullText "تبادر البلدية بالعمليات المرتبطة بتهيئة الهياكل والتجهيزات الخاصة بالشبكات التابعة لاختصاصاتها وكذا العمليات المتعلقة بتسييرها وصيانتها . ويمكنها أيضا القيام أو المساهمة في تهيئة المساحات الموجهة لاحتواء النشاطات الاقتصادية أو التجارية أو الخدماتية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2011-06-22/11-10#art_118_right_0_c82cac5d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_118> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_118_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_118_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_118_20110622_OpEnact_702c3d5dce> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_118_obligation_0_39d8202c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "118" ;
    dzdoc:position 117 ;
    dzdoc:usesTerm dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_119> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_2> ;
    dzdoc:eId "art_119" ;
    dzdoc:fullText "توفر البلدية في مجال السكن الشروط التحفيزية للترقية العقارية، كما تبادر أو تساهم في ترقية برامج السكن . تشجع وتنظم بصفة خاصة كل جمعية سكان تهدف إلى حماية وصيانة وترميم المباني أو الأحياء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_119> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_119_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_119_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_119_20110622_OpEnact_b4874c5117> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_119_obligation_0_bba62a40>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_119_obligation_1_0b650737> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "119" ;
    dzdoc:position 118 ;
    dzdoc:usesTerm dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_126> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1_dup_1> ;
    dzdoc:eId "art_126" ;
    dzdoc:fullText "يتحدد تنظيم إدارة البلدية طبقا لهذا القانون وحسب أهمية الجماعة وحجم المهام المسندة إليها ولا سيما منها المتعلقة بما يأتي: الهيكل التنظيمي ومخطط تسيير المستخدمين، تنظيم مصلحة الحالة المدنية . وسير ها، وحماية كل العقود والسجلات الخاصة بها والحفاظ عليها، مسك بطاقة الناخبين وتسييرها، إحصاء المواطنين، حسب شرائح السن المولودين في البلدية أو المقيمين بها في إطار تسيير بطاقة الخدمة الوطنية، النشاط الاجتماعي، النشاط الثقافي والرياضي، تسيير الميزانية والمالية، مسك سجل جرد الأملاك العقارية البلدية وسجل جرد الأملاك المنقولة، تسيير مستخدمي البلدية، تنظيم المصالح التقنية البلدية وتسييرها، أرشيف البلدية، الشؤون القانونية والمنازعات. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_126> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_126_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_126_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_126_20110622_OpEnact_a3fb6e6f3d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 126" ;
    dzdoc:position 125 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_144> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_dup_2> ;
    dzdoc:eId "art_144" ;
    dzdoc:fullText "البلدية مسؤولة مدنيا عن الأخطاء التي يرتكبها رئيس المجلس الشعبي البلدي ومنتخبو البلدية ومستخدموها أثناء ممارسة مهامهم أو بمناسبتها. وتلزم البلدية برفع دعوى الرجوع أمام الجهة القضائية المختصة ضد هؤلاء في حالة ارتكابهم خطأ شخصيا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_144> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_144_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_144_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_144_20110622_OpEnact_2388a9159e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_144_obligation_0_e36344c6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "144" ;
    dzdoc:position 143 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_144_condition_0_70c83f59> ;
    dzdoc:usesTerm dzterm:mayor,
        dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_147> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_dup_2> ;
    dzdoc:eId "art_147" ;
    dzdoc:fullText "في حالة وقوع كارثة طبيعية لا تتحمل البلدية أية مسؤولية تجاه الدولة والمواطنين إذا أثبتت أنها اتخذت الاحتياطات التي تقع على عاتقها والمنصوص عليها بموجب التشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_147> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_147_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_147_20110622_OpEnact_faab1b75d5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "147" ;
    dzdoc:position 146 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_147_condition_0_4e772690>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_147_condition_1_97660c28> ;
    dzdoc:usesTerm dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_153> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_3_sec_3> ;
    dzdoc:eId "art_153" ;
    dzdoc:fullText "يمكن البلدية أن تنشئ مؤسسات عمومية بلدية تتمتع بـ الشخصية المعنوية والذمة المالية المستقلة من أجل تسيير مصالحها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_153_permission_0_2cb7e61a> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2011-06-22/11-10#art_153_right_0_a7370517> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_153> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_153_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_153_20110622_OpEnact_33f811131d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 153" ;
    dzdoc:position 152 ;
    dzdoc:usesTerm dzterm:municipality,
        dzterm:public_institution .

<https://legal.dz/resource/law/2011-06-22/11-10#art_155> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_3_sec_4> ;
    dzdoc:eId "art_155" ;
    dzdoc:fullText "يمكن المصالح العمومية البلدية المذكورة في المادة 149 أعلاه، أن تكون محل امتياز طبقا للتنظيم الساري المفعول. يخضع الامتياز لـ دفتر شروط نموذجي يحدد عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_155_permission_0_a1ecc518> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_155> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_155_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_155_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_155_20110622_OpEnact_cdfc8240a6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 155" ;
    dzdoc:position 154 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_149> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_149> ;
    dzdoc:usesTerm dzterm:concession,
        dzterm:model_specifications,
        dzterm:public_services .

<https://legal.dz/resource/law/2011-06-22/11-10#art_160> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_3_sec_5> ;
    dzdoc:eId "art_160" ;
    dzdoc:fullText "يتم إحصاء الأملاك البلدية غير المنقولة في السجل البلدي لجرد الأملاك العقارية ويتم جرد الأملاك المنقولة في سجل جرد الأملاك المنقولة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_160> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_160_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_160_20110622_OpEnact_df98027cba> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_160_obligation_0_258763a9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 160" ;
    dzdoc:position 159 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_167> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_3_sec_5> ;
    dzdoc:eId "art_167" ;
    dzdoc:fullText "يتعين على البلدية اقتناء وتخصيص الأراضي الضرورية للدفن وصيانتها ، وهي غير قابلة للتمليك. تحدد كيفيات إنشائها وتوسيعها وإعادة تخصيصها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_167> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_167_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_167_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_167_20110622_OpEnact_79b4e02ff6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_167_obligation_0_167c3993> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 167" ;
    dzdoc:position 166 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_176> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:definesTerm dzterm:municipal_budget ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1_dup_1> ;
    dzdoc:eId "art_176" ;
    dzdoc:fullText "ميزانية البلدية هي جدول تقديرات الإيرادات والنفقات السنوية للبلدية. وهي عقد ترخيص وإدارة يسمح بسير المصالح البلدية وتنفيذ برنامجها للتجهيز والاستثمار. يحدد شكل ميزانية البلدية ومضمونها عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_176_permission_0_6564a1aa> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_176> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2011-06-22/11-10#art_176_defocc_897d60ab677e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_176_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_176_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_176_20110622_OpEnact_bdb64e67ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 176" ;
    dzdoc:position 175 ;
    dzdoc:usesTerm dzterm:municipal_budget .

<https://legal.dz/resource/law/2011-06-22/11-10#art_188> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1_dup_1> ;
    dzdoc:eId "art_188" ;
    dzdoc:fullText "يعد رئيس المجلس الشعبي البلدي عند نهاية الفترة الإضافية للسنة المالية الحساب الإداري للبلدية ويعرضه على المجلس الشعبي البلدي للمصادقة . تتم المصادقة على الحساب الإداري وإعداد حساب التسيير وكذا التقريب الدوري للكتابات طبقا للتشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_188> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_188_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_188_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_188_20110622_OpEnact_4315fa52a1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_188_obligation_0_ae3aef09> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 188" ;
    dzdoc:position 187 ;
    dzdoc:usesTerm dzterm:council,
        dzterm:mayor .

<https://legal.dz/resource/law/2011-06-22/11-10#art_201> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1_dup_1> ;
    dzdoc:eId "art_201" ;
    dzdoc:fullText "تتقادم الديون التي لم يؤمر بصرفها وتصفيتها ودفعها في أجل أربع (4) سنوات من افتتاح السنة المالية المتعلقة بها ، وتعود بصفة نهائية لصالح البلديات باستثناء الحالات التي يكون فيها التأخير بفعل الإدارة أو بسبب وجود طعن أمام جهة قضائية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_201> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_201_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_201_20110622_OpEnact_6345d145d8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_201_obligation_0_f38c0060> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 201" ;
    dzdoc:position 200 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_201_condition_0_5cc15cdc> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_204> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_2_dup_1> ;
    dzdoc:eId "art_204" ;
    dzdoc:fullText "تعتبر منجزة عند نهاية السنة المالية : كل النفقات المأمور بدفعها والمعترف بصحتها، كل الإيرادات التي كانت موضوع إصدار سندات تحصيل. تتولى الخزينة العمومية من أجل تغطية حاجيات خزينة البلديات تحصيل الإيرادات وتقدم تسبيقات على الإيرادات الجبائية وفقا للأحكام المحددة في قانون المالية وطبقا للإجراءات المحددة بموجب التنظيم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_204> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_204_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_204_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_204_20110622_OpEnact_727d6ca51d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_204_obligation_0_3c583cb7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "204" ;
    dzdoc:position 203 ;
    dzdoc:usesTerm dzterm:treasury .

<https://legal.dz/resource/law/2011-06-22/11-10#art_212> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_dup_4> ;
    dzdoc:eId "art_212" ;
    dzdoc:fullText "يدفع الصندوق البلدي للتضامن المذكور في المادة 211 أعلاه للبلديات ما يأتي : مخصص مالي سنوي بالمعادلة، موجه لقسم التسيير في ميزانية البلدية لتغطية النفقات الإجبارية كأولوية، إعانات التجهيز الموجهة لقسم التجهيز والاستثمار لميزانية البلدية، إعانات توازن للبلديات التي تواجه وضعية مالية صعبة، إعانات استثنائية للبلديات التي تواجه وضعية غير متوقعة. تقييد إعانات التجهيز للصندوق البلدي للتضامن بتخصيص خاص. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_212> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_212_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_212_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_212_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_212_20110622_OpEnact_1e6ee3f89b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_212_obligation_0_ac5b7c41> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 212" ;
    dzdoc:position 211 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_211> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_211> ;
    dzdoc:usesTerm dzterm:municipal_solidarity_fund,
        dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_214> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_dup_4> ;
    dzdoc:eId "art_214" ;
    dzdoc:fullText "يمول صندوق الجماعات المحلية للضمان المنصوص عليه في المادة 211 أعلاه بالمساهمات الإجبارية للجماعات المحلية التي تحدد نسبتها عن طريق التنظيم . يدفع الرصيد الدائن لصندوق الجماعات المحلية للضمان المستخلص من كل سنة مالية إلى الصندوق البلدي للتضامن ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_214> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_214_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_214_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_214_20110622_OpEnact_ae71dbb517> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_214_obligation_0_2a584904>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_214_obligation_1_ce940180> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 214" ;
    dzdoc:position 213 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_211> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_211> ;
    dzdoc:usesTerm dzterm:local_authorities_guarantee_fund .

<https://legal.dz/resource/law/2011-06-22/11-10#art_216> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_dup_4> ;
    dzdoc:eId "art_216" ;
    dzdoc:fullText "تنجز الأعمال المسجلة في إطار التعاون المشترك بين البلديات بموجب اتفاقية أو عقود يصادق عليها عن طريق المداولات. تحدد كيفيات تطبيق المادتين 215 و 216 عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_216> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_216_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_216_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_216_20110622_OpEnact_0c0f8dd588> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 216" ;
    dzdoc:position 215 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_215>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_216> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_215>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_216> ;
    dzdoc:usesTerm dzterm:inter-municipal_cooperation .

<https://legal.dz/resource/law/2011-06-22/11-10#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "يتم إعداد الوكالة بطلب من الموكل أمام أي سلطة مؤهلة لهذا الغرض . وتحدد صراحة الجلسة أو الدورة التي حررت من أجلها هذه الوكالة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_25> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_25_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_25_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_25_20110622_OpEnact_5d8b420b4e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_25_obligation_0_fe41d538>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_25_obligation_1_5f9923c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "25" ;
    dzdoc:position 24 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "تمارس البلدية صلاحياتها في كل مجالات الاختصاص المخولة لها بموجب القانون. وتساهم مع الدولة، بصفة خاصة في إدارة وتهيئة الإقليم والتنمية الاقتصادية والاجتماعية والثقافية والأمن وكذا الحفاظ على الإطار المعيشي للمواطنين وتحسينه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_3_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_3_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_3_20110622_OpEnact_a989c87f07> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "3" ;
    dzdoc:position 2 ;
    dzdoc:usesTerm dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_41> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_41" ;
    dzdoc:fullText "في حالة الوفاة أو الاستقالة أو الإقصاء أو حصول مانع قانوني لمنتخب بالمجلس الشعبي البلدي ، يتم استخلافه في أجل لا يتجاوز شهرا واحدا ، بالمرشح الذي يلي مباشرة آخر منتخب من نفس القائمة بقرار من الوالي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_41> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_41_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_41_20110622_OpEnact_2097d39aad> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 41" ;
    dzdoc:position 40 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_41_condition_0_a4c65944> ;
    dzdoc:usesTerm dzterm:wali .

<https://legal.dz/resource/law/2011-06-22/11-10#art_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1> ;
    dzdoc:eId "art_5" ;
    dzdoc:fullText "يجب أن يعوض كل تخفيض في الإيرادات الجبائية البلدية ينجم عن إجراء تتخذه الدولة ويتضمن إعفاء جبائيا أو تخفيضا في نسب الضريبة أو إلغائها ، بناتج جبائي يساوي على الأقل مبلغ الفارق عند التحصيل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_5_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_5_20110622_OpEnact_b12b23e437> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_5_obligation_0_f9ec5267> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "5" ;
    dzdoc:position 4 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_80> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2> ;
    dzdoc:eId "art_80" ;
    dzdoc:fullText "يسهر رئيس المجلس الشعبي البلدي على تنفيذ مداولات المجلس الشعبي البلدي ويطلعه على ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_80> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_80_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_80_20110622_OpEnact_12e70a20be> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_80_obligation_0_3eba5421> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "80" ;
    dzdoc:position 79 ;
    dzdoc:usesTerm dzterm:council,
        dzterm:mayor .

<https://legal.dz/resource/law/2011-06-22/11-10#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "يقوم رئيس المجلس الشعبي البلدي تحت إشراف الوالي بما يأتي : تبليغ وتنفيذ القوانين والتنظيمات على إقليم البلدية، السهر على النظام والسكينة والنظافة العمومية، السهر على حسن تنفيذ التدابير الاحتياطية والوقاية والتدخل في مجال الإسعاف. ويكلف بالإضافة إلى ذلك، بكل المهام التي يخولها له التشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_88_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_88_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_88_20110622_OpEnact_1cb731128a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_88_obligation_0_042d0482>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_88_obligation_1_e2762017> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "88" ;
    dzdoc:position 87 ;
    dzdoc:usesTerm dzterm:mayor,
        dzterm:wali .

<https://legal.dz/resource/law/2011-06-22/11-10#art_90> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2> ;
    dzdoc:eId "art_90" ;
    dzdoc:fullText "في حالة حدوث كارثة طبيعية أو تكنولوجية على إقليم البلدية يأمر رئيس المجلس الشعبي البلدي بتفعيل المخطط البلدي لتنظيم الإسعافات طبقا للتشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_90> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_90_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_90_20110622_OpEnact_75e9f097ee> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_90_obligation_0_25232251> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "90" ;
    dzdoc:position 89 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_90_condition_0_55a8ecb1> ;
    dzdoc:usesTerm dzterm:mayor .

