    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_82> ;
    dznorm:position 0 ;
    dznorm:provisionText "ويجب عليه، على وجه الخصوص، القيام بما يأتي:"@ar ;
    dznorm:sourceArticle "art_82" .

<https://legal.dz/resource/law/2011-06-22/11-10#art_82_obligation_0_e752aa25_action_927d4e0b52> a dznorm:Action ;
