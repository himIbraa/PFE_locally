<https://legal.dz/resource/law/2011-06-22/11-10#version_art_175> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحدد البلدية في إطار تسيير ممتلكاتها وسير مصالحها العمومية المحلية مساهمة مالية للمرتفقين تتناسب وطبيعة الخدمات المقدمة ونوعيتها . تشجع البلدية وتدعم كل نشاط أو مساهمة أو مبادرة فردية أو جماعية تهدف إلى إنجاز مشاريع ذات منفعة عامة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_175_20110622_OpEnact_821f9dbf8a> ;
