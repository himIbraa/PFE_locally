<https://legal.dz/resource/law/2011-06-22/11-10#version_art_19> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعقد المجلس الشعبي البلدي دوراته بمقر البلدية . إلا أنه في حالة قوة قاهرة معلنة تحول دون الدخول إلى مقر البلدية ، يمكنه أن يجتمع في مكان آخر من إقليم البلدية . كما يمكن المجلس الشعبي البلدي أن يجتمع في مكان آخر، خارج إقليم البلدية يعينه الوالي بعد استشارة رئيس المجلس الشعبي البلدي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_19_20110622_OpEnact_fbd3635b49> ;
    dzdoc:replacementText "يعقد المجلس الشعبي البلدي دوراته بمقر البلدية . إلا أنه في حالة قوة قاهرة معلنة تحول دون الدخول إلى مقر البلدية ، يمكنه أن يجتمع في مكان آخر من إقليم البلدية . كما يمكن المجلس الشعبي البلدي أن يجتمع في مكان آخر، خارج إقليم البلدية يعينه الوالي بعد استشارة رئيس المجلس الشعبي البلدي."@ar ;
