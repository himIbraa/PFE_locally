<https://legal.dz/resource/law/2011-06-22/11-10#version_art_12> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "قصد تحقيق أهداف الديمقراطية المحلية في إطار التسيير الجواري المذكور في المادة 11 أعلاه، يسهر المجلس الشعبي البلدي على وضع إطار ملائم للمبادرات المحلية التي تهدف إلى تحفيز المواطنين وحثهم على المشاركة في تسوية مشاكلهم وتحسين ظروف معيشتهم . يتم تنظيم هذا الإطار طبقا للتشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_12_20110622_OpEnact_a9c8b18535> ;
    dzdoc:replacementText "قصد تحقيق أهداف الديمقراطية المحلية في إطار التسيير الجواري المذكور في المادة 11 أعلاه، يسهر المجلس الشعبي البلدي على وضع إطار ملائم للمبادرات المحلية التي تهدف إلى تحفيز المواطنين وحثهم على المشاركة في تسوية مشاكلهم وتحسين ظروف معيشتهم . يتم تنظيم هذا الإطار طبقا للتشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_12> ;
