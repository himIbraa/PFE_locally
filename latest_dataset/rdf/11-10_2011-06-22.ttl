<https://legal.dz/resource/law/2011-06-22/11-10#version_art_75> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتبر في حالة تخل عن المنصب، الغياب غير المبرر ل رئيس المجلس الشعبي البلدي لأكثر من شهر ، ويعلن ذلك من طرف المجلس الشعبي البلدي. في حالة انقضاء أربعين (40) يوما من غياب رئيس المجلس الشعبي البلدي دون أن يجتمع المجلس في جلسة استثنائية ، يقوم الوالي بجمعه لإثبات هذا الغياب. يتم استخلاف رئيس المجلس الشعبي البلدي في مهامه طبقا لأحكام المادة 72 أعلاه. يتم تعويض رئيس المجلس الشعبي البلدي وفق الشروط والأشكال المنصوص عليها في المادة 65 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_75_20110622_OpEnact_95f3fa264d> ;
    dzdoc:replacementText "يعتبر في حالة تخل عن المنصب، الغياب غير المبرر ل رئيس المجلس الشعبي البلدي لأكثر من شهر ، ويعلن ذلك من طرف المجلس الشعبي البلدي. في حالة انقضاء أربعين (40) يوما من غياب رئيس المجلس الشعبي البلدي دون أن يجتمع المجلس في جلسة استثنائية ، يقوم الوالي بجمعه لإثبات هذا الغياب. يتم استخلاف رئيس المجلس الشعبي البلدي في مهامه طبقا لأحكام المادة 72 أعلاه. يتم تعويض رئيس المجلس الشعبي البلدي وفق الشروط والأشكال المنصوص عليها في المادة 65 من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
