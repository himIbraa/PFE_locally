    dznorm:provisionText "ترسل هذه القرارات خلال الثماني والأربعين (48) ساعة من رئيس المجلس الشعبي البلدي إلى الوالي"@ar ;
    dznorm:sourceArticle "art_98" .

<https://legal.dz/resource/law/2011-06-22/11-10#art_98_obligation_0_3a0df82c_period_cb318008eb> a dznorm:Period ;
    rdfs:label "خلال الثماني والأربعين (48) ساعة من"@ar ;
