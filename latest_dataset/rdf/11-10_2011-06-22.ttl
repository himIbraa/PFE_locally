<https://legal.dz/resource/law/2011-06-22/11-10#version_art_144> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "البلدية مسؤولة مدنيا عن الأخطاء التي يرتكبها رئيس المجلس الشعبي البلدي ومنتخبو البلدية ومستخدموها أثناء ممارسة مهامهم أو بمناسبتها. وتلزم البلدية برفع دعوى الرجوع أمام الجهة القضائية المختصة ضد هؤلاء في حالة ارتكابهم خطأ شخصيا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_144_20110622_OpEnact_2388a9159e> ;
    dzdoc:replacementText "البلدية مسؤولة مدنيا عن الأخطاء التي يرتكبها رئيس المجلس الشعبي البلدي ومنتخبو البلدية ومستخدموها أثناء ممارسة مهامهم أو بمناسبتها. وتلزم البلدية برفع دعوى الرجوع أمام الجهة القضائية المختصة ضد هؤلاء في حالة ارتكابهم خطأ شخصيا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
