<https://legal.dz/resource/law/2011-06-22/11-10#version_art_106> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تخضع توأمة بلدية ما مع بلدية أو أي جماعة إقليمية أجنبية أخرى إلى الموافقة المسبقة للوزير المكلف بالداخلية بعد أخذ رأي وزير الشؤون الخارجية . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
