    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتولى الأمين العام للبلدية ، تحت سلطة رئيس المجلس الشعبي البلدي ، إعداد مشروع الميزانية. يقدم رئيس المجلس الشعبي البلدي مشروع الميزانية أمام المجلس للمصادقة عليه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
