<https://legal.dz/resource/law/2011-06-22/11-10#version_art_116> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في إطار حماية التراث المعماري وطبقا للتشريع والتنظيم المعمول بهما المتعلقين بالسكن والتعمير والمحافظة على التراث الثقافي وحمايته تسهر البلدية بمساهمة المصالح التقنية المؤهلة على المحافظة وحماية الأملاك العقارية الثقافية والحماية والحفاظ على الانسجام الهندسي للتجمعات السكنية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_116_20110622_OpEnact_0ee2684312> ;
