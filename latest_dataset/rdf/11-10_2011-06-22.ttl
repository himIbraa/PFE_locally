<https://legal.dz/resource/law/2011-06-22/11-10#version_art_170> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتكون الموارد الميزانية والمالية للبلدية بصفة خاصة، مما يأتي : حصيلة الجباية، مداخيل ممتلكاتها، مداخيل أملاك البلدية، الإعانات والمخصصات، ناتج الهبات والوصايا، القروض، ناتج مقابل الخدمات الخاصة التي تؤديها البلدية، ناتج حق الامتياز للفضاءات العمومية، بما فيها الفضاءات الإشهارية، الناتج المحصل مقابل مختلف الخدمات. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_170_20110622_OpEnact_890977acbf> ;
    dzdoc:replacementText "تتكون الموارد الميزانية والمالية للبلدية بصفة خاصة، مما يأتي : حصيلة الجباية، مداخيل ممتلكاتها، مداخيل أملاك البلدية، الإعانات والمخصصات، ناتج الهبات والوصايا، القروض، ناتج مقابل الخدمات الخاصة التي تؤديها البلدية، ناتج حق الامتياز للفضاءات العمومية، بما فيها الفضاءات الإشهارية، الناتج المحصل مقابل مختلف الخدمات. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
