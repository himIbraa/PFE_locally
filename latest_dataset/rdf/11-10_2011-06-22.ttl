<https://legal.dz/resource/law/2011-06-22/11-10#version_art_192> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يقوم رئيس المجلس الشعبي البلدي بإجراء مناقصة عمومية لحساب البلدية ، يساعده أعضاء اللجنة البلدية للمناقصة . كل مناقصة يحرر بشأنها محضر يتضمن جميع الملاحظات، ويوقعه جميع أعضاء اللجنة البلدية للمناقصة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_192_20110622_OpEnact_bb375585bb> ;
    dzdoc:replacementText "عندما يقوم رئيس المجلس الشعبي البلدي بإجراء مناقصة عمومية لحساب البلدية ، يساعده أعضاء اللجنة البلدية للمناقصة . كل مناقصة يحرر بشأنها محضر يتضمن جميع الملاحظات، ويوقعه جميع أعضاء اللجنة البلدية للمناقصة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_192> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
