<https://legal.dz/resource/law/2011-06-22/11-10#version_art_98> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسجل قرارات رئيس المجلس الشعبي البلدي حسب تاريخ إصدارها في السجل البلدي المخصص لهذا الغرض. ترسل هذه القرارات خلال الثماني والأربعين (48) ساعة من رئيس المجلس الشعبي البلدي إلى الوالي الذي يثبت استلامها على سجل مرقم ومؤشر من طرفه ويسلم مقابلها وصل استلام. ويتم إلصاقها في المكان المخصص لإعلام الجمهور بعد إصدار وصل الاستلام من الوالي، وتدرج في مدونة العقود الإدارية للبلدية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_98_20110622_OpEnact_ce99f55e7e> ;
    dzdoc:replacementText "تسجل قرارات رئيس المجلس الشعبي البلدي حسب تاريخ إصدارها في السجل البلدي المخصص لهذا الغرض. ترسل هذه القرارات خلال الثماني والأربعين (48) ساعة من رئيس المجلس الشعبي البلدي إلى الوالي الذي يثبت استلامها على سجل مرقم ومؤشر من طرفه ويسلم مقابلها وصل استلام. ويتم إلصاقها في المكان المخصص لإعلام الجمهور بعد إصدار وصل الاستلام من الوالي، وتدرج في مدونة العقود الإدارية للبلدية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_98> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
