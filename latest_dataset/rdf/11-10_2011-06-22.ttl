<https://legal.dz/resource/law/2011-06-22/11-10#version_art_212> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يدفع الصندوق البلدي للتضامن المذكور في المادة 211 أعلاه للبلديات ما يأتي : مخصص مالي سنوي بالمعادلة، موجه لقسم التسيير في ميزانية البلدية لتغطية النفقات الإجبارية كأولوية، إعانات التجهيز الموجهة لقسم التجهيز والاستثمار لميزانية البلدية، إعانات توازن للبلديات التي تواجه وضعية مالية صعبة، إعانات استثنائية للبلديات التي تواجه وضعية غير متوقعة. تقييد إعانات التجهيز للصندوق البلدي للتضامن بتخصيص خاص. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_212_20110622_OpEnact_1e6ee3f89b> ;
    dzdoc:replacementText "يدفع الصندوق البلدي للتضامن المذكور في المادة 211 أعلاه للبلديات ما يأتي : مخصص مالي سنوي بالمعادلة، موجه لقسم التسيير في ميزانية البلدية لتغطية النفقات الإجبارية كأولوية، إعانات التجهيز الموجهة لقسم التجهيز والاستثمار لميزانية البلدية، إعانات توازن للبلديات التي تواجه وضعية مالية صعبة، إعانات استثنائية للبلديات التي تواجه وضعية غير متوقعة. تقييد إعانات التجهيز للصندوق البلدي للتضامن بتخصيص خاص. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
