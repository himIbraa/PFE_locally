<https://legal.dz/resource/law/2011-06-22/11-10#version_art_43> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوقف بقرار من الوالي كل منتخب تعرض لمتابعة قضائية بسبب جناية أو جنحة لها صلة بالمال العام أو لأسباب مخلة بالشرف أو كان محل تدابير قضائية لا تمكنه من الاستمرار في ممارسة عهدته الانتخابية بصفة صحيحة، إلى غاية صدور حكم نهائي من الجهة القضائية المختصة. في حالة صدور حكم نهائي بالبراءة ، يستأنف المنتخب تلقائيا وفوريا ممارسة مهامه الانتخابية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_43_20110622_OpEnact_bd27aba3b0> ;
    dzdoc:replacementText "يوقف بقرار من الوالي كل منتخب تعرض لمتابعة قضائية بسبب جناية أو جنحة لها صلة بالمال العام أو لأسباب مخلة بالشرف أو كان محل تدابير قضائية لا تمكنه من الاستمرار في ممارسة عهدته الانتخابية بصفة صحيحة، إلى غاية صدور حكم نهائي من الجهة القضائية المختصة. في حالة صدور حكم نهائي بالبراءة ، يستأنف المنتخب تلقائيا وفوريا ممارسة مهامه الانتخابية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_43> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
