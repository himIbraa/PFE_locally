    dzdoc:position 88 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_89_condition_0_f9864c28> ;
    dzdoc:usesTerm dzterm:mayor,
        dzterm:wali .

<https://legal.dz/resource/law/2011-06-22/11-10#art_94> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2> ;
    dzdoc:eId "art_94" ;
    dzdoc:fullText "في إطار احترام حقوق وحريات المواطنين، يكلف رئيس المجلس الشعبي البلدي على الخصوص، بما ياتي السهر على المحافظة على النظام العام وأمن الأشخاص والممتلكات، التأكد من الحفاظ على النظام العام في كل الأماكن العمومية التي يجرى فيها تجمع الأشخاص، ومعاقبة كل مساس بالسكينة العمومية وكل الأعمال التي من شأنها الإخلال بها، تنظيم ضبطية الطرقات المتواجدة على إقليم البلدية مع مراعاة الأحكام الخاصة بالطرقات ذات الحركة الكثيفة، السهر على حماية التراث التاريخي والثقافي ورموز ثورة التحرير الوطني، السهر على احترام المقاييس والتعليمات في مجال العقار والسكن والتعمير وحماية التراث الثقافي المعماري، السهر على نظافة العمارات وضمان سهولة السير في الشوارع والساحات والطرق العمومية، السهر على احترام التنظيم في مجال الشغل المؤقت للأماكن التابعة للأملاك العمومية والمحافظة عليها، اتخاذ الاحتياطات والتدابير الضرورية لمكافحة الأمراض المتنقلة أو المعدية والوقاية منها، منع تشرد الحيوانات المؤذية والضارة، السهر على سلامة المواد الغذائية الاستهلاكية المعروضة للبيع، السهر على احترام تعليمات نظافة المحيط وحماية البيئة، ضمان ضبطية الجنائز والمقابر طبقا للعادات وحسب مختلف الشعائر الدينية، والعمل فورا على دفن كل شخص متوفى بصفة لائقة دون تمييز للدين أو المعتقد. ترسل نسخة من المحاضر التي تثبت مخالفة القانون والتنظيم من المصالح التقنية للدولة إلى رئيس المجلس الشعبي البلدي . يمكن رئيس المجلس الشعبي البلدي أن يستعين بالمصالح التقنية للدولة في إطار ممارسة صلاحياته كما هي محددة في هذه المادة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_94_permission_0_3dd1716f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_94> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_94_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_94_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_94_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_94_20110622_OpEnact_59dea454c0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_94_obligation_0_4d490354> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 94" ;
    dzdoc:position 93 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_94> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_94> ;
    dzdoc:usesTerm dzterm:mayor .

<https://legal.dz/resource/law/2011-06-22/11-10#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:definesTerm dzterm:municipality ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_3> ;
    dzdoc:eId "art_11" ;
    dzdoc:fullText "تشكل البلدية الإطار المؤسساتي لممارسة الديمقراطية على المستوى المحلي والتسيير الجواري. يتخذ المجلس الشعبي البلدي كل التدابير لإعلام المواطنين بشؤونهم واستشارتهم حول خيارات وأولويات التهيئة والتنمية الاقتصادية والاجتماعية والثقافية حسب الشروط المحددة في هذا القانون . ويمكن في هذا المجال استعمال، على وجه الخصوص الوسائط والوسائل الإعلامية المتاحة. كما يمكن المجلس الشعبي البلدي تقديم عرض عن نشاطه السنوي أمام المواطنين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_11_permission_0_7b99f8ee> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_11> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2011-06-22/11-10#art_11_defocc_5327b39e422f> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_11_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_11_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_11_para_2>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_11_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_11_20110622_OpEnact_e59a87430b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_11_obligation_0_b75c80d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "11" ;
    dzdoc:position 10 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_11_condition_0_8591033a> ;
    dzdoc:usesTerm dzterm:apc,
        dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_200> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1_dup_1> ;
    dzdoc:eId "art_200" ;
    dzdoc:fullText "يمكن المجلس الشعبي البلدي أن يقيد في الميزانية اعتمادات لتغطية النفقات الطارئة . يقرر المجلس الشعبي البلدي استعمال هذه الاعتمادات عن طريق التحويل إلى مواد لم تزود بصفة كافية و في حالة الاستعجال ، يقوم رئيس المجلس الشعبي البلدي بذلك ويخطر المجلس الشعبي البلدي خلال الدورة الجديدة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_200_permission_0_28dde6ce> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2011-06-22/11-10#art_200_right_0_178f1845> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_200> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_200_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_200_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_200_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_200_20110622_OpEnact_3cbd299294> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_200_obligation_0_589e4a72> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 200" ;
    dzdoc:position 199 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_200_condition_0_ce71e929>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_200_condition_1_e854c5b5> ;
    dzdoc:usesTerm dzterm:apc .

<https://legal.dz/resource/law/2011-06-22/11-10#art_185> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1_dup_1> ;
    dzdoc:eId "art_185" ;
    dzdoc:fullText "إذا لم تضبط ميزانية البلدية نهائيا لسبب ما ، قبل بدء السنة المالية يستمر العمل بالإيرادات والنفقات العادية المقيدة في السنة المالية السابقة إلى غاية المصادقة على الميزانية الجديدة. غير أنه لا يجوز الالتزام بالنفقات وصرفها إلا في حدود جزء من اثني عشر (1/12) في الشهر من مبلغ اعتمادات السنة المالية السابقة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_185_permission_0_fad45bfd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_185> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_185_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_185_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_185_20110622_OpEnact_4614b95fa2> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2011-06-22/11-10#art_185_prohibition_0_fad45bfd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 185" ;
    dzdoc:position 184 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_185_condition_0_d85c1e67> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_19" ;
    dzdoc:fullText "يعقد المجلس الشعبي البلدي دوراته بمقر البلدية . إلا أنه في حالة قوة قاهرة معلنة تحول دون الدخول إلى مقر البلدية ، يمكنه أن يجتمع في مكان آخر من إقليم البلدية . كما يمكن المجلس الشعبي البلدي أن يجتمع في مكان آخر، خارج إقليم البلدية يعينه الوالي بعد استشارة رئيس المجلس الشعبي البلدي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_19_permission_0_073f620a> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2011-06-22/11-10#art_19_right_0_029dd690>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_19_right_1_c60ab866> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_19_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_19_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_19_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_19_20110622_OpEnact_fbd3635b49> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_19_obligation_0_a148f6fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "19" ;
    dzdoc:position 18 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_19_condition_0_281152b3> ;
    dzdoc:usesTerm dzterm:council .

<https://legal.dz/resource/law/2011-06-22/11-10#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "يمكن عضو المجلس الشعبي البلدي الذي حصل له مانع لحضور جلسة أو دورة أن يوكل كتابيا عضوا آخر من المجلس من اختياره، ليصوت نيابة عنه . لا يمكن نفس العضو أن يكون حاملا لأكثر من وكالة واحدة . لا تصح الوكالة إلا لجلسة أو لدورة واحدة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_24_permission_0_91826723>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_24_permission_1_de9829e1> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2011-06-22/11-10#art_24_right_0_f9141915> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_24_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_24_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_24_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_24_20110622_OpEnact_115eef4064> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_24_obligation_0_6ef037e4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "24" ;
    dzdoc:position 23 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_24_condition_0_a9912afe> ;
    dzdoc:usesTerm dzterm:council .

<https://legal.dz/resource/law/2011-06-22/11-10#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "يمنع على أي عضو بالمجلس الشعبي البلدي حضور جلسات المجلس التي يداول فيها حول موضوع يخصه أو تكون له مصلحة فيه بمفهوم أحكام المادة 60 من هذا القانون، و يجب على رئيس الجلسة التأكد من ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_28_20110622_OpEnact_23a90718d5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_28_obligation_0_ba1623a4>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_28_obligation_1_a56121bd> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2011-06-22/11-10#art_28_prohibition_0_f1bc5aaa> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "28" ;
    dzdoc:position 27 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_60> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_60> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "يمكن المجلس الشعبي البلدي أن يشكل من بين أعضائه لجنة خاصة لدراسة موضوع محدد يدخل في مجال اختصاصه كما هو مبين في هذا القانون. تتشكل اللجنة خاصة بناء على اقتراح من رئيس المجلس الشعبي البلدي عن طريق مداولة المجلس مصادق عليها بأغلبية أعضائه. تقدم اللجنة نتائج أعمالها لرئيس المجلس الشعبي البلدي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_33_permission_0_67881f94> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_33_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_33_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_33_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_33_20110622_OpEnact_0744a519f9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "33" ;
    dzdoc:position 32 ;
    dzdoc:usesTerm dzterm:council,
        dzterm:president .

<https://legal.dz/resource/law/2011-06-22/11-10#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "في حالة حل المجلس الشعبي البلدي ، يعين الوالي ، خلال العشرة (10) أيام التي تلي حل المجلس، متصرفا ومساعدين، عند الاقتضاء، توكل لهم مهمة تسيير شؤون البلدية. وتنتهي مهامهم بقوة القانون بمجرد تنصيب المجلس الجديد. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_48_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_48_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_48_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_48_20110622_OpEnact_3e997fcaed> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_48_obligation_0_223f385f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "48" ;
    dzdoc:position 47 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_48> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_48> ;
    dzdoc:usesTerm dzterm:council,
        dzterm:wali .

<https://legal.dz/resource/law/2011-06-22/11-10#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "ترسل الاستدعاءات لدورات المجلس الشعبي البلدي من رئيسه، وتدون بسجل مداولات البلدية . تسلم الاستدعاءات، مرفقة بمشروع جدول الأعمال بواسطة ظرف محمول إلى أعضاء المجلس الشعبي البلدي بمقر سكناهم قبل عشرة (10) أيام كاملة على الأقل من تاريخ افتتاح الدورة مقابل وصل استلام . يمكن تخفيض هذا الأجل في حالة الاستعجال، على ألا يقل عن يوم واحد كامل . وفي هذه الحالة، يتخذ رئيس المجلس الشعبي البلدي التدابير اللازمة لتسليم الاستدعاءات ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_21_permission_0_867fd0e2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_21_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_21_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_21_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_21_20110622_OpEnact_ccf4615145> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_21_obligation_0_9e30d1f3>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_21_obligation_1_74d2fa8f>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_21_obligation_2_e744dfc3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "21" ;
    dzdoc:position 20 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_21_condition_0_5843232e> ;
    dzdoc:usesTerm dzterm:council .

<https://legal.dz/resource/law/2011-06-22/11-10#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "تجري انتخابات تجديد المجلس الشعبي البلدي المحل خلال أجل أقصاه ستة (6) أشهر ابتداء من تاريخ الحل ، و لا يمكن بأي حال من الأحوال إجراؤها خلال السنة الأخيرة من العهدة الانتخابية . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_49_permission_0_e0981ea8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_49_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_49_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_49_20110622_OpEnact_41685f61b4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_49_obligation_0_dff01f19> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "49" ;
    dzdoc:position 48 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_49> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_49> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_49_condition_0_f3a3742c> ;
    dzdoc:usesTerm dzterm:council .

<https://legal.dz/resource/law/2011-06-22/11-10#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "يتقاضى رئيس المجلس الشعبي البلدي ونواب الرئيس والمندوبون البلديون، وعند الاقتضاء، المتصرف المنصوص عليه في المادة 48 من هذا القانون منحة مرتبطة بوظائفهم . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2011-06-22/11-10#art_76_right_0_e2dd2be2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_76_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_76_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_76_20110622_OpEnact_93fd581f51> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 76" ;
    dzdoc:position 75 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_48> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_48> ;
    dzdoc:usesTerm dzterm:mayor .

<https://legal.dz/resource/law/2011-06-22/11-10#art_186> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1_dup_1> ;
    dzdoc:eId "art_186" ;
    dzdoc:fullText "عندما لا يصوت على ميزانية البلدية بسبب اختلال داخل المجلس الشعبي البلدي وطبقا ل المادة 102 أعلاه ، يقوم الوالي باستدعاء المجلس الشعبي البلدي في دورة غير عادية للمصادقة عليها. غير أنه لا تعقد هذه الدورة إلا إذا انقضت الفترة القانونية للمصادقة على الميزانية وبعد تطبيق أحكام المادة 185 أعلاه عندما يتعلق الأمر بالميزانية الأولية . وفي حالة عدم توصل هذه الدورة إلى المصادقة على الميزانية ، يضبطها الوالي نهائيا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_186> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_186_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_186_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_186_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_186_20110622_OpEnact_75ef321497> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 186" ;
    dzdoc:position 185 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_102>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_185> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_102>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_185> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_186_condition_0_c01b098e>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_186_condition_1_60e9f5a2>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_186_condition_2_4d0025d8> ;
    dzdoc:usesTerm dzterm:council,
        dzterm:wali .

<https://legal.dz/resource/law/2011-06-22/11-10#art_57> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_57" ;
    dzdoc:fullText "لا تنفذ إلا بعد المصادقة عليها من الوالي ، المداولات المتضمنة ما يأتي : الميزانيات والحسابات قبول الهبات والوصايا الأجنبية، اتفاقيات التوأمة، التنازل عن الأملاك العقارية البلدية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_57> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_57_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_57_20110622_OpEnact_d7eb2132d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "57" ;
    dzdoc:position 56 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_57_condition_0_16090c41> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_182> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_sec_1_dup_1> ;
    dzdoc:eId "art_182" ;
    dzdoc:fullText "يصوت على الاعتمادات بابا بابا ومادة مادة. يمكن المجلس الشعبي البلدي إجراء تحويلات من باب إلى باب داخل نفس القسم عن طريق مداولة . يمكن رئيس المجلس الشعبي البلدي إجراء تحويلات من مادة إلى مادة داخل نفس الباب بموجب قرار ، ويخطر بذلك المجلس الشعبي البلدي بمجرد انعقاد دورة جديدة . غير أنه لا يمكن القيام بأي تحويل بالنسبة للاعتمادات المقيدة بتخصيص خاص."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_182_permission_0_1e8bcb03>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_182_permission_1_d3497bff>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_182_permission_2_61954a60> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2011-06-22/11-10#art_182_right_0_e134e2ac>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_182_right_1_56f6f252> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_182> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_182_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_182_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_182_para_2>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_182_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_182_20110622_OpEnact_aa56fcb458> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_182_obligation_0_b699c317> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 182" ;
    dzdoc:position 181 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_3> ;
    dzdoc:eId "art_14" ;
    dzdoc:fullText "يمكن كل شخص الاطلاع على مستخرجات مداولات المجلس الشعبي البلدي وكذا القرارات البلدية . و يمكن كل شخص ذي مصلحة الحصول على نسخة منها كاملة أو جزئية على نفقته مع مراعاة أحكام المادة 56 أدناه . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_14_permission_0_d74047ce> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2011-06-22/11-10#art_14_right_0_e536fb13>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_14_right_1_429abcd7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_14_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_14_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_14_20110622_OpEnact_8bd5a85adc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "14" ;
    dzdoc:position 13 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_56> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_56> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_14_condition_0_a2c2d293> ;
    dzdoc:usesTerm dzterm:apc .

<https://legal.dz/resource/law/2011-06-22/11-10#art_211> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_dup_4> ;
    dzdoc:eId "art_211" ;
    dzdoc:fullText "تتوفر البلديات قصد تجسيد التضامن المالي ما بين البلديات وضمان المداخيل الجبائية، على صندوقين : الصندوق البلدي للتضامن صندوق الجماعات المحلية للضمان . تحدد كيفيات تنظيم هذه الصناديق وتسييرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_211> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_211_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_211_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_211_20110622_OpEnact_5f511c3ca7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_211_obligation_0_61ddc42c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 211" ;
    dzdoc:position 210 ;
    dzdoc:usesTerm dzterm:local_authorities_guarantee_fund,
        dzterm:municipal_solidarity_fund,
        dzterm:municipality .

<https://legal.dz/resource/law/2011-06-22/11-10#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "يجب على المستخدمين منح مستخدميهم، الأعضاء في مجلس شعبي بلدي الوقت الضروري لممارسة عهدتهم الانتخابية . يعتبر الاستدعاء لأشغال المجلس ودورات التكوين المنظمة لصالح المنتخبين مبررا للغياب. مع مراعاة أحكام المادة 76 من هذا القانون ، يدفع المستخدم أجر المنتخب غير الدائم مقابل الوقت المخصص لأداء العهدة ، و لا يمكن أن يشكل التوقف عن العمل المنصوص عليه في هذه المادة سببا لفسخ عقد العمل من طرف المستخدم . يستفيد المنتخب من الحقوق المرتبطة بمساره المهني طوال كل الفترة المخصصة لعهدته الانتخابية . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_38_permission_0_8897446b> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2011-06-22/11-10#art_38_right_0_4149da10> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_38_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_38_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_38_para_2>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_38_para_3>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_38_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_38_20110622_OpEnact_9e772197a3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2011-06-22/11-10#art_38_obligation_0_3a576405>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_38_obligation_1_7f50beae> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 38" ;
    dzdoc:position 37 ;
    dzdoc:references <https://legal.dz/resource/law/2011-06-22/11-10#art_76> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2011-06-22/11-10#art_76> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_38_condition_0_ccc00da6>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_38_condition_1_8325f546> .

<https://legal.dz/resource/law/2011-06-22/11-10#art_148> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_2_dup_2> ;
    dzdoc:eId "art_148" ;
    dzdoc:fullText "تغطي البلدية مبالغ التعويضات الناجمة عن الحوادث الضارة التي تطرأ لرئيس المجلس الشعبي البلدي ونواب الرئيس والمندوبين البلديين والمنتخبين والمستخدمين البلديين أثناء ممارسة مهامهم أو بمناسبتها . عندما يتعرض منتخب أو عون بلدي إلى ضرر مادي ناجم بصفة مباشرة عن ممارسة وظيفته أو بمناسبتها ، تكون البلدية ملزمة بموجب مداولة المجلس الشعبي البلدي مصادق عليها طبقا لأحكام هذا القانون، بالتعويض المستحق على أساس تقييم عادل ومنصف . ولا يمكن بأي حال من الأحوال أن يجمع هذا التعويض مع تعويض آخر لنفس الضرر. تتحمل ميزانية البلدية التعويضات ذات الصلة. للبلدية حق الرجوع ضد المتسببين في هذه الأحداث ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2011-06-22/11-10#art_148_permission_0_e2bc25db> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2011-06-22/11-10#art_148_right_0_dae2afe8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_148> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_148_para_0>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_148_para_1>,
        <https://legal.dz/resource/law/2011-06-22/11-10#art_148_para_2>,
