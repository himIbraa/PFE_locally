<https://legal.dz/resource/law/2011-06-22/11-10#version_art_194> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يصادق على محضر المناقصة والصفقة العمومية عن طريق مداولة المجلس الشعبي البلدي . يرسل محضر المناقصة والصفقة العمومية إلى الوالي مرفقان بالمداولة المتعلقة بهما ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_194_20110622_OpEnact_06435d5fb7> ;
    dzdoc:replacementText "يصادق على محضر المناقصة والصفقة العمومية عن طريق مداولة المجلس الشعبي البلدي . يرسل محضر المناقصة والصفقة العمومية إلى الوالي مرفقان بالمداولة المتعلقة بهما ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
