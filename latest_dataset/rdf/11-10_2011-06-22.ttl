<https://legal.dz/resource/law/2011-06-22/11-10#art_125> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1_dup_1> ;
    dzdoc:eId "art_125" ;
    dzdoc:fullText "للبلدية إدارة توضع تحت سلطة رئيس المجلس الشعبي البلدي وينشطها الأمين العام للبلدية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_125> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_125_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_125_20110622_OpEnact_9cccacb93f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:introducedOn "2011-06-22"^^xsd:date ;
    dzdoc:number "المادة 125" ;
    dzdoc:position 124 ;
    dzdoc:usesTerm dzterm:president_apc,
        dzterm:secretary_general .

<https://legal.dz/resource/law/2011-06-22/11-10#art_127> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_1_dup_1> ;
    dzdoc:eId "art_127" ;
    dzdoc:fullText "تحدد كيفية وشروط تعيين الأمين العام للبلدية عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2011-06-22/11-10#version_art_127> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2011-06-22/11-10#art_127_para_0> ;
