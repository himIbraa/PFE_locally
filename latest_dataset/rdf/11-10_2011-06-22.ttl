<https://legal.dz/resource/law/2011-06-22/11-10#version_art_114> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقتضي إنشاء أي مشروع يحتمل الإضرار بـ البيئة و الصحة العمومية على إقليم البلدية موافقة المجلس الشعبي البلدي ، باستثناء المشاريع ذات المنفعة الوطنية التي تخضع للأحكام المتعلقة بحماية البيئة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
