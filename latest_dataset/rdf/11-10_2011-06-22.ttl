<https://legal.dz/resource/law/2011-06-22/11-10#art_106_condition_0_9c2d35e6> a dznorm:Condition ;
    dznorm:conditionText "الموافقة المسبقة للوزير المكلف بالداخلية بعد أخذ رأي وزير الشؤون الخارجية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_106> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_106_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_106> ;
    dzdoc:position 0 ;
    dzdoc:text "تخضع توأمة بلدية ما مع بلدية أو أي جماعة إقليمية أجنبية أخرى إلى الموافقة المسبقة للوزير المكلف بالداخلية بعد أخذ رأي وزير الشؤون الخارجية."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_106_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_106> ;
    dzdoc:position 1 ;
    dzdoc:text "تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_107_obligation_0_e1b3cd49> a dznorm:Obligation ;
