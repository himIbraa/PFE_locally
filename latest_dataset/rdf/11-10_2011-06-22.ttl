    dzdoc:evidenceText "في إطار احترام التشريع والتنظيم المعمول بهما ، تودع إجباريا وثائق الحالة المدنية التي تجاوز عمرها القرن والمخططات وسجلات مسح الأراضي التي لم تعد مستعملة منذ ثلاثين (30) سنة على الأقل وكل الوثائق الأخرى المحفوظة في أرشيف البلدية التي يقل عدد سكانها عن 20.000 نسمة في أرشيف الولاية ما عدا الحالات التي يرخص فيها الوالي بخلاف ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_140_20110622_OpEnact_74d2fd4b6e> ;
    dzdoc:replacementText "في إطار احترام التشريع والتنظيم المعمول بهما ، تودع إجباريا وثائق الحالة المدنية التي تجاوز عمرها القرن والمخططات وسجلات مسح الأراضي التي لم تعد مستعملة منذ ثلاثين (30) سنة على الأقل وكل الوثائق الأخرى المحفوظة في أرشيف البلدية التي يقل عدد سكانها عن 20.000 نسمة في أرشيف الولاية ما عدا الحالات التي يرخص فيها الوالي بخلاف ذلك ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_140> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
