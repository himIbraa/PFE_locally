    dznorm:conditionText "مع مراعاة الأحكام القانونية المطبقة في هذا المجال"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_149> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_149_obligation_0_3e915189> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_149> ;
    dznorm:position 0 ;
    dznorm:provisionText "تضمن البلدية سير المصالح العمومية البلدية التي تهدف إلى تلبية حاجات مواطنيها وإدارة أملاكها"@ar ;
    dznorm:sourceArticle "art_149" .

<https://legal.dz/resource/law/2011-06-22/11-10#art_149_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_149> ;
    dzdoc:position 0 ;
    dzdoc:text "مع مراعاة الأحكام القانونية المطبقة في هذا المجال، تضمن البلدية سير المصالح العمومية البلدية التي تهدف إلى تلبية حاجات مواطنيها وإدارة أملاكها."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_149_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_149> ;
    dzdoc:position 1 ;
    dzdoc:text "وبهذه الصفة، فهي تحدث إضافة إلى مصالح الإدارة العامة، مصالح عمومية تقنية قصد التكفل على وجه الخصوص، بما يأتي : التزويد بالمياه الصالحة للشرب وصرف المياه المستعملة، النفايات المنزلية والفضلات الأخرى، صيانة الطرقات وإشارات المرور الإنارة العمومية، الأسواق المغطاة والأسواق والموازين العمومية، الحظائر ومساحات التوقف، المحاشر، النقل الجماعي، المذابح البلدية، الخدمات الجنائزية وتهيئة المقابر وصيانتها بما فيها مقابر الشهداء، الفضاءات الثقافية التابعة لأملاكها، فضاءات الرياضة والتسلية التابعة لأملاكها، المساحات الخضراء."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_14_condition_0_a2c2d293> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2011-06-22/11-10#art_14_condition_0_a2c2d293_ref_ba36c4c37bec> ;
