    dznorm:position 0 ;
    dznorm:provisionText "يعد رئيس المجلس الشعبي البلدي عند نهاية الفترة الإضافية للسنة المالية الحساب الإداري للبلدية ويعرضه على المجلس الشعبي البلدي للمصادقة"@ar ;
    dznorm:sourceArticle "art_188" .

