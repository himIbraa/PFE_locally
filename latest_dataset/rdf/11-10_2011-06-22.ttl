<https://legal.dz/resource/law/2011-06-22/11-10#version_art_44> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقصى بقوة القانون من المجلس، كل عضو مجلس شعبي بلدي كان محل إدانة جزائية نهائية للأسباب المذكورة في المادة 43 أعلاه. يثبت الوالي هذا الإقصاء بموجب قرار."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_44_20110622_OpEnact_c1e3e682b9> ;
    dzdoc:replacementText "يقصى بقوة القانون من المجلس، كل عضو مجلس شعبي بلدي كان محل إدانة جزائية نهائية للأسباب المذكورة في المادة 43 أعلاه. يثبت الوالي هذا الإقصاء بموجب قرار."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_44> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
