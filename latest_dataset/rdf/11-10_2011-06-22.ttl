    dzdoc:number "المادة 130" ;
    dzdoc:position 129 .

<https://legal.dz/resource/law/2011-06-22/11-10#art_135> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#chp_1_sec_2_dup_1> ;
    dzdoc:eId "art_135" ;
    dzdoc:fullText "يتصرف المندوب البلدي تحت مسؤولية رئيس المجلس الشعبي البلدي وباسمه ويتلقى منه تفويضا بالإمضاء."@ar ;
