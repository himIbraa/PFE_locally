<https://legal.dz/resource/law/2011-06-22/11-10#version_art_72> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتفرغ رئيس المجلس الشعبي البلدي بصفة دائمة لممارسة عهدته الانتخابية . يستخلف رئيس المجلس الشعبي البلدي الذي حصل له مانع مؤقت في أداء وظائفه بنائب رئيس. إذا استحال على الرئيس تعيين مستخلف له ، يقوم المجلس الشعبي البلدي بتعيين أحد نواب الرئيس، وإن تعذر ذلك، أحد أعضاء المجلس الشعبي البلدي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_72_20110622_OpEnact_5bfd7e034c> ;
    dzdoc:replacementText "يتفرغ رئيس المجلس الشعبي البلدي بصفة دائمة لممارسة عهدته الانتخابية . يستخلف رئيس المجلس الشعبي البلدي الذي حصل له مانع مؤقت في أداء وظائفه بنائب رئيس. إذا استحال على الرئيس تعيين مستخلف له ، يقوم المجلس الشعبي البلدي بتعيين أحد نواب الرئيس، وإن تعذر ذلك، أحد أعضاء المجلس الشعبي البلدي."@ar ;
