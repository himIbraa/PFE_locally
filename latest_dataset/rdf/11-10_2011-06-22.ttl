<https://legal.dz/resource/law/2011-06-22/11-10#version_art_200> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن المجلس الشعبي البلدي أن يقيد في الميزانية اعتمادات لتغطية النفقات الطارئة . يقرر المجلس الشعبي البلدي استعمال هذه الاعتمادات عن طريق التحويل إلى مواد لم تزود بصفة كافية و في حالة الاستعجال ، يقوم رئيس المجلس الشعبي البلدي بذلك ويخطر المجلس الشعبي البلدي خلال الدورة الجديدة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم ."@ar ;
