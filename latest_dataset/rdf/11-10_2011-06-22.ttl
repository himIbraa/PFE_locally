    dznorm:position 0 ;
    dznorm:provisionText "يسهر رئيس المجلس الشعبي البلدي على وضع المصالح والمؤسسات العمومية البلدية وحسن سيرها."@ar ;
    dznorm:sourceArticle "art_83" .

<https://legal.dz/resource/law/2011-06-22/11-10#art_83_obligation_0_99e0ea47_role_9fccbda088> a dznorm:Role ;
