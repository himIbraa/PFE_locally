<https://legal.dz/resource/law/2011-06-22/11-10#version_art_93> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتمد رئيس المجلس الشعبي البلدي ، قصد ممارسة صلاحياته في مجال الشرطة الإدارية، على سلك الشرطة البلدية التي يحدد قانونها الأساسي عن طريق التنظيم . يمكن رئيس المجلس الشعبي البلدي ، عند الاقتضاء، تسخير قوات الشرطة أو الدرك الوطني المختصة إقليميا حسب الكيفيات المحددة عن طريق التنظيم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_93_20110622_OpEnact_cb42c9f6aa> ;
    dzdoc:replacementText "يعتمد رئيس المجلس الشعبي البلدي ، قصد ممارسة صلاحياته في مجال الشرطة الإدارية، على سلك الشرطة البلدية التي يحدد قانونها الأساسي عن طريق التنظيم . يمكن رئيس المجلس الشعبي البلدي ، عند الاقتضاء، تسخير قوات الشرطة أو الدرك الوطني المختصة إقليميا حسب الكيفيات المحددة عن طريق التنظيم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
