<https://legal.dz/resource/law/2011-06-22/11-10#version_art_143> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في إطار احترام التشريع والتنظيم المعمول بهما ، تبقى الوثائق المودعة تطبيقا لأحكام المواد 140 و 141 و 142 أعلاه بأرشيف الولاية ملكا للبلدية. يتم ضمان حفظ أرشيف البلدية وتصنيفه وتبليغه وفق نفس الشروط المطبقة على أرشيف الولاية. لا يمكن إتلاف محتوى أرشيف البلدية المودع بأرشيف الولاية بدون ترخيص من المجلس الشعبي البلدي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_143_20110622_OpEnact_98503d165c> ;
    dzdoc:replacementText "في إطار احترام التشريع والتنظيم المعمول بهما ، تبقى الوثائق المودعة تطبيقا لأحكام المواد 140 و 141 و 142 أعلاه بأرشيف الولاية ملكا للبلدية. يتم ضمان حفظ أرشيف البلدية وتصنيفه وتبليغه وفق نفس الشروط المطبقة على أرشيف الولاية. لا يمكن إتلاف محتوى أرشيف البلدية المودع بأرشيف الولاية بدون ترخيص من المجلس الشعبي البلدي ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_143> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
