<https://legal.dz/resource/law/2011-06-22/11-10#version_art_186> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما لا يصوت على ميزانية البلدية بسبب اختلال داخل المجلس الشعبي البلدي وطبقا ل المادة 102 أعلاه ، يقوم الوالي باستدعاء المجلس الشعبي البلدي في دورة غير عادية للمصادقة عليها. غير أنه لا تعقد هذه الدورة إلا إذا انقضت الفترة القانونية للمصادقة على الميزانية وبعد تطبيق أحكام المادة 185 أعلاه عندما يتعلق الأمر بالميزانية الأولية . وفي حالة عدم توصل هذه الدورة إلى المصادقة على الميزانية ، يضبطها الوالي نهائيا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_186_20110622_OpEnact_75ef321497> ;
    dzdoc:replacementText "عندما لا يصوت على ميزانية البلدية بسبب اختلال داخل المجلس الشعبي البلدي وطبقا ل المادة 102 أعلاه ، يقوم الوالي باستدعاء المجلس الشعبي البلدي في دورة غير عادية للمصادقة عليها. غير أنه لا تعقد هذه الدورة إلا إذا انقضت الفترة القانونية للمصادقة على الميزانية وبعد تطبيق أحكام المادة 185 أعلاه عندما يتعلق الأمر بالميزانية الأولية . وفي حالة عدم توصل هذه الدورة إلى المصادقة على الميزانية ، يضبطها الوالي نهائيا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
