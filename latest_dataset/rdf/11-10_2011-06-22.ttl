<https://legal.dz/resource/law/2011-06-22/11-10#version_art_88> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم رئيس المجلس الشعبي البلدي تحت إشراف الوالي بما يأتي : تبليغ وتنفيذ القوانين والتنظيمات على إقليم البلدية، السهر على النظام والسكينة والنظافة العمومية، السهر على حسن تنفيذ التدابير الاحتياطية والوقاية والتدخل في مجال الإسعاف. ويكلف بالإضافة إلى ذلك، بكل المهام التي يخولها له التشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_88_20110622_OpEnact_1cb731128a> ;
    dzdoc:replacementText "يقوم رئيس المجلس الشعبي البلدي تحت إشراف الوالي بما يأتي : تبليغ وتنفيذ القوانين والتنظيمات على إقليم البلدية، السهر على النظام والسكينة والنظافة العمومية، السهر على حسن تنفيذ التدابير الاحتياطية والوقاية والتدخل في مجال الإسعاف. ويكلف بالإضافة إلى ذلك، بكل المهام التي يخولها له التشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
