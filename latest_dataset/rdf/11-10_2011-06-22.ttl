<https://legal.dz/resource/law/2011-06-22/11-10#art_124_obligation_0_c129f6bd> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_124> ;
    dznorm:hasCondition <https://legal.dz/resource/law/2011-06-22/11-10#art_124_obligation_0_c129f6bd_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "تتكفل البلدية في مجال تحسين الإطار المعيشي للمواطن، وفي حدود إمكانياتها وطبقا للتشريع والتنظيم المعمول بهما، بتهيئة المساحات الخضراء ووضع العتاد الحضري وتساهم في صيانة فضاءات الترفيه والشواطئ"@ar ;
    dznorm:sourceArticle "art_124" .

<https://legal.dz/resource/law/2011-06-22/11-10#art_171_obligation_0_485f7b2f> a dznorm:Obligation ;
