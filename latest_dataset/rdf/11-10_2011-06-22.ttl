<https://legal.dz/resource/law/2011-06-22/11-10#version_art_177> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم إعداد الميزانية الأولية قبل بدء السنة المالية ويتم تعديل النفقات والإيرادات خلال السنة المالية حسب نتائج السنة المالية السابقة عن طريق ميزانية إضافية . يسمى فتح الاعتمادات المصادق عليها على انفراد في حالة الضرورة \"اعتمادات مفتوحة مسبقا\" إذا جاءت قبل الميزانية الإضافية أو \"ترخيصا خاصا\" إذا جاءت بعدها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_177_20110622_OpEnact_b32fdd65a4> ;
    dzdoc:replacementText "يتم إعداد الميزانية الأولية قبل بدء السنة المالية ويتم تعديل النفقات والإيرادات خلال السنة المالية حسب نتائج السنة المالية السابقة عن طريق ميزانية إضافية . يسمى فتح الاعتمادات المصادق عليها على انفراد في حالة الضرورة \"اعتمادات مفتوحة مسبقا\" إذا جاءت قبل الميزانية الإضافية أو \"ترخيصا خاصا\" إذا جاءت بعدها ."@ar ;
