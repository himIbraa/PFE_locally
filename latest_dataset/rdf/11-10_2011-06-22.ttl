<https://legal.dz/resource/law/2011-06-22/11-10#version_art_185> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم تضبط ميزانية البلدية نهائيا لسبب ما ، قبل بدء السنة المالية يستمر العمل بالإيرادات والنفقات العادية المقيدة في السنة المالية السابقة إلى غاية المصادقة على الميزانية الجديدة. غير أنه لا يجوز الالتزام بالنفقات وصرفها إلا في حدود جزء من اثني عشر (1/12) في الشهر من مبلغ اعتمادات السنة المالية السابقة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2011-06-22/11-10#version_art_185_20110622_OpEnact_4614b95fa2> ;
    dzdoc:replacementText "إذا لم تضبط ميزانية البلدية نهائيا لسبب ما ، قبل بدء السنة المالية يستمر العمل بالإيرادات والنفقات العادية المقيدة في السنة المالية السابقة إلى غاية المصادقة على الميزانية الجديدة. غير أنه لا يجوز الالتزام بالنفقات وصرفها إلا في حدود جزء من اثني عشر (1/12) في الشهر من مبلغ اعتمادات السنة المالية السابقة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_185> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2011-06-22/11-10> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2011-06-22/11-10#art_185> ;
