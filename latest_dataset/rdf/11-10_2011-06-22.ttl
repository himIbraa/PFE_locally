    dznorm:sourceArticle "art_40" .

<https://legal.dz/resource/law/2011-06-22/11-10#art_40_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2011-06-22/11-10#art_40> ;
    dzdoc:position 0 ;
    dzdoc:text "تزول صفة المنتخب بالوفاة أو الاستقالة أو الإقصاء أو حصول مانع قانوني."@ar .

<https://legal.dz/resource/law/2011-06-22/11-10#art_40_para_1> a dzdoc:Paragraph ;
