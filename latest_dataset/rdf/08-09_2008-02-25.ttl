    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز ل مجلس الدولة ، إذا أخطر بعريضة رفع وقف التنفيذ المأمور به من طرف المحكمة الإدارية ، أن يقرر رفعه حالا ، إذا كان من شأنه الإضرار بمصلحة عامة أو بحقوق المستأنف، وذلك إلى غاية الفصل في موضوع الاستئناف ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_911_20080225_OpEnact_adf3192600> ;
