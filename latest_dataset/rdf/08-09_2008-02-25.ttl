    dzdoc:replacementText "يمكن للقاضي أثناء تنقله، سماع أي شخص من تلقاء نفسه أو بناء على طلب أحد الخصوم إذا رأى في ذلك ضرورة . كما يجوز له في نفس الظروف سماع الخصوم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_148> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
