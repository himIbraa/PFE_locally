    dznorm:sourceArticle "art_568" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_569_condition_0_0e78f266> a dznorm:Condition ;
    dznorm:conditionText "عند انتهاء الآجال القانونية المحددة للأطراف لإيداع مذكراتهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_569> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_569_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_569> ;
    dzdoc:position 0 ;
    dzdoc:text "عند انتهاء الآجال القانونية المحددة للأطراف لإيداع مذكراتهم، يرسل أمين الضبط الرئيسي للمجلس القضائي الملف مشكلا ومره فقا بملف القضية إلى أمين الضبط الرئيسي للمحكمة العليا، الذي يحيله بدوره إلى رئيس الغرفة المعنية."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_56_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_56> ;
    dzdoc:position 0 ;
    dzdoc:text "التخلي عن النزاع بسبب الارتباط بين القضايا، يؤمر به من طرف آخر جهة قضائية أو آخر تشكيلة طرح عليها النزاع، لصالح جهة قضائية أو تشكيلة أخرى، بموجب حكم مسبب بناء على طلب أحد الخصوم أو تلقائيا."@ar .

