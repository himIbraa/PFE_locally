<https://legal.dz/resource/law/2008-02-25/08-09#version_art_376> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمحكمة العليا ، أن تستبدل سببا قانونيا خاطئا تضمنه الحكم أو القرار المطعون فيه بالنقض، بسبب قانوني صحيح، وترفض الطعن اعتمادا على ذلك . كما يجوز لها أيضا رفض الطعن بصرف النظر عن السبب القانوني الخاطئ إذا كان زائدا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_376_20080225_OpEnact_729a09befb> ;
    dzdoc:replacementText "يجوز للمحكمة العليا ، أن تستبدل سببا قانونيا خاطئا تضمنه الحكم أو القرار المطعون فيه بالنقض، بسبب قانوني صحيح، وترفض الطعن اعتمادا على ذلك . كما يجوز لها أيضا رفض الطعن بصرف النظر عن السبب القانوني الخاطئ إذا كان زائدا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_376> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
