    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1063_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_1063> ;
    dzdoc:position 0 ;
    dzdoc:text "تبقى قواعد الاختصاص النوعي والإقليمي المنصوص عليها في المادة 40 (3 و4) من هذا القانون، سارية المفعول إلى حين تنصيب الأقطاب المتخصصة."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1064_extref_25d79f82> a dzdoc:ExternalReference ;
    rdfs:label "الأمر رقم 66-154 المؤرخ في 18 صفر عام 1386 الموافق 8 يونيو سنة 1966 والمتضمن قانون الإجراءات المدنية، المعدل والمتمم"@ar ;
    dzdoc:frbrUri "/akn/dz/act/order/1966-06-08/66-154"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/order/1966-06-08/66-154"^^xsd:anyURI ;
