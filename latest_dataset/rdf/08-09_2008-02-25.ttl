<https://legal.dz/resource/law/2008-02-25/08-09#version_art_313> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "طرق الطعن العادية هي الاستئناف و المعارضة . طرق الطعن غير العادية هي اعتراض الغير الخارج عن الخصومة و التماس إعادة النظر و الطعن بالنقض . يبدأ سريان أجل الطعن ابتداء من تاريخ التبليغ الرسمي للحكم. ويسري هذا الأجل كذلك في حق من قام بالتبليغ الرسمي. يعتبر الاعتراف كتابة بالتبليغ الرسمي أثناء سير الخصومة، بمثابة التبليغ الرسمي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_313_20080225_OpEnact_c770a62219> ;
    dzdoc:replacementText "طرق الطعن العادية هي الاستئناف و المعارضة . طرق الطعن غير العادية هي اعتراض الغير الخارج عن الخصومة و التماس إعادة النظر و الطعن بالنقض . يبدأ سريان أجل الطعن ابتداء من تاريخ التبليغ الرسمي للحكم. ويسري هذا الأجل كذلك في حق من قام بالتبليغ الرسمي. يعتبر الاعتراف كتابة بالتبليغ الرسمي أثناء سير الخصومة، بمثابة التبليغ الرسمي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_313> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_313> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
