    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "لا يقبل أي تدخل بعد اختتام التحقيق."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_871_20080225_OpEnact_041b997eb7> a dzdoc:ArticleVersion ;
