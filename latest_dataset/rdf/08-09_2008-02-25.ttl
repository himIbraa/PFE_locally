    dzdoc:usesTerm dzterm:conflict_of_jurisdiction,
        dzterm:council_of_state .

<https://legal.dz/resource/law/2008-02-25/08-09#art_82> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_82" ;
    dzdoc:fullText "تنفذ إجراءات التحقيق حسب الحالة، بمبادرة من القاضي أو من أحد الخصوم، بموجب أمر شفوي أو تنفيذا لمستخرج الحكم أو نسخة منه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_82> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_82_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_82_20080225_OpEnact_5019070f12> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_82_obligation_0_5650fbfc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "82" ;
    dzdoc:position 81 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_823> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_823" ;
    dzdoc:fullText "تقيد العريضة عند إيداعها بسجل خاص يمسك بأمانة ضبط المحكمة الإدارية . يسلم أمين الضبط للمدعي وصلا يثبت إيداع العريضة، كما يؤشر على إيداع مختلف المذكرات والمستندات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_823> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_823_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_823_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_823_20080225_OpEnact_45a6d9e583> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 823" ;
    dzdoc:position 822 ;
    dzdoc:usesTerm dzterm:administrative_court,
        dzterm:clerk .

<https://legal.dz/resource/law/2008-02-25/08-09#art_824> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_824" ;
    dzdoc:fullText "تقيد العرائض وترقم في السجل حسب ترتيب ورودها. يقيد التاريخ ورقم التسجيل على العريضة وعلى المستندات المرفقة بها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_824> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_824_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_824_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_824_20080225_OpEnact_3309e9ea93> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 824" ;
    dzdoc:position 823 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_831> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_831" ;
    dzdoc:fullText "لا يحتج بأجل الطعن المنصوص عليه في المادة 829 أعلاه، إلا إذا أشير إليه في تبليغ القرار المطعون فيه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_831> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_831_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_831_20080225_OpEnact_842b2299e7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "831" ;
    dzdoc:position 830 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_829> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_829> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_831_condition_0_ddb3b5d6> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_850> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_850" ;
    dzdoc:fullText "إذا لم يقدم المدعي، رغم الإعذار الموجه له المذكرة الإضافية التي أعلن عن تقديمها، أو لم يقم بتحضير الملف يعتبر متنازلا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_850> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_850_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_850_20080225_OpEnact_90b6ff5c94> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 850" ;
    dzdoc:position 849 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_850_condition_0_f7fc5eba> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_851> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_851" ;
    dzdoc:fullText "إذا لم يقدم المدعى عليه، رغم إعذاره، أية مذكرة ، يعتبر قابلا بالوقائع الواردة في العريضة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_851> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_851_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_851_20080225_OpEnact_a1528b01a5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 851" ;
    dzdoc:position 850 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_851_condition_0_0b77bdbe> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_853> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_853" ;
    dzdoc:fullText "إذا لم يصدر رئيس تشكيلة الحكم الأمر باختتام التحقيق ، يعتبر التحقيق منتهيا ثلاثة (3) أيام قبل تاريخ الجلسة المحددة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_853> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_853_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_853_20080225_OpEnact_f0947c64bb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 853" ;
    dzdoc:position 852 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_853_condition_0_ec5166c8> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_866> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:definesTerm dzterm:incidental_requests ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_866" ;
    dzdoc:fullText "الطلبات العارضة هي الطلبات المقابلة والتدخل ويحقق فيها حسب الأشكال المقررة لعريضة افتتاح الدعوى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_866> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_866_defocc_8ab03f08d4cd> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_866_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_866_20080225_OpEnact_4da94e28f2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "866" ;
    dzdoc:position 865 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_867> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_867" ;
    dzdoc:fullText "يكون الطلب المقابل مقبولا إذا كان مرتبطا بالطلب الأصلي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_867> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_867_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_867_20080225_OpEnact_96ab837bf1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "867" ;
    dzdoc:position 866 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_867_condition_0_568501c6> ;
    dzdoc:usesTerm dzterm:counterclaim .

<https://legal.dz/resource/law/2008-02-25/08-09#art_879> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_879" ;
    dzdoc:fullText "يبلغ رئيس الجهة القضائية الإدارية نسخة من طلب الرد إلى القاضي المطلوب رده."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_879> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_879_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_879_20080225_OpEnact_1f7630c6d6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_879_obligation_0_8c03105b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "879" ;
    dzdoc:position 878 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_885> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_3> ;
    dzdoc:eId "art_885" ;
    dzdoc:fullText "يقدم محافظ الدولة طلباته بعد إتمام الإجراءات المنصوص عليها في المادة 884 أعلاه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_885> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_885_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_885_20080225_OpEnact_bbfbfa386d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_885_obligation_0_08cda778> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "885" ;
    dzdoc:position 884 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_884> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_884> ;
    dzdoc:usesTerm dzterm:state_commissioner .

<https://legal.dz/resource/law/2008-02-25/08-09#art_886> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_3> ;
    dzdoc:eId "art_886" ;
    dzdoc:fullText "المحكمة الإدارية غير ملزمة بالرد على الأوجه المقدمة شفويا بالجلسة، ما لم تؤكد بمذكرة كتابية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_886> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_886_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_886_20080225_OpEnact_e5b2549c23> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "886" ;
    dzdoc:position 885 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_886_condition_0_87a16ef8> ;
    dzdoc:usesTerm dzterm:administrative_court .

<https://legal.dz/resource/law/2008-02-25/08-09#art_888> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_888" ;
    dzdoc:fullText "تطبق المقتضيات المتعلقة بالأحكام القضائية المنصوص عليها في المواد من 270 إلى 298 من هذا القانون أمام المحاكم الإدارية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_888> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_888_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_888_20080225_OpEnact_1bf202ff10> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_888_obligation_0_86590a7f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "888" ;
    dzdoc:position 887 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_270>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_298> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_270>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_298> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_889> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_889" ;
    dzdoc:fullText "يتضمن الحكم أيضا الإشارة إلى الوثائق والنصوص المطبقة، ويشار إلى أنه تم الاستماع إلى القاضي المقرر وإلى محافظ الدولة ، وعند الاقتضاء، إلى الخصوم وممثليهم، وكذا إلى كل شخص تم سماعه بأمر من الرئيس."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_889> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_889_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_889_20080225_OpEnact_c58ba767c0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_889_obligation_0_9c5eac78> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "889" ;
    dzdoc:position 888 ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:state_commissioner .

<https://legal.dz/resource/law/2008-02-25/08-09#art_89> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_89" ;
    dzdoc:fullText "تنفذ إجراءات التحقيق أمام الجهة القضائية، في جلسة علنية أو في غرفة المشورة، حسب القواعد المعمول بها في سير الخصومة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_89> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_89_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_89_20080225_OpEnact_89d409e083> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_89_obligation_0_6b675a65> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "89" ;
    dzdoc:position 88 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_890> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_890" ;
    dzdoc:fullText "يسبق منطوق الحكم بكلمة \"يقرر\"."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_890> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_890_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_890_20080225_OpEnact_38b9144c5a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_890_obligation_0_de236d55> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "890" ;
    dzdoc:position 889 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_894> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_894" ;
    dzdoc:fullText "يتم التبليغ الرسمي للأحكام والأوامر إلى الخصوم في موطنهم، عن طريق محضر قضائي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_894> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_894_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_894_20080225_OpEnact_cef8366f1b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_894_obligation_0_7f8456ed> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "894" ;
    dzdoc:position 893 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_896> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_896" ;
    dzdoc:fullText "تطبق الأحكام المتعلقة بالمصاريف القضائية المنصوص عليها في المواد من 417 إلى 422 من هذا القانون أمام المحاكم الإدارية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_896> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_896_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_896_20080225_OpEnact_baec43d040> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_896_obligation_0_5f756b02> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "896" ;
    dzdoc:position 895 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_417>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_422> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_417>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_422> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_898> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_5> ;
    dzdoc:eId "art_898" ;
    dzdoc:fullText "يعرض محافظ الدولة تقريره المكتوب. يتضمن التقرير عرضا عن الوقائع والقانون والأوجه المثارة ورأيه حول كل مسألة مطروحة والحلول المقترحة للفصل في النزاع، ويختتم بطلبات محددة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_898> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_898_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_898_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_898_20080225_OpEnact_6f56883b8c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "898" ;
    dzdoc:position 897 ;
    dzdoc:usesTerm dzterm:state_commissioner .

<https://legal.dz/resource/law/2008-02-25/08-09#art_907> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_907" ;
    dzdoc:fullText "عندما يفصل مجلس الدولة كدرجة أولى وأخيرة ، تطبق الأحكام المتعلقة بالآجال المنصوص عليها في المواد من 829 إلى 832 أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_907> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_907_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_907_20080225_OpEnact_275205d702> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 907" ;
    dzdoc:position 906 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_829>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_832> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_829>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_832> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_907_condition_0_dc3b93aa> ;
    dzdoc:usesTerm dzterm:state_council .

<https://legal.dz/resource/law/2008-02-25/08-09#art_916> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_2_sec_3> ;
    dzdoc:eId "art_916" ;
    dzdoc:fullText "تطبق أحكام المواد من 874 إلى 900 أعلاه ، المتعلقة بالفصل في القضية أمام مجلس الدولة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_916> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_916_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_916_20080225_OpEnact_ff505a04e1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_916_obligation_0_48fa6dc2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "916" ;
    dzdoc:position 915 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_874>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_900> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_874>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_900> ;
    dzdoc:usesTerm dzterm:conseil_etat .

<https://legal.dz/resource/law/2008-02-25/08-09#art_918> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_1> ;
    dzdoc:eId "art_918" ;
    dzdoc:fullText "يأمر قاضي الاستعجال بالتدابير المؤقتة. لا ينظر في أصل الحق، ويفصل في أقرب الآجال."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_918> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_918_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_918_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_918_20080225_OpEnact_d6dee58075> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 918" ;
    dzdoc:position 917 ;
    dzdoc:usesTerm dzterm:قاضي_الاستعجال .

<https://legal.dz/resource/law/2008-02-25/08-09#art_92> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_3> ;
    dzdoc:eId "art_92" ;
    dzdoc:fullText "يفصل القاضي في الإشكالات التي قد تعترض تنفيذ التحقيق، بأمر غير قابل لأي طعن ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_92> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_92_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_92_20080225_OpEnact_058a8db741> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_92_obligation_0_95c3b8c8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 92" ;
    dzdoc:position 91 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_929> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_929" ;
    dzdoc:fullText "عندما يخطر قاضي الاستعجال بطلبات مؤسسة وفقا لأحكام المادة 919 أو المادة 920 أعلاه ، يستدعى الخصوم إلى الجلسة في أقرب الآجال وبمختلف الطرق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_929> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_929_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_929_20080225_OpEnact_85fe06dfa9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "929" ;
    dzdoc:position 928 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_919>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_920> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_919>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_920> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_929_condition_0_9d2ef525> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_941> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_3_subsec_2> ;
    dzdoc:eId "art_941" ;
    dzdoc:fullText "يتم التبليغ الرسمي للعريضة حالا إلى المدعى عليه مع تحديد أجل للرد من قبل المحكمة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_941> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_941_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_941_20080225_OpEnact_a5af42cd76> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_941_obligation_0_2568731c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 941" ;
    dzdoc:position 940 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_948> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_6> ;
    dzdoc:eId "art_948" ;
    dzdoc:fullText "يخضع الاستعجال في المادة الجبائية للقواعد المنصوص عليها في قانون الإجراءات الجبائية ولأحكام هذا الباب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_948> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_948_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_948_20080225_OpEnact_e0947e0139> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_948_obligation_0_dea28058> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "948" ;
    dzdoc:position 947 ;
    dzdoc:usesTerm dzterm:tax_matter,
        dzterm:tax_procedure_law,
        dzterm:urgency .

<https://legal.dz/resource/law/2008-02-25/08-09#art_95> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_4> ;
    dzdoc:eId "art_95" ;
    dzdoc:fullText "يخضع بطلان إجراءات التنفيذ المتعلقة بـ تدابير التحقيق للقواعد المقررة لـ بطلان الأعمال الإجرائية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_95> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_95_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_95_20080225_OpEnact_e97431dde3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_95_obligation_0_a7483d91> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "95" ;
    dzdoc:position 94 ;
    dzdoc:usesTerm dzterm:execution_procedures,
        dzterm:investigation_measures,
        dzterm:nullity,
        dzterm:procedural_acts_nullity .

<https://legal.dz/resource/law/2008-02-25/08-09#art_953> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_1_subsec_2> ;
    dzdoc:eId "art_953" ;
    dzdoc:fullText "تكون الأحكام والقرارات الصادرة غيابيا عن المحاكم الإدارية و مجلس الدولة قابلة للمعارضة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_953_right_0_985dd0f8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_953> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_953_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_953_20080225_OpEnact_bb32e6466d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "953" ;
    dzdoc:position 952 ;
    dzdoc:usesTerm dzterm:administrative_courts,
        dzterm:judgments,
        dzterm:state_council .

<https://legal.dz/resource/law/2008-02-25/08-09#art_955> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_1_subsec_2> ;
    dzdoc:eId "art_955" ;
    dzdoc:fullText "للمعارضة أثر موقف للتنفيذ ، ما لم يؤمر بخلاف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_955> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_955_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_955_20080225_OpEnact_ecc1f55cd9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "955" ;
    dzdoc:position 954 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_955_condition_0_df5d7b5a> ;
    dzdoc:usesTerm dzterm:suspensive_effect .

<https://legal.dz/resource/law/2008-02-25/08-09#art_956> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_956" ;
    dzdoc:fullText "يحدد أجل الطعن بالنقض بشهرين (2) يسري من تاريخ التبليغ الرسمي للقرار محل الطعن ، ما لم ينص القانون على خلاف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_956> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_956_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_956_20080225_OpEnact_a19a8a7d4e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 956" ;
    dzdoc:position 955 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_956_condition_0_ec35d730> ;
    dzdoc:usesTerm dzterm:delay .

<https://legal.dz/resource/law/2008-02-25/08-09#art_958> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_958" ;
    dzdoc:fullText "عندما يقرر مجلس الدولة نقض قرار مجلس المحاسبة يفصل في الموضوع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_958> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_958_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_958_20080225_OpEnact_6cdbb899ef> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 958" ;
    dzdoc:position 957 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_958_condition_0_a3a124a5> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_960> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_960" ;
    dzdoc:fullText "يهدف اعتراض الغير الخارج عن الخصومة إلى مراجعة أو إلغاء الحكم أو القرار الذي فصل في أصل النزاع. ويفصل في القضية من جديد من حيث الوقائع والقانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_960> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_960_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_960_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_960_20080225_OpEnact_bcf0867a51> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 960" ;
    dzdoc:position 959 ;
    dzdoc:usesTerm dzterm:third_party_opposition .

<https://legal.dz/resource/law/2008-02-25/08-09#art_988> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_6_sec_2> ;
    dzdoc:eId "art_988" ;
    dzdoc:fullText "في حالة رفض التظلم الموجه إلى الإدارة من أجل تنفيذ الحكم الصادر عن الجهة القضائية الإدارية، يبدأ سريان الأجل المحدد في المادة 987 أعلاه، بعد قرار الرفض."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_988> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_988_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_988_20080225_OpEnact_769493ffc3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "988" ;
    dzdoc:position 987 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_987> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_987> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_988_condition_0_886e2c5c> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_989> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_6_sec_2> ;
    dzdoc:eId "art_989" ;
    dzdoc:fullText "في نهاية كل سنة، يوجه رئيس كل محكمة إدارية تقريرا إلى رئيس مجلس الدولة حول صعوبات التنفيذ ومختلف الإشكالات المعاينة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_989> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_989_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_989_20080225_OpEnact_0be6eb4d98> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_989_obligation_0_93d60c5b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "989" ;
    dzdoc:position 988 ;
    dzdoc:usesTerm dzterm:administrative_court,
        dzterm:council_of_state .

<https://legal.dz/resource/law/2008-02-25/08-09#art_991> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_991" ;
    dzdoc:fullText "تتم محاولة الصلح في المكان والوقت الذي يراهما القاضي مناسبين، ما لم توجد نصوص خاصة في القانون تقرر خلاف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_991> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_991_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_991_20080225_OpEnact_88e861466d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 991" ;
    dzdoc:position 990 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_991_condition_0_db63b50a> ;
    dzdoc:usesTerm dzterm:reconciliation .

<https://legal.dz/resource/law/2008-02-25/08-09#art_995> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_995" ;
    dzdoc:fullText "تمتد الوساطة إلى كل النزاع أو إلى جزء منه. لا يترتب على الوساطة تخلي القاضي عن القضية، ويمكنه اتخاذ أي تدبير يراه ضروريا في أي وقت."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_995> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_995_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_995_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_995_20080225_OpEnact_ce41ae2207> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 995" ;
    dzdoc:position 994 ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:mediation .

