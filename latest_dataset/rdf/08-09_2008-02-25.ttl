    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_86> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يجوز للخصوم أن يستعينوا بمحاميهم أثناء تنفيذ إجراءات التحقيق ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_870_20080225_OpEnact_de3fe01b6b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
