<https://legal.dz/resource/law/2008-02-25/08-09#version_art_880> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على القاضي المطلوب رده أن يتنحى عن القضية، بمجرد تبليغه بطلب الرد إلى حين الفصل فيه. في حالة الاستعجال يعين رئيس الجهة القضائية الإدارية قاضيا آخر لضمان سير القضية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_880_20080225_OpEnact_f1ce6dc68a> ;
