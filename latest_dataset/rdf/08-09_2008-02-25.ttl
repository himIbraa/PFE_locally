<https://legal.dz/resource/law/2008-02-25/08-09#version_art_610> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تعرض الضابط العمومي المكلف بالتنفيذ إلى إهانة، أثناء أداء وظيفته ، وجب عليه تحرير محضر، يبين فيه مناسبة أداء مهمته، والتاريخ والساعة ومكان المهمة ، ونوع الإهانة والألفاظ الصادرة ضده، وأسماء وألقاب الأطراف والشهود الحاضرين أثناء الواقعة . وتتبع في هذا الشأن الأحكام المقررة في قانون العقوبات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_610_20080225_OpEnact_c4fad5e499> ;
    dzdoc:replacementText "إذا تعرض الضابط العمومي المكلف بالتنفيذ إلى إهانة، أثناء أداء وظيفته ، وجب عليه تحرير محضر، يبين فيه مناسبة أداء مهمته، والتاريخ والساعة ومكان المهمة ، ونوع الإهانة والألفاظ الصادرة ضده، وأسماء وألقاب الأطراف والشهود الحاضرين أثناء الواقعة . وتتبع في هذا الشأن الأحكام المقررة في قانون العقوبات ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_610> ;
