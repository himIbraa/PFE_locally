    dzdoc:targetEId "art_829" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_848_obligation_0_8d98ea72> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
