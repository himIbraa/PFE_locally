<https://legal.dz/resource/law/2008-02-25/08-09#art_473_condition_0_cf33ec76> a dznorm:Condition ;
    dznorm:conditionText "إذا قصر الولي أو الوصي أو المقدم في أداء مهامه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_473> ;
