<https://legal.dz/resource/law/2008-02-25/08-09#version_art_1040> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسري اتفاقية التحكيم على النزاعات القائمة والمستقبلية. يجب من حيث الشكل، وتحت طائلة البطلان، أن تبرم اتفاقية التحكيم كتابة، أو بأية وسيلة اتصال أخرى تجيز الإثبات بالكتابة . تكون اتفاقية التحكيم صحيحة من حيث الموضوع، إذا استجابت للشروط التي يضعها إما القانون الذي اتفق الأطراف على اختياره أو القانون المنظم لموضوع النزاع أو القانون الذي يراه المحكم ملائما . لا يمكن الاحتجاج بعدم صحة اتفاقية التحكيم ، بسبب عدم صحة العقد الأصلي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1040_20080225_OpEnact_c1f144de15> ;
    dzdoc:replacementText "تسري اتفاقية التحكيم على النزاعات القائمة والمستقبلية. يجب من حيث الشكل، وتحت طائلة البطلان، أن تبرم اتفاقية التحكيم كتابة، أو بأية وسيلة اتصال أخرى تجيز الإثبات بالكتابة . تكون اتفاقية التحكيم صحيحة من حيث الموضوع، إذا استجابت للشروط التي يضعها إما القانون الذي اتفق الأطراف على اختياره أو القانون المنظم لموضوع النزاع أو القانون الذي يراه المحكم ملائما . لا يمكن الاحتجاج بعدم صحة اتفاقية التحكيم ، بسبب عدم صحة العقد الأصلي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_1040> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_1040> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_1041> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن للأطراف، مباشرة أو بالرجوع إلى نظام التحكيم ، تعيين المحكم أو المحكمين أو تحديد شروط تعيينهم وشروط عزلهم أو استبدالهم . في غياب التعيين، وفي حالة صعوبة تعيين المحكمين أو عزلهم أو استبدالهم ، يجوز للطرف الذي يهمه التعجيل القيام بما يأتي : 1- رفع الأمر إلى رئيس المحكمة التي يقع في دائرة اختصاصها التحكيم إذا كان التحكيم يجري في الجزائر، 2- رفع الأمر إلى رئيس محكمة الجزائر، إذا كان التحكيم يجري في الخارج واختار الأطرف تطبيق قواعد الإجراءات المعمول بها في الجزائر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1041_20080225_OpEnact_22fcc5872d> ;
    dzdoc:replacementText "يمكن للأطراف، مباشرة أو بالرجوع إلى نظام التحكيم ، تعيين المحكم أو المحكمين أو تحديد شروط تعيينهم وشروط عزلهم أو استبدالهم . في غياب التعيين، وفي حالة صعوبة تعيين المحكمين أو عزلهم أو استبدالهم ، يجوز للطرف الذي يهمه التعجيل القيام بما يأتي : 1- رفع الأمر إلى رئيس المحكمة التي يقع في دائرة اختصاصها التحكيم إذا كان التحكيم يجري في الجزائر، 2- رفع الأمر إلى رئيس محكمة الجزائر، إذا كان التحكيم يجري في الخارج واختار الأطرف تطبيق قواعد الإجراءات المعمول بها في الجزائر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_1041> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_1041> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_1042> a dzdoc:AmendmentEvent,
