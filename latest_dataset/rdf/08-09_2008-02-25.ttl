<https://legal.dz/resource/law/2008-02-25/08-09#version_art_62> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للقاضي أن يمنح أجلا للخصوم لتصحيح الإجراء المشوب بالبطلان ، بشرط عدم بقاء أي ضرر قائم بعد التصحيح . يسري أثر هذا التصحيح من تاريخ الإجراء المشوب بالبطلان."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_62_20080225_OpEnact_7c5ee487ae> ;
    dzdoc:replacementText "يجوز للقاضي أن يمنح أجلا للخصوم لتصحيح الإجراء المشوب بالبطلان ، بشرط عدم بقاء أي ضرر قائم بعد التصحيح . يسري أثر هذا التصحيح من تاريخ الإجراء المشوب بالبطلان."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_62> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_62> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
