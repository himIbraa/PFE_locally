<https://legal.dz/resource/law/2008-02-25/08-09#art_85> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_85" ;
    dzdoc:fullText "يتم إخطار الخصوم لحضور إجراءات التحقيق المأمور به شفاهة بالجلسة أو بواسطة محاميهم . في حالة غيابهم ومحاميهم عن الجلسة التي أمر فيها بإجراء التحقيق ، يتم استدعاؤهم برسالة مضمنة مع الإشعار بالاستلام من طرف أمين ضبط الجهة القضائية . ويتم استدعاء الغير بالحضور لنفس الغرض حسب نفس الإجراء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_85> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_85_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_85_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_85_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_85_20080225_OpEnact_d7c51ae60b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_85_obligation_0_0b536983>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_85_obligation_1_ef5a671a>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_85_obligation_2_e0f7f668> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "85" ;
    dzdoc:position 84 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_85_condition_0_1467b64f> ;
    dzdoc:usesTerm dzterm:clerk .

<https://legal.dz/resource/law/2008-02-25/08-09#art_893> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_893" ;
    dzdoc:fullText "تحفظ أصول الأحكام والأوامر بأمانة ضبط المحكمة الإدارية لكل قضية مع الوثائق المتعلقة بالتحقيق. يستعيد الخصوم الوثائق المملوكة لهم، بناء على طلبهم مقابل وصل بالاستلام ما لم يأمر رئيس المحكمة الإدارية أن بعض هذه الوثائق تبقى ملحقة بالحكم . في حالة استئناف الحكم أو الأمر ، يرسل ملف القضية مع الوثائق المرفقة به، إلى جهة الاستئناف ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_893_right_0_120ec6ee> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_893> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_893_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_893_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_893_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_893_20080225_OpEnact_aaf40df726> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_893_obligation_0_bcd86329>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_893_obligation_1_de51ba50> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "893" ;
    dzdoc:position 892 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_893_condition_0_bb9b43c6>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_893_condition_1_9c5573a5> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_924> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_924" ;
    dzdoc:fullText "عندما لا يتوفر الاستعجال في الطلب، أو يكون غير مؤسس ، يرفض قاضي الاستعجال هذا الطلب بأمر مسبب. وعندما يظهر أن الطلب لا يدخل في اختصاص الجهة القضائية الإدارية ، يحكم القاضي بعدم الاختصاص النوعي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_924> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_924_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_924_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_924_20080225_OpEnact_b4e5b816b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "924" ;
    dzdoc:position 923 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_924_condition_0_10bab502>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_924_condition_1_f39803b1> ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_932> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_932" ;
    dzdoc:fullText "خلافا لأحكام المادة 843 أعلاه، يجوز إخبار الخصوم بالأوجه المثارة الخاصة بالنظام العام خلال الجلسة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_932_permission_0_ce9d720b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_932> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_932_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_932_20080225_OpEnact_b5f1d1ac3a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "932" ;
    dzdoc:position 931 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_843> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_843> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_942> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_4> ;
    dzdoc:eId "art_942" ;
    dzdoc:fullText "يجوز ل قاضي الاستعجال أن يمنح تسبيقا ماليا إلى الدائن الذي رفع دعوى في الموضوع أمام المحكمة الإدارية ، ما لم ينازع في وجود الدين بصفة جدية . ويجوز له ولو تلقائيا، أن يخضع دفع هذا التسبيق لتقديم ضمان ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_942_permission_0_a489e7e5> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_942_right_0_0fe3807a>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_942_right_1_cff73c4d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_942> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_942_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_942_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_942_20080225_OpEnact_a2df3053db> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "942" ;
    dzdoc:position 941 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_942_condition_0_283f1e27> ;
    dzdoc:usesTerm dzterm:administrative_court,
        dzterm:creditor,
        dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_967> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_2_subsec_4> ;
    dzdoc:eId "art_967" ;
    dzdoc:fullText "يمكن تقديم التماس إعادة النظر في إحدى الحالتين الآتيتين : إذا اكتشف أن القرار قد صدر بناء على وثائق مزورة قدمت لأول مرة أمام مجلس الدولة ، إذا حكم على خصم بسبب عدم تقديم وثيقة قاطعة كانت محتجزة عند الخصم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_967_permission_0_a9deb086> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_967> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_967_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_967_20080225_OpEnact_dd5562d80c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 967" ;
    dzdoc:position 966 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_967_condition_0_15ab910d>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_967_condition_1_810e582c> ;
    dzdoc:usesTerm dzterm:التماس_إعادة_النظر,
        dzterm:مجلس_الدولة .

