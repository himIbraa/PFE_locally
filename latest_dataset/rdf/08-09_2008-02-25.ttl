<https://legal.dz/resource/law/2008-02-25/08-09#version_art_46> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للخصوم الحضور باختيارهم أمام القاضي ، حتى ولو لم يكن مختصا إقليميا. يوقع الخصوم على تصريح بطلب التقاضي ، وإذا تعذر التوقيع يشار إلى ذلك. يكون القاضي مختصا طيلة الخصومة، ويمتد الاختصاص في حالة الاستئناف إلى المجلس القضائي التابع له."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_46_20080225_OpEnact_972a38dde4> ;
    dzdoc:replacementText "يجوز للخصوم الحضور باختيارهم أمام القاضي ، حتى ولو لم يكن مختصا إقليميا. يوقع الخصوم على تصريح بطلب التقاضي ، وإذا تعذر التوقيع يشار إلى ذلك. يكون القاضي مختصا طيلة الخصومة، ويمتد الاختصاص في حالة الاستئناف إلى المجلس القضائي التابع له."@ar ;
