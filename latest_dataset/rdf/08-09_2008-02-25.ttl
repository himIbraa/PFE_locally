<https://legal.dz/resource/law/2008-02-25/08-09#version_art_763> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتضمن حكم رسو المزاد، فضلا عن بيانات الأحكام المألوفة وأسماء وألقاب الأطراف ما يأتي : السند التنفيذي الذي بموجبه تم الحجز والإجراءات التي تلته، لا سيما تاريخ كل من التبليغ الرسمي والتكليف بالوفاء وإعلان البيع، تعيين العقار و/أو الحق العيني العقاري المباع ومشتملاته والارتفاقات العالقة به إن وجدت، كما هو معين في قائمة شروط البيع، تحديد الثمن الأساسي للعقار و/أو الحق العيني العقاري المباع، إجراءات البيع بالمزاد العلني، الهوية الكاملة للراسي عليه المزاد شخصا طبيعيا أو معنويا، الثمن الراسي به المزاد "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_763_20080225_OpEnact_e8416f66cf> ;
    dzdoc:replacementText "يتضمن حكم رسو المزاد، فضلا عن بيانات الأحكام المألوفة وأسماء وألقاب الأطراف ما يأتي : السند التنفيذي الذي بموجبه تم الحجز والإجراءات التي تلته، لا سيما تاريخ كل من التبليغ الرسمي والتكليف بالوفاء وإعلان البيع، تعيين العقار و/أو الحق العيني العقاري المباع ومشتملاته والارتفاقات العالقة به إن وجدت، كما هو معين في قائمة شروط البيع، تحديد الثمن الأساسي للعقار و/أو الحق العيني العقاري المباع، إجراءات البيع بالمزاد العلني، الهوية الكاملة للراسي عليه المزاد شخصا طبيعيا أو معنويا، الثمن الراسي به المزاد وتاريخ الدفع، إلزام المحجوز عليه أو الحائز أو الكفيل العيني أو الحارس حسب الأحوال بتسليم العقار و/أو الحق العيني العقاري لمن رسا عليه المزاد."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_763> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_763> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_764> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يبلغ حكم رسو المزاد لأطراف الحجز، ويتم تنفيذه جبرا على الأشخاص المذكورين في المادة 763 -7 أعلاه. يترتب على قيد حكم رسو المزاد بالمحافظة العقارية تطهير العقار و/أو الحق العيني العقاري من كل التأمينات العينية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_764_20080225_OpEnact_626567d662> ;
    dzdoc:replacementText "لا يبلغ حكم رسو المزاد لأطراف الحجز، ويتم تنفيذه جبرا على الأشخاص المذكورين في المادة 763 -7 أعلاه. يترتب على قيد حكم رسو المزاد بالمحافظة العقارية تطهير العقار و/أو الحق العيني العقاري من كل التأمينات العينية."@ar ;
