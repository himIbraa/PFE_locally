<https://legal.dz/resource/law/2008-02-25/08-09#version_art_501> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤول الاختصاص الإقليمي إلى المحكمة التي تم في دائرة اختصاصها إبرام عقد العمل أو تنفيذه أو التي يوجد بها موطن المدعى عليه. غير أنه في حالة إنهاء أو تعليق عقد العمل بسبب حادث عمل أو مرض مهني ، يؤول الاختصاص إلى المحكمة التي يوجد بها موطن المدعي."@ar ;
    dzdoc:isAuthoritative true ;
