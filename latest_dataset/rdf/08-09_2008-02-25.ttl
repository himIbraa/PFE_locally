<https://legal.dz/resource/law/2008-02-25/08-09#art_1015> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_1_subsec_3> ;
    dzdoc:eId "art_1015" ;
    dzdoc:fullText "لا يعد تشكيل محكمة التحكيم صحيحا، إلا إذا قبل المحكم أو المحكمون بالمهمة المسندة إليهم . إذا علم المحكم أنه قابل للرد ، يخبر الأطراف بذلك ، و لا يجوز له القيام بالمهمة إلا بعد موافقتهم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_1015_permission_0_87d69489> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1015> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1015_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1015_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1015_20080225_OpEnact_5f5e92e7ae> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_1015_obligation_0_0bb86085>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1015_obligation_1_ede08fc1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "1015" ;
    dzdoc:position 1014 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_1015_condition_0_4f44e14d>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1015_condition_1_11b82e58> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1055> a dzdoc:Article ;
