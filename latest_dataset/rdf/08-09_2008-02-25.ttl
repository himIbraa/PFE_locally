    dzdoc:evidenceText "لا يترتب على إفلاس المدين المحجوز عليه وقف إجراءات التوزيع ولو حدد التوقف عن الدفع بتاريخ سابق على الشروع في التوزيع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
