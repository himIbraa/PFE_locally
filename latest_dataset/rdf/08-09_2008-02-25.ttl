<https://legal.dz/resource/law/2008-02-25/08-09#art_201_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_201> ;
    dzdoc:position 0 ;
