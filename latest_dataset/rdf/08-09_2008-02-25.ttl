<https://legal.dz/resource/law/2008-02-25/08-09#version_art_180> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يثار الادعاء الفرعي بالتزوير بمذكرة تودع أمام القاضي الذي ينظر في الدعوى الأصلية. وتتضمن هذه المذكرة بدقة، الأوجه التي يستند عليها الخصم لإثبات التزوير، تحت طائلة عدم قبول الادعاء. يجب على المدعي في الطلب الفرعي تبليغ هذه المذكرة إلى خصمه ، ويحدد القاضي الأجل الذي يمنحه للمدعى عليه للرد على هذا الطلب."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_180_20080225_OpEnact_bd8429fea5> ;
    dzdoc:replacementText "يثار الادعاء الفرعي بالتزوير بمذكرة تودع أمام القاضي الذي ينظر في الدعوى الأصلية. وتتضمن هذه المذكرة بدقة، الأوجه التي يستند عليها الخصم لإثبات التزوير، تحت طائلة عدم قبول الادعاء. يجب على المدعي في الطلب الفرعي تبليغ هذه المذكرة إلى خصمه ، ويحدد القاضي الأجل الذي يمنحه للمدعى عليه للرد على هذا الطلب."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_180> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_180> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
