    dznorm:position 0 ;
    dznorm:provisionText "يجب إرفاق عريضة الطعن بالنقض تحت طائلة عدم قبول الطعن شكلا تلقائيا، بالوثائق الآتية :"@ar ;
    dznorm:sourceArticle "art_566" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_566_obligation_0_8110978b_action_6e32536f92> a dznorm:Action ;
    rdfs:label "إرفاق عريضة الطعن بالنقض تحت"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب إرفاق عريضة الطعن بالنقض تحت طائلة عدم قبول الطعن شكلا تلقائيا، بالوثائق الآتية :"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_566> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_566_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_566> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب إرفاق عريضة الطعن بالنقض تحت طائلة عدم قبول الطعن شكلا تلقائيا، بالوثائق الآتية : 1 - نسخة مطابقة لأصل القرار أو الحكم محل الطعن مرفقة بمحاضر التبليغ الرسمي إن وجدت. 2- نسخة من الحكم المؤيد أو الملغى بالقرار محل الطعن، 3 - الوثائق المشار إليها في مرفقات عريضة الطعن، 4- وصل دفع الرسم القضائي لدى أمين الضبط الرئيسي لدى المحكمة العليا أو المجلس القضائي، 5- نسخة من محاضر التبليغ الرسمي للتصريح و/أو لعريضة الطعن بالنقض إلى المطعون ضده."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_567_obligation_0_e7c9186c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
