<https://legal.dz/resource/law/2008-02-25/08-09#version_art_580> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتوقف الخصومة في القضايا التي لم توضع في المداولة، في حالة : وفاة أحد الخصوم، وفاة أو استقالة أو توقيف أو تشطيب أو تنحية المحامي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
