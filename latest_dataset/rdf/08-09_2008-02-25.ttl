    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "1025" ;
    dzdoc:position 1024 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1034> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_4> ;
    dzdoc:eId "art_1034" ;
    dzdoc:fullText "تكون القرارات الفاصلة في الاستئناف وحدها قابلة للطعن بالنقض طبقا للأحكام المنصوص عليها في هذا القانون."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_1034_right_0_9bd8bcfd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1034> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1034_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1034_20080225_OpEnact_6ea2e53579> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "1034" ;
    dzdoc:position 1033 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1036> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_5> ;
    dzdoc:eId "art_1036" ;
    dzdoc:fullText "يسلم رئيس أمناء الضبط نسخة رسمية ممهورة بالصيغة التنفيذية من حكم التحكيم لمن يطلبها من الأطراف ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1036> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1036_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1036_20080225_OpEnact_c4e059291f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_1036_obligation_0_45a3cfe0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "1036" ;
    dzdoc:position 1035 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1039> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:definesTerm dzterm:تحكيم_دولي ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_6_subsec_1> ;
    dzdoc:eId "art_1039" ;
    dzdoc:fullText "يعد التحكيم دوليا، بمفهوم هذا القانون التحكيم الذي يخص النزاعات المتعلقة بالمصالح الاقتصادية لدولتين على الأقل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1039> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_1039_defocc_7081c7170c8c> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1039_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1039_20080225_OpEnact_4418984a68> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 1039" ;
    dzdoc:position 1038 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1047> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_6_subsec_2> ;
    dzdoc:eId "art_1047" ;
    dzdoc:fullText "تتولى محكمة التحكيم البحث عن الأدلة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1047> ;
