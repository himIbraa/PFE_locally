<https://legal.dz/resource/law/2008-02-25/08-09#version_art_649> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم الحجز التحفظي بموجب أمر على عريضة من رئيس المحكمة التي يوجد في دائرة اختصاصها موطن المدين أو مقر الأموال المطلوب حجزها. يلزم رئيس المحكمة بالفصل في طلب الحجز في أجل أقصاه خمسة (5) أيام من تاريخ إيداع العريضة بأمانة الضبط ."@ar ;
