<https://legal.dz/resource/law/2008-02-25/08-09#version_art_276> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يتضمن الحكم البيانات الآتية : 1 - الجهة القضائية التي أصدرته، 2- أسماء وألقاب وصفات القضاة الذين تداولوا في القضية، 3- تاريخ النطق به، 4- اسم ولقب ممثل النيابة العامة عند الاقتضاء، 5- اسم ولقب أمين الضبط الذي حضر مع تشكيلة الحكم، 6- أسماء وألقاب الخصوم وموطن كل منهم ، وفي حالة الشخص المعنوي تذكر طبيعته وتسميته ومقره الاجتماعي وصفة ممثله القانوني أو الاتفاقي، 7- أسماء وألقاب المحامين أو أي شخص قام بتمثيل أو مساعدة الخصوم، 8- الإشارة إلى عبارة النطق بالحكم في جلسة علنية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_276_20080225_OpEnact_7c16b88178> ;
    dzdoc:replacementText "يجب أن يتضمن الحكم البيانات الآتية : 1 - الجهة القضائية التي أصدرته، 2- أسماء وألقاب وصفات القضاة الذين تداولوا في القضية، 3- تاريخ النطق به، 4- اسم ولقب ممثل النيابة العامة عند الاقتضاء، 5- اسم ولقب أمين الضبط الذي حضر مع تشكيلة الحكم، 6- أسماء وألقاب الخصوم وموطن كل منهم ، وفي حالة الشخص المعنوي تذكر طبيعته وتسميته ومقره الاجتماعي وصفة ممثله القانوني أو الاتفاقي، 7- أسماء وألقاب المحامين أو أي شخص قام بتمثيل أو مساعدة الخصوم، 8- الإشارة إلى عبارة النطق بالحكم في جلسة علنية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_276> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_276> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_277> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز النطق بالحكم إلا بعد تسبيبه ، و يجب أن يسبب الحكم من حيث الوقائع والقانون، وأن يشار إلى النصوص المطبقة . يجب أيضا أن يستعرض بإيجاز، وقائع القضية وطلبات وادعاءات الخصوم ووسائل دفاعهم . ويجب أن يرد على كل الطلبات والأوجه المثارة . يتضمن ما قضى به في شكل منطوق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_277_20080225_OpEnact_8fa0361046> ;
    dzdoc:replacementText "لا يجوز النطق بالحكم إلا بعد تسبيبه ، و يجب أن يسبب الحكم من حيث الوقائع والقانون، وأن يشار إلى النصوص المطبقة . يجب أيضا أن يستعرض بإيجاز، وقائع القضية وطلبات وادعاءات الخصوم ووسائل دفاعهم . ويجب أن يرد على كل الطلبات والأوجه المثارة . يتضمن ما قضى به في شكل منطوق."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_277> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
