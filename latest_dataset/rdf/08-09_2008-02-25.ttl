<https://legal.dz/resource/law/2008-02-25/08-09#version_art_139> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يرخص للخبير باقتطاع تسبيق من المبلغ المودع بأمانة الضبط، إلا إذا قدم تبريرا عن هذا إذا تبين أن المبلغ المودع بأمانة الضبط لتغطية أتعاب الخبير غير كاف يحدد القاضي مبلغا إضافيا وأجلا لإيداعه. في حالة عدم إيداع المبلغ المحدد في الأجل المقرر ، يودع الخبير تقريره على الحالة التي يوجد عليها، ويستغني عما تبقى من إجراءات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
