<https://legal.dz/resource/law/2008-02-25/08-09#art_934_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_934> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم التبليغ الرسمي للأمر الإستعجالي، وعند الاقتضاء، يبلغ بكل الوسائل وفي أقرب الآجال."@ar .

