<https://legal.dz/resource/law/2008-02-25/08-09#art_661_extref_6091b5e0> a dzdoc:ExternalReference ;
    rdfs:label "قانون العقوبات"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-156" ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/1966-06-08/66-156> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-156"^^xsd:anyURI .

<https://legal.dz/resource/law/2008-02-25/08-09#art_661_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_661> ;
    dzdoc:position 0 ;
    dzdoc:text "كل تصرف قانوني من المدين في الأموال المحجوزة، لا يكون نافذا. ويترتب على التصرفات القانونية أو الأعمال المادية المضرة بالحاجز، تعرضه للعقوبات المتعلقة بجرائم الأموال المحجوزة المنصوص عليها في قانون العقوبات."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_661_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_661> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أنه يجوز للمدين أن يؤجر الأموال المحجوزة بترخيص من رئيس المحكمة الذي أمر بالحجز وذلك بأمر على عريضة."@ar .

