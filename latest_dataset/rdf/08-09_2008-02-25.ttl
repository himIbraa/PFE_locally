<https://legal.dz/resource/law/2008-02-25/08-09#version_art_64> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "حالات بطلان العقود غير القضائية والإجراءات من حيث موضوعها محددة على سبيل الحصر فيما يأتي : انعدام الأهلية للخصوم، انعدام الأهلية أو التفويض لممثل الشخص الطبيعي أو المعنوي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
