<https://legal.dz/resource/law/2008-02-25/08-09#version_art_756> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجري بيع العقارات و/أو الحقوق العينية العقارية بالتتابع، و إذا تناول البيع عدة عقارات و/أو حقوق عينية عقارية تقع في دوائر محاكم مختلفة ، يتم البيع حسب تتابع قيد الحجز المنصوص عليه في المادة 724 أعلاه. غير أنه إذا كان الثمن الناتج من بيع عقار و/أو حق عيني عقاري واحد أو أكثر، كافيا للوفاء بأصل الدين والمصاريف القضائية ، يأمر الرئيس الذي أشرف على البيع بالتوقف عن بيع باقي العقارات و/أو الحقوق العينية العقارية المحجوزة ورفع الحجز عنها تلقائيا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_756_20080225_OpEnact_b14fe88602> ;
    dzdoc:replacementText "يجري بيع العقارات و/أو الحقوق العينية العقارية بالتتابع، و إذا تناول البيع عدة عقارات و/أو حقوق عينية عقارية تقع في دوائر محاكم مختلفة ، يتم البيع حسب تتابع قيد الحجز المنصوص عليه في المادة 724 أعلاه. غير أنه إذا كان الثمن الناتج من بيع عقار و/أو حق عيني عقاري واحد أو أكثر، كافيا للوفاء بأصل الدين والمصاريف القضائية ، يأمر الرئيس الذي أشرف على البيع بالتوقف عن بيع باقي العقارات و/أو الحقوق العينية العقارية المحجوزة ورفع الحجز عنها تلقائيا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_756> ;
