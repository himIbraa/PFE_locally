<https://legal.dz/resource/law/2008-02-25/08-09#version_art_488> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم التبليغ الرسمي للأمر الذي يصرح بافتتاح التقديم أو برفض الطلب، بتسخيرة من النيابة العامة، عن طريق المحضر القضائي بدون رسوم ومصاريف إلى الشخص المعني وإلى من قدم الطلب. يرفع الاستئناف في هذا الأمر في أجل خمسة عشر (15) يوما . يسري هذا الأجل تجاه الأطراف ابتداء من تاريخ التبليغ الرسمي. ويسري ابتداء من تاريخ النطق به بالنسبة للنيابة العامة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_488_20080225_OpEnact_790eb0a601> ;
    dzdoc:replacementText "يتم التبليغ الرسمي للأمر الذي يصرح بافتتاح التقديم أو برفض الطلب، بتسخيرة من النيابة العامة، عن طريق المحضر القضائي بدون رسوم ومصاريف إلى الشخص المعني وإلى من قدم الطلب. يرفع الاستئناف في هذا الأمر في أجل خمسة عشر (15) يوما . يسري هذا الأجل تجاه الأطراف ابتداء من تاريخ التبليغ الرسمي. ويسري ابتداء من تاريخ النطق به بالنسبة للنيابة العامة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
