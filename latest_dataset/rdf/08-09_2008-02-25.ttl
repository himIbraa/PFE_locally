    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_976> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_976_condition_2_4c5ddfe7> a dznorm:Condition ;
    dznorm:conditionText "عندما يتعلق التحكيم بمؤسسة عمومية ذات صبغة إدارية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_976> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_976_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_976> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق الأحكام المتعلقة بالتحكيم المنصوص عليها في هذا القانون، أمام الجهات القضائية الإدارية."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_976_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_976> ;
    dzdoc:position 1 ;
    dzdoc:text "عندما يكون التحكيم متعلقا بالدولة، يتم اللجوء إلى هذا الإجراء بمبادرة من الوزير المعني أو الوزراء المعنيين."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_976_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_976> ;
    dzdoc:position 2 ;
    dzdoc:text "عندما يتعلق التحكيم بالولاية أو البلدية، يتم اللجوء إلى هذا الإجراء على التوالي، بمبادرة من الوالي أو من رئيس المجلس الشعبي البلدي."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_976_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_976> ;
    dzdoc:position 3 ;
    dzdoc:text "عندما يتعلق التحكيم بمؤسسة عمومية ذات صبغة إدارية، يتم اللجوء إلى هذا الإجراء بمبادرة من ممثلها القانوني، أو من ممثل السلطة الوصية التي يتبعها."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_977_obligation_0_db14119b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
