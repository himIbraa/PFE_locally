<https://legal.dz/resource/law/2008-02-25/08-09#version_art_75> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن للقاضي بناء على طلب الخصوم ، أو من تلقاء نفسه، أن يأمر شفاهة أو كتابة بأي إجراء من إجراءات التحقيق التي يسمح بها القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_75_20080225_OpEnact_3fdb8d0e46> ;
    dzdoc:replacementText "يمكن للقاضي بناء على طلب الخصوم ، أو من تلقاء نفسه، أن يأمر شفاهة أو كتابة بأي إجراء من إجراءات التحقيق التي يسمح بها القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_75> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_75> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
