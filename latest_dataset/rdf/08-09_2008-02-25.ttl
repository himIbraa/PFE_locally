<https://legal.dz/resource/law/2008-02-25/08-09#version_art_56> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "التخلي عن النزاع بسبب الارتباط بين القضايا، يؤمر به من طرف آخر جهة قضائية أو آخر تشكيلة طرح عليها النزاع، لصالح جهة قضائية أو تشكيلة أخرى، بموجب حكم مسبب بناء على طلب أحد الخصوم أو تلقائيا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_56_20080225_OpEnact_3bc208addb> ;
