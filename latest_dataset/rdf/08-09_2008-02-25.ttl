<https://legal.dz/resource/law/2008-02-25/08-09#version_art_884> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "بعد تلاوة القاضي المقرر للتقرير المعد حول القضية، يجوز للخصوم تقديم ملاحظاتهم الشفوية تدعيما لطلباتهم الكتابية . يمكن أيضا لرئيس تشكيلة الحكم الاستماع إلى أعوان الإدارة المعنية أو دعوتهم لتقديم توضيحات . يمكنه أيضا، خلال الجلسة، وبصفة استثنائية، أن يطلب توضيحات من كل شخص حاضر يرغب أحد الخصوم في سماعه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_884_20080225_OpEnact_2a179efd99> ;
    dzdoc:replacementText "بعد تلاوة القاضي المقرر للتقرير المعد حول القضية، يجوز للخصوم تقديم ملاحظاتهم الشفوية تدعيما لطلباتهم الكتابية . يمكن أيضا لرئيس تشكيلة الحكم الاستماع إلى أعوان الإدارة المعنية أو دعوتهم لتقديم توضيحات . يمكنه أيضا، خلال الجلسة، وبصفة استثنائية، أن يطلب توضيحات من كل شخص حاضر يرغب أحد الخصوم في سماعه ."@ar ;
