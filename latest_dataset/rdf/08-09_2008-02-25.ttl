    dzdoc:number "96" ;
    dzdoc:position 95 ;
    dzdoc:usesTerm dzterm:investigation_operations,
        dzterm:nullity .

<https://legal.dz/resource/law/2008-02-25/08-09#art_961> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_961" ;
    dzdoc:fullText "تطبق الأحكام المتعلقة بـ اعتراض الغير الخارج عن الخصومة المنصوص عليها في المواد من 381 إلى 389 من هذا القانون أمام الجهات القضائية الإدارية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_961> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_961_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_961_20080225_OpEnact_0ec5241f01> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 961" ;
    dzdoc:position 960 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_381>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_389> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_381>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_389> ;
    dzdoc:usesTerm dzterm:third_party_opposition .

<https://legal.dz/resource/law/2008-02-25/08-09#art_962> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_962" ;
    dzdoc:fullText "يجرى التحقيق في اعتراض الغير الخارج عن الخصومة بنفس الأشكال المتعلقة بالعريضة المنصوص عليها في المادة 815 وما يليها من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_962> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_962_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_962_20080225_OpEnact_f08d5d7d58> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 962" ;
    dzdoc:position 961 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_815> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_815> ;
    dzdoc:usesTerm dzterm:third_party_opposition .

<https://legal.dz/resource/law/2008-02-25/08-09#art_963> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_2_subsec_3> ;
    dzdoc:eId "art_963" ;
    dzdoc:fullText "تطبق أحكام المادتين 286 و 287 من هذا القانون على تصحيح الأخطاء المادية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_963> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_963_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_963_20080225_OpEnact_7206ca8e01> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 963" ;
    dzdoc:position 962 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_286>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_287> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_286>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_287> ;
    dzdoc:usesTerm dzterm:material_errors .

<https://legal.dz/resource/law/2008-02-25/08-09#art_965> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_2_subsec_3> ;
    dzdoc:eId "art_965" ;
    dzdoc:fullText "ترفع دعوى تفسير الأحكام ويفصل فيها وفقا للأشكال والإجراءات المنصوص عليها في المادة 285 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_965> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_965_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_965_20080225_OpEnact_c443e11333> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 965" ;
    dzdoc:position 964 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_285> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_285> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_968> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_2_subsec_4> ;
    dzdoc:eId "art_968" ;
    dzdoc:fullText "يحدد أجل الطعن ب التماس إعادة النظر بشهرين (2) يسري من تاريخ التبليغ الرسمي للقرار أو من تاريخ اكتشاف التزوير أو من تاريخ استرداد الوثيقة المحتجزة بغير حق من طرف الخصم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_968> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_968_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_968_20080225_OpEnact_4cdf72e989> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 968" ;
    dzdoc:position 967 ;
    dzdoc:usesTerm dzterm:التماس_إعادة_النظر .

<https://legal.dz/resource/law/2008-02-25/08-09#art_972> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_5_sec_1> ;
    dzdoc:eId "art_972" ;
    dzdoc:fullText "يتم إجراء الصلح بسعي من الخصوم أو بمبادرة من رئيس تشكيلة الحكم بعد موافقة الخصوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_972> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_972_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_972_20080225_OpEnact_1701bc7ca8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 972" ;
    dzdoc:position 971 ;
    dzdoc:usesTerm dzterm:conciliation .

<https://legal.dz/resource/law/2008-02-25/08-09#art_982> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_6_sec_1> ;
    dzdoc:eId "art_982" ;
    dzdoc:fullText "تكون الغرامة التهديدية مستقلة عن تعويض الضرر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_982> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_982_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_982_20080225_OpEnact_e870009d7f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "982" ;
    dzdoc:position 981 ;
    dzdoc:usesTerm dzterm:fine .

<https://legal.dz/resource/law/2008-02-25/08-09#art_99> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_5> ;
    dzdoc:eId "art_99" ;
    dzdoc:fullText "يحضر الخصوم شخصيا أمام الجهة القضائية في جلسة علنية أو في غرفة المشورة، طبقا للقواعد التي تحكم سير الخصومة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_99> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_99_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_99_20080225_OpEnact_40474e3dd4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 99" ;
    dzdoc:position 98 ;
    dzdoc:usesTerm dzterm:litigants .

<https://legal.dz/resource/law/2008-02-25/08-09#art_992> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_992" ;
    dzdoc:fullText "يثبت الصلح في محضر ، يوقع عليه الخصوم والقاضي وأمين الضبط ويودع بأمانة ضبط الجهة القضائية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_992> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_992_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_992_20080225_OpEnact_aee0ad9fcf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 992" ;
    dzdoc:position 991 ;
    dzdoc:usesTerm dzterm:reconciliation .

<https://legal.dz/resource/law/2008-02-25/08-09#art_993> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_993" ;
    dzdoc:fullText "يعد محضر الصلح سندا تنفيذيا بمجرد إيداعه بأمانة الضبط."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_993> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_993_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_993_20080225_OpEnact_78a876305c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 993" ;
    dzdoc:position 992 ;
    dzdoc:usesTerm dzterm:enforcement_order,
        dzterm:reconciliation_minutes .

