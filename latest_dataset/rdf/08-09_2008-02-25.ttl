    dzdoc:position 0 ;
    dzdoc:text "يفصل القاضي في طلب الكفالة بأمر ولائي."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_494_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_494> ;
