    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "تطبق الأحكام المتعلقة بـ التدخل في الخصومة المنصوص عليها في المواد من 194 إلى 206 من هذا القانون أمام المحاكم الإدارية ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_86_20080225_OpEnact_6d887d3bbd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
