<https://legal.dz/resource/law/2008-02-25/08-09#version_art_665> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وقع الحجز التحفظي على أموال منقولة موجودة تحت يد المدين ، يحرر المحضر القضائي محضر الحجز والجرد ، ويسلم نسخة منه للمدين، ويعينه حارسا عليها . إذا وقع الحجز على مصوغات أو سبائك ذهبية أو فضية أو معادن نفيسة أخرى أو حلي أو أحجار كريمة ، وجب على المحضر القضائي ، أن يبين في محضر الحجز، نوع المعدن والوزن الحقيقي وأوصافه وتقدير قيمته بمعرفة خبير يعين بأمر على عريضة، أومن طرف الإدارة المكلفة بدمغ المعادن الثمينة، وهذا بحضور المدين أو ممثله القانوني، أو بعد صحة تكليفه بالحضور . وفي كل الأحوال، يرفق ت"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_665_20080225_OpEnact_84f24a2805> ;
    dzdoc:replacementText "إذا وقع الحجز التحفظي على أموال منقولة موجودة تحت يد المدين ، يحرر المحضر القضائي محضر الحجز والجرد ، ويسلم نسخة منه للمدين، ويعينه حارسا عليها . إذا وقع الحجز على مصوغات أو سبائك ذهبية أو فضية أو معادن نفيسة أخرى أو حلي أو أحجار كريمة ، وجب على المحضر القضائي ، أن يبين في محضر الحجز، نوع المعدن والوزن الحقيقي وأوصافه وتقدير قيمته بمعرفة خبير يعين بأمر على عريضة، أومن طرف الإدارة المكلفة بدمغ المعادن الثمينة، وهذا بحضور المدين أو ممثله القانوني، أو بعد صحة تكليفه بالحضور . وفي كل الأحوال، يرفق تقرير الخبير الخاص بالتقدير والوزن بمحضر الحجز. ويجب، بعد الوزن والتقييم، أن توضع في حرز مختوم ومشمع ، وأن يذكر ذلك في محضر الحجز مع وصف الأختام وإيداعها بأمانة ضبط المحكمة مقابل وصل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_665> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_665> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_666> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا فصلت المحكمة في دعوى تثبيت الحجز التحفظي بإثبات الدين ، قضت بصحة الحجز التحفظي وتثبيته، كما يمكنها أن تقضي برفع الحجز كليا أو جزئيا، إذا برر المدين طلبه بأسباب جدية ومشروعة . إذا فصلت المحكمة برفض الدعوى لعدم إثبات الدين ، قضت وجوبا برفع الحجز، وفصلت في طلب التعويضات المدنية، عند الاقتضاء. يجوز الحكم أيضا على الحاجز بغرامة مدنية لا تقل عن عشرين ألف دينار (20.000 دج)."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_666_20080225_OpEnact_54706810aa> ;
    dzdoc:replacementText "إذا فصلت المحكمة في دعوى تثبيت الحجز التحفظي بإثبات الدين ، قضت بصحة الحجز التحفظي وتثبيته، كما يمكنها أن تقضي برفع الحجز كليا أو جزئيا، إذا برر المدين طلبه بأسباب جدية ومشروعة . إذا فصلت المحكمة برفض الدعوى لعدم إثبات الدين ، قضت وجوبا برفع الحجز، وفصلت في طلب التعويضات المدنية، عند الاقتضاء. يجوز الحكم أيضا على الحاجز بغرامة مدنية لا تقل عن عشرين ألف دينار (20.000 دج)."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_666> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_666> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_667> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لكل دائن بيده سند تنفيذي ، أن يحجز حجزا تنفيذيا، على ما يكون لمدينه لدى الغير من الأموال المنقولة المادية أو الأسهم أو حصص الأرباح في الشركات أو السندات المالية أو الديون، ولو لم يحل أجل استحقاقها ، وذلك بموجب أمر على عريضة من رئيس المحكمة التي توجد فيها الأموال ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
