    dzdoc:fullText "تكون مداولات المحكمين سرية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1025> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1025_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1025_20080225_OpEnact_060a85dacb> ;
