<https://legal.dz/resource/law/2008-02-25/08-09#version_art_785> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم المحضر القضائي بالتبليغ الرسمي عن إيداع قائمة شروط البيع، إلى الدائنين أصحاب التأمينات العينية، وإخطار النيابة العامة ، ولهؤلاء حق طلب إلغاء قائمة شروط البيع عن طريق الاعتراض عليها، عند الاقتضاء، طبقا لأحكام هذا القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_785_20080225_OpEnact_9806dd8732> ;
    dzdoc:replacementText "يقوم المحضر القضائي بالتبليغ الرسمي عن إيداع قائمة شروط البيع، إلى الدائنين أصحاب التأمينات العينية، وإخطار النيابة العامة ، ولهؤلاء حق طلب إلغاء قائمة شروط البيع عن طريق الاعتراض عليها، عند الاقتضاء، طبقا لأحكام هذا القانون ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_785> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_785> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
