    dzdoc:position 1 ;
    dzdoc:text "وإذا كانت المبالغ المالية غير كافية، يجري تقسيمها بين الدائنين قسمة غرماء."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_687_condition_0_8aff6b91> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2008-02-25/08-09#art_687_condition_0_8aff6b91_ref_5357a277577c> ;
