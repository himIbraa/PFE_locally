<https://legal.dz/resource/law/2008-02-25/08-09#version_art_542> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المستأنف القيام بالتبليغ الرسمي لعريضة الاستئناف إلى المستأنف عليه طبقا ل المواد من 404 إلى 416 من هذا القانون وإحضار نسخة من محاضر التبليغ الرسمي والوثائق المدعمة للاستئناف في أول جلسة . في حالة عدم القيام بذلك يمنح له أجل لذات الغرض، و إذا لم يقدم محضر التبليغ الرسمي والوثائق المطلوبة بعد فوات هذا الأجل دون مبرر مقبول ، تشطب القضية بأمر غير قابل للطعن. يترتب على الشطب إزالة الأثر الموقف للاستئناف، ما لم يعاد تسجيل القضية في الجدول خلال آجال الاستئناف المتبقية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_542_20080225_OpEnact_599e98af3f> ;
    dzdoc:replacementText "يجب على المستأنف القيام بالتبليغ الرسمي لعريضة الاستئناف إلى المستأنف عليه طبقا ل المواد من 404 إلى 416 من هذا القانون وإحضار نسخة من محاضر التبليغ الرسمي والوثائق المدعمة للاستئناف في أول جلسة . في حالة عدم القيام بذلك يمنح له أجل لذات الغرض، و إذا لم يقدم محضر التبليغ الرسمي والوثائق المطلوبة بعد فوات هذا الأجل دون مبرر مقبول ، تشطب القضية بأمر غير قابل للطعن. يترتب على الشطب إزالة الأثر الموقف للاستئناف، ما لم يعاد تسجيل القضية في الجدول خلال آجال الاستئناف المتبقية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_542> ;
