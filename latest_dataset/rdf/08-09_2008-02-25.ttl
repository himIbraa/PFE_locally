<https://legal.dz/resource/law/2008-02-25/08-09#version_art_143> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم تحديد أتعاب الخبير النهائية من طرف رئيس الجهة القضائية، بعد إيداع التقرير ، مراعيا في ذلك المساعي المبذولة، واحترام الآجال المحددة وجودة العمل المنجز. يأذن رئيس الجهة القضائية لأمانة الضبط، بتسليم المبالغ المودعة لديها للخبير ، في حدود المبلغ المستحق مقابل أتعابه. يأمر الرئيس عند اللزوم، إما باستكمال المبالغ المستحقة للخبير مع تعيين الخصم الذي يتحمل ذلك، وإما إعادة المبالغ الفائضة إلى من أودعها. في جميع هذه الحالات، يفصل رئيس الجهة القضائية بأمر ، تسلم أمانة الضبط نسخة رسمية منه إلى الخبير ل"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_143_20080225_OpEnact_e9ce121d20> ;
    dzdoc:replacementText "يتم تحديد أتعاب الخبير النهائية من طرف رئيس الجهة القضائية، بعد إيداع التقرير ، مراعيا في ذلك المساعي المبذولة، واحترام الآجال المحددة وجودة العمل المنجز. يأذن رئيس الجهة القضائية لأمانة الضبط، بتسليم المبالغ المودعة لديها للخبير ، في حدود المبلغ المستحق مقابل أتعابه. يأمر الرئيس عند اللزوم، إما باستكمال المبالغ المستحقة للخبير مع تعيين الخصم الذي يتحمل ذلك، وإما إعادة المبالغ الفائضة إلى من أودعها. في جميع هذه الحالات، يفصل رئيس الجهة القضائية بأمر ، تسلم أمانة الضبط نسخة رسمية منه إلى الخبير للتنفيذ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_143> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_143> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

