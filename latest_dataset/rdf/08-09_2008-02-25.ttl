    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_612> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_612_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_612> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب أن يسبق التنفيذ الجبري، التبليغ الرسمي للسند التنفيذي وتكليف المنفذ عليه بالوفاء، بما تضمنه السند التنفيذي في أجل خمسة عشر (15) يوما."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_612_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_612> ;
    dzdoc:position 1 ;
    dzdoc:text "تطبق في التبليغ الرسمي للتكليف بالوفاء أحكام المواد من 406 إلى 416 من هذا القانون."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_613_obligation_0_78f76eb8> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2008-02-25/08-09#art_613_obligation_0_78f76eb8_action_e65290872f> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2008-02-25/08-09#art_613_obligation_0_78f76eb8_role_2f738bc707> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_613> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب أن يشتمل التكليف بالوفاء، تحت طائلة القابلية للإبطال، فضلا عن البيانات المعتادة، على ما يأتي :"@ar ;
    dznorm:sourceArticle "art_613" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_613_obligation_0_78f76eb8_action_e65290872f> a dznorm:Action ;
    rdfs:label "أن يشتمل التكليف بالوفاء"@ar ;
