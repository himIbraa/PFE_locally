<https://legal.dz/resource/law/2008-02-25/08-09#version_art_647> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للدائن، بدين محقق الوجود، حال الأداء، أن يطلب بعريضة مسببة، مؤرخة وموقعة منه أو ممن ينوبه، استصدار أمر بالحجز التحفظي على منقولات أو عقارات مدينه ، إذا كان حاملا لسند دين أو كان لديه مسوغات ظاهرة ترجح وجود الدين، ويخشى فقدان الضمان لحقوقه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_647_20080225_OpEnact_4bd19ff3c7> ;
    dzdoc:replacementText "يجوز للدائن، بدين محقق الوجود، حال الأداء، أن يطلب بعريضة مسببة، مؤرخة وموقعة منه أو ممن ينوبه، استصدار أمر بالحجز التحفظي على منقولات أو عقارات مدينه ، إذا كان حاملا لسند دين أو كان لديه مسوغات ظاهرة ترجح وجود الدين، ويخشى فقدان الضمان لحقوقه ."@ar ;
