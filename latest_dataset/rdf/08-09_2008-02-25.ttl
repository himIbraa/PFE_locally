<https://legal.dz/resource/law/2008-02-25/08-09#version_art_599> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون مخاصمة المحاسبين المنتدبين بمعرفة القضاء أمام الجهة القضائية التي انتدبتهم، وتكون مخاصمة الأوصياء أمام الجهة القضائية التي قدم إليها طلب تعيين الوصي، وتكون مخاصمة بقية المحاسبين أمام الجهة القضائية التي يوجد في دائرة اختصاصها موطنهم."@ar ;
    dzdoc:isAuthoritative true ;
