<https://legal.dz/resource/law/2008-02-25/08-09#version_art_100> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم استجواب الخصوم معا، ما لم تتطلب ظروف القضية استجوابهم بصفة انفرادية . تتم المواجهة بينهم إذا طلب أحدهم ذلك . إذا أمر بحضور أحد الخصوم ، يتم استجوابه في حضور الخصم الآخر، ما لم تتطلب الظروف استجوابه على الفور ، مع حفظ حق الطرف المتغيب في الاطلاع على تصريحات الطرف المسموع ، ولا يحول غياب أحد الخصوم سماع من حضر منهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_100_20080225_OpEnact_4db5cacbce> ;
    dzdoc:replacementText "يتم استجواب الخصوم معا، ما لم تتطلب ظروف القضية استجوابهم بصفة انفرادية . تتم المواجهة بينهم إذا طلب أحدهم ذلك . إذا أمر بحضور أحد الخصوم ، يتم استجوابه في حضور الخصم الآخر، ما لم تتطلب الظروف استجوابه على الفور ، مع حفظ حق الطرف المتغيب في الاطلاع على تصريحات الطرف المسموع ، ولا يحول غياب أحد الخصوم سماع من حضر منهم."@ar ;
