<https://legal.dz/resource/law/2008-02-25/08-09#art_1062_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_1062> ;
    dzdoc:position 0 ;
    dzdoc:text "يسري مفعول هذا القانون، بعد سنة (1) من تاريخ نشره في الجريدة الرسمية."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1063_condition_0_47c7bf6c> a dznorm:Condition ;
