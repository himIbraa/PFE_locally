<https://legal.dz/resource/law/2008-02-25/08-09#version_art_770> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحرر المحضر القضائي قائمة شروط البيع وفقا لأحكام المادة 737 أعلاه، وترفق معها المستندات المحددة في المادة 766 أعلاه . تطبق على تحديد الثمن الأساسي والتبليغ الرسمي لقائمة شروط البيع وتقديم الاعتراضات أحكام المواد من 739 إلى 742 أعلاه. يخضع نشر الإعلان عن البيع بالمزاد العلني لأحكام المادتين 748 و 750 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_770_20080225_OpEnact_33a9e19c12> ;
    dzdoc:replacementText "يحرر المحضر القضائي قائمة شروط البيع وفقا لأحكام المادة 737 أعلاه، وترفق معها المستندات المحددة في المادة 766 أعلاه . تطبق على تحديد الثمن الأساسي والتبليغ الرسمي لقائمة شروط البيع وتقديم الاعتراضات أحكام المواد من 739 إلى 742 أعلاه. يخضع نشر الإعلان عن البيع بالمزاد العلني لأحكام المادتين 748 و 750 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_770> ;
