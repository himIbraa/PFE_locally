<https://legal.dz/resource/law/2008-02-25/08-09#art_501_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_501> ;
    dzdoc:position 0 ;
    dzdoc:text "يؤول الاختصاص الإقليمي إلى المحكمة التي تم في دائرة اختصاصها إبرام عقد العمل أو تنفيذه أو التي يوجد بها موطن المدعى عليه."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_501_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_501> ;
