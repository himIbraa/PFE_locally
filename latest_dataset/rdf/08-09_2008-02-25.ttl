<https://legal.dz/resource/law/2008-02-25/08-09#version_art_700> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وقع الحجز من دائن ولم يتم البيع، وعلم الدائنون الآخرون بالحجز الأول قبل البيع ، جاز لهم أن يتقدموا بسنداتهم أمام المحضر القضائي لتسجيلهم وانضمامهم إلى الدائن الحاجز الأول، وإعادة جرد الأموال المحجوزة، وطلب مواصلة إجراءات البيع إذا تقاعس الحاجز الأول، وتوزيع المتحصل منه بينهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_700_20080225_OpEnact_61fb356714> ;
    dzdoc:replacementText "إذا وقع الحجز من دائن ولم يتم البيع، وعلم الدائنون الآخرون بالحجز الأول قبل البيع ، جاز لهم أن يتقدموا بسنداتهم أمام المحضر القضائي لتسجيلهم وانضمامهم إلى الدائن الحاجز الأول، وإعادة جرد الأموال المحجوزة، وطلب مواصلة إجراءات البيع إذا تقاعس الحاجز الأول، وتوزيع المتحصل منه بينهم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_700> ;
