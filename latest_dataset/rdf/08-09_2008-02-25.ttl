<https://legal.dz/resource/law/2008-02-25/08-09#version_art_70> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب إبلاغ الأوراق والسندات والوثائق التي يقدمها كل طرف دعما لادعاءاته إلى الخصم الآخر ولو لم يطلبها. لا يشترط إبلاغ الخصم في مرحلة الاستئناف بالأوراق المودعة في ملف الدعوى بالدرجة الأولى، غير أنه يجوز لكل طرف طلبها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_70_20080225_OpEnact_8938278d14> ;
    dzdoc:replacementText "يجب إبلاغ الأوراق والسندات والوثائق التي يقدمها كل طرف دعما لادعاءاته إلى الخصم الآخر ولو لم يطلبها. لا يشترط إبلاغ الخصم في مرحلة الاستئناف بالأوراق المودعة في ملف الدعوى بالدرجة الأولى، غير أنه يجوز لكل طرف طلبها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_70> ;
