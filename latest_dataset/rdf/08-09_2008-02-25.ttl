<https://legal.dz/resource/law/2008-02-25/08-09#version_art_410> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عند استحالة التبليغ الرسمي شخصيا للمطلوب تبليغه ، فإن التبليغ يعد صحيحا إذا تم في موطنه الأصلي إلى أحد أفراد عائلته المقيمين معه أو في موطنه المختار. يجب أن يكون الشخص الذي تلقى التبليغ متمتعا بالأهلية ، وإلا كان التبليغ قابلا للإبطال."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_410_20080225_OpEnact_35a2c7e02c> ;
    dzdoc:replacementText "عند استحالة التبليغ الرسمي شخصيا للمطلوب تبليغه ، فإن التبليغ يعد صحيحا إذا تم في موطنه الأصلي إلى أحد أفراد عائلته المقيمين معه أو في موطنه المختار. يجب أن يكون الشخص الذي تلقى التبليغ متمتعا بالأهلية ، وإلا كان التبليغ قابلا للإبطال."@ar ;
