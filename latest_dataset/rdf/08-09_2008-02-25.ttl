<https://legal.dz/resource/law/2008-02-25/08-09#version_art_897> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحيل القاضي المقرر وجوبا، ملف القضية مرفقا بالتقرير والوثائق الملحقة به إلى محافظ الدولة ، لتقديم تقريره المكتوب في أجل شهر واحد (1) من تاريخ استلامه الملف . يجب على محافظ الدولة إعادة الملف والوثائق المرفقة به إلى القاضي المقرر بمجرد انقضاء الأجل المذكور ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_897_20080225_OpEnact_3f09cd181a> ;
    dzdoc:replacementText "يحيل القاضي المقرر وجوبا، ملف القضية مرفقا بالتقرير والوثائق الملحقة به إلى محافظ الدولة ، لتقديم تقريره المكتوب في أجل شهر واحد (1) من تاريخ استلامه الملف . يجب على محافظ الدولة إعادة الملف والوثائق المرفقة به إلى القاضي المقرر بمجرد انقضاء الأجل المذكور ."@ar ;
