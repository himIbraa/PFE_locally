<https://legal.dz/resource/law/2008-02-25/08-09#version_art_691> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يتضمن محضر الحجز والجرد ، فضلا عن البيانات المعتادة، ما يأتي : 1- بيان السند التنفيذي والأمر الذي بموجبه تم الحجز، 2 مبلغ الدين المحجوز من أجله، 3- اختيار موطن للدائن الحاجز في دائرة اختصاص المحكمة التي يوجد في دائرة اختصاصها مكان التنفيذ، 4- بيان مكان الحجز وما قام به المحضر القضائي من إجراءات، أو ما لقيه من صعوبات أو اعتراضات أثناء الحجز، وما اتخذه من تدابير، 5- تعيين الأشياء المحجوزة بالتفصيل مع تحديد نوعها و أوصافها ومقدارها ووزنها و مقاسها وقيمتها بالتقريب. و يختم المحضر بالتوقيع علي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_691_20080225_OpEnact_d4cc96f2c0> ;
    dzdoc:replacementText "يجب أن يتضمن محضر الحجز والجرد ، فضلا عن البيانات المعتادة، ما يأتي : 1- بيان السند التنفيذي والأمر الذي بموجبه تم الحجز، 2 مبلغ الدين المحجوز من أجله، 3- اختيار موطن للدائن الحاجز في دائرة اختصاص المحكمة التي يوجد في دائرة اختصاصها مكان التنفيذ، 4- بيان مكان الحجز وما قام به المحضر القضائي من إجراءات، أو ما لقيه من صعوبات أو اعتراضات أثناء الحجز، وما اتخذه من تدابير، 5- تعيين الأشياء المحجوزة بالتفصيل مع تحديد نوعها و أوصافها ومقدارها ووزنها و مقاسها وقيمتها بالتقريب. و يختم المحضر بالتوقيع عليه مع المحجوز عليه إن كان حاضرا أو التنويه عن غيابه أو رفضه التوقيع. إذا خلا محضر الحجز والجرد من أحد هذه البيانات ، كان قابلا للإبطال خلال أجل عشرة (10) أيام من تاريخه. يرفع طلب الإبطال من كل ذي مصلحة عن طريق الاستعجال، يفصل فيه رئيس المحكمة خلال أجل أقصاه خمسة عشر (15) يوما."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_691> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_691> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_692> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز الحجز على الثمار المتصلة أو المزروعات القائمة قبل نضجها. ويجب أن يتضمن محضر الحجز ، موقع البستان والأرض واسمهما ورقم المسح إن وجد ومساحة الأرض التقريبية وحدودها ونوع الثمار والمزروعات أو نوع الأشجار المثمرة وعددها والمقدار التقريبي لما يمكن أن يحصد أو يجنى أو ينتج منها وقيمته على وجه التقريب. يشرع في جني الثمار أو حصاد المزروعات وبيعها بموجب أمر على عريضة بناء على طلب الحارس أو الحاجز أو المحجوز عليه. كما يجوز بيع الثمار أو المزروعات وهي قائمة في أرضها إذا كان ذلك يحقق نفعا أوفر وفقا للإجرا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_692_20080225_OpEnact_bc8084775b> ;
    dzdoc:replacementText "يجوز الحجز على الثمار المتصلة أو المزروعات القائمة قبل نضجها. ويجب أن يتضمن محضر الحجز ، موقع البستان والأرض واسمهما ورقم المسح إن وجد ومساحة الأرض التقريبية وحدودها ونوع الثمار والمزروعات أو نوع الأشجار المثمرة وعددها والمقدار التقريبي لما يمكن أن يحصد أو يجنى أو ينتج منها وقيمته على وجه التقريب. يشرع في جني الثمار أو حصاد المزروعات وبيعها بموجب أمر على عريضة بناء على طلب الحارس أو الحاجز أو المحجوز عليه. كما يجوز بيع الثمار أو المزروعات وهي قائمة في أرضها إذا كان ذلك يحقق نفعا أوفر وفقا للإجراء المنصوص عليه في الفقرة أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_692> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_692> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

