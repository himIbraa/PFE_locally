        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة وفاة الخصم الذي قام بالتبليغ الرسمي للحكم ، يبلغ الطعن إلى الورثة في مسكن المتوفى، طبقا ل المادة 319 أعلاه. غير أنه لا يمكن للخصم المطالبة بالحكم ضد الورثة، إلا إذا أدخلوا في الخصام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_320_20080225_OpEnact_1f22f74b34> ;
    dzdoc:replacementText "في حالة وفاة الخصم الذي قام بالتبليغ الرسمي للحكم ، يبلغ الطعن إلى الورثة في مسكن المتوفى، طبقا ل المادة 319 أعلاه. غير أنه لا يمكن للخصم المطالبة بالحكم ضد الورثة، إلا إذا أدخلوا في الخصام."@ar ;
