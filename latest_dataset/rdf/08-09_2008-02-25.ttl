<https://legal.dz/resource/law/2008-02-25/08-09#version_art_664> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تعلق الحجز بسندات تجارية محررة لفائدة المدين ، يجب أن تعين في محضر الحجز، وتودع في أمانة ضبط المحكمة مع أصل المحضر مقابل وصل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
