    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_964> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يجب أن ترفع دعوى تصحيح الأخطاء المادية بنفس الأشكال والإجراءات المقررة لعريضة افتتاح الدعوى . يجب تقديم دعوى تصحيح الأخطاء المادية في أجل شهرين (2) ابتداء من تاريخ التبليغ الرسمي للحكم أو القرار المشوب بالخطأ ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_965_20080225_OpEnact_c443e11333> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
