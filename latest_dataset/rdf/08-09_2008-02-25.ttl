    dznorm:position 0 ;
    dznorm:provisionText "يجب أن يتم التبليغ الرسمي شخصيا."@ar ;
    dznorm:sourceArticle "art_408" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_408_obligation_0_043f3d5d_action_efe6c4d704> a dznorm:Action ;
    rdfs:label "أن يتم التبليغ الرسمي شخصيا"@ar ;
    dzdoc:confidenceScore 0.62 ;
