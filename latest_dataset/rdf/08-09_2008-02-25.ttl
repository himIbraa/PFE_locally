<https://legal.dz/resource/law/2008-02-25/08-09#version_art_912> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يتم استئناف حكم صادر عن المحكمة الإدارية قضى برفض الطعن لتجاوز السلطة لقرار إداري ، يجوز ل مجلس الدولة أن يأمر بوقف التنفيذ بطلب من المستأنف عندما يكون تنفيذ القرار الإداري المطعون فيه من شأنه إحداث عواقب يصعب تداركها، وعندما تبدو الأوجه المثارة في العريضة من خلال ما توصل إليه التحقيق جدية، ومن شأنها تبرير إلغاء القرار الإداري المطعون فيه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_912_20080225_OpEnact_d3fd3917ca> ;
    dzdoc:replacementText "عندما يتم استئناف حكم صادر عن المحكمة الإدارية قضى برفض الطعن لتجاوز السلطة لقرار إداري ، يجوز ل مجلس الدولة أن يأمر بوقف التنفيذ بطلب من المستأنف عندما يكون تنفيذ القرار الإداري المطعون فيه من شأنه إحداث عواقب يصعب تداركها، وعندما تبدو الأوجه المثارة في العريضة من خلال ما توصل إليه التحقيق جدية، ومن شأنها تبرير إلغاء القرار الإداري المطعون فيه ."@ar ;
