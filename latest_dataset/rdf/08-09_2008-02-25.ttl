<https://legal.dz/resource/law/2008-02-25/08-09#art_997> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_997" ;
    dzdoc:fullText "تسند الوساطة إلى شخص طبيعي أو إلى جمعية. عندما يكون الوسيط المعين جمعية ، يقوم رئيسها بتعيين أحد أعضائها لتنفيذ الإجراء باسمها ويخطر القاضي بذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_997> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_997_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_997_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_997_20080225_OpEnact_6878d6aae5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 997" ;
    dzdoc:position 996 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_997_condition_0_1d17fa15> ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:mediation .

<https://legal.dz/resource/law/2008-02-25/08-09#art_999> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_999" ;
    dzdoc:fullText "يجب أن يتضمن الأمر القاضي بتعيين الوسيط ما يأتي : موافقة الخصوم، تحديد الآجال الأولى الممنوحة للوسيط للقيام بمهمته وتاريخ رجوع القضية إلى الجلسة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_999> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_999_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_999_20080225_OpEnact_61be10b01d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_999_obligation_0_ec1e195d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 999" ;
    dzdoc:position 998 .

