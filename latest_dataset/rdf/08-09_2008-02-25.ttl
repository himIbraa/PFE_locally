<https://legal.dz/resource/law/2008-02-25/08-09#art_157_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_157> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب إثارة أوجه التجريح قبل الإدلاء بالشهادة، إلا إذا ظهر سبب التجريح بعد الإدلاء بالشهادة وأثناء سماع الشهود الآخرين."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_157_para_1> a dzdoc:Paragraph ;
