<https://legal.dz/resource/law/2008-02-25/08-09#version_art_121> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للقاضي المناب أن يرفض تلقائيا أو بطلب من أي شخص يهمه الأمر، تنفيذ الإنابة القضائية إذا رأى أنها لا تدخل ضمن صلاحياته . يجب على القاضي رفض تنفيذ الإنابة القضائية، إذا كان من شأنها المساس بالسيادة أو بأمن الدولة أو بالنظام العام . ويجوز كذلك في هذه الحالات، لكل شخص معني أن يطلب من القاضي المناب التراجع عن الإجراءات المتخذة، وإبطال العقود التي قام بتحريرها تنفيذا للإنابة القضائية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_121_20080225_OpEnact_6092c19e9e> ;
    dzdoc:replacementText "يجوز للقاضي المناب أن يرفض تلقائيا أو بطلب من أي شخص يهمه الأمر، تنفيذ الإنابة القضائية إذا رأى أنها لا تدخل ضمن صلاحياته . يجب على القاضي رفض تنفيذ الإنابة القضائية، إذا كان من شأنها المساس بالسيادة أو بأمن الدولة أو بالنظام العام . ويجوز كذلك في هذه الحالات، لكل شخص معني أن يطلب من القاضي المناب التراجع عن الإجراءات المتخذة، وإبطال العقود التي قام بتحريرها تنفيذا للإنابة القضائية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_121> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_121> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
