    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_796> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتم تكليف الدائنين الحاجزين والدائنين المتدخلين في الحجز من طرف المحضر القضائي بناء على طلب من يهمه التعجيل بالحضور إلى جلسة التسوية الودية أمام رئيس المحكمة"@ar ;
    dznorm:sourceArticle "art_796" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_796_obligation_0_e0076b9b_role_9b6180be7c> a dznorm:Role ;
