<https://legal.dz/resource/law/2008-02-25/08-09#art_881> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_881" ;
    dzdoc:fullText "يقدم القاضي المطلوب رده، كتابة قبول الرد أو أسباب اعتراضه عليه في أجل عشرة (10) أيام من تاريخ استلامه طلب الرد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_881> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_881_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_881_20080225_OpEnact_d5fa7cb993> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_881_obligation_0_7005e121> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "881" ;
    dzdoc:position 880 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_90> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_90" ;
    dzdoc:fullText "يجوز للقاضي أن يقوم شخصيا بتنفيذ إجراء من إجراءات التحقيق أو يشرف على تنفيذه ، و يتم بحضور أمين الضبط الذي يحرر محضرا بذلك، يودع بأمانة الضبط ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_90_permission_0_b71bd97e> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_90_right_0_54185e83> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_90> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_90_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_90_20080225_OpEnact_e450e78f48> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_90_obligation_0_059b29b7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "90" ;
    dzdoc:position 89 ;
    dzdoc:usesTerm dzterm:clerk,
        dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_900> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_5> ;
    dzdoc:eId "art_900" ;
    dzdoc:fullText "يجب أن يشار في أحكام المحكمة الإدارية بإيجاز إلى طلبات محافظ الدولة وملاحظاته والرد عليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_900> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_900_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_900_20080225_OpEnact_e438b5ca57> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_900_obligation_0_4d9d9b18> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "900" ;
    dzdoc:position 899 ;
    dzdoc:usesTerm dzterm:administrative_court,
        dzterm:state_commissioner .

<https://legal.dz/resource/law/2008-02-25/08-09#art_949> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_1_subsec_1> ;
    dzdoc:eId "art_949" ;
    dzdoc:fullText "يجوز لكل طرف حضر الخصومة أو استدعي بصفة قانونية، ولو لم يقدم أي دفاع، أن يرفع استئنافا ضد الحكم أو الأمر الصادر عن المحكمة الإدارية ، ما لم ينص القانون على خلاف ذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_949_permission_0_fd4b8212> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_949_right_0_e138c1df> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_949> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_949_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_949_20080225_OpEnact_d58e8cda67> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "949" ;
    dzdoc:position 948 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_949_condition_0_df257e89> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_951> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_1_subsec_1> ;
    dzdoc:eId "art_951" ;
    dzdoc:fullText "يجوز للمستأنف عليه، استئناف الحكم فرعيا حتى في حالة سقوط حقه في رفع الاستئناف الأصلي . لا يقبل الاستئناف الفرعي إذا كان الاستئناف الأصلي غير مقبول . يترتب على التنازل عن الاستئناف الأصلي عدم قبول الاستئناف الفرعي إذا وقع بعد التنازل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_951_permission_0_6fadd4e8> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_951_right_0_ce1bbd81> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_951> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_951_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_951_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_951_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_951_20080225_OpEnact_ba3555356b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "951" ;
    dzdoc:position 950 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_951_condition_0_b680890b> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_994> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_994" ;
    dzdoc:fullText "يجب على القاضي عرض إجراء الوساطة على الخصوم في جميع المواد ، باستثناء قضايا شؤون الأسرة والقضايا العمالية وكل ما من شأنه أن يمس بالنظام العام . إذا قبل الخصوم هذا الإجراء ، يعين القاضي وسيطا لتلقي وجهة نظر كل واحد منهم ومحاولة التوفيق بينهم، لتمكينهم من إيجاد حل للنزاع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_994> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_994_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_994_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_994_20080225_OpEnact_0de9fe5e47> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_994_obligation_0_46728292> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 994" ;
    dzdoc:position 993 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_994_condition_0_1978a49e>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_994_condition_1_2d7944ce> ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:mediation,
        dzterm:mediator .

