<https://legal.dz/resource/law/2008-02-25/08-09#version_art_793> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة وجود عدة حجوز على أموال نفس المدين المحجوز عليه أمام جهات قضائية مختلفة ، يجب على المحضرين القضائيين، أو على محافظي البيع، وعلى كل من كانت لديه المبالغ المتحصلة من التنفيذ، إيداعها بأمانة ضبط المحكمة التي تم في دائرة اختصاصها الحجز الأول أو البيع الأول للأموال المحجوزة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_793_20080225_OpEnact_3efe44b6bd> ;
    dzdoc:replacementText "في حالة وجود عدة حجوز على أموال نفس المدين المحجوز عليه أمام جهات قضائية مختلفة ، يجب على المحضرين القضائيين، أو على محافظي البيع، وعلى كل من كانت لديه المبالغ المتحصلة من التنفيذ، إيداعها بأمانة ضبط المحكمة التي تم في دائرة اختصاصها الحجز الأول أو البيع الأول للأموال المحجوزة ."@ar ;
