<https://legal.dz/resource/law/2008-02-25/08-09#version_art_1006> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن لكل شخص اللجوء إلى التحكيم في الحقوق التي له مطلق التصرف فيها . لا يجوز التحكيم في المسائل المتعلقة بالنظام العام أو حالة الأشخاص وأهليتهم . ولا يجوز للأشخاص المعنوية العامة أن تطلب التحكيم ما عدا في علاقاتها الاقتصادية الدولية أو في إطار الصفقات العمومية ."@ar ;
