<https://legal.dz/resource/law/2008-02-25/08-09#version_art_152> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسمع كل شاهد على انفراد في حضور أو في غياب الخصوم، ويعرف قبل سماعه، باسمه ولقبه ومهنته وسنه وموطنه ، وعلاقته ودرجة قرابته ومصاهرته أو تبعيته للخصوم. يؤدي الشاهد اليمين بأن يقول الحقيقة وإلا كانت شهادته قابلة للإبطال. يجوز إعادة سماع الشهود ومواجهة بعضهم البعض."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_152_20080225_OpEnact_7aba2bea0f> ;
    dzdoc:replacementText "يسمع كل شاهد على انفراد في حضور أو في غياب الخصوم، ويعرف قبل سماعه، باسمه ولقبه ومهنته وسنه وموطنه ، وعلاقته ودرجة قرابته ومصاهرته أو تبعيته للخصوم. يؤدي الشاهد اليمين بأن يقول الحقيقة وإلا كانت شهادته قابلة للإبطال. يجوز إعادة سماع الشهود ومواجهة بعضهم البعض."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_152> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_152> ;
