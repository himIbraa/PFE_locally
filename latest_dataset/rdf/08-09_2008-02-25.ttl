<https://legal.dz/resource/law/2008-02-25/08-09#art_647_condition_0_02e91305> a dznorm:Condition ;
    dznorm:conditionText "إذا كان حاملا لسند دين أو كان لديه مسوغات ظاهرة ترجح وجود الدين، ويخشى فقدان الضمان لحقوقه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_647> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_647_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_647> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز للدائن، بدين محقق الوجود، حال الأداء، أن يطلب بعريضة مسببة، مؤرخة وموقعة منه أو ممن ينوبه، استصدار أمر بالحجز التحفظي على منقولات أو عقارات مدينه، إذا كان حاملا لسند دين أو كان لديه مسوغات ظاهرة ترجح وجود الدين، ويخشى فقدان الضمان لحقوقه."@ar .

