<https://legal.dz/resource/law/2008-02-25/08-09#version_art_719> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحجز السندات التجارية الموجودة لدى المدين إذا كانت لحاملها أو قابلة للتظهير وفقا للأحكام المقررة لـ الحجز التنفيذي على المنقول تحت يد المدين . وتحجز القيم المنقولة و إيرادات الأسهم الاسمية و حصص الأرباح المستحقة الموجودة في ذمة الأشخاص المعنوية طبقا للأحكام المقررة لـ حجز ما للمدين لدى الغير ، ويترتب على ذلك، الحجز على ثمارها وفوائدها إلى تاريخ البيع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_719_20080225_OpEnact_3d4d25a88a> ;
