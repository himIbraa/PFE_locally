<https://legal.dz/resource/law/2008-02-25/08-09#art_316_condition_1_d17b489d> a dznorm:Condition ;
    dznorm:conditionText "عندما يكون الحكم لصالح عدة أطراف متضامنين أو معنيين بالتزام غير قابل للتجزئة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_316> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_316_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_316> ;
    dzdoc:position 0 ;
    dzdoc:text "في حالة الحكم على الخصوم بالتضامن أو في نزاع غير قابل للتجزئة، فإن أجل الطعن لا يسري إلا على من تم تبليغه رسميا."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_316_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_316> ;
    dzdoc:position 1 ;
    dzdoc:text "عندما يكون الحكم لصالح عدة أطراف متضامنين أو معنيين بالتزام غير قابل للتجزئة، جاز لكل منهم التمسك بالتبليغ الرسمي الذي قام به أحدهم."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_316_right_0_8e427f1d> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
