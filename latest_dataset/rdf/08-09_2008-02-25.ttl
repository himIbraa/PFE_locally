    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_965> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "ترفع دعوى تفسير الأحكام ويفصل فيها وفقا للأشكال والإجراءات المنصوص عليها في المادة 285 من هذا القانون."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_966_20080225_OpEnact_ce603fd44a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
