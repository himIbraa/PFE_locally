<https://legal.dz/resource/law/2008-02-25/08-09#version_art_286> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للجهة القضائية التي أصدرت الحكم، ولو بعد حيازة ذلك الحكم قوة الشيء المقضي به، أن الخطأ المادي أو الإغفال الذي يشوبه، كما يجوز للجهة القضائية التي يطعن في الحكم أمامها القيام بتصحيحه. يقدم طلب التصحيح إلى الجهة القضائية ، بعريضة من أحد الخصوم أو بعريضة مشتركة منهم، وفقا للأشكال المقررة في رفع الدعوى، ويمكن للنيابة العامة تقديم هذا الطلب، لا سيما إذا تبين لها أن الخطأ المادي يعود إلى مرفق العدالة. يفصل في طلب التصحيح بعد سماع الخصوم أو بعد صحة تكليفهم بالحضور. يؤشر بحكم التصحيح على أصل الحكم "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_286_20080225_OpEnact_5fbf6e763a> ;
    dzdoc:replacementText "يجوز للجهة القضائية التي أصدرت الحكم، ولو بعد حيازة ذلك الحكم قوة الشيء المقضي به، أن الخطأ المادي أو الإغفال الذي يشوبه، كما يجوز للجهة القضائية التي يطعن في الحكم أمامها القيام بتصحيحه. يقدم طلب التصحيح إلى الجهة القضائية ، بعريضة من أحد الخصوم أو بعريضة مشتركة منهم، وفقا للأشكال المقررة في رفع الدعوى، ويمكن للنيابة العامة تقديم هذا الطلب، لا سيما إذا تبين لها أن الخطأ المادي يعود إلى مرفق العدالة. يفصل في طلب التصحيح بعد سماع الخصوم أو بعد صحة تكليفهم بالحضور. يؤشر بحكم التصحيح على أصل الحكم المصحح وعلى النسخ المستخرجة منه، ويبلغ الخصوم المعنيون بحكم التصحيح. عندما يصبح الحكم المصحح حائزا لقوة الشيء المقضي به ، فلا يمكن الطعن في الحكم القاضي بالتصحيح إلا عن طريق الطعن بالنقض."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_286> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_286> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_287> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقصد بالخطأ المادي عرض غير صحيح لواقعة مادية أو تجاهل وجودها. غير أن تصحيح الخطأ المادي أو الإغفال لا يؤدي إلى تعديل ما قضى به الحكم من حقوق و التزامات للأطراف."@ar ;
