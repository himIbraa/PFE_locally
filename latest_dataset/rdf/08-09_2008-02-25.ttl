<https://legal.dz/resource/law/2008-02-25/08-09#version_art_484> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتلقى القاضي تصريحات الشخص المعني بإجراء التقديم، بحضور محاميه والأشخاص المعنيين. وإذا رأى ضرورة لذلك يتلقى هذه التصريحات بحضور الطبيب المعالج وممثل النيابة العامة. إذا استحال على القاضي سماع أقوال الشخص المعني بإجراء التقديم أو إذا كان سماعه من شأنه أن يضر بصحته ، يجوز له صرف النظر عن هذا السماع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_484_20080225_OpEnact_260aa62300> ;
    dzdoc:replacementText "يتلقى القاضي تصريحات الشخص المعني بإجراء التقديم، بحضور محاميه والأشخاص المعنيين. وإذا رأى ضرورة لذلك يتلقى هذه التصريحات بحضور الطبيب المعالج وممثل النيابة العامة. إذا استحال على القاضي سماع أقوال الشخص المعني بإجراء التقديم أو إذا كان سماعه من شأنه أن يضر بصحته ، يجوز له صرف النظر عن هذا السماع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
