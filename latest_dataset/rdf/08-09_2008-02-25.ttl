    dznorm:conditionText "إذا لم يكن العقار المحجوز مؤجرا وقت قيد أمر الحجز"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_730> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_730_condition_1_6d804d4e> a dznorm:Condition ;
    dznorm:conditionText "إذا كان العقار مؤجرا وقت قيد أمر الحجز"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_730> ;
