    dzdoc:evidenceText "يجوز ل مجلس الدولة ، أن يأمر بوقف تنفيذ الأمر القاضي بمنح التسبيق ، إذا كان تنفيذه من شأنه أن يؤدي إلى نتائج لا يمكن تداركها وإذا كانت الأوجه المثارة تبدو من خلال التحقيق جدية، ومن طبيعتها أن تبرر إلغاءه ورفض الطلب ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
