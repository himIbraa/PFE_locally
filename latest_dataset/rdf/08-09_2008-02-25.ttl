<https://legal.dz/resource/law/2008-02-25/08-09#version_art_423> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينظر قسم شؤون الأسرة ، على الخصوص في الدعاوى الآتية : 1- الدعاوى المتعلقة بالخطبة والزواج والرجوع إلى بيت الزوجية وانحلال الرابطة الزوجية وتوابعها حسب الحالات و الشروط المذكورة في قانون الأسرة ، 2- دعاوى النفقة والحضانة وحق الزيارة، 3- دعاوى إثبات الزواج والنسب، 4- الدعاوى المتعلقة بالكفالة، 5- الدعاوى المتعلقة بالولاية وسقوطها والحجر والغياب والفقدان والتقديم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_423_20080225_OpEnact_47c309e94a> ;
    dzdoc:replacementText "ينظر قسم شؤون الأسرة ، على الخصوص في الدعاوى الآتية : 1- الدعاوى المتعلقة بالخطبة والزواج والرجوع إلى بيت الزوجية وانحلال الرابطة الزوجية وتوابعها حسب الحالات و الشروط المذكورة في قانون الأسرة ، 2- دعاوى النفقة والحضانة وحق الزيارة، 3- دعاوى إثبات الزواج والنسب، 4- الدعاوى المتعلقة بالكفالة، 5- الدعاوى المتعلقة بالولاية وسقوطها والحجر والغياب والفقدان والتقديم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
