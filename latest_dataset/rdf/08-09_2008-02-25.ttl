<https://legal.dz/resource/law/2008-02-25/08-09#version_art_1012> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحصل الاتفاق على التحكيم كتابيا. يجب أن يتضمن اتفاق التحكيم، تحت طائلة البطلان موضوع النزاع وأسماء المحكمين، أو كيفية تعيينهم. إذا رفض المحكم المعين القيام بالمهمة المسندة إليه ، يستبدل بغيره بأمر من طرف رئيس المحكمة المختصة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
