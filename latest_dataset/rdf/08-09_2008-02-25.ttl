<https://legal.dz/resource/law/2008-02-25/08-09#version_art_251> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا اعترض الرئيس على الطلب ، يحيل القضية مع بيان أسباب الاعتراض إلى رئيس الجهة القضائية الأعلى مباشرة ، تفصل هذه الجهة في قرار الرفض، في غرفة المشورة، خلال شهر، دون حاجة إلى استدعاء الخصوم. تتولى الجهة القضائية المقدم إليها الطلب إرسال نسخة من قرارها إلى الجهة القضائية المطلوب تخليها عن النظر في القضية . يتولى الخصم الذي يهمه التعجيل القيام بالتبليغ الرسمي لهذا القرار لبقية الخصوم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_251_20080225_OpEnact_bb616965d9> ;
    dzdoc:replacementText "إذا اعترض الرئيس على الطلب ، يحيل القضية مع بيان أسباب الاعتراض إلى رئيس الجهة القضائية الأعلى مباشرة ، تفصل هذه الجهة في قرار الرفض، في غرفة المشورة، خلال شهر، دون حاجة إلى استدعاء الخصوم. تتولى الجهة القضائية المقدم إليها الطلب إرسال نسخة من قرارها إلى الجهة القضائية المطلوب تخليها عن النظر في القضية . يتولى الخصم الذي يهمه التعجيل القيام بالتبليغ الرسمي لهذا القرار لبقية الخصوم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_251> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_251> ;
