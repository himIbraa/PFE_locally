    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_363_20080225_OpEnact_0da863e134> ;
    dzdoc:replacementText "يتم نقض الحكم أو القرار المطعون فيه كليا أو جزئيا. ويكون النقض جزئيا إذا تعلق بجزء من الحكم أو القرار، قابل للانفصال عن الأجزاء الأخرى."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_363> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_363> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_364> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا نقض الحكم أو القرار المطعون فيه، تحيل المحكمة العليا القضية، إما أمام الجهة القضائية التي أصدرت الحكم أو القرار بتشكيلة جديدة، وإما أمام جهة قضائية أخرى من نفس النوع والدرجة. يعيد قرار النقض الخصوم إلى الحالة التي كانوا عليها قبل الحكم أو القرار المنقوض فيما يتعلق بالنقاط التي شملها النقض. كما يترتب على النقض، وبدون حاجة لاستصدار حكم جديد، الإلغاء بالنتيجة، لكل حكم صدر بعد الحكم أو القرار المنقوض جاء تطبيقا أو تنفيذا له أو كان له ارتباط ضروري به."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_364_20080225_OpEnact_b15e26afd2> ;
    dzdoc:replacementText "إذا نقض الحكم أو القرار المطعون فيه، تحيل المحكمة العليا القضية، إما أمام الجهة القضائية التي أصدرت الحكم أو القرار بتشكيلة جديدة، وإما أمام جهة قضائية أخرى من نفس النوع والدرجة. يعيد قرار النقض الخصوم إلى الحالة التي كانوا عليها قبل الحكم أو القرار المنقوض فيما يتعلق بالنقاط التي شملها النقض. كما يترتب على النقض، وبدون حاجة لاستصدار حكم جديد، الإلغاء بالنتيجة، لكل حكم صدر بعد الحكم أو القرار المنقوض جاء تطبيقا أو تنفيذا له أو كان له ارتباط ضروري به."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_364> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
