<https://legal.dz/resource/law/2008-02-25/08-09#version_art_304> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون الأوامر الاستعجالية الصادرة في أول درجة قابلة للاستئناف. وتكون الأوامر الاستعجالية الصادرة غيابيا في آخر درجة، قابلة للمعارضة. يرفع الاستئناف والمعارضة خلال خمسة عشر (15) يوما من تاريخ التبليغ الرسمي للأمر، و يجب أن يفصل في ذلك في أقرب الآجال ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_304_20080225_OpEnact_888bdea1c4> ;
