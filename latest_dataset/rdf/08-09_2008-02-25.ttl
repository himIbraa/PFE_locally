<https://legal.dz/resource/law/2008-02-25/08-09#art_716> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_4_subsec_8> ;
    dzdoc:eId "art_716" ;
    dzdoc:fullText "إذا ادعى الغير ملكية منقولات محجوزة، وقام برفع دعوى استردادها ، يوقف البيع وجوبا من المحضر القضائي أو محافظ البيع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_716> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_716_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_716_20080225_OpEnact_c8c22049f0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_716_obligation_0_82632bcc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "716" ;
    dzdoc:position 715 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_716_condition_0_2c8d0cb9> ;
    dzdoc:usesTerm dzterm:auctioneer,
        dzterm:judicial_bailiff .

<https://legal.dz/resource/law/2008-02-25/08-09#art_719> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_4_subsec_9> ;
    dzdoc:eId "art_719" ;
    dzdoc:fullText "تحجز السندات التجارية الموجودة لدى المدين إذا كانت لحاملها أو قابلة للتظهير وفقا للأحكام المقررة لـ الحجز التنفيذي على المنقول تحت يد المدين . وتحجز القيم المنقولة و إيرادات الأسهم الاسمية و حصص الأرباح المستحقة الموجودة في ذمة الأشخاص المعنوية طبقا للأحكام المقررة لـ حجز ما للمدين لدى الغير ، ويترتب على ذلك، الحجز على ثمارها وفوائدها إلى تاريخ البيع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_719> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_719_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_719_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_719_20080225_OpEnact_3d4d25a88a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_719_obligation_0_d9b28966>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_719_obligation_1_a8d6f1af> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 719" ;
    dzdoc:position 718 ;
    dzdoc:usesTerm dzterm:commercial_papers,
        dzterm:executive_seizure,
        dzterm:garnishment,
        dzterm:nominal_shares_revenues,
        dzterm:profit_shares,
        dzterm:securities .

<https://legal.dz/resource/law/2008-02-25/08-09#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_1> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "يجوز للقاضي تصفية الغرامة التهديدية التي أمر بها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_72_permission_0_d681e7e3> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_72_right_0_e85258a4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_72_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_72_20080225_OpEnact_cb67c0768a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "72" ;
    dzdoc:position 71 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_755> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_5_subsec_10> ;
    dzdoc:eId "art_755" ;
    dzdoc:fullText "يجب أن يحدد في الأمر الصادر بتأجيل البيع، تاريخ جلسة لاحقة للبيع خلال فترة لا تقل عن ثلاثين (30) يوما ولا تزيد عن خمسة وأربعين (45) يوما من تاريخ التأجيل . في هذه الحالة، يعاد النشر والتعليق عن البيع بالكيفيات المنصوص عليها في المادتين 749 و 750 أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_755> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_755_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_755_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_755_20080225_OpEnact_80d4f18444> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_755_obligation_0_c937a95b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "755" ;
    dzdoc:position 754 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_749>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_750> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_749>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_750> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_758> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_5_subsec_10> ;
    dzdoc:eId "art_758" ;
    dzdoc:fullText "يلزم الراسي عليه المزاد المتخلف عن دفع الثمن في أجل ثمانية (8) أيام المنصوص عليه في المادة 757 أعلاه، بفرق الثمن إذا أعيد بيع العقار بثمن أقل من الراسي به المزاد ، ولا يكون له الحق في الزيادة إذا بيع بثمن أعلى . وفي هذه الحالة، يتضمن منطوق الحكم الصادر برسو المزاد للبيع الثاني، إلزام المزايد المتخلف بفرق الثمن إن وجد."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_758_right_0_ad0ce5f1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_758> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_758_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_758_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_758_20080225_OpEnact_41dc4f29c4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_758_obligation_0_0bd96109> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "758" ;
    dzdoc:position 757 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_757> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_757> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "يمكن للقاضي ، ولسبب مشروع وقبل مباشرة الدعوى أن يأمر بأي إجراء من إجراءات التحقيق ، بناء على طلب كل ذي مصلحة ، قصد إقامة الدليل والاحتفاظ به لإثبات الوقائع التي قد تحدد مآل النزاع. يأمر القاضي بالإجراء المطلوب بأمر على عريضة أو عن طريق الاستعجال."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_77_permission_0_701abd78> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_77_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_77_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_77_20080225_OpEnact_e11dced927> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "77" ;
    dzdoc:position 76 ;
    dzdoc:usesTerm dzterm:investigation_measure,
        dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_787> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_8_subsec_2> ;
    dzdoc:eId "art_787" ;
    dzdoc:fullText "يقوم المحضر القضائي بالتبليغ الرسمي عن إيداع قائمة شروط البيع، إلى الدائنين أصحاب التأمينات العينية، وجميع المالكين على الشيوع ، ولهؤلاء حق طلب إلغاء قائمة شروط البيع بطريق الاعتراض على القائمة ، عند الاقتضاء، طبقا لأحكام هذا القانون."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_787_right_0_e26282e5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_787> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_787_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_787_20080225_OpEnact_95911ab22d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_787_obligation_0_8287ba5a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "787" ;
    dzdoc:position 786 ;
    dzdoc:usesTerm dzterm:judicial_bailiff .

<https://legal.dz/resource/law/2008-02-25/08-09#art_813> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_1_subsec_6> ;
    dzdoc:eId "art_813" ;
    dzdoc:fullText "عندما تخطر إحدى المحاكم الإدارية بطلبات ترى أنها من اختصاص مجلس الدولة ، يحول رئيس المحكمة الملف في أقرب الآجال إلى مجلس الدولة . يفصل مجلس الدولة في الاختصاص ويحدد عند الاقتضاء، المحكمة الإدارية المختصة للفصل في كل الطلبات أو في جزء منها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_813> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_813_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_813_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_813_20080225_OpEnact_467b67f3ef> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_813_obligation_0_6d33f13e>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_813_obligation_1_833e1df4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 813" ;
    dzdoc:position 812 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_813_condition_0_ccaab44d> ;
    dzdoc:usesTerm dzterm:administrative_court,
        dzterm:council_of_state .

<https://legal.dz/resource/law/2008-02-25/08-09#art_815> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_815" ;
    dzdoc:fullText "مع مراعاة أحكام المادة 827 أدناه، ترفع الدعوى أمام المحكمة الإدارية بعريضة موقعة من محام."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_815> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_815_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_815_20080225_OpEnact_51d1ed4c5a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 815" ;
    dzdoc:position 814 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_827> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_827> ;
    dzdoc:usesTerm dzterm:administrative_court .

<https://legal.dz/resource/law/2008-02-25/08-09#art_819> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_819" ;
    dzdoc:fullText "يجب أن يرفق مع العريضة الرامية إلى إلغاء أو تفسير أو تقدير مدى مشروعية القرار الإداري، تحت طائلة عدم القبول، القرار الإداري المطعون فيه ، ما لم يوجد مانع مبرر. وإذا ثبت أن هذا المانع يعود إلى امتناع الإدارة من تمكين المدعي من القرار المطعون فيه ، أمرها القاضي المقرر بتقديمه في أول جلسة، ويستخلص النتائج القانونية المترتبة على هذا الامتناع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_819> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_819_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_819_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_819_20080225_OpEnact_d4686b0416> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_819_obligation_0_8c5b3096> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 819" ;
    dzdoc:position 818 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_819_condition_0_e7ccbcd7> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_827> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_827" ;
    dzdoc:fullText "تعفى الدولة والأشخاص المعنوية المذكورة في المادة 800 أعلاه، من التمثيل الوجوبي بمحام في الادعاء أو الدفاع أو التدخل . توقع العرائض ومذكرات الدفاع ومذكرات التدخل المقدمة باسم الدولة أو باسم الأشخاص المشار إليهم أعلاه، من طرف الممثل القانوني."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_827_right_0_f2f44247> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_827> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_827_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_827_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_827_20080225_OpEnact_68e7356a86> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 827" ;
    dzdoc:position 826 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_800> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_800> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_838> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_838" ;
    dzdoc:fullText "تودع المذكرات والوثائق المقدمة من الخصوم بأمانة ضبط المحكمة الإدارية . يتم التبليغ الرسمي لعريضة افتتاح الدعوى عن طريق محضر قضائي ، ويتم تبليغ المذكرات ومذكرات الرد مع الوثائق المرفقة بها إلى الخصوم عن طريق أمانة الضبط تحت إشراف القاضي المقرر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_838> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_838_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_838_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_838_20080225_OpEnact_0e7bb1b883> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_838_obligation_0_51a8a4fc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "838" ;
    dzdoc:position 837 ;
    dzdoc:usesTerm dzterm:administrative_court,
        dzterm:judicial_bailiff,
        dzterm:official_notification,
        dzterm:reporting_judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_84> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_84" ;
    dzdoc:fullText "يمكن للقاضي أن ينتقل خارج دائرة اختصاصه للقيام بإجراء التحقيق أو لمراقبة تنفيذه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_84_permission_0_5ae28e5e> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_84_right_0_2d1dc208> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_84> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_84_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_84_20080225_OpEnact_f2d40570e2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "84" ;
    dzdoc:position 83 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_842> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_842" ;
    dzdoc:fullText "يجوز لرئيس المحكمة الإدارية أن يرخص في حالة الضرورة الملحة ، بتسليم هذه الوثائق مؤقتا إلى الخصوم أو ممثليهم خلال أجل يحدده."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_842_permission_0_c38d40e5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_842> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_842_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_842_20080225_OpEnact_6a4ca0c681> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "842" ;
    dzdoc:position 841 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_842_condition_0_20cafde3> ;
    dzdoc:usesTerm dzterm:administrative_court .

<https://legal.dz/resource/law/2008-02-25/08-09#art_847> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_847" ;
    dzdoc:fullText "يجوز لرئيس المحكمة الإدارية أن يقرر بألا وجه للتحقيق في القضية عندما يتبين له من العريضة أن حلها مؤكد ، ويرسل الملف إلى محافظ الدولة لتقديم التماساته. في هذه الحالة يأمر الرئيس بإحالة الملف أمام تشكيلة الحكم بعد تقديم التماسات محافظ الدولة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_847_permission_0_2a028c00> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_847> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_847_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_847_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_847_20080225_OpEnact_ea622bf8bf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 847" ;
    dzdoc:position 846 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_847_condition_0_47d95a2c> ;
    dzdoc:usesTerm dzterm:president_administrative_court,
        dzterm:state_commissioner .

<https://legal.dz/resource/law/2008-02-25/08-09#art_855> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_855" ;
    dzdoc:fullText "يجوز لرئيس تشكيلة الحكم في حالة الضرورة أن يقرر إعادة السير في التحقيق، بموجب أمرغير مسبب وغير قابل لأي طعن. يبلغ هذا الأمر بنفس شروط تبليغ أمر اختتام التحقيق المنصوص عليه في المادة 852 أعلاه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_855_permission_0_6a9e354a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_855> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_855_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_855_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_855_20080225_OpEnact_49e0fad997> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 855" ;
    dzdoc:position 854 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_852> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_852> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_855_condition_0_f610c34f> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "يجوز للخصوم أن يستعينوا بمحاميهم أثناء تنفيذ إجراءات التحقيق ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_86_permission_0_1fd41ffa> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_86_right_0_f4259582> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_86_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_86_20080225_OpEnact_6d887d3bbd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "86" ;
    dzdoc:position 85 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_87" ;
    dzdoc:fullText "يجوز لممثل أو محامي أحد الخصوم أمام الجهة القضائية التي أمرت بإجراء التحقيق، متابعة تنفيذه أيا كان مكانه، وتقديم الملاحظات والطلبات المتعلقة به حتى في غياب الخصم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_87_permission_0_add48a2e> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_87_right_0_a2ecd8ca> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_87> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_87_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_87_20080225_OpEnact_16d064c642> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "87" ;
    dzdoc:position 86 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_875> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_875" ;
    dzdoc:fullText "يجوز لتشكيلة الحكم أو لرئيس المحكمة الإدارية ، أن يقرر في أي وقت وفي حالة الضرورة ، جدولة أية قضية للجلسة للفصل فيها بإحدى تشكيلاتها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_875_permission_0_336d7fd8> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_875_right_0_36eee4bf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_875> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_875_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_875_20080225_OpEnact_bd84df003f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "875" ;
    dzdoc:position 874 ;
    dzdoc:usesTerm dzterm:judgment_formation,
        dzterm:president_court .

<https://legal.dz/resource/law/2008-02-25/08-09#art_877> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_877" ;
    dzdoc:fullText "يقدم طلب الرد بعريضة تودع بأمانة ضبط الجهة القضائية الإدارية التي يعمل بها القاضي المعني. وإذا كان القاضي المطلوب رده رئيس محكمة إدارية ، يقدم الطلب مباشرة إلى رئيس مجلس الدولة، ويفصل فيه وفقا لأحكام المادة 882 أدناه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_877> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_877_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_877_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_877_20080225_OpEnact_0efcd14791> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_877_obligation_0_b6f82a41>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_877_obligation_1_dc297c70> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "877" ;
    dzdoc:position 876 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_882> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_882> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_877_condition_0_71bb269c> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "يجوز لممثل النيابة العامة حضور إجراءات التحقيق في القضايا التي يتم إشعاره بها، وعند الاقتضاء، إبداء ملاحظاته ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_88_permission_0_cd4d17b7> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_88_right_0_f041a537> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_88_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_88_20080225_OpEnact_5b6dc201c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "88" ;
    dzdoc:position 87 ;
    dzdoc:usesTerm dzterm:public_prosecutor .

<https://legal.dz/resource/law/2008-02-25/08-09#art_892> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_892" ;
    dzdoc:fullText "يؤشر على أصل الحكم المصحح وعلى النسخ المستخرجة منه بما قضى به حكم التصحيح، ويبلغ الخصوم بحكم التصحيح. إذا كان الحكم المصحح حائزا لقوة الشيء المقضي به فلا يكون حكم التصحيح قابلا لأي طعن."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_892> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_892_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_892_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_892_20080225_OpEnact_3174dfbdbd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_892_obligation_0_77c4fda4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "892" ;
    dzdoc:position 891 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_892_condition_0_4aa74a42> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_895> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_895" ;
    dzdoc:fullText "يجوز بصفة استثنائية لرئيس المحكمة الإدارية أن يأمر بتبليغ الحكم أو الأمر إلى الخصوم عن طريق أمانة الضبط ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_895_permission_0_a251c796> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_895_right_0_7d07de05> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_895> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_895_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_895_20080225_OpEnact_0af9f18329> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "895" ;
    dzdoc:position 894 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_911> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_2_sec_2_subsec_3> ;
    dzdoc:eId "art_911" ;
    dzdoc:fullText "يجوز ل مجلس الدولة ، إذا أخطر بعريضة رفع وقف التنفيذ المأمور به من طرف المحكمة الإدارية ، أن يقرر رفعه حالا ، إذا كان من شأنه الإضرار بمصلحة عامة أو بحقوق المستأنف، وذلك إلى غاية الفصل في موضوع الاستئناف ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_911_permission_0_ef547a33> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_911> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_911_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_911_20080225_OpEnact_adf3192600> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 911" ;
    dzdoc:position 910 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_911_condition_0_b46d1a4f> ;
    dzdoc:usesTerm dzterm:administrative_court,
        dzterm:council_of_state .

<https://legal.dz/resource/law/2008-02-25/08-09#art_926> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_926" ;
    dzdoc:fullText "يجب أن ترفع العريضة الرامية إلى وقف تنفيذ القرار الإداري أو بعض آثاره، تحت طائلة عدم القبول، بنسخة من عريضة دعوى الموضوع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_926> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_926_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_926_20080225_OpEnact_3d4ad5dc30> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_926_obligation_0_9d057538> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "926" ;
    dzdoc:position 925 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_937> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_2_subsec_3> ;
    dzdoc:eId "art_937" ;
    dzdoc:fullText "تخضع الأوامر الصادرة طبقا لأحكام المادة 920 أعلاه، للطعن بالاستئناف أمام مجلس الدولة خلال همسة عشر (15) يوما التالية للتبليغ الرسمي أو التبليغ . في هذه الحالة، يفصل مجلس الدولة في أجل ثمان وأربعين (48) ساعة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_937> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_937_para_0>,
