    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_762> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_762_obligation_1_02acca4d_role_5ad092641e> a dznorm:Role ;
    rdfs:label "المحضر القضائي قيد حكم"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يتعين على المحضر القضائي قيد حكم رسو المزاد بالحافظة العقارية من أجل إشهاره خلال أجل شهرين (2) من تاريخ صدوره"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_762> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_762_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_762> ;
    dzdoc:position 1 ;
    dzdoc:text "يتعين على المحضر القضائي قيد حكم رسو المزاد بالحافظة العقارية من أجل إشهاره خلال أجل شهرين (2) من تاريخ صدوره."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_763_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_763> ;
    dzdoc:position 0 ;
    dzdoc:text "يتضمن حكم رسو المزاد، فضلا عن بيانات الأحكام المألوفة وأسماء وألقاب الأطراف ما يأتي : السند التنفيذي الذي بموجبه تم الحجز والإجراءات التي تلته، لا سيما تاريخ كل من التبليغ الرسمي والتكليف بالوفاء وإعلان البيع، تعيين العقار و/أو الحق العيني العقاري المباع ومشتملاته والارتفاقات العالقة به إن وجدت، كما هو معين في قائمة شروط البيع، تحديد الثمن الأساسي للعقار و/أو الحق العيني العقاري المباع، إجراءات البيع بالمزاد العلني، الهوية الكاملة للراسي عليه المزاد شخصا طبيعيا أو معنويا، الثمن الراسي به المزاد وتاريخ الدفع، إلزام المحجوز عليه أو الحائز أو الكفيل العيني أو الحارس حسب الأحوال بتسليم العقار و/أو الحق العيني العقاري لمن رسا عليه المزاد."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_764_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_764> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يبلغ حكم رسو المزاد لأطراف الحجز، ويتم تنفيذه جبرا على الأشخاص المذكورين في المادة 763 -7 أعلاه."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_764_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_764> ;
    dzdoc:position 1 ;
    dzdoc:text "يترتب على قيد حكم رسو المزاد بالمحافظة العقارية تطهير العقار و/أو الحق العيني العقاري من كل التأمينات العينية."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_765_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_765> ;
    dzdoc:position 0 ;
    dzdoc:text "حكم رسو المزاد غير قابل لأي طعن."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_766_condition_0_448c62ef> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/law/2008-02-25/08-09#art_766_condition_0_448c62ef_action_9c31ca5605> ;
    dzdoc:hasReference <https://legal.dz/resource/law/2008-02-25/08-09#art_766_condition_0_448c62ef_ref_5b72549926b7> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2008-02-25/08-09#art_766_condition_0_448c62ef_role_b37d7de1c7> ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_721> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_721> ;
    dznorm:conditionText "يجوز للدائن وفقا لأحكام المادة 721 أعلاه ، الحجز على عقارات مدينه غير المشهرة، إذا كان لها مقرر إداري أو سند عرفي ثابت التاريخ وفقا لأحكام القانون المدني"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_766> ;
    dznorm:position 0 .

