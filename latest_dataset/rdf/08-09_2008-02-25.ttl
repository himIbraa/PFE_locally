<https://legal.dz/resource/law/2008-02-25/08-09#version_art_1046> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن لمحكمة التحكيم أن تأمر بتدابير مؤقتة أو تحفظية بناء على طلب أحد الأطراف ، ما لم ينص اتفاق التحكيم على خلاف ذلك . إذا لم يقم الطرف المعني بتنفيذ هذا التدبير إراديا ، جاز لمحكمة التحكيم أن تطلب تدخل القاضي المختص ، ويطبق في هذا الشأن قانون بلد القاضي. يمكن لمحكمة التحكيم أو للقاضي أن يخضع التدابير المؤقتة أو التحفظية لتقديم الضمانات الملائمة من قبل الطرف الذي طلب هذا التدبير ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1046_20080225_OpEnact_419cf70d47> ;
    dzdoc:replacementText "يمكن لمحكمة التحكيم أن تأمر بتدابير مؤقتة أو تحفظية بناء على طلب أحد الأطراف ، ما لم ينص اتفاق التحكيم على خلاف ذلك . إذا لم يقم الطرف المعني بتنفيذ هذا التدبير إراديا ، جاز لمحكمة التحكيم أن تطلب تدخل القاضي المختص ، ويطبق في هذا الشأن قانون بلد القاضي. يمكن لمحكمة التحكيم أو للقاضي أن يخضع التدابير المؤقتة أو التحفظية لتقديم الضمانات الملائمة من قبل الطرف الذي طلب هذا التدبير ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_1046> ;
