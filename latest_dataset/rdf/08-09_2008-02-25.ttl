<https://legal.dz/resource/law/2008-02-25/08-09#version_art_303> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمس الأمر الاستعجالي أصل الحق، وهو معجل النفاذ بكفالة أو بدونها رغم كل طرق الطعن. كما أنه غير قابل للمعارضة ولا للاعتراض على النفاذ المعجل. في حالة الاستعجال القصوى ، يأمر القاضي بالتنفيذ بموجب النسخة الأصلية للأمر حتى قبل تسجيله ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_303_20080225_OpEnact_e2581e4a5b> ;
