<https://legal.dz/resource/law/2008-02-25/08-09#version_art_15> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن تتضمن عريضة افتتاح الدعوى، تحت طائلة عدم قبولها شكلا ، البيانات الآتية : 1 - الجهة القضائية التي ترفع أمامها الدعوى، 2- اسم ولقب المدعي وموطنه، 3- اسم ولقب وموطن المدعى عليه، فإن لم يكن له موطن معلوم، فآخر موطن له، 4- الإشارة إلى تسمية وطبيعة الشخص المعنوي، ومقره الاجتماعي وصفة ممثله القانوني أو الاتفاقي، 5- عرضا موجزا للوقائع والطلبات والوسائل التي تؤسس عليها الدعوى، 6- الإشارة عند الاقتضاء، إلى المستندات والوثائق المؤيدة للدعوى."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_15_20080225_OpEnact_0f13bbffdd> ;
    dzdoc:replacementText "يجب أن تتضمن عريضة افتتاح الدعوى، تحت طائلة عدم قبولها شكلا ، البيانات الآتية : 1 - الجهة القضائية التي ترفع أمامها الدعوى، 2- اسم ولقب المدعي وموطنه، 3- اسم ولقب وموطن المدعى عليه، فإن لم يكن له موطن معلوم، فآخر موطن له، 4- الإشارة إلى تسمية وطبيعة الشخص المعنوي، ومقره الاجتماعي وصفة ممثله القانوني أو الاتفاقي، 5- عرضا موجزا للوقائع والطلبات والوسائل التي تؤسس عليها الدعوى، 6- الإشارة عند الاقتضاء، إلى المستندات والوثائق المؤيدة للدعوى."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_15> ;
