<https://legal.dz/resource/law/2008-02-25/08-09#version_art_317> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يسري الأجل على شخص موضوع تحت نظام الولاية، إلا من تاريخ التبليغ الرسمي للحكم، إلى وليه أو وصيه أو المقدم عليه، و في حالة وجود تضارب بين مصلحته ومصلحة أحدهم ، يتم التبليغ الرسمي إلى المتصرف الخاص."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_317_20080225_OpEnact_17b76de1be> ;
    dzdoc:replacementText "لا يسري الأجل على شخص موضوع تحت نظام الولاية، إلا من تاريخ التبليغ الرسمي للحكم، إلى وليه أو وصيه أو المقدم عليه، و في حالة وجود تضارب بين مصلحته ومصلحة أحدهم ، يتم التبليغ الرسمي إلى المتصرف الخاص."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_317> ;
