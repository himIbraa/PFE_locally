    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للخصوم الاعتراض على تصفية المصاريف أمام رئيس الجهة القضائية التي أصدرت الحكم في أجل عشرة (10) أيام من تاريخ التبليغ الرسمي إذا كان صادرا في آخر درجة . الأمر الفاصل في الاعتراض غير قابل لأي طعن."@ar ;
