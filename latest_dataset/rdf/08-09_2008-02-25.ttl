    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يحدد أجل الطعن بالنقض بشهرين (2) يسري من تاريخ التبليغ الرسمي للقرار محل الطعن ، ما لم ينص القانون على خلاف ذلك."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_957_20080225_OpEnact_f875c6f416> a dzdoc:ArticleVersion ;
