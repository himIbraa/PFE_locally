<https://legal.dz/resource/law/2008-02-25/08-09#version_art_639> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز الحجز على الأجور والمرتبات ومعاشات التقاعد أو العجز الجسماني ، إلا في الحدود المنصوص عليها في هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
