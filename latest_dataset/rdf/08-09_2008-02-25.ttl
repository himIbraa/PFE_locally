<https://legal.dz/resource/law/2008-02-25/08-09#version_art_846> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما تكون القضية مهيأة للجلسة، أو عندما تقتضي القيام بالتحقيق عن طريق خبرة أو سماع شهود أو غيرها من الإجراءات يرسل الملف إلى محافظ الدولة لتقديم التماساته بعد دراسته من قبل القاضي المقرر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_846_20080225_OpEnact_bf5379f098> ;
