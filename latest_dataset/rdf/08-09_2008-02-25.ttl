<https://legal.dz/resource/law/2008-02-25/08-09#version_art_801> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تختص المحاكم الإدارية كذلك بالفصل في : 1- دعاوى إلغاء القرارات الإدارية والدعاوى التفسيرية ودعاوى فحص المشروعية للقرارات الصادرة عن: الولاية والمصالح غير الممركزة للدولة على مستوى الولاية، البلدية والمصالح الإدارية الأخرى للبلدية، المؤسسات العمومية المحلية ذات الصبغة الإدارية، 2- دعاوى القضاء الكامل، 3- القضايا المخولة لها بموجب نصوص خاصة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_801_20080225_OpEnact_1d04cd245c> ;
    dzdoc:replacementText "تختص المحاكم الإدارية كذلك بالفصل في : 1- دعاوى إلغاء القرارات الإدارية والدعاوى التفسيرية ودعاوى فحص المشروعية للقرارات الصادرة عن: الولاية والمصالح غير الممركزة للدولة على مستوى الولاية، البلدية والمصالح الإدارية الأخرى للبلدية، المؤسسات العمومية المحلية ذات الصبغة الإدارية، 2- دعاوى القضاء الكامل، 3- القضايا المخولة لها بموجب نصوص خاصة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_801> ;
