<https://legal.dz/resource/law/2008-02-25/08-09#version_art_919> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يتعلق الأمر بقرار إداري ولو بالرفض، ويكون موضوع طلب إلغاء كلي أو جزئي ، يجوز لـ قاضي الاستعجال ، أن يأمر بوقف تنفيذ هذا القرار أو وقف آثار معينة منه متى كانت ظروف الاستعجال تبرر ذلك، ومتى ظهر له من التحقيق وجود وجه خاص من شأنه إحداث شك جدي حول مشروعية القرار . عندما يقضى بوقف التنفيذ ، يفصل في طلب إلغاء القرار في أقرب الآجال. ينتهي أثر وقف التنفيذ عند الفصل في موضوع الطلب."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_919_20080225_OpEnact_cc778b27b6> ;
    dzdoc:replacementText "عندما يتعلق الأمر بقرار إداري ولو بالرفض، ويكون موضوع طلب إلغاء كلي أو جزئي ، يجوز لـ قاضي الاستعجال ، أن يأمر بوقف تنفيذ هذا القرار أو وقف آثار معينة منه متى كانت ظروف الاستعجال تبرر ذلك، ومتى ظهر له من التحقيق وجود وجه خاص من شأنه إحداث شك جدي حول مشروعية القرار . عندما يقضى بوقف التنفيذ ، يفصل في طلب إلغاء القرار في أقرب الآجال. ينتهي أثر وقف التنفيذ عند الفصل في موضوع الطلب."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_919> ;
