    dzdoc:versionOf <https://legal.dz/resource/law/2008-02-25/08-09#art_862> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_862> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "تطبق الأحكام المتعلقة بـ مضاهاة الخطوط المنصوص عليها في المواد من 164 إلى 174 من هذا القانون أمام المحاكم الإدارية ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_863_20080225_OpEnact_45669a33a9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_863> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-02-25/08-09#art_863> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_863> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يجوز لرئيس تشكيلة الحكم تعيين أحد أعضائها للقيام بكل تدابير التحقيق غير تلك الواردة في المواد من 858 إلى 861 أعلاه."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_864_20080225_OpEnact_69007c18d9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_864> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-02-25/08-09#art_864> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_864> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "عندما يؤمر بأحد تدابير التحقيق ، يجوز لـ تشكيلة الحكم أن تقرر إجراء تسجيل صوتي أو بصري أو سمعي بصري لكل العمليات أو لجزء منها."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_865_20080225_OpEnact_ae7ac5b9e7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
