    dznorm:position 0 ;
    dznorm:provisionText "تباع القيم المنقولة والأسهم بواسطة أحد البنوك أو أية مؤسسة مؤهلة قانونا، تعين من طرف رئيس المحكمة بأمر على عريضة، بناء على طلب الدائن الحاجز"@ar ;
    dznorm:sourceArticle "art_720" .

