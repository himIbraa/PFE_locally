<https://legal.dz/resource/law/2008-02-25/08-09#version_art_606> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز تنفيذ العقود والسندات الرسمية المحررة في بلد أجنبي، في الإقليم الجزائري، إلا بعد منحها الصيغة التنفيذية من إحدى الجهات القضائية الجزائرية متى استوفت الشروط الآتية : توافر الشروط المطلوبة لرسمية السند وفقا لقانون البلد الذي حرر فيه، توفره على صفة السند التنفيذي وقابليته للتنفيذ وفقا لقانون البلد الذي حرر فيه، خلوه مما يخالف القوانين الجزائرية و النظام العام والآداب العامة في الجزائر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_606_20080225_OpEnact_f87246fa4c> ;
    dzdoc:replacementText "لا يجوز تنفيذ العقود والسندات الرسمية المحررة في بلد أجنبي، في الإقليم الجزائري، إلا بعد منحها الصيغة التنفيذية من إحدى الجهات القضائية الجزائرية متى استوفت الشروط الآتية : توافر الشروط المطلوبة لرسمية السند وفقا لقانون البلد الذي حرر فيه، توفره على صفة السند التنفيذي وقابليته للتنفيذ وفقا لقانون البلد الذي حرر فيه، خلوه مما يخالف القوانين الجزائرية و النظام العام والآداب العامة في الجزائر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_606> ;
