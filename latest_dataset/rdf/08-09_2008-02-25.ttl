    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_383_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_383> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز لدائني أحد الخصوم أو خلفهم، حتى ولو كانوا ممثلين في الدعوى، تقديم اعتراض الغير الخارج عن الخصومة على الحكم أو القرار أو الأمر، بشرط أن يكون الحكم أو القرار أو الأمر المطعون فيه قد مس بحقوقهم بسبب الغش."@ar .

