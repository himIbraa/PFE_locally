    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "توزع الطعون بالنقض المعروضة أمام مجلس الدولة على الغرف من طرف رئيس مجلس الدولة ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_958_20080225_OpEnact_6cdbb899ef> a dzdoc:ArticleVersion ;
