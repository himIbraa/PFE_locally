<https://legal.dz/resource/law/2008-02-25/08-09#art_970> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_5_sec_1> ;
    dzdoc:eId "art_970" ;
    dzdoc:fullText "يجوز للجهات القضائية الإدارية إجراء الصلح في مادة القضاء الكامل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_970_permission_0_badc57c1> ;
