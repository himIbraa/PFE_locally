<https://legal.dz/resource/law/2008-02-25/08-09#version_art_569> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عند انتهاء الآجال القانونية المحددة للأطراف لإيداع مذكراتهم ، يرسل أمين الضبط الرئيسي للمجلس القضائي الملف مشكلا ومره فقا بملف القضية إلى أمين الضبط الرئيسي للمحكمة العليا ، الذي يحيله بدوره إلى رئيس الغرفة المعنية."@ar ;
