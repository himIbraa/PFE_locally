<https://legal.dz/resource/law/2008-02-25/08-09#version_art_819> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يرفق مع العريضة الرامية إلى إلغاء أو تفسير أو تقدير مدى مشروعية القرار الإداري، تحت طائلة عدم القبول، القرار الإداري المطعون فيه ، ما لم يوجد مانع مبرر. وإذا ثبت أن هذا المانع يعود إلى امتناع الإدارة من تمكين المدعي من القرار المطعون فيه ، أمرها القاضي المقرر بتقديمه في أول جلسة، ويستخلص النتائج القانونية المترتبة على هذا الامتناع."@ar ;
