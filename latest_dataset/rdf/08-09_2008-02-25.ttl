<https://legal.dz/resource/law/2008-02-25/08-09#version_art_1045> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون القاضي غير مختص بالفصل في موضوع النزاع ، إذا كانت الخصومة التحكيمية قائمة، أو إذا تبين له وجود اتفاقية تحكيم على أن تثار من أحد الأطراف ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1045_20080225_OpEnact_d6dfbefd99> ;
    dzdoc:replacementText "يكون القاضي غير مختص بالفصل في موضوع النزاع ، إذا كانت الخصومة التحكيمية قائمة، أو إذا تبين له وجود اتفاقية تحكيم على أن تثار من أحد الأطراف ."@ar ;
