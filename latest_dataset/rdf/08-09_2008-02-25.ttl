<https://legal.dz/resource/law/2008-02-25/08-09#version_art_780> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتولى المحضر القضائي دعوة الدائن الحاجز و المدين المحجوز عليه للحضور أمام رئيس المحكمة في أجل أقصاه ثمانية (8) أيام من تاريخ التبليغ الرسمي لأمر الحجز . يقوم رئيس المحكمة بمحاولة الصلح بين الطرفين في أجل أقصاه شهر واحد (1)، ويحرر محضرا يثبت فيه حضورهما أو غيابهما . إذا حصل صلح ، يقيد رئيس المحكمة الشروط المتفق عليها في محضر ، ويأمر برفع الحجز تلقائيا . إذا لم يحصل الصلح ، يثبت ذلك في محضر ويصدر أمرا بالتحويل لفائدة الدائن الحاجز ، يحدد فيه، فضلا عن البيانات المعتادة، ما يأتي : اسم ولقب وصفة الدا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_780_20080225_OpEnact_c14f1af2f8> ;
    dzdoc:replacementText "يتولى المحضر القضائي دعوة الدائن الحاجز و المدين المحجوز عليه للحضور أمام رئيس المحكمة في أجل أقصاه ثمانية (8) أيام من تاريخ التبليغ الرسمي لأمر الحجز . يقوم رئيس المحكمة بمحاولة الصلح بين الطرفين في أجل أقصاه شهر واحد (1)، ويحرر محضرا يثبت فيه حضورهما أو غيابهما . إذا حصل صلح ، يقيد رئيس المحكمة الشروط المتفق عليها في محضر ، ويأمر برفع الحجز تلقائيا . إذا لم يحصل الصلح ، يثبت ذلك في محضر ويصدر أمرا بالتحويل لفائدة الدائن الحاجز ، يحدد فيه، فضلا عن البيانات المعتادة، ما يأتي : اسم ولقب وصفة الدائن الحاجز وتاريخ الميلاد ومكانه وموطنه، اسم ولقب المدين المحجوز عليه ، اسم ولقب وصفة المحجوز لديه وعنوانه، مبلغ الدين المحجوز من أجله، تحديد النسبة المحجوزة وتقدير المبلغ المقتطع من المرتب أو الأجر، أمر المحجوز لديه بتسليم المبلغ المقتطع إلى الدائن الحاجز نقدا مقابل وصل أو دفعه في حساب جار، أو بحوالة بريدية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_780> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_780> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_781> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان مبلغ الدين محددا بصفة نهائية في السند التنفيذي ، يقتصر أمر التحويل وجوبا على مبلغ الدين . وإذا كان مبلغ الدين نفقة غذائية ، يتضمن أمر التحويل الاستمرار في الدفع شهريا إلى الدائن الحاجز ، إلى غاية انقضائه قانونا أو صدور أمر مخالف ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_781_20080225_OpEnact_3ffd96a44b> ;
    dzdoc:replacementText "إذا كان مبلغ الدين محددا بصفة نهائية في السند التنفيذي ، يقتصر أمر التحويل وجوبا على مبلغ الدين . وإذا كان مبلغ الدين نفقة غذائية ، يتضمن أمر التحويل الاستمرار في الدفع شهريا إلى الدائن الحاجز ، إلى غاية انقضائه قانونا أو صدور أمر مخالف ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_781> ;
