    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 1047" ;
    dzdoc:position 1046 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1053> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_6_subsec_3> ;
    dzdoc:eId "art_1053" ;
    dzdoc:fullText "تودع الوثائق المذكورة في المادة 1052 أعلاه، بأمانة ضبط الجهة القضائية المختصة من الطرف المعني بالتعجيل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1053> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1053_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1053_20080225_OpEnact_a1f9f1e697> ;
