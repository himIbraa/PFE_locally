<https://legal.dz/resource/law/2008-02-25/08-09#version_art_392> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن تقديم التماس إعادة النظر لأحد السببين الآتيين : 1- إذا بني الحكم أو القرار أو الأمر على شهادة شهود، أو على وثائق اعترف بتزويرها، أو ثبت قضائيا تزويرها بعد صدور ذلك الحكم أو القرار أو الأمر وحيازته قوة الشيء المقضي به، 2 - إذا اكتشفت بعد صدور الحكم أو القرار أو الأمر الحائز لقوة الشيء المقضي به، أوراق حاسمة في الدعوى، كانت محتجزة عمدا لدى أحد الخصوم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_392_20080225_OpEnact_28c35f2f2e> ;
    dzdoc:replacementText "يمكن تقديم التماس إعادة النظر لأحد السببين الآتيين : 1- إذا بني الحكم أو القرار أو الأمر على شهادة شهود، أو على وثائق اعترف بتزويرها، أو ثبت قضائيا تزويرها بعد صدور ذلك الحكم أو القرار أو الأمر وحيازته قوة الشيء المقضي به، 2 - إذا اكتشفت بعد صدور الحكم أو القرار أو الأمر الحائز لقوة الشيء المقضي به، أوراق حاسمة في الدعوى، كانت محتجزة عمدا لدى أحد الخصوم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_392> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
