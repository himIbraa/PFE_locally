<https://legal.dz/resource/law/2008-02-25/08-09#art_781_obligation_1_8ecfb4e8> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_781> ;
    dznorm:position 1 ;
    dznorm:provisionText "يتضمن أمر التحويل الاستمرار في الدفع شهريا إلى الدائن الحاجز، إلى غاية انقضائه قانونا أو صدور أمر مخالف"@ar ;
    dznorm:sourceArticle "art_781" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_781_para_0> a dzdoc:Paragraph ;
