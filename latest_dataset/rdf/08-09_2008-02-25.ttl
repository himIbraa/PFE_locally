    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_772> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_772_obligation_0_e0d0ba06> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
