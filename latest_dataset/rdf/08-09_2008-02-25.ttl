<https://legal.dz/resource/law/2008-02-25/08-09#version_art_611> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم التنفيذ من طرف المحضرين القضائيين ، بناء على طلب المستفيد من السند التنفيذي أو من ممثله القانوني أو الاتفاقي. تثبت علاقة الدائن بممثله طبقا لما يقرره القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_611_20080225_OpEnact_753f8a4bf9> ;
    dzdoc:replacementText "يتم التنفيذ من طرف المحضرين القضائيين ، بناء على طلب المستفيد من السند التنفيذي أو من ممثله القانوني أو الاتفاقي. تثبت علاقة الدائن بممثله طبقا لما يقرره القانون."@ar ;
