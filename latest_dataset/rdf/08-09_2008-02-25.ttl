<https://legal.dz/resource/law/2008-02-25/08-09#version_art_676> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كانت للمدين أموال تحت يد الدولة أو إحدى الجماعات الإقليمية أو مؤسسة عمومية أو هيئة عمومية وطنية ، وجب عليها أن تسلم للدائن الحاجز أو المحضر القضائي بناء على طلبه شهادة تثبت ما لديها من أموال للمدين المحجوز عليه ."@ar ;
