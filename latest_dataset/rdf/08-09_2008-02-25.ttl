<https://legal.dz/resource/law/2008-02-25/08-09#version_art_151> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد القاضي في الحكم الأمر بسماع الشهود الوقائع التي يسمعون حولها، ويوم وساعة الجلسة المحددة لذلك، مع مراعاة الظروف الخاصة بكل قضية. يتضمن هذا الحكم دعوة الخصوم للحضور وإحضار شهودهم في اليوم والساعة المحددين للجلسة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_151_20080225_OpEnact_eaefd34808> ;
    dzdoc:replacementText "يحدد القاضي في الحكم الأمر بسماع الشهود الوقائع التي يسمعون حولها، ويوم وساعة الجلسة المحددة لذلك، مع مراعاة الظروف الخاصة بكل قضية. يتضمن هذا الحكم دعوة الخصوم للحضور وإحضار شهودهم في اليوم والساعة المحددين للجلسة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
