<https://legal.dz/resource/law/2008-02-25/08-09#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#body> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "تطبق أحكام هذا القانون على الدعاوى المرفوعة أمام الجهات القضائية العادية و الجهات القضائية الإدارية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1_20080225_OpEnact_fd6f6b27bc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة الأولى" ;
    dzdoc:position 0 ;
    dzdoc:usesTerm dzterm:administrative_judicial_bodies,
        dzterm:judicial_bodies .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1010> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_1010" ;
    dzdoc:fullText "يعرض النزاع على محكمة التحكيم من قبل الأطراف معا أو من الطرف الذي يهمه التعجيل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1010> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1010_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1010_20080225_OpEnact_f0ac0a4237> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 1010" ;
    dzdoc:position 1009 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1024> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_2> ;
    dzdoc:eId "art_1024" ;
    dzdoc:fullText "ينتهي التحكيم : بوفاة أحد المحكمين أو رفضه القيام بمهمته بمبرر أو تنحيته أو حصول مانع له، ما لم يوجد شرط مخالف، أو إذا اتفق الأطراف على استبداله أو استبداله من قبل المحكم أو المحكمين الباقين. وفي حالة غياب الاتفاق تطبق أحكام المادة 1009 أعلاه، بانتهاء المدة المقررة للتحكيم، فإذا لم تشترط المدة، فبانتهاء مدة أربعة (4) أشهر، بفقد الشيء موضوع النزاع أو انقضاء الدين المتنازع فيه، بوفاة أحد أطراف العقد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1024> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1024_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
