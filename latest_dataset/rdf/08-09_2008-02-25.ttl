<https://legal.dz/resource/law/2008-02-25/08-09#version_art_129> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد القاضي الأمر بالخبرة، مبلغ التسبيق على أن يكون مقاربا قدر الإمكان للمبلغ النهائي المحتمل لأتعاب ومصاريف الخبير. يعين القاضي الخصم أو الخصوم الذين يتعين عليهم إيداع مبلغ التسبيق لدى أمانة الضبط في الأجل الذي يحدده. يترتب على عدم إيداع التسبيق في الأجل المحدد اعتبار تعيين الخبير لاغيا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_129_20080225_OpEnact_97af8500ca> ;
