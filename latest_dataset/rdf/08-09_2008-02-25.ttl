<https://legal.dz/resource/law/2008-02-25/08-09#version_art_696> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وقع الحجز على حيوانات يجب تعيين نوعها وفصيلتها وعددها ووصف سنها وقيمتها التقريبية، وتبقى في حراسة المحجوز عليه."@ar ;
    dzdoc:isAuthoritative true ;
