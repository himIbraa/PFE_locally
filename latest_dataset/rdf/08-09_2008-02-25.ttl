<https://legal.dz/resource/law/2008-02-25/08-09#version_art_544> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يعين رئيس الغرفة مستشارا مقررا في القضية لتقديم تقريره، قبل تاريخ انعقاد أول جلسة ينادى فيها على القضية . إذا تبين للمستشار المقرر عدم قبول الاستئناف ، أدرجت القضية في أقرب جلسة لسماع الخصوم في ملاحظاتهم والفصل فيها فورا عند الاقتضاء."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
