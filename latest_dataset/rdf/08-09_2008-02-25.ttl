    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يتم إجراء الصلح بسعي من الخصوم أو بمبادرة من رئيس تشكيلة الحكم بعد موافقة الخصوم."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_973_20080225_OpEnact_1f28086003> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
