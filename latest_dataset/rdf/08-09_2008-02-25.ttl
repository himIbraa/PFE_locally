    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل منازعة تتعلق بقبول الكفيل تقدم من الخصم في أول جلسة، ويفصل فيها في الحال. إذا وقعت المنازعة ، يخطر أطراف الخصومة بتاريخ الجلسة التي سيتم الفصل فيها . الحكم الصادر في المنازعة واجب النفاذ رغم المعارضة أو الاستئناف."@ar ;
