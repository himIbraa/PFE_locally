<https://legal.dz/resource/law/2008-02-25/08-09#art_584_condition_0_1bc5b4de> a dznorm:Condition ;
    dznorm:conditionText "في حالة رفض العرض"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_584> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_584_obligation_0_84d18f41> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_584> ;
    dznorm:position 0 ;
    dznorm:provisionText "يقدم عرض الوفاء بواسطة محضر قضائي في الموطن الحقيقي أو المختار للدائن"@ar ;
    dznorm:sourceArticle "art_584" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_584_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_584> ;
    dzdoc:position 0 ;
    dzdoc:text "يقدم عرض الوفاء بواسطة محضر قضائي في الموطن الحقيقي أو المختار للدائن، ويبلغ رسميا وفقا لأحكام هذا القانون."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_584_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_584> ;
    dzdoc:position 1 ;
    dzdoc:text "يتضمن محضر العرض : اسم ولقب المدين وموطنه، اسم ولقب الدائن وموطنه الحقيقي أو المختار، وصف الشيء المعروض بحيث لا يمكن استبداله بغيره، وإن كان الشيء المعروض نقودا يحدد مقدارها ونوعها، ذكر أسباب العرض، رفض أو قبول الدائن للعرض، توقيع الدائن أو الشخص المبلغ له العرض، أو الإشارة إلى رفض التوقيع أو عدم قدرته على ذلك، تنبيه الدائن بأنه في حالة رفض العرض سيتم الإيداع في المكان واليوم والساعة المحددة في طلب العرض، وأنه سيسقط حقه في المطالبة به، بعد مضي سنة واحدة (1) تسري من تاريخ الإيداع."@ar .

