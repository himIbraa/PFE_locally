<https://legal.dz/resource/law/2008-02-25/08-09#version_art_620> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم التنفيذ على الأموال المنقولة، فإن كان مقدارها لا يغطي الدين والمصاريف، انتقل التنفيذ إلى العقارات. وإذا لم يكن للمنفذ عليه عقارات فيتم التنفيذ على أمواله المنقولة مهما كانت قيمتها مع مراعاة أحكام المادتين 622 و 636 أدناه. أما أصحاب حقوق الامتيازات الخاصة أو التخصيص أو الدائنين المرتهنين فيمكنهم التنفيذ مباشرة على العقارات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_620_20080225_OpEnact_e84e415e5c> ;
    dzdoc:replacementText "يتم التنفيذ على الأموال المنقولة، فإن كان مقدارها لا يغطي الدين والمصاريف، انتقل التنفيذ إلى العقارات. وإذا لم يكن للمنفذ عليه عقارات فيتم التنفيذ على أمواله المنقولة مهما كانت قيمتها مع مراعاة أحكام المادتين 622 و 636 أدناه. أما أصحاب حقوق الامتيازات الخاصة أو التخصيص أو الدائنين المرتهنين فيمكنهم التنفيذ مباشرة على العقارات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_620> ;
