dzterm:third_party_opposition a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "اعتراض الغير الخارج عن الخصومة"@ar,
        "يهدف اعتراض الغير الخارج عن الخصومة إلى مراجعة أو إلغاء الحكم أو القرار أو الأمر الاستعجالي الذي فصل في أصل النزاع."@ar ;
