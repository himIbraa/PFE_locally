<https://legal.dz/resource/law/2008-02-25/08-09#version_art_809> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما تخطر المحكمة الإدارية بطلبات مستقلة في نفس الدعوى، لكنها مرتبطة، بعضها يعود إلى اختصاصها والبعض الآخر يعود إلى اختصاص مجلس الدولة ، يحيل رئيس المحكمة جميع هذه الطلبات إلى مجلس الدولة . عندما تخطر المحكمة الإدارية بطلبات، بمناسبة النظر في دعوى تدخل في اختصاصها، وتكون في نفس الوقت مرتبطة بطلبات مقدمة في دعوى أخرى مرفوعة أمام مجلس الدولة ، وتدخل في اختصاصه ، يحيل رئيس المحكمة تلك الطلبات أمام مجلس الدولة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_809_20080225_OpEnact_1901845510> ;
    dzdoc:replacementText "عندما تخطر المحكمة الإدارية بطلبات مستقلة في نفس الدعوى، لكنها مرتبطة، بعضها يعود إلى اختصاصها والبعض الآخر يعود إلى اختصاص مجلس الدولة ، يحيل رئيس المحكمة جميع هذه الطلبات إلى مجلس الدولة . عندما تخطر المحكمة الإدارية بطلبات، بمناسبة النظر في دعوى تدخل في اختصاصها، وتكون في نفس الوقت مرتبطة بطلبات مقدمة في دعوى أخرى مرفوعة أمام مجلس الدولة ، وتدخل في اختصاصه ، يحيل رئيس المحكمة تلك الطلبات أمام مجلس الدولة ."@ar ;
