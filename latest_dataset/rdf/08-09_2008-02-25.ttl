<https://legal.dz/resource/law/2008-02-25/08-09#version_art_847> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لرئيس المحكمة الإدارية أن يقرر بألا وجه للتحقيق في القضية عندما يتبين له من العريضة أن حلها مؤكد ، ويرسل الملف إلى محافظ الدولة لتقديم التماساته. في هذه الحالة يأمر الرئيس بإحالة الملف أمام تشكيلة الحكم بعد تقديم التماسات محافظ الدولة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_847_20080225_OpEnact_ea622bf8bf> ;
    dzdoc:replacementText "يجوز لرئيس المحكمة الإدارية أن يقرر بألا وجه للتحقيق في القضية عندما يتبين له من العريضة أن حلها مؤكد ، ويرسل الملف إلى محافظ الدولة لتقديم التماساته. في هذه الحالة يأمر الرئيس بإحالة الملف أمام تشكيلة الحكم بعد تقديم التماسات محافظ الدولة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_847> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
