        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان العقار و/أو الحق العيني العقاري ، مثقلا بتأمين عيني وانتقلت ملكيته بعقد رسمي مشهر إلى الغير قبل قيد أمر الحجز ، وجب إنذار الغير الحائز وتكليفه بدفع مبلغ الدين أو تخليته العقار، وإلا بيع العقار جبرا عليه . يجب أن يشتمل الإنذار ، فضلا عن البيانات المعتادة، على ما يأتي : 1- بيان السند التنفيذي والإجراءات التالية له، 2- بيان أمر الحجز وتاريخ القيد، 3- إنذار الحائز وتكليفه بالوفاء بمبلغ الدين خلال أجل شهر واحد (1) من تاريخ التبليغ الرسمي، وإلا بيع العقار جبرا عليه. تطبق جميع الأحكام المنصوص ع"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_734_20080225_OpEnact_c0bfaf5860> ;
    dzdoc:replacementText "إذا كان العقار و/أو الحق العيني العقاري ، مثقلا بتأمين عيني وانتقلت ملكيته بعقد رسمي مشهر إلى الغير قبل قيد أمر الحجز ، وجب إنذار الغير الحائز وتكليفه بدفع مبلغ الدين أو تخليته العقار، وإلا بيع العقار جبرا عليه . يجب أن يشتمل الإنذار ، فضلا عن البيانات المعتادة، على ما يأتي : 1- بيان السند التنفيذي والإجراءات التالية له، 2- بيان أمر الحجز وتاريخ القيد، 3- إنذار الحائز وتكليفه بالوفاء بمبلغ الدين خلال أجل شهر واحد (1) من تاريخ التبليغ الرسمي، وإلا بيع العقار جبرا عليه. تطبق جميع الأحكام المنصوص عليها في المواد 731 و 732 و 733 أعلاه، عند إنذار الحائز وتكليفه بالوفاء."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_734> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_734> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
