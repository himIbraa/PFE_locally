<https://legal.dz/resource/law/2008-02-25/08-09#version_art_703> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون الحجز والإجراءات التالية له قابلين للإبطال، إذا لم يتم البيع خلال أجل ستة (6) أشهر ابتداء من تاريخ التبليغ الرسمي للحجز إلى المحجوز عليه ، ما لم يكن قد تم إيقاف البيع باتفاق الخصوم أو بحكم قضائي. إذا تسبب المحضر القضائي أو محافظ البيع في هذا البطلان ، يجوز إلزامهما بالتعويضات المدنية للحاجز ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_703_20080225_OpEnact_5d3090976f> ;
    dzdoc:replacementText "يكون الحجز والإجراءات التالية له قابلين للإبطال، إذا لم يتم البيع خلال أجل ستة (6) أشهر ابتداء من تاريخ التبليغ الرسمي للحجز إلى المحجوز عليه ، ما لم يكن قد تم إيقاف البيع باتفاق الخصوم أو بحكم قضائي. إذا تسبب المحضر القضائي أو محافظ البيع في هذا البطلان ، يجوز إلزامهما بالتعويضات المدنية للحاجز ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_703> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
