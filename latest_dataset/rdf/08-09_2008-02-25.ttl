<https://legal.dz/resource/law/2008-02-25/08-09#art_663_condition_1_415f471a> a dznorm:Condition ;
    dznorm:conditionText "إذا قام المدين بإيداع مبالغ مالية بأمانة ضبط المحكمة أو بمكتب المحضر القضائي لتغطية أصل الدين والمصاريف"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_663> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_663_condition_2_8cb44236> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/2008-02-25/08-09#art_663_condition_2_8cb44236_role_cd78c0dd9e> ;
    dznorm:conditionText "في كل حالة يثبت فيها المستأجر أو المستأجر الفرعي أنه دفع الأجرة المستحقة في حالة حجز المؤجر على منقولات المستأجر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_663> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_663_condition_2_8cb44236_role_cd78c0dd9e> a dznorm:Role ;
    rdfs:label "منقولات المستأجر"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "في كل حالة يثبت فيها المستأجر أو المستأجر الفرعي أنه دفع الأجرة المستحقة في حالة حجز المؤجر على منقولات المستأجر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_663> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_663_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_663> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم رفع الحجز التحفظي، بدعوى استعجالية، في الحالات الآتية : إذا لم يسع الدائن إلى رفع دعوى تثبيته في الأجل المنصوص عليه في المادة 662 أعلاه، إذا قام المدين بإيداع مبالغ مالية بأمانة ضبط المحكمة أو بمكتب المحضر القضائي لتغطية أصل الدين والمصاريف، في كل حالة يثبت فيها المستأجر أو المستأجر الفرعي أنه دفع الأجرة المستحقة في حالة حجز المؤجر على منقولات المستأجر."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_664_condition_0_f72bf7a5> a dznorm:Condition ;
    dznorm:conditionText "إذا تعلق الحجز بسندات تجارية محررة لفائدة المدين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_664> ;
    dznorm:position 0 .

