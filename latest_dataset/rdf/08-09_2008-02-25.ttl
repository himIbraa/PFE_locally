    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_636_prohibition_0_63e3809c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "636" ;
    dzdoc:position 635 ;
