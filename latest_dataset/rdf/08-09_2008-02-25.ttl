<https://legal.dz/resource/law/2008-02-25/08-09#version_art_978> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يتطلب الأمر أو الحكم أو القرار، إلزام أحد الأشخاص المعنوية العامة أو هيئة تخضع منازعاتها لاختصاص الجهات القضائية الإدارية باتخاذ تدابير تنفيذ معينة ، تأمر الجهة القضائية الإدارية المطلوب منها ذلك، في نفس الحكم القضائي، بالتدبير المطلوب مع تحديد أجل للتنفيذ، عند الاقتضاء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_978_20080225_OpEnact_2ce4ded13f> ;
    dzdoc:replacementText "عندما يتطلب الأمر أو الحكم أو القرار، إلزام أحد الأشخاص المعنوية العامة أو هيئة تخضع منازعاتها لاختصاص الجهات القضائية الإدارية باتخاذ تدابير تنفيذ معينة ، تأمر الجهة القضائية الإدارية المطلوب منها ذلك، في نفس الحكم القضائي، بالتدبير المطلوب مع تحديد أجل للتنفيذ، عند الاقتضاء ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_978> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
