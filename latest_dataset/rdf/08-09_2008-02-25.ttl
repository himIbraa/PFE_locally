    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_762> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_762_obligation_1_02acca4d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
