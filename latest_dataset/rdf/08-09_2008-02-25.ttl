<https://legal.dz/resource/law/2008-02-25/08-09#version_art_794> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد رئيس المحكمة خلال خمسة عشر (15) يوما من تاريخ إخطاره، قائمة مؤقتة لتوزيع المبالغ المالية المتحصلة من التنفيذ بين الدائنين المقيدين، ويأمر بإيداعها بأمانة الضبط وتعليق مستخرج منها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_794_20080225_OpEnact_4c140fe0b8> ;
    dzdoc:replacementText "يعد رئيس المحكمة خلال خمسة عشر (15) يوما من تاريخ إخطاره، قائمة مؤقتة لتوزيع المبالغ المالية المتحصلة من التنفيذ بين الدائنين المقيدين، ويأمر بإيداعها بأمانة الضبط وتعليق مستخرج منها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
