<https://legal.dz/resource/law/2008-02-25/08-09#version_art_855> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لرئيس تشكيلة الحكم في حالة الضرورة أن يقرر إعادة السير في التحقيق، بموجب أمرغير مسبب وغير قابل لأي طعن. يبلغ هذا الأمر بنفس شروط تبليغ أمر اختتام التحقيق المنصوص عليه في المادة 852 أعلاه."@ar ;
