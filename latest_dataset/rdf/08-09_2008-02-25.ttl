<https://legal.dz/resource/law/2008-02-25/08-09#version_art_412> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان الشخص المطلوب تبليغه رسميا، لا يملك موطنا معروفا ، يحرر المحضر القضائي محضرا يضمنه الإجراءات التي قام بها ، و يتم التبليغ الرسمي بتعليق نسخة منه بلوحة الإعلانات بمقر المحكمة ومقر البلدية التي كان له بها آخر موطن . إذا رفض الأشخاص الذين لهم صفة تلقي التبليغ الرسمي ، استلام محضر التبليغ ، تطبق أحكام الفقرة الأولى أعلاه ، وعلاوة على ذلك، يرسل التبليغ الرسمي برسالة مضمنة مع الإشعار بالاستلام إلى آخر موطن له . يثبت الإرسال المضمون، والتعليق، بختم إدارة البريد أو تأشيرة رئيس المجلس الشعبي البل"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_412_20080225_OpEnact_7efa1d9168> ;
    dzdoc:replacementText "إذا كان الشخص المطلوب تبليغه رسميا، لا يملك موطنا معروفا ، يحرر المحضر القضائي محضرا يضمنه الإجراءات التي قام بها ، و يتم التبليغ الرسمي بتعليق نسخة منه بلوحة الإعلانات بمقر المحكمة ومقر البلدية التي كان له بها آخر موطن . إذا رفض الأشخاص الذين لهم صفة تلقي التبليغ الرسمي ، استلام محضر التبليغ ، تطبق أحكام الفقرة الأولى أعلاه ، وعلاوة على ذلك، يرسل التبليغ الرسمي برسالة مضمنة مع الإشعار بالاستلام إلى آخر موطن له . يثبت الإرسال المضمون، والتعليق، بختم إدارة البريد أو تأشيرة رئيس المجلس الشعبي البلدي أو موظف مؤهل لذلك، أو تأشيرة رئيس أمناء الضبط، حسب الحالة . وإذا كانت قيمة الالتزام تتجاوز خمسمائة ألف دينار (500.000 دج) ، يجب أن ينشر مضمون عقد التبليغ الرسمي في جريدة يومية وطنية، بإذن من رئيس المحكمة التي يقع فيها مكان التبليغ وعلى نفقة طالبه . وفي جميع الأحوال، يسري أجل التبليغ الرسمي من تاريخ آخر إجراء حصل وفق هذه الطرق . يعتبر التبليغ الرسمي بهذه الطرق بمثابة التبليغ الشخصي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_412> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_412> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

