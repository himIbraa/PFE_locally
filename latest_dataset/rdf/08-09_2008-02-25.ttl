<https://legal.dz/resource/law/2008-02-25/08-09#version_art_629> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز مباشرة التنفيذ خارج أو بعد الوقت القانوني المحدد في المادة 416 أعلاه، ولا في أيام العطل إلا في حالة الضرورة ، وفي هذه الحالة يرخص للمحضر القضائي بإجراء التنفيذ بأمر على عريضة من رئيس المحكمة التي يباشر فيها التنفيذ . غير أنه، إذا بدأ التنفيذ ولم ينته في أوقات العمل الرسمية ، فإنه يجوز أن يستمر إلى غاية الانتهاء منه . يجب أن ينوه في كل محضر تنفيذ عن تاريخ وساعة بدايته وساعة نهايته ، وإلا كان قابلا للإبطال، ويترتب على ذلك المسؤولية المدنية للمحضر القضائي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_629_20080225_OpEnact_9615231564> ;
    dzdoc:replacementText "لا يجوز مباشرة التنفيذ خارج أو بعد الوقت القانوني المحدد في المادة 416 أعلاه، ولا في أيام العطل إلا في حالة الضرورة ، وفي هذه الحالة يرخص للمحضر القضائي بإجراء التنفيذ بأمر على عريضة من رئيس المحكمة التي يباشر فيها التنفيذ . غير أنه، إذا بدأ التنفيذ ولم ينته في أوقات العمل الرسمية ، فإنه يجوز أن يستمر إلى غاية الانتهاء منه . يجب أن ينوه في كل محضر تنفيذ عن تاريخ وساعة بدايته وساعة نهايته ، وإلا كان قابلا للإبطال، ويترتب على ذلك المسؤولية المدنية للمحضر القضائي ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
