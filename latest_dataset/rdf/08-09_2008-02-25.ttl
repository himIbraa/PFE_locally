    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "للمعارضة أثر موقف للتنفيذ ، ما لم يؤمر بخلاف ذلك ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_956_20080225_OpEnact_a19a8a7d4e> a dzdoc:ArticleVersion ;
