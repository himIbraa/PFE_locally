<https://legal.dz/resource/law/2008-02-25/08-09#version_art_316> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة الحكم على الخصوم بالتضامن أو في نزاع غير قابل للتجزئة ، فإن أجل الطعن لا يسري إلا على من تم تبليغه رسميا. عندما يكون الحكم لصالح عدة أطراف متضامنين أو معنيين بالتزام غير قابل للتجزئة ، جاز لكل منهم التمسك بالتبليغ الرسمي الذي قام به أحدهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_316_20080225_OpEnact_14efb405ef> ;
    dzdoc:replacementText "في حالة الحكم على الخصوم بالتضامن أو في نزاع غير قابل للتجزئة ، فإن أجل الطعن لا يسري إلا على من تم تبليغه رسميا. عندما يكون الحكم لصالح عدة أطراف متضامنين أو معنيين بالتزام غير قابل للتجزئة ، جاز لكل منهم التمسك بالتبليغ الرسمي الذي قام به أحدهم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
