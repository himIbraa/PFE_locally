<https://legal.dz/resource/law/2008-02-25/08-09#art_604_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_604> ;
    dzdoc:position 0 ;
    dzdoc:text "جميع السندات التنفيذية قابلة للتنفيذ في الإقليم الجزائري."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_604_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_604> ;
    dzdoc:position 1 ;
    dzdoc:text "ولأجل التنفيذ الجبري للسندات التنفيذية، يجب على قضاة النيابة العامة تسخير استعمال القوة العمومية، في أجل أقصاه عشرة (10) أيام من تاريخ إيداع طلب التسخيرة."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_604_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_604> ;
    dzdoc:position 2 ;
    dzdoc:text "يسجل طلب التسخيرة في سجل خاص يمسك لهذا الغرض، ويسلم وصل للطالب يثبت إيداع هذا الطلب."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_605_condition_0_41ffa71a> a dznorm:Condition ;
    dznorm:conditionText "متى استوفت الشروط الآتية :"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_605> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_605_obligation_0_8c085dc4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2008-02-25/08-09#art_605_obligation_0_8c085dc4_action_f2c67c7cb0> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_605> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يجوز تنفيذ الأوامر والأحكام والقرارات الصادرة من جهات قضائية أجنبية، في الإقليم الجزائري، إلا بعد منحها الصيغة التنفيذية من إحدى الجهات القضائية الجزائرية"@ar ;
    dznorm:sourceArticle "art_605" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_605_obligation_0_8c085dc4_action_f2c67c7cb0> a dznorm:Action ;
    rdfs:label "تنفيذ الأوامر والأحكام والقرارات الصادرة"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "لا يجوز تنفيذ الأوامر والأحكام والقرارات الصادرة من جهات قضائية أجنبية، في الإقليم الجزائري، إلا بعد منحها الصيغة التنفيذية من إحدى الجهات القضائية الجزائرية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_605> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_605_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_605> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يجوز تنفيذ الأوامر والأحكام والقرارات الصادرة من جهات قضائية أجنبية، في الإقليم الجزائري، إلا بعد منحها الصيغة التنفيذية من إحدى الجهات القضائية الجزائرية متى استوفت الشروط الآتية : ألا تتضمن ما يخالف قواعد الاختصاص، حائزة لقوة الشيء المقضي به طبقا لقانون البلد الذي صدرت فيه، ألا تتعارض مع أمر أو حكم أو قرار سبق صدوره من جهات قضائية جزائرية، وأثير من المدعى عليه، ألا تتضمن ما يخالف النظام العام والآداب العامة في الجزائر."@ar .

