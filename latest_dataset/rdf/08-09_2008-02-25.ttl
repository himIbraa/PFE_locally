<https://legal.dz/resource/law/2008-02-25/08-09#version_art_624> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان التنفيذ متعلقا بإلزام المنفذ عليه بتسليم عقار أو التنازل عنه أو تركه ، تنقل الحيازة المادية لهذا العقار إلى طالب التنفيذ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_624_20080225_OpEnact_d496f399da> ;
    dzdoc:replacementText "إذا كان التنفيذ متعلقا بإلزام المنفذ عليه بتسليم عقار أو التنازل عنه أو تركه ، تنقل الحيازة المادية لهذا العقار إلى طالب التنفيذ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_624> ;
