<https://legal.dz/resource/law/2008-02-25/08-09#version_art_165> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أنكر أحد الخصوم الخط أو التوقيع المنسوب إليه، أو صرح بعدم الاعتراف بخط أو توقيع الغير ، يجوز للقاضي أن يصرف النظر عن ذلك إذا رأى أن هذه الوسيلة غير منتجة في الفصل في النزاع. وفي الحالة العكسية، يؤشر القاضي على الوثيقة محل النزاع، ويأمر بإيداع أصلها بأمانة الضبط، كما يأمر بإجراء مضاهاة الخطوط اعتمادا على المستندات أو على شهادة الشهود، وعند الاقتضاء، بواسطة خبير. يبلغ ملف القضية إلى النيابة العامة لتقديم طلباتها المكتوبة. إذا عرضت القضية أمام القاضي الجزائي ، يتم إرجاء الفصل في دعوى مضاهاة الخ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_165_20080225_OpEnact_e162ed46ce> ;
    dzdoc:replacementText "إذا أنكر أحد الخصوم الخط أو التوقيع المنسوب إليه، أو صرح بعدم الاعتراف بخط أو توقيع الغير ، يجوز للقاضي أن يصرف النظر عن ذلك إذا رأى أن هذه الوسيلة غير منتجة في الفصل في النزاع. وفي الحالة العكسية، يؤشر القاضي على الوثيقة محل النزاع، ويأمر بإيداع أصلها بأمانة الضبط، كما يأمر بإجراء مضاهاة الخطوط اعتمادا على المستندات أو على شهادة الشهود، وعند الاقتضاء، بواسطة خبير. يبلغ ملف القضية إلى النيابة العامة لتقديم طلباتها المكتوبة. إذا عرضت القضية أمام القاضي الجزائي ، يتم إرجاء الفصل في دعوى مضاهاة الخطوط إلى حين الفصل في الدعوى الجزائية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_165> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_165> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_166> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن للقاضي أن يأمر بالحضور الشخصي للخصوم وسماع من كتب المحرر المنازع فيه، وعند الاقتضاء، سماع الشهود الذين شاهدوا كتابة ذلك المحرر أو توقيعه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_166_20080225_OpEnact_f81c9e52df> ;
