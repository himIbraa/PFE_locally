    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يجوز للجهات القضائية الإدارية إجراء الصلح في مادة القضاء الكامل ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_971_20080225_OpEnact_7b25633416> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
