<https://legal.dz/resource/law/2008-02-25/08-09#art_730_condition_2_d6ecc5a3> a dznorm:Condition ;
    dznorm:conditionText "إذا سبق للمستأجر أن دفع الأجرة للمدين المحجوز عليه قبل تبليغه الرسمي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_730> ;
