<https://legal.dz/resource/law/2008-02-25/08-09#version_art_659> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يبلغ رسميا أمر الحجز التحفظي إلى المدين وفقا ل المادة 688 أدناه ، ويتبع فورا بالحجز، و على المحضر القضائي تحرير محضر حجز وجرد للأموال الموجودة تحت يد المدين وإلا كان الحجز باطلا . عند الاقتضاء ، يمكن الاستعانة بالقوة العمومية لتنفيذ أمر الحجز ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
