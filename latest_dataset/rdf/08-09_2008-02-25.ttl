    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_133_condition_1_68790db4> a dznorm:Condition ;
    dznorm:conditionText "لا يقبل الرد إلا بسبب القرابة المباشرة أو القرابة غير المباشرة لغاية الدرجة الرابعة أو لوجود مصلحة شخصية أو لأي سبب جدي آخر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_133> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_133_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_133> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا أراد أحد الخصوم رد الخبير المعين، يقدم عريضة تتضمن أسباب الرد، توجه إلى القاضي الذي أمر بالخبرة خلال ثمانية (8) أيام من تاريخ تبليغه بهذا التعيين، ويفصل دون تأخير في طلب الرد بأمر غير قابل لأي طعن."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_133_para_1> a dzdoc:Paragraph ;
