<https://legal.dz/resource/law/2008-02-25/08-09#art_1007> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:definesTerm dzterm:arbitration_clause ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_1007" ;
    dzdoc:fullText "شرط التحكيم هو الاتفاق الذي يلتزم بموجبه الأطراف في عقد متصل بحقوق متاحة بمفهوم المادة 1006 أعلاه، لعرض النزاعات التي قد تثار بشأن هذا العقد على التحكيم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1007> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_1007_defocc_1d30ac9e1af6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1007_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1007_20080225_OpEnact_762eb16df1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_1007_obligation_0_dd384d65> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 1007" ;
    dzdoc:position 1006 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_1006> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_1006> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1009> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_1009" ;
    dzdoc:fullText "إذا اعترضت صعوبة تشكيل محكمة التحكيم، بفعل أحد الأطراف أو بمناسبة تنفيذ إجراءات تعيين المحكم أو المحكمين ، يعين المحكم أو المحكمون من قبل رئيس المحكمة الواقع في دائرة اختصاصها محل إبرام العقد أو محل تنفيذه. إذا كان شرط التحكيم باطلا أو غير كاف لتشكيل محكمة التحكيم ، يعاين رئيس المحكمة ذلك ويصرح بالأ وجه للتعيين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1009> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1009_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1009_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1009_20080225_OpEnact_4b5344c082> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 1009" ;
    dzdoc:position 1008 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_1009_condition_0_847a340c>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1009_condition_1_612a3720> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1027> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_3> ;
    dzdoc:eId "art_1027" ;
    dzdoc:fullText "يجب أن تتضمن أحكام التحكيم عرضا موجزا لادعاءات الأطراف وأوجه دفاعهم. يجب أن تكون أحكام التحكيم مسببة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1027> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1027_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1027_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1027_20080225_OpEnact_a89c384c58> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_1027_obligation_0_67b19f58>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1027_obligation_1_5305556b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "1027" ;
    dzdoc:position 1026 ;
    dzdoc:usesTerm dzterm:arbitration_awards .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1030> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_3> ;
    dzdoc:eId "art_1030" ;
    dzdoc:fullText "يتخلى المحكم عن النزاع بمجرد الفصل فيه. غير أنه يمكن للمحكم تفسير الحكم، أو تصحيح الأخطاء المادية والإغفالات التي تشوبه ، طبقا للأحكام الواردة في هذا القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_1030_permission_0_2dce3105> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_1030_right_0_1129e5c1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1030> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1030_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1030_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1030_20080225_OpEnact_eb92799c02> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "1030" ;
    dzdoc:position 1029 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_107> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_5> ;
    dzdoc:eId "art_107" ;
    dzdoc:fullText "يمكن للقاضي أن يأمر بمثول فاقد الأهلية رفقة ممثله القانوني. يمكن أيضا أن يأمر بمثول الممثل القانوني للشخص المعنوي، سواء كان خاضعا للقانون العام أو الخاص."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_107_permission_0_9d48f308>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_107_permission_1_e1f02f93> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_107> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_107_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_107_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_107_20080225_OpEnact_3e41336058> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 107" ;
    dzdoc:position 106 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_133> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_8> ;
    dzdoc:eId "art_133" ;
    dzdoc:fullText "إذا أراد أحد الخصوم رد الخبير المعين ، يقدم عريضة تتضمن أسباب الرد، توجه إلى القاضي الذي أمر بالخبرة خلال ثمانية (8) أيام من تاريخ تبليغه بهذا التعيين ، ويفصل دون تأخير في طلب الرد بأمر غير قابل لأي طعن. لا يقبل الرد إلا بسبب القرابة المباشرة أو القرابة غير المباشرة لغاية الدرجة الرابعة أو لوجود مصلحة شخصية أو لأي سبب جدي آخر ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_133_right_0_4114e2a3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_133> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_133_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_133_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_133_20080225_OpEnact_1fe02a0cb8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 133" ;
    dzdoc:position 132 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_133_condition_0_5ff0bed4>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_133_condition_1_68790db4> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_152> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_10> ;
    dzdoc:eId "art_152" ;
    dzdoc:fullText "يسمع كل شاهد على انفراد في حضور أو في غياب الخصوم، ويعرف قبل سماعه، باسمه ولقبه ومهنته وسنه وموطنه ، وعلاقته ودرجة قرابته ومصاهرته أو تبعيته للخصوم. يؤدي الشاهد اليمين بأن يقول الحقيقة وإلا كانت شهادته قابلة للإبطال. يجوز إعادة سماع الشهود ومواجهة بعضهم البعض."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_152_permission_0_72ffd26d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_152> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_152_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_152_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_152_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_152_20080225_OpEnact_7aba2bea0f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_152_obligation_0_a5a8f093> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 152" ;
    dzdoc:position 151 ;
    dzdoc:usesTerm dzterm:witness,
        dzterm:witnesses .

<https://legal.dz/resource/law/2008-02-25/08-09#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_10> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "يجب إثارة أوجه التجريح قبل الإدلاء بالشهادة ، إلا إذا ظهر سبب التجريح بعد الإدلاء بالشهادة وأثناء سماع الشهود الآخرين . إذا قبل التجريح في الحالة الأخيرة تكون الشهادة باطلة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_157_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_157_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_157_20080225_OpEnact_2a22c1afe2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_157_obligation_0_00fe6d84> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 157" ;
    dzdoc:position 156 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_157_condition_0_77444cec>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_157_condition_1_2f3e25bc> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_193> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_14> ;
    dzdoc:eId "art_193" ;
    dzdoc:fullText "تؤدى اليمين من قبل الخصم الذي وجهت له شخصيا بالجلسة أو في المكان الذي يحدده القاضي ، و إذا برر استحالة التنقل يمكنه أداءها إما أمام قاض منتدب لهذا الغرض، ينتقل إلى مكان تواجده بحضور أمين الضبط ، وإما أمام المحكمة الموجود بدائرة اختصاصها محل إقامته . تؤدى اليمين حسب الحالة، بحضور أمين الضبط أو المحضر القضائي الذي يحرر محضرا عن ذلك، وفي جميع الحالات، تؤدى بحضور الخصم الآخر أو بعد صحة تبليغه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_193_right_0_99ed550f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_193> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_193_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_193_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_193_20080225_OpEnact_65f4606b78> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_193_obligation_0_c0106ed3>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_193_obligation_1_fd95882d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "193" ;
    dzdoc:position 192 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_193_condition_0_da10d38c> ;
    dzdoc:usesTerm dzterm:bailiff,
        dzterm:clerk,
        dzterm:judge,
        dzterm:oath .

<https://legal.dz/resource/law/2008-02-25/08-09#art_204> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_5_sec_3> ;
    dzdoc:eId "art_204" ;
    dzdoc:fullText "يمكن للقاضي أن يمنح أجلا للخصوم لإدخال الضامن . يستأنف سير الخصومة بمجرد بانقضاء هذا الأجل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_204_permission_0_3398419e> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_204_right_0_ab865228> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_204> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_204_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_204_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_204_20080225_OpEnact_86b344f1b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "204" ;
    dzdoc:position 203 ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:litigant,
        dzterm:litigation .

<https://legal.dz/resource/law/2008-02-25/08-09#art_210> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_6_sec_2> ;
    dzdoc:eId "art_210" ;
    dzdoc:fullText "تنقطع الخصومة في القضايا التي تكون غير مهيأة للفصل للأسباب الآتية : تغير في أهلية التقاضي لأحد الخصوم، وفاة أحد الخصوم، إذا كانت الخصومة قابلة للانتقال ، وفاة أو استقالة أو توقيف أو شطب أو تنحي المحامي ، إلا إذا كان التمثيل جوازيا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_210> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_210_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_210_20080225_OpEnact_2e3f3f5522> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_210_obligation_0_4a9c406f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 210" ;
    dzdoc:position 209 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_210_condition_0_e90b3a4d>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_210_condition_1_f1579e80> ;
    dzdoc:usesTerm dzterm:lawyer,
        dzterm:litigation .

<https://legal.dz/resource/law/2008-02-25/08-09#art_223> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:definesTerm dzterm:مساعي ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_6_sec_5> ;
    dzdoc:eId "art_223" ;
    dzdoc:fullText "تسقط الخصومة بمرور سنتين (2) ، تحسب من تاريخ صدور الحكم أو صدور أمر القاضي، الذي كلف أحد الخصوم القيام بالمساعي. تتمثل المساعي في كل الإجراءات التي تتخذ بهدف مواصلة القضية وتقدمها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_223> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_223_defocc_a6530c5576f1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_223_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_223_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_223_20080225_OpEnact_23bd792b4c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_223_obligation_0_b1e47b69> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 223" ;
    dzdoc:position 222 ;
    dzdoc:usesTerm dzterm:خصومة .

<https://legal.dz/resource/law/2008-02-25/08-09#art_247> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_247" ;
    dzdoc:fullText "يحكم على طالب الرد الذي رفض طلبه، بغرامة مدنية لا تقل عن عشرة آلاف دينار (10.000د.ج) ، دون الإخلال ب حق المطالبة بالتعويض ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_247_right_0_72be91a6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_247> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_247_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_247_20080225_OpEnact_bdde203da3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_247_obligation_0_287a43be> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "247" ;
    dzdoc:position 246 ;
    dzdoc:usesTerm dzterm:applicant_for_recusal .

<https://legal.dz/resource/law/2008-02-25/08-09#art_255> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_8_sec_1> ;
    dzdoc:eId "art_255" ;
    dzdoc:fullText "تصدر أحكام المحاكم بقاض فرد، ما لم ينص القانون على خلاف ذلك . وتصدر قرارات جهة الاستئناف بتشكيلة مكونة من ثلاثة قضاة، ما لم ينص القانون على خلاف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_255> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_255_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_255_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_255_20080225_OpEnact_0bf309a151> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 255" ;
    dzdoc:position 254 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_255_condition_0_0ae03fe2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_255_condition_1_88492f66> ;
    dzdoc:usesTerm dzterm:appellate_body,
        dzterm:court .

<https://legal.dz/resource/law/2008-02-25/08-09#art_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_1_sec_6> ;
    dzdoc:eId "art_27" ;
    dzdoc:fullText "يجوز للقاضي أن يأمر في الجلسة بحضور الخصوم شخصيا لتقديم توضيحات يراها ضرورية لحل النزاع. كما يجوز له أن يأمر شفهيا، بإحضار أية وثيقة لنفس الغرض."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_27_permission_0_a196946f>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_27_permission_1_4722cdfb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_27_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_27_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_27_20080225_OpEnact_468e24e966> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 27" ;
    dzdoc:position 26 ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:litigants .

<https://legal.dz/resource/law/2008-02-25/08-09#art_278> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_8_sec_1_subsec_2> ;
    dzdoc:eId "art_278" ;
    dzdoc:fullText "يوقع على أصل الحكم الرئيس وأمين الضبط والقاضي المقرر عند الاقتضاء ، ويحفظ أصل الحكم في أرشيف الجهة القضائية. يحفظ أيضا ملف القضية في أرشيف الجهة القضائية. يستعيد الخصوم الوثائق المملوكة لهم ، بناء على طلبهم مقابل وصل بالاستلام."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_278_right_0_9065ee59> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_278> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_278_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_278_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_278_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_278_20080225_OpEnact_62150b76ff> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_278_obligation_0_e3a7b073> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 278" ;
    dzdoc:position 277 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_285> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_8_sec_1_subsec_2> ;
    dzdoc:eId "art_285" ;
    dzdoc:fullText "إن تفسير الحكم بغرض توضيح مدلوله أو تحديد مضمونه، من اختصاص الجهة القضائية التي أصدرته. يقدم طلب تفسير الحكم بعريضة من أحد الخصوم أو بعريضة مشتركة منهم، وتفصل الجهة القضائية ، بعد سماع الخصوم أو بعد صحة تكليفهم بالحضور."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_285> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_285_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_285_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_285_20080225_OpEnact_d6f63927fb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "285" ;
    dzdoc:position 284 ;
    dzdoc:usesTerm dzterm:judicial_authority .

<https://legal.dz/resource/law/2008-02-25/08-09#art_305> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_8_sec_5_subsec_2> ;
    dzdoc:eId "art_305" ;
    dzdoc:fullText "يمكن لقاضي الاستعجال الحكم بالغرامات التهديدية وتصفيتها . يفصل، عند الاقتضاء، في المصاريف القضائية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_305_permission_0_3bbe1a0f> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_305_right_0_c94215fb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_305> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_305_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_305_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_305_20080225_OpEnact_383d216107> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 305" ;
    dzdoc:position 304 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_1_sec_6> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "يجوز للخصوم ، دون سواهم أو بوكالة خاصة عند انتهاء الخصومة، استرجاع الوثائق المودعة في أمانة الضبط مقابل وصل. يفصل رئيس الجهة القضائية في الإشكالات التي قد تثار بهذا الشأن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_31_permission_0_39385811> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_31_right_0_39385811> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_31_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_31_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_31_20080225_OpEnact_8b7820c821> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 31" ;
    dzdoc:position 30 ;
    dzdoc:usesTerm dzterm:litigants .

<https://legal.dz/resource/law/2008-02-25/08-09#art_316> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_1> ;
    dzdoc:eId "art_316" ;
    dzdoc:fullText "في حالة الحكم على الخصوم بالتضامن أو في نزاع غير قابل للتجزئة ، فإن أجل الطعن لا يسري إلا على من تم تبليغه رسميا. عندما يكون الحكم لصالح عدة أطراف متضامنين أو معنيين بالتزام غير قابل للتجزئة ، جاز لكل منهم التمسك بالتبليغ الرسمي الذي قام به أحدهم ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_316_right_0_8e427f1d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_316> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_316_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_316_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_316_20080225_OpEnact_14efb405ef> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 316" ;
    dzdoc:position 315 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_316_condition_0_07c7550c>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_316_condition_1_d17b489d> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_337> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_2_subsec_2> ;
    dzdoc:eId "art_337" ;
    dzdoc:fullText "يجوز للمستأنف عليه، استئناف الحكم فرعيا في أية حالة كانت عليها الخصومة، ولو بلغ رسميا بالحكم دون تحفظ وحتى في حالة سقوط حقه في رفع الاستئناف الأصلي. لا يقبل الاستئناف الفرعي إذا كان الاستئناف الأصلي غير مقبول . يترتب على التنازل في الاستئناف الأصلي عدم قبول الاستئناف الفرعي إذا وقع بعد التنازل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_337_permission_0_22bd9ca4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_337> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_337_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_337_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_337_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_337_20080225_OpEnact_a2e4b54401> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "337" ;
    dzdoc:position 336 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_337_condition_0_9390728e> ;
    dzdoc:usesTerm dzterm:incidental_appeal .

<https://legal.dz/resource/law/2008-02-25/08-09#art_346> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_2_subsec_3> ;
    dzdoc:eId "art_346" ;
    dzdoc:fullText "عند الفصل في استئناف حكم فاصل في أحد الدفوع الشكلية قضى بإنهاء الخصومة، يجوز للمجلس القضائي التصدي للمسائل غير المفصول فيها ، إذا تبين له، ولحسن سير العدالة، إعطاء حل نهائي للنزاع، وذلك بعد الأمر بإجراء تحقيق عند الاقتضاء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_346_permission_0_50076713> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_346_right_0_cb07e58c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_346> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_346_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_346_20080225_OpEnact_9b861ad0c4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "346" ;
    dzdoc:position 345 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_346_condition_0_43415aba> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_373> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_3_subsec_1> ;
    dzdoc:eId "art_373" ;
    dzdoc:fullText "يمكن للأشخاص المذكورين في المادة 372 أعلاه، طبقا لنفس الشروط المبادرة بإخطار جهة الإحالة . يقوم الرئيس الأول ل المحكمة العليا بتسوية كل إشكال قد يطرأ بشأن تسليم نسخ من قرار النقض لهؤلاء الأشخاص."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_373_permission_0_43813539> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_373_right_0_1060f391> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_373> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_373_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_373_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_373_20080225_OpEnact_27b4155b90> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 373" ;
    dzdoc:position 372 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_372> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_372> ;
    dzdoc:usesTerm dzterm:cassation,
        dzterm:supreme_court .

<https://legal.dz/resource/law/2008-02-25/08-09#art_378> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_3_subsec_1> ;
    dzdoc:eId "art_378" ;
    dzdoc:fullText "تقضي المحكمة العليا على الخصم الذي خسر الدعوى بالمصاريف القضائية . كما يمكنها أن تحكم بجعل تلك المصاريف على عاتق الخزينة العمومية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_378_right_0_3edb11ab> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_378> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_378_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_378_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_378_20080225_OpEnact_320cf7b495> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_378_obligation_0_2125e2b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "378" ;
    dzdoc:position 377 ;
    dzdoc:usesTerm dzterm:supreme_court .

<https://legal.dz/resource/law/2008-02-25/08-09#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_2_sec_4> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "في حالة تعدد المدعى عليهم ، يؤول الاختصاص الإقليمي للجهة القضائية التي يقع في دائرة اختصاصها موطن أحدهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_38_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_38_20080225_OpEnact_35f04c970f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "38" ;
    dzdoc:position 37 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_38_condition_0_6423b94a> ;
    dzdoc:usesTerm dzterm:jurisdiction .

<https://legal.dz/resource/law/2008-02-25/08-09#art_387> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_3_subsec_2> ;
    dzdoc:eId "art_387" ;
    dzdoc:fullText "إذا قبل القاضي اعتراض الغير الخارج عن الخصومة على الحكم أو القرار أو الأمر ، يجب أن يقتصر في قضائه على إلغاء أو تعديل مقتضيات الحكم أو القرار أو الأمر، التي اعترض عليها الغير والضارة به ، ويحتفظ الحكم أو القرار أو الأمر المعترض فيه بآثاره إزاء الخصوم الأصليين، حتى فيما يتعلق بمقتضياته المبطلة، ماعدا في حالة عدم قابلية الموضوع للتجزئة المنصوص عليها في المادة 382 أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_387> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_387_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_387_20080225_OpEnact_559e686b34> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_387_obligation_0_6705d603> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 387" ;
    dzdoc:position 386 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_382> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_382> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_387_condition_0_2e633550> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_2_sec_4> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "فضلا عما ورد في المواد 37 و 38 و 46 من هذا القانون، ترفع الدعاوى أمام الجهات القضائية المبينة أدناه دون سواها : 1- في المواد العقارية، أو الأشغال المتعلقة بالعقار، أو دعاوى الإيجارات بما فيها التجارية المتعلقة بالعقارات والدعاوى المتعلقة بالأشغال العمومية، أمام المحكمة التي يقع في دائرة اختصاصها العقار، أو المحكمة التي يقع في دائرة اختصاصها مكان تنفيذ الأشغال. 2- في مواد الميراث، دعاوى الطلاق أو الرجوع الحضانة، النفقة الغذائية والسكن على التوالي، أمام المحكمة التي يقع في دائرة اختصاصها موطن المتوفى، مسكن الزوجية، مكان ممارسة الحضانة، موطن الدائن بالنفقة، مكان وجود السكن. 3- في مواد الإفلاس أو التسوية القضائية للشركات وكذا الدعاوى المتعلقة بمنازعات الشركاء، أمام المحكمة التي يقع في دائرة اختصاصها مكان افتتاح الإفلاس أو التسوية القضائية أو مكان المقر الاجتماعي للشركة. 4- في مواد الملكية الفكرية، أمام المحكمة المنعقدة في مقر المجلس القضائي الموجود في دائرة اختصاصه موطن المدعى عليه. 5- في المواد المتعلقة بالخدمات الطبية، أمام المحكمة التي تم في دائرة اختصاصها تقديم العلاج. 6- في مواد مصاريف الدعاوى وأجور المساعدين القضائيين أمام المحكمة التي فصلت في الدعوى الأصلية، وفي دعاوى الضمان أمام المحكمة التي قدم إليها الطلب الأصلي. 7- في مواد الحجز، سواء كان بالنسبة للإذن بالحجز، أو للإجراءات التالية له، أمام المحكمة التي وقع في دائرة اختصاصها الحجز. 8- في المنازعات التي تقوم بين صاحب العمل والأجير، يؤول الاختصاص الإقليمي للمحكمة التي تم في دائرة اختصاصها إبرام عقد العمل أو تنفيذه أو التي يوجد بها موطن المدعى عليه. غير أنه في حالة إنهاء أو تعليق عقد العمل بسبب حادث عمل أو مرض مهني يؤول الاختصاص للمحكمة التي يوجد بها موطن المدعي. 9- في المواد المستعجلة، أمام المحكمة الواقع في دائرة اختصاصها مكان وقوع الإشكال في التنفيذ، أو التدابير المطلوبة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_40_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_40_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_40_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_40_20080225_OpEnact_4392a92ee0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "40" ;
    dzdoc:position 39 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_37>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_38>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_46> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_37>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_38>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_46> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_40_condition_0_10e9d826> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_403> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_10> ;
    dzdoc:eId "art_403" ;
    dzdoc:fullText "يمكن للجهة القضائية المعروض عليها التنازع أن تأمر عند الاقتضاء، بإيقاف إجراءات التنفيذ المتبعة أمام الجهات القضائية التي ظهر أمامها التنازع . باستثناء الإجراءات التحفظية، يكون مشوبا بالبطلان كل إجراء تم خرقا لوقف التنفيذ المأمور به."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_403_permission_0_056aa1bc> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_403_right_0_0684fd62> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_403> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_403_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_403_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_403_20080225_OpEnact_5315f68cf4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "403" ;
    dzdoc:position 402 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_2_sec_4_subsec_1> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "يجوز أن يكلف بالحضور كل جزائري أمام الجهات القضائية الجزائرية بشأن التزامات تعاقد عليها في بلد أجنبي، حتى ولو كان مع أجنبي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_42_permission_0_e531eda7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_42> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_42_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_42_20080225_OpEnact_bd68232a89> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_42_obligation_0_cab3f172> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "42" ;
    dzdoc:position 41 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_42_condition_0_c8bf4d67> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_425> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_425" ;
    dzdoc:fullText "يمارس رئيس قسم شؤون الأسرة الصلاحيات المخولة لقاضي الاستعجال، ويجوز له بالإضافة للصلاحيات المخولة له في هذا القانون، أن يأمر في إطار التحقيق بتعيين مساعدة اجتماعية أو طبيب خبير أو اللجوء إلى أية مصلحة مختصة في الموضوع بغرض الاستشارة. ينتهي التحقيق بتحرير تقرير يتضمن المعاينات التي قام بها المحقق والحلول المقترحة. يطلع القاضي الأطراف على التقرير ويحدد لهم أجلا لتقديم طلب إجراء تحقيق مضاد. يمكن اللجوء إلى الاستشارة في أي وقت وحتى أثناء إجراءات الصلح."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_425_permission_0_aee9b953> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_425> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_425_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_425_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_425_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_425_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_425_20080225_OpEnact_b9489b4078> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "425" ;
    dzdoc:position 424 ;
    dzdoc:usesTerm dzterm:head_of_family_division .

<https://legal.dz/resource/law/2008-02-25/08-09#art_429> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_429" ;
    dzdoc:fullText "يجب أن تتضمن العريضة الوحيدة ما يأتي : 1- بيان الجهة القضائية المرفوع أمامها الطلب، 2- اسم ولقب وجنسية كلا الزوجين وموطن وتاريخ ومكان ميلادهما، 3- تاريخ ومكان زواجهما، وعند الاقتضاء، عدد الأولاد القصر، 4- عرض موجز يتضمن جميع شروط الاتفاق الحاصل بينهما حول توابع الطلاق. يجب أن يرفق مع العريضة شهادة عائلية ومستخرج من عقد زواج المعنيين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_429> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_429_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_429_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_429_20080225_OpEnact_3d5a14fb27> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_429_obligation_0_50d6ae4d>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_429_obligation_1_c9c8200b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 429" ;
    dzdoc:position 428 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_431> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_431" ;
    dzdoc:fullText "يتأكد القاضي في التاريخ المحدد للحضور، من قبول العريضة، ويستمع إلى الزوجين على انفراد ثم مجتمعين، ويتأكد من رضائهما، ويحاول الصلح بينهما إذا كان ذلك ممكنا . ينظر مع الزوجين أو وكلائهما في الاتفاق، وله أن يلغي أو يعدل في شروطه، إذا كانت تتعارض مع مصلحة الأولاد أو خالفت النظام العام . يثبت القاضي إرادة الزوجين، بإصدار حكم يتضمن المصادقة على الاتفاق النهائي ويصرح بالطلاق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_431> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_431_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_431_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_431_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_431_20080225_OpEnact_8d351ca080> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_431_obligation_0_0091f984> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 431" ;
    dzdoc:position 430 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_431_condition_0_37f2cde4> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_436> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_436" ;
    dzdoc:fullText "ترفع دعوى الطلاق من أحد الزوجين أمام قسم شؤون الأسرة، بتقديم عريضة وفقا للأشكال المقررة لرفع الدعوى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_436> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_436_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_436_20080225_OpEnact_d18162fe3b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 436" ;
    dzdoc:position 435 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_445> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_445" ;
    dzdoc:fullText "يجوز للقاضي في حالة ظهور واقعة جديدة، وحسب الظروف ، أن يلغي أو يعدل أو يتمم التدابير المؤقتة التي أمر بها ، ما لم يتم الفصل في الموضوع . هذا الأمر غير قابل لأي طعن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_445_permission_0_eac53021> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_445> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_445_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_445_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_445_20080225_OpEnact_1efc6183ce> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 445" ;
    dzdoc:position 444 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_445_condition_0_334ded12>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_445_condition_1_984cf0dc> ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_461> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_461" ;
    dzdoc:fullText "يجوز للقاضي إلغاء تدابير الإنهاء أو السحب المؤقت للحقوق المرتبطة بممارسة الولاية كليا أو جزئيا، بطلب من والد القاصر المسقطة عنه الولاية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_461_permission_0_c30ef2c8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_461> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_461_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_461_20080225_OpEnact_242599b169> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 461" ;
    dzdoc:position 460 ;
    dzdoc:usesTerm dzterm:minor,
        dzterm:parental_authority .

<https://legal.dz/resource/law/2008-02-25/08-09#art_465> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_465" ;
    dzdoc:fullText "يمكن للقاضي مراقبة الولاية من تلقاء نفسه أو بناء على طلب ممثل النيابة العامة أو بطلب من أي شخص تهمه مصلحة من وضع تحت الولاية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_465_permission_0_30e2bc1b> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_465_right_0_d04aa14d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_465> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_465_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_465_20080225_OpEnact_14c2c368d3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 465" ;
    dzdoc:position 464 ;
    dzdoc:usesTerm dzterm:prosecution .

<https://legal.dz/resource/law/2008-02-25/08-09#art_467> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_467" ;
    dzdoc:fullText "يمكن للقاضي، قبل الفصل في الموضوع، أن يأمر باتخاذ التدابير المؤقتة لحماية مصالح القاصر . هذا الأمر غير قابل لأي طعن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_467_permission_0_c055fe91> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_467_right_0_a5f0785d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_467> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_467_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_467_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_467_20080225_OpEnact_fb266558fb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 467" ;
    dzdoc:position 466 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_482> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_482" ;
    dzdoc:fullText "يجب أن تتضمن العريضة المقدمة من أجل افتتاح التقديم على ناقص الأهلية، فضلا عن البيانات العادية، عرضا عن الوقائع التي تبرر التقديم ، و يجب أن ترفق بالملف الطبي للشخص المعني بالتقديم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_482> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_482_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_482_20080225_OpEnact_0167dc8231> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_482_obligation_0_8de876e7>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_482_obligation_1_b5d1ff37> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 482" ;
    dzdoc:position 481 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_488> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_488" ;
    dzdoc:fullText "يتم التبليغ الرسمي للأمر الذي يصرح بافتتاح التقديم أو برفض الطلب، بتسخيرة من النيابة العامة، عن طريق المحضر القضائي بدون رسوم ومصاريف إلى الشخص المعني وإلى من قدم الطلب. يرفع الاستئناف في هذا الأمر في أجل خمسة عشر (15) يوما . يسري هذا الأجل تجاه الأطراف ابتداء من تاريخ التبليغ الرسمي. ويسري ابتداء من تاريخ النطق به بالنسبة للنيابة العامة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_488_right_0_8ec4297a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_488> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_488_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_488_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_488_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_488_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_488_20080225_OpEnact_790eb0a601> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 488" ;
    dzdoc:position 487 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_505> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_505" ;
    dzdoc:fullText "تحدد أول جلسة في أجل أقصاه خمسة عشر (15) يوما من تاريخ رفع الدعوى . يجب على القاضي أن يفصل فيها في أقرب الآجال ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_505> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_505_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_505_20080225_OpEnact_5a560067ed> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_505_obligation_0_cdea456b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 505" ;
    dzdoc:position 504 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_505_condition_0_c4d98ff9> ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_525> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_3_subsec_5> ;
    dzdoc:eId "art_525" ;
    dzdoc:fullText "يجوز رفع دعوى استرداد الحيازة لعقار أو حق عيني عقاري ممن اغتصبت منه الحيازة بالتعدي أو الإكراه ، وكان له، وقت حصول التعدي أو الإكراه، الحيازة المادية أو وضع اليد الهادئ العلني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_525_permission_0_5b404576> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_525_right_0_4775b377> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_525> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_525_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_525_20080225_OpEnact_1cb82461ed> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "525" ;
    dzdoc:position 524 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_525_condition_0_d28bf88f> ;
    dzdoc:usesTerm dzterm:recovery_of_possession .

<https://legal.dz/resource/law/2008-02-25/08-09#art_537> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_537" ;
    dzdoc:fullText "تتم الإجراءات أمام المجلس القضائي بالكتابة أساسا ، غير أنه يمكن للخصوم تقديم ملاحظات شفوية إضافية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_537_permission_0_9f6f0eb7> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_537_right_0_2d866fd3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_537> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_537_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_537_20080225_OpEnact_af73e15e40> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_537_obligation_0_26a3f69a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 537" ;
    dzdoc:position 536 ;
    dzdoc:usesTerm dzterm:court_of_appeal .

<https://legal.dz/resource/law/2008-02-25/08-09#art_544> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_2_sec_3> ;
    dzdoc:eId "art_544" ;
    dzdoc:fullText "يجب أن يعين رئيس الغرفة مستشارا مقررا في القضية لتقديم تقريره، قبل تاريخ انعقاد أول جلسة ينادى فيها على القضية . إذا تبين للمستشار المقرر عدم قبول الاستئناف ، أدرجت القضية في أقرب جلسة لسماع الخصوم في ملاحظاتهم والفصل فيها فورا عند الاقتضاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_544> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_544_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_544_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_544_20080225_OpEnact_b18522af48> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_544_obligation_0_f4872012> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "544" ;
    dzdoc:position 543 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_544_condition_0_61607bf4> ;
    dzdoc:usesTerm dzterm:president_chamber,
        dzterm:reporting_judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_560> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_3_sec_2> ;
    dzdoc:eId "art_560" ;
    dzdoc:fullText "يرفع الطعن بالنقض بتصريح أو بعريضة أمام أمانة ضبط المحكمة العليا . يجوز أيضا أن يرفع الطعن بالنقض بتصريح أو بعريضة أمام أمانة ضبط المجلس القضائي الذي صدر في دائرة اختصاصه الحكم موضوع الطعن ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_560_permission_0_4e0c3c8b> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_560_right_0_65b63076>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_560_right_1_9e79a414> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_560> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_560_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_560_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_560_20080225_OpEnact_d30393a88d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "560" ;
    dzdoc:position 559 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_564> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_3_sec_3> ;
    dzdoc:eId "art_564" ;
    dzdoc:fullText "يجب على الطاعن أن يبلغ رسميا المطعون ضده خلال أجل شهر واحد (1) من تاريخ إيداع عريضة الطعن بأمانة ضبط المحكمة العليا أو المجلس القضائي ، بنسخة من هذه العريضة مؤشر عليها من طرف أمين الضبط الرئيسي لدى المحكمة العليا أو المجلس القضائي . تتم التبليغات الرسمية وفقا لأحكام المواد من 404 إلى 416 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_564> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_564_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_564_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_564_20080225_OpEnact_3e37171819> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_564_obligation_0_953c6324> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 564" ;
    dzdoc:position 563 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_404>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_416> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_404>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_416> ;
    dzdoc:usesTerm dzterm:appellant,
        dzterm:appellee .

<https://legal.dz/resource/law/2008-02-25/08-09#art_565> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_3_sec_4> ;
    dzdoc:eId "art_565" ;
    dzdoc:fullText "يجب أن تتضمن عريضة الطعن بالنقض تحت طائلة عدم قبولها شكلا المثار تلقائيا، ما يأتي: 1- اسم ولقب وموطن الطاعن، وإذا تعلق الطعن بشخص معنوي بيان تسميته وطبيعته ومقره الاجتماعي وصفة ممثله القانوني أو الاتفاقي، 2- اسم ولقب وموطن المطعون ضده أو ضدهم، وإذا تعلق الطعن بشخص معنوي، بيان تسميته ومقره الاجتماعي، 3- تاريخ وطبيعة القرار المطعون فيه، 4- عرضا موجزا عن الوقائع والإجراءات المتبعة، 5 عرضا عن أوجه الطعن المؤسس عليها الطعن بالنقض . يجب ألا يتضمن الوجه المتمسك به أو الفرع منه، إلا حالة واحدة من حالات الطعن بالنقض بعد تحديدها، وذلك تحت طائلة عدم قبوله."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_565> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_565_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_565_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_565_20080225_OpEnact_857108966e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_565_obligation_0_ce037c3f>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_565_obligation_1_65f7fc7d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "565" ;
    dzdoc:position 564 ;
    dzdoc:usesTerm dzterm:cassation_appeal,
        dzterm:petition .

<https://legal.dz/resource/law/2008-02-25/08-09#art_579> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_3_sec_7> ;
    dzdoc:eId "art_579" ;
    dzdoc:fullText "إذا قدم الطاعن تنازلا عن الطعن بالنقض ، ولم يقدم المطعون ضده مذكرة جواب، أو إذا أودعها ولم يعترض عن التنازل عن الطعن بالنقض ، فإن هذا التنازل يقرر بأمر من رئيس الغرفة المختصة . إذا اعترض المطعون ضده على هذا التنازل يتم الفصل فيه بقرار من الغرفة . في كلا الحالتين، يعد الأمر أو القرار الذي يثبت التنازل بمثابة قرار رفض."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_579> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_579_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_579_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_579_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_579_20080225_OpEnact_a0cc30395e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "579" ;
    dzdoc:position 578 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_579_condition_0_dd1ddd00>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_579_condition_1_48ad07f4> ;
    dzdoc:usesTerm dzterm:appellant,
        dzterm:cassation_appeal,
        dzterm:chamber,
        dzterm:chamber_president,
        dzterm:respondent .

<https://legal.dz/resource/law/2008-02-25/08-09#art_582> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_3_sec_8> ;
    dzdoc:eId "art_582" ;
    dzdoc:fullText "يصدر القرار في جلسة علنية مع الإشارة إلى النصوص المطبقة وبيان ما يأتي : اسم ولقب وصفة وموطن كل من الخصوم وأسماء وألقاب محاميهم وعناوينهم المهنية، المذكرات المقدمة والأوجه المثارة، أسماء وألقاب وصفات القضاة الذين أصدروه مع صفة المستشار المقرر، اسم ولقب ممثل النيابة العامة ، اسم ولقب أمين الضبط الذي ساعد التشكيلة، سماع النيابة العامة ، سماع محامي الخصوم في الجلسة عند الاقتضاء، تلاوة التقرير خلال الجلسة والمداولة، النطق بالقرار في جلسة علنية. يوقع أصل القرار من طرف رئيس التشكيلة و أمين الضبط والمستشار المقرر عند الاقتضاء. وفي حالة وجود مانع، يعين الرئيس الأول للمحكمة العليا بموجب أمر ، رئيسا أو مستشارا آخر ، و / أو أمين ضبط آخر للتوقيع على أصل القرار، حسب الحالة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_582> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_582_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_582_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_582_20080225_OpEnact_247488d333> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_582_obligation_0_aa235245>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_582_obligation_1_7c4e6e7e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "582" ;
    dzdoc:position 581 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_582_condition_0_ca1b98f0> ;
    dzdoc:usesTerm dzterm:clerk,
        dzterm:public_prosecutor .

<https://legal.dz/resource/law/2008-02-25/08-09#art_586> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_2> ;
    dzdoc:eId "art_586" ;
    dzdoc:fullText "تحدد الأحكام والقرارات القاضية بتقديم كفيل أو كفالة ، تاريخ تقديم الكفيل أو تاريخ إيداع الكفالة ، ما لم يكن هذا التقديم أو هذا الإيداع قد حصل قبل صدور الحكم أو القرار . يتم إيداع الكفالة بأمانة الضبط ، و يحصل تقديم الكفيل بالجلسة بعد إيداع المستندات الدالة على ملاءته في أمانة الضبط، عند الاقتضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_586> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_586_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_586_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_586_20080225_OpEnact_e995a8d740> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_586_obligation_0_e8cfe45a>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_586_obligation_1_8c098999> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "586" ;
    dzdoc:position 585 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_586_condition_0_a9a80c71> ;
    dzdoc:usesTerm dzterm:guarantee,
        dzterm:guarantor .

<https://legal.dz/resource/law/2008-02-25/08-09#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_3_sec_2_subsec_3> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "يجب على القاضي إرجاء الفصل في الخصومة إذا نص القانون على منح أجل للخصم الذي يطلبه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_59_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_59_20080225_OpEnact_722109d6cb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_59_obligation_0_274bab40> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "59" ;
    dzdoc:position 58 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_59_condition_0_d39acbb6> ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_597> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_3> ;
    dzdoc:eId "art_597" ;
    dzdoc:fullText "إذا صدر الحكم غيابيا في حق طالب الحساب ، تصادق المحكمة على بنود الحساب إن كانت مبررة و إذا تجاوزت الإيرادات مقدار المصروفات يودع الملزم المبلغ الفائض بأمانة الضبط ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_597> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_597_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_597_20080225_OpEnact_aa418b08d4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_597_obligation_0_73a04d4e>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_597_obligation_1_30d4b477> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 597" ;
    dzdoc:position 596 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_597_condition_0_ea3b735f>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_597_condition_1_25dd9139> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_616> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_4_sec_3_subsec_2> ;
    dzdoc:eId "art_616" ;
    dzdoc:fullText "يجوز أن يستكمل التنفيذ من طرف جميع ورثة الدائن مجتمعين أو من أحدهم دون تفويض من باقي الورثة . في هذه الحالة تبرأ ذمة المنفذ عليه تجاه الورثة الآخرين الذين تنتقل حقوقهم إلى الشخص الذي سعى إلى التنفيذ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_616_permission_0_142022ad> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_616_right_0_10980fc2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_616> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_616_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_616_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_616_20080225_OpEnact_11127f70cf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "616" ;
    dzdoc:position 615 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_635> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_4_sec_4> ;
    dzdoc:eId "art_635" ;
    dzdoc:fullText "إذا سبق الفصل في إشكال التنفيذ أو في طلب وقف التنفيذ ، فلا يجوز رفع دعوى ثانية من نفس الأطراف حول نفس الموضوع ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_635_permission_0_a3544c61> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_635> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_635_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_635_20080225_OpEnact_355f887bc8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_635_obligation_0_e3d98fc3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "635" ;
    dzdoc:position 634 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_635_condition_0_b0f8edab> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_686> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_3_subsec_4> ;
    dzdoc:eId "art_686" ;
    dzdoc:fullText "إذا كانت المبالغ المالية المحجوزة كافية للوفاء بحقوق جميع الدائنين ، يتم الوفاء بموجب أمر تخصيص بين الدائنين كل حسب قيمة دينه . وإذا كانت المبالغ المالية غير كافية ، يجري تقسيمها بين الدائنين قسمة غرماء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_686> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_686_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_686_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_686_20080225_OpEnact_1f2f56d837> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_686_obligation_0_62466efc>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_686_obligation_1_f6ddd364> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "686" ;
    dzdoc:position 685 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_686_condition_0_d544653f>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_686_condition_1_98ab0438> ;
    dzdoc:usesTerm dzterm:allocation_order .

<https://legal.dz/resource/law/2008-02-25/08-09#art_708> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_4_subsec_6> ;
    dzdoc:eId "art_708" ;
    dzdoc:fullText "لا يجري البيع بالمزاد العلني، إلا بعد إعادة جرد الأموال المحجوزة وتحرير محضر بذلك ، يبين فيه المحضر القضائي أو محافظ البيع ما يكون قد نقص منها. ولا يجري البيع إلا إذا حضر عدد من المزايدين يزيد عن ثلاثة (3) أشخاص ، وإلا أجل البيع إلى تاريخ لاحق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_708> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_708_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_708_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_708_20080225_OpEnact_4837e4ce17> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_708_obligation_0_42f7d45f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "708" ;
    dzdoc:position 707 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_708_condition_0_4f88df88> ;
    dzdoc:usesTerm dzterm:judicial_officer .

<https://legal.dz/resource/law/2008-02-25/08-09#art_714> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_4_subsec_7> ;
    dzdoc:eId "art_714" ;
    dzdoc:fullText "يعتبر محضر البيع برسو المزاد ، سندا تنفيذيا بفرق الثمن تجاه الراسي عليه المزاد المتخلف عن دفع ثمن الشيء المباع. يكون المحضر القضائي أو محافظ البيع ملزما بالثمن ، إذا لم يستوفه من الراسي عليه المزاد فورا أو في الأجل المحدد في شروط البيع، ولم يبادر إلى إعادة البيع خلال أجل أقصاه خمسة عشر (15) يوما من تاريخ البيع . ويعتبر محضر البيع برسو المزاد سندا تنفيذيا تجاه من أشرف منهما على البيع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_714> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_714_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_714_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_714_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_714_20080225_OpEnact_e2023142d6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_714_obligation_0_bfdac6ce> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "714" ;
    dzdoc:position 713 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_714_condition_0_5e57391d> ;
    dzdoc:usesTerm dzterm:auctioneer,
        dzterm:bidder,
        dzterm:enforcement_title,
        dzterm:judicial_officer,
        dzterm:sale_report .

<https://legal.dz/resource/law/2008-02-25/08-09#art_726> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_5_subsec_2> ;
    dzdoc:eId "art_726" ;
    dzdoc:fullText "إذا كان الدائن الحاجز ، دائنا ممتازا ، له تأمين عيني على العقارات المراد حجزها ، يقوم بالتبليغ الرسمي لأمر الحجز إلى حائز العقار المرهون، وإلى الكفيل العيني إن وجد . لحائز العقار المرهون أو الكفيل العيني الخيار بين الوفاء بالدين أو التخلية أو قبول إجراءات الحجز والبيع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_726_right_0_bb6e1332> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_726> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_726_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_726_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_726_20080225_OpEnact_c723255a84> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_726_obligation_0_d031b532> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "726" ;
    dzdoc:position 725 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_726_condition_0_f2d50ac4> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_728> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_5_subsec_4> ;
    dzdoc:eId "art_728" ;
    dzdoc:fullText "يجب على المحافظ العقاري ، قيد أمر الحجز من تاريخ الإيداع وتسليم شهادة عقارية إلى المحضر القضائي ، أو إلى الدائن الحاجز، خلال أجل أقصاه ثمانية (8) أيام ، وإلا تعرض للعقوبات التأديبية المنصوص عليها في التشريع الساري المفعول. تتضمن الشهادة العقارية جميع القيود والحقوق المثقلة للعقار أو الحق العيني العقاري وكذا أسماء الدائنين وموطن كل منهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_728> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_728_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_728_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_728_20080225_OpEnact_a1e5bb559d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_728_obligation_0_6328a2ad> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "728" ;
    dzdoc:position 727 ;
    dzdoc:usesTerm dzterm:conservateur_foncier,
        dzterm:huissier_justice .

<https://legal.dz/resource/law/2008-02-25/08-09#art_733> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_5_subsec_4> ;
    dzdoc:eId "art_733" ;
    dzdoc:fullText "إذا قام المدين المحجوز عليه أو حائز العقار أو الكفيل العيني باختلاس أو إتلاف الأموال المذكورة في المادة 732 أعلاه ، تعرض إلى العقوبات المقررة في قانون العقوبات للجرائم المتعلقة بالأموال المحجوزة، فضلا عن التعويضات المدنية، عند الاقتضاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_733> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_733_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_733_20080225_OpEnact_8aa81d6237> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "733" ;
    dzdoc:position 732 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_732> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_732> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_733_condition_0_43c07793> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_779> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_7> ;
    dzdoc:eId "art_779" ;
    dzdoc:fullText "إذا تعدد الحاجزون، أو ظهر دائنون بيدهم سندات تنفيذية بعد إجراء الحجز الأول ، فإنهم يشتركون بحصص متساوية في نسبة الحجز المشار إليها في المادة 776 أعلاه. يتم قيد بقية الحاجزين مع الحاجز الأول بأمانة الضبط، بأمر على عريضة ، بمجرد إثبات صفتهم. تبقى للديون المتعلقة بالنفقة الغذائية حق الأولوية على باقي الديون عند الاستيفاء وفقا للترتيب المنصوص عليه في القانون المدني ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_779_right_0_9e8ee32d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_779> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_779_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_779_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_779_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_779_20080225_OpEnact_b4021ab4e2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "779" ;
    dzdoc:position 778 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_776> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_776> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_779_condition_0_808b53bf> ;
    dzdoc:usesTerm dzterm:civil_code,
        dzterm:petition_order .

<https://legal.dz/resource/law/2008-02-25/08-09#art_782> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_7> ;
    dzdoc:eId "art_782" ;
    dzdoc:fullText "يتم التبليغ الرسمي لأمر التحويل المشار إليه في المادتين 780 و 781 أعلاه، إلى المدين المحجوز عليه وإلى المحجوز لديه . يجب على المحجوز لديه تنفيذ أمر التحويل لفائدة الدائن الحاجز ابتداء من الشهر التالي لتاريخ التبليغ الرسمي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_782> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_782_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_782_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_782_20080225_OpEnact_a63b28291f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_782_obligation_0_fae4914e>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_782_obligation_1_8b349b87> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "782" ;
    dzdoc:position 781 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_780>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_781> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_780>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_781> ;
    dzdoc:usesTerm dzterm:garnishee,
        dzterm:seized_debtor,
        dzterm:seizing_creditor .

<https://legal.dz/resource/law/2008-02-25/08-09#art_786> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_8_subsec_2> ;
    dzdoc:eId "art_786" ;
    dzdoc:fullText "إذا تقرر بحكم أو قرار قضائي بيع العقار و/أو الحق العيني العقاري المملوك على الشيوع لعدم إمكان القسمة بغير ضرر أو لتعذر القسمة عينا ، بيع العقار عن طريق المزاد العلني بناء على قائمة شروط البيع، يعدها المحضر القضائي ، وتودع بأمانة ضبط المحكمة التي يوجد فيها العقار ، بناء على طلب من يهمه التعجيل من المالكين على الشيوع. تشتمل قائمة شروط البيع فضلا عن البيانات المذكورة في المادة 783 أعلاه، على ذكر جميع المالكين على الشيوع وموطن كل منهم، ويرفق بها فضلا عن الوثائق المذكورة في المادة 784 أعلاه، نسخة من الحكم أو القرار الصادر بإجراء البيع بالمزاد العلني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_786> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_786_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_786_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_786_20080225_OpEnact_b5b311ff48> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "786" ;
    dzdoc:position 785 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_783>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_784> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_783>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_784> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_786_condition_0_52ddab72> ;
    dzdoc:usesTerm dzterm:immovable,
        dzterm:judicial_bailiff,
        dzterm:real_right .

<https://legal.dz/resource/law/2008-02-25/08-09#art_803> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_803" ;
    dzdoc:fullText "يتحدد الاختصاص الإقليمي للمحاكم الإدارية طبقا للمادتين 37 و 38 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_803> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_803_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_803_20080225_OpEnact_567ba02cf1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "803" ;
    dzdoc:position 802 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_37>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_38> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_37>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_38> ;
    dzdoc:usesTerm dzterm:territorial_jurisdiction .

<https://legal.dz/resource/law/2008-02-25/08-09#art_828> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_828" ;
    dzdoc:fullText "مع مراعاة النصوص الخاصة عندما تكون الدولة أو الولاية أو البلدية أو المؤسسة العمومية ذات الصبغة الإدارية طرفا في الدعوى بصفة مدعي أو مدعى عليه ، تمثل بواسطة الوزير المعني ، الوالي ، رئيس المجلس الشعبي البلدي على التوالي، والممثل القانوني بالنسبة للمؤسسة ذات الصبغة الإدارية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_828> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_828_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_828_20080225_OpEnact_12d5b45d0f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_828_obligation_0_9d7b714d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "828" ;
    dzdoc:position 827 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_828_condition_0_6e9faaf4> ;
    dzdoc:usesTerm dzterm:commune,
        dzterm:mayor,
        dzterm:minister,
        dzterm:public_institution,
        dzterm:state,
        dzterm:wali,
        dzterm:wilaya .

<https://legal.dz/resource/law/2008-02-25/08-09#art_840> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_840" ;
    dzdoc:fullText "تبلغ كل الإجراءات المتخذة وتدابير التحقيق إلى الخصوم برسالة مضمنة مع الإشعار بالاستلام، أو عن طريق محضر قضائي ، عند الاقتضاء. يتم أيضا تبليغ طلبات التسوية والإعذارات وأوامر الاختتام وتاريخ الجلسة بنفس الأشكال. يشار في تبليغ العرائض والمذكرات إلى أنه في حالة عدم مراعاة الأجل المحدد من طرف القاضي لتقديم مذكرات الرد يمكن اختتام التحقيق دون إشعار مسبق."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_840_permission_0_0aa556cf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_840> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_840_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_840_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_840_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_840_20080225_OpEnact_d6e2fbebe1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "840" ;
    dzdoc:position 839 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_840_condition_0_9c6239b6> ;
    dzdoc:usesTerm dzterm:judicial_bailiff .

<https://legal.dz/resource/law/2008-02-25/08-09#art_860> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_860" ;
    dzdoc:fullText "يجوز لـ تشكيلة الحكم أو لـ القاضي المقرر الذي يقوم بسماع الشهود أن يستدعي أو يستمع تلقائيا إلى أي شخص يرى سماعه مفيدا. كما يجوز أيضا سماع أعوان الإدارة، أو طلب حضورهم لتقديم الإيضاحات."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_860_permission_0_61b22ebc>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_860_permission_1_0c9078f7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_860> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_860_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_860_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_860_20080225_OpEnact_2f5c9f1f46> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "860" ;
    dzdoc:position 859 ;
    dzdoc:usesTerm dzterm:reporting_judge,
        dzterm:trial_panel .

<https://legal.dz/resource/law/2008-02-25/08-09#art_922> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_922" ;
    dzdoc:fullText "يجوز لـ قاضي الاستعجال ، بطلب من كل ذي مصلحة، أن يعدل في أي وقت وبناء على مقتضيات جديدة، التدابير التي سبق أن أمر بها أو يضع حدا لها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_922_permission_0_7621ee19> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_922> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_922_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_922_20080225_OpEnact_000093c0ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "922" ;
    dzdoc:position 921 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_935> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_935" ;
    dzdoc:fullText "يرتب الأمر الاستعجالي أثاره من تاريخ التبليغ الرسمي أو التبليغ للخصم المحكوم عليه. غیر أنه، يجوز لـ قاضي الاستعجال أن يقرر تنفيذه فور صدوره. يبلغ أمين ضبط الجلسة، بأمر من القاضي، منطوق الأمر ممهورا بالصيغة التنفيذية في الحال إلى الخصوم مقابل وصل استلام، إذا اقتضت ظروف الاستعجال ذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_935_permission_0_5ed1291b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_935> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_935_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_935_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_935_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_935_20080225_OpEnact_296cf1454d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "935" ;
    dzdoc:position 934 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_935_condition_0_5fc1cad8> ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_97> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_4> ;
    dzdoc:eId "art_97" ;
    dzdoc:fullText "يمكن القيام بـ عمليات التحقيق من جديد أو تصحيحها ، إذا أمكن تصحيح العيب الذي يشوبها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_97_permission_0_6f5a4f73> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_97_right_0_dd02b921> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_97> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_97_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_97_20080225_OpEnact_cda15e60e3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "97" ;
    dzdoc:position 96 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_97_condition_0_c9c88b0f> ;
    dzdoc:usesTerm dzterm:investigation_operations .

<https://legal.dz/resource/law/2008-02-25/08-09#art_979> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_6_sec_1> ;
    dzdoc:eId "art_979" ;
    dzdoc:fullText "عندما يتطلب الأمر أو الحكم أو القرار، إلزام أحد الأشخاص المعنوية العامة أو هيئة تخضع منازعاتها لاختصاص الجهات القضائية الإدارية باتخاذ تدابير تنفيذ معينة، لم يسبق أن أمرت بها بسبب عدم طلبها في الخصومة السابقة ، تأمر الجهة القضائية الإدارية المطلوب منها ذلك، بإصدار قرار إداري جديد في أجل محدد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_979> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_979_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_979_20080225_OpEnact_a092eff8a6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_979_obligation_0_367bd9f4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "979" ;
    dzdoc:position 978 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_979_condition_0_acc52bae> .

