<https://legal.dz/resource/law/2008-02-25/08-09#art_393_obligation_0_eb617c8e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2008-02-25/08-09#art_393_obligation_0_eb617c8e_period_b73d71c76e> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_393> ;
    dznorm:position 0 ;
    dznorm:provisionText "يرفع التماس إعادة النظر في أجل شهرين (2)، يبدأ سريانه من تاريخ ثبوت تزوير شهادة الشاهد، أو ثبوت التزوير، أو تاريخ اكتشاف الوثيقة المحتجزة."@ar ;
    dznorm:sourceArticle "art_393" .

