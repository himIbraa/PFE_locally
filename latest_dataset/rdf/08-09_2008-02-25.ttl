<https://legal.dz/resource/law/2008-02-25/08-09#version_art_660> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبقى الأموال المحجوزة تحت يد المحجوز عليه إلى حين الحكم بتثبيت الحجز أو الأمر برفعه . وله أن ينتفع بها انتفاع أب الأسرة الحريص وأن يمتلك ثمارها مع المحافظة عليها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_660_20080225_OpEnact_2c7873eefd> ;
    dzdoc:replacementText "تبقى الأموال المحجوزة تحت يد المحجوز عليه إلى حين الحكم بتثبيت الحجز أو الأمر برفعه . وله أن ينتفع بها انتفاع أب الأسرة الحريص وأن يمتلك ثمارها مع المحافظة عليها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_660> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
