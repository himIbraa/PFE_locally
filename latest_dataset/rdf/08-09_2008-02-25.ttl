<https://legal.dz/resource/law/2008-02-25/08-09#art_950> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_1_subsec_1> ;
    dzdoc:eId "art_950" ;
    dzdoc:fullText "يحدد أجل استئناف الأحكام بشهرين (2) ويخفض هذا الأجل إلى خمسة عشر (15) يوما بالنسبة للأوامر الاستعجالية ، ما لم توجد نصوص خاصة . تسري هذه الآجال من يوم التبليغ الرسمي للأمر أو الحكم إلى المعني، وتسري من تاريخ انقضاء أجل المعارضة إذا صدر غيابيا. تسري هذه الآجال في مواجهة طالب التبليغ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_950> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_950_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_950_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_950_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_950_20080225_OpEnact_1cfc5c0620> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_950_obligation_0_da99a779> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "950" ;
    dzdoc:position 949 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_950_condition_0_dd3cbca9> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_966> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_2_subsec_4> ;
    dzdoc:eId "art_966" ;
    dzdoc:fullText "لا يجوز الطعن ب التماس إعادة النظر إلا في القرارات الصادرة عن مجلس الدولة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_966_permission_0_9f54f999> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_966> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_966_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_966_20080225_OpEnact_ce603fd44a> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_966_prohibition_0_9f54f999> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 966" ;
    dzdoc:position 965 ;
    dzdoc:usesTerm dzterm:التماس_إعادة_النظر,
        dzterm:مجلس_الدولة .

<https://legal.dz/resource/law/2008-02-25/08-09#art_969> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_2_subsec_4> ;
    dzdoc:eId "art_969" ;
    dzdoc:fullText "لا يجوز تقديم التماس إعادة النظر من جديد في القرار الفاصل في دعوى الالتماس."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_969_permission_0_32804413> ;
