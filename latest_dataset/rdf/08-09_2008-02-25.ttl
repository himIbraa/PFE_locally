<https://legal.dz/resource/law/2008-02-25/08-09#version_art_440> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في التاريخ المحدد لإجراء محاولة الصلح، يستمع القاضي إلى كل زوج على انفراد ثم معا . ويمكن بناء على طلب الزوجين حضور أحد أفراد العائلة والمشاركة في محاولة الصلح ."@ar ;
    dzdoc:isAuthoritative true ;
