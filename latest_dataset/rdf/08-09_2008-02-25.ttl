    rdfs:label "أن تتضمن عريضة افتتاح الدعوى"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب أن تتضمن عريضة افتتاح الدعوى، تحت طائلة عدم قبولها شكلا، البيانات الآتية :"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_15> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_15_obligation_0_d95570d3_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/law/2008-02-25/08-09#art_15_obligation_0_d95570d3> ;
    dznorm:conditionText "تحت طائلة عدم قبولها شكلا"@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_15_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_15> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب أن تتضمن عريضة افتتاح الدعوى، تحت طائلة عدم قبولها شكلا، البيانات الآتية : 1 - الجهة القضائية التي ترفع أمامها الدعوى، 2- اسم ولقب المدعي وموطنه، 3- اسم ولقب وموطن المدعى عليه، فإن لم يكن له موطن معلوم، فآخر موطن له، 4- الإشارة إلى تسمية وطبيعة الشخص المعنوي، ومقره الاجتماعي وصفة ممثله القانوني أو الاتفاقي، 5- عرضا موجزا للوقائع والطلبات والوسائل التي تؤسس عليها الدعوى، 6- الإشارة عند الاقتضاء، إلى المستندات والوثائق المؤيدة للدعوى."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_160_obligation_0_1ce08c35> a dznorm:Obligation ;
