<https://legal.dz/resource/law/2008-02-25/08-09#art_637_obligation_0_df109922> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_637> ;
