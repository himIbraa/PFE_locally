<https://legal.dz/resource/law/2008-02-25/08-09#version_art_193> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تؤدى اليمين من قبل الخصم الذي وجهت له شخصيا بالجلسة أو في المكان الذي يحدده القاضي ، و إذا برر استحالة التنقل يمكنه أداءها إما أمام قاض منتدب لهذا الغرض، ينتقل إلى مكان تواجده بحضور أمين الضبط ، وإما أمام المحكمة الموجود بدائرة اختصاصها محل إقامته . تؤدى اليمين حسب الحالة، بحضور أمين الضبط أو المحضر القضائي الذي يحرر محضرا عن ذلك، وفي جميع الحالات، تؤدى بحضور الخصم الآخر أو بعد صحة تبليغه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_193_20080225_OpEnact_65f4606b78> ;
    dzdoc:replacementText "تؤدى اليمين من قبل الخصم الذي وجهت له شخصيا بالجلسة أو في المكان الذي يحدده القاضي ، و إذا برر استحالة التنقل يمكنه أداءها إما أمام قاض منتدب لهذا الغرض، ينتقل إلى مكان تواجده بحضور أمين الضبط ، وإما أمام المحكمة الموجود بدائرة اختصاصها محل إقامته . تؤدى اليمين حسب الحالة، بحضور أمين الضبط أو المحضر القضائي الذي يحرر محضرا عن ذلك، وفي جميع الحالات، تؤدى بحضور الخصم الآخر أو بعد صحة تبليغه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_193> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_193> ;
