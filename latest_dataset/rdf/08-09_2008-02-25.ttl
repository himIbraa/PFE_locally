<https://legal.dz/resource/law/2008-02-25/08-09#version_art_1015> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يعد تشكيل محكمة التحكيم صحيحا، إلا إذا قبل المحكم أو المحكمون بالمهمة المسندة إليهم . إذا علم المحكم أنه قابل للرد ، يخبر الأطراف بذلك ، و لا يجوز له القيام بالمهمة إلا بعد موافقتهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
