<https://legal.dz/resource/law/2008-02-25/08-09#art_818_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_818> ;
    dzdoc:position 0 ;
    dzdoc:text "تودع العريضة مع نسخة منها بملف القضية، وعند الضرورة ، يأمر رئيس تشكيلة الحكم الخصوم بتقديم نسخ إضافية."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_819_condition_0_e7ccbcd7> a dznorm:Condition ;
    dznorm:conditionText "وإذا ثبت أن هذا المانع يعود إلى امتناع الإدارة من تمكين المدعي من القرار المطعون فيه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_819> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_819_obligation_0_8c5b3096> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2008-02-25/08-09#art_819_obligation_0_8c5b3096_action_d8d9a2bf8d> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_819> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب أن يرفق مع العريضة الرامية إلى إلغاء أو تفسير أو تقدير مدى مشروعية القرار الإداري، تحت طائلة عدم القبول، القرار الإداري المطعون فيه"@ar ;
    dznorm:sourceArticle "art_819" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_819_obligation_0_8c5b3096_action_d8d9a2bf8d> a dznorm:Action ;
