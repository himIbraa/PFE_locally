<https://legal.dz/resource/law/2008-02-25/08-09#version_art_852> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما تكون القضية مهيأة للفصل ، يحدد رئيس تشكيلة الحكم تاريخ اختتام التحقيق بموجب أمر غير قابل لأي طعن. يبلغ الأمر إلى جميع الخصوم برسالة مضمنة مع إشعار بالاستلام أو بأية وسيلة أخرى، في أجل لا يقل عن خمسة عشر (15) يوما قبل تاريخ الاختتام المحدد في الأمر"@ar ;
