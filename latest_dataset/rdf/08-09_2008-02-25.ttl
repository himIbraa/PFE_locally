    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_455_20080225_OpEnact_12f7626d93> ;
    dzdoc:replacementText "يتم التبليغ الرسمي للأمر الاستعجالي الصادر وفقا ل المادة 453 أعلاه، من طرف الخصم الذي يهمه التعجيل إلى باقي الخصوم خلال ثلاثين (30) يوما من تاريخ النطق به تحت طائلة سقوط الأمر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_455> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
