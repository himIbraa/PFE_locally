    dznorm:position 0 ;
    dznorm:provisionText "يجب الفصل في الدعاوى الاستعجالية في أقرب الآجال"@ar ;
    dznorm:sourceArticle "art_299" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_299_obligation_0_e4906563_action_b205270348> a dznorm:Action ;
