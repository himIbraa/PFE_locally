<https://legal.dz/resource/law/2008-02-25/08-09#version_art_748> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم المحضر القضائي ، بعد إيداع قائمة شروط البيع، بنشر مستخرج من هذه القائمة في جريدة يومية وطنية والتعليق في لوحة الإعلانات بالمحكمة خلال ثمانية (8) أيام التالية لآخر تبليغ رسمي بإيداع القائمة وترفق صورة من الإعلان في الجريدة ونسخة من محضر التعليق مع ملف التنفيذ. يجوز لكل شخص الاطلاع على قائمة شروط البيع في مكتب المحضر القضائي أو في أمانة ضبط المحكمة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_748_20080225_OpEnact_f49b70f220> ;
    dzdoc:replacementText "يقوم المحضر القضائي ، بعد إيداع قائمة شروط البيع، بنشر مستخرج من هذه القائمة في جريدة يومية وطنية والتعليق في لوحة الإعلانات بالمحكمة خلال ثمانية (8) أيام التالية لآخر تبليغ رسمي بإيداع القائمة وترفق صورة من الإعلان في الجريدة ونسخة من محضر التعليق مع ملف التنفيذ. يجوز لكل شخص الاطلاع على قائمة شروط البيع في مكتب المحضر القضائي أو في أمانة ضبط المحكمة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_748> ;
