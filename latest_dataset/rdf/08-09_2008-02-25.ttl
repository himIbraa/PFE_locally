<https://legal.dz/resource/law/2008-02-25/08-09#art_1046_condition_1_77ded2fc> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يقم الطرف المعني بتنفيذ هذا التدبير إراديا"@ar ;
