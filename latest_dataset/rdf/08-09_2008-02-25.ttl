<https://legal.dz/resource/law/2008-02-25/08-09#art_906> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_906" ;
    dzdoc:fullText "تطبق الأحكام الواردة في المواد من 826 إلى 828 أعلاه، فيما يخص تمثيل الأطراف أمام مجلس الدولة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_906> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_906_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_906_20080225_OpEnact_ab1d9118cb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 906" ;
    dzdoc:position 905 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_826>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_828> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_826>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_828> ;
    dzdoc:usesTerm dzterm:state_council .

<https://legal.dz/resource/law/2008-02-25/08-09#art_908> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_908" ;
    dzdoc:fullText "الاستئناف أمام مجلس الدولة ليس له أثر موقف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_908> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_908_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_908_20080225_OpEnact_f625a373af> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 908" ;
    dzdoc:position 907 ;
    dzdoc:usesTerm dzterm:state_council .

<https://legal.dz/resource/law/2008-02-25/08-09#art_909> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_909" ;
    dzdoc:fullText "الطعن بالنقض أمام مجلس الدولة ليس له أثر موقف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_909> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_909_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_909_20080225_OpEnact_3862c70dfb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 909" ;
    dzdoc:position 908 ;
    dzdoc:usesTerm dzterm:state_council .

<https://legal.dz/resource/law/2008-02-25/08-09#art_910> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_910" ;
    dzdoc:fullText "تطبق الأحكام المتعلقة ب وقف التنفيذ المنصوص عليها في المواد من 833 إلى 837 أعلاه، أمام مجلس الدولة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_910> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_910_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_910_20080225_OpEnact_928e9dc51e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "910" ;
    dzdoc:position 909 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_833>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_837> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_833>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_837> ;
    dzdoc:usesTerm dzterm:council_of_state,
        dzterm:stay_of_execution .

<https://legal.dz/resource/law/2008-02-25/08-09#art_915> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_2_sec_2_subsec_5> ;
    dzdoc:eId "art_915" ;
    dzdoc:fullText "تطبق الأحكام الواردة في المواد من 838 إلى 873 أعلاه، المتعلقة بالتحقيق أمام مجلس الدولة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_915> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_915_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_915_20080225_OpEnact_22f0020f58> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "915" ;
    dzdoc:position 914 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_838>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_873> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_838>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_873> ;
    dzdoc:usesTerm dzterm:council_of_state .

<https://legal.dz/resource/law/2008-02-25/08-09#art_917> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_1> ;
    dzdoc:eId "art_917" ;
    dzdoc:fullText "يفصل في مادة الاستعجال بالتشكيلة الجماعية المنوط بها البت في دعوى الموضوع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_917> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_917_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_917_20080225_OpEnact_d5318a67c8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 917" ;
    dzdoc:position 916 ;
    dzdoc:usesTerm dzterm:مادة_الاستعجال .

<https://legal.dz/resource/law/2008-02-25/08-09#art_923> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_923" ;
    dzdoc:fullText "يفصل قاضي الاستعجال وفقا لإجراءات وجاهية، كتابية وشفوية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_923> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_923_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_923_20080225_OpEnact_fefc6ac60e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "923" ;
    dzdoc:position 922 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_927> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_927" ;
    dzdoc:fullText "لا تطبق في مادة الاستعجال أحكام المادة 848 أعلاه، المتعلقة بطلب التسوية والإعذار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_927> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_927_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_927_20080225_OpEnact_ab631e6f78> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "927" ;
    dzdoc:position 926 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_848> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_848> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_93> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_3> ;
    dzdoc:eId "art_93" ;
    dzdoc:fullText "يستأنف السير في الخصومة بعد الانتهاء من التحقيق، من الخصم الذي يهمه التعجيل، وذلك بموجب طلب بسيط."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_93> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_93_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_93_20080225_OpEnact_ddbe698a65> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 93" ;
    dzdoc:position 92 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_930> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_930" ;
    dzdoc:fullText "تعتبر القضية مهيأة للفصل بمجرد استكمال الإجراء المنصوص عليه في المادة 926 أعلاه، والتأكد من استدعاء الخصوم بصفة قانونية إلى الجلسة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_930> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_930_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_930_20080225_OpEnact_d2787207b0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "930" ;
    dzdoc:position 929 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_926> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_926> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_934> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_934" ;
    dzdoc:fullText "يتم التبليغ الرسمي للأمر الإستعجالي، وعند الاقتضاء، يبلغ بكل الوسائل وفي أقرب الآجال."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_934> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_934_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_934_20080225_OpEnact_f1f7123fe5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "934" ;
    dzdoc:position 933 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_936> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_2_subsec_3> ;
    dzdoc:eId "art_936" ;
    dzdoc:fullText "الأوامر الصادرة تطبيقا للمواد 919 و 921 و 922 أعلاه، غير قابلة لأي طعن."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_936> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_936_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_936_20080225_OpEnact_b032ca5942> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 936" ;
    dzdoc:position 935 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_919>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_921>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_922> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_919>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_921>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_922> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_952> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_1_subsec_1> ;
    dzdoc:eId "art_952" ;
    dzdoc:fullText "لا تكون الأحكام الصادرة قبل الفصل في الموضوع، قابلة للاستئناف إلا مع الحكم الفاصل في موضوع الدعوى، ويتم الاستئناف بعريضة واحدة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_952> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_952_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_952_20080225_OpEnact_4fecd8d406> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "952" ;
    dzdoc:position 951 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_957> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_957" ;
    dzdoc:fullText "توزع الطعون بالنقض المعروضة أمام مجلس الدولة على الغرف من طرف رئيس مجلس الدولة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_957> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_957_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_957_20080225_OpEnact_f875c6f416> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 957" ;
    dzdoc:position 956 ;
    dzdoc:usesTerm dzterm:appeals,
        dzterm:president_state_council,
        dzterm:state_council .

<https://legal.dz/resource/law/2008-02-25/08-09#art_959> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_959" ;
    dzdoc:fullText "تطبق الأحكام المتعلقة بأوجه النقض المنصوص عليها في المادة 358 من هذا القانون أمام مجلس الدولة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_959> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_959_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_959_20080225_OpEnact_f5f252f23e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 959" ;
    dzdoc:position 958 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_358> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_358> ;
    dzdoc:usesTerm dzterm:state_council .

<https://legal.dz/resource/law/2008-02-25/08-09#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_4> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "لا يمس البطلان عمليات التحقيق إلا في جوانبها المشوبة بعدم الصحة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_96_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_96_20080225_OpEnact_513ab80d27> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
