    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "تطبق الأحكام المتعلقة بـ الادعاء بالتزوير المنصوص عليها في المواد من 175 إلى 188 من هذا القانون أمام المحاكم الإدارية ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_872_20080225_OpEnact_9840520f09> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_872> ;
