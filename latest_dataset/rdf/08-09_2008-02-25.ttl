<https://legal.dz/resource/law/2008-02-25/08-09#version_art_995> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تمتد الوساطة إلى كل النزاع أو إلى جزء منه. لا يترتب على الوساطة تخلي القاضي عن القضية، ويمكنه اتخاذ أي تدبير يراه ضروريا في أي وقت."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_995_20080225_OpEnact_ce41ae2207> ;
    dzdoc:replacementText "تمتد الوساطة إلى كل النزاع أو إلى جزء منه. لا يترتب على الوساطة تخلي القاضي عن القضية، ويمكنه اتخاذ أي تدبير يراه ضروريا في أي وقت."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_995> ;
