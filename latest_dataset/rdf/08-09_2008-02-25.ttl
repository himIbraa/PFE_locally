    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_961> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "تطبق الأحكام المتعلقة بـ اعتراض الغير الخارج عن الخصومة المنصوص عليها في المواد من 381 إلى 389 من هذا القانون أمام الجهات القضائية الإدارية."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_962_20080225_OpEnact_f08d5d7d58> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
