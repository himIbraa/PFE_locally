    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "لا يجوز تقديم التماس إعادة النظر من جديد في القرار الفاصل في دعوى الالتماس."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_96_20080225_OpEnact_513ab80d27> a dzdoc:ArticleVersion ;
