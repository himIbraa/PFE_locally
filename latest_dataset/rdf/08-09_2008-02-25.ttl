<https://legal.dz/resource/law/2008-02-25/08-09#version_art_663> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم رفع الحجز التحفظي، بدعوى استعجالية، في الحالات الآتية : إذا لم يسع الدائن إلى رفع دعوى تثبيته في الأجل المنصوص عليه في المادة 662 أعلاه ، إذا قام المدين بإيداع مبالغ مالية بأمانة ضبط المحكمة أو بمكتب المحضر القضائي لتغطية أصل الدين والمصاريف ، في كل حالة يثبت فيها المستأجر أو المستأجر الفرعي أنه دفع الأجرة المستحقة في حالة حجز المؤجر على منقولات المستأجر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_663_20080225_OpEnact_42f4e5ab58> ;
    dzdoc:replacementText "يتم رفع الحجز التحفظي، بدعوى استعجالية، في الحالات الآتية : إذا لم يسع الدائن إلى رفع دعوى تثبيته في الأجل المنصوص عليه في المادة 662 أعلاه ، إذا قام المدين بإيداع مبالغ مالية بأمانة ضبط المحكمة أو بمكتب المحضر القضائي لتغطية أصل الدين والمصاريف ، في كل حالة يثبت فيها المستأجر أو المستأجر الفرعي أنه دفع الأجرة المستحقة في حالة حجز المؤجر على منقولات المستأجر ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_663> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
