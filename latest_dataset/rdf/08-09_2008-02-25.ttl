<https://legal.dz/resource/law/2008-02-25/08-09#version_art_145> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز استئناف الحكم الأمر بالخبرة، أو الطعن فيه بالنقض، إلا مع الحكم الفاصل في موضوع النزاع . إذا لم تكن قد أثيرت مسبقا أمام الجهة القضائية التي فصلت في نتائج الخبرة ، لا يمكن أن تشكل المناقشات المتعلقة بعناصر الخبرة، أسبابا لاستئناف الحكم أو الطعن فيه بالنقض ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_145_20080225_OpEnact_bf93e09024> ;
    dzdoc:replacementText "لا يجوز استئناف الحكم الأمر بالخبرة، أو الطعن فيه بالنقض، إلا مع الحكم الفاصل في موضوع النزاع . إذا لم تكن قد أثيرت مسبقا أمام الجهة القضائية التي فصلت في نتائج الخبرة ، لا يمكن أن تشكل المناقشات المتعلقة بعناصر الخبرة، أسبابا لاستئناف الحكم أو الطعن فيه بالنقض ."@ar ;
