dzterm:commercial_section a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "القسم التجاري"@ar .

dzterm:expertise a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الخبرة"@ar,
        "تهدف الخبرة إلى توضيح واقعة مادية تقنية أو علمية محضة للقاضي"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_125_defocc_216ed96c3965> .

dzterm:extraordinary_appeals a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "طرق الطعن غير العادية هي اعتراض الغير الخارج عن الخصومة والتماس إعادة النظر والطعن بالنقض"@ar,
        "لطرق الطعن غير العادية"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_313_defocc_9c9f399c90df> .

dzterm:family_law a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "قانون الأسرة"@ar .

dzterm:formal_pleas a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الدفوع الشكلية"@ar,
        "الدفوع الشكلية هي كل وسيلة تهدف إلى التصريح بعدم صحة الإجراءات أو انقضائها أو وقفها."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_49_defocc_8fd08ce8c434> .

dzterm:guarantee a skos:Concept,
