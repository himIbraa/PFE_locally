<https://legal.dz/resource/law/2008-02-25/08-09#version_art_21> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب إيداع الأوراق والسندات والوثائق التي يستند إليها الخصوم، دعما لادعاءاتهم، بأمانة ضبط الجهة القضائية، بأصولها أو نسخ رسمية منها أو نسخ مطابقة للأصل، وتبلغ للخصم. غير أنه يجوز للقاضي قبول نسخ عادية منها، عند الاقتضاء. يمكن تبليغ تلك الأوراق أو السندات أو الوثائق لباقي الخصوم في شكل نسخ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_21_20080225_OpEnact_0d4372ab86> ;
    dzdoc:replacementText "يجب إيداع الأوراق والسندات والوثائق التي يستند إليها الخصوم، دعما لادعاءاتهم، بأمانة ضبط الجهة القضائية، بأصولها أو نسخ رسمية منها أو نسخ مطابقة للأصل، وتبلغ للخصم. غير أنه يجوز للقاضي قبول نسخ عادية منها، عند الاقتضاء. يمكن تبليغ تلك الأوراق أو السندات أو الوثائق لباقي الخصوم في شكل نسخ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_21> ;
