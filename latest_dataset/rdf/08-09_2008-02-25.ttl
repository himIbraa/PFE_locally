    dznorm:position 0 ;
    dznorm:provisionText "تدون أقوال الشاهد في محضر"@ar ;
    dznorm:sourceArticle "art_160" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_160_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_160> ;
    dzdoc:position 0 ;
    dzdoc:text "تدون أقوال الشاهد في محضر"@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_160_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_160> ;
    dzdoc:position 1 ;
    dzdoc:text "يتضمن المحضر البيانات الآتية : مكان ويوم وساعة سماع الشاهد، حضور أو غياب الخصوم، اسم ولقب ومهنة وموطن الشاهد، أداء اليمين من طرف الشاهد، ودرجة قرابته أو مصاهرته مع الخصوم أو تبعيته لهم، أوجه التجريح المقدمة ضد الشاهد عند الاقتضاء، أقوال الشاهد والتنويه بتلاوتها عليه."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_161_condition_0_9f90776b> a dznorm:Condition ;
    dznorm:conditionText "إذا كان الشاهد لا يعرف أو لا يستطيع التوقيع أو يرفضه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_161> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_161_obligation_0_24313bba> a dznorm:Obligation ;
