<https://legal.dz/resource/law/2008-02-25/08-09#version_art_26> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للقاضي أن يؤسس حكمه على وقائع لم تكن محل المناقشات والمرافعات. يجوز للقاضي أن يأخذ بعين الاعتبار ، من بين عناصر المناقشات والمرافعات الوقائع التي أثيرت من طرف الخصوم ولم يؤسسوا عليها ادعاءاتهم."@ar ;
