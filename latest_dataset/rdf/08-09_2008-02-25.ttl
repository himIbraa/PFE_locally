<https://legal.dz/resource/law/2008-02-25/08-09#version_art_1044> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تفصل محكمة التحكيم في الاختصاص الخاص بها . و يجب إثارة الدفع بعدم الاختصاص قبل أي دفاع في الموضوع . تفصل محكمة التحكيم في اختصاصها بحكم أولي إلا إذا كان الدفع بعدم الاختصاص مرتبطا بموضوع النزاع ."@ar ;
