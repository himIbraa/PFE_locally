    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "تطبق أحكام المادتين 286 و 287 من هذا القانون على تصحيح الأخطاء المادية ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_964_20080225_OpEnact_ce5b892cc0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
