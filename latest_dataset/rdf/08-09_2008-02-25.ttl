<https://legal.dz/resource/law/2008-02-25/08-09#version_art_375> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة رفض الطعن بالنقض، أو عدم قبوله لا يجوز للطاعن أن يطعن بالنقض من جديد في نفس القرار، أو يطعن فيه بالتماس إعادة النظر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_375_20080225_OpEnact_bc75e6e4b7> ;
