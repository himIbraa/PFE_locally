<https://legal.dz/resource/law/2008-02-25/08-09#version_art_854> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المذكرات الواردة بعد اختتام التحقيق، لا تبلغ ويصرف النظر عنها من طرف تشكيلة الحكم. إذا قدم الخصوم بعد تحديد تاريخ اختتام التحقيق طلبات جديدة أو أوجها جديدة ، لا تقبل ما لم تأمر تشكيلة الحكم بتمديد التحقيق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
