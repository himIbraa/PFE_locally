<https://legal.dz/resource/law/2008-02-25/08-09#version_art_141> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تبين للتقاضي أن العناصر التي بني عليها الخبير تقريره غير وافية ، له أن يتخذ جميع الإجراءات اللازمة ، كما يجوز له على الخصوص أن يأمر باستكمال التحقيق، أو بحضور الخبير أمامه، ليتلقى منه الإيضاحات والمعلومات الضرورية ."@ar ;
