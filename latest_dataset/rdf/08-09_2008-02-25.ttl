    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_455> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_455_obligation_0_b4cf7bf3_ref_eeb696f98f5b> a dzdoc:Reference ;
    rdfs:label "المادة 453"@ar ;
    dzdoc:frbrUri "#art_453"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2008-02-25/08-09#art_453> ;
    dzdoc:sourceEId "art_455" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يتم التبليغ الرسمي للأمر الاستعجالي الصادر وفقا لالمادة 453 أعلاه، من طرف الخصم الذي يهمه التعجيل إلى باقي الخصوم خلال ثلاثين (30) يوما من تاريخ النطق به تحت طائلة سقوط الأمر."@ar ;
    dzdoc:targetEId "art_453" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_455_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_455> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم التبليغ الرسمي للأمر الاستعجالي الصادر وفقا لالمادة 453 أعلاه، من طرف الخصم الذي يهمه التعجيل إلى باقي الخصوم خلال ثلاثين (30) يوما من تاريخ النطق به تحت طائلة سقوط الأمر."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_456_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_456> ;
    dzdoc:position 0 ;
    dzdoc:text "يكون الأمر قابلا للاستئناف : 1- من قبل الخصوم في أجل خمسة عشر (15) يوما من تاريخ التبليغ الرسمي، 2- من قبل النيابة العامة خلال نفس المدة ابتداء من تاريخ النطق بالأمر."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_457_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_457> ;
    dzdoc:position 0 ;
    dzdoc:text "ينظر في الاستئناف ويفصل فيه في غرفة المشورة في آجال معقولة."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_458_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_458> ;
    dzdoc:position 0 ;
    dzdoc:text "تقدم الطلبات المشار إليها في المادة 453 أعلاه، حسب القواعد المقررة لرفع الدعوى الاستعجالية وذلك أمام محكمة مقر ممارسة الولاية."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_458_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_458> ;
    dzdoc:position 1 ;
    dzdoc:text "ينظر في الطلبات ويفصل فيها في غرفة المشورة، بعد سماع ممثل النيابة العامة ومحامي الخصوم في ملاحظاتهم عند الاقتضاء."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_459_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_459> ;
    dzdoc:position 0 ;
    dzdoc:text "يجمع القاضي المعلومات التي يراها مفيدة حول أوضاع عائلة القاصر وسلوك الأبوين."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_45_condition_0_6e309e97> a dznorm:Condition ;
    dznorm:conditionText "إلا إذا تم بين التجار"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_45> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_45_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_45> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر لاغيا وعديم الأثر كل شرط يمنح الاختصاص الإقليمي لجهة قضائية غير مختصة، إلا إذا تم بين التجار."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_460_condition_0_c954216e> a dznorm:Condition ;
    dznorm:conditionText "إذا تطلبت مصلحة القاصر ذلك"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_460> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_460_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_460> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن للقاضي ومراعاة لمصلحة القاصر، أن يأمر بكل تدبير مؤقت له علاقة بممارسة الولاية."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_460_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_460> ;
    dzdoc:position 1 ;
    dzdoc:text "كما يجوز له أن يسند مؤقتا حضانة القاصر لأحد الأبوين، وإذا تعذر ذلك تسند لأحد الأشخاص المبينين في قانون الأسرة."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_460_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_460> ;
    dzdoc:position 2 ;
    dzdoc:text "يمكن أن يكون هذا الإجراء موضوع تعديل، إذا تطلبت مصلحة القاصر ذلك، إما تلقائيا من القاضي أو بناء على طلب الولي أو القاصر المميز أو ممثل النيابة العامة أو كل شخص آخر تتوفر فيه الصفة لحماية القاصر."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_460_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_460> ;
    dzdoc:position 3 ;
    dzdoc:text "يفصل القاضي في هذا الطلب بموجب أمر استعجالي."@ar .

