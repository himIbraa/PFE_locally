<https://legal.dz/resource/law/2008-02-25/08-09#version_art_401> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقدم عريضة الفصل في تنازع الاختصاص بين القضاة، أمام الجهة القضائية المختصة في أجل شهرين (2) ، ويسري ابتداء من تاريخ التبليغ الرسمي لآخر حكم إلى الخصم المحكوم عليه. تقدم عريضة الفصل في تنازع الاختصاص بين القضاة أمام المجلس القضائي، وفقا للقواعد المقررة لرفع عريضة الاستئناف، وتخضع العريضة التي تقدم أمام المحكمة العليا للقواعد المقررة لعريضة الطعن بالنقض."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_401_20080225_OpEnact_718a6b7124> ;
    dzdoc:replacementText "تقدم عريضة الفصل في تنازع الاختصاص بين القضاة، أمام الجهة القضائية المختصة في أجل شهرين (2) ، ويسري ابتداء من تاريخ التبليغ الرسمي لآخر حكم إلى الخصم المحكوم عليه. تقدم عريضة الفصل في تنازع الاختصاص بين القضاة أمام المجلس القضائي، وفقا للقواعد المقررة لرفع عريضة الاستئناف، وتخضع العريضة التي تقدم أمام المحكمة العليا للقواعد المقررة لعريضة الطعن بالنقض."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_401> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_401> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

