<https://legal.dz/resource/law/2008-02-25/08-09#version_art_311> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقدم العريضة من نسختين . و يجب أن تكون معللة، وتتضمن الإشارة إلى الوثائق المحتج بها ، و إذا كانت العريضة مقدمة بشأن خصومة قائمة ، فيجب ذكر المحكمة المعروضة أمامها الخصومة. يجب أن يكون الأمر على عريضة مسببا ، ويكون قابلا للتنفيذ بناء على النسخة الأصلية. كل أمر على عريضة لم ينفذ خلال أجل ثلاثة (3) أشهر من تاريخ صدوره ، يسقط ولا يرتب أي أثر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_311_20080225_OpEnact_4793324d1c> ;
    dzdoc:replacementText "تقدم العريضة من نسختين . و يجب أن تكون معللة، وتتضمن الإشارة إلى الوثائق المحتج بها ، و إذا كانت العريضة مقدمة بشأن خصومة قائمة ، فيجب ذكر المحكمة المعروضة أمامها الخصومة. يجب أن يكون الأمر على عريضة مسببا ، ويكون قابلا للتنفيذ بناء على النسخة الأصلية. كل أمر على عريضة لم ينفذ خلال أجل ثلاثة (3) أشهر من تاريخ صدوره ، يسقط ولا يرتب أي أثر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_311> ;
