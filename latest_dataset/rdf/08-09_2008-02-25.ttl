    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_168_20080225_OpEnact_643629051d> ;
    dzdoc:replacementText "يؤشر القاضي على الوثائق المعتمدة للمقارنة ويحتفظ بها مع المحرر المنازع فيه أو يأمر بإيداعها بأمانة الضبط، ليتم سحبها من طرف الخبير المعين مقابل توقيعه بالاستلام."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_168> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_168> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_169> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للقاضي أن يأمر ولو من تلقاء نفسه وتحت طائلة غرامة تهديدية، بإحضار الأصل أو نسخة من الوثائق التي بحوزة الغير إذا كانت مقارنتها بالمحرر المنازع فيه مفيدة. تودع هذه الوثائق بأمانة ضبط الجهة القضائية مقابل وصل. يأمر القاضي باتخاذ التدابير اللازمة التي من شأنها المحافظة على هذه الوثائق والاطلاع عليها أو نسخها أو إرجاعها أو إعادة إدراجها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_169_20080225_OpEnact_5c54b689cc> ;
    dzdoc:replacementText "يجوز للقاضي أن يأمر ولو من تلقاء نفسه وتحت طائلة غرامة تهديدية، بإحضار الأصل أو نسخة من الوثائق التي بحوزة الغير إذا كانت مقارنتها بالمحرر المنازع فيه مفيدة. تودع هذه الوثائق بأمانة ضبط الجهة القضائية مقابل وصل. يأمر القاضي باتخاذ التدابير اللازمة التي من شأنها المحافظة على هذه الوثائق والاطلاع عليها أو نسخها أو إرجاعها أو إعادة إدراجها."@ar ;
