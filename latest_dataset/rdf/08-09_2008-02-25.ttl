    dzdoc:eId "art_868" ;
    dzdoc:fullText "يترتب على عدم قبول الطلب الأصلي عدم قبول الطلب المقابل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_868> ;
