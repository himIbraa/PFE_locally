<https://legal.dz/resource/law/2008-02-25/08-09#version_art_891> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحوز للجهة القضائية التي أصدرت الحكم، ولو بعد حيازة ذلك الحكم قوة الشيء المقضي به، أن تصحح الخطأ المادي أو الإغفال الذي يشوبه ، كما يجوز للجهة القضائية التي يطعن في الحكم أمامها القيام بتصحيحه . يقدم طلب التصحيح إلى الجهة القضائية بعريضة من أحد الخصوم أو بعريضة مشتركة منهم، كما يمكن لـ محافظ الدولة تقديم هذا الطلب. يفصل في طلب التصحيح بعد سماع الخصوم أو بعد صحة تكليفهم بالحضور."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_891_20080225_OpEnact_2cec6755dc> ;
    dzdoc:replacementText "يحوز للجهة القضائية التي أصدرت الحكم، ولو بعد حيازة ذلك الحكم قوة الشيء المقضي به، أن تصحح الخطأ المادي أو الإغفال الذي يشوبه ، كما يجوز للجهة القضائية التي يطعن في الحكم أمامها القيام بتصحيحه . يقدم طلب التصحيح إلى الجهة القضائية بعريضة من أحد الخصوم أو بعريضة مشتركة منهم، كما يمكن لـ محافظ الدولة تقديم هذا الطلب. يفصل في طلب التصحيح بعد سماع الخصوم أو بعد صحة تكليفهم بالحضور."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_891> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_891> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_892> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤشر على أصل الحكم المصحح وعلى النسخ المستخرجة منه بما قضى به حكم التصحيح، ويبلغ الخصوم بحكم التصحيح. إذا كان الحكم المصحح حائزا لقوة الشيء المقضي به فلا يكون حكم التصحيح قابلا لأي طعن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_892_20080225_OpEnact_3174dfbdbd> ;
    dzdoc:replacementText "يؤشر على أصل الحكم المصحح وعلى النسخ المستخرجة منه بما قضى به حكم التصحيح، ويبلغ الخصوم بحكم التصحيح. إذا كان الحكم المصحح حائزا لقوة الشيء المقضي به فلا يكون حكم التصحيح قابلا لأي طعن."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_892> ;
