    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_966> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "لا يجوز الطعن ب التماس إعادة النظر إلا في القرارات الصادرة عن مجلس الدولة ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_967_20080225_OpEnact_dd5562d80c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_967> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-02-25/08-09#art_967> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_967> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يمكن تقديم التماس إعادة النظر في إحدى الحالتين الآتيتين : إذا اكتشف أن القرار قد صدر بناء على وثائق مزورة قدمت لأول مرة أمام مجلس الدولة ، إذا حكم على خصم بسبب عدم تقديم وثيقة قاطعة كانت محتجزة عند الخصم ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_968_20080225_OpEnact_4cdf72e989> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
