<https://legal.dz/resource/law/2008-02-25/08-09#art_128_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_128> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب أن يتضمن الحكم الأمر بإجراء الخبرة ما يأتي : عرض الأسباب التي بررت اللجوء إلى الخبرة، وعند الاقتضاء، تبرير تعيين عدة خبراء، بيان اسم ولقب وعنوان الخبير أو الخبراء المعينين مع تحديد التخصص، تحديد مهمة الخبير تحديدا دقيقا، تحديد أجل إيداع تقرير الخبرة بأمانة الضبط."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_129_condition_0_5297a319> a dznorm:Condition ;
