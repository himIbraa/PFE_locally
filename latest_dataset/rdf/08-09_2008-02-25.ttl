    dznorm:provisionText "ولهؤلاء حق طلب إلغاء قائمة شروط البيع عن طريق الاعتراض عليها، عند الاقتضاء، طبقا لأحكام هذا القانون"@ar ;
    dznorm:sourceArticle "art_785" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_786_condition_0_52ddab72> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/2008-02-25/08-09#art_786_condition_0_52ddab72_role_c7d5683ce2> ;
    dznorm:conditionText "إذا تقرر بحكم أو قرار قضائي بيع العقار و/أو الحق العيني العقاري المملوك على الشيوع لعدم إمكان القسمة بغير ضرر أو لتعذر القسمة عينا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_786> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_786_condition_0_52ddab72_role_c7d5683ce2> a dznorm:Role ;
    rdfs:label "الشيوع لعدم إمكان القسمة"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "إذا تقرر بحكم أو قرار قضائي بيع العقار و/أو الحق العيني العقاري المملوك على الشيوع لعدم إمكان القسمة بغير ضرر أو لتعذر القسمة عينا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_786> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_786_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_786> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا تقرر بحكم أو قرار قضائي بيع العقار و/أو الحق العيني العقاري المملوك على الشيوع لعدم إمكان القسمة بغير ضرر أو لتعذر القسمة عينا، بيع العقار عن طريق المزاد العلني بناء على قائمة شروط البيع، يعدها المحضر القضائي، وتودع بأمانة ضبط المحكمة التي يوجد فيها العقار، بناء على طلب من يهمه التعجيل من المالكين على الشيوع."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_786_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_786> ;
    dzdoc:position 1 ;
    dzdoc:text "تشتمل قائمة شروط البيع فضلا عن البيانات المذكورة في المادة 783 أعلاه، على ذكر جميع المالكين على الشيوع وموطن كل منهم، ويرفق بها فضلا عن الوثائق المذكورة في المادة 784 أعلاه، نسخة من الحكم أو القرار الصادر بإجراء البيع بالمزاد العلني."@ar .

