<https://legal.dz/resource/law/2008-02-25/08-09#version_art_591> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتضمن الحساب بيان الإيرادات والمصروفات الفعلية، ويختتم بموازنة تلك الإيرادات والمصروفات مع تخصيص باب للأموال المطلوب تحصيلها، ويرفق بالحساب جميع المستندات المثبتة ، و يقوم الملزم بالحساب بتقديمه والموافقة عليه إما شخصيا أو بواسطة وكيل خاص في الأجل المحدد ، و يبلغ طالبو الحساب بالحضور في اليوم الذي يحدده القاضي المنتدب ، ويكون هذا التبليغ إما شخصيا أو في الموطن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_591_20080225_OpEnact_e6f4862d34> ;
    dzdoc:replacementText "يتضمن الحساب بيان الإيرادات والمصروفات الفعلية، ويختتم بموازنة تلك الإيرادات والمصروفات مع تخصيص باب للأموال المطلوب تحصيلها، ويرفق بالحساب جميع المستندات المثبتة ، و يقوم الملزم بالحساب بتقديمه والموافقة عليه إما شخصيا أو بواسطة وكيل خاص في الأجل المحدد ، و يبلغ طالبو الحساب بالحضور في اليوم الذي يحدده القاضي المنتدب ، ويكون هذا التبليغ إما شخصيا أو في الموطن."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_591> ;
