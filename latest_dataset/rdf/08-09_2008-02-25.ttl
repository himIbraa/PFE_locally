<https://legal.dz/resource/law/2008-02-25/08-09#version_art_23> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتبادل الخصوم المستندات المودعة طبقا لـ المادة 22 أعلاه، أثناء الجلسة، أو خارجها بواسطة أمين الضبط . يمكن للقاضي، بناء على طلب أحد الخصوم، أن يأمر شفهيا بإبلاغ كل وثيقة عرضت عليه وثبت عدم إبلاغها للخصم الآخر ، ويحدد أجل وكيفية ذلك الإبلاغ. يمكن للقاضي أن يستبعد من المناقشة كل وثيقة لم يتم إبلاغها خلال الآجال، وبالكيفية التي حددها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_23_20080225_OpEnact_b5ff24c4c0> ;
    dzdoc:replacementText "يتبادل الخصوم المستندات المودعة طبقا لـ المادة 22 أعلاه، أثناء الجلسة، أو خارجها بواسطة أمين الضبط . يمكن للقاضي، بناء على طلب أحد الخصوم، أن يأمر شفهيا بإبلاغ كل وثيقة عرضت عليه وثبت عدم إبلاغها للخصم الآخر ، ويحدد أجل وكيفية ذلك الإبلاغ. يمكن للقاضي أن يستبعد من المناقشة كل وثيقة لم يتم إبلاغها خلال الآجال، وبالكيفية التي حددها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_23> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
