<https://legal.dz/resource/law/2008-02-25/08-09#version_art_173> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تغيب المدعى عليه ، رغم صحة تكليفه، أو إذا أنكر أو لم يتعرف على الخط أو التوقيع ، تتبع الإجراءات المنصوص عليها في المادة 165 وما يليها من هذا القانون."@ar ;
