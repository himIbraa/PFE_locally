    dzdoc:position 0 ;
    dzdoc:text "يخضع قبول الطلبات الجديدة لنفس القواعد المطبقة أمام الجهة القضائية التي أصدرت الحكم أو القرار المنقوض."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_36_obligation_0_e3ca36ab> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
