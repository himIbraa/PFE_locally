<https://legal.dz/resource/law/2008-02-25/08-09#version_art_540> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن تتضمن عريضة الاستئناف، تحت طائلة عدم قبولها شكلا ، البيانات الآتية : الجهة القضائية التي أصدرت الحكم المستأنف، اسم ولقب وموطن المستأنف، اسم ولقب وموطن المستأنف عليه وإن لم يكن له موطن معروف فآخر موطن له، عرض موجز للوقائع والطلبات والأوجه التي أسس عليها الاستئناف، الإشارة إلى طبيعة وتسمية الشخص المعنوي ومقره الاجتماعي وصفة ممثله القانوني أو الاتفاقي، ختم وتوقيع المحامي وعنوانه المهني، ما لم ينص القانون على خلاف ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_540_20080225_OpEnact_e465b1eb8a> ;
    dzdoc:replacementText "يجب أن تتضمن عريضة الاستئناف، تحت طائلة عدم قبولها شكلا ، البيانات الآتية : الجهة القضائية التي أصدرت الحكم المستأنف، اسم ولقب وموطن المستأنف، اسم ولقب وموطن المستأنف عليه وإن لم يكن له موطن معروف فآخر موطن له، عرض موجز للوقائع والطلبات والأوجه التي أسس عليها الاستئناف، الإشارة إلى طبيعة وتسمية الشخص المعنوي ومقره الاجتماعي وصفة ممثله القانوني أو الاتفاقي، ختم وتوقيع المحامي وعنوانه المهني، ما لم ينص القانون على خلاف ذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_540> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_540> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

