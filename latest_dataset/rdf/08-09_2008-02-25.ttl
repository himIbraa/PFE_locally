    dzdoc:position 0 ;
    dzdoc:text "ينظر القسم العقاري في الدعاوى المقدمة من طرف عضو أو أكثر من أعضاء المجموعة الفلاحية ضد عضو أو أكثر من تلك المجموعة بسبب خرق الالتزامات القانونية أو الاتفاقية."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_515_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_515> ;
