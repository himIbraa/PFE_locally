    dznorm:provisionText "يجب أن ينوه في كل محضر تنفيذ عن تاريخ وساعة بدايته وساعة نهايته"@ar ;
    dznorm:sourceArticle "art_629" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_629_obligation_1_039e10cd_action_7880244aba> a dznorm:Action ;
