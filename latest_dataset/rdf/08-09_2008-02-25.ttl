<https://legal.dz/resource/law/2008-02-25/08-09#version_art_721> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للدائن الحجز على العقارات و/أو الحقوق العينية العقارية لمدينه ، مفرزة كانت أو مشاعة ، إذا كان بيده سند تنفيذي وأثبت عدم كفاية الأموال المنقولة لمدينه أو عدم وجودها . غير أن الدائن المرتهن أو صاحب حق الامتياز الخاص على عقار أو صاحب حق التخصيص على عقار ، الذي بیده سندا تنفيذيا ، يجوز له الحجز على العقارات و/أو على الحقوق العينية العقارية لمدينه مباشرة حتى لو انتقلت ملكيتها إلى الغير ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_721_20080225_OpEnact_0adfd85e4a> ;
    dzdoc:replacementText "يجوز للدائن الحجز على العقارات و/أو الحقوق العينية العقارية لمدينه ، مفرزة كانت أو مشاعة ، إذا كان بيده سند تنفيذي وأثبت عدم كفاية الأموال المنقولة لمدينه أو عدم وجودها . غير أن الدائن المرتهن أو صاحب حق الامتياز الخاص على عقار أو صاحب حق التخصيص على عقار ، الذي بیده سندا تنفيذيا ، يجوز له الحجز على العقارات و/أو على الحقوق العينية العقارية لمدينه مباشرة حتى لو انتقلت ملكيتها إلى الغير ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_721> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_721> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
