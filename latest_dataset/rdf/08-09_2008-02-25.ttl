<https://legal.dz/resource/law/2008-02-25/08-09#art_240_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_240> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب التعبير عن القبول صراحة وبدون لبس، سواء أمام القاضي أو أمام المحضر القضائي أثناء التنفيذ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_241_condition_0_8ee615b4> a dznorm:Condition ;
    dznorm:conditionText "إذا كان له أو لزوجه مصلحة شخصية في النزاع"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_241> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_241_condition_1_264ec636> a dznorm:Condition ;
    dznorm:conditionText "إذا وجدت قرابة أو مصاهرة بينه أو بين زوجه وبين أحد الخصوم أو أحد المحامين أو وكلاء الخصوم، حتى الدرجة الرابعة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_241> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_241_condition_2_3acdddc0> a dznorm:Condition ;
    dznorm:conditionText "إذا كان له أو لزوجه أو أصولهما أو فروعهما خصومة سابقة أو قائمة مع أحد الخصوم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_241> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_241_condition_3_b1c04263> a dznorm:Condition ;
    dznorm:conditionText "إذا كان هو شخصيا أو زوجه أو أحد أصوله أو أحد فروعه، دائنا أو مدينا لأحد الخصوم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_241> ;
    dznorm:position 3 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_241_condition_4_15b68370> a dznorm:Condition ;
    dznorm:conditionText "إذا سبق له أن أدلى بشهادة في النزاع"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_241> ;
    dznorm:position 4 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_241_condition_5_6e1f4ca0> a dznorm:Condition ;
    dznorm:conditionText "إذا كان ممثلا قانونيا لأحد الخصوم في النزاع أو سبق له ذلك"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_241> ;
    dznorm:position 5 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_241_condition_6_333b089d> a dznorm:Condition ;
    dznorm:conditionText "إذا كان أحد الخصوم في خدمته"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_241> ;
    dznorm:position 6 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_241_condition_7_a6b3561b> a dznorm:Condition ;
    dznorm:conditionText "إذا كان بينه وبين أحد الخصوم علاقة صداقة حميمة، أو عداوة بينة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_241> ;
    dznorm:position 7 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_241_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_241> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز رد قاضي الحكم، ومساعد القاضي في الحالات الآتية : إذا كان له أو لزوجه مصلحة شخصية في النزاع، إذا وجدت قرابة أو مصاهرة بينه أو بين زوجه وبين أحد الخصوم أو أحد المحامين أو وكلاء الخصوم، حتى الدرجة الرابعة، إذا كان له أو لزوجه أو أصولهما أو فروعهما خصومة سابقة أو قائمة مع أحد الخصوم، إذا كان هو شخصيا أو زوجه أو أحد أصوله أو أحد فروعه، دائنا أو مدينا لأحد الخصوم، إذا سبق له أن أدلى بشهادة في النزاع، إذا كان ممثلا قانونيا لأحد الخصوم في النزاع أو سبق له ذلك، إذا كان أحد الخصوم في خدمته، إذا كان بينه وبين أحد الخصوم علاقة صداقة حميمة، أو عداوة بينة."@ar .

