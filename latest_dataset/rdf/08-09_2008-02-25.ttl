    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_397> ;
    dznorm:conditionText "لا يقبل التماس إعادة النظر، إلا إذا كانت العريضة مرفقة بوصل يثبت إيداع كفالة بأمانة ضبط الجهة القضائية، لا تقل عن الحد الأقصى للغرامة المنصوص عليها في المادة 397 أدناه."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_393> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_393_condition_0_09a6c2b5_ref_a78f49f01a31> a dzdoc:Reference ;
