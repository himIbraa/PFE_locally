<https://legal.dz/resource/law/2008-02-25/08-09#version_art_841> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبلغ نسخ الوثائق المرفقة للعرائض والمذكرات إلى الخصوم بنفس الأشكال المقررة لتبليغ المذكرات. عندما يحول عدد الوثائق أو حجمها أو خصائصها دون استخراج نسخ منها ، يبلغ جرد مفصل لها إلى الخصوم أو إلى ممثليهم، للإطلاع عليها بأمانة الضبط، وأخذ نسخ عنها على نفقتهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_841_20080225_OpEnact_f3a95f49b6> ;
    dzdoc:replacementText "تبلغ نسخ الوثائق المرفقة للعرائض والمذكرات إلى الخصوم بنفس الأشكال المقررة لتبليغ المذكرات. عندما يحول عدد الوثائق أو حجمها أو خصائصها دون استخراج نسخ منها ، يبلغ جرد مفصل لها إلى الخصوم أو إلى ممثليهم، للإطلاع عليها بأمانة الضبط، وأخذ نسخ عنها على نفقتهم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
