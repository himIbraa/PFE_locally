    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_692> ;
    dznorm:position 0 ;
    dznorm:provisionText "ويجب أن يتضمن محضر الحجز ، موقع البستان والأرض واسمهما ورقم المسح إن وجد ومساحة الأرض التقريبية وحدودها ونوع الثمار والمزروعات أو نوع الأشجار المثمرة وعددها والمقدار التقريبي لما يمكن أن يحصد أو يجنى أو ينتج منها وقيمته على وجه التقريب."@ar ;
    dznorm:sourceArticle "art_692" .

