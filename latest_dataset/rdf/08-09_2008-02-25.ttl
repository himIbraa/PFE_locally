    dznorm:sourceArticle "art_44" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_450_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_450> ;
    dzdoc:position 0 ;
    dzdoc:text "يتأكد القاضي من إرادة الزوج في طلب الطلاق، ويأمر باتخاذ كل التدابير التي يراها لازمة في ذلك."@ar .

