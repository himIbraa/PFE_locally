<https://legal.dz/resource/law/2008-02-25/08-09#version_art_133> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أراد أحد الخصوم رد الخبير المعين ، يقدم عريضة تتضمن أسباب الرد، توجه إلى القاضي الذي أمر بالخبرة خلال ثمانية (8) أيام من تاريخ تبليغه بهذا التعيين ، ويفصل دون تأخير في طلب الرد بأمر غير قابل لأي طعن. لا يقبل الرد إلا بسبب القرابة المباشرة أو القرابة غير المباشرة لغاية الدرجة الرابعة أو لوجود مصلحة شخصية أو لأي سبب جدي آخر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_133_20080225_OpEnact_1fe02a0cb8> ;
    dzdoc:replacementText "إذا أراد أحد الخصوم رد الخبير المعين ، يقدم عريضة تتضمن أسباب الرد، توجه إلى القاضي الذي أمر بالخبرة خلال ثمانية (8) أيام من تاريخ تبليغه بهذا التعيين ، ويفصل دون تأخير في طلب الرد بأمر غير قابل لأي طعن. لا يقبل الرد إلا بسبب القرابة المباشرة أو القرابة غير المباشرة لغاية الدرجة الرابعة أو لوجود مصلحة شخصية أو لأي سبب جدي آخر ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_133> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
