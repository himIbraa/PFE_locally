    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_614_condition_1_f5de0a3d> a dznorm:Condition ;
    dznorm:conditionText "إذا كان التنفيذ يتم بموجب حكم مشمول بالنفاذ المعجل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_614> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_614_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_614> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز إجراء التنفيذ الجبري بمجرد التبليغ الرسمي للتكليف بالوفاء بما تضمنه السند التنفيذي، دون مراعاة الآجال المنصوص عليها في المادة 612 أعلاه، فيما يأتي : إذا كان التنفيذ يتم بموجب أمر استعجالي، إذا كان التنفيذ يتم بموجب حكم مشمول بالنفاذ المعجل."@ar .

