<https://legal.dz/resource/law/2008-02-25/08-09#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#body> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "تمثيل الخصوم بمحام وجوبي أمام جهات الاستئناف والنقض ، ما لم ينص القانون على خلاف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_10_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_10_20080225_OpEnact_f5db130fa5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_10_obligation_0_107c0655> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "10" ;
    dzdoc:position 9 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1000> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_1000" ;
    dzdoc:fullText "بمجرد النطق بالأمر القاضي بتعيين الوسيط ، يقوم أمين الضبط بتبليغ نسخة منه للخصوم والوسيط. يخطر الوسيط القاضي بقبوله مهمة الوساطة دون تأخير، ويدعو الخصوم إلى أول لقاء للوساطة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1000> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1000_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1000_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1000_20080225_OpEnact_9d3ad6a37d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 1000" ;
    dzdoc:position 999 ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:mediation,
        dzterm:mediator .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1004> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:definesTerm dzterm:enforcement_title ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_1004" ;
    dzdoc:fullText "يقوم القاضي بالمصادقة على محضر الاتفاق بموجب أمر غير قابل لأي طعن، و يعد محضر الاتفاق سندا تنفيذيا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1004> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_1004_defocc_df78863dd57e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1004_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1004_20080225_OpEnact_504729909a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 1004" ;
    dzdoc:position 1003 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1011> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:definesTerm dzterm:arbitration_agreement ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_1_subsec_2> ;
    dzdoc:eId "art_1011" ;
    dzdoc:fullText "اتفاق التحكيم هو الاتفاق الذي يقبل الأطراف بموجبه عرض نزاع سبق نشوؤه على التحكيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1011> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_1011_defocc_fa844dd780ae> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1011_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1011_20080225_OpEnact_abe1296ee1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 1011" ;
    dzdoc:position 1010 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1017> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_1_subsec_3> ;
    dzdoc:eId "art_1017" ;
    dzdoc:fullText "تتشكل محكمة التحكيم من محكم أو عدة محكمين بعدد فردي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1017> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1017_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1017_20080225_OpEnact_ae39f7e04d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_1017_obligation_0_49608740> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "1017" ;
    dzdoc:position 1016 .

