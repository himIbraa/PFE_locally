<https://legal.dz/resource/law/2008-02-25/08-09#version_art_271> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم النطق بالحكم في الحال أو في تاريخ لاحق ، ويبلغ الخصوم بهذا التاريخ خلال الجلسة. في حالة التأجيل ، يجب أن يحدد تاريخ النطق بالحكم للجلسة الموالية . لا يجوز تمديد المداولة إلا إذا اقتضت الضرورة الملحة ذلك ، على ألا تتجاوز جلستين متتاليتين."@ar ;
