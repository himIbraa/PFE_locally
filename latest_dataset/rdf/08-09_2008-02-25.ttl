<https://legal.dz/resource/law/2008-02-25/08-09#version_art_848> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما تكون العريضة مشوبة بعيب يرتب عدم القبول، وتكون قابلة للتصحيح بعد فوات الأجل المنصوص عليه في المادة 829 أعلاه ، لا يجوز للمحكمة الإدارية أن ترفض هذه الطلبات وإثارة عدم القبول التلقائي إلا بعد دعوة المعنيين إلى تصحيحيها . يشار في أمر التصحيح، إلى أنه في حالة عدم القيام بهذا الإجراء، يمكن رفض الطلبات بعد انقضاء الأجل المحدد الذي لا يقل عن خمسة عشر (15) يوما، باستثناء حالة الاستعجال."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_848_20080225_OpEnact_fdfad0bd64> ;
    dzdoc:replacementText "عندما تكون العريضة مشوبة بعيب يرتب عدم القبول، وتكون قابلة للتصحيح بعد فوات الأجل المنصوص عليه في المادة 829 أعلاه ، لا يجوز للمحكمة الإدارية أن ترفض هذه الطلبات وإثارة عدم القبول التلقائي إلا بعد دعوة المعنيين إلى تصحيحيها . يشار في أمر التصحيح، إلى أنه في حالة عدم القيام بهذا الإجراء، يمكن رفض الطلبات بعد انقضاء الأجل المحدد الذي لا يقل عن خمسة عشر (15) يوما، باستثناء حالة الاستعجال."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_848> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
