<https://legal.dz/resource/law/2008-02-25/08-09#version_art_496> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ترفع دعوى إلغاء الكفالة أو التخلي عنها حسب قواعد الإجراءات العادية. ينظر في الدعوى في جلسة سرية، بعد سماع ممثل النيابة العامة في طلباته. يتم استئناف هذا الحكم حسب الإجراءات العادية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_496_20080225_OpEnact_c893dc11f6> ;
