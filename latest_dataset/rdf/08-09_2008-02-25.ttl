    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "ترفع المعارضة خلال أجل شهر واحد (1) من تاريخ التبليغ الرسمي للحكم أو القرار الغيابي ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_955_20080225_OpEnact_ecc1f55cd9> a dzdoc:ArticleVersion ;
