<https://legal.dz/resource/law/2008-02-25/08-09#version_art_441> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا استحال على أحد الزوجين الحضور في التاريخ المحدد أو حدث له مانع ، جاز للقاضي إما تحديد تاريخ لاحق للجلسة، أو ندب قاض آخر لسماعه بموجب إنابة قضائية. غیر أنه إذا تخلف أحد الزوجين عن حضور الجلسة المحددة للصلح بدون عذر رغم تبليغه شخصيا ، يحرر القاضي محضرا بذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_441_20080225_OpEnact_f91416894b> ;
    dzdoc:replacementText "إذا استحال على أحد الزوجين الحضور في التاريخ المحدد أو حدث له مانع ، جاز للقاضي إما تحديد تاريخ لاحق للجلسة، أو ندب قاض آخر لسماعه بموجب إنابة قضائية. غیر أنه إذا تخلف أحد الزوجين عن حضور الجلسة المحددة للصلح بدون عذر رغم تبليغه شخصيا ، يحرر القاضي محضرا بذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_441> ;
