    dzdoc:evidenceText "عندما لا يحترم أحد الخصوم الأجل الممنوح له لتقديم مذكرة أو ملاحظات ، يجوز لرئيس تشكيلة الحكم أن يوجه له إعذارا برسالة مضمنة مع الإشعار بالاستلام. في حالة القوة القاهرة أو الحادث الفجائي ، يجوز منح أجل جديد وأخير."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
