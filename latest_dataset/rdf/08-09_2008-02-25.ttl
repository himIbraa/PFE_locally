<https://legal.dz/resource/law/2008-02-25/08-09#art_1041> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_6_subsec_2> ;
    dzdoc:eId "art_1041" ;
    dzdoc:fullText "يمكن للأطراف، مباشرة أو بالرجوع إلى نظام التحكيم ، تعيين المحكم أو المحكمين أو تحديد شروط تعيينهم وشروط عزلهم أو استبدالهم . في غياب التعيين، وفي حالة صعوبة تعيين المحكمين أو عزلهم أو استبدالهم ، يجوز للطرف الذي يهمه التعجيل القيام بما يأتي : 1- رفع الأمر إلى رئيس المحكمة التي يقع في دائرة اختصاصها التحكيم إذا كان التحكيم يجري في الجزائر، 2- رفع الأمر إلى رئيس محكمة الجزائر، إذا كان التحكيم يجري في الخارج واختار الأطرف تطبيق قواعد الإجراءات المعمول بها في الجزائر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_1041_permission_0_c7ad7662>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1041_permission_1_abe620fa> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_1041_right_0_2fcdc3ea>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1041_right_1_c4be76f5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1041> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1041_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1041_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1041_20080225_OpEnact_22fcc5872d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 1041" ;
    dzdoc:position 1040 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_1041_condition_0_f6ede8f8> ;
    dzdoc:usesTerm dzterm:arbitration_system,
        dzterm:arbitrator,
        dzterm:arbitrators .

<https://legal.dz/resource/law/2008-02-25/08-09#art_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_1_sec_1> ;
    dzdoc:eId "art_13" ;
    dzdoc:fullText "لا يجوز لأي شخص، التقاضي ما لم تكن له صفة ، وله مصلحة قائمة أو محتملة يقرها القانون. يثير القاضي تلقائيا انعدام الصفة في المدعي أو في المدعى عليه. كما يثير تلقائيا انعدام الإذن إذا ما اشترطه القانون ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_13_permission_0_8107a30f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_13> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_13_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_13_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_13_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_13_20080225_OpEnact_739308aa1b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_13_obligation_0_8107a30f>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_13_obligation_1_9c02eb6f>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_13_obligation_2_27b1fb9b> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_13_prohibition_0_8107a30f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "13" ;
    dzdoc:position 12 ;
    dzdoc:usesTerm dzterm:إذن,
        dzterm:صفة,
        dzterm:مصلحة .

<https://legal.dz/resource/law/2008-02-25/08-09#art_140> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_8> ;
    dzdoc:eId "art_140" ;
    dzdoc:fullText "لا يجوز للخصوم بأي حال من الأحوال، أداء تسبيقات عن الأتعاب والمصاريف، مباشرة للخبير . يترتب على قبول الخبير ، المقيد في الجدول، هذه التسبيقات ، شطبه من قائمة الخبراء وبطلان الخبرة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_140_permission_0_4bf3d152> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_140> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_140_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_140_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_140_20080225_OpEnact_dc9dffdc53> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_140_obligation_0_5902c3dd>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_140_obligation_1_33079832> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_140_prohibition_0_4bf3d152> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 140" ;
    dzdoc:position 139 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_140_condition_0_ed1672ba> ;
    dzdoc:usesTerm dzterm:expert .

<https://legal.dz/resource/law/2008-02-25/08-09#art_149> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_9> ;
    dzdoc:eId "art_149" ;
    dzdoc:fullText "يحرر محضر عن الانتقال إلى الأماكن، يوقعه القاضي و أمين الضبط ، ويودع ضمن الأصول بأمانة الضبط . يمكن للخصوم الحصول على نسخ من هذا المحضر ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_149_permission_0_b0ad535f> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_149_right_0_84f856bc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_149> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_149_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_149_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_149_20080225_OpEnact_f9ad146095> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_149_obligation_0_91f231b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "149" ;
    dzdoc:position 148 ;
    dzdoc:usesTerm dzterm:clerk,
        dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_323> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_2> ;
    dzdoc:eId "art_323" ;
    dzdoc:fullText "يوقف تنفيذ الحكم خلال أجل الطعن العادي كما يوقف بسبب ممارسته. باستثناء الأحكام الواجبة التنفيذ بقوة القانون، يؤمر بالنفاذ المعجل، رغم المعارضة أو الاستئناف، عند طلبه في جميع الحالات التي يحكم فيها بناء على عقد رسمي أو وعد معترف به أو حكم سابق حاز قوة الشيء المقضي به، أو في مادة النفقة أو منح مسكن الزوجية لمن أسندت له الحضانة. يجوز للقاضي في جميع الأحوال الأخرى، أن يأمر في حالة الاستعجال بالنفاذ المعجل بكفالة أو بدون كفالة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_323_permission_0_2e720f58> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_323_right_0_2e720f58> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_323> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_323_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_323_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_323_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_323_20080225_OpEnact_2b53b07e9c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_323_obligation_0_70ccc895>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_323_obligation_1_a3d5af35> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "323" ;
    dzdoc:position 322 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_353> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_3_subsec_1> ;
    dzdoc:eId "art_353" ;
    dzdoc:fullText "لا يقبل الطعن بالنقض إلا إذا قدم من أحد الخصوم أو من ذوي الحقوق . غير أنه، إذا علم النائب العام لدى المحكمة العليا ، بصدور حكم أو قرار في آخر درجة من محكمة أو مجلس قضائي، وكان هذا الحكم أو القرار مخالفا للقانون، ولم يطعن فيه أحد الخصوم بالنقض في الأجل ، فله أن يعرض الأمر بعريضة بسيطة على المحكمة العليا . وفي حالة نقض هذا الحكم أو القرار، لا يجوز للخصوم التمسك بالقرار الصادر من المحكمة العليا للتخلص مما قضى به الحكم أو القرار المنقوض ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_353_permission_0_42b71911> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_353> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_353_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_353_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_353_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_353_20080225_OpEnact_7f0ac466f1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_353_obligation_0_bc906835> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_353_prohibition_0_42b71911> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "353" ;
    dzdoc:position 352 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_353_condition_0_6dcb6ccb>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_353_condition_1_ef244bce> ;
    dzdoc:usesTerm dzterm:prosecutor_general,
        dzterm:supreme_court .

<https://legal.dz/resource/law/2008-02-25/08-09#art_404> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_11_sec_1> ;
    dzdoc:eId "art_404" ;
    dzdoc:fullText "تمدد لمدة شهرين (2) أجال المعارضة و الاستئناف و التماس إعادة النظر و الطعن بالنقض المنصوص عليها في هذا القانون ، للأشخاص المقيمين خارج الإقليم الوطني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_404> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_404_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_404_20080225_OpEnact_a08243f0fa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_404_obligation_0_15c7f474> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 404" ;
    dzdoc:position 403 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_404_condition_0_290e0c6d> ;
    dzdoc:usesTerm dzterm:appeal,
        dzterm:cassation_appeal,
        dzterm:opposition,
        dzterm:petition_for_reconsideration .

<https://legal.dz/resource/law/2008-02-25/08-09#art_451> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_451" ;
    dzdoc:fullText "يعاين القاضي ويكيف الوقائع المعتمد عليها في تأسيس الأسباب المدعمة لطلب التطليق طبقا لأحكام قانون الأسرة . ويفصل في مدى تأسيس الطلب، آخذا بعين الاعتبار الظروف التي قدم فيها. يمكن للقاضي أن يتخذ كل التدابير التي يراها ملائمة، لا سيما الأمر بالتحقيق أو بخبرة طبية أو الانتقال للمعاينة. يتعين على القاضي تسبيب الإجراء المأمور به إذا تعلق بخبرة طبية . يعاين القاضي أيضا ويكيف الوقائع المعتمد عليها في طلب الخلع طبقا لأحكام قانون الأسرة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_451_permission_0_a2b04701> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_451> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_451_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_451_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_451_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_451_para_3>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_451_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_451_20080225_OpEnact_aeca04011e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_451_obligation_0_299ef02a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 451" ;
    dzdoc:position 450 ;
    dzdoc:usesTerm dzterm:family_law,
        dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_46> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_2_sec_4_subsec_3> ;
    dzdoc:eId "art_46" ;
    dzdoc:fullText "يجوز للخصوم الحضور باختيارهم أمام القاضي ، حتى ولو لم يكن مختصا إقليميا. يوقع الخصوم على تصريح بطلب التقاضي ، وإذا تعذر التوقيع يشار إلى ذلك. يكون القاضي مختصا طيلة الخصومة، ويمتد الاختصاص في حالة الاستئناف إلى المجلس القضائي التابع له."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_46_permission_0_63763c61> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_46_right_0_da9689fb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_46> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_46_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_46_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_46_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_46_20080225_OpEnact_972a38dde4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_46_obligation_0_e222ab99> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "46" ;
    dzdoc:position 45 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_640> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_1_subsec_2> ;
    dzdoc:eId "art_640" ;
    dzdoc:fullText "يجوز للمحجوز عليه أو من يمثله في أية حالة كانت عليها الإجراءات، قبل مباشرة البيع أو أثناءه وقبل رسو المزاد، إيداع مبلغ من النقود يساوي الدين المحجوز من أجله والمصاريف . يودع هذا المبلغ بين يدي المحضر القضائي أو بأمانة ضبط المحكمة التي يباشر في دائرة اختصاصها التنفيذ مقابل وصل . يترتب على هذا الإيداع زوال الحجز عن الأموال المحجوزة وانتقاله إلى المبلغ المودع الذي يبقى خالصا للدائن الحاجز دون مزاحمة بقية الدائنين له في ذلك. إذا وقعت حجوز أخرى على أموال المدين بعد الإيداع ، فلا يكون لها أثر في حق الدائن الذي خصص له هذا المبلغ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_640_permission_0_e1df08ff> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_640_right_0_82234bce> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_640> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_640_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_640_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_640_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_640_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_640_20080225_OpEnact_ec9344c434> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_640_obligation_0_371dcc7b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "640" ;
    dzdoc:position 639 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_640_condition_0_79d8e0ca> ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:judicial_bailiff .

<https://legal.dz/resource/law/2008-02-25/08-09#art_652> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_2_subsec_3> ;
    dzdoc:eId "art_652" ;
    dzdoc:fullText "يجوز للدائن أن يحجز تحفظيا على عقارات مدينه . يقيد أمر الحجز التحفظي على العقارات بالمحافظة العقارية التي يوجد بدائرة اختصاصها العقار خلال أجل خمسة عشر (15) يوما من تاريخ صدوره وإلا كان الحجز باطلا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_652_permission_0_2b692afb> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_652_right_0_ad96c176> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_652> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_652_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_652_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_652_20080225_OpEnact_b9d3e4057f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_652_obligation_0_aad040c6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "652" ;
    dzdoc:position 651 ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/law/2008-02-25/08-09#art_655> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_2_subsec_4> ;
    dzdoc:eId "art_655" ;
    dzdoc:fullText "يجوز ل المؤجر أن يحجز تحفظيا على المنقولات الموجودة بالمبنى أو المزرعة إذا نقلت من مكانها بغير رضاء المؤجر والتي له عليها حق الامتياز المنصوص عليه في القانون ، ما لم يكن قد مضى على نقلها مدة ستين (60) يوما ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_655_permission_0_171bc8ff> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_655_right_0_a2541ff6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_655> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_655_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_655_20080225_OpEnact_0d81cb4261> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "655" ;
    dzdoc:position 654 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_655_condition_0_dd8345f3>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_655_condition_1_a003a274> ;
    dzdoc:usesTerm dzterm:lessor .

<https://legal.dz/resource/law/2008-02-25/08-09#art_656> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_2_subsec_4> ;
    dzdoc:eId "art_656" ;
    dzdoc:fullText "يجوز ل المؤجر أن يحجز تحفظيا على منقولات المستأجرين الفرعيين للمباني أو الأراضي الزراعية أو الحقول أو البساتين الموجودة في الأمكنة التي يشغلونها . ويجوز أيضا الحجز تحفظيا على ثمار تلك الأراضي وفاء للأجرة المستحقة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_656_permission_0_33723501> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_656_right_0_4cdd6b22>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_656_right_1_705d38d2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_656> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_656_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_656_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_656_20080225_OpEnact_fe12a9d6f2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "656" ;
    dzdoc:position 655 ;
    dzdoc:usesTerm dzterm:lessor .

<https://legal.dz/resource/law/2008-02-25/08-09#art_669> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_3_subsec_1> ;
    dzdoc:eId "art_669" ;
    dzdoc:fullText "يبلغ أمر الحجز إلى الغير المحجوز لديه شخصيا إذا كان شخصا طبيعيا، وإذا كان شخصا معنويا يبلغ إلى الممثل القانوني، مع تسليمه نسخة من أمر الحجز والتنويه بذلك في المحضر. يقوم المحضر القضائي على الفور بجرد الأموال المراد حجزها وتعيينها تعيينا دقيقا في محضر الحجز والجرد، ويعين المحجوز لديه حارسا عليها وعلى ثمارها ، إلا إذا فضل هذا الأخير تسليمها للمحضر القضائي فينوه في هذه الحالة عن ذلك في المحضر . يجب أن ينوه في محضر الحجز على إعذار المحجوز لديه بعدم التخلي عن الأموال المحجوزة وعدم تسليمها إلى المدين أو غيره، إلا بصدور أمر مخالف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_669> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_669_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_669_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_669_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_669_20080225_OpEnact_02e4fff35d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_669_obligation_0_e0ffac15>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_669_obligation_1_dcc97217>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_669_obligation_2_a201db93> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "669" ;
    dzdoc:position 668 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_669_condition_0_87d1da51> ;
    dzdoc:usesTerm dzterm:judicial_bailiff,
        dzterm:order_seizure,
        dzterm:third_party_garnishee .

<https://legal.dz/resource/law/2008-02-25/08-09#art_713> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_4_subsec_6> ;
    dzdoc:eId "art_713" ;
    dzdoc:fullText "يرسو المزاد على الشيء المباع لمن تقدم بأعلى عرض و لا يسلم له الشيء المباع إلا بعد دفع ثمنه . إذا نتج عن بيع جزء من الأموال المحجوزة مبلغ كاف للوفاء بالديون المحجوز من أجلها والمصاريف ، يتوقف المحضر القضائي أو محافظ البيع عن المضي في بيع باقي المحجوزات ، و يرفع الحجز عنها بقوة القانون . إذا لم يدفع الراسي عليه المزاد ثمن الشيء المباع فورا أو في الأجل المحدد في شروط البيع ، وجب إعادة البيع بالمزاد على نفقته بأي ثمن ، و يلزم بفرق الثمن بين الذي عرضه وثمن إعادة البيع وليس له الحق في طلب الزيادة في الثمن إذا بيع بثمن أعلى."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_713_right_0_81a9be0c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_713> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_713_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_713_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_713_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_713_20080225_OpEnact_d2cdb698c4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_713_obligation_0_0f5b97e1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_713_obligation_1_bbe32e5b>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_713_obligation_2_f9039671>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_713_obligation_3_49302658> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "713" ;
    dzdoc:position 712 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_713_condition_0_a7166461>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_713_condition_1_f052353e> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_742> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_5_subsec_8> ;
    dzdoc:eId "art_742" ;
    dzdoc:fullText "تقدم الاعتراضات بعريضة من طرف الأشخاص المشار إليهم في المادة 740 أعلاه، أو من ورثتهم إلى رئيس المحكمة ، قبل جلسة الاعتراضات بثلاثة (3) أيام على الأقل ، وإلا سقط حقهم في التمسك بها. تسجل العريضة في سجل خاص بعد دفع الرسوم حسب تاریخ ورودها، وتعقد جلسة الاعتراضات في غرفة المشورة بحضور المعترض والحاجز و المحضر القضائي . يفصل رئيس المحكمة في الاعتراضات، بأمر غير قابل لأي طعن في أجل أقصاه ثمانية (8) أيام . إذا لم يقدم أي اعتراض بالجلسة ، يؤشر أمين الضبط بذلك في السجل الخاص به، ويشرع المحضر القضائي في إجراءات الإعلان عن البيع بالمزاد العلني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_742> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_742_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_742_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_742_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_742_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_742_20080225_OpEnact_54310b2ca8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_742_obligation_0_853db6e4>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_742_obligation_1_0dfdb651> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "742" ;
    dzdoc:position 741 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_740> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_740> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_742_condition_0_bbbe46c3> ;
    dzdoc:usesTerm dzterm:huissier_justice,
        dzterm:president_tribunal .

<https://legal.dz/resource/law/2008-02-25/08-09#art_912> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_2_sec_2_subsec_3> ;
    dzdoc:eId "art_912" ;
    dzdoc:fullText "عندما يتم استئناف حكم صادر عن المحكمة الإدارية قضى برفض الطعن لتجاوز السلطة لقرار إداري ، يجوز ل مجلس الدولة أن يأمر بوقف التنفيذ بطلب من المستأنف عندما يكون تنفيذ القرار الإداري المطعون فيه من شأنه إحداث عواقب يصعب تداركها، وعندما تبدو الأوجه المثارة في العريضة من خلال ما توصل إليه التحقيق جدية، ومن شأنها تبرير إلغاء القرار الإداري المطعون فيه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_912_permission_0_0f31aa18> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_912_right_0_31cdcd93> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_912> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_912_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_912_20080225_OpEnact_d3fd3917ca> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 912" ;
    dzdoc:position 911 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_912_condition_0_770cf5c0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_912_condition_1_ea4479ef> ;
    dzdoc:usesTerm dzterm:administrative_court,
        dzterm:council_of_state .

<https://legal.dz/resource/law/2008-02-25/08-09#art_914> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_914" ;
    dzdoc:fullText "عندما يتم استئناف حكم صادر عن المحكمة الإدارية قضى بإلغاء قرار إداري لتجاوز السلطة، يجوز ل مجلس الدولة ، بناء على طلب المستأنف، أن يأمر بوقف تنفيذ هذا الحكم متى كانت أوجه الاستئناف تبدو من التحقيق جدية ومن شأنها أن تؤدي فضلا عن إلغاء الحكم المطعون فيه أو تعديله، إلى رفض الطلبات الرامية إلى الإلغاء من أجل تجاوز السلطة الذي قضى به الحكم . في جميع الحالات المنصوص عليها في الفقرة أعلاه وفي المادة 912 من هذا القانون يجوز ل مجلس الدولة ، في أي وقت أن يرفع حالة وقف التنفيذ، بناء على طلب من يهمه الأمر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_914_permission_0_7b994765>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_914_permission_1_a19c56e6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_914> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_914_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_914_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_914_20080225_OpEnact_5be532ef37> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 914" ;
    dzdoc:position 913 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_912> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_912> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_914_condition_0_b9ea3bfe> ;
    dzdoc:usesTerm dzterm:administrative_court,
        dzterm:council_of_state .

<https://legal.dz/resource/law/2008-02-25/08-09#art_921> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_921" ;
    dzdoc:fullText "في حالة الاستعجال القصوى يجوز لـ قاضي الاستعجال ، أن يأمر بكل التدابير الضرورية الأخرى، دون عرقلة تنفيذ أي قرار إداري، بموجب أمر على عريضة ولو في غياب القرار الإداري المسبق. وفي حالة التعدي أو الاستيلاء أو الغلق الإداري ، يمكن أيضا لـ قاضي الاستعجال أن يأمر بوقف تنفيذ القرار الإداري المطعون فيه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_921_permission_0_3e75d76c>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_921_permission_1_6abddc32> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_921> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_921_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_921_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_921_20080225_OpEnact_b652fc10ec> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "921" ;
    dzdoc:position 920 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_921_condition_0_a5455f7e>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_921_condition_1_8b8e3595> ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_931> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_931" ;
    dzdoc:fullText "يختتم التحقيق بانتهاء الجلسة، ما لم يقرر قاضي الاستعجال تأجيل اختتامه إلى تاريخ لاحق ويخطر به الخصوم بكل الوسائل. في الحالة الأخيرة يجوز أن توجه المذكرات والوثائق الإضافية المقدمة بعد الجلسة وقبل اختتام التحقيق ومباشرة إلى الخصوم الآخرين عن طريق محضر قضائي، بشرط أن يقدم الخصم المعني الدليل عما قام به أمام القاضي . يفتتح التحقيق من جديد في حالة التأجيل إلى جلسة أخرى."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_931_permission_0_a9c19347> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_931> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_931_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_931_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_931_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_931_20080225_OpEnact_d70c88d78d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "931" ;
    dzdoc:position 930 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_931_condition_0_542363f0> ;
    dzdoc:usesTerm dzterm:judge .

