    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_796> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_796_obligation_1_4247cb36> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
