<https://legal.dz/resource/law/2008-02-25/08-09#version_art_711> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان الطلب الثاني للحجز يتجاوز في مقداره الحجز الأول ، يجري توحيد الحجزين، إلا إذا كانت الأموال المحجوزة في الحجز الأول قد بيعت ، وفي هذه الحالة يعتبر الحجز الثاني بمثابة اعتراض على المتحصل من البيع، ويترتب عليه إجراء التوزيع بين الدائنين كل بنسبة دينه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
