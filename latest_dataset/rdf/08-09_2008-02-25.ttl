<https://legal.dz/resource/law/2008-02-25/08-09#version_art_766> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للدائن وفقا لأحكام المادة 721 أعلاه ، الحجز على عقارات مدينه غير المشهرة، إذا كان لها مقرر إداري أو سند عرفي ثابت التاريخ وفقا لأحكام القانون المدني . تتم إجراءات الحجز في هذه الحالة وفقا للمادتين 722 و 723 أعلاه، ويرفق مع طلب الحجز : نسخة من السند التنفيذي المتضمن مبلغ الدين، محضر عدم كفاية الأموال المنقولة أو عدم وجودها، مستخرج من السند العرفي أو المقرر الإداري للعقار المراد حجزه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_766_20080225_OpEnact_99925e1ea5> ;
    dzdoc:replacementText "يجوز للدائن وفقا لأحكام المادة 721 أعلاه ، الحجز على عقارات مدينه غير المشهرة، إذا كان لها مقرر إداري أو سند عرفي ثابت التاريخ وفقا لأحكام القانون المدني . تتم إجراءات الحجز في هذه الحالة وفقا للمادتين 722 و 723 أعلاه، ويرفق مع طلب الحجز : نسخة من السند التنفيذي المتضمن مبلغ الدين، محضر عدم كفاية الأموال المنقولة أو عدم وجودها، مستخرج من السند العرفي أو المقرر الإداري للعقار المراد حجزه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_766> ;
