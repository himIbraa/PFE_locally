<https://legal.dz/resource/law/2008-02-25/08-09#version_art_720> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تباع القيم المنقولة و الأسهم بواسطة أحد البنوك أو أية مؤسسة مؤهلة قانونا، تعين من طرف رئيس المحكمة بأمر على عريضة، بناء على طلب الدائن الحاجز ، يبين في الأمر ما يلزم اتخاذه من إجراءات النشر والتعليق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_720_20080225_OpEnact_5d2d8f39bf> ;
    dzdoc:replacementText "تباع القيم المنقولة و الأسهم بواسطة أحد البنوك أو أية مؤسسة مؤهلة قانونا، تعين من طرف رئيس المحكمة بأمر على عريضة، بناء على طلب الدائن الحاجز ، يبين في الأمر ما يلزم اتخاذه من إجراءات النشر والتعليق."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_720> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
