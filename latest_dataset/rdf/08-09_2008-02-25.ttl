    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "تطبق الأحكام المتعلقة بأوجه النقض المنصوص عليها في المادة 358 من هذا القانون أمام مجلس الدولة ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_95_20080225_OpEnact_e97431dde3> a dzdoc:ArticleVersion ;
