    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يخضع بطلان إجراءات التنفيذ المتعلقة بـ تدابير التحقيق للقواعد المقررة لـ بطلان الأعمال الإجرائية ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_960_20080225_OpEnact_bcf0867a51> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_960> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-02-25/08-09#art_960> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_960> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يهدف اعتراض الغير الخارج عن الخصومة إلى مراجعة أو إلغاء الحكم أو القرار الذي فصل في أصل النزاع. ويفصل في القضية من جديد من حيث الوقائع والقانون."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_961_20080225_OpEnact_0ec5241f01> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
