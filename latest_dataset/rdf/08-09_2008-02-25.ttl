<https://legal.dz/resource/law/2008-02-25/08-09#version_art_1002> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن للقاضي في أي وقت إنهاء الوساطة ، بطلب من الوسيط أو من الخصوم. يمكن للقاضي إنهاء الوساطة تلقائيا عندما يتبين له استحالة السير الحسن لها . وفي جميع الحالات، ترجع القضية إلى الجلسة، ويستدعى الوسيط والخصوم إليها عن طريق أمين الضبط."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1002_20080225_OpEnact_221fcac429> ;
    dzdoc:replacementText "يمكن للقاضي في أي وقت إنهاء الوساطة ، بطلب من الوسيط أو من الخصوم. يمكن للقاضي إنهاء الوساطة تلقائيا عندما يتبين له استحالة السير الحسن لها . وفي جميع الحالات، ترجع القضية إلى الجلسة، ويستدعى الوسيط والخصوم إليها عن طريق أمين الضبط."@ar ;
    dzdoc:resolutionStatus "resolved" ;
