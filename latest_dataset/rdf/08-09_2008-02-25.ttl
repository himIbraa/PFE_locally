        dzdoc:LegalTerm ;
    skos:prefLabel "قاضي شؤون الأسرة"@ar .

dzterm:judicial_council a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المجلس القضائي"@ar .

dzterm:lawsuit a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الدعوى"@ar,
        "الدعوى الأصلية"@ar,
        "دعوى الاعتراف بالنسب، بالبنوة أو بالأبوة أو بالأمومة لشخص مجهول النسب أو إنكار الأبوة"@ar .

dzterm:lawyer a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المحامي"@ar,
        "محام"@ar,
        "محام معتمد لدى المحكمة العليا"@ar .

dzterm:mutual_consent_divorce a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الطلاق بالتراضي"@ar,
        "الطلاق بالتراضي هو إجراء يرمي إلى حل الرابطة الزوجية بإرادة الزوجين المشتركة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_427_defocc_a804f6de5200> .

dzterm:president_section_immobilier a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "رئيس القسم العقاري"@ar,
