<https://legal.dz/resource/law/2008-02-25/08-09#art_678_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_678> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا توفي المحجوز لديه أو فقد أهليته أو زالت صفته أو زالت صفة من يمثله، وجب على الحاجز أن يبلغ نسخة من محضر وأمر الحجز إلى ورثة المحجوز لديه أو إلى ممثلهم الاتفاقي أو القانوني، ويكلفهم بتقديم تصريح بما في حيازتهم، إن لم يكن تم إعداده من قبل خلال أجل أقصاه عشرة (10) أيام من تاريخ التبليغ الرسمي."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_679_condition_0_1365c722> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2008-02-25/08-09#art_679_condition_0_1365c722_ref_32aaf7a438e6> ;
