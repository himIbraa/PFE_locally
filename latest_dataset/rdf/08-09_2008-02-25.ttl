<https://legal.dz/resource/law/2008-02-25/08-09#version_art_404> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تمدد لمدة شهرين (2) أجال المعارضة و الاستئناف و التماس إعادة النظر و الطعن بالنقض المنصوص عليها في هذا القانون ، للأشخاص المقيمين خارج الإقليم الوطني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_404_20080225_OpEnact_a08243f0fa> ;
    dzdoc:replacementText "تمدد لمدة شهرين (2) أجال المعارضة و الاستئناف و التماس إعادة النظر و الطعن بالنقض المنصوص عليها في هذا القانون ، للأشخاص المقيمين خارج الإقليم الوطني ."@ar ;
