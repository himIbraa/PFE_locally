<https://legal.dz/resource/law/2008-02-25/08-09#version_art_878> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب تقديم طلب الرد قبل إقفال باب المناقشة. ويجب أن يتضمن الطلب تحت طائلة عدم القبول الإشارة إلى أسباب الرد المنصوص عليها في المادة 241 من هذا القانون، ويرفق بالوثائق المبررة له، عند الاقتضاء. يجب أيضا على القاضي الذي يعلم أنه في وضعية تجعله قابلا للرد بمفهوم المادة 241 من هذا القانون، أن يقدم طلبا لرئيس الجهة القضائية الإدارية التابع لها بغرض استبداله."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_878_20080225_OpEnact_839e892a88> ;
    dzdoc:replacementText "يجب تقديم طلب الرد قبل إقفال باب المناقشة. ويجب أن يتضمن الطلب تحت طائلة عدم القبول الإشارة إلى أسباب الرد المنصوص عليها في المادة 241 من هذا القانون، ويرفق بالوثائق المبررة له، عند الاقتضاء. يجب أيضا على القاضي الذي يعلم أنه في وضعية تجعله قابلا للرد بمفهوم المادة 241 من هذا القانون، أن يقدم طلبا لرئيس الجهة القضائية الإدارية التابع لها بغرض استبداله."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_878> ;
