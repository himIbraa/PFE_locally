<https://legal.dz/resource/law/2008-02-25/08-09#art_393_condition_0_09a6c2b5> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2008-02-25/08-09#art_393_condition_0_09a6c2b5_ref_a78f49f01a31> ;
