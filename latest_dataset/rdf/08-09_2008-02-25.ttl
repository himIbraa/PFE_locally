<https://legal.dz/resource/law/2008-02-25/08-09#version_art_996> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن أن تتجاوز مدة الوساطة ثلاثة (3) أشهر. ويمكن تجديدها لنفس المدة مرة واحدة بطلب من الوسيط عند الاقتضاء، بعد موافقة الخصوم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_996_20080225_OpEnact_e2952c403b> ;
    dzdoc:replacementText "لا يمكن أن تتجاوز مدة الوساطة ثلاثة (3) أشهر. ويمكن تجديدها لنفس المدة مرة واحدة بطلب من الوسيط عند الاقتضاء، بعد موافقة الخصوم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_996> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
