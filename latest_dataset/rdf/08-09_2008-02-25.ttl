<https://legal.dz/resource/law/2008-02-25/08-09#art_687_condition_0_8aff6b91_ref_5357a277577c> a dzdoc:Reference ;
    rdfs:label "المادة 612"@ar ;
    dzdoc:frbrUri "#art_612"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2008-02-25/08-09#art_612> ;
    dzdoc:sourceEId "art_687" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "إذا لم يقم المدين بالوفاء بعد انقضاء أجل خمسة عشر (15) يوما من تاريخ تكليفه بالوفاء وفقا لالمادة 612 أعلاه"@ar ;
    dzdoc:targetEId "art_612" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_687_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_687> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا لم يقم المدين بالوفاء بعد انقضاء أجل خمسة عشر (15) يوما من تاريخ تكليفه بالوفاء وفقا لالمادة 612 أعلاه، يجوز للمستفيد من السند التنفيذي، الحجز على جميع المنقولات و/أو الأسهم و/أو حصص الأرباح في الشركات و/أو السندات المالية للمدين."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_687_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_687> ;
    dzdoc:position 1 ;
    dzdoc:text "يتم الحجز بأمر على عريضة يصدره رئيس المحكمة التي توجد في دائرة اختصاصها الأموال المراد حجزها، وعند الاقتضاء، في موطن المدين، وذلك بناء على طلب الدائن أو ممثله القانوني أو الاتفاقي."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_687_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_687> ;
    dzdoc:position 2 ;
    dzdoc:text "يمكن الاستعانة بالقوة العمومية لتنفيذ أمر الحجز عند الاقتضاء."@ar .

