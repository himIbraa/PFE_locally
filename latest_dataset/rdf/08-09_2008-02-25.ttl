<https://legal.dz/resource/law/2008-02-25/08-09#version_art_471> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعين القاضي المقدم بموجب أمر ولائي بعد التأكد من رضائه. يجب على المقدم أن يقدم دوريا وطبقا لما يحدده القاضي، عرضا عن إدارة أموال القاصر وعن أي إشكال أو طارئ له علاقة بهذه الإدارة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_471_20080225_OpEnact_1f42f911d3> ;
    dzdoc:replacementText "يعين القاضي المقدم بموجب أمر ولائي بعد التأكد من رضائه. يجب على المقدم أن يقدم دوريا وطبقا لما يحدده القاضي، عرضا عن إدارة أموال القاصر وعن أي إشكال أو طارئ له علاقة بهذه الإدارة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_471> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
