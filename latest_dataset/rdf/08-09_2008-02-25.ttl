<https://legal.dz/resource/law/2008-02-25/08-09#version_art_690> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يبلغ أمر الحجز أو بلغ ولم يتم الحجز في أجل شهرين (2) من تاريخ صدوره ، اعتبر الأمر لاغيا بقوة القانون . يمكن تجديد طلب الحجز بعد هذا الأجل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_690_20080225_OpEnact_747025e0dd> ;
    dzdoc:replacementText "إذا لم يبلغ أمر الحجز أو بلغ ولم يتم الحجز في أجل شهرين (2) من تاريخ صدوره ، اعتبر الأمر لاغيا بقوة القانون . يمكن تجديد طلب الحجز بعد هذا الأجل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
