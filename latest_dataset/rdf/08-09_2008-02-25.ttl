<https://legal.dz/resource/law/2008-02-25/08-09#version_art_1024> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينتهي التحكيم : بوفاة أحد المحكمين أو رفضه القيام بمهمته بمبرر أو تنحيته أو حصول مانع له، ما لم يوجد شرط مخالف، أو إذا اتفق الأطراف على استبداله أو استبداله من قبل المحكم أو المحكمين الباقين. وفي حالة غياب الاتفاق تطبق أحكام المادة 1009 أعلاه، بانتهاء المدة المقررة للتحكيم، فإذا لم تشترط المدة، فبانتهاء مدة أربعة (4) أشهر، بفقد الشيء موضوع النزاع أو انقضاء الدين المتنازع فيه، بوفاة أحد أطراف العقد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1024_20080225_OpEnact_7f85eb720f> ;
    dzdoc:replacementText "ينتهي التحكيم : بوفاة أحد المحكمين أو رفضه القيام بمهمته بمبرر أو تنحيته أو حصول مانع له، ما لم يوجد شرط مخالف، أو إذا اتفق الأطراف على استبداله أو استبداله من قبل المحكم أو المحكمين الباقين. وفي حالة غياب الاتفاق تطبق أحكام المادة 1009 أعلاه، بانتهاء المدة المقررة للتحكيم، فإذا لم تشترط المدة، فبانتهاء مدة أربعة (4) أشهر، بفقد الشيء موضوع النزاع أو انقضاء الدين المتنازع فيه، بوفاة أحد أطراف العقد."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_1024> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
