<https://legal.dz/resource/law/2008-02-25/08-09#version_art_278> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوقع على أصل الحكم الرئيس وأمين الضبط والقاضي المقرر عند الاقتضاء ، ويحفظ أصل الحكم في أرشيف الجهة القضائية. يحفظ أيضا ملف القضية في أرشيف الجهة القضائية. يستعيد الخصوم الوثائق المملوكة لهم ، بناء على طلبهم مقابل وصل بالاستلام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_278_20080225_OpEnact_62150b76ff> ;
    dzdoc:replacementText "يوقع على أصل الحكم الرئيس وأمين الضبط والقاضي المقرر عند الاقتضاء ، ويحفظ أصل الحكم في أرشيف الجهة القضائية. يحفظ أيضا ملف القضية في أرشيف الجهة القضائية. يستعيد الخصوم الوثائق المملوكة لهم ، بناء على طلبهم مقابل وصل بالاستلام."@ar ;
