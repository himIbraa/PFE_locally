<https://legal.dz/resource/law/2008-02-25/08-09#art_620_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_620> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم التنفيذ على الأموال المنقولة، فإن كان مقدارها لا يغطي الدين والمصاريف، انتقل التنفيذ إلى العقارات."@ar .

