    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_962> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يجرى التحقيق في اعتراض الغير الخارج عن الخصومة بنفس الأشكال المتعلقة بالعريضة المنصوص عليها في المادة 815 وما يليها من هذا القانون."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_963_20080225_OpEnact_7206ca8e01> a dzdoc:ArticleVersion ;
