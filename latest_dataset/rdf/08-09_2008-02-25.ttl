<https://legal.dz/resource/law/2008-02-25/08-09#version_art_836> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في جميع الأحوال، تفصل التشكيلة التي تنظر في الموضوع في الطلبات الرامية إلى وقف التنفيذ بأمر مسبب . ينتهي أثر وقف التنفيذ بالفصل في دعوى الموضوع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_836_20080225_OpEnact_1fb7dd3ffd> ;
    dzdoc:replacementText "في جميع الأحوال، تفصل التشكيلة التي تنظر في الموضوع في الطلبات الرامية إلى وقف التنفيذ بأمر مسبب . ينتهي أثر وقف التنفيذ بالفصل في دعوى الموضوع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_836> ;
