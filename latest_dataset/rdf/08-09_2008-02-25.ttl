    dzdoc:position 1 ;
    dzdoc:text "يفصل في القضية من جديد من حيث الوقائع والقانون."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_381_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_381> ;
