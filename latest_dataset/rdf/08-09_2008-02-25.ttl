<https://legal.dz/resource/law/2008-02-25/08-09#version_art_760> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا بيع العقار و/أو الحق العيني العقاري بثمن أقل من الثمن الأساسي المحدد في قائمة شروط البيع ، يجوز لكل شخص في أجل ثمانية (8) أيام التالية لتاريخ حكم رسو المزاد، تقديم عريضة موقعة منه، يطلب فيها إعادة البيع بالمزاد العلني . في هذه الحالة، يتعهد المزايد الجديد بزيادة السدس (6/1) عن الثمن الراسي به المزاد على الأقل، مع إيداعه الثمن الكامل مع المصاريف القضائية والرسوم المستحقة بأمانة الضبط مقابل وصل ويعاد البيع بالمزاد العلني بنفس الكيفيات المنصوص عليها في المواد من 749 إلى 757 أعلاه، ويتحمل طالب ت"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_760_20080225_OpEnact_960d38baef> ;
    dzdoc:replacementText "إذا بيع العقار و/أو الحق العيني العقاري بثمن أقل من الثمن الأساسي المحدد في قائمة شروط البيع ، يجوز لكل شخص في أجل ثمانية (8) أيام التالية لتاريخ حكم رسو المزاد، تقديم عريضة موقعة منه، يطلب فيها إعادة البيع بالمزاد العلني . في هذه الحالة، يتعهد المزايد الجديد بزيادة السدس (6/1) عن الثمن الراسي به المزاد على الأقل، مع إيداعه الثمن الكامل مع المصاريف القضائية والرسوم المستحقة بأمانة الضبط مقابل وصل ويعاد البيع بالمزاد العلني بنفس الكيفيات المنصوص عليها في المواد من 749 إلى 757 أعلاه، ويتحمل طالب تجديد البيع بالمزاد العلني جميع النفقات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_760> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
