<https://legal.dz/resource/law/2008-02-25/08-09#version_art_1058> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن يكون حكم التحكيم الدولي الصادر في الجزائر موضوع طعن بالبطلان في الحالات المنصوص عليها في المادة 1056 أعلاه . لا يقبل الأمر الذي يقضي بتنفيذ حكم التحكيم الدولي المشار إليه أعلاه أي طعن غير أن الطعن ببطلان حكم التحكيم يرتب بقوة القانون الطعن في أمر التنفيذ أو تخلي المحكمة عن الفصل في طلب التنفيذ، إذا لم يتم الفصل فيه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1058_20080225_OpEnact_f04bd1c3f2> ;
    dzdoc:replacementText "يمكن أن يكون حكم التحكيم الدولي الصادر في الجزائر موضوع طعن بالبطلان في الحالات المنصوص عليها في المادة 1056 أعلاه . لا يقبل الأمر الذي يقضي بتنفيذ حكم التحكيم الدولي المشار إليه أعلاه أي طعن غير أن الطعن ببطلان حكم التحكيم يرتب بقوة القانون الطعن في أمر التنفيذ أو تخلي المحكمة عن الفصل في طلب التنفيذ، إذا لم يتم الفصل فيه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
