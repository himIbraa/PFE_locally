<https://legal.dz/resource/law/2008-02-25/08-09#version_art_191> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد القاضي اليوم والساعة والمكان الذي تؤدى فيه اليمين . يحدد القاضي الصيغة التي تؤدى بها اليمين ، وينبه الخصوم إلى ما يترتب من عقوبات جزائية على اليمين الكاذبة ."@ar ;
