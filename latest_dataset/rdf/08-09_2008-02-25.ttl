<https://legal.dz/resource/law/2008-02-25/08-09#version_art_333> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون الأحكام الصادرة في جميع المواد قابلة للإستئناف ، عندما تفصل في موضوع النزاع أو في دفع شكلي أو في دفع بعدم القبول أو أي دفع عارض آخر ينهي الخصومة ، ما لم ينص القانون على خلاف ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_333_20080225_OpEnact_9c903c2fd0> ;
    dzdoc:replacementText "تكون الأحكام الصادرة في جميع المواد قابلة للإستئناف ، عندما تفصل في موضوع النزاع أو في دفع شكلي أو في دفع بعدم القبول أو أي دفع عارض آخر ينهي الخصومة ، ما لم ينص القانون على خلاف ذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_333> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_333> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_334> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الأحكام الفاصلة في جزء من موضوع النزاع أو التي تأمر بالقيام بإجراء من إجراءات التحقيق أو تدبير مؤقت، لا تقبل الاستئناف إلا مع الحكم الفاصل في أصل الدعوى برمتها، ما لم ينص القانون على خلاف ذلك. يتم الاستئناف في الحكم الصادر قبل الفصل في الموضوع والحكم الفاصل في موضوع الدعوى بموجب نفس عريضة الاستئناف. يترتب على عدم قبول استئناف الحكم الفاصل في موضوع الدعوى عدم قبول استئناف الحكم الصادر قبل الفصل في الموضوع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_334_20080225_OpEnact_0d019c0c71> ;
    dzdoc:replacementText "الأحكام الفاصلة في جزء من موضوع النزاع أو التي تأمر بالقيام بإجراء من إجراءات التحقيق أو تدبير مؤقت، لا تقبل الاستئناف إلا مع الحكم الفاصل في أصل الدعوى برمتها، ما لم ينص القانون على خلاف ذلك. يتم الاستئناف في الحكم الصادر قبل الفصل في الموضوع والحكم الفاصل في موضوع الدعوى بموجب نفس عريضة الاستئناف. يترتب على عدم قبول استئناف الحكم الفاصل في موضوع الدعوى عدم قبول استئناف الحكم الصادر قبل الفصل في الموضوع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_334> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_334> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_335> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "حق الاستئناف مقرر لجميع الأشخاص الذين كانوا خصوما على مستوى الدرجة الأولى أو لذوي حقوقهم . كما يحق للأشخاص الذين تم تمثيلهم على مستوى الدرجة الأولى، بسبب نقص الأهلية، ممارسة الاستئناف إذا زال سبب ذلك . ويجوز رفع الاستئناف من طرف المتدخل الأصلي أو المدخل في الخصام في الدرجة الأولى. يجب أن تتوفر المصلحة في المستأنف لممارسة الاستئناف ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_335_20080225_OpEnact_ac5664b533> ;
    dzdoc:replacementText "حق الاستئناف مقرر لجميع الأشخاص الذين كانوا خصوما على مستوى الدرجة الأولى أو لذوي حقوقهم . كما يحق للأشخاص الذين تم تمثيلهم على مستوى الدرجة الأولى، بسبب نقص الأهلية، ممارسة الاستئناف إذا زال سبب ذلك . ويجوز رفع الاستئناف من طرف المتدخل الأصلي أو المدخل في الخصام في الدرجة الأولى. يجب أن تتوفر المصلحة في المستأنف لممارسة الاستئناف ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_335> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_335> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
