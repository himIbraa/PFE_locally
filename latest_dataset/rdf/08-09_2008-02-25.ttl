    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_491_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_491> ;
    dzdoc:position 0 ;
    dzdoc:text "ينظر في الدعاوى المتعلقة بالمنازعات المنصوص عليها في المادة 490 أعلاه، بحضور ممثل النيابة العامة وفي جلسة سرية."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_492_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_492> ;
