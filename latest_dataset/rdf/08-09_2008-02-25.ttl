<https://legal.dz/resource/law/2008-02-25/08-09#version_art_939> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لقاضي الاستعجال ما لم يطلب منه أكثر من إثبات حالة الوقائع، بموجب أمر على عريضة ولو في غياب قرار إداري مسبق ، أن يعين خبيرا ليقوم بدون تأخير، بإثبات حالة الوقائع التي من شأنها أن تؤدي إلى نزاع أمام الجهة القضائية. يتم إشعار المدعى عليه المحتمل من قبل الخبير المعين على الفور ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
