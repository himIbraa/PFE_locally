    dzdoc:versionOf <https://legal.dz/resource/law/2008-02-25/08-09#art_865> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_865> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "تطبق الأحكام المتعلقة بـ الإنابات القضائية المنصوص عليها في المواد من 108 إلى 124 من هذا القانون أمام المحاكم الإدارية ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_866_20080225_OpEnact_4da94e28f2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_866> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-02-25/08-09#art_866> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_866> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "الطلبات العارضة هي الطلبات المقابلة والتدخل ويحقق فيها حسب الأشكال المقررة لعريضة افتتاح الدعوى."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_867_20080225_OpEnact_96ab837bf1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_867> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-02-25/08-09#art_867> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_867> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يكون الطلب المقابل مقبولا إذا كان مرتبطا بالطلب الأصلي ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_868_20080225_OpEnact_088d87e89b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
