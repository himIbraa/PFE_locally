<https://legal.dz/resource/law/2008-02-25/08-09#version_art_834> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقدم الطلبات الرامية إلى وقف التنفيذ بدعوى مستقلة . لا يقبل طلب وقف تنفيذ القرار الإداري، ما لم يكن متزامنا مع دعوى مرفوعة في الموضوع، أو في حالة التظلم المشار إليه في المادة 830 أعلاه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_834_20080225_OpEnact_264dc05c46> ;
    dzdoc:replacementText "تقدم الطلبات الرامية إلى وقف التنفيذ بدعوى مستقلة . لا يقبل طلب وقف تنفيذ القرار الإداري، ما لم يكن متزامنا مع دعوى مرفوعة في الموضوع، أو في حالة التظلم المشار إليه في المادة 830 أعلاه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_834> ;
