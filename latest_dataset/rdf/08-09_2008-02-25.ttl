<https://legal.dz/resource/law/2008-02-25/08-09#version_art_626> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للغير الحائز للشيء محل التنفيذ، أن يعترض على الحجز بادعائه أن له حق امتياز على هذا الشيء ، إنما له أن يثبت حقوقه وقت توزيع الثمن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_626_20080225_OpEnact_d21ce2f88e> ;
    dzdoc:replacementText "لا يجوز للغير الحائز للشيء محل التنفيذ، أن يعترض على الحجز بادعائه أن له حق امتياز على هذا الشيء ، إنما له أن يثبت حقوقه وقت توزيع الثمن."@ar ;
