<https://legal.dz/resource/law/2008-02-25/08-09#art_101> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_5> ;
    dzdoc:eId "art_101" ;
    dzdoc:fullText "يمكن استجواب الخصوم بحضور خبير ومواجهتهم بالشهود بطلب منهم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_101_permission_0_1b6d0406> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_101> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_101_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_101_20080225_OpEnact_0fa523847c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 101" ;
    dzdoc:position 100 ;
    dzdoc:usesTerm dzterm:litigants .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1019> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_2> ;
    dzdoc:eId "art_1019" ;
    dzdoc:fullText "تطبق على الخصومة التحكيمية الآجال والأوضاع المقررة أمام الجهات القضائية ما لم يتفق الأطراف على خلاف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1019> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1019_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1019_20080225_OpEnact_59db155e0d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "1019" ;
    dzdoc:position 1018 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_1019_condition_0_76779aef> ;
    dzdoc:usesTerm dzterm:arbitration_proceedings .

<https://legal.dz/resource/law/2008-02-25/08-09#art_102> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_5> ;
    dzdoc:eId "art_102" ;
    dzdoc:fullText "يجيب الخصوم بأنفسهم على الأسئلة المطروحة عليهم، دون قراءة لأي نص مكتوب ."@ar ;
