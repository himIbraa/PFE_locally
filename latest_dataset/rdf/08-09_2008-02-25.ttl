    dzdoc:position 1 ;
    dzdoc:text "وإذا لم يكن للمنفذ عليه عقارات فيتم التنفيذ على أمواله المنقولة مهما كانت قيمتها مع مراعاة أحكام المادتين 622 و 636 أدناه."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_620_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_620> ;
