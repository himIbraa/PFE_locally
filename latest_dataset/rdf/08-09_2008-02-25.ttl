    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_22> ;
    dznorm:position 0 ;
    dznorm:provisionText "يقدم الخصوم المستندات المشار إليها في المادة 21 أعلاه إلى أمين الضبط، لجردها والتأشير عليها، قبل إيداعها بملف القضية، تحت طائلة الرفض."@ar ;
    dznorm:sourceArticle "art_22" .

