<https://legal.dz/resource/law/2008-02-25/08-09#version_art_403> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن للجهة القضائية المعروض عليها التنازع أن تأمر عند الاقتضاء، بإيقاف إجراءات التنفيذ المتبعة أمام الجهات القضائية التي ظهر أمامها التنازع . باستثناء الإجراءات التحفظية، يكون مشوبا بالبطلان كل إجراء تم خرقا لوقف التنفيذ المأمور به."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_403_20080225_OpEnact_5315f68cf4> ;
    dzdoc:replacementText "يمكن للجهة القضائية المعروض عليها التنازع أن تأمر عند الاقتضاء، بإيقاف إجراءات التنفيذ المتبعة أمام الجهات القضائية التي ظهر أمامها التنازع . باستثناء الإجراءات التحفظية، يكون مشوبا بالبطلان كل إجراء تم خرقا لوقف التنفيذ المأمور به."@ar ;
