<https://legal.dz/resource/law/2008-02-25/08-09#version_art_1028> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتضمن حكم التحكيم البيانات الآتية : اسم ولقب المحكم أو المحكمين، تاريخ صدور الحكم، مكان إصداره، أسماء وألقاب الأطراف وموطن كل منهم وتسمية الأشخاص المعنوية ومقرها الاجتماعي، أسماء وألقاب المحامين أو من مثل أو ساعد الأطراف، عند الاقتضاء."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
