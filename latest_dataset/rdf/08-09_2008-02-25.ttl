    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_868> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يترتب على عدم قبول الطلب الأصلي عدم قبول الطلب المقابل ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_869_20080225_OpEnact_5d786c2664> a dzdoc:ArticleVersion ;
