<https://legal.dz/resource/law/2008-02-25/08-09#version_art_844> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعين رئيس المحكمة الإدارية التشكيلة التي يؤول إليها الفصل في الدعوى ، بمجرد قيد عريضة افتتاح الدعوى بأمانة الضبط. يعين رئيس تشكيلة الحكم القاضي المقرر الذي يحدد بناء على ظروف القضية، الأجل الممنوح للخصوم من أجل تقديم المذكرات الإضافية والملاحظات وأوجه الدفاع والردود ، ويجوز له أن يطلب من الخصوم كل مستند أو أية وثيقة تفيد في فض النزاع. يجوز لرئيس تشكيلة الحكم ، عندما تقتضي ظروف القضية ، أن يحدد فور تسجيل العريضة، التاريخ الذي يختتم فيه التحقيق، ويعلم الخصوم به عن طريق أمانة الضبط."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_844_20080225_OpEnact_19693b4721> ;
    dzdoc:replacementText "يعين رئيس المحكمة الإدارية التشكيلة التي يؤول إليها الفصل في الدعوى ، بمجرد قيد عريضة افتتاح الدعوى بأمانة الضبط. يعين رئيس تشكيلة الحكم القاضي المقرر الذي يحدد بناء على ظروف القضية، الأجل الممنوح للخصوم من أجل تقديم المذكرات الإضافية والملاحظات وأوجه الدفاع والردود ، ويجوز له أن يطلب من الخصوم كل مستند أو أية وثيقة تفيد في فض النزاع. يجوز لرئيس تشكيلة الحكم ، عندما تقتضي ظروف القضية ، أن يحدد فور تسجيل العريضة، التاريخ الذي يختتم فيه التحقيق، ويعلم الخصوم به عن طريق أمانة الضبط."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_844> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
