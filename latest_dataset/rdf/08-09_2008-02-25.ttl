    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرفع التماس إعادة النظر في أجل شهرين (2)، يبدأ سريانه من تاريخ ثبوت تزوير شهادة الشاهد، أو ثبوت التزوير، أو تاريخ اكتشاف الوثيقة المحتجزة. لا يقبل التماس إعادة النظر ، إلا إذا كانت العريضة مرفقة بوصل يثبت إيداع كفالة بأمانة ضبط الجهة القضائية، لا تقل عن الحد الأقصى للغرامة المنصوص عليها في المادة 397 أدناه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
