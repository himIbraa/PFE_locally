<https://legal.dz/resource/law/2008-02-25/08-09#version_art_298> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الحكم الصادر قبل الفصل في الموضوع هو الحكم الأمر بإجراء تحقيق أو بتدبير مؤقت . لا يحوز هذا الحكم حجية الشيء المقضي فيه . لا يترتب على هذا الحكم تخلي القاضي عن النزاع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_298_20080225_OpEnact_eca7d6ead7> ;
    dzdoc:replacementText "الحكم الصادر قبل الفصل في الموضوع هو الحكم الأمر بإجراء تحقيق أو بتدبير مؤقت . لا يحوز هذا الحكم حجية الشيء المقضي فيه . لا يترتب على هذا الحكم تخلي القاضي عن النزاع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_298> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
