<https://legal.dz/resource/law/2008-02-25/08-09#version_art_950> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد أجل استئناف الأحكام بشهرين (2) ويخفض هذا الأجل إلى خمسة عشر (15) يوما بالنسبة للأوامر الاستعجالية ، ما لم توجد نصوص خاصة . تسري هذه الآجال من يوم التبليغ الرسمي للأمر أو الحكم إلى المعني، وتسري من تاريخ انقضاء أجل المعارضة إذا صدر غيابيا. تسري هذه الآجال في مواجهة طالب التبليغ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
