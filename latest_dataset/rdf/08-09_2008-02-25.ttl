<https://legal.dz/resource/law/2008-02-25/08-09#version_art_33> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تفصل المحكمة بحكم في أول وآخر درجة في الدعاوى التي لا تتجاوز قيمتها مائتي ألف دينار (200.000 دج). إذا كانت قيمة الطلبات المقدمة من المدعي لا تتجاوز مائتي ألف دينار (200.000 دج) ، تفصل المحكمة بحكم في أول وآخر درجة، حتى ولو كانت قيمة الطلبات المقابلة أو المقاصة القضائية تتجاوز هذه القيمة. وتفصل في جميع الدعاوى الأخرى بأحكام قابلة للاستئناف."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_33_20080225_OpEnact_08e761d15d> ;
    dzdoc:replacementText "تفصل المحكمة بحكم في أول وآخر درجة في الدعاوى التي لا تتجاوز قيمتها مائتي ألف دينار (200.000 دج). إذا كانت قيمة الطلبات المقدمة من المدعي لا تتجاوز مائتي ألف دينار (200.000 دج) ، تفصل المحكمة بحكم في أول وآخر درجة، حتى ولو كانت قيمة الطلبات المقابلة أو المقاصة القضائية تتجاوز هذه القيمة. وتفصل في جميع الدعاوى الأخرى بأحكام قابلة للاستئناف."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_33> ;
