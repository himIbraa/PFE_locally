<https://legal.dz/resource/law/2008-02-25/08-09#version_art_833> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا توقف الدعوى المرفوعة أمام المحكمة الإدارية ، تنفيذ القرار الإداري المتنازع فيه، ما لم ينص القانون على خلاف ذلك . غير أنه يمكن للمحكمة الإدارية أن تأمر ، بناء على طلب الطرف المعني، بوقف تنفيذ القرار الإداري ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_833_20080225_OpEnact_623e276f4b> ;
    dzdoc:replacementText "لا توقف الدعوى المرفوعة أمام المحكمة الإدارية ، تنفيذ القرار الإداري المتنازع فيه، ما لم ينص القانون على خلاف ذلك . غير أنه يمكن للمحكمة الإدارية أن تأمر ، بناء على طلب الطرف المعني، بوقف تنفيذ القرار الإداري ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
