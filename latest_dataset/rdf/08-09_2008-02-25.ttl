    dzdoc:replacementText "إذا وقع الحجز على لوحات فنية أو أشياء ذات قيمة خاصة ، وجب وصفها وتقييمها بمعرفة خبير يعين بموجب أمر على عريضة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
