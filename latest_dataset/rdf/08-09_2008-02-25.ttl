<https://legal.dz/resource/law/2008-02-25/08-09#version_art_712> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يحصل البيع في التاريخ المعين في الإعلان لضعف العروض أو قلة المزايدين ، يؤجل البيع لمدة خمسة عشر (15) يوما، مع إعادة التعليق والنشر وفقا ل المادة 707 أعلاه، وإخطار المحجوز عليه بتاريخ البيع . وفي هذا التاريخ تباع الأموال لمن يقدم أعلى عرض وبأي ثمن دون التقيد بعدد المزايدين المنصوص عليه في المادة 708 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_712_20080225_OpEnact_a11714d862> ;
    dzdoc:replacementText "إذا لم يحصل البيع في التاريخ المعين في الإعلان لضعف العروض أو قلة المزايدين ، يؤجل البيع لمدة خمسة عشر (15) يوما، مع إعادة التعليق والنشر وفقا ل المادة 707 أعلاه، وإخطار المحجوز عليه بتاريخ البيع . وفي هذا التاريخ تباع الأموال لمن يقدم أعلى عرض وبأي ثمن دون التقيد بعدد المزايدين المنصوص عليه في المادة 708 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_712> ;
