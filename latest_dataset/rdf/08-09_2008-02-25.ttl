<https://legal.dz/resource/law/2008-02-25/08-09#version_art_761> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمزايد الجديد طلب إيقاف إعادة البيع المقرر على ذمته قبل الحكم برسو المزاد الجديد ، إذا قام بإيداع المصاريف الإضافية المترتبة على تراجعه بأمانة ضبط المحكمة . يقدم طلب إيقاف إعادة البيع في شكل عريضة مرفقا بوصل إيداع المصاريف الإضافية، إلى رئيس المحكمة الذي يفصل فيه بأمر غير قابل لأي طعن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_761_20080225_OpEnact_ea87474b2c> ;
    dzdoc:replacementText "يجوز للمزايد الجديد طلب إيقاف إعادة البيع المقرر على ذمته قبل الحكم برسو المزاد الجديد ، إذا قام بإيداع المصاريف الإضافية المترتبة على تراجعه بأمانة ضبط المحكمة . يقدم طلب إيقاف إعادة البيع في شكل عريضة مرفقا بوصل إيداع المصاريف الإضافية، إلى رئيس المحكمة الذي يفصل فيه بأمر غير قابل لأي طعن."@ar ;
