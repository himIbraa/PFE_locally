        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للقاضي تلقائيا أو بطلب من الخصوم أن يطلب اتخاذ أي إجراء من إجراءات التحقيق أو أي إجراء قضائي آخر يراه ضروريا في دولة أجنبية، بإصدار إنابة قضائية إلى السلطة القضائية المختصة للدولة المعنية أو إلى السلطات الدبلوماسية أو القنصلية الجزائرية."@ar ;
