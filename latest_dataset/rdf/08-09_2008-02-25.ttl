<https://legal.dz/resource/law/2008-02-25/08-09#version_art_122> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب تسبيب الحكم الذي يصدره القاضي المناب بشأن رفض تنفيذ الإنابة القضائية، أو إبطال العقود التي قام بتحريرها تنفيذا للإنابة القضائية، أو التراجع عن الإجراءات المتخذة، أو رفض التراجع . يجوز للخصوم وللنيابة العامة استئناف الحكم في أجل خمسة عشر (15) يوما ، ولا يمدد هذا الأجل بسبب المسافات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_122_20080225_OpEnact_3993e392d9> ;
