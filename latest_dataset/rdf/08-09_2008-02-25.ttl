<https://legal.dz/resource/law/2008-02-25/08-09#version_art_69> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على القاضي أن يثير تلقائيا ، الدفع بعدم القبول إذا كان من النظام العام ، لا سيما عند عدم احترام آجال طرق الطعن أو عند غياب طرق الطعن."@ar ;
