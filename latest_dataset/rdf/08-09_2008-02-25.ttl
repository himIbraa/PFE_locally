<https://legal.dz/resource/law/2008-02-25/08-09#version_art_832> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنقطع أجال الطعن في الحالات الآتية : الطعن أمام جهة قضائية إدارية غير مختصة، طلب المساعدة القضائية، وفاة المدعي أو تغير أهليته، القوة القاهرة أو الحادث الفجائي."@ar ;
    dzdoc:isAuthoritative true ;
