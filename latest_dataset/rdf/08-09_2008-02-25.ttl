    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز تقديم طلب التنفيذ الفوري إلى رئيس القسم الاجتماعي في الحالتين الآتيتين : حالة الامتناع عن تنفيذ اتفاق المصالحة من قبل أحد الأطراف، حالة الامتناع عن التنفيذ الكلي أو الجزئي للاتفاق الجماعي للعمل، يكون فيه ممثلو العمال طرفا، وواحد أو أكثر من أصحاب العمل."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
