        <https://legal.dz/resource/law/2008-02-25/08-09#art_153_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_153_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_153_para_3>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_153_para_4>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_153_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_153_20080225_OpEnact_54eff2577f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_153_obligation_0_ffb09fe3>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_153_obligation_1_76ab64af>,
