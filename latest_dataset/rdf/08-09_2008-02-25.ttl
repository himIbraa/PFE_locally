<https://legal.dz/resource/law/2008-02-25/08-09#version_art_246> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على القاضي الذي يعلم أنه في وضعية تجعله قابلا للرد بمفهوم المادة 241 أعلاه، أن يقدم طلبا لرئيس الجهة القضائية التابع لها بغرض استبداله . يتم النظر في هذا الطلب وفقا للإجراءات المنصوص عليها في المواد 242 و 243 و 244 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_246_20080225_OpEnact_be4dbe8d61> ;
    dzdoc:replacementText "يجب على القاضي الذي يعلم أنه في وضعية تجعله قابلا للرد بمفهوم المادة 241 أعلاه، أن يقدم طلبا لرئيس الجهة القضائية التابع لها بغرض استبداله . يتم النظر في هذا الطلب وفقا للإجراءات المنصوص عليها في المواد 242 و 243 و 244 من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_246> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_246> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_247> a dzdoc:AmendmentEvent,
