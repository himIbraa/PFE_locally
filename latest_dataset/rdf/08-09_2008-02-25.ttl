<https://legal.dz/resource/law/2008-02-25/08-09#version_art_336> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد أجل الطعن بالاستئناف بشهر واحد (1) ابتداء من تاريخ التبليغ الرسمي للحكم إلى الشخص ذاته . ويمدد أجل الاستئناف إلى شهرين (2) إذا تم التبليغ الرسمي في موطنه الحقيقي أو المختار . لا يسري أجل الاستئناف في الأحكام الغيابية إلا بعد انقضاء أجل المعارضة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_336_20080225_OpEnact_47706c8ea7> ;
    dzdoc:replacementText "يحدد أجل الطعن بالاستئناف بشهر واحد (1) ابتداء من تاريخ التبليغ الرسمي للحكم إلى الشخص ذاته . ويمدد أجل الاستئناف إلى شهرين (2) إذا تم التبليغ الرسمي في موطنه الحقيقي أو المختار . لا يسري أجل الاستئناف في الأحكام الغيابية إلا بعد انقضاء أجل المعارضة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_336> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_336> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_337> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمستأنف عليه، استئناف الحكم فرعيا في أية حالة كانت عليها الخصومة، ولو بلغ رسميا بالحكم دون تحفظ وحتى في حالة سقوط حقه في رفع الاستئناف الأصلي. لا يقبل الاستئناف الفرعي إذا كان الاستئناف الأصلي غير مقبول . يترتب على التنازل في الاستئناف الأصلي عدم قبول الاستئناف الفرعي إذا وقع بعد التنازل."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_337_20080225_OpEnact_a2e4b54401> ;
    dzdoc:replacementText "يجوز للمستأنف عليه، استئناف الحكم فرعيا في أية حالة كانت عليها الخصومة، ولو بلغ رسميا بالحكم دون تحفظ وحتى في حالة سقوط حقه في رفع الاستئناف الأصلي. لا يقبل الاستئناف الفرعي إذا كان الاستئناف الأصلي غير مقبول . يترتب على التنازل في الاستئناف الأصلي عدم قبول الاستئناف الفرعي إذا وقع بعد التنازل."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_337> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_337> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
