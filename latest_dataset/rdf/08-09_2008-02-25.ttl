<https://legal.dz/resource/law/2008-02-25/08-09#version_art_161> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتلى على الشاهد أقواله من طرف أمين الضبط فور الإدلاء بها . يجب توقيع المحضر من القاضي و أمين الضبط و الشاهد ويلحق مع أصل الحكم . إذا كان الشاهد لا يعرف أو لا يستطيع التوقيع أو يرفضه ، ينوه عن ذلك في المحضر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_161_20080225_OpEnact_b8570cf7af> ;
