    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يجوز إجراء الصلح في أية مرحلة تكون عليها الخصومة ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_972_20080225_OpEnact_1701bc7ca8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
