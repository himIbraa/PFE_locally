<https://legal.dz/resource/law/2008-02-25/08-09#version_art_192> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا امتنع الخصم عن أداء اليمين التي وجهت إليه دون ردها للخصم الآخر سقط ادعاؤه. إذا رفض من ردت عليه اليمين أداءها ، سقط ادعاؤه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
