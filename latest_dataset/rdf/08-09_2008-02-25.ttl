<https://legal.dz/resource/law/2008-02-25/08-09#version_art_179> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الادعاء بالتزوير ضد العقود الرسمية هو الدعوى التي تهدف إلى إثبات تزييف أو تغيير عقد سبق تحريره أو إضافة معلومات مزورة إليه. وقد تهدف أيضا إلى إثبات الطابع المصطنع لهذا العقد. يقام الادعاء بالتزوير بطلب فرعي أو بدعوى أصلية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_179_20080225_OpEnact_e11632a7b6> ;
    dzdoc:replacementText "الادعاء بالتزوير ضد العقود الرسمية هو الدعوى التي تهدف إلى إثبات تزييف أو تغيير عقد سبق تحريره أو إضافة معلومات مزورة إليه. وقد تهدف أيضا إلى إثبات الطابع المصطنع لهذا العقد. يقام الادعاء بالتزوير بطلب فرعي أو بدعوى أصلية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_179> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
