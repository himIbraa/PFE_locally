    dzdoc:evidenceText "تتقادم الحقوق التي تتضمنها السندات التنفيذية بمضي خمس عشرة (15) سنة كاملة ابتداء من تاريخ قابليتها للتنفيذ . يقطع التقادم بكل إجراء من إجراءات التنفيذ ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
