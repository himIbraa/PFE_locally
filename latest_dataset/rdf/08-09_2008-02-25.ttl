<https://legal.dz/resource/law/2008-02-25/08-09#version_art_631> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة وجود إشكال في تنفيذ أحد السندات التنفيذية المنصوص عليها في هذا القانون ، يحرر المحضر القضائي محضرا عن الإشكال، ويدعو الخصوم لعرض الإشكال على رئيس المحكمة التي يباشر في دائرة اختصاصها التنفيذ عن طريق الاستعجال . تخضع إشكالات التنفيذ المتعلقة بالحجوز للقواعد الخاصة بأحكام الحجوز."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_631_20080225_OpEnact_eb265fc5f9> ;
    dzdoc:replacementText "في حالة وجود إشكال في تنفيذ أحد السندات التنفيذية المنصوص عليها في هذا القانون ، يحرر المحضر القضائي محضرا عن الإشكال، ويدعو الخصوم لعرض الإشكال على رئيس المحكمة التي يباشر في دائرة اختصاصها التنفيذ عن طريق الاستعجال . تخضع إشكالات التنفيذ المتعلقة بالحجوز للقواعد الخاصة بأحكام الحجوز."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_631> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_631> ;
