    dzdoc:sourceEId "art_733" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "إذا قام المدين المحجوز عليه أو حائز العقار أو الكفيل العيني باختلاس أو إتلاف الأموال المذكورة في المادة 732 أعلاه"@ar ;
    dzdoc:targetEId "art_732" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_733_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_733> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا قام المدين المحجوز عليه أو حائز العقار أو الكفيل العيني باختلاس أو إتلاف الأموال المذكورة في المادة 732 أعلاه، تعرض إلى العقوبات المقررة في قانون العقوبات للجرائم المتعلقة بالأموال المحجوزة، فضلا عن التعويضات المدنية، عند الاقتضاء."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_734_condition_0_f5f40a92> a dznorm:Condition ;
    dznorm:conditionText "إذا كان العقار و/أو الحق العيني العقاري، مثقلا بتأمين عيني وانتقلت ملكيته بعقد رسمي مشهر إلى الغير قبل قيد أمر الحجز"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_734> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_734_obligation_0_75f5c609> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_734> ;
    dznorm:position 0 ;
    dznorm:provisionText "وجب إنذار الغير الحائز وتكليفه بدفع مبلغ الدين أو تخليته العقار، وإلا بيع العقار جبرا عليه"@ar ;
    dznorm:sourceArticle "art_734" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_734_obligation_1_7cf260c0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
