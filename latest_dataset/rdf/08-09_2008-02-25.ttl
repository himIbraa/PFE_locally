    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 1055" ;
    dzdoc:position 1054 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_120> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_7> ;
    dzdoc:eId "art_120" ;
    dzdoc:fullText "يتعين على القاضي المناب إشعار الجهة القضائية المنيبة بمكان وتاريخ وساعة تنفيذ الإنابة القضائية إذا طلبت منه ذلك ، كما يجوز للقاضي الأجنبي المنيب، أن يحضر إجراءات تنفيذ الإنابة القضائية ، إذا وجدت اتفاقيات قضائية تسمح بذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_120_permission_0_4421e632> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_120_right_0_eee0808d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_120> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_120_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_120_20080225_OpEnact_f909a2d0a0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_120_obligation_0_bba1bb0d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 120" ;
    dzdoc:position 119 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_120_condition_0_4d38a121> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_141> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_8> ;
    dzdoc:eId "art_141" ;
    dzdoc:fullText "إذا تبين للتقاضي أن العناصر التي بني عليها الخبير تقريره غير وافية ، له أن يتخذ جميع الإجراءات اللازمة ، كما يجوز له على الخصوص أن يأمر باستكمال التحقيق، أو بحضور الخبير أمامه، ليتلقى منه الإيضاحات والمعلومات الضرورية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_141_permission_0_b9c1543c> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_141_right_0_7db53dcf>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_141_right_1_1ac05133> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_141> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_141_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_141_20080225_OpEnact_faee16cf27> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 141" ;
    dzdoc:position 140 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_141_condition_0_d0d335c8> ;
    dzdoc:usesTerm dzterm:expert,
        dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_144> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_8> ;
    dzdoc:eId "art_144" ;
    dzdoc:fullText "يمكن للتقاضي أن يؤسس حكمه على نتائج الخبرة . القاضي غير ملزم برأي الخبير ، غير أنه ينبغي عليه تسبيب استبعاد نتائج الخبرة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_144_permission_0_84b2e762> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_144_right_0_364114bb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_144> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_144_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_144_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_144_20080225_OpEnact_92b6367774> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_144_obligation_0_065e0a9f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 144" ;
    dzdoc:position 143 ;
    dzdoc:usesTerm dzterm:expert,
        dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "تقيد العريضة حالا في سجل خاص تبعا لترتيب ورودها، مع بيان أسماء وألقاب الخصوم ورقم القضية وتاريخ أول جلسة. يسجل أمين الضبط رقم القضية وتاريخ أول جلسة على نسخ العريضة الافتتاحية، ويسلمها للمدعي بغرض تبليغها رسميا للخصوم. يجب احترام أجل عشرين (20) يوما على الأقل بين تاريخ تسليم التكليف بالحضور، والتاريخ المحدد لأول جلسة، ما لم ينص القانون على خلاف ذلك . إذا كان الشخص المكلف بالحضور مقيما في الخارج ، يمدد هذا الأجل أمام جميع الجهات القضائية إلى ثلاثة (3) أشهر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_16_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_16_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_16_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_16_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_16_20080225_OpEnact_949acaed4c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_16_obligation_0_4fcc6902> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "16" ;
    dzdoc:position 15 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_16_condition_0_ec2c6489> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_161> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_10> ;
    dzdoc:eId "art_161" ;
    dzdoc:fullText "تتلى على الشاهد أقواله من طرف أمين الضبط فور الإدلاء بها . يجب توقيع المحضر من القاضي و أمين الضبط و الشاهد ويلحق مع أصل الحكم . إذا كان الشاهد لا يعرف أو لا يستطيع التوقيع أو يرفضه ، ينوه عن ذلك في المحضر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_161> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_161_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_161_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_161_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_161_20080225_OpEnact_b8570cf7af> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_161_obligation_0_24313bba>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_161_obligation_1_22d3b498>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_161_obligation_2_8fc89b50> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "161" ;
    dzdoc:position 160 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_161_condition_0_9f90776b> ;
    dzdoc:usesTerm dzterm:clerk,
        dzterm:judge,
        dzterm:witness .

<https://legal.dz/resource/law/2008-02-25/08-09#art_162> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_10> ;
    dzdoc:eId "art_162" ;
    dzdoc:fullText "يجوز للخصوم، الحصول على نسخة من محضر السماع ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_162_permission_0_9d31d946> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_162_right_0_7315de47> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_162> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_162_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_162_20080225_OpEnact_b73fa1d598> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "162" ;
    dzdoc:position 161 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_190> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_14> ;
    dzdoc:eId "art_190" ;
    dzdoc:fullText "يحدد الخصم الذي يوجه اليمين لخصم آخر ، الوقائع التي ينصب عليها اليمين . يحدد القاضي في الحكم ، الوقائع التي ستؤدى بشأنها اليمين ، سواء كان طلب توجيه اليمين من أحد الخصوم أو قرره القاضي تلقائيا. لا يجوز توجيه اليمين حول وقائع مخالفة للنظام العام ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_190_permission_0_7bf3ba61> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_190> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_190_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_190_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_190_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_190_20080225_OpEnact_041c8c8378> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_190_obligation_0_af48eab4> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_190_prohibition_0_7bf3ba61> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "190" ;
    dzdoc:position 189 ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:litigant,
        dzterm:oath .

<https://legal.dz/resource/law/2008-02-25/08-09#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_1_sec_4> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "يتبادل الخصوم المستندات المودعة طبقا لـ المادة 22 أعلاه، أثناء الجلسة، أو خارجها بواسطة أمين الضبط . يمكن للقاضي، بناء على طلب أحد الخصوم، أن يأمر شفهيا بإبلاغ كل وثيقة عرضت عليه وثبت عدم إبلاغها للخصم الآخر ، ويحدد أجل وكيفية ذلك الإبلاغ. يمكن للقاضي أن يستبعد من المناقشة كل وثيقة لم يتم إبلاغها خلال الآجال، وبالكيفية التي حددها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_23_permission_0_c48cf380>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_23_permission_1_dc91ea66> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_23_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_23_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_23_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_23_20080225_OpEnact_b5ff24c4c0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "23" ;
    dzdoc:position 22 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_22> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_22> ;
    dzdoc:usesTerm dzterm:clerk .

<https://legal.dz/resource/law/2008-02-25/08-09#art_251> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_7_sec_3> ;
    dzdoc:eId "art_251" ;
    dzdoc:fullText "إذا اعترض الرئيس على الطلب ، يحيل القضية مع بيان أسباب الاعتراض إلى رئيس الجهة القضائية الأعلى مباشرة ، تفصل هذه الجهة في قرار الرفض، في غرفة المشورة، خلال شهر، دون حاجة إلى استدعاء الخصوم. تتولى الجهة القضائية المقدم إليها الطلب إرسال نسخة من قرارها إلى الجهة القضائية المطلوب تخليها عن النظر في القضية . يتولى الخصم الذي يهمه التعجيل القيام بالتبليغ الرسمي لهذا القرار لبقية الخصوم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_251> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_251_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_251_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_251_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_251_20080225_OpEnact_bb616965d9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_251_obligation_0_3272ff2b>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_251_obligation_1_16fc18d3>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_251_obligation_2_f403ab6f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 251" ;
    dzdoc:position 250 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_251_condition_0_99fcbd27> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_297> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_8_sec_4> ;
    dzdoc:eId "art_297" ;
    dzdoc:fullText "يتخلى القاضي عن النزاع الذي فصل فيه بمجرد النطق بالحكم . غير أنه يمكن للقاضي الرجوع عن حكمه في حالة الطعن بالمعارضة أو اعتراض الغير الخارج عن الخصومة أو التماس إعادة النظر ، و يجوز له أيضا تفسير حكمه أو تصحيحه طبقا للمادتين 285 و 286 من هذا القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_297_permission_0_1af51114> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_297_right_0_449c86e3>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_297_right_1_2bbee076> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_297> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_297_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_297_20080225_OpEnact_677f454b31> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_297_obligation_0_5e11243b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "297" ;
    dzdoc:position 296 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_285>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_286> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_285>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_286> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_298> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:definesTerm dzterm:judgment_before_merits ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_8_sec_5_subsec_1> ;
    dzdoc:eId "art_298" ;
    dzdoc:fullText "الحكم الصادر قبل الفصل في الموضوع هو الحكم الأمر بإجراء تحقيق أو بتدبير مؤقت . لا يحوز هذا الحكم حجية الشيء المقضي فيه . لا يترتب على هذا الحكم تخلي القاضي عن النزاع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_298> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_298_defocc_43a6150f6f8d> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_298_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_298_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_298_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_298_20080225_OpEnact_eca7d6ead7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "298" ;
    dzdoc:position 297 ;
    dzdoc:usesTerm dzterm:interlocutory_judgment,
        dzterm:res_judicata .

<https://legal.dz/resource/law/2008-02-25/08-09#art_306> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_8_sec_5_subsec_3> ;
    dzdoc:eId "art_306" ;
    dzdoc:fullText "خلافا للقواعد المقرر في رفع الدعاوى، يجوز للدائن بدين من النقود مستحق وحال الأداء ومعين المقدار وثابت بالكتابة، لا سيما الكتابة العرفية المتضمنة الاعتراف بدين أو التعهد بالوفاء أو فاتورة مؤشر عليها من المدين، تقديم طلب في شكل عريضة على نسختين، إلى رئيس المحكمة التي يوجد في دائرة اختصاصها موطن المدين ، وتحتوي على : 1 - اسم ولقب الدائن وموطنه الحقيقي أو المختار في الجزائر، 2- اسم ولقب المدين وموطنه الحقيقي أو المختار في الجزائر، 3- ذكر تسمية وطبيعة الشخص المعنوي ومقره الاجتماعي وصفة ممثله القانوني أو الاتفاقي، 4- عرض موجز عن سبب الدين ومقداره. ترفق جميع المستندات المثبتة للدين مع العريضة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_306_permission_0_04aca402> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_306_right_0_9d078202> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_306> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_306_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_306_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_306_20080225_OpEnact_2f94cde430> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_306_obligation_0_91906554> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "306" ;
    dzdoc:position 305 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_347> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_2_subsec_3> ;
    dzdoc:eId "art_347" ;
    dzdoc:fullText "يجوز للمجلس القضائي إذا تبين له أن الاستئناف تعسفي أو الغرض منه الإضرار بالمستأنف عليه ، أن يحكم على المستأنف بغرامة مدنية من عشرة آلاف دينار 10.000 دج إلى عشرين ألف دينار (20.000دج) ، دون الإخلال بالتعويضات التي يمكن أن يحكم بها للمستأنف عليه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_347_permission_0_294fd0db> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_347_right_0_fdbe11dd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_347> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_347_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_347_20080225_OpEnact_7ff7e185d1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "347" ;
    dzdoc:position 346 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_377> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_3_subsec_1> ;
    dzdoc:eId "art_377" ;
    dzdoc:fullText "يجوز للمحكمة العليا إذا رأت أن الطعن تعسفي أو الغرض منه الإضرار بالمطعون ضده ، أن تحكم على الطاعن بغرامة مدنية من عشرة آلاف دينار (10.000 دج إلى عشرين ألف دينار (20.000 دج) ، دون الإخلال بالتعويضات التي يمكن أن يحكم بها للمطعون ضده."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_377_permission_0_f9ad9c02> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_377_right_0_5149b579> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_377> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_377_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_377_20080225_OpEnact_580e1a2091> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "377" ;
    dzdoc:position 376 ;
    dzdoc:usesTerm dzterm:supreme_court .

<https://legal.dz/resource/law/2008-02-25/08-09#art_405> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:definesTerm dzterm:holiday ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_11_sec_1> ;
    dzdoc:eId "art_405" ;
    dzdoc:fullText "تحسب كل الآجال المنصوص عليها في هذا القانون كاملة ، و لا يحسب يوم التبليغ أو التبليغ الرسمي ويوم انقضاء الأجل . يعتد بأيام العطل الداخلة ضمن هذه الآجال عند حسابها. تعتبر أيام عطلة، بمفهوم هذا القانون، أيام الأعياد الرسمية وأيام الراحة الأسبوعية طبقا للنصوص الجاري بها العمل . إذا كان اليوم الأخير من الأجل ليس يوم عمل كليا أو جزئيا ، يمدد الأجل إلى أول يوم عمل موالي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_405> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_405_defocc_0717f4417251> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_405_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_405_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_405_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_405_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_405_20080225_OpEnact_c89aa722df> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_405_obligation_0_1b4317a6>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_405_obligation_1_06ae34a2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_405_obligation_2_96641f4d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 405" ;
    dzdoc:position 404 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_405_condition_0_1d14ae52> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_417> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_12> ;
    dzdoc:eId "art_417" ;
    dzdoc:fullText "يحدد التشريع المصاريف القضائية ومصاريف سير الخصومة . يعفى المستفيد من المساعدة القضائية من دفع المصاريف القضائية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_417_right_0_379f9f83> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_417> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_417_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_417_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_417_20080225_OpEnact_bcc18aa81b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_417_obligation_0_51c317f5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 417" ;
    dzdoc:position 416 ;
    dzdoc:usesTerm dzterm:judicial_expenses,
        dzterm:legal_aid .

<https://legal.dz/resource/law/2008-02-25/08-09#art_432> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_432" ;
    dzdoc:fullText "لا يجوز تقديم طلب الطلاق بالتراضي، إذا كان أحد الزوجين تحت وضع التقديم أو إذا ظهر عليه اختلال في قدراته الذهنية تمنعه من التعبير عن إرادته . يجب إثبات اختلال القدرات الذهنية من قبل طبيب مختص ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_432_permission_0_d3da48db> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_432> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_432_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_432_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_432_20080225_OpEnact_ec913fae2c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_432_obligation_0_6e24f56c> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_432_prohibition_0_d3da48db> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 432" ;
    dzdoc:position 431 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_432_condition_0_f54f5b5a> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "يجب على الخصم الذي يدفع بعدم الاختصاص الإقليمي للجهة القضائية، أن يسبب طلبه، ويعين الجهة القضائية التي يستوجب رفع الدعوى أمامها . لا يجوز للمدعي إثارة هذا الدفع."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_51_permission_0_f94dd349> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_51_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_51_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_51_20080225_OpEnact_7e3f783c63> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_51_obligation_0_5c9640d9> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_51_prohibition_0_f94dd349> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "51" ;
    dzdoc:position 50 ;
    dzdoc:usesTerm dzterm:adversary,
        dzterm:plaintiff,
        dzterm:territorial_incompetence .

<https://legal.dz/resource/law/2008-02-25/08-09#art_574> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_3_sec_6> ;
    dzdoc:eId "art_574" ;
    dzdoc:fullText "يجب على محامي الخصوم الذين يرغبون في تقديم ملاحظات شفوية خلال الجلسة، أن يقدموا طلبا لرئيس التشكيلة ثلاثة (3) أيام على الأقل قبل ذلك . يمكن لهذا الأخير أن يرفضه إذا رأى عدم جدواه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_574_permission_0_63ef5786> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_574> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_574_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_574_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_574_20080225_OpEnact_13a81c5d4c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_574_obligation_0_c39887fc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "574" ;
    dzdoc:position 573 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_578> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_3_sec_6> ;
    dzdoc:eId "art_578" ;
    dzdoc:fullText "إذا تبين لرئيس التشكيلة أنه يمكن التصريح بعدم قبول الطعن بالنقض ، يجدول القضية في أقرب جلسة لتمكين الخصوم من تقديم ملاحظاتهم . يقدم المستشار المقرر تقريرا وجيزا عن الإجراءات . يتم سماع الطلبات الشفوية للنيابة العامة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_578_permission_0_12ad05ce> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_578> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_578_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_578_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_578_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_578_20080225_OpEnact_915e1f2dfc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_578_obligation_0_3db40315>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_578_obligation_1_b5761221> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "578" ;
    dzdoc:position 577 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_578_condition_0_c5936f0c> ;
    dzdoc:usesTerm dzterm:cassation_appeal,
        dzterm:public_prosecution,
        dzterm:reporting_judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_583> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_3_sec_8> ;
    dzdoc:eId "art_583" ;
    dzdoc:fullText "ترسل أمانة ضبط المحكمة العليا نسخة من القرار إلى الجهة القضائية التي أصدرت الحكم أو القرار المطعون فيه. ويمكن للأطراف استخراج نسخ عادية منه من أمانة الضبط بتلك الجهة القضائية. وعلى أمانة ضبط الجهة القضائية المرسل إليها، التأشير على هامش أصل الحكم أو القرار بمنطوق القرار الصادر من المحكمة العليا."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_583_right_0_5e05433c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_583> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_583_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_583_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_583_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_583_20080225_OpEnact_66778aba3d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_583_obligation_0_43e4ed78>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_583_obligation_1_9bf44001> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "583" ;
    dzdoc:position 582 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_604> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_4_sec_1> ;
    dzdoc:eId "art_604" ;
    dzdoc:fullText "جميع السندات التنفيذية قابلة للتنفيذ في الإقليم الجزائري. ولأجل التنفيذ الجبري للسندات التنفيذية، يجب على قضاة النيابة العامة تسخير استعمال القوة العمومية، في أجل أقصاه عشرة (10) أيام من تاريخ إيداع طلب التسخيرة . يسجل طلب التسخيرة في سجل خاص يمسك لهذا الغرض ، و يسلم وصل للطالب يثبت إيداع هذا الطلب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_604> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_604_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_604_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_604_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_604_20080225_OpEnact_e4c0cfa008> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_604_obligation_0_94dd3ec0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_604_obligation_1_2d00d6d6>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_604_obligation_2_018c64ae> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "604" ;
    dzdoc:position 603 ;
    dzdoc:usesTerm dzterm:enforcement_titles .

<https://legal.dz/resource/law/2008-02-25/08-09#art_625> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_4_sec_3_subsec_4> ;
    dzdoc:eId "art_625" ;
    dzdoc:fullText "دون الإخلال بأحكام التنفيذ الجبري، إذا رفض المنفذ عليه تنفيذ التزام بعمل، أو خالف التزاما بالامتناع عن عمل ، يحرر المحضر القضائي محضر امتناع عن التنفيذ، ويحيل صاحب المصلحة إلى المحكمة للمطالبة بالتعويضات أو المطالبة بالغرامات التهديدية ما لم يكن قد قضي بها من قبل. يمكن لطالب التنفيذ القيام بالعمل موضوع الالتزام على نفقة المحكوم عليه ، وتنجز الأعمال المأمور بها تحت مراقبة محضر قضائي ويحرر محضرا بذلك."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_625_permission_0_6869a812> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_625_right_0_b121048f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_625> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_625_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_625_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_625_20080225_OpEnact_82493a6041> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "625" ;
    dzdoc:position 624 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_625_condition_0_17330cf3> ;
    dzdoc:usesTerm dzterm:judicial_bailiff .

<https://legal.dz/resource/law/2008-02-25/08-09#art_650> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_2_subsec_2> ;
    dzdoc:eId "art_650" ;
    dzdoc:fullText "يجوز لكل من له ابتكار أو إنتاج مسجل ومحمي قانونا أن يحجز تحفظيا على عينة من السلع أو نماذج من المصنوعات المقلدة . يحرر المحضر القضائي محضر الحجز، يبين فيه المنتوج أو العينة أو النموذج المحجوز، ويضعه في حرز مختوم ومشمع، وإيداعه مع نسخة من المحضر بأمانة ضبط المحكمة المختصة إقليميا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_650_permission_0_e5e78be4> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_650_right_0_6b264ff7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_650> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_650_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_650_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_650_20080225_OpEnact_3c23355173> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_650_obligation_0_f29cf0e3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "650" ;
    dzdoc:position 649 ;
    dzdoc:usesTerm dzterm:innovation,
        dzterm:judicial_bailiff,
        dzterm:production .

<https://legal.dz/resource/law/2008-02-25/08-09#art_666> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_2_subsec_8> ;
    dzdoc:eId "art_666" ;
    dzdoc:fullText "إذا فصلت المحكمة في دعوى تثبيت الحجز التحفظي بإثبات الدين ، قضت بصحة الحجز التحفظي وتثبيته، كما يمكنها أن تقضي برفع الحجز كليا أو جزئيا، إذا برر المدين طلبه بأسباب جدية ومشروعة . إذا فصلت المحكمة برفض الدعوى لعدم إثبات الدين ، قضت وجوبا برفع الحجز، وفصلت في طلب التعويضات المدنية، عند الاقتضاء. يجوز الحكم أيضا على الحاجز بغرامة مدنية لا تقل عن عشرين ألف دينار (20.000 دج)."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_666_permission_0_2ccfe6f8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_666> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_666_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_666_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_666_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_666_20080225_OpEnact_54706810aa> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "666" ;
    dzdoc:position 665 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_666_condition_0_f8184ee8>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_666_condition_1_27c49d69>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_666_condition_2_7e862922> ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/law/2008-02-25/08-09#art_680> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_3_subsec_2> ;
    dzdoc:eId "art_680" ;
    dzdoc:fullText "يحق للمحجوز لديه في جميع الأحوال أن يطلب خصم مما في ذمته قدر ما أنفقه من المصاريف . يتم الخصم وتقدير المصاريف بأمر على عريضة مسبب يصدره رئيس المحكمة التي يوجد في دائرة اختصاصها مكان التنفيذ. لا يمكن تنفيذ أمر الخصم إلا بعد أن يتم التبليغ الرسمي للمحجوز عليه والحاجز ، وهو قابل للاعتراض عليه أمام قاضي الاستعجال ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_680_permission_0_adeb4aac> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_680_right_0_a34aa89f>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_680_right_1_b5d5c085> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_680> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_680_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_680_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_680_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_680_20080225_OpEnact_c0230a799f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "680" ;
    dzdoc:position 679 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_680_condition_0_4b90df78> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_690> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_4_subsec_1> ;
    dzdoc:eId "art_690" ;
    dzdoc:fullText "إذا لم يبلغ أمر الحجز أو بلغ ولم يتم الحجز في أجل شهرين (2) من تاريخ صدوره ، اعتبر الأمر لاغيا بقوة القانون . يمكن تجديد طلب الحجز بعد هذا الأجل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_690_permission_0_20942c79> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_690_right_0_52b93715> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_690> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_690_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_690_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_690_20080225_OpEnact_747025e0dd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_690_obligation_0_8c55268e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "690" ;
    dzdoc:position 689 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_690_condition_0_b2c17b78> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_703> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_4_subsec_5> ;
    dzdoc:eId "art_703" ;
    dzdoc:fullText "يكون الحجز والإجراءات التالية له قابلين للإبطال، إذا لم يتم البيع خلال أجل ستة (6) أشهر ابتداء من تاريخ التبليغ الرسمي للحجز إلى المحجوز عليه ، ما لم يكن قد تم إيقاف البيع باتفاق الخصوم أو بحكم قضائي. إذا تسبب المحضر القضائي أو محافظ البيع في هذا البطلان ، يجوز إلزامهما بالتعويضات المدنية للحاجز ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_703_permission_0_7c2d7c48> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_703> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_703_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_703_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_703_20080225_OpEnact_5d3090976f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_703_obligation_0_ea6df422> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "703" ;
    dzdoc:position 702 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_703_condition_0_9ab4e844>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_703_condition_1_7446faf7> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_754> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_5_subsec_10> ;
    dzdoc:eId "art_754" ;
    dzdoc:fullText "بعد افتتاح جلسة البيع ، يقوم الرئيس بالتحقق من حضور أو غياب أطراف الحجز وإتمام إجراءات التبليغ الرسمي والنشر والتعليق. إذا كانت هذه الإجراءات صحيحة ، يأمر بافتتاح المزاد العلني، ويذكر بشروط البيع ونوع العقار و/أو الحق العيني العقاري المعروض للبيع، والثمن الأساسي والرسوم والمصاريف، ثم يحدد مبلغ التدرج في المزايدة حسب أهمية العقار و/أو الحق العيني العقاري، وفي جميع الأحوال لا يقل عن عشرة آلاف دينار (10.000دج) في كل عرض. إذا لم يتوفر النصاب من المزايدين أو كان العرض أقل من الثمن الأساسي للمزايدة، أو لم يتقدم أحد بأي عرض خلال خمس عشرة (15) دقيقة ، أثبت الرئيس ذلك في سجل الجلسة، وقرر تأجيل البيع إلى جلسة لاحقة بذات الثمن الأساسي. في الجلسة الجديدة، وبغض النظر عن عدد المزايدين إذا كانت العروض أقل من قيمة الثمن الأساسي وغير كافية لقيمة الدين والمصاريف ، قرر الرئيس تأجيل البيع وإنقاص عشر الثمن الأساسي مع إعادة النشر والتعليق وفقا ل المادة 750 أعلاه. في الجلسات الموالية، يباع العقار و/أو الحق العيني العقاري لمن تقدم بأعلى عرض ولو كان أقل من الثمن الأساسي، إلا إذا قبل الدائن الحاجز أو أحد الدائنين المتدخلين في الحجز استيفاء الدين عينا بالعقار و/أو الحق العيني العقاري، بالثمن الأساسي المحدد له."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_754> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_754_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_754_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_754_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_754_para_3>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_754_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_754_20080225_OpEnact_3cd1faf62e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "754" ;
    dzdoc:position 753 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_750> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_750> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_754_condition_0_c0bd3f57>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_754_condition_1_761beb24>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_754_condition_2_84e554b3> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_807> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_807" ;
    dzdoc:fullText "الاختصاص النوعي و الاختصاص الإقليمي للمحاكم الإدارية من النظام العام . يجوز إثارة الدفع بعدم الاختصاص من أحد الخصوم في أية مرحلة كانت عليها الدعوى . يجب إثارته تلقائيا من طرف القاضي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_807_permission_0_6aa4741c> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_807_right_0_12365748> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_807> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_807_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_807_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_807_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_807_20080225_OpEnact_a365d35685> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_807_obligation_0_9cb7a0f2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "807" ;
    dzdoc:position 806 ;
    dzdoc:usesTerm dzterm:public_order,
        dzterm:subject_matter_jurisdiction,
        dzterm:territorial_jurisdiction .

<https://legal.dz/resource/law/2008-02-25/08-09#art_811> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_811" ;
    dzdoc:fullText "عندما تخطر محكمتان إداريتان في آن واحد بطلبات مستقلة لكنها مرتبطة وتدخل في الاختصاص الإقليمي لكل منهما ، يرفع رئيسا المحكمتين تلك الطلبات إلى رئيس مجلس الدولة . يخطر كل رئيس محكمة إدارية الرئيس الآخر بأمر الإحالة . يفصل رئيس مجلس الدولة بأمر في الارتباط إن وجد، ويحدد المحكمة أو المحاكم المختصة للفصل في الطلبات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_811> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_811_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_811_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_811_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_811_20080225_OpEnact_d3d870d0a3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_811_obligation_0_9b1c81d0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_811_obligation_1_aa093777>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_811_obligation_2_013fdf0b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "811" ;
    dzdoc:position 810 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_811_condition_0_87cd31a7> ;
    dzdoc:usesTerm dzterm:council_of_state .

<https://legal.dz/resource/law/2008-02-25/08-09#art_835> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_835" ;
    dzdoc:fullText "يتم التحقيق في طلب وقف التنفيذ بصفة عاجلة ، و يتم تقليص الآجال الممنوحة للإدارات المعنية لتقديم الملاحظات حول هذا الطلب ، وإلا استغني عن هذه الملاحظات دون إعذار. عندما يظهر للمحكمة الإدارية من عريضة افتتاح الدعوى ومن طلبات وقف التنفيذ أن رفض هذه الطلبات مؤكد ، يجوز الفصل في الطلب بدون تحقيق ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_835_permission_0_bada0ee7> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_835_right_0_7dcc8222> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_835> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_835_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_835_para_1> ;
