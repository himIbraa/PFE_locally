<https://legal.dz/resource/law/2008-02-25/08-09#version_art_13> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز لأي شخص، التقاضي ما لم تكن له صفة ، وله مصلحة قائمة أو محتملة يقرها القانون. يثير القاضي تلقائيا انعدام الصفة في المدعي أو في المدعى عليه. كما يثير تلقائيا انعدام الإذن إذا ما اشترطه القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
