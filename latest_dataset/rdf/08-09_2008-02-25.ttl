<https://legal.dz/resource/law/2008-02-25/08-09#art_645_obligation_0_9d98fb50> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
