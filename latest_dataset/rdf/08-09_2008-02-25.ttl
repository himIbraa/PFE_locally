    dznorm:conditionText "في غياب التعيين، وفي حالة صعوبة تعيين المحكمين أو عزلهم أو استبدالهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_1041> ;
