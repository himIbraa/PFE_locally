<https://legal.dz/resource/law/2008-02-25/08-09#version_art_153> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز سماع أي شخص كشاهد إذا كانت له قرابة أو مصاهرة مباشرة مع أحد الخصوم . لا يجوز سماع شهادة زوج أحد الخصوم في القضية التي تعني زوجه، ولو كان مطلقا . لا يجوز أيضا قبول شهادة الإخوة والأخوات وأبناء العمومة لأحد الخصوم . غير أن الأشخاص المذكورين في هذه المادة ، باستثناء الفروع، يجوز سماعهم في القضايا الخاصة بحالة الأشخاص والطلاق. يجوز سماع القصر الذين بلغوا سن التمييز على سبيل الاستدلال. تقبل شهادة باقي الأشخاص، ما عدا ناقصي الأهلية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_153_20080225_OpEnact_54eff2577f> ;
    dzdoc:replacementText "لا يجوز سماع أي شخص كشاهد إذا كانت له قرابة أو مصاهرة مباشرة مع أحد الخصوم . لا يجوز سماع شهادة زوج أحد الخصوم في القضية التي تعني زوجه، ولو كان مطلقا . لا يجوز أيضا قبول شهادة الإخوة والأخوات وأبناء العمومة لأحد الخصوم . غير أن الأشخاص المذكورين في هذه المادة ، باستثناء الفروع، يجوز سماعهم في القضايا الخاصة بحالة الأشخاص والطلاق. يجوز سماع القصر الذين بلغوا سن التمييز على سبيل الاستدلال. تقبل شهادة باقي الأشخاص، ما عدا ناقصي الأهلية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_153> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
