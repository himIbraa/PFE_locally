<https://legal.dz/resource/law/2008-02-25/08-09#version_art_74> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقدم في الجلسة الطلب المشار إليه في المادة 73 أعلاه، في شكل عريضة، تبلغ للخصوم. يفصل القاضي في الطلب بأمر معجل النفاذ بموجب النسخة الأصلية للأمر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_74_20080225_OpEnact_bf66b21529> ;
    dzdoc:replacementText "يقدم في الجلسة الطلب المشار إليه في المادة 73 أعلاه، في شكل عريضة، تبلغ للخصوم. يفصل القاضي في الطلب بأمر معجل النفاذ بموجب النسخة الأصلية للأمر."@ar ;
