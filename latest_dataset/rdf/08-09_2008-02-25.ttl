    dzdoc:position 1 ;
    dzdoc:text "لا يحوز هذا الحكم حجية الشيء المقضي فيه."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_298_para_2> a dzdoc:Paragraph ;
