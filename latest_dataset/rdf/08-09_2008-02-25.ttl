<https://legal.dz/resource/law/2008-02-25/08-09#version_art_79> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يأمر القاضي ، عند الاقتضاء، الخصوم أو أحدهم، بإيداع مصاريف إجراءات التحقيق أو التسبيقات المالية بعد تحديدها ، لدى أمانة ضبط الجهة القضائية. إذا لم تودع هذه المبالغ في الآجال التي حددها القاضي ، استغنى عن الإجراء الذي أمر به، وحكم في القضية على الحالة التي هي عليها. لا يخل تطبيق أحكام هذه المادة بما هو مقرر في شأن المساعدة القضائية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_79_20080225_OpEnact_90eba7afe4> ;
    dzdoc:replacementText "يأمر القاضي ، عند الاقتضاء، الخصوم أو أحدهم، بإيداع مصاريف إجراءات التحقيق أو التسبيقات المالية بعد تحديدها ، لدى أمانة ضبط الجهة القضائية. إذا لم تودع هذه المبالغ في الآجال التي حددها القاضي ، استغنى عن الإجراء الذي أمر به، وحكم في القضية على الحالة التي هي عليها. لا يخل تطبيق أحكام هذه المادة بما هو مقرر في شأن المساعدة القضائية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_79> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
