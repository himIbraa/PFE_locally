<https://legal.dz/resource/law/2008-02-25/08-09#version_art_160> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تدون أقوال الشاهد في محضر يتضمن المحضر البيانات الآتية : مكان ويوم وساعة سماع الشاهد ، حضور أو غياب الخصوم، اسم ولقب ومهنة وموطن الشاهد ، أداء اليمين من طرف الشاهد ، ودرجة قرابته أو مصاهرته مع الخصوم أو تبعيته لهم، أوجه التجريح المقدمة ضد الشاهد عند الاقتضاء، أقوال الشاهد والتنويه بتلاوتها عليه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_160_20080225_OpEnact_512216b3a2> ;
    dzdoc:replacementText "تدون أقوال الشاهد في محضر يتضمن المحضر البيانات الآتية : مكان ويوم وساعة سماع الشاهد ، حضور أو غياب الخصوم، اسم ولقب ومهنة وموطن الشاهد ، أداء اليمين من طرف الشاهد ، ودرجة قرابته أو مصاهرته مع الخصوم أو تبعيته لهم، أوجه التجريح المقدمة ضد الشاهد عند الاقتضاء، أقوال الشاهد والتنويه بتلاوتها عليه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_160> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
