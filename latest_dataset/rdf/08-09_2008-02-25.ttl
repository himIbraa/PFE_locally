<https://legal.dz/resource/law/2008-02-25/08-09#art_812> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_812" ;
    dzdoc:fullText "يترتب على أوامر الإحالة المنصوص عليها في المادتين 809 و 811 أعلاه، إرجاء الفصل في الخصومة، وهي غير قابلة لأي طعن."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_812> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_812_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_812_20080225_OpEnact_47375b6c90> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "812" ;
    dzdoc:position 811 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_809>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_811> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_809>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_811> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_818> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_818" ;
    dzdoc:fullText "تودع العريضة مع نسخة منها بملف القضية، وعند الضرورة ، يأمر رئيس تشكيلة الحكم الخصوم بتقديم نسخ إضافية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_818> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_818_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_818_20080225_OpEnact_eab58a3923> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 818" ;
    dzdoc:position 817 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_821> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_821" ;
    dzdoc:fullText "تودع العريضة بأمانة ضبط المحكمة الإدارية مقابل دفع الرسم القضائي، ما لم ينص القانون على خلاف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_821> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_821_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_821_20080225_OpEnact_793e40a147> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 821" ;
    dzdoc:position 820 ;
    dzdoc:usesTerm dzterm:administrative_court .

<https://legal.dz/resource/law/2008-02-25/08-09#art_845> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_845" ;
    dzdoc:fullText "يتم تبليغ الطلبات والأعمال الإجرائية المختلفة أثناء التحقيق إلى الأطراف أو ممثليهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_845> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_845_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_845_20080225_OpEnact_6cfd6a8c40> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "845" ;
    dzdoc:position 844 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_857> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_857" ;
    dzdoc:fullText "تبلغ المذكرات المقدمة إلى الخصوم خلال المرحلة الفاصلة بين اختتام التحقيق وإعادة السير فيه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_857> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_857_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_857_20080225_OpEnact_e69b368e52> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 857" ;
    dzdoc:position 856 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_859> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_859" ;
    dzdoc:fullText "تطبق الأحكام المتعلقة بـ سماع الشهود المنصوص عليها في المواد من 150 إلى 162 من هذا القانون أمام المحاكم الإدارية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_859> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_859_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_859_20080225_OpEnact_2ad62fa9c8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "859" ;
    dzdoc:position 858 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_150>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_162> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_150>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_162> ;
    dzdoc:usesTerm dzterm:administrative_courts,
        dzterm:witness_hearing .

<https://legal.dz/resource/law/2008-02-25/08-09#art_862> a dzdoc:Article ;
