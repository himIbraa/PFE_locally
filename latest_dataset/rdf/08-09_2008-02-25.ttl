<https://legal.dz/resource/law/2008-02-25/08-09#version_art_924> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما لا يتوفر الاستعجال في الطلب، أو يكون غير مؤسس ، يرفض قاضي الاستعجال هذا الطلب بأمر مسبب. وعندما يظهر أن الطلب لا يدخل في اختصاص الجهة القضائية الإدارية ، يحكم القاضي بعدم الاختصاص النوعي."@ar ;
