<https://legal.dz/resource/law/2008-02-25/08-09#version_art_561> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمسك بأمانة ضبط المحكمة العليا وبأمانة ضبط المجالس القضائية سجل يسمى \"سجل قيد الطعون بالنقض\"، تسجل فيه تصريحات أو عرائض الطعون بالنقض حسب تاريخ وصولها . يكون هذا السجل موضوعا تحت مسؤولية أمين الضبط الرئيسي ، مرقما وموقعا من طرف الرئيس الأول للمحكمة العليا ، أو رئيس المجلس القضائي ، حسب الحالة، الذي يراقب مسكه دوريا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_561_20080225_OpEnact_8517a25e2b> ;
    dzdoc:replacementText "يمسك بأمانة ضبط المحكمة العليا وبأمانة ضبط المجالس القضائية سجل يسمى \"سجل قيد الطعون بالنقض\"، تسجل فيه تصريحات أو عرائض الطعون بالنقض حسب تاريخ وصولها . يكون هذا السجل موضوعا تحت مسؤولية أمين الضبط الرئيسي ، مرقما وموقعا من طرف الرئيس الأول للمحكمة العليا ، أو رئيس المجلس القضائي ، حسب الحالة، الذي يراقب مسكه دوريا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_561> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_561> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
