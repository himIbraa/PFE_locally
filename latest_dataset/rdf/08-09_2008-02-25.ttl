<https://legal.dz/resource/law/2008-02-25/08-09#version_art_347> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمجلس القضائي إذا تبين له أن الاستئناف تعسفي أو الغرض منه الإضرار بالمستأنف عليه ، أن يحكم على المستأنف بغرامة مدنية من عشرة آلاف دينار 10.000 دج إلى عشرين ألف دينار (20.000دج) ، دون الإخلال بالتعويضات التي يمكن أن يحكم بها للمستأنف عليه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_347_20080225_OpEnact_7ff7e185d1> ;
    dzdoc:replacementText "يجوز للمجلس القضائي إذا تبين له أن الاستئناف تعسفي أو الغرض منه الإضرار بالمستأنف عليه ، أن يحكم على المستأنف بغرامة مدنية من عشرة آلاف دينار 10.000 دج إلى عشرين ألف دينار (20.000دج) ، دون الإخلال بالتعويضات التي يمكن أن يحكم بها للمستأنف عليه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
