<https://legal.dz/resource/law/2008-02-25/08-09#version_art_997> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسند الوساطة إلى شخص طبيعي أو إلى جمعية. عندما يكون الوسيط المعين جمعية ، يقوم رئيسها بتعيين أحد أعضائها لتنفيذ الإجراء باسمها ويخطر القاضي بذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_997_20080225_OpEnact_6878d6aae5> ;
    dzdoc:replacementText "تسند الوساطة إلى شخص طبيعي أو إلى جمعية. عندما يكون الوسيط المعين جمعية ، يقوم رئيسها بتعيين أحد أعضائها لتنفيذ الإجراء باسمها ويخطر القاضي بذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_997> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_997> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_998> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يعين الشخص الطبيعي المكلف بالوساطة من بين الأشخاص المعترف لهم بحسن السلوك والاستقامة ، و أن تتوفر فيه الشروط الآتية : ألا يكون قد تعرض إلى عقوبة عن جريمة مخلة بالشرف ، وألا يكون ممنوعا من حقوقه المدنية، أن يكون مؤهلا للنظر في المنازعة المعروضة عليه، أن يكون محايدا ومستقلا في ممارسة الوساطة، تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_998_20080225_OpEnact_8eaf56e54a> ;
    dzdoc:replacementText "يجب أن يعين الشخص الطبيعي المكلف بالوساطة من بين الأشخاص المعترف لهم بحسن السلوك والاستقامة ، و أن تتوفر فيه الشروط الآتية : ألا يكون قد تعرض إلى عقوبة عن جريمة مخلة بالشرف ، وألا يكون ممنوعا من حقوقه المدنية، أن يكون مؤهلا للنظر في المنازعة المعروضة عليه، أن يكون محايدا ومستقلا في ممارسة الوساطة، تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_998> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_998> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_999> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يتضمن الأمر القاضي بتعيين الوسيط ما يأتي : موافقة الخصوم، تحديد الآجال الأولى الممنوحة للوسيط للقيام بمهمته وتاريخ رجوع القضية إلى الجلسة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_999_20080225_OpEnact_61be10b01d> ;
    dzdoc:replacementText "يجب أن يتضمن الأمر القاضي بتعيين الوسيط ما يأتي : موافقة الخصوم، تحديد الآجال الأولى الممنوحة للوسيط للقيام بمهمته وتاريخ رجوع القضية إلى الجلسة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
