    dzdoc:evidenceText "يجوز ل مجلس الدولة أن يأمر بوقف تنفيذ الحكم الصادر عن المحكمة الإدارية ، إذا كان تنفيذه من شأنه أن يعرض المستأنف لخسارة مالية مؤكدة لا يمكن تداركها، وعندما تبدو الأوجه المثارة في الاستئناف من شأنها تبرير إلغاء القرار المستأنف ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_913_20080225_OpEnact_7039874652> ;
