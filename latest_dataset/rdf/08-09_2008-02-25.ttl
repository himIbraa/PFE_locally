<https://legal.dz/resource/law/2008-02-25/08-09#version_art_296> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الحكم في الموضوع هو الحكم الفاصل كليا أو جزئيا في موضوع النزاع أو في دفع شكلي أو في دفع بعدم القبول أو في أي طلب عارض. ويكون هذا الحكم بمجرد النطق به حائزا لحجية الشيء المقضي فيه في النزاع المفصول فيه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_296_20080225_OpEnact_32b77a1c00> ;
    dzdoc:replacementText "الحكم في الموضوع هو الحكم الفاصل كليا أو جزئيا في موضوع النزاع أو في دفع شكلي أو في دفع بعدم القبول أو في أي طلب عارض. ويكون هذا الحكم بمجرد النطق به حائزا لحجية الشيء المقضي فيه في النزاع المفصول فيه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_296> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_296> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_297> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتخلى القاضي عن النزاع الذي فصل فيه بمجرد النطق بالحكم . غير أنه يمكن للقاضي الرجوع عن حكمه في حالة الطعن بالمعارضة أو اعتراض الغير الخارج عن الخصومة أو التماس إعادة النظر ، و يجوز له أيضا تفسير حكمه أو تصحيحه طبقا للمادتين 285 و 286 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_297_20080225_OpEnact_677f454b31> ;
    dzdoc:replacementText "يتخلى القاضي عن النزاع الذي فصل فيه بمجرد النطق بالحكم . غير أنه يمكن للقاضي الرجوع عن حكمه في حالة الطعن بالمعارضة أو اعتراض الغير الخارج عن الخصومة أو التماس إعادة النظر ، و يجوز له أيضا تفسير حكمه أو تصحيحه طبقا للمادتين 285 و 286 من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
