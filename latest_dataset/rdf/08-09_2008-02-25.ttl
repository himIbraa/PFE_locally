<https://legal.dz/resource/law/2008-02-25/08-09#version_art_650> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لكل من له ابتكار أو إنتاج مسجل ومحمي قانونا أن يحجز تحفظيا على عينة من السلع أو نماذج من المصنوعات المقلدة . يحرر المحضر القضائي محضر الحجز، يبين فيه المنتوج أو العينة أو النموذج المحجوز، ويضعه في حرز مختوم ومشمع، وإيداعه مع نسخة من المحضر بأمانة ضبط المحكمة المختصة إقليميا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_650_20080225_OpEnact_3c23355173> ;
