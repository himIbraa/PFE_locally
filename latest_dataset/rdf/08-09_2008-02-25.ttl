    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رفع استئناف في الحكم القاضي برفض طلب تقديم الحساب ، فإن القرار الذي يقضي بالإلغاء، يحيل مراجعة المحاسبة والحكم الفاصل في الحساب إلى الجهة القضائية التي قدم إليها الطلب، أو إلى الجهة القضائية التي يحددها القرار. في حالة إلغاء الحكم الفاصل في الحساب المقدم أمام المحكمة ، فإن تنفيذ قرار الإلغاء يعود إما إلى المجلس القضائي الذي أصدره، أو إلى الجهة القضائية التي حددها هذا القرار."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_598_20080225_OpEnact_b61d06175b> ;
    dzdoc:replacementText "إذا رفع استئناف في الحكم القاضي برفض طلب تقديم الحساب ، فإن القرار الذي يقضي بالإلغاء، يحيل مراجعة المحاسبة والحكم الفاصل في الحساب إلى الجهة القضائية التي قدم إليها الطلب، أو إلى الجهة القضائية التي يحددها القرار. في حالة إلغاء الحكم الفاصل في الحساب المقدم أمام المحكمة ، فإن تنفيذ قرار الإلغاء يعود إما إلى المجلس القضائي الذي أصدره، أو إلى الجهة القضائية التي حددها هذا القرار."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_598> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
