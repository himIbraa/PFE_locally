<https://legal.dz/resource/law/2008-02-25/08-09#version_art_132> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رفض الخبير إنجاز المهمة المسندة إليه أو تعذر عليه ذلك ، استبدل بغيره بموجب أمر على عريضة صادر عن القاضي الذي عينه. إذا قبل الخبير المهمة ولم يقم بها أو لم ينجز تقريره أو لم يودعه في الأجل المحدد ، جاز الحكم عليه بكل ما تسبب فيه من مصاريف، وعند الاقتضاء، الحكم عليه بالتعويضات المدنية ، ويمكن علاوة على ذلك استبداله."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_132_20080225_OpEnact_cdbea350f6> ;
    dzdoc:replacementText "إذا رفض الخبير إنجاز المهمة المسندة إليه أو تعذر عليه ذلك ، استبدل بغيره بموجب أمر على عريضة صادر عن القاضي الذي عينه. إذا قبل الخبير المهمة ولم يقم بها أو لم ينجز تقريره أو لم يودعه في الأجل المحدد ، جاز الحكم عليه بكل ما تسبب فيه من مصاريف، وعند الاقتضاء، الحكم عليه بالتعويضات المدنية ، ويمكن علاوة على ذلك استبداله."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_132> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
