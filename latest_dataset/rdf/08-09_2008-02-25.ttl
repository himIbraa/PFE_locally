<https://legal.dz/resource/law/2008-02-25/08-09#version_art_373> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن للأشخاص المذكورين في المادة 372 أعلاه، طبقا لنفس الشروط المبادرة بإخطار جهة الإحالة . يقوم الرئيس الأول ل المحكمة العليا بتسوية كل إشكال قد يطرأ بشأن تسليم نسخ من قرار النقض لهؤلاء الأشخاص."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_373_20080225_OpEnact_27b4155b90> ;
    dzdoc:replacementText "يمكن للأشخاص المذكورين في المادة 372 أعلاه، طبقا لنفس الشروط المبادرة بإخطار جهة الإحالة . يقوم الرئيس الأول ل المحكمة العليا بتسوية كل إشكال قد يطرأ بشأن تسليم نسخ من قرار النقض لهؤلاء الأشخاص."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_373> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
