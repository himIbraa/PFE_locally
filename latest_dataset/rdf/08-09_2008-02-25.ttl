<https://legal.dz/resource/law/2008-02-25/08-09#version_art_314> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يكون الحكم الحضوري الفاصل في موضوع النزاع والحكم الفاصل في أحد الدفوع الشكلية أو الدفع بعدم القبول أو أي دفع من الدفوع الأخرى التي تنهي الخصومة، قابلا لأي طعن بعد انقضاء سنتين (2) من تاريخ النطق به، ولو لم يتم تبليغه رسميا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_314_20080225_OpEnact_e269fc79a3> ;
