    dzdoc:usesTerm dzterm:counterclaim .

<https://legal.dz/resource/law/2008-02-25/08-09#art_869> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_869" ;
    dzdoc:fullText "تطبق الأحكام المتعلقة بـ التدخل في الخصومة المنصوص عليها في المواد من 194 إلى 206 من هذا القانون أمام المحاكم الإدارية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_869> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_869_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_869_20080225_OpEnact_5d786c2664> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "869" ;
    dzdoc:position 868 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_194>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_206> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_194>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_206> ;
    dzdoc:usesTerm dzterm:administrative_courts,
        dzterm:intervention .

<https://legal.dz/resource/law/2008-02-25/08-09#art_870> a dzdoc:Article ;
