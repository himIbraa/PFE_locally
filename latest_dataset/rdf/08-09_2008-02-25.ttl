<https://legal.dz/resource/law/2008-02-25/08-09#version_art_77> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن للقاضي ، ولسبب مشروع وقبل مباشرة الدعوى أن يأمر بأي إجراء من إجراءات التحقيق ، بناء على طلب كل ذي مصلحة ، قصد إقامة الدليل والاحتفاظ به لإثبات الوقائع التي قد تحدد مآل النزاع. يأمر القاضي بالإجراء المطلوب بأمر على عريضة أو عن طريق الاستعجال."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_77_20080225_OpEnact_e11dced927> ;
    dzdoc:replacementText "يمكن للقاضي ، ولسبب مشروع وقبل مباشرة الدعوى أن يأمر بأي إجراء من إجراءات التحقيق ، بناء على طلب كل ذي مصلحة ، قصد إقامة الدليل والاحتفاظ به لإثبات الوقائع التي قد تحدد مآل النزاع. يأمر القاضي بالإجراء المطلوب بأمر على عريضة أو عن طريق الاستعجال."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_77> ;
