    dzdoc:position 0 ;
    dzdoc:text "ترفع دعوى الاعتراف بالنسب، بالبنوة أو بالأبوة أو بالأمومة لشخص مجهول النسب أو إنكار الأبوة، أمام محكمة موطن المدعى عليه."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_491_condition_0_d50fc59e> a dznorm:Condition ;
