    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_639_20080225_OpEnact_c31a590a2a> ;
    dzdoc:replacementText "لا يجوز الحجز على الأجور والمرتبات ومعاشات التقاعد أو العجز الجسماني ، إلا في الحدود المنصوص عليها في هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_639> ;
