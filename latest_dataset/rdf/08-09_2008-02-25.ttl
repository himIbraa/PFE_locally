<https://legal.dz/resource/law/2008-02-25/08-09#version_art_1000> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "بمجرد النطق بالأمر القاضي بتعيين الوسيط ، يقوم أمين الضبط بتبليغ نسخة منه للخصوم والوسيط. يخطر الوسيط القاضي بقبوله مهمة الوساطة دون تأخير، ويدعو الخصوم إلى أول لقاء للوساطة."@ar ;
