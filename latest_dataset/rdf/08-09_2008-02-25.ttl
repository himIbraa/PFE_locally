dzterm:acceptance a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "القبول بطلب الخصم"@ar,
        "القبول هو تخلي أحد الخصوم عن حقه في الاحتجاج على طلب خصمه، أو على حكم سبق صدوره ويكون إما جزئيا أو كليا."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_237_defocc_9ddef2a0b613> .

dzterm:appellant a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الطاعن"@ar .

dzterm:arbitration_agreement a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "اتفاق التحكيم هو الاتفاق الذي يقبل الأطراف بموجبه عرض نزاع سبق نشوؤه على التحكيم."@ar,
        "اتفاقية التحكيم"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_1011_defocc_fa844dd780ae> .

