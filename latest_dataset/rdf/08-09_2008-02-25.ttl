<https://legal.dz/resource/law/2008-02-25/08-09#version_art_935> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرتب الأمر الاستعجالي أثاره من تاريخ التبليغ الرسمي أو التبليغ للخصم المحكوم عليه. غیر أنه، يجوز لـ قاضي الاستعجال أن يقرر تنفيذه فور صدوره. يبلغ أمين ضبط الجلسة، بأمر من القاضي، منطوق الأمر ممهورا بالصيغة التنفيذية في الحال إلى الخصوم مقابل وصل استلام، إذا اقتضت ظروف الاستعجال ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
