<https://legal.dz/resource/law/2008-02-25/08-09#art_711_condition_1_293e2016> a dznorm:Condition ;
    dznorm:conditionText "إلا إذا كانت الأموال المحجوزة في الحجز الأول قد بيعت"@ar ;
