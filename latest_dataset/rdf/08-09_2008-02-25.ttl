<https://legal.dz/resource/law/2008-02-25/08-09#version_art_914> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يتم استئناف حكم صادر عن المحكمة الإدارية قضى بإلغاء قرار إداري لتجاوز السلطة، يجوز ل مجلس الدولة ، بناء على طلب المستأنف، أن يأمر بوقف تنفيذ هذا الحكم متى كانت أوجه الاستئناف تبدو من التحقيق جدية ومن شأنها أن تؤدي فضلا عن إلغاء الحكم المطعون فيه أو تعديله، إلى رفض الطلبات الرامية إلى الإلغاء من أجل تجاوز السلطة الذي قضى به الحكم . في جميع الحالات المنصوص عليها في الفقرة أعلاه وفي المادة 912 من هذا القانون يجوز ل مجلس الدولة ، في أي وقت أن يرفع حالة وقف التنفيذ، بناء على طلب من يهمه الأمر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_914_20080225_OpEnact_5be532ef37> ;
    dzdoc:replacementText "عندما يتم استئناف حكم صادر عن المحكمة الإدارية قضى بإلغاء قرار إداري لتجاوز السلطة، يجوز ل مجلس الدولة ، بناء على طلب المستأنف، أن يأمر بوقف تنفيذ هذا الحكم متى كانت أوجه الاستئناف تبدو من التحقيق جدية ومن شأنها أن تؤدي فضلا عن إلغاء الحكم المطعون فيه أو تعديله، إلى رفض الطلبات الرامية إلى الإلغاء من أجل تجاوز السلطة الذي قضى به الحكم . في جميع الحالات المنصوص عليها في الفقرة أعلاه وفي المادة 912 من هذا القانون يجوز ل مجلس الدولة ، في أي وقت أن يرفع حالة وقف التنفيذ، بناء على طلب من يهمه الأمر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
