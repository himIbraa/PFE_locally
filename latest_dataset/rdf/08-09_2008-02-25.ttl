<https://legal.dz/resource/law/2008-02-25/08-09#version_art_324> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز رفع الاعتراض على النفاذ المعجل، أمام رئيس الجهة القضائية المعروض أمامها الاستئناف أو المعارضة ، و يجوز له توقيف النفاذ المعجل، عن طريق الاستعجال، إذا رأى أن الاستمرار فيه قد تترتب عليه آثار بالغة أو آثار يتعذر استدراكها . يفصل رئيس الجهة القضائية في الاعتراض على النفاذ المعجل في أقرب جلسة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_324_20080225_OpEnact_efc73c1c9d> ;
    dzdoc:replacementText "يجوز رفع الاعتراض على النفاذ المعجل، أمام رئيس الجهة القضائية المعروض أمامها الاستئناف أو المعارضة ، و يجوز له توقيف النفاذ المعجل، عن طريق الاستعجال، إذا رأى أن الاستمرار فيه قد تترتب عليه آثار بالغة أو آثار يتعذر استدراكها . يفصل رئيس الجهة القضائية في الاعتراض على النفاذ المعجل في أقرب جلسة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_324> ;
