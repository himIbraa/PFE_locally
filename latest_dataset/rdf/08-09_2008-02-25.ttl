    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_236_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_236> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر التنازل عن المعارضة أو الاستئناف، قبولا بالحكم."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_236_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_236> ;
    dzdoc:position 1 ;
