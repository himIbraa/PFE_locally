<https://legal.dz/resource/law/2008-02-25/08-09#version_art_282> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تسلم إلا نسخة تنفيذية واحدة. إلا أن الخصم المستفيد الذي أضاع قبل التنفيذ النسخة التنفيذية أو تعذر عليه التنفيذ، لا سيما بسبب إتلافها أو تمزيقها، يمكنه الحصول على نسخة تنفيذية ثانية ، وفقا لأحكام المادتين 602 و 603 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_282_20080225_OpEnact_e1751d2e5e> ;
