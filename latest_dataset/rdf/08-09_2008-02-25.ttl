<https://legal.dz/resource/law/2008-02-25/08-09#version_art_646> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الحجز التحفظي هو وضع أموال المدين المنقولة المادية والعقارية تحت يد القضاء ومنعه من التصرف فيها ، ويقع الحجز على مسؤولية الدائن ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
