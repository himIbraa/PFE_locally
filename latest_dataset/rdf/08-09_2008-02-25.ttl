<https://legal.dz/resource/law/2008-02-25/08-09#version_art_627> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة غياب المنفذ عليه، عند مباشرة إجراءات التنفيذ ، يجوز الترخيص للمحضر القضائي بناء على طلبه، وبأمر على عريضة يصدره رئيس المحكمة التي يباشر في دائرة اختصاصها التنفيذ، بعد إبلاغ ممثل النيابة العامة بفتح أو كسر أبواب المحلات أو المنازل المغلقة وفض أقفال الغرف في حدود ما تستلزمه مقتضيات التنفيذ ، وذلك بحضور أحد أعوان الضبطية القضائية، وفي حالة تعذر ذلك يتم الفتح بحضور شاهدين . يتعين تحرير محضر فتح وجرد للأشياء الموجودة بالمحل المفتوح وتوقيعه من المحضر القضائي وعون الضبطية القضائية أو الشاهدين ،"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_627_20080225_OpEnact_108799f3a3> ;
    dzdoc:replacementText "في حالة غياب المنفذ عليه، عند مباشرة إجراءات التنفيذ ، يجوز الترخيص للمحضر القضائي بناء على طلبه، وبأمر على عريضة يصدره رئيس المحكمة التي يباشر في دائرة اختصاصها التنفيذ، بعد إبلاغ ممثل النيابة العامة بفتح أو كسر أبواب المحلات أو المنازل المغلقة وفض أقفال الغرف في حدود ما تستلزمه مقتضيات التنفيذ ، وذلك بحضور أحد أعوان الضبطية القضائية، وفي حالة تعذر ذلك يتم الفتح بحضور شاهدين . يتعين تحرير محضر فتح وجرد للأشياء الموجودة بالمحل المفتوح وتوقيعه من المحضر القضائي وعون الضبطية القضائية أو الشاهدين ، وإلا كان قابلا للإبطال تحت المسؤولية المدنية للمحضر القضائي ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_627> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_627> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_628> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسمح ل لمحضر القضائي في إطار مهمته بالدخول إلى الإدارات والمؤسسات العمومية أو الخاصة، للبحث عن حقوق مالية عينية للمنفذ عليه أو أموال أخرى قابلة للتنفيذ ، و على هذه المؤسسات تقديم يد المساعدة لإنجاز الغرض المطلوب منها . في هذه الحالة ، يحرر محضر جرد لهذه الحقوق و/أو الأموال، ثم مباشرة التنفيذ عليها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_628_20080225_OpEnact_591ddb25f1> ;
    dzdoc:replacementText "يسمح ل لمحضر القضائي في إطار مهمته بالدخول إلى الإدارات والمؤسسات العمومية أو الخاصة، للبحث عن حقوق مالية عينية للمنفذ عليه أو أموال أخرى قابلة للتنفيذ ، و على هذه المؤسسات تقديم يد المساعدة لإنجاز الغرض المطلوب منها . في هذه الحالة ، يحرر محضر جرد لهذه الحقوق و/أو الأموال، ثم مباشرة التنفيذ عليها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_628> ;
