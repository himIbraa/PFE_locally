    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_677> ;
    dznorm:conditionText "إذا لم يصرح المحجوز لديه بما عنده كما هو مبين في المادة 677 أعلاه، أو قدم تصريحا بغير الحقيقة أو أخفى الأوراق الواجب إيداعها لتأييد التصريح"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_679> ;
    dznorm:position 0 .

