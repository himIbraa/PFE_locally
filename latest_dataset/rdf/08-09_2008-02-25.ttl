    dzdoc:position 969 ;
    dzdoc:usesTerm dzterm:conciliation .

<https://legal.dz/resource/law/2008-02-25/08-09#art_971> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_5_sec_1> ;
    dzdoc:eId "art_971" ;
    dzdoc:fullText "يجوز إجراء الصلح في أية مرحلة تكون عليها الخصومة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_971_permission_0_3c67a820> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_971_right_0_3ad0cb5e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_971> ;
