<https://legal.dz/resource/law/2008-02-25/08-09#version_art_729> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عند قيام المحافظ العقاري بقيد أمر الحجز ، يجب ذكر تاريخ وساعة الإيداع، وينوه بهامشه وبترتيب ورود كل أمر حجز سبق قيده، مع ذكر اسم ولقب وموطن كل الدائنين والجهة القضائية التي أصدرت أمر الحجز ."@ar ;
    dzdoc:isAuthoritative true ;
