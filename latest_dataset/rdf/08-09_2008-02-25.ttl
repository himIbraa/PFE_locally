<https://legal.dz/resource/law/2008-02-25/08-09#version_art_625> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "دون الإخلال بأحكام التنفيذ الجبري، إذا رفض المنفذ عليه تنفيذ التزام بعمل، أو خالف التزاما بالامتناع عن عمل ، يحرر المحضر القضائي محضر امتناع عن التنفيذ، ويحيل صاحب المصلحة إلى المحكمة للمطالبة بالتعويضات أو المطالبة بالغرامات التهديدية ما لم يكن قد قضي بها من قبل. يمكن لطالب التنفيذ القيام بالعمل موضوع الالتزام على نفقة المحكوم عليه ، وتنجز الأعمال المأمور بها تحت مراقبة محضر قضائي ويحرر محضرا بذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_625_20080225_OpEnact_82493a6041> ;
    dzdoc:replacementText "دون الإخلال بأحكام التنفيذ الجبري، إذا رفض المنفذ عليه تنفيذ التزام بعمل، أو خالف التزاما بالامتناع عن عمل ، يحرر المحضر القضائي محضر امتناع عن التنفيذ، ويحيل صاحب المصلحة إلى المحكمة للمطالبة بالتعويضات أو المطالبة بالغرامات التهديدية ما لم يكن قد قضي بها من قبل. يمكن لطالب التنفيذ القيام بالعمل موضوع الالتزام على نفقة المحكوم عليه ، وتنجز الأعمال المأمور بها تحت مراقبة محضر قضائي ويحرر محضرا بذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_625> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
