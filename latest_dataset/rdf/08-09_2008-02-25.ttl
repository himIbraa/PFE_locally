<https://legal.dz/resource/law/2008-02-25/08-09#art_723_obligation_0_25ee0988> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/law/2008-02-25/08-09#art_723_obligation_0_25ee0988_ref_c18b287f629d> ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_722> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_722> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_723> ;
    dznorm:position 0 ;
    dznorm:provisionText "يرفق طلب الحجز المشار إليه في المادة 722 أعلاه، بالوثائق الآتية"@ar ;
    dznorm:sourceArticle "art_723" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_723_obligation_0_25ee0988_ref_c18b287f629d> a dzdoc:Reference ;
    rdfs:label "المادة 722"@ar ;
    dzdoc:frbrUri "#art_722"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2008-02-25/08-09#art_722> ;
    dzdoc:sourceEId "art_723" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يرفق طلب الحجز المشار إليه في المادة 722 أعلاه، بالوثائق الآتية"@ar ;
    dzdoc:targetEId "art_722" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_723_obligation_1_d041b56a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_723> ;
    dznorm:position 1 ;
    dznorm:provisionText "رفض طلب الحجز"@ar ;
    dznorm:sourceArticle "art_723" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_723_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_723> ;
    dzdoc:position 0 ;
    dzdoc:text "يرفق طلب الحجز المشار إليه في المادة 722 أعلاه، بالوثائق الآتية : نسخة من السند التنفيذي المتضمن مبلغ الدين ونسخة من محضر التبليغ الرسمي والتكليف بالوفاء، محضر عدم كفاية الأموال المنقولة أو عدم وجودها بالنسبة للدائن العادي، مستخرج عقد الرهن أو أمر التخصيص على عقار أو مستخرج من قيد حق الامتياز، بالنسبة لأصحاب التأمينات العينية، مستخرج من سند ملكية المدين للعقار، شهادة عقارية."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_723_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_723> ;
    dzdoc:position 1 ;
    dzdoc:text "إذا لم يرفق الطلب بإحدى هذه الوثائق، رفض طلب الحجز، ويمكن تجديده عند استكمال الوثائق المطلوبة."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_724_condition_0_141d1fc7> a dznorm:Condition ;
    dznorm:conditionText "إذا كان للمدين عدة عقارات و/أو حقوق عينية عقارية تقع في دوائر اختصاص مختلفة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_724> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_724_condition_1_34040ba4> a dznorm:Condition ;
    dznorm:conditionText "وإذا خلا الأمر من أحد البيانات الثلاثة أعلاه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_724> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_724_obligation_0_b97dd63b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2008-02-25/08-09#art_724_obligation_0_b97dd63b_action_0cb5e4465c> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_724> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب أن يتضمن أمر الحجز، فضلا عن البيانات المعتادة، ما يأتي"@ar ;
    dznorm:sourceArticle "art_724" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_724_obligation_0_b97dd63b_action_0cb5e4465c> a dznorm:Action ;
    rdfs:label "أن يتضمن أمر الحجز"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب أن يتضمن أمر الحجز، فضلا عن البيانات المعتادة، ما يأتي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_724> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_724_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_724> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم الحجز على العقار و/أو الحق العيني العقاري، بموجب أمر على عريضة، يصدره رئيس المحكمة التي يوجد في دائرة اختصاصها هذا العقار و/أو الحق العيني العقاري، في أجل أقصاه ثمانية (8) أيام من تاريخ إيداع الطلب."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_724_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_724> ;
    dzdoc:position 1 ;
    dzdoc:text "إذا كان للمدين عدة عقارات و/أو حقوق عينية عقارية تقع في دوائر اختصاص مختلفة، يجوز للدائن استصدار أمر واحد بالحجز عليها من طرف رئيس المحكمة التي يقع في دائرة اختصاصها إحدى هذه العقارات و/أو الحقوق العينية العقارية."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_724_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_724> ;
    dzdoc:position 2 ;
    dzdoc:text "يجب أن يتضمن أمر الحجز، فضلا عن البيانات المعتادة، ما يأتي : نوع السند التنفيذي الذي بموجبه تم الحجز وتاريخه والجهة التي أصدرته ومبلغ الدين المطلوب الوفاء به، تاريخ التبليغ الرسمي للسند التنفيذي، وتاريخ تكليف المدين بالوفاء بقيمة الدين، تعيين العقار و/أو الحق العيني العقاري المحجوز ، تعيينا دقيقا، لا سيما موقعه وحدوده ونوعه ومشتملاته ومساحته ورقم القطعة الأرضية واسمها عند الاقتضاء، مفرزا أو مشاعا، وغيرها من البيانات التي تفيد في تعيينه، وإذا كان العقار بناية، يبين الشارع ورقمه وأجزاء العقارات."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_724_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_724> ;
    dzdoc:position 3 ;
    dzdoc:text "وإذا خلا الأمر من أحد البيانات الثلاثة أعلاه، كان قابلا للإبطال."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_724_permission_0_9d0d9da1> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
