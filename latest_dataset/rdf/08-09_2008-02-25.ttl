dzterm:enforcement_title a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "السند التنفيذي"@ar,
        "سند تنفيذي"@ar,
        "سندا تنفيذيا"@ar,
        "للسند التنفيذي"@ar,
        "يعد محضر الاتفاق سندا تنفيذيا"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_1004_defocc_df78863dd57e> .

dzterm:official_notification a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التبليغ"@ar,
        "التبليغ الرسمي"@ar,
        "تبليغ رسمي"@ar,
        "يقصد بالتبليغ الرسمي، التبليغ الذي يتم بموجب محضر يعده المحضر القضائي."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_406_defocc_b10c9df2015b> .

dzterm:التماس_إعادة_النظر a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التماس إعادة النظر"@ar,
        "يهدف التماس إعادة النظر إلى مراجعة الأمر الاستعجالي أو الحكم أو القرار الفاصل في الموضوع، والحائز لقوة الشيء المقضي به، وذلك للفصل فيه من جديد من حيث الوقائع والقانون."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_390_defocc_bb31247f839b> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1012> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_1_subsec_2> ;
    dzdoc:eId "art_1012" ;
    dzdoc:fullText "يحصل الاتفاق على التحكيم كتابيا. يجب أن يتضمن اتفاق التحكيم، تحت طائلة البطلان موضوع النزاع وأسماء المحكمين، أو كيفية تعيينهم. إذا رفض المحكم المعين القيام بالمهمة المسندة إليه ، يستبدل بغيره بأمر من طرف رئيس المحكمة المختصة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1012> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1012_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1012_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1012_20080225_OpEnact_16fb077e38> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_1012_obligation_0_c9c28abc>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1012_obligation_1_a0b62da2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 1012" ;
    dzdoc:position 1011 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_1012_condition_0_d5da2450> ;
    dzdoc:usesTerm dzterm:court_president .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1013> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_1_subsec_2> ;
    dzdoc:eId "art_1013" ;
    dzdoc:fullText "يجوز للأطراف الاتفاق على التحكيم، حتى أثناء سريان الخصومة أمام الجهة القضائية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_1013_permission_0_b0fb39e5> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_1013_right_0_b0fb39e5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1013> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1013_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1013_20080225_OpEnact_1a44377f70> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 1013" ;
    dzdoc:position 1012 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1032> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_4> ;
    dzdoc:eId "art_1032" ;
    dzdoc:fullText "أحكام التحكيم غير قابلة للمعارضة. يجوز الطعن فيها عن طريق اعتراض الغير الخارج عن الخصومة أمام المحكمة المختصة قبل عرض النزاع على التحكيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_1032_permission_0_c1071093> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_1032_right_0_d719f512> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1032> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1032_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1032_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1032_20080225_OpEnact_5d3b38c10b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "1032" ;
    dzdoc:position 1031 ;
    dzdoc:usesTerm dzterm:arbitration_awards .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1044> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_6_subsec_2> ;
    dzdoc:eId "art_1044" ;
    dzdoc:fullText "تفصل محكمة التحكيم في الاختصاص الخاص بها . و يجب إثارة الدفع بعدم الاختصاص قبل أي دفاع في الموضوع . تفصل محكمة التحكيم في اختصاصها بحكم أولي إلا إذا كان الدفع بعدم الاختصاص مرتبطا بموضوع النزاع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1044> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1044_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1044_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1044_20080225_OpEnact_9373e28553> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_1044_obligation_0_10547b36>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1044_obligation_1_b3db79b0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_1044_obligation_2_ee821ebb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 1044" ;
    dzdoc:position 1043 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_1044_condition_0_3b96dc0a> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_105> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_5> ;
    dzdoc:eId "art_105" ;
    dzdoc:fullText "تدون تصريحات الخصوم في محضر ، ويشار فيه، عند الاقتضاء، إلى غيابهم أو رفضهم الإدلاء بالتصريحات. يوقع الخصوم على المحضر فور تلاوته عليهم من طرف أمين الضبط . في حالة رفض التوقيع يشار إلى ذلك في المحضر. يتضمن المحضر مكان وتاريخ وساعة تحريره، ويوقع من قبل القاضي وأمين الضبط."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_105> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_105_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_105_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_105_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_105_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_105_20080225_OpEnact_af89fb04d2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_105_obligation_0_1cf14df6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 105" ;
    dzdoc:position 104 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_105_condition_0_ae5188a0> ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:litigants .

<https://legal.dz/resource/law/2008-02-25/08-09#art_1052> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_2_sec_6_subsec_3> ;
    dzdoc:eId "art_1052" ;
    dzdoc:fullText "يثبت حكم التحكيم بتقديم الأصل مرفقا بـ اتفاقية التحكيم أو بنسخ عنهما، تستوفي شروط صحتها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1052> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_1052_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_1052_20080225_OpEnact_edb3946dce> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_1052_obligation_0_8cd1890c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 1052" ;
    dzdoc:position 1051 ;
    dzdoc:usesTerm dzterm:arbitration_agreement .

<https://legal.dz/resource/law/2008-02-25/08-09#art_124> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_7> ;
    dzdoc:eId "art_124" ;
    dzdoc:fullText "تنفذ الإنابات القضائية دون دفع مصاريف أو رسوم . غير أن المبالغ المستحقة للشهود والخبراء والمترجمين ولأي شخص ساهم في إنجاز الإنابة القضائية ، تكون على عاتق السلطة الأجنبية ، دون الإخلال بما تنص عليه الاتفاقيات القضائية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_124> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_124_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_124_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_124_20080225_OpEnact_6966784e05> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_124_obligation_0_5307d18c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 124" ;
    dzdoc:position 123 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_124_condition_0_95744bba> ;
    dzdoc:usesTerm dzterm:judicial_delegation .

<https://legal.dz/resource/law/2008-02-25/08-09#art_127> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_8> ;
    dzdoc:eId "art_127" ;
    dzdoc:fullText "في حالة تعدد الخبراء المعينين ، يقومون بأعمال الخبرة معا، ويعدون تقريرا واحدا . إذا اختلفت آراؤهم وجب على كل واحد منهم تسبيب رأيه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_127> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_127_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_127_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_127_20080225_OpEnact_1b0099e6ba> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_127_obligation_0_6d6030b4>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_127_obligation_1_a085c771> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 127" ;
    dzdoc:position 126 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_127_condition_0_fcb06689>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_127_condition_1_c33c05ef> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_167> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_11> ;
    dzdoc:eId "art_167" ;
    dzdoc:fullText "يتعين على القاضي إجراء مضاهاة الخطوط استنادا إلى عناصر المقارنة التي توجد بحوزته. يمكنه، عند الاقتضاء، أمر الخصوم بتقديم الوثائق التي تسمح بإجراء المقارنة مع كتابة نماذج بإملاء منه. يقبل على وجه المقارنة، لا سيما العناصر الآتية: التوقيعات التي تتضمنها العقود الرسمية، الخطوط والتوقيعات التي سبق الاعتراف بها، الجزء من المستند موضوع المضاهاة الذي لم يتم إنكاره."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_167> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_167_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_167_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_167_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_167_20080225_OpEnact_c8999d441f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_167_obligation_0_8947df7b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "167" ;
    dzdoc:position 166 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_169> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_11> ;
    dzdoc:eId "art_169" ;
    dzdoc:fullText "يجوز للقاضي أن يأمر ولو من تلقاء نفسه وتحت طائلة غرامة تهديدية، بإحضار الأصل أو نسخة من الوثائق التي بحوزة الغير إذا كانت مقارنتها بالمحرر المنازع فيه مفيدة. تودع هذه الوثائق بأمانة ضبط الجهة القضائية مقابل وصل. يأمر القاضي باتخاذ التدابير اللازمة التي من شأنها المحافظة على هذه الوثائق والاطلاع عليها أو نسخها أو إرجاعها أو إعادة إدراجها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_169_permission_0_3fa42909> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_169> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_169_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_169_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_169_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_169_20080225_OpEnact_5c54b689cc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_169_obligation_0_b0178dce> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "169" ;
    dzdoc:position 168 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_174> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_11> ;
    dzdoc:eId "art_174" ;
    dzdoc:fullText "إذا ثبت من مضاهاة الخطوط أن المحرر محل النزاع مكتوب أو موقع عليه من الخصم الذي أنكره ، يحكم عليه بغرامة مدنية من خمسة آلاف دينار (5000) دج إلى خمسين ألف دينار (50.000 دج) ، دون المساس بحق المطالبة بالتعويضات المدنية والمصاريف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_174> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_174_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_174_20080225_OpEnact_ea5788f2f8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_174_obligation_0_b249cd73> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 174" ;
    dzdoc:position 173 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_174_condition_0_a4aa8ab5> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_180> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_13> ;
    dzdoc:eId "art_180" ;
    dzdoc:fullText "يثار الادعاء الفرعي بالتزوير بمذكرة تودع أمام القاضي الذي ينظر في الدعوى الأصلية. وتتضمن هذه المذكرة بدقة، الأوجه التي يستند عليها الخصم لإثبات التزوير، تحت طائلة عدم قبول الادعاء. يجب على المدعي في الطلب الفرعي تبليغ هذه المذكرة إلى خصمه ، ويحدد القاضي الأجل الذي يمنحه للمدعى عليه للرد على هذا الطلب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_180> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_180_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_180_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_180_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_180_20080225_OpEnact_bd8429fea5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_180_obligation_0_c2bea1d1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_180_obligation_1_3e65f952> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "180" ;
    dzdoc:position 179 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_183> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_13> ;
    dzdoc:eId "art_183" ;
    dzdoc:fullText "إذا قضى الحكم بثبوت التزوير ، يأمر إما بإزالة أو إتلاف المحرر أو شطبه كليا أو جزئيا وإما بتعديله. يسجل المنطوق على هامش العقد المزور. يقرر القاضي إما إعادة إدراج أصل العقد الرسمي ضمن المحفوظات التي استخرج منها أو حفظه بأمانة الضبط. يخضع الحكم الفاصل في دعوى التزوير الفرعية إلى جميع طرق الطعن."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_183> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_183_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_183_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_183_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_183_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_183_20080225_OpEnact_23d408f9c8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "183" ;
    dzdoc:position 182 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_183_condition_0_2c4bf082> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_202> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_5_sec_3> ;
    dzdoc:eId "art_202" ;
    dzdoc:fullText "لا يجوز للغير المدخل في الخصام أن يثير الدفع بعدم الاختصاص الإقليمي للجهة القضائية المكلف بالحضور أمامها، حتى ولو استند على شرط محدد للاختصاص."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_202_permission_0_ff82c4f4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_202> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_202_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_202_20080225_OpEnact_84510e4075> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_202_prohibition_0_ff82c4f4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "202" ;
    dzdoc:position 201 ;
    dzdoc:usesTerm dzterm:litigation,
        dzterm:plea_of_incompetence .

<https://legal.dz/resource/law/2008-02-25/08-09#art_211> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_6_sec_2> ;
    dzdoc:eId "art_211" ;
    dzdoc:fullText "يدعو القاضي شفاهة، فور علمه بسبب انقطاع الخصومة ، كل من له صفة ليقوم باستئناف السير فيها أو يختار محام جديد. كما يمكن للقاضي دعوة الخصم الذي يعينه لاستئناف سير الخصومة عن طريق التكليف بالحضور ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_211_permission_0_f72aa67c> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_211_right_0_632b2379> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_211> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_211_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_211_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_211_20080225_OpEnact_05c044b321> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_211_obligation_0_971e83d2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 211" ;
    dzdoc:position 210 ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:litigation .

<https://legal.dz/resource/law/2008-02-25/08-09#art_222> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_6_sec_5> ;
    dzdoc:eId "art_222" ;
    dzdoc:fullText "تسقط الخصومة نتيجة تخلف الخصوم عن القيام بالمساعي اللازمة . يجوز للخصوم تقديم طلب السقوط ، إما عن طريق دعوى أو عن طريق دفع يثيره أحدهم قبل أية مناقشة في الموضوع."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_222_permission_0_32775632> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_222_right_0_c296b95c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_222> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_222_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_222_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_222_20080225_OpEnact_7a4da04c7f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_222_obligation_0_a90283f9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 222" ;
    dzdoc:position 221 ;
    dzdoc:usesTerm dzterm:خصومة .

<https://legal.dz/resource/law/2008-02-25/08-09#art_231> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:definesTerm dzterm:التنازل ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_6_sec_6> ;
    dzdoc:eId "art_231" ;
    dzdoc:fullText "التنازل هو إمكانية مخولة للمدعي لإنهاء الخصومة، ولا يترتب عليه التخلي عن الحق في الدعوى. يتم التعبير عن التنازل ، إما كتابيا وإما بتصريح يثبت بمحضر يحرره رئيس أمناء الضبط ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_231> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_231_defocc_f24474769416> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_231_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_231_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_231_20080225_OpEnact_cc31ba45b7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 231" ;
    dzdoc:position 230 ;
    dzdoc:usesTerm dzterm:التنازل,
        dzterm:رئيس_أمناء_الضبط .

<https://legal.dz/resource/law/2008-02-25/08-09#art_248> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_7_sec_2> ;
    dzdoc:eId "art_248" ;
    dzdoc:fullText "يمكن للنائب العام لدى المحكمة العليا ، إذا أخطر بطلب إحالة قضية لسبب يتعلق بالأمن العام ، أن يقدم التماسات إلى المحكمة العليا تهدف إلى تلبية هذا الطلب. يفصل في هذا الطلب خلال ثمانية (8) أيام في غرفة المشورة من قبل الرئيس الأول ورؤساء الغرف ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_248_permission_0_5b129230> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_248> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_248_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_248_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_248_20080225_OpEnact_5ce26d3b96> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_248_obligation_0_06d53e65> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "248" ;
    dzdoc:position 247 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_248_condition_0_66422ee2> ;
    dzdoc:usesTerm dzterm:prosecutor_general,
        dzterm:supreme_court .

<https://legal.dz/resource/law/2008-02-25/08-09#art_250> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_7_sec_3> ;
    dzdoc:eId "art_250" ;
    dzdoc:fullText "يقدم طلب الإحالة بسبب الشبهة المشروعة طبقا لنفس الأشكال المقررة لعريضة افتتاح الدعوى ، ويفصل رئيس الجهة القضائية المعنية في هذا الطلب بأمر خلال ثمانية (8) أيام. إذا رأى رئيس الجهة القضائية أن الطلب مؤسس ، يقوم إما بتعيين تشكيلة جديدة، أو يرفع الطلب إلى رئيس الجهة القضائية الأعلى مباشرة ، لتعيين جهة الإحالة . هذا الأمر غير قابل لأي طعن."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_250> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_250_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_250_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_250_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_250_20080225_OpEnact_ce9fa00010> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_250_obligation_0_9c6b0ade>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_250_obligation_1_271f0b46> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 250" ;
    dzdoc:position 249 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_250_condition_0_e30d197d> ;
    dzdoc:usesTerm dzterm:طلب_الإحالة_بسبب_الشبهة_المشروعة .

<https://legal.dz/resource/law/2008-02-25/08-09#art_270> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_8_sec_1_subsec_2> ;
    dzdoc:eId "art_270" ;
    dzdoc:fullText "يصدر الحكم الفاصل في النزاع بأغلبية الأصوات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_270> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_270_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_270_20080225_OpEnact_c09b0145b5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_270_obligation_0_4eeb83ec> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 270" ;
    dzdoc:position 269 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_287> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:definesTerm dzterm:material_error ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_8_sec_1_subsec_2> ;
    dzdoc:eId "art_287" ;
    dzdoc:fullText "يقصد بالخطأ المادي عرض غير صحيح لواقعة مادية أو تجاهل وجودها. غير أن تصحيح الخطأ المادي أو الإغفال لا يؤدي إلى تعديل ما قضى به الحكم من حقوق و التزامات للأطراف."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_287_right_0_c136aecf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_287> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_287_defocc_f3c398b7ad3c> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_287_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_287_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_287_20080225_OpEnact_10598dce8a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_287_obligation_0_429b9a3c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "287" ;
    dzdoc:position 286 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_310> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:definesTerm dzterm:ex_parte_order ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_8_sec_5_subsec_4> ;
    dzdoc:eId "art_310" ;
    dzdoc:fullText "الأمر على عريضة أمر مؤقت يصدر دون حضور الخصم ، ما لم ينص القانون على خلاف ذلك . تقدم الطلبات الرامية إلى إثبات الحالة أو توجيه إنذار أو إجراء استجواب في موضوع لا يمس بحقوق الأطراف، إلى رئيس الجهة القضائية المختصة ، ليفصل فيها خلال أجل أقصاه ثلاثة (3) أيام من تاريخ إيداع الطلب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_310> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_310_defocc_e2c94349127c> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_310_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_310_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_310_20080225_OpEnact_d97e9f3027> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_310_obligation_0_1f776815> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 310" ;
    dzdoc:position 309 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_310_condition_0_df257e89> ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_313> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:definesTerm dzterm:extraordinary_appeals,
        dzterm:ordinary_appeals ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_1> ;
    dzdoc:eId "art_313" ;
    dzdoc:fullText "طرق الطعن العادية هي الاستئناف و المعارضة . طرق الطعن غير العادية هي اعتراض الغير الخارج عن الخصومة و التماس إعادة النظر و الطعن بالنقض . يبدأ سريان أجل الطعن ابتداء من تاريخ التبليغ الرسمي للحكم. ويسري هذا الأجل كذلك في حق من قام بالتبليغ الرسمي. يعتبر الاعتراف كتابة بالتبليغ الرسمي أثناء سير الخصومة، بمثابة التبليغ الرسمي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_313> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_313_defocc_79da9c6128a0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_313_defocc_9c9f399c90df> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_313_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_313_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_313_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_313_para_3>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_313_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_313_20080225_OpEnact_c770a62219> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 313" ;
    dzdoc:position 312 ;
    dzdoc:usesTerm dzterm:appeal,
        dzterm:appeal_period,
        dzterm:cassation,
        dzterm:official_notification,
        dzterm:opposition,
        dzterm:reconsideration,
        dzterm:third_party_opposition .

<https://legal.dz/resource/law/2008-02-25/08-09#art_340> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_2_subsec_3> ;
    dzdoc:eId "art_340" ;
    dzdoc:fullText "ينقل الاستئناف إلى المجلس القضائي مقتضيات الحكم التي يشير إليها هذا الاستئناف صراحة أو ضمنيا أو المقتضيات الأخرى المرتبطة بها. يمكن أن يقتصر الاستئناف على بعض مقتضيات الحكم. يتم نقل الخصومة برمتها عندما يهدف الاستئناف إلى إلغاء الحكم أو إذا كان موضوع النزاع غير قابل للتجزئة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_340_permission_0_3b1bbd45> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_340> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_340_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_340_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_340_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_340_20080225_OpEnact_754946f6cd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "340" ;
    dzdoc:position 339 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_340_condition_0_f5685e63> ;
    dzdoc:usesTerm dzterm:استئناف,
        dzterm:المجلس_القضائي .

<https://legal.dz/resource/law/2008-02-25/08-09#art_345> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_2_subsec_3> ;
    dzdoc:eId "art_345" ;
    dzdoc:fullText "يجوز تقديم الطلبات المقابلة خلال النظر في الاستئناف ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_345_permission_0_bd6eb815> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_345_right_0_08ed685e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_345> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_345_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_345_20080225_OpEnact_d414c2bd2b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "345" ;
    dzdoc:position 344 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_354> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_3_subsec_1> ;
    dzdoc:eId "art_354" ;
    dzdoc:fullText "يرفع الطعن بالنقض في أجل شهرين (2) يبدأ من تاريخ التبليغ الرسمي للحكم المطعون فيه إذا تم شخصيا . ويمدد أجل الطعن بالنقض إلى ثلاثة (3) أشهر، إذا تم التبليغ الرسمي في موطنه الحقيقي أو المختار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_354> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_354_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_354_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_354_20080225_OpEnact_f33d071de9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_354_obligation_0_83642c9f>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_354_obligation_1_2468eae8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "354" ;
    dzdoc:position 353 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_368> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_3_subsec_1> ;
    dzdoc:eId "art_368" ;
    dzdoc:fullText "يجوز للأطراف إثارة أوجه جديدة لتدعيم ادعاءاتهم . لا تقبل الأوجه الرامية إلى عدم قبول الاستئناف، إذا لم يثرها الخصم الذي قدم طلباته في الموضوع أمام الجهة القضائية التي أصدرت الحكم أو القرار المنقوض ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_368_permission_0_c6296d80> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_368_right_0_d7f1f3af> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_368> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_368_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_368_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_368_20080225_OpEnact_8a30e3386c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 368" ;
    dzdoc:position 367 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_368_condition_0_5099ae29> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_2_sec_4> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "يؤول الاختصاص الإقليمي للجهة القضائية التي يقع في دائرة اختصاصها موطن المدعى عليه ، و إن لم يكن له موطن معروف ، فيعود الاختصاص للجهة القضائية التي يقع فيها آخر موطن له، و في حالة اختيار موطن ، يؤول الاختصاص الإقليمي للجهة القضائية التي يقع فيها الموطن المختار، ما لم ينص القانون على خلاف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_37_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_37_20080225_OpEnact_704f2fba9d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "37" ;
    dzdoc:position 36 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_37_condition_0_9bf31c49>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_37_condition_1_829fe4e0> ;
    dzdoc:usesTerm dzterm:domicile,
        dzterm:jurisdiction .

<https://legal.dz/resource/law/2008-02-25/08-09#art_381> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_3_subsec_2> ;
    dzdoc:eId "art_381" ;
    dzdoc:fullText "يجوز لكل شخص له مصلحة ولم يكن طرفا ولا ممثلا في الحكم أو القرار أو الأمر المطعون فيه، تقديم اعتراض الغير الخارج عن الخصومة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_381_permission_0_0d4e99a9> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_381_right_0_0d4e99a9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_381> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_381_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_381_20080225_OpEnact_5450aceebf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 381" ;
    dzdoc:position 380 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_389> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_3_subsec_2> ;
    dzdoc:eId "art_389" ;
    dzdoc:fullText "يجوز الطعن في الحكم أو القرار أو الأمر الصادر في اعتراض الغير الخارج عن الخصومة بنفس طرق الطعن المقررة للأحكام ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_389_permission_0_0c543c49> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_389_right_0_0d9b7e86> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_389> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_389_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_389_20080225_OpEnact_906826c373> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 389" ;
    dzdoc:position 388 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_391> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_3_subsec_3> ;
    dzdoc:eId "art_391" ;
    dzdoc:fullText "لا يجوز تقديم التماس إعادة النظر ، إلا ممن كان طرفا في الحكم أو القرار أو الأمر، أو تم استدعاؤه قانونا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_391_permission_0_1bc8d10b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_391> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_391_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_391_20080225_OpEnact_4172d1caf3> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_391_prohibition_0_1bc8d10b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 391" ;
    dzdoc:position 390 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_391_condition_0_1bc8d10b> ;
    dzdoc:usesTerm dzterm:التماس_إعادة_النظر .

<https://legal.dz/resource/law/2008-02-25/08-09#art_396> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_9_sec_3_subsec_3> ;
    dzdoc:eId "art_396" ;
    dzdoc:fullText "لا يجوز تقديم التماس إعادة النظر من جديد في الحكم أو القرار أو الأمر الفاصل في الالتماس."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_396_permission_0_dd8a5b86> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_396> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_396_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_396_20080225_OpEnact_5b4766e509> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_396_prohibition_0_dd8a5b86> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 396" ;
    dzdoc:position 395 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_396_condition_0_dd8a5b86> ;
    dzdoc:usesTerm dzterm:التماس_إعادة_النظر .

<https://legal.dz/resource/law/2008-02-25/08-09#art_408> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_11_sec_2> ;
    dzdoc:eId "art_408" ;
    dzdoc:fullText "يجب أن يتم التبليغ الرسمي شخصيا. ويعتبر التبليغ الرسمي إلى الشخص المعنوي شخصيا، إذا سلم محضر التبليغ إلى ممثله القانوني أو الاتفاقي أو لأي شخص تم تعيينه لهذا الغرض . يتم التبليغ الرسمي ، الموجه إلى الإدارات والجماعات الإقليمية والمؤسسات العمومية ذات الصبغة الإدارية، إلى الممثل المعين لهذا الغرض وبمقرها. يتم التبليغ الرسمي ، الموجه إلى شخص معنوي في حالة تصفية، إلى المصفي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_408> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_408_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_408_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_408_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_408_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_408_20080225_OpEnact_d395212a26> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_408_obligation_0_043f3d5d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "408" ;
    dzdoc:position 407 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_408_condition_0_58c6bbb6> ;
    dzdoc:usesTerm dzterm:official_notification .

<https://legal.dz/resource/law/2008-02-25/08-09#art_419> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_12> ;
    dzdoc:eId "art_419" ;
    dzdoc:fullText "يتحمل الخصم الذي خسر الدعوى المصاريف المترتبة عليها ، ما لم يقرر القاضي تحميلها كليا أو جزئيا لخصم آخر مع تسبيب ذلك . وفي حالة تعدد الخصوم الخاسرين الدعوى ، يجوز للقاضي الأمر بتحميل المصاريف لكل واحد منهم حسب النسب التي يحددها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_419_permission_0_f19cdfd8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_419> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_419_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_419_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_419_20080225_OpEnact_821121f42a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_419_obligation_0_59788894> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 419" ;
    dzdoc:position 418 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_419_condition_0_a78f88b9>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_419_condition_1_998b5f87> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_438> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_438" ;
    dzdoc:fullText "يجب على المدعي في دعوى الطلاق أن يبلغ رسميا المدعى عليه والنيابة العامة بنسخة من العريضة المشار إليها في المادة 436 أعلاه . ويجوز له أيضا تبليغ النيابة العامة عن طريق أمانة الضبط ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_438_right_0_072c5a98> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_438> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_438_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_438_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_438_20080225_OpEnact_d862783e8c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_438_obligation_0_a77c8b49> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 438" ;
    dzdoc:position 437 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_436> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_436> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_440> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_440" ;
    dzdoc:fullText "في التاريخ المحدد لإجراء محاولة الصلح، يستمع القاضي إلى كل زوج على انفراد ثم معا . ويمكن بناء على طلب الزوجين حضور أحد أفراد العائلة والمشاركة في محاولة الصلح ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_440_right_0_13355d5f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_440> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_440_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_440_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_440_20080225_OpEnact_2fdaedfb8d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_440_obligation_0_f4c7c27b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 440" ;
    dzdoc:position 439 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_442> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_442" ;
    dzdoc:fullText "يمكن للقاضي منح الزوجين مهلة تفكير لإجراء محاولة صلح جديدة، كما يجوز له اتخاذ ما يراها لازما من التدابير المؤقتة بموجب أمر غير قابل لأي طعن. في جميع الحالات، يجب ألا تتجاوز محاولات الصلح ثلاثة (3) أشهر من تاريخ رفع دعوى الطلاق ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_442_permission_0_80621887> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_442> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_442_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_442_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_442_20080225_OpEnact_8c67a13cd9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_442_obligation_0_46f24615> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 442" ;
    dzdoc:position 441 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_466> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_466" ;
    dzdoc:fullText "عند قيام القاضي، تلقائيا، بمراقبة الولاية أو بناء على طلب النيابة العامة ، يجوز له استدعاء كل شخص يرى سماعه مفيدا. وفي الحالات الأخرى، يكون التكليف بالحضور على عاتق المدعي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_466_permission_0_a87def87> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_466> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_466_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_466_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_466_20080225_OpEnact_2b896859ce> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 466" ;
    dzdoc:position 465 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_466_condition_0_10cfb589> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_471> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_471" ;
    dzdoc:fullText "يعين القاضي المقدم بموجب أمر ولائي بعد التأكد من رضائه. يجب على المقدم أن يقدم دوريا وطبقا لما يحدده القاضي، عرضا عن إدارة أموال القاصر وعن أي إشكال أو طارئ له علاقة بهذه الإدارة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_471> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_471_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_471_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_471_20080225_OpEnact_1f42f911d3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_471_obligation_0_cb4f520a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 471" ;
    dzdoc:position 470 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_472> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_472" ;
    dzdoc:fullText "يخطر القاضي من قبل الوصي أو ممثل النيابة العامة أو القاصر الذي بلغ سن التمييز أو كل شخص تهمه مصلحة القاصر بتثبيت الوصاية أو رفضها بعد وفاة الأب. في حالة رفض الوصاية ، يعين القاضي مقدما طبقا ل المادة 471 أعلاه، أو يتخذ جميع الإجراءات التحفظية في انتظار تعيين المقدم. يجوز للقاضي وضع القاصر تحت وصاية الوصي المختار عندما تتوفر فيه الشروط المقررة قانونا. يفصل في جميع المنازعات الخاصة بتعيين الوصي بأمر استعجالي قابل لجميع طرق الطعن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_472_permission_0_53e90476> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_472> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_472_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_472_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_472_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_472_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_472_20080225_OpEnact_7f810b9acf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 472" ;
    dzdoc:position 471 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_471> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_471> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_472_condition_0_94c662a0> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_484> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_484" ;
    dzdoc:fullText "يتلقى القاضي تصريحات الشخص المعني بإجراء التقديم، بحضور محاميه والأشخاص المعنيين. وإذا رأى ضرورة لذلك يتلقى هذه التصريحات بحضور الطبيب المعالج وممثل النيابة العامة. إذا استحال على القاضي سماع أقوال الشخص المعني بإجراء التقديم أو إذا كان سماعه من شأنه أن يضر بصحته ، يجوز له صرف النظر عن هذا السماع."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_484_permission_0_9d4f94dd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_484> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_484_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_484_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_484_20080225_OpEnact_260aa62300> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 484" ;
    dzdoc:position 483 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_484_condition_0_e30a1fe7> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_527> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_3_subsec_5> ;
    dzdoc:eId "art_527" ;
    dzdoc:fullText "لا يجوز للمحكمة المطروح عليها دعوى الحيازة أن تفصل في الملكية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_527_permission_0_5aa63b20> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_527> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_527_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_527_20080225_OpEnact_1a609dbb42> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_527_obligation_0_0c0c28af> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_527_prohibition_0_5aa63b20> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "527" ;
    dzdoc:position 526 ;
    dzdoc:usesTerm dzterm:possessory_actions .

<https://legal.dz/resource/law/2008-02-25/08-09#art_528> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_3_subsec_5> ;
    dzdoc:eId "art_528" ;
    dzdoc:fullText "إذا ادعى كل من المدعي والمدعى عليه الحيازة، وقدم كل منهما دليلا على حيازته ، يجوز للقاضي إما أن يعين حارسا قضائيا أو أن يسند حراسة المال المتنازع عليه إلى أحد أطراف الخصومة، مع إلزامه بتقديم حساب عن الثمار، عند الاقتضاء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_528_permission_0_f3c2afc4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_528> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_528_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_528_20080225_OpEnact_8a5d84094c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_528_obligation_0_95e91ead> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "528" ;
    dzdoc:position 527 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_528_condition_0_1f2d2f46> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_536> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_536" ;
    dzdoc:fullText "يمكن ل رئيس القسم التجاري ، أن يتخذ عن طريق الاستعجال الإجراءات المؤقتة أو التحفظية للحفاظ على الحقوق موضوع النزاع وفق الإجراءات المنصوص عليها في هذا القانون والنصوص الخاصة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_536_permission_0_265dba2a> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_536_right_0_132bd493> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_536> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_536_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_536_20080225_OpEnact_5145bc0553> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "536" ;
    dzdoc:position 535 ;
    dzdoc:usesTerm dzterm:head_commercial_section .

<https://legal.dz/resource/law/2008-02-25/08-09#art_538> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_538" ;
    dzdoc:fullText "تمثيل الخصوم أمام المجلس القضائي من طرف محام وجوبي تحت طائلة عدم قبول الاستئناف ، ما لم ينص هذا القانون على خلاف ذلك . لا يكون تمثيل الأطراف بمحام وجوبيا في مادة شؤون الأسرة والمادة الاجتماعية بالنسبة للعمال. تعفى الدولة والولاية والبلدية والمؤسسات العمومية ذات الصبغة الإدارية من التمثيل الوجوبي بمحام."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_538> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_538_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_538_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_538_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_538_20080225_OpEnact_433440d5a7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_538_obligation_0_394d5f09> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 538" ;
    dzdoc:position 537 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_538_condition_0_daa2ee87>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_538_condition_1_b90247eb> ;
    dzdoc:usesTerm dzterm:court_of_appeal,
        dzterm:lawyer .

<https://legal.dz/resource/law/2008-02-25/08-09#art_54> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_54" ;
    dzdoc:fullText "يجب على الجهة القضائية الأخيرة التي رفع إليها النزاع أن تتخلى لصالح الجهة الأخرى ، إذا طلب أحد الخصوم ذلك . ويجوز للقاضي أن يتخلى عن الفصل تلقائيا إذا تبين له وحدة الموضوع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_54> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_54_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_54_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_54_20080225_OpEnact_668daa9d10> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_54_obligation_0_a521683a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "54" ;
    dzdoc:position 53 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_54_condition_0_c4bff53d>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_54_condition_1_54249e56> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_546> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_2_sec_3> ;
    dzdoc:eId "art_546" ;
    dzdoc:fullText "يودع تقرير المستشار المقرر بأمانة ضبط الغرفة ثمانية (8) أيام على الأقل قبل انعقاد جلسة المرافعات ، ليتسنى للخصوم الاطلاع عليه . يحدد رئيس الغرفة جدول القضايا لكل جلسة ، و يأمر رئيس أمانة الضبط بتعليق نسخة منه بمدخل قاعة الجلسات وإبلاغه إلى ممثل النيابة العامة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_546_right_0_b510f417> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_546> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_546_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_546_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_546_20080225_OpEnact_d36aef2e33> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_546_obligation_0_4b511d82>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_546_obligation_1_3f6c34ae>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_546_obligation_2_ae582ad9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "546" ;
    dzdoc:position 545 ;
    dzdoc:usesTerm dzterm:president_chamber,
        dzterm:reporting_judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_555> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_2_sec_4> ;
    dzdoc:eId "art_555" ;
    dzdoc:fullText "يوقع الرئيس وأمين الضبط والمستشار المقرر إن اقتضى الأمر على أصل القرار الذي يحفظ في أرشيف الجهة القضائية. يحفظ أيضا ملف القضية في أرشيف الجهة القضائية. يستعيد الخصوم دون سواهم أو بوكالة خاصة، الوثائق المملوكة لهم بناء على طلبهم مقابل وصل بالاستلام."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_555_right_0_bb36a387> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_555> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_555_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_555_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_555_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_555_20080225_OpEnact_071bab3a90> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_555_obligation_0_92928d00> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "555" ;
    dzdoc:position 554 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_562> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_3_sec_2> ;
    dzdoc:eId "art_562" ;
    dzdoc:fullText "يتم التصريح بالطعن بالنقض من طرف الطاعن أو محاميه، في محضر يعده أمين الضبط الرئيسي لدى المحكمة العليا أو المجلس القضائي أو أمين الضبط الذي يفوضه لهذا الغرض . يتضمن المحضر البيانات الآتية : 1- اسم ولقب وموطن الطاعن، وإذا تعلق الطعن بشخص معنوي بيان تسميته وطبيعته ومقره الاجتماعي وصفة ممثله القانوني أو الاتفاقي، 2 - اسم ولقب وموطن المطعون ضده أو ضدهم، وإذا تعلق الطعن بشخص معنوي بيان تسميته ومقره الاجتماعي. 3- تاريخ وطبيعة القرار المطعون فيه. يوقع المحضر حسب الحالة، من طرف أمين الضبط الرئيسي أو أمين الضبط الذي يفوضه لهذا الغرض لدى المحكمة العليا أو المجلس القضائي والقائم بالتصريح . تسلم نسخة منه إلى القائم بالتصريح بغرض تبليغه الرسمي للمطعون ضده ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_562> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_562_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_562_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_562_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_562_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_562_20080225_OpEnact_2fcfe68398> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_562_obligation_0_3d22007a>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_562_obligation_1_5eeb932a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "562" ;
    dzdoc:position 561 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_562_condition_0_820f80d6> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_563> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_3_sec_3> ;
    dzdoc:eId "art_563" ;
    dzdoc:fullText "يلزم الطاعن بتبليغ المطعون ضده رسميا، خلال أجل شهر واحد (1)، من تاريخ التصريح بالطعن بالنقض ، بنسخة من محضر التصريح وتنبيهه بأنه يجب عليه تأسيس محام إذا رغب في الدفاع عن نفسه . وللطاعن أجل شهرين (2) ، ابتداء من تاريخ التصريح بالطعن بالنقض، لإيداع العريضة بأمانة ضبط المحكمة العليا أو المجلس القضائي، يعرض فيها الأوجه القانونية لتأسيس طعنه ، وذلك تحت طائلة عدم قبول الطعن بالنقض شكلا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_563> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_563_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_563_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_563_20080225_OpEnact_5be25d6b60> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_563_obligation_0_6a84d5f0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_563_obligation_1_a71d7068> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 563" ;
    dzdoc:position 562 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_563_condition_0_1c315ef1> ;
    dzdoc:usesTerm dzterm:appellant,
        dzterm:appellee .

<https://legal.dz/resource/law/2008-02-25/08-09#art_568> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_2_chp_3_sec_5> ;
    dzdoc:eId "art_568" ;
    dzdoc:fullText "للمطعون ضده أجل شهرين (2) ، ابتداء من تاريخ التبليغ الرسمي لعريضة الطعن بالنقض، لتقديم مذكرة جواب موقعة من طرف محام معتمد لدى المحكمة العليا ، إلى أمين الضبط الرئيسي للمحكمة العليا أو المجلس القضائي ، وتبليغها لمحامي الطاعن، وذلك تحت طائلة عدم القبول التلقائي . يجب أن تتضمن مذكرة الجواب الرد على أوجه الطعن المثارة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_568_right_0_ed6cf692> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_568> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_568_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_568_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_568_20080225_OpEnact_0650939172> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_568_obligation_0_2cfe4187> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "568" ;
    dzdoc:position 567 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_568_condition_0_286b06d5> ;
    dzdoc:usesTerm dzterm:chief_clerk,
        dzterm:judicial_council,
        dzterm:lawyer .

<https://legal.dz/resource/law/2008-02-25/08-09#art_584> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_1> ;
    dzdoc:eId "art_584" ;
    dzdoc:fullText "يقدم عرض الوفاء بواسطة محضر قضائي في الموطن الحقيقي أو المختار للدائن ، ويبلغ رسميا وفقا لأحكام هذا القانون. يتضمن محضر العرض : اسم ولقب المدين وموطنه، اسم ولقب الدائن وموطنه الحقيقي أو المختار، وصف الشيء المعروض بحيث لا يمكن استبداله بغيره، وإن كان الشيء المعروض نقودا يحدد مقدارها ونوعها، ذكر أسباب العرض، رفض أو قبول الدائن للعرض، توقيع الدائن أو الشخص المبلغ له العرض، أو الإشارة إلى رفض التوقيع أو عدم قدرته على ذلك، تنبيه الدائن بأنه في حالة رفض العرض سيتم الإيداع في المكان واليوم والساعة المحددة في طلب العرض، وأنه سيسقط حقه في المطالبة به، بعد مضي سنة واحدة (1) تسري من تاريخ الإيداع."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_584_permission_0_7d6ba6c8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_584> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_584_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_584_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_584_20080225_OpEnact_1f74602a5c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_584_obligation_0_84d18f41> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "584" ;
    dzdoc:position 583 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_584_condition_0_1bc5b4de> ;
    dzdoc:usesTerm dzterm:judicial_bailiff,
        dzterm:tender_of_payment .

<https://legal.dz/resource/law/2008-02-25/08-09#art_614> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_4_sec_3_subsec_1> ;
    dzdoc:eId "art_614" ;
    dzdoc:fullText "يجوز إجراء التنفيذ الجبري بمجرد التبليغ الرسمي للتكليف بالوفاء بما تضمنه السند التنفيذي ، دون مراعاة الآجال المنصوص عليها في المادة 612 أعلاه ، فيما يأتي : إذا كان التنفيذ يتم بموجب أمر استعجالي ، إذا كان التنفيذ يتم بموجب حكم مشمول بالنفاذ المعجل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_614_permission_0_8962adfc> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_614_right_0_e53147f1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_614> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_614_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_614_20080225_OpEnact_3f7c4565ed> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "614" ;
    dzdoc:position 613 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_612> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_612> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_614_condition_0_21316923>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_614_condition_1_f5de0a3d> ;
    dzdoc:usesTerm dzterm:enforcement,
        dzterm:enforcement_title,
        dzterm:official_notification .

<https://legal.dz/resource/law/2008-02-25/08-09#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_3_sec_2_subsec_4> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "يجوز للقاضي أن يمنح أجلا للخصوم لتصحيح الإجراء المشوب بالبطلان ، بشرط عدم بقاء أي ضرر قائم بعد التصحيح . يسري أثر هذا التصحيح من تاريخ الإجراء المشوب بالبطلان."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_62_permission_0_c60e80b9> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_62_right_0_19e75ef9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_62_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_62_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_62_20080225_OpEnact_7c5ee487ae> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "62" ;
    dzdoc:position 61 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_62_condition_0_972f7b58> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_63> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_3_sec_2_subsec_4> ;
    dzdoc:eId "art_63" ;
    dzdoc:fullText "لا يجوز التمسك ببطلان الأعمال الإجرائية شكلا، إلا لمن تقرر البطلان لصالحه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_63_permission_0_f4c15dcd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_63> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_63_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_63_20080225_OpEnact_5f3b7660ca> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_63_obligation_0_592d4f0f> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_63_prohibition_0_f4c15dcd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "63" ;
    dzdoc:position 62 ;
    dzdoc:usesTerm dzterm:procedural_acts .

<https://legal.dz/resource/law/2008-02-25/08-09#art_648> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_2_subsec_1> ;
    dzdoc:eId "art_648" ;
    dzdoc:fullText "يجوز توقيع الحجز التحفظي، خلال وجود دعوى أمام قاضي الموضوع ، وفي هذه الحالة، يقدم طلب تثبيت الحجز أمام نفس قاضي الموضوع بمذكرة إضافية تضم إلى أصل الدعوى للفصل فيهما معا وبحكم واحد، دون مراعاة الأجل المنصوص عليه في المادة 662 أدناه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_648_permission_0_c21c4edd> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_648_right_0_4821e8b1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_648> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_648_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_648_20080225_OpEnact_37b849d718> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "648" ;
    dzdoc:position 647 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_662> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_662> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_653> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_2_subsec_4> ;
    dzdoc:eId "art_653" ;
    dzdoc:fullText "يجوز ل مؤجر المباني أن يحجز تحفظيا على منقولات مستأجريه الموجودة في هذه المباني وفاء للأجرة المستحقة عن الإيجار ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_653_permission_0_b32d6655> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_653_right_0_82064ac5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_653> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_653_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_653_20080225_OpEnact_7427dc47c9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "653" ;
    dzdoc:position 652 ;
    dzdoc:usesTerm dzterm:lessor .

<https://legal.dz/resource/law/2008-02-25/08-09#art_654> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_2_subsec_4> ;
    dzdoc:eId "art_654" ;
    dzdoc:fullText "يجوز ل مؤجر الأراضي الزراعية أو الحقول أو البساتين ، أن يحجز تحفظيا على المزروعات والثمار الموجودة في تلك الأراضي، وفاء للأجرة المستحقة عن إيجارها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_654_permission_0_a01d6388> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_654_right_0_d7c48111> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_654> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_654_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_654_20080225_OpEnact_5ae7bff92d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "654" ;
    dzdoc:position 653 ;
    dzdoc:usesTerm dzterm:lessor .

<https://legal.dz/resource/law/2008-02-25/08-09#art_682> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_3_subsec_3> ;
    dzdoc:eId "art_682" ;
    dzdoc:fullText "يمنع على المحجوز لديه الوفاء من المبالغ المحجوزة للمدين المحجوز عليه من تاريخ توقيع الحجز ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_682> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_682_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_682_20080225_OpEnact_e28371b3a4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_682_obligation_0_bb5d4cc9> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_682_prohibition_0_36cec14f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "682" ;
    dzdoc:position 681 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_691> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_4_subsec_2> ;
    dzdoc:eId "art_691" ;
    dzdoc:fullText "يجب أن يتضمن محضر الحجز والجرد ، فضلا عن البيانات المعتادة، ما يأتي : 1- بيان السند التنفيذي والأمر الذي بموجبه تم الحجز، 2 مبلغ الدين المحجوز من أجله، 3- اختيار موطن للدائن الحاجز في دائرة اختصاص المحكمة التي يوجد في دائرة اختصاصها مكان التنفيذ، 4- بيان مكان الحجز وما قام به المحضر القضائي من إجراءات، أو ما لقيه من صعوبات أو اعتراضات أثناء الحجز، وما اتخذه من تدابير، 5- تعيين الأشياء المحجوزة بالتفصيل مع تحديد نوعها و أوصافها ومقدارها ووزنها و مقاسها وقيمتها بالتقريب. و يختم المحضر بالتوقيع عليه مع المحجوز عليه إن كان حاضرا أو التنويه عن غيابه أو رفضه التوقيع. إذا خلا محضر الحجز والجرد من أحد هذه البيانات ، كان قابلا للإبطال خلال أجل عشرة (10) أيام من تاريخه. يرفع طلب الإبطال من كل ذي مصلحة عن طريق الاستعجال، يفصل فيه رئيس المحكمة خلال أجل أقصاه خمسة عشر (15) يوما."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_691> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_691_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_691_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_691_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_691_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_691_20080225_OpEnact_d4cc96f2c0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_691_obligation_0_5993038e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "691" ;
    dzdoc:position 690 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_691_condition_0_4ebe8693> ;
    dzdoc:usesTerm dzterm:enforcement_title,
        dzterm:judicial_officer,
        dzterm:seizure_report .

<https://legal.dz/resource/law/2008-02-25/08-09#art_704> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_4_subsec_6> ;
    dzdoc:eId "art_704" ;
    dzdoc:fullText "تباع الأموال المحجوزة بالمزاد العلني، بعد إعادة جردها، إما بالتجزئة أو بالجملة، وفقا لمصلحة المدين . يجري البيع بعد مضي مدة عشرة (10) أيام من تاريخ تسليم نسخة من محضر الحجز وتبليغه رسميا ، إلا إذا اتفق الحاجز والمحجوز عليه على تحديد أجل آخر لا تزيد مدته القصوى على ثلاثة (3) أشهر. غير أنه إذا كانت الأموال المحجوزة ، بضائع قابلة للتلف أو بضائع عرضة لتقلب الأسعار أو بضائع على وشك انقضاء مدة صلاحية استهلاكها ، فلرئيس المحكمة أن يأمر بإجراء البيع، بمجرد الانتهاء من الحجز والجرد وفي المكان الذي يراه مناسبا إذا كان يضمن أحسن عرض، وذلك بأمر على عريضة تقدم إليه من الحاجز أو المحجوز عليه أو المحضر القضائي أو الحارس."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_704> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_704_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_704_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_704_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_704_20080225_OpEnact_a3bbb06442> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_704_obligation_0_e0791726> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "704" ;
    dzdoc:position 703 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_704_condition_0_f97a3a4d>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_704_condition_1_1850c9a8> ;
    dzdoc:usesTerm dzterm:judicial_officer .

<https://legal.dz/resource/law/2008-02-25/08-09#art_744> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_5_subsec_8> ;
    dzdoc:eId "art_744" ;
    dzdoc:fullText "يجوز للمدين المحجوز عليه أو الحائز أو الكفيل العيني، أن يطلب بطريق الاستعجال، تأجيل إجراءات بيع العقار و/أو الحق العيني العقاري ، إذا أثبت أن الإيرادات السنوية لهذا العقار و/أو الحق العيني العقاري لسنة واحدة كافية للوفاء بديون جميع الدائنين . يحدد الأمر الفاصل بتأجيل البيع، الأجل الذي يستأنف فيه إجراءات البيع إذا لم يتم الوفاء ، مراعيا في ذلك المهلة اللازمة للمدين المحجوز عليه للوفاء، على أن لا تتجاوز سنة واحدة (1)."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_744_permission_0_7e768910> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_744_right_0_3ba705cc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_744> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_744_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_744_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_744_20080225_OpEnact_377eb19831> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "744" ;
    dzdoc:position 743 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_744_condition_0_83dd040c> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_745> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_5_subsec_8> ;
    dzdoc:eId "art_745" ;
    dzdoc:fullText "إذا وجد بين الدائنين، بائع العقار و/أو الحق العيني العقاري أو أحد المقايضين به أو الشريك المقاسم ، بلغ له المحضر القضائي إنذارا بأنه في حالة عدم رفع دعوى الفسخ لعدم دفع الثمن أو الفرق في الثمن أو طلب إعادة البيع عن طريق المزاد العلني والتأشير بذلك على قائمة شروط البيع قبل الجلسة المحددة للاعتراضات بثلاثة (3) أيام على الأقل ، وإلا سقط حقه في ذلك. غير أنه إذا رفع دعوى الفسخ أو قدم طلبا لإعادة البيع بالمزاد العلني في الأجل المحدد في الفقرة الأولى أعلاه ، قام المحضر القضائي بتأشير ذلك على قائمة شروط البيع، وتوقف عن الاستمرار في إجراءات البيع إلى حين الفصل في هذه الدعوى من طرف قاضي الموضوع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_745> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_745_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_745_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_745_20080225_OpEnact_efc9a73681> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_745_obligation_0_4c03a9c6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "745" ;
    dzdoc:position 744 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_745_condition_0_5fe405e0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_745_condition_1_7149fe34> ;
    dzdoc:usesTerm dzterm:huissier_justice .

<https://legal.dz/resource/law/2008-02-25/08-09#art_747> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_5_subsec_9> ;
    dzdoc:eId "art_747" ;
    dzdoc:fullText "إذا لم يتم تحديد تاريخ ومكان جلسة البيع بالمزاد العلني مسبقا ، يتم تحديدها بموجب أمر على عريضة، بناء على طلب المحضر القضائي أو أي دائن طرف في الحجز. يصدر رئيس المحكمة الأمر بعد التحقق من الفصل في جميع الاعتراضات التي سجلت . يخطر المحضر القضائي جميع الدائنين المقيدين والمدين المحجوز عليه والحائز والكفيل العيني إن وجد، بتاريخ وساعة ومكان جلسة البيع بالمزاد العلني، ثمانية (8) أيام قبل الجلسة على الأقل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_747> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_747_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_747_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_747_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_747_20080225_OpEnact_8a24329e11> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_747_obligation_0_7f9dfcbe>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_747_obligation_1_9e3bcda3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "747" ;
    dzdoc:position 746 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_747_condition_0_f2a6ffa1> ;
    dzdoc:usesTerm dzterm:judicial_officer .

<https://legal.dz/resource/law/2008-02-25/08-09#art_752> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_5_sec_5_subsec_9> ;
    dzdoc:eId "art_752" ;
    dzdoc:fullText "يقدر رئيس المحكمة مصاريف إجراءات التنفيذ بما فيها أتعاب المحضر القضائي بموجب أمر على عريضة ، تقدم من طرف هذا الأخير أو من أحد الدائنين، و يعلن عن هذا التقدير قبل افتتاح المزاد العلني ، و ينوه عنها في حكم رسو المزاد فيما بعد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_752> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_752_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_752_20080225_OpEnact_802c8fb091> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_752_obligation_0_d10aa4a8>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_752_obligation_1_29f0d665>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_752_obligation_2_5cdf24c1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "752" ;
    dzdoc:position 751 ;
    dzdoc:usesTerm dzterm:huissier_justice,
        dzterm:president_tribunal .

<https://legal.dz/resource/law/2008-02-25/08-09#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "يأمر القاضي ، عند الاقتضاء، الخصوم أو أحدهم، بإيداع مصاريف إجراءات التحقيق أو التسبيقات المالية بعد تحديدها ، لدى أمانة ضبط الجهة القضائية. إذا لم تودع هذه المبالغ في الآجال التي حددها القاضي ، استغنى عن الإجراء الذي أمر به، وحكم في القضية على الحالة التي هي عليها. لا يخل تطبيق أحكام هذه المادة بما هو مقرر في شأن المساعدة القضائية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_79_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_79_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_79_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_79_20080225_OpEnact_90eba7afe4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_79_obligation_0_9a3ed0fd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "79" ;
    dzdoc:position 78 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_79> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_79> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_79_condition_0_2acd8785> ;
    dzdoc:usesTerm dzterm:investigation_measure,
        dzterm:judge,
        dzterm:legal_aid,
        dzterm:parties .

<https://legal.dz/resource/law/2008-02-25/08-09#art_792> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_3_chp_6> ;
    dzdoc:eId "art_792" ;
    dzdoc:fullText "إذا كانت المبالغ المالية المتحصلة من التنفيذ غير كافية للوفاء بحقوق جميع الدائنين الحاجزين والدائنين المتدخلين في الحجز ، يجب على المحضر القضائي أو محافظ البيع وعلى كل من تكون لديه المبالغ المتحصلة من التنفيذ إيداعها بأمانة ضبط المحكمة التي تم في دائرة اختصاصها التنفيذ مع إرفاق جدول عن الأموال المحجوزة ومحضر رسو المزاد . وفي هذه الحالة، يقوم رئيس أمانة الضبط بإخطار رئيس المحكمة كتابيا من أجل توزيع المبالغ المتحصلة من التنفيذ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_792> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_792_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_792_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_792_20080225_OpEnact_b15a18a5d3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_792_obligation_0_13b3f701> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "792" ;
    dzdoc:position 791 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_792_condition_0_95d5efd1> ;
    dzdoc:usesTerm dzterm:auctioneer,
        dzterm:judicial_officer .

<https://legal.dz/resource/law/2008-02-25/08-09#art_814> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_1_subsec_6> ;
    dzdoc:eId "art_814" ;
    dzdoc:fullText "عندما يفصل مجلس الدولة في الاختصاص ، يحيل القضية أمام المحكمة الإدارية المختصة ، و لا يجوز لهذه الأخيرة التصريح بعدم اختصاصها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_814_permission_0_5db65cc0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_814> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_814_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_814_20080225_OpEnact_3913776297> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_814_obligation_0_bc4cd1a7>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_814_obligation_1_16aca4fd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 814" ;
    dzdoc:position 813 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_814_condition_0_955a7291> ;
    dzdoc:usesTerm dzterm:administrative_court,
        dzterm:council_of_state .

<https://legal.dz/resource/law/2008-02-25/08-09#art_844> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_844" ;
    dzdoc:fullText "يعين رئيس المحكمة الإدارية التشكيلة التي يؤول إليها الفصل في الدعوى ، بمجرد قيد عريضة افتتاح الدعوى بأمانة الضبط. يعين رئيس تشكيلة الحكم القاضي المقرر الذي يحدد بناء على ظروف القضية، الأجل الممنوح للخصوم من أجل تقديم المذكرات الإضافية والملاحظات وأوجه الدفاع والردود ، ويجوز له أن يطلب من الخصوم كل مستند أو أية وثيقة تفيد في فض النزاع. يجوز لرئيس تشكيلة الحكم ، عندما تقتضي ظروف القضية ، أن يحدد فور تسجيل العريضة، التاريخ الذي يختتم فيه التحقيق، ويعلم الخصوم به عن طريق أمانة الضبط."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_844_permission_0_d5082017> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_844> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_844_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_844_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_844_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_844_20080225_OpEnact_19693b4721> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_844_obligation_0_312894dc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "844" ;
    dzdoc:position 843 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_844_condition_0_e0110978> ;
    dzdoc:usesTerm dzterm:administrative_court,
        dzterm:reporting_judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_852> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_852" ;
    dzdoc:fullText "عندما تكون القضية مهيأة للفصل ، يحدد رئيس تشكيلة الحكم تاريخ اختتام التحقيق بموجب أمر غير قابل لأي طعن. يبلغ الأمر إلى جميع الخصوم برسالة مضمنة مع إشعار بالاستلام أو بأية وسيلة أخرى، في أجل لا يقل عن خمسة عشر (15) يوما قبل تاريخ الاختتام المحدد في الأمر"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_852> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_852_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_852_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_852_20080225_OpEnact_cba5e839c6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_852_obligation_0_43821c1f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 852" ;
    dzdoc:position 851 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_852_condition_0_7c117445> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_874> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_874" ;
    dzdoc:fullText "يحدد رئيس تشكيلة الحكم جدول كل جلسة أمام المحكمة الإدارية ، ويبلغ إلى محافظ الدولة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_874> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_874_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_874_20080225_OpEnact_96193ed24e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_874_obligation_0_61d2517e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "874" ;
    dzdoc:position 873 ;
    dzdoc:usesTerm dzterm:administrative_court,
        dzterm:president_formation,
        dzterm:state_commissioner .

<https://legal.dz/resource/law/2008-02-25/08-09#art_880> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_880" ;
    dzdoc:fullText "يجب على القاضي المطلوب رده أن يتنحى عن القضية، بمجرد تبليغه بطلب الرد إلى حين الفصل فيه. في حالة الاستعجال يعين رئيس الجهة القضائية الإدارية قاضيا آخر لضمان سير القضية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_880> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_880_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_880_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_880_20080225_OpEnact_f1ce6dc68a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_880_obligation_0_60451441>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_880_obligation_1_45bb2d77> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "880" ;
    dzdoc:position 879 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_880_condition_0_ce71e929> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_897> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_3_subsec_5> ;
    dzdoc:eId "art_897" ;
    dzdoc:fullText "يحيل القاضي المقرر وجوبا، ملف القضية مرفقا بالتقرير والوثائق الملحقة به إلى محافظ الدولة ، لتقديم تقريره المكتوب في أجل شهر واحد (1) من تاريخ استلامه الملف . يجب على محافظ الدولة إعادة الملف والوثائق المرفقة به إلى القاضي المقرر بمجرد انقضاء الأجل المذكور ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_897> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_897_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_897_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_897_20080225_OpEnact_3f09cd181a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_897_obligation_0_f58cffbf>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_897_obligation_1_1137dce4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "897" ;
    dzdoc:position 896 ;
    dzdoc:usesTerm dzterm:judge_rapporteur,
        dzterm:state_commissioner .

<https://legal.dz/resource/law/2008-02-25/08-09#art_91> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_1_chp_4_sec_2_subsec_3> ;
    dzdoc:eId "art_91" ;
    dzdoc:fullText "يتولى القاضي تلقائيا أو بناء على طلب أحد الخصوم أو الخبير المعين ، تسوية الإشكالات التي قد تعترض تنفيذ التحقيق المأمور به . عند إشراف القاضي على عمليات الخبرة ، يأمر أمين الضبط بتحرير محضر يدون فيه معاينته، والتوضيحات المقدمة من الخبير وتصريحات الخصوم والغير ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_91> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_91_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_91_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_91_20080225_OpEnact_e74ec93a12> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_91_obligation_0_e23dc423>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_91_obligation_1_feedbca0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 91" ;
    dzdoc:position 90 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_91_condition_0_a18e9c9a> ;
    dzdoc:usesTerm dzterm:clerk,
        dzterm:expert,
        dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_913> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_913" ;
    dzdoc:fullText "يجوز ل مجلس الدولة أن يأمر بوقف تنفيذ الحكم الصادر عن المحكمة الإدارية ، إذا كان تنفيذه من شأنه أن يعرض المستأنف لخسارة مالية مؤكدة لا يمكن تداركها، وعندما تبدو الأوجه المثارة في الاستئناف من شأنها تبرير إلغاء القرار المستأنف ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_913_permission_0_424d08d7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_913> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_913_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_913_20080225_OpEnact_7039874652> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 913" ;
    dzdoc:position 912 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_913_condition_0_43562b4a> ;
    dzdoc:usesTerm dzterm:administrative_court,
        dzterm:council_of_state .

<https://legal.dz/resource/law/2008-02-25/08-09#art_940> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_3_sec_3_subsec_2> ;
    dzdoc:eId "art_940" ;
    dzdoc:fullText "يجوز لقاضي الاستعجال ، بناء على عريضة، ولو في غياب قرار إداري مسبق، أن يأمر بكل تدبير ضروري للخبرة أو للتحقيق ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_940_permission_0_4950072c> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_940_right_0_76e9ad98> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_940> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_940_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_940_20080225_OpEnact_7b99d16fda> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 940" ;
    dzdoc:position 939 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/law/2008-02-25/08-09#art_964> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_4_sec_2_subsec_3> ;
    dzdoc:eId "art_964" ;
    dzdoc:fullText "يجب أن ترفع دعوى تصحيح الأخطاء المادية بنفس الأشكال والإجراءات المقررة لعريضة افتتاح الدعوى . يجب تقديم دعوى تصحيح الأخطاء المادية في أجل شهرين (2) ابتداء من تاريخ التبليغ الرسمي للحكم أو القرار المشوب بالخطأ ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_964> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_964_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_964_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_964_20080225_OpEnact_ce5b892cc0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_964_obligation_0_2808105b>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_964_obligation_1_01275334> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 964" ;
    dzdoc:position 963 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_974> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_5_sec_1> ;
    dzdoc:eId "art_974" ;
    dzdoc:fullText "لا يجوز للجهة القضائية الإدارية أن تباشر الصلح إلا في النزاعات التي تدخل في اختصاصها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_974_permission_0_3a1e00e8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_974> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_974_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_974_20080225_OpEnact_41ce7e7984> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_974_prohibition_0_3a1e00e8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 974" ;
    dzdoc:position 973 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_974_condition_0_bcdec3ff> ;
    dzdoc:usesTerm dzterm:conciliation .

<https://legal.dz/resource/law/2008-02-25/08-09#art_975> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_5_sec_2_subsec_1> ;
    dzdoc:eId "art_975" ;
    dzdoc:fullText "لا يجوز للأشخاص المذكورة في المادة 800 أعلاه، أن تجري تحكيما إلا في الحالات الواردة في الاتفاقيات الدولية التي صادقت عليها الجزائر وفي مادة الصفقات العمومية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_975_permission_0_55b0369c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_975> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_975_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_975_20080225_OpEnact_81f57096dd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_975_obligation_0_b583740e> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_975_prohibition_0_55b0369c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "975" ;
    dzdoc:position 974 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_800> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_800> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_976> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_5_sec_2_subsec_1> ;
    dzdoc:eId "art_976" ;
    dzdoc:fullText "تطبق الأحكام المتعلقة بالتحكيم المنصوص عليها في هذا القانون، أمام الجهات القضائية الإدارية. عندما يكون التحكيم متعلقا بالدولة ، يتم اللجوء إلى هذا الإجراء بمبادرة من الوزير المعني أو الوزراء المعنيين. عندما يتعلق التحكيم بالولاية أو البلدية ، يتم اللجوء إلى هذا الإجراء على التوالي، بمبادرة من الوالي أو من رئيس المجلس الشعبي البلدي. عندما يتعلق التحكيم بمؤسسة عمومية ذات صبغة إدارية ، يتم اللجوء إلى هذا الإجراء بمبادرة من ممثلها القانوني، أو من ممثل السلطة الوصية التي يتبعها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_976> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_976_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_976_para_1>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_976_para_2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_976_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_976_20080225_OpEnact_de95729bdc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "976" ;
    dzdoc:position 975 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_976_condition_0_a173801d>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_976_condition_1_8e43a03a>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_976_condition_2_4c5ddfe7> ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2008-02-25/08-09#art_998> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_998" ;
    dzdoc:fullText "يجب أن يعين الشخص الطبيعي المكلف بالوساطة من بين الأشخاص المعترف لهم بحسن السلوك والاستقامة ، و أن تتوفر فيه الشروط الآتية : ألا يكون قد تعرض إلى عقوبة عن جريمة مخلة بالشرف ، وألا يكون ممنوعا من حقوقه المدنية، أن يكون مؤهلا للنظر في المنازعة المعروضة عليه، أن يكون محايدا ومستقلا في ممارسة الوساطة، تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_998> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_998_para_0>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_998_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_998_20080225_OpEnact_8eaf56e54a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_998_obligation_0_0d6fc05d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 998" ;
    dzdoc:position 997 ;
    dzdoc:references <https://legal.dz/resource/law/2008-02-25/08-09#art_998> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-02-25/08-09#art_998> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_998_condition_0_b8adad45> .

