<https://legal.dz/resource/law/2008-02-25/08-09#version_art_608> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن العمل بالقواعد المنصوص عليها في المادتين 605 و 606 أعلاه، لا يخل بأحكام المعاهدات الدولية والاتفاقيات القضائية التي تبرم بين الجزائر وغيرها من الدول."@ar ;
    dzdoc:isAuthoritative true ;
