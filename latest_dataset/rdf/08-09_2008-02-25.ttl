<https://legal.dz/resource/law/2008-02-25/08-09#art_738_obligation_0_b7dba1e8> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_738> ;
    dznorm:position 0 ;
    dznorm:provisionText "ترفق مع قائمة شروط البيع المستندات الآتية :"@ar ;
    dznorm:sourceArticle "art_738" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_738_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_738> ;
    dzdoc:position 0 ;
    dzdoc:text "ترفق مع قائمة شروط البيع المستندات الآتية : نسخة من السند التنفيذي الذي تم الحجز بمقتضاه، نسخة من أمر الحجز، نسخة من محضر التبليغ الرسمي للمحجوز عليه أو الحائز أو الكفيل العيني إن وجد، شهادة عقارية تتضمن القيود التي حصلت إلى غاية تاريخ الحجز، مستخرج جدول الضريبة العقارية."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_739_obligation_0_40019f3a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2008-02-25/08-09#art_739_obligation_0_40019f3a_role_0a068bcf92>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_739_obligation_0_40019f3a_role_1c59dc8368>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_739_obligation_0_40019f3a_role_4445ceb2e2> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_739> ;
    dznorm:position 0 ;
    dznorm:provisionText "يحدد الثمن الأساسي، الذي يبدأ به البيع بالمزاد العلني والقيمة التقريبية له في السوق، للعقار و/أو الحق العيني العقاري المحجوز، جملة أو على أجزاء من طرف خبير عقاري، يعين بأمر على عريضة، بناء على طلب المحضر القضائي أو الدائن الحاجز، بعد إثبات إيداع أتعاب الخبير بأمانة الضبط والمحددة مسبقا من طرف رئيس المحكمة"@ar ;
    dznorm:sourceArticle "art_739" .

