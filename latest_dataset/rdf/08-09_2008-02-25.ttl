<https://legal.dz/resource/law/2008-02-25/08-09#art_708_condition_0_4f88df88> a dznorm:Condition ;
    dznorm:conditionText "ولا يجري البيع إلا إذا حضر عدد من المزايدين يزيد عن ثلاثة (3) أشخاص"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_708> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_708_obligation_0_42f7d45f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_708> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يجري البيع بالمزاد العلني، إلا بعد إعادة جرد الأموال المحجوزة وتحرير محضر بذلك"@ar ;
    dznorm:sourceArticle "art_708" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_708_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_708> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يجري البيع بالمزاد العلني، إلا بعد إعادة جرد الأموال المحجوزة وتحرير محضر بذلك، يبين فيه المحضر القضائي أو محافظ البيع ما يكون قد نقص منها."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_708_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_708> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا يجري البيع إلا إذا حضر عدد من المزايدين يزيد عن ثلاثة (3) أشخاص، وإلا أجل البيع إلى تاريخ لاحق."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#art_709_condition_0_c5ea5e2a> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يتقدم أحد لشرائها بالقيمة المقدرة لها ولم يقبل الدائن استيفاء دينه منها عينا بهذه القيمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_709> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_709_obligation_0_f40ea46e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
