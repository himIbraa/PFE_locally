    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تبين لرئيس التشكيلة أنه يمكن التصريح بعدم قبول الطعن بالنقض ، يجدول القضية في أقرب جلسة لتمكين الخصوم من تقديم ملاحظاتهم . يقدم المستشار المقرر تقريرا وجيزا عن الإجراءات . يتم سماع الطلبات الشفوية للنيابة العامة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_578_20080225_OpEnact_915e1f2dfc> ;
    dzdoc:replacementText "إذا تبين لرئيس التشكيلة أنه يمكن التصريح بعدم قبول الطعن بالنقض ، يجدول القضية في أقرب جلسة لتمكين الخصوم من تقديم ملاحظاتهم . يقدم المستشار المقرر تقريرا وجيزا عن الإجراءات . يتم سماع الطلبات الشفوية للنيابة العامة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_578> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
