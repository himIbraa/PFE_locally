<https://legal.dz/resource/law/2008-02-25/08-09#version_art_458> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقدم الطلبات المشار إليها في المادة 453 أعلاه، حسب القواعد المقررة لرفع الدعوى الاستعجالية وذلك أمام محكمة مقر ممارسة الولاية . ينظر في الطلبات ويفصل فيها في غرفة المشورة، بعد سماع ممثل النيابة العامة ومحامي الخصوم في ملاحظاتهم عند الاقتضاء."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_458_20080225_OpEnact_926b6579e3> ;
