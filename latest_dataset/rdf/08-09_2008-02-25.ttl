<https://legal.dz/resource/law/2008-02-25/08-09#art_408_obligation_0_043f3d5d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
