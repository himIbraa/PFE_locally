<https://legal.dz/resource/law/2008-02-25/08-09#version_art_61> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن إثارة الدفع ببطلان الأعمال الإجرائية شكلا خلال القيام بها ، ولا يعتد بهذا الدفع إذا قدم من تمسك به دفاعا في الموضوع لاحقا للعمل الإجرائي المشوب بالبطلان دون إثارته ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
