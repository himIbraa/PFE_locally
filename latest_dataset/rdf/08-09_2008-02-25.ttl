<https://legal.dz/resource/law/2008-02-25/08-09#version_art_877> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقدم طلب الرد بعريضة تودع بأمانة ضبط الجهة القضائية الإدارية التي يعمل بها القاضي المعني. وإذا كان القاضي المطلوب رده رئيس محكمة إدارية ، يقدم الطلب مباشرة إلى رئيس مجلس الدولة، ويفصل فيه وفقا لأحكام المادة 882 أدناه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_877_20080225_OpEnact_0efcd14791> ;
