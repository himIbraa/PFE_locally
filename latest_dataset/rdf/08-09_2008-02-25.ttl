    dzdoc:sourceEId "art_672" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "عدم التصريح في الآجال المنصوص عليها في المادة 677 أدناه"@ar ;
    dzdoc:targetEId "art_677" .

<https://legal.dz/resource/law/2008-02-25/08-09#art_672_obligation_0_37e79f3d> a dznorm:Obligation ;
