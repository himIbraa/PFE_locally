    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_859> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "تطبق الأحكام المتعلقة بـ سماع الشهود المنصوص عليها في المواد من 150 إلى 162 من هذا القانون أمام المحاكم الإدارية ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_85_20080225_OpEnact_d7c51ae60b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_85> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-02-25/08-09#art_85> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_85> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يتم إخطار الخصوم لحضور إجراءات التحقيق المأمور به شفاهة بالجلسة أو بواسطة محاميهم . في حالة غيابهم ومحاميهم عن الجلسة التي أمر فيها بإجراء التحقيق ، يتم استدعاؤهم برسالة مضمنة مع الإشعار بالاستلام من طرف أمين ضبط الجهة القضائية . ويتم استدعاء الغير بالحضور لنفس الغرض حسب نفس الإجراء ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_860_20080225_OpEnact_2f5c9f1f46> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_860> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-02-25/08-09#art_860> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_860> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "يجوز لـ تشكيلة الحكم أو لـ القاضي المقرر الذي يقوم بسماع الشهود أن يستدعي أو يستمع تلقائيا إلى أي شخص يرى سماعه مفيدا. كما يجوز أيضا سماع أعوان الإدارة، أو طلب حضورهم لتقديم الإيضاحات."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_861_20080225_OpEnact_7a5b0f957a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_861> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-02-25/08-09#art_861> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_861> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "تطبق الأحكام المتعلقة بـ المعاينة و الانتقال إلى الأماكن المنصوص عليها في المواد من 146 إلى 149 من هذا القانون أمام المحاكم الإدارية ."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_862_20080225_OpEnact_e4ad498969> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-02-25"^^xsd:date ;
