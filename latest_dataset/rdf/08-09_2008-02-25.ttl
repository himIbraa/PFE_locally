<https://legal.dz/resource/law/2008-02-25/08-09#version_art_648> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز توقيع الحجز التحفظي، خلال وجود دعوى أمام قاضي الموضوع ، وفي هذه الحالة، يقدم طلب تثبيت الحجز أمام نفس قاضي الموضوع بمذكرة إضافية تضم إلى أصل الدعوى للفصل فيهما معا وبحكم واحد، دون مراعاة الأجل المنصوص عليه في المادة 662 أدناه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
