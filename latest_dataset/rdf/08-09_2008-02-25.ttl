<https://legal.dz/resource/law/2008-02-25/08-09#art_914_condition_0_b9ea3bfe> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/law/2008-02-25/08-09#art_914_condition_0_b9ea3bfe_action_a7f94bea92> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2008-02-25/08-09#art_914_condition_0_b9ea3bfe_role_6ec20e8c7b> ;
    dznorm:conditionText "عندما يتم استئناف حكم صادر عن المحكمة الإدارية قضى بإلغاء قرار إداري لتجاوز السلطة، يجوز لمجلس الدولة، بناء على طلب المستأنف، أن يأمر بوقف تنفيذ هذا الحكم متى كانت أوجه الاستئناف تبدو من التحقيق جدية ومن شأنها أن تؤدي فضلا عن إلغاء الحكم المطعون فيه أو تعديله، إلى رفض الطلبات الرامية إلى الإلغاء من أجل تجاوز السلطة الذي قضى به الحكم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_914> ;
    dznorm:position 0 .

