<https://legal.dz/resource/law/2008-02-25/08-09#version_art_18> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يتضمن التكليف بالحضور البيانات الآتية : 1- اسم ولقب المحضر القضائي وعنوانه المهني وختمه وتوقيعه وتاريخ التبليغ الرسمي وساعته، 2- اسم ولقب المدعي وموطنه، 3- اسم ولقب الشخص المكلف بالحضور وموطنه، 4- تسمية وطبيعة الشخص المعنوي ومقره الاجتماعي، وصفة ممثله القانوني أو الاتفاقي، 5 تاريخ أول جلسة وساعة انعقادها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_18_20080225_OpEnact_8779005744> ;
    dzdoc:replacementText "يجب أن يتضمن التكليف بالحضور البيانات الآتية : 1- اسم ولقب المحضر القضائي وعنوانه المهني وختمه وتوقيعه وتاريخ التبليغ الرسمي وساعته، 2- اسم ولقب المدعي وموطنه، 3- اسم ولقب الشخص المكلف بالحضور وموطنه، 4- تسمية وطبيعة الشخص المعنوي ومقره الاجتماعي، وصفة ممثله القانوني أو الاتفاقي، 5 تاريخ أول جلسة وساعة انعقادها."@ar ;
