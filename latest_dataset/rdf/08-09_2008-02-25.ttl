<https://legal.dz/resource/law/2008-02-25/08-09#version_art_248> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن للنائب العام لدى المحكمة العليا ، إذا أخطر بطلب إحالة قضية لسبب يتعلق بالأمن العام ، أن يقدم التماسات إلى المحكمة العليا تهدف إلى تلبية هذا الطلب. يفصل في هذا الطلب خلال ثمانية (8) أيام في غرفة المشورة من قبل الرئيس الأول ورؤساء الغرف ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
