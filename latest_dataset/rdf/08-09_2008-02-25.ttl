        "للتكليف بالحضور"@ar .

dzterm:trial_panel a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تشكيلة الحكم"@ar .

dzterm:ادعاء_بالتزوير a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الادعاء بالتزوير"@ar,
        "الادعاء بالتزوير ضد العقود الرسمية هو الدعوى التي تهدف إلى إثبات تزييف أو تغيير عقد سبق تحريره أو إضافة معلومات مزورة إليه."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_179_defocc_d451a1136d94> .

dzterm:التنازل a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التنازل"@ar,
        "التنازل هو إمكانية مخولة للمدعي لإنهاء الخصومة، ولا يترتب عليه التخلي عن الحق في الدعوى."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_231_defocc_f24474769416> .

dzterm:حجز_تحفظي a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الحجز التحفظي"@ar,
        "الحجز التحفظي هو وضع أموال المدين المنقولة المادية والعقارية تحت يد القضاء ومنعه من التصرف فيها"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-02-25/08-09#art_646_defocc_74359fd1a8f4> .

