        <https://legal.dz/resource/law/2008-02-25/08-09#art_174> ;
    dzdoc:usesTerm dzterm:administrative_courts,
        dzterm:handwriting_verification .

<https://legal.dz/resource/law/2008-02-25/08-09#art_865> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_865" ;
    dzdoc:fullText "تطبق الأحكام المتعلقة بـ الإنابات القضائية المنصوص عليها في المواد من 108 إلى 124 من هذا القانون أمام المحاكم الإدارية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_865> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_865_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_865_20080225_OpEnact_ae7ac5b9e7> ;
