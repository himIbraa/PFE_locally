<https://legal.dz/resource/law/2008-02-25/08-09#version_art_386> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لقاضي الاستعجال أن يوقف تنفيذ الحكم أو القرار أو الأمر المطعون فيه، باعتراض الغير الخارج عن الخصومة حسب الأشكال المقررة في مادة الاستعجال."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
