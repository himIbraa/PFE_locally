<https://legal.dz/resource/law/2008-02-25/08-09#version_art_742> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقدم الاعتراضات بعريضة من طرف الأشخاص المشار إليهم في المادة 740 أعلاه، أو من ورثتهم إلى رئيس المحكمة ، قبل جلسة الاعتراضات بثلاثة (3) أيام على الأقل ، وإلا سقط حقهم في التمسك بها. تسجل العريضة في سجل خاص بعد دفع الرسوم حسب تاریخ ورودها، وتعقد جلسة الاعتراضات في غرفة المشورة بحضور المعترض والحاجز و المحضر القضائي . يفصل رئيس المحكمة في الاعتراضات، بأمر غير قابل لأي طعن في أجل أقصاه ثمانية (8) أيام . إذا لم يقدم أي اعتراض بالجلسة ، يؤشر أمين الضبط بذلك في السجل الخاص به، ويشرع المحضر القضائي في إ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_742_20080225_OpEnact_54310b2ca8> ;
    dzdoc:replacementText "تقدم الاعتراضات بعريضة من طرف الأشخاص المشار إليهم في المادة 740 أعلاه، أو من ورثتهم إلى رئيس المحكمة ، قبل جلسة الاعتراضات بثلاثة (3) أيام على الأقل ، وإلا سقط حقهم في التمسك بها. تسجل العريضة في سجل خاص بعد دفع الرسوم حسب تاریخ ورودها، وتعقد جلسة الاعتراضات في غرفة المشورة بحضور المعترض والحاجز و المحضر القضائي . يفصل رئيس المحكمة في الاعتراضات، بأمر غير قابل لأي طعن في أجل أقصاه ثمانية (8) أيام . إذا لم يقدم أي اعتراض بالجلسة ، يؤشر أمين الضبط بذلك في السجل الخاص به، ويشرع المحضر القضائي في إجراءات الإعلان عن البيع بالمزاد العلني."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_742> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_742> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_743> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لكل من المدين المحجوز عليه أو الحائز أو الكفيل العيني، أن يطلب بطريق الاستعجال، وقف إجراءات البيع مؤقتا على عقار و/أو حق عيني عقاري أو أكثر من العقارات المحجوزة ، إذا أثبت أن قيمة إحدى هذه العقارات و/أو الحق العيني العقاري كاف للوفاء بديون جميع الدائنين . يحدد الأمر الاستعجالي العقارات و/أو الحقوق العينية العقارية محل التوقيف المؤقت للبيع. مع ذلك يجوز لكل دائن حتى بعد الحكم برسو المزاد أن يستمر في بيع تلك العقارات و/أو الحقوق العينية العقارية إذا لم يكف الثمن الناتج عن البيع للوفاء بدينه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_743_20080225_OpEnact_7ecf2a874a> ;
    dzdoc:replacementText "يجوز لكل من المدين المحجوز عليه أو الحائز أو الكفيل العيني، أن يطلب بطريق الاستعجال، وقف إجراءات البيع مؤقتا على عقار و/أو حق عيني عقاري أو أكثر من العقارات المحجوزة ، إذا أثبت أن قيمة إحدى هذه العقارات و/أو الحق العيني العقاري كاف للوفاء بديون جميع الدائنين . يحدد الأمر الاستعجالي العقارات و/أو الحقوق العينية العقارية محل التوقيف المؤقت للبيع. مع ذلك يجوز لكل دائن حتى بعد الحكم برسو المزاد أن يستمر في بيع تلك العقارات و/أو الحقوق العينية العقارية إذا لم يكف الثمن الناتج عن البيع للوفاء بدينه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_743> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_743> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_744> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمدين المحجوز عليه أو الحائز أو الكفيل العيني، أن يطلب بطريق الاستعجال، تأجيل إجراءات بيع العقار و/أو الحق العيني العقاري ، إذا أثبت أن الإيرادات السنوية لهذا العقار و/أو الحق العيني العقاري لسنة واحدة كافية للوفاء بديون جميع الدائنين . يحدد الأمر الفاصل بتأجيل البيع، الأجل الذي يستأنف فيه إجراءات البيع إذا لم يتم الوفاء ، مراعيا في ذلك المهلة اللازمة للمدين المحجوز عليه للوفاء، على أن لا تتجاوز سنة واحدة (1)."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_744_20080225_OpEnact_377eb19831> ;
    dzdoc:replacementText "يجوز للمدين المحجوز عليه أو الحائز أو الكفيل العيني، أن يطلب بطريق الاستعجال، تأجيل إجراءات بيع العقار و/أو الحق العيني العقاري ، إذا أثبت أن الإيرادات السنوية لهذا العقار و/أو الحق العيني العقاري لسنة واحدة كافية للوفاء بديون جميع الدائنين . يحدد الأمر الفاصل بتأجيل البيع، الأجل الذي يستأنف فيه إجراءات البيع إذا لم يتم الوفاء ، مراعيا في ذلك المهلة اللازمة للمدين المحجوز عليه للوفاء، على أن لا تتجاوز سنة واحدة (1)."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_744> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_744> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_745> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وجد بين الدائنين، بائع العقار و/أو الحق العيني العقاري أو أحد المقايضين به أو الشريك المقاسم ، بلغ له المحضر القضائي إنذارا بأنه في حالة عدم رفع دعوى الفسخ لعدم دفع الثمن أو الفرق في الثمن أو طلب إعادة البيع عن طريق المزاد العلني والتأشير بذلك على قائمة شروط البيع قبل الجلسة المحددة للاعتراضات بثلاثة (3) أيام على الأقل ، وإلا سقط حقه في ذلك. غير أنه إذا رفع دعوى الفسخ أو قدم طلبا لإعادة البيع بالمزاد العلني في الأجل المحدد في الفقرة الأولى أعلاه ، قام المحضر القضائي بتأشير ذلك على قائمة شروط"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_745_20080225_OpEnact_efc9a73681> ;
    dzdoc:replacementText "إذا وجد بين الدائنين، بائع العقار و/أو الحق العيني العقاري أو أحد المقايضين به أو الشريك المقاسم ، بلغ له المحضر القضائي إنذارا بأنه في حالة عدم رفع دعوى الفسخ لعدم دفع الثمن أو الفرق في الثمن أو طلب إعادة البيع عن طريق المزاد العلني والتأشير بذلك على قائمة شروط البيع قبل الجلسة المحددة للاعتراضات بثلاثة (3) أيام على الأقل ، وإلا سقط حقه في ذلك. غير أنه إذا رفع دعوى الفسخ أو قدم طلبا لإعادة البيع بالمزاد العلني في الأجل المحدد في الفقرة الأولى أعلاه ، قام المحضر القضائي بتأشير ذلك على قائمة شروط البيع، وتوقف عن الاستمرار في إجراءات البيع إلى حين الفصل في هذه الدعوى من طرف قاضي الموضوع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_745> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_745> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_746> a dzdoc:AmendmentEvent,
