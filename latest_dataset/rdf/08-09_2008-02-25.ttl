<https://legal.dz/resource/law/2008-02-25/08-09#art_754_condition_0_c0bd3f57> a dznorm:Condition ;
    dznorm:conditionText "إذا كانت هذه الإجراءات صحيحة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_754> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_754_condition_1_761beb24> a dznorm:Condition ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2008-02-25/08-09#art_754_condition_1_761beb24_period_11f05d9d6f> ;
    dznorm:conditionText "إذا لم يتوفر النصاب من المزايدين أو كان العرض أقل من الثمن الأساسي للمزايدة، أو لم يتقدم أحد بأي عرض خلال خمس عشرة (15) دقيقة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_754> ;
