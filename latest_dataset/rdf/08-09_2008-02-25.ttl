<https://legal.dz/resource/law/2008-02-25/08-09#version_art_155> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أثبت الشاهد أنه استحال عليه الحضور في اليوم المحدد ، جاز للقاضي أن يحدد له أجلا آخر أو ينتقل لتلقي شهادته. إذا كان الشاهد مقيما خارج دائرة اختصاص الجهة القضائية ، جاز للقاضي إصدار إنابة قضائية لتلقي شهادته."@ar ;
