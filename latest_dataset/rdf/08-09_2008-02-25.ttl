        <https://legal.dz/resource/law/2008-02-25/08-09#art_919_condition_1_eb3d29c2>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_919_condition_2_12336836> ;
    dzdoc:usesTerm dzterm:judge .

