<https://legal.dz/resource/law/2008-02-25/08-09#art_978> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_4_chp_6_sec_1> ;
    dzdoc:eId "art_978" ;
    dzdoc:fullText "عندما يتطلب الأمر أو الحكم أو القرار، إلزام أحد الأشخاص المعنوية العامة أو هيئة تخضع منازعاتها لاختصاص الجهات القضائية الإدارية باتخاذ تدابير تنفيذ معينة ، تأمر الجهة القضائية الإدارية المطلوب منها ذلك، في نفس الحكم القضائي، بالتدبير المطلوب مع تحديد أجل للتنفيذ، عند الاقتضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_978> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-02-25/08-09#art_978_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_978_20080225_OpEnact_2ce4ded13f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-02-25/08-09#art_978_obligation_0_b7630843> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "978" ;
    dzdoc:position 977 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-02-25/08-09#art_978_condition_0_8bf65ab8> .

<https://legal.dz/resource/law/2008-02-25/08-09#art_990> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_990" ;
    dzdoc:fullText "يجوز للخصوم التصالح تلقائيا، أو بسعي من القاضي، في جميع مراحل الخصومة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_990_permission_0_07960143> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-02-25/08-09#art_990_right_0_100a6e33> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_990> ;
