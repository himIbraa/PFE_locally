<https://legal.dz/resource/law/2008-02-25/08-09#version_art_451> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاين القاضي ويكيف الوقائع المعتمد عليها في تأسيس الأسباب المدعمة لطلب التطليق طبقا لأحكام قانون الأسرة . ويفصل في مدى تأسيس الطلب، آخذا بعين الاعتبار الظروف التي قدم فيها. يمكن للقاضي أن يتخذ كل التدابير التي يراها ملائمة، لا سيما الأمر بالتحقيق أو بخبرة طبية أو الانتقال للمعاينة. يتعين على القاضي تسبيب الإجراء المأمور به إذا تعلق بخبرة طبية . يعاين القاضي أيضا ويكيف الوقائع المعتمد عليها في طلب الخلع طبقا لأحكام قانون الأسرة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_451_20080225_OpEnact_aeca04011e> ;
    dzdoc:replacementText "يعاين القاضي ويكيف الوقائع المعتمد عليها في تأسيس الأسباب المدعمة لطلب التطليق طبقا لأحكام قانون الأسرة . ويفصل في مدى تأسيس الطلب، آخذا بعين الاعتبار الظروف التي قدم فيها. يمكن للقاضي أن يتخذ كل التدابير التي يراها ملائمة، لا سيما الأمر بالتحقيق أو بخبرة طبية أو الانتقال للمعاينة. يتعين على القاضي تسبيب الإجراء المأمور به إذا تعلق بخبرة طبية . يعاين القاضي أيضا ويكيف الوقائع المعتمد عليها في طلب الخلع طبقا لأحكام قانون الأسرة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_451> ;
