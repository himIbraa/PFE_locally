<https://legal.dz/resource/law/2008-02-25/08-09#version_art_590> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أمرت أية جهة قضائية بتقديم حساب لتصفية حسابات أموال القاصر أو حسابات أموال الشركات المدنية ، يمكنها ندب قاض وتحديد أجل لتقديم الحساب . يقوم القاضي المنتدب بتحرير محضر عن أعماله ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_590_20080225_OpEnact_ffb2c71166> ;
