<https://legal.dz/resource/law/2008-02-25/08-09#version_art_555> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوقع الرئيس وأمين الضبط والمستشار المقرر إن اقتضى الأمر على أصل القرار الذي يحفظ في أرشيف الجهة القضائية. يحفظ أيضا ملف القضية في أرشيف الجهة القضائية. يستعيد الخصوم دون سواهم أو بوكالة خاصة، الوثائق المملوكة لهم بناء على طلبهم مقابل وصل بالاستلام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_555_20080225_OpEnact_071bab3a90> ;
    dzdoc:replacementText "يوقع الرئيس وأمين الضبط والمستشار المقرر إن اقتضى الأمر على أصل القرار الذي يحفظ في أرشيف الجهة القضائية. يحفظ أيضا ملف القضية في أرشيف الجهة القضائية. يستعيد الخصوم دون سواهم أو بوكالة خاصة، الوثائق المملوكة لهم بناء على طلبهم مقابل وصل بالاستلام."@ar ;
