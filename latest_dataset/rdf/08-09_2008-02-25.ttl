<https://legal.dz/resource/law/2008-02-25/08-09#version_art_429> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن تتضمن العريضة الوحيدة ما يأتي : 1- بيان الجهة القضائية المرفوع أمامها الطلب، 2- اسم ولقب وجنسية كلا الزوجين وموطن وتاريخ ومكان ميلادهما، 3- تاريخ ومكان زواجهما، وعند الاقتضاء، عدد الأولاد القصر، 4- عرض موجز يتضمن جميع شروط الاتفاق الحاصل بينهما حول توابع الطلاق. يجب أن يرفق مع العريضة شهادة عائلية ومستخرج من عقد زواج المعنيين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_429_20080225_OpEnact_3d5a14fb27> ;
    dzdoc:replacementText "يجب أن تتضمن العريضة الوحيدة ما يأتي : 1- بيان الجهة القضائية المرفوع أمامها الطلب، 2- اسم ولقب وجنسية كلا الزوجين وموطن وتاريخ ومكان ميلادهما، 3- تاريخ ومكان زواجهما، وعند الاقتضاء، عدد الأولاد القصر، 4- عرض موجز يتضمن جميع شروط الاتفاق الحاصل بينهما حول توابع الطلاق. يجب أن يرفق مع العريضة شهادة عائلية ومستخرج من عقد زواج المعنيين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_429> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
