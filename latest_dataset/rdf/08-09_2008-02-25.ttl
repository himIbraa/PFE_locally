    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:versionText "لا يمس البطلان عمليات التحقيق إلا في جوانبها المشوبة بعدم الصحة."@ar .

<https://legal.dz/resource/law/2008-02-25/08-09#version_art_970_20080225_OpEnact_0a4ce64c71> a dzdoc:ArticleVersion ;
