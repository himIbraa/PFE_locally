<https://legal.dz/resource/law/2008-02-25/08-09#art_1061_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_1061> ;
    dzdoc:position 0 ;
