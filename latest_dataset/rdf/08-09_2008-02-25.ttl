<https://legal.dz/resource/law/2008-02-25/08-09#version_art_727> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تقدم دائن آخر بيده سند تنفيذي حائزا لقوة الشيء المقضي به، بعد قيد أمر الحجز ، وجب على المحضر القضائي تسجيله مع الدائنين الحاجزين واستصدار أمر على عريضة يتضمن قيده بالمحافظة العقارية مع بقية الدائنين ، ويصبح تاریخ التأشير به طرفا في إجراءات التنفيذ. ولا يجوز شطب التسجيلات والتأشيرات إلا بصدور أمر مخالف."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_727_20080225_OpEnact_59fa447ce7> ;
    dzdoc:replacementText "إذا تقدم دائن آخر بيده سند تنفيذي حائزا لقوة الشيء المقضي به، بعد قيد أمر الحجز ، وجب على المحضر القضائي تسجيله مع الدائنين الحاجزين واستصدار أمر على عريضة يتضمن قيده بالمحافظة العقارية مع بقية الدائنين ، ويصبح تاریخ التأشير به طرفا في إجراءات التنفيذ. ولا يجوز شطب التسجيلات والتأشيرات إلا بصدور أمر مخالف."@ar ;
