    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
    dzdoc:number "المادة 990" ;
    dzdoc:position 989 ;
    dzdoc:usesTerm dzterm:reconciliation .

<https://legal.dz/resource/law/2008-02-25/08-09#art_996> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_996" ;
    dzdoc:fullText "لا يمكن أن تتجاوز مدة الوساطة ثلاثة (3) أشهر. ويمكن تجديدها لنفس المدة مرة واحدة بطلب من الوسيط عند الاقتضاء، بعد موافقة الخصوم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-02-25/08-09#art_996_permission_0_632ebbf7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_996> ;
