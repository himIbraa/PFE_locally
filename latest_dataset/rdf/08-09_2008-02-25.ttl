<https://legal.dz/resource/law/2008-02-25/08-09#version_art_387> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا قبل القاضي اعتراض الغير الخارج عن الخصومة على الحكم أو القرار أو الأمر ، يجب أن يقتصر في قضائه على إلغاء أو تعديل مقتضيات الحكم أو القرار أو الأمر، التي اعترض عليها الغير والضارة به ، ويحتفظ الحكم أو القرار أو الأمر المعترض فيه بآثاره إزاء الخصوم الأصليين، حتى فيما يتعلق بمقتضياته المبطلة، ماعدا في حالة عدم قابلية الموضوع للتجزئة المنصوص عليها في المادة 382 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_387_20080225_OpEnact_559e686b34> ;
    dzdoc:replacementText "إذا قبل القاضي اعتراض الغير الخارج عن الخصومة على الحكم أو القرار أو الأمر ، يجب أن يقتصر في قضائه على إلغاء أو تعديل مقتضيات الحكم أو القرار أو الأمر، التي اعترض عليها الغير والضارة به ، ويحتفظ الحكم أو القرار أو الأمر المعترض فيه بآثاره إزاء الخصوم الأصليين، حتى فيما يتعلق بمقتضياته المبطلة، ماعدا في حالة عدم قابلية الموضوع للتجزئة المنصوص عليها في المادة 382 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_387> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_387> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
