    dzdoc:eId "art_862" ;
    dzdoc:fullText "تطبق الأحكام المتعلقة بـ مضاهاة الخطوط المنصوص عليها في المواد من 164 إلى 174 من هذا القانون أمام المحاكم الإدارية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-02-25/08-09#version_art_862> ;
