<https://legal.dz/resource/law/2008-02-25/08-09#version_art_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن تتم الإجراءات والعقود القضائية من عرائض ومذكرات باللغة العربية ، تحت طائلة عدم القبول. يجب أن تقدم الوثائق والمستندات باللغة العربية أو مصحوبة بترجمة رسمية إلى هذه اللغة ، تحت طائلة عدم القبول. تتم المناقشات والمرافعات باللغة العربية. تصدر الأحكام القضائية باللغة العربية تحت طائلة البطلان المثار تلقائيا من القاضي. يقصد بالأحكام القضائية في هذا القانون، الأوامر والأحكام والقرارات القضائية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_8_20080225_OpEnact_3ffa0227f3> ;
    dzdoc:replacementText "يجب أن تتم الإجراءات والعقود القضائية من عرائض ومذكرات باللغة العربية ، تحت طائلة عدم القبول. يجب أن تقدم الوثائق والمستندات باللغة العربية أو مصحوبة بترجمة رسمية إلى هذه اللغة ، تحت طائلة عدم القبول. تتم المناقشات والمرافعات باللغة العربية. تصدر الأحكام القضائية باللغة العربية تحت طائلة البطلان المثار تلقائيا من القاضي. يقصد بالأحكام القضائية في هذا القانون، الأوامر والأحكام والقرارات القضائية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_8> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_8> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

