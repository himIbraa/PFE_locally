<https://legal.dz/resource/law/2008-02-25/08-09#version_art_840> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبلغ كل الإجراءات المتخذة وتدابير التحقيق إلى الخصوم برسالة مضمنة مع الإشعار بالاستلام، أو عن طريق محضر قضائي ، عند الاقتضاء. يتم أيضا تبليغ طلبات التسوية والإعذارات وأوامر الاختتام وتاريخ الجلسة بنفس الأشكال. يشار في تبليغ العرائض والمذكرات إلى أنه في حالة عدم مراعاة الأجل المحدد من طرف القاضي لتقديم مذكرات الرد يمكن اختتام التحقيق دون إشعار مسبق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_840_20080225_OpEnact_d6e2fbebe1> ;
    dzdoc:replacementText "تبلغ كل الإجراءات المتخذة وتدابير التحقيق إلى الخصوم برسالة مضمنة مع الإشعار بالاستلام، أو عن طريق محضر قضائي ، عند الاقتضاء. يتم أيضا تبليغ طلبات التسوية والإعذارات وأوامر الاختتام وتاريخ الجلسة بنفس الأشكال. يشار في تبليغ العرائض والمذكرات إلى أنه في حالة عدم مراعاة الأجل المحدد من طرف القاضي لتقديم مذكرات الرد يمكن اختتام التحقيق دون إشعار مسبق."@ar ;
