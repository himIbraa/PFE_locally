<https://legal.dz/resource/law/2008-02-25/08-09#version_art_443> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يثبت الصلح بين الزوجين بموجب محضر ، يحرر في الحال من أمين الضبط تحت إشراف القاضي . يوقع المحضر من طرف القاضي وأمين الضبط والزوجين ويودع بأمانة الضبط. يعد محضر الصلح سندا تنفيذيا. في حالة عدم الصلح أو تخلف أحد الزوجين بالرغم من مهلة التفكير الممنوحة له ، يشرع في مناقشة موضوع الدعوى."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_443_20080225_OpEnact_7f0a964879> ;
    dzdoc:replacementText "يثبت الصلح بين الزوجين بموجب محضر ، يحرر في الحال من أمين الضبط تحت إشراف القاضي . يوقع المحضر من طرف القاضي وأمين الضبط والزوجين ويودع بأمانة الضبط. يعد محضر الصلح سندا تنفيذيا. في حالة عدم الصلح أو تخلف أحد الزوجين بالرغم من مهلة التفكير الممنوحة له ، يشرع في مناقشة موضوع الدعوى."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_443> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_443> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-02-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

