    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_699> ;
    dznorm:position 3 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_699_obligation_0_4469d12f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2008-02-25/08-09#art_699_obligation_0_4469d12f_action_c3460f9021> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_699> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يجوز للحارس أن يستعمل أو يستغل أو يعير الأموال المحجوزة إلا بأمر مخالف من القضاء"@ar ;
    dznorm:sourceArticle "art_699" .

