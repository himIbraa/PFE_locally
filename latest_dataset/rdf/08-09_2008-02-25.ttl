<https://legal.dz/resource/law/2008-02-25/08-09#version_art_757> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرسو المزاد على من تقدم من المزايدين بأعلى عرض وكان آخر مزايد. يعتمد الرئيس العرض الذي لا يزاد عليه بعد النداء به ثلاث (3) مرات متتالية تفصل بين كل نداء دقيقة واحدة. يجب على الراسي عليه المزاد أن يدفع حال انعقاد الجلسة، خمس الثمن والمصاريف والرسوم المستحقة، ويدفع المبلغ الباقي في أجل أقصاه ثمانية (8) أيام بأمانة ضبط المحكمة. إذا لم يودع الراسي عليه المزاد باقي الثمن كاملا في المدة المحددة في الفقرة أعلاه ، يتم إعذاره بالدفع خلال خمسة (5) أيام، وإلا أعيد البيع بالمزاد العلني على ذمته."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_757_20080225_OpEnact_b03605340a> ;
    dzdoc:replacementText "يرسو المزاد على من تقدم من المزايدين بأعلى عرض وكان آخر مزايد. يعتمد الرئيس العرض الذي لا يزاد عليه بعد النداء به ثلاث (3) مرات متتالية تفصل بين كل نداء دقيقة واحدة. يجب على الراسي عليه المزاد أن يدفع حال انعقاد الجلسة، خمس الثمن والمصاريف والرسوم المستحقة، ويدفع المبلغ الباقي في أجل أقصاه ثمانية (8) أيام بأمانة ضبط المحكمة. إذا لم يودع الراسي عليه المزاد باقي الثمن كاملا في المدة المحددة في الفقرة أعلاه ، يتم إعذاره بالدفع خلال خمسة (5) أيام، وإلا أعيد البيع بالمزاد العلني على ذمته."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_757> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
