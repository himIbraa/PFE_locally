<https://legal.dz/resource/law/2008-02-25/08-09#version_art_802> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "خلافا لأحكام المادتين 800 و 801 أعلاه، يكون من اختصاص المحاكم العادية المنازعات الآتية : 1- مخالفات الطرق 2 - المنازعات المتعلقة بكل دعوى خاصة بالمسؤولية الرامية إلى طلب تعويض الأضرار الناجمة عن مركبة تابعة للدولة، أو لإحدى الولايات أو البلديات أو المؤسسات العمومية ذات الصبغة الإدارية."@ar ;
