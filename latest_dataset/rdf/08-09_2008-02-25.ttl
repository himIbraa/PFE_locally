    dznorm:position 0 .

<https://legal.dz/resource/law/2008-02-25/08-09#art_238_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-02-25/08-09#art_238> ;
    dzdoc:position 0 ;
    dzdoc:text "القبول بطلب الخصم يعد اعترافا بصحة ادعاءاته، وتخليا من المدعى عليه، ما لم يطعن في الحكم لاحقا."@ar .

