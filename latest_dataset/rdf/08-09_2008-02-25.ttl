<https://legal.dz/resource/law/2008-02-25/08-09#version_art_319> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة وفاة المحكوم عليه ، لا يستأنف سريان الأجل إلا بعد التبليغ الرسمي للورثة، ويكون التبليغ الرسمي صحيحا إذا تم في مسكن المتوفى. يكون التبليغ الرسمي صحيحا إذا سلم إلى الورثة جملة ودون تحديد أسمائهم وصفاتهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_319_20080225_OpEnact_1eae2fe4d1> ;
    dzdoc:replacementText "في حالة وفاة المحكوم عليه ، لا يستأنف سريان الأجل إلا بعد التبليغ الرسمي للورثة، ويكون التبليغ الرسمي صحيحا إذا تم في مسكن المتوفى. يكون التبليغ الرسمي صحيحا إذا سلم إلى الورثة جملة ودون تحديد أسمائهم وصفاتهم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_319> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-02-25/08-09> ;
