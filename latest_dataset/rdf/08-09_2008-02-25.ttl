<https://legal.dz/resource/law/2008-02-25/08-09#version_art_362> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان موضوع الدعوى غير قابل للتجزئة، فإن رفع الطعن بالنقض من أحد الخصوم ينتج آثاره بالنسبة إلى الباقي حتى ولو لم يطعنوا بالنقض. وإذا رفع الطعن بالنقض ضد أحد الخصوم في موضوع غير قابل للتجزئة، لا يكون ذلك الطعن مقبولا، ما لم يتم استدعاء باقي الخصوم."@ar ;
