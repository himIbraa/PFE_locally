    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتضمن القرار أو الحكم أو الأمر الفاصل في النزاع، تصفية مقدار المصاريف ، إلا إذا تعذر تصفيتها قبل صدوره . في الحالة الأخيرة تتم تصفية المصاريف بموجب أمر يصدره القاضي ويرفق بمستندات الدعوى."@ar ;
