<https://legal.dz/resource/law/2008-02-25/08-09#version_art_931> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يختتم التحقيق بانتهاء الجلسة، ما لم يقرر قاضي الاستعجال تأجيل اختتامه إلى تاريخ لاحق ويخطر به الخصوم بكل الوسائل. في الحالة الأخيرة يجوز أن توجه المذكرات والوثائق الإضافية المقدمة بعد الجلسة وقبل اختتام التحقيق ومباشرة إلى الخصوم الآخرين عن طريق محضر قضائي، بشرط أن يقدم الخصم المعني الدليل عما قام به أمام القاضي . يفتتح التحقيق من جديد في حالة التأجيل إلى جلسة أخرى."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-02-25/08-09#version_art_931_20080225_OpEnact_d70c88d78d> ;
    dzdoc:replacementText "يختتم التحقيق بانتهاء الجلسة، ما لم يقرر قاضي الاستعجال تأجيل اختتامه إلى تاريخ لاحق ويخطر به الخصوم بكل الوسائل. في الحالة الأخيرة يجوز أن توجه المذكرات والوثائق الإضافية المقدمة بعد الجلسة وقبل اختتام التحقيق ومباشرة إلى الخصوم الآخرين عن طريق محضر قضائي، بشرط أن يقدم الخصم المعني الدليل عما قام به أمام القاضي . يفتتح التحقيق من جديد في حالة التأجيل إلى جلسة أخرى."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-02-25/08-09#art_931> ;
