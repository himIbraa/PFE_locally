    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-02-25/08-09#art_153_prohibition_0_34931d95>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_153_prohibition_1_1984bf94>,
        <https://legal.dz/resource/law/2008-02-25/08-09#art_153_prohibition_2_5a45a0cf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-02-25/08-09> ;
    dzdoc:introducedOn "2008-02-25"^^xsd:date ;
