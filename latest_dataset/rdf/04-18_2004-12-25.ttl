<https://legal.dz/resource/law/2004-12-25/04-18#version_art_13> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من سنتين (2) إلى عشر (10) سنوات وبغرامة من 100.000 دج إلى 500.000 دج كل من يسلم أو يعرض بطريقة غير مشروعة مخدرات أو مؤثرات عقلية على الغير بهدف الاستعمال الشخصي . يضاعف الحد الأقصى للعقوبة إذا تم تسليم أو عرض المخدرات أو المؤثرات العقلية حسب الشروط المحددة في الفقرة السابقة على قاصر أو معوق أو شخص يعالج بسبب إدمانه أو في مراكز تعليمية أو تربوية أو تكوينية أو صحية أو اجتماعية أو داخل هيئات عمومية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_13_20041225_OpEnact_d3dcab96e1> ;
    dzdoc:replacementText "يعاقب بالحبس من سنتين (2) إلى عشر (10) سنوات وبغرامة من 100.000 دج إلى 500.000 دج كل من يسلم أو يعرض بطريقة غير مشروعة مخدرات أو مؤثرات عقلية على الغير بهدف الاستعمال الشخصي . يضاعف الحد الأقصى للعقوبة إذا تم تسليم أو عرض المخدرات أو المؤثرات العقلية حسب الشروط المحددة في الفقرة السابقة على قاصر أو معوق أو شخص يعالج بسبب إدمانه أو في مراكز تعليمية أو تربوية أو تكوينية أو صحية أو اجتماعية أو داخل هيئات عمومية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
