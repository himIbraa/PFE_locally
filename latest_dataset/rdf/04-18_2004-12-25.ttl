<https://legal.dz/resource/law/2004-12-25/04-18#version_art_12> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من 5.000 دج إلى 50.000 دج أو بإحدى هاتين العقوبتين كل شخص يستهلك أو يحوز من أجل الاستهلاك الشخصي مخدرات أو مؤثرات عقلية بصفة غير مشروعة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_12_20041225_OpEnact_d518bbcd6b> ;
    dzdoc:replacementText "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من 5.000 دج إلى 50.000 دج أو بإحدى هاتين العقوبتين كل شخص يستهلك أو يحوز من أجل الاستهلاك الشخصي مخدرات أو مؤثرات عقلية بصفة غير مشروعة ."@ar ;
