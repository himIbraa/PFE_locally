<https://legal.dz/resource/law/2004-12-25/04-18#version_art_39> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 13 ذي القعدة عام 1425 الموافق 25 ديسمبر سنة 2004. عبد العزيز بوتفليقة"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_39_20041225_OpEnact_79df85aa11> ;
    dzdoc:replacementText "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 13 ذي القعدة عام 1425 الموافق 25 ديسمبر سنة 2004. عبد العزيز بوتفليقة"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2004-12-25/04-18#art_39> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2004-12-25/04-18> ;
