<https://legal.dz/resource/law/2004-12-25/04-18#version_art_28> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "العقوبات المقررة في هذا القانون غير قابلة للتخفيض حسب الشكل الآتي: عشرون (20) سنة سجنا, عندما تكون العقوبة المقررة هي السجن المؤبد, ثلثا (3/2) العقوبة المقررة في كل الحالات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_28_20041225_OpEnact_1f16719a2f> ;
    dzdoc:replacementText "العقوبات المقررة في هذا القانون غير قابلة للتخفيض حسب الشكل الآتي: عشرون (20) سنة سجنا, عندما تكون العقوبة المقررة هي السجن المؤبد, ثلثا (3/2) العقوبة المقررة في كل الحالات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2004-12-25/04-18#art_28> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2004-12-25/04-18#art_28> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2004-12-25/04-18> ;
