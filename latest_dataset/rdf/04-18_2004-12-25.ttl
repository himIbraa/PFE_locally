    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_37_20041225_OpEnact_a237a9cb88> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_37_obligation_0_13d15ac3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
