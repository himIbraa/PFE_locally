<https://legal.dz/resource/law/2004-12-25/04-18#version_art_11> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أمر قاضي التحقيق أو الجهة القضائية المختصة متهما بإجراء مراقبة طبية أو الخضوع لعلاج مزيل للتسمم ، فإن تنفيذ هذه الإجراءات يخضع لأحكام المواد من 7 إلى 9 من هذا القانون ، مع مراعاة أحكام المادة 125 مكرر 1 \"الفقرة 2-7\" من قانون الإجراءات الجزائية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_11_20041225_OpEnact_67da34e02e> ;
    dzdoc:replacementText "إذا أمر قاضي التحقيق أو الجهة القضائية المختصة متهما بإجراء مراقبة طبية أو الخضوع لعلاج مزيل للتسمم ، فإن تنفيذ هذه الإجراءات يخضع لأحكام المواد من 7 إلى 9 من هذا القانون ، مع مراعاة أحكام المادة 125 مكرر 1 \"الفقرة 2-7\" من قانون الإجراءات الجزائية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
