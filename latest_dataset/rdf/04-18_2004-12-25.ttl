<https://legal.dz/resource/law/2004-12-25/04-18#version_art_31> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تخفض العقوبات التي يتعرض لها مرتكب الجريمة أو شريكه, المنصوص عليها في المواد من 12 إلى 17 من هذا القانون إلى النصف , إذا مكن بعد تحريك الدعوى العمومية من إيقاف الفاعل الأصلي أو الشركاء في نفس الجريمة أو الجرائم الأخرى من نفس الطبيعة أو مساوية لها في الخطورة . وتخفض العقوبات المنصوص عليها في المواد من 18 إلى 23 من هذا القانون إلى السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_31_20041225_OpEnact_e87e0a4393> ;
    dzdoc:replacementText "تخفض العقوبات التي يتعرض لها مرتكب الجريمة أو شريكه, المنصوص عليها في المواد من 12 إلى 17 من هذا القانون إلى النصف , إذا مكن بعد تحريك الدعوى العمومية من إيقاف الفاعل الأصلي أو الشركاء في نفس الجريمة أو الجرائم الأخرى من نفس الطبيعة أو مساوية لها في الخطورة . وتخفض العقوبات المنصوص عليها في المواد من 18 إلى 23 من هذا القانون إلى السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة."@ar ;
