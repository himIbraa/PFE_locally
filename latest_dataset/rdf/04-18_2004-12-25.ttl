    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_13> .

<https://legal.dz/resource/law/2004-12-25/04-18#art_13_condition_1_46054f72> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/2004-12-25/04-18#art_13_condition_1_46054f72_role_63740b9f46> ;
    dznorm:conditionText "إذا تم تسليم أو عرض المخدرات أو المؤثرات العقلية حسب الشروط المحددة في الفقرة السابقة على قاصر أو معوق أو شخص يعالج بسبب إدمانه أو في مراكز تعليمية أو تربوية أو تكوينية أو صحية أو اجتماعية أو داخل هيئات عمومية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_13> ;
    dznorm:position 1 .

