    dzdoc:heading "التدابير الوقائية والعلاجية"@ar ;
    dzdoc:number "الثاني" ;
    dzdoc:position 1 .

dzterm:psychotropic_substances a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المؤثرات العقلية"@ar,
        "المؤثرات العقلية : كل مادة طبيعية كانت أم اصطناعية، أو كل منتوج طبيعي مدرج في الجدول الأول أو الثاني أو الثالث أو الرابع من اتفاقية المؤثرات العقلية لسنة 1971."@ar,
        "مؤثرات عقلية"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_d9ef934f1cc3> .

<https://legal.dz/resource/law/2004-12-25/04-18#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_3> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "العقوبات المقررة في هذا القانون غير قابلة للتخفيض حسب الشكل الآتي: عشرون (20) سنة سجنا, عندما تكون العقوبة المقررة هي السجن المؤبد, ثلثا (3/2) العقوبة المقررة في كل الحالات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_28_20041225_OpEnact_1f16719a2f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "28" ;
    dzdoc:position 21 .

<https://legal.dz/resource/law/2004-12-25/04-18#sec_1> a dzdoc:Section ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#body> ;
    dzdoc:directlyContains <https://legal.dz/resource/law/2004-12-25/04-18#art_1>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_2>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_3>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_4>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_5> ;
    dzdoc:eId "sec_1" ;
    dzdoc:hasArticle <https://legal.dz/resource/law/2004-12-25/04-18#art_1>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_2>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_3>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_4>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_5> ;
    dzdoc:heading "أحكام عامة"@ar ;
    dzdoc:number "الأول" ;
    dzdoc:position 0 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_1> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "يهدف هذا القانون إلى الوقاية من المخدرات والمؤثرات العقلية وقمع الاستعمال والاتجار غير المشروعين بها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_1_20041225_OpEnact_6f878939ec> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_1_obligation_0_ab22bfc5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "الأولى" ;
    dzdoc:position 0 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_3> ;
    dzdoc:eId "art_27" ;
    dzdoc:fullText "في حالة العود , تكون العقوبة التي يتعرض لها مرتكب الأفعال المنصوص عليها في هذا القانون كما يأتي: السجن المؤبد عندما تكون الجريمة معاقبا عليها بالحبس من عشر (10) سنوات إلى عشرين (20) سنة، السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة، عندما تكون الجريمة معاقبا عليها بالحبس من خمس (5) سنوات إلى عشر (10) سنوات, ضعف العقوبة المقررة لكل الجرائم الأخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_27_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_27_20041225_OpEnact_f048934c3a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "27" ;
    dzdoc:position 20 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2004-12-25/04-18#art_27_condition_0_f1e41b6f> .

<https://legal.dz/resource/law/2004-12-25/04-18#sec_4> a dzdoc:Section ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#body> ;
    dzdoc:directlyContains <https://legal.dz/resource/law/2004-12-25/04-18#art_33>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_35>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_36>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_37>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_38>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_39> ;
    dzdoc:eId "sec_4" ;
    dzdoc:hasArticle <https://legal.dz/resource/law/2004-12-25/04-18#art_33>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_35>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_36>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_37>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_38>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_39> ;
    dzdoc:heading "القواعد الإجرائية"@ar ;
    dzdoc:number "الرابع" ;
    dzdoc:position 3 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_2> ;
    dzdoc:eId "art_11" ;
    dzdoc:fullText "إذا أمر قاضي التحقيق أو الجهة القضائية المختصة متهما بإجراء مراقبة طبية أو الخضوع لعلاج مزيل للتسمم ، فإن تنفيذ هذه الإجراءات يخضع لأحكام المواد من 7 إلى 9 من هذا القانون ، مع مراعاة أحكام المادة 125 مكرر 1 \"الفقرة 2-7\" من قانون الإجراءات الجزائية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_11> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_11_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_11_20041225_OpEnact_67da34e02e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_11_obligation_0_f6b8fe22> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "المادة 11" ;
    dzdoc:position 8 ;
    dzdoc:references <https://legal.dz/resource/law/2004-12-25/04-18#art_7>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_9> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2004-12-25/04-18#art_11_extref_b4db7fd6> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2004-12-25/04-18#art_7>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_9> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2004-12-25/04-18#art_11_condition_0_027b3e7d> .

<https://legal.dz/resource/law/2004-12-25/04-18#art_22> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_3> ;
    dzdoc:eId "art_22" ;
    dzdoc:fullText "يعاقب كل من يحرض أو يشجع أو يحث بأية وسيلة كانت على ارتكاب الجرائم المنصوص عليها في هذا القانون بالعقوبات المقررة للجريمة أو الجرائم المرتكبة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_22> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_22_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_22_20041225_OpEnact_6a8cacb16c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_22_obligation_0_9aeb1e0c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "المادة 22" ;
    dzdoc:position 15 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_3> ;
    dzdoc:eId "art_30" ;
    dzdoc:fullText "يعفى من العقوبة المقررة كل من يبلغ السلطات الإدارية أو القضائية بكل جريمة منصوص عليها في هذا القانون , قبل البدء في تنفيذها أو الشروع فيها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2004-12-25/04-18#art_30_right_0_13e39f4d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_30> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_30_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_30_20041225_OpEnact_034f71cde9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "30" ;
    dzdoc:position 23 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2004-12-25/04-18#art_30_condition_0_7366da0d> .

<https://legal.dz/resource/law/2004-12-25/04-18#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_4> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "تأمر الجهة القضائية المختصة في كل الحالات المنصوص عليها في هذا القانون, بمصادرة المنشآت والتجهيزات والأملاك المنقولة والعقارية الأخرى المستعملة أو الموجهة للاستعمال قصد ارتكب الجريمة أيا كان مالكها , إلا إذا أثبت أصحابها حسن نيتهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_33_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_33_20041225_OpEnact_624709785e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_33_obligation_0_c7170a56> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "33" ;
    dzdoc:position 25 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2004-12-25/04-18#art_33_condition_0_57f155ba> ;
    dzdoc:usesTerm dzterm:judicial_authority .

<https://legal.dz/resource/law/2004-12-25/04-18#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_4> ;
    dzdoc:eId "art_39" ;
    dzdoc:fullText "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 13 ذي القعدة عام 1425 الموافق 25 ديسمبر سنة 2004. عبد العزيز بوتفليقة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_39> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_39_para_0>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_39_para_1>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_39_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_39_20041225_OpEnact_79df85aa11> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "39" ;
    dzdoc:position 30 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_1> ;
    dzdoc:eId "art_5" ;
    dzdoc:fullText "لا يسلم الترخيص المذكور في المادة 4 أعلاه، إلا الوزير المكلف بالصحة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_5_para_0>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_5_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_5_20041225_OpEnact_6eaf1ebae2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "5" ;
    dzdoc:position 4 ;
    dzdoc:references <https://legal.dz/resource/law/2004-12-25/04-18#art_4> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2004-12-25/04-18#art_4> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2004-12-25/04-18#art_5_condition_0_de7466ae> ;
    dzdoc:usesTerm dzterm:license,
        dzterm:minister .

<https://legal.dz/resource/law/2004-12-25/04-18#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_3> ;
    dzdoc:eId "art_29" ;
    dzdoc:fullText "في حالة الإدانة لمخالفة الأحكام المنصوص عليها في هذا القانون , للجهة القضائية المختصة أن تقضي بعقوبة الحرمان من الحقوق السياسية والمدنية والعائلية من خمس (5) سنوات إلى عشر (10) سنوات . ويجوز لها, زيادة على ذلك, الحكم بما يأتي: المنع من ممارسة المهنة التي ارتكبت الجريمة بمناسبتها لمدة لا تقل عن خمس (5) سنوات, المنع من الإقامة وفقا للأحكام المنصوص عليها في قانون العقوبات , سحب جواز السفر وكذا سحب رخصة السياقة لمدة لا تقل عن خمس (5) سنوات, المنع من حيازة أو حمل سلاح خاضع للترخيص لمدة لا تقل عن خمس (5) سنوات, مصادرة الأشياء التي استعملت أو كانت موجهة لارتكاب الجريمة أو الأشياء الناجمة عنها, الغلق لمدة لا تزيد عن عشر (10) سنوات بالنسبة للفنادق والمنازل المفروشة ومراكز الإيواء والحانات والمطاعم والنوادي وأماكن العروض أو أي مكان مفتوح للجمهور أو مستعمل من قبل الجمهور, حيث ارتكب المستغل أو شارك في ارتكاب الجرائم المنصوص عليها في المادتين 15 و 16 من هذا القانون."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2004-12-25/04-18#art_29_right_0_8bb8f729> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_29_para_0>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_29_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_29_20041225_OpEnact_f72e688800> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "29" ;
    dzdoc:position 22 ;
    dzdoc:references <https://legal.dz/resource/law/2004-12-25/04-18#art_15>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_16> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2004-12-25/04-18#art_15>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_16> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2004-12-25/04-18#art_29_condition_0_53f46b5c> ;
    dzdoc:usesTerm dzterm:penal_code .

<https://legal.dz/resource/law/2004-12-25/04-18#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_1> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "ترتب جميع النباتات والمواد المصنفة كمخدرات أو مؤثرات عقلية أو سلائف بقرار من الوزير المكلف بالصحة في أربعة (4) جداول تبعا لخطورتها وفائدتها الطبية ويخضع كل تعديل لهذه الجداول إلى الأشكال نفسها. تسجل النباتات والمواد بتسميتها الدولية، وإذا تعذر ذلك بتسميتها العلمية أو التسمية المتعارف عليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_3_para_0>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_3_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_3_20041225_OpEnact_d9ffc109a0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_3_obligation_0_e37978a9>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_3_obligation_1_e099d952> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "3" ;
    dzdoc:position 2 ;
    dzdoc:usesTerm dzterm:health_minister .

<https://legal.dz/resource/law/2004-12-25/04-18#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_3> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "تخفض العقوبات التي يتعرض لها مرتكب الجريمة أو شريكه, المنصوص عليها في المواد من 12 إلى 17 من هذا القانون إلى النصف , إذا مكن بعد تحريك الدعوى العمومية من إيقاف الفاعل الأصلي أو الشركاء في نفس الجريمة أو الجرائم الأخرى من نفس الطبيعة أو مساوية لها في الخطورة . وتخفض العقوبات المنصوص عليها في المواد من 18 إلى 23 من هذا القانون إلى السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_31_para_0>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_31_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_31_20041225_OpEnact_e87e0a4393> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_31_obligation_0_6068edf2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "31" ;
    dzdoc:position 24 ;
    dzdoc:references <https://legal.dz/resource/law/2004-12-25/04-18#art_12>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_17>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_18>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_23> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2004-12-25/04-18#art_12>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_17>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_18>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_23> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2004-12-25/04-18#art_31_condition_0_a9e5ef4c> .

<https://legal.dz/resource/law/2004-12-25/04-18#art_35> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_4> ;
    dzdoc:eId "art_35" ;
    dzdoc:fullText "يمكن أن تتابع وتحاكم الجهات القضائية الجزائرية كل من يرتكب جريمة منصوصا عليها في هذا القانون سواء كان جزائريا أو أجنبيا مقيما بالجزائر أو موجودا بها, أو كل شخص معنوي خاضع للقانون الجزائري, ولو خارج الإقليم الوطني, أو يكون قد ارتكب فعلا من الأفعال المكونة لأحد أركان الجريمة داخل الإقليم الجزائري حتى وإن كانت الأفعال الأخرى قد تم ارتكابها في بلدان أخرى ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2004-12-25/04-18#art_35_permission_0_f0844467> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2004-12-25/04-18#art_35_right_0_62c8bbc0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_35> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_35_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_35_20041225_OpEnact_06b35daf31> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "35" ;
    dzdoc:position 26 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_4> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "تلغى جميع الأحكام المخالفة لهذا القانون , لا سيما المواد 190 من 241 إلى 259 من القانون رقم 85-05 المؤرخ في 26 جمادى الأولى عام 1405 الموافق 16 فبراير سنة 1985 والمذكور أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_38_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_38_20041225_OpEnact_845dba0822> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_38_obligation_0_01b950c4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "38" ;
    dzdoc:position 29 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2004-12-25/04-18#art_38_extref_5ec02815>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_38_extref_71da5a7b>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_38_extref_c95c3b7d> .

<https://legal.dz/resource/law/2004-12-25/04-18#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_3> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "يعاقب بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.000.000 دج ، كل من: 1 - سهل للغير الاستعمال غير المشروع للمواد المخدرة أو المؤثرات العقلية بمقابل أو مجانا، سواء بتوفير المحل لهذا الغرض أو بأية وسيلة أخرى، وكذلك الأمر بالنسبة لكل من الملاك والمسيرين والمديرين والمستغلين بأية صفة كانت لفندق أو منزل مفروش أو نزل أو حانة أو مطعم أو ناد أو مكان عرض أو أي مكان مخصص للجمهور أو مستعمل من الجمهور، الذين يسمحون باستعمال المخدرات داخل هذه المؤسسات أو ملحقاتها أو في الأماكن المذكورة . 2 - وضع مخدرات أو مؤثرات عقلية في مواد غذائية أو في مشروبات دون علم المستهلكين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_15_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_15_20041225_OpEnact_2b7df5cac1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_15_obligation_0_531b554b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "15" ;
    dzdoc:position 12 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2004-12-25/04-18#art_15_condition_0_693ec432>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_15_condition_1_4e9b7d89> .

<https://legal.dz/resource/law/2004-12-25/04-18#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_4> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "زيادة على ضباط الشرطة القضائية المنصوص عليهم في المادة 12 وما يليها من قانون الإجراءات الجزائية , يمكن أن يقوم المهندسون الزراعيون ومفتشو الصيدلة المؤهلون قانونا من وصايتهم, تحت سلطة ضباط الشرطة القضائية, بالبحث عن الجرائم المنصوص عليها في هذا القانون ومعاينتها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2004-12-25/04-18#art_36_permission_0_d1362e6e> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2004-12-25/04-18#art_36_right_0_16d3966a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_36_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_36_20041225_OpEnact_546dde9560> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "36" ;
    dzdoc:position 27 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2004-12-25/04-18#art_36_extref_f8bd0a57> ;
    dzdoc:usesTerm dzterm:criminal_procedure_code,
        dzterm:judicial_police_officers .

<https://legal.dz/resource/law/2004-12-25/04-18#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_3> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "بغض النظر عن العقوبات المنصوص عليها بالنسبة للشخص الطبيعي، يعاقب الشخص المعنوي الذي يرتكب جريمة أو أكثر من الجرائم المنصوص عليها في المواد من 13 إلى 17 من هذا القانون بغرامة تعادل خمس (5) مرات الغرامة المقررة للشخص الطبيعي. وفي حالة ارتكاب الجرائم المنصوص عليها في المواد من 18 إلى 21 من هذا القانون، يعاقب الشخص المعنوي بغرامة تتراوح من 50.000.000 دج إلى 250.000.000 دج. وفي جميع الحالات، يتم الحكم بحل المؤسسة أو غلقها مؤقتا لمدة لا تفوق خمس (5) سنوات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_25> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_25_para_0>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_25_para_1>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_25_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_25_20041225_OpEnact_957c6cb625> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_25_obligation_0_95a86b64>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_25_obligation_1_bdd77953>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_25_obligation_2_70089f89> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "المادة 25" ;
    dzdoc:position 18 ;
    dzdoc:references <https://legal.dz/resource/law/2004-12-25/04-18#art_13>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_17>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_18>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_21> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2004-12-25/04-18#art_13>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_17>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_18>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_21> ;
    dzdoc:usesTerm dzterm:legal_entity .

<https://legal.dz/resource/law/2004-12-25/04-18#art_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_3> ;
    dzdoc:eId "art_14" ;
    dzdoc:fullText "يعاقب بالحبس من سنتين (2) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 200.000 دج كل من يعرقل أو يمنع بأي شكل من الأشكال الأعوان المكلفين بمعاينة الجرائم أثناء ممارسة وظائفهم أو المهام المخولة لهم بموجب أحكام هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_14_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_14_20041225_OpEnact_9515ad0114> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_14_obligation_0_7a8e4af1> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2004-12-25/04-18#art_14_prohibition_0_57a3e380> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "14" ;
    dzdoc:position 11 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2004-12-25/04-18#art_14_condition_0_7c703487> .

<https://legal.dz/resource/law/2004-12-25/04-18#art_26> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_3> ;
    dzdoc:eId "art_26" ;
    dzdoc:fullText "لا تطبق أحكام المادة 53 من قانون العقوبات على الجرائم المنصوص عليها في المواد من 12 إلى 23 من هذا القانون : إذا استخدم الجاني العنف أو الأسلحة ، إذا كان الجاني يمارس وظيفة عمومية وارتكب الجريمة أثناء تأدية وظيفته ، إذا ارتكب الجريمة ممتهن في الصحة أو شخص مكلف بمكافحة المخدرات أو استعمالها ، إذا تسببت المخدرات أو المؤثرات العقلية المسلمة في وفاة شخص، أو عدة أشخاص أو إحداث عاهة مستديمة ، إذا أضاف مرتكب الجريمة للمخدرات موادا من شأنها أن تزيد في خطورتها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_26> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_26_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_26_20041225_OpEnact_c9c6dda281> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_26_obligation_0_3f575711> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "26" ;
    dzdoc:position 19 ;
    dzdoc:references <https://legal.dz/resource/law/2004-12-25/04-18#art_12>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_23> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2004-12-25/04-18#art_26_extref_34830295> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2004-12-25/04-18#art_12>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_23> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2004-12-25/04-18#art_26_condition_0_151ad59b>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_26_condition_1_08d57be2>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_26_condition_2_94c6450c>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_26_condition_3_95679d32>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_26_condition_4_23b5f635> .

<https://legal.dz/resource/law/2004-12-25/04-18#art_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_2> ;
    dzdoc:eId "art_9" ;
    dzdoc:fullText "تطبق العقوبات المنصوص عليها في المادة 12 من هذا القانون على الأشخاص الذين يمتنعون عن تنفيذ قرار الخضوع للعلاج المزيل للتسمم ، دون الإخلال بتطبيق المادة 7 أعلاه من جديد، عند الاقتضاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_9_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_9_20041225_OpEnact_f0e29b2397> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_9_obligation_0_462e5693> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "المادة 9" ;
    dzdoc:position 7 ;
    dzdoc:references <https://legal.dz/resource/law/2004-12-25/04-18#art_12>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_7> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2004-12-25/04-18#art_12>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_7> .

<https://legal.dz/resource/law/2004-12-25/04-18#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_3> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "يعاقب الشريك في الجريمة أو في كل عمل تحضيري منصوص عليه في هذا القانون بنفس عقوبة الفاعل الأصلي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_23_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_23_20041225_OpEnact_2946b135b7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_23_obligation_0_5d19c058> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "المادة 23" ;
    dzdoc:position 16 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_3> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "يجوز للمحكمة أن تمنع أي أجنبي حكم عليه بسبب ارتكابه إحدى الجرائم المنصوص عليها في هذا القانون من الإقامة في الإقليم الجزائري إما نهائيا أو لمدة لا تقل عن عشر (10) سنوات. يترتب بقوة القانون على المنع من الإقامة في الإقليم الجزائري طرد المحكوم عليه إلى خارج الحدود بعد انقضاء العقوبة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2004-12-25/04-18#art_24_permission_0_9386ecbf> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2004-12-25/04-18#art_24_right_0_9386ecbf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_24_para_0>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_24_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_24_20041225_OpEnact_bb9eda7e5f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_24_obligation_0_cf279575> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "المادة 24" ;
    dzdoc:position 17 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_3> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "يعاقب بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.000.000 دج ، كل من: قدم عن قصد وصفة طبية صورية أو على سبيل المحاباة تحتوي على مؤثرات عقلية . سلم مؤثرات عقلية بدون وصفة أو كان على علم بالطابع الصوري أو المحاباة للوصفات الطبية . حاول الحصول على المؤثرات العقلية قصد البيع أو تحصل عليها بواسطة وصفات طبية صورية بناء على ما عرض عليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_16_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_16_20041225_OpEnact_f0acb4866e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_16_obligation_0_531b554b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "16" ;
    dzdoc:position 13 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2004-12-25/04-18#art_16_condition_0_0ad71910>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_16_condition_1_51e9990b>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_16_condition_2_b15c878a> .

<https://legal.dz/resource/law/2004-12-25/04-18#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#sec_2> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "لا تمارس الدعوى العمومية ضد الأشخاص الذين امتثلوا إلى العلاج الطبي الذي وصف لهم لإزالة التسمم وتابعوه حتى نهايته . ولا يجوز أيضا متابعة الأشخاص الذين استعملوا المخدرات أو المؤثرات العقلية استعمالا غير مشروع إذا ثبت أنهم خضعوا لعلاج مزيل للتسمم أو كانوا تحت المتابعة الطبية منذ حدوث الوقائع المنسوبة إليهم . الحالات المنصوص عليها في هذه المادة يحكم بمصادرة المواد وفي جميع والنباتات المحجوزة إن اقتضى الأمر بأمر من رئيس الجهة القضائية المختصة، بناء على طلب النيابة العامة. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2004-12-25/04-18#art_6_permission_0_8b149422> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2004-12-25/04-18#version_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2004-12-25/04-18#art_6_para_0>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_6_para_1>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_6_para_2>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_6_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_6_20041225_OpEnact_1139fbfd12> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2004-12-25/04-18#art_6_obligation_0_903aeda2>,
        <https://legal.dz/resource/law/2004-12-25/04-18#art_6_obligation_1_cc53dcc0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:introducedOn "2004-12-25"^^xsd:date ;
    dzdoc:number "المادة 6" ;
    dzdoc:position 5 ;
    dzdoc:references <https://legal.dz/resource/law/2004-12-25/04-18#art_6> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2004-12-25/04-18#art_6> ;
    dzdoc:usesTerm dzterm:drugs,
        dzterm:psychotropic_substances,
        dzterm:public_action .

<https://legal.dz/resource/law/2004-12-25/04-18#art_2_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_2> ;
    dzdoc:position 0 ;
    dzdoc:text "يقصد في مفهوم هذا القانون بما يأتي: المخدر: كل مادة طبيعية كانت أم اصطناعية، من المواد الواردة في الجدولين الأول والثاني من الاتفاقية الوحيدة للمخدرات لسنة 1961 بصيغتها بموجب بروتوكول سنة 1972. المعدلة المؤثرات العقلية : كل مادة طبيعية كانت أم اصطناعية، أو كل منتوج طبيعي مدرج في الجدول الأول أو الثاني أو الثالث أو الرابع من اتفاقية المؤثرات العقلية لسنة 1971. السلائف جميع المنتجات الكيماوية التي تستخدم في عمليات صنع المواد المخدرة والمؤثرات العقلية. المستحضر كل مزيج جامد أو سائل به مخدر ومؤثر عقلي. القنب الأطراف المزهرة أو المثمرة من نبتة القنب ولا يشمل البذور والأوراق غير المصحوبة بأطراف التي لم يستخرج الراتينج منها، أيا كان استخدامها. نبات القنب أي نبات من جنس القنب. خشخاش الأفيون كل شجيرة من فصيلة الخشخاش المنوم. شجيرة الكوكا: كل نوع من أنواع الشجيرات من جنس إريتروكسيلون. الاستعمال غير المشروع : الاستعمال الشخصي للمخدرات أو المؤثرات العقلية الموضوعة تحت الرقابة بدون وصفة طبية. الإدمان: حالة تبعية نفسانية أو تبعية نفسية جسمانية تجاه مخدر أو مؤثر عقلي. العلاج من الإدمان: العلاج الذي يهدف إلى إزالة التبعية النفسانية أو التبعية النفسية جسمانية تجاه مخدر أو مؤثر عقلي. الزراعة: يقصد بها زراعة خشخاش الأفيون، وجنبة الكوكا، ونبتة القنب. الإنتاج: عملية تتمثل في فصل الأفيون وأوراق الكوكا والقنب وراتينج القنب عن نباتاتها. الصنع جميع العمليات غير الإنتاج التي يتم الحصول بها على المخدرات والمؤثرات العقلية وتشمل التنقية وتحويل المخدرات إلى مخدرات أخرى. التصدير والاستيراد النقل المادي للمخدرات و/أو المؤثرات العقلية من دولة إلى دولة أخرى. النقل: نقل المواد الموضوعة تحت المراقبة داخل الإقليم الجزائري من مكان إلى آخر أو عن طريق العبور. دولة العبور : الدولة التي يجري عبر إقليمها نقل المواد غير المشروعة والمخدرات والمؤثرات العقلية والمواد الواردة في الجدول الأول والجدول الثاني غير المشروعة والتي ليست مكان منشئها الأصلي ولا مكان مقصدها النهائي."@ar .

