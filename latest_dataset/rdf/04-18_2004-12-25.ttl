    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_29> ;
    dznorm:position 0 ;
    dznorm:provisionText "للجهة القضائية المختصة أن تقضي بعقوبة الحرمان من الحقوق السياسية والمدنية والعائلية من خمس (5) سنوات إلى عشر (10) سنوات"@ar ;
    dznorm:sourceArticle "art_29" .

<https://legal.dz/resource/law/2004-12-25/04-18#art_30_condition_0_7366da0d> a dznorm:Condition ;
    dznorm:conditionText "قبل البدء في تنفيذها أو الشروع فيها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_30> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_30_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_30> ;
    dzdoc:position 0 ;
    dzdoc:text "يعفى من العقوبة المقررة كل من يبلغ السلطات الإدارية أو القضائية بكل جريمة منصوص عليها في هذا القانون, قبل البدء في تنفيذها أو الشروع فيها."@ar .

