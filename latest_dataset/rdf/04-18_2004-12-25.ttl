<https://legal.dz/resource/law/2004-12-25/04-18#art_38_obligation_0_01b950c4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_38> ;
    dznorm:position 0 ;
    dznorm:provisionText "تلغى جميع الأحكام المخالفة لهذا القانون"@ar ;
    dznorm:sourceArticle "art_38" .

<https://legal.dz/resource/law/2004-12-25/04-18#art_38_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_38> ;
    dzdoc:position 0 ;
    dzdoc:text "تلغى جميع الأحكام المخالفة لهذا القانون, لا سيما المواد 190 من 241 إلى 259 من القانون رقم 85-05 المؤرخ في 26 جمادى الأولى عام 1405 الموافق 16 فبراير سنة 1985 والمذكور أعلاه."@ar .

<https://legal.dz/resource/law/2004-12-25/04-18#art_39_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_39> ;
    dzdoc:position 0 ;
    dzdoc:text "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية."@ar .

<https://legal.dz/resource/law/2004-12-25/04-18#art_39_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_39> ;
    dzdoc:position 1 ;
    dzdoc:text "حرر بالجزائر في 13 ذي القعدة عام 1425 الموافق 25 ديسمبر سنة 2004."@ar .

<https://legal.dz/resource/law/2004-12-25/04-18#art_39_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_39> ;
    dzdoc:position 2 ;
    dzdoc:text "عبد العزيز بوتفليقة"@ar .

<https://legal.dz/resource/law/2004-12-25/04-18#art_3_obligation_0_e37978a9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_3> ;
    dznorm:position 0 ;
    dznorm:provisionText "ترتب جميع النباتات والمواد المصنفة كمخدرات أو مؤثرات عقلية أو سلائف بقرار من الوزير المكلف بالصحة في أربعة (4) جداول تبعا لخطورتها وفائدتها الطبية"@ar ;
    dznorm:sourceArticle "art_3" .

<https://legal.dz/resource/law/2004-12-25/04-18#art_3_obligation_1_e099d952> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_3> ;
    dznorm:position 1 ;
    dznorm:provisionText "تسجل النباتات والمواد بتسميتها الدولية، وإذا تعذر ذلك بتسميتها العلمية أو التسمية المتعارف عليها"@ar ;
    dznorm:sourceArticle "art_3" .

<https://legal.dz/resource/law/2004-12-25/04-18#art_3_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_3> ;
    dzdoc:position 0 ;
    dzdoc:text "ترتب جميع النباتات والمواد المصنفة كمخدرات أو مؤثرات عقلية أو سلائف بقرار من الوزير المكلف بالصحة في أربعة (4) جداول تبعا لخطورتها وفائدتها الطبية ويخضع كل تعديل لهذه الجداول إلى الأشكال نفسها."@ar .

<https://legal.dz/resource/law/2004-12-25/04-18#art_3_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_3> ;
    dzdoc:position 1 ;
    dzdoc:text "تسجل النباتات والمواد بتسميتها الدولية، وإذا تعذر ذلك بتسميتها العلمية أو التسمية المتعارف عليها."@ar .

<https://legal.dz/resource/law/2004-12-25/04-18#art_4_condition_0_082df2bd> a dznorm:Condition ;
    dznorm:conditionText "إلا إذا كان استعمال النباتات والمواد والمستحضرات موجها لأهداف طبية أو علمية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_4> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_4_condition_1_d11b8c4f> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/2004-12-25/04-18#art_4_condition_1_d11b8c4f_role_2217a5b914> ;
    dznorm:conditionText "إلا بناء على تحقيق اجتماعي حول السلوك الأخلاقي والمهني للشخص طالب الرخصة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_4> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_4_condition_1_d11b8c4f_role_2217a5b914> a dznorm:Role ;
    rdfs:label "تحقيق اجتماعي حول السلوك"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "إلا بناء على تحقيق اجتماعي حول السلوك الأخلاقي والمهني للشخص طالب الرخصة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_4> .

<https://legal.dz/resource/law/2004-12-25/04-18#art_4_condition_2_82ba8845> a dznorm:Condition ;
    dznorm:conditionText "لشخص حكم عليه بسبب الجرائم المنصوص عليها في هذا القانون"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_4> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_4_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_4> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يسلم الترخيص بالقيام بالعمليات المذكورة في المواد 17 و19 و 20 من هذا القانون، إلا إذا كان استعمال النباتات والمواد والمستحضرات موجها لأهداف طبية أو علمية."@ar .

<https://legal.dz/resource/law/2004-12-25/04-18#art_4_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_4> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا يمنح هذا الترخيص إلا بناء على تحقيق اجتماعي حول السلوك الأخلاقي والمهني للشخص طالب الرخصة."@ar .

<https://legal.dz/resource/law/2004-12-25/04-18#art_4_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_4> ;
    dzdoc:position 2 ;
    dzdoc:text "ولا يمكن أن يمنح هذا الترخيص لشخص حكم عليه بسبب الجرائم المنصوص عليها في هذا القانون."@ar .

<https://legal.dz/resource/law/2004-12-25/04-18#art_4_permission_0_77377614> a dznorm:Permission ;
