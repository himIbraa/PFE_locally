    dznorm:position 0 ;
    dznorm:provisionText "لا تمارس الدعوى العمومية ضد الأشخاص الذين امتثلوا إلى العلاج الطبي الذي وصف لهم لإزالة التسمم وتابعوه حتى نهايته"@ar ;
    dznorm:sourceArticle "art_6" .

<https://legal.dz/resource/law/2004-12-25/04-18#art_6_obligation_1_cc53dcc0_action_16933098d1> a dznorm:Action ;
    rdfs:label "أيضا متابعة الأشخاص الذين استعملوا"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "ولا يجوز أيضا متابعة الأشخاص الذين استعملوا المخدرات أو المؤثرات العقلية استعمالا غير مشروع إذا ثبت أنهم خضعوا لعلاج مزيل للتسمم أو كانوا تحت المتابعة الطبية منذ حدوث الوقائع المنسوبة إليهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_6> .

<https://legal.dz/resource/law/2004-12-25/04-18#art_6_obligation_1_cc53dcc0_condition_0> a dznorm:Condition ;
