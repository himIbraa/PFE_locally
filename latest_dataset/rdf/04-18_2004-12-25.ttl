dzorg:parliament a dzdoc:Organization ;
    rdfs:label "البرلمان"@ar ;
    dzdoc:frbrUri "/ontology/organization/dz/parliament"^^xsd:anyURI .

dzterm:addiction a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الإدمان: حالة تبعية نفسانية أو تبعية نفسية جسمانية تجاه مخدر أو مؤثر عقلي."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_6cb219c716e9> .

dzterm:addiction_treatment a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "العلاج من الإدمان: العلاج الذي يهدف إلى إزالة التبعية النفسانية أو التبعية النفسية جسمانية تجاه مخدر أو مؤثر عقلي."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_469a5bf063e2> .

dzterm:cannabis a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "القنب الأطراف المزهرة أو المثمرة من نبتة القنب ولا يشمل البذور والأوراق غير المصحوبة بأطراف التي لم يستخرج الراتينج منها، أيا كان استخدامها."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_1e5e3b75f36d> .

dzterm:cannabis_plant a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "نبات القنب أي نبات من جنس القنب."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_234d5d127ff9> .

dzterm:coca_bush a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "شجيرة الكوكا: كل نوع من أنواع الشجيرات من جنس إريتروكسيلون."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_7fc47c8daa15> .

dzterm:cultivation a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الزراعة: يقصد بها زراعة خشخاش الأفيون، وجنبة الكوكا، ونبتة القنب."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_395f677000aa> .

dzterm:export_import a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التصدير والاستيراد النقل المادي للمخدرات و/أو المؤثرات العقلية من دولة إلى دولة أخرى."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_e397cb78556b> .

dzterm:illicit_use a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الاستعمال غير المشروع : الاستعمال الشخصي للمخدرات أو المؤثرات العقلية الموضوعة تحت الرقابة بدون وصفة طبية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_bf2c7af8af1e> .

dzterm:manufacture a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الصنع جميع العمليات غير الإنتاج التي يتم الحصول بها على المخدرات والمؤثرات العقلية وتشمل التنقية وتحويل المخدرات إلى مخدرات أخرى."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_11d9de9275d3> .

dzterm:narcotic a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المخدر: كل مادة طبيعية كانت أم اصطناعية، من المواد الواردة في الجدولين الأول والثاني من الاتفاقية الوحيدة للمخدرات لسنة 1961 بصيغتها بموجب بروتوكول سنة 1972. المعدلة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_bf8fb0df2d6a> .

dzterm:opium_poppy a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "خشخاش الأفيون كل شجيرة من فصيلة الخشخاش المنوم."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_808ec21edf17> .

dzterm:precursors a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "السلائف جميع المنتجات الكيماوية التي تستخدم في عمليات صنع المواد المخدرة والمؤثرات العقلية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_ef20c68b74fb> .

dzterm:preparation a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المستحضر كل مزيج جامد أو سائل به مخدر ومؤثر عقلي."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_1a2c8f081b44> .

dzterm:production a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الإنتاج: عملية تتمثل في فصل الأفيون وأوراق الكوكا والقنب وراتينج القنب عن نباتاتها."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_944f56ce49f3> .

dzterm:transit_state a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "دولة العبور : الدولة التي يجري عبر إقليمها نقل المواد غير المشروعة والمخدرات والمؤثرات العقلية والمواد الواردة في الجدول الأول والجدول الثاني غير المشروعة والتي ليست مكان منشئها الأصلي ولا مكان مقصدها النهائي."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_aeaab3d0e7cd> .

dzterm:transport a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "النقل: نقل المواد الموضوعة تحت المراقبة داخل الإقليم الجزائري من مكان إلى آخر أو عن طريق العبور."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2004-12-25/04-18#art_2_defocc_5e49b06921b5> .

