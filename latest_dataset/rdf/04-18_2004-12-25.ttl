<https://legal.dz/resource/law/2004-12-25/04-18#art_11_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_11> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا أمر قاضي التحقيق أو الجهة القضائية المختصة متهما بإجراء مراقبة طبية أو الخضوع لعلاج مزيل للتسمم، فإن تنفيذ هذه الإجراءات يخضع لأحكام المواد من 7 إلى 9 من هذا القانون، مع مراعاة أحكام المادة 125 مكرر 1 \"الفقرة 2-7\" من قانون الإجراءات الجزائية."@ar .

<https://legal.dz/resource/law/2004-12-25/04-18#art_12_condition_0_75d730d6> a dznorm:Condition ;
    dznorm:conditionText "يستهلك أو يحوز من أجل الاستهلاك الشخصي مخدرات أو مؤثرات عقلية بصفة غير مشروعة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_12> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_12_obligation_0_d775af6b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_12> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من 5.000 دج إلى 50.000 دج أو بإحدى هاتين العقوبتين"@ar ;
    dznorm:sourceArticle "art_12" .

<https://legal.dz/resource/law/2004-12-25/04-18#art_12_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_12> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من 5.000 دج إلى 50.000 دج أو بإحدى هاتين العقوبتين كل شخص يستهلك أو يحوز من أجل الاستهلاك الشخصي مخدرات أو مؤثرات عقلية بصفة غير مشروعة."@ar .

