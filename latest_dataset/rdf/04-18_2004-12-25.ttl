<https://legal.dz/resource/law/2004-12-25/04-18#art_15_condition_0_693ec432> a dznorm:Condition ;
    dznorm:conditionText "سهل للغير الاستعمال غير المشروع للمواد المخدرة أو المؤثرات العقلية بمقابل أو مجانا، سواء بتوفير المحل لهذا الغرض أو بأية وسيلة أخرى، وكذلك الأمر بالنسبة لكل من الملاك والمسيرين والمديرين والمستغلين بأية صفة كانت لفندق أو منزل مفروش أو نزل أو حانة أو مطعم أو ناد أو مكان عرض أو أي مكان مخصص للجمهور أو مستعمل من الجمهور، الذين يسمحون باستعمال المخدرات داخل هذه المؤسسات أو ملحقاتها أو في الأماكن المذكورة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_15> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_15_condition_1_4e9b7d89> a dznorm:Condition ;
    dznorm:conditionText "وضع مخدرات أو مؤثرات عقلية في مواد غذائية أو في مشروبات دون علم المستهلكين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_15> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_15_obligation_0_531b554b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_15> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.000.000 دج"@ar ;
    dznorm:sourceArticle "art_15" .

<https://legal.dz/resource/law/2004-12-25/04-18#art_15_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_15> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.000.000 دج، كل من: 1 - سهل للغير الاستعمال غير المشروع للمواد المخدرة أو المؤثرات العقلية بمقابل أو مجانا، سواء بتوفير المحل لهذا الغرض أو بأية وسيلة أخرى، وكذلك الأمر بالنسبة لكل من الملاك والمسيرين والمديرين والمستغلين بأية صفة كانت لفندق أو منزل مفروش أو نزل أو حانة أو مطعم أو ناد أو مكان عرض أو أي مكان مخصص للجمهور أو مستعمل من الجمهور، الذين يسمحون باستعمال المخدرات داخل هذه المؤسسات أو ملحقاتها أو في الأماكن المذكورة. 2 - وضع مخدرات أو مؤثرات عقلية في مواد غذائية أو في مشروبات دون علم المستهلكين."@ar .

<https://legal.dz/resource/law/2004-12-25/04-18#art_16_condition_0_0ad71910> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/2004-12-25/04-18#art_16_condition_0_0ad71910_role_5561bb8b07> ;
    dznorm:conditionText "قدم عن قصد وصفة طبية صورية أو على سبيل المحاباة تحتوي على مؤثرات عقلية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_16> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2004-12-25/04-18#art_16_condition_0_0ad71910_role_5561bb8b07> a dznorm:Role ;
    rdfs:label "سبيل المحاباة تحتوي على"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
