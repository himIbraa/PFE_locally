<https://legal.dz/resource/law/2004-12-25/04-18#version_art_4> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يسلم الترخيص بالقيام بالعمليات المذكورة في المواد 17 و 19 و 20 من هذا القانون، إلا إذا كان استعمال النباتات والمواد والمستحضرات موجها لأهداف طبية أو علمية . ولا يمنح هذا الترخيص إلا بناء على تحقيق اجتماعي حول السلوك الأخلاقي والمهني للشخص طالب الرخصة . ولا يمكن أن يمنح هذا الترخيص لشخص حكم عليه بسبب الجرائم المنصوص عليها في هذا القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_4_20041225_OpEnact_e1b0268298> ;
    dzdoc:replacementText "لا يسلم الترخيص بالقيام بالعمليات المذكورة في المواد 17 و 19 و 20 من هذا القانون، إلا إذا كان استعمال النباتات والمواد والمستحضرات موجها لأهداف طبية أو علمية . ولا يمنح هذا الترخيص إلا بناء على تحقيق اجتماعي حول السلوك الأخلاقي والمهني للشخص طالب الرخصة . ولا يمكن أن يمنح هذا الترخيص لشخص حكم عليه بسبب الجرائم المنصوص عليها في هذا القانون ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2004-12-25/04-18#art_4> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2004-12-25/04-18#art_4> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2004-12-25/04-18> ;
