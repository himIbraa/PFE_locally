    dzdoc:evidenceText "يعاقب كل من يحرض أو يشجع أو يحث بأية وسيلة كانت على ارتكاب الجرائم المنصوص عليها في هذا القانون بالعقوبات المقررة للجريمة أو الجرائم المرتكبة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
