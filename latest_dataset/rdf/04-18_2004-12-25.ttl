<https://legal.dz/resource/law/2004-12-25/04-18#version_art_29> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة الإدانة لمخالفة الأحكام المنصوص عليها في هذا القانون , للجهة القضائية المختصة أن تقضي بعقوبة الحرمان من الحقوق السياسية والمدنية والعائلية من خمس (5) سنوات إلى عشر (10) سنوات . ويجوز لها, زيادة على ذلك, الحكم بما يأتي: المنع من ممارسة المهنة التي ارتكبت الجريمة بمناسبتها لمدة لا تقل عن خمس (5) سنوات, المنع من الإقامة وفقا للأحكام المنصوص عليها في قانون العقوبات , سحب جواز السفر وكذا سحب رخصة السياقة لمدة لا تقل عن خمس (5) سنوات, المنع من حيازة أو حمل سلاح خاضع للترخيص لمدة لا تقل عن خمس "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_29_20041225_OpEnact_f72e688800> ;
    dzdoc:replacementText "في حالة الإدانة لمخالفة الأحكام المنصوص عليها في هذا القانون , للجهة القضائية المختصة أن تقضي بعقوبة الحرمان من الحقوق السياسية والمدنية والعائلية من خمس (5) سنوات إلى عشر (10) سنوات . ويجوز لها, زيادة على ذلك, الحكم بما يأتي: المنع من ممارسة المهنة التي ارتكبت الجريمة بمناسبتها لمدة لا تقل عن خمس (5) سنوات, المنع من الإقامة وفقا للأحكام المنصوص عليها في قانون العقوبات , سحب جواز السفر وكذا سحب رخصة السياقة لمدة لا تقل عن خمس (5) سنوات, المنع من حيازة أو حمل سلاح خاضع للترخيص لمدة لا تقل عن خمس (5) سنوات, مصادرة الأشياء التي استعملت أو كانت موجهة لارتكاب الجريمة أو الأشياء الناجمة عنها, الغلق لمدة لا تزيد عن عشر (10) سنوات بالنسبة للفنادق والمنازل المفروشة ومراكز الإيواء والحانات والمطاعم والنوادي وأماكن العروض أو أي مكان مفتوح للجمهور أو مستعمل من قبل الجمهور, حيث ارتكب المستغل أو شارك في ارتكاب الجرائم المنصوص عليها في المادتين 15 و 16 من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2004-12-25/04-18#art_29> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2004-12-25/04-18#art_29> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2004-12-25"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2004-12-25/04-18#version_art_3> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ترتب جميع النباتات والمواد المصنفة كمخدرات أو مؤثرات عقلية أو سلائف بقرار من الوزير المكلف بالصحة في أربعة (4) جداول تبعا لخطورتها وفائدتها الطبية ويخضع كل تعديل لهذه الجداول إلى الأشكال نفسها. تسجل النباتات والمواد بتسميتها الدولية، وإذا تعذر ذلك بتسميتها العلمية أو التسمية المتعارف عليها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2004-12-25/04-18#version_art_3_20041225_OpEnact_d9ffc109a0> ;
    dzdoc:replacementText "ترتب جميع النباتات والمواد المصنفة كمخدرات أو مؤثرات عقلية أو سلائف بقرار من الوزير المكلف بالصحة في أربعة (4) جداول تبعا لخطورتها وفائدتها الطبية ويخضع كل تعديل لهذه الجداول إلى الأشكال نفسها. تسجل النباتات والمواد بتسميتها الدولية، وإذا تعذر ذلك بتسميتها العلمية أو التسمية المتعارف عليها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2004-12-25/04-18#art_3> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2004-12-25/04-18> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2004-12-25/04-18#art_3> ;
