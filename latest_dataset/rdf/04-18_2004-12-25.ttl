    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_16> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.000.000 دج"@ar ;
    dznorm:sourceArticle "art_16" .

<https://legal.dz/resource/law/2004-12-25/04-18#art_16_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_16> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.000.000 دج، كل من: قدم عن قصد وصفة طبية صورية أو على سبيل المحاباة تحتوي على مؤثرات عقلية. سلم مؤثرات عقلية بدون وصفة أو كان على علم بالطابع الصوري أو المحاباة للوصفات الطبية. حاول الحصول على المؤثرات العقلية قصد البيع أو تحصل عليها بواسطة وصفات طبية صورية بناء على ما عرض عليه."@ar .

<https://legal.dz/resource/law/2004-12-25/04-18#art_17_obligation_0_79b4cf25> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2004-12-25/04-18#art_17> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 5.000.000 دج إلى 50.000.000 دج كل من قام بطريقة غير مشروعة بإنتاج أو صنع أو حيازة أو عرض أو بيع أو وضع للبيع أو حصول وشراء قصد البيع أو التخزين أو استخراج أو تحضير أو توزيع أو تسليم بأية صفة كانت، أو سمسرة أو شحن أو نقل عن طريق العبور أو نقل المواد المخدرة أو المؤثرات العقلية."@ar ;
    dznorm:sourceArticle "art_17" .

