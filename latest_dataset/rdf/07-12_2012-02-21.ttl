<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_98> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يساهم المجلس الشعبي الولائي في حماية التراث الثقافي والفني والتاريخي والحفاظ عليه بمساهمة المصالح التقنية المؤهلة وبالتنسيق مع البلديات وكل هيئة وجمعية معنية . ويطور كل عمل يرمي إلى ترقية التراث الثقافي والفني والتاريخي بالاتصال مع المؤسسات والجمعيات المعنية ويقترح كل التدابير الضرورية لتثمينه والحفاظ عليه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_98_20120221_OpEnact_948368fd44> ;
    dzdoc:replacementText "يساهم المجلس الشعبي الولائي في حماية التراث الثقافي والفني والتاريخي والحفاظ عليه بمساهمة المصالح التقنية المؤهلة وبالتنسيق مع البلديات وكل هيئة وجمعية معنية . ويطور كل عمل يرمي إلى ترقية التراث الثقافي والفني والتاريخي بالاتصال مع المؤسسات والجمعيات المعنية ويقترح كل التدابير الضرورية لتثمينه والحفاظ عليه ."@ar ;
