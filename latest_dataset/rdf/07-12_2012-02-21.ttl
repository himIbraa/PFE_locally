    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ترسل الاستدعاءات إلى دورات المجلس الشعبي الولائي مرفقة بمشروع جدول الأعمال من رئيسه أو ممثله الذي يعين من ضمن نواب الرئيس . وتدون في سجل مداولات المجلس الشعبي الولائي . ويحدد جدول أعمال الدورة وتاريخ انعقادها بمشاركة الوالي بعد مشاورة أعضاء المكتب."@ar ;
    dzdoc:isAuthoritative true ;
