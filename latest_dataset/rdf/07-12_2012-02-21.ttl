<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_2_sec_1> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "يمكن أي عضو من أعضاء المجلس الشعبي الولائي توجيه سؤال كتابي لأي مدير أو مسؤول من مديري أو مسؤولي المصالح أو المديريات غير الممركزة للدولة المكلفة بمختلف قطاعات النشاط في إقليم الولاية . يجب على مديري ومسؤولي هذه المديريات والمصالح الإجابة كتابة عن أي سؤال يتعلق بنشاطهم على مستوى تراب الولاية في أجل لا يمكن أن يتجاوز الخمسة عشر (15) يوما من تاريخ تبليغه نص السؤال المبين على الإشعار بالاستلام ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_37_permission_0_6ad42fe5>,
        <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_37_permission_1_e3a59476> ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_37_right_0_7d424f91> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_37_para_0>,
        <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_37_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_37_20120221_OpEnact_6e275be78c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_37_obligation_0_f7c626e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:introducedOn "2012-02-21"^^xsd:date ;
    dzdoc:number "37" ;
    dzdoc:position 36 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_37_condition_0_6590033f> .

