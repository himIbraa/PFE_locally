    dznorm:position 0 .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_49_obligation_0_5f6d967a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
