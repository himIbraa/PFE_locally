<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_2_sec_1> ;
    dzdoc:eId "art_13" ;
    dzdoc:fullText "يعد المجلس الشعبي الولائي نظامه الداخلي ويصادق عليه . يحدد النظام الداخلي النموذجي للمجلس عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_13> ;
