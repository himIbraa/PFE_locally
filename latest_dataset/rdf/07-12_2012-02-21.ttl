<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_42> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ترسل استقالة عضو من المجلس الشعبي الولائي إلى رئيسه بواسطة ظرف محمول مقابل وصل استلام . ويقر المجلس الشعبي الولائي ذلك بموجب مداولة. ويبلغ الوالي بذلك فورا."@ar ;
