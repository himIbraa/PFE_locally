    dznorm:expressedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_4> ;
    dznorm:position 0 ;
    dznorm:provisionText "تكلف الولاية بصفتها الدائرة الإدارية بالأعمال غير الممركزة للدولة وتساهم في تنفيذ السياسات العمومية ضمن الإطار المحدد لتوزيع صلاحيات ووسائل الدولة بين مستوياتها المركزية والإقليمية."@ar ;
    dznorm:sourceArticle "art_4" .

