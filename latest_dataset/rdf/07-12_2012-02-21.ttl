<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_102> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_3_sec_1> ;
    dzdoc:eId "art_102" ;
    dzdoc:fullText "يسهر الوالي على نشر مداولات المجلس الشعبي الولائي وتنفيذها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_102> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_102_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_102_20120221_OpEnact_db06c51422> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_102_obligation_0_a2c2e79f> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:introducedOn "2012-02-21"^^xsd:date ;
    dzdoc:number "المادة 102" ;
    dzdoc:position 101 ;
    dzdoc:usesTerm dzterm:apw,
        dzterm:wali .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_108> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_3_sec_1> ;
    dzdoc:eId "art_108" ;
    dzdoc:fullText "يسهر الوالي على وضع المصالح الولائية ومؤسساتها العمومية وحسن سيرها ويتولى تنشيط ومراقبة نشاطاتها طبقا للتشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_108> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_108_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_108_20120221_OpEnact_579274eedd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_108_obligation_0_aa4fe3c0> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:introducedOn "2012-02-21"^^xsd:date ;
    dzdoc:number "المادة 108" ;
    dzdoc:position 107 ;
