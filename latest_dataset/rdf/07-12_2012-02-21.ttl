    dznorm:conditionText "في حالة حدوث ظروف استثنائية تحول دون تنصيب المجلس المنتخب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_48> ;
