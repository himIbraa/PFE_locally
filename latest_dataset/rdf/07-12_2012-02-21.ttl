<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_111> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينشط الوالي وينسق ويراقب نشاط المصالح غير الممركزة للدولة المكلفة بمختلف قطاعات النشاط في الولاية ، غير أنه يستثنى : أ) العمل التربوي والتنظيم في مجال التربية والتكوين والتعليم العالي والبحث العلمي، ب وعاء الضرائب وتحصيلها، ج) الرقابة المالية، د) إدارة الجمارك، ه) مفتشية العمل، و) مفتشية الوظيفة العمومية، ز) المصالح التي يتجاوز نشاطها بالنظر إلى طبيعته أو خصوصيته إقليم الولاية. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_111_20120221_OpEnact_883b1c3a26> ;
    dzdoc:replacementText "ينشط الوالي وينسق ويراقب نشاط المصالح غير الممركزة للدولة المكلفة بمختلف قطاعات النشاط في الولاية ، غير أنه يستثنى : أ) العمل التربوي والتنظيم في مجال التربية والتكوين والتعليم العالي والبحث العلمي، ب وعاء الضرائب وتحصيلها، ج) الرقابة المالية، د) إدارة الجمارك، ه) مفتشية العمل، و) مفتشية الوظيفة العمومية، ز) المصالح التي يتجاوز نشاطها بالنظر إلى طبيعته أو خصوصيته إقليم الولاية. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_111> ;
