<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_56> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن رئيس المجلس الشعبي الولائي أو عضو في المجلس يكون في وضعية تعارض مصالحه مع مصالح الولاية، بأسمائهم الشخصية أو أزواجهم أو أصولهم أو فروعهم إلى الدرجة الرابعة أو كوكلاء، حضور المداولة التي تعالج هذا الموضوع . وفي حالة المخالفة تكون هذه المداولة باطلة. يلزم كل عضو مجلس شعبي ولائي، يكون في وضعية تعارض مصالح بالتصريح بذلك لرئيس المجلس الشعبي الولائي . وفي حالة ما يكون رئيس المجلس الشعبي الولائي في وضعية تعارض مصالح متعلقة به ، يجب عليه التصريح بذلك للمجلس الشعبي الولائي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_56_20120221_OpEnact_18fdeb647c> ;
    dzdoc:replacementText "لا يمكن رئيس المجلس الشعبي الولائي أو عضو في المجلس يكون في وضعية تعارض مصالحه مع مصالح الولاية، بأسمائهم الشخصية أو أزواجهم أو أصولهم أو فروعهم إلى الدرجة الرابعة أو كوكلاء، حضور المداولة التي تعالج هذا الموضوع . وفي حالة المخالفة تكون هذه المداولة باطلة. يلزم كل عضو مجلس شعبي ولائي، يكون في وضعية تعارض مصالح بالتصريح بذلك لرئيس المجلس الشعبي الولائي . وفي حالة ما يكون رئيس المجلس الشعبي الولائي في وضعية تعارض مصالح متعلقة به ، يجب عليه التصريح بذلك للمجلس الشعبي الولائي ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_56> ;
