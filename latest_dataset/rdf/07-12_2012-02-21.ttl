<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_50> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تجرى انتخابات تجديد المجلس الشعبي الولائي المحل في أجل أقصاه ثلاثة (3) أشهر ابتداء من تاريخ الحل ، إلا في حالة المساس الخطير بالنظام العام . ولا يمكن بأي حال من الأحوال إجراؤها خلال السنة الأخيرة من العهدة الجارية. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
