<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_139> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتعين على الولاية حماية الأشخاص المذكورين في المادة 138 أعلاه، والدفاع عنهم من التهديدات أو الإهانات أو الافتراء أو التهجمات مهما تكن طبيعتها التي قد يتعرضون لها أثناء أداء مهامهم أو بمناسبتها . ويكون ل الولاية حق دعوى الرجوع ضد محدثي الأضرار ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
