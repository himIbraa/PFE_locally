<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_115> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتولى الوالي لتطبيق القرارات المتخذة في إطار المهام المبينة في المواد 112 و 113 و 114 أعلاه، تنسيق نشاطات مصالح الأمن المتواجدة على إقليم الولاية. وبهذه الصفة يلزم رؤساء مصالح الأمن بإعلامه في المقام الأول بكل القضايا المتعلقة بالأمن العام والنظام العمومي على مستوى الولاية . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_115_20120221_OpEnact_6700610d56> ;
    dzdoc:replacementText "يتولى الوالي لتطبيق القرارات المتخذة في إطار المهام المبينة في المواد 112 و 113 و 114 أعلاه، تنسيق نشاطات مصالح الأمن المتواجدة على إقليم الولاية. وبهذه الصفة يلزم رؤساء مصالح الأمن بإعلامه في المقام الأول بكل القضايا المتعلقة بالأمن العام والنظام العمومي على مستوى الولاية . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_115> ;
