<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_48> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم حل المجلس الشعبي الولائي وتجديده الكلي : في حالة خرق أحكام دستورية ، في حالة إلغاء انتخاب جميع أعضاء المجلس ، في حالة استقالة جماعية لأعضاء المجلس الشعبي الولائي ، عندما يكون الإبقاء على المجلس مصدرا لاختلالات خطيرة تم إثباتها أو من طبيعته المساس بمصالح المواطنين وطمأنينتهم ، عندما يصبح عدد المنتخبين أقل من الأغلبية المطلقة وذلك رغم تطبيق أحكام المادة 41 أعلاه ، في حالة اندماج بلديات أو ضمها أو تجزئتها ، في حالة حدوث ظروف استثنائية تحول دون تنصيب المجلس المنتخب ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_48_20120221_OpEnact_b5ed58bf2f> ;
    dzdoc:replacementText "يتم حل المجلس الشعبي الولائي وتجديده الكلي : في حالة خرق أحكام دستورية ، في حالة إلغاء انتخاب جميع أعضاء المجلس ، في حالة استقالة جماعية لأعضاء المجلس الشعبي الولائي ، عندما يكون الإبقاء على المجلس مصدرا لاختلالات خطيرة تم إثباتها أو من طبيعته المساس بمصالح المواطنين وطمأنينتهم ، عندما يصبح عدد المنتخبين أقل من الأغلبية المطلقة وذلك رغم تطبيق أحكام المادة 41 أعلاه ، في حالة اندماج بلديات أو ضمها أو تجزئتها ، في حالة حدوث ظروف استثنائية تحول دون تنصيب المجلس المنتخب ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_48> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
