    dzdoc:introducedOn "2012-02-21"^^xsd:date ;
    dzdoc:number "المادة 13" ;
    dzdoc:position 12 ;
    dzdoc:usesTerm dzterm:apw .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_135> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_4_sec_2> ;
    dzdoc:eId "art_135" ;
    dzdoc:fullText "تبرم الصفقات الخاصة بالأشغال أو الخدمات أو التوريدات للولاية ومؤسساتها العمومية ذات الطابع الإداري طبقا للقوانين والتنظيمات المعمول بها والمطبقة على الصفقات العمومية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_135> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_135_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_135_20120221_OpEnact_af12ff008c> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:introducedOn "2012-02-21"^^xsd:date ;
    dzdoc:number "المادة 135" ;
    dzdoc:position 134 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_135_condition_0_8968edf8> ;
    dzdoc:usesTerm dzterm:public_procurement .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_136> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_4_sec_2> ;
    dzdoc:eId "art_136" ;
    dzdoc:fullText "عندما تجرى مناقصة عمومية لحساب الولاية ، فإن الموظف الذي يجريها يساعده ثلاثة (3) منتخبين من تشكيلات سياسية مختلفة يعينهم المجلس الشعبي الولائي ويحضر المناقصة المحاسب المعين أو ممثله بصفة استشارية. ويتم إعداد محضر لهذه المناقصة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_136> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_136_para_0>,
        <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_136_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_136_20120221_OpEnact_56a22925ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:introducedOn "2012-02-21"^^xsd:date ;
    dzdoc:number "المادة 136" ;
    dzdoc:position 135 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_136_condition_0_dc6915e1> ;
    dzdoc:usesTerm dzterm:apw .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_137> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_4_sec_2> ;
    dzdoc:eId "art_137" ;
    dzdoc:fullText "عندما تبرم سلطة مكلفة بتسيير مؤسسة عمومية ولائية ذات طابع إداري مناقصة عمومية فإنه يجب أن يحضرها ثلاثة (3) منتخبين من تشكيلات سياسية مختلفة بأصوات تداولية وكذا المحاسب أو ممثله بصفة استشارية. ويتم إعداد محضر لهذه المناقصة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_137> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_137_para_0>,
        <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_137_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_137_20120221_OpEnact_aec2606f9a> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:introducedOn "2012-02-21"^^xsd:date ;
    dzdoc:number "المادة 137" ;
    dzdoc:position 136 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_137_condition_0_1e4c306b> .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_152> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_5_sec_1> ;
    dzdoc:eId "art_152" ;
    dzdoc:fullText "الولاية مسؤولة عن تسيير مواردها المالية الخاصة . وهي مسؤولة أيضا عن تعبئة مواردها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_152> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_152_para_0> ;
