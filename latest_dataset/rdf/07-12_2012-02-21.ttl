    dzdoc:eId "art_114" ;
    dzdoc:fullText "الوالي مسؤول على المحافظة على النظام والأمن والسلامة والسكينة العمومية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_114> ;
