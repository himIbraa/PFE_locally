<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_136> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما تجرى مناقصة عمومية لحساب الولاية ، فإن الموظف الذي يجريها يساعده ثلاثة (3) منتخبين من تشكيلات سياسية مختلفة يعينهم المجلس الشعبي الولائي ويحضر المناقصة المحاسب المعين أو ممثله بصفة استشارية. ويتم إعداد محضر لهذه المناقصة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_136_20120221_OpEnact_56a22925ea> ;
