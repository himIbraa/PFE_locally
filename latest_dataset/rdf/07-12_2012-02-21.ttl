<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_55> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تنفذ إلا بعد مصادقة الوزير المكلف بالداخلية عليها، في أجل أقصاه شهران (2) ، مداولات المجلس الشعبي الولائي المتضمنة ما يأتي : الميزانيات والحسابات، التنازل عن العقار واقتناءه أو تبادله، اتفاقيات التوأمة، الهبات والوصايا الأجنبية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_55_20120221_OpEnact_6b9072111c> ;
    dzdoc:replacementText "لا تنفذ إلا بعد مصادقة الوزير المكلف بالداخلية عليها، في أجل أقصاه شهران (2) ، مداولات المجلس الشعبي الولائي المتضمنة ما يأتي : الميزانيات والحسابات، التنازل عن العقار واقتناءه أو تبادله، اتفاقيات التوأمة، الهبات والوصايا الأجنبية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
