<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_26> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون جلسات المجلس الشعبي الولائي علنية. ويمكن أن يقرر المجلس الشعبي الولائي التداول في جلسة مغلقة في الحالتين الآتيتين : الكوارث الطبيعية أو التكنولوجية، دراسة الحالات التأديبية للمنتخبين."@ar ;
