        <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_131_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_131_20120221_OpEnact_486b5a3ddc> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:introducedOn "2012-02-21"^^xsd:date ;
    dzdoc:number "المادة 131" ;
