    dzdoc:evidenceText "مع مراعاة أحكام المادة 32 أدناه، يلصق مستخلص مداولة المجلس الشعبي الولائي، المصادق عليه بصفة من الوالي خلال الثمانية (8) أيام التي تلي دخولها حيز التنفيذ، في الأماكن المخصصة لإعلام الجمهور وبمقرات الولاية والبلديات وبكل وسيلة إعلام أخرى ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_31_20120221_OpEnact_06b01cab49> ;
