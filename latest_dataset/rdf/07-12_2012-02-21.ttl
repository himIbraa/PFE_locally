<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_33_obligation_0_9ebd9c85> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_33> ;
    dznorm:position 0 ;
    dznorm:provisionText "يشكل المجلس الشعبي الولائي من بين أعضائه لجانا دائمة للمسائل التابعة لمجال اختصاصه"@ar ;
    dznorm:sourceArticle "art_33" .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_33_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_33> ;
    dzdoc:position 0 ;
    dzdoc:text """يشكل المجلس الشعبي الولائي من بين أعضائه لجانا دائمة للمسائل التابعة لمجال اختصاصه ولا سيما المتعلقة بما يأتي :
            
            التربية والتعليم العالي والتكوين المهني،
            الاقتصاد والمالية،
            الصحة والنظافة وحماية البيئة،
            الاتصال وتكنولوجيات الإعلام،
            تهيئة الإقليم والنقل،
            التعمير والسكن،
            الري والفلاحة والغابات والصيد البحري والسياحة،
            الشؤون الاجتماعية والثقافة والشؤون الدينية والوقف والرياضة والشباب،
            التنمية المحلية، التجهيز والاستثمار والتشغيل. التربية والتعليم العالي والتكوين المهني، الاقتصاد والمالية، الصحة والنظافة وحماية البيئة، الاتصال وتكنولوجيات الإعلام، تهيئة الإقليم والنقل، التعمير والسكن، الري والفلاحة والغابات والصيد البحري والسياحة، الشؤون الاجتماعية والثقافة والشؤون الدينية والوقف والرياضة والشباب، التنمية المحلية، التجهيز والاستثمار والتشغيل."""@ar .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_33_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_33> ;
    dzdoc:position 1 ;
    dzdoc:text "ويمكنه أيضا تشكيل لجان خاصة لدراسة كل المسائل الأخرى التي تهم الولاية."@ar .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_34_condition_0_5b2dd766> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_34_condition_0_5b2dd766_role_5a6b54a28f> ;
    dznorm:conditionText "تشكل اللجان الدائمة أو الخاصة عن طريق مداولة يصادق عليها بالأغلبية المطلقة لأعضاء المجلس الشعبي الولائي بناء على اقتراح من رئيسه أو الأغلبية المطلقة لأعضائه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_34> ;
    dznorm:position 0 .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_34_condition_0_5b2dd766_role_5a6b54a28f> a dznorm:Role ;
