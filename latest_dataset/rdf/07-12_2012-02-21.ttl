<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_158> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تشتمل ميزانية الولاية على قسمين متوازنين في الإيرادات والنفقات وهما : قسم التسيير، قسم التجهيز والاستثمار. ينقسم كل قسم إلى إيرادات ونفقات متوازنة وجوبا. يقتطع من إيرادات التسيير مبلغ يخصص لتغطية نفقات قسم التجهيز والاستثمار وفقا للشروط التي يحددها التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_158_20120221_OpEnact_a89d328511> ;
    dzdoc:replacementText "تشتمل ميزانية الولاية على قسمين متوازنين في الإيرادات والنفقات وهما : قسم التسيير، قسم التجهيز والاستثمار. ينقسم كل قسم إلى إيرادات ونفقات متوازنة وجوبا. يقتطع من إيرادات التسيير مبلغ يخصص لتغطية نفقات قسم التجهيز والاستثمار وفقا للشروط التي يحددها التنظيم."@ar ;
