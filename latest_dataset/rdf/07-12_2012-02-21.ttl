<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_166> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عند غلق السنة المالية المعنية بتاريخ 31 مارس ، يعد الوالي الحساب الإداري للولاية ويعرضه على المجلس الشعبي الولائي للمصادقة عليه . تتم المصادقة على الحساب الإداري وإعداد حساب التسيير وكذا التقارب الدوري للحسابات طبقا للقوانين والتنظيمات المعمول بها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_166_20120221_OpEnact_537535415c> ;
