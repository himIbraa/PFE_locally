<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_38> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مع مراعاة أحكام المادة 39 أدناه تكون العهدة الانتخابية مجانية. إلا أن المنتخبين يستفيدون من تعويضات بمناسبة انعقاد دورات المجلس الشعبي الولائي أو مختلف اللجان التي يكونون أعضاء فيها . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_38_20120221_OpEnact_207731c54a> ;
    dzdoc:replacementText "مع مراعاة أحكام المادة 39 أدناه تكون العهدة الانتخابية مجانية. إلا أن المنتخبين يستفيدون من تعويضات بمناسبة انعقاد دورات المجلس الشعبي الولائي أو مختلف اللجان التي يكونون أعضاء فيها . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
