<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_41> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة الوفاة أو الاستقالة النهائية أو الإقصاء أو حصول المانع القانوني لمنتخب بـ المجلس الشعبي الولائي يتم استخلافه قانونا في أجل لا يتجاوز الشهر بالمرشح الذي يلي مباشرة آخر منتخب من نفس القائمة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
