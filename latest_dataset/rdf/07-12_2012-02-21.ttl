<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_51> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتداول المجلس الشعبي الولائي في الشؤون التي تدخل في مجال اختصاصاته . باستثناء الحالات المنصوص عليها صراحة في هذا القانون تتخذ المداولات بالأغلبية البسيطة لأعضاء المجلس الشعبي الولائي الحاضرين أو الممثلين عند التصويت . وفي حالة تساوي الأصوات يكون صوت الرئيس مرجحا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_51_20120221_OpEnact_a8551233ff> ;
    dzdoc:replacementText "يتداول المجلس الشعبي الولائي في الشؤون التي تدخل في مجال اختصاصاته . باستثناء الحالات المنصوص عليها صراحة في هذا القانون تتخذ المداولات بالأغلبية البسيطة لأعضاء المجلس الشعبي الولائي الحاضرين أو الممثلين عند التصويت . وفي حالة تساوي الأصوات يكون صوت الرئيس مرجحا."@ar ;
