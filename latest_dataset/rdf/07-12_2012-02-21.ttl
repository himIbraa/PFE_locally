    dzdoc:sourceTextSpan "تشكل اللجان الدائمة أو الخاصة عن طريق مداولة يصادق عليها بالأغلبية المطلقة لأعضاء المجلس الشعبي الولائي بناء على اقتراح من رئيسه أو الأغلبية المطلقة لأعضائه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_34> .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_34_obligation_0_ea811aad> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
