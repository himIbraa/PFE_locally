<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_74> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقدم المجلس الشعبي الولائي المساعدة للبلديات في إطار التكامل وانسجام الأعمال التي ينبغي القيام بها. ويمكنه المبادرة بكل الأعمال التي تهدف إلى إنجاز التجهيزات التي بحكم حجمها وأهميتها أو استعمالها، تتجاوز قدرات البلديات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_74_20120221_OpEnact_c7e14257c7> ;
