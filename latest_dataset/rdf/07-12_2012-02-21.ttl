<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_69> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتفرغ رئيس المجلس الشعبي الولائي ونواب الرئيس ورؤساء اللجان الدائمة بصفة تامة لعهدتهم الانتخابية . يتم انتداب المنتخبين المذكورين أعلاه، بصفة دائمة من أجل أداء مهامهم. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
