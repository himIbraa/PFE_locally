<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_100_20120221_OpEnact_7b2f57db89> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2012-02-21"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_100> ;
