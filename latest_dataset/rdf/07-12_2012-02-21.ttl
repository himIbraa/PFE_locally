    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_153> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:targetArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_153> ;
    dzdoc:targetDocument <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2012-02-21"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_154> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتلقى الولاية من الدولة إعانات ومخصصات تسيير بالنظر على الخصوص لما يأتي: عدم مساواة مداخيل الولايات عدم كفاية مداخيلها مقارنة بمهامها وصلاحياتها كما هو محدد في هذا القانون، عدم كفاية التغطية المالية للنفقات الإجبارية، التبعات الناجمة عن التكفل بحالات القوة القاهرة ولاسيما منها الكوارث الطبيعية أو الأضرار كما القانون، هي محددة في الأهداف الرامية إلى تلبية الاحتياجات المخولة لها قانونا، نقص القيمة للإيرادات الجبائية الولائية ولا سيما في إطار التشجيع على الاستثمار المنصوص عليه في قانون المالية. وتخ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_154_20120221_OpEnact_27a531c333> ;
    dzdoc:replacementText "تتلقى الولاية من الدولة إعانات ومخصصات تسيير بالنظر على الخصوص لما يأتي: عدم مساواة مداخيل الولايات عدم كفاية مداخيلها مقارنة بمهامها وصلاحياتها كما هو محدد في هذا القانون، عدم كفاية التغطية المالية للنفقات الإجبارية، التبعات الناجمة عن التكفل بحالات القوة القاهرة ولاسيما منها الكوارث الطبيعية أو الأضرار كما القانون، هي محددة في الأهداف الرامية إلى تلبية الاحتياجات المخولة لها قانونا، نقص القيمة للإيرادات الجبائية الولائية ولا سيما في إطار التشجيع على الاستثمار المنصوص عليه في قانون المالية. وتخصص إعانات الدولة الممنوحة للولاية للغرض الذي منحت من أجله . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_154> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
