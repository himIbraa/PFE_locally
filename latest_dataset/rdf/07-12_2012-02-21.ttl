    dznorm:position 1 ;
    dznorm:provisionText "وتعد الولاية جدولا سنويا يبين النتائج المحصل عليها في كل القطاعات ومعدلات نمو كل قطاع"@ar ;
    dznorm:sourceArticle "art_81" .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_81_para_0> a dzdoc:Paragraph ;
