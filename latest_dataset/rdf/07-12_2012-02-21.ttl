<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_2_sec_4> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "يمكن المجلس الشعبي الولائي أن يساهم في إنجاز برامج السكن ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_100_permission_0_5ac0d102> ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_100_right_0_d32ec040> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_100> ;
