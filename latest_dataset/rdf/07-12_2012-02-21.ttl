    dzdoc:versionSourceDocument <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:versionText "يحدد المجلس الشعبي الولائي المصالح العمومية التي يقرر استغلالها عن طريق الاستغلال المباشر."@ar .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_144_20120221_OpEnact_8a1f2bef7c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2012-02-21"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
