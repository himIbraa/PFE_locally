<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_1_sec_2> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "يخضع كل تعديل في الحدود الإقليمية للولاية إلى القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_10_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_10_20120221_OpEnact_a47a651896> ;
