<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_84> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يبادر المجلس الشعبي الولائي ويضع حيز التنفيذ كل عمل في مجال حماية وتوسيع وترقية الأراضي الفلاحية والتهيئة والتجهيز الريفي. ويشجع أعمال الوقاية من الكوارث والآفات الطبيعية. وبهذه الصفة، يبادر بكل الأعمال لمحاربة مخاطر الفيضانات والجفاف. ويتخذ كل الإجراءات الرامية إلى إنجاز أشغال تهيئة وتطهير وتنقية مجاري المياه في حدود إقليمه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_84_20120221_OpEnact_9e0ea1d840> ;
