<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_19> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تصح اجتماعات المجلس الشعبي الولائي إلا بحضور الأغلبية المطلقة لأعضائه الممارسين . وإذا لم يجتمع المجلس الشعبي الولائي بعد الاستدعاء الأول لعدم اكتمال النصاب القانوني، فإن المداولات المتخذة بعد الاستدعاء الثاني بفارق خمسة (5) أيام كاملة على الأقل، تكون صحيحة مهما يكن عدد الأعضاء الحاضرين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
