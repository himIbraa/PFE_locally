<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_177> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يدفع صندوق تضامن الجماعات المحلية المذكور في المادة 176 أعلاه، للولايات : تخصيص سنوي للمعادلة، موجه لقسم تسيير ميزانية الولاية، إعانات تجهيز موجهة لقسم التجهيز والاستثمار في ميزانية الولاية، إعانات استثنائية للولايات التي تواجه على الخصوص وضعية مالية صعبة، أو التي تواجه أحداثا كارثية أو غير متوقعة، إعانات تشجيع خاصة بالبحث والتكوين والاتصال، إعانات موجهة إلى تنمية المناطق الواجب ترقيتها. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_177_20120221_OpEnact_54d5f511ce> ;
    dzdoc:replacementText "يدفع صندوق تضامن الجماعات المحلية المذكور في المادة 176 أعلاه، للولايات : تخصيص سنوي للمعادلة، موجه لقسم تسيير ميزانية الولاية، إعانات تجهيز موجهة لقسم التجهيز والاستثمار في ميزانية الولاية، إعانات استثنائية للولايات التي تواجه على الخصوص وضعية مالية صعبة، أو التي تواجه أحداثا كارثية أو غير متوقعة، إعانات تشجيع خاصة بالبحث والتكوين والاتصال، إعانات موجهة إلى تنمية المناطق الواجب ترقيتها. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_177> ;
