<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_105> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمثل الوالي الولاية في جميع أعمال الحياة المدنية والإدارية حسب الأشكال والشروط المنصوص عليها في القوانين والتنظيمات المعمول بها . و يؤدي باسم الولاية، طبقا لأحكام هذا القانون كل أعمال إدارة الأملاك والحقوق التي تتكون منها ممتلكات الولاية . ويبلغ المجلس الشعبي الولائي بذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_105_20120221_OpEnact_72927e133e> ;
