    dzdoc:introducedOn "2012-02-21"^^xsd:date ;
    dzdoc:number "المادة 117" ;
    dzdoc:position 116 ;
    dzdoc:usesTerm dzterm:wali .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_120> a dzdoc:Article ;
