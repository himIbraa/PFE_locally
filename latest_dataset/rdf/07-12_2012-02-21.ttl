<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_173> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعتبر منجزة عند نهاية السنة المالية : كل النفقات المأمور بصرفها والمعترف بصحتها، كل الإيرادات التي كانت موضوع إصدار سندات تحصيل. تتولى الخزينة العمومية ، من أجل تغطية حاجات خزينة الولايات تحصيل الإيرادات وتقدم تسبيقات على الإيرادات الجبائية وفقا للأحكام المحددة في قانون المالية وطبقا للإجراءات المحددة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
