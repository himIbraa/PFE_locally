<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_149> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تعذر استغلال المصالح العمومية الولائية المذكورة في المادة 146 أعلاه عن طريق الاستغلال المباشر أو مؤسسة ، فإنه يمكن المجلس الشعبي الولائي الترخيص باستغلالها عن طريق الامتياز طبقا للتنظيم المعمول به . يخضع الامتياز لدفتر شروط نموذجي يحدد عن طريق التنظيم ويصادق عليه حسب القواعد والإجراءات المعمول بها. ويصادق على العقود المبرمة في هذا الشأن طبقا لأحكام المادة 54 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_149_20120221_OpEnact_2b652fdf3c> ;
    dzdoc:replacementText "إذا تعذر استغلال المصالح العمومية الولائية المذكورة في المادة 146 أعلاه عن طريق الاستغلال المباشر أو مؤسسة ، فإنه يمكن المجلس الشعبي الولائي الترخيص باستغلالها عن طريق الامتياز طبقا للتنظيم المعمول به . يخضع الامتياز لدفتر شروط نموذجي يحدد عن طريق التنظيم ويصادق عليه حسب القواعد والإجراءات المعمول بها. ويصادق على العقود المبرمة في هذا الشأن طبقا لأحكام المادة 54 من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_149> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
