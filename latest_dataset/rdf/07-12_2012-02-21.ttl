<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_37> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أي عضو من أعضاء المجلس الشعبي الولائي توجيه سؤال كتابي لأي مدير أو مسؤول من مديري أو مسؤولي المصالح أو المديريات غير الممركزة للدولة المكلفة بمختلف قطاعات النشاط في إقليم الولاية . يجب على مديري ومسؤولي هذه المديريات والمصالح الإجابة كتابة عن أي سؤال يتعلق بنشاطهم على مستوى تراب الولاية في أجل لا يمكن أن يتجاوز الخمسة عشر (15) يوما من تاريخ تبليغه نص السؤال المبين على الإشعار بالاستلام ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_37_20120221_OpEnact_6e275be78c> ;
    dzdoc:replacementText "يمكن أي عضو من أعضاء المجلس الشعبي الولائي توجيه سؤال كتابي لأي مدير أو مسؤول من مديري أو مسؤولي المصالح أو المديريات غير الممركزة للدولة المكلفة بمختلف قطاعات النشاط في إقليم الولاية . يجب على مديري ومسؤولي هذه المديريات والمصالح الإجابة كتابة عن أي سؤال يتعلق بنشاطهم على مستوى تراب الولاية في أجل لا يمكن أن يتجاوز الخمسة عشر (15) يوما من تاريخ تبليغه نص السؤال المبين على الإشعار بالاستلام ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_37> ;
