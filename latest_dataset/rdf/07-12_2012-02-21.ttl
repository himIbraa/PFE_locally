<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_14> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعقد المجلس الشعبي الولائي ، أربع (4) دورات عادية في السنة، مدة كل دورة منها خمسة عشر (15) يوما على الأكثر . تنعقد هذه الدورات وجوبا خلال أشهر مارس ويونيو وسبتمبر وديسمبر ولا يمكن جمعها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_14_20120221_OpEnact_f208503458> ;
