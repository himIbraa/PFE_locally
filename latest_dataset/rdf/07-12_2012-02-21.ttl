<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_117> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_3_sec_2> ;
    dzdoc:eId "art_117" ;
    dzdoc:fullText "الوالي مسؤول حسب الشروط التي تحددها القوانين والتنظيمات على وضع تدابير الدفاع والحماية التي لا تكتسي طابعا عسكريا وتنفيذها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_117> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_117_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_117_20120221_OpEnact_479872af84> ;
