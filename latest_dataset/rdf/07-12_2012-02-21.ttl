    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_146_20120221_OpEnact_c14fdc6cc1> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:introducedOn "2012-02-21"^^xsd:date ;
    dzdoc:number "المادة 146" ;
    dzdoc:position 145 ;
    dzdoc:usesTerm dzterm:apw .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_168> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_5_sec_3> ;
    dzdoc:eId "art_168" ;
    dzdoc:fullText "عندما لا يصوت على مشروع الميزانية بسبب اختلال داخل المجلس الشعبي الولائي ، فإن الوالي يقوم استثناء باستدعاء المجلس الشعبي الولائي في دورة غير عادية للمصادقة عليه. غير أن هذه الدورة لا تعقد إلا إذا تجاوزت الفترة القانونية للمصادقة على مشروع الميزانية وبعد تطبيق أحكام المادة 167 أعلاه . وفي حالة عدم توصل هذه الدورة إلى المصادقة على مشروع الميزانية ، يبلغ الوالي الوزير المكلف بالداخلية الذي يتخذ التدابير الملائمة لضبطها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_168> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_168_para_0>,
        <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_168_para_1>,
        <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_168_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_168_20120221_OpEnact_5728bf1749> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_168_obligation_0_fa7f9743> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:introducedOn "2012-02-21"^^xsd:date ;
    dzdoc:number "المادة 168" ;
    dzdoc:position 167 ;
    dzdoc:references <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_167> ;
    dzdoc:referencesInternal <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_167> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_168_condition_0_1f5c94e9>,
        <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_168_condition_1_fcabd1b9>,
        <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_168_condition_2_d4207ce5> ;
    dzdoc:usesTerm dzterm:apw,
        dzterm:minister_interior,
        dzterm:wali .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_2_sec_1> ;
    dzdoc:eId "art_45" ;
    dzdoc:fullText "يمكن أن يوقف بموجب مداولة لـ المجلس الشعبي الولائي ، كل منتخب يكون محل متابعة قضائية بسبب جناية أو جنحة لها صلة بالمال العام أو لأسباب مخلة بالشرف ولا تمكنه من متابعة عهدته الانتخابية بصفة صحيحة . يعلن التوقيف بموجب قرار معلل من الوزير المكلف بالداخلية إلى غاية صدور الحكم النهائي من الجهة القضائية المختصة. وفي حالة صدور حكم قضائي نهائي بالبراءة ، يستأنف المنتخب تلقائيا وفوريا ممارسة مهامه الانتخابية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_45_permission_0_a4c067a7> ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_45_right_0_d56a6565> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_45> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_45_para_0>,
        <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_45_para_1>,
        <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_45_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_45_20120221_OpEnact_0cd22c0ac9> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:introducedOn "2012-02-21"^^xsd:date ;
    dzdoc:number "45" ;
    dzdoc:position 44 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_45_condition_0_52e3e3de>,
        <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_45_condition_1_4f6f260f> ;
    dzdoc:usesTerm dzterm:apw,
        dzterm:minister_interior .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_2_sec_1> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "في حالة حل المجلس الشعبي الولائي ، يعين الوزير المكلف بالداخلية ، بناء على اقتراح من الوالي ، خلال العشرة (10) أيام التي تلي حل المجلس، مندوبية ولائية لممارسة الصلاحيات المخول إياها بموجب القوانين والتنظيمات المعمول بها إلى حين تنصيب المجلس الجديد . تنتهي مهمة المندوبية الولائية بقوة القانون فور تنصيب المجلس الشعبي الولائي الجديد. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_49_para_0>,
        <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_49_para_1>,
        <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_49_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_49_20120221_OpEnact_4a7313e9d8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_49_obligation_0_5f6d967a> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:introducedOn "2012-02-21"^^xsd:date ;
    dzdoc:number "49" ;
    dzdoc:position 48 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_49_condition_0_09082d7c> ;
    dzdoc:usesTerm dzterm:minister_interior,
        dzterm:provincial_assembly,
        dzterm:wali .

