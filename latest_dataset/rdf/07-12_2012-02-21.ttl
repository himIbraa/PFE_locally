<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_75> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يبادر المجلس الشعبي الولائي حسب قدرات وطابع و خصوصيات كل ولاية على عاتق الميزانية الخاصة بالولاية، بكل الأعمال التي من طبيعتها المساهمة في التنمية الاقتصادية والاجتماعية والثقافية وكذا إنجاز المعالم التذكارية بالتعاون مع البلديات. كما يمكنه طبقا للتشريع المعمول به في مجال ترقية الاستثمار، تشجيع كل مبادرة ترمي إلى تفضيل التنمية المنسجمة والمتوازنة لإقليمها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_75_20120221_OpEnact_1d916eaa34> ;
    dzdoc:replacementText "يبادر المجلس الشعبي الولائي حسب قدرات وطابع و خصوصيات كل ولاية على عاتق الميزانية الخاصة بالولاية، بكل الأعمال التي من طبيعتها المساهمة في التنمية الاقتصادية والاجتماعية والثقافية وكذا إنجاز المعالم التذكارية بالتعاون مع البلديات. كما يمكنه طبقا للتشريع المعمول به في مجال ترقية الاستثمار، تشجيع كل مبادرة ترمي إلى تفضيل التنمية المنسجمة والمتوازنة لإقليمها."@ar ;
