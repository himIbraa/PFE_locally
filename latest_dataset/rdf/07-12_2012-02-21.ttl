<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_87> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعمل المجلس الشعبي الولائي على تنمية الري المتوسط والصغير. كما يساعد تقنيا وماليا بلديات الولاية في مشاريع التزويد بالمياه الصالحة للشرب والتطهير وإعادة استعمال المياه التي تتجاوز الإطار الإقليمي للبلديات المعنية."@ar ;
