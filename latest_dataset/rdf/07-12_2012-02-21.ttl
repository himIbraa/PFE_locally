<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_43> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعلن في حالة تخلي عن العهدة، كل منتخب تغيب بدون عذر مقبول في أكثر من ثلاث (3) دورات عادية خلال نفس السنة. ويثبت التخلي عن العهدة من طرف المجلس الشعبي الولائي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_43_20120221_OpEnact_33da3109d4> ;
    dzdoc:replacementText "يعلن في حالة تخلي عن العهدة، كل منتخب تغيب بدون عذر مقبول في أكثر من ثلاث (3) دورات عادية خلال نفس السنة. ويثبت التخلي عن العهدة من طرف المجلس الشعبي الولائي ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_43> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:targetArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_43> ;
    dzdoc:targetDocument <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
