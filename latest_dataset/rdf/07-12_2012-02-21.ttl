<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_32> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مع مراعاة الأحكام التشريعية والتنظيمية الملزمة باحترام الحياة الخاصة للمواطن وبسرية الإعلام والنظام العام، يحق لكل شخص له مصلحة أن يطلع في عين المكان على محاضر مداولات المجلس الشعبي الولائي وأن يحصلعلى نسخة كاملة أو جزئية منها على نفقته . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_32_20120221_OpEnact_ec99b2b72e> ;
    dzdoc:replacementText "مع مراعاة الأحكام التشريعية والتنظيمية الملزمة باحترام الحياة الخاصة للمواطن وبسرية الإعلام والنظام العام، يحق لكل شخص له مصلحة أن يطلع في عين المكان على محاضر مداولات المجلس الشعبي الولائي وأن يحصلعلى نسخة كاملة أو جزئية منها على نفقته . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
