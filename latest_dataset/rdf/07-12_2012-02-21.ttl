<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_49> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة حل المجلس الشعبي الولائي ، يعين الوزير المكلف بالداخلية ، بناء على اقتراح من الوالي ، خلال العشرة (10) أيام التي تلي حل المجلس، مندوبية ولائية لممارسة الصلاحيات المخول إياها بموجب القوانين والتنظيمات المعمول بها إلى حين تنصيب المجلس الجديد . تنتهي مهمة المندوبية الولائية بقوة القانون فور تنصيب المجلس الشعبي الولائي الجديد. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_49_20120221_OpEnact_4a7313e9d8> ;
    dzdoc:replacementText "في حالة حل المجلس الشعبي الولائي ، يعين الوزير المكلف بالداخلية ، بناء على اقتراح من الوالي ، خلال العشرة (10) أيام التي تلي حل المجلس، مندوبية ولائية لممارسة الصلاحيات المخول إياها بموجب القوانين والتنظيمات المعمول بها إلى حين تنصيب المجلس الجديد . تنتهي مهمة المندوبية الولائية بقوة القانون فور تنصيب المجلس الشعبي الولائي الجديد. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_49> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:targetArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_49> ;
    dzdoc:targetDocument <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2012-02-21"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_5> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تخصص الدولة للولاية بصفتها الجماعة الإقليمية، الموارد المخصصة لتغطية الأعباء والصلاحيات المخولة لها بموجب القانون. وفي إطار القانون : يرافق كل مهمة تحول من الدولة إلى الولاية توفير الموارد المالية الضرورية للتكفل بها بصفة دائمة ، يجب أن يعوض كل تخفيض في الموارد الجبائية للولاية ناجم عن إجراء تتخذه الدولة ويتضمن إعفاء جبائيا أو تخفيضا في نسب الضريبة أو إلغائها بمورد يساوي على الأقل مبلغ الفارق عند التحصيل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_5_20120221_OpEnact_effe984d68> ;
    dzdoc:replacementText "تخصص الدولة للولاية بصفتها الجماعة الإقليمية، الموارد المخصصة لتغطية الأعباء والصلاحيات المخولة لها بموجب القانون. وفي إطار القانون : يرافق كل مهمة تحول من الدولة إلى الولاية توفير الموارد المالية الضرورية للتكفل بها بصفة دائمة ، يجب أن يعوض كل تخفيض في الموارد الجبائية للولاية ناجم عن إجراء تتخذه الدولة ويتضمن إعفاء جبائيا أو تخفيضا في نسب الضريبة أو إلغائها بمورد يساوي على الأقل مبلغ الفارق عند التحصيل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_5> ;
