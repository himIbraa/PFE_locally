<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_150> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن ولايتين أو أكثر إنشاء مؤسسات ولائية مشتركة لإدارة الممتلكات أو التجهيزات المنجزة بصفة مشتركة والتي يكون تسييرها المشترك ضروريا من الناحية التقنية والقانونية وذلك بعد مداولة مجالسها الشعبية الولائية، طبقا لأحكام المادة 54 من هذا القانون. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_150_20120221_OpEnact_ceba080744> ;
    dzdoc:replacementText "يمكن ولايتين أو أكثر إنشاء مؤسسات ولائية مشتركة لإدارة الممتلكات أو التجهيزات المنجزة بصفة مشتركة والتي يكون تسييرها المشترك ضروريا من الناحية التقنية والقانونية وذلك بعد مداولة مجالسها الشعبية الولائية، طبقا لأحكام المادة 54 من هذا القانون. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
