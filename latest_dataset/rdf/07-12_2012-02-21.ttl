<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_140> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الولاية مسؤولة مدنيا عن الأخطاء التي يرتكبها رئيس المجلس الشعبي الولائي والمنتخبون . وتتولى الولاية ممارسة حق دعوى الرجوع أمام الجهة القضائية المختصة ضد هؤلاء في حالة خطأ شخصي من جانبهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_140_20120221_OpEnact_3e7b48c502> ;
    dzdoc:replacementText "الولاية مسؤولة مدنيا عن الأخطاء التي يرتكبها رئيس المجلس الشعبي الولائي والمنتخبون . وتتولى الولاية ممارسة حق دعوى الرجوع أمام الجهة القضائية المختصة ضد هؤلاء في حالة خطأ شخصي من جانبهم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_140> ;
