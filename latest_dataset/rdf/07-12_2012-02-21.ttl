    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_95_20120221_OpEnact_4ac60ae198> ;
    dzdoc:replacementText "يساهم المجلس الشعبي الولائي ، بالاتصال مع البلديات، في تنفيذ كل الأعمال المتعلقة بمخطط تنظيم الإسعافات والكوارث والآفات الطبيعية والوقاية من الأوبئة ومكافحتها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_95> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:targetArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_95> ;
    dzdoc:targetDocument <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2012-02-21"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_96> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يساهم المجلس الشعبي الولائي بالتنسيق مع البلدية في كل نشاط اجتماعي يهدف إلى ضمان : تنفيذ البرنامج الوطني للتحكم في النمو الديمغرافي، حماية الأم والطفل، مساعدة الطفولة، مساعدة المسنين والأشخاص ذوي الاحتياجات الخاصة، مساعدة الأشخاص في وضع صعب والمحتاجين، التكفل بالمشردين والمختلين عقليا. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_96_20120221_OpEnact_e18a1688d1> ;
    dzdoc:replacementText "يساهم المجلس الشعبي الولائي بالتنسيق مع البلدية في كل نشاط اجتماعي يهدف إلى ضمان : تنفيذ البرنامج الوطني للتحكم في النمو الديمغرافي، حماية الأم والطفل، مساعدة الطفولة، مساعدة المسنين والأشخاص ذوي الاحتياجات الخاصة، مساعدة الأشخاص في وضع صعب والمحتاجين، التكفل بالمشردين والمختلين عقليا. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_96> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
