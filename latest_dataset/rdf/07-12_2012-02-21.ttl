<https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_78> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يساهم المجلس الشعبي الولائي في إعداد مخطط تهيئة إقليم الولاية ويراقب تطبيقه طبقا للقوانين والتنظيمات المعمول بها. ويعلمه الوالي بالنشاطات المحلية أو الجهوية أو الوطنية الخاصة بتهيئة الإقليم ويتداول قبل المصادقة على كل أداة مقررة في هذا المجال لها انعكاسات على مخطط تهيئة الولاية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
