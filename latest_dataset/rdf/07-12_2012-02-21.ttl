    dzdoc:position 9 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_10_condition_0_9dbd432f> .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#art_106> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#chp_3_sec_1> ;
    dzdoc:eId "art_106" ;
    dzdoc:fullText "يمثل الوالي الولاية أمام القضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_106> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_106_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-02-21/07-12#version_art_106_20120221_OpEnact_ac1ed2a7f8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-02-21/07-12#art_106_obligation_0_0724ac7b> ;
