    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم إعداد الوكالة بطلب من الموكل أمام أي سلطة مؤهلة لهذا الغرض. وتحدد الوكالة صراحة الجلسة أو الدورة التي حررت من أجلها هذه الوكالة. تقدم الوكالة إلى مكتب الدورة ولا تصح إلا لجلسة أو لدورة واحدة."@ar ;
