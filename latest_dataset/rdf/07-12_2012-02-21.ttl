<https://legal.dz/resource/organic-law/2012-02-21/07-12#preamble_segment_10> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#preamble> ;
    dzdoc:position 10 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبمقتضى الأمر رقم 59-75 المؤرخ في 20 رمضان عام 1395 الموافق 26 سبتمبر سنة 1975 والمتضمن القانون التجاري، المعدل والمتمم،"@ar .

<https://legal.dz/resource/organic-law/2012-02-21/07-12#preamble_segment_11> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-02-21/07-12#preamble> ;
