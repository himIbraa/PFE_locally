<https://legal.dz/resource/order/1975-09-26/75-59#art_186_condition_0_847741ff> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_186_condition_0_847741ff_ref_c071a27adec4> ;
