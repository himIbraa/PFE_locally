    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_575_condition_1_0d69a9e3> a dznorm:Condition ;
    dznorm:conditionText "إذا قررت الجمعية تخفيض رأس المال من دون أن يكون ذلك مبرر بخسائر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_575> ;
