<https://legal.dz/resource/order/1975-09-26/75-59#art_523_obligation_1_57ffce22> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
