    dznorm:conditionText "متى أثبت أنه صاحب الحق فيه بسلسلة غير منقطعة من التظهيرات ولو كان آخر تظهير على بياض"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_491> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_491_condition_0_01ef02c9_role_9195c95740> a dznorm:Role ;
    rdfs:label "بياض"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "متى أثبت أنه صاحب الحق فيه بسلسلة غير منقطعة من التظهيرات ولو كان آخر تظهير على بياض"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_491> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_491_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_491> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر من يحوز شيكا قابلا للتظهير أنه حامله الشرعي متى أثبت أنه صاحب الحق فيه بسلسلة غير منقطعة من التظهيرات ولو كان آخر تظهير على بياض، وتعد التظهيرات المشطبة على هذا الوضع كأن لم تكن، وإذا كان التظهير على بياض متبوعا بتظهير آخر فإن الموقع على هذا التظهير الأخير يعتبر قد اكتسب الشيك، بموجب تظهير على بياض."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_492_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_492> ;
    dzdoc:position 0 ;
    dzdoc:text "إن التظهير الموضوع على شيك لحامله يجعل المظهر مسؤولا بمقتضى الأحكام التي تسود الحق في الرجوع ولكن ليس من شأنه أن يحول السند إلى شيك لأمر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_493_condition_0_c2b207f5> a dznorm:Condition ;
    dznorm:conditionText "إلا إذا كان قد اكتسبه عن سوء نية أو كان قد ارتكب خطأ جسيما عند اكتسابه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_493> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_493_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_493> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا زالت يد شخص عن الشيك للأمر من شخص بأي حادث من الحوادث فلا يلزم المستفيد الذي يثبت أنه صاحب الحق فيه على الكيفية المبينة في المادة 491 بالتخلي عنه إلا إذا كان قد اكتسبه عن سوء نية أو كان قد ارتكب خطأ جسيما عند اكتسابه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_494_condition_0_9ba0caca> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_494_condition_0_9ba0caca_role_6e3fec355c> ;
    dznorm:conditionText "ما لم يكن حامله قد تعمد الحصول على الشيك للإضرار بالمدين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_494> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_494_condition_0_9ba0caca_role_6e3fec355c> a dznorm:Role ;
    rdfs:label "الشيك للإضرار بالمدين"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "ما لم يكن حامله قد تعمد الحصول على الشيك للإضرار بالمدين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_494> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_494_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_494> ;
    dzdoc:position 0 ;
    dzdoc:text "ليس لمن رفعت عليهم دعوى بموجب الشيك أن يحتجوا على حامله بدفوع مبنية على علاقاتهم الشخصية بساحبه أو بحملته السابقين ما لم يكن حامله قد تعمد الحصول على الشيك للإضرار بالمدين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_495_condition_0_cd658553> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_495_condition_0_cd658553_role_c95d6dbe65> ;
