<https://legal.dz/resource/order/1975-09-26/75-59#version_art_773> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يدعى الشركاء في نهاية التصفية للنظر في الحساب الختامي، وفي إبراء إدارة المصفي وإعفائه من الوكالة والتحقق من اختتام التصفية . فإذا لم يدع الشركاء فإنه يجوز لكل شريك أن يطلب قضائيا تعيين وكيل يكلف بالقيام بإجراءات الدعوة بموجب أمر مستعجل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_773_19750926_OpEnact_be5491bee7> ;
