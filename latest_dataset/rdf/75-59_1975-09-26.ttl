<https://legal.dz/resource/order/1975-09-26/75-59#art_221_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_221> ;
    dzdoc:position 0 ;
    dzdoc:text "لرئيس المحكمة أن يأمر بكل إجراءات التحقيق لتلقي جميع المعلومات عن وضعية المدين وتصرفاته."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_221_right_0_47a5e3d1> a dznorm:Right ;
