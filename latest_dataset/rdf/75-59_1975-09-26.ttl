    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_735_19750926_OpEnact_6b3244169f> ;
    dzdoc:replacementText "تنقضي دعوى البطلان إذا انقطع سبب البطلان في اليوم الذي تتولى فيه المحكمة النظر في الأصل ابتدائيا ، إلا إذا كان هذا البطلان مبنيا على عدم قانونية موضوع الشركة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_735> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_735> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_736> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمحكمة التي تتولى النظر في دعوى البطلان أن تحدد أجلا ولو تلقائيا للتمكن من إزالة البطلان . ولا يسوغ لها أن تقضي بالبطلان في أقل من شهرين من تاريخ طلب افتتاح الدعوى. إذا اقتضى الحال استدعاء الجمعية أو وقعت استشارة الشركاء لإزالة البطلان، وإذا ثبت استدعاء قانوني لتلك الجمعية أو إرسال نص مشاريع القرار مصحوبا بالمستندات التي يجب تسليمها للشركاء ، فإن المحكمة تقضي بحكم بمنح الأجل اللازم للشركاء لاتخاذ قرار."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_736_19750926_OpEnact_467d5ecdc1> ;
    dzdoc:replacementText "يجوز للمحكمة التي تتولى النظر في دعوى البطلان أن تحدد أجلا ولو تلقائيا للتمكن من إزالة البطلان . ولا يسوغ لها أن تقضي بالبطلان في أقل من شهرين من تاريخ طلب افتتاح الدعوى. إذا اقتضى الحال استدعاء الجمعية أو وقعت استشارة الشركاء لإزالة البطلان، وإذا ثبت استدعاء قانوني لتلك الجمعية أو إرسال نص مشاريع القرار مصحوبا بالمستندات التي يجب تسليمها للشركاء ، فإن المحكمة تقضي بحكم بمنح الأجل اللازم للشركاء لاتخاذ قرار."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_736> ;
