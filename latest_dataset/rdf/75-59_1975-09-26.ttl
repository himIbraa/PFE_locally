<https://legal.dz/resource/order/1975-09-26/75-59#version_art_289> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يفتح باب الطعن في التسوية القضائية أو الإفلاس الخاص بالشركاء في الالتزام بعضهم ضد البعض الآخر، بسبب الحصص المؤداة ، ما لم يكن مجموع الحصص المؤداة من التسويات القضائية والتفليسات فائضا على تمام مبلغ الدين من أصل وملحقات ، ففي هذه الحالة يعود ذلك الفائض، إلى أولئك الشركاء في الالتزام الذين كان الآخرون لهم كفلاء، وفقا لأسبقية التعهدات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_289_19750926_OpEnact_4d2ba11079> ;
