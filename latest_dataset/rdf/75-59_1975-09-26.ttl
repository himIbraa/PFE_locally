<https://legal.dz/resource/order/1975-09-26/75-59#version_art_54> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون الطالب ملزم تحت مسؤوليته بأن يوجه الدعوة لحضور هذه الخبرة بواسطة رسالة موصى عليها أو برقية ، ويمكن إدخال جميع الأطراف في الدعوى وخاصة المرسل و المرسل إليه و الناقل و الوكيل بالعمولة . على أنه يمكن الإعفاء من إتمام الإجراءات المقررة بهذه الفقرة كليا أو جزئيا بترخيص صريح ينص عليه في الأمر المذكور. ويمكن الأمر بإيداع الأشياء المتنازع فيها أو حجزها ثم نقلها إلى مستودع عمومي. ويحوز الأمر ببيعها تسديدا لنفقات النقل وغيرها من النفقات التي سبق ،صرفها، ويقرر الحاكم منح ثمن المبيع لمن قام بتسبيق تلك "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_54_19750926_OpEnact_1f7ad07b5e> ;
    dzdoc:replacementText "يكون الطالب ملزم تحت مسؤوليته بأن يوجه الدعوة لحضور هذه الخبرة بواسطة رسالة موصى عليها أو برقية ، ويمكن إدخال جميع الأطراف في الدعوى وخاصة المرسل و المرسل إليه و الناقل و الوكيل بالعمولة . على أنه يمكن الإعفاء من إتمام الإجراءات المقررة بهذه الفقرة كليا أو جزئيا بترخيص صريح ينص عليه في الأمر المذكور. ويمكن الأمر بإيداع الأشياء المتنازع فيها أو حجزها ثم نقلها إلى مستودع عمومي. ويحوز الأمر ببيعها تسديدا لنفقات النقل وغيرها من النفقات التي سبق ،صرفها، ويقرر الحاكم منح ثمن المبيع لمن قام بتسبيق تلك المصاريف من الأطراف."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_54> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_54> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_540> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
