<https://legal.dz/resource/order/1975-09-26/75-59#version_art_500> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن الشيك واجب الوفاء لدى الإطلاع وكل شرط مخالف لذلك يعتبر كأن لم يكن. إذا قدم الشيك للوفاء قبل اليوم المعين فيه كتاريخ لإصداره يكون واجب الوفاء في يوم تقديمه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_500_19750926_OpEnact_5131d63524> ;
