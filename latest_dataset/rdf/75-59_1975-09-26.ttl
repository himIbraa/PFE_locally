<https://legal.dz/resource/order/1975-09-26/75-59#art_158_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_158> ;
    dzdoc:position 0 ;
    dzdoc:text "يظل امتياز الدائن المرتهن ساريا طبقا لهذا القانون إذا أصبح المال المحمل بالامتياز مالا ثابتا بالتخصيص."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_159_obligation_0_72b985fd> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_159_obligation_0_72b985fd_action_e1ef6585d8> ;
