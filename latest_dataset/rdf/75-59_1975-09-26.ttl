<https://legal.dz/resource/order/1975-09-26/75-59#art_149> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_7> ;
    dzdoc:eId "art_149" ;
    dzdoc:fullText "لا يجوز أن يتدخل بطريق مباشر أو غير مباشر ولو بالتبعية كسماسرة أو وسطاء أو مستشارين مهنيين في التنازلات والرهون المتعلقة بالمحلات التجارية كما لا يجوز لهم أن يكونوا تحت أي اسم كان مودعين لأثمان بيع المحلات التجارية : الأفراد المحكوم عليهم بجريمة أو تفليس أو سرقة أو خيانة الأمانة أو الاحتيال أو اختلاس مرتكب من مودع عمومي أو ابتزاز الأموال أو التوقيع أو القيم أو إصدار شيك عن سوء نية بدون رصيد أو المس باعتماد الدولة أو اليمين الكاذبة أو الشهادة الكاذبة أو إغراء شاهد أو المحاولة أو الاشتراك في إحدى الجرائم أو الجنح المشار إليها أعلاه ، المفلسون الذين لم يرد لهم اعتبارهم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_149_permission_0_f0b32cfd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_149> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_149_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_149_19750926_OpEnact_59a3150e7e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_149_obligation_0_b308fd6c> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_149_prohibition_0_f0b32cfd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 149" ;
    dzdoc:position 151 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_149_condition_0_dab8f10b>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_149_condition_1_f6c34670> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_8> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "يجب على المدين الذي يرغب في بيع كل أو جزء من الأموال المحملة بالديون عن طريق البيع الاختياري أن يطلب، إذا وقع ذلك قبل دفع المستحق من المبالغ المضمونة طبقا لهذا القانون ، الموافقة المسبقة من الدائن المرتهن ، وخلاف ذلك، الإذن من قاضي الأمور المستعجلة للمحكمة التي تفصل بالدرجة الأخيرة وإلا تعرض المدين للعقوبات المنصوص عليها في المادة 167 من هذا القانون. يجوز للدائن المرتهن أو من يحل محله التمتع بحق الامتياز المنصوص عليه في المادة 132 لممارسة الامتياز الناتج عن الرهن وذلك إذا توفرت شروط النشر المطلوبة في هذا القانون ووضعت اللوحة على الأموال المثقلة بالدين وذلك طبقا ل المادة 154 المشار إليها أعلاه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_157_permission_0_7cba4755> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_157_right_0_4b1dbf37> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_157_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_157_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_157_19750926_OpEnact_d796614f71> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_157_obligation_0_4431d34c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "157" ;
    dzdoc:position 159 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_132>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_154>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_167> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_132>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_154>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_167> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_157_condition_0_99583cd8> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_196> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_2_sec_6> ;
    dzdoc:eId "art_196" ;
    dzdoc:fullText "يتعين على المستأجر طيلة مدة الدعوى الاستمرار في سداد بدلات الإيجار المستحقة حسب السعر القديم، أو عند الاقتضاء، حسب السعر الذي يمكن تجديده على أي حال بصفة مؤقتة من طرف الجهة القضائية التي طرحت أمامها القضية وفقا ل المادة السابقة ما عدا إجراء الحساب بين المؤجر والمستأجر بعد التحديد النهائي لسعر الإيجار المجدد. وفي حالة عدم حصول اتفاق بين الطرفين في مهلة شهر واحد من تاريخ تبليغ الحكم النهائي على شروط الإيجار الجديد ، يعتبر الأمر أو الحكم المتضمن تحديد بدل الإيجار أو شروط الإيجار الجديد بمثابة عقد إيجار."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_196_permission_0_71aef2f8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_196> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_196_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_196_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_196_19750926_OpEnact_5cb481a244> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_196_obligation_0_5d04bf22> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 196" ;
    dzdoc:position 200 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_195> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_195> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_196_condition_0_9bc02e0c> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_216> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_1> ;
    dzdoc:eId "art_216" ;
    dzdoc:fullText "يمكن أن تفتح كذلك التسوية القضائية أو الإفلاس بناء على تكليف الدائن بالحضور كيفما كانت طبيعة دينه، ولا سيما ذلك الدين الناتج عن فاتورة قابلة للدفع في أجل محدد. ويمكن المحكمة أن تتسلم القضية تلقائيا بعد الاستماع للمدين أو استدعائه قانونا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_216_permission_0_58089646> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_216> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_216_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_216_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_216_19750926_OpEnact_f15fa9ce03> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "216" ;
    dzdoc:position 220 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_217> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_1> ;
    dzdoc:eId "art_217" ;
    dzdoc:fullText "تخضع الشركات ذات رؤوس أموال عمومية كليا أو جزئيا لأحكام هذا الباب المتعلق بالإفلاس والتسويات القضائية. لا تطبق أحكام المادة 352 من هذا القانون في حالة ما إذا كان إجراء التصفية يعني شركة مذكورة في المقطع الأول أعلاه. غير أنه يمكن أن تتخذ السلطة العمومية المؤهلة عن طريق التنظيم، تدابير تسديد مستحقات الدائنين. وتشمل التدابير المذكورة في المقطع السابق قفل الإجراء الجاري، طبقا لأحكام المادة 357 أدناه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_217_permission_0_b98d532b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_217> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_217_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_217_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_217_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_217_para_3> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_217_19750926_OpEnact_a5c1dc8270> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "217" ;
    dzdoc:position 221 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_352>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_357> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_352>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_357> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_282> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_1> ;
    dzdoc:eId "art_282" ;
    dzdoc:fullText "يجرى تحقيق الديون من طرف وكيل التفليسة يعاونه المراقبون إن عينوا، وذلك بحضور المدين أو بعد استدعائه قانونا برسالة موصى عليها مع طلب العلم بالوصول . إذا ناقش وكيل التفليسة الدين كله أو بعضه يتعين عليه إخبار الدائن برسالة موصى عليها مع طلب العلم بالوصول . وللدائن أجل ثمانية أيام لتقديم بيانات كتابية أو شفاهية . ويقدم وكيل التفليسة مقترحاته حول قبول أو رفض الديون المناقشة أم لا. غير أن الديون المشار إليها في القانون العام للضرائب وقانون الجمارك غير قابلة للمنازعة إلا بالشروط المنصوص عليها بالقانونين المذكورين وتقبل على وجه معجل."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_282_right_0_731822a5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_282> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_282_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_282_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_282_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_282_para_3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_282_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_282_19750926_OpEnact_912e57dc5a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_282_obligation_0_dab50e69>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_282_obligation_1_f91e8d3b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 282" ;
    dzdoc:position 287 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_282_condition_0_3bf5daa2> ;
    dzdoc:usesTerm dzterm:receiver .

<https://legal.dz/resource/order/1975-09-26/75-59#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_2> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "يثبت الرهن المتمم من تاجر أو غير تاجر لأجل عمل من الأعمال التجارية، تجاه الغير وبالنسبة للمتعاقدين طبقا لأحكام المادة 30 أعلاه. ويثبت الرهن أيضا بالنسبة للسندات القابلة للتحويل بتظهير قانوني يشير إلى أن القيم قد سلمت على وجه الضمان. أما بالنسبة للأسهم وحصص الشركاء في الشركات المالية والصناعية والتجارية أو المدنية والتي يحصل نقلها بموجب تحويل في دفاتر الشركة يجب أن يثبت الرهن بعقد رسمي ويجب أن تقيد هذه العملية على سبيل الضمان في الدفاتر المذكورة . ويبقى العمل جاريا بالأحكام الخاصة بالديون المتعلقة بالأموال المنقولة التي لا يمكن أن يبلغ فيها المحال له بالنسبة للغير إلا بالتبليغ بالحوالة والواقع للمدين. ويجب أن تثبت حوالة الدين المتعلق بالأموال المنقولة بعقد رسمي . وتحصل السندات التجارية المسلمة كرهن من طرف الدائن المرتهن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_31_permission_0_014dbb95> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_31_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_31_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_31_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_31_para_3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_31_para_4>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_31_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_31_19750926_OpEnact_b7427879c0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_31_obligation_0_2d9db00b>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_31_obligation_1_b383fd3f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "31" ;
    dzdoc:position 33 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_30> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_30> ;
    dzdoc:usesTerm dzterm:pledge .

<https://legal.dz/resource/order/1975-09-26/75-59#art_404> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_404" ;
    dzdoc:fullText "يمكن للمسحوب عليه أن يطلب عرض القبول عليه مرة ثانية في اليوم الذي يلي العرض الأول ولا يمكن للمعنيين أن تقبل منهم دعوى بعدم استجابة هذا الطلب إلا إذا كان هذا الطلب مضمنا في الاحتجاج . لا يكون الحامل ملزما بالتخلي عن السفتجة للمسحوب عليه عند عرضها للقبول ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_404_permission_0_3a6f8f23> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_404_right_0_be6be8fc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_404> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_404_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_404_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_404_19750926_OpEnact_d8e023d9ec> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_404_obligation_0_f4a40ed4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 404" ;
    dzdoc:position 409 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_404_condition_0_184c088b> ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:drawee,
        dzterm:holder .

<https://legal.dz/resource/order/1975-09-26/75-59#art_406> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_406" ;
    dzdoc:fullText "إذا عين الساحب في السفتجة مكانا للدفع غير المكان الذي به موطن المسحوب عليه ، بدون أن يعين شخصا آخر يجب الدفع لديه ، يمكن للمسحوب عليه تعيينه عند القبول وإذا قبل بدون أن يعينه يعد بأنه التزم بنفسه في مكان الأداء. وإذا كانت السفتجة واجبة الأداء في موطن المسحوب عليه جاز لهذا الأخير أن يعين في صيغة القبول عنوانا بنفس المكان الذي يجب الدفع فيه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_406_permission_0_255bd92f> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_406_right_0_2a23cea0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_406_right_1_a0dc40bd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_406> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_406_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_406_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_406_19750926_OpEnact_516901f2e2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 406" ;
    dzdoc:position 411 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_406_condition_0_73180a8e>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_406_condition_1_12d1f7b6> ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:drawee,
        dzterm:drawer .

<https://legal.dz/resource/order/1975-09-26/75-59#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_2> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "يحق للمرسل إبدال اسم المرسل إليه أو استرداد الأشياء المنقولة ما دامت في حيازة الناقل ، بشرط أن يدفع له أجرة النقل عن المسافة المقطوعة وأن يعرض له ما صرفه وما لحقه من الضرر بسبب استردادها . على أنه لا يجوز للمرسل أن يمارس هذا الحق : إذا تم تسليم سند النقل إلى المرسل إليه فينتقل إليه هذا الحق ، إذا كان المرسل تسلم سند النقل وعجز عن تقديمه ، إذا طلب المرسل إليه استلام الأشياء بعد وصولها إلى المكان الموجهة إليه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_42_permission_0_d36d5835> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_42_right_0_56736760> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_42> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_42_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_42_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_42_19750926_OpEnact_7584bea580> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_42_prohibition_0_d36d5835> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 42" ;
    dzdoc:position 44 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_42_condition_0_6f214722>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_42_condition_1_f8b49b6a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_42_condition_2_d2b01de1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_42_condition_3_55c24cc4>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_42_condition_4_2941de5c> ;
    dzdoc:usesTerm dzterm:carrier,
        dzterm:sender,
        dzterm:sender_to .

<https://legal.dz/resource/order/1975-09-26/75-59#art_437> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_8> ;
    dzdoc:eId "art_437" ;
    dzdoc:fullText "بعد انقضاء الآجال المعينة : لتقديم السفتجة الواجب وفاؤها لدى الإطلاع أو في أجل معين لدى الإطلاع، ولتحرير الاحتجاج لعدم القبول أو الوفاء، ولتقديم السفتجة للوفاء في حالة شرط الرجوع بلا مصاريف. تسقط حقوق الحامل ضد المظهرين والساحب وغيرهما من الملزمين باستثناء القابل. على أن هذا السقوط لا يحصل في حق الساحب إلا إذا أثبت وجود مقابل الوفاء في الاستحقاق وفي هذه الحالة لا يبقى للحامل إلا حق رفع الدعوى على الشخص الذي سحبت عليه السفتجة . وإذا لم تقدم السفتجة للقبول في الأجل الذي اشترطه الساحب تسقط حقوق الحامل في الرجوع لعدم الوفاء أو لعدم القبول ما لم يقتض مضمون الشرط أن الساحب لم يقصد سوى إعفاءه من ضمان القبول . وإذا ورد شرط بتعيين أجل للتقديم في أحد التظهيرات فلا يمكن لغير المظهر التمسك به."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_437_permission_0_537b5be1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_437> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_437_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_437_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_437_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_437_para_3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_437_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_437_19750926_OpEnact_f069c73bd7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 437" ;
    dzdoc:position 442 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_437_condition_0_bfe35405>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_437_condition_1_978786c3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_437_condition_2_ee7a9551>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_437_condition_3_ae22f1ff>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_437_condition_4_a09e11c4> ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:holder .

<https://legal.dz/resource/order/1975-09-26/75-59#art_447> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_8> ;
    dzdoc:eId "art_447" ;
    dzdoc:fullText "لا يجوز تراكم نسخ الرجوع . وكل مظهر أو ساحب لا يمكن أن يتحمل إلا واحدا منها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_447_permission_0_90ebf6e8>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_447_permission_1_1355334c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_447> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_447_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_447_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_447_19750926_OpEnact_90f4b6b5e4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_447_obligation_0_67c6780b>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_447_obligation_1_f2b1c20d> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_447_prohibition_0_90ebf6e8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 447" ;
