    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_585> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتعين على الشركة أن تلحق بهذه الوثيقة قائمة المديرين، وعند الاقتضاء قائمة مندوبي حسابات القائمين بمهامهم"@ar ;
    dznorm:sourceArticle "art_585" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_585_obligation_0_747f97f2_role_87acdcf1b1> a dznorm:Role ;
    rdfs:label "الشركة أن تلحق بهذه"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يتعين على الشركة أن تلحق بهذه الوثيقة قائمة المديرين، وعند الاقتضاء قائمة مندوبي حسابات القائمين بمهامهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_585> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_585_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_585> ;
    dzdoc:position 0 ;
    dzdoc:text "لكل شريك الحق في : الحصول في أي وقت كان بمركز الشركة على نسخة مطابقة للأصل من القانون الأساسي السري المفعول يوم الطلب. ويتعين على الشركة أن تلحق بهذه الوثيقة قائمة المديرين، وعند الاقتضاء قائمة مندوبي حسابات القائمين بمهامهم، ولا يسوغ لها مقابل هذا التسليم أن تطلب مبلغا زائدا عن المبلغ المحدد بموجب النظام الساري المفعول، الإطلاع في أي وقت كان بمقر الشركة وبنفسه على الوثائق التالية: حساب الاستغلال العام وحساب النتائج والميزانيات والجرد والتقارير المعروضة على الجمعيات العامة ومحاضر هذه الجمعيات الخاصة بالسنين الثلاث والأخيرة، ما عدا ما يخص الجرد الذي يستتبع حق الإطلاع عليه حق الأخذ نسخة منه. ولهذا الغرض يسوغ للشريك أن يستعين بخبير معتمد. الإطلاع أو أخذ نسخة خلال مدة الخمسة عشر يوما السابقة لانعقاد كل جمعية من نص القرارات المعروضة وتقرير إدارة الشركة وكذلك عند الاقتضاء تقرير مندوب الحسابات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_585_right_0_cbc3286d> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
