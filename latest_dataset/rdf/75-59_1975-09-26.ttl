<https://legal.dz/resource/order/1975-09-26/75-59#art_65> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_3> ;
    dzdoc:eId "art_65" ;
    dzdoc:fullText "يكون باطلا كل شرط بإعفاء الناقل كليا أو جزئيا من مسؤوليته المتسببة عن الأضرار البدنية الحاصلة للمسافرين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_65> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_65_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_65_19750926_OpEnact_1844cc6008> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 65" ;
    dzdoc:position 67 ;
    dzdoc:usesTerm dzterm:carrier .

<https://legal.dz/resource/order/1975-09-26/75-59#art_652> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_652" ;
    dzdoc:fullText "يمثل رئيس مجلس المديرين الشركة في علاقاتها مع الغير. غير أنه يجوز أن يؤهل القانون الأساسي مجلس المراقبة لمنح نفس سلطة التمثيل لعضو أو عدة أعضاء آخرين في مجلس المديرين . لا يحتج على الغير بأحكام القانون الأساسي التي تحدد سلطة تمثيل أعضاء مجلس المديرين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_652_permission_0_36f4eacd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_652> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_652_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_652_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_652_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_652_19750926_OpEnact_ee3c482b3a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 652" ;
    dzdoc:position 711 ;
    dzdoc:usesTerm dzterm:board_of_directors,
        dzterm:statutes,
        dzterm:supervisory_board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_675> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_675" ;
    dzdoc:fullText "تتخذ الجمعية العامة العادية كل القرارات غير المذكورة في المادة 674 السابقة. ولا يصح تداولها في الدعوة الأولى إلا إذا حاز عدد المساهمين الحاضرين أو الممثلين على الأقل ربع الأسهم التي لها الحق في التصويت ولا يشترط أي نصاب في الدعوة الثانية. وتبت بأغلبية الأصوات المعبر عنها ، ولا تؤخذ الأوراق البيضاء بعين الاعتبار إذا أجريت العملية عن طريق الاقتراع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_675> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_675_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_675_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_675_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_675_19750926_OpEnact_e83cd617c7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "675" ;
    dzdoc:position 734 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_674> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_674> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_675_condition_0_b18a9280> ;
    dzdoc:usesTerm dzterm:general_assembly .

<https://legal.dz/resource/order/1975-09-26/75-59#art_676> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_676" ;
    dzdoc:fullText "تجتمع الجمعية العامة العادية مرة على الأقل في السنة خلال الستة أشهر التي تسبق قفل السنة المالية ، فيما عدا تمديد هذا الأجل بناء على طلب مجلس الإدارة أو مجلس المديرين حسب الحالة، بأمر من الجهة القضائية المختصة التي تبت في ذلك بناء على عريضة. ولا يقبل هذا الأمر أي طعن. ويقدم مجلس الإدارة أو مجلس المديرين إلى الجمعية العامة بعد تلاوة تقريره جدول حسابات النتائج والوثائق التلخيصية والحصيلة . وفضلا عن ذلك، يشير مندوبو الحسابات في تقريرهم إلى إتمام المهمة التي أسندت إليهم طبقا ل المادة 715 مكرر 4 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_676> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_676_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_676_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_676_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_676_19750926_OpEnact_807d0e2f66> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_676_obligation_0_07ee4ffb>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_676_obligation_1_5cb22714> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "676" ;
    dzdoc:position 735 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4> ;
    dzdoc:usesTerm dzterm:board_of_directors,
        dzterm:board_of_managers,
        dzterm:general_assembly .

<https://legal.dz/resource/order/1975-09-26/75-59#art_691> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_691" ;
    dzdoc:fullText "للجمعية العامة غير العادية وحدها حق الاختصاص باتخاذ قرار زيادة رأس المال بناء على تقرير مجلس الإدارة أو مجلس المديرين حسب الحالات. و إذا تحققت زيادة رأس المال بإلحاق الاحتياط أو الأرباح أو علاوات الإصدار أو تحويل سندات الاستحقاق ، فتفصل الجمعية العامة خلافا لما ورد في المادة 674 أعلاه، حسب شروط النصاب والأغلبية المنصوص عليها في المادة 675 أعلاه. ويجوز للجمعية العامة أن تفوض لمجلس الإدارة أو لمجلس المديرين السلطات اللازمة لتحقيق زيادة رأس المال مرة واحدة أو أكثر، وتحديد الكيفيات ومعاينة التنفيذ والقيام بإجراء التعديل المناسب للقانون الأساسي . ويعتبر كأن لم يكن كل شرط ورد في القانون الأساسي يخول مجلس الإدارة أو مجلس المديرين ، حسب الحالة، سلطة تقرير زيادة رأس المال."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_691_right_0_2cd9f8df>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_691_right_1_7835d32d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_691> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_691_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_691_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_691_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_691_19750926_OpEnact_23e2c5ab3a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "691" ;
    dzdoc:position 750 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_674>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_675> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_674>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_675> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_691_condition_0_9ac0c656> ;
    dzdoc:usesTerm dzterm:board_of_directors,
        dzterm:board_of_managers,
        dzterm:general_assembly .

<https://legal.dz/resource/order/1975-09-26/75-59#art_709> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:capital_amortization ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_709" ;
    dzdoc:fullText "يتم استهلاك رأس المال بموجب حكم في القانون الأساسي أو قرار من الجمعية العامة غير العادية وبواسطة مبالغ قابلة للتوزيع. ولا يمكن تحقيق هذا الاستهلاك إلا عن طريق التسديد المتساوي عن كل سهم من نفس الصنف ولا يترتب عنه تخفيض في رأس المال. وتعتبر الأسهم كلية إسهما انتفاعية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_709_permission_0_d286a5e7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_709> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_709_defocc_3e0d5aaa7ccf> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_709_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_709_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_709_19750926_OpEnact_f100ca1508> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "709" ;
    dzdoc:position 767 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_709_condition_0_349e6c58> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_113> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_6> ;
    dzdoc:eId "art_715_bis_113" ;
    dzdoc:fullText "يملك أصحاب شهادات الاستثمار حقا تفضيليا في اكتتاب القيم المنقولة المذكورة في المادة 715 مكرر 110 ، أعلاه . وعندما يمكن أن تسمح هذه القيم المنقولة بمنح شهادات استثمار ، يمارس ذلك الحق وفقا للشروط المنصوص عليها في هذا القسم الفرعي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_113_permission_0_1e14951d> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_113_right_0_464418ee> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_113> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_113_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_113_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_113_19750926_OpEnact_c0dc3f510c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 113" ;
    dzdoc:position 887 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_110> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_110> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_113_condition_0_996a81bc> ;
    dzdoc:usesTerm dzterm:securities .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_119> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_6> ;
    dzdoc:eId "art_715_bis_119" ;
    dzdoc:fullText "لا يجوز أن يكون سعر إصدار سندات الاستحقاق القابلة للتحويل أقل من القيمة الاسمية للأسهم التي تؤول إلى أصحاب سندات الاستحقاق في حالة اختيار التحويل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_119_permission_0_7b9f68f3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_119> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_119_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_119_19750926_OpEnact_ced0bf432c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_119_obligation_0_9292885f> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_119_prohibition_0_7b9f68f3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 119" ;
    dzdoc:position 893 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_124> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_6> ;
    dzdoc:eId "art_715_bis_124" ;
    dzdoc:fullText "يجوز طلب التحويل وفق أجل وشروط محددة في عقد الإصدار، في حالة إصدار سندات استحقاق قابلة للتحويل إلى أسهم في أي وقت . ويكون للأسهم المسلمة لأصحاب سندات الاستحقاق الحق في الأرباح المدفوعة بعنوان السنة المالية التي طلب فيها التحويل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_124_permission_0_2f754ea0> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_124_right_0_58eb0e1a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_124_right_1_dd9ae822> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_124> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_124_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_124_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_124_19750926_OpEnact_2a9df1b3f2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 124" ;
    dzdoc:position 898 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_8> ;
    dzdoc:eId "art_715_bis_17" ;
    dzdoc:fullText "يتطلب التحويل إلى شركة تضامن موافقة كل الشركاء . يتقرر التحويل إلى شركة توصية بسيطة أو شركة مساهمة حسب الشروط المنصوص عليها لتعديل القانون الأساسي وبموافقة كل الشركاء الذين يقبلون أن يصبحوا شركاء متضامنين . ويتم التحويل إلى شركة ذات مسؤولية محدودة وفقا للشروط المقررة لتعديل القانون الأساسي لهذا النوع من الشركات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_17> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_17_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_17_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_17_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_17_19750926_OpEnact_a879a4da04> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_17_obligation_0_8cac4417> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 17" ;
    dzdoc:position 791 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_17_condition_0_3c957240>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_17_condition_1_051cc29c>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_17_condition_2_a0ab202c> ;
    dzdoc:usesTerm dzterm:general_partnership,
        dzterm:joint_stock_company,
        dzterm:limited_liability_company,
        dzterm:limited_partnership .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_10> ;
    dzdoc:eId "art_715_bis_21" ;
    dzdoc:fullText "يجوز أن يعتبر مؤسسو الشركة ، الذين أسند إليهم البطلان و القائمون بالإدارة الذين كانوا في وظائفهم وقت وقوع البطلان، متضامنين بالمسؤولية عن الضرر الذي يلحق المساهمين أو الغير من جراء حل الشركة . كما يجوز أن تسند نفس مسؤولية التضامن للمساهمين الذين لم يحقق في حصصهم المقدمة للشركة أو المنافع ولم يصادق عليها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_21_permission_0_e917f535>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_21_permission_1_9db379f8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_21_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_21_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_21_19750926_OpEnact_4c1e167066> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_21_obligation_0_a8d876ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 21" ;
    dzdoc:position 795 ;
    dzdoc:usesTerm dzterm:directors,
        dzterm:founders .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_10> ;
    dzdoc:eId "art_715_bis_29" ;
    dzdoc:fullText "يعتبر أعضاء مجلس المراقبة مسؤولين عن الأخطاء الشخصية المرتكبة أثناء ممارسة وكالتهم . ولا يتحملون أية مسؤولية بسبب أعمال التسيير ونتائجها. ويمكن اعتبارهم مسؤولين مدنيا عن الجنح التي يرتكبها أعضاء مجلس المديرين في حالة درايتهم بها وعدم إخبار الجمعية العامة بذلك . تطبق أحكام المادتين 715 مكرر 25 و 715 مكرر 26 المذكورتين أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_29_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_29_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_29_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_29_19750926_OpEnact_223f9b13fc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_29_obligation_0_86738e18>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_29_obligation_1_b12bb352> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 29" ;
    dzdoc:position 803 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_25>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_26> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_25>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_26> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_29_condition_0_0c0bd018> ;
    dzdoc:usesTerm dzterm:council_of_supervision_members .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_715_bis_3" ;
    dzdoc:fullText "يحظر على الشركة رهن أسهمها الخاصة مباشرة أو بواسطة شخص يتصرف باسمه الخاص لحساب الشركة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_3_19750926_OpEnact_527a1b72ad> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_3_obligation_0_24010e0a> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_3_prohibition_0_3b2b754f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 3" ;
    dzdoc:position 777 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:ordinary_shares ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_42" ;
    dzdoc:fullText "الأسهم العادية هي الأسهم التي تمثل اكتتابات ووفاء لجزء من رأسمال شركة تجارية. وتمنح الحق في المشاركة في الجمعيات العامة والحق في انتخاب هيئات التسيير أو عزلها والمصادقة على كل عقود الشركة أو جزء منها، وقانونها الأساسي أو تعديله بالتناسب مع حق التصويت الذي بحوزتها بموجب قانونها الأساسي أو بموجب القانون . وتمنح الأسهم العادية ، علاوة على ذلك، الحق في تحصيل الأرباح عندما تقرر الجمعية العامة توزيع كل الفوائد الصافية المحققة أو جزء منها . وتتمتع جميع الأسهم العادية بنفس الحقوق والواجبات."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_42_right_0_637a16b4>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_42_right_1_dadb9a17> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_42> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_42_defocc_7c61e37530f1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_42_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_42_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_42_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_42_19750926_OpEnact_aab3a5bd41> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 42" ;
    dzdoc:position 816 ;
    dzdoc:usesTerm dzterm:ordinary_shares .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_60" ;
    dzdoc:fullText "لا يمكن شركة ما تقديم أموال أو منح قروض أو الموافقة على تقديم ضمان قصد اكتتاب أسهمها أو لشرائها ، تحت طائلة تطبيق العقوبات المنصوص عليها في المادة 811 أدناه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_60_permission_0_10b1afae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_60_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_60_19750926_OpEnact_09d927c5ff> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_60_obligation_0_1062fdc7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 60" ;
    dzdoc:position 834 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_811> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_811> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_80> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_4> ;
    dzdoc:eId "art_715_bis_80" ;
    dzdoc:fullText "يمكن حاملي سندات المساهمة الإطلاع على وثائق الشركة حسب نفس الشروط المطلوبة بالنسبة للمساهمين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_80_permission_0_37e1606c> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_80_right_0_6f46d98c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_80> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_80_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_80_19750926_OpEnact_c12b1c83c6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 80" ;
    dzdoc:position 854 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_724> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_724" ;
    dzdoc:fullText "إن كيفيات دفع الأرباح المصادق عليها من طرف الجمعية العامة تحددها هذه الجمعية أو عند عدمها، مجلس الإدارة أو القائمون بالإدارة، حسب الأحوال. غير أن دفع الأرباح يجب أن يقع في أجل أقصاه تسعة أشهر بعد إقفال السنة المالية . ويسوغ مد هذا الأجل بقرار قضائي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_724> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_724_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_724_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_724_19750926_OpEnact_6c7deec9dc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_724_obligation_0_e3b81393> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "724" ;
    dzdoc:position 926 ;
    dzdoc:usesTerm dzterm:board_of_directors,
        dzterm:general_assembly .

<https://legal.dz/resource/order/1975-09-26/75-59#art_728> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_728" ;
    dzdoc:fullText "لا يسوغ أن يجاوز مبلغ المكافآت عشر الأرباح القابلة للتوزيع ، بعد طرح: الاحتياطات المكونة تنفيذا لمداولة الجمعية العامة، المبالغ المرحلة من جديد. ولتقدير المكافآت يمكن أيضا مراعاة المبالغ المشروع في توزيعها التي تقتطع حسب الشروط المنصوص عليها في الفقرة الثانية من المادة 722 . ولا يسوغ اعتبار المبالغ المدرجة في رأس المال أو المقتطعة من علاوات الإصدار لأجل حساب المكافآت."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_728_permission_0_054836ae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_728> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_728_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_728_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_728_19750926_OpEnact_071d15992f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_728_obligation_0_3cd78e26> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "728" ;
    dzdoc:position 930 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_722> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_722> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_737> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_737" ;
    dzdoc:fullText "إذا لم يتخذ أي قرار عند انقضاء الأجل المنصوص عليه في المادة المتقدمة ، تصدر المحكمة حكمها بناء على طلب الطرف الذي يهمه الاستعجال."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_737> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_737_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_737_19750926_OpEnact_783e0cb523> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "737" ;
    dzdoc:position 944 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_736> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_736> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_737_condition_0_ee4ce600> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_743> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_743" ;
    dzdoc:fullText "تتقادم دعوى المسؤولية المبنية على إبطال الشركة أو الأعمال والمداولات اللاحقة لتأسيسها بثلاثة أعوام اعتبارا من التاريخ الذي اكتسب فيه حكم البطلان قوة الشيء المقضي. لا يحول زوال سبب البطلان دون ممارسة دعوى التعويض الرامية إلى تعويض الضرر اللاحق من العيب الذي كانت الشركة أو العمل أو المداولة مشوبة به وتتقادم هذه الدعوى بمرور ثلاث سنوات اعتبارا من تاريخ كشف البطلان."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_743> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_743_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_743_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_743_19750926_OpEnact_479d0bde2d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 743" ;
    dzdoc:position 950 ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_759> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_759" ;
    dzdoc:fullText "عندما يجب تحقيق الانفصال بتقديم الحصص لشركات المساهمة الجديدة فإن هذا الانفصال يقرر من الجمعية العامة غير العادية للشركة المنفصلة. ويمكن أن تتكون كل من الشركات الجديدة دون حاجة إلى حصة أخرى غير الحصة التي تم الحصول عليها من الشركة المنفصلة. وفي هذه الحالة يجوز للجمعية العامة للمساهمين والخاصة بهذه الأخيرة، أن تتحول بحكم القانون إلى جمعية عامة تأسيسية لكل من الشركات التي نشأت عن الانفصال وتتبع الإجراءات طبقا للأحكام التي تنظم تأسيس الشركات المساهمة. غير أنه لا يجري تحقيق لتقدير الأموال المقدمة من الشركة المنفصلة. وتسند الأسهم الصادرة من الشركات الجديدة مباشرة لمساهمي الشركة المنفصلة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_759_permission_0_4131caec> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_759> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_759_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_759_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_759_19750926_OpEnact_5bbe667a97> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "759" ;
    dzdoc:position 966 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_759_condition_0_95c5a3ac> ;
    dzdoc:usesTerm dzterm:general_assembly .

<https://legal.dz/resource/order/1975-09-26/75-59#art_766> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:liquidation_status ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_766" ;
    dzdoc:fullText "تعتبر الشركة في حالة تصفية من وقت حلها مهما كان السبب . ويتبع عنوان أو اسم الشركة بالبيان التالي \" شركة في حالة تصفية \". وتبقى الشخصية المعنوية للشركة قائمة لاحتياجات التصفية إلى أن يتم إقفالها . ولا ينتج حل الشركة آثاره على الغير إلا ابتداء من اليوم الذي تنشر فيه في السجل التجاري ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_766> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_766_defocc_09da0470c392> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_766_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_766_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_766_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_766_19750926_OpEnact_73f93403f9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_766_obligation_0_b7f5e006> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "766" ;
    dzdoc:position 973 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_766_condition_0_b146a36a> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_769> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_769" ;
    dzdoc:fullText "لا ينجم عن حل الشركة بحكم القانون فسخ إيجارات العقارات المستعملة لنشاط الشركة بما فيها محلات السكن التابعة لهذه العقارات. وإذا لم يعد التزام الضمان في حالة التنازل عن الإيجار مضمونا في حدود الإيجار المشار إليه ، فإنه يمكن إبداله بأمر مستعجل بكل ضمان كاف يقدم من المتنازل له أو الغير ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_769_permission_0_c3a125e1> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_769_right_0_96ec3c41> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_769> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_769_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_769_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_769_19750926_OpEnact_b44995a135> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "769" ;
    dzdoc:position 976 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_769_condition_0_951247c4> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_771> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_771" ;
    dzdoc:fullText "يحظر التنازل عن كل أو جزء من مال الشركة التي توجد في حالة تصفية إلى المصفي أو مستخدميه أو أزواجهم أو أصوله أو فروعه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_771> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_771_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_771_19750926_OpEnact_87fc570ef0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_771_obligation_0_059850f2> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_771_prohibition_0_da516078> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "771" ;
    dzdoc:position 978 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_788> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_788" ;
    dzdoc:fullText "يمثل المصفي الشركة وتخول له السلطات الواسعة لبيع الأصول ولو بالتراضي. غير أن القيود الواردة على هذه السلطات الناتجة عن القانون الأساسي أو أمر التعيين لا يحتج بها على الغير. وتكون له الأهلية لتسديد الديون وتوزيع الرصيد الباقي. ولا يجوز له متابعة الدعاوي الجارية أو القيام بدعاوي جديدة لصالح التصفية ما لم يؤذن له بذلك من الشركاء أو بقرار قضائي إذا تم تعيينه بنفس الطريقة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_788_permission_0_4885fc5d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_788> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_788_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_788_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_788_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_788_19750926_OpEnact_dd119f195d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_788_obligation_0_2bd00b74> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "788" ;
    dzdoc:position 995 ;
    dzdoc:usesTerm dzterm:liquidator .

<https://legal.dz/resource/order/1975-09-26/75-59#art_790> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_790" ;
    dzdoc:fullText "يجوز للشركاء أثناء التصفية أن يطلعوا على وثائق الشركة بنفس الشروط التي سبق ذكرها من قبل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_790_permission_0_f1ddd097> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_790_right_0_b933d09a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_790> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_790_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_790_19750926_OpEnact_3627b162b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "790" ;
    dzdoc:position 997 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_791> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_791" ;
    dzdoc:fullText "تتخذ القرارات المنصوص عليها في الفقرة الثانية من المادة 789 على النحو التالي : بأغلبية الشركاء في الرأس المال، في شركات التضامن والشركات ذات المسؤولية المحدودة، بشروط النصاب القانوني وأغلبية أصوات الجمعيات العادية في الشركات المساهمة، فإذا لم يحصل على الأغلبية المطلوبة فإنه يفصل بقرار قضائي بناء على طلب المصفي أو كل من يهمه الأمر، وإذا أدت المداولة إلى تعديل في القانون الأساسي فإنها تتخذ في هذه الحالة حسب الشروط المنصوص عليها لهذا الغرض في كل نوع من أنواع الشركة. ويجوز للشركاء المصفين أن يشتركوا في التصويت ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_791_right_0_d9fe1cf8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_791> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_791_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_791_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_791_19750926_OpEnact_f09df24429> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "791" ;
    dzdoc:position 998 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_789> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_789> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_791_condition_0_b12fe07d>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_791_condition_1_90675b27> ;
    dzdoc:usesTerm dzterm:liquidator .

<https://legal.dz/resource/order/1975-09-26/75-59#art_797> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_5> ;
    dzdoc:eId "art_797" ;
    dzdoc:fullText "يحدد عقد التجمعات تنظيم التجمع مع مراعاة أحكام هذا القانون. ويتم إعداده كتابيا وينشر حسب الكيفيات المحددة عن طريق التنظيم. ويتضمن لا سيما البيانات الآتية 1- اسم التجمع، 2- اسم الشركة أو موضوعها والشكل القانوني وعنوان المقر أو المركز الرئيسي للشركة، وإذا اقتضى الأمر رقم تسجيل كل عضو من التجمع في السجل التجاري ، 3- المدة التي أنشئ لأجلها التجمع، 4- موضوع التجمع، 5- عنوان مقر التجمع. تتم جميع تعديلات العقد وتنشر حسب شروط العقد نفسه . ولا تصبح قابلة للاحتجاج بها على الغير إلا ابتداء من تاريخ الإشهار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_797> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_797_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_797_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_797_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_797_para_3> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_797_19750926_OpEnact_e6007c2549> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_797_obligation_0_dc5435b1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 797" ;
    dzdoc:position 1009 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_797_condition_0_044d498c> ;
    dzdoc:usesTerm dzterm:السجل_التجاري,
        dzterm:عقد_التجمعات .

<https://legal.dz/resource/order/1975-09-26/75-59#art_820> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_3> ;
    dzdoc:eId "art_820" ;
    dzdoc:fullText """يعاقب بغرامة من 20.000 دج إلى 50.000 دج رئيس شركة المساهمة أو القائمون بإدارتها : 1- الذين لم يقدموا عمدا أثناء كل اجتماع للجمعية العادية للمساهمين ورقة الحضور موقعة من المساهمين الحاضرين والوكلاء مصادق عليها من مكتب الجمعية والمتضمنة:
                أ) أسماء وألقاب وموطن كل مساهم حاضر وعدد الأسهم التي يملكها وكذلك عدد الأصوات الملحقة بهذه الأسهم،
                ب) أسماء وألقاب وموطن كل وكيل وعدد أسهم موكليه وكذا عدد الأصوات الملحقة بهذه الأسهم،
                ج) أسماء وألقاب وموطن كل مساهم ممثل وعدد الأسهم التي يملكها وكذا عدد الأصوات الملحقة بهذه الأسهم أو عدد التفويضات المسندة لكل وكيل عند عدم وجود هذه الإشارات، 2- الذين لم يلحقوا بورقة الحضور التفويضات المسندة لكل وكيل، 3- الذين لم يقوموا بإثبات قرارات كل جمعية مساهمين بمحضر يوقع من طرف أعضاء المكتب ويحفظ بمركز الشركة في ملف خاص ويثبت فيه تاريخ ومكان انعقاد الجمعية وكيفية الاستدعاء وجدول الأعمال وتشكيل المكتب وعدد المساهمين المشاركين في التصويت ومقدار النصاب القانوني والمستندات والتقارير المقدمة للجمعية مع ملخص المناقشات ونص القرارات المطروحة للتصويت ونتيجة التصويت."""@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_820> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_820_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_820_19750926_OpEnact_a7fb387662> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_820_obligation_0_7fe6e413> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "820" ;
    dzdoc:position 1037 ;
    dzdoc:usesTerm dzterm:chairman .

<https://legal.dz/resource/order/1975-09-26/75-59#art_827> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_827" ;
    dzdoc:fullText "يعاقب بغرامة من 20.000 دج إلى 200.000 دج رئيس شركة المساهمة أو القائمون بإدارتها الذين قاموا عمدا بتخفيض رأس مال الشركة: 1- دون مرا اعاة المساواة بين المساهمين، 2- دون تبلیغ مشروع تخفيض رأسمال الشركة إلى مندوبي الحسابات قبل 45 يوما على الأقل من انعقاد الجمعية العامة المدعوة للبت في ذلك، 3- ودون أن يقوموا بنشر قرار تخفيض رأس المال في النشرة الرسمية للإعلانات القانونية وفضلا عن ذلك في جريدة مؤهلة لقبول الإعلانات القانونية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_827> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_827_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_827_19750926_OpEnact_0cf7098299> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_827_obligation_0_2601fe38> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "827" ;
    dzdoc:position 1044 ;
    dzdoc:usesTerm dzterm:auditors,
        dzterm:chairman,
        dzterm:directors .

