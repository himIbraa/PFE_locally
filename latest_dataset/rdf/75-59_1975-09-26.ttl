<https://legal.dz/resource/order/1975-09-26/75-59#version_art_677> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على مجلس الإدارة أو مجلس المديرين أن يبلغ المساهمين أو يضع تحت تصرفهم قبل ثلاثين يوما من انعقاد الجمعية العامة، الوثائق الضرورية لتمكينهم من إبداء الرأي عن دراية وإصدار قرار دقيق فيما يخص إدارة أعمال الشركة وسيرها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_677_19750926_OpEnact_09ce35e901> ;
    dzdoc:replacementText "يجب على مجلس الإدارة أو مجلس المديرين أن يبلغ المساهمين أو يضع تحت تصرفهم قبل ثلاثين يوما من انعقاد الجمعية العامة، الوثائق الضرورية لتمكينهم من إبداء الرأي عن دراية وإصدار قرار دقيق فيما يخص إدارة أعمال الشركة وسيرها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
