    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_403> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_403_obligation_1_8bfdf45a_role_95c19b1fa5> a dznorm:Role ;
    rdfs:label "البضائع"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "لا يمكن للمسحوب عليه الامتناع من التصريح بالقبول بمجرد انقضاء أجل مناسب للعرف الجاري في التجارة للتعرف على البضائع"@ar ;
