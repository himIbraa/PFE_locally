<https://legal.dz/resource/order/1975-09-26/75-59#version_art_791> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتخذ القرارات المنصوص عليها في الفقرة الثانية من المادة 789 على النحو التالي : بأغلبية الشركاء في الرأس المال، في شركات التضامن والشركات ذات المسؤولية المحدودة، بشروط النصاب القانوني وأغلبية أصوات الجمعيات العادية في الشركات المساهمة، فإذا لم يحصل على الأغلبية المطلوبة فإنه يفصل بقرار قضائي بناء على طلب المصفي أو كل من يهمه الأمر، وإذا أدت المداولة إلى تعديل في القانون الأساسي فإنها تتخذ في هذه الحالة حسب الشروط المنصوص عليها لهذا الغرض في كل نوع من أنواع الشركة. ويجوز للشركاء المصفين أن يشتركوا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_791_19750926_OpEnact_f09df24429> ;
    dzdoc:replacementText "تتخذ القرارات المنصوص عليها في الفقرة الثانية من المادة 789 على النحو التالي : بأغلبية الشركاء في الرأس المال، في شركات التضامن والشركات ذات المسؤولية المحدودة، بشروط النصاب القانوني وأغلبية أصوات الجمعيات العادية في الشركات المساهمة، فإذا لم يحصل على الأغلبية المطلوبة فإنه يفصل بقرار قضائي بناء على طلب المصفي أو كل من يهمه الأمر، وإذا أدت المداولة إلى تعديل في القانون الأساسي فإنها تتخذ في هذه الحالة حسب الشروط المنصوص عليها لهذا الغرض في كل نوع من أنواع الشركة. ويجوز للشركاء المصفين أن يشتركوا في التصويت ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_791> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_791> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_792> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة استمرار استغلال الشركة ، يتعين على المصفي استدعاء جمعية الشركاء حسب الشروط المنصوص عليها في المادة 789 ، وإلا جاز لكل من يهمه الأمر أن يطلب الاستدعاء سواء بواسطة مندوبي الحسابات أو هيئة المراقبة أو من وكيل معين بقرار قضائي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_792_19750926_OpEnact_2e3d40272a> ;
