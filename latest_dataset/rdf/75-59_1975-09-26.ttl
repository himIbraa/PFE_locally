    dzdoc:sourceTextSpan "يجوز للقضاة أن يوجهوا إنابة قضائية لدى المحكمة التي توجد بها الدفاتر أو يعينون قاضيا للاطلاع عليها وتحرير محضر بمحتواها وإرساله إلى المحكمة المختصة بالدعوى"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_17> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_180_condition_0_58061f90> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_180_condition_0_58061f90_ref_c071a27adec4> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_177> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_177> ;
    dznorm:conditionText "عندما تزيد مساحة العمارة التي أعيد بناؤها حسب الشروط المنصوص عليها في المادة 177 عن مساحة العمارة القديمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_180> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_180_condition_0_58061f90_ref_c071a27adec4> a dzdoc:Reference ;
    rdfs:label "المادة 177"@ar ;
