<https://legal.dz/resource/order/1975-09-26/75-59#version_art_301> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أجري توزيع ثمن العقارات قبل توزيع ثمن الأموال المنقولة، أو أجريا في وقت واحد ، كان للدائنين الممتازين أو المرتهنين عقاريا الذين لم يستوفوا حقوقهم من ثمن العقارات أن يشتركوا مع الدائنين العاديين بنسبة ما بقي مستحقا لهم في الأموال الخاصة بجماعة الدائنين العاديين ، و يشترط مع ذلك أن تكون الديون قد تم قبولها طبقا للأوضاع المبينة فيها بعد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_301_19750926_OpEnact_53c4715e2c> ;
    dzdoc:replacementText "إذا أجري توزيع ثمن العقارات قبل توزيع ثمن الأموال المنقولة، أو أجريا في وقت واحد ، كان للدائنين الممتازين أو المرتهنين عقاريا الذين لم يستوفوا حقوقهم من ثمن العقارات أن يشتركوا مع الدائنين العاديين بنسبة ما بقي مستحقا لهم في الأموال الخاصة بجماعة الدائنين العاديين ، و يشترط مع ذلك أن تكون الديون قد تم قبولها طبقا للأوضاع المبينة فيها بعد ."@ar ;
