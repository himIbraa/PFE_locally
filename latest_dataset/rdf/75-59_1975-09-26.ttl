<https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_4> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسترجع كل شخص منع من إصدار الشيكات حقه في ذلك ، عندما يثبت أنه قام بتسوية قيمة الشيك غير المدفوع، أو تكوين رصيد كاف ومتوفر موجه لتسويته بعناية المسحوب عليه، وبدفع غرامة التبرئة المنصوص عليها في المادة 526 مكرر 5 أدناه، وذلك في أجل عشرين (20) يوما ابتداء من تاريخ نهاية أجل الأمر بالدفع . في حالة عدم القيام بذلك ، لا يسترجع الممنوع حق إصدار الشيكات إلا بمرور أجل خمس (5) سنوات، ابتداء من تاريخ الأمر بالدفع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_4_19750926_OpEnact_aa17210038> ;
    dzdoc:replacementText "يسترجع كل شخص منع من إصدار الشيكات حقه في ذلك ، عندما يثبت أنه قام بتسوية قيمة الشيك غير المدفوع، أو تكوين رصيد كاف ومتوفر موجه لتسويته بعناية المسحوب عليه، وبدفع غرامة التبرئة المنصوص عليها في المادة 526 مكرر 5 أدناه، وذلك في أجل عشرين (20) يوما ابتداء من تاريخ نهاية أجل الأمر بالدفع . في حالة عدم القيام بذلك ، لا يسترجع الممنوع حق إصدار الشيكات إلا بمرور أجل خمس (5) سنوات، ابتداء من تاريخ الأمر بالدفع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_4> ;
