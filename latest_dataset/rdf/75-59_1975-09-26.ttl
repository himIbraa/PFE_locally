<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقتضي تعديل القانون الأساسي موافقة كل الشركاء المتضامنين ولأغلبية ثلثي رأس مال الشركاء الموصين . يثبت المسيرون تعديل القانون الأساسي المترتب عن زيادة في رأس المال ."@ar ;
