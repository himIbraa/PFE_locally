<https://legal.dz/resource/order/1975-09-26/75-59#version_art_825> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من ستة أشهر إلى سنتين وبغرامة من 20.000 دج إلى 500.000 دج أو بإحدى هاتين العقوبتين فقط : رئيس شركة المساهمة و القائمون بإدارتها أو مندوبو الحسابات الذين منحوا عمدا أو وافقوا على البيانات غير الصحيحة التي وردت في التقارير المقدمة للجمعية العامة المدعوة للبت في إلغاء حق الأفضلية في اكتتاب المساهمين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
