<https://legal.dz/resource/order/1975-09-26/75-59#version_art_646> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد القانون الأساسي مدة عضوية مجلس المديرين ضمن حدود تتراوح من عامين إلى ست سنوات، و عند عدم وجود أحكام قانونية أساسية صريحة تقدر مدة العضوية بأربع سنوات. وفي حالة الشغور ، يتم تعيين الخلف للفترة المتبقية إلى غاية تجديد مجلس المديرين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_646_19750926_OpEnact_f519a68a20> ;
