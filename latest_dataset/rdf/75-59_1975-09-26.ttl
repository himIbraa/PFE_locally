<https://legal.dz/resource/order/1975-09-26/75-59#art_642_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_642> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز النص في القانون الأساسي لكل شركة مساهمة، على أن هذه الشركة تخضع لأحكام هذا القسم الفرعي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_642_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_642> ;
