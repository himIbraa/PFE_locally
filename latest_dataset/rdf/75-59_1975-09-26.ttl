<https://legal.dz/resource/order/1975-09-26/75-59#version_art_274> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رفض المدين القيام بالإجراءات المشار إليها في الفقرة الأولى من المادة 273 فلوكيل التفليسة مباشرتها وحده بإذن من القاضي المنتدب . ومع ذلك إذا تعلق الأمر برفع دعوى لا يكون هذا الإذن ضروريا وإنما يلتزم وكيل التفليسة بإدخال المدين في الدعوى ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_274_19750926_OpEnact_d421bdce18> ;
