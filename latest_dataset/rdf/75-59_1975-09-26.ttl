    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_601> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب على الجمعية العامة التأسيسية أن تفصل في تقدير الحصص العينية"@ar ;
    dznorm:sourceArticle "art_601" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_601_obligation_0_6b895e70_action_9f7642c073> a dznorm:Action ;
