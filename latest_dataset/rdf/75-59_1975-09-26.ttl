<https://legal.dz/resource/order/1975-09-26/75-59#art_535_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_535> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يتجدد الدين بقبول دائن تسلم شيكا وفاء لدينه. ويترتب على ذلك أن الدين الأصلي يبقى قائما بكل ما له من ضمانات إلى أن يتم وفاء قيمة هذا الشيك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_536_condition_0_939bc66b> a dznorm:Condition ;
    dznorm:conditionText "حالة عدم الدفع ضمن أجل عشرين يوما ابتداء من تاريخ إصدار التبليغ المنصوص عليه في الفقرة السابقة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_536> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_536_extref_c995b561> a dzdoc:ExternalReference ;
    rdfs:label "المادة 183 من قانون الإجراءات المدنية"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-154#art_183"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-154#art_183"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-154#art_183" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-154"^^xsd:anyURI ;
    dzdoc:targetEId "art_183" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_536_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_536> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي حالة عدم الدفع ضمن أجل عشرين يوما ابتداء من تاريخ إصدار التبليغ المنصوص عليه في الفقرة السابقة يمكن لحامل الصك عن طريق القيام بأمر صادر في ذيل العريضة بحجز وبيع أملاك المسحوب عليه ضمن الشروط التي أقرها التشريع المعمول به وفي حالة وجود صعوبة ، يلتمس كاتب الضبط المكلف بالتنفيذ قاضي الأمور المستعجلة طبقا لأحكام المادة 183 من قانون الإجراءات المدنية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_536_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_536> ;
    dzdoc:position 2 ;
    dzdoc:text "يجوز لحامل الصك المحتج عليه فضلا عن الإجراءات المقررة لممارسة دعوى الضمان أن يتخذ إجراءات تحفظية تجاه الساحبين والمظهرين والضامنين لهم."@ar .

