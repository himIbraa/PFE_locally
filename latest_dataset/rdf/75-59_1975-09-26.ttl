<https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_15> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون المسحوب عليه الذي يمتنع عن تسديد شيك صادر بواسطة: نموذج لم يتم طلب إرجاعه وفقا للشروط المحددة في المادة 526 مكرر 9 أعلاه، ما لم يثبت أنه قام بالمساعي الضرورية من أجل ذلك، نموذج سلم خرقا لأحكام المادتين 526 مكرر 3 و 526 مكرر 9 أعلاه، نموذج سلم إلى زبون جديد، رغم أنه كان ممنوعا من إصدار شيكات، وكان اسمه واردا لهذه الأسباب في قائمة مركزية المستحقات غير المدفوعة ل بنك الجزائر . ملزما بالتضامن بدفع التعويضات المدنية الممنوحة للحامل بسبب عدم التسديد ، ما لم يبرر أن عملية فتحه للحساب تمت وفق الإجر"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_15_19750926_OpEnact_55048b6834> ;
    dzdoc:replacementText "يكون المسحوب عليه الذي يمتنع عن تسديد شيك صادر بواسطة: نموذج لم يتم طلب إرجاعه وفقا للشروط المحددة في المادة 526 مكرر 9 أعلاه، ما لم يثبت أنه قام بالمساعي الضرورية من أجل ذلك، نموذج سلم خرقا لأحكام المادتين 526 مكرر 3 و 526 مكرر 9 أعلاه، نموذج سلم إلى زبون جديد، رغم أنه كان ممنوعا من إصدار شيكات، وكان اسمه واردا لهذه الأسباب في قائمة مركزية المستحقات غير المدفوعة ل بنك الجزائر . ملزما بالتضامن بدفع التعويضات المدنية الممنوحة للحامل بسبب عدم التسديد ، ما لم يبرر أن عملية فتحه للحساب تمت وفق الإجراءات القانونية والتنظيمية المتعلقة بفتح الحساب وتسليم نماذج الشيكات وكذا الالتزامات القانونية و التنظيمية الناتجة عن عوارض الدفع ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_15> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
