<https://legal.dz/resource/order/1975-09-26/75-59#version_art_795> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تودع المبالغ المخصصة للتوزيع بين الشركاء والدائنين في أجل خمسة عشر يوما ابتداء من قرار التوزيع، في بنك باسم الشركة الموضوعة تحت التصفية . و يجوز سحب المبالغ بمجرد توقيع مصف واحد وتحت مسؤوليته ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_795_19750926_OpEnact_b35cbc380b> ;
