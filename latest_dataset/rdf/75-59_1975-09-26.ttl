<https://legal.dz/resource/order/1975-09-26/75-59#version_art_253> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يستدعي وكيل التفليسة المدين لديه لإقفال الدفاتر وحصرها في حضوره وذلك بغير مساس بما نصت عليه المادة 261 بخصوص حالة وضع الأختام. فإذا لم يستجب المدين لهذا الاستدعاء دعي بموجب رسالة موصى عليها مع طلب علم الوصول ليحضر ويقدم دفاتره خلال ثمانية أو أربعين ساعة . وله الحضور بمندوب مفوض عنه إذا هو علل تخلفه بأسباب يجدها القاضي المختص مقبولة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_253_19750926_OpEnact_11e081aad8> ;
    dzdoc:replacementText "يستدعي وكيل التفليسة المدين لديه لإقفال الدفاتر وحصرها في حضوره وذلك بغير مساس بما نصت عليه المادة 261 بخصوص حالة وضع الأختام. فإذا لم يستجب المدين لهذا الاستدعاء دعي بموجب رسالة موصى عليها مع طلب علم الوصول ليحضر ويقدم دفاتره خلال ثمانية أو أربعين ساعة . وله الحضور بمندوب مفوض عنه إذا هو علل تخلفه بأسباب يجدها القاضي المختص مقبولة ."@ar ;
