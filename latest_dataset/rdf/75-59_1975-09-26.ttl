    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_472> ;
    dznorm:conditionText "إذا خلا السند من أحد البيانات المذكورة في المادة السابقة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_473> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_473_condition_0_cb1da0a1_ref_9062b04044fd> a dzdoc:Reference ;
    rdfs:label "المادة السابقة"@ar ;
    dzdoc:frbrUri "#art_472"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1975-09-26/75-59#art_472> ;
    dzdoc:sourceEId "art_473" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "إذا خلا السند من أحد البيانات المذكورة في المادة السابقة"@ar ;
    dzdoc:targetEId "art_472" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_473_condition_1_d3c40c44> a dznorm:Condition ;
    dznorm:conditionText "إذا خلا الشيك من بيان مكان الوفاء"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_473> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_473_condition_2_fd5a08dc> a dznorm:Condition ;
    dznorm:conditionText "فإذا ذكرت عدة أمكنة بجانب اسم المسحوب عليه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_473> ;
    dznorm:position 2 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_473_condition_3_81eab3bd> a dznorm:Condition ;
    dznorm:conditionText "وإذا لم تذكر هذه البيانات أو غيرها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_473> ;
    dznorm:position 3 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_473_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_473> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا خلا السند من أحد البيانات المذكورة في المادة السابقة، فلا يعتبر شيكا إلا في الأحوال المنصوص عليها في الفقرات الآتية : إذا خلا الشيك من بيان مكان الوفاء فإن المكان المبين بجانب اسم المسحوب عليه يعتبر مكان الوفاء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_473_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_473> ;
    dzdoc:position 1 ;
    dzdoc:text "فإذا ذكرت عدة أمكنة بجانب اسم المسحوب عليه فيكون الشيك واجب الدفع في المكان المذكور أولا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_473_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_473> ;
    dzdoc:position 2 ;
    dzdoc:text "وإذا لم تذكر هذه البيانات أو غيرها يكون الشيك واجب الدفع في المكان الذي به المحل الأصلي للمسحوب عليه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_473_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_473> ;
    dzdoc:position 3 ;
    dzdoc:text "إن الشيك الذي لم يذكر فيه مكان إنشائه يعتبر إنشاؤه قد تم في المكان المبين بجانب اسم الساحب."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_474_obligation_0_dfbe1f1c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_474_obligation_0_dfbe1f1c_action_a64a6db146> ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_474_obligation_0_dfbe1f1c_role_b8c908e6bf>,
