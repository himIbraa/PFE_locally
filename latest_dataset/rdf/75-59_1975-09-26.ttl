<https://legal.dz/resource/order/1975-09-26/75-59#art_439_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_439> ;
    dzdoc:position 0 ;
    dzdoc:text "لا تعتبر من قبيل القوة القاهرة الأفعال الشخصية المحضة المتصلة بالحامل أو بالشخص الذي كلفه بتقديم السفتجة أو الاحتجاج."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_43_condition_0_c9871514> a dznorm:Condition ;
    dznorm:conditionText "إذا كانت طبيعة الشيء تتطلب تحزيمه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_43> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_43_obligation_0_ac8eda4f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_43_obligation_0_ac8eda4f_role_aa6de56080> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_43> ;
    dznorm:position 0 ;
    dznorm:provisionText "وجب على المرسل القيام بالتحزيم بشكل يكون واقيا من الضياع والتلف ولا يؤدي لضرر الأشخاص والمعدات أو غيرها من الأشياء المنقولة"@ar ;
    dznorm:sourceArticle "art_43" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_43_obligation_0_ac8eda4f_role_aa6de56080> a dznorm:Role ;
    rdfs:label "المرسل القيام بالتحزيم بشكل"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "وجب على المرسل القيام بالتحزيم بشكل يكون واقيا من الضياع والتلف ولا يؤدي لضرر الأشخاص والمعدات أو غيرها من الأشياء المنقولة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_43> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_43_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_43> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كانت طبيعة الشيء تتطلب تحزيمه، وجب على المرسل القيام بالتحزيم بشكل يكون واقيا من الضياع والتلف ولا يؤدي لضرر الأشخاص والمعدات أو غيرها من الأشياء المنقولة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_440_condition_0_4d6624dd> a dznorm:Condition ;
    dznorm:conditionText "وإذا تعذر الدفع ضمن أجل عشرين يوما ابتداء من تاريخ التبليغ المقرر في الفقرة أعلاه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_440> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_440_extref_c995b561> a dzdoc:ExternalReference ;
    rdfs:label "المادة 183 من قانون الإجراءات المدنية"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-154#art_183"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-154#art_183"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-154#art_183" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-154"^^xsd:anyURI ;
    dzdoc:targetEId "art_183" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_440_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_440> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر تبليغ احتجاج لعدم الوفاء الذي تم بالمسحوب عليه لسفتجة مقبولة بمثابة أمر بالدفع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_440_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_440> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا تعذر الدفع ضمن أجل عشرين يوما ابتداء من تاريخ التبليغ المقرر في الفقرة أعلاه، يمكن للحامل القيام عن طريق أمر صادر في ذيل العريضة بحجز وبيع ممتلكات المسحوب عليه ضمن الشروط التي أقرها التشريع المعمول به."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_440_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_440> ;
    dzdoc:position 2 ;
    dzdoc:text "وفي حالة ظهور صعوبة يلتمس كاتب الضبط المكلف بالتنفيذ، قاضي الأمور المستعجلة طبقا لأحكام المادة 183 من قانون الإجراءات المدنية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_440_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_440> ;
    dzdoc:position 3 ;
    dzdoc:text "يمكن لحامل السفتجة المحتج فيها لعدم الوفاء فضلا عما توجبه عليه الإجراءات المقررة برفع دعوى الضمان، أن يتخذ إجراءات تحفظية بعد ترخيص من القاضي إزاء الساحبين والمظهرين والضامنين لهم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_440_permission_0_f0ee5bde> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
