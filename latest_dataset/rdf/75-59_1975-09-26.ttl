<https://legal.dz/resource/order/1975-09-26/75-59#version_art_100> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يترتب على إهمال واحد أو أكثر من البيانات الواردة في المادة 98 بطلان إذا نشأ عنه ضرر لغير المتعاقدين . ولا يجوز أن يطلب الحكم بهذا البطلان إلا الأشخاص الذين لحقهم ضرر من جراء الإهمال أو الإخلال ويمكن للمحاكم أن تقرر حسب أهمية الضرر ونوعه إبطال وحصر مفعوله."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_100_19750926_OpEnact_d7d1b0931e> ;
    dzdoc:replacementText "يترتب على إهمال واحد أو أكثر من البيانات الواردة في المادة 98 بطلان إذا نشأ عنه ضرر لغير المتعاقدين . ولا يجوز أن يطلب الحكم بهذا البطلان إلا الأشخاص الذين لحقهم ضرر من جراء الإهمال أو الإخلال ويمكن للمحاكم أن تقرر حسب أهمية الضرر ونوعه إبطال وحصر مفعوله."@ar ;
