    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أيضا أن يتضمن الصلح التنازل للمدين عن جزء تختلف أهميته عن الديون، على أن هذا التنازل يستبقى على عاتق المفلس التزاما طبيعيا. ويجوز أن يقبل الصلح مع اشتراط الوفاء عند اليسر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
