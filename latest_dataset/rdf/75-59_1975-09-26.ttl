<https://legal.dz/resource/order/1975-09-26/75-59#art_777> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_777" ;
    dzdoc:fullText "تتقادم كل الدعاوي ضد الشركاء غير المصقين أو ورثتهم أو ذوي حقوقهم بمرور خمس سنوات اعتبارا من نشر انحلال الشركة بالسجل التجاري."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_777> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_777_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_777_19750926_OpEnact_750a20618c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "777" ;
    dzdoc:position 984 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_780> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_780" ;
    dzdoc:fullText "لا تنهي مهام مندوبي الحسابات بانحلال الشركة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_780> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_780_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
