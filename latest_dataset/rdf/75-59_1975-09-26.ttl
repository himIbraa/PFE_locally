<https://legal.dz/resource/order/1975-09-26/75-59#version_art_743> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتقادم دعوى المسؤولية المبنية على إبطال الشركة أو الأعمال والمداولات اللاحقة لتأسيسها بثلاثة أعوام اعتبارا من التاريخ الذي اكتسب فيه حكم البطلان قوة الشيء المقضي. لا يحول زوال سبب البطلان دون ممارسة دعوى التعويض الرامية إلى تعويض الضرر اللاحق من العيب الذي كانت الشركة أو العمل أو المداولة مشوبة به وتتقادم هذه الدعوى بمرور ثلاث سنوات اعتبارا من تاريخ كشف البطلان."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_743_19750926_OpEnact_479d0bde2d> ;
    dzdoc:replacementText "تتقادم دعوى المسؤولية المبنية على إبطال الشركة أو الأعمال والمداولات اللاحقة لتأسيسها بثلاثة أعوام اعتبارا من التاريخ الذي اكتسب فيه حكم البطلان قوة الشيء المقضي. لا يحول زوال سبب البطلان دون ممارسة دعوى التعويض الرامية إلى تعويض الضرر اللاحق من العيب الذي كانت الشركة أو العمل أو المداولة مشوبة به وتتقادم هذه الدعوى بمرور ثلاث سنوات اعتبارا من تاريخ كشف البطلان."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_743> ;
