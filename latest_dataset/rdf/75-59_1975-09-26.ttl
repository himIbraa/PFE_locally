<https://legal.dz/resource/order/1975-09-26/75-59#version_art_355> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا توقف في أي وقت من الأوقات سير عمليات التفليسة أو التسوية القضائية لعدم كفاية الأصول يجوز للمحكمة بناء على تقرير من القاضي المنتدب أن تقضي بإقفال هذه العمليات، ولو كان هذا من تلقاء نفسها. ويعيد هذا الحكم لكل دائن حقه في مباشرة دعواه الشخصية ، وللدائن إذا كان دينه قد تم تحقيقه وقبوله أن يحصل على السند التنفيذي اللازم . يكون وكيل التفليسة مسؤولا لمدة عامين من الحكم بشهر الإفلاس أو بالتسوية القضائية، عن السندات التي يكون الدائنون قد سلموها له . وفي حالة وجود حكم بإقفال التفليسة لعدم كفاية الأصول"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_355_19750926_OpEnact_d048356f06> ;
    dzdoc:replacementText "إذا توقف في أي وقت من الأوقات سير عمليات التفليسة أو التسوية القضائية لعدم كفاية الأصول يجوز للمحكمة بناء على تقرير من القاضي المنتدب أن تقضي بإقفال هذه العمليات، ولو كان هذا من تلقاء نفسها. ويعيد هذا الحكم لكل دائن حقه في مباشرة دعواه الشخصية ، وللدائن إذا كان دينه قد تم تحقيقه وقبوله أن يحصل على السند التنفيذي اللازم . يكون وكيل التفليسة مسؤولا لمدة عامين من الحكم بشهر الإفلاس أو بالتسوية القضائية، عن السندات التي يكون الدائنون قد سلموها له . وفي حالة وجود حكم بإقفال التفليسة لعدم كفاية الأصول تخفض المهلة إلى عام واحد اعتبارا من تاريخ هذا الحكم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_355> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_355> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_356> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للمدين أو لكل ذي مصلحة غيره أن يطلب من المحكمة العدول عن حكمها الذي أصدرته مع تقديم دليل على وجود أموال كافية لمواجهة نفقات العمليات، أو إيداع مبلغ يكفي لمواجهتها بين يدي وكيل التفليسة . وعلى أي حال يتعين تسديد نفقات الإجراءات التي اتخذت بمقتضى المادة السابقة على وجه الأسبقية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_356_19750926_OpEnact_ed6f93f708> ;
    dzdoc:replacementText "للمدين أو لكل ذي مصلحة غيره أن يطلب من المحكمة العدول عن حكمها الذي أصدرته مع تقديم دليل على وجود أموال كافية لمواجهة نفقات العمليات، أو إيداع مبلغ يكفي لمواجهتها بين يدي وكيل التفليسة . وعلى أي حال يتعين تسديد نفقات الإجراءات التي اتخذت بمقتضى المادة السابقة على وجه الأسبقية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_356> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
