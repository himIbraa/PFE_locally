<https://legal.dz/resource/order/1975-09-26/75-59#version_art_408> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وضع المسحوب عليه صيغة القبول على السفتجة ثم شطبها قبل ترجيع السفتجة ، عد القبول مرفوضا ويعد التشطيب واقعا قبل ترجيع السند ما لم يثبت خلافه. على أنه إذا كان المسحوب عليه قد أعلم كتابة الحامل أو أي موقع آخر بقبوله يصبح ملزما تجاه هذين الأخيرين بما تضمنته الصيغة التي عبر بها عن قبوله ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_408_19750926_OpEnact_3c009b0ad5> ;
    dzdoc:replacementText "إذا وضع المسحوب عليه صيغة القبول على السفتجة ثم شطبها قبل ترجيع السفتجة ، عد القبول مرفوضا ويعد التشطيب واقعا قبل ترجيع السند ما لم يثبت خلافه. على أنه إذا كان المسحوب عليه قد أعلم كتابة الحامل أو أي موقع آخر بقبوله يصبح ملزما تجاه هذين الأخيرين بما تضمنته الصيغة التي عبر بها عن قبوله ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_408> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_408> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
