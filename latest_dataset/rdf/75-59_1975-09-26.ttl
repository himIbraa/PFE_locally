<https://legal.dz/resource/order/1975-09-26/75-59#art_697_permission_0_a97e7f0b_role_64a74c5a36> a dznorm:Role ;
    rdfs:label "تقرير مجلس الإدارة أو"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يجوز للجمعية العامة، التي تقرر زيادة رأس المال أن تلغي حق التفاضل في الاكتتاب. وتفصل تحت طائلة بطلان المداولة بهذا الشأن، بناء على تقرير مجلس الإدارة أو مجلس المديرين، حسب الحالة، وتقرير مجلس مندوبي الحسابات."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_697> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_698_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_698> ;
    dzdoc:position 0 ;
    dzdoc:text "يخضع الإصدار ، الذي يتم باللجوء العلني للادخار دون حق التفاضل في اكتتاب أسهم جديدة تمنح لصاحبها نفس حقوق الأسهم القديمة، للشروط التالية: يتم الإصدار في أجل ثلاث سنوات ابتداء من تاريخ انعقاد الجمعية التي قررت ذلك. بالنسبة للشركات التي تكون أسهمها مسجلة في السعر الرسمي لبورصة الأوراق المالية، يكون سعر الإصدار على الأقل مساويا لمعدل الأسعار التي تحققها هذه الأسهم مدة عشرين يوما متتالية ومختارة من بين الأربعين يوما السابقة ليوم بداية الإصدار بعد تصحيح هذا المعدل المراعاة اختلاف تاريخ الانتفاع. أما بالنسبة للشركات غير تلك المشار إليها في الفقرة 2 أعلاه، فيكون سعر الإصدار على الأقل مساويا إما لحصة رؤوس الأموال الخاصة بالأسهم عن آخر ميزانية موافق عليها في تاريخ الإصدار، وإما لسعر يحدده خبير يعينه القضاء بناء على طلب مجلس الإدارة أو مجلس المديرين."@ar .

