<https://legal.dz/resource/order/1975-09-26/75-59#art_277_condition_0_17eb1fe8> a dznorm:Condition ;
    dznorm:conditionText "إذا ارتأى وكيل التفليسة استغلال المحل التجاري"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_277> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_277_condition_1_8213b552> a dznorm:Condition ;
