<https://legal.dz/resource/order/1975-09-26/75-59#version_art_796> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لشخصين معنويين أو أكثر أن يؤسسوا فيما بينهم كتابيا، ولفترة محدودة تجمعا لتطبيق كل الوسائل الملاءمة لتسهيل النشاط الاقتصادي لأعضائها أو تطويره وتحسين نتائج هذا النشاط وتنميته ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_796_19750926_OpEnact_2a7d27a822> ;
    dzdoc:replacementText "يجوز لشخصين معنويين أو أكثر أن يؤسسوا فيما بينهم كتابيا، ولفترة محدودة تجمعا لتطبيق كل الوسائل الملاءمة لتسهيل النشاط الاقتصادي لأعضائها أو تطويره وتحسين نتائج هذا النشاط وتنميته ."@ar ;
