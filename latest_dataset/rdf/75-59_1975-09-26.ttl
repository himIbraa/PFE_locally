<https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_4> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "على حامل سند الخزن أن يطالب عند الاستحقاق، بالتسديد بمقر إقامة المودع . وفي حالة عدم التسديد ، يمكنه خلال الأيام الثمانية (8) الموالية للاحتجاج، أن يقوم ببيع البضائع المخزونة في المزاد العلني واستعمال حق امتيازه على السعر . إذا كان السعر غير كاف للتسديد ، فيمكنه أن يطعن ضد المودع والمظهرين المتتاليين بصفته حاملا لسند تجاري ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_4_19750926_OpEnact_253eac1aab> ;
    dzdoc:replacementText "على حامل سند الخزن أن يطالب عند الاستحقاق، بالتسديد بمقر إقامة المودع . وفي حالة عدم التسديد ، يمكنه خلال الأيام الثمانية (8) الموالية للاحتجاج، أن يقوم ببيع البضائع المخزونة في المزاد العلني واستعمال حق امتيازه على السعر . إذا كان السعر غير كاف للتسديد ، فيمكنه أن يطعن ضد المودع والمظهرين المتتاليين بصفته حاملا لسند تجاري ."@ar ;
