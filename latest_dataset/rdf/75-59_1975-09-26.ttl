<https://legal.dz/resource/order/1975-09-26/75-59#version_art_324> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان الحكم في المعارضة متوقفا على الفصل في مسائل تخرج بسبب نوعها عن اختصاص المحكمة التي قضت بالتسوية القضائية أو الإفلاس ، توقف هذه المحكمة الحكم في المعارضة لما بعد الفصل في تلك المسائل. وتحدد المحكمة ميعادا قصيرا يلتزم الدائن المعارض بأن يرفع خلاله الموضوع للقضاء المختص وأن يثبت متابعته للطلب ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_324_19750926_OpEnact_82319631ad> ;
    dzdoc:replacementText "إذا كان الحكم في المعارضة متوقفا على الفصل في مسائل تخرج بسبب نوعها عن اختصاص المحكمة التي قضت بالتسوية القضائية أو الإفلاس ، توقف هذه المحكمة الحكم في المعارضة لما بعد الفصل في تلك المسائل. وتحدد المحكمة ميعادا قصيرا يلتزم الدائن المعارض بأن يرفع خلاله الموضوع للقضاء المختص وأن يثبت متابعته للطلب ."@ar ;
