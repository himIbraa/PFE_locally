<https://legal.dz/resource/order/1975-09-26/75-59#art_540> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_9> ;
    dzdoc:eId "art_540" ;
    dzdoc:fullText "لا تسري المادة 53 من قانون العقوبات على مختلف الجرائم المنصوص عليها في المادتين 374 و 375 من قانون العقوبات إلا فيما يخص إصدار أو قبول شيك بدون مقابل وفاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_540> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_540_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_540_19750926_OpEnact_cdfd8de4dd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 540" ;
    dzdoc:position 562 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_540_extref_1fa030ab>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_540_extref_f2c7a5d7>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_540_extref_f75c36b3> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_2> ;
    dzdoc:eId "art_543_bis_13" ;
    dzdoc:fullText "تطبق الأحكام التي تحكم السند لأمر ما لم ينص هذا الفصل على خلاف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_13> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_13_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_13_19750926_OpEnact_3cc0d8022c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 543 مكرر 13" ;
    dzdoc:position 579 ;
    dzdoc:usesTerm dzterm:promissory_note .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_3> ;
    dzdoc:eId "art_543_bis_16" ;
    dzdoc:fullText "يترتب عن تحويل الديون التجارية، نقل كل الضمانات التي كانت تضمن تنفيذ الالتزامات لفائدة الوسيط ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_16_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_16_19750926_OpEnact_f012a600a5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 16" ;
    dzdoc:position 582 ;
    dzdoc:usesTerm dzterm:factor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_3> ;
    dzdoc:eId "art_543_bis_18" ;
    dzdoc:fullText "يحدد محتوى إصدار الفاتورات لأجل محدد وشروطه وكذلك شروط تأهيل الشركات التي تمارس تحويل الفاتورة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_18_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_18_19750926_OpEnact_a43a448264> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 18" ;
    dzdoc:position 584 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_4_sec_1> ;
    dzdoc:eId "art_543_bis_19" ;
    dzdoc:fullText "يحتوي الأمر بالتحويل على : 1 – الأمر الذي يوجهه صاحب الحساب إلى ماسك الحساب لتحويل الأموال أو القيم أو السندات المحددة القيمة، 2 - بيان الحساب الذي يتم الخصم منه، 3 – بيان الحساب الذي يتم إليه التحويل وصاحبه، 4 - تاريخ التنفيذ، 5 - توقيع الأمر بالتحويل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_19_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_19_19750926_OpEnact_75bf377434> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 19" ;
    dzdoc:position 585 ;
    dzdoc:usesTerm dzterm:account_holder,
        dzterm:account_keeper,
        dzterm:transfer_order .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_4_sec_2> ;
    dzdoc:eId "art_543_bis_21" ;
    dzdoc:fullText "يحتوي الأمر بالاقتطاع على : 1 - اسم مرسل الإشعار بالاقتطاع وبياناته المصرفية، وكذا رقمه كمرسل، الممنوح من قبل بنك الجزائر ، 2 - الاسم والبيانات المصرفية للمدين الأمر بالاقتطاع، 3 – الأمر غير المشروط بتحويل الأموال أو القيم أو السندات، 4 - قيمة المبلغ المحول، 5 - فترات الاقتطاع، 6 - توقيع المدين الأمر بالاقتطاع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_21_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_21_19750926_OpEnact_b44fb583a6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 21" ;
    dzdoc:position 587 ;
    dzdoc:usesTerm dzterm:bank_of_algeria,
        dzterm:order_of_deduction .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_22> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_4_sec_2> ;
    dzdoc:eId "art_543_bis_22" ;
    dzdoc:fullText "تنقل ملكية الأموال أو القيم أو السندات موضوع أمر الاقتطاع بقوة القانون بمجرد الخصم من الحساب، لفائدة الدائن المرسل للإشعار بالاقتطاع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_22> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_22_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_22_19750926_OpEnact_c20ab253a9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 22" ;
    dzdoc:position 588 ;
    dzdoc:usesTerm dzterm:order_of_deduction .

<https://legal.dz/resource/order/1975-09-26/75-59#art_590_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_590_bis_1" ;
    dzdoc:fullText "لا تطبق أحكام المادة 441 من القانون المدني والمتعلقة بالحل القضائي في حالة اجتماع كل حصص شركة ذات مسؤولية محدودة في يد واحدة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_590_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_590_bis_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_590_bis_1_19750926_OpEnact_5bdd12b260> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "590 مكرر 1" ;
    dzdoc:position 648 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_590_bis_1_extref_a4a7d1af> ;
    dzdoc:usesTerm dzterm:sarl .

<https://legal.dz/resource/order/1975-09-26/75-59#art_606> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_606" ;
    dzdoc:fullText "المادة 606 : تثبت الدفعات بمقتضى تصريح من مساهم أو أكثر في عقد موثق يتصرف الموثق على النحو المنصوص عليه في المادة 599 بناء على تقديم قائمة المساهمين المحتوية على المبالغ التي يدفعها كل مساهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_606> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_606_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_606_19750926_OpEnact_7451a410f9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "606" ;
    dzdoc:position 665 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_599> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_599> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_647> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_647" ;
    dzdoc:fullText "يحدد عقد التعيين كيفية دفع أجر أعضاء مجلس المديرين ومبلغ ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_647> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_647_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_647_19750926_OpEnact_41927b6c85> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 647" ;
    dzdoc:position 706 ;
    dzdoc:usesTerm dzterm:board_of_directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_650> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_650" ;
    dzdoc:fullText "يتداول مجلس المديرين ويتخذ قراراته حسب الشروط التي يحددها القانون الأساسي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_650> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_650_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_650_19750926_OpEnact_a1f4b97269> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 650" ;
    dzdoc:position 709 ;
    dzdoc:usesTerm dzterm:board_of_directors,
        dzterm:statutes .

<https://legal.dz/resource/order/1975-09-26/75-59#art_653> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_653" ;
    dzdoc:fullText "لا تمنح مهمة رئيس مجلس المديرين لصاحبها سلطة إدارة أوسع من تلك التي منح للأعضاء الآخرين في مجلس المديرين ، مع مراعاة أحكام المادة السابقة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_653> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_653_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_653_19750926_OpEnact_7e834bad52> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 653" ;
    dzdoc:position 712 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_652> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_652> ;
    dzdoc:usesTerm dzterm:board_of_directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_67> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_3> ;
    dzdoc:eId "art_67" ;
    dzdoc:fullText "ليس على الناقل أن يحرس الطرود المحمولة باليد والتي يحافظ عليها المسافر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_67> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_67_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_67_19750926_OpEnact_272f9f3161> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 67" ;
    dzdoc:position 69 ;
    dzdoc:usesTerm dzterm:carrier .

<https://legal.dz/resource/order/1975-09-26/75-59#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_3> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "يخضع نقل الأمتعة المسجلة لأحكام المواد 46 و 47 و 48 ومن 52 إلى 61 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_68> ;
