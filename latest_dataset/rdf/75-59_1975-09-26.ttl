<https://legal.dz/resource/order/1975-09-26/75-59#version_art_50> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يتعذر تعيين المسافة التي حصل أثناءها الضرر فيكون للناقل الذي تحمل تعويض الضرر حق الرجوع الجزئي على كل واحد من الناقلين على نسبة المسافة التي قطعها و يجب توزيع الحصص المطلوبة من المعسرين منهم على الجميع مع مراعاة نفس النسبة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_50_19750926_OpEnact_c72b689be5> ;
