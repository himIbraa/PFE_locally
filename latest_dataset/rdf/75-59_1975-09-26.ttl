    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_177> ;
    dznorm:conditionText "في حالة ما إذا ثبت أن المؤجر لم يمارس الحقوق المسندة له بموجب المادة 177 وما يليها إلا بنية تعطيل حقوق المستأجر بطريقة تدليسية، خاصة إذا قام بعمليات تأجير وإعادة بيع"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_186> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_186_condition_0_847741ff_ref_c071a27adec4> a dzdoc:Reference ;
