    dzdoc:targetEId "art_571" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_570_condition_3_a8fc1f89> a dznorm:Condition ;
    dznorm:conditionText "عند رفض القبول"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_570> ;
    dznorm:position 3 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_570_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_570> ;
    dzdoc:position 0 ;
    dzdoc:text "للحصص قابلية الانتقال عن طريق الإرث كما أنه يمكن إحالتها بكل حرية بين الأزواج والأصول والفروع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_570_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_570> ;
    dzdoc:position 1 ;
    dzdoc:text "غیر أنه يمكن أن يشترط في القانون الأساسي أنه لا يجوز أن يصبح الزوج أو أحد الورثة أو الأصل أو الفرع، شريكا إلا بعد قبوله ضمن الشروط المنصوص عنها. إن الآجال الممنوحة للشركة للفصل في القبول، لا يجوز أن تكون أكثر من التي نصت عليها المادة 571 والأغلبية المشترطة لا تكون أقوى من الأغلبية المطلوبة في المادة المذكورة، وذلك تحت طائلة بطلان الشرط المذكور، ويجرى عند رفض القبول تطبيق أحكام الفقرتين 3 و4 من المادة 571 ، ويعتبر القبول مكتسبا إذا لم يحصل حل من الحلول المنصوص عليها في هاتين الفقرتين في الآجال المقررة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_570_permission_0_c4df8a85> a dznorm:Permission ;
