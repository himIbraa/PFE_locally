<https://legal.dz/resource/order/1975-09-26/75-59#version_art_706> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يثبت الاكتتاب والدفعات بشهادة المودع المعتمد المعدة وقت إيداع الأموال بناء على تقديم بطاقة الاكتتاب. ويتم إثبات وفاء الأسهم بالمقاصة لديون نقدية ومستحقة الأداء على الشركة بواسطة تصريح موثق صادر إما عن مجلس الإدارة أو مجلس المديرين أو موكليهما. ويقوم هذا التصريح الموثق مقام شهادة المودع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_706_19750926_OpEnact_f3ad50e1f8> ;
    dzdoc:replacementText "يثبت الاكتتاب والدفعات بشهادة المودع المعتمد المعدة وقت إيداع الأموال بناء على تقديم بطاقة الاكتتاب. ويتم إثبات وفاء الأسهم بالمقاصة لديون نقدية ومستحقة الأداء على الشركة بواسطة تصريح موثق صادر إما عن مجلس الإدارة أو مجلس المديرين أو موكليهما. ويقوم هذا التصريح الموثق مقام شهادة المودع."@ar ;
