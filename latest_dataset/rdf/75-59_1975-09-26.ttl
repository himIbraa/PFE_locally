<https://legal.dz/resource/order/1975-09-26/75-59#art_34_defocc_a3aa4fbf0686> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 238 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:commercial_agency_contract ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_34> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_34_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يعتبر عقد الوكالة التجارية اتفاقية يلتزم بواسطتها الشخص عادة بإعداد أو إبرام البيوع أو الشراءات وبوجه عام جميع العمليات التجارية باسم ولحساب تاجر، والقيام عند الاقتضاء بعمليات تجارية لحسابه الخاص ولكن دون أن يكون مرتبطا بعقد إجارة الخدمات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_34_para_0> a dzdoc:Paragraph ;
