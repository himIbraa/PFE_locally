<https://legal.dz/resource/order/1975-09-26/75-59#art_147_obligation_0_80926f28> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_147> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتم إجراء القيد والبيانات طبقا للتشريع الساري المفعول"@ar ;
    dznorm:sourceArticle "art_147" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_147_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_147> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم إجراء القيد والبيانات طبقا للتشريع الساري المفعول إذا كانت البيوع أو التنازلات عن المحلات التجارية تشتمل على علامات المصنع أو التجارة أو الرسوم أو النماذج الصناعية، وكانت رهون هذه المحلات تشتمل على براءات اختراع أو رخص أو علامات أو رسوم أو نماذج."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_148_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_148> ;
    dzdoc:position 0 ;
    dzdoc:text "تحدد طبقا للتنظيم المعمول به المصاريف المستحقة للمركز الوطني للسجل التجاري لإتمام الإجراءات المنصوص عليها في هذا القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_149_condition_0_dab8f10b> a dznorm:Condition ;
    dznorm:conditionText "الأفراد المحكوم عليهم بجريمة أو تفليس أو سرقة أو خيانة الأمانة أو الاحتيال أو اختلاس مرتكب من مودع عمومي أو ابتزاز الأموال أو التوقيع أو القيم أو إصدار شيك عن سوء نية بدون رصيد أو المس باعتماد الدولة أو اليمين الكاذبة أو الشهادة الكاذبة أو إغراء شاهد أو المحاولة أو الاشتراك في إحدى الجرائم أو الجنح المشار إليها أعلاه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_149> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_149_condition_1_f6c34670> a dznorm:Condition ;
    dznorm:conditionText "المفلسون الذين لم يرد لهم اعتبارهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_149> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_149_obligation_0_b308fd6c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_149_obligation_0_b308fd6c_action_4f9a0817b4>,
