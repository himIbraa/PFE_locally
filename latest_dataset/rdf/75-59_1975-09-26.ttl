<https://legal.dz/resource/order/1975-09-26/75-59#version_art_357> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للمحكمة أن تقضي ولو تلقائيا بإقفال الإجراءات عند عدم وجود ديون مستحقة أو عندما يكون تحت تصرف وكيل التفليسة ما يكفي من المال . ولا يجوز إصدار الحكم بالإقفال لانقضاء الديون إلا بناء على تقرير من القاضي المنتدب يثبت تحقق واحد من الشرطين المتقدمين، ويضع الحكم حدا نهائيا للإجراءات بإعادة كافة حقوق المدين إليه وإعفائه من كل إسقاطات الحق التي كانت قد لحقت به. ويترتب على هذا الحكم رفع اليد عن رهن جماعة الدائنين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_357_19750926_OpEnact_6ce9e9d7f5> ;
    dzdoc:replacementText "للمحكمة أن تقضي ولو تلقائيا بإقفال الإجراءات عند عدم وجود ديون مستحقة أو عندما يكون تحت تصرف وكيل التفليسة ما يكفي من المال . ولا يجوز إصدار الحكم بالإقفال لانقضاء الديون إلا بناء على تقرير من القاضي المنتدب يثبت تحقق واحد من الشرطين المتقدمين، ويضع الحكم حدا نهائيا للإجراءات بإعادة كافة حقوق المدين إليه وإعفائه من كل إسقاطات الحق التي كانت قد لحقت به. ويترتب على هذا الحكم رفع اليد عن رهن جماعة الدائنين."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_357> ;
