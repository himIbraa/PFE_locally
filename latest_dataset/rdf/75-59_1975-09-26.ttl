<https://legal.dz/resource/order/1975-09-26/75-59#art_739_condition_1_af8dcd1b> a dznorm:Condition ;
    dznorm:conditionText "إذا يقع التصحيح في هذا الأجل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_739> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_739_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_739> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان بطلان أعمال ومداولات لاحقة لتأسيس الشركة مبنيا على مخالفة قواعد النشر، لكل شخص يهمه أمر تصحيح العمل أن ينذر الشركة بالقيام بهذا التصحيح في أجل ثلاثين يوما. وإذا يقع التصحيح في هذا الأجل، يجوز لكل شخص يهمه الأمر أن يطلب من القضاء تعيين وكيل يكلف بالقيام بهذا الإجراء."@ar .

