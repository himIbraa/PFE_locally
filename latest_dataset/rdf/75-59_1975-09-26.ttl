<https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_6> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "قيمة البضاعة هي القيمة المحددة وقت الإيداع، إلا إذا تعلق الأمر باختيار عمليات لأجل ، وبهذا الشرط الأخير فإن القيمة التي ينبغي أخذها بعين الاعتبار، تصبح القيمة المحددة بالنسبة لاختيار عمليات لأجل على البضائع أو المنتوجات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
