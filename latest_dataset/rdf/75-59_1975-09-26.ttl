<https://legal.dz/resource/order/1975-09-26/75-59#version_art_32> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يستمر الامتياز في جميع الأحوال على المرهون إلا إذا وضع هذا الأخير في حيازة الدائن وبقي لديه أو لدى الغير المتفق عليه بين الطرفين . ويعتبر الدائن حائزا للبضائع متى كانت تحت تصرفه في مخازنه أو سفنه، أو في الجمرك أو في مستودع عمومي أو كان بيد الدائن قبل وصولها وثيقة الشحن أو أي سند نقل آخر معادل لها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_32_19750926_OpEnact_4b10b5f196> ;
    dzdoc:replacementText "لا يستمر الامتياز في جميع الأحوال على المرهون إلا إذا وضع هذا الأخير في حيازة الدائن وبقي لديه أو لدى الغير المتفق عليه بين الطرفين . ويعتبر الدائن حائزا للبضائع متى كانت تحت تصرفه في مخازنه أو سفنه، أو في الجمرك أو في مستودع عمومي أو كان بيد الدائن قبل وصولها وثيقة الشحن أو أي سند نقل آخر معادل لها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_32> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
