<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_96> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحق لكل صاحب سندات استحقاق المشاركة في الجمعية أو أن يمثله وكيل من اختياره لا يكون موضوع أي منع . لا يجوز للشركة التي تحوز نسبة 10% على الأقل من رأسمال الشركة المدينة أن تصوت في الجمعية بما تملكه من سندات الاستحقاق ."@ar ;
