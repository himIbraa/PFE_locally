<https://legal.dz/resource/order/1975-09-26/75-59#art_108> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_108" ;
    dzdoc:fullText "لا يجوز ل مأموري السجل التجاري في سائر الأحوال أن يمتنعوا عن القيام بالقيود أو تسليم الجداول أو الشهادات المطلوبة. ويعدون مسؤولين عن الإهمال الحاصل في دفاتر القيود المطلوبة في المركز الوطني للسجل التجاري وكذلك عن عدم التأشير في الجداول أو شهادات القيد أو القيود المتعددة الموجودة لديهم، إلا إذا كان الخطأ في هذه الحالة الأخيرة ناتجا عن بيانات غير كافية لا يمكن إسنادها إليهم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_108_permission_0_d20ccc61>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_108_permission_1_9c07be62> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_108> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_108_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_108_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_108_19750926_OpEnact_ce3a718503> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_108_obligation_0_d20ccc61> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_108_prohibition_0_d20ccc61> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "108" ;
    dzdoc:position 110 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_108_condition_0_778f2250> ;
    dzdoc:usesTerm dzterm:cnrc,
        dzterm:registrar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_151> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_8> ;
    dzdoc:eId "art_151" ;
    dzdoc:fullText "يجوز أن يكون دفع ثمن امتلاك الأدوات ومعدات التجهيز المهنية مضمونة . سواء بالنسبة للبائع أو بالنسبة للمقرض الذي يقدم المال اللازم لتسديده للبائع، أو بالرهن الحيازي المحدود للأدوات أو المعدات الممتلكة على الشكل المذكور. وإذا كان للمشتري صفة التاجر ، فإن الرهن الحيازي يخضع في هذه الحالة للأحكام التالية، وللقواعد المقررة المتعلقة ببيع المحلات التجارية ورهنها الحيازي و للنصوص اللاحقة دون أن يشتمل وجوبا على العناصر الأساسية للمحل التجاري. أما إذا لم يكن للمشتري صفة التاجر فإن الرهن الحيازي يخضع في هذه الحالة لأحكام المادة 166 الواردة فيما بعد."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_151_permission_0_0feffb77> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_151_right_0_9488e19e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_151> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_151_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_151_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_151_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_151_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_151_19750926_OpEnact_8f3d12cb32> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 151" ;
    dzdoc:position 153 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_166> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_166> ;
