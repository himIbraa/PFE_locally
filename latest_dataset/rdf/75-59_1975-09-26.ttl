<https://legal.dz/resource/order/1975-09-26/75-59#art_79_obligation_0_e5d4710d_action_9d14c66374> a dznorm:Action ;
    rdfs:label "إثباته بعقد رسمي وإلا كان"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "كل بيع اختياري أو وعد بالبيع وبصفة أعم كل تنازل عن محل تجاري ولو كان معلقا على شرط أو صادرا بموجب عقد من نوع آخر أو كان يقضي بانتقال المحل التجاري بالقسمة أو المزايدة أو بطريق المساهمة به في رأس مال شركة يجب إثباته بعقد رسمي وإلا كان باطلا"@ar ;
