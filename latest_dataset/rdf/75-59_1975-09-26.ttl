<https://legal.dz/resource/order/1975-09-26/75-59#version_art_467> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تطبق على السند لأمر الأحكام المتعلقة بـ السفتجة فيما لا يتعارض مع طبيعته وذلك في الأحوال الآتية : التظهير \" المادة من 396 إلى 402 \"، الاستحقاق \" المادة من 410 إلى 413 \"، الوفاء \" المادة من 414 إلى 425 \"، الرجوع لعدم الوفاء \" المادة من 426 إلى 435 و المادة 437 و 438 و 439 و 440 \"، الاحتجاجات \" المادة من 441 إلى 444 \"، سند الرجوع \" المادة من 445 إلى 447 \"، الوفاء بطريق التدخل \" المادة من 448 و 450 إلى 454 \"، النسخ \" المادة 458 و المادة 459 \"، التحريف \" المادة 460 \"، التقادم \" المادة 461 \". أيام ال"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_467_19750926_OpEnact_2a89949454> ;
    dzdoc:replacementText "تطبق على السند لأمر الأحكام المتعلقة بـ السفتجة فيما لا يتعارض مع طبيعته وذلك في الأحوال الآتية : التظهير \" المادة من 396 إلى 402 \"، الاستحقاق \" المادة من 410 إلى 413 \"، الوفاء \" المادة من 414 إلى 425 \"، الرجوع لعدم الوفاء \" المادة من 426 إلى 435 و المادة 437 و 438 و 439 و 440 \"، الاحتجاجات \" المادة من 441 إلى 444 \"، سند الرجوع \" المادة من 445 إلى 447 \"، الوفاء بطريق التدخل \" المادة من 448 و 450 إلى 454 \"، النسخ \" المادة 458 و المادة 459 \"، التحريف \" المادة 460 \"، التقادم \" المادة 461 \". أيام الأعياد الرسمية وأيام العمل المشبهة بها وحساب الآجال ومنح أجال الإمهال طبقا لأحكام \" المواد 464 و 463 و 462 \""@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_467> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
