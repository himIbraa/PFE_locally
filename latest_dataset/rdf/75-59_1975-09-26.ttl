<https://legal.dz/resource/order/1975-09-26/75-59#art_570_condition_2_011d0bc8> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_570_condition_2_011d0bc8_ref_43c345d3097a> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_571> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_571> ;
    dznorm:conditionText "الأغلبية المشترطة لا تكون أقوى من الأغلبية المطلوبة في المادة المذكورة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_570> ;
    dznorm:position 2 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_570_condition_2_011d0bc8_ref_43c345d3097a> a dzdoc:Reference ;
