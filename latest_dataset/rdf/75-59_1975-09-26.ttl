    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_37> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_37_obligation_0_84417e8a_role_b2d3573e9d> a dznorm:Role ;
    rdfs:label "بمقتضاه تاجر بأن يباشر"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يلتزم بمقتضاه تاجر بأن يباشر باسمه الخاص أو باسم موكله أو شخص من الغير نقل أشخاص أو أشياء، وأن يقوم عند الاقتضاء بالأعمال الفرعية المرتبطة بالنقل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_37> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_380_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_380> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق عقوبة التفليس بالتقصير على القائمين بالإدارة والمديرين أو المصفين في شركة مساهمة، والمسيرين أو المصفين في الشركة ذات المسؤولية المحدودة، وبوجه عام كل المفوضين من قبل الشركة يكونون بقصد إخفاء كل أو بعض ذمتهم المالية عن متابعتهم من جانب الشركة المتوقفة عن الدفع أو من دائني الشركة يكونون عن سوء قصد اختلسوا أو أخفوا جانبا من أموالهم أو أقروا تدليسا بمديونتهم بمبالغ ليست في ذمتهم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_381_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_381> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق على الأشخاص المحكوم عليهم بمقتضى المواد من 378 إلى 380 وبقوة القانون، الإسقاطات التي رتبها القانون على إفلاس التجار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_382_extref_59ab611c> a dzdoc:ExternalReference ;
    rdfs:label "43"@ar ;
    dzdoc:frbrUri "/akn/dz/act/order/1966-06-08/66-156#art_43"^^xsd:anyURI ;
