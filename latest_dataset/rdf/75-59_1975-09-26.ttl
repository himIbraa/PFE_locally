<https://legal.dz/resource/order/1975-09-26/75-59#version_art_531> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "بالنسبة لمظهري الصك وضامني وفائه لا يمكن أن يحل إجراء حامل الصك محل عقد الاحتجاج ما عدا الحالة المنصوص عليها في المادتين 508 و 509 المتعلقة بضياع الصك . وبالنسبة للساحب، تعادل شهادة عدم الدفع لانعدام أو قلة الرصيد المسلمة من قبل البنك. تحدد عند الاقتضاء كيفيات تطبيق الفقرة السالفة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_531_19750926_OpEnact_3fd1f4a1ed> ;
    dzdoc:replacementText "بالنسبة لمظهري الصك وضامني وفائه لا يمكن أن يحل إجراء حامل الصك محل عقد الاحتجاج ما عدا الحالة المنصوص عليها في المادتين 508 و 509 المتعلقة بضياع الصك . وبالنسبة للساحب، تعادل شهادة عدم الدفع لانعدام أو قلة الرصيد المسلمة من قبل البنك. تحدد عند الاقتضاء كيفيات تطبيق الفقرة السالفة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_531> ;
