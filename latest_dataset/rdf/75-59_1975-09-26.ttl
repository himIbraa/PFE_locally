<https://legal.dz/resource/order/1975-09-26/75-59#art_605_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_605> ;
    dzdoc:position 0 ;
    dzdoc:text "المادة 605 : تطبق أحكام الفقرة الأولى أعلاه ما عدا المواد 595 و 597 و 600 و 601 \"المقاطع 2 و 3 و 4\" و 602 و 603، عندما لا يتم اللجوء علانية للادخار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_606_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_606> ;
    dzdoc:position 0 ;
    dzdoc:text "المادة 606 : تثبت الدفعات بمقتضى تصريح من مساهم أو أكثر في عقد موثق يتصرف الموثق على النحو المنصوص عليه في المادة 599 بناء على تقديم قائمة المساهمين المحتوية على المبالغ التي يدفعها كل مساهم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_607_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_607> ;
    dzdoc:position 0 ;
    dzdoc:text "المادة 607 : يشتمل القانون الأساسي، على تقدير الحصص العينية. ويتم هذا التقدير بناء على تقرير ملحق بالقانون الأساسي يعده مندوب الحصص تحت مسؤوليته."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_607_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_607> ;
    dzdoc:position 1 ;
    dzdoc:text "ويتبع نفس الإجراء، إذا تم اشتراط امتيازات خاصة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_608_condition_0_331a45ad> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_608_condition_0_331a45ad_ref_5fcc14ca4ca2> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_607> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_607> ;
    dznorm:conditionText "بعد التصريح الموثق بالدفعات وبعد وضع التقرير المشار إليه في المادة السابقة تحت تصرف المساهمين حسب الشروط والآجال المحددة عن طريق التنظيم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_608> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_608_condition_0_331a45ad_ref_5fcc14ca4ca2> a dzdoc:Reference ;
    rdfs:label "المادة السابقة"@ar ;
    dzdoc:frbrUri "#art_607"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1975-09-26/75-59#art_607> ;
    dzdoc:sourceEId "art_608" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "بعد التصريح الموثق بالدفعات وبعد وضع التقرير المشار إليه في المادة السابقة تحت تصرف المساهمين حسب الشروط والآجال المحددة عن طريق التنظيم"@ar ;
    dzdoc:targetEId "art_607" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_608_obligation_0_10774729> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_608> ;
    dznorm:position 0 ;
    dznorm:provisionText "يوقع المساهمون القانون الأساسي، إما بأنفسهم أو بواسطة وكيل مزود بتفويض خاص"@ar ;
    dznorm:sourceArticle "art_608" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_608_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_608> ;
    dzdoc:position 0 ;
    dzdoc:text "المادة 608 : يوقع المساهمون القانون الأساسي، إما بأنفسهم أو بواسطة وكيل مزود بتفويض خاص، بعد التصريح الموثق بالدفعات وبعد وضع التقرير المشار إليه في المادة السابقة تحت تصرف المساهمين حسب الشروط والآجال المحددة عن طريق التنظيم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_609_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_609> ;
    dzdoc:position 0 ;
    dzdoc:text "المادة 609 : يعين القائمون بالإدارة الأولون وأعضاء مجلس المراقبة الأولون ومندوبو الحسابات الأولون في القوانين الأساسية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_60_obligation_0_bda27b97> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_60> ;
    dznorm:position 0 ;
    dznorm:provisionText "يكون الوكيل بالعمولة مكلفا قانونا بالحضور فيها"@ar ;
    dznorm:sourceArticle "art_60" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_60_obligation_1_bda27b97> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_60> ;
    dznorm:position 1 ;
    dznorm:provisionText "يكون الوكيل بالعمولة مكلفا قانونا بالحضور فيها"@ar ;
    dznorm:sourceArticle "art_60" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_60_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_60> ;
