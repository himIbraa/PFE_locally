    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_57> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتعين على الهيئات المؤهلة في الشركة في أجل شهرين ابتداء من تاريخ إبلاغ الرفض، إما العمل على أن يشتري الأسهم أحد المساهمين أو أن يشتريها من الغير، وإما أن تشتريها الشركة بموافقة المحيل قصد تخفيض رأس المال"@ar ;
    dznorm:sourceArticle "art_715_bis_57" .

