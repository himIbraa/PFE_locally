<https://legal.dz/resource/order/1975-09-26/75-59#art_637_condition_2_02d5918c> a dznorm:Condition ;
    dznorm:conditionText "وفي حالة الوفاة أو الاستقالة أو الإقالة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_637> ;
