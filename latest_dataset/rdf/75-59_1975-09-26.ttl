<https://legal.dz/resource/order/1975-09-26/75-59#version_art_93> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز لقاضي الأمور المستعجلة أن يمنح الإذن المطلوب إلا إذا أقام المشتري المدخل في الدعوى إشهادا صريحا بعدم وجود دائنين آخرين معارضين غير الدائنين الذين شملهم النزاع . ولا تعتبر ذمة المشتري مبرأة بتنفيذه الأمر تجاه الدائنين الآخرين إذا وجدوا على أثر حجوز ما للمدين لدى الغير ومبلغة قبل صدور الأمر وقد تعمد المشتري إخفاءها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_93_19750926_OpEnact_0882c3ca61> ;
    dzdoc:replacementText "لا يجوز لقاضي الأمور المستعجلة أن يمنح الإذن المطلوب إلا إذا أقام المشتري المدخل في الدعوى إشهادا صريحا بعدم وجود دائنين آخرين معارضين غير الدائنين الذين شملهم النزاع . ولا تعتبر ذمة المشتري مبرأة بتنفيذه الأمر تجاه الدائنين الآخرين إذا وجدوا على أثر حجوز ما للمدين لدى الغير ومبلغة قبل صدور الأمر وقد تعمد المشتري إخفاءها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
