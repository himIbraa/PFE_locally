<https://legal.dz/resource/order/1975-09-26/75-59#version_art_34> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتبر عقد الوكالة التجارية اتفاقية يلتزم بواسطتها الشخص عادة بإعداد أو إبرام البيوع أو الشراءات وبوجه عام جميع العمليات التجارية باسم ولحساب تاجر، والقيام عند الاقتضاء بعمليات تجارية لحسابه الخاص ولكن دون أن يكون مرتبطا بعقد إجارة الخدمات . إذا كان عقد الوكالة التجارية غير محدد بمدة معينة فلا يجوز لكلا الطرفين فسخه دون إخبار مسبق ومطابق للأعراف ، إلا في حالة صدور خطأ من أحد الطرفين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_34_19750926_OpEnact_65a732b9e2> ;
    dzdoc:replacementText "يعتبر عقد الوكالة التجارية اتفاقية يلتزم بواسطتها الشخص عادة بإعداد أو إبرام البيوع أو الشراءات وبوجه عام جميع العمليات التجارية باسم ولحساب تاجر، والقيام عند الاقتضاء بعمليات تجارية لحسابه الخاص ولكن دون أن يكون مرتبطا بعقد إجارة الخدمات . إذا كان عقد الوكالة التجارية غير محدد بمدة معينة فلا يجوز لكلا الطرفين فسخه دون إخبار مسبق ومطابق للأعراف ، إلا في حالة صدور خطأ من أحد الطرفين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_34> ;
