<https://legal.dz/resource/order/1975-09-26/75-59#version_art_251> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يصح التمسك قبل جماعة الدائنين بالرهون الحيازية والامتيازات التي سجلت بعد صدور الحكم الذي قضى بالتسوية القضائية أو شهر الإفلاس . غير أن الخزينة العامة تبقى متمسكة بامتيازها على الديون التي كانت غير ملزمة بتسجيلها في تاريخ الحكم الذي قضى بالتسوية القضائية أو شهر الإفلاس وللديون المعروضة للتحصيل بعد ذلك التاريخ."@ar ;
    dzdoc:isAuthoritative true ;
