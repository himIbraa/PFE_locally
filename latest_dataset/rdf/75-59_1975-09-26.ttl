<https://legal.dz/resource/order/1975-09-26/75-59#version_art_257> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقدم وكيل التفليسة خلال الشهر الذي صدر فيه الحكم ، بيانا موجزا للقاضي المنتدب بالوضعية الظاهرة للمدين وأسباب وخصائص هذا المركز . ويقوم القاضي المنتدب بإحالة البيان فورا إلى وكيل الدولة مشفوعا بملاحظاته . فإذا لم يقدم إليه ذلك البيان في المهلة المحددة ، وجب عليه أن يخطر وكيل الدولة بذلك وأن يوضح له أسباب التأخير ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_257_19750926_OpEnact_5e646b7eed> ;
    dzdoc:replacementText "يقدم وكيل التفليسة خلال الشهر الذي صدر فيه الحكم ، بيانا موجزا للقاضي المنتدب بالوضعية الظاهرة للمدين وأسباب وخصائص هذا المركز . ويقوم القاضي المنتدب بإحالة البيان فورا إلى وكيل الدولة مشفوعا بملاحظاته . فإذا لم يقدم إليه ذلك البيان في المهلة المحددة ، وجب عليه أن يخطر وكيل الدولة بذلك وأن يوضح له أسباب التأخير ."@ar ;
