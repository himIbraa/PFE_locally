<https://legal.dz/resource/order/1975-09-26/75-59#version_art_662> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنتخب الجمعية العامة التأسيسية أو الجمعية العامة العادية، أعضاء مجلس المراقبة . ويمكن إعادة انتخابهم ما لم ينص القانون الأساسي على خلاف ذلك . وتحدد فترة وظائفهم بموجب القانون الأساسي دون تجاوز ست (6) سنوات في حالة التعيين من الجمعية العامة، ودون تجاوز ثلاث (3) سنوات في حالة التعيين بموجب القانون الأساسي . غير أنه يمكن في حالة الدمج أو الانفصال أن يتم التعيين من الجمعية العامة غير العادية. ويمكن أن تعزلهم الجمعية العامة العادية في أي وقت ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_662_19750926_OpEnact_612141b340> ;
    dzdoc:replacementText "تنتخب الجمعية العامة التأسيسية أو الجمعية العامة العادية، أعضاء مجلس المراقبة . ويمكن إعادة انتخابهم ما لم ينص القانون الأساسي على خلاف ذلك . وتحدد فترة وظائفهم بموجب القانون الأساسي دون تجاوز ست (6) سنوات في حالة التعيين من الجمعية العامة، ودون تجاوز ثلاث (3) سنوات في حالة التعيين بموجب القانون الأساسي . غير أنه يمكن في حالة الدمج أو الانفصال أن يتم التعيين من الجمعية العامة غير العادية. ويمكن أن تعزلهم الجمعية العامة العادية في أي وقت ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_662> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_662> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
