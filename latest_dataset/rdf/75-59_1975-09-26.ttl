<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_124> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز طلب التحويل وفق أجل وشروط محددة في عقد الإصدار، في حالة إصدار سندات استحقاق قابلة للتحويل إلى أسهم في أي وقت . ويكون للأسهم المسلمة لأصحاب سندات الاستحقاق الحق في الأرباح المدفوعة بعنوان السنة المالية التي طلب فيها التحويل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_124_19750926_OpEnact_2a9df1b3f2> ;
    dzdoc:replacementText "يجوز طلب التحويل وفق أجل وشروط محددة في عقد الإصدار، في حالة إصدار سندات استحقاق قابلة للتحويل إلى أسهم في أي وقت . ويكون للأسهم المسلمة لأصحاب سندات الاستحقاق الحق في الأرباح المدفوعة بعنوان السنة المالية التي طلب فيها التحويل ."@ar ;
