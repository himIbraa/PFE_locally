<https://legal.dz/resource/order/1975-09-26/75-59#version_art_340> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يقم المدين بتنفيذ شروط الصلح ، فيجوز رفع طلب بفسخه إلى المحكمة التي صدقت عليه في مواجهة الكفلاء إن كانوا أو بعد استدعائهم قانونا. وللمحكمة أن تتولى القضية تلقائيا وتحكم بفسخ الصلح . ولا يترتب على فسخ الصلح إبراء الكفلاء المتدخلين لضمان تنفيذه كليا أو جزئيا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_340_19750926_OpEnact_7bcb6749ef> ;
