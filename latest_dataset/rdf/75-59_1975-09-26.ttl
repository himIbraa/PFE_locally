<https://legal.dz/resource/order/1975-09-26/75-59#version_art_443> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يشتمل الاحتجاج على نسخة حرفية لنص السفتجة والقبول والتظهيرات والقيود المبينة بها مع الإنذار بوفاء مبلغ السفتجة . ويذكر فيه ما إذا كان الشخص الذي يجب عليه الدفع حاضرا أو غائبا مع بيان أسباب رفض الوفاء والعجز عن التوقيع أو رفض التوقيع."@ar ;
