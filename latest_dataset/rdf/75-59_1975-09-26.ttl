<https://legal.dz/resource/order/1975-09-26/75-59#art_181_condition_0_14ba6b8d> a dznorm:Condition ;
    dznorm:conditionText "إذا كانت نيته تتجه إلى الارتفاع بالعمارة وأن هذا الارتفاع يتطلب طرد المستأجر مؤقتا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_181> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_181_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_181> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز كذلك للمالك أن يؤخر تجديد الإيجار لمدة أقصاها ثلاث سنوات، إذا كانت نيته تتجه إلى الارتفاع بالعمارة وأن هذا الارتفاع يتطلب طرد المستأجر مؤقتا. فيحق لهذا الأخير في هذه الحالة، الحصول على تعويض يساوي الضرر اللاحق به دون أن يزيد هذا التعويض عن بدل إيجار ثلاث سنوات."@ar .

