<https://legal.dz/resource/order/1975-09-26/75-59#version_art_756> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تصبح الشركة مدينة لدائني الشركة المدمجة في محل ومكان تلك دون أن يترتب على هذا الحلول تجديد بالنسبة لهم . ويجوز لدائني الشركة الذين شاركوا في عملية الإدماج وكان دينهم سابقا لنشر مشروع الإدماج، أن يقدموا معارضة ضد هذه الأخيرة في أجل 30 يوما ابتداء من النشر المنصوص عليه في المادة 748 . ويتخذ بعد ذلك قرار قضائي إما برفض المعارضة أو يلغى الأمر إما بتسديد الديون، وإما بإنشاء ضمانات تقدمها الشركة الماصة بشرط أن تكون هذه الضمانات كافية. ولا يحتج بالإدماج على هذا الدائن إذا لم تسدد الديون أو لم تنشأ الضم"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_756_19750926_OpEnact_1dbe43f4ef> ;
    dzdoc:replacementText "تصبح الشركة مدينة لدائني الشركة المدمجة في محل ومكان تلك دون أن يترتب على هذا الحلول تجديد بالنسبة لهم . ويجوز لدائني الشركة الذين شاركوا في عملية الإدماج وكان دينهم سابقا لنشر مشروع الإدماج، أن يقدموا معارضة ضد هذه الأخيرة في أجل 30 يوما ابتداء من النشر المنصوص عليه في المادة 748 . ويتخذ بعد ذلك قرار قضائي إما برفض المعارضة أو يلغى الأمر إما بتسديد الديون، وإما بإنشاء ضمانات تقدمها الشركة الماصة بشرط أن تكون هذه الضمانات كافية. ولا يحتج بالإدماج على هذا الدائن إذا لم تسدد الديون أو لم تنشأ الضمانات التي أمر بتقديمها. على أن المعارضة المقدمة من دائن واحد لا يكون لها أي تأثير على متابعة عمليات الإدماج. كما لا تعترض أحكام هذه المادة بالنسبة لتطبيق الاتفاقيات التي ترخص للدائن باشتراط التسديد العاجل لدينه في حالة إدماج الشركة المدينة بشركة أخرى."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_756> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_756> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

