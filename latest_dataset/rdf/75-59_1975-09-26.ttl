    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب تسديد رأس المال بكامله قبل القيام بأي إصدار لأسهم جديدة واجبة التسديد نقدا ذلك تحت طائلة بطلان العملية. وعلاوة على ذلك، فإن زيادة رأس المال باللجوء العلني للادخار الذي تم تحقيقه في فترة تقل عن سنتين من تأسيس شركة وفقا ل المواد من 605 إلى 609 ، يجب أن يسبقه حسب الشروط المنصوص عليها في المواد من 601 إلى 603 فحص أصول وخصوم هذه الشركة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_693_19750926_OpEnact_f7d5a1af2a> ;
    dzdoc:replacementText "يجب تسديد رأس المال بكامله قبل القيام بأي إصدار لأسهم جديدة واجبة التسديد نقدا ذلك تحت طائلة بطلان العملية. وعلاوة على ذلك، فإن زيادة رأس المال باللجوء العلني للادخار الذي تم تحقيقه في فترة تقل عن سنتين من تأسيس شركة وفقا ل المواد من 605 إلى 609 ، يجب أن يسبقه حسب الشروط المنصوص عليها في المواد من 601 إلى 603 فحص أصول وخصوم هذه الشركة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
