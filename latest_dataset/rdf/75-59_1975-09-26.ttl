<https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis_2_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis_2> ;
    dzdoc:position 0 ;
    dzdoc:text "يسير التجمع شخص واحد أو أكثر ويمكن أن يعين شخص معنوي قائما بإدارة التجمع مع مراعاة تعيين ممثل دائم يتحمل نفس المسؤوليات المدنية والجزائية كما لو كان قائما بالإدارة باسمه الخاص."@ar .

