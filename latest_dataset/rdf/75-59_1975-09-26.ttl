<https://legal.dz/resource/order/1975-09-26/75-59#version_art_581> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لكل شريك أن يشارك في القرارات وله عدد من الأصوات يعادل عدد الحصص التي يملكها في الشركة . لكل شريك أن ينيب عنه شريكا آخر أو زوجه و لا يسوغ له أن ينيب عنه شخصا آخر إلا إذا أجاز ذلك القانون الأساسي . لا يسوغ لشريك أن يعين وكيلا للتصويت عن جزء من حصصه والتصويت بنفسه عن الجزء الآخر من الحصص . ويعتبر كل شرط مخالف لأحكام الفقرتين الثانية والرابعة كأن لم يكن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_581_19750926_OpEnact_1b4d83f7f9> ;
    dzdoc:replacementText "يجوز لكل شريك أن يشارك في القرارات وله عدد من الأصوات يعادل عدد الحصص التي يملكها في الشركة . لكل شريك أن ينيب عنه شريكا آخر أو زوجه و لا يسوغ له أن ينيب عنه شخصا آخر إلا إذا أجاز ذلك القانون الأساسي . لا يسوغ لشريك أن يعين وكيلا للتصويت عن جزء من حصصه والتصويت بنفسه عن الجزء الآخر من الحصص . ويعتبر كل شرط مخالف لأحكام الفقرتين الثانية والرابعة كأن لم يكن."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_581> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_581> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_582> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتخذ القرارات في الجمعيات أو خلال الاستشارات الكتابية من واحد أو أكثر من الشركاء الذين يمثلون أكثر من نصف رأسمال الشركة . وإذا لم تحصل هذه الأغلبية في المداولة الأولى وجب دعوة الشركاء أو استشاراتهم مرة ثانية حسب الأحوال وتصدر القرارات بأغلبية الأصوات مهما كان مقدار جزء رأس المال الممثل ، ما لم ينص القانون الأساسي على شرط يخالف ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_582_19750926_OpEnact_0bf96c2c4a> ;
    dzdoc:replacementText "تتخذ القرارات في الجمعيات أو خلال الاستشارات الكتابية من واحد أو أكثر من الشركاء الذين يمثلون أكثر من نصف رأسمال الشركة . وإذا لم تحصل هذه الأغلبية في المداولة الأولى وجب دعوة الشركاء أو استشاراتهم مرة ثانية حسب الأحوال وتصدر القرارات بأغلبية الأصوات مهما كان مقدار جزء رأس المال الممثل ، ما لم ينص القانون الأساسي على شرط يخالف ذلك ."@ar ;
