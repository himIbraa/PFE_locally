<https://legal.dz/resource/order/1975-09-26/75-59#version_art_254> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقضي الحكم الناطق بالتسوية القضائية أو شهر الإفلاس لصالح جماعة الدائنين، بالرهن العقاري الذي يتعين على وكيل التفليسة بتسجيله فورا على جميع أموال المدين وعلى الأموال التي يكتسبها من بعد أولا بأول ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
