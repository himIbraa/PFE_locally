<https://legal.dz/resource/order/1975-09-26/75-59#version_art_172> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز التمسك ب حق التجديد إلا من طرف المستأجرين أو المحول إليهم أو ذوي الحقوق الذين يثبتون بأنهم يستغلون متجرا بأنفسهم أو بواسطة تابعيهم إما منذ سنتين متتابعتين وفقا لإيجار واحد أو أكثر مقيدة بصفة متتالية إما منذ أربع سنوات متتابعة وفقا لإيجار واحد أو أكثر متتالية شفاهية كانت أو كتابية . غیر أنه يجوز للمستأجر الذي يثبت بسبب مشروع أو الذي أجر متجره ضمن الشروط المنصوص عليها في الأحكام القانونية المتعلقة ب إيجار التسيير فإنه يجوز له أن يتمسك بالاستغلال . وفي حالة التنازل عن المتجر فإنه يجوز للمحو"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_172_19750926_OpEnact_683cc2cc49> ;
    dzdoc:replacementText "لا يجوز التمسك ب حق التجديد إلا من طرف المستأجرين أو المحول إليهم أو ذوي الحقوق الذين يثبتون بأنهم يستغلون متجرا بأنفسهم أو بواسطة تابعيهم إما منذ سنتين متتابعتين وفقا لإيجار واحد أو أكثر مقيدة بصفة متتالية إما منذ أربع سنوات متتابعة وفقا لإيجار واحد أو أكثر متتالية شفاهية كانت أو كتابية . غیر أنه يجوز للمستأجر الذي يثبت بسبب مشروع أو الذي أجر متجره ضمن الشروط المنصوص عليها في الأحكام القانونية المتعلقة ب إيجار التسيير فإنه يجوز له أن يتمسك بالاستغلال . وفي حالة التنازل عن المتجر فإنه يجوز للمحول إليه أن يتمسك بالحقوق المكتسبة من قبل المتنازل لإتمام مدة الاستغلال الشخصي عند الاقتضاء والمنصوص عليه في الفقرة السابقة. وتنتهي هذه المدة بانتهاء عقد الإيجار أو عند الاقتضاء بتاريخ تمديده حسبما هو منصوص عليه في المادة 173 التالية، ويعتبر هذا التاريخ الأخير إما بمثابة التاريخ الذي تم فيه التنبيه بالإخلاء وإما الأجل المألوف الذي يلي هذا الطلب في حالة وقوع طلب تجديد."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_172> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_172> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_173> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا ينتهي إيجار المحلات الخاصة بهذه الأحكام إلا بأثر تنبيه بالإخلاء حسبما جرت عليه العادات المحلية وفي مدة ستة أشهر قبل الأجل على الأقل. وفي حالة عدم التنبيه بالإخلاء يتواصل الإيجار المنعقد كتابة بالتمديد الضمني إلى ما بعد الأجل المحدد في العقد مع مراعاة الأحكام المنصوص عليها في الفقرة السابقة. لا تنتهي مدة الإيجار الواقف على شرط والذي يسمح تحقيقه للمؤجر بأن يطلب الفسخ إلا بتبليغ واقع قبل ستة أشهر قبل الأجل ولأجل مألوف، ويجب أن يشير هذا الإعلان إلى تحقيق الشرط المنصوص عليه في العقد. وعندما يتضمن "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_173_19750926_OpEnact_cc429a7970> ;
    dzdoc:replacementText "لا ينتهي إيجار المحلات الخاصة بهذه الأحكام إلا بأثر تنبيه بالإخلاء حسبما جرت عليه العادات المحلية وفي مدة ستة أشهر قبل الأجل على الأقل. وفي حالة عدم التنبيه بالإخلاء يتواصل الإيجار المنعقد كتابة بالتمديد الضمني إلى ما بعد الأجل المحدد في العقد مع مراعاة الأحكام المنصوص عليها في الفقرة السابقة. لا تنتهي مدة الإيجار الواقف على شرط والذي يسمح تحقيقه للمؤجر بأن يطلب الفسخ إلا بتبليغ واقع قبل ستة أشهر قبل الأجل ولأجل مألوف، ويجب أن يشير هذا الإعلان إلى تحقيق الشرط المنصوص عليه في العقد. وعندما يتضمن الإيجار عدة مراحل فإنه يجب التنبيه بالإخلاء في الآجال المنصوص عليها في الفقرة الأولى أعلاه ، إذا فسخ المؤجر الإيجار في نهاية إحدى هذه المراحل . يجب أن يتم التنبيه بالإخلاء بعقد غير قضائي وأن تبين فيه الأسباب التي أدت إلى توجيهه مع إعادة ذكر مضمون المادة 194 ، وإلا اعتبر باطلا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_173> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_173> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

