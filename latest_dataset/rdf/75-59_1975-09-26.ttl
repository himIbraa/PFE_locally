<https://legal.dz/resource/order/1975-09-26/75-59#version_art_110> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على البائع في حالة الفسخ القضائي أو الاختياري للبيع أن يسترد جميع عناصر المحل التجاري التي شملها البيع ، وبما فيها العناصر التي انقضى فيها امتيازه وحقه في دعوى الفسخ. ويكون البائع محاسبا عن ثمن البضائع والمعدات الموجودة بالمحل عند إعادة حيازته بما يقدر بموجب خبرة حضورية أو بالتراضي أو عن طريق القضاء على أن يطرح من الثمن ما قد يستحقه بموجب الامتياز الذي له على ثمن كل من البضائع والمعدات وإذا بقي شيء زائدا عن ذلك فيكون ضمانا للدائنين العاديين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_110_19750926_OpEnact_fae37645e4> ;
    dzdoc:replacementText "يجب على البائع في حالة الفسخ القضائي أو الاختياري للبيع أن يسترد جميع عناصر المحل التجاري التي شملها البيع ، وبما فيها العناصر التي انقضى فيها امتيازه وحقه في دعوى الفسخ. ويكون البائع محاسبا عن ثمن البضائع والمعدات الموجودة بالمحل عند إعادة حيازته بما يقدر بموجب خبرة حضورية أو بالتراضي أو عن طريق القضاء على أن يطرح من الثمن ما قد يستحقه بموجب الامتياز الذي له على ثمن كل من البضائع والمعدات وإذا بقي شيء زائدا عن ذلك فيكون ضمانا للدائنين العاديين."@ar ;
