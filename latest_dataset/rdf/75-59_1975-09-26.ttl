<https://legal.dz/resource/order/1975-09-26/75-59#version_art_374> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد مرتكبا للتفليس بالتدليس كل تاجر في حالة توقف عن الدفع يكون قد أخفى حساباته أو بدد أو اختلس كل أو بعض أصوله أو يكون بطريق التدليس قد أقر بمديونيته بمبالغ ليست في ذمته سواء كان هذا في محرراته بأوراق رسمية أو تعهدات عرفية أو في ميزانيته."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
