<https://legal.dz/resource/order/1975-09-26/75-59#version_art_664> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن شخصا طبيعيا الانتماء في نفس الوقت إلى أكثر من خمسة مجالس مراقبة لشركات المساهمة التي يكون مقرها في الجزائر. ولا تطبق أحكام المقطع السابق على الممثلين الدائمين للأشخاص المعنويين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_664_19750926_OpEnact_61ae83ffbd> ;
    dzdoc:replacementText "لا يمكن شخصا طبيعيا الانتماء في نفس الوقت إلى أكثر من خمسة مجالس مراقبة لشركات المساهمة التي يكون مقرها في الجزائر. ولا تطبق أحكام المقطع السابق على الممثلين الدائمين للأشخاص المعنويين."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_664> ;
