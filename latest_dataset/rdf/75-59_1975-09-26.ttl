<https://legal.dz/resource/order/1975-09-26/75-59#version_art_769> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا ينجم عن حل الشركة بحكم القانون فسخ إيجارات العقارات المستعملة لنشاط الشركة بما فيها محلات السكن التابعة لهذه العقارات. وإذا لم يعد التزام الضمان في حالة التنازل عن الإيجار مضمونا في حدود الإيجار المشار إليه ، فإنه يمكن إبداله بأمر مستعجل بكل ضمان كاف يقدم من المتنازل له أو الغير ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_769_19750926_OpEnact_b44995a135> ;
    dzdoc:replacementText "لا ينجم عن حل الشركة بحكم القانون فسخ إيجارات العقارات المستعملة لنشاط الشركة بما فيها محلات السكن التابعة لهذه العقارات. وإذا لم يعد التزام الضمان في حالة التنازل عن الإيجار مضمونا في حدود الإيجار المشار إليه ، فإنه يمكن إبداله بأمر مستعجل بكل ضمان كاف يقدم من المتنازل له أو الغير ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_769> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
