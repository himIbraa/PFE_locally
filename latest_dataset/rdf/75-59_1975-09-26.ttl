<https://legal.dz/resource/order/1975-09-26/75-59#art_663> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_663" ;
    dzdoc:fullText "يجوز تعيين شخص معنوي في مجلس المراقبة ، و عليه أن يعين ممثلا دائما عند تعيينه ، يخضع لنفس الشروط والالتزامات، ويتحمل نفس المسؤوليات الجزائية والمدنية كما لو كان عضوا باسمه الخاص ، دون المساس بالمسؤولية التضامنية للشخص المعنوي ممثله الذي يمثله و إذا عزل الشخص المعنوي وجب عليه استخلافه في الوقت نفسه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_663_permission_0_63651e44> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_663_right_0_0e47d4c5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_663> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_663_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_663_19750926_OpEnact_94d3549462> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_663_obligation_0_38679250>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_663_obligation_1_12a84970>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_663_obligation_2_6789e4a6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 663" ;
    dzdoc:position 722 ;
    dzdoc:usesTerm dzterm:board_of_auditors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_673> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_673" ;
    dzdoc:fullText "يمكن اعتبار أعضاء مجلس المديرين و أعضاء مجلس المراقبة ، المذكورين في المادة 671 أعلاه، مسؤولين عن ديون الشركة في حالة التسوية القضائية أو الإفلاس ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_673_permission_0_4cdfd5af> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_673> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_673_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_673_19750926_OpEnact_1b877a63f1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 673" ;
    dzdoc:position 732 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_671> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_671> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_673_condition_0_724863e4> ;
    dzdoc:usesTerm dzterm:board_of_directors_members,
        dzterm:supervisory_board_members .

<https://legal.dz/resource/order/1975-09-26/75-59#art_682> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_682" ;
    dzdoc:fullText "يرجع كذلك حق الإطلاع على الوثائق المنصوص عليها في المواد 677 و 678 و 680 ، إلى كل واحد من المالكين الشركاء للأسهم المشاعة وإلى مالك الرقبة والمنتفع بالأسهم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_682_right_0_33efb12d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_682> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_682_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_682_19750926_OpEnact_c3bdcb03c7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "682" ;
    dzdoc:position 741 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_677>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_678>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_680> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_677>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_678>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_680> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_685> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_685" ;
    dzdoc:fullText "يجوز أن يحدد القانون الأساسي عدد الأصوات التي يحوزها كل مساهم في الجمعيات، بشرط أن يفرض هذا التحديد على جميع الأسهم دون تمييز فئة عن أخرى ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_685_permission_0_b884af9e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_685> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_685_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_685_19750926_OpEnact_635e7e7fdf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "685" ;
    dzdoc:position 744 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_685_condition_0_af1c92c3> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_696> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_696" ;
    dzdoc:fullText "إذا لم تمتص الاكتتابات القائمة على أساس التفاضل والصلاحيات التي تمت بموجب الاكتتاب القائمة على أساس قابل للتخفيض مجموع زيادة رأس المال ، فإن الرصيد يوزع من مجلس الإدارة أو مجلس المديرين ، حسب الحالة، إذا لم تقرر الجمعية العامة غير العادية خلاف ذلك . وفي غياب ذلك، لا تتحقق زيادة رأس المال."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_696> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_696_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_696_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_696_19750926_OpEnact_d0c710fb95> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 696" ;
    dzdoc:position 755 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_696_condition_0_e9dabe42>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_696_condition_1_5c8a90bb> ;
    dzdoc:usesTerm dzterm:board_of_directors,
        dzterm:directorate .

<https://legal.dz/resource/order/1975-09-26/75-59#art_699> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_699" ;
    dzdoc:fullText "يخضع الإصدار ، الذي يتم باللجوء العلني للادخار دون حق التفاضل في اكتتاب الأسهم الذي لا يمنح لصاحبها نفس حقوق الأسهم القديمة، للشروط التالية : يجب أن يتم الإصدار في أجل سنتين ابتداء من تاريخ انعقاد الجمعية العامة التي قررت ذلك. تحدد الجمعية العامة غير العادية ، بناء على تقرير مجلس الإدارة أو مجلس المديرين وبناء على تقرير خاص من مندوب الحسابات ، سعر الإصدار أو شروط تحديد هذا السعر. وعندما لا يتم الإصدار في تاريخ انعقاد الجمعية العامة السنوية حسب القرار ، تفصل جمعية عامة غير عادية، بناء على تقرير مجلس الإدارة أو مجلس المديرين وبناء على تقرير خاص من مندوب الحسابات ، في الحفاظ على سعر الإصدار أو تعديله أو شروط تحديده، وفي غياب ذلك يكون قرار الجمعية الأولى باطلا."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_699_right_0_4ad512a3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_699> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_699_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_699_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_699_19750926_OpEnact_90c07c6679> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_699_obligation_0_3a326604> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "699" ;
    dzdoc:position 758 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_699_condition_0_0a6e1fdf>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_699_condition_1_3e876b97> ;
    dzdoc:usesTerm dzterm:auditor,
        dzterm:board_of_directors,
        dzterm:directorate,
        dzterm:general_assembly,
        dzterm:issuance .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_103> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_103" ;
    dzdoc:fullText "لا يجوز للشركة المصدرة ، بأي حال من الأحوال، أن تفرض التسديد المسبق لسندات الاستحقاق إلا في حالة وجود شرط صريح في عقد الإصدار ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_103_permission_0_1bd875b0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_103> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_103_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_103_19750926_OpEnact_e57fd23f2f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_103_obligation_0_1e046760> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_103_prohibition_0_1bd875b0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 103" ;
    dzdoc:position 877 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_103_condition_0_a9a19250> ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_6> ;
    dzdoc:eId "art_715_bis_110" ;
    dzdoc:fullText "ترخص الجمعية العامة غير العادية للمساهمين بإصدار القيم المنقولة ، بناء على تقرير مجلس الإدارة أو مجلس المراقبة أو مجلس المديرين و مندوب الحسابات . ويجيز قرار الجمعية العامة غير العادية بقوة القانون لصالح حاملي هذه القيم المنقولة ، تنازل المساهمين عن حقهم في الأفضلية للاكتتاب في السندات التي تعطي الحق فيه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_110_right_0_1a12ea01> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_110_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_110_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_110_19750926_OpEnact_de1fa21a10> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 110" ;
    dzdoc:position 884 ;
    dzdoc:usesTerm dzterm:auditor,
        dzterm:board_of_directors,
        dzterm:general_assembly,
        dzterm:management_board,
        dzterm:securities,
        dzterm:supervisory_board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_130> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_6> ;
    dzdoc:eId "art_715_bis_130" ;
    dzdoc:fullText "يجوز التنازل عن قسيمات الاكتتاب أو التداول فيها بصفة مستقلة عن سندات الاستحقاق ، إلا إذا نص عقد الإصدار على خلاف ذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_130_permission_0_ac1bda7a> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_130_right_0_77cf592e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_130> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_130_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_130_19750926_OpEnact_9890912025> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 130" ;
    dzdoc:position 904 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_130_condition_0_bad8ee00> ;
    dzdoc:usesTerm dzterm:entitlement_securities,
        dzterm:subscription_coupons .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_8> ;
    dzdoc:eId "art_715_bis_15" ;
    dzdoc:fullText "يجوز لكل شركة مساهمة أن تتحول إلى شركة من نوع آخر إذا كان عند التحويل، قد مر على تاريخ إنشائها سنتان على الأقل وأعدت ميزانية السنتين الماليتين الأوليين وأثبتت موافقة المساهمين عليها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_15_permission_0_26bbeb24> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_15_right_0_0defb6fe> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_15_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_15_19750926_OpEnact_8cbaa7cde1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 15" ;
    dzdoc:position 789 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_15_condition_0_3fc37f3a> ;
    dzdoc:usesTerm dzterm:joint_stock_company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_8> ;
    dzdoc:eId "art_715_bis_16" ;
    dzdoc:fullText "يتخذ قرار التحويل بناء على تقرير مندوبي الحسابات الذين يشهدون أن رؤوس الأصول تساوي على الأقل رأس مال الشركة . يعرض التحويل، عند الاقتضاء ، لموافقة جمعيات أصحاب السندات. ويخضع قرار التحويل لشروط الإشهار المنصوص عليها قانونا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_16_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_16_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_16_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_16_19750926_OpEnact_0f1edf9a9d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_16_obligation_0_3a397787>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_16_obligation_1_44aa304b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 16" ;
    dzdoc:position 790 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_16_condition_0_1b1645cd> ;
