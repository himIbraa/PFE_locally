<https://legal.dz/resource/order/1975-09-26/75-59#art_474_obligation_2_006da810> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_474_obligation_2_006da810_role_240fa36b8e> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_474> ;
    dznorm:position 2 ;
    dznorm:provisionText "وعلى الساحب أو من صدر الشيك لحسابه أن يتولى وضع مقابل الوفاء"@ar ;
    dznorm:sourceArticle "art_474" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_474_obligation_2_006da810_role_240fa36b8e> a dznorm:Role ;
    rdfs:label "الساحب أو من صدر"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "وعلى الساحب أو من صدر الشيك لحسابه أن يتولى وضع مقابل الوفاء"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_474> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_474_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_474> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يجوز سحب الشيك إلا على مصرف أو مقاولة أو مؤسسة مالية أو على مصلحة الصكوك البريدية أو مصلحة الودائع والأمانات أو الخزينة العامة أو قباضة مالية كما لا يجوز سحب الشيك إلا على مؤسسة القرض البلدي أو صناديق القرض الفلاحي التي يكون لديها وقت إنشاء السند رصيد من النقود تحت تصرف الساحب وبموجب اتفاق صريح أو ضمني يحق بمقتضاه للساحب أن يتصرف في هذه النقود بطريقة إصدار الشيك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_474_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_474> ;
    dzdoc:position 1 ;
    dzdoc:text "وعلى الساحب أو من صدر الشيك لحسابه أن يتولى وضع مقابل الوفاء ومع ذلك يظل الساحب لحساب غيره ملزما شخصيا للمظهرين والحامل دون غيرهم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_474_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_474> ;
    dzdoc:position 2 ;
    dzdoc:text "ويكون الساحب وحده ملزما عند الإنكار بإثبات أن من سحب عليه الشيك كان لديه مقابل وفائه في وقت إنشائه وإلا كان ضامنا وفاءه ولو قدم الاحتجاج بعد مضي الآجال المحددة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_474_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_474> ;
    dzdoc:position 3 ;
    dzdoc:text "إن السندات التي تم سحبها ووجب دفعها بالقطر الجزائري على غير الأشخاص المذكورين في الفقرة الأولى وكانت محررة على شكل شيكات لا يصح اعتبارها شيكات."@ar .

