<https://legal.dz/resource/order/1975-09-26/75-59#version_art_256> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة ما إذا كان المدين لم يودع الميزانية ، يقوم وكيل التفليسة بوضعها فورا مستعينا بالدفاتر والمستندات الحسابية والأوراق والمعلومات التي يحصل عليها ثم يودعها بكتابة ضبط المحكمة ."@ar ;
    dzdoc:isAuthoritative true ;
