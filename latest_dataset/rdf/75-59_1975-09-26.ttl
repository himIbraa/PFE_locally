    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_179> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_179_obligation_3_e9e36dfe> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
