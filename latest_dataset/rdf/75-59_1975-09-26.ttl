<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_83_permission_0_77cfb06a_action_0e566d0717> a dznorm:Action ;
    rdfs:label "أن يكون سند الاستحقاق دخلا"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "وفي الحالات المنصوص عليها صراحة عند الإصدار ، يمكن أن يكون سند الاستحقاق دخلا دائما يسمح بدخل متغير وقابل للتحويل إلى رأسمال بدون تعويض الأصل."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_83> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_84_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_84> ;
    dzdoc:position 0 ;
    dzdoc:text "تكون الجمعية العامة للمساهمين مؤهلة وحدها لتقرير إصدار سندات الاستحقاق وتحديد شروطها أو السماح بذلك. ويجوز لها أن تفوض سلطاتها إلى مجلس الإدارة أو مجلس المراقبة أو مجلس المديرين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_85_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_85> ;
    dzdoc:position 0 ;
    dzdoc:text "لا تطبق أحكام المادة 715 مكرر 84 المذكورة أعلاه على الشركات التي يكون موضوعها الأساسي إصدار سندات ضرورية لتمويل القروض التي تمنحها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_86_condition_0_d6372fb8> a dznorm:Condition ;
    dznorm:conditionText "إذا لجأت الشركة علنية إلى الادخار"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_86> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_86_obligation_0_95ef39ce> a dznorm:Obligation ;
