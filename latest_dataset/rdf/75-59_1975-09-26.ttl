<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_42> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الأسهم العادية هي الأسهم التي تمثل اكتتابات ووفاء لجزء من رأسمال شركة تجارية. وتمنح الحق في المشاركة في الجمعيات العامة والحق في انتخاب هيئات التسيير أو عزلها والمصادقة على كل عقود الشركة أو جزء منها، وقانونها الأساسي أو تعديله بالتناسب مع حق التصويت الذي بحوزتها بموجب قانونها الأساسي أو بموجب القانون . وتمنح الأسهم العادية ، علاوة على ذلك، الحق في تحصيل الأرباح عندما تقرر الجمعية العامة توزيع كل الفوائد الصافية المحققة أو جزء منها . وتتمتع جميع الأسهم العادية بنفس الحقوق والواجبات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_42_19750926_OpEnact_aab3a5bd41> ;
    dzdoc:replacementText "الأسهم العادية هي الأسهم التي تمثل اكتتابات ووفاء لجزء من رأسمال شركة تجارية. وتمنح الحق في المشاركة في الجمعيات العامة والحق في انتخاب هيئات التسيير أو عزلها والمصادقة على كل عقود الشركة أو جزء منها، وقانونها الأساسي أو تعديله بالتناسب مع حق التصويت الذي بحوزتها بموجب قانونها الأساسي أو بموجب القانون . وتمنح الأسهم العادية ، علاوة على ذلك، الحق في تحصيل الأرباح عندما تقرر الجمعية العامة توزيع كل الفوائد الصافية المحققة أو جزء منها . وتتمتع جميع الأسهم العادية بنفس الحقوق والواجبات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
