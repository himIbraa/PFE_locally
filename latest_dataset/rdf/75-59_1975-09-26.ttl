<https://legal.dz/resource/order/1975-09-26/75-59#version_art_641> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد مجلس الإدارة بالاتفاق مع رئيسه مدى ومدة السلطات المخولة للمديرين العامين ، وإذا كان أحدهما قائما بالإدارة فمدة وظيفته لا تكون أكثر من مدة وكالته. وللمديرين العامين نحو الغير نفس السلطات التي يتمتع بها الرئيس."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
