<https://legal.dz/resource/order/1975-09-26/75-59#version_art_169> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تطبق الأحكام الآتية على إيجار العمارات أو المحلات التي يستغل فيها محل تجاري سواء كان هذا الأخير مملوكا لـ تاجر أو لـ صناعي أو الحرفي أو لـ مؤسسة حرفية مقيدين قانونا في السجل التجاري أو في سجل الحرف والصناعات التقليدية حسب الحالة، ولا سيما : 1 - إيجار المحلات أو العمارات الملحقة باستغلال محل تجاري عندما يكون استعمالها ضروريا لاستغلال المحل التجاري وملكيتها تابعة لمالك المحل أو العمارة التي توجد بها المؤسسة الرئيسية . ويجب في حالة تعدد المالكين أن تكون المحلات الملحقة قد أجرت على مرآي ومسمع من الم"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_169_19750926_OpEnact_878ffe160b> ;
    dzdoc:replacementText "تطبق الأحكام الآتية على إيجار العمارات أو المحلات التي يستغل فيها محل تجاري سواء كان هذا الأخير مملوكا لـ تاجر أو لـ صناعي أو الحرفي أو لـ مؤسسة حرفية مقيدين قانونا في السجل التجاري أو في سجل الحرف والصناعات التقليدية حسب الحالة، ولا سيما : 1 - إيجار المحلات أو العمارات الملحقة باستغلال محل تجاري عندما يكون استعمالها ضروريا لاستغلال المحل التجاري وملكيتها تابعة لمالك المحل أو العمارة التي توجد بها المؤسسة الرئيسية . ويجب في حالة تعدد المالكين أن تكون المحلات الملحقة قد أجرت على مرآي ومسمع من المؤجر بقصد الاستعمال المشترك ، 2 - إيجار الأراضي العارية التي شيدت عليها قبل أو بعد الإيجار بنايات معدة للاستعمال التجاري أو الصناعي أو الحرفي بشرط أن تكون هذه البنايات قد شيدت أو استغلت بموافقة المالك الصريحة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_169> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_169> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_17> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للقضاة أن يوجهوا إنابة قضائية لدى المحكمة التي توجد بها الدفاتر أو يعينون قاضيا للاطلاع عليها وتحرير محضر بمحتواها وإرساله إلى المحكمة المختصة بالدعوى وذلك في حالة العرض بتقديمها أو طلب تقديمها أو الأمر به، إذا كانت هذه الدفاتر موجودة في أماكن بعيدة عن المحكمة المختصة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_17_19750926_OpEnact_d847f896ef> ;
    dzdoc:replacementText "يجوز للقضاة أن يوجهوا إنابة قضائية لدى المحكمة التي توجد بها الدفاتر أو يعينون قاضيا للاطلاع عليها وتحرير محضر بمحتواها وإرساله إلى المحكمة المختصة بالدعوى وذلك في حالة العرض بتقديمها أو طلب تقديمها أو الأمر به، إذا كانت هذه الدفاتر موجودة في أماكن بعيدة عن المحكمة المختصة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_17> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
