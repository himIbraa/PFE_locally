    dzdoc:evidenceText "للمحكمة بناء على طلب أحد دائني المدين أو وكيل التفليسة الإذن لهذا الأخير بالتعاقد جزافا في كل الأصول المنقولة أو العقارية أو بعضها وبيعها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_352_19750926_OpEnact_e08ce744ab> ;
