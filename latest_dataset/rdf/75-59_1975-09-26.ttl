    dznorm:provisionText "تمسك في كل جمعية ورقة للحضور"@ar ;
    dznorm:sourceArticle "art_681" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_681_obligation_1_bec73b9b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_681> ;
    dznorm:position 1 ;
    dznorm:provisionText "يلحق مكتب الجمعية بورقة الحضور ، الوكالة التي تتضمن اسم كل موكل ولقبه وموطنه وكذا عدد الأصوات التابعة لهذه الأسهم."@ar ;
    dznorm:sourceArticle "art_681" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_681_obligation_2_556d18dd> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
