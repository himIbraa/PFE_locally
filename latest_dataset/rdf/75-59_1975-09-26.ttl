    dznorm:conditionText "إذا كان من شأن العملية المقررة زيادة تعهدات الشركاء أو المساهمين لشركة أو عدة شركات معنية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_746> ;
