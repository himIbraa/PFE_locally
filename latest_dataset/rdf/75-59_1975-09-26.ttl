<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_23> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد القائمون بالإدارة مسؤولين على وجه الإنفراد أو بالتضامن، حسب الحالة، تجاه الشركة أو الغير، إما عن المخالفات الماسة بالأحكام التشريعية أو التنظيمية المطبقة على شركات المساهمة، وإما عن خرق القانون الأساسي أو عن الأخطاء المرتكبة أثناء تسييرهم . إذا شارك عدد كبير من القائمين بالإدارة في نفس الأفعال ، فإن المحكمة تحدد حصة كل واحد في تعويض الضرر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_23_19750926_OpEnact_7005c28497> ;
    dzdoc:replacementText "يعد القائمون بالإدارة مسؤولين على وجه الإنفراد أو بالتضامن، حسب الحالة، تجاه الشركة أو الغير، إما عن المخالفات الماسة بالأحكام التشريعية أو التنظيمية المطبقة على شركات المساهمة، وإما عن خرق القانون الأساسي أو عن الأخطاء المرتكبة أثناء تسييرهم . إذا شارك عدد كبير من القائمين بالإدارة في نفس الأفعال ، فإن المحكمة تحدد حصة كل واحد في تعويض الضرر."@ar ;
