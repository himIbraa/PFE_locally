<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لمساهم أو عدة مساهمين يمثلون على الأقل عشر (10/1) رأسمال الشركة، في الشركات التي تلجأ علنية للإدخار، أن يطلبوا من العدالة، وبناء على سبب مبرر، رفض مندوب ، أو مندوبي الحسابات الذين عينتهم الجمعية العامة . وإذا تمت تلبية الطلب ، تعين العدالة مندوبا جديدا للحسابات ويبقى هذا الأخير في وظيفته حتى قدوم مندوب الحسابات الذي تعينه الجمعية العامة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_8_19750926_OpEnact_2235aabbfe> ;
    dzdoc:replacementText "يجوز لمساهم أو عدة مساهمين يمثلون على الأقل عشر (10/1) رأسمال الشركة، في الشركات التي تلجأ علنية للإدخار، أن يطلبوا من العدالة، وبناء على سبب مبرر، رفض مندوب ، أو مندوبي الحسابات الذين عينتهم الجمعية العامة . وإذا تمت تلبية الطلب ، تعين العدالة مندوبا جديدا للحسابات ويبقى هذا الأخير في وظيفته حتى قدوم مندوب الحسابات الذي تعينه الجمعية العامة."@ar ;
