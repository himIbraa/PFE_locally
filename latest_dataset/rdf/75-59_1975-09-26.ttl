    dzdoc:text "وإذا وقعت معارضات على أموال مودعة من الغير، ويجب على وكيل التفليسة أن يطلب رفعها والحصول على ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_273_condition_0_219a1634> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_273_condition_0_219a1634_ref_a766bff8581e> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_277> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_277> ;
    dznorm:conditionText "وإذا كان المدين مأذونا بمتابعة استغلال مؤسسته الصناعية أو التجارية، وفقا للأوضاع المنصوص عليها في المادة 277"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_273> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_273_condition_0_219a1634_ref_a766bff8581e> a dzdoc:Reference ;
    rdfs:label "المادة 277"@ar ;
    dzdoc:frbrUri "#art_277"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1975-09-26/75-59#art_277> ;
    dzdoc:sourceEId "art_273" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "وإذا كان المدين مأذونا بمتابعة استغلال مؤسسته الصناعية أو التجارية، وفقا للأوضاع المنصوص عليها في المادة 277"@ar ;
    dzdoc:targetEId "art_277" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_273_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_273> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز للمدين، بمعونة وكيل التفليسة أن يقوم بكافة الإجراءات التحفظية وأن يباشر تحصيل السندات والديون الحالة الأداء وبيع الأشياء المعروضة للتلف القريب أو انخفاض القيمة الوشيك أو التي يكلف حفظها ثمنا باهظا وأن يرفع أو يتابع أية دعوى منقولة أو عقارية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_273_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_273> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا كان المدين مأذونا بمتابعة استغلال مؤسسته الصناعية أو التجارية، وفقا للأوضاع المنصوص عليها في المادة 277، جاز له بمساعدة وكيل التفليسة القيام بكافة الإجراءات اللازمة لذلك الاستغلال."@ar .

