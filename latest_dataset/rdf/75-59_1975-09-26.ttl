<https://legal.dz/resource/order/1975-09-26/75-59#version_art_748> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوضع مشروع العقد بأحد مكاتب التوثيق للمحل الموجود به مقر الشركات المدمجة والمستوعبة . ويكون محل نشر في إحدى الصحف المعتمدة لتلقي الإعلانات القانونية. الفقرة الثانية أحكام خاصة بالشركات المساهمة"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_748_19750926_OpEnact_c58a3c07b5> ;
    dzdoc:replacementText "يوضع مشروع العقد بأحد مكاتب التوثيق للمحل الموجود به مقر الشركات المدمجة والمستوعبة . ويكون محل نشر في إحدى الصحف المعتمدة لتلقي الإعلانات القانونية. الفقرة الثانية أحكام خاصة بالشركات المساهمة"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_748> ;
