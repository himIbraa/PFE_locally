    dzdoc:replacementText "يتعين على المساهم أن يسدد المبالغ المرتبطة بالأسهم التي قام باكتتابها حسب الكيفيات المنصوص عليها في القانون والقانون الأساسي للشركة . وفي غياب ذلك ، تتابع الشركة بعد شهر من طلب الدفع الموجه إلى المساهم المتخلف ببيع هذه الأسهم. وتحدد كيفيات تطبيق هذا المقطع عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_47> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_47> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_48> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد المساهم المتخلف والمحال لهم المتتابعون والمكتتبون، ملزمين بالتضامن بمبلغ السهم غير المسدد ويمكن الشخص الذي سدد ما للشركة من دين، المطالبة بالكل ضد أصحاب السهم المتتابعين، ويبقى العبء النهائي للدين على عاتق الأخير منهم. كل مكتتب أو مساهم أحال سنده، لا يبقى ملزما عن سداد الأقساط التي لا زالت لم تطلب، بعد سنتين من إثبات التنازل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_48_19750926_OpEnact_fe5b1ae96d> ;
    dzdoc:replacementText "يعد المساهم المتخلف والمحال لهم المتتابعون والمكتتبون، ملزمين بالتضامن بمبلغ السهم غير المسدد ويمكن الشخص الذي سدد ما للشركة من دين، المطالبة بالكل ضد أصحاب السهم المتتابعين، ويبقى العبء النهائي للدين على عاتق الأخير منهم. كل مكتتب أو مساهم أحال سنده، لا يبقى ملزما عن سداد الأقساط التي لا زالت لم تطلب، بعد سنتين من إثبات التنازل ."@ar ;
