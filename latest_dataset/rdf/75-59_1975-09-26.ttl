<https://legal.dz/resource/order/1975-09-26/75-59#art_406_condition_0_73180a8e> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_406_condition_0_73180a8e_action_0a5584a98b> ;
    dznorm:conditionText "إذا عين الساحب في السفتجة مكانا للدفع غير المكان الذي به موطن المسحوب عليه، بدون أن يعين شخصا آخر يجب الدفع لديه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_406> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_406_condition_0_73180a8e_action_0a5584a98b> a dznorm:Action ;
    rdfs:label "الدفع لديه"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "إذا عين الساحب في السفتجة مكانا للدفع غير المكان الذي به موطن المسحوب عليه، بدون أن يعين شخصا آخر يجب الدفع لديه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_406> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_406_condition_1_12d1f7b6> a dznorm:Condition ;
    dznorm:conditionText "وإذا كانت السفتجة واجبة الأداء في موطن المسحوب عليه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_406> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_406_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_406> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا عين الساحب في السفتجة مكانا للدفع غير المكان الذي به موطن المسحوب عليه، بدون أن يعين شخصا آخر يجب الدفع لديه، يمكن للمسحوب عليه تعيينه عند القبول وإذا قبل بدون أن يعينه يعد بأنه التزم بنفسه في مكان الأداء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_406_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_406> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا كانت السفتجة واجبة الأداء في موطن المسحوب عليه جاز لهذا الأخير أن يعين في صيغة القبول عنوانا بنفس المكان الذي يجب الدفع فيه."@ar .

