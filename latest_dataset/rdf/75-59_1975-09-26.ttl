    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_142_obligation_0_b13ad0cd_ref_3de05c0a480d>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_142_obligation_0_b13ad0cd_ref_4b8d7e7a150d> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_98>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_99> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_98>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_99> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_142> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعطى لكل الأوراق المشار إليها في المادتين 98 و 99 أعلاه وكذلك كل الأوراق الأخرى المقدمة إلى المركز الوطني للسجل التجاري بالنظر في الأحكام التجارية، رقم إيداع عند تقديمها"@ar ;
    dznorm:sourceArticle "art_142" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_142_obligation_0_b13ad0cd_ref_3de05c0a480d> a dzdoc:Reference ;
    rdfs:label "99"@ar ;
