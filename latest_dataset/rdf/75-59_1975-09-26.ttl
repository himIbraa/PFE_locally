    dzdoc:evidenceText "يعاقب بالسجن من سنة إلى خمس سنوات وبغرامة من 20.000 دج إلى 500.000 دج أو بإحدى هاتين العقوبتين فقط ، رئيس الشركة و القائمون بإدارتها و مديروها العامون أو كل شخص في خدمة الشركة يتعمد وضع عائق لمراجعة الحسابات أو مراقبات مندوبي الحسابات أو يمتنع عن تقديم كل الوثائق اللازمة للإطلاع عليها في عين المكان أثناء ممارسة مهامهم خاصة فيما يتعلق بالاتفاقات والدفاتر المستندية وسجلات المحاضر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_831_19750926_OpEnact_c7237d2241> ;
    dzdoc:replacementText "يعاقب بالسجن من سنة إلى خمس سنوات وبغرامة من 20.000 دج إلى 500.000 دج أو بإحدى هاتين العقوبتين فقط ، رئيس الشركة و القائمون بإدارتها و مديروها العامون أو كل شخص في خدمة الشركة يتعمد وضع عائق لمراجعة الحسابات أو مراقبات مندوبي الحسابات أو يمتنع عن تقديم كل الوثائق اللازمة للإطلاع عليها في عين المكان أثناء ممارسة مهامهم خاصة فيما يتعلق بالاتفاقات والدفاتر المستندية وسجلات المحاضر ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
