<https://legal.dz/resource/order/1975-09-26/75-59#art_343_obligation_1_b64e9179> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_343_obligation_1_b64e9179_ref_ce1336d16af2> ;
