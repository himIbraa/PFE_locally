    dzdoc:sourceTextSpan "للدائنين الذين كان حقهم سابقا لتاريخ إيداع محضر المداولات بكتابة ضبط المحكمة، أن يرفعوا معارضة في هذا التخفيض في أجل شهر اعتبارا من يوم هذا الإيداع"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_575> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_576_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_576> ;
    dzdoc:position 0 ;
    dzdoc:text "يدير الشركة ذات المسؤولية المحدودة شخص أو عدة أشخاص طبيعيين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_576_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_576> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجوز اختيارهم خارجا عن الشركاء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_576_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_576> ;
    dzdoc:position 2 ;
    dzdoc:text "ويعينهم الشركاء في القانون الأساسي أو بعقد لاحق حسب الشروط المنصوص عليها في الفقرة الأولى من المادة 582."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_577_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_577> ;
    dzdoc:position 0 ;
    dzdoc:text "يحدد القانون الأساسي سلطات المديرين في العلاقات بين الشركاء وعند سكوت القانون الأساسي تحددها المادة 554 أعلاه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_577_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_577> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي العلاقات مع الغير، للمدير أوسع السلطات للتصرف في جميع الظروف باسم الشركة من دون إخلال بالسلطات التي يمنحها القانون صراحة للشركاء. فإن الشركة نفسها ملزمة بتصرفات المدير التي لم تدخل في نطاق موضوع الشركة ما لم تثبت أن الغير كان عالما أن التصرف يتجاوز ذلك الموضوع أو أنه لم يخف عليه ذلك نظرا للظروف، وذلك بقطع النظر على أن نشر القانون الأساسي كاف وحده لتكوين ذلك الإثبات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_577_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_577> ;
    dzdoc:position 2 ;
    dzdoc:text "لا احتجاج تجاه الغير بالشروط التي يتضمنها القانون الأساسي والمحددة لسلطات المديرين الناتجة عن هذه المادة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_577_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_577> ;
    dzdoc:position 3 ;
    dzdoc:text "عند تعدد المديرين يتمتع كل واحد منفردا بالسلطات المنصوص عليها في هذه المادة. ولا أثر لمعارضة أحد المديرين لتصرفات مدير آخر تجاه الغير ما لم يقم الدليل على أنهم كانوا على علم بها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_578_condition_0_9214e8ef> a dznorm:Condition ;
    dznorm:conditionText "إذا أسفر تفليس شركة عن عجز فيما لها من الأموال"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_578> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_578_obligation_0_7710cb6f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasActivity <https://legal.dz/resource/order/1975-09-26/75-59#art_578_obligation_0_7710cb6f_activity_8f9f5f0d90> ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_578_obligation_0_7710cb6f_role_35d11ada71>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_578_obligation_0_7710cb6f_role_99598906e1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_578_obligation_0_7710cb6f_role_b60b34c9d8> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_578> ;
    dznorm:position 0 ;
    dznorm:provisionText "وعلى المديرين أو الشركاء المورطين كي يتخلصوا من المسؤولية الملقاة على عاتقهم أن يقيموا الدليل على أنهم بذلوا في إدارة شؤون الشركة ما يبذله الوكيل المأجور من النشاط والحرص"@ar ;
    dznorm:sourceArticle "art_578" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_578_obligation_0_7710cb6f_activity_8f9f5f0d90> a dznorm:Activity ;
