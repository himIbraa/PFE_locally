<https://legal.dz/resource/order/1975-09-26/75-59#art_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_2> ;
    dzdoc:eId "art_52" ;
    dzdoc:fullText "فيما عدا حالة الاشتراط الكتابي المدرج بسند النقل والمطابق للقوانين والأنظمة الجاري بها العمل والمبلغ لعلم المرسل، يجوز للناقل ، عدا حالة الخطأ العمدي أو الجسيم المرتكب منه أو من مستخدمه : 1 - تحديد مسؤوليته بسبب الضياع أو التلف بشرط ألا يكون التعويض المقرر أقل بكثير من قيمة الشيء نفسه بحيث يصبح في الحقيقة وهميا ، 2 - إعفاؤه كليا أو جزئيا من مسؤولية التأخير. 3 - يكون باطلا كل اشتراط من شأنه أن يعفي الناقل كليا من مسؤوليته عن الفقدان الكلي أو الجزئي أو التلف."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_52_permission_0_f56909bc> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_52_right_0_171d2b15> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_52_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_52_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_52_19750926_OpEnact_6fe5c45a0b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 52" ;
    dzdoc:position 54 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_52_condition_0_8774e9e8> ;
    dzdoc:usesTerm dzterm:carrier .

<https://legal.dz/resource/order/1975-09-26/75-59#art_541> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_9> ;
    dzdoc:eId "art_541" ;
    dzdoc:fullText "يمكن في جميع الأحوال المشار إليها في المادتين 374 و 375 من قانون العقوبات الحكم بـ التجريد الكلي أو الجزئي من الحقوق المبينة في المادة الثامنة من قانون العقوبات وفي حالة العود يجب الحكم بذلك لمدة لا تتجاوز عشر سنين . وزيادة على ذلك يمكن في جميع الأحوال على من ثبتت إدانتهم الحكم بعقوبة حظر الإقامة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_541_permission_0_abe1c872>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_541_permission_1_2b02f679> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_541> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_541_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_541_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_541_19750926_OpEnact_80ae2a3b21> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_541_obligation_0_9852609f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 541" ;
    dzdoc:position 563 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_541_extref_1e6b0e90>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_541_extref_1fa030ab>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_541_extref_f75c36b3> ;
    dzdoc:usesTerm dzterm:disenfranchisement,
        dzterm:residency_ban .

<https://legal.dz/resource/order/1975-09-26/75-59#art_545> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_sec_التمهيدي> ;
    dzdoc:eId "art_545" ;
    dzdoc:fullText "تثبت الشركة بعقد رسمي وإلا كانت باطلة . لا يقبل أي دليل إثبات بين شركاء فيما يتجاوز أو يخالف ضد مضمون عقد الشركة. يجوز أن يقبل من الغير إثبات وجود الشركة بجميع الوسائل عند الاقتضاء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_545_permission_0_22daaf37> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_545_right_0_b5864eb9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_545> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_545_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_545_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_545_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_545_19750926_OpEnact_681f796a06> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_545_obligation_0_d4c18577> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "545" ;
    dzdoc:position 592 ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1_bis> ;
    dzdoc:eId "art_563_bis_1" ;
    dzdoc:fullText "يسري على الشركاء المتضامنين ، القانون الأساسي للشركاء بالتضامن. يلتزم الشركاء الموصون بديون الشركة فقط في حدود قيمة حصصهم التي لا يمكن أن تكون على شكل تقديم عمل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_1_permission_0_5ded31bd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_1_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_1_19750926_OpEnact_5c49b586a7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_1_obligation_0_77f908ba> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "563 مكرر 1" ;
    dzdoc:position 612 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_1_condition_0_293dd94b> ;
    dzdoc:usesTerm dzterm:active_partners,
        dzterm:silent_partners .

<https://legal.dz/resource/order/1975-09-26/75-59#art_596> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_596" ;
    dzdoc:fullText "يجب أن يكتتب رأس المال بكامله، وتكون الأسهم النقدية مدفوعة عند الاكتتاب بنسبة الربع (4/1) على الأقل من قيمتها الاسمية ، ويتم وفاء الزيادة مرة واحدة أو عدة مرات بناء على قرار من مجلس الإدارة أو مجلس المديرين حسب كل حالة في أجل لا يمكن أن يتجاوز خمس (5) سنوات ابتداء من تاريخ تسجيل الشركة في السجل التجاري. لا يمكن مخالفة هذه القاعدة إلا بنص تشريعي صريح. وتكون الأسهم العينية مسددة القيمة بكاملها حين إصدارها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_596_permission_0_f0d5c83b>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_596_permission_1_7b288ef2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_596> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_596_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_596_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_596_19750926_OpEnact_e3ff6b957b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_596_obligation_0_5ff649e2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "596" ;
    dzdoc:position 655 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_2> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "يجوز للموكل أن يرفع مباشرة على الناقل كل دعوى متولدة عن عقد النقل ، و يكون الوكيل بالعمولة مكلفا قانونا بالحضور فيها . ويجوز للناقل أن يرفع مباشرة على الموكل دعوى بطلب التعويض عن الأضرار الحاصلة له من جراء تنفيذ عقد النقل ، و يكون الوكيل بالعمولة مكلفا قانونا بالحضور فيها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_60_permission_0_479df5ae> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_60_right_0_dd1d500e>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_60_right_1_195691a3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_60_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_60_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_60_19750926_OpEnact_c73c312021> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_60_obligation_0_bda27b97>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_60_obligation_1_bda27b97> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 60" ;
    dzdoc:position 62 ;
    dzdoc:usesTerm dzterm:carrier,
        dzterm:commission_agent,
        dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-59#art_612> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_612" ;
    dzdoc:fullText "لا يمكن شخصا طبيعيا الانتماء في نفس الوقت إلى أكثر من خمسة (05) مجالس إدارة لشركات مساهمة يوجد مقرها بالجزائر . ويجوز تعيين شخص معنوي قائما بالإدارة في عدة شركات، وفي هذه الحالة لا تطبق أحكام المقطع الأول على الممثلين الدائمين للأشخاص المعنويين. و يجب عليه عند تعيينه اختيار ممثل دائم يخضع لنفس الشروط والواجبات ويتحمل نفس المسؤوليات المدنية والجزائية كما لو كان قائما بالإدارة باسمه الخاص ، دون المساس بالمسؤولية التضامنية للشخص المعنوي الذي يمثله. وعندما يقوم الشخص المعنوي بعزل ممثله ، يجب عليه العمل في نفس الوقت على استبداله ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_612_permission_0_bfdcde7f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_612> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_612_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_612_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_612_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_612_19750926_OpEnact_13526eb080> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_612_obligation_0_a5074e15>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_612_obligation_1_b69cb167>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_612_obligation_2_bfa428fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "612" ;
    dzdoc:position 671 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_612_condition_0_7535925d> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_620> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_620" ;
    dzdoc:fullText "يجوز للقائم بالإدارة السابق أو لذوي حقوقه استرجاع حرية التصرف في أسهم الضمان ، بمجرد مصادقة الجمعية العامة العادية على حسابات السنة المالية الأخيرة والمتعلقة بإدارته ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_620_permission_0_c29ab781> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_620_right_0_698cb5d1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_620> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_620_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_620_19750926_OpEnact_175a9409df> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "620" ;
    dzdoc:position 679 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_620_condition_0_56c4417d> ;
    dzdoc:usesTerm dzterm:director .

<https://legal.dz/resource/order/1975-09-26/75-59#art_662> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_662" ;
    dzdoc:fullText "تنتخب الجمعية العامة التأسيسية أو الجمعية العامة العادية، أعضاء مجلس المراقبة . ويمكن إعادة انتخابهم ما لم ينص القانون الأساسي على خلاف ذلك . وتحدد فترة وظائفهم بموجب القانون الأساسي دون تجاوز ست (6) سنوات في حالة التعيين من الجمعية العامة، ودون تجاوز ثلاث (3) سنوات في حالة التعيين بموجب القانون الأساسي . غير أنه يمكن في حالة الدمج أو الانفصال أن يتم التعيين من الجمعية العامة غير العادية. ويمكن أن تعزلهم الجمعية العامة العادية في أي وقت ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_662_permission_0_8349b7e5> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_662_right_0_365a5632>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_662_right_1_c9dac5f7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_662> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_662_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_662_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_662_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_662_para_3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_662_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_662_19750926_OpEnact_612141b340> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 662" ;
    dzdoc:position 721 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_662_condition_0_1953c705> ;
    dzdoc:usesTerm dzterm:board_of_auditors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_705> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_705" ;
    dzdoc:fullText "تكون الأسهم المكتتب فيها نقدا واجبة الوفاء إجباريا عند الاكتتاب بنسبة الربع (4/1) على الأقل من قيمتها الاسمية وعند الاقتضاء بكامل علاوة الإصدار. وإذا لم تتحقق زيادة رأس المال في أجل ستة أشهر ابتداء من افتتاح الاكتتاب ، تكون العملية باطلة. يجب أن يتم وفاء الفائض مرة أو أكثر في أجل خمس سنوات ابتداء من اليوم الذي تصبح فيه زيادة رأس المال نهائية. ويجوز أن يتم سحب الأموال الحاصلة من الاكتتاب النقدي بواسطة وكيل الشركة بعد إعداد شهادة المودع."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_705_right_0_5acb07f9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_705> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_705_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_705_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_705_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_705_para_3> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_705_19750926_OpEnact_9cb1b188ec> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_705_obligation_0_f640b2c1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_705_obligation_1_fcfa1a29> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "705" ;
    dzdoc:position 763 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_705_condition_0_c12c8d7c> ;
    dzdoc:usesTerm dzterm:shares .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_7> ;
    dzdoc:eId "art_715_bis_6" ;
    dzdoc:fullText "لا يجوز أن يعين مندوبا للحسابات في شركة المساهمة : الأقرباء والأصهار لغاية الدرجة الرابعة، بما في ذلك القائمين بالإدارة وأعضاء مجلس المديرين ومجلس مراقبة الشركة. القائمون بالإدارة وأعضاء مجلس المديرين أو مجلس المراقبة وأزواج القائمين بالإدارة وأعضاء مجلس المديرين أو مجلس المراقبة للشركات التي تملك عشر (10/1) رأس مال الشركة أو إذا كانت هذه الشركة نفسها تملك عشر (10/1) رأسمال هذه الشركات. أزواج الأشخاص الذين يتحصلون بحكم نشاط دائم غير نشاط مندوب الحسابات على أجرة أو مرتبا، إما من القائمين بالإدارة أو أعضاء مجلس المديرين أو من مجلس المراقبة. الأشخاص الذين منحتهم الشركة أجرة بحكم وظائف غير وظائف مندوب الحسابات في أجل خمس سنوات ابتداء من تاريخ إنهاء وظائفهم. الأشخاص الذين كانوا قائمين بالإدارة أو أعضاء في مجلس المراقبة أو مجلس المديرين، في أجل خمس سنوات ابتداء من تاريخ إنهاء وظائفهم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_6_permission_0_2e1112f7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_6_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_6_19750926_OpEnact_ae1d47c3e6> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_6_prohibition_0_2e1112f7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 6" ;
    dzdoc:position 780 ;
    dzdoc:usesTerm dzterm:auditor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_725> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_725" ;
    dzdoc:fullText "يحظر اشتراط فائدة ثانية أو إضافية لصالح الشركاء . ويعتبر كل شرط مخالف لذلك كأن لم يكن. ولا تطبق أحكام الفقرة المتقدمة، متى منحت الدولة للأسهم ضمان ربح أدنى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_725> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_725_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_725_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_725_19750926_OpEnact_d2aaecad5d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_725_obligation_0_0d17ad4d> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_725_prohibition_0_0851a7af> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "725" ;
    dzdoc:position 927 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_73> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_3> ;
    dzdoc:eId "art_73" ;
    dzdoc:fullText "يجوز للمسافر أن يرفع مباشرة على الناقل دعوى التعويض عن الضرر الحاصل له بسبب عدم تنفيذ عقد النقل أو الإخلال بتنفيذه أو التأخير فيه ، ويكون الوكيل بالعمولة مكلفا قانونا بالحضور فيها. ويجوز للناقل أن يرفع مباشرة على المسافر دعوى التعويض عن الضرر الحاصل له بسبب تنفيذ عقد النقل ، ويكون الوكيل بالعمولة مكلفا قانونا بالحضور فيها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_73_permission_0_699686ec> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_73_right_0_660812ea>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_73_right_1_79161400> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_73> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_73_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_73_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_73_19750926_OpEnact_4305dcfb37> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 73" ;
    dzdoc:position 75 ;
    dzdoc:usesTerm dzterm:carrier,
        dzterm:commission_agent .

<https://legal.dz/resource/order/1975-09-26/75-59#art_773> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_773" ;
    dzdoc:fullText "يدعى الشركاء في نهاية التصفية للنظر في الحساب الختامي، وفي إبراء إدارة المصفي وإعفائه من الوكالة والتحقق من اختتام التصفية . فإذا لم يدع الشركاء فإنه يجوز لكل شريك أن يطلب قضائيا تعيين وكيل يكلف بالقيام بإجراءات الدعوة بموجب أمر مستعجل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_773_permission_0_c181dfc1> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_773_right_0_ddc33830> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_773> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_773_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_773_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_773_19750926_OpEnact_be5491bee7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_773_obligation_0_8443d5e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "773" ;
    dzdoc:position 980 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_773_condition_0_601165a2> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_2> ;
    dzdoc:eId "art_9" ;
    dzdoc:fullText "كل شخص طبيعي أو معنوي له صفة التاجر ملزم بمسك دفتر لليومية يقيد فيه يوما بيوم عمليات المقاولة أو أن يراجع على الأقل نتائج هذه العمليات شهريا بشرط أن يحتفظ في هذه الحالة بكافة الوثائق التي يمكن معها مراجعة تلك العمليات يوميا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_9_permission_0_e6344e8e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_9_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_9_19750926_OpEnact_f09acc53be> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_9_obligation_0_78915660> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "9" ;
    dzdoc:position 9 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_9_condition_0_15522fcb> ;
    dzdoc:usesTerm dzterm:journal_book,
        dzterm:person,
        dzterm:trader .

