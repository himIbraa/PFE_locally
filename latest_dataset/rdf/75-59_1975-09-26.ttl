<https://legal.dz/resource/order/1975-09-26/75-59#version_art_276> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان موضوع التحكيم أو المصالحة غير محدد القيمة أو تجاوز قيمته اختصاص المحكمة في الدرجة الأخيرة لا يعتبر شرط التحكيم أو المصالحة إلزاميا إلا بعد التصديق عليه من المحكمة. ويكون لكل دائن الحق في التدخل عند طلب التصديق ."@ar ;
