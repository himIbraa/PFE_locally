<https://legal.dz/resource/order/1975-09-26/75-59#version_art_255> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "متى صدر الحكم بالتسوية القضائية أو شهر الإفلاس يتعين على وكيل التفليسة أن يقوم بكافة الإجراءات اللازمة لحفظ حقوق المدين ضد مدينيه . ويلتزم بنوع خاص بطلب القيود عن الرهون العقارية التي لم يكن المدين طلبها حتى ولو أخذ القيد باسم جماعة الدائنين من طرف وكيل التفليسة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_255_19750926_OpEnact_4c7f53f2e1> ;
