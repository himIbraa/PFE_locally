    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_490_19750926_OpEnact_06043a5d23> ;
    dzdoc:replacementText "إن المظهر ضامن للوفاء ما لم يشترط خلاف ذلك . ويمكنه أن يمنع تظهيره من جديد وحينئذ لا يكون ملزما بالضمان لمن يظهر لهم الشيك فيما بعد."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_490> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
