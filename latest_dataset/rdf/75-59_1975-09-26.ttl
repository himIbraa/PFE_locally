<https://legal.dz/resource/order/1975-09-26/75-59#version_art_337> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقضي المحكمة في أي وقت أثناء قيام التسوية القضائية بشهر الإفلاس ، وذلك : إذا حكم على المدين بالإفلاس بالتدليس ، إذا أبطل الصلح ، إذا ثبت أن المدين يوجد في إحدى الحالات المنصوص عليها في الفقرة الثانية من المادة 226 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_337_19750926_OpEnact_efbf4b1fc2> ;
    dzdoc:replacementText "تقضي المحكمة في أي وقت أثناء قيام التسوية القضائية بشهر الإفلاس ، وذلك : إذا حكم على المدين بالإفلاس بالتدليس ، إذا أبطل الصلح ، إذا ثبت أن المدين يوجد في إحدى الحالات المنصوص عليها في الفقرة الثانية من المادة 226 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
