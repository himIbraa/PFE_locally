<https://legal.dz/resource/order/1975-09-26/75-59#art_17_condition_0_762dfafd> a dznorm:Condition ;
    dznorm:conditionText "إذا كانت هذه الدفاتر موجودة في أماكن بعيدة عن المحكمة المختصة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_17> ;
