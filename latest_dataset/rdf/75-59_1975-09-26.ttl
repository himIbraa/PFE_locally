<https://legal.dz/resource/order/1975-09-26/75-59#version_art_66> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للناقل ، استنادا لاشتراط كتابي مدرج في سند النقل ومطابق للقوانين والأنظمة الجاري بها العمل ومبلغ للمسافر ، و فيما عدا حالة الخطأ العمدي أو الجسيم المرتكب منه بنفسه أو من مستخدمه إعفاءه كليا أو جزئيا من مسؤوليته عن التأخير أو الأضرار غير البدنية الحاصلة للمسافر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
