<https://legal.dz/resource/order/1975-09-26/75-59#art_433> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_8> ;
    dzdoc:eId "art_433" ;
    dzdoc:fullText "يمكن للحامل أن يطالب كل من أقام عليه دعوى الرجوع : 1 - بمبلغ السفتجة التي لم يحصل قبولها أو وفاؤها، 2 - وبمصاريف الاحتجاج والإخطارات الموجهة وغيرها من النفقات. وإذا أقيمت دعوى الرجوع قبل الاستحقاق فإنه يطرح من مبلغ السفتجة مقدار الخصم ويحسب على سعر الخصم الرسمي للمصرف المركزي الجزائري الجاري به التعامل في تاريخ رفع الدعوى في مكان موطن الحامل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_433_permission_0_0f7c1ea9> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_433_right_0_8f8e7e5a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_433> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_433_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_433_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_433_19750926_OpEnact_ac932e0ffd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 433" ;
    dzdoc:position 438 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_433_condition_0_5c3d9a11> ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:holder .

<https://legal.dz/resource/order/1975-09-26/75-59#art_450> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_9> ;
    dzdoc:eId "art_450" ;
    dzdoc:fullText "يمكن حصول الوفاء بطريق التدخل في جميع الأحوال التي يجوز فيها للحامل القيام بدعوى الرجوع سواء كان في الاستحقاق أو قبله . ويجب أن يشتمل الوفاء جميع المبلغ الواجب دفعه على الشخص الذي يقع الوفاء لمصلحته . كما يجب أن يتم هذا الوفاء على الأكثر في اليوم التالي لآخر يوم يجوز فيه الاحتجاج لعدم الوفاء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_450_permission_0_cb4abd8e>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_450_permission_1_21b9c551> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_450_right_0_1b4f80f4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_450> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_450_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_450_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_450_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_450_19750926_OpEnact_742873e9a3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_450_obligation_0_25839757>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_450_obligation_1_48d18c08> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "450" ;
    dzdoc:position 455 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_1> ;
    dzdoc:eId "art_5" ;
    dzdoc:fullText "لا يجوز للقاصر المرشد، ذكرا أم أنثى البالغ من العمر ثمانية عشر سنة كاملة والذي يريد مزاولة التجارة أن يبدأ في العمليات التجارية، كما لا يمكن اعتباره راشدا بالنسبة للتعهدات التي يبرمها عن أعمال تجارية : إذا لم يكن قد حصل مسبقا على إذن والده أو أمه أو على قرار من مجلس العائلة مصدق عليه من المحكمة، فيما إذا كان والده متوفيا أو غائبا أو سقطت عنه سلطته الأبوية أو استحال عليه مباشرتها أو في حالة انعدام الأب والأم . ويجب أن يقدم هذا الإذن الكتابي دعما لطلب التسجيل في السجل التجاري ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_5_permission_0_672ed759> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_5_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_5_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_5_19750926_OpEnact_24c8a35aa5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_5_obligation_0_94f079dd> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_5_prohibition_0_672ed759> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "5" ;
    dzdoc:position 5 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_5_condition_0_6caabe2d> ;
    dzdoc:usesTerm dzterm:commercial_register .

<https://legal.dz/resource/order/1975-09-26/75-59#art_566> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_566" ;
    dzdoc:fullText "لا يجوز أن يكون رأسمال الشركة ذات المسؤولية المحدودة أقل من 100.000دج وينقسم الرأسمال إلى حصص ذات قيمة اسمية متساوية مبلغها 1000 دج على الأقل. ويجب أن يكون تحويله إلى مبلغ أقل متبوع بزيادة في أجل سنة بقصد إعادته إلى المبلغ المنصوص عليه في الفقرة المتقدمة ، ما لم تحول الشركة في نفس الأجل إلى شركة ذات شكل آخر . وعند عدم ذلك يجوز لكل من يهمه الأمر أن يطلب من القضاء فسخ الشركة بعد إنذار ممثليها بتسوية الحالة . وتنقضي الدعوى إذا كان سبب البطلان منعدما في اليوم الذي تتولى فيه المحكمة النظر في أصل الدعوى ابتدائيا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_566_permission_0_e35a252b>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_566_permission_1_eaf3ff36> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_566_right_0_1978666c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_566> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_566_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_566_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_566_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_566_19750926_OpEnact_5f84c2b1b2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_566_obligation_0_dceba1dc>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_566_obligation_1_06f3dda3> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_566_prohibition_0_e35a252b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "566" ;
    dzdoc:position 624 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_566_condition_0_63cff355>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_566_condition_1_3bd1a610> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_570> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_570" ;
    dzdoc:fullText "للحصص قابلية الانتقال عن طريق الإرث كما أنه يمكن إحالتها بكل حرية بين الأزواج والأصول والفروع . غیر أنه يمكن أن يشترط في القانون الأساسي أنه لا يجوز أن يصبح الزوج أو أحد الورثة أو الأصل أو الفرع، شريكا إلا بعد قبوله ضمن الشروط المنصوص عنها . إن الآجال الممنوحة للشركة للفصل في القبول، لا يجوز أن تكون أكثر من التي نصت عليها المادة 571 و الأغلبية المشترطة لا تكون أقوى من الأغلبية المطلوبة في المادة المذكورة ، وذلك تحت طائلة بطلان الشرط المذكور، ويجرى عند رفض القبول تطبيق أحكام الفقرتين 3 و4 من المادة 571 ، ويعتبر القبول مكتسبا إذا لم يحصل حل من الحلول المنصوص عليها في هاتين الفقرتين في الآجال المقررة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_570_permission_0_c4df8a85>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_570_permission_1_ed06c3c3> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_570_right_0_77a3977c>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_570_right_1_536ea14f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_570> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_570_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_570_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_570_19750926_OpEnact_1ba3991e6f> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_570_prohibition_0_ed06c3c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "570" ;
    dzdoc:position 628 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_571> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_571> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_570_condition_0_11980ee9>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_570_condition_1_961beb55>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_570_condition_2_011d0bc8>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_570_condition_3_a8fc1f89> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_738> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_738" ;
    dzdoc:fullText "في حالة بطلان شركة أو أعمال أو مداولات لاحقة لتأسيسها مبني على عيب في الرضاء أو فقد أهلية شريك، وإذا كان التصحيح ممكنا ، يجوز لكل شخص يهمه الأمر أن ينذر الشخص الجدير بهذا الإجراء، إما بالقيام بالتصحيح أو برفع دعوى البطلان في أجل ستة أشهر تحت طائلة انقضاء الميعاد ويتعين إبلاغ الشركة بهذا الإنذار. يجوز للشركة أو أحد الشركاء أن يعرض على المحكمة التي تتولى الحكم في الأجل المنصوص عليه في المادة المتقدمة ، كل إجراء من شأنه أن يزيل مصلحة المدعي خصوصا بشراء حقوقه في الشركة . وفي هذه الحالة يسوغ للمحكمة إما أن تقضي بالبطلان أو بموجب الإجراءات المعروضة، إذا وافقت عليها الشركة مسبقا ضمن الشروط المقررة لتعديلات القانون الأساسي . ولا تأثير لتصويت الشريك المطلوب شراء حقوقه من جديد على قرار الشركة. وعند التنازع تقدر قيمة الحقوق في الشركة الواجب دفعها للشريك بمقتضى الفقرة الثالثة من المادة 578 من هذا القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_738_permission_0_5c24f664>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_738_permission_1_b083b0ce> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_738_right_0_d7b1e3df>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_738_right_1_cb34e44a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_738> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_738_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_738_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_738_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_738_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_738_19750926_OpEnact_a9b3fae5b7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "738" ;
    dzdoc:position 945 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_578>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_737> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_578>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_737> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_738_condition_0_d2936f3a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_738_condition_1_d3215afa> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "كل بيع اختياري أو وعد بالبيع وبصفة أعم كل تنازل عن محل تجاري ولو كان معلقا على شرط أو صادرا بموجب عقد من نوع آخر أو كان يقضي بانتقال المحل التجاري بالقسمة أو المزايدة أو بطريق المساهمة به في رأس مال شركة يجب إثباته بعقد رسمي وإلا كان باطلا . ويجب أن يتضمن العقد المثبت للتنازل ما يلي : 1 - اسم البائع السابق وتاريخ سنده الخاص بالشراء ونوعه وقيمة الشراء بالنسبة للعناصر المعنوية والبضائع والمعدات، 2 - قائمة الامتيازات والرهون المترتبة على المحل التجاري، 3 - رقم الأعمال التي حققها في كل سنة من سنوات الاستغلال الثلاث الأخيرة أو من تاريخ شرائه إذا لم يقم بالاستغلال مند أكثر من ثلاث سنوات، 4 - الأرباح التي حصل عليها في نفس المدة، 5 - وعند الاقتضاء الإيجار وتاريخه ومدته واسم وعنوان المؤجر والمحيل. ويمكن أن يترتب على إهمال ذكر البيانات المقررة آنفا بطلان عقد البيع بطلب من المشتري إذا كان طلبه واقعا خلال السنة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_79_right_0_474b8791> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_79_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_79_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_79_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_79_19750926_OpEnact_9d17d55c06> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_79_obligation_0_e5d4710d>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_79_obligation_1_c7daaa01> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "79" ;
    dzdoc:position 81 ;
    dzdoc:usesTerm dzterm:promise_to_sell,
        dzterm:sale,
        dzterm:transfer .

<https://legal.dz/resource/order/1975-09-26/75-59#art_97> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_97" ;
    dzdoc:fullText "يجب قيد البيع في ظرف ثلاثين يوما من تاريخ عقده وإلا كان باطلا وتبقى المهلة سارية ولو في حالة صدور الحكم بإعلان الإفلاس. ولكل ذي مصلحة أن يتمسك بهذا البطلان وإن كان المدين نفسه. وإذا تم القيد بالطريقة المشار إليها فتكون للمشتري الأولوية ويمكن الاحتجاج به على التفليسة والتصفية القضائية للمشتري ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_97_right_0_2b361c76>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_97_right_1_cfe6ba08> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_97> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_97_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_97_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_97_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_97_19750926_OpEnact_fb0ea8254d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_97_obligation_0_6d89e69d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "97" ;
    dzdoc:position 99 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_97_condition_0_26e6e83c> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_154> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_8> ;
    dzdoc:eId "art_154" ;
    dzdoc:fullText "يجوز طبقا لهذا النص وبطلب من المستفيد من الرهن الحيازي أن يوضع على قطعة أساسية من الأموال وبصفة بارزة فوق لوحة مثبتة فيها وتتضمن مكان وتاريخ ورقم قيد الامتياز المثقلة به . و لا يجوز للمدين أن يقوم بالمعارضة في هذا التدبير وإلا تعرض للعقوبات المنصوص عليها في المادة 167 و لا يجوز أن تكون العلامات الموضوعة على هذا النحو معرضة للهلاك أو الانتزاع أو إخفاء المعالم قبل انقضاء امتياز الدائن المرتهن أو شطبه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_154_permission_0_7fb7e058>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_154_permission_1_6d601124> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_154_right_0_b3ceb25c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_154> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_154_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_154_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_154_19750926_OpEnact_e6f9a88197> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_154_obligation_0_ad71fc8a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_154_obligation_1_0cf8d644> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_154_prohibition_0_6d601124> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 154" ;
    dzdoc:position 156 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_167> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_167> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_194> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_2_sec_6> ;
    dzdoc:eId "art_194" ;
    dzdoc:fullText "في حالة عدم اتفاق الطرفين عند انتهاء مهلة ثلاثة أشهر من تاريخ التبليغ، ومهما كان مبلغ الإيجار ، ترفع كل النزاعات المتعلقة بتطبيق هذا الباب لدى الجهة القضائية المختصة والتي يكون موقع العمارة تابعا لها ، وذلك عن طريق تكليف بالحضور يقدم من الطرف الذي يهمه التعجيل. غير أنه إذا طالب المستأجر بتعويض الإخلاء ، جاز للطرف الذي يهمه التعجيل أن يتم دعواه أمام رئيس المحكمة الناظرة في القضايا المستعجلة ليأمر بإجراءات الخبرة اللازمة ، وذلك قبل انتهاء الأجل المنصوص عليه في الفقرة السابقة. يلحق تقرير الخبرة، الذي يجب إيداعه في ظرف شهرين بكتابة الضبط، بملف الدعوى المرفوعة أمام المحكمة المختصة التي تفصل في الموضوع بعد إيداع التقرير المذكور ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_194_right_0_360e36c5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_194> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_194_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_194_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_194_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_194_19750926_OpEnact_85ec28b6f3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_194_obligation_0_c50e2681>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_194_obligation_1_c8853d41> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 194" ;
    dzdoc:position 198 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_194_condition_0_98238bb5>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_194_condition_1_4e2796b9> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_258> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_3> ;
    dzdoc:eId "art_258" ;
    dzdoc:fullText "للمحكمة التي تحكم بشهر التسوية القضائية أو الإفلاس أن تأمر بوضع الأختام على الخزائن والحافظات والدفاتر والأوراق والمنقولات والأوراق التجارية والمخازن والمراكز التجارية التابعة للمدين و إذا كان الأمر يتعلق بشخص معنوي يحتوي على شركاء مسؤولين من غير تحديد يكون وضع الأختام على أموال كل منهم . في حالة ما إذا كانت الأموال المشار إليها في الفقرة السابقة واقعة خارج دائرة اختصاص المحكمة المختصة يوجه إعلان بذلك إلى قاضي المحكمة التي توجد أموال المفلس في دائرة اختصاصها . ومع ذلك في حال تواري المدين عن الأنظار أو اختلاس كافة أمواله أو بعضها ، جاز للقاضي قبل صدور الحكم المشار إليه في الفقرة الأولى أن يضع الأختام سواء تلقائيا أو بناء على طلب أحد الدائنين أو بعض منهم ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_258_right_0_70797e8c>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_258_right_1_996c6800> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_258> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_258_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_258_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_258_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_258_19750926_OpEnact_e3484aa52b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_258_obligation_0_175de339> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "258" ;
    dzdoc:position 263 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_258_condition_0_9b361d61>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_258_condition_1_712b92d6>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_258_condition_2_6e88b750> ;
    dzdoc:usesTerm dzterm:bankruptcy,
        dzterm:settlement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_396> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_396" ;
    dzdoc:fullText "كل سفتجة وإن لم يشترط فيها صراحة كلمة « لأمر» تكون قابلة للتداول بطريق التظهير . وإذا أدرج الساحب في نص السفتجة عبارة «ليست لأمر» أو عبارة مماثلة فلا يكون السند قابلا للتداول إلا على الشكل والآثار المرتبة على التنازل العادي. ويمكن أن يكون التظهير حاصلا لصالح المسحوب عليه سواء أكان قابلا للسند أم لا أو لصالح الساحب أو أي ملتزم آخر سواه، وهؤلاء الأشخاص يمكنهم أن يظهروا السفتجة من جديد. يجب أن يكون التظهير بدون قيد أو شرط . وكل شرط يعلق عليه التظهير يعد كأن لم يكن. ويعد التظهير الجزئي باطلا. والتظهير «للحامل» يعد بمثابة تظهير على بياض . يجب أن يكتب التظهير على السفتجة ذاتها أو على ورقة ملحقة بها أي (متصلة بها) ويجب أن يكون مشتملا على توقيع المظهر ويضع هذا الأخير إمضاءه بيده أو بأي طريقة أخرى غير المخطوط باليد . ويجوز ألا يعين في التظهير الشخص المستفيد منه أو أن تقتصر على توقيع المظهر فقط ( تظهير على بياض ) وفي هذه الحالة الأخيرة لا يكون التظهير صحيحا إلا إذا كان على ظهر السفتجة أو على الورقة المتصلة بها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_396> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_4>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_5>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_6>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_7>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_8> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_396_19750926_OpEnact_47d9baf8fa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_396_obligation_0_ae756391>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_396_obligation_1_21eebf2f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 396" ;
    dzdoc:position 401 ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:blank_endorsement,
        dzterm:drawee,
        dzterm:drawer,
        dzterm:endorsement,
        dzterm:endorser,
        dzterm:partial_endorsement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_508> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_4> ;
    dzdoc:eId "art_508" ;
    dzdoc:fullText "في حالة ضياع الشيك يجوز المالك أن يطالب بوفاء قيمته بموجب نسخته الثانية أو الثالثة أو الرابعة الخ... وإذا لم يتمكن من أضاع الشيك من إحضار نسخته الثانية أو الثالثة أو الرابعة الخ... ، جاز له بأن يطالب بوفاء قيمة الشيك الضائع والحصول على ذلك بمقتضى أمر من القاضي بعد أن يثبت ملكيته له بدفاتر وأن يقدم كفيلا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_508_permission_0_def9c7de> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_508_right_0_f2123838>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_508_right_1_ff15b716> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_508> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_508_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_508_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_508_19750926_OpEnact_8ce97bf0eb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 508" ;
    dzdoc:position 513 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_508_condition_0_4e416995>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_508_condition_1_4c60ac49>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_508_condition_2_96fc0ba3> ;
    dzdoc:usesTerm dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_537> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_9> ;
    dzdoc:eId "art_537" ;
    dzdoc:fullText "من أصدر شيكا ولم يبين فيه مكان إصداره أو تاريخه أو وضع به تاريخا مزورا أو من سحب شيكا على هيئة خلاف الهيئات المنصوص عليها في المادة 474 يعاقب بغرامة قدرها 10 في المائة من مبلغ الشيك ولا يجوز أن تكون هذه الغرامة أقل من مائة دينار. ويكون المظهر الأول أو حامل الشيك ملزما شخصيا بأداء الغرامة نفسها دون أن يكون له حق الرجوع على أحد إذا كان الشيك خاليا من بيان مكان الإصدار أو التاريخ أو كان يتضمن تاريخا لاحقا لتاريخ تظهيره أو تقديمه . كما يستوجب أيضا الغرامة المذكورة كل من دفع أو تسلم على وجه المقاصة شيكا لا يشتمل على مكان إصداره أو تاريخه. ويعاقب بالغرامة نفسها كل من أصدر شيكا ليس له مقابل وفاء سابق وقابل للتصرف فيه. وإذا كان مبلغ مقابل الوفاء أقل من قيمة الشيك فإن الغرامة لا يمكن أن تتجاوز الفرق بين مبلغ مقابل الوفاء وقيمة الشيك. على كل صيرفي إعداد صيغ للشيكات تسلم مجانا لأصحاب الحسابات الجاري فيها التعامل بالشيكات . على كل مصرف يسلم لدائنه صيغ شيكات بيضاء للدفع بموجبها من خزانته، أن يكتب على كل واحدة منها اسم الشخص الذي سلمت إليه وإلا يعاقب بغرامة قدرها مائة دينار عن كل مخالفة. كل مصرف يرفض وفاء شيك، لديه مقابل وفائه، ولم تحصل لديه أية معارضة فيه، ومسحوب سحبا صحيحا على خزانته يكون مسؤولا تجاه الساحب بتعويض الضرر الناشئ له عن عدم تنفيذ أمره وعما لحقه في سمعته."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_537_permission_0_739ec49f>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_537_permission_1_05efa42d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_537> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_537_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_537_para_1>,
