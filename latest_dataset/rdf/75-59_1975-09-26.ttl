<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_88> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون حاملو سندات الاستحقاق من نفس الإصدار جماعة، بقوة القانون، للدفاع عن مصالحهم المشتركة. وتتمتع هذه الجماعة بالشخصية المعنوية. يمكن الجمعية العامة لأصحاب سندات الاستحقاق أن تجتمع في كل وقت."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
