<https://legal.dz/resource/order/1975-09-26/75-59#art_788_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_788> ;
    dzdoc:position 0 ;
    dzdoc:text "يمثل المصفي الشركة وتخول له السلطات الواسعة لبيع الأصول ولو بالتراضي. غير أن القيود الواردة على هذه السلطات الناتجة عن القانون الأساسي أو أمر التعيين لا يحتج بها على الغير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_788_para_1> a dzdoc:Paragraph ;
