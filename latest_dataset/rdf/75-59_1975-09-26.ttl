    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_196> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتعين على المستأجر طيلة مدة الدعوى الاستمرار في سداد بدلات الإيجار المستحقة حسب السعر القديم، أو عند الاقتضاء، حسب السعر الذي يمكن تجديده على أي حال بصفة مؤقتة من طرف الجهة القضائية التي طرحت أمامها القضية وفقا لالمادة السابقة"@ar ;
    dznorm:sourceArticle "art_196" .

