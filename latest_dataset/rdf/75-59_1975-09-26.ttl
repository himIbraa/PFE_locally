    dznorm:provisionText "يحق لكل صاحب سندات استحقاق المشاركة في الجمعية أو أن يمثله وكيل من اختياره لا يكون موضوع أي منع"@ar ;
    dznorm:sourceArticle "art_715_bis_96" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_97_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_97> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز أن يشارك في الجمعية العامة، أصحاب سندات الاستحقاق المستهلكة وغير المسددة من جراء تخلف الشركة المدينة أو بسبب خلاف يتعلق بشروط التسديد."@ar .

