    dznorm:sourceArticle "art_799_bis" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_799_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_799> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يؤدي التجمع من تلقاء نفسه إلى تحقيق الفوائد واقتسامها ويمكن أن يؤسس بدون رأسمال."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_799_para_1> a dzdoc:Paragraph ;
