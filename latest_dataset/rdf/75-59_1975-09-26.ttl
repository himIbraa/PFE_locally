<https://legal.dz/resource/order/1975-09-26/75-59#version_art_378> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة توقف شركة عن الدفع ، تطبق العقوبات الخاصة بالتفليس بالتقصير على القائمين بالإدارة و المديرين أو المصفين في الشركة ذات المسؤولية المحدودة ، وبوجه عام كل المفوضين من قبل الشركة، يكونون بهذه الصفة وبسوء نية : استهلكوا مبالغ جسيمة تخص الشركة في القيام بعمليات نصيبية محضة أو عمليات وهمية، أو قاموا بقصد تأخير إثبات توقف الشركة عن الدفع بمشتريات لإعادة البيع بأقل من سعر السوق، أو استعملوا بنفس القصد وسائل مؤدية للإفلاس للحصول على أمول، أو قاموا بعد توقف الشركة عن الدفع بإيفاء أحد الدائنين أو جع"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_378_19750926_OpEnact_35c7b590d3> ;
    dzdoc:replacementText "في حالة توقف شركة عن الدفع ، تطبق العقوبات الخاصة بالتفليس بالتقصير على القائمين بالإدارة و المديرين أو المصفين في الشركة ذات المسؤولية المحدودة ، وبوجه عام كل المفوضين من قبل الشركة، يكونون بهذه الصفة وبسوء نية : استهلكوا مبالغ جسيمة تخص الشركة في القيام بعمليات نصيبية محضة أو عمليات وهمية، أو قاموا بقصد تأخير إثبات توقف الشركة عن الدفع بمشتريات لإعادة البيع بأقل من سعر السوق، أو استعملوا بنفس القصد وسائل مؤدية للإفلاس للحصول على أمول، أو قاموا بعد توقف الشركة عن الدفع بإيفاء أحد الدائنين أو جعله يستوفي حقه إضرارا بجماعة الدائنين، أو جعلوا الشركة تعقد لحساب الغير تعهدات ثبت أنها بالغة الضخامة بالنسبة لوضعها عند التعاقد وذلك بغير أن تتقاضى الشركة مقابلا، أو أمسكوا أو أمروا بإمساك حسابات الشركة بغير انتظام."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_378> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_378> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

