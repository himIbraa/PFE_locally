<https://legal.dz/resource/order/1975-09-26/75-59#version_art_640> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز ل مجلس الإدارة عزل المديرين العامين في أي وقت، بناء على اقتراح الرئيس . وفي حالة وفاة الرئيس أو استقالته أو عزله ، يحتفظ المديران العامان بوظائفهما واختصاصاتهما إلى تاريخ تعيين رئيس جديد، إلا إذا اتخذ المجلس قرارا مخالفا."@ar ;
