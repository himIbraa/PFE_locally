<https://legal.dz/resource/order/1975-09-26/75-59#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_2> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "يجب عليه أيضا أن يجري سنويا جردا لعناصر أصول وخصوم مقاولته وأن يقفل كافة حساباته بقصد إعداد الميزانية وحساب النتائج وتنسخ بعد ذلك هذه الميزانية وحساب النتائج في دفتر الجرد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_10_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_10_19750926_OpEnact_873d16b6f0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_10_obligation_0_9ced752b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "10" ;
    dzdoc:position 10 ;
    dzdoc:usesTerm dzterm:inventory_book .

<https://legal.dz/resource/order/1975-09-26/75-59#art_101> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_101" ;
    dzdoc:fullText "يسلم مأمورو السجل التجاري للطالب نسخة من السند مع أحد الجدولين المنصوص عليهما في المادة 98 بعد التأشير عليهما، إثر استلامهما بما يفيد القيد المتضمن تاريخه والرقم الذي تم بموجبه، ويحتفظ بالمركز الوطني للسجل التجاري بالجدول الباقي المتضمن لنفس البيانات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_101> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_101_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_101_19750926_OpEnact_d2025349bc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "101" ;
    dzdoc:position 103 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_98> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_98> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_112> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_112" ;
    dzdoc:fullText "إذا اشترط البائع عند البيع فسخ العقد من تلقاء نفسه لعدم دفع الثمن في الأجل المتفق عليه أو إذا تراضى البائع و المشتري على فسخ البيع وجب على البائع إبلاغ الدائنين المقيدين بواسطة إجراء غير قضائي وفي محلات إقامتهم المختارة بالفسخ الحاصل أو المتفق عليه ولا يصبح هذا الفسخ نهائيا إلا بعد مضي شهر من تاريخ التبليغ الحاصل على الشكل المذكور. ويجب أن يتضمن التبليغ ذكر هذه المهلة تحت طائلة البطلان ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_112> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_112_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_112_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_112_19750926_OpEnact_8072cbe6ef> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_112_obligation_0_5610ca6f>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_112_obligation_1_11c72338> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "112" ;
    dzdoc:position 114 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_112_condition_0_dcc4d615> ;
    dzdoc:usesTerm dzterm:buyer,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-59#art_116> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_116" ;
    dzdoc:fullText "يعتبر لاغيا كل شرط وارد في عقد بيع المحل التجاري ويقضي باحتفاظ البائع في حالة حصول الفسخ بثمن المبيع كله أو بعضه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_116> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_116_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_116_19750926_OpEnact_6d3dbbb612> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "116" ;
    dzdoc:position 118 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_135> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_135" ;
    dzdoc:fullText "يحق لكل دائن مقيد أو معارض عند تبليغ إعادة المزايدة العمل على الحلول محل المزايدة بالزيادة في ملاحقة الإجراءات إذا لم يتابع هذا الأخير دعواه خلال شهر من إعادة المزايدة . ولا يسمح للمزايد بالزيادة وإن دفع مبلغ المزايدة أن يحول دون وقوع مرسى المزاد العلني بتنازله عن البيع إلا إذا وافقه جميع الدائنين المقيدين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_135_permission_0_6dd8c2d3> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_135_right_0_7d59608f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_135> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_135_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_135_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_135_19750926_OpEnact_62d6a82ad4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 135" ;
    dzdoc:position 137 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_135_condition_0_739cf304>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_135_condition_1_ec7a5a07> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_175> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_175" ;
    dzdoc:fullText "يجب في حالة تجديد الإيجار وفيما عدا حصول اتفاق بين الطرفين أن تكون مدة الإيجار الجديد مساوية لمدة الإيجار الذي حل أجله دون أن تزيد عن تسع سنوات . ويسري مفعول هذا الإيجار الجديد اعتبارا من يوم انتهاء الإيجار السابق أو عند الاقتضاء، اعتبارا من يوم تجديده ، حيث إن هذا التاريخ الأخير يكون إما هو تاريخ إعطاء التنبيه بالإخلاء أو الأجل المألوف الذي يلي طلب التجديد إذا تم تقديم هذا الأخير. غير أنه عندما يبلغ المؤجر عن طريق التنبيه بالإخلاء أو عن طريق رفض التجديد عن نيته في عدم تجديد الإيجار، أو عدل عن رأيه فيما بعد، وقام بتجديد الإيجار ، فإن هذا التجديد يصبح ساري المفعول من يوم تبليغ هذا القبول للمستأجر بإجراء غير قضائي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_175> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_175_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_175_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_175_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_175_19750926_OpEnact_b81f27425a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_175_obligation_0_58745b66> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "175" ;
    dzdoc:position 177 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_175_condition_0_7ab4ab09>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_175_condition_1_b0b7c02f> ;
    dzdoc:usesTerm dzterm:التنبيه_بالإخلاء,
        dzterm:تجديد_الإيجار,
        dzterm:طلب_التجديد .

<https://legal.dz/resource/order/1975-09-26/75-59#art_183> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_2_sec_3> ;
    dzdoc:eId "art_183" ;
    dzdoc:fullText "لا يحتج بحق الاسترجاع على المالك الذي حصل على رخصة لبناء محل سكن على كل أو على جزء من إحدى قطع الأرض المشار إليها في المادة 169 الفقرة الثانية. و لا يجوز أن يمارس حق الاسترجاع هذا في جميع الأحوال، إلا على الجزء من الأرض التي لابد منها للبناء وتطبق أحكام المادة 178 أعلاه، فيما إذا نجم عن هذا البناء لزوما توقيف الاستثمار التجاري أو الصناعي أو الحرفي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_183_permission_0_88b9ed35> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_183> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_183_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_183_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_183_19750926_OpEnact_426836be52> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_183_obligation_0_ddd71e08> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "183" ;
    dzdoc:position 185 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_169>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_178> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_169>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_178> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_187_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_2_sec_3> ;
    dzdoc:eId "art_187_bis" ;
    dzdoc:fullText "تحرر عقود الإيجار المبرمة ابتداء من تاريخ نشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية في الشكل الرسمي، وذلك تحت طائلة البطلان ، وتبرم لمدة يحددها الأطراف بكل حرية. يلزم المستأجر بمغادرة الأمكنة المستأجرة بانتهاء الأجل المحدد في العقد دون حاجة إلى توجيه تنبيه بالإخلاء ودون الحق في الحصول على تعويض الاستحقاق المنصوص عليه في هذا القانون ، ما لم يشترط الأطراف خلاف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_187_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_187_bis_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_187_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_187_bis_19750926_OpEnact_de36fef449> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_187_bis_obligation_0_c35e1875>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_187_bis_obligation_1_dbbd927b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "187 مكرر" ;
    dzdoc:position 190 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_187_bis_condition_0_4d76936d> ;
    dzdoc:usesTerm dzterm:tenant .

<https://legal.dz/resource/order/1975-09-26/75-59#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_3_sec_2> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "مع عدم الإخلال بتطبيق المادة 209 المتعلقة بتأجير المتاجر على وجه التسيير الحر، فإنه لا يمكن للتاجر المسجل الذي يتنازل عن متجره أو يؤجر استغلال تأجير التسيير، أن يحتج بإنهاء نشاطه التجاري للتهرب من القيام بالمسؤولية التي هي عليه من جراء الالتزامات التي تعهد بها خلفه في استغلال المتجر ، إلا ابتداء من اليوم الذي وقع فيه إما الشطب وإما الإشارة المطابقة وإما الإشارة التي تتضمن وضع المتجر على وجه تأجير التسيير."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_23_permission_0_6fe9ffb8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_23_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_23_19750926_OpEnact_a4efa7228a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_23_obligation_0_51ac87a4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "23" ;
    dzdoc:position 25 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_209> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_209> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_246> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_246" ;
    dzdoc:fullText "يؤدي حكم الإفلاس أو التسوية القضائية إلى جعل الديون غير المستحقة حالة الأجل بالنسبة للمدين. وإن كانت هذه الديون مقومة بعملة غير عملة المكان الذي صدر فيه الحكم بالتسوية القضائية أو الإفلاس فيجري تحويلها بالنسبة لجماعة الدائنين إلى عملة ذلك المكان تبعا لسعر الصرف في تاريخ الحكم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_246> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_246_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_246_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_246_19750926_OpEnact_8f2e76516f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "246" ;
    dzdoc:position 250 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_246_condition_0_91ef3f3a> ;
    dzdoc:usesTerm dzterm:bankruptcy .

<https://legal.dz/resource/order/1975-09-26/75-59#art_253> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_2> ;
    dzdoc:eId "art_253" ;
    dzdoc:fullText "يستدعي وكيل التفليسة المدين لديه لإقفال الدفاتر وحصرها في حضوره وذلك بغير مساس بما نصت عليه المادة 261 بخصوص حالة وضع الأختام. فإذا لم يستجب المدين لهذا الاستدعاء دعي بموجب رسالة موصى عليها مع طلب علم الوصول ليحضر ويقدم دفاتره خلال ثمانية أو أربعين ساعة . وله الحضور بمندوب مفوض عنه إذا هو علل تخلفه بأسباب يجدها القاضي المختص مقبولة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_253_right_0_15d5f926> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_253> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_253_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_253_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_253_19750926_OpEnact_11e081aad8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_253_obligation_0_170a1705>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_253_obligation_1_f4feb0c4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "253" ;
    dzdoc:position 258 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_261> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_261> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_253_condition_0_d3f0336d>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_253_condition_1_4e0a1325> ;
    dzdoc:usesTerm dzterm:receiver .

<https://legal.dz/resource/order/1975-09-26/75-59#art_255> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_2> ;
    dzdoc:eId "art_255" ;
    dzdoc:fullText "متى صدر الحكم بالتسوية القضائية أو شهر الإفلاس يتعين على وكيل التفليسة أن يقوم بكافة الإجراءات اللازمة لحفظ حقوق المدين ضد مدينيه . ويلتزم بنوع خاص بطلب القيود عن الرهون العقارية التي لم يكن المدين طلبها حتى ولو أخذ القيد باسم جماعة الدائنين من طرف وكيل التفليسة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_255> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_255_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_255_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_255_19750926_OpEnact_4c7f53f2e1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_255_obligation_0_a64f8246>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_255_obligation_1_3cbb3f33> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "255" ;
    dzdoc:position 260 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_255_condition_0_59773c81> ;
    dzdoc:usesTerm dzterm:receiver .

<https://legal.dz/resource/order/1975-09-26/75-59#art_262> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_3> ;
    dzdoc:eId "art_262" ;
    dzdoc:fullText "اعتبارا من الحكم القاضي ب التسوية القضائية أو شهر الإفلاس لشخص معنوي، لا يجوز للمديرين بحكم القانون أو الواقع أن يحولوا الحصص أو الأسهم التي تتكون منها حقوقهم في الشركة إلا بإذن القاضي المنتدب . و تقضي المحكمة بعدم قبول حوالة الأسهم والحصص في الشركة والتي يملكها كل شخص تدخل في إدارة أموال شخص معنوي مهما كان الزمن الذي ثبت فيه هذا التدخل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_262_permission_0_615bc4fa> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_262> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_262_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_262_19750926_OpEnact_368eb985f9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_262_obligation_0_cd3f6513>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_262_obligation_1_843a16a5> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_262_prohibition_0_615bc4fa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "262" ;
    dzdoc:position 267 ;
    dzdoc:usesTerm dzterm:bankruptcy,
        dzterm:settlement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_264> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_4> ;
    dzdoc:eId "art_264" ;
    dzdoc:fullText "يجري مباشرة جرد أموال المدين بحضوره أو بعد استدعائه قانونا بموجب رسالة موصى عليها . ويجري في نفس الوقت التحقيق من وجود الأشياء التي لم تكن قد وضعت عليها الأختام، أو تكون قد استخرجت وكان تقويمها وجردها طبقا ل المادة 260 . وتحرر قائمة الجرد تلك في أصلين يودع أحدهما فورا بكتابة ضبط المحكمة المختصة ويبقى الأصل الثاني بين يدي وكيل التفليسة . ويجوز أن يعاون وكيل التفليسة في تحرير قائمة الجرد أي شخص يرى اختياره لذلك أو ليقدر قيمة الأشياء ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_264_right_0_067188ae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_264> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_264_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_264_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_264_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_264_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_264_19750926_OpEnact_24d73e6491> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_264_obligation_0_19ad064c>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_264_obligation_1_1b988c82> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "264" ;
    dzdoc:position 269 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_260> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_260> ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:trustee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_266> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_4> ;
    dzdoc:eId "art_266" ;
    dzdoc:fullText "يجوز للنيابة العامة حضور الجرد . ولها في أي وقت الحق في طلب الاطلاع على كافة المحررات والدفاتر والأوراق المتعلقة بالتسوية القضائية أو الإفلاس ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_266_permission_0_4b3dc6a8> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_266_right_0_0775afee>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_266_right_1_e70ebaf1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_266> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_266_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_266_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_266_19750926_OpEnact_b67ea7e56d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "266" ;
    dzdoc:position 271 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_272> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_5> ;
    dzdoc:eId "art_272" ;
    dzdoc:fullText "كل معارضة في الأموال التي أودعها وكيل التفليسة أو الغير لحساب الإفلاس تعد لاغية. وإذا وقعت معارضات على أموال مودعة من الغير ، و يجب على وكيل التفليسة أن يطلب رفعها والحصول على ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_272> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_272_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_272_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_272_19750926_OpEnact_dbc85f945a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_272_obligation_0_637afa95> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 272" ;
    dzdoc:position 277 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_272_condition_0_cd5ea217> ;
    dzdoc:usesTerm dzterm:syndic .

<https://legal.dz/resource/order/1975-09-26/75-59#art_274> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_6> ;
    dzdoc:eId "art_274" ;
    dzdoc:fullText "إذا رفض المدين القيام بالإجراءات المشار إليها في الفقرة الأولى من المادة 273 فلوكيل التفليسة مباشرتها وحده بإذن من القاضي المنتدب . ومع ذلك إذا تعلق الأمر برفع دعوى لا يكون هذا الإذن ضروريا وإنما يلتزم وكيل التفليسة بإدخال المدين في الدعوى ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_274> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_274_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_274_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_274_19750926_OpEnact_d421bdce18> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_274_obligation_0_513891d0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_274_obligation_1_18023a01> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "274" ;
    dzdoc:position 279 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_273> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_273> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_274_condition_0_2fe41f41>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_274_condition_1_338fa931> ;
    dzdoc:usesTerm dzterm:bankruptcy_trustee,
        dzterm:debtor,
        dzterm:delegated_judge .

<https://legal.dz/resource/order/1975-09-26/75-59#art_293> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_3> ;
    dzdoc:eId "art_293" ;
    dzdoc:fullText "لوكيل التفليسة بإذن من القاضي المنتدب وبعد تسديد الدين أن يسحب الضمان الصادر من المدين لصالح جماعة الدائنين . وإذا لم يسحب الضمان فعلى الدائن المنذر من طرف وكيل التفليسة أن يقوم بالبيع في الأجل المحدد وعند عدمه جاز لوكيل التفليسة أن يقوم عوضا عنه بالبيع بعد الإذن له بذلك من القاضي المنتدب . يقدم امتياز الدائن المرتهن على كل دائن آخر صاحب امتياز أم لا. إن كان ثمن البيع يفوق مبلغ الدين المضمون ، يحصل الفائض من طرف وكيل التفليسة ، وفي حالة العكس يخصص الفائض للدائن بصفته دائنا عاديا."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_293_right_0_94b9d4c5>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_293_right_1_5e0b36cf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_293> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_293_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_293_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_293_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_293_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_293_19750926_OpEnact_ea6bddc0aa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 293" ;
    dzdoc:position 298 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_293_condition_0_8e7b4cc8>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_293_condition_1_bc5e09ff> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:mortgagee,
        dzterm:trustee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_309> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_5> ;
    dzdoc:eId "art_309" ;
    dzdoc:fullText "يجوز استرداد البضائع المرسلة إلى المدين ما دام التسليم لم يتحقق في مخازنه . ومع ذلك لا يقبل الاسترداد إذا كانت البضائع قد تم بيعها قبل وصولها دون غش وبمقتضى فواتير أو سندات صحيحة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_309_permission_0_ee2b992f> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_309_right_0_5d3987d9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_309> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_309_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_309_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_309_19750926_OpEnact_71a4f235b9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_309_obligation_0_c7c87ec6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "309" ;
    dzdoc:position 314 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_309_condition_0_2c7add96> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_314> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_1> ;
    dzdoc:eId "art_314" ;
    dzdoc:fullText "في مدى الثلاثة أيام التالية لإقفال كشف الديون أو إن كان ثمة نزاع ففي مدى ثلاثة أيام من القرار الصادر من المحكمة تطبيقا للمادة 287 ، يقوم القاضي المنتدب باستدعاء الدائنين المقبولة ديونهم ويكون ذلك بإخطارات نشر في الصحف المختصة بالإعلانات القانونية أو مرسلة إليهم فرديا من طرف وكيل التفليسة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_314> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_314_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_314_19750926_OpEnact_765feaec1d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_314_obligation_0_846601f9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 314" ;
    dzdoc:position 319 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_287> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_287> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_314_condition_0_b04575cc> ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:trustee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_325> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_3> ;
    dzdoc:eId "art_325" ;
    dzdoc:fullText "يخضع الصلح للتصديق عليه من المحكمة . وتكون متابعة التصديق بناء على طلب الطرف الذي يهمه التعجيل و لا يمكن للمحكمة الفصل فيه إلا بعد فوات ميعاد الثمانية أيام المحدد في المادة 323 فإذا حصلت معارضات خلال هذه المهلة، تبت فيها المحكمة وفي موضوع التصديق بحكم واحد."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_325_permission_0_710fde86> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_325> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_325_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_325_19750926_OpEnact_9a224a2e1d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_325_obligation_0_94e443d3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 325" ;
    dzdoc:position 330 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_323> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_323> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_325_condition_0_dce9a622> ;
    dzdoc:usesTerm dzterm:conciliation .

<https://legal.dz/resource/order/1975-09-26/75-59#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:commercial_agency_contract ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_3> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "يعتبر عقد الوكالة التجارية اتفاقية يلتزم بواسطتها الشخص عادة بإعداد أو إبرام البيوع أو الشراءات وبوجه عام جميع العمليات التجارية باسم ولحساب تاجر، والقيام عند الاقتضاء بعمليات تجارية لحسابه الخاص ولكن دون أن يكون مرتبطا بعقد إجارة الخدمات . إذا كان عقد الوكالة التجارية غير محدد بمدة معينة فلا يجوز لكلا الطرفين فسخه دون إخبار مسبق ومطابق للأعراف ، إلا في حالة صدور خطأ من أحد الطرفين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_34_permission_0_024078a3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_34> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_34_defocc_a3aa4fbf0686> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_34_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_34_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_34_19750926_OpEnact_65a732b9e2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_34_obligation_0_f7111879> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 34" ;
    dzdoc:position 36 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_34_condition_0_6202e45a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_34_condition_1_207e74b0> ;
    dzdoc:usesTerm dzterm:commercial_agency_contract .

<https://legal.dz/resource/order/1975-09-26/75-59#art_350> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_8> ;
    dzdoc:eId "art_350" ;
    dzdoc:fullText "يجوز لوكيل التفليسة القيام وحده ببيع بضائع ومنقولات المدين وتحصيل حقوقه وتصفية ديونه ، وذلك من دون إخلال بالأوضاع المنصوص عليها في الفقرة الثانية من المادة السابقة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_350_permission_0_486dc038> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_350_right_0_4827f993> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_350> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_350_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_350_19750926_OpEnact_401d2d350e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "350" ;
    dzdoc:position 355 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_349> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_349> ;
    dzdoc:usesTerm dzterm:bankruptcy_trustee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_356> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_8> ;
    dzdoc:eId "art_356" ;
    dzdoc:fullText "للمدين أو لكل ذي مصلحة غيره أن يطلب من المحكمة العدول عن حكمها الذي أصدرته مع تقديم دليل على وجود أموال كافية لمواجهة نفقات العمليات، أو إيداع مبلغ يكفي لمواجهتها بين يدي وكيل التفليسة . وعلى أي حال يتعين تسديد نفقات الإجراءات التي اتخذت بمقتضى المادة السابقة على وجه الأسبقية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_356_right_0_764d962a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_356> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_356_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_356_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_356_19750926_OpEnact_ed6f93f708> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_356_obligation_0_c439ef44> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "356" ;
    dzdoc:position 361 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_355> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_355> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_356_condition_0_502122f0> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_365> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_2> ;
    dzdoc:eId "art_365" ;
    dzdoc:fullText "يفصل بعدئذ في الطلب وفي المعارضات المرفوعة بموجب حكم واحد. وإذا رفض الطلب لا يجوز تجديده إلا بعد انقضاء عام واحد. وإذا قبل الطلب يسجل الحكم في سجل المحكمة التي أصدرته ومحكمة موطن الطالب. ويبلغ فضلا عن ذلك بعناية كاتب الضبط لوكيل الدولة التابع له محل ميلاد الطالب، ملخص عن الحكم ليؤشر عنه في الصحيفة القضائية إزاء التصريح بإشهار الإفلاس أو التسوية القضائية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_365_permission_0_1b245357> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_365> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_365_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_365_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_365_19750926_OpEnact_dff2ddc2bb> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_365_prohibition_0_1b245357> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 365" ;
    dzdoc:position 370 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_365_condition_0_cf86826c>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_365_condition_1_a193d10d> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_380> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_3_sec_2> ;
    dzdoc:eId "art_380" ;
    dzdoc:fullText "تطبق عقوبة التفليس بالتقصير على القائمين بالإدارة و المديرين أو المصفين في شركة مساهمة ، و المسيرين أو المصفين في الشركة ذات المسؤولية المحدودة ، وبوجه عام كل المفوضين من قبل الشركة يكونون بقصد إخفاء كل أو بعض ذمتهم المالية عن متابعتهم من جانب الشركة المتوقفة عن الدفع أو من دائني الشركة يكونون عن سوء قصد اختلسوا أو أخفوا جانبا من أموالهم أو أقروا تدليسا بمديونتهم بمبالغ ليست في ذمتهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_380> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_380_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_380_19750926_OpEnact_a095c73b02> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 380" ;
    dzdoc:position 385 ;
    dzdoc:usesTerm dzterm:administrators,
        dzterm:joint_stock_company,
        dzterm:liquidators,
        dzterm:llc,
        dzterm:managers,
        dzterm:penalties .

<https://legal.dz/resource/order/1975-09-26/75-59#art_429> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_8> ;
    dzdoc:eId "art_429" ;
    dzdoc:fullText "يجب على المسحوب عليه الذي يقبل التبليغ إذا لم يؤد مبلغ السفتجة ومصاريف الإخبار وعند الاقتضاء احتجاج الشيك ، أن يرد السفتجة إلى كتابة الضبط وهناك يحرر في الحين احتجاج لعدم الوفاء. إذا لم يرد المسحوب عليه السفتجة يحرر الاحتجاج في الحين ويوقع الإشهاد بعدم الرد، وفي هذه الحالة يعفى الحامل من الغير من تطبيق أحكام المادتين 421 و 422 . يعتبر عدم رد السفتجة كجنحة تستوجب العقوبات المنصوص عليها في المادة 376 من قانون العقوبات ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_429_right_0_805f7b56> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_429> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_429_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_429_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_429_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_429_19750926_OpEnact_9e3e665819> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_429_obligation_0_69d3639d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "429" ;
    dzdoc:position 434 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_421>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_422> ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_429_extref_02fdd0c2> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_421>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_422> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_429_condition_0_67fc3710> ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:check,
        dzterm:drawee,
        dzterm:holder .

<https://legal.dz/resource/order/1975-09-26/75-59#art_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_2> ;
    dzdoc:eId "art_45" ;
    dzdoc:fullText "في حالة نقل شيء غير مشروط تسليمه إلى الموطن ، وجب على الناقل إخطار المرسل إليه بالوقت الذي يمكن له فيه تسليمه بمجرد ما يكون في استطاعة الناقل وضعه تحت تصرفه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_45_permission_0_0f110475> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_45> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_45_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_45_19750926_OpEnact_c225a7b3d5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_45_obligation_0_cf0791da> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 45" ;
    dzdoc:position 47 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_45_condition_0_b5d6dc28> ;
    dzdoc:usesTerm dzterm:carrier,
        dzterm:sender_to .

<https://legal.dz/resource/order/1975-09-26/75-59#art_458> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_10> ;
    dzdoc:eId "art_458" ;
    dzdoc:fullText "يحق لحامل السفتجة أن يستخرج نسخا منها . يجب أن تكون النسخة مطابقة تماما للأصل مع ما يشتمل عليه من التظهيرات وجميع البيانات الأخرى وأن يبين فيها الحد الذي تنتهي إليه . ويمكن تظهيرها وضمانها احتياطيا بمثل الكيفية التي تجري على الأصل ويترتب عليها ما يترتب عليه من الآثار."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_458_right_0_f57e105a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_458> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_458_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_458_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_458_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_458_19750926_OpEnact_9216b8e2b2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_458_obligation_0_4887b396> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "458" ;
    dzdoc:position 463 ;
    dzdoc:usesTerm dzterm:bill_of_exchange .

<https://legal.dz/resource/order/1975-09-26/75-59#art_472> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_472" ;
    dzdoc:fullText "يحتوي الشيك على البيانات الآتية : 1 - ذكر كلمة شيك مدرجة في نص السند نفسه باللغة التي كتب بها، 2 - أمر غير معلق على شرط بدفع مبلغ معين، 3 - اسم الشخص الذي يجب عليه الدفع ( المسحوب عليه )، 4 - بيان المكان الذي يجب فيه الدفع، 5 - بيان تاريخ إنشاء الشيك ومكانه، 6 - توقيع من أصدر الشيك ( الساحب )."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_472> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_472_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_472_19750926_OpEnact_3a79c3e3da> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_472_obligation_0_13595aae> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 472" ;
    dzdoc:position 477 ;
    dzdoc:usesTerm dzterm:cheque,
        dzterm:drawee,
        dzterm:drawer .

<https://legal.dz/resource/order/1975-09-26/75-59#art_473> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_473" ;
    dzdoc:fullText "إذا خلا السند من أحد البيانات المذكورة في المادة السابقة ، فلا يعتبر شيكا إلا في الأحوال المنصوص عليها في الفقرات الآتية : إذا خلا الشيك من بيان مكان الوفاء فإن المكان المبين بجانب اسم المسحوب عليه يعتبر مكان الوفاء. فإذا ذكرت عدة أمكنة بجانب اسم المسحوب عليه فيكون الشيك واجب الدفع في المكان المذكور أولا. وإذا لم تذكر هذه البيانات أو غيرها يكون الشيك واجب الدفع في المكان الذي به المحل الأصلي للمسحوب عليه . إن الشيك الذي لم يذكر فيه مكان إنشائه يعتبر إنشاؤه قد تم في المكان المبين بجانب اسم الساحب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_473> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_473_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_473_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_473_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_473_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_473_19750926_OpEnact_9309fafe2b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 473" ;
    dzdoc:position 478 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_472> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_472> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_473_condition_0_cb1da0a1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_473_condition_1_d3c40c44>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_473_condition_2_fd5a08dc>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_473_condition_3_81eab3bd> ;
    dzdoc:usesTerm dzterm:cheque,
        dzterm:drawee,
        dzterm:drawer .

<https://legal.dz/resource/order/1975-09-26/75-59#art_499> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_3> ;
    dzdoc:eId "art_499" ;
    dzdoc:fullText "يلتزم ضامن الوفاء بمثل ما التزم به الشخص المضمون . ويكون التزام ضامن الوفاء صحيحا وإن كان الالتزام الذي ضمنه باطلا لأي سبب آخر غير عيب في الشكل. إذا أوفى الضامن الاحتياطي مبلغ الشيك فإنه يكتسب الحقوق الناتجة عن الشيك تجاه المضمون والملتزمين تجاه هذا الأخير بمقتضى الشيك ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_499_right_0_007a19be> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_499> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_499_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_499_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_499_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_499_19750926_OpEnact_3c5601ba35> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_499_obligation_0_e71d9527> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "499" ;
    dzdoc:position 504 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_499_condition_0_1835dca2> ;
    dzdoc:usesTerm dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_2> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "عندما يتعذر تعيين المسافة التي حصل أثناءها الضرر فيكون للناقل الذي تحمل تعويض الضرر حق الرجوع الجزئي على كل واحد من الناقلين على نسبة المسافة التي قطعها و يجب توزيع الحصص المطلوبة من المعسرين منهم على الجميع مع مراعاة نفس النسبة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_50_right_0_028e1ce6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_50> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_50_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_50_19750926_OpEnact_c72b689be5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_50_obligation_0_d0c5d91d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 50" ;
    dzdoc:position 52 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_50_condition_0_6a507bdc> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_501> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_4> ;
    dzdoc:eId "art_501" ;
    dzdoc:fullText "يجب تقديم صك صادر وقابل للدفع في الجزائر للدفع ضمن عشرين يوما . أما الصك الصادر خارج الجزائر والقابل للدفع فيها فيجب تقديمه إما في مدة ثلاثين يوما إذا كان الصك صادرا من أوروبا أو من أحد البلدان المطلة على البحر الأبيض المتوسط، وإما في مدة سبعين يوما إذا كان الصك صادرا في أي بلد آخر ، مع مراعاة الأحكام المتعلقة بتنظيم الصرف. وتسري الآجال المذكورة أعلاه من اليوم المعين في الشيك كتاريخ لإصداره."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_501> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_501_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_501_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_501_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_501_19750926_OpEnact_d78ba9a6b0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_501_obligation_0_9d3160e4>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_501_obligation_1_b678b17a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "501" ;
    dzdoc:position 506 ;
    dzdoc:usesTerm dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_8_bis> ;
    dzdoc:eId "art_526_bis_9" ;
    dzdoc:fullText "بمجرد قيام بنك الجزائر بتبليغ قائمة الممنوعين من إصدار الشيكات المنصوص عليها في المادة 526 مكرر 8 أعلاه ، إلى البنوك والهيئات المالية المؤهلة قانونا ، يجب أن تقوم هذه الأخيرة : بالامتناع عن تسليم دفتر الشيكات لكل شخص مدرج في هذه القائمة ، بطلب إرجاع نماذج الشيكات التي لم يتم استعمالها بعد من قبل الزبون المعني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_9_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_9_19750926_OpEnact_0d8697b6aa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_9_obligation_0_df83fa1d>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_9_obligation_1_ef78913a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_9_obligation_2_a7cbbce3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "526 مكرر 9" ;
    dzdoc:position 541 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_8> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_8> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_9_condition_0_a8deca01> ;
    dzdoc:usesTerm dzterm:central_bank .

<https://legal.dz/resource/order/1975-09-26/75-59#art_529> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_9> ;
    dzdoc:eId "art_529" ;
    dzdoc:fullText "يجب تقديم الاحتجاج على يد كاتب الضبط لموطن الذي كان يجب عليه وفاء قيمة الشيك أو في موطنه الأخير المعروف . وفي حالة الدلالة على موطن كاذب يكون الاحتجاج مسبوقا بإجراء التفتيش."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_529> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_529_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_529_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_529_19750926_OpEnact_8c42cd4d1c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_529_obligation_0_bcea469c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "529" ;
    dzdoc:position 551 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_529_condition_0_701ed93d> ;
    dzdoc:usesTerm dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_534> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_9> ;
    dzdoc:eId "art_534" ;
    dzdoc:fullText "لا يجوز منح أي يوم إمهال إداري أو قانوني أو قضائي إلا في الأحوال المنصوص عليها في التشريع الجاري به العمل والمتعلق بتمديد الآجال الخاصة بالاحتجاج أو بتمديد استحقاقات السندات القابلة للتحويل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_534_permission_0_53ff6314> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_534> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_534_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_534_19750926_OpEnact_bc00b813b4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_534_obligation_0_cc8bb232> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_534_prohibition_0_53ff6314> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 534" ;
    dzdoc:position 556 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_534_condition_0_1555b691> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_556> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_556" ;
    dzdoc:fullText "تؤخذ القرارات التي تجاوز السلطات المعترف بها للمديرين بإجماع الشركاء. غير أنه يمكن أن ينص القانون الأساسي على أن تؤخذ بعض القرارات بأغلبية محددة في القانون. كما أنه يمكن أن ينص القانون الأساسي على أن تؤخذ القرارات عن طريق استشارة كتابية، إذا لم يطلب أحد الشركاء عقد اجتماع الشركاء."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_556_permission_0_b5632ff7>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_556_permission_1_36225c87> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_556> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_556_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_556_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_556_19750926_OpEnact_e5ada43613> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "556" ;
    dzdoc:position 603 ;
    dzdoc:usesTerm dzterm:statutes .

<https://legal.dz/resource/order/1975-09-26/75-59#art_557> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_557" ;
    dzdoc:fullText "يعرض التقرير الصادر عن عمليات السنة المالية وإجراء الجرد، وحساب الاستغلال العام وحساب النتائج والميزانية الموضوعة من المديرين على جمعية الشركاء للمصادقة عليها، وذلك في أجل ستة أشهر ابتداء من قفل السنة المالية . ولهذا الغرض توجه المستندات المشار إليها في الفقرة المتقدمة وكذلك نص القرارات المقترحة، إلى الشركاء قبل خمسة عشر يوما من اجتماع الجمعية . ويمكن إبطال كل مداولة جارية خلافا لهذه الفقرة. لا تسري أحكام هذه المادة إذا كان جميع الشركاء مديرين. ويعتبر كل شرط مخالف لأحكام هذه المادة كأن لم يكن."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_557> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_557_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_557_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_557_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_557_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_557_19750926_OpEnact_c2cf34b7bf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_557_obligation_0_3205d2e5>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_557_obligation_1_d7245d44> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "557" ;
    dzdoc:position 604 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1_bis> ;
    dzdoc:eId "art_563_bis_5" ;
    dzdoc:fullText "لا يمكن للشريك الموصى أن يقوم بأي عمل تسيير خارجي ولو بمقتضى وكالة . في حالة مخالفة هذا المنع ، يتحمل الشريك الموصي، بالتضامن مع الشركاء المتضامنين، ديون الشركة والتزاماتها المترتبة عن الأعمال الممنوعة . ويمكن أن يلتزم بالتضامن بكل التزامات الشركة أو بعضها فقط حسب عدد أو أهمية هذه الأعمال الممنوعة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_5_permission_0_e4e7c76e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_5_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_5_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_5_19750926_OpEnact_937d7c6c81> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_5_obligation_0_e9a31448>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_5_obligation_1_6a333b2e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "563 مكرر 5" ;
    dzdoc:position 616 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_5_condition_0_e14c98bc> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_595> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_595" ;
    dzdoc:fullText "يحرر الموثق مشروع القانون الأساسي لشركة المساهمة، بطلب من مؤسس أو أكثر، وتودع نسخة من هذا العقد بالمركز الوطني للسجل التجاري . ينشر المؤسسون تحت مسؤوليتهم إعلانا حسب الشروط المحددة عن طريق التنظيم . لا يقبل أي اكتتاب إذا لم تحترم الإجراءات المقررة في المقطعين الأول والثاني أعلاه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_595> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_595_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_595_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_595_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_595_19750926_OpEnact_dad45748b3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_595_obligation_0_03fd02c6>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_595_obligation_1_e67e6a84> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "595" ;
    dzdoc:position 654 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_595_condition_0_61c5a382> ;
    dzdoc:usesTerm dzterm:notary .

<https://legal.dz/resource/order/1975-09-26/75-59#art_638> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_638" ;
    dzdoc:fullText "يتولى رئيس مجلس الإدارة تحت مسؤوليته، الإدارة العامة للشركة ويمثل الشركة في علاقاتها مع الغير . يتمتع الرئيس بالسلطات الواسعة للتصرف باسم الشركة في كل الظروف مع مراعاة السلطات التي يخولها القانون صراحة لجمعيات المساهمين وكذا السلطات المخصصة بكيفية خاصة ل مجلس الإدارة وفي حدود موضوع الشركة. وفي علاقاتها مع الغير، تكون الشركة ملتزمة حتى بأعمال رئيس مجلس الإدارة غير التابعة لموضوع الشركة ما لم يثبت أن الغير كان يعلم أن العمل يتجاوز هذا الموضوع أو لا يمكنه تجاهله نظرا للظروف ، مع استبعاد كون نشر القانون الأساسي يكفي وحده لتأسيس هذه البينة. لا يحتج على الغير بأحكام القانون الأساسي أو قرارات مجلس الإدارة المحددة لهذه السلطات."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_638_right_0_9d3fcd54> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_638> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_638_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_638_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_638_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_638_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_638_19750926_OpEnact_8e13f793f7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_638_obligation_0_f6d40793>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_638_obligation_1_878f71c8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 638" ;
    dzdoc:position 697 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_638_condition_0_0ffb70ac> ;
    dzdoc:usesTerm dzterm:board_of_directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_640> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_640" ;
    dzdoc:fullText "يجوز ل مجلس الإدارة عزل المديرين العامين في أي وقت، بناء على اقتراح الرئيس . وفي حالة وفاة الرئيس أو استقالته أو عزله ، يحتفظ المديران العامان بوظائفهما واختصاصاتهما إلى تاريخ تعيين رئيس جديد، إلا إذا اتخذ المجلس قرارا مخالفا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_640_permission_0_11a51983> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_640_right_0_f0296fca> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_640> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_640_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_640_19750926_OpEnact_6e28f9ec0e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 640" ;
    dzdoc:position 699 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_640_condition_0_ad52fd1c> ;
    dzdoc:usesTerm dzterm:board_of_directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_644> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_644" ;
    dzdoc:fullText "يعين مجلس المراقبة أعضاء مجلس المديرين ويسند الرئاسة لأحدهم. وتحت طائلة البطلان يعتبر أعضاء مجلس المديرين أشخاصا طبيعيين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_644> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_644_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_644_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_644_19750926_OpEnact_f0c0673eba> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 644" ;
    dzdoc:position 703 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_644_condition_0_6bf5d68c> ;
    dzdoc:usesTerm dzterm:board_of_directors,
        dzterm:supervisory_board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_656> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_656" ;
    dzdoc:fullText "يقدم مجلس المديرين مرة كل ثلاثة أشهر على الأقل وعند نهاية كل سنة مالية، تقريرا لـ مجلس المراقبة حول تسييره . يقدم مجلس المديرين بعد قفل كل سنة مالية، لـ مجلس المراقبة ، وثائق الشركة المذكورة في المادة 716 ، \"المقطعين 2 و 3 منها\"، قصد المراجعة والرقابة . يقدم مجلس المراقبة للجمعية العامة ملاحظاته على تقرير مجلس المديرين وعلى حسابات السنة المالية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_656> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_656_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_656_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_656_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_656_19750926_OpEnact_5c7a828ea1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_656_obligation_0_90cce0cf>,
