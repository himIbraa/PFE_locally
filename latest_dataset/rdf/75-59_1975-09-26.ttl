<https://legal.dz/resource/order/1975-09-26/75-59#art_442_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_442> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب أن يتم الاحتجاج: في موطن الشخص الذي كان يجب عليه وفاء السفتجة أو بآخر موطن معروف له، وفي موطن الأشخاص المعينين في السفتجة لوفائها عند الحاجة، وفي موطن الغير الذي قبلها بطريقة التدخل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_442_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_442> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجب أن يتم كل ذلك بإجراء واحد. وعند وجود بيان مزيف بالنسبة للموطن يتم إجراء التفتيش قبل الاحتجاج."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_443_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_443> ;
    dzdoc:position 0 ;
    dzdoc:text "يشتمل الاحتجاج على نسخة حرفية لنص السفتجة والقبول والتظهيرات والقيود المبينة بها مع الإنذار بوفاء مبلغ السفتجة. ويذكر فيه ما إذا كان الشخص الذي يجب عليه الدفع حاضرا أو غائبا مع بيان أسباب رفض الوفاء والعجز عن التوقيع أو رفض التوقيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_444_obligation_0_bb766579> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_444> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يقوم مقام الاحتجاج أي إجراء آخر يصدر عن حامل السفتجة"@ar ;
    dznorm:sourceArticle "art_444" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_444_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_444> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يقوم مقام الاحتجاج أي إجراء آخر يصدر عن حامل السفتجة فيما عدا الأحوال المنصوص عليها في المادة 420 وما يليها والمادة 428."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_445_condition_0_60179095> a dznorm:Condition ;
