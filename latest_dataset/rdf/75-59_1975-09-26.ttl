<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_118> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤدي ترخيص الجمعية العامة لفائدة أصحاب سندات الاستحقاق، إلى التنازل الصريح للمساهمين عن حقهم التفضيلي في الاكتتاب في الأسهم التي تصدر بموجب تحویل سندات الاستحقاق. لا يجوز التحويل إلا بناء على رغبة الحاملين وفقط حسب شروط وأسس التحويل المحددة في عقد إصدار سندات الاستحقاق . ويبين هذا العقد بأن التحويل سيتم إما في فترة أو فترات اختيارية محددة وإما في أي وقت كان ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_118_19750926_OpEnact_16efa8abbb> ;
    dzdoc:replacementText "يؤدي ترخيص الجمعية العامة لفائدة أصحاب سندات الاستحقاق، إلى التنازل الصريح للمساهمين عن حقهم التفضيلي في الاكتتاب في الأسهم التي تصدر بموجب تحویل سندات الاستحقاق. لا يجوز التحويل إلا بناء على رغبة الحاملين وفقط حسب شروط وأسس التحويل المحددة في عقد إصدار سندات الاستحقاق . ويبين هذا العقد بأن التحويل سيتم إما في فترة أو فترات اختيارية محددة وإما في أي وقت كان ."@ar ;
