    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_49_obligation_0_44b923a6>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_49_obligation_1_34607adf>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_49_obligation_2_edb3f1fa> ;
