<https://legal.dz/resource/order/1975-09-26/75-59#version_art_314> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في مدى الثلاثة أيام التالية لإقفال كشف الديون أو إن كان ثمة نزاع ففي مدى ثلاثة أيام من القرار الصادر من المحكمة تطبيقا للمادة 287 ، يقوم القاضي المنتدب باستدعاء الدائنين المقبولة ديونهم ويكون ذلك بإخطارات نشر في الصحف المختصة بالإعلانات القانونية أو مرسلة إليهم فرديا من طرف وكيل التفليسة ."@ar ;
