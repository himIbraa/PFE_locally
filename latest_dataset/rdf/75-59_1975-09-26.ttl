<https://legal.dz/resource/order/1975-09-26/75-59#version_art_271> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تودع الأموال الناتجة من البيوع والتحصيلات في الخزينة العامة فورا . ويتعين تقديم إثبات الإيداع إلى القاضي المنتدب في مدى خمسة عشرة يوما من التحصيل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_271_19750926_OpEnact_1cc2c9ac22> ;
    dzdoc:replacementText "تودع الأموال الناتجة من البيوع والتحصيلات في الخزينة العامة فورا . ويتعين تقديم إثبات الإيداع إلى القاضي المنتدب في مدى خمسة عشرة يوما من التحصيل ."@ar ;
