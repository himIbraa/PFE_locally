        dzterm:investment_certificate,
        dzterm:share,
        dzterm:voting_right_certificate .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_bis> ;
    dzdoc:eId "art_715_ثالثا_2" ;
    dzdoc:fullText "تعين الجمعية العامة العادية وفقا للشروط المحددة في القانون الأساسي، مجلسا للمراقبة يتكون من ثلاثة (03) مساهمين على الأقل. لا يجوز أن يكون الشريك المتضامن عضوا في مجلس المراقبة وذلك تحت طائلة بطلان تعيينه. ولا يجوز للمساهمين الذين لهم صفة شريك متضامن أن يشاركوا في تعيين أعضاء مجلس المراقبة . تكون القواعد المتعلقة بتعيين القائمين بالإدارة بشركات المساهمة ومدة مهمتهم قابلة للتطبيق."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_2_permission_0_016caa78>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_2_permission_1_521c902c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_2_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_2_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_2_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_2_para_3> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715___2_19750926_OpEnact_827787f34a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_2_obligation_0_8b5e70d2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_2_obligation_1_903dedc9> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_2_prohibition_0_016caa78> ;
