<https://legal.dz/resource/order/1975-09-26/75-59#version_art_505> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحق للمسحوب عليه أن يطلب من الحامل عند وفائه قيمة الشيك أن يسلمه إليه مع التأشير عليه بالمخالصة . ولا يجوز للحامل أن يرفض الوفاء الجزئي . وإذا كان مقابل الوفاء أقل من مبلغ الشيك ، جاز للحامل أن يطلب الوفاء على قدر مقابل الوفاء . وفي حالة الوفاء الجزئي يحق للمسحوب عليه أن يطلب ذكر هذا الوفاء في الشيك وإعطاءه مخالصة بذلك . وتعفى هذه المخالصة المدرجة في الشيك نفسه من الطابع المالي. وتبرأ ذمة الساحبين والمظهرين بقدر الوفاء الجزئي من أصل مبلغ الشيك . ويجب على الحامل تحرير احتجاج بالنسبة لباقي المبلغ "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_505_19750926_OpEnact_0cd0bbb2c1> ;
    dzdoc:replacementText "يحق للمسحوب عليه أن يطلب من الحامل عند وفائه قيمة الشيك أن يسلمه إليه مع التأشير عليه بالمخالصة . ولا يجوز للحامل أن يرفض الوفاء الجزئي . وإذا كان مقابل الوفاء أقل من مبلغ الشيك ، جاز للحامل أن يطلب الوفاء على قدر مقابل الوفاء . وفي حالة الوفاء الجزئي يحق للمسحوب عليه أن يطلب ذكر هذا الوفاء في الشيك وإعطاءه مخالصة بذلك . وتعفى هذه المخالصة المدرجة في الشيك نفسه من الطابع المالي. وتبرأ ذمة الساحبين والمظهرين بقدر الوفاء الجزئي من أصل مبلغ الشيك . ويجب على الحامل تحرير احتجاج بالنسبة لباقي المبلغ ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_505> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_505> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_506> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "من أوفى قيمة شيك بغير معارضة، عد وفاؤه صحيحا. وإذا أوفى المسحوب عليه قيمة شيك قابل للتظهير ، وجب عليه التحقق من صحة تسلسل التظهيرات وليس من تواقيع المظهرين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_506_19750926_OpEnact_0469d5aeee> ;
    dzdoc:replacementText "من أوفى قيمة شيك بغير معارضة، عد وفاؤه صحيحا. وإذا أوفى المسحوب عليه قيمة شيك قابل للتظهير ، وجب عليه التحقق من صحة تسلسل التظهيرات وليس من تواقيع المظهرين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_506> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
