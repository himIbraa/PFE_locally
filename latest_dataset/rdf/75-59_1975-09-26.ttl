<https://legal.dz/resource/order/1975-09-26/75-59#version_art_551> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للشركاء بالتضامن صفة التاجر وهم مسؤولون من غير تحديد وبالتضامن عن ديون الشركة . ولا يجوز لدائني الشركة مطالبة أحد الشركاء بوفاء ديون الشركة إلا بعد مرور خمسة عشر يوما من تاريخ إنذار الشركة بعقد غير قضائي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
