<https://legal.dz/resource/order/1975-09-26/75-59#version_art_742> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للشركة ولا للشركاء الاحتجاج بالبطلان تجاه الغير حسن النية . غير أن البطلان الناتج عن عدم الأهلية أو عيب في الرضاء ممكن الاحتجاج به حتى تجاه الغي، من طرف عديم الأهلية وممثليه الشرعيين، أو من طرف الشريك الذي انتزع رضاه بطريق الغلط أو التدليس أو العنف ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
