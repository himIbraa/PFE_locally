    dznorm:sourceArticle "art_585" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_586_condition_0_2eab9d31> a dznorm:Condition ;
    dznorm:conditionText "بموافقة أغلبية الشركاء التي تمثل ثلاثة أرباع رأسمال الشركة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_586> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_586_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_586> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يجوز إدخال أي تعديل على القانون الأساسي إلا بموافقة أغلبية الشركاء التي تمثل ثلاثة أرباع رأسمال الشركة ما لم يقض عقد التأسيس خلاف ذلك. غير انه لا يمكن في أي حال للأغلبية أن تلزم أحد الشركاء بزيادة حصته في رأس مال الشركة."@ar .

