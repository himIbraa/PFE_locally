    dzdoc:evidenceText "إذا تحققت الزيادة بصفة كلية أو جزئية بتقدمات عينية ، تطبق أحكام الفقرة الأولى من المادة 568 . يكون مديرو الشركة والأشخاص الذين اكتتبوا بزيادة رأس المال مسؤولين بالتضامن مدة خمس سنوات تجاه الغير بقيمة التقدمات العينية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_574_19750926_OpEnact_74e4e44b0f> ;
    dzdoc:replacementText "إذا تحققت الزيادة بصفة كلية أو جزئية بتقدمات عينية ، تطبق أحكام الفقرة الأولى من المادة 568 . يكون مديرو الشركة والأشخاص الذين اكتتبوا بزيادة رأس المال مسؤولين بالتضامن مدة خمس سنوات تجاه الغير بقيمة التقدمات العينية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
