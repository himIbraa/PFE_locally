<https://legal.dz/resource/order/1975-09-26/75-59#art_471_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_471> ;
    dzdoc:position 0 ;
    dzdoc:text "إن السندات لأمر الواجب دفعها بعد مدة من الإطلاع عليها يجب أن تعرض على محررها للتأشير عليها وذلك في الآجال المعينة (المادة 403) ، ويبتدىء الأجل الذي يحرر بعد الإطلاع من تاريخ التأشير الموقع من المحرر على السند فإذا امتنع المحرر عن وضع التأشير بتاريخه وجب إثبات امتناعه باحتجاج (المادة 405) ويكون تاريخه مبدأ سريان مدة الاطلاع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_472_obligation_0_13595aae> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_472_obligation_0_13595aae_role_c209286943> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_472> ;
    dznorm:position 0 ;
    dznorm:provisionText "يحتوي الشيك على البيانات الآتية :"@ar ;
    dznorm:sourceArticle "art_472" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_472_obligation_0_13595aae_role_c209286943> a dznorm:Role ;
    rdfs:label "البيانات الآتية"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يحتوي الشيك على البيانات الآتية :"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_472> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_472_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_472> ;
    dzdoc:position 0 ;
    dzdoc:text "يحتوي الشيك على البيانات الآتية : 1 - ذكر كلمة شيك مدرجة في نص السند نفسه باللغة التي كتب بها، 2 - أمر غير معلق على شرط بدفع مبلغ معين، 3 - اسم الشخص الذي يجب عليه الدفع (المسحوب عليه)، 4 - بيان المكان الذي يجب فيه الدفع، 5 - بيان تاريخ إنشاء الشيك ومكانه، 6 - توقيع من أصدر الشيك (الساحب)."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_473_condition_0_cb1da0a1> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_473_condition_0_cb1da0a1_ref_9062b04044fd> ;
