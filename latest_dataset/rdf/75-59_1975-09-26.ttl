<https://legal.dz/resource/order/1975-09-26/75-59#version_art_784> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وقع انحلال الشركة بأمر قضائي فإن هذا القرار يعين مصفيا واحدا أو أكثر. إذا عين عدة مصفين فإنه يجوز لهم ممارسة مهامهم على انفراد، وذلك باستثناء كل نص مخالف لأمر التسمية. إلا أن المصفين يتعين عليهم أن يضعوا ويقدموا تقريرا مشتركا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_784_19750926_OpEnact_c80b2ea37a> ;
    dzdoc:replacementText "إذا وقع انحلال الشركة بأمر قضائي فإن هذا القرار يعين مصفيا واحدا أو أكثر. إذا عين عدة مصفين فإنه يجوز لهم ممارسة مهامهم على انفراد، وذلك باستثناء كل نص مخالف لأمر التسمية. إلا أن المصفين يتعين عليهم أن يضعوا ويقدموا تقريرا مشتركا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_784> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
