<https://legal.dz/resource/order/1975-09-26/75-59#version_art_472> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحتوي الشيك على البيانات الآتية : 1 - ذكر كلمة شيك مدرجة في نص السند نفسه باللغة التي كتب بها، 2 - أمر غير معلق على شرط بدفع مبلغ معين، 3 - اسم الشخص الذي يجب عليه الدفع ( المسحوب عليه )، 4 - بيان المكان الذي يجب فيه الدفع، 5 - بيان تاريخ إنشاء الشيك ومكانه، 6 - توقيع من أصدر الشيك ( الساحب )."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_472_19750926_OpEnact_3a79c3e3da> ;
    dzdoc:replacementText "يحتوي الشيك على البيانات الآتية : 1 - ذكر كلمة شيك مدرجة في نص السند نفسه باللغة التي كتب بها، 2 - أمر غير معلق على شرط بدفع مبلغ معين، 3 - اسم الشخص الذي يجب عليه الدفع ( المسحوب عليه )، 4 - بيان المكان الذي يجب فيه الدفع، 5 - بيان تاريخ إنشاء الشيك ومكانه، 6 - توقيع من أصدر الشيك ( الساحب )."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_472> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_472> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
