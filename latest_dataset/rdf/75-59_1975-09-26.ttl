<https://legal.dz/resource/order/1975-09-26/75-59#art_628_obligation_3_3a927a98> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
