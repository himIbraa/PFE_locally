<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_24_right_2_a935e739> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_24> ;
    dznorm:position 2 ;
    dznorm:provisionText "حق متابعة التعويض عن كامل الضرر اللاحق بالشركة، وبالتعويضات التي يحكم لهم بها عند الاقتضاء"@ar ;
    dznorm:sourceArticle "art_715_bis_24" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_25_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_25> ;
    dzdoc:position 0 ;
    dzdoc:text "كل شرط في القانون الأساسي يقضي بجعل ممارسة دعوى الشركة مشروطا بأخذ الرأي المسبق للجمعية العامة أو إذنها أو يتضمن مبدئيا العدول عن ممارسة هذه الدعوى، يعد كأنه لم يكن."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_25_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_25> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا يكون لأي قرار صادر عن الجمعية العامة، أي أثر لانقضاء دعوى المسؤولية ضد القائمين بالإدارة لارتكابهم خطأ أثناء القيام بوكالتهم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_26_condition_0_5348bd86> a dznorm:Condition ;
    dznorm:conditionText "الفعل المرتكب إذا كان جناية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_26> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_26_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_26> ;
    dzdoc:position 0 ;
    dzdoc:text "تتقادم دعوى المسؤولية ضد القائمين بالإدارة مشتركة كانت أو فردية بمرور ثلاث سنوات، ابتداء من تاريخ ارتكاب العمل الضار ، أو من وقت العلم به إن كان قد أخفي. غير أن الفعل المرتكب إذا كان جناية فإن الدعوى في هذه الحالة تتقادم بمرور عشر سنوات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_27_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_27> ;
    dzdoc:position 0 ;
    dzdoc:text "في حالة التسوية القضائية للشركة أو إفلاسها، يمكن أن يكون الأشخاص، الذين أشارت إليهم الأحكام المتعلقة بالتسوية القضائية أو الإفلاس أو التفليس، مسؤولين عن ديون الشركة وفقا للشروط المنصوص عليها في الأحكام المذكورة."@ar .

