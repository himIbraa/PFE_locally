<https://legal.dz/resource/order/1975-09-26/75-59#version_art_249> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز القضاء بعدم التمسك قبل جماعة الدائنين للمدفوعات التي يؤديها المدين وفاء لديون حالة بعد التاريخ المحدد تطبيقا للمادة 247 وكذلك التصرفات بعوض التي يعقدها بعد ذلك التاريخ إن كان الذين تلقوا منه الوفاء أو تعاقدوا معه قاموا بذلك مع العلم بتوقفه عن الدفع ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_249_19750926_OpEnact_f475342ba1> ;
    dzdoc:replacementText "يجوز القضاء بعدم التمسك قبل جماعة الدائنين للمدفوعات التي يؤديها المدين وفاء لديون حالة بعد التاريخ المحدد تطبيقا للمادة 247 وكذلك التصرفات بعوض التي يعقدها بعد ذلك التاريخ إن كان الذين تلقوا منه الوفاء أو تعاقدوا معه قاموا بذلك مع العلم بتوقفه عن الدفع ."@ar ;
