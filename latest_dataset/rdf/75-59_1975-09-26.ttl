    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_732" ;
    dzdoc:fullText "تعتبر أية مساهمة، حتى ولو كانت أقل من 10 ، تحوزها شركة مراقبة، بأنها محيزة بصفة غير مباشرة من طرف الشركة التي تراقبها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_732> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_732_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_732_19750926_OpEnact_b4dca91144> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "732" ;
    dzdoc:position 934 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_740> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_740" ;
    dzdoc:fullText "تتقادم دعاوى بطلان الشركة أو الأعمال أو المداولات اللاحقة لتأسيسها بانقضاء أجل ثلاث سنوات اعتبارا من تاريخ حصول البطلان وذلك من دون إخلال بانقضاء الميعاد المنصوص عليه في الفقرة الأولى من المادة 738 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_740> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_740_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_740_19750926_OpEnact_cdec89546a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 740" ;
    dzdoc:position 947 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_738> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_738> ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_764> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_764" ;
    dzdoc:fullText "تطبق أحكام المواد 756 و 760 و 761 إذا كانت العمليات المشار إليها في المادة 744 تتضمن مساهمة الشركات المساهمة والشركات ذات المسؤولية المحدودة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_764> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_764_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_764_19750926_OpEnact_555f4c1b59> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "764" ;
    dzdoc:position 971 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_744>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_756>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_760>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_761> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_744>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_756>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_760>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_761> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_4> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "تكون باطلة وعديمة الأثر جميع الاشتراطات المخالفة بصفة مسبقة لما يلي: 1 - أحكام المواد 38 و 44 الفقرة 2 و 46 الفقرة 1 و 49 الفقرة 1 و 51 و 53 و 55 و 61 و 65 و 71 و 74 و 75 و 76 ، 2 - أحكام المواد 47 و 58 و 62 و 64 و 69 إلا إذا كانت الاشتراطات في كل من الحدود المرخص بها بموجب المواد 52 و 59 و 66 و 72 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_77> ;
