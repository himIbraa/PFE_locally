<https://legal.dz/resource/order/1975-09-26/75-59#art_434> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_8> ;
    dzdoc:eId "art_434" ;
    dzdoc:fullText "يجوز لمن سدد مبلغ السفتجة أن يطالب ضامنيه بكامل المبلغ الذي أوفاه وما دفعه من المصاريف ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_434_permission_0_cbead006> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_434_right_0_848f601a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_434> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_434_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_434_19750926_OpEnact_c51aa1fed4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 434" ;
    dzdoc:position 439 ;
    dzdoc:usesTerm dzterm:bill_of_exchange .

<https://legal.dz/resource/order/1975-09-26/75-59#art_440> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_8> ;
    dzdoc:eId "art_440" ;
    dzdoc:fullText "يعتبر تبليغ احتجاج لعدم الوفاء الذي تم بالمسحوب عليه لسفتجة مقبولة بمثابة أمر بالدفع. وإذا تعذر الدفع ضمن أجل عشرين يوما ابتداء من تاريخ التبليغ المقرر في الفقرة أعلاه ، يمكن للحامل القيام عن طريق أمر صادر في ذيل العريضة بحجز وبيع ممتلكات المسحوب عليه ضمن الشروط التي أقرها التشريع المعمول به . وفي حالة ظهور صعوبة يلتمس كاتب الضبط المكلف بالتنفيذ، قاضي الأمور المستعجلة طبقا لأحكام المادة 183 من قانون الإجراءات المدنية . يمكن لحامل السفتجة المحتج فيها لعدم الوفاء فضلا عما توجبه عليه الإجراءات المقررة برفع دعوى الضمان، أن يتخذ إجراءات تحفظية بعد ترخيص من القاضي إزاء الساحبين والمظهرين والضامنين لهم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_440_permission_0_f0ee5bde>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_440_permission_1_a5e881e0> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_440_right_0_702d804f>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_440_right_1_eee60287> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_440> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_440_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_440_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_440_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_440_para_3> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_440_19750926_OpEnact_abbcb0c83d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "440" ;
    dzdoc:position 445 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_440_extref_c995b561> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_440_condition_0_4d6624dd> ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:protest .

<https://legal.dz/resource/order/1975-09-26/75-59#art_461> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_12> ;
    dzdoc:eId "art_461" ;
    dzdoc:fullText "جميع الدعاوى الناشئة عن السفتجة والمرفوعة على قابلها تسقط بمضي ثلاثة أعوام من تاريخ الاستحقاق. وتسقط دعاوى الحامل ضد المظهرين أو الساحب بمضي عام واحد من تاريخ الاحتجاج المحرر في المدة القانونية أو من تاريخ الاستحقاق إذا كانت السفتجة مشتملة على شرط الرجوع بلا مصاريف . وتسقط دعاوى المظهرين على بعضهم بعضا أو على الساحب بعد مضي ستة أشهر ابتداء من اليوم الذي سدد فيه المظهر السفتجة أو من يوم رفع الدعوى عليه. لا تسرى مدة التقادم في حالة رفع الدعوى إلا من يوم آخر إجراء قضائي ولا يطبق التقادم إذا كان قد صدر حكم أو اعتراف بالدين بموجب إجراء مستقل . لا يكون لانقطاع التقادم من أثر إلا بالنسبة لمن اتخذ ضده الإجراء القاطع. على أن الأشخاص المدعى عليهم بالدين يلزمون عند الطلب بأداء اليمين على براءة ذمتهم ، كما يلزم ورثتهم أو خلفاؤهم على أن يؤدوا يمينا على أنهم يعتقدون عن حسن نية أنه لم يبق شيء من الدين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_461> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_461_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_461_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_461_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_461_para_3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_461_para_4>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_461_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_461_19750926_OpEnact_15f3432732> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_461_obligation_0_621538c3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_461_obligation_1_6b3aa4e8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "461" ;
    dzdoc:position 466 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_461_condition_0_d92b94cc>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_461_condition_1_6e0fdadc> ;
    dzdoc:usesTerm dzterm:bill_of_exchange .

<https://legal.dz/resource/order/1975-09-26/75-59#art_462> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_13> ;
    dzdoc:eId "art_462" ;
    dzdoc:fullText "إن السفتجة التي يحل أجل وفائها في يوم عيد رسمي لا يمكن المطالبة بها إلا في أول يوم عمل يليه ، وكذلك جميع الإجراءات المتعلقة بـ السفتجة ولا سيما تقديمها للقبول والاحتجاج فإنه لا يمكن القيام بهما إلا في أيام العمل . وإذا وجب القيام بأحد هذه الإجراءات في أجل معين يوافق آخر يوم منه يوم عيد رسمي فيمدد الأجل إلى أول يوم عمل يليه وتعتبر أيام العيد التي تتخلل الأجل في حساب مدته."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_462_permission_0_7a5faa06> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_462> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_462_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_462_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_462_19750926_OpEnact_bd7214a8de> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_462_obligation_0_cb297614>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_462_obligation_1_a798e2e0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_462_obligation_2_00dce719> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 462" ;
    dzdoc:position 467 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_462_condition_0_18e0b3b7>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_462_condition_1_58bac803> ;
    dzdoc:usesTerm dzterm:سفتجة .

<https://legal.dz/resource/order/1975-09-26/75-59#art_536> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:notification ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_9> ;
    dzdoc:eId "art_536" ;
    dzdoc:fullText "يعد تبليغ شهادة عدم الدفع لانعدام الرصيد أو نقصه لساحب الصك بمثابة أمر بالدفع . وفي حالة عدم الدفع ضمن أجل عشرين يوما ابتداء من تاريخ إصدار التبليغ المنصوص عليه في الفقرة السابقة يمكن لحامل الصك عن طريق القيام بأمر صادر في ذيل العريضة بحجز وبيع أملاك المسحوب عليه ضمن الشروط التي أقرها التشريع المعمول به وفي حالة وجود صعوبة ، يلتمس كاتب الضبط المكلف بالتنفيذ قاضي الأمور المستعجلة طبقا لأحكام المادة 183 من قانون الإجراءات المدنية . يجوز لحامل الصك المحتج عليه فضلا عن الإجراءات المقررة لممارسة دعوى الضمان أن يتخذ إجراءات تحفظية تجاه الساحبين والمظهرين والضامنين لهم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_536_permission_0_b0623b76>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_536_permission_1_ece2f65a> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_536_right_0_47e51c51>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_536_right_1_1264da72> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_536> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_536_defocc_1bcfe96831d9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_536_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_536_para_1>,
