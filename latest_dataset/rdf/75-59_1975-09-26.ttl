<https://legal.dz/resource/order/1975-09-26/75-59#art_228_obligation_4_a8f79a1e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/order/1975-09-26/75-59#art_228_obligation_4_a8f79a1e_period_17c985bd81> ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_228_obligation_4_a8f79a1e_ref_ce1336d16af2> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_228> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_228> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_228> ;
    dznorm:position 4 ;
    dznorm:provisionText "نشر البيانات التي تدرج بسجل التجارة، طبقا للفقرة الأولى من هذه المادة، في النشرة الرسمية للإعلانات القانونية خلال خمسة عشر يوما من النطق بالحكم"@ar ;
    dznorm:sourceArticle "art_228" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_228_obligation_4_a8f79a1e_period_17c985bd81> a dznorm:Period ;
