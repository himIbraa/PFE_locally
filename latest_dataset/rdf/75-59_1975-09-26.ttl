<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_10> ;
    dzdoc:eId "art_715_bis_24" ;
    dzdoc:fullText "يجوز للمساهمين، بالإضافة إلى دعوى التعويض عن الضرر الذي لحق بهم شخصيا ، أن يقيموا منفردين أو مجتمعين دعوى على الشركة بالمسؤولية ضد القائمين بالإدارة . وللمدعين حق متابعة التعويض عن كامل الضرر اللاحق بالشركة، وبالتعويضات التي يحكم لهم بها عند الاقتضاء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_24_permission_0_759c1094> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_24_right_0_15053996>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_24_right_1_6c97390a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_24_right_2_a935e739> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_24_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_24_19750926_OpEnact_025c3f299c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 24" ;
    dzdoc:position 798 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_56> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_56" ;
    dzdoc:fullText "إذا وقع اشتراط الموافقة في القانون الأساسي للشركة ، يتعين إبلاغ الشركة بطلب الاعتماد عن طريق رسالة موصى عليها مع وصل الاستلام يرسلها المساهم مع ذكر اسم المحال إليه ولقبه وعنوانه وعدد الأسهم المقرر إحالتها والثمن المعروض ، وتنتج الموافقة سواء من تبليغ طلب الاعتماد أو من عدم الجواب في أجل شهرين اعتبارا من تاريخ الطلب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_56> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_56_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_56_19750926_OpEnact_4435cdd3a4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_56_obligation_0_9bb1656d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 56" ;
    dzdoc:position 830 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_56_condition_0_05fdacdd> ;
    dzdoc:usesTerm dzterm:shares .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_7> ;
    dzdoc:eId "art_715_bis_7" ;
    dzdoc:fullText "يعين مندوبو الحسابات لثلاث سنوات مالية ، وتنتهي مهامهم بعد اجتماع الجمعية العامة العادية التي تفصل في حسابات السنة المالية الثالثة. يبقى مندوب الحسابات المعين من الجمعية بدل مندوب آخر يمارس وظيفته حتى انتهاء مهمة المندوب الذي استخلفه. وإذا أغفلت الجمعية تعيين مندوب للحسابات يجوز لكل مساهم أن يطلب من العدالة تعيين مندوب الحسابات ، ويبلغ قانونا بالحضور رئيس مجلس الإدارة أو مجلس المديرين وتنتهي المهمة الممنوحة عندما تقوم الجمعية العامة بتعيين مندوب أو مندوبي الحسابات."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_7_permission_0_134e5ea3> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_7_right_0_6a70644d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_7_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_7_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_7_19750926_OpEnact_3825a3019a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_7_obligation_0_e609721f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 7" ;
    dzdoc:position 781 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_7_condition_0_5b0f6793> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_95> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_95" ;
    dzdoc:fullText "يجب أن يحدد صاحب الاستدعاء جدول أعمال الجمعية العامة لأصحاب سندات الاستحقاق غير أنه يجوز لأصحاب سندات الاستحقاق أن يطلبوا بصفة فردية أو جماعية، إدراج مشاريع لوائح في جدول الأعمال تخضع فورا لتصويت الجمعية العامة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_95_permission_0_4bd8886d> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_95_right_0_3b73cdf4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_95> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_95_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_95_19750926_OpEnact_e08b308e7c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_95_obligation_0_a71d0aa9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 95" ;
    dzdoc:position 869 ;
    dzdoc:usesTerm dzterm:bondholders .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:partnership_limited_by_shares ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_bis> ;
    dzdoc:eId "art_715_ثالثا" ;
    dzdoc:fullText "تؤسس شركة التوصية بالأسهم التي يكون رأسمالها مقسما إلى أسهم، بين شريك متضامن أو أكثر له صفة تاجر ومسؤول دائما وبصفة متضامنة عن ديون الشركة وشركاء موصين لهم صفة مساهمين ولا يتحملون الخسائر إلا بما يعادل حصصهم. لا يمكن أن يكون عدد الشركاء الموصين أقل من ثلاثة (03) ولا يذكر أسهم في اسم الشركة. تطبق القواعد المتعلقة بشركات التوصية البسيطة وشركات المساهمة باستثناء المواد 610 إلى 673 المذكورة أعلاه، على شركات التوصية بالأسهم ما دامت تتطابق مع الأحكام الخاصة المنصوص عليها في هذا الفصل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_permission_0_d80712d8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_defocc_5a2c2d9e8d21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_19750926_OpEnact_ed6ea33de4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 ثالثا" ;
    dzdoc:position 907 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_610>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_673> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_610>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_673> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_condition_0_85ce36a4> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_bis> ;
    dzdoc:eId "art_715_ثالثا_9" ;
    dzdoc:fullText "لا يتحمل أعضاء مجلس المراقبة أية مسؤولية تتعلق بأعمال التسيير والنتائج المترتبة عنها. ويمكن اعتبار أعضاء مجلس المراقبة مسؤولين مدنيا عن الجنح التي ارتكبها المسيرون، إذا كانوا على علم بذلك ولم يصرحوا بها إلى الجمعية العامة . ويكونون مسؤولين عن الأخطاء الشخصية المرتكبة خلال مدة وكالتهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_9_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_9_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_9_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715___9_19750926_OpEnact_8f76e1f2a1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_9_obligation_0_249f4650> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 ثالثا 9" ;
    dzdoc:position 916 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_9_condition_0_3ebdf301> ;
    dzdoc:usesTerm dzterm:supervisory_board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_722> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:distributable_profits ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_722" ;
    dzdoc:fullText "تكون الأرباح القابلة للتوزيع، من الربح الصافي للسنة المالية، وبزيادة الأرباح المنقولة ولكن بعد أن تطرح من الاقتطاع المنصوص عليه في المادة 721 ، حصة الأرباح الآيلة للعمال والخسائر السابقة. ويجوز للجمعية العامة، علاوة على ذلك، أن تقرر توزيع المبالغ المقتطعة من الاحتياطي الموضوع تحت تصرفها ، وفي هذه الحالة يبين في القرار صراحة عنوان الاحتياطي الذي وقع الاقتطاع فيه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_722_right_0_b9c1c88e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_722> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_722_defocc_88818e6a7c59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_722_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_722_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_722_19750926_OpEnact_4076ae9579> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "722" ;
    dzdoc:position 924 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_721> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_721> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_732_bis" ;
    dzdoc:fullText "عندما تراقب شركة مساهمة شركة أخرى، بصفة غير مباشرة ، لا يجوز لهذه الأخيرة امتلاك أكثر من 50% من رأسمال الشركة الأولى ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_permission_0_3eb907e1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_732_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_732_bis_19750926_OpEnact_2e9cd89467> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_obligation_0_60c0fe8f> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_prohibition_0_3eb907e1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "732 مكرر" ;
    dzdoc:position 935 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_condition_0_62b0cf21> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_742> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_742" ;
    dzdoc:fullText "لا يجوز للشركة ولا للشركاء الاحتجاج بالبطلان تجاه الغير حسن النية . غير أن البطلان الناتج عن عدم الأهلية أو عيب في الرضاء ممكن الاحتجاج به حتى تجاه الغي، من طرف عديم الأهلية وممثليه الشرعيين، أو من طرف الشريك الذي انتزع رضاه بطريق الغلط أو التدليس أو العنف ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_742_permission_0_60e1585b> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_742_right_0_b72ca10a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_742> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_742_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_742_19750926_OpEnact_ee0001a779> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_742_obligation_0_251d6f40> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_742_prohibition_0_60e1585b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 742" ;
    dzdoc:position 949 ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_744> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_744" ;
    dzdoc:fullText "للشركة ولو في حالة تصفيتها، أن تدمج في شركة أخرى أو أن تساهم في تأسيس شركة جديدة بطريقة الدمج . كما لها أن تقدم ماليتها لشركات موجودة أو تساهم معها في إنشاء شركات جديدة بطريقة الإدماج والانفصال. كما لها أخيرا أن تقدم رأسمالها لشركات جديدة بطريقة الانفصال."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_744_right_0_2d4374c5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_744> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_744_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_744_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_744_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_744_19750926_OpEnact_26b589e192> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "744" ;
    dzdoc:position 951 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_751> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_751" ;
    dzdoc:fullText "يضع ويقدم مندوبو الحسابات لكل شركة، ويساعدهم عند الاقتضاء خبراء يختارونهم، تقريرا عن طرق الإدماج وخاصة عن مكافأة الحصص المقدمة للشركة المدمجة . ولأجل ذلك يسوغ لمندوبي الحسابات الاطلاع على كافة المستندات المفيدة، لدى كل شركة معنية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_751_right_0_8ad147ce> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_751> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_751_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_751_19750926_OpEnact_ffa7283c79> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_751_obligation_0_31d182b8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "751" ;
    dzdoc:position 958 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_760> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_760" ;
    dzdoc:fullText "تكون الشركات المستفيدة من الحصص الناتجة عن الانفصال مدينة بالتضامن تجاه دائني الشركة المنفصلة، في المحل والمكان دون أن يترتب عن هذا الحلول تجديد بالنسبة لهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_760> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_760_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_760_19750926_OpEnact_9b07e655a8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_760_obligation_0_ea546a21> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "760" ;
    dzdoc:position 967 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_82> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_82" ;
    dzdoc:fullText "عند التخلي يوقع البائع والمشتري جميع الدفاتر الحسابية التي كان يمسكها البائع والتي يرجع ضبطها إلى السنوات الثلاث السابقة للبيع أو لمدة حيازته للمحل التجاري إذا كانت هذه الحيازة لم تستمر ثلاث سنوات . وتكون هذه الدفاتر موضوع قائمة جرد توقع من قبل الأطراف وتسلم نسخة لكل واحد منهم. وعلى المحيل أن يضع هذه الدفاتر تحت تصرف المشتري لمدة ثلاث سنوات من تاريخ بدء انتفاعه بالمحل التجاري . ويعتبر لاغيا كل شرط مخالف لما جاء في عقد التنازل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_82> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_82_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_82_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_82_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_82_19750926_OpEnact_d2f5c283e1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_82_obligation_0_97d54570>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_82_obligation_1_499611de> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "82" ;
    dzdoc:position 84 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_838> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_838" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 20.000 دج إلى 200.000 دج أو بإحدى هاتين العقوبتين فقط ، مصفي الشركة الذي : 1- لم يقم عمدا في ظرف شهر من تعيينه بنشر الأمر المتضمن تعيينه مصفيا بجريدة خاصة لقبول الإعلانات القانونية بالولاية التي يوجد بها ولم يودع بالسجل التجاري القرارات التي قضت بالحل 2- ولم يستدع عمدا الشركاء في نهاية التصفية لأجل البت في الحساب النهائي وعلى إبراء إدارته وإخلاء ذمته من توكيله وإثبات اختتام التصفية أو لم يضع حساباته بكتابة المحكمة ولم يطلب من القضاء المصادقة عليها وذلك في الحالة المنصوص عليها في المادة 774 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_838> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_838_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_838_19750926_OpEnact_292dc687de> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_838_obligation_0_4ab1fcef> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "838" ;
    dzdoc:position 1055 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_774> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_774> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_838_condition_0_6d8936cc> ;
    dzdoc:usesTerm dzterm:liquidator .

<https://legal.dz/resource/order/1975-09-26/75-59#art_94> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_94" ;
    dzdoc:fullText "إذا لم يكن للمعارضة سند ولا سبب أو كانت باطلة شكلا ولم ترفع دعوى أصلية فإنه يجوز للبائع رفع دعوى مستعجلة لدى رئيس المحكمة للحصول على إذن بقبض ثمن البيع بالرغم من المعارضة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_94_permission_0_673c3ddf> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_94_right_0_b410e1fc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_94> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_94_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_94_19750926_OpEnact_cf104c32eb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "94" ;
    dzdoc:position 96 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_94_condition_0_4b3465e5> ;
    dzdoc:usesTerm dzterm:seller .

