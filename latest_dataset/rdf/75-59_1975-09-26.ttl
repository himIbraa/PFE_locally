<https://legal.dz/resource/order/1975-09-26/75-59#version_art_277> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمدين في حالة التسوية القضائية ، وبمعونة وكيل التفليسة وإذن القاضي المنتدب ، متابعة استغلال مؤسسته التجارية والصناعية . وفي حالة الإفلاس ، إذا ارتأى وكيل التفليسة استغلال المحل التجاري ، لا يكون له هذا إلا بعد إذن المحكمة بناء على تقرير القاضي المنتدب بإثبات أن المصلحة العامة أو مصلحة الدائنين تقضي ضرورة ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_277_19750926_OpEnact_e796d20b54> ;
    dzdoc:replacementText "يجوز للمدين في حالة التسوية القضائية ، وبمعونة وكيل التفليسة وإذن القاضي المنتدب ، متابعة استغلال مؤسسته التجارية والصناعية . وفي حالة الإفلاس ، إذا ارتأى وكيل التفليسة استغلال المحل التجاري ، لا يكون له هذا إلا بعد إذن المحكمة بناء على تقرير القاضي المنتدب بإثبات أن المصلحة العامة أو مصلحة الدائنين تقضي ضرورة ذلك ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
