    dzdoc:replacementText "لا تطبق أحكام المادة 441 من القانون المدني والمتعلقة بالحل القضائي في حالة اجتماع كل حصص شركة ذات مسؤولية محدودة في يد واحدة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_590_bis_1> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_590_bis_1> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_590_bis_2> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز لشخص طبيعي أن يكون شريكا وحيدا إلا في شركة واحدة ذات مسؤولية محدودة . و لا يجوز لشركة ذات مسؤولية محدودة أن يكون لها كشريك وحيد شركة أخرى ذات مسؤولية محدودة مكونة من شخص واحد . وفي حالة الإخلال بأحكام الفقرة السابقة ، فلكل من يعنيه الأمر أن يطلب حل الشركات المؤسسة بطريقة غير شرعية ، و إذا كان ذلك ناتجا عن اجتماع كل حصص الشركة في يد واحدة ، لا يسوغ تقديم طلب حل شركة قبل سنة من جمع الحصص عندما يجمع شريك واحد كل الحصص في شركة فيها أكثر من شريك . وفي جميع الحالات، يمكن المحكمة منح أجل أقصاه "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_590_bis_2_19750926_OpEnact_5e70d7dd46> ;
    dzdoc:replacementText "لا يجوز لشخص طبيعي أن يكون شريكا وحيدا إلا في شركة واحدة ذات مسؤولية محدودة . و لا يجوز لشركة ذات مسؤولية محدودة أن يكون لها كشريك وحيد شركة أخرى ذات مسؤولية محدودة مكونة من شخص واحد . وفي حالة الإخلال بأحكام الفقرة السابقة ، فلكل من يعنيه الأمر أن يطلب حل الشركات المؤسسة بطريقة غير شرعية ، و إذا كان ذلك ناتجا عن اجتماع كل حصص الشركة في يد واحدة ، لا يسوغ تقديم طلب حل شركة قبل سنة من جمع الحصص عندما يجمع شريك واحد كل الحصص في شركة فيها أكثر من شريك . وفي جميع الحالات، يمكن المحكمة منح أجل أقصاه ستة (6) أشهر لتسوية الوضعية في حين لا يمكن الحكم بالحل إذا تمت التسوية يوم النظر في الموضوع ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_590_bis_2> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_590_bis_2> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_591> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
