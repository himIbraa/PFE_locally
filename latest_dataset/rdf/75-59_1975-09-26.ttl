<https://legal.dz/resource/order/1975-09-26/75-59#art_683_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_683> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا رفضت الشركة تبليغ الوثائق كليا أو جزئيا خلافا لأحكام المواد 677 و 678 و 680 و 682 أعلاه، فيجوز للجهة القضائية المختصة التي تفصل في هذا الشأن بنفس طريقة الاستعجال أن تأمر بناء على طلب المساهم الذي رفض طلبه، الشركة بتبليغ هذه الوثائق تحت طائلة الإكراه المالي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_684_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_684> ;
    dzdoc:position 0 ;
    dzdoc:text "مع مراعاة الأحكام الواردة في المادتين 603 و 685، يكون حق التصويت المرتبط بأسهم رأس المال أو الانتفاع متناسبا مع حصة رأس المال التي تنوب عنها. ولكل سهم صوت على الأقل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_684_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_684> ;
    dzdoc:position 1 ;
    dzdoc:text "ويعتبر كل شرط مخالف لذلك كأن لم يكن."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_684_right_0_cbcb0dc6> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_684> ;
    dznorm:position 0 ;
    dznorm:provisionText "حق التصويت المرتبط بأسهم رأس المال أو الانتفاع متناسبا مع حصة رأس المال التي تنوب عنها"@ar ;
    dznorm:sourceArticle "art_684" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_685_condition_0_af1c92c3> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_685_condition_0_af1c92c3_role_cc653bd67f> ;
    dznorm:conditionText "بشرط أن يفرض هذا التحديد على جميع الأسهم دون تمييز فئة عن أخرى"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_685> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_685_condition_0_af1c92c3_role_cc653bd67f> a dznorm:Role ;
    rdfs:label "جميع الأسهم دون تمييز"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "بشرط أن يفرض هذا التحديد على جميع الأسهم دون تمييز فئة عن أخرى"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_685> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_685_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_685> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز أن يحدد القانون الأساسي عدد الأصوات التي يحوزها كل مساهم في الجمعيات، بشرط أن يفرض هذا التحديد على جميع الأسهم دون تمييز فئة عن أخرى."@ar .

