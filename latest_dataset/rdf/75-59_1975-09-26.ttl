    dzdoc:sourceTextSpan "ويجب على الحامل أن يبادر دون إبطاء بإخطار المظهر له بالقوة القاهرة وأن يضمن هذا الإخطار على السفتجة أو الورقة المتصلة بها وأن يؤرخه ويوقع عليه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_438> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_438_obligation_1_fe6885d9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_438_obligation_1_fe6885d9_role_a098fba9a4> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_438> ;
    dznorm:position 1 ;
    dznorm:provisionText "وعلى الحامل أن يبادر بعد زوال القوة القاهرة ودون إبطاء إلى تقديم السفتجة للقبول أو الوفاء أو الاحتجاج عند الاقتضاء"@ar ;
    dznorm:sourceArticle "art_438" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_438_obligation_1_fe6885d9_role_a098fba9a4> a dznorm:Role ;
    rdfs:label "الحامل أن يبادر بعد"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "وعلى الحامل أن يبادر بعد زوال القوة القاهرة ودون إبطاء إلى تقديم السفتجة للقبول أو الوفاء أو الاحتجاج عند الاقتضاء"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_438> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_438_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_438> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا حال دون تقديم السفتجة أو تقديم الاحتجاج في المهل المقررة حائل لا يمكن التغلب عليه وكان عرض السفتجة أو تحرير الاحتجاج في الآجال المعينة كوجود نص قانوني لحالة ما أو غير ذلك من ظروف القوة القاهرة، فتمتد هذه المواعيد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_438_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_438> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجب على الحامل أن يبادر دون إبطاء بإخطار المظهر له بالقوة القاهرة وأن يضمن هذا الإخطار على السفتجة أو الورقة المتصلة بها وأن يؤرخه ويوقع عليه وتطبق فيما بقي أحكام المادة 430."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_438_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_438> ;
    dzdoc:position 2 ;
    dzdoc:text "وعلى الحامل أن يبادر بعد زوال القوة القاهرة ودون إبطاء إلى تقديم السفتجة للقبول أو الوفاء أو الاحتجاج عند الاقتضاء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_438_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_438> ;
    dzdoc:position 3 ;
    dzdoc:text "وإذا استمرت القوة القاهرة أكثر من ثلاثين يوما ابتداء من الاستحقاق، جاز رفع دعوى الرجوع بدون حاجة لتقديم السفتجة أو تحرير الاحتجاج ما لم تكن هذه الدعوى معلقة لأمد أطول تطبيقا للقانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_438_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_438> ;
    dzdoc:position 4 ;
    dzdoc:text "وبالنسبة للسفاتج الواجبة الوفاء لدى الإطلاع أو بعد مدة معينة لدى الإطلاع فإن مدة الثلاثين يوما تسري من تاريخ اليوم الذي أخطر فيه الحامل المظهر له بحدوث القوة القاهرة حتى ولو كان قبل انقضاء آجال التقديم، وبالنسبة للسفاتج الواجبة الوفاء بعد أجل معين من الإطلاع فتضاف مدة الثلاثين يوما إلى مدة أجل الإطلاع المعين بالسفتجة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_438_permission_0_e838594d> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_438_permission_0_e838594d_action_89ae2248c2> ;
