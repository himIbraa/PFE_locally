<https://legal.dz/resource/order/1975-09-26/75-59#art_130_obligation_1_42a72dcc> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_130_obligation_1_42a72dcc_action_54413a36c2> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_130> ;
    dznorm:position 1 ;
    dznorm:provisionText "ويجب تقدير الثمن بالنسبة لمختلف عناصر المحل التجاري التي لم تشملها الامتيازات المقيدة"@ar ;
    dznorm:sourceArticle "art_130" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_130_obligation_1_42a72dcc_action_54413a36c2> a dznorm:Action ;
    rdfs:label "تقدير الثمن بالنسبة لمختلف عناصر"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "ويجب تقدير الثمن بالنسبة لمختلف عناصر المحل التجاري التي لم تشملها الامتيازات المقيدة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_130> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_130_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_130> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يجوز البيع على حدة لواحد أو أكثر من عناصر المحل التجاري المثقل بقيود، إذا كان طلب البيع بموجب حجز تنفيذي أو بمقتضى هذا القانون إلا بعد عشرين يوما على الأقل من تاريخ تبليغ الملاحقة للدائنين في محل الإقامة المختار منهم في القيود والذين أتموا تقييدهم قبل ذلك التبليغ بخمسة عشر يوما على الأقل. ويمكن خلال مهلة العشرين يوما المذكورة لكل دائن مقيد حل أجل دينه أو لم يحل، أن يرفع دعوى على المعنيين أمام المحكمة التي يستغل في دائرة اختصاصها المحل التجاري ويطلب فيها الشروع في بيع جميع عناصر المحل التجاري بناء على طلب القائم بالتنفيذ أو بناء على عريضة ذاتها وذلك وفقا للأحكام المبينة في المواد 125 و126 و 127 أعلاه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_130_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_130> ;
    dzdoc:position 1 ;
    dzdoc:text "ويحصل بيع المعدات والبضائع مع المحل التجاري في وقت واحد بالأثمان الأساسية المتميزة أو بأثمان متميزة إذا ورد بدفتر الشروط ما يوجب على الراسي عليه المزاد تسلمها بالثمن الذي يقدره الخبراء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_130_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_130> ;
    dzdoc:position 2 ;
    dzdoc:text "ويجب تقدير الثمن بالنسبة لمختلف عناصر المحل التجاري التي لم تشملها الامتيازات المقيدة."@ar .

