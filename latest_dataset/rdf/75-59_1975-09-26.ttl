<https://legal.dz/resource/order/1975-09-26/75-59#art_250_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_250> ;
    dzdoc:position 0 ;
    dzdoc:text "إن عدم التمسك المنصوص عليه في المادتين 247 فقرة 3 و 251 لا يمس صحة وفاء سفتجة أو سند لأمر أو شيك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_250_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_250> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أن لجماعة الدائنين أن ترفع دعوى رد المال إلى التفليسة ضد ساحب السفتجة، أو في حالة السحب لأجل الحساب ضد الأمر بالسحب وكذلك ضد المستفيد من الشيك وأول مظهر للسند لأمر، بشرط إقامة الدليل على أن المطالب برد المال كان عالما بالتوقف على الدفع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_250_right_0_58de86dc> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
