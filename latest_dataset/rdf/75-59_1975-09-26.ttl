<https://legal.dz/resource/order/1975-09-26/75-59#version_art_592> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "شركة المساهمة هي الشركة التي ينقسم رأسمالها إلى حصص، وتتكون من شركاء لا يتحملون الخسائر إلا بقدر حصتهم . ولا يمكن أن يقل عدد الشركاء عن سبعة (7) . ولا يطبق الشرط المذكور في المقطع 2 أعلاه على الشركات ذات رؤوس أموال عمومية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_592_19750926_OpEnact_ec4975c3dc> ;
    dzdoc:replacementText "شركة المساهمة هي الشركة التي ينقسم رأسمالها إلى حصص، وتتكون من شركاء لا يتحملون الخسائر إلا بقدر حصتهم . ولا يمكن أن يقل عدد الشركاء عن سبعة (7) . ولا يطبق الشرط المذكور في المقطع 2 أعلاه على الشركات ذات رؤوس أموال عمومية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_592> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_592> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
