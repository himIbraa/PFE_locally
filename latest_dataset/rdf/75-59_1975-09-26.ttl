    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_344> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجري بغير إبطاء تحقيق ما يقدم من مستندات الديون عملا بالمادة السابقة"@ar ;
    dznorm:sourceArticle "art_344" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_344_obligation_0_1b628b88_ref_912b10b79b2c> a dzdoc:Reference ;
    rdfs:label "المادة السابقة"@ar ;
    dzdoc:frbrUri "#art_343"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1975-09-26/75-59#art_343> ;
    dzdoc:sourceEId "art_344" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يجري بغير إبطاء تحقيق ما يقدم من مستندات الديون عملا بالمادة السابقة"@ar ;
    dzdoc:targetEId "art_343" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_344_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_344> ;
    dzdoc:position 0 ;
    dzdoc:text "يجري بغير إبطاء تحقيق ما يقدم من مستندات الديون عملا بالمادة السابقة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_344_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_344> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا يكون ثمة محل لتحقيق جديد للديون السابق قبولها بغير إخلال مع ذلك برفض أو تخفيض الديون التي قد تكون من ذلك الحين قد وفيت كليا أو جزئيا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_345_extref_01dc79ca> a dzdoc:ExternalReference ;
    rdfs:label "المادة 103 من القانون المدني"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1975-09-26/75-58#art_103"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1975-09-26/75-58#art_103"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1975-09-26/75-58#art_103" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1975-09-26/75-58"^^xsd:anyURI ;
    dzdoc:targetEId "art_103" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_345_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_345> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يبطل ما أجراه المدين من أعمال بعد حكم التصديق وقبل إبطال أو فسخ الصلح إلا ما جرى منه تدليسا بحقوق الدائنين وطبقا لأحكام المادة 103 من القانون المدني."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_346_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_346> ;
    dzdoc:position 0 ;
    dzdoc:text "تعود للدائنين السابقين على الصلح حقوقهم بأكملها في مواجهة المدين وحده ولكنهم لا يدرجون ضمن جماعة الدائنين إلا بالنسب التالية: ديونهم كاملة ، إن كانوا لم يقبضوا شيئا من ديونهم، جزء من ديونهم الأصلية مناسب لشطر الحصة الذي لم يستوفوه إن كانوا قد قبضوا جزءا من حصتهم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_346_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_346> ;
    dzdoc:position 1 ;
    dzdoc:text "وتطبق أحكام هذه المادة في حالة افتتاح تفليسة أو تسوية قضائية ثانية دون أن يسبق هذا إبطال أو فسخ للصلح."@ar .

