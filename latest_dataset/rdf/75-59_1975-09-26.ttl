<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4> ;
    dzdoc:position 0 ;
    dzdoc:text "يتمتع المسير بأوسع السلطات للتصرف باسم الشركة في كل الظروف."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4> ;
    dzdoc:position 1 ;
    dzdoc:text "يخضع المسير لنفس الالتزامات التي يخضع لها مجلس إدارة شركات المساهمة، مع مراعاة أحكام هذا الفصل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4> ;
    dzdoc:position 2 ;
    dzdoc:text "وفي إطار العلاقات مع الغير، تلتزم الشركة حتى بأعمال المسير التي لا تخضع لموضوع الشركة إلا إذا توصلت إلى إثبات أن الغير كان على إطلاع بأن نشاط المسير بعيد عن موضوعها أو لا يمكنه تجاهله نظرا للظروف مع استثناء أن مجرد نشر القانون الأساسي يكفي وحده لتأسيس هذه البينة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4> ;
    dzdoc:position 3 ;
    dzdoc:text "تكون بنود القانون الأساسي التي تحد سلطات المسير والمترتبة عن هذه المادة، غير قابلة للاحتجاج بها على الغير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4_right_0_69ea3708> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتمتع المسير بأوسع السلطات للتصرف باسم الشركة في كل الظروف"@ar ;
    dznorm:sourceArticle "art_715_ثالثا_4" .

