<https://legal.dz/resource/order/1975-09-26/75-59#version_art_813> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالغرامة من 20.000 دج إلى 200.000 دج الرئيس و القائمون بالإدارة أو المديرون العامون للشركة المساهمة والذين: يتخلفون في كل سنة مالية عن وضع حساب الاستغلال العام وحساب النتائج والجرد والميزانية والتقرير الكتابي عن حالة الشركة ونشاطها أثناء السنة المنصرمة، يتخلفون في إعداد هاته المستندات عن استعمال نفس الأشكال وطرق التقدير المتبعة في السنين السابقة وذلك مع مراعاة التعديلات المقدمة طبقا ل المادة 548 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_813_19750926_OpEnact_e724cb154a> ;
    dzdoc:replacementText "يعاقب بالغرامة من 20.000 دج إلى 200.000 دج الرئيس و القائمون بالإدارة أو المديرون العامون للشركة المساهمة والذين: يتخلفون في كل سنة مالية عن وضع حساب الاستغلال العام وحساب النتائج والجرد والميزانية والتقرير الكتابي عن حالة الشركة ونشاطها أثناء السنة المنصرمة، يتخلفون في إعداد هاته المستندات عن استعمال نفس الأشكال وطرق التقدير المتبعة في السنين السابقة وذلك مع مراعاة التعديلات المقدمة طبقا ل المادة 548 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_813> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
