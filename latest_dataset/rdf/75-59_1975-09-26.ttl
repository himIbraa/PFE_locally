<https://legal.dz/resource/order/1975-09-26/75-59#version_art_738> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة بطلان شركة أو أعمال أو مداولات لاحقة لتأسيسها مبني على عيب في الرضاء أو فقد أهلية شريك، وإذا كان التصحيح ممكنا ، يجوز لكل شخص يهمه الأمر أن ينذر الشخص الجدير بهذا الإجراء، إما بالقيام بالتصحيح أو برفع دعوى البطلان في أجل ستة أشهر تحت طائلة انقضاء الميعاد ويتعين إبلاغ الشركة بهذا الإنذار. يجوز للشركة أو أحد الشركاء أن يعرض على المحكمة التي تتولى الحكم في الأجل المنصوص عليه في المادة المتقدمة ، كل إجراء من شأنه أن يزيل مصلحة المدعي خصوصا بشراء حقوقه في الشركة . وفي هذه الحالة يسوغ للمحكمة "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_738_19750926_OpEnact_a9b3fae5b7> ;
    dzdoc:replacementText "في حالة بطلان شركة أو أعمال أو مداولات لاحقة لتأسيسها مبني على عيب في الرضاء أو فقد أهلية شريك، وإذا كان التصحيح ممكنا ، يجوز لكل شخص يهمه الأمر أن ينذر الشخص الجدير بهذا الإجراء، إما بالقيام بالتصحيح أو برفع دعوى البطلان في أجل ستة أشهر تحت طائلة انقضاء الميعاد ويتعين إبلاغ الشركة بهذا الإنذار. يجوز للشركة أو أحد الشركاء أن يعرض على المحكمة التي تتولى الحكم في الأجل المنصوص عليه في المادة المتقدمة ، كل إجراء من شأنه أن يزيل مصلحة المدعي خصوصا بشراء حقوقه في الشركة . وفي هذه الحالة يسوغ للمحكمة إما أن تقضي بالبطلان أو بموجب الإجراءات المعروضة، إذا وافقت عليها الشركة مسبقا ضمن الشروط المقررة لتعديلات القانون الأساسي . ولا تأثير لتصويت الشريك المطلوب شراء حقوقه من جديد على قرار الشركة. وعند التنازع تقدر قيمة الحقوق في الشركة الواجب دفعها للشريك بمقتضى الفقرة الثالثة من المادة 578 من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_738> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_738> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_739> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان بطلان أعمال ومداولات لاحقة لتأسيس الشركة مبنيا على مخالفة قواعد النشر ، لكل شخص يهمه أمر تصحيح العمل أن ينذر الشركة بالقيام بهذا التصحيح في أجل ثلاثين يوما . و إذا يقع التصحيح في هذا الأجل ، يجوز لكل شخص يهمه الأمر أن يطلب من القضاء تعيين وكيل يكلف بالقيام بهذا الإجراء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_739_19750926_OpEnact_e546ba4d7a> ;
    dzdoc:replacementText "إذا كان بطلان أعمال ومداولات لاحقة لتأسيس الشركة مبنيا على مخالفة قواعد النشر ، لكل شخص يهمه أمر تصحيح العمل أن ينذر الشركة بالقيام بهذا التصحيح في أجل ثلاثين يوما . و إذا يقع التصحيح في هذا الأجل ، يجوز لكل شخص يهمه الأمر أن يطلب من القضاء تعيين وكيل يكلف بالقيام بهذا الإجراء ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_739> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
