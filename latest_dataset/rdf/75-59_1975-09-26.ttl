<https://legal.dz/resource/order/1975-09-26/75-59#version_art_3> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد عملا تجاريا بحسب شكله التعامل بالسفتجة بين كل الأشخاص، الشركات التجارية، وكالات ومكاتب الأعمال مهما كان هدفها، العمليات المتعلقة بالمحلات التجارية كل عقد تجاري يتعلق بالتجارة البحرية والجوية."@ar ;
