<https://legal.dz/resource/order/1975-09-26/75-59#version_art_346> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعود للدائنين السابقين على الصلح حقوقهم بأكملها في مواجهة المدين وحده ولكنهم لا يدرجون ضمن جماعة الدائنين إلا بالنسب التالية: ديونهم كاملة ، إن كانوا لم يقبضوا شيئا من ديونهم، جزء من ديونهم الأصلية مناسب لشطر الحصة الذي لم يستوفوه إن كانوا قد قبضوا جزءا من حصتهم. وتطبق أحكام هذه المادة في حالة افتتاح تفليسة أو تسوية قضائية ثانية دون أن يسبق هذا إبطال أو فسخ للصلح."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_346_19750926_OpEnact_51bb5d34b0> ;
    dzdoc:replacementText "تعود للدائنين السابقين على الصلح حقوقهم بأكملها في مواجهة المدين وحده ولكنهم لا يدرجون ضمن جماعة الدائنين إلا بالنسب التالية: ديونهم كاملة ، إن كانوا لم يقبضوا شيئا من ديونهم، جزء من ديونهم الأصلية مناسب لشطر الحصة الذي لم يستوفوه إن كانوا قد قبضوا جزءا من حصتهم. وتطبق أحكام هذه المادة في حالة افتتاح تفليسة أو تسوية قضائية ثانية دون أن يسبق هذا إبطال أو فسخ للصلح."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_346> ;
