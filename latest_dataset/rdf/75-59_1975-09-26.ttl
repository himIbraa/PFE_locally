<https://legal.dz/resource/order/1975-09-26/75-59#version_art_95> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تبرأ ذمة المشتري قبل الغير إذا لم يقم بعمليات النشر ضمن الأشكال المقررة، أو إذا كان قد دفع الثمن للبائع قبل انقضاء خمسة عشر يوما ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_95_19750926_OpEnact_6059b67923> ;
    dzdoc:replacementText "لا تبرأ ذمة المشتري قبل الغير إذا لم يقم بعمليات النشر ضمن الأشكال المقررة، أو إذا كان قد دفع الثمن للبائع قبل انقضاء خمسة عشر يوما ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_95> ;
