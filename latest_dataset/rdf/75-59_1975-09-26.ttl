    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_91_permission_0_9c3d73cb_action_f4d347a31f> ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_91_permission_0_9c3d73cb_role_caf9ab3db4> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_91> ;
    dznorm:position 0 ;
    dznorm:provisionText "عند حصول المعارضة في دفع الثمن يمكن للبائع في كل الأحوال وبعد انقضاء مهلة خمسة عشر يوما ابتداء من رفع تلك المعارضة، أن يرفع دعوى مستعجلة أمام رئيس المحكمة طالبا فيها الإذن له بقبض الثمن بالرغم من المعارضة على شرط أن يدفع لمصلحة الودائع والأمانات أو للغير المنتدب لهذا الغرض المبلغ الكافي الذي يعينه قاضي الأمور المستعجلة لضمان أسباب المعارضة فيما إذا ظهر أو حكم عليه بأنه مدين."@ar ;
    dznorm:sourceArticle "art_91" .

