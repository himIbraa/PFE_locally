<https://legal.dz/resource/order/1975-09-26/75-59#version_art_464> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يدخل في حساب المواعيد القانونية أو الاتفاقية اليوم المعين لابتداء سريانها . ولا يجوز منح أجال قانونية كانت أو شرعية إلا في الأحوال المنصوص عليها في المادتين 426 و 438 من هذا القانون ."@ar ;
    dzdoc:isAuthoritative true ;
