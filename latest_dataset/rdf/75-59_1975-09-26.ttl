<https://legal.dz/resource/order/1975-09-26/75-59#version_art_827> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بغرامة من 20.000 دج إلى 200.000 دج رئيس شركة المساهمة أو القائمون بإدارتها الذين قاموا عمدا بتخفيض رأس مال الشركة: 1- دون مرا اعاة المساواة بين المساهمين، 2- دون تبلیغ مشروع تخفيض رأسمال الشركة إلى مندوبي الحسابات قبل 45 يوما على الأقل من انعقاد الجمعية العامة المدعوة للبت في ذلك، 3- ودون أن يقوموا بنشر قرار تخفيض رأس المال في النشرة الرسمية للإعلانات القانونية وفضلا عن ذلك في جريدة مؤهلة لقبول الإعلانات القانونية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_827_19750926_OpEnact_0cf7098299> ;
    dzdoc:replacementText "يعاقب بغرامة من 20.000 دج إلى 200.000 دج رئيس شركة المساهمة أو القائمون بإدارتها الذين قاموا عمدا بتخفيض رأس مال الشركة: 1- دون مرا اعاة المساواة بين المساهمين، 2- دون تبلیغ مشروع تخفيض رأسمال الشركة إلى مندوبي الحسابات قبل 45 يوما على الأقل من انعقاد الجمعية العامة المدعوة للبت في ذلك، 3- ودون أن يقوموا بنشر قرار تخفيض رأس المال في النشرة الرسمية للإعلانات القانونية وفضلا عن ذلك في جريدة مؤهلة لقبول الإعلانات القانونية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
