<https://legal.dz/resource/order/1975-09-26/75-59#version_art_728> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يسوغ أن يجاوز مبلغ المكافآت عشر الأرباح القابلة للتوزيع ، بعد طرح: الاحتياطات المكونة تنفيذا لمداولة الجمعية العامة، المبالغ المرحلة من جديد. ولتقدير المكافآت يمكن أيضا مراعاة المبالغ المشروع في توزيعها التي تقتطع حسب الشروط المنصوص عليها في الفقرة الثانية من المادة 722 . ولا يسوغ اعتبار المبالغ المدرجة في رأس المال أو المقتطعة من علاوات الإصدار لأجل حساب المكافآت."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
