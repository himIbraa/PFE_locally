    dznorm:provisionText "دعوى التعويض عن الضرر الذي لحق بهم شخصيا"@ar ;
    dznorm:sourceArticle "art_715_bis_24" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_24_right_1_6c97390a> a dznorm:Right ;
