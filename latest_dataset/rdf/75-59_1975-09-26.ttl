<https://legal.dz/resource/order/1975-09-26/75-59#art_248> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_248" ;
    dzdoc:fullText "للمحكمة أن تعدل في الحدود المقررة في المادة السابقة تاريخ التوقف عن الوفاء بقرار تال للحكم الذي قضى بالتسوية القضائية أو شهر الإفلاس وسابق لقفل قائمة الديون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_248> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_248_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_248_19750926_OpEnact_ebe9206cc2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 248" ;
    dzdoc:position 252 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_247> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_247> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_252> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_252" ;
    dzdoc:fullText "تخصص الديون لجماعة الدائنين بدلا عن الدائن الذي قضى بعدم التمسك بر هنه العقاري أو رهنه الحيازي أو امتيازه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_252> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_252_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_252_19750926_OpEnact_59a349a415> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 252" ;
    dzdoc:position 256 ;
    dzdoc:usesTerm dzterm:creditors_group .

<https://legal.dz/resource/order/1975-09-26/75-59#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_3_sec_2> ;
    dzdoc:eId "art_29" ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_29_para_0> ;
    dzdoc:hasStatus dzdoc:StatusRepealed ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_29_19750926_OpEnact_8363297531> ;
