    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_308_condition_1_b588bf26> a dznorm:Condition ;
    dznorm:conditionText "متى كانت دعوى الاسترداد أو الفسخ قد رفعها البائع، الذي لم يستوف الثمن قبل الحكم المنشيء"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_308> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_308_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_308> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز استرداد البضائع التي فسخ بيعها قبل الحكم بالتسوية القضائية أو بالإفلاس سواء كان هذا بحكم قضائي أو من جراء شرط فسخ اتفاقي، وذلك ما دامت هذه البضائع قائمة عينا كلها أو بعضها ويتعين أيضا قبول الاسترداد رغم الحكم بفسخ البيع أو تقرير وجوده بمقتضى حكم قضائي تال للحكم بالتسوية القضائية أو بالإفلاس، وذلك متى كانت دعوى الاسترداد أو الفسخ قد رفعها البائع، الذي لم يستوف الثمن قبل الحكم المنشيء."@ar .

