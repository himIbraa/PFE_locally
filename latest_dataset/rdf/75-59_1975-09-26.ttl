<https://legal.dz/resource/order/1975-09-26/75-59#version_art_33> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يتم الدفع في الاستحقاق ، جاز للدائن خلال خمسة عشر يوما من تاريخ تبليغ عاد حاصل للمدين أو الكفيل العيني من الغير إذا كان له محل، أن يشرع في البيع العلني للأشياء المرهونة . ويجوز لرئيس المحكمة بناء على طلب الأطراف أن يعين عونا للدولة مختصا للقيام بهذا العمل . ويعتبر لاغيا كل شرط يرخص فيه للدائن بأن يستملك المرهون أو يتصرف فيه من غير مراعاة للإجراءات المقررة أنفا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_33_19750926_OpEnact_be0f53548b> ;
    dzdoc:replacementText "إذا لم يتم الدفع في الاستحقاق ، جاز للدائن خلال خمسة عشر يوما من تاريخ تبليغ عاد حاصل للمدين أو الكفيل العيني من الغير إذا كان له محل، أن يشرع في البيع العلني للأشياء المرهونة . ويجوز لرئيس المحكمة بناء على طلب الأطراف أن يعين عونا للدولة مختصا للقيام بهذا العمل . ويعتبر لاغيا كل شرط يرخص فيه للدائن بأن يستملك المرهون أو يتصرف فيه من غير مراعاة للإجراءات المقررة أنفا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
