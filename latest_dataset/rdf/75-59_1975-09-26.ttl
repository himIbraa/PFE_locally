<https://legal.dz/resource/order/1975-09-26/75-59#art_261_obligation_0_89f8306b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_261> ;
    dznorm:position 0 ;
    dznorm:provisionText "يستخرج القاضي المختص من الحفظ تحت الأختام الدفاتر والمستندات الحسابية ويسلمها إلى وكيل التفليسة بعد أن يقوم بجردها ويبين بإيجاز في محضره الحالة التي هي عليها"@ar ;
    dznorm:sourceArticle "art_261" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_261_obligation_1_0d32b3f7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_261> ;
    dznorm:position 1 ;
    dznorm:provisionText "ويستخرج القاضي المنتدب من الحفظ تحت الأختام أوراق الحافظة التجارية التي حان أجل استحقاقها أو المحتملة القبول أو التي يستدعى الحال اتخاذ إجراءات تحفظية بالنسبة لها، ويصفها ويسلمها لوكيل التفليسة بعد بيان أوصافها، للقيام بتحصيلها"@ar ;
    dznorm:sourceArticle "art_261" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_261_obligation_2_a0d825a6> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_261> ;
    dznorm:position 2 ;
    dznorm:provisionText "تسلم الرسائل الموجهة للمفلس إلى وكيل التفليسة"@ar ;
    dznorm:sourceArticle "art_261" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_261_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_261> ;
    dzdoc:position 0 ;
    dzdoc:text "يستخرج القاضي المختص من الحفظ تحت الأختام الدفاتر والمستندات الحسابية ويسلمها إلى وكيل التفليسة بعد أن يقوم بجردها ويبين بإيجاز في محضره الحالة التي هي عليها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_261_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_261> ;
    dzdoc:position 1 ;
    dzdoc:text "ويستخرج القاضي المنتدب من الحفظ تحت الأختام أوراق الحافظة التجارية التي حان أجل استحقاقها أو المحتملة القبول أو التي يستدعى الحال اتخاذ إجراءات تحفظية بالنسبة لها، ويصفها ويسلمها لوكيل التفليسة بعد بيان أوصافها، للقيام بتحصيلها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_261_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_261> ;
    dzdoc:position 2 ;
    dzdoc:text "تسلم الرسائل الموجهة للمفلس إلى وكيل التفليسة، ويجوز للمفلس إن كان موجودا حضور فتحها."@ar .

