    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis> ;
    dznorm:position 0 ;
    dznorm:provisionText "تطبق الأحكام المتعلقة بشركات التضامن على شركات التوصية البسيطة مع مراعاة القواعد المنصوص عليها في هذا الفصل"@ar ;
    dznorm:sourceArticle "art_563_bis" .

