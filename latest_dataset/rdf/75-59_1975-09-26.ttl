<https://legal.dz/resource/order/1975-09-26/75-59#version_art_278> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوقف لمدة ثلاثة أشهر من تاريخ الحكم بـ التسوية القضائية أو شهر الإفلاس ما يتخذ بناء على طلب المؤجر من إجراءات التنفيذ على الأموال المنقولة المؤثثة بها الأماكن المؤجرة ، وذلك دون إخلال بأية إجراءات تحفظية أو ما يكون المؤجر قد اكتسبه قبل التسوية القضائية أو الإفلاس من حقوق في أن يستعيد حيازة الأماكن المؤجرة. ويتعين على المؤجر لممارسة هذه الحقوق المكتسبة أن يرفع طلبه في الميعاد المحدد فيما تقدم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_278_19750926_OpEnact_022de29889> ;
    dzdoc:replacementText "يوقف لمدة ثلاثة أشهر من تاريخ الحكم بـ التسوية القضائية أو شهر الإفلاس ما يتخذ بناء على طلب المؤجر من إجراءات التنفيذ على الأموال المنقولة المؤثثة بها الأماكن المؤجرة ، وذلك دون إخلال بأية إجراءات تحفظية أو ما يكون المؤجر قد اكتسبه قبل التسوية القضائية أو الإفلاس من حقوق في أن يستعيد حيازة الأماكن المؤجرة. ويتعين على المؤجر لممارسة هذه الحقوق المكتسبة أن يرفع طلبه في الميعاد المحدد فيما تقدم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_278> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_278> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_279> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لوكيل التفليسة في حالة التسوية القضائية أو للمدين بمساعدة وكيل التفليسة بعد إذن القاضي المنتدب أن يقوم بالتنازل عن الإجارة أو الاستمرار فيها مع تنفيذ كافة التزامات المستأجر ، كما له الحق بنفس الشروط فسخ الإيجار. يتعين على وكيل التفليسة أو المدين إبلاغ المؤجر عن نيته بالاحتفاظ بالإيجار أو فسخه في الميعاد المحدد في الفقرة الأولى من المادة السابقة ، ويقضي بالفسخ إذا ارتأت المحكمة عدم كفاية الضمانات المقدمة . تطبق أحكام هذه المادة مع مراعاة أحكام المادتين 296 و 297 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_279_19750926_OpEnact_9522141fbd> ;
    dzdoc:replacementText "يجوز لوكيل التفليسة في حالة التسوية القضائية أو للمدين بمساعدة وكيل التفليسة بعد إذن القاضي المنتدب أن يقوم بالتنازل عن الإجارة أو الاستمرار فيها مع تنفيذ كافة التزامات المستأجر ، كما له الحق بنفس الشروط فسخ الإيجار. يتعين على وكيل التفليسة أو المدين إبلاغ المؤجر عن نيته بالاحتفاظ بالإيجار أو فسخه في الميعاد المحدد في الفقرة الأولى من المادة السابقة ، ويقضي بالفسخ إذا ارتأت المحكمة عدم كفاية الضمانات المقدمة . تطبق أحكام هذه المادة مع مراعاة أحكام المادتين 296 و 297 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_279> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
