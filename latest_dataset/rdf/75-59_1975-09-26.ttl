<https://legal.dz/resource/order/1975-09-26/75-59#art_527> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_9> ;
    dzdoc:eId "art_527" ;
    dzdoc:fullText "تتقادم دعاوى الرجوع بالنسبة لحامل ضد المظهرين أو الساحب أو الملزمين الآخرين، بمضي ستة أشهر من تاريخ انقضاء مهلة التقديم . أما دعاوى الرجوع المتعلقة بمختلف الملزمين بوفاء الشيك على بعضهم بعضا، فإنها تتقادم بمضي ستة أشهر من تاريخ اليوم الذي سدد فيه الملزم قيمة الشيك أو من اليوم الذي رفعت فيه الدعوى عليه . وتتقادم دعوى حامل الشيك على المسحوب عليه بمضي ثلاثة أعوام من تاريخ انقضاء مهلة تقديمه . على أنه في حالة سقوط الحق أو التقادم ، فإنه يبقى الحق في رفع الدعوى على الساحب الذي لم يوفر قابل الوفاء أو على غيره من الملزمين الذين حصلوا على إثراء غير عادل ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_527_right_0_077e4a5e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_527> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_527_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_527_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_527_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_527_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_527_19750926_OpEnact_50a0930b57> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_527_obligation_0_0ca9ec70>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_527_obligation_1_5ef45c31>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_527_obligation_2_25301742> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "527" ;
    dzdoc:position 549 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_527_condition_0_2bb09334> ;
    dzdoc:usesTerm dzterm:cheque,
        dzterm:holder .

<https://legal.dz/resource/order/1975-09-26/75-59#art_564> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:limited_liability_company ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_564" ;
    dzdoc:fullText "تؤسس الشركة ذات المسؤولية المحدودة من شخص واحد أو عدة أشخاص لا يتحملون الخسائر إلا في حدود ما قدموا من حصص . إذا كانت الشركة ذات المسؤولية المحدودة المؤسسة طبقا للفقرة السابقة، لا تضم إلا شخصا واحدا \" كشريك وحيد \" ، تسمى هذه الشركة \" مؤسسة ذات الشخص الوحيد وذات المسؤولية المحدودة \". يمارس الشريك الوحيد السلطات المخولة جمعية الشركاء بمقتضى أحكام هذا الفصل. وتعين بعنوان للشركة يمكن أن يشتمل على اسم واحد من الشركاء أو أكثر على أن تكون هذه التسمية مسبوقة أو متبوعة بكلمات \" شركة ذات مسؤولية محدودة \" أو الأحرف الأولى منها أي \" ش. م. م \" وبيان رأسمال الشركة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_564_permission_0_88ab1a94> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_564> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_564_defocc_3a9a35b016e1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_564_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_564_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_564_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_564_para_3> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_564_19750926_OpEnact_d10cb20b7b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_564_obligation_0_8742c67c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "564" ;
    dzdoc:position 622 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_564_condition_0_a9e5ea52> ;
    dzdoc:usesTerm dzterm:limited_liability_company,
        dzterm:sole_partner,
        dzterm:sole_proprietorship_llc .

<https://legal.dz/resource/order/1975-09-26/75-59#art_579> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_579" ;
    dzdoc:fullText "يمكن عزل المدير بقرار من الشركاء الممثلين أكثر من نصف رأسمال الشركة . ويعتبر كل شرط مخالف لذلك كأن لم يكن. و إذا قرر العزل من دون سبب مشروع ، يكون موجبا لتعويض الضرر اللاحق . يجوز أيضا عزل المدير من طرف المحاكم لسبب قانوني بناء على طلب كل شريك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_579_permission_0_d36f8bd0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_579_permission_1_7338777e> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_579_right_0_6ff56807>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_579_right_1_1957bfee> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_579> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_579_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_579_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_579_19750926_OpEnact_d80290ef2c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_579_obligation_0_429b9bb4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 579" ;
    dzdoc:position 637 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_579_condition_0_28b0a57c> ;
    dzdoc:usesTerm dzterm:manager .

<https://legal.dz/resource/order/1975-09-26/75-59#art_604> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_604" ;
    dzdoc:fullText "لا يجوز أن يسحب وكيل الشركة الأموال الناتجة عن الاكتتابات النقدية قبل تسجيل الشركة في السجل التجاري . وإذا لم تؤسس الشركة في أجل ستة أشهر ابتداء من تاريخ إيداع مشروع القانون الأساسي بالمركز الوطني للسجل التجاري ، جاز لكل مكتتب أن يطالب أمام القضاء بتعيين وكيل يكلف بسحب الأموال لإعادتها للمكتتبين بعد خصم مصاريف التوزيع . وإذا قرر المؤسس أو المؤسسون فيما بعد تأسيس الشركة وجب القيام بإيداع الأموال من جديد وتقديم التصريح المنصوص عليه في المادتين 598 و 599 المذكورتين أعلاه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_604_permission_0_1f5fe669> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_604_right_0_ca41b777> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_604> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_604_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_604_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_604_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_604_19750926_OpEnact_8e50bcb55e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_604_obligation_0_52f3dc93>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_604_obligation_1_38923bac> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_604_prohibition_0_1f5fe669> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
