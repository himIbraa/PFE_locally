    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_80_19750926_OpEnact_9dd853b4a9> ;
    dzdoc:replacementText "يكون البائع ملزما بضمان ما ينشأ عن بياناته غير الصحيحة حسب الشروط المقررة في المادتين 376 و 379 من القانون المدني بالرغم من كل شرط مخالف في العقد ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_80> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
