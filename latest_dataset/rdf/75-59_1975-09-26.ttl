<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1_condition_0_f17cdf45> a dznorm:Condition ;
    dznorm:conditionText "إلا في حالة وجود شرط مخالف في القانون الأساسي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1> ;
    dzdoc:position 0 ;
    dzdoc:text "يعين المسير الأول أو المسيرون الأولون بموجب القانون الأساسي وينجزون إجراءات التأسيس التي يكلف بها مؤسسو شركات المساهمة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1> ;
    dzdoc:position 1 ;
    dzdoc:text "تعين الجمعية العامة العادية المسير أو المسيرين خلال وجود الشركة، بموافقة كل الشركاء المتضامنين، إلا في حالة وجود شرط مخالف في القانون الأساسي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1> ;
    dzdoc:position 2 ;
    dzdoc:text "يعزل المسير، شريكا كان أم لا، وفقا للشروط المنصوص عليها في القانون الأساسي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1> ;
    dzdoc:position 3 ;
    dzdoc:text "ويكون المسير علاوة على ذلك قابلا للعزل من المحكمة لسبب شرعي بناء على طلب من أي شريك أو من الشركة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_2_obligation_0_8b5e70d2> a dznorm:Obligation ;
