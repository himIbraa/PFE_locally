    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_311> ;
    dznorm:conditionText "أو متى كانت الميزانية الموضوعة خلال السنة المالية أو في آخرها ومصادق عليها من طرف مندوب الحسابات، تثبت أن الشركة حصلت خلال السنة المالية، بعد تكوين الاستهلاكات والمؤونات الضرورية أرباحا صافية زائدة على مبلغ الدفعات، وذلك عند الاقتضاء، بعد طرح الخسائر السابقة والاقتطاع المنصوص عليه في المادة 311"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_723> ;
