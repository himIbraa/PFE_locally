    dzdoc:sourceTextSpan "يعين في حالة ما إذا كانت الحصص المقدمة عينية، ما عدا في حالة وجود أحكام تشريعية خاصة، مندوب واحد للحصص أو أكثر بقرار قضائي بناء على طلب المؤسسين أو أحدهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_601> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_601_condition_1_803c52e5> a dznorm:Condition ;
    dznorm:conditionText "وعند عدم الموافقة الصريحة عليه من مقدمي الحصص المشار إليها بالمحضر، تعد الشركة غير مؤسسة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_601> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_601_obligation_0_6b895e70> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_601_obligation_0_6b895e70_action_9f7642c073> ;
