    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_709> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_709_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_709> ;
    dzdoc:position 1 ;
    dzdoc:text "وتعتبر الأسهم كلية إسهما انتفاعية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_709_permission_0_d286a5e7> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_709_permission_0_d286a5e7_action_3617939c75> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_709> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتم استهلاك رأس المال بموجب حكم في القانون الأساسي أو قرار من الجمعية العامة غير العادية وبواسطة مبالغ قابلة للتوزيع. ولا يمكن تحقيق هذا الاستهلاك إلا عن طريق التسديد المتساوي عن كل سهم من نفس الصنف ولا يترتب عنه تخفيض في رأس المال."@ar ;
    dznorm:sourceArticle "art_709" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_709_permission_0_d286a5e7_action_3617939c75> a dznorm:Action ;
