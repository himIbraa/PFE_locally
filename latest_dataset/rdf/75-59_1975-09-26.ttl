    dznorm:sourceArticle "art_235" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_236_condition_0_bd5ca04b> a dznorm:Condition ;
    dznorm:conditionText "إذا تقرر قبول تاجر في حالة تسوية قضائية أو شهر إفلاسه بعد الوفاة، أو كانت وفاته حاصلة بعد القبول في التسوية القضائية أو شهر الإفلاس"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_236> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_236_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_236> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا تقرر قبول تاجر في حالة تسوية قضائية أو شهر إفلاسه بعد الوفاة، أو كانت وفاته حاصلة بعد القبول في التسوية القضائية أو شهر الإفلاس، فإن لأرملته أو أولاده أو ورثته الحضور أو الإنابة في الحضور للحلول محله في كافة أعمال التسوية القضائية أو التفليسة وأن يستمع إليهم على نحو ما نص عليه في الفقرة الثالثة من المادة 235."@ar .

