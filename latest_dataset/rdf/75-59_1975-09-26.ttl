        dzterm:participation_bonds .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_74> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:participation_bonds ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_4> ;
    dzdoc:eId "art_715_bis_74" ;
    dzdoc:fullText "تعتبر سندات المساهمة سندات دين تتكون أجرتها من جزء ثابت يتضمنه العقد وجزء متغير يحسب استنادا إلى عناصر تتعلق بنشاط الشركة أو نتائجها وتقوم على القيمة الاسمية للسند . يكون الجزء المتغير موضوع تنظيم خاص توضح حدوده بدقة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_74> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_74_defocc_86456525188e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_74_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_74_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_74_19750926_OpEnact_54b2e023ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 74" ;
    dzdoc:position 848 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_86" ;
    dzdoc:fullText "إذا لجأت الشركة علنية إلى الادخار ، فيتعين عليها قبل افتتاح الاكتتاب، القيام بإجراءات إشهار شروط الإصدار وتحدد إجراءات الإشهار عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_86_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_86_19750926_OpEnact_def2e00920> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_86_obligation_0_95ef39ce> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 86" ;
    dzdoc:position 860 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_86_condition_0_d6372fb8> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_2> a dzdoc:Article ;
