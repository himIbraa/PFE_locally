<https://legal.dz/resource/order/1975-09-26/75-59#version_art_590> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يسوغ أن يتجاوز عدد الشركاء في شركة ذات مسؤولية محدودة عشرين شريكا. وإذا أصبحت الشركة مشتملة على أكثر من عشرين شريكا وجب تحويلها إلى شركة مساهمة في أجل سنة واحدة . وعند عدم ذلك تنحل الشركة ما لم يصبح عدد الشركاء في تلك الفترة من الزمن مساويا لعشرين شريكا أو أقل."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_590_19750926_OpEnact_0ae3574445> ;
    dzdoc:replacementText "لا يسوغ أن يتجاوز عدد الشركاء في شركة ذات مسؤولية محدودة عشرين شريكا. وإذا أصبحت الشركة مشتملة على أكثر من عشرين شريكا وجب تحويلها إلى شركة مساهمة في أجل سنة واحدة . وعند عدم ذلك تنحل الشركة ما لم يصبح عدد الشركاء في تلك الفترة من الزمن مساويا لعشرين شريكا أو أقل."@ar ;
    dzdoc:resolutionStatus "resolved" ;
