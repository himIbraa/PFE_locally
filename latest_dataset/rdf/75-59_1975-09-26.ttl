<https://legal.dz/resource/order/1975-09-26/75-59#version_art_170> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تطبق هذه الأحكام كذلك على : 1 - الإيجارات الممنوحة للبلديات بالنسبة للعمارات أو المحلات المخصصة لمصالح تسيير الاستغلال البلدي، إما عند الإيجار أو بعده، وبالموافقة الصريحة أو الضمنية من المالك، 2 - إيجار العمارات أو المحلات الرئيسية أو الملحقة والضرورية لمواصلة نشاط المؤسسات العمومية الاقتصادية في حدود القوانين والأنظمة التي تسودها، شريطة ألا يكون لهذا الإيجار أي تأثير على الملك العمومي ، 3 - كما تطبق هذه الأحكام أيضا مع مراعاة أحكام المادتين 185 و 186 التاليتين على إيجار المحلات أو العمارات المم"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_170_19750926_OpEnact_dfd79430da> ;
    dzdoc:replacementText "تطبق هذه الأحكام كذلك على : 1 - الإيجارات الممنوحة للبلديات بالنسبة للعمارات أو المحلات المخصصة لمصالح تسيير الاستغلال البلدي، إما عند الإيجار أو بعده، وبالموافقة الصريحة أو الضمنية من المالك، 2 - إيجار العمارات أو المحلات الرئيسية أو الملحقة والضرورية لمواصلة نشاط المؤسسات العمومية الاقتصادية في حدود القوانين والأنظمة التي تسودها، شريطة ألا يكون لهذا الإيجار أي تأثير على الملك العمومي ، 3 - كما تطبق هذه الأحكام أيضا مع مراعاة أحكام المادتين 185 و 186 التاليتين على إيجار المحلات أو العمارات المملوكة للدولة أو الولايات أو البلديات أو المؤسسات العمومية في حالة ما إذا كانت هذه المحلات أو العمارات تستجب لأحكام المادة 169 أعلاه وللفقرتين الأولى والثانية من هذه المادة . غیر أن هذه الأحكام لا تطبق على رخص العمل المؤقتة الممنوحة من قبل الإدارة لعمارة سبق اكتسابها من طرفها على إثر تصريح للمنفعة العمومية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_170> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_170> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_171> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تطبق هذه الأحكام على الإيجارات الاحتكارية إلا إذا كانت تخص إعادة النظر في بدل الإيجار . غير أنها تطبق في الأحوال المنصوص عليها في المادتين 169 و 170 أعلاه، على الإيجارات المبرمة عن طريق الإيجار الطويل الأمد بشرط ألا تؤدي مدة التجديد الممنوحة للمستأجرين من الباطن إلى تمديد شغل الأماكن إلى ما بعد تاريخ انتهاء الإيجار الطويل الأمد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_171_19750926_OpEnact_b105f938b2> ;
    dzdoc:replacementText "لا تطبق هذه الأحكام على الإيجارات الاحتكارية إلا إذا كانت تخص إعادة النظر في بدل الإيجار . غير أنها تطبق في الأحوال المنصوص عليها في المادتين 169 و 170 أعلاه، على الإيجارات المبرمة عن طريق الإيجار الطويل الأمد بشرط ألا تؤدي مدة التجديد الممنوحة للمستأجرين من الباطن إلى تمديد شغل الأماكن إلى ما بعد تاريخ انتهاء الإيجار الطويل الأمد ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_171> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
