<https://legal.dz/resource/order/1975-09-26/75-59#version_art_600> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم المؤسسون بعد التصريح بالاكتتاب والدفعات باستدعاء المكتتبين إلى جمعية عامة تأسيسية حسب الأشكال والآجال المنصوص عليها عن طريق التنظيم . تثبت هذه الجمعية أن رأس المال مكتتب به تماما، وأن مبلغ الأسهم مستحق الدفع. وتبدي رأيها في المصادقة على القانون الأساسي الذي لا يقبل التعديل إلا بإجماع آراء جميع المكتتبين، وتعين القائمين بالإدارة الأولين أو أعضاء مجلس المراقبة وتعين واحد أو أكثر من مندوبي الحسابات. كما يجب أن يتضمن محضر الجلسة الخاص بالجمعية عند الاقتضاء إثبات قبول القائمين بالإدارة أو أعضاء "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_600_19750926_OpEnact_a9abcd316f> ;
    dzdoc:replacementText "يقوم المؤسسون بعد التصريح بالاكتتاب والدفعات باستدعاء المكتتبين إلى جمعية عامة تأسيسية حسب الأشكال والآجال المنصوص عليها عن طريق التنظيم . تثبت هذه الجمعية أن رأس المال مكتتب به تماما، وأن مبلغ الأسهم مستحق الدفع. وتبدي رأيها في المصادقة على القانون الأساسي الذي لا يقبل التعديل إلا بإجماع آراء جميع المكتتبين، وتعين القائمين بالإدارة الأولين أو أعضاء مجلس المراقبة وتعين واحد أو أكثر من مندوبي الحسابات. كما يجب أن يتضمن محضر الجلسة الخاص بالجمعية عند الاقتضاء إثبات قبول القائمين بالإدارة أو أعضاء مجلس المراقبة ومندوبي الحسابات وظائفهم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_600> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_600> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_601> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعين في حالة ما إذا كانت الحصص المقدمة عينية، ما عدا في حالة وجود أحكام تشريعية خاصة، مندوب واحد للحصص أو أكثر بقرار قضائي بناء على طلب المؤسسين أو أحدهم ، ويخضع هؤلاء لأحكام التنافي المنصوص عليها في المادة 715 مكرر 6 أدناه. يقع تقدير قيمة الحصص العينية على مسؤولية مندوبي الحصص، ويوضع التقرير المودع لدى المركز الوطني للسجل التجاري مع القانون الأساسي تحت تصرف المكتتبين بمقر الشركة. يجب على الجمعية العامة التأسيسية أن تفصل في تقدير الحصص العينية . ولا يجوز لها أن تخفض هذا التقدير إلا بإجماع المكتت"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_601_19750926_OpEnact_17cf36b1c9> ;
    dzdoc:replacementText "يعين في حالة ما إذا كانت الحصص المقدمة عينية، ما عدا في حالة وجود أحكام تشريعية خاصة، مندوب واحد للحصص أو أكثر بقرار قضائي بناء على طلب المؤسسين أو أحدهم ، ويخضع هؤلاء لأحكام التنافي المنصوص عليها في المادة 715 مكرر 6 أدناه. يقع تقدير قيمة الحصص العينية على مسؤولية مندوبي الحصص، ويوضع التقرير المودع لدى المركز الوطني للسجل التجاري مع القانون الأساسي تحت تصرف المكتتبين بمقر الشركة. يجب على الجمعية العامة التأسيسية أن تفصل في تقدير الحصص العينية . ولا يجوز لها أن تخفض هذا التقدير إلا بإجماع المكتتبين. وعند عدم الموافقة الصريحة عليه من مقدمي الحصص المشار إليها بالمحضر، تعد الشركة غير مؤسسة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_601> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_601> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_602> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المادة 602 : ل مكتتبي الأسهم حق الاقتراع بأنفسهم أو بواسطة ممثليهم حسب الشروط المنصوص عليها في المادة 603 أدناه . وتتداول الجمعية التأسيسية حسب شروط اكتمال النصاب والأغلبية المقررة في الجمعيات غير العادية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_602_19750926_OpEnact_8a41023dfb> ;
    dzdoc:replacementText "المادة 602 : ل مكتتبي الأسهم حق الاقتراع بأنفسهم أو بواسطة ممثليهم حسب الشروط المنصوص عليها في المادة 603 أدناه . وتتداول الجمعية التأسيسية حسب شروط اكتمال النصاب والأغلبية المقررة في الجمعيات غير العادية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_602> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_602> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
