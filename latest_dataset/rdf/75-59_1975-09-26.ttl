<https://legal.dz/resource/order/1975-09-26/75-59#version_art_750> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقدم مجلس الإدارة أو القائمون بالإدارة، حسب الأحوال، مشروع الإدماج أو الانفصال وملحقاته لمندوبي الحسابات، إن وجدوا ، لكل واحدة من الشركات المساهمة في العملية قبل خمسة وأربعين يوما على الأقل، من انعقاد جمعية الشركاء أو المساهمين المدعوين للنظر في هذا المشروع ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
