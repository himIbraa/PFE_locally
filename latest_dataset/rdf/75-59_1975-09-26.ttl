<https://legal.dz/resource/order/1975-09-26/75-59#version_art_415> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحق للمسحوب عليه عند إيفائه قيمة السفتجة أن يطلب من الحامل تسليمها إليه موقعا عليها بالوفاء . ولا يمكن للحامل أن يرفض وفاء جزئيا. وإذا كان الوفاء جزئيا جاز للمسحوب عليه أن يطلب بيان هذا الوفاء على السفتجة وإعطاءه مخالصة به . وكل ما يدفع من أصل قيمة السفتجة تبرأ منه ذمة ساحبها مظهريها. ويتعين على الحامل أن يقدم احتجاجا عما تبقى من المبلغ ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_415_19750926_OpEnact_5dc0fb864f> ;
    dzdoc:replacementText "يحق للمسحوب عليه عند إيفائه قيمة السفتجة أن يطلب من الحامل تسليمها إليه موقعا عليها بالوفاء . ولا يمكن للحامل أن يرفض وفاء جزئيا. وإذا كان الوفاء جزئيا جاز للمسحوب عليه أن يطلب بيان هذا الوفاء على السفتجة وإعطاءه مخالصة به . وكل ما يدفع من أصل قيمة السفتجة تبرأ منه ذمة ساحبها مظهريها. ويتعين على الحامل أن يقدم احتجاجا عما تبقى من المبلغ ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_415> ;
