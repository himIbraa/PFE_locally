<https://legal.dz/resource/order/1975-09-26/75-59#version_art_161> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "القيد يحفظ الامتياز لمدة خمس سنوات ابتداء من تاريخ ضبطه النهائي. وينتهي أثر هذا القيد إذا لم يجدد قبل انقضاء المهلة المذكورة أعلاه. ويمكن تجديده مرتين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
