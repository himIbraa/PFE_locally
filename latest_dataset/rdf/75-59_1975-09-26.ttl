<https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "يتمتع التجمع بالشخصية المعنوية وبالأهلية التامة ابتداء من تاريخ تسجيله في السجل التجاري. ويحدد العقد الخاضع للإشهار القانوني، شروط التجمع وموضوعه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis_right_0_f7ffad6e> a dznorm:Right ;
