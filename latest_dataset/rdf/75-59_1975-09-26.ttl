<https://legal.dz/resource/order/1975-09-26/75-59#version_art_323> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحق لجميع الدائنين الذين كان لهم حق المشاركة في الصلح أو الذين حصل إقرار بحقوقهم منذ إبرامه أن يعارضوا فيه . وتكون المعارضة مسببة و يتعين إبلاغها للمدين ووكيل التفليسة في الثمانية أيام التالية للصلح، وإلا كانت ،باطلة، وتتضمن إعلانات بالحضور لأول جلسة للمحكمة . وفي حالة المعارضة التسويفية أو التعسفية يجوز أن تطبق على المعارضة غرامة مدنية لا تتجاوز 5.000 دج."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_323_19750926_OpEnact_e7f7ee78e9> ;
    dzdoc:replacementText "يحق لجميع الدائنين الذين كان لهم حق المشاركة في الصلح أو الذين حصل إقرار بحقوقهم منذ إبرامه أن يعارضوا فيه . وتكون المعارضة مسببة و يتعين إبلاغها للمدين ووكيل التفليسة في الثمانية أيام التالية للصلح، وإلا كانت ،باطلة، وتتضمن إعلانات بالحضور لأول جلسة للمحكمة . وفي حالة المعارضة التسويفية أو التعسفية يجوز أن تطبق على المعارضة غرامة مدنية لا تتجاوز 5.000 دج."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_323> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
