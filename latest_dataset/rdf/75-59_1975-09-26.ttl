<https://legal.dz/resource/order/1975-09-26/75-59#version_art_373> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تلتزم الخزينة العامة بمصروفات الدعوى التي يرفعها أحد الدائنين إذا قضى بالإدانة ، دون إخلال بحق الرجوع على المدين طبقا للأوضاع الواردة في الفقرة الثانية من المادة 372 ، وأما في حالة الإعفاء من التهمة فيتحملها الدائن المدعي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_373_19750926_OpEnact_2a33f917e8> ;
