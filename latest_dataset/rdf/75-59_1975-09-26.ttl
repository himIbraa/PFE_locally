<https://legal.dz/resource/order/1975-09-26/75-59#version_art_94> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يكن للمعارضة سند ولا سبب أو كانت باطلة شكلا ولم ترفع دعوى أصلية فإنه يجوز للبائع رفع دعوى مستعجلة لدى رئيس المحكمة للحصول على إذن بقبض ثمن البيع بالرغم من المعارضة ."@ar ;
    dzdoc:isAuthoritative true ;
