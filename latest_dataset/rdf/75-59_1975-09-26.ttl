<https://legal.dz/resource/order/1975-09-26/75-59#version_art_222> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في أول جلسة يثبت فيها لدى المحكمة التوقف عن الدفع فإنها تحدد تاريخه كما تقضي بـ التسوية القضائية أو الإفلاس . فإن لم يحدد تاريخ التوقف عن الدفع ، عد هذا التوقف واقعا بتاريخ الحكم المقرر له وذلك مع مراعاة أحكام المادة 233 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
