<https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_2> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المسحوب عليه ، بمناسبة أول عارض دفع لعدم وجود أو عدم كفاية الرصيد، ، أن يوجه لساحب الشيك أمرا بالدفع لتسوية هذا العارض خلال مهلة أقصاها عشرة (10) أيام ابتداء من تاريخ توجيه الأمر . يقصد بالتسوية المذكورة في الفقرة السابقة، منح إمكانية لساحب الشيك بدون رصيد لتكوين رصيد كاف ومتوفر لدى المسحوب عليه، من أجل تسوية عارض الدفع . يحدد شكل الأمر بالدفع ومضمونه عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_2_19750926_OpEnact_c6b01ce05f> ;
    dzdoc:replacementText "يجب على المسحوب عليه ، بمناسبة أول عارض دفع لعدم وجود أو عدم كفاية الرصيد، ، أن يوجه لساحب الشيك أمرا بالدفع لتسوية هذا العارض خلال مهلة أقصاها عشرة (10) أيام ابتداء من تاريخ توجيه الأمر . يقصد بالتسوية المذكورة في الفقرة السابقة، منح إمكانية لساحب الشيك بدون رصيد لتكوين رصيد كاف ومتوفر لدى المسحوب عليه، من أجل تسوية عارض الدفع . يحدد شكل الأمر بالدفع ومضمونه عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_2> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_2> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_3> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
