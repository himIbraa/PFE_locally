<https://legal.dz/resource/order/1975-09-26/75-59#art_191_obligation_0_76a69180> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_191_obligation_0_76a69180_action_27713b9f52> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_191> ;
    dznorm:position 0 ;
    dznorm:provisionText "ويجب أن يشار في هذا الإخطار إلى هذه المهلة."@ar ;
    dznorm:sourceArticle "art_191" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_191_obligation_0_76a69180_action_27713b9f52> a dznorm:Action ;
    rdfs:label "أن يشار في هذا الإخطار"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "ويجب أن يشار في هذا الإخطار إلى هذه المهلة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_191> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_191_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_191> ;
    dzdoc:position 0 ;
    dzdoc:text "كل اشتراط مدرج في الإيجار ينص على الفسخ بقوة القانون في حالة عدم دفع بدل الإيجار في الاستحقاقات المتفق عليها ، لا ينتج أثره إلا بعد مرور شهر واحد من الإخطار بالدفع الذي يبقى بدون نتيجة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_191_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_191> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجب أن يشار في هذا الإخطار إلى هذه المهلة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_191_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_191> ;
    dzdoc:position 2 ;
    dzdoc:text "يجوز للقضاة إذا رفع إليهم طلب مقدم وفقا للأوضاع والشروط المنصوص عليها في المادتين 277 الفقرة الأولى، و 281 من القانون المدني، أن يوقفوا، في الوقت الذي يمنحون فيه مهلا، تحقيق وآثار شروط الفسخ لعدم سداد بدل الإيجار في الوقت المتفق عليه، وذلك إذا لم يعلن عن الفسخ أو يصدر عنه بحكم قضائي حاز قوة الشيء المقضي فيه، ولا يكون للشرط الفاسخ أي أثر إذا تمكن المستأجر من التخلص من دينه ضمن الشروط المحددة من قبل القاضي."@ar .

