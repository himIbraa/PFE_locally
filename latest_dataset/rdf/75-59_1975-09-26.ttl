<https://legal.dz/resource/order/1975-09-26/75-59#art_737_condition_0_ee4ce600> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_737_condition_0_ee4ce600_ref_212aa16c6407> ;
