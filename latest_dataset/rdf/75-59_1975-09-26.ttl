    dznorm:provisionText "إذا حال دون تقديم السفتجة أو تقديم الاحتجاج في المهل المقررة حائل لا يمكن التغلب عليه وكان عرض السفتجة أو تحرير الاحتجاج في الآجال المعينة كوجود نص قانوني لحالة ما أو غير ذلك من ظروف القوة القاهرة، فتمتد هذه المواعيد."@ar ;
    dznorm:sourceArticle "art_438" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_438_permission_0_e838594d_action_89ae2248c2> a dznorm:Action ;
    rdfs:label "التغلب عليه وكان عرض السفتجة"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "إذا حال دون تقديم السفتجة أو تقديم الاحتجاج في المهل المقررة حائل لا يمكن التغلب عليه وكان عرض السفتجة أو تحرير الاحتجاج في الآجال المعينة كوجود نص قانوني لحالة ما أو غير ذلك من ظروف القوة القاهرة، فتمتد هذه المواعيد."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_438> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_438_right_0_1174aea2> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_438> ;
