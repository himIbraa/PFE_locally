<https://legal.dz/resource/order/1975-09-26/75-59#art_469> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_2> ;
    dzdoc:eId "art_469" ;
    dzdoc:fullText "كما تطبق على السند لأمر الأحكام المتعلقة بالضمان الاحتياطي ( المادة 409 ) وفي الحالة المنصوص عليها في الفقرة السادسة من المادة المذكورة إذا لم يعين في الضمان الشخص الذي يضمنه فإن الضمان يعد حاصلا للملزم بالسند لأمر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_469> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_469_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_469_19750926_OpEnact_e280e6eca3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "469" ;
    dzdoc:position 474 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_409> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_409> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_469_condition_0_43554a8a> ;
    dzdoc:usesTerm dzterm:promissory_note .

<https://legal.dz/resource/order/1975-09-26/75-59#art_481> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_481" ;
    dzdoc:fullText "من وقع شيكا بالنيابة عن شخص ولم يكن وكيلا عنه في ذلك يصبح بتوقيعه ملزما شخصيا بمقتضى الشيك ، وإذا أوفى، آلت له نفس الحقوق التي كانت تؤول إلى من زعم النيابة عنه، ويجري مثل ذلك على من تجاوز حدود نيابته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_481> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_481_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_481_19750926_OpEnact_5bd8983497> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_481_obligation_0_7d3c439c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "481" ;
    dzdoc:position 486 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_482> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_482" ;
    dzdoc:fullText "الساحب ضامن للوفاء كل شرط بإعفاء الساحب من هذا الضمان يعد كأن لم يكن."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_482> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_482_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_482_19750926_OpEnact_0d6ca44f4a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_482_obligation_0_74a2e979> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "482" ;
    dzdoc:position 487 ;
    dzdoc:usesTerm dzterm:drawer .

<https://legal.dz/resource/order/1975-09-26/75-59#art_485> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_2> ;
    dzdoc:eId "art_485" ;
    dzdoc:fullText "إن الشيك المشترط دفعه إلى شخص مسمى بموجب اشتراط صريح \" للأمر\" أو بدونه يكون قابلا للتداول بطريق التظهير . أما الشيك المشترط دفعه إلى شخص مسمى مع شرط \" ليس لأمر\" أو شرط مماثل لا يكون قابلا للتداول إلا حسب الأوضاع المقررة للإحالة العادية وبما يترتب عليها من النتائج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_485> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_485_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_485_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_485_19750926_OpEnact_cfe0b5dd44> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "485" ;
    dzdoc:position 490 ;
    dzdoc:usesTerm dzterm:cheque,
        dzterm:endorsement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_493> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_2> ;
    dzdoc:eId "art_493" ;
    dzdoc:fullText "إذا زالت يد شخص عن الشيك للأمر من شخص بأي حادث من الحوادث فلا يلزم المستفيد الذي يثبت أنه صاحب الحق فيه على الكيفية المبينة في المادة 491 بالتخلي عنه إلا إذا كان قد اكتسبه عن سوء نية أو كان قد ارتكب خطأ جسيما عند اكتسابه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_493> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_493_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_493_19750926_OpEnact_9660376fc8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "493" ;
    dzdoc:position 498 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_491> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_491> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_493_condition_0_c2b207f5> ;
    dzdoc:usesTerm dzterm:cheque_to_order .

<https://legal.dz/resource/order/1975-09-26/75-59#art_504> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_4> ;
    dzdoc:eId "art_504" ;
    dzdoc:fullText "إذا فقد الساحب أهليته أو توفي بعد إصدار الشيك ، فليس في ذلك أثر على الشيك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_504> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_504_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_504_19750926_OpEnact_7c0f627744> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "504" ;
    dzdoc:position 509 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_504_condition_0_5dd4b3ae> ;
    dzdoc:usesTerm dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_8_bis> ;
    dzdoc:eId "art_526_bis_10" ;
    dzdoc:fullText "يطبق منع إصدار الشيكات على كل الحسابات الجارية وحسابات الشيكات التي يحتفظ بها الزبون المعني. ويطبق أيضا على وكلائه فيما يتعلق بذات الحسابات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_10_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_10_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_10_19750926_OpEnact_3fced17329> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "526 مكرر 10" ;
    dzdoc:position 542 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_8_bis> ;
    dzdoc:eId "art_526_bis_12" ;
    dzdoc:fullText "لا يفقد الممنوع من إصدار الشيكات صفته كوكيل لحسابات موكله ما لم يكن هذا الأخير موضوع نفس التدبير. ولا يمتد إجراء المنع من إصدار الشيكات المتخذ ضد شخص إلى وكلائه فيما يتعلق بسير حساباتهم الخاصة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_12_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_12_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_12_19750926_OpEnact_fef7454930> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "526 مكرر 12" ;
    dzdoc:position 544 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_8_bis> ;
    dzdoc:eId "art_526_bis_14" ;
    dzdoc:fullText "يحتفظ صاحب الحساب الذي منع من إصدار الشيكات أو وكيله بإمكانية سحب شيكات مخصصة فقط لسحب أموال لدى المسحوب عليه أو إصدار شيكات مصادق عليها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_14_right_0_357174ab> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_14_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_14_19750926_OpEnact_09b3669e7b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "526 مكرر 14" ;
    dzdoc:position 546 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_8_bis> ;
    dzdoc:eId "art_526_bis_6" ;
    dzdoc:fullText "تباشر المتابعة الجزائية طبقا لأحكام قانون العقوبات، في حالة عدم القيام بتسوية عارض الدفع في الآجال المنصوص عليها في المادتين 526 مكرر 2 و 526 مكرر 4 المذكورتين أعلاه، مجتمعة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_6_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_6_19750926_OpEnact_5fa9f19e0e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "526 مكرر 6" ;
    dzdoc:position 538 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_4> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_4> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_6_condition_0_2342c258> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_8_bis> ;
    dzdoc:eId "art_526_bis_7" ;
    dzdoc:fullText "يبلغ المسحوب عليه فورا مركزية المستحقات غير المدفوعة بكل منع من إصدار الشيكات يتخذه ضد أحد زبائنه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_7_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_7_19750926_OpEnact_d5d072ac41> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_7_obligation_0_f52d4a15> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "526 مكرر 7" ;
    dzdoc:position 539 ;
    dzdoc:usesTerm dzterm:drawee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_9> ;
    dzdoc:eId "art_543" ;
    dzdoc:fullText "يعاقب بالغرامة من 5000 دج إلى 200.000 دج كل مسحوب عليه تعمد تعيين مقابل وفاء أقل من مقابل الوفاء المتوفر لديه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_19750926_OpEnact_d808a26a50> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_543_obligation_0_60ed7df5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 543" ;
    dzdoc:position 565 ;
    dzdoc:usesTerm dzterm:drawee,
        dzterm:provision .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:سند_الخزن ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_1> ;
    dzdoc:eId "art_543_bis" ;
    dzdoc:fullText "سند الخزن هو استمارة ضمان ملحقة بوصل البضائع المودعة بمخازن عامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_defocc_039b2cfc9ebd> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_19750926_OpEnact_a4ba23b9c7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر" ;
    dzdoc:position 566 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_1> ;
    dzdoc:eId "art_543_bis_1" ;
    dzdoc:fullText "يمثل الوصل إيصال البضاعة وهو قابل للتحويل عن طريق التظهير. ويحتوي على اسم الشخص الطبيعي أو المعنوي المعني أو اسم شركته، مهنته أو غرض شركته، مقر سكناه أو عنوان شركته وطبيعة المواد المودعة والبيانات الخاصة التي تسمح بالتعرف على البضاعة وقيمتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_1_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_1_19750926_OpEnact_d3baf54304> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 1" ;
    dzdoc:position 567 ;
    dzdoc:usesTerm dzterm:الوصل .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_2> ;
    dzdoc:eId "art_543_bis_11" ;
    dzdoc:fullText "سند النقل المتضمن شرط \"الأمر\" قابل للتحويل عن طريق التظهير من الشخص الذي صدر لأمره ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_11_right_0_e2a286c8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_11> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_11_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_11_19750926_OpEnact_a5386c7356> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 543 مكرر 11" ;
    dzdoc:position 577 ;
    dzdoc:usesTerm dzterm:transport_document .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:factoring_contract ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_3> ;
    dzdoc:eId "art_543_bis_14" ;
    dzdoc:fullText "عقد تحويل الفاتورة هو عقد تحل بمقتضاه شركة متخصصة، تسمى \" وسيط \" محل زبونها المسمى \" المنتمي \"، عندما تسدد فورا لهذا الأخير المبلغ التام لفاتورة لأجل محدد ناتج عن عقد، وتتكفل بتبعة عدم التسديد، وذلك مقابل أجر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_14> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_14_defocc_e4bad3e98191> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_14_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_14_19750926_OpEnact_1ca6aa03ae> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 14" ;
    dzdoc:position 580 ;
    dzdoc:usesTerm dzterm:adherent,
        dzterm:factor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_3> ;
    dzdoc:eId "art_543_bis_17" ;
    dzdoc:fullText "ينظم الوسيط و المنتمي بكل حرية، وعن طريق الاتفاق، الكيفيات العملية لتحويلات الدفعات المطابقة لحواصل التنازل."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_17_right_0_bd06c125> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_17> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_17_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_17_19750926_OpEnact_60ffb9322c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 17" ;
    dzdoc:position 583 ;
    dzdoc:usesTerm dzterm:adherent,
        dzterm:factor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_2> ;
    dzdoc:eId "art_543_bis_9" ;
    dzdoc:fullText "يأخذ سند النقل حسب الشروط المنصوص عليها في المادة السابقة ، شكل السند التجاري ، سواء كانت البضاعة في طريق النقل أو وصلت إلى الجهة المقصودة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_9_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_9_19750926_OpEnact_560b84fcc7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 543 مكرر 9" ;
    dzdoc:position 575 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_8> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_8> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_9_condition_0_4b02884c> ;
    dzdoc:usesTerm dzterm:commercial_instrument,
        dzterm:transport_document .

<https://legal.dz/resource/order/1975-09-26/75-59#art_544> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_sec_التمهيدي> ;
    dzdoc:eId "art_544" ;
    dzdoc:fullText "يحدد الطابع التجاري لـ شركة إما بشكلها أو موضوعها. تعد شركات التضامن و شركات التوصية و الشركات ذات المسؤولية المحدودة و شركات المساهمة ، تجارية بحكم شكلها ومهما يكن موضوعها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_544> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_544_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_544_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_544_19750926_OpEnact_b4fd43663f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "544" ;
    dzdoc:position 591 ;
    dzdoc:usesTerm dzterm:commercial_nature,
        dzterm:company,
        dzterm:joint_stock_company,
        dzterm:limited_liability_company,
        dzterm:limited_partnership,
        dzterm:partnership .

<https://legal.dz/resource/order/1975-09-26/75-59#art_550> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_sec_التمهيدي> ;
    dzdoc:eId "art_550" ;
    dzdoc:fullText "يتعين نشر انحلال الشركة حسب نفس شروط وآجال العقد التأسيسي ذاته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_550> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_550_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_550_19750926_OpEnact_882733d85a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_550_obligation_0_86c8061b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "550" ;
    dzdoc:position 597 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_552> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:company_title ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_552" ;
    dzdoc:fullText "يتألف عنوان الشركة من أسماء جميع الشركاء أو من اسم أحدهم أو أكثر متبوع بكلمة \" و شركاؤهم \" ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_552> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_552_defocc_73df78337a1d> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_552_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_552_19750926_OpEnact_82d03f6287> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "552" ;
    dzdoc:position 599 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_553> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_553" ;
    dzdoc:fullText "تعود إدارة الشركة لكافة الشركاء ما لم يشترط في القانون الأساسي على خلاف ذلك. ويجوز أن يعين في القانون المشار إليه مدير أو أكثر من الشركاء أو غير الشركاء، أو ينص على هذا التعيين بموجب عقد لاحق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_553> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_553_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_553_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_553_19750926_OpEnact_c28ee33c91> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "553" ;
    dzdoc:position 600 ;
    dzdoc:usesTerm dzterm:statutes .

<https://legal.dz/resource/order/1975-09-26/75-59#art_573> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_573" ;
    dzdoc:fullText "في حالة زيادة رأس المال عن طريق الاكتتاب بقبول حصص نقدية في الشركة ، تطبق أحكام المادة 567 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_573> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_573_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_573_19750926_OpEnact_c005493562> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "573" ;
    dzdoc:position 631 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_567> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_567> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_573_condition_0_749f8198> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_583> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_583" ;
    dzdoc:fullText "يرأس الجمعية العامة للشركاء، مدير الشركة . وكل مداولة لجمعية الشركاء تثبت بمحضر"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_583> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_583_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_583_19750926_OpEnact_2028c2c5cd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_583_obligation_0_f0626559> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 583" ;
    dzdoc:position 641 ;
    dzdoc:usesTerm dzterm:manager .

<https://legal.dz/resource/order/1975-09-26/75-59#art_591> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_591" ;
    dzdoc:fullText "إن تحويل شركة ذات مسؤولية محدودة إلى شركة تضامن يستوجب الموافقة الاجماعية للشركاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_591> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_591_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_591_19750926_OpEnact_1759c1c905> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_591_obligation_0_0e884ae7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "591" ;
    dzdoc:position 650 ;
    dzdoc:usesTerm dzterm:general_partnership,
        dzterm:limited_liability_company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_611> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_611" ;
    dzdoc:fullText "تنتخب الجمعية العامة التأسيسية أو الجمعية العامة العادية القائمين بالإدارة. وتحدد مدة عضويتهم في القانون الأساسي دون أن يتجاوز ذلك ست (06) سنوات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_611> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_611_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_611_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_611_19750926_OpEnact_41a8715edd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "611" ;
    dzdoc:position 670 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_614> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_614" ;
    dzdoc:fullText "كل تعيين مخالف للأحكام السابقة يعتبر باطلا ما عدا التعيين الواقع حسب الشروط المنصوص عليها في المادة 617 أدناه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_614> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_614_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_614_19750926_OpEnact_c18d256c93> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "614" ;
    dzdoc:position 673 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_617> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_617> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_614_condition_0_5458aba5> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_622> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_622" ;
    dzdoc:fullText "يخول لمجلس الإدارة كل السلطات للتصرف في كل الظروف باسم الشركة ، ويمارس هذه السلطات في نطاق موضوع الشركة ومع مراعاة السلطات المسندة صراحة في القانون لجمعيات المساهمين."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_622_right_0_9e859b2d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_622> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_622_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_622_19750926_OpEnact_30a3eb2b63> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "622" ;
    dzdoc:position 681 ;
    dzdoc:usesTerm dzterm:board_of_directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_643> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_643" ;
    dzdoc:fullText "يدير شركة المساهمة مجلس مديرين يتكون من ثلاثة (3) إلى خمسة (5) أعضاء. ويمارس مجلس المديرين وظائفه تحت رقابة مجلس مراقبة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_643> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_643_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_643_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_643_19750926_OpEnact_048e7c00b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 643" ;
    dzdoc:position 702 ;
    dzdoc:usesTerm dzterm:board_of_directors,
        dzterm:joint_stock_company,
        dzterm:supervisory_board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_648> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_648" ;
    dzdoc:fullText "يتمتع مجلس المديرين بالسلطات الواسعة للتصرف باسم الشركة في كل الظروف. ويمارس هذه السلطات في حدود موضوع الشركة مع مراعاة السلطات التي يخولها القانون صراحة لمجلس المراقبة وجمعيات المساهمين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_648> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_648_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_648_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_648_19750926_OpEnact_64fbd9dab7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 648" ;
    dzdoc:position 707 ;
    dzdoc:usesTerm dzterm:board_of_directors,
        dzterm:supervisory_board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_651> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_651" ;
    dzdoc:fullText "يتم نقل مقر الشركة في نفس المدينة بقرار مجلس المراقبة ، و إذا ما تقرر نقله خارج هذه المدينة ، فإن القرار يكون من اختصاص الجمعية العامة العادية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_651> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_651_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_651_19750926_OpEnact_b1504570b8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 651" ;
    dzdoc:position 710 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_651_condition_0_c6f8b960> ;
    dzdoc:usesTerm dzterm:ordinary_general_assembly,
        dzterm:supervisory_board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_683> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_683" ;
    dzdoc:fullText "إذا رفضت الشركة تبليغ الوثائق كليا أو جزئيا خلافا لأحكام المواد 677 و 678 و 680 و 682 أعلاه ، فيجوز للجهة القضائية المختصة التي تفصل في هذا الشأن بنفس طريقة الاستعجال أن تأمر بناء على طلب المساهم الذي رفض طلبه، الشركة بتبليغ هذه الوثائق تحت طائلة الإكراه المالي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_683> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_683_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_683_19750926_OpEnact_af09d7feae> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "683" ;
    dzdoc:position 742 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_677>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_678>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_680>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_682> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_677>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_678>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_680>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_682> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_683_condition_0_a2de348b> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_688> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_688" ;
    dzdoc:fullText "تصبح الأسهم الجديدة مسددة القيمة إذا قدمت نقدا أو بالمقاصة مع ديون معينة المقدار ومستحقة الأداء من الشركة وإما بضم الاحتياط أو الأرباح أو علاوات الإصدار أو بما يقدم من حصص عينية وإما بتحويل السندات بامتيازات أو بدونها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_688> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_688_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_688_19750926_OpEnact_61e9ef98b2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "688" ;
    dzdoc:position 747 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_688_condition_0_849bf6b5> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_703> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_703" ;
    dzdoc:fullText "تقوم الشركة عند بداية الاكتتاب بإجراءات الإشهار التي تحدد كيفياتها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_703> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_703_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_703_19750926_OpEnact_e8b17016db> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_703_obligation_0_c70c7bce> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "703" ;
    dzdoc:position 762 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_706> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_706" ;
    dzdoc:fullText "يثبت الاكتتاب والدفعات بشهادة المودع المعتمد المعدة وقت إيداع الأموال بناء على تقديم بطاقة الاكتتاب. ويتم إثبات وفاء الأسهم بالمقاصة لديون نقدية ومستحقة الأداء على الشركة بواسطة تصريح موثق صادر إما عن مجلس الإدارة أو مجلس المديرين أو موكليهما. ويقوم هذا التصريح الموثق مقام شهادة المودع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_706> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_706_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_706_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_706_19750926_OpEnact_f3ad50e1f8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "706" ;
    dzdoc:position 764 ;
    dzdoc:usesTerm dzterm:shares .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_7> ;
    dzdoc:eId "art_715_bis_10" ;
    dzdoc:fullText "يطلع مندوبو الحسابات مجلس الإدارة أو مجلس المديرين أو مجلس المراقبة، حسب الحالة، بما يلي : عمليات المراقبة والتحقيق التي قاموا بها ومختلف عمليات السير التي أدوها. مناصب الموازنة والوثائق الأخرى المتعلقة بالحسابات التي يرون ضرورة إدخال تغييرات عليها بتقديم كل الملاحظات الضرورية حول الطرق التقييمية المستعملة في إعداد هذه الوثائق. المخالفات والأخطاء التي قد يكتشفونها. النتائج التي تسفر عنها الملاحظات والتصحيحات أعلاه والخاصة بنتائج السنة المالية مقارنة بنتائج السنة المالية السابقة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_10_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_10_19750926_OpEnact_6ef491704a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_10_obligation_0_b526c44c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 10" ;
    dzdoc:position 784 ;
    dzdoc:usesTerm dzterm:auditor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_107> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_107" ;
    dzdoc:fullText "يعين قرار قضائي، في كل الحالات، وكيلا يتولى تمثيل جماعة أصحاب سندات الاستحقاق في حالة عجز وكلاء هذه الجماعة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_107> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_107_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_107_19750926_OpEnact_2cff5e093e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 107" ;
    dzdoc:position 881 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_107_condition_0_d0ce67a9> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_109" ;
    dzdoc:fullText "لا تطبق أحكام المواد المتعلقة بتنظيم أصحاب سندات الاستحقاق في شكل جماعة، على القروض التي تضمنها الدولة أو الجماعات المحلية أو المؤسسات العمومية، إلا بمقتضى شرط في عقد الإصدار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_109> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_109_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_109_19750926_OpEnact_2d2e67747f> ;
