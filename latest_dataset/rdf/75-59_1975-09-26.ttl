<https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_6> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للشركاء الموصين، الحق مرتين خلال سنة، في الإطلاع على دفاتر الشركة ومستنداتها وفي طرح أسئلة كتابية حول تسيير الشركة ، وتكون الإجابة عنها كتابيا أيضا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
