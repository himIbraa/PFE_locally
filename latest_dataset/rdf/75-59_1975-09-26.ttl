<https://legal.dz/resource/order/1975-09-26/75-59#art_570_condition_1_961beb55> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_570_condition_1_961beb55_action_e7d73231b6> ;
