<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_51> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تكون الأسهم قابلة للتداول إلا بعد تقييد الشركة في السجل التجاري . وفي حالة الزيادة في رأس المال ، تكون الأسهم قابلة للتداول ابتداء من تاريخ التسديد الكامل لهذه الزيادة. ويحظر التداول في الوعود بالأسهم ، ما عدا إذا كانت أسهما تنشأ بمناسبة زيادة في رأسمال شركة كانت أسهمها القديمة قد سجلت في تسعيرة بورصة القيم . وفي هذه الحالة لا يصح التداول إلا إذا تم تحت شرط موقف لتحقيق الزيادة في رأس المال . ويكون هذا الشرط مفترضا في غياب أي بيان صريح."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_51_19750926_OpEnact_cd2dd49461> ;
    dzdoc:replacementText "لا تكون الأسهم قابلة للتداول إلا بعد تقييد الشركة في السجل التجاري . وفي حالة الزيادة في رأس المال ، تكون الأسهم قابلة للتداول ابتداء من تاريخ التسديد الكامل لهذه الزيادة. ويحظر التداول في الوعود بالأسهم ، ما عدا إذا كانت أسهما تنشأ بمناسبة زيادة في رأسمال شركة كانت أسهمها القديمة قد سجلت في تسعيرة بورصة القيم . وفي هذه الحالة لا يصح التداول إلا إذا تم تحت شرط موقف لتحقيق الزيادة في رأس المال . ويكون هذا الشرط مفترضا في غياب أي بيان صريح."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_51> ;
