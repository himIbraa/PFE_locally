<https://legal.dz/resource/order/1975-09-26/75-59#version_art_105> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتم عملية الشطب بتأشير يقوم به مأمورو السجل التجاري على هامش القيد وتسلم شهادة منه للأطراف التي يطلبونها. ويحصل الشطب الكلي أو الجزئي للقيد في المعهد الجزائري للملكية الصناعية وتنظيمها ، طبقا ل المادة 99 وذلك بناء على تقديم شهادة الشطب المسلمة من مأموري السجل التجاري ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_105_19750926_OpEnact_afd937bf48> ;
