<https://legal.dz/resource/order/1975-09-26/75-59#art_87_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_87> ;
    dzdoc:position 0 ;
    dzdoc:text "يجري المزاد بزيارة السدس بنفس الشروط والمهل المقررة للبيع الذي طرأ عليه هذا المزاد بالزيادة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_88_condition_0_99e3ce9a> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_88_condition_0_99e3ce9a_role_24fe699569> ;
