<https://legal.dz/resource/order/1975-09-26/75-59#version_art_498> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعطى الضمان الاحتياطي سواء على الشيك أو على الورقة المتصلة به أو بورقة مستقلة يبين فيها المكان الذي تمت فيه. ويعبر عنه بكلمات « مقبول كضمان احتياطي » أو بأية صيغة أخرى مماثلة ومذيلة بتوقيع ضامن الوفاء . ويعتبر الضمان الاحتياطي حاصلا بمجرد توقيع ضمان الوفاء على وجه الشيك إلا إذا كان صاحب التوقيع هو الساحب . ويجب أن يذكر في الضمان اسم المضمون وإلا عد الضمان معطى للساحب ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_498_19750926_OpEnact_c203c47790> ;
    dzdoc:replacementText "يعطى الضمان الاحتياطي سواء على الشيك أو على الورقة المتصلة به أو بورقة مستقلة يبين فيها المكان الذي تمت فيه. ويعبر عنه بكلمات « مقبول كضمان احتياطي » أو بأية صيغة أخرى مماثلة ومذيلة بتوقيع ضامن الوفاء . ويعتبر الضمان الاحتياطي حاصلا بمجرد توقيع ضمان الوفاء على وجه الشيك إلا إذا كان صاحب التوقيع هو الساحب . ويجب أن يذكر في الضمان اسم المضمون وإلا عد الضمان معطى للساحب ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_498> ;
