    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_785> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_785_obligation_1_bf1be255_role_62640a3694> a dznorm:Role ;
    rdfs:label "المصفي عند طلب تجديد"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يجب على المصفي عند طلب تجديد وكالته أن يبين الأسباب التي حالت دون إقفال التصفية والتدابير التي ينوي اتخاذها والآجال التي يقتضيها إتمام التصفية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_785> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_785_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_785> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يجوز أن تتجاوز مدة وكالة المصفي ثلاثة أعوام، غير أنه يمكن تجديد هذه الوكالة من طرف الشركاء أو رئيس المحكمة بحسب ما إذا كان المصفي قد عين من طرف الشركاء أو بقرار قضائي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_785_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_785> ;
    dzdoc:position 1 ;
    dzdoc:text "إذا لم يكن بالإمكان انعقاد جمعية الشركاء بصفة قانونية، جددت الوكالة بقرار قضائي بناء على طلب المصفي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_785_para_2> a dzdoc:Paragraph ;
