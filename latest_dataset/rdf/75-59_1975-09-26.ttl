<https://legal.dz/resource/order/1975-09-26/75-59#version_art_122> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجري ترتيب الدائنين المرتهنين فيما بينهم على حسب ترتيب تاريخ قيودهم. وتكون للدائنين المرتهنين المقيدين في يوم واحد رتبة واحدة متساوية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_122_19750926_OpEnact_d1e6ea1b96> ;
    dzdoc:replacementText "يجري ترتيب الدائنين المرتهنين فيما بينهم على حسب ترتيب تاريخ قيودهم. وتكون للدائنين المرتهنين المقيدين في يوم واحد رتبة واحدة متساوية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_122> ;
