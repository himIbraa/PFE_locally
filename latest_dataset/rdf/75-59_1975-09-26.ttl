    dzdoc:eId "art_715_bis_90" ;
    dzdoc:fullText "باستثناء القيود التي تقررها الجمعية العامة لأصحاب سندات الاستحقاق ، يملك الوكلاء سلطة القيام باسم المجموعة بجميع أعمال التسيير للدفاع عن المصالح المشتركة لأصحاب سندات الاستحقاق ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_90> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_90_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
