<https://legal.dz/resource/order/1975-09-26/75-59#art_358> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_2> ;
    dzdoc:eId "art_358" ;
    dzdoc:fullText "يرد الاعتبار بقوة القانون لكل تاجر سواء كان شخصا طبيعيا أو معنويا، أشهر إفلاسه أو قبل في تسوية قضائية متى كان قد أوفى كامل المبالغ المدين بها من أصل ومصاريف . وحتى يرد الاعتبار بقوة القانون إلى شريك متضامن في شركة أشهر إفلاسها أو قبلت في تسوية قضائية يتعين عليه الإثبات أنه أوفى طبقا لنفس الشروط كافة ديون الشركة وذلك حتى إن كان قد منح صلحا منفردا. وفي حالة اختفاء واحد أو أكثر من الدائنين، أو غيابه أو رفضه قبوله ، يودع المبلغ المستحق في خزانة الأمانات والودائع ويكون الإثبات بالإيداع بمثابة مخالفة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_358_right_0_61849f17>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_358_right_1_9e4509e2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_358> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_358_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_358_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_358_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_358_19750926_OpEnact_5ee6420692> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_358_obligation_0_5b388cf5>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_358_obligation_1_c475c8b0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 358" ;
    dzdoc:position 363 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_358_condition_0_a53813d8>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_358_condition_1_ab720866> ;
    dzdoc:usesTerm dzterm:merchant .

<https://legal.dz/resource/order/1975-09-26/75-59#art_362> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_2> ;
    dzdoc:eId "art_362" ;
    dzdoc:fullText "لكل دائن لم يستوف حقوقه كاملة وفقا ل المادة 359 ، أن يعارض في رد الاعتبار التجاري خلال شهر واحد من تاريخ هذا الإعلان وذلك بإيداعه عريضة مسببة ومدعمة بوثائق ثبوتية لدى كتابة الضبط."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_362_right_0_7889ece6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_362> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_362_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_362_19750926_OpEnact_30fd69769e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 362" ;
    dzdoc:position 367 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_359> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_359> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_362_condition_0_ed425bd7> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_386> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_3_sec_2> ;
    dzdoc:eId "art_386" ;
    dzdoc:fullText "يقضى، فضلا عن ذلك، ببطلان تلك الاتفاقات بالنسبة لجميع الأشخاص المذكورين أعلاه بما فيهم المدين . ويتعين على الدائن بأن يرد لصاحب الشأن المبالغ أو القيم المنقولة التي قبضها بموجب الاتفاقات المحكوم ببطلانها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_386> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_386_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_386_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_386_19750926_OpEnact_ac2e13d08b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_386_obligation_0_4dc6e4ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 386" ;
    dzdoc:position 391 ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_411> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_6> ;
    dzdoc:eId "art_411" ;
    dzdoc:fullText "إن السفتجة المسحوبة للوفاء لدى الاطلاع تكون واجبة الدفع عند تقديمها. ويجب أن تقدم للدفع خلال سنة من تاريخها. ويمكن للساحب أن يقصر هذا الأجل أو أن يشترط أجلا أطول. كما يمكن للمظهرين تقصير الآجال المذكورة. يمكن لساحب السفتجة الواجبة الدفع لدى الاطلاع أن يشترط عدم تقديمها للدفع قبل أجل معين. وفي هذه الحالة تسري مهلة ابتداء من هذا الأجل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_411_permission_0_cb07d144>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_411_permission_1_7a699f7a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_411> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_411_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_411_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_411_19750926_OpEnact_9cdbd118fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "411" ;
    dzdoc:position 416 ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:drawer .

<https://legal.dz/resource/order/1975-09-26/75-59#art_464> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_13> ;
    dzdoc:eId "art_464" ;
    dzdoc:fullText "لا يدخل في حساب المواعيد القانونية أو الاتفاقية اليوم المعين لابتداء سريانها . ولا يجوز منح أجال قانونية كانت أو شرعية إلا في الأحوال المنصوص عليها في المادتين 426 و 438 من هذا القانون ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_464_permission_0_5aebf721> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_464> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_464_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_464_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_464_19750926_OpEnact_46fd6a78da> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_464_obligation_0_c9f62ae5>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_464_obligation_1_70162e78> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 464" ;
    dzdoc:position 469 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_426>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_438> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_426>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_438> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_478> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_478" ;
    dzdoc:fullText "يجوز أن يكون الشيك واجب الدفع في موطن الغير سواء بالمنطقة التي يوجد فيها موطن المسحوب عليه أو بمنطقة أخرى، بشرط أن يكون الغير مصرفا أو مكتبا للصكوك البريدية . إذا قدم شيك للقبض وكان به تعيين البنك المركزي الجزائري أو مصرف له حساب بالبنك المركزي أو مكتب للصكوك البريدية كموطن للوفاء فإن هذه الزيادة الواردة على نص الشيك لا تكون موجبة لوضع طابع مالي. وفوق ذلك لا يمكن تعيين هذا الموطن بالرغم عن إرادة الحامل ما لم يكن الشيك مسطرا أو الموطن معينا بالبنك المركزي الجزائري في نفس البلد."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_478_permission_0_9c6558f7>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_478_permission_1_5ebfcc1d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_478> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_478_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_478_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_478_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_478_19750926_OpEnact_8fd9a37e2b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "478" ;
    dzdoc:position 483 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_478_condition_0_c38d973e>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_478_condition_1_da667b87> ;
    dzdoc:usesTerm dzterm:cheque,
        dzterm:drawee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_487> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_2> ;
    dzdoc:eId "art_487" ;
    dzdoc:fullText "يجب أن يكون التظهير غير معلق على شرط وكل شرط يعلق عليه التظهير يعتبر كأن لم يكن. إن التظهير الجزئي باطل. كما أن تظهير المسحوب عليه باطل. إن التظهير للحامل يعد بمثابة تظهير على بياض . إن التظهير للمسحوب عليه يعتبر بمثابة إبراء فحسب إلا في حالة ما إذا كان للمسحوب عليه عدة مؤسسات وحصل التظهير لمصلحة مؤسسة غير التي سحب عليها الشيك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_487> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_487_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_487_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_487_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_487_para_3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_487_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_487_19750926_OpEnact_ec02f6a661> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_487_obligation_0_f0c74b15> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "487" ;
    dzdoc:position 492 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_487_condition_0_5e22ec28> ;
    dzdoc:usesTerm dzterm:blank_endorsement,
        dzterm:drawee,
        dzterm:endorsement,
        dzterm:endorsement_to_bearer,
        dzterm:endorsement_to_drawee,
        dzterm:partial_endorsement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_524> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_7> ;
    dzdoc:eId "art_524" ;
    dzdoc:fullText "فيما عدا الشيكات التي لحاملها ، يجوز تحرير الشيك في عدة نظائر مماثلة إن كان صادرا في الجزائر وواجب الوفاء في بلد آخر أو على عكس ذلك ، و إذا كان الشيك محررا في نظائر متعددة وجب ذكر أرقام النظائر في نص الشيك ذاته وإلا اعتبر كل نظير منها شيكا مستقلا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_524_permission_0_0fd694b1> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_524_right_0_98aec10a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_524> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_524_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_524_19750926_OpEnact_378e46a2f5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_524_obligation_0_2b5b9e45> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 524" ;
    dzdoc:position 529 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_524_condition_0_e45e8b44> ;
    dzdoc:usesTerm dzterm:cheque,
        dzterm:cheque_bearer .

<https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_8_bis> ;
    dzdoc:eId "art_526_bis_5" ;
    dzdoc:fullText "تحدد غرامة التبرئة بمائة دينار (100) دج) لكل قسط من ألف دينار (1000 دج) أو جزء منه. تضاعف هذه الغرامة في حالة العود. يدفع حاصل هذه الغرامات إلى الخزينة العمومية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_5_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_5_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_5_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_5_19750926_OpEnact_8602fb0cbc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_5_obligation_0_e7d0c343> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "526 مكرر 5" ;
    dzdoc:position 537 ;
    dzdoc:usesTerm dzterm:fine .

<https://legal.dz/resource/order/1975-09-26/75-59#art_563> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_563" ;
    dzdoc:fullText "في حالة إفلاس أحد الشركاء أو منعه من ممارسة مهنته التجارية أو فقدان أهليته ، تنحل الشركة، ما لم ينص القانون الأساسي على استمرارها أو يقرر باقي الشركاء ذلك بإجماع الآراء . وفي حالة الاستمرار تعين حقوق الشريك الفاقد لهذه الصفة والواجب أداؤها له، طبقا للفقرة الأولى من المادة 559 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_563_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_563_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_19750926_OpEnact_9ea5aab6b6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "563" ;
    dzdoc:position 610 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_559> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_559> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_563_condition_0_18f84545>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_563_condition_1_0fc924ef>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_563_condition_2_e9655ffb> ;
    dzdoc:usesTerm dzterm:partners .

<https://legal.dz/resource/order/1975-09-26/75-59#art_567> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_567" ;
    dzdoc:fullText "يجب أن يتم الاكتتاب بجميع الحصص من طرف الشركاء وأن تدفع قيمتها كاملة سواء كانت الحصص عينية أو نقدية . ولا يجوز أن تمثل الحصص بتقديم عمل، ويذكر توزيع الحصص في القانون الأساسي. إن المال الناتج عن تسديد قيمة الحصص المودعة بمكتب التوثيق، تسلم إلى مدير الشركة بعد قيدها بالسجل التجاري."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_567_permission_0_b1e7830d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_567> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_567_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_567_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_567_19750926_OpEnact_2de8b4761a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_567_obligation_0_333d3a2a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "567" ;
    dzdoc:position 625 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_593> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_593" ;
    dzdoc:fullText "يطلق على شركة المساهمة تسمية الشركة، ويجب أن تكون مسبوقة أو متبوعة بذكر شكل الشركة ومبلغ رأسمالها . يجوز إدراج اسم شريك واحد أو أكثر في تسمية الشركة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_593_permission_0_9a8cc55d> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_593_right_0_c90d1792> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_593> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_593_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_593_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_593_19750926_OpEnact_424c0aa668> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_593_obligation_0_f8f336f2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "593" ;
    dzdoc:position 652 ;
    dzdoc:usesTerm dzterm:joint_stock_company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_599> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_599" ;
    dzdoc:fullText "تكون الاكتتابات والمبالغ المدفوعة مثبتة في تصريح المؤسسين بواسطة عقد موثق. يؤكد الموثق بناء على تقديم بطاقات الاكتتاب في مضمون العقد الذي يحرره، أن مبلغ الدفعات المصرح بها من المؤسسين يطابق مقدار المبالغ المودعة إما بين يديه أو لدى المؤسسات المالية المؤهلة قانونا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_599> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_599_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_599_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_599_19750926_OpEnact_d51dd5481c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "599" ;
    dzdoc:position 658 ;
    dzdoc:usesTerm dzterm:notary .

<https://legal.dz/resource/order/1975-09-26/75-59#art_618> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_618" ;
    dzdoc:fullText "تعرض التعيينات التي يقوم بها المجلس بمقتضى المقطعين 1 و 3 من المادة 617 أعلاه، على الجمعية العامة العادية المقبلة للمصادقة عليها. وعند عدم المصادقة، فإن المداولات المتخذة والتصرفات التي قام بها المجلس سابقا تعتبر صحيحة على أي حال. وإذا أهمل المجلس القيام بالتعيينات المطلوبة أو استدعاء الجمعية ، جاز لكل معني بالأمر أن يطلب من القضاء تعيين وكيل يكلف باستدعاء الجمعية العامة لإجراء التعيينات أو المصادقة على التعيينات المذكورة في المادة السابقة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_618_right_0_1863e7b5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_618> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_618_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_618_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_618_19750926_OpEnact_2359b87486> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_618_obligation_0_bceec34c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "618" ;
    dzdoc:position 677 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_617> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_617> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_618_condition_0_5a2b81c3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_618_condition_1_6de82e2a> ;
    dzdoc:usesTerm dzterm:board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_637> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_637" ;
    dzdoc:fullText "في حالة وقوع مانع مؤقت للرئيس أو وفاته أو استقالته أو عزله ، يجوز ل مجلس الإدارة أن ينتدب قائما بالإدارة ليقوم بوظائف الرئيس . وفي حالة المانع المؤقت ، يمنح هذا الانتداب لمدة محددة قابلة للتجديد. وفي حالة الوفاة أو الاستقالة أو الإقالة ، تستمر هذه المدة إلى غاية انتخاب رئيس جديد."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_637_permission_0_66a5790e> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_637_right_0_5aa7f04e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_637> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_637_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_637_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_637_19750926_OpEnact_064230afab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 637" ;
    dzdoc:position 696 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_637_condition_0_5d5d9583>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_637_condition_1_021fea39>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_637_condition_2_02d5918c> ;
    dzdoc:usesTerm dzterm:board_of_directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_639> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_639" ;
    dzdoc:fullText "يجوز ل مجلس الإدارة ، بناء على اقتراح الرئيس، أن يكلف شخصا واحدا أو اثنين من الأشخاص الطبيعيين ليساعد الرئيس كمديرين عامين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_639_permission_0_9252a0dc> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_639_right_0_c245963c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_639> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_639_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_639_19750926_OpEnact_8e3744ed0c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 639" ;
    dzdoc:position 698 ;
    dzdoc:usesTerm dzterm:board_of_directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_659> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_659" ;
    dzdoc:fullText "يجب على أعضاء مجلس المراقبة أن يحوزوا أسهم الضمانات الخاصة بتسييرهم حسب الشروط المنصوص عليها في المادة 619 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_659> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_659_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_659_19750926_OpEnact_a414e5d051> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_659_obligation_0_f8d7dc10> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 659" ;
    dzdoc:position 718 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_619> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_619> ;
    dzdoc:usesTerm dzterm:board_of_auditors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_66> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_3> ;
    dzdoc:eId "art_66" ;
    dzdoc:fullText "يجوز للناقل ، استنادا لاشتراط كتابي مدرج في سند النقل ومطابق للقوانين والأنظمة الجاري بها العمل ومبلغ للمسافر ، و فيما عدا حالة الخطأ العمدي أو الجسيم المرتكب منه بنفسه أو من مستخدمه إعفاءه كليا أو جزئيا من مسؤوليته عن التأخير أو الأضرار غير البدنية الحاصلة للمسافر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_66_permission_0_a46ef15e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_66> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_66_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_66_19750926_OpEnact_ccc222de9f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 66" ;
    dzdoc:position 68 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_66_condition_0_f8f73298>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_66_condition_1_e8e39975> ;
    dzdoc:usesTerm dzterm:carrier .

<https://legal.dz/resource/order/1975-09-26/75-59#art_707> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_707" ;
    dzdoc:fullText "في حالة ما إذا كانت الحصص المقدمة عينية أو كان هناك اشتراط منافع خاصة ، فإنه يعين واحد أو أكثر من المندوبين المكلفين بتقدير الحصص العينية بقرار قضائي بناء على طلب رئيس مجلس الإدارة أو مجلس المديرين ويخضع هؤلاء المندوبون للتنافي المنصوص عليه في المادة 679 . ويتم تقدير الحصص العينية والامتيازات خاصة تحت مسؤولية هؤلاء المندوبين، ويوضع تقريرهم تحت تصرف المساهمين قبل ثمانية أيام على الأقل من تاريخ انعقاد الجمعية. وتطبق أحكام المادة 603 على الجمعية العامة غير العادية. إذا أقرت الجمعية العامة تقدير الحصص ومنح المنافع الخاصة ، فإنها تثبت تحقيق زيادة رأس المال. وإذا خفضت الجمعية تقدير الحصص المقدمة ومكافأة المنافع الخاصة ، فإن المصادقة الصريحة لتعديلات مقدمي الحصص أو المستفيدين أو وكلائهم المرخص لهم قانونا بهذا الشأن، تعد واجبة. فإذا لم يتحقق ذلك فإن زيادة رأس المال تبقى غير محققة. وتصبح أسهم الحصص المقدمة بكاملها مسددة بمجرد إصدارها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_707> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_707_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_707_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_707_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_707_para_3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_707_para_4> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_707_19750926_OpEnact_d3d9f8578e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_707_obligation_0_81b7013f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "707" ;
    dzdoc:position 765 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_603>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_679> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_603>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_679> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_707_condition_0_ba7ab775>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_707_condition_1_52cbb777>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_707_condition_2_25e69ae5> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_715_bis" ;
    dzdoc:fullText "خلافا للمادة 714 ، المقطع الأول أعلاه، فإن الشركات التي تكون أسهمها مقبولة في التسعيرة الرسمية لبورصة الأوراق المالية، يمكنها شراء أسهمها الخاصة في البورصة لتنظيم سعر الأسهم . ولهذا الغرض، يجب على الجمعية العامة العادية أن تكون قد رخصت صراحة للشركة القيام بعمليات البورصة بأسهمها الخاصة ، كما أنها تحدد كيفيات إجراء العملية ولا سيما السعر الأقصى للشراء والسعر الأدنى للبيع، وكذا العدد الأقصى من الأسهم الواجب حيازتها والأجل الذي يجب أن تتم خلاله الحيازة. ولا يمكن منح هذه الرخصة لأجل يفوق سنة واحدة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_permission_0_9c38c91e> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_right_0_1c05c3ae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_19750926_OpEnact_b454cc59d1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر" ;
    dzdoc:position 774 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_714> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_714> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_condition_0_29f6d429> ;
    dzdoc:usesTerm dzterm:companies .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_715_bis_1" ;
    dzdoc:fullText "يجب على الشركات أن تصرح للسلطة المكلفة بتنظيم عمليات البورصة ومراقبتها بالصفقات التي تنوي القيام بها تطبيقا للمادة 714 المذكورة أعلاه وتعلم لجنة البورصة بعمليات الحيازة التي قامت بها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_1_19750926_OpEnact_d2c7f5700c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_1_obligation_0_41a467bb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 1" ;
    dzdoc:position 775 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_714> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_714> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_104> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_104" ;
    dzdoc:fullText "يجوز للجمعية العامة لأصحاب سندات الاستحقاق أن تطلب تسديد سندات الاستحقاق في حالة حل مسبق للشركة لم يسببه إدماج أو انقسام ، و يمكن الشركة أن تفرض هذا التسديد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_104_permission_0_9434e886> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_104_right_0_37a69fb0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_104_right_1_77b3e553> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_104> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_104_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_104_19750926_OpEnact_302429a620> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 104" ;
    dzdoc:position 878 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_104_condition_0_f831aac9> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_1> ;
    dzdoc:eId "art_715_bis_36" ;
    dzdoc:fullText "يمكن أن ينص القانون الأساسي على أن للشركة الحق في طلب تعريف الحائزين على أسهم أو سندات أخرى تمنح، على الفور أو لأجل الحق في التصويت في جمعيات مساهميها وكذا عدد السندات التي يملكها كل واحد منهم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_36_permission_0_dd963560> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_36_right_0_3d811118> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_36_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_36_19750926_OpEnact_7a5b889803> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 36" ;
    dzdoc:position 810 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_51" ;
    dzdoc:fullText "لا تكون الأسهم قابلة للتداول إلا بعد تقييد الشركة في السجل التجاري . وفي حالة الزيادة في رأس المال ، تكون الأسهم قابلة للتداول ابتداء من تاريخ التسديد الكامل لهذه الزيادة. ويحظر التداول في الوعود بالأسهم ، ما عدا إذا كانت أسهما تنشأ بمناسبة زيادة في رأسمال شركة كانت أسهمها القديمة قد سجلت في تسعيرة بورصة القيم . وفي هذه الحالة لا يصح التداول إلا إذا تم تحت شرط موقف لتحقيق الزيادة في رأس المال . ويكون هذا الشرط مفترضا في غياب أي بيان صريح."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_51_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_51_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_51_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_51_19750926_OpEnact_cd2dd49461> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_51_obligation_0_af569801>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_51_obligation_1_cee873ce>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_51_obligation_2_db3ea8b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 51" ;
    dzdoc:position 825 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_51_condition_0_9e7ae196>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_51_condition_1_f5c4db85> ;
    dzdoc:usesTerm dzterm:shares .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_3> ;
    dzdoc:eId "art_715_bis_69" ;
    dzdoc:fullText "يجوز لحاملي شهادات الاستثمار وشهادات الحق في التصويت الإطلاع على وثائق الشركة حسب نفس الشروط المطبقة على المساهمين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_69_permission_0_e65e0e58> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_69_right_0_22637853> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_69_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_69_19750926_OpEnact_9ce250a5ba> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 69" ;
    dzdoc:position 843 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_3> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "يجوز للوكيل بالعمولة ، استنادا لاشتراط كتابي مدرج في سند النقل ومطابق للقوانين والأنظمة الجاري بها العمل ومبلغ للمسافر ، و فيما عدا حالة الخطأ العمدي أو الجسيم والمرتكب إما منه بنفسه أو من مستخدمه، وإما من الناقل أو مستخدم هذا الأخير ، أن يشترط إعفاءه كليا أو جزئيا من مسؤوليته عن التأخير أو الأضرار غير البدنية الحاصلة للمسافر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_72_permission_0_bef1638d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_72_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_72_19750926_OpEnact_146f659eea> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 72" ;
    dzdoc:position 74 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_72_condition_0_f8f73298>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_72_condition_1_4448c48e> ;
    dzdoc:usesTerm dzterm:commission_agent .

<https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_732_bis_1" ;
    dzdoc:fullText "عندما تأخذ شركة، خلال سنة مالية مساهمة في شركة يوجد مركزها بالجزائر، أو تحصلت على أكثر من نصف رأسمال هذه الشركة ، يذكر ذلك في التقرير الذي يقدم للشركاء والمتعلق بالعمليات التي تم إجراؤها خلال السنة المالية، وعند الاقتضاء، في تقرير محافظي الحسابات . يشير مجلس الإدارة أو مجلس المديرين أو المسير في تقريره إلى نشاط الشركات التابعة حسب مجال النشاط كما يظهر النتائج المحصل عليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_732_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_1_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_732_bis_1_19750926_OpEnact_bbdcdf36f5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_1_obligation_0_9bef1dc8>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_1_obligation_1_5ab22a05> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "732 مكرر 1" ;
    dzdoc:position 936 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_1_condition_0_00566f05> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_745> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_745" ;
    dzdoc:fullText "يسوغ تحقيق العمليات المشار إليها في المادة المتقدمة بين شركات ذات شكل مختلف. ويجب أن تقررها كل واحدة من الشركات المعنية حسب الشروط المطلوبة في تعديل قوانينها الأساسية . إذا كانت العملية تتضمن إحداث شركات جديدة ، يتعين تأسيس كل واحدة منها حسب القواعد الخاصة بكل شكل من الشركة الموافق عليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_745> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_745_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_745_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_745_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_745_19750926_OpEnact_29ee268436> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_745_obligation_0_69f110e2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_745_obligation_1_7b9a3478> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "745" ;
    dzdoc:position 952 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_744> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_744> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_745_condition_0_ce70d8cc> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_755> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_755" ;
    dzdoc:fullText "إذا تحقق الإدماج عن طريق إنشاء شركة جديدة ، فإنه يمكن أن تتكون هذه الشركة دون حصص أخرى غير تلك التي تكونت من جراء الإدماج . وفي هذه الحالة يجوز لمساهمي هذه الشركات أن يجتمعوا بحكم القانون في جمعية عامة تأسيسية للشركة الجديدة الناشئة عن طريق الإدماج ، أما بالنسبة للإجراءات فإنها تتبع طبقا للأحكام التي تنظم تكوين الشركات المساهمة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_755_permission_0_ceed967a> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_755_right_0_56459253>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_755_right_1_3688adbb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_755> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_755_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_755_19750926_OpEnact_f40f12e7f5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 755" ;
    dzdoc:position 962 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_755_condition_0_2312bdec> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_784> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_784" ;
    dzdoc:fullText "إذا وقع انحلال الشركة بأمر قضائي فإن هذا القرار يعين مصفيا واحدا أو أكثر. إذا عين عدة مصفين فإنه يجوز لهم ممارسة مهامهم على انفراد، وذلك باستثناء كل نص مخالف لأمر التسمية. إلا أن المصفين يتعين عليهم أن يضعوا ويقدموا تقريرا مشتركا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_784_permission_0_c3698444> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_784> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_784_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_784_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_784_19750926_OpEnact_c80b2ea37a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_784_obligation_0_d34113f6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "784" ;
    dzdoc:position 991 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_784_condition_0_ded9330d>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_784_condition_1_b43e2b8d> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_5> ;
    dzdoc:eId "art_799_bis_1" ;
    dzdoc:fullText "أعضاء التجمع ملزمون بتسديد ديونه وذلك من ثروتهم الخاصة . وهم متضامنون إلا إذا وجد اتفاق مخالف مع المتعاقدين الآخرين. لا يجوز لدائني التجمع متابعة تسديد الديون ضد عضو من الأعضاء إلا إذا تم توجيه إنذار للتجمع عن طريق وثيقة غير قضائية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis_1_permission_0_378bf42c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_799_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis_1_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_799_bis_1_19750926_OpEnact_cfcbfeaa7e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis_1_obligation_0_6f0e3821> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis_1_prohibition_0_378bf42c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 799 مكرر 1" ;
    dzdoc:position 1013 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis_1_condition_0_67cdc2df> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_90> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_90" ;
    dzdoc:fullText "يجب على كل حائز للثمن الذي تم به بيع محل تجاري أن يقوم بتوزيعه في ظرف ثلاثة أشهر من تاريخ عقد البيع . وبانقضاء هذه المهلة يجوز للطرف الذي يهمه التعجيل، أن يرفع دعوى مستعجلة أمام رئيس المحكمة التي يقع المحل التجاري في دائرة اختصاصها والذي يأمر إما بإيداع الثمن في مصلحة الودائع والأمانات وإما بتعيين حارس موزع."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_90_permission_0_1a10c498> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_90_right_0_54f78f69> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_90> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_90_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_90_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_90_19750926_OpEnact_c4ac14d8b7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_90_obligation_0_05b60c54> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "90" ;
    dzdoc:position 92 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_91> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_91" ;
    dzdoc:fullText "عند حصول المعارضة في دفع الثمن يمكن للبائع في كل الأحوال وبعد انقضاء مهلة خمسة عشر يوما ابتداء من رفع تلك المعارضة، أن يرفع دعوى مستعجلة أمام رئيس المحكمة طالبا فيها الإذن له بقبض الثمن بالرغم من المعارضة على شرط أن يدفع لمصلحة الودائع والأمانات أو للغير المنتدب لهذا الغرض المبلغ الكافي الذي يعينه قاضي الأمور المستعجلة لضمان أسباب المعارضة فيما إذا ظهر أو حكم عليه بأنه مدين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_91_permission_0_9c3d73cb> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_91_right_0_7d9f7657> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_91> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_91_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_91_19750926_OpEnact_d5b7ad591d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "91" ;
    dzdoc:position 93 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_91_condition_0_65619606>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_91_condition_1_bff2a6ff> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_93> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_93" ;
    dzdoc:fullText "لا يجوز لقاضي الأمور المستعجلة أن يمنح الإذن المطلوب إلا إذا أقام المشتري المدخل في الدعوى إشهادا صريحا بعدم وجود دائنين آخرين معارضين غير الدائنين الذين شملهم النزاع . ولا تعتبر ذمة المشتري مبرأة بتنفيذه الأمر تجاه الدائنين الآخرين إذا وجدوا على أثر حجوز ما للمدين لدى الغير ومبلغة قبل صدور الأمر وقد تعمد المشتري إخفاءها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_93_permission_0_f9a8ac44> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_93> ;
