<https://legal.dz/resource/order/1975-09-26/75-59#version_art_564> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تؤسس الشركة ذات المسؤولية المحدودة من شخص واحد أو عدة أشخاص لا يتحملون الخسائر إلا في حدود ما قدموا من حصص . إذا كانت الشركة ذات المسؤولية المحدودة المؤسسة طبقا للفقرة السابقة، لا تضم إلا شخصا واحدا \" كشريك وحيد \" ، تسمى هذه الشركة \" مؤسسة ذات الشخص الوحيد وذات المسؤولية المحدودة \". يمارس الشريك الوحيد السلطات المخولة جمعية الشركاء بمقتضى أحكام هذا الفصل. وتعين بعنوان للشركة يمكن أن يشتمل على اسم واحد من الشركاء أو أكثر على أن تكون هذه التسمية مسبوقة أو متبوعة بكلمات \" شركة ذات مسؤولية محدودة \" "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_564_19750926_OpEnact_d10cb20b7b> ;
    dzdoc:replacementText "تؤسس الشركة ذات المسؤولية المحدودة من شخص واحد أو عدة أشخاص لا يتحملون الخسائر إلا في حدود ما قدموا من حصص . إذا كانت الشركة ذات المسؤولية المحدودة المؤسسة طبقا للفقرة السابقة، لا تضم إلا شخصا واحدا \" كشريك وحيد \" ، تسمى هذه الشركة \" مؤسسة ذات الشخص الوحيد وذات المسؤولية المحدودة \". يمارس الشريك الوحيد السلطات المخولة جمعية الشركاء بمقتضى أحكام هذا الفصل. وتعين بعنوان للشركة يمكن أن يشتمل على اسم واحد من الشركاء أو أكثر على أن تكون هذه التسمية مسبوقة أو متبوعة بكلمات \" شركة ذات مسؤولية محدودة \" أو الأحرف الأولى منها أي \" ش. م. م \" وبيان رأسمال الشركة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_564> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
