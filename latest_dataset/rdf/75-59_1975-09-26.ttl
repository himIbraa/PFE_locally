    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_601>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_603>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_605>,
