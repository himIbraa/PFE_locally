<https://legal.dz/resource/order/1975-09-26/75-59#version_art_414> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على حامل السفتجة الواجبة الدفع في يوم محدد أو في أجل ما من تاريخ معين أو بعد الإطلاع، أن يقدم السفتجة للدفع إما في يوم وجوب دفعها أو في أحد يومي العمل المواليين له . ويعتبر التقديم المادي للسفتجة لغرفة المقاصة بمثابة تقديم للوفاء. يمكن أن يتم هذا التقديم أيضا بأية وسيلة تبادل إلكترونية محددة في التشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_414_19750926_OpEnact_e178a361f8> ;
    dzdoc:replacementText "يجب على حامل السفتجة الواجبة الدفع في يوم محدد أو في أجل ما من تاريخ معين أو بعد الإطلاع، أن يقدم السفتجة للدفع إما في يوم وجوب دفعها أو في أحد يومي العمل المواليين له . ويعتبر التقديم المادي للسفتجة لغرفة المقاصة بمثابة تقديم للوفاء. يمكن أن يتم هذا التقديم أيضا بأية وسيلة تبادل إلكترونية محددة في التشريع والتنظيم المعمول بهما."@ar ;
