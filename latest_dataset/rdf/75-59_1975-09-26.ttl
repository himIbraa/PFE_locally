<https://legal.dz/resource/order/1975-09-26/75-59#version_art_264> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجري مباشرة جرد أموال المدين بحضوره أو بعد استدعائه قانونا بموجب رسالة موصى عليها . ويجري في نفس الوقت التحقيق من وجود الأشياء التي لم تكن قد وضعت عليها الأختام، أو تكون قد استخرجت وكان تقويمها وجردها طبقا ل المادة 260 . وتحرر قائمة الجرد تلك في أصلين يودع أحدهما فورا بكتابة ضبط المحكمة المختصة ويبقى الأصل الثاني بين يدي وكيل التفليسة . ويجوز أن يعاون وكيل التفليسة في تحرير قائمة الجرد أي شخص يرى اختياره لذلك أو ليقدر قيمة الأشياء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_264_19750926_OpEnact_24d73e6491> ;
    dzdoc:replacementText "يجري مباشرة جرد أموال المدين بحضوره أو بعد استدعائه قانونا بموجب رسالة موصى عليها . ويجري في نفس الوقت التحقيق من وجود الأشياء التي لم تكن قد وضعت عليها الأختام، أو تكون قد استخرجت وكان تقويمها وجردها طبقا ل المادة 260 . وتحرر قائمة الجرد تلك في أصلين يودع أحدهما فورا بكتابة ضبط المحكمة المختصة ويبقى الأصل الثاني بين يدي وكيل التفليسة . ويجوز أن يعاون وكيل التفليسة في تحرير قائمة الجرد أي شخص يرى اختياره لذلك أو ليقدر قيمة الأشياء ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_264> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
