<https://legal.dz/resource/order/1975-09-26/75-59#version_art_129> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يقم الراسي عليه المزاد بتنفيذ شروط مرسى المزاد يعاد بيع المحل التجاري عن طريق إعادة المزايدة بعد إنذار غير متبوع بنتيجة، في مهلة عشرين يوما وذلك وفقا للأوضاع المقررة في المادة 127 أعلاه. ويلزم المزايد المتخلف، تجاه دائني البائع والبائع نفسه بالفرق الحاصل بين الثمن الذي تم به البيع له والثمن الحاصل من إعادة البيع عن طريق إعادة المزايدة ، دون أن يكون له الحق في المطالبة بالمزايدة إن وجدت. وتكون نفقات المزايدة الأولى على عاتق الراسي عليه المزاد الأولي، وتحصل عند الاقتضاء تنفيذيا بواسطة الموظ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_129_19750926_OpEnact_3637167ff6> ;
    dzdoc:replacementText "إذا لم يقم الراسي عليه المزاد بتنفيذ شروط مرسى المزاد يعاد بيع المحل التجاري عن طريق إعادة المزايدة بعد إنذار غير متبوع بنتيجة، في مهلة عشرين يوما وذلك وفقا للأوضاع المقررة في المادة 127 أعلاه. ويلزم المزايد المتخلف، تجاه دائني البائع والبائع نفسه بالفرق الحاصل بين الثمن الذي تم به البيع له والثمن الحاصل من إعادة البيع عن طريق إعادة المزايدة ، دون أن يكون له الحق في المطالبة بالمزايدة إن وجدت. وتكون نفقات المزايدة الأولى على عاتق الراسي عليه المزاد الأولي، وتحصل عند الاقتضاء تنفيذيا بواسطة الموظف العمومي المكلف بالبيع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_129> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_129> ;
