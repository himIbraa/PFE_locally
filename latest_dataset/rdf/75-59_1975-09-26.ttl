<https://legal.dz/resource/order/1975-09-26/75-59#version_art_342> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا جرت متابعة المدين ، بعد التصديق، لاتهامه بالتفليس ووضع قيد التوقف أو الحبس ، يجوز للمحكمة أن تتخذ التدابير التحفظية التي تراها، ويوقف العمل بهذه التدابير بمجرد صدور أمر أو حكم بعدم المعارضة أو حكم بالإعفاء من التهمة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_342_19750926_OpEnact_cf1c10da54> ;
    dzdoc:replacementText "إذا جرت متابعة المدين ، بعد التصديق، لاتهامه بالتفليس ووضع قيد التوقف أو الحبس ، يجوز للمحكمة أن تتخذ التدابير التحفظية التي تراها، ويوقف العمل بهذه التدابير بمجرد صدور أمر أو حكم بعدم المعارضة أو حكم بالإعفاء من التهمة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_342> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_342> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_343> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أبطل الصلح أو فسخ يقوم وكيل التفليسة فورا بجرد الأوراق المالية والأسهم والأوراق على أساس القائمة القديمة وبمعونة القاضي الذي وضع الأختام طبقا ل المادة 258 ، ويقوم بتحرير قائمة وميزانية تكميلية إذا اقتضى الحال ذلك. ويجري حالا نشر موجز للحكم الصادر ودعوة للدائنين الجدد إن كانوا ، ليقدموا مستندات ديونهم للتحقيق وفقا للأوضاع المنصوص عليها في المادة 228 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_343_19750926_OpEnact_2114a46bb5> ;
    dzdoc:replacementText "إذا أبطل الصلح أو فسخ يقوم وكيل التفليسة فورا بجرد الأوراق المالية والأسهم والأوراق على أساس القائمة القديمة وبمعونة القاضي الذي وضع الأختام طبقا ل المادة 258 ، ويقوم بتحرير قائمة وميزانية تكميلية إذا اقتضى الحال ذلك. ويجري حالا نشر موجز للحكم الصادر ودعوة للدائنين الجدد إن كانوا ، ليقدموا مستندات ديونهم للتحقيق وفقا للأوضاع المنصوص عليها في المادة 228 ."@ar ;
