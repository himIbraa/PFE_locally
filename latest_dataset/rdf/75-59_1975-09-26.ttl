<https://legal.dz/resource/order/1975-09-26/75-59#art_731_defocc_23a9f2e0c16a> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 99 ;
    dzdoc:charStart 85 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:holding_company ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_731> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_731_para_2> ;
    dzdoc:paragraphPosition 2 ;
    dzdoc:snippet "تسمى الشركة التي تراقب شركة أو عدة شركات وفقا للفقرات السابقة، قصد تطبيق هذا القسم، \"الشركة القابضة\"."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_731_defocc_efc6b78238cc> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 29 ;
    dzdoc:charStart 12 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:controlling_company ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_731> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_731_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """تعد شركة ما مراقبة لشركة أخرى قصد تطبيق أحكام هذا القسم:
                
                
                عندما تملك بصفة مباشرة أو غير مباشرة جزءا من رأسمال لها يخول أغلبية الأصوات في الجمعيات العامة هذه الشركة،
                
                
                عندما تملك وحدها أغلبية الأصوات في هذه الشركة بموجب اتفاق مع باقي الشركاء الآخرين أو المساهمين، على إلا يخالف هذا الاتفاق مصالح الشركة،
                
                
                عندما تتحكم في الواقع، بموجب حقوق التصويت التي تملكها، في قرارات الجمعيات العامة لهذه الشركة."""@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_731_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_731> ;
    dzdoc:position 0 ;
    dzdoc:text "تعد شركة ما مراقبة لشركة أخرى قصد تطبيق أحكام هذا القسم: عندما تملك بصفة مباشرة أو غير مباشرة جزءا من رأسمال لها يخول أغلبية الأصوات في الجمعيات العامة هذه الشركة، عندما تملك وحدها أغلبية الأصوات في هذه الشركة بموجب اتفاق مع باقي الشركاء الآخرين أو المساهمين، على إلا يخالف هذا الاتفاق مصالح الشركة، عندما تتحكم في الواقع، بموجب حقوق التصويت التي تملكها، في قرارات الجمعيات العامة لهذه الشركة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_731_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_731> ;
    dzdoc:position 2 ;
    dzdoc:text "تسمى الشركة التي تراقب شركة أو عدة شركات وفقا للفقرات السابقة، قصد تطبيق هذا القسم، \"الشركة القابضة\"."@ar .

