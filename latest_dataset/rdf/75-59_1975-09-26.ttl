<https://legal.dz/resource/order/1975-09-26/75-59#art_485_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_485> ;
    dzdoc:position 0 ;
    dzdoc:text "إن الشيك المشترط دفعه إلى شخص مسمى بموجب اشتراط صريح \" للأمر\" أو بدونه يكون قابلا للتداول بطريق التظهير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_485_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_485> ;
    dzdoc:position 1 ;
