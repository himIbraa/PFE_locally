<https://legal.dz/resource/order/1975-09-26/75-59#version_art_400> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن للأشخاص المدعى عليهم بمقتضى السفتجة أن يحتجوا على الحامل بالدفوع المبينة على علاقاتهم الشخصية بالساحب أو بحامليها السابقين ما لم يكن الحامل قد تعمد عند اكتسابه السفتجة الإضرار بالمدين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_400_19750926_OpEnact_2e2c0a88ef> ;
    dzdoc:replacementText "لا يمكن للأشخاص المدعى عليهم بمقتضى السفتجة أن يحتجوا على الحامل بالدفوع المبينة على علاقاتهم الشخصية بالساحب أو بحامليها السابقين ما لم يكن الحامل قد تعمد عند اكتسابه السفتجة الإضرار بالمدين."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_400> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
