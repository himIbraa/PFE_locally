    dzdoc:sourceTextSpan "يعاقب بغرامة من 20.000 دج إلى 50.000 دج رئيس شركة المساهمة والقائمون بإدارتها ومديروها العامون أو مسيروها الذين أغفلوا الإشارة على العقود أو المستندات الصادرة من الشركة والمخصصة للغير اسم الشركة مسبوقا أو متبوعا فورا بالكلمات الآتية { شركات المساهمة } ومكان مركز الشركة وبيان رأس مالها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_833> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_833_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_833> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بغرامة من 20.000 دج إلى 50.000 دج رئيس شركة المساهمة والقائمون بإدارتها ومديروها العامون أو مسيروها الذين أغفلوا الإشارة على العقود أو المستندات الصادرة من الشركة والمخصصة للغير اسم الشركة مسبوقا أو متبوعا فورا بالكلمات الآتية { شركات المساهمة } ومكان مركز الشركة وبيان رأس مالها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_834_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_834> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق أحكام هذا الفصل الخاصة برئيس الشركة والقائمين بإدارتها أو مديريها العامين على كل شخص قام مباشرة أو بواسطة شخص بممارسة مديرية تلك الشركات أو إدارتها في ظل محل أو مكان نائبيهم القانونيين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_835_condition_0_cd831142> a dznorm:Condition ;
    dznorm:conditionText "الذين أصدروا لحساب هذه الشركة أسهما تقل قيمتها الاسمية عن الحد الأدنى القانوني"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_835> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_835_obligation_0_c78547ec> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
