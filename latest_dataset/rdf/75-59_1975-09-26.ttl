    dznorm:position 0 ;
    dznorm:provisionText "يستوجب الموافقة الاجماعية للشركاء"@ar ;
    dznorm:sourceArticle "art_591" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_591_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_591> ;
    dzdoc:position 0 ;
    dzdoc:text "إن تحويل شركة ذات مسؤولية محدودة إلى شركة تضامن يستوجب الموافقة الاجماعية للشركاء."@ar .

