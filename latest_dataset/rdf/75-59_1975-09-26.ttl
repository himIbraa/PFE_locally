<https://legal.dz/resource/order/1975-09-26/75-59#art_779_obligation_0_9f5e5613> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_779_obligation_0_9f5e5613_ref_d1dfd916a863> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_778> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_778> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_779> ;
    dznorm:position 0 ;
    dznorm:provisionText "تنتهي سلطات مجلس الإدارة أو المسيرين اعتبارا من تاريخ الأمر المستعجل المتخذ طبقا لالمادة المتقدمة أو من تاريخ انحلال الشركة إن كان لاحقا"@ar ;
    dznorm:sourceArticle "art_779" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_779_obligation_0_9f5e5613_ref_d1dfd916a863> a dzdoc:Reference ;
    rdfs:label "المادة المتقدمة"@ar ;
    dzdoc:frbrUri "#art_778"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1975-09-26/75-59#art_778> ;
    dzdoc:sourceEId "art_779" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "تنتهي سلطات مجلس الإدارة أو المسيرين اعتبارا من تاريخ الأمر المستعجل المتخذ طبقا لالمادة المتقدمة أو من تاريخ انحلال الشركة إن كان لاحقا"@ar ;
    dzdoc:targetEId "art_778" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_779_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_779> ;
    dzdoc:position 0 ;
    dzdoc:text "تنتهي سلطات مجلس الإدارة أو المسيرين اعتبارا من تاريخ الأمر المستعجل المتخذ طبقا لالمادة المتقدمة أو من تاريخ انحلال الشركة إن كان لاحقا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_77_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_77> ;
    dzdoc:position 0 ;
    dzdoc:text "تكون باطلة وعديمة الأثر جميع الاشتراطات المخالفة بصفة مسبقة لما يلي: 1 - أحكام المواد 38 و 44 الفقرة 2 و 46 الفقرة 1 و 49 الفقرة 1 و 51 و 53 و 55 و 61 و 65 و 71 و 74 و 75 و 76، 2 - أحكام المواد 47 و 58 و 62 و 64 و 69 إلا إذا كانت الاشتراطات في كل من الحدود المرخص بها بموجب المواد 52 و 59 و 66 و 72."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_780_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_780> ;
    dzdoc:position 0 ;
    dzdoc:text "لا تنهي مهام مندوبي الحسابات بانحلال الشركة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_781_condition_0_cbeaed85> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يوجد مندوبو الحسابات، ولو في الشركات غير الملتزمة بتعيينهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_781> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_781_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_781> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا لم يوجد مندوبو الحسابات، ولو في الشركات غير الملتزمة بتعيينهم، يجوز تعيين مراقب واحد أو أكثر من طرف الشركات طبقا للشروط المنصوص عليها في الفقرة الأولى من المادة 781."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_781_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_781> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي حالة انعدام ذلك يمكن تعيينهم من رئيس المحكمة حالة فصله وبعد إجراء بحث بناء على طلب المصفي، أو عن طريق دعوى مستعجلة بطلب كل من يهمه الأمر ، وذلك بعد استدعاء المصفي قانونيا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_781_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_781> ;
    dzdoc:position 2 ;
    dzdoc:text "يحدد في أمر تسمية المراقبين سلطاتهم وواجباتهم وأجورهم وكذلك مدة مهامهم. وتجري عليهم نفس المسؤولية الملقاة على عاتق مندوبي الحسابات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_781_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_781> ;
    dzdoc:position 3 ;
    dzdoc:text "وفي جميع الأحوال ينشر هذا الأمر بنفس الشروط والآجال الخاصة بالمصفين والمنصوص عليها في المادة 767."@ar .

