<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_83_condition_0_342dd74f> a dznorm:Condition ;
    dznorm:conditionText "وفي الحالات المنصوص عليها صراحة عند الإصدار"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_83> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_83_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_83> ;
    dzdoc:position 0 ;
    dzdoc:text "تكون سندات الاستحقاق حسب كل حالة مقترنة بشروط أو بنود التسديد أو الاستهلاك عند حلول الأجل أو عن طريق السحب."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_83_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_83> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي الحالات المنصوص عليها صراحة عند الإصدار ، يمكن أن يكون سند الاستحقاق دخلا دائما يسمح بدخل متغير وقابل للتحويل إلى رأسمال بدون تعويض الأصل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_83_permission_0_77cfb06a> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
