    dzdoc:replacementText "المادة 607 : يشتمل القانون الأساسي، على تقدير الحصص العينية. ويتم هذا التقدير بناء على تقرير ملحق بالقانون الأساسي يعده مندوب الحصص تحت مسؤوليته. ويتبع نفس الإجراء، إذا تم اشتراط امتيازات خاصة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_607> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_607> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_608> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المادة 608 : يوقع المساهمون القانون الأساسي، إما بأنفسهم أو بواسطة وكيل مزود بتفويض خاص ، بعد التصريح الموثق بالدفعات وبعد وضع التقرير المشار إليه في المادة السابقة تحت تصرف المساهمين حسب الشروط والآجال المحددة عن طريق التنظيم ."@ar ;
