<https://legal.dz/resource/order/1975-09-26/75-59#version_art_730> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن شركة المساهمة أن تملك أسهما في شركة أخرى إذا كانت هذه الأخيرة تملك مباشرة جزءا من رأسمالها يزيد عن 10% ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_730_19750926_OpEnact_867ecc1bb3> ;
    dzdoc:replacementText "لا يمكن شركة المساهمة أن تملك أسهما في شركة أخرى إذا كانت هذه الأخيرة تملك مباشرة جزءا من رأسمالها يزيد عن 10% ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_730> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
