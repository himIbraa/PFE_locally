    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يجب أن تخضع هذه الأجور المقيدة في تكاليف الاستغلال لأحكام المادتين 670 و 672 أدناه"@ar ;
    dzdoc:targetEId "art_670" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_669_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_669> ;
    dzdoc:position 0 ;
    dzdoc:text "يسوغ لـ مجلس المراقبة منح أجور استثنائية عن المهام أو الوكالات المعهودة لأعضاء هذا المجلس. وفي هذه الحالة، يجب أن تخضع هذه الأجور المقيدة في تكاليف الاستغلال لأحكام المادتين 670 و 672 أدناه."@ar .

