<https://legal.dz/resource/order/1975-09-26/75-59#version_art_42> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحق للمرسل إبدال اسم المرسل إليه أو استرداد الأشياء المنقولة ما دامت في حيازة الناقل ، بشرط أن يدفع له أجرة النقل عن المسافة المقطوعة وأن يعرض له ما صرفه وما لحقه من الضرر بسبب استردادها . على أنه لا يجوز للمرسل أن يمارس هذا الحق : إذا تم تسليم سند النقل إلى المرسل إليه فينتقل إليه هذا الحق ، إذا كان المرسل تسلم سند النقل وعجز عن تقديمه ، إذا طلب المرسل إليه استلام الأشياء بعد وصولها إلى المكان الموجهة إليه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_42_19750926_OpEnact_7584bea580> ;
    dzdoc:replacementText "يحق للمرسل إبدال اسم المرسل إليه أو استرداد الأشياء المنقولة ما دامت في حيازة الناقل ، بشرط أن يدفع له أجرة النقل عن المسافة المقطوعة وأن يعرض له ما صرفه وما لحقه من الضرر بسبب استردادها . على أنه لا يجوز للمرسل أن يمارس هذا الحق : إذا تم تسليم سند النقل إلى المرسل إليه فينتقل إليه هذا الحق ، إذا كان المرسل تسلم سند النقل وعجز عن تقديمه ، إذا طلب المرسل إليه استلام الأشياء بعد وصولها إلى المكان الموجهة إليه ."@ar ;
