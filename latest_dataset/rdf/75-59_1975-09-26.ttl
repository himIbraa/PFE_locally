<https://legal.dz/resource/order/1975-09-26/75-59#version_art_823> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بغرامة من 20.000 دج إلى 400.000 دج رئيس شركة المساهمة و القائمون بإدارتها و مديروها العامون والذين لم يقوموا عند زيادة رأس المال : 1- بإفادة المساهمين حسب نسبة الأسهم التي يملكونها للتمتع ب حق الأفضلية في الاكتتاب بالأسهم النقدية ، 2- الذين لم يتركوا للمساهمين أجل ثلاثين يوما على الأقل ابتداء من تاريخ افتتاح الاكتتاب ليمارسوا حقهم في الاكتتاب 3- الذين لم يقوموا بتوزيع الأسهم التي أصبحت متوفرة على المساهمين بسبب عدم وجود عدد كاف من الاكتتابات التفاضلية على المساهمين الذين اكتتبوا في الأسهم "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_823_19750926_OpEnact_e705dfd380> ;
    dzdoc:replacementText "يعاقب بغرامة من 20.000 دج إلى 400.000 دج رئيس شركة المساهمة و القائمون بإدارتها و مديروها العامون والذين لم يقوموا عند زيادة رأس المال : 1- بإفادة المساهمين حسب نسبة الأسهم التي يملكونها للتمتع ب حق الأفضلية في الاكتتاب بالأسهم النقدية ، 2- الذين لم يتركوا للمساهمين أجل ثلاثين يوما على الأقل ابتداء من تاريخ افتتاح الاكتتاب ليمارسوا حقهم في الاكتتاب 3- الذين لم يقوموا بتوزيع الأسهم التي أصبحت متوفرة على المساهمين بسبب عدم وجود عدد كاف من الاكتتابات التفاضلية على المساهمين الذين اكتتبوا في الأسهم القابلة للنقص وعددا من الأسهم يفوق العدد الذي يجوز لهم الاكتتاب فيه عن طريق التفضيل بالنسبة لما يملكونه من حقوق. لا تطبق أحكام هذه المادة في حالة إلغاء الجمعية العامة لحق الأفضلية في الاكتتاب ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_823> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
