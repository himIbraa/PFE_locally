    dzdoc:evidenceText "يعاقب بالحبس من شهر إلى ثلاثة أشهر وبغرامة من 20.000 دج إلى 200.000 دج أو بإحدى هاتين العقوبتين فقط، كل شخص تعمد القبول أو الاحتفاظ بمهام مندوب لتقدير الحصص المقدمة وهذا بالرغم من عدم الملاءمات أو الموانع القانونية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_810_19750926_OpEnact_5883c7da29> ;
