    dzdoc:sourceTextSpan "ويجب أن تبلغ هذه الوكالات حسب نفس الشروط المتعلقة بورقة الحضور وفي نفس الوقت."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_681> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_681_obligation_3_bf54e26e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
