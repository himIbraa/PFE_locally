<https://legal.dz/resource/order/1975-09-26/75-59#art_187_bis_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_187_bis_1> ;
    dzdoc:position 0 ;
    dzdoc:text "يبقى تجديد عقود الإيجار المبرمة قبل النشر المذكور في المادة 187 مكرر أعلاه، خاضعا للتشريع الساري المفعول بتاريخ إبرام عقد الإيجار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_187_bis_condition_0_4d76936d> a dznorm:Condition ;
