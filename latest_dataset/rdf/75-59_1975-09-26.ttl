<https://legal.dz/resource/order/1975-09-26/75-59#version_art_57> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز إعفاء الوكيل بالعمولة كليا أو جزئيا من مسؤوليته عن عدم تنفيذ التزاماته أو تنفيذها الناقص أو المتأخر بشرط أن يثبت أن ذلك ناشئ عن قوة قاهرة أو عيب خاص بالشيء أو عن خطأ منسوب إما لموكله أو المرسل إليه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_57_19750926_OpEnact_df79994330> ;
    dzdoc:replacementText "يجوز إعفاء الوكيل بالعمولة كليا أو جزئيا من مسؤوليته عن عدم تنفيذ التزاماته أو تنفيذها الناقص أو المتأخر بشرط أن يثبت أن ذلك ناشئ عن قوة قاهرة أو عيب خاص بالشيء أو عن خطأ منسوب إما لموكله أو المرسل إليه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
