    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_433> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_449_condition_0_64b21313>,
