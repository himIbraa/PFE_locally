<https://legal.dz/resource/order/1975-09-26/75-59#version_art_645> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للجمعية العامة بناء على اقتراح من مجلس المراقبة عزل أعضاء مجلس المديرين . وفي حالة ارتباط المعني بالأمر بعقد عمل ، فإن تجريده من عضويته بمجلس المديرين لا يترتب عنه فسخ عقد العمل. وفي هذه الحالة يعاد إدماجه في منصب عمله الأصلي أو في منصب عمل مماثل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_645_19750926_OpEnact_773732ae99> ;
