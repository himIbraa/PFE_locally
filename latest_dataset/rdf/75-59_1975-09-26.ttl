<https://legal.dz/resource/order/1975-09-26/75-59#art_643_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_643> ;
    dzdoc:position 0 ;
    dzdoc:text "يدير شركة المساهمة مجلس مديرين يتكون من ثلاثة (3) إلى خمسة (5) أعضاء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_643_para_1> a dzdoc:Paragraph ;
