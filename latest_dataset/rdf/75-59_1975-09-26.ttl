<https://legal.dz/resource/order/1975-09-26/75-59#art_356_obligation_0_c439ef44_role_f69814d220> a dznorm:Role ;
    rdfs:label "أي حال يتعين تسديد"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "وعلى أي حال يتعين تسديد نفقات الإجراءات التي اتخذت بمقتضى المادة السابقة على وجه الأسبقية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_356> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_356_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_356> ;
    dzdoc:position 0 ;
    dzdoc:text "للمدين أو لكل ذي مصلحة غيره أن يطلب من المحكمة العدول عن حكمها الذي أصدرته مع تقديم دليل على وجود أموال كافية لمواجهة نفقات العمليات، أو إيداع مبلغ يكفي لمواجهتها بين يدي وكيل التفليسة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_356_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_356> ;
    dzdoc:position 1 ;
    dzdoc:text "وعلى أي حال يتعين تسديد نفقات الإجراءات التي اتخذت بمقتضى المادة السابقة على وجه الأسبقية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_356_right_0_764d962a> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_356> ;
