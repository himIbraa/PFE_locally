<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_81> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "سندات الاستحقاق هي سندات قابلة للتداول، تخول بالنسبة للإصدار الواحد نفس حقوق الدين بالنسبة لنفس القيمة الاسمية."@ar ;
