<https://legal.dz/resource/order/1975-09-26/75-59#art_653_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_653> ;
    dzdoc:position 0 ;
    dzdoc:text "لا تمنح مهمة رئيس مجلس المديرين لصاحبها سلطة إدارة أوسع من تلك التي منح للأعضاء الآخرين في مجلس المديرين، مع مراعاة أحكام المادة السابقة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_654_obligation_0_913ce8a5> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
