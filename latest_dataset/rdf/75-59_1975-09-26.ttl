    dznorm:position 0 ;
    dznorm:provisionText "تكون الشركة ملزمة بما يقوم به المدير من تصرفات تدخل في موضوع الشركة، وذلك في علاقاتها مع الغير"@ar ;
    dznorm:sourceArticle "art_555" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_555_para_0> a dzdoc:Paragraph ;
