<https://legal.dz/resource/order/1975-09-26/75-59#version_art_732_bis_3> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تلزم الشركات القابضة التي تلجأ علنيا للادخار و/أو المسعرة في البورصة، بإعداد الحسابات المدعمة ونشرها كما هو محدد في المادة 732 مكرر 4 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
