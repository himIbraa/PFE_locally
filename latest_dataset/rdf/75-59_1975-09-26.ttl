<https://legal.dz/resource/order/1975-09-26/75-59#version_art_465> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحتوي السند لأمر على: 1 - شرط الأمر أو تسمية السند مكتوبة في نفس النص وباللغة المستعملة لتحريره، 2 - الوعد بلا قيد ولا شرط بأداء مبلغ معين، 3 - تعيين تاريخ الاستحقاق، 4 - تعيين المكان الذي يجب فيه الأداء، 5 - اسم الشخص الذي يجب أن يتم الأداء له أو لأمره، 6 - تعيين المكان والتاريخ اللذين حرر فيهما السند، 7 - توقيع من حرر السند أي (الملزم)."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_465_19750926_OpEnact_1daa0e6246> ;
    dzdoc:replacementText "يحتوي السند لأمر على: 1 - شرط الأمر أو تسمية السند مكتوبة في نفس النص وباللغة المستعملة لتحريره، 2 - الوعد بلا قيد ولا شرط بأداء مبلغ معين، 3 - تعيين تاريخ الاستحقاق، 4 - تعيين المكان الذي يجب فيه الأداء، 5 - اسم الشخص الذي يجب أن يتم الأداء له أو لأمره، 6 - تعيين المكان والتاريخ اللذين حرر فيهما السند، 7 - توقيع من حرر السند أي (الملزم)."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_465> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
