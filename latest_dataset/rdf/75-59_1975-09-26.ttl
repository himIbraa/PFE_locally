    dzdoc:evidenceText "يقدم مجلس المديرين مرة كل ثلاثة أشهر على الأقل وعند نهاية كل سنة مالية، تقريرا لـ مجلس المراقبة حول تسييره . يقدم مجلس المديرين بعد قفل كل سنة مالية، لـ مجلس المراقبة ، وثائق الشركة المذكورة في المادة 716 ، \"المقطعين 2 و 3 منها\"، قصد المراجعة والرقابة . يقدم مجلس المراقبة للجمعية العامة ملاحظاته على تقرير مجلس المديرين وعلى حسابات السنة المالية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_656_19750926_OpEnact_5c7a828ea1> ;
    dzdoc:replacementText "يقدم مجلس المديرين مرة كل ثلاثة أشهر على الأقل وعند نهاية كل سنة مالية، تقريرا لـ مجلس المراقبة حول تسييره . يقدم مجلس المديرين بعد قفل كل سنة مالية، لـ مجلس المراقبة ، وثائق الشركة المذكورة في المادة 716 ، \"المقطعين 2 و 3 منها\"، قصد المراجعة والرقابة . يقدم مجلس المراقبة للجمعية العامة ملاحظاته على تقرير مجلس المديرين وعلى حسابات السنة المالية ."@ar ;
