    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من شهر إلى ثلاثة أشهر وبغرامة من 20.000 دج إلى 200.000 دج أو بإحدى هاتين العقوبتين فقط، كل شخص تعمد القبول أو الاحتفاظ بمهام مندوب لتقدير الحصص المقدمة وهذا بالرغم من عدم الملاءمات أو الموانع القانونية"@ar ;
    dznorm:sourceArticle "art_810" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_810_para_0> a dzdoc:Paragraph ;
