<https://legal.dz/resource/order/1975-09-26/75-59#art_359_condition_0_6af02c57> a dznorm:Condition ;
    dznorm:conditionText "متى ثبتت استقامته"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_359> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_359_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_359> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز أن يحصل على رد اعتباره متى ثبتت استقامته: المدين الذي حصل على صلح وسدد الحصص الموعود بها كاملة، ويطبق هذا الحكم على الشريك المتضامن الذي حصل من الدائنين على صلح منفرد، من أثبت إبراء الدائنين له من كامل الديون وموافقتهم الاجماعية على رد اعتباره."@ar .

