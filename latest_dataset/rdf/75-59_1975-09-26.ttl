    dzdoc:usesTerm dzterm:investment_certificate .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_73> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_4> ;
    dzdoc:eId "art_715_bis_73" ;
    dzdoc:fullText "يجوز ل شركات المساهمة أن تصدر سندات مساهمة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_73_permission_0_779dfd12> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_73> ;
