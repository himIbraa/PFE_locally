<https://legal.dz/resource/order/1975-09-26/75-59#version_art_446> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يضبط الرجوع على النسبة التالية : ربع في المائة بمراكز الولاية، نصف في المائة ب بمراكز الدائرة، وثلاثة أرباع في المائة بالمحلات الأخرى. لا يمكن في أي حال من الأحوال أن يقع الرجوع بنفس الولاية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_446_19750926_OpEnact_0309980c63> ;
    dzdoc:replacementText "يضبط الرجوع على النسبة التالية : ربع في المائة بمراكز الولاية، نصف في المائة ب بمراكز الدائرة، وثلاثة أرباع في المائة بالمحلات الأخرى. لا يمكن في أي حال من الأحوال أن يقع الرجوع بنفس الولاية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_446> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_446> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_447> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز تراكم نسخ الرجوع . وكل مظهر أو ساحب لا يمكن أن يتحمل إلا واحدا منها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
