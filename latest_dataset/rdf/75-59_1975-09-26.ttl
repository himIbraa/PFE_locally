    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_88> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_88_condition_1_a1f04320> a dznorm:Condition ;
    dznorm:conditionText "إذا كان لم يسبق له الإشارة إليها في دفتر الشروط"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_88> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_88_obligation_0_56f911c2> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_88> ;
    dznorm:position 0 ;
    dznorm:provisionText "وجب عليه أن يسلم تحت مسؤوليته المعارضات الموجودة لديه، إلى الراسي عليه المزاد بعد أخذ إيصال منه في ظرف ثمانية أيام من تاريخ إرساء المزاد"@ar ;
    dznorm:sourceArticle "art_88" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_88_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_88> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا انتزع من المشتري المزاد عليه المبيع على إثر المزاد بالزيادة، وجب عليه أن يسلم تحت مسؤوليته المعارضات الموجودة لديه، إلى الراسي عليه المزاد بعد أخذ إيصال منه في ظرف ثمانية أيام من تاريخ إرساء المزاد إذا كان لم يسبق له الإشارة إليها في دفتر الشروط، وينتقل أثر هذه المعارضات لثمن المزايدة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_89_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_89> ;
    dzdoc:position 0 ;
    dzdoc:text "لا تجوز المزايدة بالسدس بعد البيع القضائي للمحل التجاري أو البيع الذي يتم بالمزاد العلني بطلب وكيل الإفلاس أو التسوية القضائية أو من الشركاء على الشيوع في محل تجاري."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_8_obligation_0_683c6b7e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_8> ;
    dznorm:position 0 ;
    dznorm:provisionText "تلتزم المرأة التاجرة شخصيا بالأعمال التي تقوم بها لحاجات تجارتها"@ar ;
    dznorm:sourceArticle "art_8" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_8_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_8> ;
    dzdoc:position 0 ;
    dzdoc:text "تلتزم المرأة التاجرة شخصيا بالأعمال التي تقوم بها لحاجات تجارتها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_8_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_8> ;
    dzdoc:position 1 ;
    dzdoc:text "و يكون للعقود بعوض التي تتصرف بمقتضاها في أموالها الشخصية لحجات تجارتها، كامل الأثر بالنسبة للغير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_90_obligation_0_05b60c54> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
