<https://legal.dz/resource/order/1975-09-26/75-59#version_art_529> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب تقديم الاحتجاج على يد كاتب الضبط لموطن الذي كان يجب عليه وفاء قيمة الشيك أو في موطنه الأخير المعروف . وفي حالة الدلالة على موطن كاذب يكون الاحتجاج مسبوقا بإجراء التفتيش."@ar ;
