<https://legal.dz/resource/order/1975-09-26/75-59#version_art_449> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن القبول بطريق التدخل يمكن حصوله في جميع الأحوال التي تكون فيها لحامل سفتجة واجبة التقديم للقبول حق الرجوع قبل الاستحقاق. وإذا تضمنت السفتجة تعيين من يقبلها أو يدفع قيمتها عند الاقتضاء في مكان الأداء ، فلا يمكن للحامل ممارسة حقوقه في الرجوع قبل الاستحقاق على من صدر منه هذا التعيين أو على الموقعين اللاحقين له إلا إذا قدم السفتجة للشخص المعين فرفض قبولها وأثبت هذا الرفض باحتجاج . وفي غير ذلك من أحوال التدخل يمكن للحامل رفض القبول عن طريق التدخل . بيد أنه إذا رضي بالتدخل ، فإنه يفقد حقه في الرجوع "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_449_19750926_OpEnact_796409c17d> ;
    dzdoc:replacementText "إن القبول بطريق التدخل يمكن حصوله في جميع الأحوال التي تكون فيها لحامل سفتجة واجبة التقديم للقبول حق الرجوع قبل الاستحقاق. وإذا تضمنت السفتجة تعيين من يقبلها أو يدفع قيمتها عند الاقتضاء في مكان الأداء ، فلا يمكن للحامل ممارسة حقوقه في الرجوع قبل الاستحقاق على من صدر منه هذا التعيين أو على الموقعين اللاحقين له إلا إذا قدم السفتجة للشخص المعين فرفض قبولها وأثبت هذا الرفض باحتجاج . وفي غير ذلك من أحوال التدخل يمكن للحامل رفض القبول عن طريق التدخل . بيد أنه إذا رضي بالتدخل ، فإنه يفقد حقه في الرجوع قبل الاستحقاق على الشخص الذي حصل القبول لمصلحته وعلى الموقعين اللاحقين. ويذكر القبول بطريق التدخل في السفتجة . ويوقع من طرف المتدخل . كما يجب أن يتضمن تعيين الشخص الذي صدر لحسابه ، وإذا أقفل هذا البيان عد القبول صادرا لمصلحة الساحب . من قبل بطريق التدخل يكون ملزما قبل الحامل والمظهرين اللاحقين لمن صدر التدخل لمصلحته، بما الزم به هذا الأخير . وبالرغم من القبول بطريق التدخل يحق لمن صدر لمصلحته ولضامنيه أن يطلبوا من الحامل مقابل تسديد المبلغ المبين في المادة 433 تسلم السفتجة والاحتجاج مع إيصال بالإبراء عند الاقتضاء ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_449> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_449> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_45> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
