<https://legal.dz/resource/order/1975-09-26/75-59#version_art_416> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجبر حامل السفتجة على استلام قيمتها قبل الاستحقاق. وإذا دفع المسحوب عليه قبل الاستحقاق فإنه يتحمل تبعة ذلك. ومن يدفع عند الاستحقاق برئت ذمته على الوجه الصحيح إلا إذا كان قد ارتكب تدليسا أو خطأ جسيما ، و يجب عليه أن يتحقق من صحة تسلسل التظهيرات، دون التثبت من صحة إمضاءات المظهرين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_416_19750926_OpEnact_4e61f6b8ab> ;
    dzdoc:replacementText "لا يجبر حامل السفتجة على استلام قيمتها قبل الاستحقاق. وإذا دفع المسحوب عليه قبل الاستحقاق فإنه يتحمل تبعة ذلك. ومن يدفع عند الاستحقاق برئت ذمته على الوجه الصحيح إلا إذا كان قد ارتكب تدليسا أو خطأ جسيما ، و يجب عليه أن يتحقق من صحة تسلسل التظهيرات، دون التثبت من صحة إمضاءات المظهرين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
