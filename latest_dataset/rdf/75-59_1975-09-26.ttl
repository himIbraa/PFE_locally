<https://legal.dz/resource/order/1975-09-26/75-59#version_art_527> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتقادم دعاوى الرجوع بالنسبة لحامل ضد المظهرين أو الساحب أو الملزمين الآخرين، بمضي ستة أشهر من تاريخ انقضاء مهلة التقديم . أما دعاوى الرجوع المتعلقة بمختلف الملزمين بوفاء الشيك على بعضهم بعضا، فإنها تتقادم بمضي ستة أشهر من تاريخ اليوم الذي سدد فيه الملزم قيمة الشيك أو من اليوم الذي رفعت فيه الدعوى عليه . وتتقادم دعوى حامل الشيك على المسحوب عليه بمضي ثلاثة أعوام من تاريخ انقضاء مهلة تقديمه . على أنه في حالة سقوط الحق أو التقادم ، فإنه يبقى الحق في رفع الدعوى على الساحب الذي لم يوفر قابل الوفاء أو "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_527_19750926_OpEnact_50a0930b57> ;
    dzdoc:replacementText "تتقادم دعاوى الرجوع بالنسبة لحامل ضد المظهرين أو الساحب أو الملزمين الآخرين، بمضي ستة أشهر من تاريخ انقضاء مهلة التقديم . أما دعاوى الرجوع المتعلقة بمختلف الملزمين بوفاء الشيك على بعضهم بعضا، فإنها تتقادم بمضي ستة أشهر من تاريخ اليوم الذي سدد فيه الملزم قيمة الشيك أو من اليوم الذي رفعت فيه الدعوى عليه . وتتقادم دعوى حامل الشيك على المسحوب عليه بمضي ثلاثة أعوام من تاريخ انقضاء مهلة تقديمه . على أنه في حالة سقوط الحق أو التقادم ، فإنه يبقى الحق في رفع الدعوى على الساحب الذي لم يوفر قابل الوفاء أو على غيره من الملزمين الذين حصلوا على إثراء غير عادل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_527> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_527> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_528> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تسري مواعيد التقادم في حالة رفع الدعوى إلا من تاريخ آخر إجراء قضائي . ولا يطبق التقادم إذا صدر الحكم بالأداء أو حصل الاعتراف بالدين بموجب ورقة مستقلة . لا أثر لانقطاع التقادم إلا بالنسبة لمن أتخذ ضده الإجراء القاطع. على أنه يجب على المدعى عليهم عند الطلب أن يؤيدوا باليمين أنه لم يبق بذمتهم شيء منه كما يلزم ورثتهم أو خلفاؤهم أن يؤدوا يمينا على أنهم يعتقدون عن حسن نية أنه لم يبق شيء من الدين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_528_19750926_OpEnact_189ec48b10> ;
    dzdoc:replacementText "لا تسري مواعيد التقادم في حالة رفع الدعوى إلا من تاريخ آخر إجراء قضائي . ولا يطبق التقادم إذا صدر الحكم بالأداء أو حصل الاعتراف بالدين بموجب ورقة مستقلة . لا أثر لانقطاع التقادم إلا بالنسبة لمن أتخذ ضده الإجراء القاطع. على أنه يجب على المدعى عليهم عند الطلب أن يؤيدوا باليمين أنه لم يبق بذمتهم شيء منه كما يلزم ورثتهم أو خلفاؤهم أن يؤدوا يمينا على أنهم يعتقدون عن حسن نية أنه لم يبق شيء من الدين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
