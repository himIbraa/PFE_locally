<https://legal.dz/resource/order/1975-09-26/75-59#art_429_obligation_0_69d3639d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_429_obligation_0_69d3639d_action_0c1be38466> ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_429_obligation_0_69d3639d_role_42f82bfdf0> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_429> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب على المسحوب عليه الذي يقبل التبليغ إذا لم يؤد مبلغ السفتجة ومصاريف الإخبار وعند الاقتضاء احتجاج الشيك، أن يرد السفتجة إلى كتابة الضبط"@ar ;
    dznorm:sourceArticle "art_429" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_429_obligation_0_69d3639d_action_0c1be38466> a dznorm:Action ;
    rdfs:label "عليه الذي يقبل التبليغ إذا"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب على المسحوب عليه الذي يقبل التبليغ إذا لم يؤد مبلغ السفتجة ومصاريف الإخبار وعند الاقتضاء احتجاج الشيك، أن يرد السفتجة إلى كتابة الضبط"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_429> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_429_obligation_0_69d3639d_role_42f82bfdf0> a dznorm:Role ;
    rdfs:label "المسحوب عليه الذي يقبل"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يجب على المسحوب عليه الذي يقبل التبليغ إذا لم يؤد مبلغ السفتجة ومصاريف الإخبار وعند الاقتضاء احتجاج الشيك، أن يرد السفتجة إلى كتابة الضبط"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_429> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_429_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_429> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب على المسحوب عليه الذي يقبل التبليغ إذا لم يؤد مبلغ السفتجة ومصاريف الإخبار وعند الاقتضاء احتجاج الشيك، أن يرد السفتجة إلى كتابة الضبط وهناك يحرر في الحين احتجاج لعدم الوفاء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_429_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_429> ;
    dzdoc:position 1 ;
    dzdoc:text "إذا لم يرد المسحوب عليه السفتجة يحرر الاحتجاج في الحين ويوقع الإشهاد بعدم الرد، وفي هذه الحالة يعفى الحامل من الغير من تطبيق أحكام المادتين 421 و422."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_429_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_429> ;
    dzdoc:position 2 ;
    dzdoc:text "يعتبر عدم رد السفتجة كجنحة تستوجب العقوبات المنصوص عليها في المادة 376 من قانون العقوبات."@ar .

