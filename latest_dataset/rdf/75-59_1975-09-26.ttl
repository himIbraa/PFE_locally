    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_784_condition_1_b43e2b8d> a dznorm:Condition ;
    dznorm:conditionText "إذا عين عدة مصفين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_784> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_784_obligation_0_d34113f6> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_784> ;
    dznorm:position 0 ;
    dznorm:provisionText "المصفين يتعين عليهم أن يضعوا ويقدموا تقريرا مشتركا"@ar ;
    dznorm:sourceArticle "art_784" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_784_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_784> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا وقع انحلال الشركة بأمر قضائي فإن هذا القرار يعين مصفيا واحدا أو أكثر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_784_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_784> ;
    dzdoc:position 1 ;
    dzdoc:text "إذا عين عدة مصفين فإنه يجوز لهم ممارسة مهامهم على انفراد، وذلك باستثناء كل نص مخالف لأمر التسمية. إلا أن المصفين يتعين عليهم أن يضعوا ويقدموا تقريرا مشتركا."@ar .

