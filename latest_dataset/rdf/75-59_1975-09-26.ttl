<https://legal.dz/resource/order/1975-09-26/75-59#version_art_88> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا انتزع من المشتري المزاد عليه المبيع على إثر المزاد بالزيادة ، وجب عليه أن يسلم تحت مسؤوليته المعارضات الموجودة لديه، إلى الراسي عليه المزاد بعد أخذ إيصال منه في ظرف ثمانية أيام من تاريخ إرساء المزاد إذا كان لم يسبق له الإشارة إليها في دفتر الشروط ، وينتقل أثر هذه المعارضات لثمن المزايدة."@ar ;
