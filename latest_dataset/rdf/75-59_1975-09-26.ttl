<https://legal.dz/resource/order/1975-09-26/75-59#version_art_626> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تصح مداولة مجلس الإدارة إلا إذا حضر نصف عدد أعضائه على الأقل . ويعتبر كل شرط مخالف كأن لم يكن. وتؤخذ القرارات بأغلبية أصوات الأعضاء الحاضرين ما لم ينص القانون الأساسي على أغلبية أكثر. ويرجح صوت رئيس الجلسة عند تعادل الأصوات ما لم ينص على خلاف ذلك في القانون الأساسي."@ar ;
    dzdoc:isAuthoritative true ;
