<https://legal.dz/resource/order/1975-09-26/75-59#art_170_obligation_0_651f8ee1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_170> ;
    dznorm:position 0 ;
    dznorm:provisionText "تطبق هذه الأحكام كذلك على :"@ar ;
    dznorm:sourceArticle "art_170" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_170_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_170> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق هذه الأحكام كذلك على : 1 - الإيجارات الممنوحة للبلديات بالنسبة للعمارات أو المحلات المخصصة لمصالح تسيير الاستغلال البلدي، إما عند الإيجار أو بعده، وبالموافقة الصريحة أو الضمنية من المالك، 2 - إيجار العمارات أو المحلات الرئيسية أو الملحقة والضرورية لمواصلة نشاط المؤسسات العمومية الاقتصادية في حدود القوانين والأنظمة التي تسودها، شريطة ألا يكون لهذا الإيجار أي تأثير على الملك العمومي، 3 - كما تطبق هذه الأحكام أيضا مع مراعاة أحكام المادتين 185 و 186 التاليتين على إيجار المحلات أو العمارات المملوكة للدولة أو الولايات أو البلديات أو المؤسسات العمومية في حالة ما إذا كانت هذه المحلات أو العمارات تستجب لأحكام المادة 169 أعلاه وللفقرتين الأولى والثانية من هذه المادة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_170_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_170> ;
    dzdoc:position 1 ;
    dzdoc:text "غیر أن هذه الأحكام لا تطبق على رخص العمل المؤقتة الممنوحة من قبل الإدارة لعمارة سبق اكتسابها من طرفها على إثر تصريح للمنفعة العمومية."@ar .

