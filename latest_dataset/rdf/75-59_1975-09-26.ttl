    dzdoc:referencesTarget <https://legal.dz/resource/order/1975-09-26/75-59#art_99> ;
    dzdoc:sourceEId "art_142" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يعطى لكل الأوراق المشار إليها في المادتين 98 و 99 أعلاه وكذلك كل الأوراق الأخرى المقدمة إلى المركز الوطني للسجل التجاري بالنظر في الأحكام التجارية، رقم إيداع عند تقديمها"@ar ;
    dzdoc:targetEId "art_99" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_142_obligation_0_b13ad0cd_ref_4b8d7e7a150d> a dzdoc:Reference ;
    rdfs:label "98"@ar ;
    dzdoc:frbrUri "#art_98"^^xsd:anyURI ;
