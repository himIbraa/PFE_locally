<https://legal.dz/resource/order/1975-09-26/75-59#version_art_785> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز أن تتجاوز مدة وكالة المصفي ثلاثة أعوام ، غير أنه يمكن تجديد هذه الوكالة من طرف الشركاء أو رئيس المحكمة بحسب ما إذا كان المصفي قد عين من طرف الشركاء أو بقرار قضائي. إذا لم يكن بالإمكان انعقاد جمعية الشركاء بصفة قانونية ، جددت الوكالة بقرار قضائي بناء على طلب المصفي . يجب على المصفي عند طلب تجديد وكالته أن يبين الأسباب التي حالت دون إقفال التصفية والتدابير التي ينوي اتخاذها والآجال التي يقتضيها إتمام التصفية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_785_19750926_OpEnact_e3f1b7eb58> ;
    dzdoc:replacementText "لا يجوز أن تتجاوز مدة وكالة المصفي ثلاثة أعوام ، غير أنه يمكن تجديد هذه الوكالة من طرف الشركاء أو رئيس المحكمة بحسب ما إذا كان المصفي قد عين من طرف الشركاء أو بقرار قضائي. إذا لم يكن بالإمكان انعقاد جمعية الشركاء بصفة قانونية ، جددت الوكالة بقرار قضائي بناء على طلب المصفي . يجب على المصفي عند طلب تجديد وكالته أن يبين الأسباب التي حالت دون إقفال التصفية والتدابير التي ينوي اتخاذها والآجال التي يقتضيها إتمام التصفية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_785> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
