<https://legal.dz/resource/order/1975-09-26/75-59#art_325_obligation_0_94e443d3> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_325> ;
    dznorm:position 0 ;
    dznorm:provisionText "يخضع الصلح للتصديق عليه من المحكمة"@ar ;
    dznorm:sourceArticle "art_325" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_325_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_325> ;
    dzdoc:position 0 ;
    dzdoc:text "يخضع الصلح للتصديق عليه من المحكمة. وتكون متابعة التصديق بناء على طلب الطرف الذي يهمه التعجيل ولا يمكن للمحكمة الفصل فيه إلا بعد فوات ميعاد الثمانية أيام المحدد في المادة 323 فإذا حصلت معارضات خلال هذه المهلة، تبت فيها المحكمة وفي موضوع التصديق بحكم واحد."@ar .

