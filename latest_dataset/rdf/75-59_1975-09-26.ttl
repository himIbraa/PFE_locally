<https://legal.dz/resource/order/1975-09-26/75-59#art_820_obligation_0_7fe6e413> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_820> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بغرامة من 20.000 دج إلى 50.000 دج رئيس شركة المساهمة أو القائمون بإدارتها"@ar ;
    dznorm:sourceArticle "art_820" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_820_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_820> ;
    dzdoc:position 0 ;
    dzdoc:text """يعاقب بغرامة من 20.000 دج إلى 50.000 دج رئيس شركة المساهمة أو القائمون بإدارتها: 1- الذين لم يقدموا عمدا أثناء كل اجتماع للجمعية العادية للمساهمين ورقة الحضور موقعة من المساهمين الحاضرين والوكلاء مصادق عليها من مكتب الجمعية والمتضمنة:
                أ) أسماء وألقاب وموطن كل مساهم حاضر وعدد الأسهم التي يملكها وكذلك عدد الأصوات الملحقة بهذه الأسهم،
                ب) أسماء وألقاب وموطن كل وكيل وعدد أسهم موكليه وكذا عدد الأصوات الملحقة بهذه الأسهم،
                ج) أسماء وألقاب وموطن كل مساهم ممثل وعدد الأسهم التي يملكها وكذا عدد الأصوات الملحقة بهذه الأسهم أو عدد التفويضات المسندة لكل وكيل عند عدم وجود هذه الإشارات، 2- الذين لم يلحقوا بورقة الحضور التفويضات المسندة لكل وكيل، 3- الذين لم يقوموا بإثبات قرارات كل جمعية مساهمين بمحضر يوقع من طرف أعضاء المكتب ويحفظ بمركز الشركة في ملف خاص ويثبت فيه تاريخ ومكان انعقاد الجمعية وكيفية الاستدعاء وجدول الأعمال وتشكيل المكتب وعدد المساهمين المشاركين في التصويت ومقدار النصاب القانوني والمستندات والتقارير المقدمة للجمعية مع ملخص المناقشات ونص القرارات المطروحة للتصويت ونتيجة التصويت."""@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_821_obligation_0_3fd6df83> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_821_obligation_0_3fd6df83_ref_7c0d5ad7b454> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_820> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_820> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_821> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالغرامة المنصوص عليها في المادة السابقة رئيس الجلسة وأعضاء مكتب الجمعية الذين لم يحترموا أثناء اجتماع جمعية المساهمين الأحكام المتعلقة بحقوق التصويت والملحقة بالأسهم"@ar ;
    dznorm:sourceArticle "art_821" .

