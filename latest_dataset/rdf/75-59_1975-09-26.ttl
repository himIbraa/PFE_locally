    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_149> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يجوز أن يتدخل بطريق مباشر أو غير مباشر ولو بالتبعية كسماسرة أو وسطاء أو مستشارين مهنيين في التنازلات والرهون المتعلقة بالمحلات التجارية كما لا يجوز لهم أن يكونوا تحت أي اسم كان مودعين لأثمان بيع المحلات التجارية"@ar ;
    dznorm:sourceArticle "art_149" .

