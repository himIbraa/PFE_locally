<https://legal.dz/resource/order/1975-09-26/75-59#version_art_345> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يبطل ما أجراه المدين من أعمال بعد حكم التصديق وقبل إبطال أو فسخ الصلح إلا ما جرى منه تدليسا بحقوق الدائنين وطبقا لأحكام المادة 103 من القانون المدني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_345_19750926_OpEnact_d68ce581a2> ;
    dzdoc:replacementText "لا يبطل ما أجراه المدين من أعمال بعد حكم التصديق وقبل إبطال أو فسخ الصلح إلا ما جرى منه تدليسا بحقوق الدائنين وطبقا لأحكام المادة 103 من القانون المدني ."@ar ;
