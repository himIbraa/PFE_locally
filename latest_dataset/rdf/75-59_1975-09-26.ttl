<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_123> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة إصدار أسهم يجب اكتتابها بمقابل نقدي أو إصدار سندات استحقاق جديدة قابلة للتحويل وذلك إذا قررت الجمعية العامة للمساهمين إلغاء الحق التفضيلي في الاكتتاب ينبغي أن تصادق الجمعية العامة لأصحاب سندات الاستحقاق المعنيين، على هذا القرار ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_123_19750926_OpEnact_5f8ff3561b> ;
