    dzdoc:evidenceText "يمنع على المسحوب عليه الساحب من إصدار الشيكات ، في حالة عدم جدوى إجراء التسوية المنصوص عليه في المادة 526 مكرر 2 أعلاه، أو في حالة تكرار المخالفة خلال الإثني عشر (12) شهرا الموالية لعارض الدفع الأول، حتى ولو تمت تسويته ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
