<https://legal.dz/resource/order/1975-09-26/75-59#art_198_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_198> ;
    dzdoc:position 0 ;
    dzdoc:text "ترفع جميع الدعاوى الممارسة وفقا ل ورد في هذا الباب ماعدا الدعاوى المشار إليها في المواد من 194 إلى 197 أعلاه، أمام محكمة موقع العمارة ويشملها التقادم بعد مرور سنتين. يحقق في القضية ويفصل فيها في مدة وجيزة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_199_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_199> ;
    dzdoc:position 0 ;
    dzdoc:text "تلغى وتصبح عديمة المفعول مهما كان شكلها البنود والشروط والتسويات التي يكون من شأنها إسقاط الحق في تجديد الإيجار الذي أنشئ بموجب هذا الباب، ولاسيما أحكام المواد من 191 إلى 193."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_199_right_0_acea0486> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_199> ;
    dznorm:position 0 ;
    dznorm:provisionText "الحق في تجديد الإيجار"@ar ;
    dznorm:sourceArticle "art_199" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_19_obligation_0_b2fdd0f1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_19> ;
    dznorm:position 0 ;
    dznorm:provisionText "يلزم بالتسجيل في السجل التجاري"@ar ;
    dznorm:sourceArticle "art_19" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_19_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_19> ;
    dzdoc:position 0 ;
    dzdoc:text "يلزم بالتسجيل في السجل التجاري. 1 – كل شخص طبيعي له صفة التاجر في نظر القانون الجزائري ويمارس أعماله التجارية داخل القطر الجزائري. 2 – كل شخص معنوي تاجر بالشكل، أو يكون موضوعه تجاريا، ومقره في الجزائر، أو كان له مكتب أو فرع أو أي مؤسسة كانت."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_1_condition_0_e6b77528> a dznorm:Condition ;
    dznorm:conditionText "ما لم يقض القانون بخلاف ذلك"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_1> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_200_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_200> ;
    dzdoc:position 0 ;
    dzdoc:text "تلغى التعاقدات أيضا مهما كان شكلها إذا كانت ترمي إلى منع المستأجر من التنازل عن إيجاره لمشتري محله التجاري أو مؤسسته، وكذلك الاتفاقيات التي تجعل مشتري المتجر خاضعا لقبول المالك"@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_200_right_0_469bb8eb> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
