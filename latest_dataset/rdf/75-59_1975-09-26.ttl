    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_720_19750926_OpEnact_090ef1d889> ;
    dzdoc:replacementText "تشكل الأرباح الصافية من الناتج الصافي من السنة المالية بعد طرح المصاريف العامة وتكاليف الشركة الأخرى بإدراج جميع الاستهلاكات والمؤونات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_720> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_720> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_721> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في الشركات ذات المسؤولية المحدودة والشركات المساهمة يقتطع من الأرباح سندات نصف العشر على الأقل وتطرح منها عند الاقتضاء الخسائر السابقة، ويخصص هذا الاقتطاع لتكوين مال احتياطي يدعى { احتياطي قانوني } وذلك تحت طائلة بطلان كل مداولة مخالفة. ويصبح اقتطاع هذا الجزء غير إلزامي إذا بلغ الاحتياطي عشر رأس المال."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_721_19750926_OpEnact_6e9bd3a999> ;
    dzdoc:replacementText "في الشركات ذات المسؤولية المحدودة والشركات المساهمة يقتطع من الأرباح سندات نصف العشر على الأقل وتطرح منها عند الاقتضاء الخسائر السابقة، ويخصص هذا الاقتطاع لتكوين مال احتياطي يدعى { احتياطي قانوني } وذلك تحت طائلة بطلان كل مداولة مخالفة. ويصبح اقتطاع هذا الجزء غير إلزامي إذا بلغ الاحتياطي عشر رأس المال."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_721> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
