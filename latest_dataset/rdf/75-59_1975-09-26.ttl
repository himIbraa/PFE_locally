<https://legal.dz/resource/order/1975-09-26/75-59#version_art_399> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتبر من بيده السفتجة أنه حاملها الشرعي إذا أثبت حقه بسلسلة غير منقطعة من التظهيرات ولو كان آخرها تظهيرا على بياض والتظهيرات المشطبة تعد على هذا الوضع كأن لم تكن. وإذا كان التظهير على بياض متبوعا بتظهير آخر اعتبر موقع هذا التظهير الأخير أنه اكتسب السفتجة بمقتضى التظهير على بياض . وإذا زالت يد شخص عن السفتجة بحادث من الحوادث فحاملها الذي يثبت حقه على النحو المبين بالفقرة السابقة لا يلزم بالتخلي عنها إلا إذا كان قد اكتسبها عن سوء نية أو كان ارتكب خطأ جسيما عند اكتسابها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_399_19750926_OpEnact_6ab39e9136> ;
    dzdoc:replacementText "يعتبر من بيده السفتجة أنه حاملها الشرعي إذا أثبت حقه بسلسلة غير منقطعة من التظهيرات ولو كان آخرها تظهيرا على بياض والتظهيرات المشطبة تعد على هذا الوضع كأن لم تكن. وإذا كان التظهير على بياض متبوعا بتظهير آخر اعتبر موقع هذا التظهير الأخير أنه اكتسب السفتجة بمقتضى التظهير على بياض . وإذا زالت يد شخص عن السفتجة بحادث من الحوادث فحاملها الذي يثبت حقه على النحو المبين بالفقرة السابقة لا يلزم بالتخلي عنها إلا إذا كان قد اكتسبها عن سوء نية أو كان ارتكب خطأ جسيما عند اكتسابها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
