<https://legal.dz/resource/order/1975-09-26/75-59#art_690> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_690" ;
    dzdoc:fullText "تصدر الأسهم الجديدة إما بقيمتها الاسمية وإما بتلك القيمة مع زيادة علاوة الإصدار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_690> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_690_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
