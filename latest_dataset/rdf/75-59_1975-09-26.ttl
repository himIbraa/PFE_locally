<https://legal.dz/resource/order/1975-09-26/75-59#version_art_156> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحول فائدة الرهن الحيازي بقوة القانون وطبقا ل المادة 243 من القانون المدني إلى الحاملين بالتعاقب للسندات المضمونة سواء كانت قد وقعت أو قبلت لأمر البائع أو المقرض الذي قدم كلا أو بعضا من الثمن أو كانت هذه السندات تمثل على العموم تداول الدين المرهون بوجه صحيح، وفقا لأحكام هذا القانون. أما إذا قامت عدة سندات لتمثيل الدين فإن الامتياز المتعلق بهذا الأخير تعود ممارسته إلى المتتبع الأول للحساب المشترك وبالنسبة لتمامه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_156_19750926_OpEnact_eb855e9cc9> ;
    dzdoc:replacementText "تحول فائدة الرهن الحيازي بقوة القانون وطبقا ل المادة 243 من القانون المدني إلى الحاملين بالتعاقب للسندات المضمونة سواء كانت قد وقعت أو قبلت لأمر البائع أو المقرض الذي قدم كلا أو بعضا من الثمن أو كانت هذه السندات تمثل على العموم تداول الدين المرهون بوجه صحيح، وفقا لأحكام هذا القانون. أما إذا قامت عدة سندات لتمثيل الدين فإن الامتياز المتعلق بهذا الأخير تعود ممارسته إلى المتتبع الأول للحساب المشترك وبالنسبة لتمامه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_156> ;
