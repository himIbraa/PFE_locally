<https://legal.dz/resource/order/1975-09-26/75-59#version_art_393> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن السفتجة التي توقع من القصر الذين ليسوا تجارا تكون باطلة بالنسبة لهم بدون أن ينال ذلك من الحقوق التي يختص بها كل من الطرفين بمقتضى المادة 191 من القانون المدني . إذا كانت السفتجة محتوية على تواقيع أشخاص ليست لهم أهلية الالتزام بموجبها أو على توقيعات مزورة أو منسوبة لأشخاص وهميين أو على تواقيع ليس من شأنها لأي سبب آخر إلزام الأشخاص الذين وضعوا توقيعهم على السفتجة أو وقع عليها باسمهم فإن ذلك يحول دون صحة التزامات الموقعين الآخرين على السفتجة. كل من وضع توقيعه على سفتجة نيابة عن شخص لم يكن له توك"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_393_19750926_OpEnact_c1b9b7b8f4> ;
    dzdoc:replacementText "إن السفتجة التي توقع من القصر الذين ليسوا تجارا تكون باطلة بالنسبة لهم بدون أن ينال ذلك من الحقوق التي يختص بها كل من الطرفين بمقتضى المادة 191 من القانون المدني . إذا كانت السفتجة محتوية على تواقيع أشخاص ليست لهم أهلية الالتزام بموجبها أو على توقيعات مزورة أو منسوبة لأشخاص وهميين أو على تواقيع ليس من شأنها لأي سبب آخر إلزام الأشخاص الذين وضعوا توقيعهم على السفتجة أو وقع عليها باسمهم فإن ذلك يحول دون صحة التزامات الموقعين الآخرين على السفتجة. كل من وضع توقيعه على سفتجة نيابة عن شخص لم يكن له توكيل منه بذلك يكون ملتزما شخصيا بمقتضى هذه السفتجة وتكون له إن قام بالدفع نفس الحقوق التي كان لموكله المزعوم أن يحصل عليها ويجري الأمر بالمثل بالنسبة للوكيل الذي يتجاوز حدود وكالته."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_393> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_393> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_394> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الساحب ضامن قبول السفتجة ووفاءها. ويمكن له أن يعفي نفسه من ضمان القبول. وكل شرط يقضي بإعفائه من ضمان الوفاء يعد كأن لم يكن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_394_19750926_OpEnact_003a412b0f> ;
    dzdoc:replacementText "الساحب ضامن قبول السفتجة ووفاءها. ويمكن له أن يعفي نفسه من ضمان القبول. وكل شرط يقضي بإعفائه من ضمان الوفاء يعد كأن لم يكن."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_394> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_394> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
