<https://legal.dz/resource/order/1975-09-26/75-59#art_32_condition_0_8c64d48b> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_32_condition_0_8c64d48b_role_b884be6caa> ;
    dznorm:conditionText "لا يستمر الامتياز في جميع الأحوال على المرهون إلا إذا وضع هذا الأخير في حيازة الدائن وبقي لديه أو لدى الغير المتفق عليه بين الطرفين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_32> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_32_condition_0_8c64d48b_role_b884be6caa> a dznorm:Role ;
    rdfs:label "المرهون إلا إذا وضع"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "لا يستمر الامتياز في جميع الأحوال على المرهون إلا إذا وضع هذا الأخير في حيازة الدائن وبقي لديه أو لدى الغير المتفق عليه بين الطرفين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_32> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_32_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_32> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يستمر الامتياز في جميع الأحوال على المرهون إلا إذا وضع هذا الأخير في حيازة الدائن وبقي لديه أو لدى الغير المتفق عليه بين الطرفين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_32_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_32> ;
    dzdoc:position 1 ;
    dzdoc:text "ويعتبر الدائن حائزا للبضائع متى كانت تحت تصرفه في مخازنه أو سفنه، أو في الجمرك أو في مستودع عمومي أو كان بيد الدائن قبل وصولها وثيقة الشحن أو أي سند نقل آخر معادل لها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_330_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_330> ;
    dzdoc:position 0 ;
    dzdoc:text "التصديق على الصلح يجعله ملزما لكافة الدائنين سواء كانت قد حققت ديونهم أم لا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_330_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_330> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أنه لا يمكن الاحتجاج بالصلح قبل الدائنين ذوي الامتياز والمرتهنين عقاريا الذين لم يتنازلوا عن تأمينهم ولا قبل الدائنين العاديين الذين نشأ حقهم أثناء مدة التسوية القضائية أو الإفلاس."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_330_permission_0_9d8cfd8b> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_330_permission_0_9d8cfd8b_action_6215a2dbc6> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_330> ;
    dznorm:position 1 ;
    dznorm:provisionText "غير أنه لا يمكن الاحتجاج بالصلح قبل الدائنين ذوي الامتياز والمرتهنين عقاريا الذين لم يتنازلوا عن تأمينهم ولا قبل الدائنين العاديين الذين نشأ حقهم أثناء مدة التسوية القضائية أو الإفلاس."@ar ;
