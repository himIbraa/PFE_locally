<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_33> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن شركات المساهمة أن تصدر ما يأتي: 1- سندات كتمثيل لرأسمالها، 2- سندات كتمثيل لرسوم الديون التي على ذمتها، 3- سندات تعطي الحق في منح سندات أخرى تمثل حصة معينة لرأسمال الشركة عن طريق التحويل أو التسديد أو أي إجراء آخر."@ar ;
