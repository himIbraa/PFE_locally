<https://legal.dz/resource/order/1975-09-26/75-59#art_74> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_3> ;
    dzdoc:eId "art_74" ;
    dzdoc:fullText "كل دعوى ناشئة عن عقد نقل الأشخاص أو عقد العمولة لنقل الأشخاص يشملها التقادم بمضي مهلة ثلاثة أعوام من تاريخ الحادث الذي تولدت عنه . وتحدد المهلة التي ترفع خلالها دعوى الرجوع بثلاثة أشهر . ولا تسري هذه المهلة إلا من تاريخ رفع الدعوى على المكفول ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_74> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_74_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_74_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_74_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_74_19750926_OpEnact_9bbb230f15> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 74" ;
    dzdoc:position 76 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_74_condition_0_3bfdc58f>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_74_condition_1_a5985da3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_74_condition_2_fd8c5131> ;
    dzdoc:usesTerm dzterm:contract_commission_transport,
        dzterm:contract_transport_persons,
        dzterm:lawsuit,
        dzterm:recourse_action,
        dzterm:statute_of_limitations .

<https://legal.dz/resource/order/1975-09-26/75-59#art_761> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_761" ;
    dzdoc:fullText "يجوز - خلافا لأحكام المادة السابقة - أن يشترط بأن الشركات المستفيدة من الانفصال لا تلزم إلا بجزء من دين الشركة المنفصلة الموضوع على عاتق كل منها ودون تضامن بينها. وفي هذه الحالة يجوز لدائني الشركة المنفصلة أن يقوموا بالمعارضة في الانفصال حسب الشروط وتحت الآثار المنصوص عليها في الفقرة الثانية من المادة 756 وما بعدها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_761_permission_0_4bbcd6a8>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_761_permission_1_5f92a685> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_761_right_0_e2c2aeeb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_761> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_761_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_761_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_761_19750926_OpEnact_f7ff28cd0c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "761" ;
    dzdoc:position 968 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_756>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_760> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_756>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_760> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_774> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_774" ;
    dzdoc:fullText "إذا لم تتمكن الجمعية المكلفة بإقفال التصفية المنصوص عليها في المادة السابقة أو رفضت التصديق عن حسابات المصفي فإنه يحكم بقرار قضائي بطلب من المصفي أو كل من يهمه الأمر. ولهذا الغرض يضع المصفي حساباته بكتابة المحكمة حيث يتمكن كل معني بالأمر من أن يطلع عليها ويحصل على نسخة منها على نفقته . وتتولى المحكمة النظر في هذه الحسابات وعند الاقتضاء في إقفال التصفية حالة بذلك محل جمعية المشتركين أو المساهمين."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_774_right_0_2fe2336f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_774> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_774_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_774_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_774_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_774_19750926_OpEnact_748970638c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_774_obligation_0_741c5049> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "774" ;
    dzdoc:position 981 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_773> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_773> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_774_condition_0_c9859dff> ;
    dzdoc:usesTerm dzterm:liquidator .

<https://legal.dz/resource/order/1975-09-26/75-59#art_794> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_794" ;
    dzdoc:fullText "يقرر المصفي إذا كان ينبغي توزيع الأموال التي أصبحت قابلة للتصرف فيها أثناء التصفية وذلك دون الإخلال بحقوق الدائنين. يجوز لكل معني بالأمر أن يطلب من القضاء الحكم في وجوب التوزيع أثناء التصفية ، وذلك بعد إنذار من المصفي وباق بدون جدوى . ينشر كل قرار توزيع يتعلق بالأصول في جريدة الإعلانات القانونية التي تم فيها النشر المنصوص عليه في المادة 767 . ويبلغ قرار التوزيع إلى الشركاء على انفراد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_794_permission_0_21c285bb> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_794_right_0_20966eb3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_794> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_794_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_794_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_794_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_794_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_794_19750926_OpEnact_cb48effa24> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_794_obligation_0_79406190>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_794_obligation_1_812112cd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "794" ;
    dzdoc:position 1001 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_767> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_767> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_794_condition_0_f9fb436c> ;
    dzdoc:usesTerm dzterm:liquidator .

<https://legal.dz/resource/order/1975-09-26/75-59#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "لا يثبت امتياز بائع المحل التجاري إذا كان البيع ثابتا بعقد رسمي ومقيدا في سجل عمومي منظم لدى المركز الوطني للسجل التجاري الذي يقع المحل التجاري في دائرة اختصاصه . لا يترتب امتياز البائع إلا على عناصر المحل التجاري المبينة في عقد البيع وفي القيد فإذا لم يعين على وجه الدقة فإن الامتياز يقع على عنوان المحل التجاري واسمه والحق في الإيجار والعملاء والشهرة التجارية. وتوضع أسعار مميزة بالنسبة للعناصر المعنوية للمحل التجاري والمعدات والبضاعة . ويمارس امتياز البائع الضامن لكل من هذه الأثمان أو ما بقي مستحقا منها بصفة منفصلة على كل من أثمان إعادة بيع البضائع والمعدات والعناصر المعنوية للمحل التجاري. وبالرغم عن كل اتفاق مخالف فإن الدفعات الجزئية غير الدفعات النقدية تطرح أولا من ثمن البضائع ثم من ثمن المعدات. وإذا كان الثمن المعد للتوزيع حاصلا من بيع عنصر واحد أو عدة عناصر لم يشملها البيع الأول فيتعين تقدير ما ينوب كل منها على حدة من ثمن إعادة البيع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_96_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_96_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_96_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_96_para_3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_96_para_4>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_96_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_96_19750926_OpEnact_5277ddef49> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_96_obligation_0_a7bdce98> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "96" ;
    dzdoc:position 98 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_96_condition_0_c49e855b>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_96_condition_1_119663c2> ;
    dzdoc:usesTerm dzterm:seller_privilege .

<https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_8> a dzdoc:Section ;
