    dznorm:sourceArticle "art_300" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_300_obligation_0_9b746ee9_ref_950460ce34c8> a dzdoc:Reference ;
    rdfs:label "المادة 282"@ar ;
