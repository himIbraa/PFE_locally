<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_8_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_8> ;
    dzdoc:position 0 ;
