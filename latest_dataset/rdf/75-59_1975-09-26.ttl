<https://legal.dz/resource/order/1975-09-26/75-59#art_687> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_687" ;
    dzdoc:fullText "يزاد رأسمال الشركة إما بإصدار أسهم جديدة أو بإضافة قيمة للأسهم الموجودة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_687> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_687_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_687_19750926_OpEnact_be118475fb> ;
