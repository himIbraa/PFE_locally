    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "762" ;
    dzdoc:position 969 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_758>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_761> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_758>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_761> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_768> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_768" ;
    dzdoc:fullText "يقوم المصفي أثناء تصفية الشركة وتحت مسؤوليته بإجراءات النشر الواقعة على الممثلين القانونيين للشركة . وخاصة فيما يتعلق بكل قرار يؤدي إلى تعديل البيانات المنشورة طبقا للمادة السابقة فإنه ينشر طبقا للشروط المنصوص عليها في هذه المادة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_768> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_768_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_768_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_768_19750926_OpEnact_96ac45b5c1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_768_obligation_0_820c37b4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "768" ;
    dzdoc:position 975 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_767> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_767> ;
    dzdoc:usesTerm dzterm:liquidator .

<https://legal.dz/resource/order/1975-09-26/75-59#art_772> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_772" ;
    dzdoc:fullText "يرخص بالتنازل الإجمالي عن مال الشركة أو عن حصة المال المقدمة إلى شركة أخرى إذا كان قد تم ذلك خاصة عن طريق الإدماج : 1- في شركات التضامن بمو افقة كافة الشركاء، 2- وفي الشركات ذات المسؤولية المحدودة بالأغلبية التي تطلب لتعديل القانون الأساسي، 3- وفي الشركات المساهمة حسب شروط النصاب والأغلبية المنصوص عليهما في الجمعيات غير العادية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_772_permission_0_b01924f8> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_772_right_0_cb89a0f7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_772> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_772_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_772_19750926_OpEnact_c2b47e4fca> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "772" ;
    dzdoc:position 979 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_772_condition_0_f9b0685c> ;
    dzdoc:usesTerm dzterm:joint_stock_company,
        dzterm:limited_liability_company,
        dzterm:partnership .

<https://legal.dz/resource/order/1975-09-26/75-59#art_795_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_795_bis_3" ;
    dzdoc:fullText "يتفق الشركاء بكل حرية على موضوع الفائدة أو شكلها أو نسبتها وعلى شروط شركة المحاصة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_795_bis_3_right_0_bf2dfb4e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_795_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_795_bis_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_795_bis_3_19750926_OpEnact_eff9510ab6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "795 مكرر 3" ;
    dzdoc:position 1005 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_795_bis_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_795_bis_5" ;
    dzdoc:fullText "لا يمكن تمثيل حقوق الشركاء بسندات قابلة للتداول. يعتبر كل شرط مخالف كأن لم يكن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_795_bis_5_permission_0_0f203c1a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_795_bis_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_795_bis_5_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_795_bis_5_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_795_bis_5_19750926_OpEnact_c9c3e0cea7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "795 مكرر 5" ;
    dzdoc:position 1007 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_798> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_5> ;
    dzdoc:eId "art_798" ;
    dzdoc:fullText "يجب أن ينص عقد التجمع كذلك على ما يأتي : 1- شروط قبول الأعضاء الجدد وعزلهم، 2- صلاحيات جمعية أعضاء التجمع، 3- كيفيات مراقبة التسيير، 4- كيفيات الحل والتصفية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_798> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_798_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_798_19750926_OpEnact_d6e3c0ffb1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_798_obligation_0_57605624> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 798" ;
    dzdoc:position 1010 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_799> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_5> ;
    dzdoc:eId "art_799" ;
    dzdoc:fullText "لا يؤدي التجمع من تلقاء نفسه إلى تحقيق الفوائد واقتسامها ويمكن أن يؤسس بدون رأسمال. ولا يمكن تمثيل حقوق أعضائه بواسطة سندات قابلة للتداول، ويعتبر كل شرط مخالف كأن لم يكن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_799_permission_0_46cc49c4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_799> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_799_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_799_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_799_19750926_OpEnact_9576dacc99> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 799" ;
    dzdoc:position 1011 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_801> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_1> ;
    dzdoc:eId "art_801" ;
    dzdoc:fullText "يعاقب بغرامة من 20.000 دج إلى 200.000 دج : 1- المسيرون الذين لم يضعوا في كل سنة مالية الجرد وحساب الاستغلال العام وحساب النتائج والميزانية وتقريرا عن عمليات السنة المالية، 2- المسيرون الذين لم يوجهوا في أجل خمسة عشر يوما قبل تاريخ انعقاد الجمعية، إلى الشركات حساب الاستغلال العام وحساب النتائج والميزانية وتقريرا عن عمليات السنة المالية ونص القرارات المقترحة وعند الاقتضاء تقرير مندوبي الحسابات، أو إذا لم يضعوا الجرد تحت تصرف الشركاء بالمركز الرئيسي للشركة، 3- المسيرون الذين لم يضعوا في أي وقت من السنة تحت تصرف كل شريك بالمقر الرئيسي المستندات التالية الخاصة بالسنوات المالية الثلاث الأخيرة المعروضة على الجمعيات وهي: حسابات الاستغلال العام والجرد وحسابات النتائج والميزانيات وتقارير المسيرين وعند الاقتضاء تقارير مندوبي الحسابات ومحاضر الجمعيات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_801> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_801_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_801_19750926_OpEnact_7233c8e668> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_801_obligation_0_2601fe38> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "801" ;
    dzdoc:position 1018 ;
    dzdoc:usesTerm dzterm:manager .

<https://legal.dz/resource/order/1975-09-26/75-59#art_806> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_806" ;
    dzdoc:fullText "يعاقب بغرامة من 20.000 دج إلى 200.000 دج، مؤسسو الشركات المساهمة ورئيسها والقائمون بإدارتها أو الذين أصدروا الأسهم سواء قبل قيد الشركة ب السجل التجاري أو في أي وقت كان إذا حصل على قيد بطريق الغش أو دون إتمام إجراءات تأسيس تلك الشركة بوجه قانوني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_806> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_806_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_806_19750926_OpEnact_7bd204f36a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_806_obligation_0_29d37cb5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "806" ;
    dzdoc:position 1023 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_806_condition_0_f25ebd3e> ;
    dzdoc:usesTerm dzterm:commercial_register,
        dzterm:founders .

<https://legal.dz/resource/order/1975-09-26/75-59#art_807> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_807" ;
    dzdoc:fullText "يعاقب بالسجن من سنة إلى خمس سنوات وبغرامة من 20.000 دج إلى 200.000 دج، أو بإحدى هاتين العقوبتين فقط : الأشخاص الذين أكدوا عمدا في تصريح توثيقي مثبت للاكتتابات والدفوعات، صحة البيانات التي كانوا يعلمون بأنها صورية أو أعلنوا بأن الأموال التي لم توضع بعد تحت تصرف الشركة قد سددت أو قدموا للموثق قائمة للمساهمين تتضمن اكتتابات صورية أو بلغوا بتسديدات مالية لم توضع نهائيا تحت تصرف الشركة، الأشخاص الذين قاموا عمدا عن طريق إخفاء اكتتابات أو دفوعات أو عن طريق نشر اكتتابات أو دفوعات غير موجودة أو وقائع أخرى مزورة للحصول أو محاولة الحصول على اكتتابات أو دفوعات، الأشخاص الذين قاموا عمدا - وبغرض الحث على الاكتتابات أو الدفوعات - بنشر أسماء أشخاص تم تعيينهم خلافا للحقيقة باعتبار أنهم ألحقوا أو سيلحقون بمنصب ما في الشركة، الأشخاص الذين منحوا - غشا - حصة عينية أعلى من قيمتها الحقيقية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_807> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_807_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_807_19750926_OpEnact_c1358d6651> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_807_obligation_0_57afdbf5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "807" ;
    dzdoc:position 1024 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_81> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_81" ;
    dzdoc:fullText "يجب على المشتري رفع الدعوى الناجمة عن المادة 84 في مهلة سنة واحدة من تاريخ حيازته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_81> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_81_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_81_19750926_OpEnact_277ebf0a06> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_81_obligation_0_844d5bae> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "81" ;
    dzdoc:position 83 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_84> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_84> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_810> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_810" ;
    dzdoc:fullText "يعاقب بالحبس من شهر إلى ثلاثة أشهر وبغرامة من 20.000 دج إلى 200.000 دج أو بإحدى هاتين العقوبتين فقط، كل شخص تعمد القبول أو الاحتفاظ بمهام مندوب لتقدير الحصص المقدمة وهذا بالرغم من عدم الملاءمات أو الموانع القانونية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_810> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_810_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_810_19750926_OpEnact_5883c7da29> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_810_obligation_0_a0c8117d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "810" ;
    dzdoc:position 1027 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_815> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_3> ;
    dzdoc:eId "art_815" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 20.000 دج إلى 200.000 دج أو بإحدى هاتين العقوبتين فقط رئيس شركة المساهمة أو القائمون بإدارتها والذين لم يعملوا على انعقاد الجمعية العامة العادية في الستة الأشهر التي تلي اختتام السنة المالية، أو عند التمديد في الأجل التي تلي اختتام السنة المالية، أو عند التمديد في الأجل المعين بقرار قضائي، أو لم يقدموا المستندات المنصوص عليها في الفقرتين 2 و 3 من المادة 545 للمصادقة عليها من طرف الجمعية المذكورة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_815> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_815_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_815_19750926_OpEnact_d7eb57186b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_815_obligation_0_4ab1fcef> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "815" ;
    dzdoc:position 1032 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_545> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_545> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_815_condition_0_50cdcbca> ;
    dzdoc:usesTerm dzterm:administrators,
        dzterm:chairman .

<https://legal.dz/resource/order/1975-09-26/75-59#art_817> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_3> ;
    dzdoc:eId "art_817" ;
    dzdoc:fullText "يعاقب بغرامة من 20.000 دج إلى 100.000 دج رئيس شركة المساهمة الذي لم يحط علما المساهمين بموجب رسالة موصى عليها بالتاريخ المحدد لانعقاد الجمعية قبل خمسة وثلاثين يوما على الأقل من التاريخ المحدد للانعقاد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_817> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_817_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_817_19750926_OpEnact_9fd0cfb03c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_817_obligation_0_63585bbc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "817" ;
    dzdoc:position 1034 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_817_condition_0_7700db51> ;
    dzdoc:usesTerm dzterm:chairman .

<https://legal.dz/resource/order/1975-09-26/75-59#art_831> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_5> ;
    dzdoc:eId "art_831" ;
    dzdoc:fullText "يعاقب بالسجن من سنة إلى خمس سنوات وبغرامة من 20.000 دج إلى 500.000 دج أو بإحدى هاتين العقوبتين فقط ، رئيس الشركة و القائمون بإدارتها و مديروها العامون أو كل شخص في خدمة الشركة يتعمد وضع عائق لمراجعة الحسابات أو مراقبات مندوبي الحسابات أو يمتنع عن تقديم كل الوثائق اللازمة للإطلاع عليها في عين المكان أثناء ممارسة مهامهم خاصة فيما يتعلق بالاتفاقات والدفاتر المستندية وسجلات المحاضر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_831> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_831_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_831_19750926_OpEnact_c7237d2241> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_831_obligation_0_71811cdd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "831" ;
    dzdoc:position 1048 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_831_condition_0_386b27fa> ;
    dzdoc:usesTerm dzterm:administrators,
        dzterm:chairman,
        dzterm:general_managers .

<https://legal.dz/resource/order/1975-09-26/75-59#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "يجب على الموظف العمومي المكلف بالبيع ألا يقبل في المزايدة إلا الأشخاص المعروفين بملاءتهم لديه أو الذين أودعوا إما بين يديه أو في مصلحة الودائع والأمانات مبلغا لا يقل عن نصف الثمن الكامل للبيع الأول أو عن جزء ثمن البيع المذكور المشترط دفعه نقدا مع إضافة الزيادة وكذلك التخصيص لسداد ثمن البيع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_86_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_86_19750926_OpEnact_05e8626bd9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_86_obligation_0_2aec908b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "86" ;
    dzdoc:position 88 ;
    dzdoc:usesTerm dzterm:public_officer .

<https://legal.dz/resource/order/1975-09-26/75-59#art_الأولى_مكرر> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
