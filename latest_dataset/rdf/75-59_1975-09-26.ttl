<https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_2> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "سند الخزن هو سند يسمح للمودع بالاقتراض على قيمة البضائع المودعة بالمخزن العام. ويحتوي على نفس بيانات الوصل . يمكن حائز السند ، في أي وقت أن يفصل سند الخزن ويحوله لإذن حامل . وتشكل البضاعة المودعة حينئذ، ضمان تسديد المبلغ المقترض عند الاستحقاق. سند الخزن هو سند قابل للتظهير بنفس شروط السندات التجارية الأخرى."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_2_19750926_OpEnact_3c12702853> ;
