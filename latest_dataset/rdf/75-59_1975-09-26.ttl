<https://legal.dz/resource/order/1975-09-26/75-59#version_art_783> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يتمكن الشركاء من تعيين مصف فإن تعيينه يقع بأمر من رئيس المحكمة بعد فصله في العريضة. ويجوز لكل من يهمه الأمر أن يرفع معارضة ضد الأمر في أجل خمسة عشر يوما اعتبارا من تاريخ نشره طبقا للشروط المنصوص عليها في المادة 757 وترفع هذه المعارضة أمام المحكمة التي يجوز لها أن تعين مصفيا آخر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_783_19750926_OpEnact_8b3d09fe5b> ;
    dzdoc:replacementText "إذا لم يتمكن الشركاء من تعيين مصف فإن تعيينه يقع بأمر من رئيس المحكمة بعد فصله في العريضة. ويجوز لكل من يهمه الأمر أن يرفع معارضة ضد الأمر في أجل خمسة عشر يوما اعتبارا من تاريخ نشره طبقا للشروط المنصوص عليها في المادة 757 وترفع هذه المعارضة أمام المحكمة التي يجوز لها أن تعين مصفيا آخر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_783> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_783> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
