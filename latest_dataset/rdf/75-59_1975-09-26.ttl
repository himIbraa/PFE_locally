<https://legal.dz/resource/order/1975-09-26/75-59#version_art_6> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للتجار القصر المرخص لهم طبقا للأحكام الواردة في المادة 5 ، أن يرتبوا التزاما أو رهنا على عقاراتهم . غير أن التصرف في هذه الأموال سواء كان اختياريا أو جبريا لا يمكن أن يتم إلا باتباع أشكال الإجراءات المتعلقة ببيع أموال القصر أو عديمي الأهلية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
