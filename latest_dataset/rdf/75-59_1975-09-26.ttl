<https://legal.dz/resource/order/1975-09-26/75-59#art_612_obligation_2_bfa428fe_role_3f1c977e2a> a dznorm:Role ;
    rdfs:label "استبداله"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يجب عليه العمل في نفس الوقت على استبداله"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_612> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_612_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_612> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يمكن شخصا طبيعيا الانتماء في نفس الوقت إلى أكثر من خمسة (05) مجالس إدارة لشركات مساهمة يوجد مقرها بالجزائر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_612_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_612> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجوز تعيين شخص معنوي قائما بالإدارة في عدة شركات، وفي هذه الحالة لا تطبق أحكام المقطع الأول على الممثلين الدائمين للأشخاص المعنويين. ويجب عليه عند تعيينه اختيار ممثل دائم يخضع لنفس الشروط والواجبات ويتحمل نفس المسؤوليات المدنية والجزائية كما لو كان قائما بالإدارة باسمه الخاص، دون المساس بالمسؤولية التضامنية للشخص المعنوي الذي يمثله."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_612_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_612> ;
    dzdoc:position 2 ;
    dzdoc:text "وعندما يقوم الشخص المعنوي بعزل ممثله، يجب عليه العمل في نفس الوقت على استبداله."@ar .

