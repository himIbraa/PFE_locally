<https://legal.dz/resource/order/1975-09-26/75-59#version_art_290> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان الدائن صاحب التعهدات التضامنية، بين المدين المفلس أو المقبول في تسوية قضائية وبين شركاء له في الالتزام قد قبض قسطا من حقه قبل التوقف عن الدفع فإنه لا يدخل ضمن جماعة الدائنين إلا بعد استنزال هذا القسط مع حفظ جميع الحقوق عن القدر الباقي له ضد الشريك في الالتزام أو الكفيل . يدرج الشريك في الالتزام أو الكفيل الصادر منه الدفع الجزئي في نفس جماعة الدائنين لكل ما دفعه إبراء لذمة المدين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_290_19750926_OpEnact_b7a58aa0b4> ;
    dzdoc:replacementText "إذا كان الدائن صاحب التعهدات التضامنية، بين المدين المفلس أو المقبول في تسوية قضائية وبين شركاء له في الالتزام قد قبض قسطا من حقه قبل التوقف عن الدفع فإنه لا يدخل ضمن جماعة الدائنين إلا بعد استنزال هذا القسط مع حفظ جميع الحقوق عن القدر الباقي له ضد الشريك في الالتزام أو الكفيل . يدرج الشريك في الالتزام أو الكفيل الصادر منه الدفع الجزئي في نفس جماعة الدائنين لكل ما دفعه إبراء لذمة المدين ."@ar ;
