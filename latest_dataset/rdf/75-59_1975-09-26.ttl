<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_70_condition_0_0d03a9b5> a dznorm:Condition ;
    dznorm:conditionText "في حالة زيادة نقدية في رأس المال"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_70> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_70_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_70> ;
    dzdoc:position 0 ;
    dzdoc:text "في حالة زيادة نقدية في رأس المال، تصدر شهادات استثمار جديدة بعدد يحافظ فيه على التناسب الذي كان قائما قبل الزيادة بين الأسهم العادية وشهادات الاستثمار بعد الزيادة التي يفترض تحققها كاملا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_70_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_70> ;
    dzdoc:position 1 ;
    dzdoc:text "لمالكي شهادات الاستثمار ، حق الأفضلية في الاكتتاب بما يتناسب وعدد السندات التي يمتلكونها، بصفة غير قابلة للتخفيض في شهادات الاستثمار الجديدة، ويجوز لمالكي شهادات الاستثمار التنازل عن هذا الحق."@ar .

