<https://legal.dz/resource/order/1975-09-26/75-59#version_art_612> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن شخصا طبيعيا الانتماء في نفس الوقت إلى أكثر من خمسة (05) مجالس إدارة لشركات مساهمة يوجد مقرها بالجزائر . ويجوز تعيين شخص معنوي قائما بالإدارة في عدة شركات، وفي هذه الحالة لا تطبق أحكام المقطع الأول على الممثلين الدائمين للأشخاص المعنويين. و يجب عليه عند تعيينه اختيار ممثل دائم يخضع لنفس الشروط والواجبات ويتحمل نفس المسؤوليات المدنية والجزائية كما لو كان قائما بالإدارة باسمه الخاص ، دون المساس بالمسؤولية التضامنية للشخص المعنوي الذي يمثله. وعندما يقوم الشخص المعنوي بعزل ممثله ، يجب عليه ال"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_612_19750926_OpEnact_13526eb080> ;
    dzdoc:replacementText "لا يمكن شخصا طبيعيا الانتماء في نفس الوقت إلى أكثر من خمسة (05) مجالس إدارة لشركات مساهمة يوجد مقرها بالجزائر . ويجوز تعيين شخص معنوي قائما بالإدارة في عدة شركات، وفي هذه الحالة لا تطبق أحكام المقطع الأول على الممثلين الدائمين للأشخاص المعنويين. و يجب عليه عند تعيينه اختيار ممثل دائم يخضع لنفس الشروط والواجبات ويتحمل نفس المسؤوليات المدنية والجزائية كما لو كان قائما بالإدارة باسمه الخاص ، دون المساس بالمسؤولية التضامنية للشخص المعنوي الذي يمثله. وعندما يقوم الشخص المعنوي بعزل ممثله ، يجب عليه العمل في نفس الوقت على استبداله ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_612> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
