<https://legal.dz/resource/order/1975-09-26/75-59#version_art_436> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أقيمت دعوى الرجوع بعد حصول قبول جزئي فمن سدد المبلغ الذي لم تقبل فيه السفتجة يحق له أن يطلب ذكر هذا التسديد على السفتجة وإعطاءه إيصالا به ويجب على الحامل فوق ذلك أن يسلم نسخة مصدقة عن السفتجة مع الاحتجاج ليمكنه من إقامة دعاوى الرجوع فيما بعد ."@ar ;
