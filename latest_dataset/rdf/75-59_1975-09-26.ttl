    dznorm:provisionText "يجب تقديم أوجه البطلان قبل مرسى المزاد بثمانية أيام على الأقل تحت طائلة سقوط الحق في القيام بها"@ar ;
    dznorm:sourceArticle "art_127" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_127_obligation_2_03ee090d_action_af985d35dd> a dznorm:Action ;
