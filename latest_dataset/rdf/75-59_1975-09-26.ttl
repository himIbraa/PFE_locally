<https://legal.dz/resource/order/1975-09-26/75-59#version_art_354> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "بعد إقفال الإجراءات يحل اتحاد الدائنين بحكم القانون و يسترجع الدائنون شخصيا ممارسة أعمالهم . وللدائنين أن يحصلوا بأمر من رئيس المحكمة على سند تنفيذي إذا حققت وقبلت حقوقهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_354_19750926_OpEnact_90ee39e1e8> ;
