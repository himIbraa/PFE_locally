<https://legal.dz/resource/order/1975-09-26/75-59#version_art_40> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "على المرسل دفع أجرة النقل والمصاريف المترتبة على الأشياء المنقولة . وإذا اشترط دفع الأجرة عند وصول الأشياء المنقولة فيكون الناقل و المرسل إليه الذي صدر منه القبول ملزمين بأدائها بالتضامن بينهما ."@ar ;
