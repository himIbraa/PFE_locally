<https://legal.dz/resource/order/1975-09-26/75-59#version_art_234> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مهلة الاستئناف لأي حكم صادر في تسوية قضائية أو إفلاس، هي عشرة أيام اعتبارا من يوم التبليغ . ويفصل المجلس القضائي فيه خلال ثلاثة أشهر . ويكون الحكم واجب التنفيذ بموجب مسودته."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_234_19750926_OpEnact_3c14515a18> ;
    dzdoc:replacementText "مهلة الاستئناف لأي حكم صادر في تسوية قضائية أو إفلاس، هي عشرة أيام اعتبارا من يوم التبليغ . ويفصل المجلس القضائي فيه خلال ثلاثة أشهر . ويكون الحكم واجب التنفيذ بموجب مسودته."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_234> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_234> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_235> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعين القاضي المنتدب ، في بدء كل سنة قضائية، بأمر من رئيس المجلس القضائي بناء على اقتراح رئيس المحكمة . ويكون القاضي المنتدب مكلفا بنوع خاص بأن يلاحظ ويراقب أعمال وإدارة التفليسة ، أو التسوية القضائية . فيجمع كافة عناصر المعلومات التي يراها مجدية ، وله بنوع خاص سماع المدين المفلس أو المقبول في تسوية قضائية ومندوبية ومستخدميه ودائنيه أو أي شخص آخر . يقدم القاضي المنتدب للمحكمة وجوبا تقريرا شاملا لجميع النزاعات الناجمة عن التسوية القضائية أو الإفلاس ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_235_19750926_OpEnact_f55585426f> ;
    dzdoc:replacementText "يعين القاضي المنتدب ، في بدء كل سنة قضائية، بأمر من رئيس المجلس القضائي بناء على اقتراح رئيس المحكمة . ويكون القاضي المنتدب مكلفا بنوع خاص بأن يلاحظ ويراقب أعمال وإدارة التفليسة ، أو التسوية القضائية . فيجمع كافة عناصر المعلومات التي يراها مجدية ، وله بنوع خاص سماع المدين المفلس أو المقبول في تسوية قضائية ومندوبية ومستخدميه ودائنيه أو أي شخص آخر . يقدم القاضي المنتدب للمحكمة وجوبا تقريرا شاملا لجميع النزاعات الناجمة عن التسوية القضائية أو الإفلاس ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_235> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_235> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_236> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تقرر قبول تاجر في حالة تسوية قضائية أو شهر إفلاسه بعد الوفاة، أو كانت وفاته حاصلة بعد القبول في التسوية القضائية أو شهر الإفلاس ، فإن لأرملته أو أولاده أو ورثته الحضور أو الإنابة في الحضور للحلول محله في كافة أعمال التسوية القضائية أو التفليسة وأن يستمع إليهم على نحو ما نص عليه في الفقرة الثالثة من المادة 235 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_236_19750926_OpEnact_60b144a211> ;
    dzdoc:replacementText "إذا تقرر قبول تاجر في حالة تسوية قضائية أو شهر إفلاسه بعد الوفاة، أو كانت وفاته حاصلة بعد القبول في التسوية القضائية أو شهر الإفلاس ، فإن لأرملته أو أولاده أو ورثته الحضور أو الإنابة في الحضور للحلول محله في كافة أعمال التسوية القضائية أو التفليسة وأن يستمع إليهم على نحو ما نص عليه في الفقرة الثالثة من المادة 235 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_236> ;
