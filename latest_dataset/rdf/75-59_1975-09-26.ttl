<https://legal.dz/resource/order/1975-09-26/75-59#version_art_503> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "وفي حالة توفر الرصيد ، يجب على المسحوب عليه أن يستوفي قيمة الصك حتى بعد انقضاء الأجل المحدد لتقديمه . ولا تقبل معارضة الساحب على وفاء الشيك إلا في حالة ضياعه أو تفليس حامله . فإذا رفع الساحب بالرغم من هذا الحظر معارضة لأسباب أخرى ، وجب على قاضي الأمور المستعجلة حتى ولو في حالة رفع دعوى أصلية أن يأمر بإلغاء هذه المعارضة بناء على طلب الحامل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_503_19750926_OpEnact_40c75a7562> ;
    dzdoc:replacementText "وفي حالة توفر الرصيد ، يجب على المسحوب عليه أن يستوفي قيمة الصك حتى بعد انقضاء الأجل المحدد لتقديمه . ولا تقبل معارضة الساحب على وفاء الشيك إلا في حالة ضياعه أو تفليس حامله . فإذا رفع الساحب بالرغم من هذا الحظر معارضة لأسباب أخرى ، وجب على قاضي الأمور المستعجلة حتى ولو في حالة رفع دعوى أصلية أن يأمر بإلغاء هذه المعارضة بناء على طلب الحامل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_503> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
