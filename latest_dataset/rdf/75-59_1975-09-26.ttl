<https://legal.dz/resource/order/1975-09-26/75-59#art_513> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_5> ;
    dzdoc:eId "art_513" ;
    dzdoc:fullText "لا يمكن ل المسحوب عليه أن يوفي شيكا محتويا على تسطير عام إلا ل مصرف معين أو لرئيس مكتب الصكوك البريدية أو لأحد عملاء المسحوب عليه . ولا يمكن ل المسحوب عليه أن يوفي شيكا محتويا على تسطير خاص إلا إلى مصرف معين، أو إلى عميله إذا كان هذا المصرف هو مسحوب عليه على أن المصرف المعين يمكنه أن يسعى لدى مصرف آخر لقبض قيمة الشيك. ولا يجوز ل مصرف أن يحصل على شيك مسطر إلا من أحد عملائه أو مصلحة الصكوك البريدية أو من مصرف آخر و لا يجوز له أن يقبض قيمته لحساب أشخاص آخرين غيرهم . إذا كان الشيك يحتوي على عدة تسطيرات خاصة فلا يمكن ل المسحوب عليه وفاؤه إلا في حالة وجود تسطرين ويكون أحدهما لتحصيل قيمته بواسطة غرف المقاصة . وإذا أهمل المسحوب عليه أو المصرف مراعاة الأحكام المتقدمة فإنه يكون مسؤولا عن الضرر بما يعادل مبلغ الشيك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_513_permission_0_4855479c>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_513_permission_1_1b2b2c73>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_513_permission_2_80106f0a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_513_permission_3_4c844dfd> ;
