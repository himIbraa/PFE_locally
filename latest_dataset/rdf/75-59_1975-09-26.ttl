<https://legal.dz/resource/order/1975-09-26/75-59#art_94_condition_0_4b3465e5> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يكن للمعارضة سند ولا سبب أو كانت باطلة شكلا ولم ترفع دعوى أصلية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_94> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_94_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_94> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا لم يكن للمعارضة سند ولا سبب أو كانت باطلة شكلا ولم ترفع دعوى أصلية فإنه يجوز للبائع رفع دعوى مستعجلة لدى رئيس المحكمة للحصول على إذن بقبض ثمن البيع بالرغم من المعارضة."@ar .

