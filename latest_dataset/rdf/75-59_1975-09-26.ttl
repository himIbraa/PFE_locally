    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_178>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_194> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_178>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_194> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_187_condition_0_567d2d49>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_187_condition_1_a37ac323> ;
