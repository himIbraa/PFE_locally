<https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_9_obligation_2_697e42f8> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_9> ;
    dznorm:position 2 ;
    dznorm:provisionText "حلت الشركة بقوة القانون عند انقضاء هذا الأجل"@ar ;
    dznorm:sourceArticle "art_563_bis_9" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_9_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_9> ;
    dzdoc:position 0 ;
    dzdoc:text "تستمر الشركة، رغم وفاة شريك موص، وإذا اشترط أنه رغم وفاة أحد الشركاء المتضامنين، فإن الشركة تستمر مع ورثته، فإن هؤلاء يصبحون شركاء موصين إذا كانوا قصرا غير راشدين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_9_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_9> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا كان المتوفى، هو الشريك المتضامن الوحيد، وكان ورثته كلهم قصرا غير راشدين، يجب تعويضه بشريك متضامن جديد أو تحويل الشركة، في أجل سنة ابتداء من تاريخ الوفاة، وإلا حلت الشركة بقوة القانون عند انقضاء هذا الأجل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_obligation_0_8a88d95d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
