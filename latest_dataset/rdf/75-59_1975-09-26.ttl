<https://legal.dz/resource/order/1975-09-26/75-59#version_art_398> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن المظهر ضامن قبول السفتجة ووفاءها ما لم يشترط خلاف ذلك. وله أن يمنع تظهيرها من جديد وفي هذه الحالة لا يكون ملزما بالضمان للأشخاص الذين تظهر لهم السفتجة فيما بعد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
