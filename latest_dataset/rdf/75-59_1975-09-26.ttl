<https://legal.dz/resource/order/1975-09-26/75-59#art_224> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_2> ;
    dzdoc:eId "art_224" ;
    dzdoc:fullText "في حالة التسوية القضائية لشخص معنوي أو إفلاسه ، يجوز إشهار ذلك شخصيا على كل مدير قانوني أو واقعي ظاهري أو باطني مأجورا كان أم لا : إذا كان ذلك المدير في ظل الشخص المعنوي أثناء قيامه بتصرفاته قد قام لمصلحته بأعمال تجارية أو تصرف في أموال الشركة كما لو كانت أمواله الخاصة . أو باشر تعسفا لمصلحته الخاصة باستغلال خاسر لا يمكن أن يؤدي إلا إلى توقف الشخص المعنوي عن الدفع ، في حالة التسوية القضائية أو شهر الإفلاس الصادر طبقا لهذه المادة، تشمل الديون علاوة على الديون الشخصية، ديون الشخص المعنوي. وتاريخ التوقف عن الدفع هو نفس التاريخ المحدد بالحكم الذي قضى بـ التسوية القضائية أو إفلاس الشخص المعنوي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_224_permission_0_4b9b05c6> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_224_right_0_c7558d4e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_224> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_224_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_224_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_224_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_224_19750926_OpEnact_4a960ccfdb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "224" ;
    dzdoc:position 228 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_224_condition_0_b17bbdda>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_224_condition_1_cc657c29>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_224_condition_2_200a66c3> ;
    dzdoc:usesTerm dzterm:bankruptcy,
        dzterm:cessation_of_payment,
        dzterm:judicial_settlement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_402> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_402" ;
    dzdoc:fullText "ينتج التظهير الحاصل بعد الاستحقاق الآثار ذاتها المترتبة عن التظهير السابق للاستحقاق. على أن التظهير الحاصل بعد الاحتجاج عند الامتناع عن الدفع أو بعد انقضاء الأجل المعين للاحتجاج فلا ينتج إلا آثار التنازل العادي. إن التظهير بدون بيان لتاريخه يعتبر واقعا قبل انقضاء الأجل المعين للاحتجاج، ما لم تقم الحجة على خلافه. يمنع تقديم تواريخ الأوامر بالدفع وإلا كان ذلك تزويرا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_402> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_402_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_402_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_402_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_402_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_402_19750926_OpEnact_3ee473a59e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_402_obligation_0_cfd9ffbd> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_402_prohibition_0_0a2833e3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "402" ;
    dzdoc:position 407 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_402_condition_0_f069aeeb> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_431> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_8> ;
    dzdoc:eId "art_431" ;
    dzdoc:fullText "يجوز للساحب أو المظهر أو الضامن الاحتياطي، بناء على شرط « الرجوع بدون مصاريف » أو « بدون احتجاج » أو أي شرط مماثل له مقيد في السند مع توقيعه عليه أن يعفي الحامل متى أراد ممارسة حقوقه في الرجوع من تحرير احتجاج لعدم القبول أو الوفاء . على أن الشرط المذكور لا يعفي الحامل من تقديم السفتجة في الآجال المعينة ولا من توجيه الإخطارات اللازمة. أما إثبات عدم مراعاة الآجال فيكون على من يتمسك بها ضد الحامل . إذا كان الشرط صادرا عن الساحب نتجت آثاره تجاه جميع الموقعين، أما إذا اشترطه مظهر أو ضامن احتياطي فلا تتعدى آثاره هذا الأخير، وإذا أقام الحامل احتجاجا بالرغم من الشرط الذي ضمنه الساحب فإنه يتحمل مصاريفه، وإذا كان الشرط صادرا عن مظهر أو ضامن احتياطي وحرر احتجاج فإن مصاريفه يمكن استيفاؤها من جميع الموقعين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_431_permission_0_735eb4c9>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_431_permission_1_3f10ea42> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_431_right_0_a8e27b33> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_431> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_431_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_431_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_431_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_431_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_431_19750926_OpEnact_cd8b472999> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 431" ;
    dzdoc:position 436 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_431_condition_0_2a451e0f>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_431_condition_1_2557456e> ;
    dzdoc:usesTerm dzterm:holder .

<https://legal.dz/resource/order/1975-09-26/75-59#art_448> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_9> ;
    dzdoc:eId "art_448" ;
    dzdoc:fullText "يمكن ل ساحب السفتجة أو مظهرها أو ضامنها الاحتياطي أن يعين من يقبلها أو يدفعها عند الاقتضاء . ويمكن وفقا للشروط الآتي بيانها قبول السفتجة أو وفاؤها من شخص متدخل لفائدة مدين معرض لدعوى الرجوع . ويمكن أن يكون المتدخل من الغير أو المسحوب عليه نفسه أو شخص آخر كان ملزما بمقتضى السفتجة عدا قابلها. ويجب على المتدخل إخطار الشخص الذي تدخل لأجله في ظرف يومي العمل التاليين و إذا أهمل مراعاة هذا الأجل يكون مسؤولا عند الاقتضاء بالضرر الناشئ عن إهماله بدون أن يتجاوز تعويض هذا الضرر مبلغ السفتجة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_448_permission_0_41f4e033> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_448_right_0_e298e646>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_448_right_1_85629a44> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_448> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_448_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_448_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_448_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_448_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_448_19750926_OpEnact_09c8d97412> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_448_obligation_0_51bb9ad9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "448" ;
    dzdoc:position 453 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_448_condition_0_2a70b610> ;
    dzdoc:usesTerm dzterm:avaliste,
        dzterm:bill_of_exchange,
        dzterm:drawee,
        dzterm:drawer,
        dzterm:endorser .

<https://legal.dz/resource/order/1975-09-26/75-59#art_523> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_6> ;
    dzdoc:eId "art_523" ;
    dzdoc:fullText "إذا حال دون تقديم الشيك أو إقامة الاحتجاج في الآجال المقررة حائل لا مرد له كوجود نص قانوني أو غير ذلك من ظروف القوة القاهرة فتمدد الآجال المذكورة. ويجب على الحامل أن يبادر بإخطار من ظهر له بحادث القوة القاهرة وأن يثبت هذا الإخطار على الشيك أو على الورقة المتصلة به مؤرخا وموقعا منه ، وفيما زاد على ذلك، تطبق أحكام المادة 517 على بقية الإجراءات. وعلى الحامل بعد زوال القوة القاهرة أن يبادر بتقديم الشيك للوفاء ثم بإقامة الاحتجاج عند الاقتضاء. وإذا استمرت القوة القاهرة أكثر من خمسة عشر يوما من تاريخ اليوم الذي قام فيه الحامل بإخطار من ظهر له بحدوث القوة القاهرة ولو كان هذا التاريخ قبل انقضاء أجل تقديم الشيك ، فيجوز استعمال حق الرجوع بغير حاجة إلى تقديم الشيك أو إقامة الاحتجاج ما لم يكن هذا الحق معلقا لمدة أطول تطبيقا لنص قانوني. ولا تعتبر من قبل القوة القاهرة، الحوادث الشخصية البحتة المتعلقة بحامل الشيك أو بمن كلفه بتقديمه أو بتقديم الاحتجاج."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_523_right_0_9e812e50> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_523> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_523_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_523_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_523_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_523_para_3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_523_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_523_19750926_OpEnact_ec6173e033> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_523_obligation_0_75cfa6d4>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_523_obligation_1_57ffce22> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 523" ;
    dzdoc:position 528 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_517> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_517> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_523_condition_0_6255221e>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_523_condition_1_d6ea89b0> ;
    dzdoc:usesTerm dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_575> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_575" ;
    dzdoc:fullText "تأذن جمعية الشركاء بتخفيض رأسمال الشركة حسب الشروط المنصوص عليها لتعديل القانون الأساسي . ولا يجوز بأي حال من الأحوال أن يمس هذا التخفيض بمساواة الشركاء. إذا قررت الجمعية تخفيض رأس المال من دون أن يكون ذلك مبرر بخسائر ، فإن للدائنين الذين كان حقهم سابقا لتاريخ إيداع محضر المداولات بكتابة ضبط المحكمة، أن يرفعوا معارضة في هذا التخفيض في أجل شهر اعتبارا من يوم هذا الإيداع ويحكم القضاء برفض المعارضة أو يأمر إما بتسديد الديون أو بتكوين الضمانات إذا عرضتها الشركة وإذا اعتبرت كافية ولا يسوغ ابتداء عمليات تخفيض رأس المال أثناء أجل المعارضة. يحظر شراء حصصها الخاصة من قبل شركة غير أنه يجوز للجمعية التي قررت التخفيض من رأس المال من دون تبرير ذلك بخسائر ، أن تأذن للمدير بشراء عدد معين من الحصص لإبطالها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_575_permission_0_ba4b4444>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_575_permission_1_63604950> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_575_right_0_d64e1f63> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_575> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_575_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_575_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_575_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_575_19750926_OpEnact_905a3c5912> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_575_obligation_0_a1f21c36> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_575_prohibition_0_63604950> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "575" ;
    dzdoc:position 633 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_575_condition_0_6ce6d556>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_575_condition_1_0d69a9e3> ;
    dzdoc:usesTerm dzterm:partners_assembly .

<https://legal.dz/resource/order/1975-09-26/75-59#art_580> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_580" ;
    dzdoc:fullText "تصدر قرارات الشركاء في جمعيات يعقدونها . غیر أنه يسوغ أن يشترط في عقد التأسيس بأن تتخذ جميع القرارات أو بعضها باستشارة مكتوبة من طرف الشركاء . يستدعى الشركاء قبل خمسة عشر يوما على الأقل من انعقاد الجمعية بكتاب موصى عليه يتضمن بيان جدول الأعمال . يجوز لواحد أو عدة شركاء يمثلون على الأقل ربع رأسمال الشركة أن يطلبوا عقد جمعية . ويعتبر كل شرط مخالف لذلك كأن لم يكن. يسوغ لكل شريك أن يطلب من القضاء تعيين وكيل مكلف باستدعاء الشركاء للجمعية وتحديد جدول الأعمال ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_580_permission_0_83212418> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_580_right_0_ed63836b>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_580_right_1_c27c3c28>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_580_right_2_3cbdfc77> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_580> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_580_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_580_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_580_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_580_para_3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_580_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_580_19750926_OpEnact_3f2bf10953> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_580_obligation_0_7cc42c6f>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_580_obligation_1_ead29a23> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 580" ;
    dzdoc:position 638 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_615> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_615" ;
    dzdoc:fullText "لا يجوز للأجير المساهم في الشركة أن يعين قائما بالإدارة إلا إذا كان عقد عمله سابقا بسنة واحدة على الأقل لتعيينه ومطابقا لمنصب العمل الفعلي ، دون أن يضيع منفعة عقد العمل. ويعتبر كل تعيين مخالف لأحكام هذه الفقرة باطلا . ولا يؤدي هذا البطلان إلى إلغاء المداولات التي ساهم فيها القائم بالإدارة المعين بصورة مخالفة للقانون. في حالة الدمج ، يمكن أن يكون عقد العمل قد أبرم مع إحدى الشركات المدمجة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_615_permission_0_2f48fa8c>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_615_permission_1_d65aac81> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_615> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_615_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_615_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_615_19750926_OpEnact_b7afd84795> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_615_obligation_0_01cad15c> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_615_prohibition_0_2f48fa8c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "615" ;
    dzdoc:position 674 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_615_condition_0_ae86a781> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_670> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_670" ;
    dzdoc:fullText "تخضع كل اتفاقية تعقد بين شركة ما وأحد أعضاء مجلس المديرين أو مجلس مراقبة هذه الشركة إلى ترخيص مسبق من مجلس المراقبة . ويكون الأمر كذلك بخصوص الاتفاقيات التي تعقد بصورة غير مباشرة مع أحد الأشخاص المشار إليهم في المقطع السابق أو التي يتعامل فيها مع الشركة من خلال أشخاص وسطاء. وتخضع للترخيص المسبق أيضا الاتفاقيات التي تعقد بين شركة ومؤسسة إذا كان أحد أعضاء مجلس المديرين أو مجلس مراقبة الشركة مالكا أو شريكا أو مسيرا أو قائما بالإدارة أو مديرا عاما للمؤسسة. تعد كل اتفاقية تبرم دون مراعاة الشروط المذكورة أعلاه باطلة بطلانا مطلقا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_670> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_670_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_670_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_670_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_670_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_670_19750926_OpEnact_9ad5cdb6b9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_670_obligation_0_3543f45e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 670" ;
    dzdoc:position 729 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_670_condition_0_0207f8a3> ;
    dzdoc:usesTerm dzterm:management_board,
        dzterm:supervisory_board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_7> ;
    dzdoc:eId "art_715_bis_11" ;
    dzdoc:fullText "يجوز لمندوب الحسابات أن يطلب توضيحات من رئيس مجلس الإدارة أو مجلس المديرين الذي يتعين عليه أن يرد على كل الوقائع التي من شأنها أن تعرقل استمرار الاستغلال والتي اكتشفها أثناء ممارسة مهامه . وفي حالة انعدام الرد أو إذا كان هذا الرد ناقصا يطلب مندوب الحسابات من الرئيس أو مجلس المديرين استدعاء مجلس الإدارة أو مجلس المراقبة للمداولة في الوقائع الملاحظة ، ويتم استدعاء مندوب الحسابات في هذه الجلسة. وفي حالة عدم احترام هذه الأحكام، أو إذا لاحظ مندوب الحسابات أنه رغم اتخاذ هذه القرارات بقيت مواصلة الاستغلال معرقلة فإنه يقوم حينئذ بإعداد تقرير خاص يقدمه لأقرب جمعية عامة مقبلة أو لجمعية عامة غير عادية، في حالة الاستعجال ، يقوم هو نفسه باستدعائها لتقديم خلاصاته ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_11_permission_0_9c57ab61> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_11_right_0_710642f7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_11> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_11_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_11_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_11_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_11_19750926_OpEnact_480c3d6c41> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_11_obligation_0_43339b41>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_11_obligation_1_86536fd5>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_11_obligation_2_6e399b25> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 11" ;
    dzdoc:position 785 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_11_condition_0_075093c6>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_11_condition_1_72078ad5> ;
    dzdoc:usesTerm dzterm:auditor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_91> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_91" ;
    dzdoc:fullText "لا يجوز لأصحاب سندات الاستحقاق وممثلي الجماعة التدخل في تسيير شؤون الشركة . أنه يجوز لممثلي جماعة أصحاب سندات الاستحقاق حضور الجمعيات العامة للمساهمين بصفة غير استشارية . ولهم الحق في الإطلاع على وثائق الشركة حسب نفس الشروط المطبقة على المساهمين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_91_permission_0_8030570a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_91_permission_1_1f0403d2> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_91_right_0_3a4a6b9e>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_91_right_1_fb4a9f54> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_91> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_91_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_91_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_91_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_91_19750926_OpEnact_8b7ac9b32c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_91_obligation_0_4f0a0c0a> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_91_prohibition_0_8030570a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 91" ;
    dzdoc:position 865 ;
    dzdoc:usesTerm dzterm:bondholders .

<https://legal.dz/resource/order/1975-09-26/75-59#art_756> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_756" ;
    dzdoc:fullText "تصبح الشركة مدينة لدائني الشركة المدمجة في محل ومكان تلك دون أن يترتب على هذا الحلول تجديد بالنسبة لهم . ويجوز لدائني الشركة الذين شاركوا في عملية الإدماج وكان دينهم سابقا لنشر مشروع الإدماج، أن يقدموا معارضة ضد هذه الأخيرة في أجل 30 يوما ابتداء من النشر المنصوص عليه في المادة 748 . ويتخذ بعد ذلك قرار قضائي إما برفض المعارضة أو يلغى الأمر إما بتسديد الديون، وإما بإنشاء ضمانات تقدمها الشركة الماصة بشرط أن تكون هذه الضمانات كافية. ولا يحتج بالإدماج على هذا الدائن إذا لم تسدد الديون أو لم تنشأ الضمانات التي أمر بتقديمها. على أن المعارضة المقدمة من دائن واحد لا يكون لها أي تأثير على متابعة عمليات الإدماج. كما لا تعترض أحكام هذه المادة بالنسبة لتطبيق الاتفاقيات التي ترخص للدائن باشتراط التسديد العاجل لدينه في حالة إدماج الشركة المدينة بشركة أخرى."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_756_right_0_4e7a5a55> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_756> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_756_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_756_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_756_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_756_para_3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_756_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_756_19750926_OpEnact_1dbe43f4ef> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_756_obligation_0_9c9912ef> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 756" ;
    dzdoc:position 963 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_748> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_748> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_767> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_767" ;
    dzdoc:fullText "ينشر أمر تعيين المصفين مهما كان شكله في أجل شهر في النشرة الرسمية للإعلانات القانونية وفضلا عن ذلك في جريدة مختصة بالإعلانات القانونية للولاية التي يوجد بها مقر الشركة . ويتضمن هذا الأمر البيانات الآتية : عنوان الشركة أو اسمها متبوعا عند الاقتضاء بمختصر اسم الشركة، نوع الشركة متبوعا بإشارة \" في حالة تصفية \"، مبلغ رأس المال عنوان مركز الشركة رقم قيد الشركة في السجل التجاري، سبب التصفية، اسم المصفين ولقبهم وموطنهم، حدود صلاحياتهم عند الاقتضاء. كما يذكر في نفس النشر بالإضافة إلى ما تقدم تعيين المكان الذي توجه إليه المراسلات والمكان الخاص بالعقود والوثائق المتعلقة بالتصفية، المحكمة التي يتم في كتابتها إيداع العقود والأوراق المتصلة بالتصفية بملحق السجل التجاري. وتبلغ نفس البيانات بواسطة رسالة عادية إلى علم المساهمين بطلب من المصفي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_767> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_767_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_767_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_767_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_767_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_767_19750926_OpEnact_090f9826a9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_767_obligation_0_c7c29765>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_767_obligation_1_53d42dea> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "767" ;
    dzdoc:position 974 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_98> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_98" ;
    dzdoc:fullText "يجب على البائع أو الدائن المرتهن أن يقدم عند إجراء قيد امتياز إلى مأموري السجل التجاري إما بأنفسهم أو بواسطة الغير نسخة من النسخ الأصلية لعقد البيع أو سند منشئ للرهن الحيازي أو نسخة منه إن كان الأصل موجودا . ويحتفظ بعقد البيع أو الرهن الحيازي في المركز الوطني للسجل التجاري. ويرفق به جدولان محرران علی ورقة غير مدموغة يحدد شكلها بقرار من وزير العدل، حامل الأختام ، ويتضمنان ما يلي : 1 - اسم البائع والمشتري أو الدائن ومالك المحل التجاري إن كان أجنبيا عنهما مع ذكر ألقابهم وعناوينهم ومهنتهم إن كانت لهم مهنة، 2 - تاريخ السند ونوعه، 3 - أثمان البيع على وجه التفصيل بالنسبة للمعدات والبضائع والعناصر المعنوية للمحل التجاري، مع الإشارة كذلك إلى الأعباء المالية المترتبة عليه بعد تقديرها إذا كان لها محل أو مبلغ الدين المحدد في السند والشروط المتعلقة بالاستحقاق، 4 - تعيين المحل التجاري والفروع التابعة له إن كان لها محل مع البيان الدقيق للعناصر التي يتكون منها والتي يشملها البيع أو الرهن الحيازي مع ذكر نوع العمليات التي يباشرها المحل وفروعه والمكان الذي به مركز كل منها، دون الإخلال بجميع الإرشادات التي من شأنها التعريف بها، وإذا كان البيع أو الرهن الحيازي يتناول عناصر أخرى غير عنوان المحل والاسم التجاري والحق في الإجارة والزبائن فيجب ذكرها بالتفصيل. 5 - اختيار محل الإقامة للبائع أو الدائن المرتهن في دائرة اختصاص المحكمة التي يقع فيها المحل التجاري."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_98> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_98_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_98_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_98_19750926_OpEnact_8cc5d199b0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_98_obligation_0_983cb53d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "98" ;
    dzdoc:position 100 ;
    dzdoc:usesTerm dzterm:minister_of_justice,
        dzterm:mortgagee,
        dzterm:seller .

