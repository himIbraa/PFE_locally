<https://legal.dz/resource/order/1975-09-26/75-59#version_art_112> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا اشترط البائع عند البيع فسخ العقد من تلقاء نفسه لعدم دفع الثمن في الأجل المتفق عليه أو إذا تراضى البائع و المشتري على فسخ البيع وجب على البائع إبلاغ الدائنين المقيدين بواسطة إجراء غير قضائي وفي محلات إقامتهم المختارة بالفسخ الحاصل أو المتفق عليه ولا يصبح هذا الفسخ نهائيا إلا بعد مضي شهر من تاريخ التبليغ الحاصل على الشكل المذكور. ويجب أن يتضمن التبليغ ذكر هذه المهلة تحت طائلة البطلان ."@ar ;
