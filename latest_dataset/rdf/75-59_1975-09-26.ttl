<https://legal.dz/resource/order/1975-09-26/75-59#version_art_181> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز كذلك للمالك أن يؤخر تجديد الإيجار لمدة أقصاها ثلاث سنوات ، إذا كانت نيته تتجه إلى الارتفاع بالعمارة وأن هذا الارتفاع يتطلب طرد المستأجر مؤقتا . فيحق لهذا الأخير في هذه الحالة، الحصول على تعويض يساوي الضرر اللاحق به دون أن يزيد هذا التعويض عن بدل إيجار ثلاث سنوات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_181_19750926_OpEnact_9f9c2d2567> ;
    dzdoc:replacementText "يجوز كذلك للمالك أن يؤخر تجديد الإيجار لمدة أقصاها ثلاث سنوات ، إذا كانت نيته تتجه إلى الارتفاع بالعمارة وأن هذا الارتفاع يتطلب طرد المستأجر مؤقتا . فيحق لهذا الأخير في هذه الحالة، الحصول على تعويض يساوي الضرر اللاحق به دون أن يزيد هذا التعويض عن بدل إيجار ثلاث سنوات ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
