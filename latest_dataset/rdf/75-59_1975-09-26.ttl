<https://legal.dz/resource/order/1975-09-26/75-59#version_art_101> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسلم مأمورو السجل التجاري للطالب نسخة من السند مع أحد الجدولين المنصوص عليهما في المادة 98 بعد التأشير عليهما، إثر استلامهما بما يفيد القيد المتضمن تاريخه والرقم الذي تم بموجبه، ويحتفظ بالمركز الوطني للسجل التجاري بالجدول الباقي المتضمن لنفس البيانات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_101_19750926_OpEnact_d2025349bc> ;
    dzdoc:replacementText "يسلم مأمورو السجل التجاري للطالب نسخة من السند مع أحد الجدولين المنصوص عليهما في المادة 98 بعد التأشير عليهما، إثر استلامهما بما يفيد القيد المتضمن تاريخه والرقم الذي تم بموجبه، ويحتفظ بالمركز الوطني للسجل التجاري بالجدول الباقي المتضمن لنفس البيانات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_101> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
