<https://legal.dz/resource/order/1975-09-26/75-59#version_art_335> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يبقى الرهن العقاري لجماعة الدائنين لسداد حصص المصالحة. وتنحصر آثار قيد الرهن العقاري في مبلغ تقدره المحكمة في حكم التصديق. وللمندوب المكلف بتنفيذ المصالحة الأهلية في منح رفع اليد عن القيد المتخذ تنفيذا للفقرة السابقة."@ar ;
