<https://legal.dz/resource/order/1975-09-26/75-59#version_art_513> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن ل المسحوب عليه أن يوفي شيكا محتويا على تسطير عام إلا ل مصرف معين أو لرئيس مكتب الصكوك البريدية أو لأحد عملاء المسحوب عليه . ولا يمكن ل المسحوب عليه أن يوفي شيكا محتويا على تسطير خاص إلا إلى مصرف معين، أو إلى عميله إذا كان هذا المصرف هو مسحوب عليه على أن المصرف المعين يمكنه أن يسعى لدى مصرف آخر لقبض قيمة الشيك. ولا يجوز ل مصرف أن يحصل على شيك مسطر إلا من أحد عملائه أو مصلحة الصكوك البريدية أو من مصرف آخر و لا يجوز له أن يقبض قيمته لحساب أشخاص آخرين غيرهم . إذا كان الشيك يحتوي على عدة تسطي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_513_19750926_OpEnact_52bcd0c182> ;
    dzdoc:replacementText "لا يمكن ل المسحوب عليه أن يوفي شيكا محتويا على تسطير عام إلا ل مصرف معين أو لرئيس مكتب الصكوك البريدية أو لأحد عملاء المسحوب عليه . ولا يمكن ل المسحوب عليه أن يوفي شيكا محتويا على تسطير خاص إلا إلى مصرف معين، أو إلى عميله إذا كان هذا المصرف هو مسحوب عليه على أن المصرف المعين يمكنه أن يسعى لدى مصرف آخر لقبض قيمة الشيك. ولا يجوز ل مصرف أن يحصل على شيك مسطر إلا من أحد عملائه أو مصلحة الصكوك البريدية أو من مصرف آخر و لا يجوز له أن يقبض قيمته لحساب أشخاص آخرين غيرهم . إذا كان الشيك يحتوي على عدة تسطيرات خاصة فلا يمكن ل المسحوب عليه وفاؤه إلا في حالة وجود تسطرين ويكون أحدهما لتحصيل قيمته بواسطة غرف المقاصة . وإذا أهمل المسحوب عليه أو المصرف مراعاة الأحكام المتقدمة فإنه يكون مسؤولا عن الضرر بما يعادل مبلغ الشيك ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_513> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_513> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

