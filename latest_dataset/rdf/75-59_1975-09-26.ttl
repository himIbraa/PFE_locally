    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_11> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_11> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:versionText "سند النقل المتضمن شرط \"الأمر\" قابل للتحويل عن طريق التظهير من الشخص الذي صدر لأمره ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_12_19750926_OpEnact_b44c3e8b7d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_12> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_12> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_12> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:versionText "سند النقل الصادر \" للحامل \" قابل للتحويل عن طريق التظهير على بياض حسب الشروط المنصوص عليها في المواد من 396 إلى 402 من هذا القانون ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_13_19750926_OpEnact_3cc0d8022c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
