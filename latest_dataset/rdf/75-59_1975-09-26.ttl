<https://legal.dz/resource/order/1975-09-26/75-59#version_art_206> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز أن تلغى أو تخفض المهلة المنصوص عليها في المادة 205 بموجب أمر من رئيس المحكمة، بناء على مجرد طلب من المعني بالأمر وبعد الاستماع إلى النيابة العامة ، وخاصة إذا أثبت هذا الأخير، بأنه يتعذر عليه أن يستغل متجره شخصيا أو بواسطة مندوبين عنه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_206_19750926_OpEnact_1e13c1145a> ;
    dzdoc:replacementText "يجوز أن تلغى أو تخفض المهلة المنصوص عليها في المادة 205 بموجب أمر من رئيس المحكمة، بناء على مجرد طلب من المعني بالأمر وبعد الاستماع إلى النيابة العامة ، وخاصة إذا أثبت هذا الأخير، بأنه يتعذر عليه أن يستغل متجره شخصيا أو بواسطة مندوبين عنه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
