<https://legal.dz/resource/order/1975-09-26/75-59#art_719_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_719> ;
    dzdoc:position 1 ;
    dzdoc:text "وتستهلك مصاريف زيادة رأس المال على الأكثر عند انقضاء السنة المالية الخامسة والتالية للسنة المالية التي صرفت خلالها. ويسوغ خصم هذه المصاريف من مبلغ علاوات الإصدار المتعلقة بهذه الزيادة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_71_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_71> ;
    dzdoc:position 0 ;
    dzdoc:text "يعد باطلا كل اشتراط بإعفاء الوكيل بالعمولة كليا أو جزئيا من مسؤوليته عن الأضرار البدنية الحاصلة للمسافر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_721_condition_0_650be572> a dznorm:Condition ;
    dznorm:conditionText "ويصبح اقتطاع هذا الجزء غير إلزامي إذا بلغ الاحتياطي عشر رأس المال."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_721> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_721_obligation_0_a0a31cd3> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_721_obligation_0_a0a31cd3_role_48d2a7f795> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_721> ;
    dznorm:position 0 ;
    dznorm:provisionText "في الشركات ذات المسؤولية المحدودة والشركات المساهمة يقتطع من الأرباح سندات نصف العشر على الأقل وتطرح منها عند الاقتضاء الخسائر السابقة، ويخصص هذا الاقتطاع لتكوين مال احتياطي يدعى { احتياطي قانوني } وذلك تحت طائلة بطلان كل مداولة مخالفة."@ar ;
    dznorm:sourceArticle "art_721" .

