<https://legal.dz/resource/order/1975-09-26/75-59#art_596_obligation_0_5ff649e2_role_2a138da09d> a dznorm:Role ;
    rdfs:label "الأقل من قيمتها الاسمية"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يجب أن يكتتب رأس المال بكامله، وتكون الأسهم النقدية مدفوعة عند الاكتتاب بنسبة الربع (4/1) على الأقل من قيمتها الاسمية"@ar ;
