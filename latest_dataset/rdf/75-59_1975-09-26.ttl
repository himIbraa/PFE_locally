    dznorm:provisionText "حق التصويت المرتبط بالسهم إلى المنتفع في الجمعيات العامة العادية، ولمالك الرقبة في الجمعيات العامة غير العادية"@ar ;
    dznorm:sourceArticle "art_679" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_679_right_1_73b13ba8> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
