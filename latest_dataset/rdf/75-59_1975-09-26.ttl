    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_788_obligation_0_2bd00b74_action_aa82a9ee98> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_788> ;
