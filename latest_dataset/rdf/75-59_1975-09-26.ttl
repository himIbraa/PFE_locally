<https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمثل الوصل إيصال البضاعة وهو قابل للتحويل عن طريق التظهير. ويحتوي على اسم الشخص الطبيعي أو المعنوي المعني أو اسم شركته، مهنته أو غرض شركته، مقر سكناه أو عنوان شركته وطبيعة المواد المودعة والبيانات الخاصة التي تسمح بالتعرف على البضاعة وقيمتها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_1_19750926_OpEnact_d3baf54304> ;
    dzdoc:replacementText "يمثل الوصل إيصال البضاعة وهو قابل للتحويل عن طريق التظهير. ويحتوي على اسم الشخص الطبيعي أو المعنوي المعني أو اسم شركته، مهنته أو غرض شركته، مقر سكناه أو عنوان شركته وطبيعة المواد المودعة والبيانات الخاصة التي تسمح بالتعرف على البضاعة وقيمتها."@ar ;
