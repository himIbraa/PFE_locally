    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز أن تكون السفتجة محررة لأمر الساحب نفسه. ويمكن أن تكون مسحوبة على الساحب نفسه، كما يمكن أن تكون مسحوبة لحساب شخص من الغير. ويمكن أن يشترط بها الدفع في موطن شخص من الغير إما في المنطقة التي يقع فيها أو في موطن المسحوب عليه أو في منطقة أخرى."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_391_19750926_OpEnact_ecbb93413f> ;
    dzdoc:replacementText "يجوز أن تكون السفتجة محررة لأمر الساحب نفسه. ويمكن أن تكون مسحوبة على الساحب نفسه، كما يمكن أن تكون مسحوبة لحساب شخص من الغير. ويمكن أن يشترط بها الدفع في موطن شخص من الغير إما في المنطقة التي يقع فيها أو في موطن المسحوب عليه أو في منطقة أخرى."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_391> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_391> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
