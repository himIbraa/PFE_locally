<https://legal.dz/resource/order/1975-09-26/75-59#art_124_condition_0_d4054a73> a dznorm:Condition ;
    dznorm:conditionText "إذا أقام البائع دعوى بفسخ عقد إيجار المحل الذي يستغل فيه محل تجاري مثقل بقيود مرسمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_124> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_124_obligation_0_abcf2ca3> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_124> ;
    dznorm:position 0 ;
    dznorm:provisionText "وجب عليه إبلاغ الدائنين السابقين المقيدين سابقا بطلب الفسخ وذلك في المحل المختار والمعين في قيد كل منهم"@ar ;
    dznorm:sourceArticle "art_124" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_124_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_124> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا أقام البائع دعوى بفسخ عقد إيجار المحل الذي يستغل فيه محل تجاري مثقل بقيود مرسمة، وجب عليه إبلاغ الدائنين السابقين المقيدين سابقا بطلب الفسخ وذلك في المحل المختار والمعين في قيد كل منهم، ولا يجوز أن يصدر الحكم قبل شهر من تاريخ هذا التبليغ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_124_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_124> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا يصبح فسخ الإيجار بالتراضي نهائيا إلا بعد شهر من تاريخ التبليغ الحاصل للدائنين المقيدين في المحل المختار لكل منهم. وفي هذه المدة يجوز لكل دائن مقيد أن يطلب بيع المحل التجاري بالمزاد العلني على حسب الأوضاع المقررة بالمادة 127."@ar .

