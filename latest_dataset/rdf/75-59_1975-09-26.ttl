    dzdoc:position 1058 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_87" ;
    dzdoc:fullText "يجري المزاد بزيارة السدس بنفس الشروط والمهل المقررة للبيع الذي طرأ عليه هذا المزاد بالزيادة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_87> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_87_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
