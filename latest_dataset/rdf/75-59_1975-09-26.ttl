    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_86> ;
    dznorm:position 0 ;
    dznorm:provisionText "فيتعين عليها قبل افتتاح الاكتتاب، القيام بإجراءات إشهار شروط الإصدار"@ar ;
    dznorm:sourceArticle "art_715_bis_86" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_86_para_0> a dzdoc:Paragraph ;
