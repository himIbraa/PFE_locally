<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_56_condition_0_05fdacdd> a dznorm:Condition ;
    dznorm:conditionText "إذا وقع اشتراط الموافقة في القانون الأساسي للشركة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_56> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_56_obligation_0_9bb1656d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_56> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتعين إبلاغ الشركة بطلب الاعتماد عن طريق رسالة موصى عليها مع وصل الاستلام يرسلها المساهم مع ذكر اسم المحال إليه ولقبه وعنوانه وعدد الأسهم المقرر إحالتها والثمن المعروض"@ar ;
    dznorm:sourceArticle "art_715_bis_56" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_56_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_56> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا وقع اشتراط الموافقة في القانون الأساسي للشركة، يتعين إبلاغ الشركة بطلب الاعتماد عن طريق رسالة موصى عليها مع وصل الاستلام يرسلها المساهم مع ذكر اسم المحال إليه ولقبه وعنوانه وعدد الأسهم المقرر إحالتها والثمن المعروض، وتنتج الموافقة سواء من تبليغ طلب الاعتماد أو من عدم الجواب في أجل شهرين اعتبارا من تاريخ الطلب."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_57_condition_0_0ac87415> a dznorm:Condition ;
    dznorm:conditionText "وإذا لم تقبل الشركة المحال إليها المقترح"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_57> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_57_condition_1_27272dcd> a dznorm:Condition ;
    dznorm:conditionText "وإذا لم يتحقق الشراء عند انقضاء الأجل المنصوص عليه في المقطع أعلاه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_57> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_57_condition_2_66a08b3c> a dznorm:Condition ;
