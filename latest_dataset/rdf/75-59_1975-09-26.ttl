<https://legal.dz/resource/order/1975-09-26/75-59#version_art_799_bis_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "أعضاء التجمع ملزمون بتسديد ديونه وذلك من ثروتهم الخاصة . وهم متضامنون إلا إذا وجد اتفاق مخالف مع المتعاقدين الآخرين. لا يجوز لدائني التجمع متابعة تسديد الديون ضد عضو من الأعضاء إلا إذا تم توجيه إنذار للتجمع عن طريق وثيقة غير قضائية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
