    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_24> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2> ;
    dzdoc:position 1 ;
    dzdoc:text "ويحتوي على نفس بيانات الوصل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2> ;
    dzdoc:position 2 ;
    dzdoc:text "يمكن حائز السند ، في أي وقت أن يفصل سند الخزن ويحوله لإذن حامل. وتشكل البضاعة المودعة حينئذ، ضمان تسديد المبلغ المقترض عند الاستحقاق."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2> ;
    dzdoc:position 3 ;
    dzdoc:text "سند الخزن هو سند قابل للتظهير بنفس شروط السندات التجارية الأخرى."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2_permission_0_1d19d9c5> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2_permission_0_1d19d9c5_role_f1e34ad952> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2> ;
    dznorm:position 0 ;
    dznorm:provisionText "سند الخزن هو سند يسمح للمودع بالاقتراض على قيمة البضائع المودعة بالمخزن العام."@ar ;
    dznorm:sourceArticle "art_543_bis_2" .

