<https://legal.dz/resource/order/1975-09-26/75-59#art_54> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_2> ;
    dzdoc:eId "art_54" ;
    dzdoc:fullText "يكون الطالب ملزم تحت مسؤوليته بأن يوجه الدعوة لحضور هذه الخبرة بواسطة رسالة موصى عليها أو برقية ، ويمكن إدخال جميع الأطراف في الدعوى وخاصة المرسل و المرسل إليه و الناقل و الوكيل بالعمولة . على أنه يمكن الإعفاء من إتمام الإجراءات المقررة بهذه الفقرة كليا أو جزئيا بترخيص صريح ينص عليه في الأمر المذكور. ويمكن الأمر بإيداع الأشياء المتنازع فيها أو حجزها ثم نقلها إلى مستودع عمومي. ويحوز الأمر ببيعها تسديدا لنفقات النقل وغيرها من النفقات التي سبق ،صرفها، ويقرر الحاكم منح ثمن المبيع لمن قام بتسبيق تلك المصاريف من الأطراف."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_54_permission_0_f79c67cf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_54> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_54_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_54_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_54_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_54_19750926_OpEnact_1f7ad07b5e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_54_obligation_0_7d151005> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "54" ;
    dzdoc:position 56 ;
    dzdoc:usesTerm dzterm:طالب,
        dzterm:مرسل,
        dzterm:مرسل_إليه,
        dzterm:ناقل,
        dzterm:وكيل_بالعمولة .

<https://legal.dz/resource/order/1975-09-26/75-59#art_558> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_558" ;
    dzdoc:fullText "للشركاء غير المديرين الحق في أن يطلعوا بأنفسهم مرتين في السنة في مركز الشركة على سجلات التجارة والحسابات والعقود والفواتير والمراسلات والمحاضر وبوجه العموم على كل وثيقة موضوعة من الشركة أو مستلمة منها . ويتبع حق الإطلاع الحق في أخذ النسخ . يمكن للشريك أثناء ممارسة حقوقه أن يستعين بخبير معتمد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_558_permission_0_eddc4420> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_558_right_0_93e9719a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_558_right_1_ed49b042>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_558_right_2_f822a5e3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_558> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_558_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_558_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_558_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_558_19750926_OpEnact_12e5a79efa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "558" ;
    dzdoc:position 605 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_630> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_630" ;
    dzdoc:fullText "مع عدم الإخلال بمسؤولية القائم بالإدارة أو المدير العام المعني بالأمر، فإن الاتفاقيات المشار إليها في المادة 628 ، المقاطع 2 و 3 و 4 والمبرمة دون الإذن المسبق من مجلس الإدارة، يجوز أن تلغى إذا كانت لها عواقب ضارة بالشركة . وتتقادم دعوى البطلان بمرور ثلاث سنوات ابتداء من تاريخ الاتفاقية، غير أنه في حالة إخفاء الاتفاقية، فإن مدة التقادم تؤجل إلى اليوم الذي تم فيه كشف هذه الاتفاقية. يمكن أن يغطى البطلان بتصويت من الجمعية العامة بناء على تقرير خاص من مندوبي الحسابات الذين يعرضون فيه الظروف التي أدت إلى عدم إتباع إجراء الإذن، وتطبق أحكام المادة 628 المقطع 7 منها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_630_permission_0_ec140ce8>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_630_permission_1_75cfefb7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_630> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_630_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_630_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_630_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_630_19750926_OpEnact_a5a95aba56> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "630" ;
    dzdoc:position 689 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_628> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_628> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_630_condition_0_1f57d08e> ;
    dzdoc:usesTerm dzterm:auditor,
        dzterm:general_assembly,
        dzterm:general_director,
        dzterm:manager .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_120> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_6> ;
    dzdoc:eId "art_715_bis_120" ;
    dzdoc:fullText "يحظر على الشركة تحت طائلة أحكام المادة 827 أدناه، استهلاك رأسمالها أو تخفيضه عن طريق التسديد . كما يحظر عليها تغيير توزيع الأرباح ابتداء من تاريخ تصويت الجمعية العامة التي ترخص الإصدار وما دامت سندات الاستحقاق القابلة للتحويل إلى أسهم، متوفرة . وفي حالة تخفيض رأس المال بسبب الخسائر أو التقليص إما في المبلغ الاسمي للأسهم وإما في عددها ، تخفض تبعا لذلك حقوق أصحاب سندات الاستحقاق الذين يختارون تحويل سنداتهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_120> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_120_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_120_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_120_19750926_OpEnact_084e0dfb9a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_120_obligation_0_6e28dc42>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_120_obligation_1_44c4d937>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_120_obligation_2_c19efaa1> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_120_prohibition_0_c4ed9066> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 120" ;
    dzdoc:position 894 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_827> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_827> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_120_condition_0_d5d3e8c9> ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_55> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_55" ;
    dzdoc:fullText "يجوز عرض إحالة الأسهم للغير بأي وجه كان على الشركة للموافقة بموجب شرط من شروط القانون الأساسي ، مهما تكن طريقة النقل، ما عدا حالة الإرث أو الإحالة سواء لزوج أو أصل أو فرع . ولا يمكن النص على هذا الشرط إلا إذا اكتست هذه الأسهم بصفة استثنائية الشكل الاسمي بموجب القانون أو القانون الأساسي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_55_permission_0_3a9382f5>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_55_permission_1_9eed4518> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_55_right_0_1f16d9ac> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_55> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_55_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_55_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_55_19750926_OpEnact_372eb18e81> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_55_obligation_0_548c88ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 55" ;
    dzdoc:position 829 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_55_condition_0_16a8b421> ;
    dzdoc:usesTerm dzterm:shares .

<https://legal.dz/resource/order/1975-09-26/75-59#art_716> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_716" ;
    dzdoc:fullText "عند قفل كل سنة مالية، يضع مجلس الإدارة أو القائمون بالإدارة، جردا بمختلف عناصر الأصول والديون الموجودة في ذلك التاريخ. ويضعون أيضا حساب الاستغلال العام وحساب النتائج والميزانية. ويضعون تقريرا مكتوبا عن حالة الشركة ونشاطها أثناء السنة المالية المنصرمة. وتوضع المستندات المشار إليها في هذه المادة تحت تصرف مندوبي الحسابات خلال الأربعة أشهر على الأكثر والتالية لقفل السنة المالية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_716> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_716_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_716_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_716_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_716_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_716_19750926_OpEnact_f3baefd340> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_716_obligation_0_5b2a1d13>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_716_obligation_1_b01b2701>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_716_obligation_2_dbe60e5f>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_716_obligation_3_723b1c2f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "716" ;
    dzdoc:position 918 ;
    dzdoc:usesTerm dzterm:auditors,
        dzterm:board_of_directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_778> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_778" ;
    dzdoc:fullText "في حالة انعدام الشروط المدرجة في القانون الأساسي أو الاتفاق الصريح بين الأطراف ، تقع تصفية الشركة المنحلة طبقا لأحكام هذه الفقرة وذلك من دون الإخلال بتطبيق الفقرة الأولى من هذا القسم. كما أنه يمكن الحكم بأمر مستعجل بأن هذه التصفية تقع بنفس الشروط المشار إليها أعلاه بناء على طلب من: 1 - أغلبية الشركاء في شركات التضامن، 2 - الشركاء الممثلين لعشر رأس المال على الأقل في الشركات ذات المسؤولية المحدودة والشركات المساهمة، 3- دائني الشركة. وتعتبر في هذه الحالة أحكام القانون الأساسي المخالف لهذا القسم كأنها لم تكن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_778_permission_0_9563141c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_778> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_778_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_778_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_778_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_778_19750926_OpEnact_e8f011b214> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "778" ;
    dzdoc:position 985 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_778_condition_0_bca35555> ;
    dzdoc:usesTerm dzterm:liquidation .

<https://legal.dz/resource/order/1975-09-26/75-59#art_796> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:تجمع ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_5> ;
    dzdoc:eId "art_796" ;
    dzdoc:fullText "يجوز لشخصين معنويين أو أكثر أن يؤسسوا فيما بينهم كتابيا، ولفترة محدودة تجمعا لتطبيق كل الوسائل الملاءمة لتسهيل النشاط الاقتصادي لأعضائها أو تطويره وتحسين نتائج هذا النشاط وتنميته ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_796_permission_0_1821d6f9> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_796_right_0_f913bc66> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_796> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_796_defocc_ceff56f44fcb> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_796_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_796_19750926_OpEnact_2a7d27a822> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 796" ;
    dzdoc:position 1008 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_839> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_839" ;
    dzdoc:fullText "تطبق العقوبات المنصوص عليها في المادة السابقة في حالة ما إذا طرأت تصفية شركة طبقا لأحكام المواد من 778 إلى 794 على المصفي الذي: 1- لم يقدم عمدا في الستة الأشهر التي تلي تعيينه تقريرا عن وضعية الأصول والخصوم وعن متابعة عمليات التصفية دون أن يطلب الرخص اللازمة لإنهاء تلك العمليات، 2- لم يضع عمدا في الثلاثة الأشهر التي تلي اختتام السنة المالية، الجرد وحساب الاستغلال العام وحساب النتائج وتقريرا مكتوبا يتضمن بيان عمليات التصفية للسنة المالية المنصرمة، 3- لم يمكن الشركاء من القيام خلال مدة التصفية من ممارسة حقهم في الإطلاع على مستندات الشركة حسب نفس الشروط المنوه عنها سابقا، 4- لم يستدع على الأقل مرة واحدة في السنة الشركاء ليطلعهم على الحسابات السنوية في حالة استمرار الاستغلال، 5- استمر في ممارسة وظائفه بعد انتهاء توكيله دون أن يطلب التجديد، 6- لم يودع في حساب جار لدى بنك باسم الشركة التي تجري تصفيتها في أجل خمسة عشر يوما ابتداء من يوم قرار التوزيع - الأموال المخصصة لتوزيعها بين الشركاء والدائنين ولم يودع بمصلحة الودائع والأمانات في أجل سنة واحدة ابتداء من اختتام التصفية، الأموال المخصصة للدائنين أو الشركاء والتي لم يسبق لهم أن طلبوها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_839_permission_0_09b19feb> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_839_right_0_a002859e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_839> ;
