<https://legal.dz/resource/order/1975-09-26/75-59#version_art_749> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقرر الإدماج من طرف الجمعية العامة الاستثنائية للشركات المدمجة والمستوعبة. إن رأسمال الشركات المستوعبة أو المدمجة يؤول إلى الشركة المدمجة أو الشركة الجديدة الناتجة عن الإدماج في الحالة التي تكون عليها في تاريخ العملية النهائية. ويؤول رأسمال الشركة المنفصلة حسب نفس الشروط، ويقع توزيع بين الشركات المدمجة أو الشركات الجديدة الناتجة عن الانفصال حسب الشروط المقررة بمشروع الانفصال."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_749_19750926_OpEnact_e12075597d> ;
    dzdoc:replacementText "يقرر الإدماج من طرف الجمعية العامة الاستثنائية للشركات المدمجة والمستوعبة. إن رأسمال الشركات المستوعبة أو المدمجة يؤول إلى الشركة المدمجة أو الشركة الجديدة الناتجة عن الإدماج في الحالة التي تكون عليها في تاريخ العملية النهائية. ويؤول رأسمال الشركة المنفصلة حسب نفس الشروط، ويقع توزيع بين الشركات المدمجة أو الشركات الجديدة الناتجة عن الانفصال حسب الشروط المقررة بمشروع الانفصال."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_749> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
