<https://legal.dz/resource/order/1975-09-26/75-59#version_art_648> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتمتع مجلس المديرين بالسلطات الواسعة للتصرف باسم الشركة في كل الظروف. ويمارس هذه السلطات في حدود موضوع الشركة مع مراعاة السلطات التي يخولها القانون صراحة لمجلس المراقبة وجمعيات المساهمين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_648_19750926_OpEnact_64fbd9dab7> ;
    dzdoc:replacementText "يتمتع مجلس المديرين بالسلطات الواسعة للتصرف باسم الشركة في كل الظروف. ويمارس هذه السلطات في حدود موضوع الشركة مع مراعاة السلطات التي يخولها القانون صراحة لمجلس المراقبة وجمعيات المساهمين."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_648> ;
