<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_14> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون مندوبو الحسابات مسؤولون، سواء إزاء الشركة أو إزاء الغير، عن الأضرار الناجمة عن الأخطاء واللامبالاة التي يكونون قد ارتكبوها في ممارسة وظائفهم . ولا يكونون مسؤولين مدنيا عن المخالفات التي يرتكبها القائمون بالإدارة أو أعضاء مجلس المديرين، حسب الحالة، إلا إذا لم يكشفوا عنها في تقريرهم للجمعية العامة و/أو لوكيل الجمهورية رغم إطلاعهم عليها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_14_19750926_OpEnact_ab0a9c203f> ;
    dzdoc:replacementText "يكون مندوبو الحسابات مسؤولون، سواء إزاء الشركة أو إزاء الغير، عن الأضرار الناجمة عن الأخطاء واللامبالاة التي يكونون قد ارتكبوها في ممارسة وظائفهم . ولا يكونون مسؤولين مدنيا عن المخالفات التي يرتكبها القائمون بالإدارة أو أعضاء مجلس المديرين، حسب الحالة، إلا إذا لم يكشفوا عنها في تقريرهم للجمعية العامة و/أو لوكيل الجمهورية رغم إطلاعهم عليها ."@ar ;
