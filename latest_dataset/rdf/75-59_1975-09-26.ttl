<https://legal.dz/resource/order/1975-09-26/75-59#art_141> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_4> ;
    dzdoc:eId "art_141" ;
    dzdoc:fullText "يجب على المشتري في هذه الحالة أن يلتزم بناء على إنذار أي دائن، وعند انقضاء مهلة خمسة عشر يوما من تاريخ تبليغ الإنذار ، أن يودع في كتابة المحكمة المختصة، نظيرا من إثبات التأمين والمعارضات المبلغة له وكشفا بالقيود الواردة على المحل التجاري ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_141> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_141_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_141_19750926_OpEnact_7e92010416> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_141_obligation_0_30078479> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "141" ;
    dzdoc:position 143 ;
    dzdoc:usesTerm dzterm:commercial_establishment .

<https://legal.dz/resource/order/1975-09-26/75-59#art_167> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_8> ;
    dzdoc:eId "art_167" ;
    dzdoc:fullText "تطبق العقوبات المنصوص عليها في المادة 376 من قانون العقوبات على كل مشتر أو كل حائز للأموال المرهونة حيازيا ، وفقا لهذا القانون، يقدم على إتلافها أو محاولة إتلافها أو يختلسها أو يحاول اختلاسها أو يفسدها أو يحاول إفسادها بأي طريقة كانت بغرض تعطيل حقوق الدائن . تطبق نفس العقوبات على كل من يقوم بأي محاولة للغش تهدف إلى حرمان الدائن من حقه في الامتياز الذي له على الأموال المثقلة بالدين أو إلى تنقيصه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_167_right_0_9501e000>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_167_right_1_e1207c43> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_167> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_167_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_167_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_167_19750926_OpEnact_633b224c31> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 167" ;
    dzdoc:position 169 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_167_extref_0df913b1> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:encumbered_assets,
        dzterm:mortgaged_assets,
        dzterm:sanctions .

<https://legal.dz/resource/order/1975-09-26/75-59#art_170> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_170" ;
    dzdoc:fullText "تطبق هذه الأحكام كذلك على : 1 - الإيجارات الممنوحة للبلديات بالنسبة للعمارات أو المحلات المخصصة لمصالح تسيير الاستغلال البلدي، إما عند الإيجار أو بعده، وبالموافقة الصريحة أو الضمنية من المالك، 2 - إيجار العمارات أو المحلات الرئيسية أو الملحقة والضرورية لمواصلة نشاط المؤسسات العمومية الاقتصادية في حدود القوانين والأنظمة التي تسودها، شريطة ألا يكون لهذا الإيجار أي تأثير على الملك العمومي ، 3 - كما تطبق هذه الأحكام أيضا مع مراعاة أحكام المادتين 185 و 186 التاليتين على إيجار المحلات أو العمارات المملوكة للدولة أو الولايات أو البلديات أو المؤسسات العمومية في حالة ما إذا كانت هذه المحلات أو العمارات تستجب لأحكام المادة 169 أعلاه وللفقرتين الأولى والثانية من هذه المادة . غیر أن هذه الأحكام لا تطبق على رخص العمل المؤقتة الممنوحة من قبل الإدارة لعمارة سبق اكتسابها من طرفها على إثر تصريح للمنفعة العمومية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_170> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_170_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_170_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_170_19750926_OpEnact_dfd79430da> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_170_obligation_0_651f8ee1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "170" ;
    dzdoc:position 172 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_169>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_185>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_186> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_169>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_185>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_186> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_170_condition_0_5c090dbc>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_170_condition_1_c0a516c9>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_170_condition_2_20adf53c> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_181> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_2_sec_3> ;
    dzdoc:eId "art_181" ;
    dzdoc:fullText "يجوز كذلك للمالك أن يؤخر تجديد الإيجار لمدة أقصاها ثلاث سنوات ، إذا كانت نيته تتجه إلى الارتفاع بالعمارة وأن هذا الارتفاع يتطلب طرد المستأجر مؤقتا . فيحق لهذا الأخير في هذه الحالة، الحصول على تعويض يساوي الضرر اللاحق به دون أن يزيد هذا التعويض عن بدل إيجار ثلاث سنوات ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_181_permission_0_47bfaad6> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_181_right_0_a22bb770>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_181_right_1_405eca7d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_181> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_181_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_181_19750926_OpEnact_9f9c2d2567> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 181" ;
    dzdoc:position 183 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_181_condition_0_14ba6b8d> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_215> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_1> ;
    dzdoc:eId "art_215" ;
    dzdoc:fullText "يتعين على كل تاجر أو شخص معنوي خاضع للقانون الخاص و لو لم يكن تاجرا، إذا توقف عن الدفع أن يدلي بإقرار في مدى خمسة عشر يوما قصد افتتاح إجراءات التسوية القضائية أو الإفلاس ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_215> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_215_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_215_19750926_OpEnact_bf154e7b19> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_215_obligation_0_0623a3ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "215" ;
    dzdoc:position 219 ;
    dzdoc:usesTerm dzterm:merchant .

<https://legal.dz/resource/order/1975-09-26/75-59#art_294> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_3> ;
    dzdoc:eId "art_294" ;
    dzdoc:fullText "يجب على وكيل التفليسة خلال عشرة أيام من الحكم بشهر الإفلاس أو التسوية القضائية أن يؤدي الأجور والتعويضات والتوابع من كل نوع الناشئة بمناسبة عقود العمل والتي لازالت مستحقة للعمال المستخدمين مباشرة من طرف المدين ، وذلك بمجرد أمر صادر من القاضي المنتدب، وذلك رغم وجود أي دائن آخر و بشرط وحيد هو وجود الأموال اللازمة لهذا الغرض ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_294> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_294_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_294_19750926_OpEnact_fa49613c66> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_294_obligation_0_92a7e91a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 294" ;
    dzdoc:position 299 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_294_condition_0_699c4bde> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_343> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_6> ;
    dzdoc:eId "art_343" ;
    dzdoc:fullText "إذا أبطل الصلح أو فسخ يقوم وكيل التفليسة فورا بجرد الأوراق المالية والأسهم والأوراق على أساس القائمة القديمة وبمعونة القاضي الذي وضع الأختام طبقا ل المادة 258 ، ويقوم بتحرير قائمة وميزانية تكميلية إذا اقتضى الحال ذلك. ويجري حالا نشر موجز للحكم الصادر ودعوة للدائنين الجدد إن كانوا ، ليقدموا مستندات ديونهم للتحقيق وفقا للأوضاع المنصوص عليها في المادة 228 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_343> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_343_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_343_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_343_19750926_OpEnact_2114a46bb5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_343_obligation_0_79df458e>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_343_obligation_1_b64e9179> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "343" ;
    dzdoc:position 348 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_228>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_258> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_228>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_258> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_343_condition_0_209b0969> ;
    dzdoc:usesTerm dzterm:bankruptcy_trustee,
        dzterm:composition .

<https://legal.dz/resource/order/1975-09-26/75-59#art_351> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_8> ;
    dzdoc:eId "art_351" ;
    dzdoc:fullText "إذا لم ترفع أية مطالبة بمبيع جبري للعقارات قبل حكم إشهار الإفلاس ، يقبل من وكيل التفليسة وحده بإذن من القاضي المنتدب ملاحقة البيع ، و يتعين عليه القيام بذلك خلال الثلاثة أشهر . غير أن للدائنين المرتهنين عقاريا أو ذوي الامتياز مهلة شهرين اعتبارا من تبليغهم الحكم بإشهار الإفلاس ملاحقة البيع الجبري مباشرة للعقارات التي قيدت عليها امتيازاتهم أو رهونهم العقارية . و عند عدم القيام في تلك المهلة يتعين على وكيل التفليسة القيام بالبيع في مهلة شهر . وتجري البيوع المشار إليها في هذه المادة طبقا للأوضاع المنصوص عليها في مادة الحجز العقاري."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_351_right_0_94b147ad>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_351_right_1_bcb1838f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_351> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_351_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_351_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_351_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_351_19750926_OpEnact_b4645c12f9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_351_obligation_0_134836cd>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_351_obligation_1_724be27f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "351" ;
    dzdoc:position 356 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_351_condition_0_8fa6fa43>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_351_condition_1_13cf56d9> ;
    dzdoc:usesTerm dzterm:bankruptcy_trustee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_357> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_9> ;
    dzdoc:eId "art_357" ;
    dzdoc:fullText "للمحكمة أن تقضي ولو تلقائيا بإقفال الإجراءات عند عدم وجود ديون مستحقة أو عندما يكون تحت تصرف وكيل التفليسة ما يكفي من المال . ولا يجوز إصدار الحكم بالإقفال لانقضاء الديون إلا بناء على تقرير من القاضي المنتدب يثبت تحقق واحد من الشرطين المتقدمين، ويضع الحكم حدا نهائيا للإجراءات بإعادة كافة حقوق المدين إليه وإعفائه من كل إسقاطات الحق التي كانت قد لحقت به. ويترتب على هذا الحكم رفع اليد عن رهن جماعة الدائنين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_357_permission_0_9c28135d> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_357_right_0_45375184> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_357> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_357_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_357_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_357_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_357_19750926_OpEnact_6ce9e9d7f5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "357" ;
    dzdoc:position 362 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_357_condition_0_d731e04f>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_357_condition_1_c3529d65> ;
    dzdoc:usesTerm dzterm:bankruptcy_trustee,
        dzterm:delegated_judge .

<https://legal.dz/resource/order/1975-09-26/75-59#art_371> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:تفليس_بالتقصير ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_371" ;
    dzdoc:fullText "يجوز أن يعتبر مرتكبا للتفليس بالتقصير كل تاجر في حالة توقف عن الدفع يوجد في إحدى الحالات الآتية : إذا كان قد عقد لحساب الغير تعهدات ثبت أنها بالغة الضخامة بالنسبة لوضعه عند التعاقد بغير أن يتقاضى مقابلها شيئا، إذا كان قد حكم بإفلاسه دون أن يكون قد أوفى بالتزاماته عن صلح سابق، إذا كان لم يقم بالتصريح لدى كاتب ضبط المحكمة عن حالة التوقف عن الدفع في مهلة خمسة عشر يوما، دون مانع مشروع، إذا كان لم يحضر بشخصه لدى وكيل التفليسة في الأحوال والمواعيد المحددة، دون مانع مشروع، إذا كانت حساباته ناقصة أو غير ممسوكة بانتظام. وبالنسبة للشركات التي تشتمل على شركاء مسؤولين بالتضامن بدون تحديد عن ديون الشركة، يجوز أن يعتبر الممثلون القانونيون مرتكبين للتفليس بالتقصير إذا بغير عذر شرعي لم يقوموا بالتصريح لدى كتابة ضبط المحكمة المختصة خلال الخمسة عشر يوما عن حالة التوقف عن الدفع دون مانع مشروع، أو لم يتضمن هذا التصريح قائمة بالشركاء المتضامنين مع بيان أسمائهم وموطنهم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_371_permission_0_ea7b0eae>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_371_permission_1_f155d039> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_371> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_371_defocc_771353ed313a> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_371_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_371_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_371_19750926_OpEnact_f4338cebf6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 371" ;
    dzdoc:position 376 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_371_condition_0_b2430b52> ;
    dzdoc:usesTerm dzterm:تاجر .

<https://legal.dz/resource/order/1975-09-26/75-59#art_391> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_391" ;
    dzdoc:fullText "يجوز أن تكون السفتجة محررة لأمر الساحب نفسه. ويمكن أن تكون مسحوبة على الساحب نفسه، كما يمكن أن تكون مسحوبة لحساب شخص من الغير. ويمكن أن يشترط بها الدفع في موطن شخص من الغير إما في المنطقة التي يقع فيها أو في موطن المسحوب عليه أو في منطقة أخرى."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_391_permission_0_ee971f03>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_391_permission_1_3417746a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_391> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_391_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_391_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_391_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_391_19750926_OpEnact_ecbb93413f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 391" ;
    dzdoc:position 396 ;
    dzdoc:usesTerm dzterm:bill_of_exchange .

<https://legal.dz/resource/order/1975-09-26/75-59#art_414> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_7> ;
    dzdoc:eId "art_414" ;
    dzdoc:fullText "يجب على حامل السفتجة الواجبة الدفع في يوم محدد أو في أجل ما من تاريخ معين أو بعد الإطلاع، أن يقدم السفتجة للدفع إما في يوم وجوب دفعها أو في أحد يومي العمل المواليين له . ويعتبر التقديم المادي للسفتجة لغرفة المقاصة بمثابة تقديم للوفاء. يمكن أن يتم هذا التقديم أيضا بأية وسيلة تبادل إلكترونية محددة في التشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_414_permission_0_5bf66ec4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_414> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_414_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_414_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_414_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_414_19750926_OpEnact_e178a361f8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_414_obligation_0_7c030ffb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "414" ;
    dzdoc:position 419 ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:holder .

<https://legal.dz/resource/order/1975-09-26/75-59#art_457> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_10> ;
    dzdoc:eId "art_457" ;
    dzdoc:fullText "من وجه أحد النظائر للقبول وجب عليه أن يذكر في النظائر الأخرى اسم الشخص الذي يكون بيده هذا النظير ، و يجب على هذا الشخص أن يسلمه إلى الحامل الشرعي لنظير آخر . وإذا امتنع من تسليم النظير فلا يمكن للحامل ممارسة حق الرجوع إلا بعد أن يثبت باحتجاج : أن النظير الموجه للقبول لم يسلم إليه بناء على طلبه، أن القبول أو الوفاء لم يحصل بمقتضى نظير آخر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_457_permission_0_65003060> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_457> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_457_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_457_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_457_19750926_OpEnact_b15000b5c4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_457_obligation_0_3352d653>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_457_obligation_1_bb4150ed> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "457" ;
    dzdoc:position 462 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_457_condition_0_603aac8a> ;
    dzdoc:usesTerm dzterm:right_of_recourse .

<https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_8_bis> ;
    dzdoc:eId "art_526_bis_4" ;
    dzdoc:fullText "يسترجع كل شخص منع من إصدار الشيكات حقه في ذلك ، عندما يثبت أنه قام بتسوية قيمة الشيك غير المدفوع، أو تكوين رصيد كاف ومتوفر موجه لتسويته بعناية المسحوب عليه، وبدفع غرامة التبرئة المنصوص عليها في المادة 526 مكرر 5 أدناه، وذلك في أجل عشرين (20) يوما ابتداء من تاريخ نهاية أجل الأمر بالدفع . في حالة عدم القيام بذلك ، لا يسترجع الممنوع حق إصدار الشيكات إلا بمرور أجل خمس (5) سنوات، ابتداء من تاريخ الأمر بالدفع."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_4_right_0_eac6950e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_4_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_4_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_4_19750926_OpEnact_aa17210038> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "526 مكرر 4" ;
    dzdoc:position 536 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_5> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_5> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_4_condition_0_50c3d67e>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_4_condition_1_e02810ee> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_532> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_9> ;
    dzdoc:eId "art_532" ;
    dzdoc:fullText "إن تقديم الشيك أو إجراء الاحتجاج فيه لا يمكن إجراؤهما إلا في يوم عمل، و إذا وافق اليوم الأخير من الأجل الذي يمنحه القانون لإتمام الإجراءات المتعلقة بالشيك ولا سيما تقديمه للوفاء أو تحرير الاحتجاج يوم عيد رسمي فيمتد هذا الأجل لغاية يوم العمل التالي. أما أيام الأعياد الرسمية التي تتخلل الأجل المذكور فإنها داخلة في حسابه. وتشبه حكما بأيام الأعياد الرسمية الأيام التي لا يجوز فيها المطالبة بأي وفاء أو إجراء أي احتجاج على مقتضى القوانين الجاري بها العمل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_532_permission_0_5ab3d11d>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_532_permission_1_1da55309> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_532> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_532_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_532_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_532_19750926_OpEnact_26be6cecef> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_532_prohibition_0_1da55309> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "532" ;
    dzdoc:position 554 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_532_condition_0_ab4737bf> ;
    dzdoc:usesTerm dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:سند_الخزن ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_1> ;
    dzdoc:eId "art_543_bis_2" ;
    dzdoc:fullText "سند الخزن هو سند يسمح للمودع بالاقتراض على قيمة البضائع المودعة بالمخزن العام. ويحتوي على نفس بيانات الوصل . يمكن حائز السند ، في أي وقت أن يفصل سند الخزن ويحوله لإذن حامل . وتشكل البضاعة المودعة حينئذ، ضمان تسديد المبلغ المقترض عند الاستحقاق. سند الخزن هو سند قابل للتظهير بنفس شروط السندات التجارية الأخرى."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2_permission_0_1d19d9c5>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2_permission_1_3ad82a86> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2_right_0_66ef3365> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_2> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2_defocc_32d1a3a5ae36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_2_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_2_19750926_OpEnact_3c12702853> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 2" ;
    dzdoc:position 568 ;
    dzdoc:usesTerm dzterm:الوصل,
        dzterm:سند_الخزن .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_1> ;
    dzdoc:eId "art_543_bis_4" ;
    dzdoc:fullText "على حامل سند الخزن أن يطالب عند الاستحقاق، بالتسديد بمقر إقامة المودع . وفي حالة عدم التسديد ، يمكنه خلال الأيام الثمانية (8) الموالية للاحتجاج، أن يقوم ببيع البضائع المخزونة في المزاد العلني واستعمال حق امتيازه على السعر . إذا كان السعر غير كاف للتسديد ، فيمكنه أن يطعن ضد المودع والمظهرين المتتاليين بصفته حاملا لسند تجاري ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_4_right_0_f0e5c4b0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_4_right_1_5ed906c5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_4_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_4_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_4_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_4_19750926_OpEnact_253eac1aab> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_4_obligation_0_e00546f3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 4" ;
    dzdoc:position 570 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_4_condition_0_27b8a3a0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_4_condition_1_ca75bbad> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_2> ;
    dzdoc:eId "art_543_bis_8" ;
    dzdoc:fullText "يصبح سند النقل باعتباره وثيقة تمثل ملكية البضائع، سندا تجاريا عندما يصدر و/ أو يظهر، \" للحامل \" أو \" لأمر\" . ويجب أن يحتوي على اسم الشخص الطبيعي أو المعنوي للشاحن أو اسمه التجاري ومهنته أو غرض شركته ومقر سكناه أو عنوان شركته وطبيعة البضاعة والبيانات التي تسمح بالتعرف عنها وعن قيمتها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_8_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_8_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_8_19750926_OpEnact_e1b9394756> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_8_obligation_0_803c438b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 543 مكرر 8" ;
    dzdoc:position 574 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_8_condition_0_f13431d9> ;
    dzdoc:usesTerm dzterm:commercial_instrument,
        dzterm:transport_document .

<https://legal.dz/resource/order/1975-09-26/75-59#art_560> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_560" ;
    dzdoc:fullText "لا يجوز أن تكون حصص الشركاء ممثلة في سندات قابلة للتداول ولا يمكن إحالتها إلا برضاء جميع الشركاء . ويعتبر كل شرط مخالف لذلك، كأنه لم يكن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_560_permission_0_9ee3e81b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_560> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_560_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_560_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_560_19750926_OpEnact_b09dfc6451> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_560_obligation_0_e80841e7> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_560_prohibition_0_9ee3e81b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "560" ;
    dzdoc:position 607 ;
    dzdoc:usesTerm dzterm:partners .

<https://legal.dz/resource/order/1975-09-26/75-59#art_581> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_581" ;
    dzdoc:fullText "يجوز لكل شريك أن يشارك في القرارات وله عدد من الأصوات يعادل عدد الحصص التي يملكها في الشركة . لكل شريك أن ينيب عنه شريكا آخر أو زوجه و لا يسوغ له أن ينيب عنه شخصا آخر إلا إذا أجاز ذلك القانون الأساسي . لا يسوغ لشريك أن يعين وكيلا للتصويت عن جزء من حصصه والتصويت بنفسه عن الجزء الآخر من الحصص . ويعتبر كل شرط مخالف لأحكام الفقرتين الثانية والرابعة كأن لم يكن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_581_permission_0_902b023b> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_581_right_0_12539133>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_581_right_1_2591ff87> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_581> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_581_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_581_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_581_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_581_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_581_19750926_OpEnact_1b4d83f7f9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_581_obligation_0_2ce786a0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_581_obligation_1_93438211> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 581" ;
    dzdoc:position 639 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_589> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_589" ;
    dzdoc:fullText "لا تنحل الشركة ذات المسؤولية المحدودة بنتيجة الحظر على أحد الشركاء أو تفليسه أو وفاته إلا إذا تضمن القانون الأساسي شرطا مخالفا في هذه الحالة الأخيرة . وفي حالة خسارة ثلاثة أرباع رأس مال الشركة يجب على المديرين استشارة الشركاء للنظر فيما إذا كان يتعين إصدار قرار بحل الشركة ، و يلزم في جميع الحالات إشهار قرار الشركاء في صحيفة معتمدة لتلقي الإعلانات القانونية في الولاية التي يكون مركز الشركة الرئيسي تابعا لها وإيداعه بكتابة ضبط المحكمة التي يكون هذا المركز تابعا لها وقيده بالسجل التجاري . وإذا لم يستشر المديرون الشركاء أو لم يتمكن الشركاء من المداولة على الوجه الصحيح ، جاز لكل من يهمه الأمر أن يطلب حل الشركة أمام القضاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_589> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_589_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_589_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_589_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_589_19750926_OpEnact_5fca3d828b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_589_obligation_0_ff96e676>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_589_obligation_1_ec27db2d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "589" ;
    dzdoc:position 646 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_589_condition_0_12848eca>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_589_condition_1_d6149b6f>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_589_condition_2_e7527262> ;
    dzdoc:usesTerm dzterm:company,
        dzterm:managers,
        dzterm:partners,
        dzterm:sarl,
        dzterm:statutes .

<https://legal.dz/resource/order/1975-09-26/75-59#art_631> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_631" ;
    dzdoc:fullText "مع مراعاة أحكام المادة 615 ، فإنه لا يجوز للقائمين بالإدارة أن يحصلوا من الشركة على أية أجرة دائمة كانت أم غير دائمة ، ما عدا الأجور المبينة في المواد 632 و 633 و 634 و 639 أدناه. يعتبر باطلا كل قرار مخالف لذلك."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_631_permission_0_b273d5ae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_631> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_631_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_631_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_631_19750926_OpEnact_81342674ac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_631_obligation_0_b7b1c274> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_631_prohibition_0_b273d5ae> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "631" ;
    dzdoc:position 690 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_615>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_632>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_633>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_634>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_639> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_615>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_632>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_633>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_634>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_639> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_700> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_700" ;
    dzdoc:fullText "يجوز للجمعية العامة غير العادية التي تقرر زيادة رأس المال أن تلغي لصالح شخص أو أكثر حق التفاضل في اكتتاب المساهمين. لا يمكن المستفيدين من الأسهم الجديدة إذا كانوا مساهمين المشاركة في الانتخابات وذلك تحت طائلة بطلان هذه المداولة. ويتم حساب النصاب والأغلبية المطلوبين بعد طرح الأسهم التي يملكونها. تحدد الجمعية العامة غير العادية ، بناء على تقرير مجلس الإدارة أو مجلس المديرين وبناء على تقرير خاص من مندوب الحسابات ، سعر إصدار الأسهم الجديدة وشروط تحديد هذا السعر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_700_permission_0_7ce848b4>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_700_permission_1_882d1b78> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_700_right_0_7ce848b4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_700> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_700_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_700_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_700_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_700_19750926_OpEnact_c3c61e7be8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_700_obligation_0_56618326> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "700" ;
    dzdoc:position 759 ;
    dzdoc:usesTerm dzterm:auditor,
        dzterm:board_of_directors,
        dzterm:directorate,
        dzterm:general_assembly .

<https://legal.dz/resource/order/1975-09-26/75-59#art_711> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_711" ;
    dzdoc:fullText "عندما يكون رأس المال مقسما إما إلى أسهم رأسمال وأسهم مستهلكة جزئيا أو كليا أو أسهم مستهلكة بصفة غير متساوية ، يجوز للجمعية العامة للمساهمين أن تقرر تحويل الأسهم المستهلكة كليا أو جزئيا إلى أسهم رأسمال وذلك وفقا للشروط المطلوبة لتعديل القانون الأساسي. وبهذه الصفة، تنص على توقع اقتطاع إجباري في حدود المبلغ المستهلك من الأسهم التي يجب تحويلها من حصة فوائد الشركة لسنة مالية أو أكثر تابعة لهذه الأسهم بعد دفع الربح الأول أو الفائدة التي يمكن أن ينص عليها القانون الأساسي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_711_permission_0_4aba04d9>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_711_permission_1_ce431e3d> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_711_right_0_3d135786> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_711> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_711_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_711_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_711_19750926_OpEnact_449f2254da> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "711" ;
    dzdoc:position 769 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_711_condition_0_a4e2a2e6> ;
    dzdoc:usesTerm dzterm:capital .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_9> ;
    dzdoc:eId "art_715_bis_19" ;
    dzdoc:fullText "يجوز للمحكمة أن تتخذ قرار حل الشركة ، بناء على طلب كل معني، إذا كان عدد المساهمين قد خفض إلى أقل من الحد الأدنى القانوني منذ أكثر من عام ، و يجوز لها أن تمنح الشركة أجلا أقصاه ستة أشهر لتسوية الوضع ، و لا تستطيع اتخاذ قرار حل الشركة إذا تمت هذه التسوية يوم فصلها في الموضوع ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_19_permission_0_343b7ab8> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_19_right_0_5b4e72bd>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_19_right_1_fda36af1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_19_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_19_19750926_OpEnact_874719cdb0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 19" ;
    dzdoc:position 793 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_19_condition_0_d3d6e02b>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_19_condition_1_8cb01744> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_7> ;
    dzdoc:eId "art_715_bis_8" ;
    dzdoc:fullText "يجوز لمساهم أو عدة مساهمين يمثلون على الأقل عشر (10/1) رأسمال الشركة، في الشركات التي تلجأ علنية للإدخار، أن يطلبوا من العدالة، وبناء على سبب مبرر، رفض مندوب ، أو مندوبي الحسابات الذين عينتهم الجمعية العامة . وإذا تمت تلبية الطلب ، تعين العدالة مندوبا جديدا للحسابات ويبقى هذا الأخير في وظيفته حتى قدوم مندوب الحسابات الذي تعينه الجمعية العامة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_8_permission_0_7f883631> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_8_right_0_bf616e54> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_8_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_8_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_8_19750926_OpEnact_2235aabbfe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 8" ;
    dzdoc:position 782 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_8_condition_0_6a6c08fa> ;
    dzdoc:usesTerm dzterm:auditor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_bis> ;
    dzdoc:eId "art_715_ثالثا_4" ;
    dzdoc:fullText "يتمتع المسير بأوسع السلطات للتصرف باسم الشركة في كل الظروف . يخضع المسير لنفس الالتزامات التي يخضع لها مجلس إدارة شركات المساهمة ، مع مراعاة أحكام هذا الفصل. وفي إطار العلاقات مع الغير، تلتزم الشركة حتى بأعمال المسير التي لا تخضع لموضوع الشركة إلا إذا توصلت إلى إثبات أن الغير كان على إطلاع بأن نشاط المسير بعيد عن موضوعها أو لا يمكنه تجاهله نظرا للظروف مع استثناء أن مجرد نشر القانون الأساسي يكفي وحده لتأسيس هذه البينة. تكون بنود القانون الأساسي التي تحد سلطات المسير والمترتبة عن هذه المادة، غير قابلة للاحتجاج بها على الغير."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4_right_0_69ea3708> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4_para_3> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715___4_19750926_OpEnact_ed348abf2c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4_obligation_0_d1ce156f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 ثالثا 4" ;
    dzdoc:position 911 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4_condition_0_a4fcc1d5> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_bis> ;
    dzdoc:eId "art_715_ثالثا_7" ;
    dzdoc:fullText "يتولى مجلس المراقبة الرقابة الدائمة لتسيير الشركة . وبهذه الصفة، فإنه يتمتع بنفس سلطات مندوبي الحسابات . يقدم مجلس المراقبة تقريرا للجمعية العامة العادية السنوية يشير فيه لاسيما إلى المخالفات والأخطاء المجودة في الحسابات السنوية، وعند الاقتضاء في الحسابات المدعمة للسنة المالية. وتعرض الوثائق الموضوعة تحت تصرف مندوبي الحسابات ، في نفس الوقت على مجلس المراقبة . ويجوز له استدعاء الجمعية العامة للمساهمين ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_7_right_0_8122199a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_7_right_1_33bf39c9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_7_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_7_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_7_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_7_para_3> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715___7_19750926_OpEnact_02df14d5bf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_7_obligation_0_4a7f82a0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_7_obligation_1_ba2dbba8>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_7_obligation_2_5c5df001> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 ثالثا 7" ;
    dzdoc:position 914 ;
    dzdoc:usesTerm dzterm:auditors,
        dzterm:supervisory_board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_723> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:fictitious_profit ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_723" ;
    dzdoc:fullText "تحدد الجمعية العامة بعد الموافقة على الحسابات والتحقق من وجود مبالغ قابلة للتوزيع، الحصة الممنوحة للشركاء تحت شكل أرباح . وكل ربح يوزع خلافا لهذه القواعد يعد ربحا صوريا . غير أنه لا تعد أرباحا صورية الدفعات المسبقة تحت الحساب من أرباح السنة المالية المقفلة أو الجارية، والتي يقرر مجلس الإدارة توزيعها قبل الموافقة على حسابات السنتين المذكورتين: إذا كانت للشركة قبل التوزيع المقرر بعنوان السنة المالية السابقة، احتياط من غير الاحتياطات التي نصت عليها المادة 721 ، وزائد على مبلغ الدفعات ، أو متى كانت الميزانية الموضوعة خلال السنة المالية أو في آخرها ومصادق عليها من طرف مندوب الحسابات، تثبت أن الشركة حصلت خلال السنة المالية، بعد تكوين الاستهلاكات والمؤونات الضرورية أرباحا صافية زائدة على مبلغ الدفعات، وذلك عند الاقتضاء، بعد طرح الخسائر السابقة والاقتطاع المنصوص عليه في المادة 311 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_723> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_723_defocc_14e55fea0e76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_723_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_723_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_723_19750926_OpEnact_937128d4ad> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_723_obligation_0_42ff9e73> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "723" ;
    dzdoc:position 925 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_311>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_721> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_311>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_721> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_723_condition_0_d6fdd9e7>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_723_condition_1_60c9ba64> ;
    dzdoc:usesTerm dzterm:board_of_directors,
        dzterm:general_assembly .

<https://legal.dz/resource/order/1975-09-26/75-59#art_808> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_808" ;
    dzdoc:fullText "يعاقب بالحبس من ثلاثة أشهر إلى سنة وبغرامة من 20.000 دج إلى 200.000 دج أو بإحدى هاتين العقوبتين فقط، المؤسسون للشركة المساهمة ورئيس مجلس إدارتها والقائمون بإدارتها ومديروها العامون وكذلك أصحاب الأسهم أو حاملوها الذين تعاملوا عمدا في : أسهم دون أن تكون لها قيمة اسمية أو كانت قيمتها الاسمية أقل من الحد الأدنى للقيمة القانونية، في أسهم عينية لا يجوز التداول فيها قبل انقضاء الأجل، الوعود بالأسهم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_808_permission_0_3a678027> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_808> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_808_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_808_19750926_OpEnact_dc3b008a94> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_808_obligation_0_bbabe362> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_808_prohibition_0_3a678027> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "808" ;
    dzdoc:position 1025 ;
    dzdoc:usesTerm dzterm:founders .

