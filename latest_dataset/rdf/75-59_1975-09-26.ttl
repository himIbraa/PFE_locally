    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يترتب بحكم القانون على الحكم بإشهار الإفلاس، ومن تاريخه تخلي المفلس عن إدارة أمواله أو التصرف فيها ، بما فيها الأموال التي قد يكتسبها بأي سبب كان، وما دام في حالة الإفلاس . ويمارس وكيل التفليسة جميع حقوق ودعاوى المفلس المتعلقة بذمته طيلة مدة التفليسة . على أنه يجوز للمفلس القيام بجميع الأعمال الاحتياطية لصيانة حقوقه والتدخل في الدعاوى التي يخاصم فيها وكيل التفليسة . ويترتب على الحكم الصادر بالتسوية القضائية اعتبارا من تاريخ أداء المساعدة الجبرية للمدين من طرف وكيل التفليسة في كافة الأعمال الخاصة"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_244_19750926_OpEnact_16efb19f89> ;
    dzdoc:replacementText "يترتب بحكم القانون على الحكم بإشهار الإفلاس، ومن تاريخه تخلي المفلس عن إدارة أمواله أو التصرف فيها ، بما فيها الأموال التي قد يكتسبها بأي سبب كان، وما دام في حالة الإفلاس . ويمارس وكيل التفليسة جميع حقوق ودعاوى المفلس المتعلقة بذمته طيلة مدة التفليسة . على أنه يجوز للمفلس القيام بجميع الأعمال الاحتياطية لصيانة حقوقه والتدخل في الدعاوى التي يخاصم فيها وكيل التفليسة . ويترتب على الحكم الصادر بالتسوية القضائية اعتبارا من تاريخ أداء المساعدة الجبرية للمدين من طرف وكيل التفليسة في كافة الأعمال الخاصة بالتصرف في أمواله طبقا للأوضاع المنصوص عليها في المواد من 273 إلى 279 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_244> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_244> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_245> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يترتب على الحكم بشهر الإفلاس أو التسوية القضائية وقف كل دعوى شخصية لأفراد جماعة الدائنين ، وبناء على هذا توقف منذ الحكم كل طرق التنفيذ، سواء على المنقولات أو العقارات من جانب الدائنين الذين لا يضمن ديونهم امتياز خاص أو رهن حيازي أو عقاري على تلك الأموال ، أما الدعاوى المنقولة أو العقارية وطرق التنفيذ التي لا يشملها الإيقاف فلا يمكن متابعتها أو رفعها إلا ضد وكيل التفليسة أو إن كان للمحكمة أن تقبل المفلس كخصم متدخل، وفي التسوية القضائية لا يكون ذلك إلا ضد المدين و وكيل التفليسة معا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_245_19750926_OpEnact_c68346cc57> ;
    dzdoc:replacementText "يترتب على الحكم بشهر الإفلاس أو التسوية القضائية وقف كل دعوى شخصية لأفراد جماعة الدائنين ، وبناء على هذا توقف منذ الحكم كل طرق التنفيذ، سواء على المنقولات أو العقارات من جانب الدائنين الذين لا يضمن ديونهم امتياز خاص أو رهن حيازي أو عقاري على تلك الأموال ، أما الدعاوى المنقولة أو العقارية وطرق التنفيذ التي لا يشملها الإيقاف فلا يمكن متابعتها أو رفعها إلا ضد وكيل التفليسة أو إن كان للمحكمة أن تقبل المفلس كخصم متدخل، وفي التسوية القضائية لا يكون ذلك إلا ضد المدين و وكيل التفليسة معا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_245> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_245> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
