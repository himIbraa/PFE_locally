<https://legal.dz/resource/order/1975-09-26/75-59#art_235> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_235" ;
    dzdoc:fullText "يعين القاضي المنتدب ، في بدء كل سنة قضائية، بأمر من رئيس المجلس القضائي بناء على اقتراح رئيس المحكمة . ويكون القاضي المنتدب مكلفا بنوع خاص بأن يلاحظ ويراقب أعمال وإدارة التفليسة ، أو التسوية القضائية . فيجمع كافة عناصر المعلومات التي يراها مجدية ، وله بنوع خاص سماع المدين المفلس أو المقبول في تسوية قضائية ومندوبية ومستخدميه ودائنيه أو أي شخص آخر . يقدم القاضي المنتدب للمحكمة وجوبا تقريرا شاملا لجميع النزاعات الناجمة عن التسوية القضائية أو الإفلاس ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_235_right_0_dd6f62a6>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_235_right_1_c32cde68> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_235> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_235_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_235_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_235_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_235_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_235_19750926_OpEnact_f55585426f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_235_obligation_0_5faf5c78>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_235_obligation_1_58ba516c>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_235_obligation_2_b74eda72> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "235" ;
    dzdoc:position 239 ;
    dzdoc:usesTerm dzterm:bankrupt,
        dzterm:bankruptcy,
        dzterm:debtor,
        dzterm:judge_delegate,
        dzterm:judicial_settlement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_273> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_6> ;
    dzdoc:eId "art_273" ;
    dzdoc:fullText "يجوز ل لمدين ، بمعونة وكيل التفليسة أن يقوم بكافة الإجراءات التحفظية وأن يباشر تحصيل السندات والديون الحالة الأداء وبيع الأشياء المعروضة للتلف القريب أو انخفاض القيمة الوشيك أو التي يكلف حفظها ثمنا باهظا وأن يرفع أو يتابع أية دعوى منقولة أو عقارية . وإذا كان المدين مأذونا بمتابعة استغلال مؤسسته الصناعية أو التجارية، وفقا للأوضاع المنصوص عليها في المادة 277 ، جاز له بمساعدة وكيل التفليسة القيام بكافة الإجراءات اللازمة لذلك الاستغلال ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_273_permission_0_108adc69> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_273_right_0_cf959f17>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_273_right_1_fa5ef48c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_273> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_273_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_273_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_273_19750926_OpEnact_1fad666bce> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "273" ;
    dzdoc:position 278 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_277> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_277> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_273_condition_0_219a1634> ;
    dzdoc:usesTerm dzterm:bankruptcy_trustee,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_317> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:concordat ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_2> ;
    dzdoc:eId "art_317" ;
    dzdoc:fullText "متى قبل المدين في تسوية قضائية يقوم القاضي المنتدب باستدعاء الدائنين المقبولة ديونهم في الميعاد المقرر في المادة 314 ، وذلك بإخطار ينشر في الصحف أو موجه ضمن ظروف شخصية من طرف وكيل التفليسة . فإن كان ثمة اقتراح بالصلح يبين الاستدعاء أن الجمعية تستهدف أيضا إبرام الصلح بين المدين ودائنيه وأن ديون الذين يشتركون في التصويت تخفض لحساب الأغلبية سواء في العدد أو في مقدار المبالغ. وترفق به خلاصة موجزة لتقرير وكيل التفليسة بشأن الصلح ونص مقترحات المدين ، ورأي المراقبين، إن كان لهم محل. فإذا لم توجد مقترحات للصلح تقوم الجمعية بإثبات قيام حالة الاتحاد . عقد الصلح المنصوص عليه في المقاطع السابقة هو اتفاق بين المدين ودائنيه، الذين يوافقون بموجبه على آجال لدفع الديون أو تخفيض جزء منها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_317> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_317_defocc_8ab754436681> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_317_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_317_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_317_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_317_para_3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_317_para_4> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_317_19750926_OpEnact_3dff92ef62> ;
