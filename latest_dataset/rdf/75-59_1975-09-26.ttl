    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_685> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_686_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_686> ;
    dzdoc:position 0 ;
    dzdoc:text ""@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_687_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_687> ;
    dzdoc:position 0 ;
    dzdoc:text "يزاد رأسمال الشركة إما بإصدار أسهم جديدة أو بإضافة قيمة للأسهم الموجودة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_688_condition_0_849bf6b5> a dznorm:Condition ;
    dznorm:conditionText "إذا قدمت نقدا أو بالمقاصة مع ديون معينة المقدار ومستحقة الأداء من الشركة وإما بضم الاحتياط أو الأرباح أو علاوات الإصدار أو بما يقدم من حصص عينية وإما بتحويل السندات بامتيازات أو بدونها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_688> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_688_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_688> ;
    dzdoc:position 0 ;
    dzdoc:text "تصبح الأسهم الجديدة مسددة القيمة إذا قدمت نقدا أو بالمقاصة مع ديون معينة المقدار ومستحقة الأداء من الشركة وإما بضم الاحتياط أو الأرباح أو علاوات الإصدار أو بما يقدم من حصص عينية وإما بتحويل السندات بامتيازات أو بدونها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_689_condition_0_6f5db2eb> a dznorm:Condition ;
    dznorm:conditionText "ما عدا إذا تحقق ذلك بإلحاق الاحتياط أو الأرباح أو علاوات الإصدار"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_689> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_689_obligation_0_e25e47e2> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_689> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا تقرر زيادة رأس المال بإضافة القيمة الاسمية للأسهم إلا بقبول المساهمين بالإجماع"@ar ;
    dznorm:sourceArticle "art_689" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_689_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_689> ;
    dzdoc:position 0 ;
    dzdoc:text "لا تقرر زيادة رأس المال بإضافة القيمة الاسمية للأسهم إلا بقبول المساهمين بالإجماع، ما عدا إذا تحقق ذلك بإلحاق الاحتياط أو الأرباح أو علاوات الإصدار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_68_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_68> ;
    dzdoc:position 0 ;
    dzdoc:text "يخضع نقل الأمتعة المسجلة لأحكام المواد 46 و 47 و48 ومن 52 إلى 61."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_690_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_690> ;
    dzdoc:position 0 ;
    dzdoc:text "تصدر الأسهم الجديدة إما بقيمتها الاسمية وإما بتلك القيمة مع زيادة علاوة الإصدار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_691_condition_0_9ac0c656> a dznorm:Condition ;
    dznorm:conditionText "إذا تحققت زيادة رأس المال بإلحاق الاحتياط أو الأرباح أو علاوات الإصدار أو تحويل سندات الاستحقاق"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_691> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_691_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_691> ;
    dzdoc:position 0 ;
    dzdoc:text "للجمعية العامة غير العادية وحدها حق الاختصاص باتخاذ قرار زيادة رأس المال بناء على تقرير مجلس الإدارة أو مجلس المديرين حسب الحالات. وإذا تحققت زيادة رأس المال بإلحاق الاحتياط أو الأرباح أو علاوات الإصدار أو تحويل سندات الاستحقاق، فتفصل الجمعية العامة خلافا لما ورد في المادة 674 أعلاه، حسب شروط النصاب والأغلبية المنصوص عليها في المادة 675 أعلاه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_691_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_691> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجوز للجمعية العامة أن تفوض لمجلس الإدارة أو لمجلس المديرين السلطات اللازمة لتحقيق زيادة رأس المال مرة واحدة أو أكثر، وتحديد الكيفيات ومعاينة التنفيذ والقيام بإجراء التعديل المناسب للقانون الأساسي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_691_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_691> ;
    dzdoc:position 2 ;
    dzdoc:text "ويعتبر كأن لم يكن كل شرط ورد في القانون الأساسي يخول مجلس الإدارة أو مجلس المديرين، حسب الحالة، سلطة تقرير زيادة رأس المال."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_691_right_0_2cd9f8df> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_691> ;
