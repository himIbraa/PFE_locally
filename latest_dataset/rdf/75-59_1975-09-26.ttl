<https://legal.dz/resource/order/1975-09-26/75-59#art_276_condition_0_942de44f> a dznorm:Condition ;
    dznorm:conditionText "إذا كان موضوع التحكيم أو المصالحة غير محدد القيمة أو تجاوز قيمته اختصاص المحكمة في الدرجة الأخيرة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_276> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_276_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_276> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان موضوع التحكيم أو المصالحة غير محدد القيمة أو تجاوز قيمته اختصاص المحكمة في الدرجة الأخيرة لا يعتبر شرط التحكيم أو المصالحة إلزاميا إلا بعد التصديق عليه من المحكمة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_276_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_276> ;
    dzdoc:position 1 ;
    dzdoc:text "ويكون لكل دائن الحق في التدخل عند طلب التصديق."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_276_right_0_97784c1f> a dznorm:Right ;
