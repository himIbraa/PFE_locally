    dznorm:sourceArticle "art_812" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_812_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_812> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالغرامة من 5.000 دج إلى 20.000 دج كل من الرئيس أو القائم بالإدارة الذي يرأس الجلسة ويتخلف عن إثبات مداولات مجلس الإدارة في المحاضر التي تحفظ بمقر الشركة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_813_obligation_0_935c757d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_813> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالغرامة من 20.000 دج إلى 200.000 دج"@ar ;
    dznorm:sourceArticle "art_813" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_813_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_813> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالغرامة من 20.000 دج إلى 200.000 دج الرئيس والقائمون بالإدارة أو المديرون العامون للشركة المساهمة والذين: يتخلفون في كل سنة مالية عن وضع حساب الاستغلال العام وحساب النتائج والجرد والميزانية والتقرير الكتابي عن حالة الشركة ونشاطها أثناء السنة المنصرمة، يتخلفون في إعداد هاته المستندات عن استعمال نفس الأشكال وطرق التقدير المتبعة في السنين السابقة وذلك مع مراعاة التعديلات المقدمة طبقا لالمادة 548 ."@ar .

