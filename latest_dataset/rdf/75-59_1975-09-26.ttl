    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_767> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_767_obligation_1_53d42dea> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_767> ;
    dznorm:position 1 ;
    dznorm:provisionText "وتبلغ نفس البيانات بواسطة رسالة عادية إلى علم المساهمين بطلب من المصفي"@ar ;
    dznorm:sourceArticle "art_767" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_767_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_767> ;
    dzdoc:position 0 ;
    dzdoc:text "ينشر أمر تعيين المصفين مهما كان شكله في أجل شهر في النشرة الرسمية للإعلانات القانونية وفضلا عن ذلك في جريدة مختصة بالإعلانات القانونية للولاية التي يوجد بها مقر الشركة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_767_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_767> ;
    dzdoc:position 1 ;
    dzdoc:text "ويتضمن هذا الأمر البيانات الآتية : عنوان الشركة أو اسمها متبوعا عند الاقتضاء بمختصر اسم الشركة، نوع الشركة متبوعا بإشارة \" في حالة تصفية \"، مبلغ رأس المال عنوان مركز الشركة رقم قيد الشركة في السجل التجاري، سبب التصفية، اسم المصفين ولقبهم وموطنهم، حدود صلاحياتهم عند الاقتضاء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_767_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_767> ;
    dzdoc:position 2 ;
    dzdoc:text "كما يذكر في نفس النشر بالإضافة إلى ما تقدم تعيين المكان الذي توجه إليه المراسلات والمكان الخاص بالعقود والوثائق المتعلقة بالتصفية، المحكمة التي يتم في كتابتها إيداع العقود والأوراق المتصلة بالتصفية بملحق السجل التجاري."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_767_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_767> ;
    dzdoc:position 3 ;
    dzdoc:text "وتبلغ نفس البيانات بواسطة رسالة عادية إلى علم المساهمين بطلب من المصفي."@ar .

