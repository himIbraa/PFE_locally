<https://legal.dz/resource/order/1975-09-26/75-59#version_art_488> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يكتب التظهير على الشيك أو على ورقة أخرى ملحقة به و يجب أن يوقع عليه المظهر . ويجوز ألا يعين المستفيد في التظهير وأن يكون مقصورا فحسب على توقيع المظهر وهو التظهير على بياض ، وفي هذه الحالة الأخيرة يشترط لصحة التظهير أن يكون مكتوبا على ظهر الشيك أو على الورقة الملحقة ."@ar ;
