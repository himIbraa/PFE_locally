<https://legal.dz/resource/order/1975-09-26/75-59#art_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "يترتب على إهمال واحد أو أكثر من البيانات الواردة في المادة 98 بطلان إذا نشأ عنه ضرر لغير المتعاقدين . ولا يجوز أن يطلب الحكم بهذا البطلان إلا الأشخاص الذين لحقهم ضرر من جراء الإهمال أو الإخلال ويمكن للمحاكم أن تقرر حسب أهمية الضرر ونوعه إبطال وحصر مفعوله."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_100_permission_0_989a53e4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_100> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_100_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_100_19750926_OpEnact_d7d1b0931e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "100" ;
    dzdoc:position 102 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_98> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_98> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_100_condition_0_67e2262c> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_102> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_102" ;
    dzdoc:fullText "يذكر مأمورو السجل التجاري في هامش القيود عمليات الأسبقية والحلول والشطب الكلي أو الجزئي الناتجتين عن العقود الرسمية. إذا وجدت سندات قابلة للتحويل لتكون محل الدين المضمون وفقا لشروط عقد البيع ، فينتقل الانتفاع الخاص بالتأمين على الدين للحاملين المتعاقبين للسندات. وإذا وجدت عدة سندات تمثل الدين فيكون الامتياز المتعلق به ممنوحا لأول القائمين بالمطالبة لحساب جميعهم ولكامل الدين. ويشارك جميع حاملي السندات المذكورة في ممارسة حق الامتياز مهما كان استحقاق السندات التي يحملونها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_102> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_102_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_102_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_102_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_102_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_102_19750926_OpEnact_38a79cfc2c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_102_obligation_0_0c98b92e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "102" ;
    dzdoc:position 104 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_102_condition_0_64e64111>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_102_condition_1_9264588f> ;
    dzdoc:usesTerm dzterm:registrar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_111> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_111" ;
    dzdoc:fullText "يجب على البائع القائم بدعوى الفسخ أن يبلغ الدائنين المقيدين في محل الإقامة المختار منهم في عمليات قيودهم . ولا يجوز أن يصدر الحكم إلا بعد مضي شهر من تاريخ هذا التبليغ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_111_permission_0_ea7c9737> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_111> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_111_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_111_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_111_19750926_OpEnact_310164cd09> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_111_obligation_0_2a8f000b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "111" ;
    dzdoc:position 113 ;
    dzdoc:usesTerm dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-59#art_118> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_118" ;
    dzdoc:fullText "يجوز الرهن الحيازي للمحلات التجارية ، دون حاجة لغير الشروط والإجراءات المقررة بموجب الأحكام التالية . لا يخول رهن المحل التجاري للدائن المرتهن الحق في التنازل له عنه مقابل ماله من ديون وتسديدا لها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_118_permission_0_b400e06d> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_118_right_0_015fcf8b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_118> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_118_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_118_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_118_19750926_OpEnact_4109065f63> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "118" ;
    dzdoc:position 120 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_118_condition_0_9a7dba94> ;
    dzdoc:usesTerm dzterm:commercial_establishment,
        dzterm:pledge .

<https://legal.dz/resource/order/1975-09-26/75-59#art_129> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_129" ;
    dzdoc:fullText "إذا لم يقم الراسي عليه المزاد بتنفيذ شروط مرسى المزاد يعاد بيع المحل التجاري عن طريق إعادة المزايدة بعد إنذار غير متبوع بنتيجة، في مهلة عشرين يوما وذلك وفقا للأوضاع المقررة في المادة 127 أعلاه. ويلزم المزايد المتخلف، تجاه دائني البائع والبائع نفسه بالفرق الحاصل بين الثمن الذي تم به البيع له والثمن الحاصل من إعادة البيع عن طريق إعادة المزايدة ، دون أن يكون له الحق في المطالبة بالمزايدة إن وجدت. وتكون نفقات المزايدة الأولى على عاتق الراسي عليه المزاد الأولي، وتحصل عند الاقتضاء تنفيذيا بواسطة الموظف العمومي المكلف بالبيع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_129> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_129_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_129_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_129_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_129_19750926_OpEnact_3637167ff6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_129_obligation_0_2bd97f6a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "129" ;
    dzdoc:position 131 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_127> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_127> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_129_condition_0_9cbd60d1> ;
    dzdoc:usesTerm dzterm:commercial_establishment .

<https://legal.dz/resource/order/1975-09-26/75-59#art_131> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_131" ;
    dzdoc:fullText "لا تقبل زيادة على المزايدة إذا حصل البيع حسب الأوضاع المقررة في المواد 85 ومن 125 إلى 128 و 130 و 133 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_131> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_131_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_131_19750926_OpEnact_6b3ad23543> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "131" ;
    dzdoc:position 133 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_125>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_128>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_130>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_133>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_85> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_125>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_128>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_130>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_133>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_85> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_131_condition_0_8ced237d> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_140> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_4> ;
    dzdoc:eId "art_140" ;
    dzdoc:fullText "إذا حدد ثمن البيع نهائيا سواء كانت هناك مزايدة بالزيادة أم لا وفي حالة عدم حصول اتفاق بين الدائنين للقيام بالتوزيع بالطريقة الودية فإن إجراء التوزيع يتم طبقا للقواعد المبينة في المادة 400 وما يليها من قانون الإجراءات المدنية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_140> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_140_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_140_19750926_OpEnact_f3c356a7b6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "140" ;
    dzdoc:position 142 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_140_extref_2238ab27> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_140_condition_0_9bac1bed> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_142> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_5> ;
    dzdoc:eId "art_142" ;
    dzdoc:fullText "يعطى لكل الأوراق المشار إليها في المادتين 98 و 99 أعلاه وكذلك كل الأوراق الأخرى المقدمة إلى المركز الوطني للسجل التجاري بالنظر في الأحكام التجارية، رقم إيداع عند تقديمها . وتسجل هذه الوثائق فيما بعد بدفتر ذي أرومة يسلم منه وصل مستخرج من الدفتر المذكور يتضمن ما يلي : 1 - رقم الإيداع، يدرج على الوثائق طبقا لما هو مبين في الفقرة الأولى أعلاه. 2 - تاريخ إيداع الوثائق 3 - عدد عدد ونوع هذه الوثائق مع بيان الهدف من الإيداع، 4 - لقب الأطراف، 5 - نوع المحل التجاري ومقره. يمضي ويؤرخ الوصل من مأموري السجل التجاري الذي يقوم بتسليمه مقابل الوثيقة المتضمنة طبقا للمادة 101 ما يثبت بأن الامتياز قد تحقق. يوقع على الصفحة الأولى والأخيرة من الدفتر كما ترقم ويوقع باختصار على كافة صفحاته من طرف رئيس المحكمة، ويجرى قفله كل يوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_142> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_142_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_142_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_142_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_142_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_142_19750926_OpEnact_dc2336a0ab> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_142_obligation_0_b13ad0cd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "142" ;
    dzdoc:position 144 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_101>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_98>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_99> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_101>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_98>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_99> ;
    dzdoc:usesTerm dzterm:commercial_register_officer,
        dzterm:national_center_commercial_register .

<https://legal.dz/resource/order/1975-09-26/75-59#art_155> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_8> ;
    dzdoc:eId "art_155" ;
    dzdoc:fullText "يجب أن يؤشر في هامش القيد على كل حلول اتفاقي بتعلق بالاستفادة من الرهن الحيازي خلال ثلاثين يوما من تاريخ العقد الرسمي أو العرفي المثبت لهذا الحلول وذلك بناء على تسليم نسخة أو أصل هذا العقد إلى مأموري السجل التجاري . وتتم تسوية النزاعات التي قد تنشأ بين أصحاب القيود المتتابعة طبقا للمادة 265 من القانون المدني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_155> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_155_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_155_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_155_19750926_OpEnact_d5b16e351e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_155_obligation_0_a3e5772e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 155" ;
    dzdoc:position 157 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_155_extref_3be14a57> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_189> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_2_sec_4> ;
    dzdoc:eId "art_189" ;
    dzdoc:fullText "يجوز للمستأجر من الباطن أن يطلب تجديد إيجاره من المستأجر الأصلي في حدود الحقوق التي يتمتع بها هذا الأخير نفسه من المالك . ويدعى المؤجر للمشاركة في العقد كما هو منصوص عليه في المادة 188 أعلاه. وعند انقضاء مدة الإيجار الأصلي لا يلزم المالك بالتجديد إلا إذا كان قد رخص صراحة أو ضمنيا بالإيجار من الباطن أو وافق عليه أو إذا لم تكن الأماكن محل الإيجار الأصلي تشكل في حالة الإيجار الجزئي من الباطن، كلا مشاعا ماديا أو في نية الطرفين المشتركة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_189_permission_0_8778f847> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_189_right_0_932c7ae2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_189> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_189_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_189_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_189_19750926_OpEnact_2fc8731b94> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 189" ;
    dzdoc:position 193 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_188> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_188> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_189_condition_0_f2b1086e> ;
    dzdoc:usesTerm dzterm:lessor,
        dzterm:original_lessee,
        dzterm:owner,
        dzterm:sublease,
        dzterm:sublessee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_209> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_3> ;
    dzdoc:eId "art_209" ;
    dzdoc:fullText "يكون مؤجر المحل التجاري مسؤولا بالتضامن مع المستأجر المسير عن الديون التي يعقدها هذا الأخير بمناسبة استغلال المتجر وذلك لغاية نشر عقد تأجير التسيير وطيلة مدة 6 أشهر من تاريخ النشر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_209> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_209_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_209_19750926_OpEnact_31de92bcff> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_209_obligation_0_fee0c409> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 209" ;
    dzdoc:position 213 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_209_condition_0_2e4fbcae> ;
    dzdoc:usesTerm dzterm:lessee_manager,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_212> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_3> ;
    dzdoc:eId "art_212" ;
    dzdoc:fullText "يعد باطلا، كل عقد بتأجير التسيير أو اتفاق آخر يتضمن شروطا مماثلة وافق عليها المالك أو المستغل للمحل التجاري دون أن تتوفر فيها الشروط المنصوص عليها في المواد المشار إليه أعلاه ، غير أنه لا يجوز للمتعاقدين التمسك بهذا البطلان تجاه الغير. ويترتب على البطلان المنصوص عليه في الفقرة السابقة بالنسبة للمتعاقدين سقوط الحق الذي قد يحصلون عليه من جراء الأحكام المتعلقة بالإيجارات التجارية المحددة للعلاقات التي تقوم بين المؤجرين والمستأجرين وذلك فيما يتعلق بتجديد إيجارات العقارات أو الأماكن ذات الاستعمال التجاري أو الصناعي أو الحرفي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_212_permission_0_a187b405> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_212> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_212_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_212_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_212_19750926_OpEnact_8817e1fa5d> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_212_prohibition_0_a187b405> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 212" ;
    dzdoc:position 216 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_212_condition_0_2cb66e9e> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_257> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_2> ;
    dzdoc:eId "art_257" ;
    dzdoc:fullText "يقدم وكيل التفليسة خلال الشهر الذي صدر فيه الحكم ، بيانا موجزا للقاضي المنتدب بالوضعية الظاهرة للمدين وأسباب وخصائص هذا المركز . ويقوم القاضي المنتدب بإحالة البيان فورا إلى وكيل الدولة مشفوعا بملاحظاته . فإذا لم يقدم إليه ذلك البيان في المهلة المحددة ، وجب عليه أن يخطر وكيل الدولة بذلك وأن يوضح له أسباب التأخير ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_257> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_257_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_257_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_257_19750926_OpEnact_5e646b7eed> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_257_obligation_0_858f03e6>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_257_obligation_1_e1a633a0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_257_obligation_2_3d08c558> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "257" ;
    dzdoc:position 262 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_257_condition_0_9af70d98> ;
    dzdoc:usesTerm dzterm:receiver .

<https://legal.dz/resource/order/1975-09-26/75-59#art_275> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_6> ;
    dzdoc:eId "art_275" ;
    dzdoc:fullText "يجوز ل لمدين بمعونة وكيل التفليسة وإذن القاضي المنتدب أن يقوم بكافة إجراءات الترك أو التنازل أو القبول . ويمكنه ضمن نفس شروط إجراء التحكيم والمصالحة عن كل حق لا يتجاوز قيمته اختصاص المحكمة الناظرة في الدعوى، في الدرجة الأخيرة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_275_permission_0_48890372> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_275_right_0_c649400a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_275_right_1_4b8742be> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_275> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_275_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_275_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_275_19750926_OpEnact_c373303a2d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "275" ;
    dzdoc:position 280 ;
    dzdoc:usesTerm dzterm:bankruptcy_trustee,
        dzterm:debtor,
        dzterm:delegated_judge .

<https://legal.dz/resource/order/1975-09-26/75-59#art_312> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_5> ;
    dzdoc:eId "art_312" ;
    dzdoc:fullText "يجوز استرداد البضائع المؤتمن عليها المدين سواء على سبيل الوديعة أو بقصد بيعها لحساب المالك، وذلك طالما هي قائمة عينا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_312_permission_0_d4de8abf> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_312_right_0_59b3353d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_312> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_312_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_312_19750926_OpEnact_f9c715b1c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "312" ;
    dzdoc:position 317 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_312_condition_0_586bd9d7> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_324> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_2> ;
    dzdoc:eId "art_324" ;
    dzdoc:fullText "إذا كان الحكم في المعارضة متوقفا على الفصل في مسائل تخرج بسبب نوعها عن اختصاص المحكمة التي قضت بالتسوية القضائية أو الإفلاس ، توقف هذه المحكمة الحكم في المعارضة لما بعد الفصل في تلك المسائل. وتحدد المحكمة ميعادا قصيرا يلتزم الدائن المعارض بأن يرفع خلاله الموضوع للقضاء المختص وأن يثبت متابعته للطلب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_324> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_324_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_324_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_324_19750926_OpEnact_82319631ad> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_324_obligation_0_b64b60a0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 324" ;
    dzdoc:position 329 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_324_condition_0_fb9e7b4f> ;
    dzdoc:usesTerm dzterm:opposing_creditor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_328> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_3> ;
    dzdoc:eId "art_328" ;
    dzdoc:fullText "يجوز أن يعين في حكم المصادقة على الصلح مندوب واحد إلى ثلاثة مندوبين لتنفيذ الصلح، مع تحديد مهمتهم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_328_permission_0_1c5dff88> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_328_right_0_9206d454> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_328> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_328_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_328_19750926_OpEnact_fa266249ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 328" ;
    dzdoc:position 333 ;
    dzdoc:usesTerm dzterm:conciliation .

<https://legal.dz/resource/order/1975-09-26/75-59#art_354> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_8> ;
    dzdoc:eId "art_354" ;
    dzdoc:fullText "بعد إقفال الإجراءات يحل اتحاد الدائنين بحكم القانون و يسترجع الدائنون شخصيا ممارسة أعمالهم . وللدائنين أن يحصلوا بأمر من رئيس المحكمة على سند تنفيذي إذا حققت وقبلت حقوقهم ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_354_right_0_fa72d2cd>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_354_right_1_71f538c1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_354> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_354_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_354_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_354_19750926_OpEnact_90ee39e1e8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "354" ;
    dzdoc:position 359 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_354_condition_0_7c4c8a73> ;
    dzdoc:usesTerm dzterm:creditors_union .

<https://legal.dz/resource/order/1975-09-26/75-59#art_363> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_2> ;
    dzdoc:eId "art_363" ;
    dzdoc:fullText "يوجه رئيس المحكمة المختص جميع المستندات إلى وكيل الدولة لدى محكمة موطن المدعي ويكلفه بجمع كافة الاستعلامات عن صحة الوقائع المدلى بها ويتم ذلك خلال شهر واحد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_363> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_363_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_363_19750926_OpEnact_1267d8a67c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_363_obligation_0_dfa0e62e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 363" ;
    dzdoc:position 368 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_2> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "على المرسل دفع أجرة النقل والمصاريف المترتبة على الأشياء المنقولة . وإذا اشترط دفع الأجرة عند وصول الأشياء المنقولة فيكون الناقل و المرسل إليه الذي صدر منه القبول ملزمين بأدائها بالتضامن بينهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_40_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_40_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_40_19750926_OpEnact_ad81587aec> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_40_obligation_0_78560d3c>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_40_obligation_1_f60a4422> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 40" ;
    dzdoc:position 42 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_40_condition_0_a36cb82e> ;
    dzdoc:usesTerm dzterm:carrier,
        dzterm:sender,
        dzterm:sender_to .

<https://legal.dz/resource/order/1975-09-26/75-59#art_416> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_7> ;
    dzdoc:eId "art_416" ;
    dzdoc:fullText "لا يجبر حامل السفتجة على استلام قيمتها قبل الاستحقاق. وإذا دفع المسحوب عليه قبل الاستحقاق فإنه يتحمل تبعة ذلك. ومن يدفع عند الاستحقاق برئت ذمته على الوجه الصحيح إلا إذا كان قد ارتكب تدليسا أو خطأ جسيما ، و يجب عليه أن يتحقق من صحة تسلسل التظهيرات، دون التثبت من صحة إمضاءات المظهرين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_416> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_416_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_416_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_416_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_416_19750926_OpEnact_4e61f6b8ab> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_416_obligation_0_3dec8b53> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "416" ;
    dzdoc:position 421 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_416_condition_0_92013f97>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_416_condition_1_286baa49> ;
    dzdoc:usesTerm dzterm:drawee,
        dzterm:holder .

<https://legal.dz/resource/order/1975-09-26/75-59#art_436> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_8> ;
    dzdoc:eId "art_436" ;
    dzdoc:fullText "إذا أقيمت دعوى الرجوع بعد حصول قبول جزئي فمن سدد المبلغ الذي لم تقبل فيه السفتجة يحق له أن يطلب ذكر هذا التسديد على السفتجة وإعطاءه إيصالا به ويجب على الحامل فوق ذلك أن يسلم نسخة مصدقة عن السفتجة مع الاحتجاج ليمكنه من إقامة دعاوى الرجوع فيما بعد ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_436_right_0_11a164ce> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_436> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_436_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_436_19750926_OpEnact_2b47922bbc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_436_obligation_0_c755d7dc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 436" ;
    dzdoc:position 441 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_436_condition_0_9ea4f6b6> ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:holder .

<https://legal.dz/resource/order/1975-09-26/75-59#art_453> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_9> ;
    dzdoc:eId "art_453" ;
    dzdoc:fullText "إن الوفاء بطريق التدخل يجب إثباته بإبراء يدرج على السفتجة ويعين فيه الشخص الذي حصل الوفاء لمصلحته وإذا لم يعين هذا الشخص عد الوفاء حاصلا لمصلحة الساحب. يجب أن تسلم السفتجة و الاحتجاج إذا كان قد سبق تحريره إلى الموفي بطريق التدخل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_453> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_453_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_453_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_453_19750926_OpEnact_1d7e1bec0c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_453_obligation_0_51b33937>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_453_obligation_1_4ccc2594> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 453" ;
    dzdoc:position 458 ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:payment_by_intervention,
        dzterm:protest .

<https://legal.dz/resource/order/1975-09-26/75-59#art_476> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_476" ;
    dzdoc:fullText "يمكن اشتراط دفع الشيك : 1 - إلى شخص مسمى مع شرط صريح يعبر عنه بكلمة \"لأمر\" أو بدونه، 2 - إلى شخص مسمى مع شرط يعبر عنه بكلمة \"ليس\" لأمر\" أو لفظ آخر بهذا المعنى، 3 - للحامل. إن الشيك المسحوب لفائدة شخص مسمى والمنصوص فيه \"أو لحامله\" أو ما يؤدي إلى هذا المعنى يعتبر شيكا لحامله . كما أن الشيك الذي لم يذكر فيه اسم المستفيد يعد بمثابة شيك لحامله ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_476_permission_0_d0b70c7c> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_476_right_0_f87128d2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_476> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_476_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_476_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_476_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_476_19750926_OpEnact_67c644fac3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 476" ;
    dzdoc:position 481 ;
    dzdoc:usesTerm dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_490> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_2> ;
    dzdoc:eId "art_490" ;
    dzdoc:fullText "إن المظهر ضامن للوفاء ما لم يشترط خلاف ذلك . ويمكنه أن يمنع تظهيره من جديد وحينئذ لا يكون ملزما بالضمان لمن يظهر لهم الشيك فيما بعد."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_490_right_0_1ad80c88> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_490> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_490_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_490_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_490_19750926_OpEnact_06043a5d23> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_490_prohibition_0_c8a6df9b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "490" ;
    dzdoc:position 495 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_490_condition_0_81d55f36> ;
    dzdoc:usesTerm dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_498> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_3> ;
    dzdoc:eId "art_498" ;
    dzdoc:fullText "يعطى الضمان الاحتياطي سواء على الشيك أو على الورقة المتصلة به أو بورقة مستقلة يبين فيها المكان الذي تمت فيه. ويعبر عنه بكلمات « مقبول كضمان احتياطي » أو بأية صيغة أخرى مماثلة ومذيلة بتوقيع ضامن الوفاء . ويعتبر الضمان الاحتياطي حاصلا بمجرد توقيع ضمان الوفاء على وجه الشيك إلا إذا كان صاحب التوقيع هو الساحب . ويجب أن يذكر في الضمان اسم المضمون وإلا عد الضمان معطى للساحب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_498> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_498_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_498_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_498_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_498_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_498_19750926_OpEnact_c203c47790> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_498_obligation_0_8435ce7b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "498" ;
    dzdoc:position 503 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_498_condition_0_8887a94d> ;
    dzdoc:usesTerm dzterm:aval,
        dzterm:cheque,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_510> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_4> ;
    dzdoc:eId "art_510" ;
    dzdoc:fullText "على مالك الشيك الضائع للحصول على نسخة منه ثانية أن يتصل بمظهره المباشر و يتعين على هذا الأخير أن يعيره اسمه وأن يقدم له المساعدة لمطالبة المظهر له وهكذا صعودا من مظهر إلى مظهر حتى الوصول إلى ساحب الشيك ، و يتحمل مالك الشيك الضائع المصاريف ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_510> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_510_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_510_19750926_OpEnact_b1b81c7ef5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_510_obligation_0_61103f75>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_510_obligation_1_2e466a60>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_510_obligation_2_f15922a8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 510" ;
    dzdoc:position 515 ;
    dzdoc:usesTerm dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_519> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_6> ;
    dzdoc:eId "art_519" ;
    dzdoc:fullText "جميع الأشخاص الملزمين بمقتضى شيك مسؤولون على وجه التضامن قبل حامله . ويحق لحامله مطالبة هؤلاء الأشخاص منفردين أو مجتمعين بدون أن يلزم بمراعاة ترتيب التزاماتهم . وكل موقع على شيك أو في قيمته، يملك هذا الحق. إن الدعوى المرفوعة على أحد الملزمين لا تمنع من مطالبة الباقين ولو كانوا لاحقين لمن رفعت عليه الدعوى أولا."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_519_right_0_e4ecd912> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_519> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_519_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_519_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_519_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_519_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_519_19750926_OpEnact_8d524f3056> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_519_obligation_0_6d0cea15> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 519" ;
    dzdoc:position 524 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_8_bis> ;
    dzdoc:eId "art_526_bis_8" ;
    dzdoc:fullText "يقوم بنك الجزائر بانتظام، بتبليغ البنوك و الهيئات المالية المؤهلة قانونا ، بالقائمة المحينة للممنوعين من إصدار الشيكات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_8_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_8_19750926_OpEnact_e38f569fc7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_8_obligation_0_a19395e2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "526 مكرر 8" ;
    dzdoc:position 540 ;
    dzdoc:usesTerm dzterm:banks,
        dzterm:financial_institutions .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_1> ;
    dzdoc:eId "art_543_bis_3" ;
    dzdoc:fullText "يمكن المودع الذي يريد بيع بضاعته إذا لم تكن مرهونة ، أن يظهر الوصل لإذن المشتري ويرفقه بسند الخزن . لا يظهر المودع الذي اقترض على البضاعة، إلا الوصل ويعتبر منذ ذلك الوقت ملزما بتسديد سند الخزن مسبقا أو بإيداع المبلغ لدى إدارة المخزن العام المعني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_3_permission_0_459ca6cc> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_3_right_0_0afdbc79> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_3_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_3_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_3_19750926_OpEnact_d10426b961> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_3_obligation_0_0cfedaef> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 3" ;
    dzdoc:position 569 ;
    dzdoc:usesTerm dzterm:الوصل .

<https://legal.dz/resource/order/1975-09-26/75-59#art_551> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_551" ;
    dzdoc:fullText "للشركاء بالتضامن صفة التاجر وهم مسؤولون من غير تحديد وبالتضامن عن ديون الشركة . ولا يجوز لدائني الشركة مطالبة أحد الشركاء بوفاء ديون الشركة إلا بعد مرور خمسة عشر يوما من تاريخ إنذار الشركة بعقد غير قضائي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_551_permission_0_f1e35087> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_551> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_551_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_551_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_551_19750926_OpEnact_d1ceddf7ae> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_551_obligation_0_62f8e9df> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "551" ;
    dzdoc:position 598 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_551_condition_0_73a1dbbf> ;
    dzdoc:usesTerm dzterm:merchant .

<https://legal.dz/resource/order/1975-09-26/75-59#art_561> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_561" ;
    dzdoc:fullText "يجب إثبات إحالة الحصص الخاصة بالشركة بموجب عقد رسمي ويكون الاحتجاج بها على الشركة بعد تبليغها للشركة أو قبولها للإحالة بعقد رسمي. ولا يجوز الاحتجاج بها على الغير إلا بعد إتمام هذه الإجراءات وكذلك بعد النشر في السجل التجاري."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_561_permission_0_9dc196fc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_561> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_561_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_561_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_561_19750926_OpEnact_dafc288c0e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_561_obligation_0_3a9cba75> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "561" ;
    dzdoc:position 608 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1_bis> ;
    dzdoc:eId "art_563_bis_2" ;
    dzdoc:fullText "يتألف عنوان الشركة من أسماء كل الشركاء المتضامنين أو من اسم أحدهم أو أكثر متبوع في كل الحالات بعبارة \" وشركاؤهم \" . وإذا كان عنوان الشركة يتألف من اسم شريك موص فيلتزم هذا الأخير من غير تحديد وبالتضامن، بديون الشركة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_2_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_2_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_2_19750926_OpEnact_f761e68ff6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_2_obligation_0_327be7be>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_2_obligation_1_391773b2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "563 مكرر 2" ;
    dzdoc:position 613 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_2_condition_0_4052c661> ;
    dzdoc:usesTerm dzterm:active_partners .

<https://legal.dz/resource/order/1975-09-26/75-59#art_568> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_568" ;
    dzdoc:fullText "يجب أن يتضمن القانون الأساسي ذكر قيمة الحصص العينية المقدمة من الشركاء ، ويتم ذلك بعد الإطلاع على تقرير ملحق بالقانون الأساسي يحرره تحت مسؤوليته المندوب المختص بالحصص والمعين بأمر من المحكمة من بين الخبراء المعتمدين. ويكون الشركاء مسؤولين بالتضامن مدة خمس سنوات تجاه الغير عن القيمة المقدرة للحصص العينية التي قدموها عند تأسيس الشركة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_568> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_568_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_568_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_568_19750926_OpEnact_5a03532eac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_568_obligation_0_cb68f6e2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_568_obligation_1_31461be0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "568" ;
    dzdoc:position 626 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_569> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_569" ;
    dzdoc:fullText "يجب أن تكون حصص الشركاء اسمية ولا يمكن أن تكون ممثلة في سندات قابلة للتداول ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_569_permission_0_a5f26ed0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_569> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_569_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_569_19750926_OpEnact_b88f7c72de> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_569_obligation_0_8599c01f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "569" ;
    dzdoc:position 627 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_2> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "يجوز للوكيل بالعمولة ، استنادا لاشتراط كتابي مدرج في سند النقل ومطابق للقوانين والأنظمة الجاري بها العمل ومبلغ للموكل ، وفيما عدا حالة الخطأ العمدي أو الجسيم المرتكب منه بذاته أو من مستخدمه أو الناقل أو مستخدم هذا الأخير ، أن يشترط إعفاءه كليا أو جزئيا من المسؤولية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_59_permission_0_36acdc83> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_59_right_0_a13a20f6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_59_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_59_19750926_OpEnact_2d3c478be5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 59" ;
    dzdoc:position 61 ;
    dzdoc:usesTerm dzterm:commission_agent .

<https://legal.dz/resource/order/1975-09-26/75-59#art_598> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_598" ;
    dzdoc:fullText "تودع الأموال الناتجة عن الاكتتابات النقدية وقائمة المكتتبين مع ذكر المبالغ التي يدفعها كل مكتتب، لدى موثق أو لدى مؤسسة مالية مؤهلة قانونا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_598> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_598_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_598_19750926_OpEnact_8f880c8e32> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_598_obligation_0_fd3d2218> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "598" ;
    dzdoc:position 657 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_607> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_607" ;
    dzdoc:fullText "المادة 607 : يشتمل القانون الأساسي، على تقدير الحصص العينية. ويتم هذا التقدير بناء على تقرير ملحق بالقانون الأساسي يعده مندوب الحصص تحت مسؤوليته. ويتبع نفس الإجراء، إذا تم اشتراط امتيازات خاصة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_607> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_607_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_607_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_607_19750926_OpEnact_82a389bb39> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "607" ;
    dzdoc:position 666 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_616> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_616" ;
    dzdoc:fullText "لا يجوز لقائم بالإدارة أن يقبل من الشركة عقد عمل ب تاريخ تعيينه فيها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_616_permission_0_ca06e40b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_616> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_616_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_616_19750926_OpEnact_44c811d738> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_616_obligation_0_52f4838b> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_616_prohibition_0_ca06e40b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "616" ;
    dzdoc:position 675 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_632> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_632" ;
    dzdoc:fullText "تمنح الجمعية العامة لمجلس الإدارة مكافأة عن نشاطات أعضائه، مبلغا ثابتا سنويا عن بدل الحضور . ويقيد هذا المبلغ على تكاليف الاستغلال. وتمنح مكافآت نسبية لمجلس الإدارة طبقا للشروط المنصوص عليها في المادتين 727 و 728 أدناه. يحدد مجلس الإدارة كيفيات توزيع المبالغ الإجمالية التي تمثل بدل الحضور والنسب بين أعضائه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_632_right_0_f064a5a1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_632> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_632_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_632_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_632_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_632_para_3> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_632_19750926_OpEnact_6d3e71d7b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "632" ;
    dzdoc:position 691 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_727>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_728> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_727>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_728> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_634> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_634" ;
    dzdoc:fullText "يجوز ل مجلس الإدارة أن يأذن بتسديد مصاريف السفر والتنقلات وكذا المصاريف التي أداها القائمون بالإدارة في مصلحة الشركة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_634_permission_0_567cecd6> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_634_right_0_681d5d41> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_634> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_634_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_634_19750926_OpEnact_1d65c29a71> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 634" ;
    dzdoc:position 693 ;
    dzdoc:usesTerm dzterm:board_of_directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_642> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_642" ;
    dzdoc:fullText "يجوز النص في القانون الأساسي لكل شركة مساهمة ، على أن هذه الشركة تخضع لأحكام هذا القسم الفرعي. يمكن أن تقرر الجمعية العامة غير العادية أثناء وجود الشركة إدراج هذا الشرط في القانون الأساسي أو إلغاءه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_642_permission_0_267945a4>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_642_permission_1_ad35c2f4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_642> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_642_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_642_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_642_19750926_OpEnact_ddfdad2277> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 642" ;
    dzdoc:position 701 ;
    dzdoc:usesTerm dzterm:extraordinary_general_assembly,
        dzterm:joint_stock_company,
        dzterm:statutes .

<https://legal.dz/resource/order/1975-09-26/75-59#art_645> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_645" ;
    dzdoc:fullText "يجوز للجمعية العامة بناء على اقتراح من مجلس المراقبة عزل أعضاء مجلس المديرين . وفي حالة ارتباط المعني بالأمر بعقد عمل ، فإن تجريده من عضويته بمجلس المديرين لا يترتب عنه فسخ عقد العمل. وفي هذه الحالة يعاد إدماجه في منصب عمله الأصلي أو في منصب عمل مماثل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_645_permission_0_9b8af569> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_645_right_0_a3ad1532> ;
