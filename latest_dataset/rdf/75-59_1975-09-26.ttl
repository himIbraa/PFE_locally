<https://legal.dz/resource/order/1975-09-26/75-59#version_art_308> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز استرداد البضائع التي فسخ بيعها قبل الحكم بالتسوية القضائية أو بالإفلاس سواء كان هذا بحكم قضائي أو من جراء شرط فسخ اتفاقي، وذلك ما دامت هذه البضائع قائمة عينا كلها أو بعضها ويتعين أيضا قبول الاسترداد رغم الحكم بفسخ البيع أو تقرير وجوده بمقتضى حكم قضائي تال للحكم بالتسوية القضائية أو بالإفلاس، وذلك متى كانت دعوى الاسترداد أو الفسخ قد رفعها البائع، الذي لم يستوف الثمن قبل الحكم المنشيء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_308_19750926_OpEnact_b1048c6af9> ;
    dzdoc:replacementText "يجوز استرداد البضائع التي فسخ بيعها قبل الحكم بالتسوية القضائية أو بالإفلاس سواء كان هذا بحكم قضائي أو من جراء شرط فسخ اتفاقي، وذلك ما دامت هذه البضائع قائمة عينا كلها أو بعضها ويتعين أيضا قبول الاسترداد رغم الحكم بفسخ البيع أو تقرير وجوده بمقتضى حكم قضائي تال للحكم بالتسوية القضائية أو بالإفلاس، وذلك متى كانت دعوى الاسترداد أو الفسخ قد رفعها البائع، الذي لم يستوف الثمن قبل الحكم المنشيء ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_308> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
