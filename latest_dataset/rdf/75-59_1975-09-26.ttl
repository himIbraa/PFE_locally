<https://legal.dz/resource/order/1975-09-26/75-59#version_art_280> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ابتداء من صدور الحكم بإشهار الإفلاس بالتسوية القضائية يقوم جميع الدائنين الممتازين أم لا بما في ذلك الخزينة العامة بتسليم وكيل التفليسة مستنداتهم مع جدول ببيان الأوراق المقدمة والمبالغ المطالب بها . ويكون التوقيع على هذا الجدول مع الإقرار بصحتها ومطابقتها إما من الدائن أو وكيل قانوني عنه. ويتعين إخبار الدائنين المستفيدين بضمانات صدر نشرها شخصيا وعند الاقتضاء بموطنهم المختار . تقبل مؤقتا وبصفة دين ممتاز أو دين عادي حسب الحالة : 1 - الديون الجبائية الحاصلة عن تسعير إداري أو تبليغ بالتصحيح ولم تكن "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_280_19750926_OpEnact_aca460d434> ;
    dzdoc:replacementText "ابتداء من صدور الحكم بإشهار الإفلاس بالتسوية القضائية يقوم جميع الدائنين الممتازين أم لا بما في ذلك الخزينة العامة بتسليم وكيل التفليسة مستنداتهم مع جدول ببيان الأوراق المقدمة والمبالغ المطالب بها . ويكون التوقيع على هذا الجدول مع الإقرار بصحتها ومطابقتها إما من الدائن أو وكيل قانوني عنه. ويتعين إخبار الدائنين المستفيدين بضمانات صدر نشرها شخصيا وعند الاقتضاء بموطنهم المختار . تقبل مؤقتا وبصفة دين ممتاز أو دين عادي حسب الحالة : 1 - الديون الجبائية الحاصلة عن تسعير إداري أو تبليغ بالتصحيح ولم تكن موضوع سند تنفيذي في آخر تاريخ لتقديم الديون. 2 - الديون الجمركية موضوع سند يأذن باتخاذ الإجراءات التحفظية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_280> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_280> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_281> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عند عدم إحضار السندات في مهلة شهر لا يقبل المتخلفون في التوزيع والأرباح ما لم ترفع عنهم المحكمة سقوط هذه المهلة إذا أثبتوا أن لا يد لهم في هذا التخلف . وفي هذه الحالة لا يمكن لهم إلا المشاركة في توزيع الحصص أو الأرباح المقبلة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_281_19750926_OpEnact_d4c655abad> ;
    dzdoc:replacementText "عند عدم إحضار السندات في مهلة شهر لا يقبل المتخلفون في التوزيع والأرباح ما لم ترفع عنهم المحكمة سقوط هذه المهلة إذا أثبتوا أن لا يد لهم في هذا التخلف . وفي هذه الحالة لا يمكن لهم إلا المشاركة في توزيع الحصص أو الأرباح المقبلة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_281> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
