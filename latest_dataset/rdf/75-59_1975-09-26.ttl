<https://legal.dz/resource/order/1975-09-26/75-59#version_art_137> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم تحصل مزايدة عد الدائن المزايد بالزيادة الراسي على المزايد. يتعين على الراسي عليه المزاد أن يتسلم المعدات والبضائع الموجودة بالمحل عند حيازته له بالثمن على أساس الخبرة الرضائية أو القضائية بحضور كل من المشتري المزاد عليه وبائعه والراسي عليه المزاد. ويكون ملزما زيادة على مبلغ مرسى المزاد بأن يسدد للمشتري الذي انتزعت منه الحيازة، النفقات والمصاريف القانونية لعقد شرائه مع مصاريف التبليغات والقيد والنشر المشار إليها في المواد 83 و 84 و 97 و 109 ومن 116 إلى 119 أعلاه ولمن كان لهم الحق فيها للتو"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_137_19750926_OpEnact_516c54bdf8> ;
    dzdoc:replacementText "إذا لم تحصل مزايدة عد الدائن المزايد بالزيادة الراسي على المزايد. يتعين على الراسي عليه المزاد أن يتسلم المعدات والبضائع الموجودة بالمحل عند حيازته له بالثمن على أساس الخبرة الرضائية أو القضائية بحضور كل من المشتري المزاد عليه وبائعه والراسي عليه المزاد. ويكون ملزما زيادة على مبلغ مرسى المزاد بأن يسدد للمشتري الذي انتزعت منه الحيازة، النفقات والمصاريف القانونية لعقد شرائه مع مصاريف التبليغات والقيد والنشر المشار إليها في المواد 83 و 84 و 97 و 109 ومن 116 إلى 119 أعلاه ولمن كان لهم الحق فيها للتوصل لإعادة البيع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_137> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_137> ;
