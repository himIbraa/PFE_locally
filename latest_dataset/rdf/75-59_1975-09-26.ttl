    dznorm:conditionText "يجب على الجمعية العامة العادية أن تكون قد رخصت صراحة للشركة القيام بعمليات البورصة بأسهمها الخاصة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis> ;
