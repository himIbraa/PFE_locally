<https://legal.dz/resource/order/1975-09-26/75-59#version_art_466> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا خلا السند من أحد البيانات المبينة في المادة السابقة فلا يعتبر سند الأمر إلا في الأحوال المنصوص عليها في الفقرات التالية. إن السند لأمر الذي لم يعين فيه تاريخ الاستحقاق يعد واجب الدفع عند الاطلاع عليه. إذا لم يكن بالسند تعيين خاص فيعد مكان إنشائه هو مكان الدفع وهو نفسه المكان الذي به مقر الملزم. إن السند لأمر الذي لم يذكر به مكان إنشائه يعتبر محررا بالمكان المعين بجانب الملزم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_466_19750926_OpEnact_73b1bf8b7c> ;
    dzdoc:replacementText "إذا خلا السند من أحد البيانات المبينة في المادة السابقة فلا يعتبر سند الأمر إلا في الأحوال المنصوص عليها في الفقرات التالية. إن السند لأمر الذي لم يعين فيه تاريخ الاستحقاق يعد واجب الدفع عند الاطلاع عليه. إذا لم يكن بالسند تعيين خاص فيعد مكان إنشائه هو مكان الدفع وهو نفسه المكان الذي به مقر الملزم. إن السند لأمر الذي لم يذكر به مكان إنشائه يعتبر محررا بالمكان المعين بجانب الملزم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_466> ;
