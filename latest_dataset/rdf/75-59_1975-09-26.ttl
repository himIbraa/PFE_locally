    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_20> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يطبق هذا الإلزام خاصة على 1 - كل تاجر ، شخصا طبيعيا كان أو معنويا . 2 - كل مقاولة تجارية يكون مقرها في الخارج وتفتح في الجزائر وكالة أو فرعا أو أي مؤسسة أخرى. 3 - كل ممثلية تجارية أجنبية تمارس نشاطا تجاريا على التراب الوطني."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_20_19750926_OpEnact_6bd8b62e21> ;
