<https://legal.dz/resource/order/1975-09-26/75-59#art_735_condition_0_0eccfdca> a dznorm:Condition ;
    dznorm:conditionText "إذا انقطع سبب البطلان في اليوم الذي تتولى فيه المحكمة النظر في الأصل ابتدائيا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_735> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_735_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_735> ;
    dzdoc:position 0 ;
    dzdoc:text "تنقضي دعوى البطلان إذا انقطع سبب البطلان في اليوم الذي تتولى فيه المحكمة النظر في الأصل ابتدائيا، إلا إذا كان هذا البطلان مبنيا على عدم قانونية موضوع الشركة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_736_condition_0_fed36086> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_736_condition_0_fed36086_action_7d399e8dc0> ;
    dznorm:conditionText "إذا اقتضى الحال استدعاء الجمعية أو وقعت استشارة الشركاء لإزالة البطلان، وإذا ثبت استدعاء قانوني لتلك الجمعية أو إرسال نص مشاريع القرار مصحوبا بالمستندات التي يجب تسليمها للشركاء"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_736> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_736_condition_0_fed36086_action_7d399e8dc0> a dznorm:Action ;
    rdfs:label "تسليمها للشركاء"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "إذا اقتضى الحال استدعاء الجمعية أو وقعت استشارة الشركاء لإزالة البطلان، وإذا ثبت استدعاء قانوني لتلك الجمعية أو إرسال نص مشاريع القرار مصحوبا بالمستندات التي يجب تسليمها للشركاء"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_736> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_736_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_736> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز للمحكمة التي تتولى النظر في دعوى البطلان أن تحدد أجلا ولو تلقائيا للتمكن من إزالة البطلان. ولا يسوغ لها أن تقضي بالبطلان في أقل من شهرين من تاريخ طلب افتتاح الدعوى."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_736_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_736> ;
    dzdoc:position 1 ;
    dzdoc:text "إذا اقتضى الحال استدعاء الجمعية أو وقعت استشارة الشركاء لإزالة البطلان، وإذا ثبت استدعاء قانوني لتلك الجمعية أو إرسال نص مشاريع القرار مصحوبا بالمستندات التي يجب تسليمها للشركاء، فإن المحكمة تقضي بحكم بمنح الأجل اللازم للشركاء لاتخاذ قرار."@ar .

