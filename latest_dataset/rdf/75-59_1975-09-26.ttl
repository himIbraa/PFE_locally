    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_615> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يجوز للأجير المساهم في الشركة أن يعين قائما بالإدارة إلا إذا كان عقد عمله سابقا بسنة واحدة على الأقل لتعيينه ومطابقا لمنصب العمل الفعلي"@ar ;
    dznorm:sourceArticle "art_615" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_615_obligation_0_01cad15c_action_6ba203f141> a dznorm:Action ;
