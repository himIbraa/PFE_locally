    dznorm:position 0 ;
    dznorm:provisionText "يجب أن يطابق مبلغ بدل الإيجار الذي يراد تجديده أو إعادة النظر فيه، القيمة الايجارية العادية."@ar ;
    dznorm:sourceArticle "art_190" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_190_obligation_0_866692c7_action_1f70749529> a dznorm:Action ;
