        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_120>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_121> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_116>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_117>,
