<https://legal.dz/resource/order/1975-09-26/75-59#version_art_102> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يذكر مأمورو السجل التجاري في هامش القيود عمليات الأسبقية والحلول والشطب الكلي أو الجزئي الناتجتين عن العقود الرسمية. إذا وجدت سندات قابلة للتحويل لتكون محل الدين المضمون وفقا لشروط عقد البيع ، فينتقل الانتفاع الخاص بالتأمين على الدين للحاملين المتعاقبين للسندات. وإذا وجدت عدة سندات تمثل الدين فيكون الامتياز المتعلق به ممنوحا لأول القائمين بالمطالبة لحساب جميعهم ولكامل الدين. ويشارك جميع حاملي السندات المذكورة في ممارسة حق الامتياز مهما كان استحقاق السندات التي يحملونها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_102_19750926_OpEnact_38a79cfc2c> ;
    dzdoc:replacementText "يذكر مأمورو السجل التجاري في هامش القيود عمليات الأسبقية والحلول والشطب الكلي أو الجزئي الناتجتين عن العقود الرسمية. إذا وجدت سندات قابلة للتحويل لتكون محل الدين المضمون وفقا لشروط عقد البيع ، فينتقل الانتفاع الخاص بالتأمين على الدين للحاملين المتعاقبين للسندات. وإذا وجدت عدة سندات تمثل الدين فيكون الامتياز المتعلق به ممنوحا لأول القائمين بالمطالبة لحساب جميعهم ولكامل الدين. ويشارك جميع حاملي السندات المذكورة في ممارسة حق الامتياز مهما كان استحقاق السندات التي يحملونها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_102> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_102> ;
