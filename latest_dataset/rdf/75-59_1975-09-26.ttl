    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يوجد مندوبو الحسابات، ولو في الشركات غير الملتزمة بتعيينهم ، يجوز تعيين مراقب واحد أو أكثر من طرف الشركات طبقا للشروط المنصوص عليها في الفقرة الأولى من المادة 781 . وفي حالة انعدام ذلك يمكن تعيينهم من رئيس المحكمة حالة فصله وبعد إجراء بحث بناء على طلب المصفي، أو عن طريق دعوى مستعجلة بطلب كل من يهمه الأمر ، وذلك بعد استدعاء المصفي قانونيا. يحدد في أمر تسمية المراقبين سلطاتهم وواجباتهم وأجورهم وكذلك مدة مهامهم. وتجري عليهم نفس المسؤولية الملقاة على عاتق مندوبي الحسابات . وفي جميع الأحوال ين"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_781_19750926_OpEnact_dbf00fa302> ;
    dzdoc:replacementText "إذا لم يوجد مندوبو الحسابات، ولو في الشركات غير الملتزمة بتعيينهم ، يجوز تعيين مراقب واحد أو أكثر من طرف الشركات طبقا للشروط المنصوص عليها في الفقرة الأولى من المادة 781 . وفي حالة انعدام ذلك يمكن تعيينهم من رئيس المحكمة حالة فصله وبعد إجراء بحث بناء على طلب المصفي، أو عن طريق دعوى مستعجلة بطلب كل من يهمه الأمر ، وذلك بعد استدعاء المصفي قانونيا. يحدد في أمر تسمية المراقبين سلطاتهم وواجباتهم وأجورهم وكذلك مدة مهامهم. وتجري عليهم نفس المسؤولية الملقاة على عاتق مندوبي الحسابات . وفي جميع الأحوال ينشر هذا الأمر بنفس الشروط والآجال الخاصة بالمصفين والمنصوص عليها في المادة 767 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_781> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_781> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_782> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعين مصف واحد أو أكثر من طرف الشركاء إذا حصل الانحلال مما تضمنه القانون الأساسي أو إذا قرره الشركاء . يعين المصفي : 1- بإجماع الشركاء في شركات التضامن، 2- بالأغلبية لرأس مال الشركاء في الشركات ذات المسؤولية المحدودة، 3- وبشروط النصاب القانونية فيما يخص الجمعيات العامة العادية في الشركات المساهمة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_782_19750926_OpEnact_5bf0016316> ;
    dzdoc:replacementText "يعين مصف واحد أو أكثر من طرف الشركاء إذا حصل الانحلال مما تضمنه القانون الأساسي أو إذا قرره الشركاء . يعين المصفي : 1- بإجماع الشركاء في شركات التضامن، 2- بالأغلبية لرأس مال الشركاء في الشركات ذات المسؤولية المحدودة، 3- وبشروط النصاب القانونية فيما يخص الجمعيات العامة العادية في الشركات المساهمة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_782> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_782> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
