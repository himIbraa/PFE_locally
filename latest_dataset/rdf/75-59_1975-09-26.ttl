<https://legal.dz/resource/order/1975-09-26/75-59#version_art_473> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا خلا السند من أحد البيانات المذكورة في المادة السابقة ، فلا يعتبر شيكا إلا في الأحوال المنصوص عليها في الفقرات الآتية : إذا خلا الشيك من بيان مكان الوفاء فإن المكان المبين بجانب اسم المسحوب عليه يعتبر مكان الوفاء. فإذا ذكرت عدة أمكنة بجانب اسم المسحوب عليه فيكون الشيك واجب الدفع في المكان المذكور أولا. وإذا لم تذكر هذه البيانات أو غيرها يكون الشيك واجب الدفع في المكان الذي به المحل الأصلي للمسحوب عليه . إن الشيك الذي لم يذكر فيه مكان إنشائه يعتبر إنشاؤه قد تم في المكان المبين بجانب اسم الساحب"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_473_19750926_OpEnact_9309fafe2b> ;
    dzdoc:replacementText "إذا خلا السند من أحد البيانات المذكورة في المادة السابقة ، فلا يعتبر شيكا إلا في الأحوال المنصوص عليها في الفقرات الآتية : إذا خلا الشيك من بيان مكان الوفاء فإن المكان المبين بجانب اسم المسحوب عليه يعتبر مكان الوفاء. فإذا ذكرت عدة أمكنة بجانب اسم المسحوب عليه فيكون الشيك واجب الدفع في المكان المذكور أولا. وإذا لم تذكر هذه البيانات أو غيرها يكون الشيك واجب الدفع في المكان الذي به المحل الأصلي للمسحوب عليه . إن الشيك الذي لم يذكر فيه مكان إنشائه يعتبر إنشاؤه قد تم في المكان المبين بجانب اسم الساحب ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_473> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_473> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_474> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز سحب الشيك إلا على مصرف أو مقاولة أو مؤسسة مالية أو على مصلحة الصكوك البريدية أو مصلحة الودائع والأمانات أو الخزينة العامة أو قباضة مالية كما لا يجوز سحب الشيك إلا على مؤسسة القرض البلدي أو صناديق القرض الفلاحي التي يكون لديها وقت إنشاء السند رصيد من النقود تحت تصرف الساحب وبموجب اتفاق صريح أو ضمني يحق بمقتضاه للساحب أن يتصرف في هذه النقود بطريقة إصدار الشيك . وعلى الساحب أو من صدر الشيك لحسابه أن يتولى وضع مقابل الوفاء ومع ذلك يظل الساحب لحساب غيره ملزما شخصيا للمظهرين والحامل دون غيرهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_474_19750926_OpEnact_205a05e960> ;
    dzdoc:replacementText "لا يجوز سحب الشيك إلا على مصرف أو مقاولة أو مؤسسة مالية أو على مصلحة الصكوك البريدية أو مصلحة الودائع والأمانات أو الخزينة العامة أو قباضة مالية كما لا يجوز سحب الشيك إلا على مؤسسة القرض البلدي أو صناديق القرض الفلاحي التي يكون لديها وقت إنشاء السند رصيد من النقود تحت تصرف الساحب وبموجب اتفاق صريح أو ضمني يحق بمقتضاه للساحب أن يتصرف في هذه النقود بطريقة إصدار الشيك . وعلى الساحب أو من صدر الشيك لحسابه أن يتولى وضع مقابل الوفاء ومع ذلك يظل الساحب لحساب غيره ملزما شخصيا للمظهرين والحامل دون غيرهم. ويكون الساحب وحده ملزما عند الإنكار بإثبات أن من سحب عليه الشيك كان لديه مقابل وفائه في وقت إنشائه وإلا كان ضامنا وفاءه ولو قدم الاحتجاج بعد مضي الآجال المحددة. إن السندات التي تم سحبها ووجب دفعها بالقطر الجزائري على غير الأشخاص المذكورين في الفقرة الأولى وكانت محررة على شكل شيكات لا يصح اعتبارها شيكات ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_474> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_474> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_475> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يخضع الشيك لشرط القبول وإذا كتب على الشيك بيان القبول عد كأن لم يكن. على أنه يجوز للمسحوب عليه التأشير على الشيك ، وهذا التأشير يفيد إثبات وجود مقابل الوفاء في تاريخ التأشير."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_475_19750926_OpEnact_b55e6e785c> ;
    dzdoc:replacementText "لا يخضع الشيك لشرط القبول وإذا كتب على الشيك بيان القبول عد كأن لم يكن. على أنه يجوز للمسحوب عليه التأشير على الشيك ، وهذا التأشير يفيد إثبات وجود مقابل الوفاء في تاريخ التأشير."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_475> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_475> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
