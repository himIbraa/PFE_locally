<https://legal.dz/resource/order/1975-09-26/75-59#version_art_265> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا حكم بالتسوية القضائية أو شهر الإفلاس بعد الوفاة ولم تكن قد حررت قائمة الجرد، أو كانت وفاة المدين حاصلة قبل إقفال قائمة الجرد ، فتحرر هذه الأخيرة أو تستكمل بحضور الورثة المعروفين أو بعد استدعائهم قانونا ."@ar ;
