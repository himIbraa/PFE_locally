<https://legal.dz/resource/order/1975-09-26/75-59#version_art_359> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز أن يحصل على رد اعتباره متى ثبتت استقامته : المدين الذي حصل على صلح وسدد الحصص الموعود بها كاملة، ويطبق هذا الحكم على الشريك المتضامن الذي حصل من الدائنين على صلح منفرد، من أثبت إبراء الدائنين له من كامل الديون وموافقتهم الاجماعية على رد اعتباره."@ar ;
