<https://legal.dz/resource/order/1975-09-26/75-59#version_art_494> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ليس لمن رفعت عليهم دعوى بموجب الشيك أن يحتجوا على حامله بدفوع مبنية على علاقاتهم الشخصية بساحبه أو بحملته السابقين ما لم يكن حامله قد تعمد الحصول على الشيك للإضرار بالمدين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_494_19750926_OpEnact_31994de4a5> ;
    dzdoc:replacementText "ليس لمن رفعت عليهم دعوى بموجب الشيك أن يحتجوا على حامله بدفوع مبنية على علاقاتهم الشخصية بساحبه أو بحملته السابقين ما لم يكن حامله قد تعمد الحصول على الشيك للإضرار بالمدين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_494> ;
