<https://legal.dz/resource/order/1975-09-26/75-59#version_art_435> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل ملزم أقيمت عليه دعوى الرجوع أو كان معرضا للرجوع يحق له أن يطلب تسليم السفتجة مع الاحتجاج وإيصال بالإبراء مقابل التسديد . وكل مظهر أوفى مبلغ السفتجة يمكنه شطب تظهيره وتظهير من تبعه فيه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_435_19750926_OpEnact_49b094628b> ;
