    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_176_obligation_0_a25ce180_ref_c071a27adec4> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_177> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_177> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_176> ;
    dznorm:position 0 ;
    dznorm:provisionText "ينبغي عليه فيما عدا الاستثناءات المنصوص عليها في المادة 177 وما يليها أن يسدد للمستأجر المخلي التعويض المسمى تعويض بالاستحقاق الذي يجب أن يكون مساويا للضرر المسبب نتيجة عدم التجديد"@ar ;
    dznorm:sourceArticle "art_176" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_176_obligation_0_a25ce180_action_84a2daeb38> a dznorm:Action ;
