<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_29> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتبر أعضاء مجلس المراقبة مسؤولين عن الأخطاء الشخصية المرتكبة أثناء ممارسة وكالتهم . ولا يتحملون أية مسؤولية بسبب أعمال التسيير ونتائجها. ويمكن اعتبارهم مسؤولين مدنيا عن الجنح التي يرتكبها أعضاء مجلس المديرين في حالة درايتهم بها وعدم إخبار الجمعية العامة بذلك . تطبق أحكام المادتين 715 مكرر 25 و 715 مكرر 26 المذكورتين أعلاه."@ar ;
