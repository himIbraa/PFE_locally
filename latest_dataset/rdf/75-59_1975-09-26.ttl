    rdfs:label "له أن يوجهه على أي"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "ومن وجب عليه توجيه إخطار يمكن له أن يوجهه على أي شكل كان ولو بمجرد ترجيع السفتجة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_430> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_430_permission_0_92120115_role_c958acbfdf> a dznorm:Role ;
    rdfs:label "أي شكل كان ولو"@ar ;
