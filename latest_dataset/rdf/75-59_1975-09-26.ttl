    dzdoc:sourceTextSpan "لا يجوز تغيير التخصيص المعين للأماكن المؤجرة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_298> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_298_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_298> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز لوكيل التفليسة الاستمرار في الإجارة أو التنازل عنها بالنسبة عن الباقي من مدتها، وذلك مع الحقوق المتعلقة بها، على أن يلتزم المدين أو المتنازل إليه بأن يحتفظ في العقار بضمان كاف وأن ينفذ في الاستحقاقات أولا بأول كافة الالتزامات القانونية أو الاتفاقية، إلا أنه لا يجوز تغيير التخصيص المعين للأماكن المؤجرة."@ar .

