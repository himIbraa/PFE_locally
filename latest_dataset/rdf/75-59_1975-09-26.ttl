<https://legal.dz/resource/order/1975-09-26/75-59#art_178_obligation_0_492862f3> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_178> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتعين عليه أن يشير في عقد رفض التجديد أو التنبيه بالإخلاء إلى أحكام الفقرة الثانية وأن يوضح الشروط الجديدة للإيجار"@ar ;
    dznorm:sourceArticle "art_178" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_178_obligation_1_ddc987cf> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_178_obligation_1_ddc987cf_ref_d9194bdf5250> ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_178_obligation_1_ddc987cf_role_a5f8d877e1> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_197> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_197> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_178> ;
    dznorm:position 1 ;
    dznorm:provisionText "ويتعين على المستأجر بعد ذلك إما أن يعلن بعقد غير قضائي عن موافقته في مدة ثلاثة أشهر، وإما أن يرفع الدعوى أمام الجهة القضائية المختصة ضمن الشروط المنصوص عليها في المادة 197"@ar ;
    dznorm:sourceArticle "art_178" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_178_obligation_1_ddc987cf_ref_d9194bdf5250> a dzdoc:Reference ;
    rdfs:label "المادة 197"@ar ;
    dzdoc:frbrUri "#art_197"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1975-09-26/75-59#art_197> ;
    dzdoc:sourceEId "art_178" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "ويتعين على المستأجر بعد ذلك إما أن يعلن بعقد غير قضائي عن موافقته في مدة ثلاثة أشهر، وإما أن يرفع الدعوى أمام الجهة القضائية المختصة ضمن الشروط المنصوص عليها في المادة 197"@ar ;
    dzdoc:targetEId "art_197" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_178_obligation_1_ddc987cf_role_a5f8d877e1> a dznorm:Role ;
    rdfs:label "المستأجر بعد ذلك إما"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "ويتعين على المستأجر بعد ذلك إما أن يعلن بعقد غير قضائي عن موافقته في مدة ثلاثة أشهر، وإما أن يرفع الدعوى أمام الجهة القضائية المختصة ضمن الشروط المنصوص عليها في المادة 197"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_178> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_178_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_178> ;
    dzdoc:position 0 ;
    dzdoc:text "للمؤجر الحق في رفض تجديد الإيجار لبناء أو إعادة بناء العمارة الموجودة شريطة أن يسدد للمستأجر المخلي المحل تعويض الإخلاء المنصوص عليه في المادة 176."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_178_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_178> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أنه يجوز للمؤجر أن يتخلص من دفع هذا التعويض بعرضه على المستأجر المخلي محلا موافقا لحاجاته وإمكانياته وموجودا بمكان مماثل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_178_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_178> ;
    dzdoc:position 2 ;
    dzdoc:text "ويقبض المستأجر عند الاقتضاء تعويض الضرر عن حرمانه المؤقت من الانتفاع ومن نقص قيمة متجره، وبالإضافة إلى ذلك تسدد له مصاريف النقل العادية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_178_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_178> ;
    dzdoc:position 3 ;
    dzdoc:text "وإذا تمسك المؤجر بالاستفادة من هذه المادة يتعين عليه أن يشير في عقد رفض التجديد أو التنبيه بالإخلاء إلى أحكام الفقرة الثانية وأن يوضح الشروط الجديدة للإيجار، ويتعين على المستأجر بعد ذلك إما أن يعلن بعقد غير قضائي عن موافقته في مدة ثلاثة أشهر، وإما أن يرفع الدعوى أمام الجهة القضائية المختصة ضمن الشروط المنصوص عليها في المادة 197."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_178_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_178> ;
    dzdoc:position 4 ;
    dzdoc:text "أما إذا كان الطرفان غير متفقين حول شروط الإيجار الجديد فقط، فإن هذه الشروط تحدد وفقا للإجراء المنصوص عليه في المادة 195."@ar .

