<https://legal.dz/resource/order/1975-09-26/75-59#version_art_719> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن مصاريف تأسيس الشركة تستهلك قبل كل توزيع للأرباح ، مع مراعاة الفقرة الثانية من المادة 725 . وتستهلك مصاريف زيادة رأس المال على الأكثر عند انقضاء السنة المالية الخامسة والتالية للسنة المالية التي صرفت خلالها. ويسوغ خصم هذه المصاريف من مبلغ علاوات الإصدار المتعلقة بهذه الزيادة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
