<https://legal.dz/resource/order/1975-09-26/75-59#art_811_obligation_0_98a503ff> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_811> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من سنة واحدة إلى خمس سنوات وبغرامة من 20.000 دج إلى 200.000 دج أو بإحدى هاتين العقوبتين فقط"@ar ;
    dznorm:sourceArticle "art_811" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_811_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_811> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من سنة واحدة إلى خمس سنوات وبغرامة من 20.000 دج إلى 200.000 دج أو بإحدى هاتين العقوبتين فقط: رئيس شركة المساهمة والقائمون بإدارتها ومديروها العامون الذين يباشرون عمدا توزيع أرباح صورية على المساهمين دون تقديم قائمة للجرد أو بتقديم قوائم جرد مغشوشة، رئيس شركة المساهمة والقائمون بإدارتها أو مديروها العامون الذين يتعمدون نشر أو تقديم ميزانية للمساهمين غير مطابقة للواقع، لإخفاء حالة الشركة الحقيقية ولو في حالة عدم وجود توزيع للأرباح، رئيس شركة المساهمة والقائمون بإدارتها أو مديروها العامون الذين يستعملون عن سوء نية أموال الشركة أو سمعتها في غايات يعلمون أنها مخالفة لمصلحتها لأغراض شخصية أو لتفضيل شركة أو مؤسسة أخرى لهم فيها مصالح مباشرة أو غير مباشرة، رئيس شركة المساهمة والقائمون بإدارتها أو مديروها العامون الذين يستعملون عن سوء نية وبهذه الصفة ما لهم من السلطة أو حق في التصرف في الأصوات استعمالا يعلمون أنه مخالف لمصالح الشركة لبلوغ أغراض شخصية أو لتفضيل شركة أو مؤسسة أخرى لهم فيها مصالح مباشرة أو غير مباشرة."@ar .

