<https://legal.dz/resource/order/1975-09-26/75-59#version_art_822> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بغرامة من 20.000 دج إلى 200.000 دج رئيس شركة المساهمة و القائمون بإدارتها الذين أصدروا وقت زيادة رأس المال أسهما: أ) إما قبل تعديل القانون الأساسي الناتج عن تلك الزيادة في رأس المال قد وقع تسجيل معدل في السجل التجاري، ب) إذا وقع تسجيل هذا التعديل عن طريق التدليس في أي زمن كان، ج) وإما قبل أن تنتهي بصفة منتظمة إجراءات تكوين هذه الشركة أو زيادة رأسمالها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_822_19750926_OpEnact_1362217a67> ;
