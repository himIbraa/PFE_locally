<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_87" ;
    dzdoc:fullText "لا يجوز للشركة تكوين أي رهن على سندات استحقاقها الذاتية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_87_permission_0_148a91a6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_87> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_87_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_87_19750926_OpEnact_07e121e7aa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_87_obligation_0_148a91a6> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_87_prohibition_0_148a91a6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 87" ;
    dzdoc:position 861 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_96" ;
    dzdoc:fullText "يحق لكل صاحب سندات استحقاق المشاركة في الجمعية أو أن يمثله وكيل من اختياره لا يكون موضوع أي منع . لا يجوز للشركة التي تحوز نسبة 10% على الأقل من رأسمال الشركة المدينة أن تصوت في الجمعية بما تملكه من سندات الاستحقاق ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_96_permission_0_c02320c3> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_96_right_0_fa96f083> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_96_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_96_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_96_19750926_OpEnact_c2b2b044ba> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_96_obligation_0_ecf56040> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_96_prohibition_0_c02320c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 96" ;
    dzdoc:position 870 ;
    dzdoc:usesTerm dzterm:bondholders .

<https://legal.dz/resource/order/1975-09-26/75-59#art_721> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_721" ;
    dzdoc:fullText "في الشركات ذات المسؤولية المحدودة والشركات المساهمة يقتطع من الأرباح سندات نصف العشر على الأقل وتطرح منها عند الاقتضاء الخسائر السابقة، ويخصص هذا الاقتطاع لتكوين مال احتياطي يدعى { احتياطي قانوني } وذلك تحت طائلة بطلان كل مداولة مخالفة. ويصبح اقتطاع هذا الجزء غير إلزامي إذا بلغ الاحتياطي عشر رأس المال."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_721> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_721_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_721_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_721_19750926_OpEnact_6e9bd3a999> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_721_obligation_0_a0a31cd3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "721" ;
    dzdoc:position 923 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_721_condition_0_650be572> ;
    dzdoc:usesTerm dzterm:legal_reserve .

<https://legal.dz/resource/order/1975-09-26/75-59#art_739> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_739" ;
    dzdoc:fullText "إذا كان بطلان أعمال ومداولات لاحقة لتأسيس الشركة مبنيا على مخالفة قواعد النشر ، لكل شخص يهمه أمر تصحيح العمل أن ينذر الشركة بالقيام بهذا التصحيح في أجل ثلاثين يوما . و إذا يقع التصحيح في هذا الأجل ، يجوز لكل شخص يهمه الأمر أن يطلب من القضاء تعيين وكيل يكلف بالقيام بهذا الإجراء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_739_permission_0_b7af8404> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_739_right_0_e61cce85>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_739_right_1_5773fdef> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_739> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_739_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_739_19750926_OpEnact_e546ba4d7a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 739" ;
    dzdoc:position 946 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_739_condition_0_0921042a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_739_condition_1_af8dcd1b> ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_757> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_757" ;
    dzdoc:fullText "يجوز كذلك لمؤجري الأماكن المؤجرة للشركات المدمجة أو المنفصلة أن يقدموا معارضة على الإدماج أو الانفصال في الأجل المحدد في الفقرة الثانية من المادة 736 ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_757_permission_0_e48af44d> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_757_right_0_9e3abf2a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_757> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_757_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_757_19750926_OpEnact_1f5fd57295> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 757" ;
    dzdoc:position 964 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_736> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_736> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_781> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_781" ;
    dzdoc:fullText "إذا لم يوجد مندوبو الحسابات، ولو في الشركات غير الملتزمة بتعيينهم ، يجوز تعيين مراقب واحد أو أكثر من طرف الشركات طبقا للشروط المنصوص عليها في الفقرة الأولى من المادة 781 . وفي حالة انعدام ذلك يمكن تعيينهم من رئيس المحكمة حالة فصله وبعد إجراء بحث بناء على طلب المصفي، أو عن طريق دعوى مستعجلة بطلب كل من يهمه الأمر ، وذلك بعد استدعاء المصفي قانونيا. يحدد في أمر تسمية المراقبين سلطاتهم وواجباتهم وأجورهم وكذلك مدة مهامهم. وتجري عليهم نفس المسؤولية الملقاة على عاتق مندوبي الحسابات . وفي جميع الأحوال ينشر هذا الأمر بنفس الشروط والآجال الخاصة بالمصفين والمنصوص عليها في المادة 767 ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_781_permission_0_b8f10f1f>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_781_permission_1_bfce0ffa> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_781> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_781_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_781_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_781_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_781_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_781_19750926_OpEnact_dbf00fa302> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "781" ;
    dzdoc:position 988 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_767>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_781> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_767>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_781> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_781_condition_0_cbeaed85> ;
    dzdoc:usesTerm dzterm:auditors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_823> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_823" ;
    dzdoc:fullText "يعاقب بغرامة من 20.000 دج إلى 400.000 دج رئيس شركة المساهمة و القائمون بإدارتها و مديروها العامون والذين لم يقوموا عند زيادة رأس المال : 1- بإفادة المساهمين حسب نسبة الأسهم التي يملكونها للتمتع ب حق الأفضلية في الاكتتاب بالأسهم النقدية ، 2- الذين لم يتركوا للمساهمين أجل ثلاثين يوما على الأقل ابتداء من تاريخ افتتاح الاكتتاب ليمارسوا حقهم في الاكتتاب 3- الذين لم يقوموا بتوزيع الأسهم التي أصبحت متوفرة على المساهمين بسبب عدم وجود عدد كاف من الاكتتابات التفاضلية على المساهمين الذين اكتتبوا في الأسهم القابلة للنقص وعددا من الأسهم يفوق العدد الذي يجوز لهم الاكتتاب فيه عن طريق التفضيل بالنسبة لما يملكونه من حقوق. لا تطبق أحكام هذه المادة في حالة إلغاء الجمعية العامة لحق الأفضلية في الاكتتاب ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_823_permission_0_b0babd01> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_823_right_0_3e8b8864> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_823> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_823_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_823_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_823_19750926_OpEnact_e705dfd380> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_823_obligation_0_bc322ddc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "823" ;
    dzdoc:position 1040 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_823_condition_0_53523f7b> ;
    dzdoc:usesTerm dzterm:chairman,
        dzterm:directors,
        dzterm:general_managers .

dzterm:chairman a skos:Concept,
