<https://legal.dz/resource/order/1975-09-26/75-59#version_art_575> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تأذن جمعية الشركاء بتخفيض رأسمال الشركة حسب الشروط المنصوص عليها لتعديل القانون الأساسي . ولا يجوز بأي حال من الأحوال أن يمس هذا التخفيض بمساواة الشركاء. إذا قررت الجمعية تخفيض رأس المال من دون أن يكون ذلك مبرر بخسائر ، فإن للدائنين الذين كان حقهم سابقا لتاريخ إيداع محضر المداولات بكتابة ضبط المحكمة، أن يرفعوا معارضة في هذا التخفيض في أجل شهر اعتبارا من يوم هذا الإيداع ويحكم القضاء برفض المعارضة أو يأمر إما بتسديد الديون أو بتكوين الضمانات إذا عرضتها الشركة وإذا اعتبرت كافية ولا يسوغ ابتداء عملي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_575_19750926_OpEnact_905a3c5912> ;
    dzdoc:replacementText "تأذن جمعية الشركاء بتخفيض رأسمال الشركة حسب الشروط المنصوص عليها لتعديل القانون الأساسي . ولا يجوز بأي حال من الأحوال أن يمس هذا التخفيض بمساواة الشركاء. إذا قررت الجمعية تخفيض رأس المال من دون أن يكون ذلك مبرر بخسائر ، فإن للدائنين الذين كان حقهم سابقا لتاريخ إيداع محضر المداولات بكتابة ضبط المحكمة، أن يرفعوا معارضة في هذا التخفيض في أجل شهر اعتبارا من يوم هذا الإيداع ويحكم القضاء برفض المعارضة أو يأمر إما بتسديد الديون أو بتكوين الضمانات إذا عرضتها الشركة وإذا اعتبرت كافية ولا يسوغ ابتداء عمليات تخفيض رأس المال أثناء أجل المعارضة. يحظر شراء حصصها الخاصة من قبل شركة غير أنه يجوز للجمعية التي قررت التخفيض من رأس المال من دون تبرير ذلك بخسائر ، أن تأذن للمدير بشراء عدد معين من الحصص لإبطالها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_575> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_575> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_576> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يدير الشركة ذات المسؤولية المحدودة شخص أو عدة أشخاص طبيعيين. ويجوز اختيارهم خارجا عن الشركاء. ويعينهم الشركاء في القانون الأساسي أو بعقد لاحق حسب الشروط المنصوص عليها في الفقرة الأولى من المادة 582 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_576_19750926_OpEnact_b121631adb> ;
    dzdoc:replacementText "يدير الشركة ذات المسؤولية المحدودة شخص أو عدة أشخاص طبيعيين. ويجوز اختيارهم خارجا عن الشركاء. ويعينهم الشركاء في القانون الأساسي أو بعقد لاحق حسب الشروط المنصوص عليها في الفقرة الأولى من المادة 582 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_576> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_576> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
