    dznorm:conditionText "وإذا وجب القيام بأحد هذه الإجراءات في أجل معين يوافق آخر يوم منه يوم عيد رسمي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_462> ;
    dznorm:position 1 .

