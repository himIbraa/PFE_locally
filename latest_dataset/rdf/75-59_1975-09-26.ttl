<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا_2> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعين الجمعية العامة العادية وفقا للشروط المحددة في القانون الأساسي، مجلسا للمراقبة يتكون من ثلاثة (03) مساهمين على الأقل. لا يجوز أن يكون الشريك المتضامن عضوا في مجلس المراقبة وذلك تحت طائلة بطلان تعيينه. ولا يجوز للمساهمين الذين لهم صفة شريك متضامن أن يشاركوا في تعيين أعضاء مجلس المراقبة . تكون القواعد المتعلقة بتعيين القائمين بالإدارة بشركات المساهمة ومدة مهمتهم قابلة للتطبيق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715___2_19750926_OpEnact_827787f34a> ;
    dzdoc:replacementText "تعين الجمعية العامة العادية وفقا للشروط المحددة في القانون الأساسي، مجلسا للمراقبة يتكون من ثلاثة (03) مساهمين على الأقل. لا يجوز أن يكون الشريك المتضامن عضوا في مجلس المراقبة وذلك تحت طائلة بطلان تعيينه. ولا يجوز للمساهمين الذين لهم صفة شريك متضامن أن يشاركوا في تعيين أعضاء مجلس المراقبة . تكون القواعد المتعلقة بتعيين القائمين بالإدارة بشركات المساهمة ومدة مهمتهم قابلة للتطبيق."@ar ;
