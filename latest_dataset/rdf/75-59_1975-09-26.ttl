<https://legal.dz/resource/order/1975-09-26/75-59#art_85_obligation_0_414d765b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_85_obligation_0_414d765b_ref_a43a8de9fa45> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_83> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_83> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_85> ;
    dznorm:position 0 ;
    dznorm:provisionText "ابتداء من البيع وإلى انقضاء مهلة عشرين يوما من آخر يوم من الإعلانات المنصوص عليها في المادة 83 يحتفظ بنسخة من عقد البيع في محل الإقامة المختار توضع تحت تصرف كل دائن معارض أو مقيد لمراجعتها دون حاجة للانتقال."@ar ;
    dznorm:sourceArticle "art_85" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_85_obligation_0_414d765b_ref_a43a8de9fa45> a dzdoc:Reference ;
    rdfs:label "المادة 83"@ar ;
    dzdoc:frbrUri "#art_83"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1975-09-26/75-59#art_83> ;
    dzdoc:sourceEId "art_85" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "ابتداء من البيع وإلى انقضاء مهلة عشرين يوما من آخر يوم من الإعلانات المنصوص عليها في المادة 83 يحتفظ بنسخة من عقد البيع في محل الإقامة المختار توضع تحت تصرف كل دائن معارض أو مقيد لمراجعتها دون حاجة للانتقال."@ar ;
    dzdoc:targetEId "art_83" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_85_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_85> ;
    dzdoc:position 0 ;
    dzdoc:text "ابتداء من البيع وإلى انقضاء مهلة عشرين يوما من آخر يوم من الإعلانات المنصوص عليها في المادة 83 يحتفظ بنسخة من عقد البيع في محل الإقامة المختار توضع تحت تصرف كل دائن معارض أو مقيد لمراجعتها دون حاجة للانتقال."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_85_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_85> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجوز في نفس المهلة لكل دائن مقيد أو دائن قدم معارضة في مهلة الخمسة عشر يوما المنصوص عليها في المادتين 83 و 84 أن يطلع في محل الإقامة المختار على عقد البيع والمعارضات وإذا كان الثمن لا يفي بديون الدائنين المقيدين والدائنين القائمين بالمعارضة في خلال خمسة عشر يوما على الأكثر والتالية لآخر يوم من الإعلانات المنصوص عليها في المادتين 83 و 84 ، فيمكنهم طبقا لشروط الواردة في المواد من 133 إلى 139 طلب زيادة السدس أصلا عن المحل التجاري دون المعدات والبضائع."@ar .

