    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تلغى التعاقدات أيضا مهما كان شكلها إذا كانت ترمي إلى منع المستأجر من التنازل عن إيجاره لمشتري محله التجاري أو مؤسسته ، وكذلك الاتفاقيات التي تجعل مشتري المتجر خاضعا لقبول المالك"@ar ;
