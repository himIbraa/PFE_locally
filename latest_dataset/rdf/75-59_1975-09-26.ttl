<https://legal.dz/resource/order/1975-09-26/75-59#art_143_obligation_1_5960152f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_143> ;
    dznorm:position 1 ;
    dznorm:provisionText "وأن يحتفظوا بفهرس أبجدي بأسماء المدينين مع بيان أرقام القيد التي تخصهم"@ar ;
    dznorm:sourceArticle "art_143" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_143_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_143> ;
    dzdoc:position 0 ;
    dzdoc:text "يتعين على مأموري السجل التجاري المشار إليهم أعلاه، أن يلتزموا بتنفيذ المواد 96 و97 و 101 و109 إلى 116 و 120 وأن يقوموا بحزم وجمع جداول قيد الامتياز الناتج عن عقد الرهن الحيازي للمحل التجاري."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_143_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_143> ;
    dzdoc:position 1 ;
    dzdoc:text "وأن يحتفظوا بفهرس أبجدي بأسماء المدينين مع بيان أرقام القيد التي تخصهم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_143_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_143> ;
    dzdoc:position 2 ;
    dzdoc:text "وتقدم الورقة التي تثبت عليها الجداول، من قبل مأموري السجل التجاري، على نفقة من يطلبها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_144_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_144> ;
    dzdoc:position 0 ;
    dzdoc:text "يثبت إيداع عقد البيع أو الرهن الحيازي للمحل التجاري المنصوص عليه في المادتين 98 و99 في دفتر خاص من طرف - مأموري السجل التجاري."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_144_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_144> ;
    dzdoc:position 1 ;
    dzdoc:text "يقسم هذا الدفتر إلى عمودين : يشتمل العمود الأول على رقم ترتيبي للدفتر، ويسجل في العمود الثاني محضر الإيداع يتضمن تاريخ الإيداع، وبيان تاريخ وكلفة تسجيل العقد ورقم وروده ونوعه وبيان اسم الدائن والمدين أو البائع والمشتري ونوع المحل التجاري وعنوانه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_144_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_144> ;
    dzdoc:position 2 ;
    dzdoc:text "ويوقع مأمورو السجل التجاري على هذا المحضر و بعد إتمام دفتر الإيداع بالفهرس الأبجدي وأسماء المدينين أو البائعين يرقم ويوقع عليه باختصار ثم يقفل كما هو مبين في المادة 142 السابقة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_145_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_145> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم التصريح بالدين في الموطن المختار تنفيذا للمادة 117 من هذا القانون في نسختين تتضمن كل منهما التاريخ الذي تم فيه التصريح، واسم المصرح ، واسم وعنوان المدين مع بيان نوع ومقر المحل التجاري الذي يملكه المدين و مبلغ الدين وبيان مقدار حصة المحل التجاري المقدمة للشركة التي يجب بيان نوعها ومقرها، وعند الاقتضاء تاريخ ورقم عقد إنشاء هذه الشركة وكذلك تاريخ إيداعه بالمركز الوطني للسجل التجاري."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_145_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_145> ;
    dzdoc:position 1 ;
    dzdoc:text "ويرفق إحدى النسختين بالعقد المثبت للحصة وتسلم النسخة الثانية للمصرح بعد التأشير عليها من طرف محرر العقد، لتكون بمثابة إيصال له."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_146_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_146> ;
    dzdoc:position 0 ;
    dzdoc:text "تعرض على رئيس المحكمة في شهر ديسمبر من كل سنة، الدفاتر المنصوص عليها في المواد أعلاه، وبعد مراجعة محتواها والتأكد من أن القيد قد اتبع على وجه الدقة، يصادق عليها في ذيل آخر قيد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_147_condition_0_23677556> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_147_condition_0_23677556_role_69be1f2602>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_147_condition_0_23677556_role_a687bd542e> ;
    dznorm:conditionText "إذا كانت البيوع أو التنازلات عن المحلات التجارية تشتمل على علامات المصنع أو التجارة أو الرسوم أو النماذج الصناعية، وكانت رهون هذه المحلات تشتمل على براءات اختراع أو رخص أو علامات أو رسوم أو نماذج"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_147> ;
    dznorm:position 0 .

