<https://legal.dz/resource/order/1975-09-26/75-59#version_art_142> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعطى لكل الأوراق المشار إليها في المادتين 98 و 99 أعلاه وكذلك كل الأوراق الأخرى المقدمة إلى المركز الوطني للسجل التجاري بالنظر في الأحكام التجارية، رقم إيداع عند تقديمها . وتسجل هذه الوثائق فيما بعد بدفتر ذي أرومة يسلم منه وصل مستخرج من الدفتر المذكور يتضمن ما يلي : 1 - رقم الإيداع، يدرج على الوثائق طبقا لما هو مبين في الفقرة الأولى أعلاه. 2 - تاريخ إيداع الوثائق 3 - عدد عدد ونوع هذه الوثائق مع بيان الهدف من الإيداع، 4 - لقب الأطراف، 5 - نوع المحل التجاري ومقره. يمضي ويؤرخ الوصل من مأموري السجل "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_142_19750926_OpEnact_dc2336a0ab> ;
    dzdoc:replacementText "يعطى لكل الأوراق المشار إليها في المادتين 98 و 99 أعلاه وكذلك كل الأوراق الأخرى المقدمة إلى المركز الوطني للسجل التجاري بالنظر في الأحكام التجارية، رقم إيداع عند تقديمها . وتسجل هذه الوثائق فيما بعد بدفتر ذي أرومة يسلم منه وصل مستخرج من الدفتر المذكور يتضمن ما يلي : 1 - رقم الإيداع، يدرج على الوثائق طبقا لما هو مبين في الفقرة الأولى أعلاه. 2 - تاريخ إيداع الوثائق 3 - عدد عدد ونوع هذه الوثائق مع بيان الهدف من الإيداع، 4 - لقب الأطراف، 5 - نوع المحل التجاري ومقره. يمضي ويؤرخ الوصل من مأموري السجل التجاري الذي يقوم بتسليمه مقابل الوثيقة المتضمنة طبقا للمادة 101 ما يثبت بأن الامتياز قد تحقق. يوقع على الصفحة الأولى والأخيرة من الدفتر كما ترقم ويوقع باختصار على كافة صفحاته من طرف رئيس المحكمة، ويجرى قفله كل يوم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_142> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_142> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_143> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتعين على مأموري السجل التجاري المشار إليهم أعلاه، أن يلتزموا بتنفيذ المواد 96 و 97 و 101 و 109 إلى 116 و 120 وأن يقوموا بحزم وجمع جداول قيد الامتياز الناتج عن عقد الرهن الحيازي للمحل التجاري . وأن يحتفظوا بفهرس أبجدي بأسماء المدينين مع بيان أرقام القيد التي تخصهم . وتقدم الورقة التي تثبت عليها الجداول، من قبل مأموري السجل التجاري ، على نفقة من يطلبها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_143_19750926_OpEnact_df44a42318> ;
    dzdoc:replacementText "يتعين على مأموري السجل التجاري المشار إليهم أعلاه، أن يلتزموا بتنفيذ المواد 96 و 97 و 101 و 109 إلى 116 و 120 وأن يقوموا بحزم وجمع جداول قيد الامتياز الناتج عن عقد الرهن الحيازي للمحل التجاري . وأن يحتفظوا بفهرس أبجدي بأسماء المدينين مع بيان أرقام القيد التي تخصهم . وتقدم الورقة التي تثبت عليها الجداول، من قبل مأموري السجل التجاري ، على نفقة من يطلبها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_143> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_143> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
