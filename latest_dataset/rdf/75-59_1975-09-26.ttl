    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_237> ;
    dznorm:position 0 ;
    dznorm:provisionText "تودع أوامر القاضي المنتدب فورا بكتابة ضبط المحكمة"@ar ;
    dznorm:sourceArticle "art_237" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_237_obligation_1_467a6907> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_237_obligation_1_467a6907_action_1bfcdfb84a> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_237> ;
    dznorm:position 1 ;
    dznorm:provisionText "ويعين القاضي المنتدب في الأمر الذي يصدره الأشخاص الذين يجب إخبارهم بالإيداع بمعرفة كاتب ضبط المحكمة"@ar ;
    dznorm:sourceArticle "art_237" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_237_obligation_1_467a6907_action_1bfcdfb84a> a dznorm:Action ;
    rdfs:label "إخبارهم بالإيداع بمعرفة كاتب ضبط"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "ويعين القاضي المنتدب في الأمر الذي يصدره الأشخاص الذين يجب إخبارهم بالإيداع بمعرفة كاتب ضبط المحكمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_237> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_237_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_237> ;
    dzdoc:position 0 ;
    dzdoc:text "تودع أوامر القاضي المنتدب فورا بكتابة ضبط المحكمة، ويجوز المعارضة خلال عشرة أيام من حصول الإيداع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_237_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_237> ;
    dzdoc:position 1 ;
    dzdoc:text "ويعين القاضي المنتدب في الأمر الذي يصدره الأشخاص الذين يجب إخبارهم بالإيداع بمعرفة كاتب ضبط المحكمة، وحينئذ يجوز لأولئك الأشخاص رفع المعارضة في مهلة عشرة أيام من ذلك الإخبار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_237_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_237> ;
    dzdoc:position 2 ;
    dzdoc:text "ترفع المعارضة بمجرد تصريح لدى كتابة ضبط المحكمة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_237_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_237> ;
    dzdoc:position 3 ;
    dzdoc:text "وتفصل فيها المحكمة في أول جلسة لها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_237_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_237> ;
    dzdoc:position 4 ;
    dzdoc:text "وللمحكمة أن تنظر تلقائيا في أوامر القاضي المنتدب فتعدلها أو تبطلها خلال عشرة أيام اعتبارا من إيداعها بكتابة ضبط المحكمة."@ar .

