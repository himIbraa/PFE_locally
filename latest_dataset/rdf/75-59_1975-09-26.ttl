<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_118_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_118> ;
    dzdoc:position 0 ;
    dzdoc:text "يؤدي ترخيص الجمعية العامة لفائدة أصحاب سندات الاستحقاق، إلى التنازل الصريح للمساهمين عن حقهم التفضيلي في الاكتتاب في الأسهم التي تصدر بموجب تحویل سندات الاستحقاق."@ar .

