<https://legal.dz/resource/order/1975-09-26/75-59#version_art_716> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عند قفل كل سنة مالية، يضع مجلس الإدارة أو القائمون بالإدارة، جردا بمختلف عناصر الأصول والديون الموجودة في ذلك التاريخ. ويضعون أيضا حساب الاستغلال العام وحساب النتائج والميزانية. ويضعون تقريرا مكتوبا عن حالة الشركة ونشاطها أثناء السنة المالية المنصرمة. وتوضع المستندات المشار إليها في هذه المادة تحت تصرف مندوبي الحسابات خلال الأربعة أشهر على الأكثر والتالية لقفل السنة المالية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_716_19750926_OpEnact_f3baefd340> ;
    dzdoc:replacementText "عند قفل كل سنة مالية، يضع مجلس الإدارة أو القائمون بالإدارة، جردا بمختلف عناصر الأصول والديون الموجودة في ذلك التاريخ. ويضعون أيضا حساب الاستغلال العام وحساب النتائج والميزانية. ويضعون تقريرا مكتوبا عن حالة الشركة ونشاطها أثناء السنة المالية المنصرمة. وتوضع المستندات المشار إليها في هذه المادة تحت تصرف مندوبي الحسابات خلال الأربعة أشهر على الأكثر والتالية لقفل السنة المالية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_716> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
