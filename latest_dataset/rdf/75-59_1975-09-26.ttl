<https://legal.dz/resource/order/1975-09-26/75-59#version_art_755> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تحقق الإدماج عن طريق إنشاء شركة جديدة ، فإنه يمكن أن تتكون هذه الشركة دون حصص أخرى غير تلك التي تكونت من جراء الإدماج . وفي هذه الحالة يجوز لمساهمي هذه الشركات أن يجتمعوا بحكم القانون في جمعية عامة تأسيسية للشركة الجديدة الناشئة عن طريق الإدماج ، أما بالنسبة للإجراءات فإنها تتبع طبقا للأحكام التي تنظم تكوين الشركات المساهمة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_755_19750926_OpEnact_f40f12e7f5> ;
    dzdoc:replacementText "إذا تحقق الإدماج عن طريق إنشاء شركة جديدة ، فإنه يمكن أن تتكون هذه الشركة دون حصص أخرى غير تلك التي تكونت من جراء الإدماج . وفي هذه الحالة يجوز لمساهمي هذه الشركات أن يجتمعوا بحكم القانون في جمعية عامة تأسيسية للشركة الجديدة الناشئة عن طريق الإدماج ، أما بالنسبة للإجراءات فإنها تتبع طبقا للأحكام التي تنظم تكوين الشركات المساهمة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_755> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
