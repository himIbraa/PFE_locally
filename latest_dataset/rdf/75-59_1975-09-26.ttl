<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_105> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_105" ;
    dzdoc:fullText "يجب أن يتم تكوين ضمانات خاصة من الشركة المصدرة بواسطة سندات الاستحقاق قبل إصدار هذه السندات . تنشئ الأجهزة المؤهلة للشركة هذه الضمانات لفائدة جماعة أصحاب سندات الاستحقاق. يترتب عن الضمانات القيام بإشهار قبل كل اكتتاب حسب الكيفيات المحددة عن طريق التنظيم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_105> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_105_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_105_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_105_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_105_19750926_OpEnact_66f5d9b5b7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_105_obligation_0_004409c4>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_105_obligation_1_cebf5b30> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 105" ;
    dzdoc:position 879 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_116> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_6> ;
    dzdoc:eId "art_715_bis_116" ;
    dzdoc:fullText "ترخص الجمعية العامة غير العادية أو تقرر بناء على تقرير مجلس الإدارة أو مجلس المراقبة أو مجلس المديرين ، وعلى تقرير خاص ل مندوب الحسابات يتعلق بأسس التحويل، إصدار سندات استحقاق قابلة للتحويل إلى أسهم ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_116_right_0_2a6a7836> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_116> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_116_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_116_19750926_OpEnact_74655440e3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 116" ;
    dzdoc:position 890 ;
    dzdoc:usesTerm dzterm:auditor,
        dzterm:board_of_directors,
        dzterm:general_assembly,
        dzterm:management_board,
        dzterm:supervisory_board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_10> ;
    dzdoc:eId "art_715_bis_23" ;
    dzdoc:fullText "يعد القائمون بالإدارة مسؤولين على وجه الإنفراد أو بالتضامن، حسب الحالة، تجاه الشركة أو الغير، إما عن المخالفات الماسة بالأحكام التشريعية أو التنظيمية المطبقة على شركات المساهمة، وإما عن خرق القانون الأساسي أو عن الأخطاء المرتكبة أثناء تسييرهم . إذا شارك عدد كبير من القائمين بالإدارة في نفس الأفعال ، فإن المحكمة تحدد حصة كل واحد في تعويض الضرر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_23_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_23_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_23_19750926_OpEnact_7005c28497> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_23_obligation_0_29213068> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 23" ;
    dzdoc:position 797 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_23_condition_0_510dc19b> ;
    dzdoc:usesTerm dzterm:directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_1> ;
    dzdoc:eId "art_715_bis_33" ;
    dzdoc:fullText "يمكن شركات المساهمة أن تصدر ما يأتي: 1- سندات كتمثيل لرأسمالها، 2- سندات كتمثيل لرسوم الديون التي على ذمتها، 3- سندات تعطي الحق في منح سندات أخرى تمثل حصة معينة لرأسمال الشركة عن طريق التحويل أو التسديد أو أي إجراء آخر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_33_permission_0_035edd81> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_33_right_0_d41f9a7a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_33_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_33_19750926_OpEnact_8843dfb123> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 33" ;
    dzdoc:position 807 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_41> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:cash_shares,
        dzterm:in_kind_shares ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_41" ;
    dzdoc:fullText "تعتبر أسهما نقدية : الأسهم التي تم وفاؤها نقدا أو عن طريق المقاصة، والأسهم التي تصدر بعد ضمها إلى رأس المال الاحتياطي أو الأرباح أو علاوة الإصدار، الأسهم التي يتكون مبلغها في جزء منه نتيجة ضمه في الاحتياطات أو الفوائد أو علاوات الإصدار وفي جزء منه عن طريق الوفاء نقدا. ويجب أن يتم وفاء هذه الأخيرة بتمامها عند الاكتتاب . أما جميع الأسهم الأخرى فتعد من الأسهم العينية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_41> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_41_defocc_451e407fb590>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_41_defocc_a5ec9c751192> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_41_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_41_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_41_19750926_OpEnact_253ca8a5ab> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_41_obligation_0_f9300bf3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 41" ;
    dzdoc:position 815 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_47" ;
    dzdoc:fullText "يتعين على المساهم أن يسدد المبالغ المرتبطة بالأسهم التي قام باكتتابها حسب الكيفيات المنصوص عليها في القانون والقانون الأساسي للشركة . وفي غياب ذلك ، تتابع الشركة بعد شهر من طلب الدفع الموجه إلى المساهم المتخلف ببيع هذه الأسهم. وتحدد كيفيات تطبيق هذا المقطع عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_47_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_47_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_47_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_47_19750926_OpEnact_1fe715c811> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_47_obligation_0_a4463457> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 47" ;
    dzdoc:position 821 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_47_condition_0_ecfe6cc4> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_3> ;
    dzdoc:eId "art_715_bis_70" ;
    dzdoc:fullText "في حالة زيادة نقدية في رأس المال ، تصدر شهادات استثمار جديدة بعدد يحافظ فيه على التناسب الذي كان قائما قبل الزيادة بين الأسهم العادية وشهادات الاستثمار بعد الزيادة التي يفترض تحققها كاملا. لمالكي شهادات الاستثمار ، حق الأفضلية في الاكتتاب بما يتناسب وعدد السندات التي يمتلكونها، بصفة غير قابلة للتخفيض في شهادات الاستثمار الجديدة ، و يجوز لمالكي شهادات الاستثمار التنازل عن هذا الحق ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_70_right_0_710bc9ba>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_70_right_1_350e4b87> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_70_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_70_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_70_19750926_OpEnact_0ff83d1fba> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 70" ;
    dzdoc:position 844 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_70_condition_0_0d03a9b5> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_88" ;
    dzdoc:fullText "يكون حاملو سندات الاستحقاق من نفس الإصدار جماعة، بقوة القانون، للدفاع عن مصالحهم المشتركة. وتتمتع هذه الجماعة بالشخصية المعنوية. يمكن الجمعية العامة لأصحاب سندات الاستحقاق أن تجتمع في كل وقت."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_88_permission_0_9fc158e4> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_88_right_0_9fc158e4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_88_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_88_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_88_19750926_OpEnact_3854f58264> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 88" ;
    dzdoc:position 862 ;
    dzdoc:usesTerm dzterm:سندات_الاستحقاق .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_92> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_92" ;
    dzdoc:fullText "يمكن في حالة الاستعجال تعيين ممثلي أصحاب سندات الاستحقاق بموجب حكم قضائي بناء على طلب كل معني."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_92_permission_0_e7734fcb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_92> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_92_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_92_19750926_OpEnact_9e55ace537> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 92" ;
    dzdoc:position 866 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_92_condition_0_f2cf0ba5> ;
    dzdoc:usesTerm dzterm:bondholders .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_bis> ;
    dzdoc:eId "art_715_ثالثا_6" ;
    dzdoc:fullText "تكون الجمعية العامة العادية وحدها المخولة بمنح أجرة للمسير غير تلك المنصوص عليها في القانون الأساسي. ولا يمكن منح هذه الأجرة إلا بموافقة الشركاء المتضامنين بالإجماع ، إلا إذا كان هناك شرط مخالف."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_6_permission_0_af219f54> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_6_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_6_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715___6_19750926_OpEnact_155c4b0f92> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 ثالثا 6" ;
    dzdoc:position 913 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_6_condition_0_926edd8f> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_717> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_717" ;
    dzdoc:fullText "يتم حساب الاستغلال العام وحساب النتائج والميزانية في كل سنة مالية حسب نفس الأشكال ونفس الطرق التقديرية المستعملة في السنين السابقة. غير أنه في حالة عرض تعديل تبت الجمعية العامة في التعديلات المعروضة، بعد الاطلاع على الحسابات الموضوعة حسب الأشكال والطرق القديمة والجديدة وبناء على تقرير مجلس الإدارة أو القائمين بالإدارة، حسب الحال وتقرير مندوبي الحسابات . تودع حسابات الشركة المذكورة في المقطع الأول في المركز الوطني للسجل التجاري خلال الشهر الذي يلي مصادقة الجمعية العامة عليها. ويعد الإيداع بمثابة إشهار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_717> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_717_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_717_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_717_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_717_19750926_OpEnact_55a401241f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_717_obligation_0_807da428> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "717" ;
    dzdoc:position 919 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_717_condition_0_83cee39a> ;
    dzdoc:usesTerm dzterm:auditors,
        dzterm:board_of_directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_718> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_718" ;
    dzdoc:fullText "حتى في حال انعدام وعدم كفاية الأرباح، فإنه يشرع في الاستهلاكات وجمع المؤونات الضرورية لكي تكون الميزانية صحيحة. وإن نقص قيمة الأصول الملحقة بالأصول الثابتة سواء أكانت مسببة بالاستهلاك أو بتغيير الوسائل الفنية أو أي سبب آخر يجب أن تكون ثابتة بالاستهلاكات، كما يجب أن يكون النقص في القيمة لبقية عناصر مال الشركة والخسائر والتكاليف المحتملة، محل مؤونات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_718> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_718_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_718_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_718_19750926_OpEnact_d384310c7e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_718_obligation_0_b59b48e9>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_718_obligation_1_1599c78a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "718" ;
    dzdoc:position 920 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_729> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:shareholding_company,
        dzterm:subsidiary ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_729" ;
    dzdoc:fullText "إذا كانت لشركة أكثر من 50% من رأسمال شركة أخرى تعد الثانية تابعة للأولى. تعتبر شركة مساهمة في شركة أخرى ، إذا كان جزء الرأسمال الذي تملكه في هذه الأخيرة يقل عن 50% أو يساويها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_729> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_729_defocc_2bebbd9112db>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_729_defocc_84a656c451a9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_729_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_729_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_729_19750926_OpEnact_1db7fd91bc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "729" ;
    dzdoc:position 931 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_729_condition_0_52f4f4c1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_729_condition_1_1e0fadc5> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_730> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_730" ;
    dzdoc:fullText "لا يمكن شركة المساهمة أن تملك أسهما في شركة أخرى إذا كانت هذه الأخيرة تملك مباشرة جزءا من رأسمالها يزيد عن 10% ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_730_permission_0_b00556ee> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_730> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_730_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_730_19750926_OpEnact_867ecc1bb3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_730_obligation_0_66fe34fa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "730" ;
    dzdoc:position 932 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_730_condition_0_3b0137a8> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:consolidated_accounts ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_732_bis_4" ;
    dzdoc:fullText "يقصد بالحسابات المدعمة، تقديم الوضعية المالية ونتائج مجموعة الشركات وكأنها تشكل نفس الوحدة . وتخضع لنفس قواعد التقديم والمراقبة والمصادقة والنشر التي تخضع لها الحسابات السنوية الفردية. تحدد كيفيات تطبيق هذه المادة، عند الاقتضاء، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_732_bis_4> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_4_defocc_20ecaf8187af> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_4_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_4_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_4_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_732_bis_4_19750926_OpEnact_15b2982d8a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "732 مكرر 4" ;
    dzdoc:position 939 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_734> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_734" ;
    dzdoc:fullText "يطلب في شركات التضامن وإلا كان باطلا إتمام إجراءات النشر الخاصة بالعقد أو المداولة حسب الأحوال ، دون احتجاج الشركاء والشركة تجاه الغير، بسبب البطلان. غير أنه يجوز للمحكمة ألا تقضي بالبطلان الذي حصل إذا لم يثبت أي تدليس ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_734_permission_0_afea27bf> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_734_right_0_41b006d8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_734> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_734_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_734_19750926_OpEnact_c8035f553f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_734_obligation_0_22ccb1ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "734" ;
    dzdoc:position 941 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_4> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "في حالة سقوط الحق عملا بالمواد 55 و 61 و 74 المذكورة أعلاه ، فلا يجوز للدائن مطلقا أن يتمسك بحقه بموجب دعوى وحتى تحت شكل مقابل أو دفع."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_76_permission_0_4c84bb21> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_76_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_76_19750926_OpEnact_613cdad533> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "76" ;
    dzdoc:position 78 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_55>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_61>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_74> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_55>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_61>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_74> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_76_condition_0_43eac35e> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_763> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_763" ;
    dzdoc:fullText "تطبق في حالة إدماج أو انفصال الشركات ذات المسؤولية المحدودة لصالح شركات من نفس الشكل المواد 756 و 760 و 761 الفقرة 1 و 2 وتطبق المادة 751 في حالة وجود مندوبين للحسابات. أما إذا وجب تحقيق الانفصال بتقديم حصص إلى الشركات الجديدة ذات المسؤولية المحدودة ، فإن كلا من هذه الشركات يمكن أن تتكون من حصة دون حصة أخرى غير التي قدمت من الشركة المنفصلة. وفي هذه الحالة يجوز لشركاء هذه الأخيرة أن يعملوا بحكم القانون كمؤسسين لكل من الشركات الناتجة عن الانفصال وتتبع الإجراءات طبقا للأحكام المنظمة لتأسيس الشركات ذات المسؤولية المحدودة. وتسند حصص الشركاء التي تمثل رأس مال الشركات الجديدة مباشرة إلى شركاء الشركة المنفصلة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_763_permission_0_3785dfae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_763> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_763_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_763_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_763_19750926_OpEnact_ecf160c85d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "763" ;
    dzdoc:position 970 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_751>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_756>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_760>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_761> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_751>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_756>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_760>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_761> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_763_condition_0_e57d8e90> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_1> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "تعد جزءا من المحل التجاري الأموال المنقولة المخصصة لممارسة نشاط تجاري. ويشمل المحل التجاري إلزاميا عملائه وشهرته. كما يشمل أيضا سائر الأموال الأخرى اللازمة لاستغلال المحل التجاري كعنوان المحل والاسم التجاري والحق في الإيجار والمعدات والآلات والبضائع وحق الملكية الصناعية والتجارية كل ذلك ما لم ينص على خلاف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_78> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_78_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_78_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_78_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_78_19750926_OpEnact_75ff49d864> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_78_obligation_0_011e32ef> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "78" ;
    dzdoc:position 80 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_78_condition_0_d4fafb62> ;
    dzdoc:usesTerm dzterm:commercial_establishment .

<https://legal.dz/resource/order/1975-09-26/75-59#art_811> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_811" ;
    dzdoc:fullText "يعاقب بالحبس من سنة واحدة إلى خمس سنوات وبغرامة من 20.000 دج إلى 200.000 دج أو بإحدى هاتين العقوبتين فقط : رئيس شركة المساهمة و القائمون بإدارتها و مديروها العامون الذين يباشرون عمدا توزيع أرباح صورية على المساهمين دون تقديم قائمة للجرد أو بتقديم قوائم جرد مغشوشة، رئيس شركة المساهمة و القائمون بإدارتها أو مديروها العامون الذين يتعمدون نشر أو تقديم ميزانية للمساهمين غير مطابقة للواقع، لإخفاء حالة الشركة الحقيقية ولو في حالة عدم وجود توزيع للأرباح، رئيس شركة المساهمة و القائمون بإدارتها أو مديروها العامون الذين يستعملون عن سوء نية أموال الشركة أو سمعتها في غايات يعلمون أنها مخالفة لمصلحتها لأغراض شخصية أو لتفضيل شركة أو مؤسسة أخرى لهم فيها مصالح مباشرة أو غير مباشرة، رئيس شركة المساهمة و القائمون بإدارتها أو مديروها العامون الذين يستعملون عن سوء نية وبهذه الصفة ما لهم من السلطة أو حق في التصرف في الأصوات استعمالا يعلمون أنه مخالف لمصالح الشركة لبلوغ أغراض شخصية أو لتفضيل شركة أو مؤسسة أخرى لهم فيها مصالح مباشرة أو غير مباشرة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_811> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_811_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_811_19750926_OpEnact_afa1e1b643> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_811_obligation_0_98a503ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "811" ;
    dzdoc:position 1028 ;
    dzdoc:usesTerm dzterm:chairman,
        dzterm:directors,
        dzterm:general_managers .

<https://legal.dz/resource/order/1975-09-26/75-59#art_816> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_3> ;
    dzdoc:eId "art_816" ;
    dzdoc:fullText "يعاقب بغرامة من 20.000 دج إلى 200.000 دج رئيس شركة المساهمة أو القائمون بإدارتها الذين لم يستدعوا لكل جمعية في الأجل القانوني أصحاب الأسهم الحائزين منذ شهر واحد على الأقل على سندات اسمية إما برسالة عادية أو برسالة موصى عليها على نفقتهم إذا كان قد نص عليها في القانون الأساسي أو بناء على طلب المعنيين بالأمر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_816> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_816_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_816_19750926_OpEnact_70274397df> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_816_obligation_0_2601fe38> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "816" ;
    dzdoc:position 1033 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_816_condition_0_4cbd9900> ;
    dzdoc:usesTerm dzterm:administrators,
        dzterm:chairman .

<https://legal.dz/resource/order/1975-09-26/75-59#art_830> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_5> ;
    dzdoc:eId "art_830" ;
    dzdoc:fullText "يعاقب بالسجن من سنة إلى خمس سنوات وبغرامة من 20.000 دج إلى 500.000 دج أو بإحدى هاتين العقوبتين فقط ، كل مندوب للحسابات يتعمد إعطاء معلومات كاذبة أو تأكيدها عن حالة الشركة أو الذي لم يكشف إلى وكيل الدولة عن الوقائع الإجرامية التي علم بها . تطبق أحكام قانون العقوبات المتعلقة بإفشاء سر المهنة على مندوبي الحسابات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_830> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_830_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_830_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_830_19750926_OpEnact_0ddfc154a3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_830_obligation_0_71811cdd>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_830_obligation_1_07e72454> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
