<https://legal.dz/resource/order/1975-09-26/75-59#art_104> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_104" ;
    dzdoc:fullText "يشطب القيد سواء كان بموافقة الأطراف المعنية إذا توفرت لديهم الأهلية المطلوبة لإجرائه ، أو بمقتضى حكم اكتسب قوة الشيء المقضي به. وفي حالة انقضاء أسباب القيد فإن الشطب في هذه الحالة يمكن أن يتم من طرف مأموري السجل التجاري وذلك بمقتضى أمر صادر في ذيل عريضة، بعد استدعاء الأطراف."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_104_permission_0_e020a98f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_104> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_104_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_104_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_104_19750926_OpEnact_bc333c438f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "104" ;
    dzdoc:position 106 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_104_condition_0_3a8204b1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_104_condition_1_f5f25648> ;
    dzdoc:usesTerm dzterm:registrar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_2> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "يجب أن تحفظ الدفاتر والمستندات المشار إليها في المادتين 9 و 10 لمدة عشر سنوات . كما يجب أن ترتب وتحفظ المراسلات الواردة ونسخ الرسالات الموجهة طيلة نفس المدة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_12_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_12_19750926_OpEnact_2345dd8622> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_12_obligation_0_c7f7d019>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_12_obligation_1_fef9881c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "12" ;
    dzdoc:position 13 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_10>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_9> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_10>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_9> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_134> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:administrator_guardian ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_134" ;
    dzdoc:fullText "يصبح المشتري متصرفا حارسا بحكم القانون على المحل التجاري إذا كان في حيازته، وذلك من تاريخ التبليغ بإعادة المزايدة . ولا يمكنه حينئذ سوى مباشرة أعمال الإدارة على أنه يمكنه أن يطلب من المحكمة أو من قاضي الأمور المستعجلة حسب الأحوال وفي كل طور من أطوار الإجراءات، تعيين متصرف آخر ، و يجوز لكل دائن أن يقوم بتقديم مثل هذا الطلب ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_134_right_0_904892f1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_134_right_1_2c8e97ea> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_134> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_134_defocc_56b8ebde90cc> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_134_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_134_19750926_OpEnact_614a2b6e8d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 134" ;
    dzdoc:position 136 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_134_condition_0_fac73be9> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_143> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_5> ;
    dzdoc:eId "art_143" ;
    dzdoc:fullText "يتعين على مأموري السجل التجاري المشار إليهم أعلاه، أن يلتزموا بتنفيذ المواد 96 و 97 و 101 و 109 إلى 116 و 120 وأن يقوموا بحزم وجمع جداول قيد الامتياز الناتج عن عقد الرهن الحيازي للمحل التجاري . وأن يحتفظوا بفهرس أبجدي بأسماء المدينين مع بيان أرقام القيد التي تخصهم . وتقدم الورقة التي تثبت عليها الجداول، من قبل مأموري السجل التجاري ، على نفقة من يطلبها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_143> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_143_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_143_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_143_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_143_19750926_OpEnact_df44a42318> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_143_obligation_0_9ac62c86>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_143_obligation_1_5960152f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "143" ;
    dzdoc:position 145 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_101>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_109>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_116>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_120>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_96>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_97> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_101>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_109>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_116>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_120>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_96>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_97> ;
    dzdoc:usesTerm dzterm:commercial_register_officer .

<https://legal.dz/resource/order/1975-09-26/75-59#art_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_2> ;
    dzdoc:eId "art_17" ;
    dzdoc:fullText "يجوز للقضاة أن يوجهوا إنابة قضائية لدى المحكمة التي توجد بها الدفاتر أو يعينون قاضيا للاطلاع عليها وتحرير محضر بمحتواها وإرساله إلى المحكمة المختصة بالدعوى وذلك في حالة العرض بتقديمها أو طلب تقديمها أو الأمر به، إذا كانت هذه الدفاتر موجودة في أماكن بعيدة عن المحكمة المختصة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_17_permission_0_921d5fe8> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_17_right_0_50939bb3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_17> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_17_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_17_19750926_OpEnact_d847f896ef> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "17" ;
    dzdoc:position 18 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_17_condition_0_762dfafd> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_213> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_3> ;
    dzdoc:eId "art_213" ;
    dzdoc:fullText "يجوز أن يكون الثمن المحدد في عقد تأجير التسيير محلا لإعادة النظر فيه كل ثلاث سنوات على غرار مادة الإيجارات."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_213_permission_0_29b4c6bc> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_213_right_0_9a5580b9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_213> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_213_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_213_19750926_OpEnact_dea5282c73> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 213" ;
    dzdoc:position 217 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_233> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_3> ;
    dzdoc:eId "art_233" ;
    dzdoc:fullText "لا يقبل القفل النهائي لكشف الديون، في حالة إفلاس أو تسوية قضائية، أي طلب يرمي لتعيين تاريخ للتوقف عن الدفع يغاير ما حدده الحكم الصادر بشهر الإفلاس أو بالتسوية القضائية أو حكم تال ، فإنه اعتبارا من ذلك اليوم يبقى تاريخ التوقف عن الدفع ثابتا بالنسبة لجماعة الدائنين على نحو غير قابل للرجوع فيه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_233> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_233_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_233_19750926_OpEnact_72a193c1de> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_233_obligation_0_650468ce> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 233" ;
    dzdoc:position 237 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_233_condition_0_c3e0ae8a> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_3_sec_2> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "لا يمكن للأشخاص الطبيعيين أو المعنويين الخاضعين للتسجيل في السجل التجاري ، أن يحتجوا تجاه الغير المتعاقدين معهم بسبب نشاطهم التجاري أو لدى الإدارات العامة، بالوقائع موضوع الإشارة المشار إليها في المادة 25 وما يليها، إلا إذا كانت هذه الوقائع قد أصبحت علنية قبل تاريخ العقد بموجب إشارة مدرجة في السجل ما لم يثبتوا بوسائل البينة المقبولة في مادة تجارية أنه في وقت إبرام الاتفاق، كان أشخاص الغير من ذوي الشأن، مطلعين شخصيا على الوقائع المذكورة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_24_permission_0_4d6f3a14> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_24_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_24_19750926_OpEnact_42baf3e670> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "24" ;
    dzdoc:position 26 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_25> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_25> ;
    dzdoc:usesTerm dzterm:commercial_register .

<https://legal.dz/resource/order/1975-09-26/75-59#art_240> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_240" ;
    dzdoc:fullText "للقاضي المنتدب أن يعين في أي وقت بأمر يصدره، مراقبا أو أثنين من بين الدائنين . ولا يجوز أن يعين مراقبا أو ممثلا لشخص معنوي معين كمراقب، أي قريب أو نسيب للمدين لغاية الدرجة الرابعة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_240_permission_0_a5a8e745> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_240_right_0_4ca7e4e4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_240> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_240_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_240_19750926_OpEnact_9fa3f5d464> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "240" ;
    dzdoc:position 244 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_240_condition_0_109fb2f0> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_241> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_241" ;
    dzdoc:fullText "المراقبون مكلفون بنوع خاص بفحص الحسابات وبيان الوضعية المقدمة من المدين ومساعدة القاضي المنتدب في مهمته بمراقبة أعمال وكيل التفليسة . للقاضي المنتدب عزلهم بناء على رأي أغلبية الدائنين . ووظائف المراقبين مجانية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_241_right_0_09acf4c5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_241> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_241_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_241_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_241_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_241_19750926_OpEnact_bf523b56c2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_241_obligation_0_ecbcb257> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "241" ;
    dzdoc:position 245 ;
    dzdoc:usesTerm dzterm:observers .

<https://legal.dz/resource/order/1975-09-26/75-59#art_250> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_250" ;
    dzdoc:fullText "إن عدم التمسك المنصوص عليه في المادتين 247 فقرة 3 و 251 لا يمس صحة وفاء سفتجة أو سند لأمر أو شيك. غير أن لجماعة الدائنين أن ترفع دعوى رد المال إلى التفليسة ضد ساحب السفتجة، أو في حالة السحب لأجل الحساب ضد الأمر بالسحب وكذلك ضد المستفيد من الشيك وأول مظهر للسند لأمر ، بشرط إقامة الدليل على أن المطالب برد المال كان عالما بالتوقف على الدفع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_250_right_0_58de86dc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_250> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_250_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_250_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_250_19750926_OpEnact_f91817d086> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 250" ;
    dzdoc:position 254 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_247>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_251> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_247>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_251> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_250_condition_0_cbc6a04a> ;
    dzdoc:usesTerm dzterm:creditors_group .

<https://legal.dz/resource/order/1975-09-26/75-59#art_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_3_sec_2> ;
    dzdoc:eId "art_27" ;
    dzdoc:fullText "يجب على كل شخص طبيعي أو معنوي مسجل في السجل التجاري أن يذكر في عنوان فواتيره أو طلباته أو تعريفاته أو نشرات الدعاية أو على كل المراسلات الخاصة بمؤسسته والموقعة منه أو باسمه، مقر المحكمة التي وقع فيها التسجيل بصفة أصلية ورقم التسجيل الذي حصل عليه. وكل مخالفة لهذه الأحكام يعاقب عنها بغرامة قدرها من 180 دج إلى 360 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_27_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_27_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_27_19750926_OpEnact_6f734f1d00> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_27_obligation_0_aad410a0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 27" ;
    dzdoc:position 29 ;
    dzdoc:usesTerm dzterm:commercial_register,
        dzterm:legal_person,
        dzterm:natural_person .

<https://legal.dz/resource/order/1975-09-26/75-59#art_297> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_3> ;
    dzdoc:eId "art_297" ;
    dzdoc:fullText "إذا بيعت المنقولات المؤثثة بها الأماكن المؤجرة، ونقلت منها ، جاز للمؤجر ممارسة امتیازه حسبما هو مقرر لحالة الفسخ طبقا ل المادة السابقة . وتكون له فضلا عن ذلك أجرة السنة التي تستحق اعتبارا من العام الصادر فيه الحكم بإشهار الإفلاس أو بالتسوية القضائية، وذلك سواء كان للإجارة تاريخ ثابت أم لم يكن."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_297_right_0_0e2e4e76> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_297> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_297_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_297_19750926_OpEnact_fcb1747340> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 297" ;
    dzdoc:position 302 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_296> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_296> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_297_condition_0_c6901c00> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_303> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_4> ;
    dzdoc:eId "art_303" ;
    dzdoc:fullText "بعد بيع العقارات والضبط النهائي لترتيب الدائنين المرتهنين عقاريا والممتازين ، لا يستحق أولئك الذين يسمح لهم ترتيبهم باقتضاء كامل حقوقهم من ثمن العقارات سوى المقدار المستحق تبعا لمرتبتهم مع خصم المبالغ التي حصلوها ضمن جماعة الدائنين العاديين. ولا تبقى المبالغ المخصومة ضمن جماعة الدائنين المرتهنين عقاريا وإنما تعود إلى جماعة الدائنين العاديين، فهي التي يكون الاستبعاد لمصلحتها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_303_permission_0_0eb695f4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_303> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_303_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_303_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_303_19750926_OpEnact_2c5ddd3381> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "303" ;
    dzdoc:position 308 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_303_condition_0_728d18dc> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_307> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_5> ;
    dzdoc:eId "art_307" ;
    dzdoc:fullText "لا تجوز ممارسة حق الامتياز و دعوى الفسخ و حق الاسترداد القائم لصالح بائع الأموال المنقولة ضد جماعة الدائنين إلا في حدود الأحكام التالية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_307_right_0_4d559cec>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_307_right_1_cb1b3eab>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_307_right_2_b2d6f559> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_307> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_307_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_307_19750926_OpEnact_fcb9733f5c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_307_obligation_0_362849eb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "307" ;
    dzdoc:position 312 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_313> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_5> ;
    dzdoc:eId "art_313" ;
    dzdoc:fullText "يجوز أيضا استرداد ثمن البضائع أو بعضه المنصوص عليها في المادة 308 إذا لم يدفع أو تسدد قيمته بورقة مالية أو بمقاصة ضمن حساب جار بين المدين والمشتري ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_313_permission_0_9248d12d> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_313_right_0_24f45f87> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_313> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_313_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_313_19750926_OpEnact_d8793f133a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "313" ;
    dzdoc:position 318 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_308> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_308> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_313_condition_0_787da648> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_316> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_1> ;
    dzdoc:eId "art_316" ;
    dzdoc:fullText "يعرض أمين التفليسة على الجمعية تقريرا عن حالة التفليسة والإجراءات التي نفذت والأعمال التي تمت كما يسمع فيها المدين. ويسلم أمين التفليسة تقريره لقيام حالة الاتحاد، موقعا عليه منه إلى القاضي المنتدب الذي يحرر محضرا بما حصل في الجمعية وما قررته . وتجري بعد ذلك الإجراءات وفقا للمادة 349 وما بعدها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_316> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_316_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_316_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_316_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_316_19750926_OpEnact_b59d39f6c3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_316_obligation_0_4d9a6f6f>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_316_obligation_1_0d9439d0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 316" ;
    dzdoc:position 321 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_349> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_349> ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:trustee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_319> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_2> ;
    dzdoc:eId "art_319" ;
    dzdoc:fullText "لا تحتسب في إجراءات الصلح أصوات الدائنين المتمتعين بتأمين عيني ، بخصوص ديونهم المضمونة على الشكل المذكور، إلا أن يتنازلوا عن تأميناتهم . ويذكر في محضر الجمعية ما يجريه الدائنون من تنازلات عن تأميناتهم. ويؤدي التصويت على الصلح إلى ذلك التنازل بقوة القانون بشرط أن تتم الموافقة على الصلح والتصديق عليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_319> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_319_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_319_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_319_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_319_19750926_OpEnact_5594b81673> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "319" ;
    dzdoc:position 324 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_319_condition_0_25b87675>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_319_condition_1_afe1e0e3> ;
    dzdoc:usesTerm dzterm:secured_creditors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_334> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_4> ;
    dzdoc:eId "art_334" ;
    dzdoc:fullText "يمكن أيضا أن يتضمن الصلح التنازل للمدين عن جزء تختلف أهميته عن الديون، على أن هذا التنازل يستبقى على عاتق المفلس التزاما طبيعيا. ويجوز أن يقبل الصلح مع اشتراط الوفاء عند اليسر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_334_permission_0_a3becfb1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_334> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_334_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_334_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_334_19750926_OpEnact_ff7286eb2b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 334" ;
    dzdoc:position 339 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_385> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_3_sec_2> ;
    dzdoc:eId "art_385" ;
    dzdoc:fullText "تطبق العقوبات المنصوص عليها في الفقرة الأولى من المادة 380 من قانون العقوبات على الدائن الذي اشترط لنفسه سواء مع المدين أو مع أشخاص سواه، مزايا خاصة في إعطاء صوته في مداولات جماعة الدائنين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_385> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_385_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_385_19750926_OpEnact_6849485724> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 385" ;
    dzdoc:position 390 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_385_extref_3c0a3197> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:creditors_group,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_390> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_390" ;
    dzdoc:fullText "تشتمل السفتجة على البيانات التالية : 1 - تسمية  \"سفتجة\" في متن السند نفسه وباللغة المستعملة في تحريره، 2 - أمر غير معلق على قيد أو شرط بدفع مبلغ معين، 3 - اسم من يجب عليه الدفع «المسحوب عليه»، 4 - تاريخ الاستحقاق، 5 - المكان الذي يجب فيه الدفع، 6 - اسم من يجب الدفع له أو لأمره، 7 - بيان تاريخ إنشاء السفتجة ومكانه، 8 - توقيع من أصدر السفتجة «الساحب ». إذا خلا السند من أحد البيانات المذكورة بالفقرات المتقدمة فلا يعتد به كسفتجة في الأحوال المعينة في الفقرات الآتية : إن السفتجة الخالية من بيان تاريخ الاستحقاق، تكون مستحقة الأداء لدى الإطلاع عليها، وإذا لم يذكر فيها مكان خاص للدفع فإن المكان المبين بجانب اسم المسحوب عليه يعد مكانا للدفع وفي الوقت نفسه مكان موطن المسحوب عليه. وإذا لم يذكر فيها مكان إنشائها تعتبر كأنها منشأة في المكان المبين بجانب اسم الساحب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_390> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_390_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_390_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_390_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_390_para_3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_390_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_390_19750926_OpEnact_2ab50c42f9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 390" ;
    dzdoc:position 395 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_390_condition_0_dc59fe43> ;
    dzdoc:usesTerm dzterm:bill_of_exchange .

<https://legal.dz/resource/order/1975-09-26/75-59#art_392> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_392" ;
    dzdoc:fullText "إذا كتب مبلغ السفتجة بالأحرف الكاملة والأرقام معا فالعبرة عند الاختلاف للمبلغ المحرر بالأحرف الكاملة. وإذا كتب مبلغ السفتجة عدة مرات بالأحرف أو بالأرقام فالعبرة عند الاختلاف لأقلها مبلغا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_392> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_392_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_392_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_392_19750926_OpEnact_a3fb16d093> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 392" ;
    dzdoc:position 397 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_392_condition_0_57ba0dff>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_392_condition_1_704ef604> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_398> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_398" ;
    dzdoc:fullText "إن المظهر ضامن قبول السفتجة ووفاءها ما لم يشترط خلاف ذلك. وله أن يمنع تظهيرها من جديد وفي هذه الحالة لا يكون ملزما بالضمان للأشخاص الذين تظهر لهم السفتجة فيما بعد."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_398_right_0_29017dff> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_398> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_398_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_398_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_398_19750926_OpEnact_0493c70b3c> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_398_prohibition_0_18b6151b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 398" ;
    dzdoc:position 403 ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:endorser .

<https://legal.dz/resource/order/1975-09-26/75-59#art_408> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_408" ;
    dzdoc:fullText "إذا وضع المسحوب عليه صيغة القبول على السفتجة ثم شطبها قبل ترجيع السفتجة ، عد القبول مرفوضا ويعد التشطيب واقعا قبل ترجيع السند ما لم يثبت خلافه. على أنه إذا كان المسحوب عليه قد أعلم كتابة الحامل أو أي موقع آخر بقبوله يصبح ملزما تجاه هذين الأخيرين بما تضمنته الصيغة التي عبر بها عن قبوله ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_408> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_408_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_408_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_408_19750926_OpEnact_3c009b0ad5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_408_obligation_0_07b03845> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 408" ;
    dzdoc:position 413 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_408_condition_0_8a8cea52>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_408_condition_1_de42a13a> ;
    dzdoc:usesTerm dzterm:acceptance,
        dzterm:bearer,
        dzterm:bill_of_exchange,
        dzterm:drawee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_410> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_6> ;
    dzdoc:eId "art_410" ;
    dzdoc:fullText "يمكن سحب السفتجة : لدى الاطلاع، أو لأجل معين لدى الاطلاع، أو لأجل معين التاريخ، أو ليوم محدد. أما السفاتج التي تتضمن آجال استحقاق أخرى أو استحقاقات متعاقبة فهي باطلة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_410_permission_0_7e7aaf7c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_410> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_410_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_410_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_410_19750926_OpEnact_bd9c8374a8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "410" ;
    dzdoc:position 415 ;
    dzdoc:usesTerm dzterm:bill_of_exchange .

<https://legal.dz/resource/order/1975-09-26/75-59#art_423> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_7> ;
    dzdoc:eId "art_423" ;
    dzdoc:fullText "في حالة الامتناع عن الوفاء بعد تقديم الطلب بمقتضى المادتين السابقتين ، يحتفظ مالك السفتجة الضائعة بجميع حقوقه في تقديم الاحتجاج . وينبغي تقديم هذا الأخير في اليوم التالي لاستحقاق السفتجة الضائعة . أما التبليغات المنصوص عليها في المادة 430 فيجب توجيهها للساحب والمظهرين في الآجال المحددة في هذه المادة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_423_right_0_daab3ed1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_423> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_423_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_423_19750926_OpEnact_60a6796d30> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_423_obligation_0_aed3af53>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_423_obligation_1_80b43372> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 423" ;
    dzdoc:position 428 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_421>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_422>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_430> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_421>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_422>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_430> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_423_condition_0_9550f1ba> ;
    dzdoc:usesTerm dzterm:bill_of_exchange .

<https://legal.dz/resource/order/1975-09-26/75-59#art_424> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_7> ;
    dzdoc:eId "art_424" ;
    dzdoc:fullText "يجب على مالك السفتجة الضائعة لأجل الحصول على نسخة ثانية منها أن يطلب من المظهر الأخير قبله أن يمده بما هو واجب عليه من المساعدة باسمه وعنايته للسعي لدى المظهر له السابق وهكذا يجري الرجوع على هذا المنوال من مظهر إلى مظهر حتى يصل إلى ساحب السفتجة ويتحمل مالك السفتجة الضائعة المصاريف ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_424> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_424_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_424_19750926_OpEnact_ecb06f2e0f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_424_obligation_0_68b75fc0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_424_obligation_1_1217eb52> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 424" ;
    dzdoc:position 429 ;
    dzdoc:usesTerm dzterm:bill_of_exchange .

<https://legal.dz/resource/order/1975-09-26/75-59#art_425> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_7> ;
    dzdoc:eId "art_425" ;
    dzdoc:fullText "ينقضي التزام الكفيل المنصوص عليه في المادتين 421 و 422 بمضي ثلاثة أعوام إذا لم يقدم في خلال هذه المدة طلبا أو ملاحقات قضائية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_425> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_425_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_425_19750926_OpEnact_ea73c3efa4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 425" ;
    dzdoc:position 430 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_421>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_422> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_421>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_422> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_425_condition_0_a0f9b89a> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_435> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_8> ;
    dzdoc:eId "art_435" ;
    dzdoc:fullText "كل ملزم أقيمت عليه دعوى الرجوع أو كان معرضا للرجوع يحق له أن يطلب تسليم السفتجة مع الاحتجاج وإيصال بالإبراء مقابل التسديد . وكل مظهر أوفى مبلغ السفتجة يمكنه شطب تظهيره وتظهير من تبعه فيه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_435_right_0_c916dddb>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_435_right_1_20998f49> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_435> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_435_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_435_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_435_19750926_OpEnact_49b094628b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 435" ;
    dzdoc:position 440 ;
    dzdoc:usesTerm dzterm:bill_of_exchange .

<https://legal.dz/resource/order/1975-09-26/75-59#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_2> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "يكون المرسل مسؤولا عن الأضرار الناجمة عن عيوب التحزيم. غير أن الناقل يكون مسؤولا عن الأضرار الناجمة من عيوب التحزيم أو انعدامه إذا قبل الشيء وهو عالم بعيوب التحزيم أو انعدامه . وإن عيوب التحزيم الخاص بالشيء المنقول لا يعفي الناقل من التزاماته المتولدة بموجب عقود نقل أخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_44_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_44_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_44_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_44_19750926_OpEnact_324f05b87a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 44" ;
    dzdoc:position 46 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_44_condition_0_4b73c203> ;
    dzdoc:usesTerm dzterm:carrier,
        dzterm:sender .

<https://legal.dz/resource/order/1975-09-26/75-59#art_446> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_8> ;
    dzdoc:eId "art_446" ;
    dzdoc:fullText "يضبط الرجوع على النسبة التالية : ربع في المائة بمراكز الولاية، نصف في المائة ب بمراكز الدائرة، وثلاثة أرباع في المائة بالمحلات الأخرى. لا يمكن في أي حال من الأحوال أن يقع الرجوع بنفس الولاية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_446_permission_0_e33b1461> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_446> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_446_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_446_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_446_19750926_OpEnact_0309980c63> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_446_obligation_0_7361090f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 446" ;
    dzdoc:position 451 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_460> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_11> ;
    dzdoc:eId "art_460" ;
    dzdoc:fullText "إذا وقع تحريف في نص السفتجة فالأشخاص الموقعون عليها بعد التحريف ملزمون بما تضمنه النص المحرف ، أما الموقعون عليها قبل التحريف ملزمون بما تضمنه النص الأصلي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_460> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_460_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_460_19750926_OpEnact_fe376b51a4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_460_obligation_0_115f4577>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_460_obligation_1_1532e7b1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "460" ;
    dzdoc:position 465 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_460_condition_0_0a6f194c> ;
    dzdoc:usesTerm dzterm:bill_of_exchange .

<https://legal.dz/resource/order/1975-09-26/75-59#art_465> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_2> ;
    dzdoc:eId "art_465" ;
    dzdoc:fullText "يحتوي السند لأمر على: 1 - شرط الأمر أو تسمية السند مكتوبة في نفس النص وباللغة المستعملة لتحريره، 2 - الوعد بلا قيد ولا شرط بأداء مبلغ معين، 3 - تعيين تاريخ الاستحقاق، 4 - تعيين المكان الذي يجب فيه الأداء، 5 - اسم الشخص الذي يجب أن يتم الأداء له أو لأمره، 6 - تعيين المكان والتاريخ اللذين حرر فيهما السند، 7 - توقيع من حرر السند أي (الملزم)."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_465> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_465_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_465_19750926_OpEnact_1daa0e6246> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "465" ;
    dzdoc:position 470 ;
    dzdoc:usesTerm dzterm:promissory_note .

<https://legal.dz/resource/order/1975-09-26/75-59#art_466> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_2> ;
    dzdoc:eId "art_466" ;
    dzdoc:fullText "إذا خلا السند من أحد البيانات المبينة في المادة السابقة فلا يعتبر سند الأمر إلا في الأحوال المنصوص عليها في الفقرات التالية. إن السند لأمر الذي لم يعين فيه تاريخ الاستحقاق يعد واجب الدفع عند الاطلاع عليه. إذا لم يكن بالسند تعيين خاص فيعد مكان إنشائه هو مكان الدفع وهو نفسه المكان الذي به مقر الملزم. إن السند لأمر الذي لم يذكر به مكان إنشائه يعتبر محررا بالمكان المعين بجانب الملزم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_466> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_466_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_466_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_466_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_466_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_466_19750926_OpEnact_73b1bf8b7c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "466" ;
    dzdoc:position 471 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_465> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_465> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_466_condition_0_afcf65af>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_466_condition_1_1f3d35f1> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_2> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "يعد الناقل مسؤولا من وقت تسلمه الأشياء المراد نقلها، عن ضياعها الكلي أو الجزئي أو تلفها أو التأخير في تسليمها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_47_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_47_19750926_OpEnact_641a287ae5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_47_obligation_0_96a86cc8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 47" ;
    dzdoc:position 49 ;
    dzdoc:usesTerm dzterm:carrier .

<https://legal.dz/resource/order/1975-09-26/75-59#art_486> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_2> ;
    dzdoc:eId "art_486" ;
    dzdoc:fullText "يجوز التظهير ولو للساحب أو لأي ملزم آخر و يحق لهذين الأخيرين تظهير الشيك من جديد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_486_permission_0_5642f13d> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_486_right_0_1520e377>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_486_right_1_21253798> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_486> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_486_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_486_19750926_OpEnact_75d81033d8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "486" ;
    dzdoc:position 491 ;
    dzdoc:usesTerm dzterm:cheque,
        dzterm:endorsement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_2> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "إذا قام عدة ناقلين على وجه التعاقب بتنفيذ عقد النقل ذاته : 1 - يكون أول الناقلين وآخرهم مسؤولين بالتضامن فيما بينهما تجاه المرسل والمرسل إليه عن مجموع النقل وضمن نفس الشروط المترتبة فيما لو قام كل منهما بتمام النقل ، 2 - ويعد كل من الناقلين الوسطاء تجاه المرسل والمرسل إليه وكذلك تجاه أول وآخر ناقل، مسؤولا عن الضرر الحاصل بالنسبة للمسافة التي قطعها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_49_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_49_19750926_OpEnact_b3bd248a09> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_49_obligation_0_1763c745> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 49" ;
    dzdoc:position 51 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_49_condition_0_574093a7> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_496> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_2> ;
    dzdoc:eId "art_496" ;
    dzdoc:fullText "إن التظهير بعد الاحتجاج أو انقضاء أجل التقديم ، لا تترتب عليه إلا الآثار المترتبة على الإحالة العادية. إن التظهير بدون تاريخ يعتبر حاصلا قبل الاحتجاج أو انقضاء الأجل المشار إليه في الفقرة السابقة إلا إذا ثبت العكس. ويحظر تقديم تواريخ الأوامر بالدفع وإلا كان تلك تزويرا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_496> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_496_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_496_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_496_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_496_19750926_OpEnact_7ccb8aabb8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_496_obligation_0_c90133a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "496" ;
    dzdoc:position 501 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_496_condition_0_105f3557> ;
    dzdoc:usesTerm dzterm:endorsement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_502> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_4> ;
    dzdoc:eId "art_502" ;
    dzdoc:fullText "يعد التقديم المادي للشيك إلى إحدى غرف المقاصة بمثابة تقديم للوفاء. يمكن أن يتم هذا التقديم أيضا، بأية وسيلة تبادل إلكترونية محددة في التشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_502_permission_0_876ff134> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_502> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_502_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_502_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_502_19750926_OpEnact_f4434b41e6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "502" ;
    dzdoc:position 507 ;
    dzdoc:usesTerm dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_531> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_9> ;
    dzdoc:eId "art_531" ;
    dzdoc:fullText "بالنسبة لمظهري الصك وضامني وفائه لا يمكن أن يحل إجراء حامل الصك محل عقد الاحتجاج ما عدا الحالة المنصوص عليها في المادتين 508 و 509 المتعلقة بضياع الصك . وبالنسبة للساحب، تعادل شهادة عدم الدفع لانعدام أو قلة الرصيد المسلمة من قبل البنك. تحدد عند الاقتضاء كيفيات تطبيق الفقرة السالفة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_531_permission_0_c8c9a0b0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_531> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_531_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_531_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_531_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_531_19750926_OpEnact_3fd1f4a1ed> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "531" ;
    dzdoc:position 553 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_508>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_509> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_508>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_509> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_531_condition_0_1b310bb6> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_4_sec_3> ;
    dzdoc:eId "art_543_bis_24" ;
    dzdoc:fullText "الأمر أو الالتزام بالدفع المعطى بموجب بطاقة الدفع غير قابل للرجوع فيه، ولا يمكن الاعتراض على الدفع إلا في حالة ضياع أو سرقة البطاقة المصرح بهما قانونا ، أو تسوية قضائية أو إفلاس المستفيد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_24_permission_0_2011af58> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_24_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_24_19750926_OpEnact_96e3b6caf2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 24" ;
    dzdoc:position 590 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_24_condition_0_5364550a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_24_condition_1_5f6b546e> ;
    dzdoc:usesTerm dzterm:payment_card .

<https://legal.dz/resource/order/1975-09-26/75-59#art_554> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_554" ;
    dzdoc:fullText "يجوز للمدير، في العلاقات بين الشركاء، وعند عدم تحديد سلطاته في القانون الأساسي ، أن يقوم بكافة أعمال الإدارة لصالح الشركة. وعند تعدد المديرين يتمتع كل واحد منهم منفردا بالسلطات المنصوص عليها في الفقرة المتقدمة، ويحق لكل واحد منهم أن يعارض في كل عملية قبل إبرامها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_554_permission_0_7f3b4c40> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_554> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_554_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_554_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_554_19750926_OpEnact_75832546af> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "554" ;
    dzdoc:position 601 ;
    dzdoc:usesTerm dzterm:statutes .

<https://legal.dz/resource/order/1975-09-26/75-59#art_57> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_2> ;
    dzdoc:eId "art_57" ;
    dzdoc:fullText "يجوز إعفاء الوكيل بالعمولة كليا أو جزئيا من مسؤوليته عن عدم تنفيذ التزاماته أو تنفيذها الناقص أو المتأخر بشرط أن يثبت أن ذلك ناشئ عن قوة قاهرة أو عيب خاص بالشيء أو عن خطأ منسوب إما لموكله أو المرسل إليه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_57_permission_0_13272471> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_57_right_0_abbb1a7b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_57> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_57_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_57_19750926_OpEnact_df79994330> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "57" ;
    dzdoc:position 59 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_57_condition_0_7aea5769> ;
    dzdoc:usesTerm dzterm:مرسل_إليه,
        dzterm:وكيل_بالعمولة .

<https://legal.dz/resource/order/1975-09-26/75-59#art_572> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_572" ;
    dzdoc:fullText "لا يمكن إثبات إحالة حصص إلا بموجب عقد رسمي . ولا يسوغ الاحتجاج على الشركة أو الغير بها إلا بعد إعلام الشركة بها أو قبولها للإحالة بعقد رد رسمي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_572_permission_0_1ed10d44> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_572> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_572_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_572_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_572_19750926_OpEnact_fd4d34100f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_572_obligation_0_d8bfef36> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "572" ;
    dzdoc:position 630 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_602> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_602" ;
    dzdoc:fullText "المادة 602 : ل مكتتبي الأسهم حق الاقتراع بأنفسهم أو بواسطة ممثليهم حسب الشروط المنصوص عليها في المادة 603 أدناه . وتتداول الجمعية التأسيسية حسب شروط اكتمال النصاب والأغلبية المقررة في الجمعيات غير العادية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_602_right_0_5cb2fa9b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_602> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_602_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_602_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_602_19750926_OpEnact_8a41023dfb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "602" ;
    dzdoc:position 661 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_603> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_603> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_602_condition_0_1b7d1434> ;
    dzdoc:usesTerm dzterm:shareholders .

<https://legal.dz/resource/order/1975-09-26/75-59#art_613> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_613" ;
    dzdoc:fullText "يجوز إعادة انتخاب القائمين بالإدارة كما يجوز للجمعية العامة العادية عزلهم في أي وقت ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_613_permission_0_f708a076> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_613_right_0_9af816ae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_613> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_613_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_613_19750926_OpEnact_7202d22183> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "613" ;
    dzdoc:position 672 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_3> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "يجب على ناقل الأشخاص ، أن يضمن أثناء مدة النقل سلامة المسافر وأن يوصله إلى وجهته المقصودة في حدود الوقت المعين بالعقد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_62_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_62_19750926_OpEnact_c5cac551d2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_62_obligation_0_35d88c4b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 62" ;
    dzdoc:position 64 ;
    dzdoc:usesTerm dzterm:carrier .

<https://legal.dz/resource/order/1975-09-26/75-59#art_626> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_626" ;
    dzdoc:fullText "لا تصح مداولة مجلس الإدارة إلا إذا حضر نصف عدد أعضائه على الأقل . ويعتبر كل شرط مخالف كأن لم يكن. وتؤخذ القرارات بأغلبية أصوات الأعضاء الحاضرين ما لم ينص القانون الأساسي على أغلبية أكثر. ويرجح صوت رئيس الجلسة عند تعادل الأصوات ما لم ينص على خلاف ذلك في القانون الأساسي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_626> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_626_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_626_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_626_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_626_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_626_19750926_OpEnact_b4aad14d92> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "626" ;
    dzdoc:position 685 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_626_condition_0_be88223d> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_629> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_629" ;
    dzdoc:fullText "تنتج الاتفاقيات التي توافق أو لا توافق عليها الجمعية آثارها تجاه الغير ما لم تكن ملغاة بسبب التدليس. وحتى في حالة عدم وجود التدليس، فإن العواقب الضارة بالشركة من جراء الاتفاقيات غير الموافق عليها، يمكن أن تلقى على عاتق القائم بالإدارة أو المدير العام المعني، وعند الاقتضاء على عاتق الأعضاء الآخرين في مجلس الإدارة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_629_permission_0_a9a702c2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_629> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_629_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_629_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_629_19750926_OpEnact_487ba5d41f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "629" ;
    dzdoc:position 688 ;
    dzdoc:usesTerm dzterm:general_director,
        dzterm:manager .

<https://legal.dz/resource/order/1975-09-26/75-59#art_657> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_657" ;
    dzdoc:fullText "يتكون مجلس المراقبة من سبعة (7) أعضاء على الأقل، ومن اثنى عشر (12) عضوا على الأكثر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_657> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_657_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_657_19750926_OpEnact_8b6e2f0ada> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 657" ;
    dzdoc:position 716 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_657_condition_0_c2106d49> ;
    dzdoc:usesTerm dzterm:board_of_auditors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_664> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_664" ;
    dzdoc:fullText "لا يمكن شخصا طبيعيا الانتماء في نفس الوقت إلى أكثر من خمسة مجالس مراقبة لشركات المساهمة التي يكون مقرها في الجزائر. ولا تطبق أحكام المقطع السابق على الممثلين الدائمين للأشخاص المعنويين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_664_permission_0_126310ea> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_664> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_664_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_664_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_664_19750926_OpEnact_61ae83ffbd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_664_obligation_0_126310ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 664" ;
    dzdoc:position 723 ;
    dzdoc:usesTerm dzterm:natural_person,
        dzterm:supervisory_board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_668> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_668" ;
    dzdoc:fullText "يمكن الجمعية العامة العادية منح أعضاء مجلس المراقبة مبلغا ثابتا كأجر مقابل نشاطهم . ويقيد مبلغ هذا الأجر في تكاليف الاستغلال."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_668_permission_0_7a489b0b> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_668_right_0_781a805e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_668> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_668_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_668_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_668_19750926_OpEnact_5effddfd0a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 668" ;
    dzdoc:position 727 ;
    dzdoc:usesTerm dzterm:general_assembly,
        dzterm:supervisory_board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_693> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_693" ;
    dzdoc:fullText "يجب تسديد رأس المال بكامله قبل القيام بأي إصدار لأسهم جديدة واجبة التسديد نقدا ذلك تحت طائلة بطلان العملية. وعلاوة على ذلك، فإن زيادة رأس المال باللجوء العلني للادخار الذي تم تحقيقه في فترة تقل عن سنتين من تأسيس شركة وفقا ل المواد من 605 إلى 609 ، يجب أن يسبقه حسب الشروط المنصوص عليها في المواد من 601 إلى 603 فحص أصول وخصوم هذه الشركة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_693> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_693_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_693_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_693_19750926_OpEnact_f7d5a1af2a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_693_obligation_0_e3c2079e>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_693_obligation_1_21e6a2fc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
