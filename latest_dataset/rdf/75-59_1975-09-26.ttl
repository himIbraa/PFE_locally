<https://legal.dz/resource/order/1975-09-26/75-59#version_art_746> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "خلافا لأحكام الفقرة الثانية من المادة 745 ، إذا كان من شأن العملية المقررة زيادة تعهدات الشركاء أو المساهمين لشركة أو عدة شركات معنية ، فإنه لا يقرر ذلك إلا بموافقة الشركاء المذكورين أو المساهمين بالإجماع ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_746_19750926_OpEnact_239a6f9fec> ;
