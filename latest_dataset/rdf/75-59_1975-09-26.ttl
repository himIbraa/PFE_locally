<https://legal.dz/resource/order/1975-09-26/75-59#art_670_condition_0_0207f8a3> a dznorm:Condition ;
    dznorm:conditionText "تعد كل اتفاقية تبرم دون مراعاة الشروط المذكورة أعلاه باطلة بطلانا مطلقا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_670> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_670_obligation_0_3543f45e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_670> ;
    dznorm:position 0 ;
    dznorm:provisionText "تخضع كل اتفاقية تعقد بين شركة ما وأحد أعضاء مجلس المديرين أو مجلس مراقبة هذه الشركة إلى ترخيص مسبق من مجلس المراقبة"@ar ;
    dznorm:sourceArticle "art_670" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_670_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_670> ;
    dzdoc:position 0 ;
    dzdoc:text "تخضع كل اتفاقية تعقد بين شركة ما وأحد أعضاء مجلس المديرين أو مجلس مراقبة هذه الشركة إلى ترخيص مسبق من مجلس المراقبة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_670_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_670> ;
    dzdoc:position 1 ;
    dzdoc:text "ويكون الأمر كذلك بخصوص الاتفاقيات التي تعقد بصورة غير مباشرة مع أحد الأشخاص المشار إليهم في المقطع السابق أو التي يتعامل فيها مع الشركة من خلال أشخاص وسطاء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_670_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_670> ;
    dzdoc:position 2 ;
    dzdoc:text "وتخضع للترخيص المسبق أيضا الاتفاقيات التي تعقد بين شركة ومؤسسة إذا كان أحد أعضاء مجلس المديرين أو مجلس مراقبة الشركة مالكا أو شريكا أو مسيرا أو قائما بالإدارة أو مديرا عاما للمؤسسة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_670_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_670> ;
    dzdoc:position 3 ;
    dzdoc:text "تعد كل اتفاقية تبرم دون مراعاة الشروط المذكورة أعلاه باطلة بطلانا مطلقا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_671_obligation_0_ea89d5da> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_671_obligation_0_ea89d5da_action_349789f414> ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_671_obligation_0_ea89d5da_role_810ce1ecbe>,
