    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_594> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_20_condition_0_84a202b9>,
