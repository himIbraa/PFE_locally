<https://legal.dz/resource/order/1975-09-26/75-59#version_art_794> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقرر المصفي إذا كان ينبغي توزيع الأموال التي أصبحت قابلة للتصرف فيها أثناء التصفية وذلك دون الإخلال بحقوق الدائنين. يجوز لكل معني بالأمر أن يطلب من القضاء الحكم في وجوب التوزيع أثناء التصفية ، وذلك بعد إنذار من المصفي وباق بدون جدوى . ينشر كل قرار توزيع يتعلق بالأصول في جريدة الإعلانات القانونية التي تم فيها النشر المنصوص عليه في المادة 767 . ويبلغ قرار التوزيع إلى الشركاء على انفراد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_794_19750926_OpEnact_cb48effa24> ;
    dzdoc:replacementText "يقرر المصفي إذا كان ينبغي توزيع الأموال التي أصبحت قابلة للتصرف فيها أثناء التصفية وذلك دون الإخلال بحقوق الدائنين. يجوز لكل معني بالأمر أن يطلب من القضاء الحكم في وجوب التوزيع أثناء التصفية ، وذلك بعد إنذار من المصفي وباق بدون جدوى . ينشر كل قرار توزيع يتعلق بالأصول في جريدة الإعلانات القانونية التي تم فيها النشر المنصوص عليه في المادة 767 . ويبلغ قرار التوزيع إلى الشركاء على انفراد ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_794> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
