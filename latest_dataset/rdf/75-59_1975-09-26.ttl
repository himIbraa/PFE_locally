<https://legal.dz/resource/order/1975-09-26/75-59#art_107> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_107" ;
    dzdoc:fullText "يجب على مأموري السجل التجاري أن يسلموا لكل طالب جدولا بالقيود الموجودة مع البيانات المتعلقة بالأسبقية أو الشطب الجزئي أو الكلي أو الحلول الجزئي أو الكلي وإما شهادة بعدم وجود قيد أو بوجوده بدون تفصيل. كما يجب أن يسلم لكل طالب جدول بالقيود أو البيانات التي تمت ب المعهد الجزائري للملكية الصناعية وتنظيمها . ويجوز للموظف العمومي المكلف ببيع محل تجاري متى رأى لزوما لذلك أن يحصل من مأموري السجل التجاري على جداول القيد المودعة ب المركز الوطني للسجل التجاري والمتعلقة بالمحل التجاري."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_107_right_0_7830ace7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_107> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_107_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_107_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_107_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_107_19750926_OpEnact_6cb4f59824> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_107_obligation_0_ded44e6c>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_107_obligation_1_a49d0af1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
