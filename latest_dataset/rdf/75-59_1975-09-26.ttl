dzterm:fraudulent_bankruptcy a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التدليسي"@ar,
        "التفليس بالتدليس"@ar,
        "يعد مرتكبا للتفليس بالتدليس كل تاجر في حالة توقف عن الدفع يكون قد أخفى حساباته أو بدد أو اختلس كل أو بعض أصوله أو يكون بطريق التدليس قد أقر بمديونيته بمبالغ ليست في ذمته سواء كان هذا في محرراته بأوراق رسمية أو تعهدات عرفية أو في ميزانيته."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_374_defocc_ef01df4b1e0f> .

dzterm:general_crossing a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التسطير العام"@ar,
        "التسطير عاما"@ar,
        "تسطير عام"@ar,
        "يكون التسطير عاما إذا كان لا يتضمن بين الخطين أي تعيين أو كلمة « مصرف » أو ما يقابلها"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_512_defocc_1ecac106a264> .

dzterm:holding_company a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الشركات القابضة"@ar,
        "الشركة القابضة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_731_defocc_23a9f2e0c16a> .

dzterm:investment_certificates a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تمثل شهادات الاستثمار التي يجب أن تكون قيمتها الاسمية مساوية للقيمة الاسمية لسهم الشركة المصدرة، حقوقا مالية، وهي قابلة للتداول."@ar,
        "شهادات الاستثمار"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_62_defocc_4dd792a4ed69> .

dzterm:ordinary_shares a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الأسهم العادية"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_42_defocc_7c61e37530f1> .

dzterm:payment_card a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "بطاقة الدفع"@ar,
        "بطاقة دفع"@ar,
        "تعتبر بطاقة دفع كل بطاقة صادرة عن البنوك والهيئات المالية المؤهلة قانونا وتسمح لصاحبها بسحب أو تحويل أموال"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_23_defocc_6678bac36918> .

