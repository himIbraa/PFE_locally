    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "780" ;
    dzdoc:position 987 ;
    dzdoc:usesTerm dzterm:auditors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_786> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_786" ;
    dzdoc:fullText "يعزل المصفي ويستخلف حسب الأوضاع المقررة لتسميته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_786> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_786_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_786_19750926_OpEnact_90f3e4e642> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "786" ;
    dzdoc:position 993 ;
    dzdoc:usesTerm dzterm:liquidator .

<https://legal.dz/resource/order/1975-09-26/75-59#art_795_bis_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_795_bis_4" ;
    dzdoc:fullText "يتعاقد كل شريك مع الغير باسمه الشخصي، ويكون ملزما وحده حتى في حالة كشفه عن أسماء الشركاء الآخرين دون موافقتهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_795_bis_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_795_bis_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_795_bis_4_19750926_OpEnact_b15877a185> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "795 مكرر 4" ;
    dzdoc:position 1006 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_805> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_1> ;
    dzdoc:eId "art_805" ;
    dzdoc:fullText "تطبق أحكام المواد من 800 إلى 804 على كل شخص قام مباشرة أو بواسطة شخص آخر بتسيير شركة ذات مسؤولية محدودة تحت ظل أو بدلا عن مسيرها القانوني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_805> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_805_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_805_19750926_OpEnact_2e94ff1b30> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "805" ;
    dzdoc:position 1022 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_800>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_804> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_800>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_804> ;
    dzdoc:usesTerm dzterm:legal_manager,
        dzterm:limited_liability_company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_826> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_826" ;
    dzdoc:fullText "تطبق أحكام المواد من 807 إلى 810 المتعلقة بتأسيس شركات المساهمة في حالة زيادة رأس المال."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_826> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_826_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_826_19750926_OpEnact_85eb74a972> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "826" ;
    dzdoc:position 1043 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_807>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_810> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_807>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_810> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_834> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_7> ;
    dzdoc:eId "art_834" ;
    dzdoc:fullText "تطبق أحكام هذا الفصل الخاصة ب رئيس الشركة والقائمين بإدارتها أو مديريها العامين على كل شخص قام مباشرة أو بواسطة شخص بممارسة مديرية تلك الشركات أو إدارتها في ظل محل أو مكان نائبيهم القانونيين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_834> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_834_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_834_19750926_OpEnact_ebb711c246> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 834" ;
    dzdoc:position 1051 ;
    dzdoc:usesTerm dzterm:chairman .

<https://legal.dz/resource/order/1975-09-26/75-59#art_836> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_8> ;
    dzdoc:eId "art_836" ;
    dzdoc:fullText "تطبق أحكام المادة السابقة الخاصة ب رئيس شركات المساهمة و القائمين بإدارتها و مديريها العامين على كل شخص قام مباشرة أو بواسطة شخص بممارسة مديرية وإدارة أو تسيير تلك الشركات في ظل محل أو مكان نائبيهم القانونيين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_836> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_836_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_836_19750926_OpEnact_05cb015230> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 836" ;
    dzdoc:position 1053 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_835> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_835> ;
    dzdoc:usesTerm dzterm:administrators,
        dzterm:general_managers,
        dzterm:president .

<https://legal.dz/resource/order/1975-09-26/75-59#art_841> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_841" ;
    dzdoc:fullText "تحدد عند الاقتضاء كيفيات تطبيق هذا الأمر بموجب مراسيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_841> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_841_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_841_19750926_OpEnact_b869d55a9f> ;
