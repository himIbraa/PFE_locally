    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالسجن لمدة سنة إلى خمس سنوات وبغرامة من 20.000 دج إلى 200.000 دج، أو بإحدى هاتين العقوبتين فقط"@ar ;
    dznorm:sourceArticle "art_800" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_800_obligation_0_2dd5c0d8_period_932f698d45> a dznorm:Period ;
