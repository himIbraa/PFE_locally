<https://legal.dz/resource/order/1975-09-26/75-59#version_art_476> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن اشتراط دفع الشيك : 1 - إلى شخص مسمى مع شرط صريح يعبر عنه بكلمة \"لأمر\" أو بدونه، 2 - إلى شخص مسمى مع شرط يعبر عنه بكلمة \"ليس\" لأمر\" أو لفظ آخر بهذا المعنى، 3 - للحامل. إن الشيك المسحوب لفائدة شخص مسمى والمنصوص فيه \"أو لحامله\" أو ما يؤدي إلى هذا المعنى يعتبر شيكا لحامله . كما أن الشيك الذي لم يذكر فيه اسم المستفيد يعد بمثابة شيك لحامله ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_476_19750926_OpEnact_67c644fac3> ;
    dzdoc:replacementText "يمكن اشتراط دفع الشيك : 1 - إلى شخص مسمى مع شرط صريح يعبر عنه بكلمة \"لأمر\" أو بدونه، 2 - إلى شخص مسمى مع شرط يعبر عنه بكلمة \"ليس\" لأمر\" أو لفظ آخر بهذا المعنى، 3 - للحامل. إن الشيك المسحوب لفائدة شخص مسمى والمنصوص فيه \"أو لحامله\" أو ما يؤدي إلى هذا المعنى يعتبر شيكا لحامله . كما أن الشيك الذي لم يذكر فيه اسم المستفيد يعد بمثابة شيك لحامله ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_476> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
