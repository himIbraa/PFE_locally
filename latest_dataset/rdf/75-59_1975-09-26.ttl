<https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_10> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحل الشركة في حالة الإفلاس أو التسوية القضائية لأحد الشركاء المتضامنين أو المنع من ممارسة مهنة تجارية أو عدم قدرة أحد الشركاء المتضامنين . غير أنه عند وجود شريك متضامن أو أكثر ، يمكن الشركاء أن يقرروا في هذه الحالة، بالإجماع، استمرار الشركة فيما بينهم . وتطبق أحكام المادة 563 أعلاه عليهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_10_19750926_OpEnact_93a77f0d0a> ;
    dzdoc:replacementText "تحل الشركة في حالة الإفلاس أو التسوية القضائية لأحد الشركاء المتضامنين أو المنع من ممارسة مهنة تجارية أو عدم قدرة أحد الشركاء المتضامنين . غير أنه عند وجود شريك متضامن أو أكثر ، يمكن الشركاء أن يقرروا في هذه الحالة، بالإجماع، استمرار الشركة فيما بينهم . وتطبق أحكام المادة 563 أعلاه عليهم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_10> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
