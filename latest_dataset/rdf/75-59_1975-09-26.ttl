<https://legal.dz/resource/order/1975-09-26/75-59#version_art_456> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن الوفاء الذي يتم بمقتضى إحدى النظائر مبرئ للذمة ولو لم يشترط أن الوفاء على هذا النحو يبطل مفعول النظائر الأخرى. على أن المسحوب عليه يبقى ملزما بالوفاء بمقتضى كل نظير مقبول منه لم يسترده . إن المظهر الذي أحال النظائر لأشخاص مختلفين وكذلك المظهرين اللاحقين ملزمون بمقتضى جميع النظائر التي تحمل تواقيعهم والتي لم يحصل استردادها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_456_19750926_OpEnact_dcb8e57e52> ;
    dzdoc:replacementText "إن الوفاء الذي يتم بمقتضى إحدى النظائر مبرئ للذمة ولو لم يشترط أن الوفاء على هذا النحو يبطل مفعول النظائر الأخرى. على أن المسحوب عليه يبقى ملزما بالوفاء بمقتضى كل نظير مقبول منه لم يسترده . إن المظهر الذي أحال النظائر لأشخاص مختلفين وكذلك المظهرين اللاحقين ملزمون بمقتضى جميع النظائر التي تحمل تواقيعهم والتي لم يحصل استردادها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_456> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_456> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
