        "عقوبات التفليس بالتدليس"@ar,
        "عقوبة التفليس بالتقصير"@ar .

dzterm:rent a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "بدل الإيجار"@ar .

dzterm:special_crossing a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تسطير خاص"@ar,
        "خاصا"@ar,
        "يكون خاصا إذا كتب بين الخطين اسم أحد المصارف"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_512_defocc_3ba93efa0314> .

dzterm:subscription_coupons a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "قسيمات اكتتاب الأسهم"@ar,
        "قسيمات الاكتتاب"@ar .

dzterm:syndic a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "وكيل التفليسة"@ar .

dzterm:transport_contract a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "عقد النقل"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_36_defocc_08d8aecacfcb> .

dzterm:voting_right_certificates a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تمثل شهادات الحق في التصويت حقوقا أخرى غير الحقوق المالية المرتبطة بالأسهم."@ar,
        "شهادات الحق في التصويت"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_63_defocc_f45b6717bd14> .

dzterm:تفليس_بالتقصير a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يجوز أن يعتبر مرتكبا للتفليس بالتقصير كل تاجر في حالة توقف عن الدفع يوجد في إحدى الحالات الآتية"@ar,
        "يعد مرتكبا لتفليس بالتقصير كل تاجر في حالة توقف عن الدفع يوجد في إحدى الحالات الآتية"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_370_defocc_6eb941038271>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_371_defocc_771353ed313a> .

dzterm:قيم_منقولة a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "القيم المنقولة"@ar,
        "القيم المنقولة هي سندات قابلة للتداول تصدرها شركات المساهمة وتكون مسعرة في البورصة أو يمكن أن تسعر ، وتمنح حقوقا مماثلة حسب الصنف وتسمح بالدخول بصورة مباشرة أو غير مباشرة في حصة معينة من رأسمال الشركة المصدرة أو حق مديونية عام على أموالها."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_30_defocc_fd1c3e0950c8> .

