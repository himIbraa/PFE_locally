    dzdoc:replacementText "للمادة القاضي المنتدب بعد سماع المدين أو استدعائه برسالة موصى عليها، أن يأذن لـ وكيل التفليسة بمباشرة بيع باقي الأموال المنقولة أو البضائع ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_269> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_269> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_27> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على كل شخص طبيعي أو معنوي مسجل في السجل التجاري أن يذكر في عنوان فواتيره أو طلباته أو تعريفاته أو نشرات الدعاية أو على كل المراسلات الخاصة بمؤسسته والموقعة منه أو باسمه، مقر المحكمة التي وقع فيها التسجيل بصفة أصلية ورقم التسجيل الذي حصل عليه. وكل مخالفة لهذه الأحكام يعاقب عنها بغرامة قدرها من 180 دج إلى 360 دج."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_27_19750926_OpEnact_6f734f1d00> ;
    dzdoc:replacementText "يجب على كل شخص طبيعي أو معنوي مسجل في السجل التجاري أن يذكر في عنوان فواتيره أو طلباته أو تعريفاته أو نشرات الدعاية أو على كل المراسلات الخاصة بمؤسسته والموقعة منه أو باسمه، مقر المحكمة التي وقع فيها التسجيل بصفة أصلية ورقم التسجيل الذي حصل عليه. وكل مخالفة لهذه الأحكام يعاقب عنها بغرامة قدرها من 180 دج إلى 360 دج."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_27> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
