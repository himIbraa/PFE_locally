<https://legal.dz/resource/order/1975-09-26/75-59#art_129_condition_0_9cbd60d1> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يقم الراسي عليه المزاد بتنفيذ شروط مرسى المزاد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_129> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_129_obligation_0_2bd97f6a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_129> ;
    dznorm:position 0 ;
    dznorm:provisionText "ويلزم المزايد المتخلف، تجاه دائني البائع والبائع نفسه بالفرق الحاصل بين الثمن الذي تم به البيع له والثمن الحاصل من إعادة البيع عن طريق إعادة المزايدة"@ar ;
    dznorm:sourceArticle "art_129" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_129_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_129> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا لم يقم الراسي عليه المزاد بتنفيذ شروط مرسى المزاد يعاد بيع المحل التجاري عن طريق إعادة المزايدة بعد إنذار غير متبوع بنتيجة، في مهلة عشرين يوما وذلك وفقا للأوضاع المقررة في المادة 127 أعلاه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_129_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_129> ;
    dzdoc:position 1 ;
    dzdoc:text "ويلزم المزايد المتخلف، تجاه دائني البائع والبائع نفسه بالفرق الحاصل بين الثمن الذي تم به البيع له والثمن الحاصل من إعادة البيع عن طريق إعادة المزايدة، دون أن يكون له الحق في المطالبة بالمزايدة إن وجدت."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_129_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_129> ;
    dzdoc:position 2 ;
    dzdoc:text "وتكون نفقات المزايدة الأولى على عاتق الراسي عليه المزاد الأولي، وتحصل عند الاقتضاء تنفيذيا بواسطة الموظف العمومي المكلف بالبيع."@ar .

