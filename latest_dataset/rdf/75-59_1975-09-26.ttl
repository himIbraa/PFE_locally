<https://legal.dz/resource/order/1975-09-26/75-59#version_art_155> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يؤشر في هامش القيد على كل حلول اتفاقي بتعلق بالاستفادة من الرهن الحيازي خلال ثلاثين يوما من تاريخ العقد الرسمي أو العرفي المثبت لهذا الحلول وذلك بناء على تسليم نسخة أو أصل هذا العقد إلى مأموري السجل التجاري . وتتم تسوية النزاعات التي قد تنشأ بين أصحاب القيود المتتابعة طبقا للمادة 265 من القانون المدني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_155_19750926_OpEnact_d5b16e351e> ;
    dzdoc:replacementText "يجب أن يؤشر في هامش القيد على كل حلول اتفاقي بتعلق بالاستفادة من الرهن الحيازي خلال ثلاثين يوما من تاريخ العقد الرسمي أو العرفي المثبت لهذا الحلول وذلك بناء على تسليم نسخة أو أصل هذا العقد إلى مأموري السجل التجاري . وتتم تسوية النزاعات التي قد تنشأ بين أصحاب القيود المتتابعة طبقا للمادة 265 من القانون المدني ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
