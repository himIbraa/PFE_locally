<https://legal.dz/resource/order/1975-09-26/75-59#version_art_603> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المادة 603 : لكل مكتتب عدد من الأصوات يعادل عدد الحصص التي اكتتب بها، دون أن يتجاوز ذلك نسبة 5% من العدد الإجمالي للأسهم. ولوكيل المكتتب عدد الأصوات التي يملكها موكله حسب نفس الشروط ونفس الحد. وعندما تتداول الجمعية حول الموافقة على حصة عينية ، فلا تؤخذ في حساب الأغلبية أسهم مقدم الحصة. وليس لمقدم الحصة صوت في المداولة لا لنفسه ولا بصفته وكيلا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_603_19750926_OpEnact_9768ed08dd> ;
    dzdoc:replacementText "المادة 603 : لكل مكتتب عدد من الأصوات يعادل عدد الحصص التي اكتتب بها، دون أن يتجاوز ذلك نسبة 5% من العدد الإجمالي للأسهم. ولوكيل المكتتب عدد الأصوات التي يملكها موكله حسب نفس الشروط ونفس الحد. وعندما تتداول الجمعية حول الموافقة على حصة عينية ، فلا تؤخذ في حساب الأغلبية أسهم مقدم الحصة. وليس لمقدم الحصة صوت في المداولة لا لنفسه ولا بصفته وكيلا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_603> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
