<https://legal.dz/resource/order/1975-09-26/75-59#art_364_obligation_0_fc3635d1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_364> ;
    dznorm:position 0 ;
    dznorm:provisionText "يحيل وكيل الدولة إلى المحكمة المرفوع إليها الطلب نتيجة التحقيقات المنصوص عليها فيما تقدم مشفوعة برأيه المسبب"@ar ;
    dznorm:sourceArticle "art_364" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_364_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_364> ;
    dzdoc:position 0 ;
    dzdoc:text "بعد انقضاء المواعيد المنصوص عليها في المادتين 362 و 363، يحيل وكيل الدولة إلى المحكمة المرفوع إليها الطلب نتيجة التحقيقات المنصوص عليها فيما تقدم مشفوعة برأيه المسبب."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_365_condition_0_cf86826c> a dznorm:Condition ;
    dznorm:conditionText "وإذا رفض الطلب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_365> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_365_condition_1_a193d10d> a dznorm:Condition ;
    dznorm:conditionText "وإذا قبل الطلب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_365> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_365_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_365> ;
    dzdoc:position 0 ;
    dzdoc:text "يفصل بعدئذ في الطلب وفي المعارضات المرفوعة بموجب حكم واحد. وإذا رفض الطلب لا يجوز تجديده إلا بعد انقضاء عام واحد. وإذا قبل الطلب يسجل الحكم في سجل المحكمة التي أصدرته ومحكمة موطن الطالب."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_365_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_365> ;
    dzdoc:position 1 ;
    dzdoc:text "ويبلغ فضلا عن ذلك بعناية كاتب الضبط لوكيل الدولة التابع له محل ميلاد الطالب، ملخص عن الحكم ليؤشر عنه في الصحيفة القضائية إزاء التصريح بإشهار الإفلاس أو التسوية القضائية."@ar .

