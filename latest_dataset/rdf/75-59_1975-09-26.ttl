<https://legal.dz/resource/order/1975-09-26/75-59#version_art_676> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تجتمع الجمعية العامة العادية مرة على الأقل في السنة خلال الستة أشهر التي تسبق قفل السنة المالية ، فيما عدا تمديد هذا الأجل بناء على طلب مجلس الإدارة أو مجلس المديرين حسب الحالة، بأمر من الجهة القضائية المختصة التي تبت في ذلك بناء على عريضة. ولا يقبل هذا الأمر أي طعن. ويقدم مجلس الإدارة أو مجلس المديرين إلى الجمعية العامة بعد تلاوة تقريره جدول حسابات النتائج والوثائق التلخيصية والحصيلة . وفضلا عن ذلك، يشير مندوبو الحسابات في تقريرهم إلى إتمام المهمة التي أسندت إليهم طبقا ل المادة 715 مكرر 4 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_676_19750926_OpEnact_807d0e2f66> ;
    dzdoc:replacementText "تجتمع الجمعية العامة العادية مرة على الأقل في السنة خلال الستة أشهر التي تسبق قفل السنة المالية ، فيما عدا تمديد هذا الأجل بناء على طلب مجلس الإدارة أو مجلس المديرين حسب الحالة، بأمر من الجهة القضائية المختصة التي تبت في ذلك بناء على عريضة. ولا يقبل هذا الأمر أي طعن. ويقدم مجلس الإدارة أو مجلس المديرين إلى الجمعية العامة بعد تلاوة تقريره جدول حسابات النتائج والوثائق التلخيصية والحصيلة . وفضلا عن ذلك، يشير مندوبو الحسابات في تقريرهم إلى إتمام المهمة التي أسندت إليهم طبقا ل المادة 715 مكرر 4 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_676> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
