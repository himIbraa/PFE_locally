<https://legal.dz/resource/order/1975-09-26/75-59#art_638_condition_0_0ffb70ac> a dznorm:Condition ;
    dznorm:conditionText "ما لم يثبت أن الغير كان يعلم أن العمل يتجاوز هذا الموضوع أو لا يمكنه تجاهله نظرا للظروف"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_638> ;
