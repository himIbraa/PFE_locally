    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_671> ;
    dznorm:position 0 ;
    dznorm:provisionText "يحظر ، تحت طائلة البطلان المطلق للعقد، على أعضاء مجلس المديرين وعلى أعضاء مجلس المراقبة، غير الأشخاص المعنويين، أن يقترضوا على أي وجه من الوجوه قروضا لدى الشركة، كما يحظر عليهم أن يجعلوا منها كفيلا أو ضامنا احتياطيا لالتزاماتهم الشخصية نحو الغير."@ar ;
    dznorm:sourceArticle "art_671" .

