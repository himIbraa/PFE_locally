<https://legal.dz/resource/order/1975-09-26/75-59#art_155_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_155> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب أن يؤشر في هامش القيد على كل حلول اتفاقي بتعلق بالاستفادة من الرهن الحيازي خلال ثلاثين يوما من تاريخ العقد الرسمي أو العرفي المثبت لهذا الحلول وذلك بناء على تسليم نسخة أو أصل هذا العقد إلى مأموري السجل التجاري."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_155_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_155> ;
    dzdoc:position 1 ;
    dzdoc:text "وتتم تسوية النزاعات التي قد تنشأ بين أصحاب القيود المتتابعة طبقا للمادة 265 من القانون المدني."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_156_extref_64c91e6a> a dzdoc:ExternalReference ;
    rdfs:label "المادة 243 من القانون المدني"@ar ;
    dzdoc:frbrUri "/akn/dz/act/order/1975-09-26/75-58#art_243"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/order/1975-09-26/75-58#art_243"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/order/1975-09-26/75-58#art_243" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/order/1975-09-26/75-58"^^xsd:anyURI ;
    dzdoc:targetEId "art_243" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_156_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_156> ;
    dzdoc:position 0 ;
    dzdoc:text "تحول فائدة الرهن الحيازي بقوة القانون وطبقا لالمادة 243 من القانون المدني إلى الحاملين بالتعاقب للسندات المضمونة سواء كانت قد وقعت أو قبلت لأمر البائع أو المقرض الذي قدم كلا أو بعضا من الثمن أو كانت هذه السندات تمثل على العموم تداول الدين المرهون بوجه صحيح، وفقا لأحكام هذا القانون. أما إذا قامت عدة سندات لتمثيل الدين فإن الامتياز المتعلق بهذا الأخير تعود ممارسته إلى المتتبع الأول للحساب المشترك وبالنسبة لتمامه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_157_condition_0_99583cd8> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_157_condition_0_99583cd8_role_b6807465e0> ;
    dznorm:conditionText "إذا توفرت شروط النشر المطلوبة في هذا القانون ووضعت اللوحة على الأموال المثقلة بالدين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_157> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_157_condition_0_99583cd8_role_b6807465e0> a dznorm:Role ;
    rdfs:label "الأموال المثقلة بالدين"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "إذا توفرت شروط النشر المطلوبة في هذا القانون ووضعت اللوحة على الأموال المثقلة بالدين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_157> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_157_obligation_0_4431d34c_action_a94fbcf30f> a dznorm:Action ;
    rdfs:label "الذي يرغب في بيع كل"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب على المدين الذي يرغب في بيع كل أو جزء من الأموال المحملة بالديون عن طريق البيع الاختياري أن يطلب، إذا وقع ذلك قبل دفع المستحق من المبالغ المضمونة طبقا لهذا القانون، الموافقة المسبقة من الدائن المرتهن ، وخلاف ذلك، الإذن من قاضي الأمور المستعجلة للمحكمة التي تفصل بالدرجة الأخيرة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_157> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_157_obligation_0_4431d34c_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/order/1975-09-26/75-59#art_157_obligation_0_4431d34c> ;
    dznorm:conditionText "إذا وقع ذلك قبل دفع المستحق من المبالغ المضمونة طبقا لهذا القانون"@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_157_obligation_0_4431d34c_role_91eeacb04b> a dznorm:Role ;
    rdfs:label "المدين الذي يرغب في"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يجب على المدين الذي يرغب في بيع كل أو جزء من الأموال المحملة بالديون عن طريق البيع الاختياري أن يطلب، إذا وقع ذلك قبل دفع المستحق من المبالغ المضمونة طبقا لهذا القانون، الموافقة المسبقة من الدائن المرتهن ، وخلاف ذلك، الإذن من قاضي الأمور المستعجلة للمحكمة التي تفصل بالدرجة الأخيرة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_157> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_157_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_157> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب على المدين الذي يرغب في بيع كل أو جزء من الأموال المحملة بالديون عن طريق البيع الاختياري أن يطلب، إذا وقع ذلك قبل دفع المستحق من المبالغ المضمونة طبقا لهذا القانون، الموافقة المسبقة من الدائن المرتهن ، وخلاف ذلك، الإذن من قاضي الأمور المستعجلة للمحكمة التي تفصل بالدرجة الأخيرة وإلا تعرض المدين للعقوبات المنصوص عليها في المادة 167 من هذا القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_157_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_157> ;
    dzdoc:position 1 ;
    dzdoc:text "يجوز للدائن المرتهن أو من يحل محله التمتع بحق الامتياز المنصوص عليه في المادة 132 لممارسة الامتياز الناتج عن الرهن وذلك إذا توفرت شروط النشر المطلوبة في هذا القانون ووضعت اللوحة على الأموال المثقلة بالدين وذلك طبقا لالمادة 154 المشار إليها أعلاه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_157_permission_0_7cba4755> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
