<https://legal.dz/resource/order/1975-09-26/75-59#art_701_condition_0_bfffaf02> a dznorm:Condition ;
    dznorm:conditionText "إذا كانت الأسهم مثقلة بحق الانتفاع"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_701> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_701_condition_1_66609c72> a dznorm:Condition ;
    dzdoc:hasActivity <https://legal.dz/resource/order/1975-09-26/75-59#art_701_condition_1_66609c72_activity_aa35d5569f> ;
    dznorm:conditionText "وإذا أهمل مالك الرقبة ممارسة حقه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_701> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_701_condition_1_66609c72_activity_aa35d5569f> a dznorm:Activity ;
    rdfs:label "ممارسة حقه"@ar ;
    dzdoc:confidenceScore 0.6 ;
    dzdoc:extractionMethod "lexical_activity_pattern" ;
    dzdoc:sourceTextSpan "وإذا أهمل مالك الرقبة ممارسة حقه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_701> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_701_condition_2_b1f3e40d> a dznorm:Condition ;
    dznorm:conditionText "إذا تم دفع المال من مالك الرقبة أو صاحب الانتفاع لتحقيق أو إتمام الاكتتاب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_701> ;
    dznorm:position 2 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_701_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_701> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كانت الأسهم مثقلة بحق الانتفاع، فإن حق التفاضل في الاكتتاب المتعلق بها يعود لمالك الرقبة. فإذا باع هذا الأخير حقوق الاكتتاب فإن المبالغ الحاصلة من الإحالة أو الأموال التي اكتسبها بواسطة هذه المبالغ، تخضع لحق الانتفاع. وإذا أهمل مالك الرقبة ممارسة حقه، فإنه يجوز لصاحب حق الانتفاع أن ينوب عنه ليقوم بالاكتتاب في الأسهم الجديدة أو يبيع الحقوق. ويجوز لمالك الرقبة في هذه الحالة الأخيرة أن يطلب استعمال المبالغ الناتجة من الإحالة من جديد وتخضع الأموال المكتسبة بهذه الكيفية لحق الانتفاع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_701_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_701> ;
    dzdoc:position 1 ;
    dzdoc:text "وتعود ملكية الأسهم الجديدة إلى مالك الرقبة بالنسبة لملكية الرقبة وإلى صاحب حق الانتفاع بالنسبة لحق الانتفاع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_701_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_701> ;
    dzdoc:position 2 ;
    dzdoc:text "غير أنه إذا تم دفع المال من مالك الرقبة أو صاحب الانتفاع لتحقيق أو إتمام الاكتتاب، فإن الأسهم الجديدة لا تكون ملكا لمالك الرقبة وصاحب حق الانتفاع إلا في حدود قيمة حقوق الاكتتاب، ويكون الفائض من الأسهم الجديدة ملكا تاما لمن دفع الأموال."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_701_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_701> ;
    dzdoc:position 3 ;
    dzdoc:text "تطبق أحكام هذه المادة في حالة سكوت الاتفاقية الخاصة بالأطراف."@ar .

