<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_79> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحضر ممثلو جماعة حاملي السندات جمعيات المساهمين . و يمكن استشارتهم في جميع المسائل المدرجة في جدول الأعمال، باستثناء المسائل المتعلقة بتوظيف مسيري الشركة أو إقالتهم ، و يمكنهم التدخل أثناء الجمعية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_79_19750926_OpEnact_38346b7cdf> ;
