<https://legal.dz/resource/order/1975-09-26/75-59#version_art_530> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يشتمل الاحتجاج على النص الحرفي للشيك وما يحتوي عليه من التظهيرات وعلى الإنذار بوفاء قيمة الشيك . ويذكر فيه وجود أو غياب الملزم بالوفاء وبيان أسباب الامتناع عن الوفاء والعجز عن الإمضاء أو الامتناع عن الإمضاء ومقدار ما دفع من مبلغ الشيك في حالة الوفاء الجزئي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_530_19750926_OpEnact_09b85646a3> ;
