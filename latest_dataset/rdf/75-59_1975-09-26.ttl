<https://legal.dz/resource/order/1975-09-26/75-59#art_3_defocc_bea0f226c51b> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 25 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:commercial_act_by_form ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_3> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_3_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يعد عملا تجاريا بحسب شكله
            
            التعامل بالسفتجة بين كل الأشخاص،
            الشركات التجارية،
            وكالات ومكاتب الأعمال مهما كان هدفها،
            العمليات المتعلقة بالمحلات التجارية
            كل عقد تجاري يتعلق بالتجارة البحرية والجوية."""@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_3_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_3> ;
    dzdoc:position 0 ;
    dzdoc:text "يعد عملا تجاريا بحسب شكله التعامل بالسفتجة بين كل الأشخاص، الشركات التجارية، وكالات ومكاتب الأعمال مهما كان هدفها، العمليات المتعلقة بالمحلات التجارية كل عقد تجاري يتعلق بالتجارة البحرية والجوية."@ar .

