<https://legal.dz/resource/order/1975-09-26/75-59#version_art_364> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "بعد انقضاء المواعيد المنصوص عليها في المادتين 362 و 363 ، يحيل وكيل الدولة إلى المحكمة المرفوع إليها الطلب نتيجة التحقيقات المنصوص عليها فيما تقدم مشفوعة برأيه المسبب ."@ar ;
