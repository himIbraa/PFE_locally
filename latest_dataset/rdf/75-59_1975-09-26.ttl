    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_672> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_672_obligation_2_b87bf00e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_672> ;
    dznorm:position 2 ;
    dznorm:provisionText "يشعر رئيس مجلس المراقبة مندوبي الحسابات بكل الاتفاقيات المرخصة ويخضعها إلى مصادقة الجمعية العامة."@ar ;
    dznorm:sourceArticle "art_672" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_672_obligation_3_51535cf3> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_672> ;
    dznorm:position 3 ;
    dznorm:provisionText "يقدم مندوبو الحسابات تقريرا خاصا عن هذه الاتفاقيات إلى الجمعية العامة التي تبت في شأن التقرير المذكور."@ar ;
    dznorm:sourceArticle "art_672" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_672_obligation_4_a913db17> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_672_obligation_4_a913db17_action_8f42863649> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_672> ;
    dznorm:position 4 ;
    dznorm:provisionText "ولا يجوز للمعني أن يشارك في التصويت ولا تؤخذ أسهمه بعين الاعتبار عند حساب النصاب والأغلبية."@ar ;
    dznorm:sourceArticle "art_672" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_672_obligation_4_a913db17_action_8f42863649> a dznorm:Action ;
    rdfs:label "للمعني أن يشارك في التصويت"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "ولا يجوز للمعني أن يشارك في التصويت ولا تؤخذ أسهمه بعين الاعتبار عند حساب النصاب والأغلبية."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_672> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_672_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_672> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب على عضو مجلس المديرين أو مجلس المراقبة المعني أن يطلع مجلس المراقبة بمجرد اطلاعه على اتفاقية تسري عليها أحكام المادة 670 أعلاه. وإذا كان عضوا في مجلس المراقبة، فلا يجوز له أن يشارك في التصويت على الترخيص المطلوب."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_672_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_672> ;
    dzdoc:position 1 ;
    dzdoc:text "يشعر رئيس مجلس المراقبة مندوبي الحسابات بكل الاتفاقيات المرخصة ويخضعها إلى مصادقة الجمعية العامة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_672_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_672> ;
    dzdoc:position 2 ;
    dzdoc:text "يقدم مندوبو الحسابات تقريرا خاصا عن هذه الاتفاقيات إلى الجمعية العامة التي تبت في شأن التقرير المذكور."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_672_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_672> ;
    dzdoc:position 3 ;
    dzdoc:text "ولا يجوز للمعني أن يشارك في التصويت ولا تؤخذ أسهمه بعين الاعتبار عند حساب النصاب والأغلبية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_672_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_672> ;
    dzdoc:position 4 ;
    dzdoc:text "تنتج الاتفاقيات المصادق عليها أو غير المصادق عليها من الجمعية العامة آثارها تجاه الغير، ما لم تبطل بسبب التدليس."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_672_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_672> ;
    dzdoc:position 5 ;
    dzdoc:text "وحتى في حالة غياب التدليس، يمكن أن تقع العواقب الضارة بالشركة من جراء الاتفاقيات غير المصادق عليها، على عاتق عضو مجلس المراقبة أو مجلس المديرين المعني بالأمر، وعند الاقتضاء، على عاتق الأعضاء الآخرين في مجلس المديرين."@ar .

