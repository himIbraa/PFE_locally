<https://legal.dz/resource/order/1975-09-26/75-59#version_art_37> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتبر عقد العمولة للنقل اتفاق يلتزم بمقتضاه تاجر بأن يباشر باسمه الخاص أو باسم موكله أو شخص من الغير نقل أشخاص أو أشياء، وأن يقوم عند الاقتضاء بالأعمال الفرعية المرتبطة بالنقل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_37_19750926_OpEnact_8711e17fc0> ;
    dzdoc:replacementText "يعتبر عقد العمولة للنقل اتفاق يلتزم بمقتضاه تاجر بأن يباشر باسمه الخاص أو باسم موكله أو شخص من الغير نقل أشخاص أو أشياء، وأن يقوم عند الاقتضاء بالأعمال الفرعية المرتبطة بالنقل ."@ar ;
