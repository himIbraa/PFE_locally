    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "وعلاوة على ما تقدم، يجوز للمحكمة إذا أسفر تفليس شركة عن عجز فيما لها من الأموال، أن تقرر بطلب من وكيل التفليسة حمل الديون المترتبة عليها على نسبة القدر الذي تعينه إما على كاهل المديرين، سواء أكانوا من الشركاء أم لا ، أو من أصحاب الأجور أم لا وإما على كاهل الشركاء أو بعض الشركاء أو المديرين على وجه التضامن بينهم أو بدونه، بشرط أن يكون الشركاء فيما يتعلق بهم قد شاركوا بالفصل في إدارة الشركة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_578> .

