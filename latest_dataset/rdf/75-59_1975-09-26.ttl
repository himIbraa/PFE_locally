<https://legal.dz/resource/order/1975-09-26/75-59#art_746_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_746> ;
    dzdoc:position 0 ;
    dzdoc:text "خلافا لأحكام الفقرة الثانية من المادة 745 ، إذا كان من شأن العملية المقررة زيادة تعهدات الشركاء أو المساهمين لشركة أو عدة شركات معنية، فإنه لا يقرر ذلك إلا بموافقة الشركاء المذكورين أو المساهمين بالإجماع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_747_obligation_0_14483c9d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
