<https://legal.dz/resource/order/1975-09-26/75-59#version_art_588> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن رد الأرباح الموزعة وغير المطابقة للأرباح المحصل عليها حقيقة، يمكن أن يطلب من الشركاء الذين قبضوها. وتتقادم دعوى رد المدفوع بدون حق في أجل ثلاث سنوات اعتبارا من يوم الشروع في توزيع حصص الأرباح."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_588_19750926_OpEnact_3a5323361f> ;
    dzdoc:replacementText "إن رد الأرباح الموزعة وغير المطابقة للأرباح المحصل عليها حقيقة، يمكن أن يطلب من الشركاء الذين قبضوها. وتتقادم دعوى رد المدفوع بدون حق في أجل ثلاث سنوات اعتبارا من يوم الشروع في توزيع حصص الأرباح."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_588> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_588> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
