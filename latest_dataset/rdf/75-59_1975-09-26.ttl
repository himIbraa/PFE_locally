<https://legal.dz/resource/order/1975-09-26/75-59#art_575_right_0_d64e1f63> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/order/1975-09-26/75-59#art_575_right_0_d64e1f63_period_238023fa3a> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_575> ;
    dznorm:position 0 ;
    dznorm:provisionText "للدائنين الذين كان حقهم سابقا لتاريخ إيداع محضر المداولات بكتابة ضبط المحكمة، أن يرفعوا معارضة في هذا التخفيض في أجل شهر اعتبارا من يوم هذا الإيداع"@ar ;
    dznorm:sourceArticle "art_575" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_575_right_0_d64e1f63_period_238023fa3a> a dznorm:Period ;
