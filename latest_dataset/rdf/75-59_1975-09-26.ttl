<https://legal.dz/resource/order/1975-09-26/75-59#version_art_309> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز استرداد البضائع المرسلة إلى المدين ما دام التسليم لم يتحقق في مخازنه . ومع ذلك لا يقبل الاسترداد إذا كانت البضائع قد تم بيعها قبل وصولها دون غش وبمقتضى فواتير أو سندات صحيحة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_309_19750926_OpEnact_71a4f235b9> ;
