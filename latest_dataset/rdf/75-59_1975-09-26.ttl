<https://legal.dz/resource/order/1975-09-26/75-59#version_art_451> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كانت السفتجة مقبولة من متدخلين لهم موطن في مكان الوفاء أو كانت تشتمل على تعيين أشخاص يقع موطنهم بنفس المكان للوفاء عند الحاجة ، فيجب على الحامل أن يقدم السفتجة على جميع هؤلاء الأشخاص وأن يوجه عند الاقتضاء احتجاجا لعدم الوفاء في اليوم التالي على الأكثر لليوم الأخير الذي يجوز فيه تحرير الاحتجاج . وإذا لم يحرر احتجاج في الأجل المتقدم فمن عين الشخص الذي يقوم عند الاقتضاء بالوفاء أو من صدر قبول السفتجة لمصلحته والمظهرون اللاحقون يصبحون في حل من إلزامهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_451_19750926_OpEnact_44caac2bae> ;
    dzdoc:replacementText "إذا كانت السفتجة مقبولة من متدخلين لهم موطن في مكان الوفاء أو كانت تشتمل على تعيين أشخاص يقع موطنهم بنفس المكان للوفاء عند الحاجة ، فيجب على الحامل أن يقدم السفتجة على جميع هؤلاء الأشخاص وأن يوجه عند الاقتضاء احتجاجا لعدم الوفاء في اليوم التالي على الأكثر لليوم الأخير الذي يجوز فيه تحرير الاحتجاج . وإذا لم يحرر احتجاج في الأجل المتقدم فمن عين الشخص الذي يقوم عند الاقتضاء بالوفاء أو من صدر قبول السفتجة لمصلحته والمظهرون اللاحقون يصبحون في حل من إلزامهم."@ar ;
