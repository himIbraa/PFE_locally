<https://legal.dz/resource/order/1975-09-26/75-59#version_art_241> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المراقبون مكلفون بنوع خاص بفحص الحسابات وبيان الوضعية المقدمة من المدين ومساعدة القاضي المنتدب في مهمته بمراقبة أعمال وكيل التفليسة . للقاضي المنتدب عزلهم بناء على رأي أغلبية الدائنين . ووظائف المراقبين مجانية."@ar ;
