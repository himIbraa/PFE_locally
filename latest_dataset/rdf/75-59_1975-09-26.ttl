    dzdoc:eId "art_715_bis_64" ;
    dzdoc:fullText "يجب أن تصدر شهادات الحق في التصويت بعدد يساوي عدد شهادات الاستثمار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_64> ;
