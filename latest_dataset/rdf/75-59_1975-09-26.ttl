<https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_4> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتخذ القرارات وفق الشروط المحددة في القانون الأساسي. غير أن انعقاد جمعية كل الشركاء تكون قانونية، إذا طالب بها الشريك المتضامن أو الشركاء الموصون الذين يمثلون ربع رأس المال ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_4_19750926_OpEnact_bcd01605ee> ;
