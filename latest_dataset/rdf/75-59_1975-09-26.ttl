    dznorm:position 0 ;
    dznorm:provisionText "معجلة التنفيذ رغم المعارضة أو الاستئناف"@ar ;
    dznorm:sourceArticle "art_227" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_227_para_0> a dzdoc:Paragraph ;
