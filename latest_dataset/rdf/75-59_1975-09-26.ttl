<https://legal.dz/resource/order/1975-09-26/75-59#art_428_obligation_2_c3ee7622> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
