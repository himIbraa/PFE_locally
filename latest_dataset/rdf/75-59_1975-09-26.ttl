    dzdoc:evidenceText "يجوز للمحكمة أن تتخذ قرار حل الشركة ، بناء على طلب كل معني، إذا كان عدد المساهمين قد خفض إلى أقل من الحد الأدنى القانوني منذ أكثر من عام ، و يجوز لها أن تمنح الشركة أجلا أقصاه ستة أشهر لتسوية الوضع ، و لا تستطيع اتخاذ قرار حل الشركة إذا تمت هذه التسوية يوم فصلها في الموضوع ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_19_19750926_OpEnact_874719cdb0> ;
