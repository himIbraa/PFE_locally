    dznorm:position 0 ;
    dznorm:provisionText "يقتصر حق الأولوية على محلات تكون مساحتها مماثلة لمساحة المحلات المشغولة سابقا أو التي من شأنها أن تلبي نفس الحاجات التجارية التي كانت عليها هذه المحلات الأخيرة"@ar ;
    dznorm:sourceArticle "art_180" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_180_right_0_b1abcf2e_role_bad5b7b877> a dznorm:Role ;
