<https://legal.dz/resource/order/1975-09-26/75-59#version_art_209> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون مؤجر المحل التجاري مسؤولا بالتضامن مع المستأجر المسير عن الديون التي يعقدها هذا الأخير بمناسبة استغلال المتجر وذلك لغاية نشر عقد تأجير التسيير وطيلة مدة 6 أشهر من تاريخ النشر ."@ar ;
