<https://legal.dz/resource/order/1975-09-26/75-59#art_641_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_641> ;
    dzdoc:position 0 ;
    dzdoc:text "يحدد مجلس الإدارة بالاتفاق مع رئيسه مدى ومدة السلطات المخولة للمديرين العامين، وإذا كان أحدهما قائما بالإدارة فمدة وظيفته لا تكون أكثر من مدة وكالته."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_641_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_641> ;
    dzdoc:position 1 ;
