    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عند الحكم في إحدى الحالات المنصوص عليها في المواد المتقدمة تفصل المحكمة المعروض عليها الموضوع، ولو قضت بالإعفاء من التهمة : 1 - تلقائيا في أن تضاف لجانب جماعة الدائنين الأموال والحقوق أو الدعاوى التي أبعدت بطريق التدليس، 2 - فيما يطلب من تعويضات عن الضرر."@ar ;
