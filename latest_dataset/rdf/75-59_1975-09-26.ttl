    dznorm:sourceArticle "art_715_bis_4" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4_obligation_1_2e959941_role_48f9b17623> a dznorm:Role ;
    rdfs:label "طلب من مجلس الإدارة"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يتم اللجوء إلى تعيينهم أو استبدالهم بموجب أمر من رئيس المحكمة التابعة لمقر الشركة بناء على طلب من مجلس الإدارة أو مجلس المديرين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4> ;
    dzdoc:position 0 ;
    dzdoc:text "تعين الجمعية العامة العادية للمساهمين مندوبا للحسابات أو أكثر لمدة ثلاث سنوات، تختارهم من بين المهنيين المسجلين على جدول المصف الوطني، وتتمثل مهمتهم الدائمة، باستثناء أي تدخل في التسيير، في التحقيق في الدفاتر والأوراق المالية للشركة وفي مراقبة انتظام حسابات الشركة وصحتها. كما يدققون في صحة المعلومات المقدمة في تقرير مجلس الإدارة أو مجلس المديرين حسب الحالة، وفي الوثائق المرسلة إلى المساهمين حول الوضعية المالية للشركة وحساباتها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4> ;
    dzdoc:position 1 ;
    dzdoc:text "ويصدقون على انتظام الجرد وحسابات الشركة والموازنة، وصحة ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4> ;
    dzdoc:position 2 ;
    dzdoc:text "ويتحقق مندوبو الحسابات إذا ما تم احترام مبدأ المساواة بين المساهمين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4> ;
    dzdoc:position 3 ;
    dzdoc:text "ويجوز لهؤلاء أن يجروا طيلة السنة التحقيقات أو الرقابات التي يرونها مناسبة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4> ;
    dzdoc:position 4 ;
    dzdoc:text "كما يمكنهم استدعاء الجمعية العامة للانعقاد في حالة الاستعجال."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4> ;
    dzdoc:position 5 ;
    dzdoc:text "وإذا لم يتم تعين الجمعية العامة مندوبي الحسابات، أو في حالة وجود مانع أو رفض واحد أو أكثر من مندوبي الحسابات المعينين، يتم اللجوء إلى تعيينهم أو استبدالهم بموجب أمر من رئيس المحكمة التابعة لمقر الشركة بناء على طلب من مجلس الإدارة أو مجلس المديرين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4_para_6> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4> ;
    dzdoc:position 6 ;
    dzdoc:text "يمكن أن يقدم هذا الطلب كل معني وفي الشركات التي تلجأ علنيا للإدخار بواسطة السلطة المكلفة بتنظيم عمليات البورصة ومراقبتها."@ar .

