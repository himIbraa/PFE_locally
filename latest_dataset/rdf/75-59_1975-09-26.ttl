    dznorm:provisionText "تعتبر الشركة متضامنة مع مقدم الحصة وملزمة بأموالها الخاصة وبالدين المترتب على المحل التجاري المقدم."@ar ;
    dznorm:sourceArticle "art_117" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_117_obligation_5_78beb71e_role_933089cb1d> a dznorm:Role ;
    rdfs:label "المحل التجاري المقدم"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "تعتبر الشركة متضامنة مع مقدم الحصة وملزمة بأموالها الخاصة وبالدين المترتب على المحل التجاري المقدم."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_117> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_117_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_117> ;
    dzdoc:position 0 ;
    dzdoc:text "يخضع كل تقديم محل تجاري إلى الشركة للشروط التالية : أ- في حالة ما إذا كان المحل التجاري المقدم يتعلق بشركة في طور التكوين، فيكون النشر المقتضى لإحداث هذه الأخيرة كافيا، ب- أما إذا كان المحل التجاري المقدم يخص شركة مكونة سابقا، فإن الحصة المقدمة في هذه الحالة يجب أن تكون محل نشر خاص حسب ما هو مبين في المادتين 79 و 83 من هذا القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_117_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_117> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا يجوز أن يحرر العقد التأسيسي أو التعديلي الذي يثبت تقديم هذه الحصة إلا بعد خمسة عشر يوما من تاريخ انقضاء المهل المنصوص عليها في المادة 83. وفي جميع الأحوال، يتعين على مقدم الحصة أن يعين الموطن المختار في مكتب التوثيق الذي يختاره الشركاء لوضع هذا العقد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_117_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_117> ;
    dzdoc:position 2 ;
    dzdoc:text "ويجب على كل دائن للشريك الذي قدم الحصة أن يقدم التصريح عن صفته في الموطن المختار وفي المهل المحددة مع ذكر قيمة المبلغ المستحق له ويسلم له إيصال بهذا التصريح."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_117_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_117> ;
    dzdoc:position 3 ;
    dzdoc:text "فإذا انقضت المهل المحددة ولم يطلب شركاء المساهم إلغاء الحصة المقدمة، أو الشركة، أو إذا لم يصدر الإلغاء، تعتبر الشركة متضامنة مع مقدم الحصة وملزمة بأموالها الخاصة وبالدين المترتب على المحل التجاري المقدم."@ar .

