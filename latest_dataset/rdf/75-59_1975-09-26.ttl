<https://legal.dz/resource/order/1975-09-26/75-59#version_art_285> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقبل كل دائن مدرج في الميزانية أو تم تقديم دينه، في إبداء كل مطالبة عن طريق الشرح على الكشف لدى كتابة ضبط المحكمة في ميعاد خمسة عشر يوما من النشر الموجز في النشرة الرسمية للإعلانات القانونية وذلك إما بنفسه أو بوكيل عنه . كما أن للمدين نفس الحق ضمن نفس الشروط ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
