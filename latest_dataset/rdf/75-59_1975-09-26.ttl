<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4_obligation_1_2e959941> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_4_obligation_1_2e959941_role_48f9b17623> ;
