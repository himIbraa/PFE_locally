    dzdoc:eId "art_715_bis_22" ;
    dzdoc:fullText "تتقادم دعوى المسؤولية المؤسسة على بطلان الشركة حسب الشروط المنصوص عليها في المادة 743 المقطع الأول ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_22> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_22_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_22_19750926_OpEnact_28c7bc52c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 22" ;
    dzdoc:position 796 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_743> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_743> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_22_condition_0_b0e3636e> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_1> ;
    dzdoc:eId "art_715_bis_38" ;
    dzdoc:fullText "يحول السند للحامل عن طريق مجرد تسليم أو بواسطة قيد في الحسابات. ويحول السند الاسمي إزاء الغير وإزاء الشخص المعنوي المصدر عن طريق نقله في السجلات التي تمسكها الشركة لهذا الغرض. وتحدد الشروط التي تمسك وفقها هذه السجلات عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_38_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_38_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_38_19750926_OpEnact_689f6981ee> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 38" ;
    dzdoc:position 812 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:share ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_40" ;
    dzdoc:fullText "السهم هو سند قابل للتداول تصدره شركة مساهمة كتمثيل لجزء من رأسمالها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_40> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_40_defocc_574612b36bbe> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_40_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_40_19750926_OpEnact_dd38c38831> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 40" ;
    dzdoc:position 814 ;
    dzdoc:usesTerm dzterm:joint_stock_company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_43> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_43" ;
    dzdoc:fullText "للمساهمين العاديين الحق في حالة التصفية بالتراضي، في توزيع فائض التصفية بالتناسب مع مساهمتهم ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_43_right_0_7fabe73b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_43> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_43_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_43_19750926_OpEnact_cc46f2be7d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 43" ;
    dzdoc:position 817 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:enjoyment_shares ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_45" ;
    dzdoc:fullText "أسهم التمتع هي الأسهم التي تم تعويض مبلغها الاسمي إلى المساهم عن طريق الاستهلاك المخصوم إما من الفوائد أو الاحتياطات. ويمثل هذا الاستهلاك دفعا مسبقا للمساهم عن حصته في تصفية الشركة في المستقبل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_45> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_45_defocc_b6038b34f4b4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_45_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_45_19750926_OpEnact_aa9fca2925> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 45" ;
    dzdoc:position 819 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_52" ;
    dzdoc:fullText "يكون السهم النقدي اسميا إلى أن يدفع كاملا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_52_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_52_19750926_OpEnact_c558acf521> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_52_obligation_0_3fffefd3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 52" ;
    dzdoc:position 826 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_59" ;
    dzdoc:fullText "في حالة اندماج شركات أو في حالة تقديم الشركة لجزء من عناصر أصولها المالية لشركة أخرى ، تصبح الأسهم قابلة للتداول قصد تحقيق هذا الاندماج. وتفتح هذه الأسهم المجال حسب الحالات، لإصدار أسهم جديدة تؤخذ بتحويل الأسهم القديمة إلى سعر معادل أو إلى تسعيرة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_59_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_59_19750926_OpEnact_39270dac3c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 59" ;
    dzdoc:position 833 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_59_condition_0_294302a8> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:investment_certificates ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_3> ;
    dzdoc:eId "art_715_bis_62" ;
    dzdoc:fullText "تمثل شهادات الاستثمار التي يجب أن تكون قيمتها الاسمية مساوية للقيمة الاسمية لسهم الشركة المصدرة، حقوقا مالية، وهي قابلة للتداول."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_62> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_62_defocc_4dd792a4ed69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_62_para_0> ;
