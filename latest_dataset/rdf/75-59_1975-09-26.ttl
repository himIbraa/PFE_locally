<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_59> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة اندماج شركات أو في حالة تقديم الشركة لجزء من عناصر أصولها المالية لشركة أخرى ، تصبح الأسهم قابلة للتداول قصد تحقيق هذا الاندماج. وتفتح هذه الأسهم المجال حسب الحالات، لإصدار أسهم جديدة تؤخذ بتحويل الأسهم القديمة إلى سعر معادل أو إلى تسعيرة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_59_19750926_OpEnact_39270dac3c> ;
    dzdoc:replacementText "في حالة اندماج شركات أو في حالة تقديم الشركة لجزء من عناصر أصولها المالية لشركة أخرى ، تصبح الأسهم قابلة للتداول قصد تحقيق هذا الاندماج. وتفتح هذه الأسهم المجال حسب الحالات، لإصدار أسهم جديدة تؤخذ بتحويل الأسهم القديمة إلى سعر معادل أو إلى تسعيرة."@ar ;
