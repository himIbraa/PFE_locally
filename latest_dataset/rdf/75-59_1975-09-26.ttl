<https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_396> ;
    dzdoc:position 0 ;
    dzdoc:text "كل سفتجة وإن لم يشترط فيها صراحة كلمة « لأمر» تكون قابلة للتداول بطريق التظهير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_396> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا أدرج الساحب في نص السفتجة عبارة «ليست لأمر» أو عبارة مماثلة فلا يكون السند قابلا للتداول إلا على الشكل والآثار المرتبة على التنازل العادي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_396> ;
    dzdoc:position 2 ;
    dzdoc:text "ويمكن أن يكون التظهير حاصلا لصالح المسحوب عليه سواء أكان قابلا للسند أم لا أو لصالح الساحب أو أي ملتزم آخر سواه، وهؤلاء الأشخاص يمكنهم أن يظهروا السفتجة من جديد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_396> ;
    dzdoc:position 3 ;
    dzdoc:text "يجب أن يكون التظهير بدون قيد أو شرط."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_396> ;
    dzdoc:position 4 ;
    dzdoc:text "وكل شرط يعلق عليه التظهير يعد كأن لم يكن."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_396> ;
    dzdoc:position 5 ;
    dzdoc:text "ويعد التظهير الجزئي باطلا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_6> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_396> ;
    dzdoc:position 6 ;
    dzdoc:text "والتظهير «للحامل» يعد بمثابة تظهير على بياض."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_7> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_396> ;
    dzdoc:position 7 ;
    dzdoc:text "يجب أن يكتب التظهير على السفتجة ذاتها أو على ورقة ملحقة بها أي (متصلة بها) ويجب أن يكون مشتملا على توقيع المظهر ويضع هذا الأخير إمضاءه بيده أو بأي طريقة أخرى غير المخطوط باليد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_396_para_8> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_396> ;
    dzdoc:position 8 ;
    dzdoc:text "ويجوز ألا يعين في التظهير الشخص المستفيد منه أو أن تقتصر على توقيع المظهر فقط (تظهير على بياض) وفي هذه الحالة الأخيرة لا يكون التظهير صحيحا إلا إذا كان على ظهر السفتجة أو على الورقة المتصلة بها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_397_condition_0_c74ac4e8> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_397_condition_0_c74ac4e8_role_88bbb9eb1f> ;
    dznorm:conditionText "وإذا كان التظهير على بياض"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_397> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_397_condition_0_c74ac4e8_role_88bbb9eb1f> a dznorm:Role ;
    rdfs:label "بياض"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "وإذا كان التظهير على بياض"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_397> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_397_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_397> ;
    dzdoc:position 0 ;
    dzdoc:text "ينقل التظهير جميع الحقوق الناشئة عن السفتجة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_397_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_397> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا كان التظهير على بياض جاز لحاملها : أن يملأ البياض بوضع اسمه أو اسم شخص آخر، أن يظهر السفتجة من جديد على بياض أو أن يظهرها لشخص آخر، أن يسلم السفتجة إلى شخص من الغير بدون أن يملأ البياض ودون أن يظهرها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_398_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_398> ;
    dzdoc:position 0 ;
    dzdoc:text "إن المظهر ضامن قبول السفتجة ووفاءها ما لم يشترط خلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_398_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_398> ;
    dzdoc:position 1 ;
    dzdoc:text "وله أن يمنع تظهيرها من جديد وفي هذه الحالة لا يكون ملزما بالضمان للأشخاص الذين تظهر لهم السفتجة فيما بعد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_398_prohibition_0_18b6151b> a dznorm:Prohibition ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_prohibition_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_398_prohibition_0_18b6151b_action_f9568edd9a> ;
