<https://legal.dz/resource/order/1975-09-26/75-59#art_474_obligation_1_5d8b6330> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_474_obligation_1_5d8b6330_action_ebb59a54ff> ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_474_obligation_1_5d8b6330_role_e57713fac5> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_474> ;
    dznorm:position 1 ;
    dznorm:provisionText "لا يجوز سحب الشيك إلا على مؤسسة القرض البلدي أو صناديق القرض الفلاحي التي يكون لديها وقت إنشاء السند رصيد من النقود تحت تصرف الساحب وبموجب اتفاق صريح أو ضمني يحق بمقتضاه للساحب أن يتصرف في هذه النقود بطريقة إصدار الشيك"@ar ;
    dznorm:sourceArticle "art_474" .

