    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_2> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتألف عنوان الشركة من أسماء كل الشركاء المتضامنين أو من اسم أحدهم أو أكثر متبوع في كل الحالات بعبارة \" وشركاؤهم \" . وإذا كان عنوان الشركة يتألف من اسم شريك موص فيلتزم هذا الأخير من غير تحديد وبالتضامن، بديون الشركة ."@ar ;
