    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_785> ;
    dznorm:position 1 ;
    dznorm:provisionText "يجب على المصفي عند طلب تجديد وكالته أن يبين الأسباب التي حالت دون إقفال التصفية والتدابير التي ينوي اتخاذها والآجال التي يقتضيها إتمام التصفية"@ar ;
    dznorm:sourceArticle "art_785" .

