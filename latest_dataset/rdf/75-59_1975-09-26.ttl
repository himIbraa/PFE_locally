<https://legal.dz/resource/order/1975-09-26/75-59#version_art_561> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب إثبات إحالة الحصص الخاصة بالشركة بموجب عقد رسمي ويكون الاحتجاج بها على الشركة بعد تبليغها للشركة أو قبولها للإحالة بعقد رسمي. ولا يجوز الاحتجاج بها على الغير إلا بعد إتمام هذه الإجراءات وكذلك بعد النشر في السجل التجاري."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
