<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_71> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تم إصدار سندات استحقاق قابلة للتحويل إلى أسهم ، يتمتع حاملو شهادات الاستثمار بحق الأفضلية في الاكتتاب وبصفة غير قابلة للتخفيض وبما يتناسب وعدد السندات التي يمتلكونها . ويجوز لمالكي شهادات الاستثمار التنازل عن هذا الحق أثناء جمعية خاصة . ولا يمكن تحويل سندات الاستحقاق هذه إلا إلى شهادات استثمار . تمنح شهادات الحق في التصويت المطابقة لشهادات الاستثمار الصادرة بمناسبة التحويل، إلى حاملي شهادات الحق في التصويت الموجودة بتاريخ المنح بما يتناسب وحقوقهم ، إلا إذا تنازلوا عن حصتهم لفائدة مجموع الحام"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_71_19750926_OpEnact_86cc2503bf> ;
    dzdoc:replacementText "إذا تم إصدار سندات استحقاق قابلة للتحويل إلى أسهم ، يتمتع حاملو شهادات الاستثمار بحق الأفضلية في الاكتتاب وبصفة غير قابلة للتخفيض وبما يتناسب وعدد السندات التي يمتلكونها . ويجوز لمالكي شهادات الاستثمار التنازل عن هذا الحق أثناء جمعية خاصة . ولا يمكن تحويل سندات الاستحقاق هذه إلا إلى شهادات استثمار . تمنح شهادات الحق في التصويت المطابقة لشهادات الاستثمار الصادرة بمناسبة التحويل، إلى حاملي شهادات الحق في التصويت الموجودة بتاريخ المنح بما يتناسب وحقوقهم ، إلا إذا تنازلوا عن حصتهم لفائدة مجموع الحاملين أو لبعضهم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_71> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
