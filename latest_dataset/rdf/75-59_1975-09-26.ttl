    dznorm:hasCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_125_right_1_67ebcd0d_condition_0> ;
    dznorm:position 1 ;
    dznorm:provisionText "يجوز للمحكمة أن تأذن بحكمها للشخص القائم بالملاحقة، إذا لم يكن هناك دائن مقيد أو معارض وبشرط اقتطاع المصاريف الممتازة لمن له الحق فيها بأن يقبض الثمن مباشرة مقابل مجرد إيصال، من الموظف العمومي القائم بالبيع وذلك لطرحه من دينه أو تسديدا لدينه الأصلي مع المصاريف"@ar ;
    dznorm:sourceArticle "art_125" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_134_defocc_56b8ebde90cc> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 25 ;
    dzdoc:charStart 13 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:administrator_guardian ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_134> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_134_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يصبح المشتري متصرفا حارسا بحكم القانون على المحل التجاري إذا كان في حيازته، وذلك من تاريخ التبليغ بإعادة المزايدة. ولا يمكنه حينئذ سوى مباشرة أعمال الإدارة على أنه يمكنه أن يطلب من المحكمة أو من قاضي الأمور المستعجلة حسب الأحوال وفي كل طور من أطوار الإجراءات، تعيين متصرف آخر، ويجوز لكل دائن أن يقوم بتقديم مثل هذا الطلب."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_134_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_134> ;
    dzdoc:position 0 ;
    dzdoc:text "يصبح المشتري متصرفا حارسا بحكم القانون على المحل التجاري إذا كان في حيازته، وذلك من تاريخ التبليغ بإعادة المزايدة. ولا يمكنه حينئذ سوى مباشرة أعمال الإدارة على أنه يمكنه أن يطلب من المحكمة أو من قاضي الأمور المستعجلة حسب الأحوال وفي كل طور من أطوار الإجراءات، تعيين متصرف آخر، ويجوز لكل دائن أن يقوم بتقديم مثل هذا الطلب."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_157_obligation_0_4431d34c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_157_obligation_0_4431d34c_action_a94fbcf30f> ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_157_obligation_0_4431d34c_role_91eeacb04b> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_157> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_157_obligation_0_4431d34c_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب على المدين الذي يرغب في بيع كل أو جزء من الأموال المحملة بالديون عن طريق البيع الاختياري أن يطلب، إذا وقع ذلك قبل دفع المستحق من المبالغ المضمونة طبقا لهذا القانون، الموافقة المسبقة من الدائن المرتهن ، وخلاف ذلك، الإذن من قاضي الأمور المستعجلة للمحكمة التي تفصل بالدرجة الأخيرة"@ar ;
    dznorm:sourceArticle "art_157" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_164_right_0_3df414ab> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_164_right_0_3df414ab_action_19e76804f2> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_164> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_164_right_0_3df414ab_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجوز للدائن المنتفع بالامتياز الموضوع وفقا لهذا القانون، إذا حل الأجل ولم يتم الدفع، أن يطالب ببيع المال المثقل طبقا للإجراء المنصوص عليه فيما يتعلق ببيع الرهن"@ar ;
    dznorm:sourceArticle "art_164" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_166_right_0_4816fb0b> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_166_right_0_4816fb0b_action_3f18ea52b8> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_166> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_166_right_0_4816fb0b_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجوز للدائن المستفيد من الامتياز الثابت بمقتضى هذا القانون، عند عدم الدفع في الاستحقاق أن يقوم بالبيع العلني للمال المثقل طبقا للإجراء المنصوص عليه في مادة بيع الرهن"@ar ;
    dznorm:sourceArticle "art_166" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_166_right_1_2ad99cd4> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_166_right_1_2ad99cd4_action_726dba243a> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_166> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_166_right_1_2ad99cd4_condition_0> ;
    dznorm:position 1 ;
    dznorm:provisionText "ويجوز أن يأمر رئيس المحكمة بالشطب إذا سقط مفعوله ولم يقع تجديده"@ar ;
    dznorm:sourceArticle "art_166" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_179_obligation_0_eea0f165> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_179_obligation_0_eea0f165_action_e2024bac58> ;
    dzdoc:hasPeriod <https://legal.dz/resource/order/1975-09-26/75-59#art_179_obligation_0_eea0f165_period_dd77da9c46> ;
