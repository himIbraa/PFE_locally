<https://legal.dz/resource/order/1975-09-26/75-59#version_art_497> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن وفاء مبلغ الشيك يمكن أن يضمن كليا أو جزئيا بضمان احتياطي كفيل . ويكون هذا الضمان من الغير ما عدا المسحوب عليه أو حتى من موقع الشيك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_497_19750926_OpEnact_85381ce423> ;
