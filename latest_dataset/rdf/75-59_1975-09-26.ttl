<https://legal.dz/resource/order/1975-09-26/75-59#art_662_condition_0_1953c705> a dznorm:Condition ;
    dznorm:conditionText "وتحدد فترة وظائفهم بموجب القانون الأساسي دون تجاوز ست (6) سنوات في حالة التعيين من الجمعية العامة، ودون تجاوز ثلاث (3) سنوات في حالة التعيين بموجب القانون الأساسي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_662> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_662_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_662> ;
    dzdoc:position 0 ;
    dzdoc:text "تنتخب الجمعية العامة التأسيسية أو الجمعية العامة العادية، أعضاء مجلس المراقبة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_662_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_662> ;
    dzdoc:position 1 ;
    dzdoc:text "ويمكن إعادة انتخابهم ما لم ينص القانون الأساسي على خلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_662_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_662> ;
    dzdoc:position 2 ;
    dzdoc:text "وتحدد فترة وظائفهم بموجب القانون الأساسي دون تجاوز ست (6) سنوات في حالة التعيين من الجمعية العامة، ودون تجاوز ثلاث (3) سنوات في حالة التعيين بموجب القانون الأساسي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_662_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_662> ;
    dzdoc:position 3 ;
    dzdoc:text "غير أنه يمكن في حالة الدمج أو الانفصال أن يتم التعيين من الجمعية العامة غير العادية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_662_para_4> a dzdoc:Paragraph ;
