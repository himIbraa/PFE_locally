<https://legal.dz/resource/order/1975-09-26/75-59#art_393_obligation_0_a36451c9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_393_obligation_0_a36451c9_role_1fb5199b30> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_393> ;
    dznorm:position 0 ;
    dznorm:provisionText "كل من وضع توقيعه على سفتجة نيابة عن شخص لم يكن له توكيل منه بذلك يكون ملتزما شخصيا بمقتضى هذه السفتجة"@ar ;
    dznorm:sourceArticle "art_393" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_393_obligation_0_a36451c9_role_1fb5199b30> a dznorm:Role ;
    rdfs:label "سفتجة نيابة عن شخص"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "كل من وضع توقيعه على سفتجة نيابة عن شخص لم يكن له توكيل منه بذلك يكون ملتزما شخصيا بمقتضى هذه السفتجة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_393> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_393_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_393> ;
    dzdoc:position 0 ;
    dzdoc:text "إن السفتجة التي توقع من القصر الذين ليسوا تجارا تكون باطلة بالنسبة لهم بدون أن ينال ذلك من الحقوق التي يختص بها كل من الطرفين بمقتضى المادة 191 من القانون المدني."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_393_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_393> ;
    dzdoc:position 1 ;
    dzdoc:text "إذا كانت السفتجة محتوية على تواقيع أشخاص ليست لهم أهلية الالتزام بموجبها أو على توقيعات مزورة أو منسوبة لأشخاص وهميين أو على تواقيع ليس من شأنها لأي سبب آخر إلزام الأشخاص الذين وضعوا توقيعهم على السفتجة أو وقع عليها باسمهم فإن ذلك يحول دون صحة التزامات الموقعين الآخرين على السفتجة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_393_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_393> ;
    dzdoc:position 2 ;
    dzdoc:text "كل من وضع توقيعه على سفتجة نيابة عن شخص لم يكن له توكيل منه بذلك يكون ملتزما شخصيا بمقتضى هذه السفتجة وتكون له إن قام بالدفع نفس الحقوق التي كان لموكله المزعوم أن يحصل عليها ويجري الأمر بالمثل بالنسبة للوكيل الذي يتجاوز حدود وكالته."@ar .

