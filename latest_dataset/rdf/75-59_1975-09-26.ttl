<https://legal.dz/resource/order/1975-09-26/75-59#version_art_273> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز ل لمدين ، بمعونة وكيل التفليسة أن يقوم بكافة الإجراءات التحفظية وأن يباشر تحصيل السندات والديون الحالة الأداء وبيع الأشياء المعروضة للتلف القريب أو انخفاض القيمة الوشيك أو التي يكلف حفظها ثمنا باهظا وأن يرفع أو يتابع أية دعوى منقولة أو عقارية . وإذا كان المدين مأذونا بمتابعة استغلال مؤسسته الصناعية أو التجارية، وفقا للأوضاع المنصوص عليها في المادة 277 ، جاز له بمساعدة وكيل التفليسة القيام بكافة الإجراءات اللازمة لذلك الاستغلال ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_273_19750926_OpEnact_1fad666bce> ;
    dzdoc:replacementText "يجوز ل لمدين ، بمعونة وكيل التفليسة أن يقوم بكافة الإجراءات التحفظية وأن يباشر تحصيل السندات والديون الحالة الأداء وبيع الأشياء المعروضة للتلف القريب أو انخفاض القيمة الوشيك أو التي يكلف حفظها ثمنا باهظا وأن يرفع أو يتابع أية دعوى منقولة أو عقارية . وإذا كان المدين مأذونا بمتابعة استغلال مؤسسته الصناعية أو التجارية، وفقا للأوضاع المنصوص عليها في المادة 277 ، جاز له بمساعدة وكيل التفليسة القيام بكافة الإجراءات اللازمة لذلك الاستغلال ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_273> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
