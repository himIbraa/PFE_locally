<https://legal.dz/resource/order/1975-09-26/75-59#version_art_468> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تطبق أيضا على السند لأمر الأحكام المختصة بـ السفتجة الواجبة الدفع لدى الغير أو في منطقة غير المنطقة التي يوجد فيها المسحوب عليه ( المادتان 391 و 406 ) والأحكام المختصة باختلاف البيانات المتعلقة بالمبلغ الواجب إيفاؤه المادة (392) والأحكام المختصة بنتائج وضع التوقيع ضمن الشروط المبينة في المادة 393 وبنتائج توقيع شخص ليس بيده توكيل أو تجاوز حدود وكالته ( المادة 393 )."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_468_19750926_OpEnact_c76c66ba5d> ;
