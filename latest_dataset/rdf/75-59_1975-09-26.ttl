<https://legal.dz/resource/order/1975-09-26/75-59#version_art_197> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رفض المؤجر تجديد الإيجار ورغب المستأجر إما في منازعة ، سبب هذا الرفض، أو طلب سداد تعويض الإخلاء فإنه يجب على هذا الأخير أن يرفع دعوى على المؤجر أمام المحكمة التي يكون موقع العمارة تابعا لها . ويجري مجرى ذلك إذا رفض المؤجر تجديد الإيجار حسب الشروط المحددة وفقا ل المادة 195 أعلاه . ويجب في هذه الحالة تبليغ التكليف بالحضور في الثلاثة أشهر من تاريخ تبليغ رفض التجديد . يحقق في القضية و يفصل فيها في مدة وجيزة. ويجوز رفع الأحكام الصادرة بالدرجة النهائية إلى المجلس الأعلى . ويجوز للمالك الذي خسر دعو"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_197_19750926_OpEnact_e93fba8624> ;
    dzdoc:replacementText "إذا رفض المؤجر تجديد الإيجار ورغب المستأجر إما في منازعة ، سبب هذا الرفض، أو طلب سداد تعويض الإخلاء فإنه يجب على هذا الأخير أن يرفع دعوى على المؤجر أمام المحكمة التي يكون موقع العمارة تابعا لها . ويجري مجرى ذلك إذا رفض المؤجر تجديد الإيجار حسب الشروط المحددة وفقا ل المادة 195 أعلاه . ويجب في هذه الحالة تبليغ التكليف بالحضور في الثلاثة أشهر من تاريخ تبليغ رفض التجديد . يحقق في القضية و يفصل فيها في مدة وجيزة. ويجوز رفع الأحكام الصادرة بالدرجة النهائية إلى المجلس الأعلى . ويجوز للمالك الذي خسر دعواه أن يتملص من سداد التعويض في ظرف خمسة عشر يوما ابتداء من اليوم الذي يصبح فيه الحكم نهائيا إذا كان الأمر يتعلق بحكم ابتدائي أو ابتداء من يوم صدور الحكم إذا كان الأمر يتعلق بالمجلس القضائي ، بشرط أن يتحمل مصاريف الدعوى وأن يقبل بتجديد الإيجار الذي تحدد شروطه في حالة عدم الاتفاق، وفقا لقواعد المادة 195 . ولا يجوز ممارسة هذا الحق ما دام المستأجر ما زال موجودا في الأماكن وما دام لم يؤجر أو لم يشتر عمارة أخرى ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_197> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_197> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_198> a dzdoc:AmendmentEvent,
