<https://legal.dz/resource/order/1975-09-26/75-59#art_615_condition_0_ae86a781> a dznorm:Condition ;
    dznorm:conditionText "في حالة الدمج"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_615> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_615_obligation_0_01cad15c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_615_obligation_0_01cad15c_action_6ba203f141> ;
