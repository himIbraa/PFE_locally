<https://legal.dz/resource/order/1975-09-26/75-59#art_505_obligation_1_b31468f1_role_c9f7d7546d> a dznorm:Role ;
    rdfs:label "الحامل تحرير احتجاج بالنسبة"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "ويجب على الحامل تحرير احتجاج بالنسبة لباقي المبلغ"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_505> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_505_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_505> ;
    dzdoc:position 0 ;
    dzdoc:text "يحق للمسحوب عليه أن يطلب من الحامل عند وفائه قيمة الشيك أن يسلمه إليه مع التأشير عليه بالمخالصة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_505_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_505> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا يجوز للحامل أن يرفض الوفاء الجزئي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_505_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_505> ;
    dzdoc:position 2 ;
    dzdoc:text "وإذا كان مقابل الوفاء أقل من مبلغ الشيك، جاز للحامل أن يطلب الوفاء على قدر مقابل الوفاء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_505_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_505> ;
    dzdoc:position 3 ;
    dzdoc:text "وفي حالة الوفاء الجزئي يحق للمسحوب عليه أن يطلب ذكر هذا الوفاء في الشيك وإعطاءه مخالصة بذلك. وتعفى هذه المخالصة المدرجة في الشيك نفسه من الطابع المالي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_505_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_505> ;
    dzdoc:position 4 ;
    dzdoc:text "وتبرأ ذمة الساحبين والمظهرين بقدر الوفاء الجزئي من أصل مبلغ الشيك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_505_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_505> ;
    dzdoc:position 5 ;
    dzdoc:text "ويجب على الحامل تحرير احتجاج بالنسبة لباقي المبلغ."@ar .

