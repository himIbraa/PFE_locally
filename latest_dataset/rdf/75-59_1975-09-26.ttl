        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز لأصحاب سندات الاستحقاق وممثلي الجماعة التدخل في تسيير شؤون الشركة . أنه يجوز لممثلي جماعة أصحاب سندات الاستحقاق حضور الجمعيات العامة للمساهمين بصفة غير استشارية . ولهم الحق في الإطلاع على وثائق الشركة حسب نفس الشروط المطبقة على المساهمين ."@ar ;
