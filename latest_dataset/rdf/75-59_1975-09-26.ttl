<https://legal.dz/resource/order/1975-09-26/75-59#version_art_272> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل معارضة في الأموال التي أودعها وكيل التفليسة أو الغير لحساب الإفلاس تعد لاغية. وإذا وقعت معارضات على أموال مودعة من الغير ، و يجب على وكيل التفليسة أن يطلب رفعها والحصول على ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_272_19750926_OpEnact_dbc85f945a> ;
    dzdoc:replacementText "كل معارضة في الأموال التي أودعها وكيل التفليسة أو الغير لحساب الإفلاس تعد لاغية. وإذا وقعت معارضات على أموال مودعة من الغير ، و يجب على وكيل التفليسة أن يطلب رفعها والحصول على ذلك ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_272> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_272> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
