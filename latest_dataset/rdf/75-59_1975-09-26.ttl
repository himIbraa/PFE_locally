<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_7> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعين مندوبو الحسابات لثلاث سنوات مالية ، وتنتهي مهامهم بعد اجتماع الجمعية العامة العادية التي تفصل في حسابات السنة المالية الثالثة. يبقى مندوب الحسابات المعين من الجمعية بدل مندوب آخر يمارس وظيفته حتى انتهاء مهمة المندوب الذي استخلفه. وإذا أغفلت الجمعية تعيين مندوب للحسابات يجوز لكل مساهم أن يطلب من العدالة تعيين مندوب الحسابات ، ويبلغ قانونا بالحضور رئيس مجلس الإدارة أو مجلس المديرين وتنتهي المهمة الممنوحة عندما تقوم الجمعية العامة بتعيين مندوب أو مندوبي الحسابات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_7_19750926_OpEnact_3825a3019a> ;
    dzdoc:replacementText "يعين مندوبو الحسابات لثلاث سنوات مالية ، وتنتهي مهامهم بعد اجتماع الجمعية العامة العادية التي تفصل في حسابات السنة المالية الثالثة. يبقى مندوب الحسابات المعين من الجمعية بدل مندوب آخر يمارس وظيفته حتى انتهاء مهمة المندوب الذي استخلفه. وإذا أغفلت الجمعية تعيين مندوب للحسابات يجوز لكل مساهم أن يطلب من العدالة تعيين مندوب الحسابات ، ويبلغ قانونا بالحضور رئيس مجلس الإدارة أو مجلس المديرين وتنتهي المهمة الممنوحة عندما تقوم الجمعية العامة بتعيين مندوب أو مندوبي الحسابات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_7> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
