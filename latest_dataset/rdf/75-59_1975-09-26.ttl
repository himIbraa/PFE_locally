<https://legal.dz/resource/order/1975-09-26/75-59#art_167_extref_0df913b1> a dzdoc:ExternalReference ;
    rdfs:label "المادة 376 من قانون العقوبات"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/penal#art_376"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/code/penal#art_376"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/penal#art_376" ;
    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" ;
    dzdoc:targetEId "art_376" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_167_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_167> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق العقوبات المنصوص عليها في المادة 376 من قانون العقوبات على كل مشتر أو كل حائز للأموال المرهونة حيازيا، وفقا لهذا القانون، يقدم على إتلافها أو محاولة إتلافها أو يختلسها أو يحاول اختلاسها أو يفسدها أو يحاول إفسادها بأي طريقة كانت بغرض تعطيل حقوق الدائن."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_167_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_167> ;
    dzdoc:position 1 ;
    dzdoc:text "تطبق نفس العقوبات على كل من يقوم بأي محاولة للغش تهدف إلى حرمان الدائن من حقه في الامتياز الذي له على الأموال المثقلة بالدين أو إلى تنقيصه."@ar .

