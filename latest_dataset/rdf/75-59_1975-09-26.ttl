    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_398> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_398_right_0_29017dff> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
