<https://legal.dz/resource/order/1975-09-26/75-59#version_art_250> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن عدم التمسك المنصوص عليه في المادتين 247 فقرة 3 و 251 لا يمس صحة وفاء سفتجة أو سند لأمر أو شيك. غير أن لجماعة الدائنين أن ترفع دعوى رد المال إلى التفليسة ضد ساحب السفتجة، أو في حالة السحب لأجل الحساب ضد الأمر بالسحب وكذلك ضد المستفيد من الشيك وأول مظهر للسند لأمر ، بشرط إقامة الدليل على أن المطالب برد المال كان عالما بالتوقف على الدفع ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_250_19750926_OpEnact_f91817d086> ;
