<https://legal.dz/resource/order/1975-09-26/75-59#art_191> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_2_sec_5> ;
    dzdoc:eId "art_191" ;
    dzdoc:fullText "كل اشتراط مدرج في الإيجار ينص على الفسخ بقوة القانون في حالة عدم دفع بدل الإيجار في الاستحقاقات المتفق عليها ، لا ينتج أثره إلا بعد مرور شهر واحد من الإخطار بالدفع الذي يبقى بدون نتيجة . ويجب أن يشار في هذا الإخطار إلى هذه المهلة. يجوز للقضاة إذا رفع إليهم طلب مقدم وفقا للأوضاع والشروط المنصوص عليها في المادتين 277 الفقرة الأولى ، و 281 من القانون المدني، أن يوقفوا، في الوقت الذي يمنحون فيه مهلا، تحقيق وآثار شروط الفسخ لعدم سداد بدل الإيجار في الوقت المتفق عليه، وذلك إذا لم يعلن عن الفسخ أو يصدر عنه بحكم قضائي حاز قوة الشيء المقضي فيه ، ولا يكون للشرط الفاسخ أي أثر إذا تمكن المستأجر من التخلص من دينه ضمن الشروط المحددة من قبل القاضي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_191_permission_0_c7d83751> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_191> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_191_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_191_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_191_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_191_19750926_OpEnact_6a966586fc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_191_obligation_0_76a69180> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "191" ;
    dzdoc:position 195 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_191_extref_24342c65>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_191_extref_e39711d1> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_191_condition_0_ef80e010>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_191_condition_1_931a2158>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_191_condition_2_49fb9a6d> ;
    dzdoc:usesTerm dzterm:rent .

<https://legal.dz/resource/order/1975-09-26/75-59#art_244> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_244" ;
    dzdoc:fullText "يترتب بحكم القانون على الحكم بإشهار الإفلاس، ومن تاريخه تخلي المفلس عن إدارة أمواله أو التصرف فيها ، بما فيها الأموال التي قد يكتسبها بأي سبب كان، وما دام في حالة الإفلاس . ويمارس وكيل التفليسة جميع حقوق ودعاوى المفلس المتعلقة بذمته طيلة مدة التفليسة . على أنه يجوز للمفلس القيام بجميع الأعمال الاحتياطية لصيانة حقوقه والتدخل في الدعاوى التي يخاصم فيها وكيل التفليسة . ويترتب على الحكم الصادر بالتسوية القضائية اعتبارا من تاريخ أداء المساعدة الجبرية للمدين من طرف وكيل التفليسة في كافة الأعمال الخاصة بالتصرف في أمواله طبقا للأوضاع المنصوص عليها في المواد من 273 إلى 279 ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_244_permission_0_a2af604f> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_244_right_0_e7a69299> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_244> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_244_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_244_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_244_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_244_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_244_19750926_OpEnact_16efb19f89> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_244_obligation_0_f01c6d65>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_244_obligation_1_9102669e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "244" ;
    dzdoc:position 248 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_273>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_279> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_273>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_279> ;
    dzdoc:usesTerm dzterm:bankruptcy,
        dzterm:trustee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_245> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_245" ;
    dzdoc:fullText "يترتب على الحكم بشهر الإفلاس أو التسوية القضائية وقف كل دعوى شخصية لأفراد جماعة الدائنين ، وبناء على هذا توقف منذ الحكم كل طرق التنفيذ، سواء على المنقولات أو العقارات من جانب الدائنين الذين لا يضمن ديونهم امتياز خاص أو رهن حيازي أو عقاري على تلك الأموال ، أما الدعاوى المنقولة أو العقارية وطرق التنفيذ التي لا يشملها الإيقاف فلا يمكن متابعتها أو رفعها إلا ضد وكيل التفليسة أو إن كان للمحكمة أن تقبل المفلس كخصم متدخل، وفي التسوية القضائية لا يكون ذلك إلا ضد المدين و وكيل التفليسة معا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_245_permission_0_915d2094> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_245> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_245_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_245_19750926_OpEnact_c68346cc57> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_245_obligation_0_df207100>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_245_obligation_1_d7c5cce7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "245" ;
    dzdoc:position 249 ;
    dzdoc:usesTerm dzterm:trustee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_270> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_5> ;
    dzdoc:eId "art_270" ;
    dzdoc:fullText "يجوز لـ وكيل التفليسة ، بإذن القاضي المنتدب ، وبعد سماع أقوال المدين أو استدعائه برسالة موصى عليها، أن يجري التحكيم أو يتصالح وذلك في كافة المنازعات التي تعني جماعة الدائنين بما فيها المنازعات المتعلقة بحقوق أو دعاوى عقارية . فإذا كان موضوع شروط التحكيم أو الصلح غير محدد القيمة أو تجاوزت قيمته اختصاص المحكمة في الدرجة الأخيرة ، وجب عرض التحكيم أو الصلح على المحكمة للتصديق . ويستدعي المفلس عند التصديق و يكون له دائما حق المعارضة عليه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_270_permission_0_b48d673a> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_270_right_0_9d44f45e>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_270_right_1_bec47693> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_270> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_270_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_270_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_270_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_270_19750926_OpEnact_35795df33e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_270_obligation_0_dba5b9bc>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_270_obligation_1_5fc880ca> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 270" ;
    dzdoc:position 275 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_270_condition_0_12480526> ;
    dzdoc:usesTerm dzterm:judge_delegate,
        dzterm:syndic .

<https://legal.dz/resource/order/1975-09-26/75-59#art_296> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_3> ;
    dzdoc:eId "art_296" ;
    dzdoc:fullText "في حالة فسخ الإيجارات المنصوص عليها في المادتين 278 و 279 المتقدمتين يكون للمالك امتياز عن السنتين الأخيرتين من الأجرة المستحقة قبل الحكم بإشهار الإفلاس أو بالتسوية القضائية وعن السنة الجارية مقابل كل ما يخص تنفيذ الإجارة. وفي حالة عدم الفسخ فليس للمؤجر بعد استيفاء كل الإيجارات المستحقة أن يطالب بسداد الإيجارات الجارية أو المستقبلة ما دامت التأمينات التي كانت معطاة له لا تزال قائمة أو تلك التي أعطيت له منذ التوقف عن الدفع قد اعتبرت كافية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_296> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_296_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_296_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_296_19750926_OpEnact_9ed157f3e9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 296" ;
    dzdoc:position 301 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_278>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_279> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_278>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_279> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_296_condition_0_0476bcdb>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_296_condition_1_e0794ed0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_296_condition_2_22977c4b> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_320> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_2> ;
    dzdoc:eId "art_320" ;
    dzdoc:fullText "يتم التوقيع على الصلح حال انعقاد الجلسة وإلا كان باطلا ، فإن توفر واحد فقط من شرطي الأغلبية المنصوص عليهما في المادة 318 تستمر المداولة بميعاد ثمانية أيام دون مهلة سواه. وفي هذه الحالة لا يلزم بحضور الجمعية الثانية من حضر الجمعية الأولى من الدائنين ومن كانوا ممثلين فيها وكانوا قد وقعوا محضرها، وتبقى نهائية القرارات التي اتخذوها وكذلك ما أعطوا من الموافقات نهائية ومكتسبة ما لم يحضروا لتعديلها في الاجتماع الأخير أو يكون المدين قد عدل اقتراحاته خلال المهلة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_320> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_320_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_320_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_320_19750926_OpEnact_8b71d1e861> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_320_obligation_0_83ec9fd0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "320" ;
    dzdoc:position 325 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_318> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_318> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_320_condition_0_6ead21bd>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_320_condition_1_5627a5a8> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_338> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_5> ;
    dzdoc:eId "art_338" ;
    dzdoc:fullText "تقضي المحكمة بشهر الإفلاس : إذا لم يعرض المدين الصلح أو لم يحصل عليه ، إذا انحل عقد الصلح ، إذا حكم على المدين بالإفلاس بالتقصير ، إن كان المدين بقصد تأخير إثبات توقفه عن الدفع قد أجرى مشتريات لإعادة البيع بأدنى من سعر السوق أو استعمل بنفس القصد طرقا موجبة لخسائر شديدة ليحصل على أموال ، إذا رؤى أن مصاريفه الخاصة ومصاريف تجارته مفرطة ، إذا كان قد استهلك مبالغ جسيمة في عمليات نصيبية محضة ، إذا كان منذ التوقف عن الدفع أو في الخمسة عشر يوما السابقة له قد أجرى عملا مما ذكر في المادتين 246 و 247 المتقدمتين وذلك متى كانت المحاكم المختصة قد قضت بعدم الأخذ بها قبل جماعة الدائنين أو أقر الأطراف بهذا ، إن كان قد عقد لحساب الغير تعهدات رؤى أنها بالغة الضخامة بالنسبة لوضعه عند التعاقد وكان لم يقبض مقابلها شيئا ، إذا كان قد ارتكب في استغلال تجارته أعمالا بسوء نية أو بإهمال لا يغتفر أو جرت منه مخالفات جسيمة لقواعد وأعراف التجارة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_338> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_338_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_338_19750926_OpEnact_17e2107f0b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "338" ;
    dzdoc:position 343 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_246>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_247> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_246>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_247> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_338_condition_0_436f34b5>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_338_condition_1_c9b75a91>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_338_condition_2_24064e23>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_338_condition_3_0140548b>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_338_condition_4_4a7e009c>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_338_condition_5_9c1e8269>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_338_condition_6_2dd7a668>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_338_condition_7_7ef07b19>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_338_condition_8_0f71e080> ;
    dzdoc:usesTerm dzterm:bankruptcy .

<https://legal.dz/resource/order/1975-09-26/75-59#art_348> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_7> ;
    dzdoc:eId "art_348" ;
    dzdoc:fullText "يجوز قبول صلح بتخلي المفلس عن الأصول كلها أو بعضها . وينتج ذلك نفس آثار الصلح البسيط كما يجوز إبطاله أو فسخه لنفس الأسباب. ومع ذلك لا ينهي هذا الصلح التخلي فيما يتعلق بالأموال المتروكة وتجري تسوية هذه الأموال طبقا ل المادة 349 و المواد التالية لها من هذا القانون. ويترك ل المدين ما زاد على ديونه من الناتج عن بيع الأصول المتخلى عنها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_348_permission_0_e0d7a2a0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_348_permission_1_ea3f5bdf> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_348_right_0_b2aa62bb>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_348_right_1_a663b3d9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_348> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_348_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_348_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_348_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_348_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_348_19750926_OpEnact_ab463a2a2b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 348" ;
    dzdoc:position 353 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_349>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_350> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_349>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_350> ;
    dzdoc:usesTerm dzterm:bankrupt,
        dzterm:debtor,
