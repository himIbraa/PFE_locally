<https://legal.dz/resource/order/1975-09-26/75-59#art_371_condition_0_b2430b52> a dznorm:Condition ;
    dzdoc:hasPeriod <https://legal.dz/resource/order/1975-09-26/75-59#art_371_condition_0_b2430b52_period_631cffee33> ;
    dznorm:conditionText "إذا بغير عذر شرعي لم يقوموا بالتصريح لدى كتابة ضبط المحكمة المختصة خلال الخمسة عشر يوما عن حالة التوقف عن الدفع دون مانع مشروع، أو لم يتضمن هذا التصريح قائمة بالشركاء المتضامنين مع بيان أسمائهم وموطنهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_371> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_371_condition_0_b2430b52_period_631cffee33> a dznorm:Period ;
    rdfs:label "خلال الخمسة عشر يوما عن حالة التوقف"@ar ;
    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "إذا بغير عذر شرعي لم يقوموا بالتصريح لدى كتابة ضبط المحكمة المختصة خلال الخمسة عشر يوما عن حالة التوقف عن الدفع دون مانع مشروع، أو لم يتضمن هذا التصريح قائمة بالشركاء المتضامنين مع بيان أسمائهم وموطنهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_371> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_371_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_371> ;
    dzdoc:position 1 ;
    dzdoc:text "وبالنسبة للشركات التي تشتمل على شركاء مسؤولين بالتضامن بدون تحديد عن ديون الشركة، يجوز أن يعتبر الممثلون القانونيون مرتكبين للتفليس بالتقصير إذا بغير عذر شرعي لم يقوموا بالتصريح لدى كتابة ضبط المحكمة المختصة خلال الخمسة عشر يوما عن حالة التوقف عن الدفع دون مانع مشروع، أو لم يتضمن هذا التصريح قائمة بالشركاء المتضامنين مع بيان أسمائهم وموطنهم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_371_permission_0_ea7b0eae> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_371_permission_0_ea7b0eae_action_67c688f869> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_371> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجوز أن يعتبر مرتكبا للتفليس بالتقصير كل تاجر في حالة توقف عن الدفع يوجد في إحدى الحالات الآتية : إذا كان قد عقد لحساب الغير تعهدات ثبت أنها بالغة الضخامة بالنسبة لوضعه عند التعاقد بغير أن يتقاضى مقابلها شيئا، إذا كان قد حكم بإفلاسه دون أن يكون قد أوفى بالتزاماته عن صلح سابق، إذا كان لم يقم بالتصريح لدى كاتب ضبط المحكمة عن حالة التوقف عن الدفع في مهلة خمسة عشر يوما، دون مانع مشروع، إذا كان لم يحضر بشخصه لدى وكيل التفليسة في الأحوال والمواعيد المحددة، دون مانع مشروع، إذا كانت حساباته ناقصة أو غير ممسوكة بانتظام."@ar ;
    dznorm:sourceArticle "art_371" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_371_permission_0_ea7b0eae_action_67c688f869> a dznorm:Action ;
    rdfs:label "أن يعتبر مرتكبا للتفليس بالتقصير"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجوز أن يعتبر مرتكبا للتفليس بالتقصير كل تاجر في حالة توقف عن الدفع يوجد في إحدى الحالات الآتية : إذا كان قد عقد لحساب الغير تعهدات ثبت أنها بالغة الضخامة بالنسبة لوضعه عند التعاقد بغير أن يتقاضى مقابلها شيئا، إذا كان قد حكم بإفلاسه دون أن يكون قد أوفى بالتزاماته عن صلح سابق، إذا كان لم يقم بالتصريح لدى كاتب ضبط المحكمة عن حالة التوقف عن الدفع في مهلة خمسة عشر يوما، دون مانع مشروع، إذا كان لم يحضر بشخصه لدى وكيل التفليسة في الأحوال والمواعيد المحددة، دون مانع مشروع، إذا كانت حساباته ناقصة أو غير ممسوكة بانتظام."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_371> .

