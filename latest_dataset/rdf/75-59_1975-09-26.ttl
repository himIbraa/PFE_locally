    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_179_obligation_0_eea0f165_role_3b545c40fc>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_179_obligation_0_eea0f165_role_4a69bd21c2> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_177> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_177> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_179> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_179_obligation_0_eea0f165_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب على المستأجر لكي يستفيد من حق الأولوية المنصوص عليه في المادة 177 أن يبلغ، عند إخلائه للأماكن التي كان يشغلها أو على الأكثر في خلال الثلاثة أشهر التالية لذلك، عن نيته في الاستفادة إلى المالك بعقد غير قضائي مع إعلامه بعنوان موطنه الجديد"@ar ;
    dznorm:sourceArticle "art_179" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_1_defocc_09659babb66f> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 71 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
