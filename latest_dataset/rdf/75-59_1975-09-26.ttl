<https://legal.dz/resource/order/1975-09-26/75-59#version_art_788> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمثل المصفي الشركة وتخول له السلطات الواسعة لبيع الأصول ولو بالتراضي. غير أن القيود الواردة على هذه السلطات الناتجة عن القانون الأساسي أو أمر التعيين لا يحتج بها على الغير. وتكون له الأهلية لتسديد الديون وتوزيع الرصيد الباقي. ولا يجوز له متابعة الدعاوي الجارية أو القيام بدعاوي جديدة لصالح التصفية ما لم يؤذن له بذلك من الشركاء أو بقرار قضائي إذا تم تعيينه بنفس الطريقة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_788_19750926_OpEnact_dd119f195d> ;
    dzdoc:replacementText "يمثل المصفي الشركة وتخول له السلطات الواسعة لبيع الأصول ولو بالتراضي. غير أن القيود الواردة على هذه السلطات الناتجة عن القانون الأساسي أو أمر التعيين لا يحتج بها على الغير. وتكون له الأهلية لتسديد الديون وتوزيع الرصيد الباقي. ولا يجوز له متابعة الدعاوي الجارية أو القيام بدعاوي جديدة لصالح التصفية ما لم يؤذن له بذلك من الشركاء أو بقرار قضائي إذا تم تعيينه بنفس الطريقة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
