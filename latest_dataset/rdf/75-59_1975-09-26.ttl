    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 29" ;
    dzdoc:position 31 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_292> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_3> ;
    dzdoc:eId "art_292" ;
    dzdoc:fullText "لا يقيد الدائنون ذوو الرهون الصحيحة ضمن جماعة الدائنين ، إلا على سبيل المراجعة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_292> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_292_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_292_19750926_OpEnact_0841af5c68> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 292" ;
    dzdoc:position 297 ;
    dzdoc:usesTerm dzterm:creditors,
        dzterm:creditors_group .

<https://legal.dz/resource/order/1975-09-26/75-59#art_304> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_4> ;
    dzdoc:eId "art_304" ;
    dzdoc:fullText "يجرى على النحو التالي بالنسبة للدائنين المرتهنين عقاريا والذين لم تسمح لهم مرتبتهم في توزيع ثمن العقارات إلا باستيفاء جزئي، تحدد نهائيا حقوقهم في جماعة الدائنين العاديين تبعا للمبالغ التي يبقون دائنين بها بعد التوزيع العقاري، وأما المبالغ التي قبضوها في توزيع سابق زائدة على هذه النسبة فإنها تستبعد من مقدار حصتهم في توزيع المرتهنين عقاريا وتضاف لجماعة الدائنين العاديين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_304> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_304_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_304_19750926_OpEnact_83cda1b479> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "304" ;
    dzdoc:position 309 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_336> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_5> ;
    dzdoc:eId "art_336" ;
    dzdoc:fullText "تقضي المحكمة بتحويل التسوية القضائية إلى تفليسة إن وجدت محلا لذلك، طبقا للأوضاع الواردة فيما بعد، وذلك بحكم يصدر في جلسة علنية تلقائيا أو بناء على طلب إما من وكيل التفليسة أو الدائنين بناء على تقرير القاضي المنتدب ، بعد السماع للمدين أو دعوته للحضور قانونا بموجب رسالة موصى عليها مع طلب العلم بالوصول."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_336> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_336_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_336_19750926_OpEnact_04f2b9b9c1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "336" ;
    dzdoc:position 341 ;
    dzdoc:usesTerm dzterm:bankruptcy,
        dzterm:bankruptcy_trustee,
        dzterm:delegated_judge,
        dzterm:judicial_settlement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_345> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_6> ;
    dzdoc:eId "art_345" ;
    dzdoc:fullText "لا يبطل ما أجراه المدين من أعمال بعد حكم التصديق وقبل إبطال أو فسخ الصلح إلا ما جرى منه تدليسا بحقوق الدائنين وطبقا لأحكام المادة 103 من القانون المدني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_345> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_345_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_345_19750926_OpEnact_d68ce581a2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "345" ;
    dzdoc:position 350 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_345_extref_01dc79ca> ;
    dzdoc:usesTerm dzterm:composition,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_347> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_7> ;
    dzdoc:eId "art_347" ;
    dzdoc:fullText "لا يقبل من المدين التاجر طلب الاستفادة ب التخلي عن المال ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_347> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_347_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_347_19750926_OpEnact_d0107d8e28> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 347" ;
    dzdoc:position 352 ;
    dzdoc:usesTerm dzterm:asset_abandonment,
        dzterm:debtor,
        dzterm:trader .

<https://legal.dz/resource/order/1975-09-26/75-59#art_35> a dzdoc:Article ;
