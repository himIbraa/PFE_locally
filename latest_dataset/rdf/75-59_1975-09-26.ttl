<https://legal.dz/resource/order/1975-09-26/75-59#art_733_extref_2b07af3b> a dzdoc:ExternalReference ;
    rdfs:label "المادة 426 من القانون المدني"@ar ;
    dzdoc:frbrUri "/akn/dz/act/order/1975-09-26/75-58#art_426"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/order/1975-09-26/75-58#art_426"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/order/1975-09-26/75-58#art_426" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/order/1975-09-26/75-58"^^xsd:anyURI ;
    dzdoc:targetEId "art_426" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_733_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_733> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يحصل بطلان شركة أو عقد معدل للقانون الأساسي إلا بنص صريح في هذا القانون أو القانون الذي يسرى على بطلان العقود. وفيما يتعلق بـالشركات ذات المسؤولية المحدودة أو الشركات المساهمة، فإن البطلان لا يحصل من عيب في القبول ولا من فقد الأهلية ما لم يشمل هذا الفقد كافة الشركاء المؤسسين. كما أن هذا البطلان لا يحصل من بطلان الشروط المحظورة بالفقرة الأولى من المادة 426 من القانون المدني."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_733_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_733> ;
    dzdoc:position 1 ;
    dzdoc:text "لا يحصل بطلان العقود أو المداولات غير التي نصت عليها الفقرة المتقدمة إلا من مخالفة نص ملزم من هذا القانون أو من القوانين التي تسري على العقود."@ar .

