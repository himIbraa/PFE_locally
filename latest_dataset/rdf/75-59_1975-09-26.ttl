<https://legal.dz/resource/order/1975-09-26/75-59#version_art_91> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عند حصول المعارضة في دفع الثمن يمكن للبائع في كل الأحوال وبعد انقضاء مهلة خمسة عشر يوما ابتداء من رفع تلك المعارضة، أن يرفع دعوى مستعجلة أمام رئيس المحكمة طالبا فيها الإذن له بقبض الثمن بالرغم من المعارضة على شرط أن يدفع لمصلحة الودائع والأمانات أو للغير المنتدب لهذا الغرض المبلغ الكافي الذي يعينه قاضي الأمور المستعجلة لضمان أسباب المعارضة فيما إذا ظهر أو حكم عليه بأنه مدين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_91_19750926_OpEnact_d5b7ad591d> ;
    dzdoc:replacementText "عند حصول المعارضة في دفع الثمن يمكن للبائع في كل الأحوال وبعد انقضاء مهلة خمسة عشر يوما ابتداء من رفع تلك المعارضة، أن يرفع دعوى مستعجلة أمام رئيس المحكمة طالبا فيها الإذن له بقبض الثمن بالرغم من المعارضة على شرط أن يدفع لمصلحة الودائع والأمانات أو للغير المنتدب لهذا الغرض المبلغ الكافي الذي يعينه قاضي الأمور المستعجلة لضمان أسباب المعارضة فيما إذا ظهر أو حكم عليه بأنه مدين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_91> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_91> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
