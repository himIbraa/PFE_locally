<https://legal.dz/resource/order/1975-09-26/75-59#version_art_321> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للدائنين أن يحضروا بأشخاصهم الجمعيات المنصوص عليها في المادتين 317 و 320 أو أن ينيبوا عنهم من يمثلهم فيها مزودا بتفويض ما لم يكن معفى من تقديمه قانونا . ويعتبر توقيع الدائن أو نائبه على أوراق التصويت المرفقة بالمحضر بمثابة توقيع على المحضر ذاته."@ar ;
