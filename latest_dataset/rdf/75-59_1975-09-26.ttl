<https://legal.dz/resource/order/1975-09-26/75-59#version_art_422> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يتمكن من ضاعت منه السفتجة سواء أكانت أو لم تكن متضمنة لصيغة القبول من أن يحضر نسختها الثانية أو الثالثة أو الرابعة الخ ... جاز له أن يطلب وفاء السفتجة الضائعة والحصول على ذلك بمقتضى أمر من القاضي بعد أن يثبت ملكيته لها بدفاتره وبشرط تقديم كفيل ."@ar ;
