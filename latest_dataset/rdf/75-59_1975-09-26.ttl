    dzdoc:number "715 مكرر 71" ;
    dzdoc:position 845 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_71_condition_0_2dff4d0f>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_71_condition_1_ed243837> ;
