    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_188> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_188_right_0_3f75a595> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_188_right_0_3f75a595_action_e04b33c92f> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_188> ;
    dznorm:position 0 ;
    dznorm:provisionText "ويجوز للمالك عندما يزيد بدل الإيجار من الباطن عن بدل الإيجار الأصلي أن يطالب بزيادة مطابقة لبدل الإيجار الأصلي"@ar ;
    dznorm:sourceArticle "art_188" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_188_right_0_3f75a595_action_e04b33c92f> a dznorm:Action ;
