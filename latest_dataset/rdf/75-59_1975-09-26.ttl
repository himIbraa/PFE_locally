<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_42_defocc_7c61e37530f1> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 14 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
