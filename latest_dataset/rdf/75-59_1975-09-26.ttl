<https://legal.dz/resource/order/1975-09-26/75-59#version_art_348> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز قبول صلح بتخلي المفلس عن الأصول كلها أو بعضها . وينتج ذلك نفس آثار الصلح البسيط كما يجوز إبطاله أو فسخه لنفس الأسباب. ومع ذلك لا ينهي هذا الصلح التخلي فيما يتعلق بالأموال المتروكة وتجري تسوية هذه الأموال طبقا ل المادة 349 و المواد التالية لها من هذا القانون. ويترك ل المدين ما زاد على ديونه من الناتج عن بيع الأصول المتخلى عنها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_348_19750926_OpEnact_ab463a2a2b> ;
    dzdoc:replacementText "يجوز قبول صلح بتخلي المفلس عن الأصول كلها أو بعضها . وينتج ذلك نفس آثار الصلح البسيط كما يجوز إبطاله أو فسخه لنفس الأسباب. ومع ذلك لا ينهي هذا الصلح التخلي فيما يتعلق بالأموال المتروكة وتجري تسوية هذه الأموال طبقا ل المادة 349 و المواد التالية لها من هذا القانون. ويترك ل المدين ما زاد على ديونه من الناتج عن بيع الأصول المتخلى عنها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_348> ;
