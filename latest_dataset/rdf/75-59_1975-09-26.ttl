<https://legal.dz/resource/order/1975-09-26/75-59#version_art_824> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن من سنة واحدة إلى خمس سنوات وبغرامة من 20.000 دج إلى 2.500.000 دج الأشخاص الذين ارتكبوا المخالفات المنصوص عليها في المادة السابقة قصد حرمان المساهمين أو البعض منهم من حصة واحدة من حقهم في مال الشركة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_824_19750926_OpEnact_65d745a820> ;
