<https://legal.dz/resource/order/1975-09-26/75-59#art_103> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_103" ;
    dzdoc:fullText "يحفظ القيد الامتياز لمدة عشر سنوات من تاريخه، ويشطب تلقائيا إذا لم يجدد قبل انقضاء هذه المهلة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_103> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_103_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_103_19750926_OpEnact_a9f08ab8ee> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "103" ;
    dzdoc:position 105 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_103_condition_0_5a9920c7> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_105> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_105" ;
    dzdoc:fullText "تتم عملية الشطب بتأشير يقوم به مأمورو السجل التجاري على هامش القيد وتسلم شهادة منه للأطراف التي يطلبونها. ويحصل الشطب الكلي أو الجزئي للقيد في المعهد الجزائري للملكية الصناعية وتنظيمها ، طبقا ل المادة 99 وذلك بناء على تقديم شهادة الشطب المسلمة من مأموري السجل التجاري ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_105> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_105_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_105_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_105_19750926_OpEnact_afd937bf48> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "105" ;
    dzdoc:position 107 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_99> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_99> ;
    dzdoc:usesTerm dzterm:inapi,
        dzterm:registrar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_145> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_5> ;
    dzdoc:eId "art_145" ;
    dzdoc:fullText "يتم التصريح بالدين في الموطن المختار تنفيذا للمادة 117 من هذا القانون في نسختين تتضمن كل منهما التاريخ الذي تم فيه التصريح، واسم المصرح ، واسم وعنوان المدين مع بيان نوع ومقر المحل التجاري الذي يملكه المدين و مبلغ الدين وبيان مقدار حصة المحل التجاري المقدمة للشركة التي يجب بيان نوعها ومقرها، وعند الاقتضاء تاريخ ورقم عقد إنشاء هذه الشركة وكذلك تاريخ إيداعه ب المركز الوطني للسجل التجاري . ويرفق إحدى النسختين بالعقد المثبت للحصة وتسلم النسخة الثانية للمصرح بعد التأشير عليها من طرف محرر العقد، لتكون بمثابة إيصال له."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_145> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_145_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_145_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_145_19750926_OpEnact_5d4431271a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "145" ;
    dzdoc:position 147 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_117> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_117> ;
    dzdoc:usesTerm dzterm:national_center_commercial_register .

<https://legal.dz/resource/order/1975-09-26/75-59#art_150> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_7> ;
    dzdoc:eId "art_150" ;
    dzdoc:fullText "يعاقب بالحبس من شهر إلى 3 أشهر وبغرامة لا تتجاوز 100.000 دج أو بإحدى هاتين العقوبتين فقط، كل من يخالف الحظر المنصوص عليه في المادة السابقة . وتضاعف العقوبة في حالة العود."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_150> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_150_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_150_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_150_19750926_OpEnact_a9db23007c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 150" ;
    dzdoc:position 152 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_149> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_149> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_168> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_8> ;
    dzdoc:eId "art_168" ;
    dzdoc:fullText "لا تخضع لأحكام هذا الفصل السيارات و البواخر و المركبات الجوية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_168> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_168_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_168_19750926_OpEnact_88e4fbff5a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 168" ;
    dzdoc:position 170 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_168_condition_0_cc54227f> ;
    dzdoc:usesTerm dzterm:aircraft,
        dzterm:cars,
        dzterm:ships .

<https://legal.dz/resource/order/1975-09-26/75-59#art_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_3_sec_1> ;
    dzdoc:eId "art_19" ;
    dzdoc:fullText "يلزم بالتسجيل في السجل التجاري . 1 – كل شخص طبيعي له صفة التاجر في نظر القانون الجزائري ويمارس أعماله التجارية داخل القطر الجزائري. 2 – كل شخص معنوي تاجر بالشكل، أو يكون موضوعه تجاريا، ومقره في الجزائر، أو كان له مكتب أو فرع أو أي مؤسسة كانت."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_19_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_19_19750926_OpEnact_a981fe2fe7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_19_obligation_0_b2fdd0f1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "19" ;
    dzdoc:position 20 ;
    dzdoc:usesTerm dzterm:algerian_law,
        dzterm:commercial_register,
        dzterm:legal_entity,
        dzterm:natural_person,
        dzterm:trader .

<https://legal.dz/resource/order/1975-09-26/75-59#art_199> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_2_sec_7> ;
    dzdoc:eId "art_199" ;
    dzdoc:fullText "تلغى وتصبح عديمة المفعول مهما كان شكلها البنود والشروط والتسويات التي يكون من شأنها إسقاط الحق في تجديد الإيجار الذي أنشئ بموجب هذا الباب، ولاسيما أحكام المواد من 191 إلى 193 ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_199_right_0_acea0486> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_199> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_199_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_199_19750926_OpEnact_32ee6f264d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 199" ;
    dzdoc:position 203 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_191>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_193> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_191>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_193> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:commercial_act_by_object ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_1> ;
    dzdoc:eId "art_2" ;
    dzdoc:fullText "يعد عملا تجاريا بحسب موضوعه : كل شراء للمنقولات لإعادة بيعها بعينها أو بعد تحويلها وشغلها، كل شراء للعقارات لإعادة بيعها، كل مقاولة لتأجير المنقولات أو العقارات، كل مقاولة للإنتاج أو التحويل أو الإصلاح، كل مقاولة للبناء أو الحفر أو لتمهيد الأرض، كل مقاولة للتوريد أو الخدمات، كل مقاولة لاستغلال المناجم أو المناجم السطحية أو مقالع الحجارة أو منتوجات الأرض الأخرى، كل مقاولة لاستغلال النقل أو الانتقال، كل مقاولة لاستغلال الملاهي العمومية أو الإنتاج الفكري، كل مقاولة للتأمينات كل مقاولة لاستغلال المخازن العمومية، كل مقاولة لبيع السلع الجديدة بالمزاد العلني بالجملة أو الأشياء المستعملة بالتجزئة، كل عملية مصرفية أو عملية صرف أو سمسرة أو خاصة بالعمولة، كل عملية توسط لشراء وبيع العقارات أو المحلات التجارية والقيم العقارية، كل مقاولة لصنع أو شراء أو بيع وإعادة بيع السفن للملاحة البحرية، كل شراء وبيع لعتاد أو مؤمن للسفن، كل تأجير أو اقتراض أو قرض بحري بالمغامرة، كل عقود التأمين والعقود الأخرى المتعلقة بالتجارة البحرية، كل الاتفاقيات والاتفاقات المتعلقة بأجور الطاقم وإيجارهم، كل الرحلات البحرية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_2> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_2_defocc_c01af520e2a5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_2_19750926_OpEnact_b9e2e4d0b6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "2" ;
    dzdoc:position 2 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_200> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_2_sec_7> ;
    dzdoc:eId "art_200" ;
    dzdoc:fullText "تلغى التعاقدات أيضا مهما كان شكلها إذا كانت ترمي إلى منع المستأجر من التنازل عن إيجاره لمشتري محله التجاري أو مؤسسته ، وكذلك الاتفاقيات التي تجعل مشتري المتجر خاضعا لقبول المالك"@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_200_right_0_469bb8eb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_200> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_200_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_200_19750926_OpEnact_73cc5f403a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 200" ;
    dzdoc:position 204 ;
    dzdoc:usesTerm dzterm:lessee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_221> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_2> ;
    dzdoc:eId "art_221" ;
    dzdoc:fullText "لرئيس المحكمة أن يأمر بكل إجراءات التحقيق لتلقي جميع المعلومات عن وضعية المدين وتصرفاته ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_221_right_0_47a5e3d1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_221> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_221_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_221_19750926_OpEnact_6cd7cfa149> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "221" ;
    dzdoc:position 225 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_227> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_2> ;
    dzdoc:eId "art_227" ;
    dzdoc:fullText "تكون جميع الأحكام والأوامر الصادرة بمقتضى هذا الباب معجلة التنفيذ رغم المعارضة أو الاستئناف و ذلك باستثناء الحكم الذي يقضي بالمصادقة على الصلح ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_227> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_227_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_227_19750926_OpEnact_8300a2f81a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_227_obligation_0_39af7a76> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 227" ;
    dzdoc:position 231 ;
    dzdoc:usesTerm dzterm:reconciliation .

<https://legal.dz/resource/order/1975-09-26/75-59#art_232> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_3> ;
    dzdoc:eId "art_232" ;
    dzdoc:fullText "لا تخضع الأحكام التالية لأي طريق من طرق الطعن : الأحكام الصادرة طبقا ل المادة 287 ، الأحكام التي تفصل بها المحكمة في الطعون الواردة على الأوامر الصادرة من القاضي المنتدب في حدود اختصاصاته، الأحكام الخاصة بالإذن باستغلال المحل التجاري."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_232> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_232_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_232_19750926_OpEnact_9dbe0bafae> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_232_obligation_0_76d2bb6c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 232" ;
    dzdoc:position 236 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_287> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_287> ;
    dzdoc:usesTerm dzterm:delegated_judge .

<https://legal.dz/resource/order/1975-09-26/75-59#art_259> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_3> ;
    dzdoc:eId "art_259" ;
    dzdoc:fullText "يقوم رئيس المحكمة الذي وضع الأختام في الأحوال المنصوص عليها في المادة السابقة بإبلاغ رئيس المحكمة الذي حكم بشهر الإفلاس أو التسوية القضائية بلا إبطاء بحصول وضع الأختام ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_259> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_259_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_259_19750926_OpEnact_abb5ee3378> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_259_obligation_0_d4d6e6f8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "259" ;
    dzdoc:position 264 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_258> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_258> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_269> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_5> ;
    dzdoc:eId "art_269" ;
    dzdoc:fullText "للمادة القاضي المنتدب بعد سماع المدين أو استدعائه برسالة موصى عليها، أن يأذن لـ وكيل التفليسة بمباشرة بيع باقي الأموال المنقولة أو البضائع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_269_right_0_9ee1b397> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_269> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_269_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_269_19750926_OpEnact_c51add3fd9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 269" ;
    dzdoc:position 274 ;
    dzdoc:usesTerm dzterm:judge_delegate,
        dzterm:syndic .

<https://legal.dz/resource/order/1975-09-26/75-59#art_288> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_2> ;
    dzdoc:eId "art_288" ;
    dzdoc:fullText "للدائن صاحب التعهدات الموقعة أو المظهرة أو المكفولة تضامنيا من قبل المدين وشركاء له في الالتزام والمتوقفين عن الدفع، أن يطالب كل جماعات الدائنين بالقيمة الاسمية لسنده وأن يشترك في التوزيعات حتى الوفاء الكامل ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_288_right_0_5f5c5ccf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_288> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_288_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_288_19750926_OpEnact_c03655ce2c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 288" ;
    dzdoc:position 293 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_291> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_2> ;
    dzdoc:eId "art_291" ;
    dzdoc:fullText "يحتفظ الدائنون بدعواهم بكامل حقهم ضد شركاء مدينهم في الالتزام، رغم إبرام الصلح ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_291_right_0_3f823051> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_291> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_291_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_291_19750926_OpEnact_eeff13034f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 291" ;
    dzdoc:position 296 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_295> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_3> ;
    dzdoc:eId "art_295" ;
    dzdoc:fullText "إذا لم توجد بين يدي وكيل التفليسة الأموال اللازمة للوفاء المنصوص عليه في المادة السابقة فيجب تسديد المبالغ المستحقة من حصيلة أول إيرادات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_295> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_295_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_295_19750926_OpEnact_b1fbf5fd47> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 295" ;
    dzdoc:position 300 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_294> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_294> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_295_condition_0_88f0f0da> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:commercial_act_by_form ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_1> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "يعد عملا تجاريا بحسب شكله التعامل بالسفتجة بين كل الأشخاص، الشركات التجارية، وكالات ومكاتب الأعمال مهما كان هدفها، العمليات المتعلقة بالمحلات التجارية كل عقد تجاري يتعلق بالتجارة البحرية والجوية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_3> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_3_defocc_bea0f226c51b> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_3_19750926_OpEnact_32bb8c0e8f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "3" ;
    dzdoc:position 3 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_305> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_4> ;
    dzdoc:eId "art_305" ;
    dzdoc:fullText "يعتبر ضمن الدائنين العاديين الدائنون الذين لا يجديهم ترتيبهم شيئا، و يخضعون تبعا لتلك الآثار كافة أعمال جماعة الدائنين العاديين بما في ذلك عقد الصلح إذا كان له محل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_305> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_305_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_305_19750926_OpEnact_f6c2c95ff2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_305_obligation_0_229dcf8a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "305" ;
    dzdoc:position 310 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_322> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_2> ;
    dzdoc:eId "art_322" ;
    dzdoc:fullText "توقف إجراءات الصلح متى قامت ملاحقات الإفلاس التدليسي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_322> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_322_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_322_19750926_OpEnact_de905d1753> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_322_obligation_0_32e4b1e9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "322" ;
    dzdoc:position 327 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_326> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_3> ;
    dzdoc:eId "art_326" ;
    dzdoc:fullText "يرفع القاضي المنتدب في جميع الأحوال وقبل البت في موضوع التصديق، إلى المحكمة تقريرا عن مميزات التسوية القضائية وقبول الصلح ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_326> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_326_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_326_19750926_OpEnact_8ae8f270b5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_326_obligation_0_b9d37e70> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 326" ;
    dzdoc:position 331 ;
    dzdoc:usesTerm dzterm:conciliation,
        dzterm:delegated_judge,
        dzterm:judicial_settlement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_339> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_5> ;
    dzdoc:eId "art_339" ;
    dzdoc:fullText "يؤدي حكم التحويل في جميع الأحوال، إلى رفع يد المدين اعتبارا من تاريخ الحكم ، ويتبع وكيل التفليسة الذي تعينه المحكمة القواعد الخاصة بالإفلاس بالنسبة للباقي من سير الإجراءات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_339> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_339_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_339_19750926_OpEnact_304b913f51> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_339_obligation_0_5ed3f6c6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "339" ;
    dzdoc:position 344 ;
    dzdoc:usesTerm dzterm:bankruptcy_trustee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_341> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_6> ;
    dzdoc:eId "art_341" ;
    dzdoc:fullText "يلغى الصلح إما للتدليس أو مبالغة في الناتج عن إخفاء الأموال أو مبالغة في الديون وإذا اكتشف التدليس بعد التصديق على الصلح . على أن هذا الإلغاء يبرئ الكفلاء بحكم القانون ما عدا الذين كانوا عالمين بالتدليس عند الالتزام."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_341> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_341_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_341_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_341_19750926_OpEnact_1c41cd457d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "341" ;
    dzdoc:position 346 ;
    dzdoc:usesTerm dzterm:composition .

<https://legal.dz/resource/order/1975-09-26/75-59#art_360> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_2> ;
    dzdoc:eId "art_360" ;
    dzdoc:fullText "يودع كل طلب رد اعتبار بكتابة ضبط المحكمة التي قضت بشهر الإفلاس أو بالتسوية القضائية ، وتكون مصحوبة بالمخالصات والمستندات المثبتة لها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_360> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_360_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_360_19750926_OpEnact_6c29af4fa0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_360_obligation_0_89327a91> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 360" ;
    dzdoc:position 365 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_370> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:تفليس_بالتقصير ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_370" ;
    dzdoc:fullText "يعد مرتكبا لتفليس بالتقصير كل تاجر في حالة توقف عن الدفع يوجد في إحدى الحالات الآتية : إذا ثبت أن مصاريفه الشخصية أو مصاريف تجارته مفرطة، إذا استهلك مبالغ جسيمة في عمليات نصيبية محضة أو عمليات وهمية، إذا كان قد قام بمشتريات لإعادة البيع بأقل من سعر السوق بقصد تأخير إثبات توقفه عن الدفع أو استعمل بنفس القصد وسائل مؤدية للإفلاس ليحصل على أموال، إذا قام التوقف عن الدفع بإيفاء أحد الدائنين إضرارا بجماعة الدائنين، إذا كان قد أشهر إفلاسه مرتين وأقفلت التفليستان بسبب عدم كفاية الأصول، إذا لم يكن قد أمسك أية حسابات مطابقة لعرف المهنة نظرا لأهمية تجارته، إذا كان قد مارس مهنته مخالفا لحظر منصوص عليه في القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_370> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_370_defocc_6eb941038271> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_370_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_370_19750926_OpEnact_8723679389> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 370" ;
    dzdoc:position 375 ;
    dzdoc:usesTerm dzterm:تاجر .

<https://legal.dz/resource/order/1975-09-26/75-59#art_379> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_3_sec_2> ;
    dzdoc:eId "art_379" ;
    dzdoc:fullText "في حالة توقف شركة عن الدفع ، تطبق العقوبات الخاصة بالتفليس بالتدليس على القائمين بالإدارة و المديرين أو المصفين في شركة مساهمة و المسيرين أو المصفين لـ شركة ذات مسؤولية محدودة ، وبوجه عام على كل المفوضين من قبل الشركة يكونون قد اختلسوا بطريق التدليس دفاتر الشركة أو بددوا أو أخفوا جزءا من أصولها أو الذين قد أقروا سواء في المحررات أو الأوراق الرسمية أو التعهدات العرفية أو في الميزانية بمديونية الشركة بمبالغ ليست في ذمتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_379> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_379_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_379_19750926_OpEnact_316c34fe87> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 379" ;
    dzdoc:position 384 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_379_condition_0_e1c6a0e3> ;
    dzdoc:usesTerm dzterm:administrators,
        dzterm:joint_stock_company,
        dzterm:liquidators,
        dzterm:llc,
        dzterm:managers,
        dzterm:penalties .

<https://legal.dz/resource/order/1975-09-26/75-59#art_384> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_3_sec_2> ;
    dzdoc:eId "art_384" ;
    dzdoc:fullText "عند الحكم في إحدى الحالات المنصوص عليها في المواد المتقدمة تفصل المحكمة المعروض عليها الموضوع، ولو قضت بالإعفاء من التهمة : 1 - تلقائيا في أن تضاف لجانب جماعة الدائنين الأموال والحقوق أو الدعاوى التي أبعدت بطريق التدليس، 2 - فيما يطلب من تعويضات عن الضرر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_384> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_384_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_384_19750926_OpEnact_f5fc5a9a2d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 384" ;
    dzdoc:position 389 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_380> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_380> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_384_condition_0_130a4a6f> ;
    dzdoc:usesTerm dzterm:creditors_group .

<https://legal.dz/resource/order/1975-09-26/75-59#art_387> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_3_sec_2> ;
    dzdoc:eId "art_387" ;
    dzdoc:fullText "في حالة رفع طلب بطلان الاتفاقات المشار إليها في المادتين السابقتين و 386 إلى القضاء المدني تحال الدعوى إلى محاكم التجارة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_387> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_387_para_0> ;
