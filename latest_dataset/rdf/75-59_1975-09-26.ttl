<https://legal.dz/resource/order/1975-09-26/75-59#art_253_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_253> ;
    dzdoc:position 0 ;
    dzdoc:text "يستدعي وكيل التفليسة المدين لديه لإقفال الدفاتر وحصرها في حضوره وذلك بغير مساس بما نصت عليه المادة 261 بخصوص حالة وضع الأختام. فإذا لم يستجب المدين لهذا الاستدعاء دعي بموجب رسالة موصى عليها مع طلب علم الوصول ليحضر ويقدم دفاتره خلال ثمانية أو أربعين ساعة."@ar .

