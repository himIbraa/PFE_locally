<https://legal.dz/resource/order/1975-09-26/75-59#version_art_316> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعرض أمين التفليسة على الجمعية تقريرا عن حالة التفليسة والإجراءات التي نفذت والأعمال التي تمت كما يسمع فيها المدين. ويسلم أمين التفليسة تقريره لقيام حالة الاتحاد، موقعا عليه منه إلى القاضي المنتدب الذي يحرر محضرا بما حصل في الجمعية وما قررته . وتجري بعد ذلك الإجراءات وفقا للمادة 349 وما بعدها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_316_19750926_OpEnact_b59d39f6c3> ;
    dzdoc:replacementText "يعرض أمين التفليسة على الجمعية تقريرا عن حالة التفليسة والإجراءات التي نفذت والأعمال التي تمت كما يسمع فيها المدين. ويسلم أمين التفليسة تقريره لقيام حالة الاتحاد، موقعا عليه منه إلى القاضي المنتدب الذي يحرر محضرا بما حصل في الجمعية وما قررته . وتجري بعد ذلك الإجراءات وفقا للمادة 349 وما بعدها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_316> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_316> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
