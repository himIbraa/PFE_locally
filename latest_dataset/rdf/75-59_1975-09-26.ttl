<https://legal.dz/resource/order/1975-09-26/75-59#version_art_90> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على كل حائز للثمن الذي تم به بيع محل تجاري أن يقوم بتوزيعه في ظرف ثلاثة أشهر من تاريخ عقد البيع . وبانقضاء هذه المهلة يجوز للطرف الذي يهمه التعجيل، أن يرفع دعوى مستعجلة أمام رئيس المحكمة التي يقع المحل التجاري في دائرة اختصاصها والذي يأمر إما بإيداع الثمن في مصلحة الودائع والأمانات وإما بتعيين حارس موزع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_90_19750926_OpEnact_c4ac14d8b7> ;
    dzdoc:replacementText "يجب على كل حائز للثمن الذي تم به بيع محل تجاري أن يقوم بتوزيعه في ظرف ثلاثة أشهر من تاريخ عقد البيع . وبانقضاء هذه المهلة يجوز للطرف الذي يهمه التعجيل، أن يرفع دعوى مستعجلة أمام رئيس المحكمة التي يقع المحل التجاري في دائرة اختصاصها والذي يأمر إما بإيداع الثمن في مصلحة الودائع والأمانات وإما بتعيين حارس موزع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_90> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_90> ;
