<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_21_obligation_0_a8d876ac> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_21> ;
    dznorm:position 0 ;
    dznorm:provisionText "متضامنين بالمسؤولية عن الضرر الذي يلحق المساهمين أو الغير من جراء حل الشركة"@ar ;
    dznorm:sourceArticle "art_715_bis_21" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_21_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_21> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز أن يعتبر مؤسسو الشركة، الذين أسند إليهم البطلان والقائمون بالإدارة الذين كانوا في وظائفهم وقت وقوع البطلان، متضامنين بالمسؤولية عن الضرر الذي يلحق المساهمين أو الغير من جراء حل الشركة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_21_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_21> ;
    dzdoc:position 1 ;
    dzdoc:text "كما يجوز أن تسند نفس مسؤولية التضامن للمساهمين الذين لم يحقق في حصصهم المقدمة للشركة أو المنافع ولم يصادق عليها."@ar .

