    dzdoc:position 1 ;
    dzdoc:text "ولا يمكن للحامل أن يرفض وفاء جزئيا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_415_para_2> a dzdoc:Paragraph ;
