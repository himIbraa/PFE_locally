<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_26> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتقادم دعوى المسؤولية ضد القائمين بالإدارة مشتركة كانت أو فردية بمرور ثلاث سنوات، ابتداء من تاريخ ارتكاب العمل الضار ، أو من وقت العلم به إن كان قد أخفي. غير أن الفعل المرتكب إذا كان جناية فإن الدعوى في هذه الحالة تتقادم بمرور عشر سنوات."@ar ;
