<https://legal.dz/resource/order/1975-09-26/75-59#version_art_803> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهر إلى ثلاثة أشهر وبغرامة من 20.000 دج إلى 100.000 دج أو بإحدى هاتين العقوبتين فقط المسيرون الذين يتخلفون مع التعمد إذا قل مال الشركة الصافي عن ربع رأس مال الشركة من جراء الخسائر الثابتة في المستندات الحسابية : 1- عن استشارة الشركاء لاتخاذ قرار بوجوب الانحلال المسبق للشركة إذا كان لذلك محل في ظرف الأربعة أشهر التالية للموافقة على الحسابات التي أظهرت تلك الخسائر، 2- عن إيداع القرار الذي اتخذه الشركاء بكتابة المحكمة ونشره في جريدة معتمدة لتلقي الإعلانات القانونية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_803_19750926_OpEnact_cb88c19e2f> ;
    dzdoc:replacementText "يعاقب بالحبس من شهر إلى ثلاثة أشهر وبغرامة من 20.000 دج إلى 100.000 دج أو بإحدى هاتين العقوبتين فقط المسيرون الذين يتخلفون مع التعمد إذا قل مال الشركة الصافي عن ربع رأس مال الشركة من جراء الخسائر الثابتة في المستندات الحسابية : 1- عن استشارة الشركاء لاتخاذ قرار بوجوب الانحلال المسبق للشركة إذا كان لذلك محل في ظرف الأربعة أشهر التالية للموافقة على الحسابات التي أظهرت تلك الخسائر، 2- عن إيداع القرار الذي اتخذه الشركاء بكتابة المحكمة ونشره في جريدة معتمدة لتلقي الإعلانات القانونية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
