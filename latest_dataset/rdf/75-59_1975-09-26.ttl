    dznorm:position 0 ;
    dznorm:provisionText "يجتمع بقوة القانون حاملو سندات المساهمة التي هي من نفس الإصدار لتمثيل مصالحهم المشتركة في جماعة تتمتع بالشخصية المدنية"@ar ;
    dznorm:sourceArticle "art_715_bis_78" .

