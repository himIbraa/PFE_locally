    dzdoc:occursInArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_1> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_1_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يعد تاجرا كل شخص طبيعي أو معنوي يباشر عملا تجاريا ويتخذه مهنة معتادة له، ما لم يقض القانون بخلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_1_para_0> a dzdoc:Paragraph ;
