        dzterm:sender .

<https://legal.dz/resource/order/1975-09-26/75-59#art_762> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_762" ;
    dzdoc:fullText "يجوز للشركة التي تقدم جزءا من مالها لشركة أخرى، وكذلك التي تستفيد من هذه الحصة أن تقرران بالاتفاق على إخضاع العملية لأحكام المادتين 758 و 761 ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_762_permission_0_465a9111> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_762> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_762_para_0> ;
