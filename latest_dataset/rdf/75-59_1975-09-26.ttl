<https://legal.dz/resource/order/1975-09-26/75-59#version_art_304> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجرى على النحو التالي بالنسبة للدائنين المرتهنين عقاريا والذين لم تسمح لهم مرتبتهم في توزيع ثمن العقارات إلا باستيفاء جزئي، تحدد نهائيا حقوقهم في جماعة الدائنين العاديين تبعا للمبالغ التي يبقون دائنين بها بعد التوزيع العقاري، وأما المبالغ التي قبضوها في توزيع سابق زائدة على هذه النسبة فإنها تستبعد من مقدار حصتهم في توزيع المرتهنين عقاريا وتضاف لجماعة الدائنين العاديين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_304_19750926_OpEnact_83cda1b479> ;
