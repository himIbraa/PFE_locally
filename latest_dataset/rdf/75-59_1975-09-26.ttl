<https://legal.dz/resource/order/1975-09-26/75-59#version_art_793> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتم قسمة المال الصافي المتبقي بعد سداد الأسهم الاسمية أو حصص الشركة بين الشركاء بنفس نسبة مساهمتهم في رأس مال الشركة وذلك باستثناء الشروط المخالفة للقانون الأساسي."@ar ;
