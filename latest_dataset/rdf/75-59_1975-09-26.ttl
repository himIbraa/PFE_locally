<https://legal.dz/resource/order/1975-09-26/75-59#version_art_637> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة وقوع مانع مؤقت للرئيس أو وفاته أو استقالته أو عزله ، يجوز ل مجلس الإدارة أن ينتدب قائما بالإدارة ليقوم بوظائف الرئيس . وفي حالة المانع المؤقت ، يمنح هذا الانتداب لمدة محددة قابلة للتجديد. وفي حالة الوفاة أو الاستقالة أو الإقالة ، تستمر هذه المدة إلى غاية انتخاب رئيس جديد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_637_19750926_OpEnact_064230afab> ;
    dzdoc:replacementText "في حالة وقوع مانع مؤقت للرئيس أو وفاته أو استقالته أو عزله ، يجوز ل مجلس الإدارة أن ينتدب قائما بالإدارة ليقوم بوظائف الرئيس . وفي حالة المانع المؤقت ، يمنح هذا الانتداب لمدة محددة قابلة للتجديد. وفي حالة الوفاة أو الاستقالة أو الإقالة ، تستمر هذه المدة إلى غاية انتخاب رئيس جديد."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_637> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
