<https://legal.dz/resource/order/1975-09-26/75-59#version_art_336> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقضي المحكمة بتحويل التسوية القضائية إلى تفليسة إن وجدت محلا لذلك، طبقا للأوضاع الواردة فيما بعد، وذلك بحكم يصدر في جلسة علنية تلقائيا أو بناء على طلب إما من وكيل التفليسة أو الدائنين بناء على تقرير القاضي المنتدب ، بعد السماع للمدين أو دعوته للحضور قانونا بموجب رسالة موصى عليها مع طلب العلم بالوصول."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_336_19750926_OpEnact_04f2b9b9c1> ;
    dzdoc:replacementText "تقضي المحكمة بتحويل التسوية القضائية إلى تفليسة إن وجدت محلا لذلك، طبقا للأوضاع الواردة فيما بعد، وذلك بحكم يصدر في جلسة علنية تلقائيا أو بناء على طلب إما من وكيل التفليسة أو الدائنين بناء على تقرير القاضي المنتدب ، بعد السماع للمدين أو دعوته للحضور قانونا بموجب رسالة موصى عليها مع طلب العلم بالوصول."@ar ;
