<https://legal.dz/resource/order/1975-09-26/75-59#version_art_492> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن التظهير الموضوع على شيك لحامله يجعل المظهر مسؤولا بمقتضى الأحكام التي تسود الحق في الرجوع ولكن ليس من شأنه أن يحول السند إلى شيك لأمر ."@ar ;
