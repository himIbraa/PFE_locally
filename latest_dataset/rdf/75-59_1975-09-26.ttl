<https://legal.dz/resource/order/1975-09-26/75-59#art_106> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_106" ;
    dzdoc:fullText "إذا كان الشطب الذي لم يوافق عليه الدائن مطلوبا عن طريق دعوى أصلية ، فيجب رفع هذه الدعوى أمام محكمة المكان الذي حصل فيه القيد. وإذا كانت الدعوى تتعلق بطلب شطب قيود متممة في دائرات اختصاص مختلفة، على محل تجاري وفروعه ، فترفع بالنسبة لجميعها أمام المحكمة التي تقع بدائرتها المؤسسة الأصلية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_106> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_106_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_106_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_106_19750926_OpEnact_6dcd984f53> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "106" ;
    dzdoc:position 108 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_106_condition_0_e6677d14>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_106_condition_1_836d91c3> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "يجب على البائع في حالة الفسخ القضائي أو الاختياري للبيع أن يسترد جميع عناصر المحل التجاري التي شملها البيع ، وبما فيها العناصر التي انقضى فيها امتيازه وحقه في دعوى الفسخ. ويكون البائع محاسبا عن ثمن البضائع والمعدات الموجودة بالمحل عند إعادة حيازته بما يقدر بموجب خبرة حضورية أو بالتراضي أو عن طريق القضاء على أن يطرح من الثمن ما قد يستحقه بموجب الامتياز الذي له على ثمن كل من البضائع والمعدات وإذا بقي شيء زائدا عن ذلك فيكون ضمانا للدائنين العاديين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_110_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_110_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_110_19750926_OpEnact_fae37645e4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_110_obligation_0_43373f37> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "110" ;
    dzdoc:position 112 ;
    dzdoc:usesTerm dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-59#art_113> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_113" ;
    dzdoc:fullText "إذا طلب بيع المحل التجاري بالمزايدة العلنية سواء كان بطلب وكيل التفليسة، أو التسوية القضائية، أو المصفين أو كان الطلب صادرا عن أي صاحب حق آخر ، وجب على الطالب إبلاغ طلبه بواسطة إجراء غير قضائي للبائعين السابقين في محل الإقامة المختار والمعين في قيودهم مع التصريح بأنهم إذا لم يرفعوا دعوى الفسخ خلال شهر من تاريخ التبليغ سقط حقهم فيها تجاه الراسي عليه المزاد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_113> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_113_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_113_19750926_OpEnact_6b7b9b13ab> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_113_obligation_0_c5488991> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "113" ;
    dzdoc:position 115 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_113_condition_0_0e7670bb> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_114" ;
    dzdoc:fullText "يجوز لبائع المحل التجاري أن يتمسك بامتيازه وحقه في الفسخ تجاه مجموعة دائني التفليسة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_114_permission_0_523574be> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_114_right_0_dadaec63> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_114> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_114_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_114_19750926_OpEnact_5dce17dbbc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "114" ;
    dzdoc:position 116 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_2> ;
    dzdoc:eId "art_13" ;
    dzdoc:fullText "يجوز للقاضي قبول الدفاتر التجارية المنتظمة كإثبات بين التجار بالنسبة للأعمال التجارية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_13_permission_0_268f9e96> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_13_right_0_285b16dd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_13> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_13_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_13_19750926_OpEnact_5ae519e4ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "13" ;
    dzdoc:position 14 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_2> ;
    dzdoc:eId "art_14" ;
    dzdoc:fullText "إن الدفاتر التي يلتزم الأفراد بمسكها والتي لا تراعى فيها الأوضاع المقررة أعلاه، لا يمكن تقديمها للقضاء ولا يكون لها قوة الإثبات أمامه لصالح من يمسكونها، وذلك مع عدم المساس بما ورد النص بشأنه في كتاب الإفلاس والتفليس."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_14_permission_0_554b2a2a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_14_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_14_19750926_OpEnact_fe7f91acab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "14" ;
    dzdoc:position 15 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_147> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_6> ;
    dzdoc:eId "art_147" ;
    dzdoc:fullText "يتم إجراء القيد والبيانات طبقا للتشريع الساري المفعول إذا كانت البيوع أو التنازلات عن المحلات التجارية تشتمل على علامات المصنع أو التجارة أو الرسوم أو النماذج الصناعية، وكانت رهون هذه المحلات تشتمل على براءات اختراع أو رخص أو علامات أو رسوم أو نماذج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_147> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_147_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_147_19750926_OpEnact_fe14a3cb63> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_147_obligation_0_80926f28> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 147" ;
    dzdoc:position 149 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_147_condition_0_23677556> ;
    dzdoc:usesTerm dzterm:commercial_assets .

<https://legal.dz/resource/order/1975-09-26/75-59#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_2> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "لا يجوز الأمر بتقديم الدفاتر وقوائم الجرد إلى القضاء إلا في قضايا الإرث وقسمة الشركة وفي حالة الإفلاس."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_15_permission_0_632c82bb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_15_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_15_19750926_OpEnact_5a53a88dad> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_15_prohibition_0_632c82bb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "15" ;
    dzdoc:position 16 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_2> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "يجوز للقاضي أن يأمر ولو من تلقاء نفسه بتقديم الدفاتر التجارية أثناء قيام نزاع وذلك بغرض استخلاص ما يتعلق منها بالنزاع ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_16_permission_0_65d7b0d9> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_16_right_0_f4b4496c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_16_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_16_19750926_OpEnact_16e8a43569> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "16" ;
    dzdoc:position 17 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_165> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_8> ;
    dzdoc:eId "art_165" ;
    dzdoc:fullText "تكون الأموال المثقلة بناء على هذا القانون والتي يكون فيها البيع متابعا مع عناصر أخرى للمحل التجاري موضوع ثمن أساسي متميز أو سعر متميز إذا كان دفتر الشروط يوجب على الراسي عليه المزاد أو يأخذ به حسب رأي الخبير . وتخصص في جميع الأحوال المبالغ المحصلة من بيع هذه الأموال وقبل إجراء أي توزيع للمستفيدين المقيدين في حدود دينهم الأصلي ويحتفظ بالنفقات والتوابع في القيود المذكورة. ولا يخضع الإيصال المسلم من الدائن المستفيد من الامتياز إلا للرسم الثابت."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_165> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_165_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_165_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_165_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_165_19750926_OpEnact_902dcfca54> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "165" ;
    dzdoc:position 167 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_165_condition_0_ab62bab6> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_186> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_2_sec_3> ;
    dzdoc:eId "art_186" ;
    dzdoc:fullText "في حالة ما إذا ثبت أن المؤجر لم يمارس الحقوق المسندة له بموجب المادة 177 وما يليها إلا بنية تعطيل حقوق المستأجر بطريقة تدليسية، خاصة إذا قام بعمليات تأجير وإعادة بيع ، فإنه يبقى للمستأجر الحق في قبض تعويض يكون مساويا لمبلغ الضرر الذي لحق به ، وذلك سواء كانت العمليات التي قام بها المؤجر ذات طابع مدني أو تجاري."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_186_right_0_d3df50c3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_186> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_186_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_186_19750926_OpEnact_55b402e121> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "186" ;
    dzdoc:position 188 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_177> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_177> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_186_condition_0_847741ff> ;
    dzdoc:usesTerm dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_204> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_3> ;
    dzdoc:eId "art_204" ;
    dzdoc:fullText "يتعين على المستأجر المسير أن يشير في عناوين فواتيره ورسائله و طلبات البضاعة والوثائق المصرفية والتعريفات أو النشرات وكذلك في عناوين جميع الأوراق الموقعة من طرفه أو باسمه، رقم تسجيله في السجل التجاري ومقر المحكمة التي سجل لديها و صفته كمستأجر مسير للمحل التجاري زيادة على الاسم والصفة والعنوان ورقم التسجيل التجاري لمؤجر المحل التجاري . كل مخالفة لأحكام الفقرة السابقة، يعاقب عنها بغرامة من 500 دج إلى 5.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_204> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_204_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_204_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_204_19750926_OpEnact_b14687b45d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_204_obligation_0_6bb4504f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 204" ;
    dzdoc:position 208 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_225> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_2> ;
    dzdoc:eId "art_225" ;
    dzdoc:fullText "لا يترتب إفلاس ولا تسوية قضائية على مجرد التوقف عن الدفع بغير صدور حكم مقرر لذلك. ومع ذلك تجوز الإدانة بـ الإفلاس البسيط أو التدليسي دون التوقف عن الدفع بحكم مقرر لذلك ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_225_right_0_ed04a32f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_225> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_225_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_225_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_225_19750926_OpEnact_4969a2230d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "225" ;
    dzdoc:position 229 ;
    dzdoc:usesTerm dzterm:bankruptcy,
        dzterm:cessation_of_payment,
        dzterm:fraudulent_bankruptcy,
        dzterm:judicial_settlement,
        dzterm:simple_bankruptcy .

<https://legal.dz/resource/order/1975-09-26/75-59#art_234> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_3> ;
    dzdoc:eId "art_234" ;
    dzdoc:fullText "مهلة الاستئناف لأي حكم صادر في تسوية قضائية أو إفلاس، هي عشرة أيام اعتبارا من يوم التبليغ . ويفصل المجلس القضائي فيه خلال ثلاثة أشهر . ويكون الحكم واجب التنفيذ بموجب مسودته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_234> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_234_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_234_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_234_19750926_OpEnact_3c14515a18> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_234_obligation_0_329a4a8c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 234" ;
    dzdoc:position 238 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_234_condition_0_099b4aa4> ;
    dzdoc:usesTerm dzterm:appeal_period .

<https://legal.dz/resource/order/1975-09-26/75-59#art_251> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_251" ;
    dzdoc:fullText "لا يصح التمسك قبل جماعة الدائنين بالرهون الحيازية والامتيازات التي سجلت بعد صدور الحكم الذي قضى بالتسوية القضائية أو شهر الإفلاس . غير أن الخزينة العامة تبقى متمسكة بامتيازها على الديون التي كانت غير ملزمة بتسجيلها في تاريخ الحكم الذي قضى بالتسوية القضائية أو شهر الإفلاس وللديون المعروضة للتحصيل بعد ذلك التاريخ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_251> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_251_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_251_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_251_19750926_OpEnact_d242df8d87> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_251_obligation_0_f155da0f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 251" ;
    dzdoc:position 255 ;
    dzdoc:usesTerm dzterm:creditors_group .

<https://legal.dz/resource/order/1975-09-26/75-59#art_252_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_252_bis" ;
    dzdoc:fullText "بغض النظر عن الأحكام القانونية المخالفة، لا يمكن إبطال الدفع والتسليم للأدوات المالية المنجزة في إطار أنظمة الدفع ما بين البنوك إلى غاية نهاية اليوم الذي صدر فيه الحكم القاضي بالتسوية القضائية أو الإفلاس ضد بنك أو هيئة مالية مؤهلة قانونا، مشاركة بصفة مباشرة أو غير مباشرة في هذه الأنظمة حتى ولو تم التمسك بوجود هذا الحكم القضائي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_252_bis_permission_0_5d4531d6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_252_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_252_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_252_bis_19750926_OpEnact_2325bc9397> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_252_bis_obligation_0_f5bd48b8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 252 مكرر" ;
    dzdoc:position 257 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_281> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_1> ;
    dzdoc:eId "art_281" ;
    dzdoc:fullText "عند عدم إحضار السندات في مهلة شهر لا يقبل المتخلفون في التوزيع والأرباح ما لم ترفع عنهم المحكمة سقوط هذه المهلة إذا أثبتوا أن لا يد لهم في هذا التخلف . وفي هذه الحالة لا يمكن لهم إلا المشاركة في توزيع الحصص أو الأرباح المقبلة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_281_permission_0_2201437d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_281> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_281_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_281_19750926_OpEnact_d4c655abad> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 281" ;
    dzdoc:position 286 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_281_condition_0_3a3d9b6b>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_281_condition_1_99606c2e> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_284> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_1> ;
    dzdoc:eId "art_284" ;
    dzdoc:fullText "يقوم كاتب الضبط فورا بإخطار الدائنين بإيداع ذلك الكشف عن طريق نشره في واحدة أو أكثر من الصحف المعتمدة لنشر الإعلانات القانونية والنشرة الرسمية للإعلانات القانونية والتي تتضمن رقم عدد جريدة الإعلانات القانونية التي جرى بها النشر الأول . ويوجه لكل من الدائنين الذين رفضت ديونهم أو نوزع فيها، رسالة موصى عليها في أجل الخمسة عشر يوما المنصوص عليه في المادة 285 لإخبارهم برفض ديونهم أو المنازعة فيها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_284> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_284_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_284_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_284_19750926_OpEnact_11891f7e8e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_284_obligation_0_7d018447>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_284_obligation_1_484414df> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 284" ;
    dzdoc:position 289 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_285> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_285> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_289> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_2> ;
    dzdoc:eId "art_289" ;
    dzdoc:fullText "لا يفتح باب الطعن في التسوية القضائية أو الإفلاس الخاص بالشركاء في الالتزام بعضهم ضد البعض الآخر، بسبب الحصص المؤداة ، ما لم يكن مجموع الحصص المؤداة من التسويات القضائية والتفليسات فائضا على تمام مبلغ الدين من أصل وملحقات ، ففي هذه الحالة يعود ذلك الفائض، إلى أولئك الشركاء في الالتزام الذين كان الآخرون لهم كفلاء، وفقا لأسبقية التعهدات ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_289_right_0_dc7d9a00> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_289> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_289_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_289_19750926_OpEnact_4d2ba11079> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_289_obligation_0_5594ef90> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 289" ;
    dzdoc:position 294 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_289_condition_0_fb0ce12d> ;
    dzdoc:usesTerm dzterm:bankruptcy,
        dzterm:judicial_settlement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_290> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_2> ;
    dzdoc:eId "art_290" ;
    dzdoc:fullText "إذا كان الدائن صاحب التعهدات التضامنية، بين المدين المفلس أو المقبول في تسوية قضائية وبين شركاء له في الالتزام قد قبض قسطا من حقه قبل التوقف عن الدفع فإنه لا يدخل ضمن جماعة الدائنين إلا بعد استنزال هذا القسط مع حفظ جميع الحقوق عن القدر الباقي له ضد الشريك في الالتزام أو الكفيل . يدرج الشريك في الالتزام أو الكفيل الصادر منه الدفع الجزئي في نفس جماعة الدائنين لكل ما دفعه إبراء لذمة المدين ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_290_right_0_1ace80f4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_290> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_290_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_290_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_290_19750926_OpEnact_b7a58aa0b4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_290_obligation_0_be6fd98d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 290" ;
    dzdoc:position 295 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_290_condition_0_673fde25> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_299> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_3> ;
    dzdoc:eId "art_299" ;
    dzdoc:fullText "لا يجوز في مواجهة جماعة الدائنين مباشرة الامتياز وحق الاسترداد الذين تقررهما المادة 993 من القانون المدني لمصلحة البائعين لأموال منقولة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_299_permission_0_1313fbb4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_299> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_299_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_299_19750926_OpEnact_9333d820f1> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_299_prohibition_0_1313fbb4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 299" ;
    dzdoc:position 304 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_299_extref_3b20a858> ;
    dzdoc:usesTerm dzterm:creditors_group .

<https://legal.dz/resource/order/1975-09-26/75-59#art_300> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_3> ;
    dzdoc:eId "art_300" ;
    dzdoc:fullText "بناء على مقترحات وكيل التفليسة ، يأذن القاضي المنتدب إن وجد محلا لذلك وطبقا لبيان كشف الدائنين الممتازين المنصوص عليه في المادة 282 ، بالسداد لهؤلاء الدائنين من حصيلة أول إيرادات . وتقضي المحكمة إن وقعت منازعة في الامتياز."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_300> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_300_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_300_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_300_19750926_OpEnact_add5e1985f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_300_obligation_0_9b746ee9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 300" ;
    dzdoc:position 305 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_282> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_282> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_300_condition_0_e882b4f4> ;
    dzdoc:usesTerm dzterm:القاضي_المنتدب,
        dzterm:وكيل_التفليسة .

<https://legal.dz/resource/order/1975-09-26/75-59#art_310> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_5> ;
    dzdoc:eId "art_310" ;
    dzdoc:fullText "يمكن للبائع أن يحبس البضائع التي باعها ولم تكن قد سلمت للمدين أو لم ترسل إليه ولا إلى شخص من الغير يعمل لحسابه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_310_permission_0_44a36604> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_310_right_0_0fdee452> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_310> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_310_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_310_19750926_OpEnact_4e39204620> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "310" ;
    dzdoc:position 315 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_315> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_1> ;
    dzdoc:eId "art_315" ;
    dzdoc:fullText "تنعقد الجمعية برئاسة القاضي المنتدب في المكان واليوم والساعة المحددين من طرفه، ويحضرها الدائنون المقبولة ديونهم نهائيا أو وقتيا، إما بأشخاصهم أو بمندوبين يتعين أن يكونوا مزودين بتفويض ما لم يكونوا معفين من هذا قانونا. وتكون دعوة المدين لتلك الجمعية برسالة موصى عليها مع طلب علم بالوصول، ويتعين عليه حضورها شخصيا . ولا يجوز أن ينيب أحدا عنه إلا لأسباب يجدها القاضي المنتدب مقبولة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_315_permission_0_2a528030> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_315> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_315_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_315_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_315_19750926_OpEnact_d0749023eb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_315_obligation_0_a4e4aebe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 315" ;
    dzdoc:position 320 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/order/1975-09-26/75-59#art_337> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_5> ;
    dzdoc:eId "art_337" ;
    dzdoc:fullText "تقضي المحكمة في أي وقت أثناء قيام التسوية القضائية بشهر الإفلاس ، وذلك : إذا حكم على المدين بالإفلاس بالتدليس ، إذا أبطل الصلح ، إذا ثبت أن المدين يوجد في إحدى الحالات المنصوص عليها في الفقرة الثانية من المادة 226 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_337> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_337_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_337_19750926_OpEnact_efbf4b1fc2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "337" ;
    dzdoc:position 342 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_226> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_226> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_337_condition_0_02951bf3>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_337_condition_1_f3c7a026>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_337_condition_2_a9e4406c> ;
    dzdoc:usesTerm dzterm:bankruptcy,
        dzterm:judicial_settlement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_352> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_8> ;
    dzdoc:eId "art_352" ;
    dzdoc:fullText "للمحكمة بناء على طلب أحد دائني المدين أو وكيل التفليسة الإذن لهذا الأخير بالتعاقد جزافا في كل الأصول المنقولة أو العقارية أو بعضها وبيعها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_352_right_0_16ddb80e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_352> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_352_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_352_19750926_OpEnact_e08ce744ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "352" ;
    dzdoc:position 357 ;
    dzdoc:usesTerm dzterm:bankruptcy_trustee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:transport_contract ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_1> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "عقد النقل اتفاق يلتزم بمقتضاه متعهد النقل مقابل ثمن بأن يتولى بنفسه نقل شخص أو شيء إلى مكان معين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_36> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_36_defocc_08d8aecacfcb> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_36_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_36_19750926_OpEnact_7a3f254039> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_36_obligation_0_49dde495> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 36" ;
    dzdoc:position 38 ;
    dzdoc:usesTerm dzterm:carrier .

<https://legal.dz/resource/order/1975-09-26/75-59#art_367> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_2> ;
    dzdoc:eId "art_367" ;
    dzdoc:fullText "يجوز بعد الوفاة رد اعتبار المدين المفلس أو المقبول في تسوية قضائية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_367_permission_0_fd361827> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_367_right_0_dac55094> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_367> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_367_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_367_19750926_OpEnact_3d50997f55> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 367" ;
    dzdoc:position 372 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:transport_commission_contract ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_1> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "يعتبر عقد العمولة للنقل اتفاق يلتزم بمقتضاه تاجر بأن يباشر باسمه الخاص أو باسم موكله أو شخص من الغير نقل أشخاص أو أشياء، وأن يقوم عند الاقتضاء بالأعمال الفرعية المرتبطة بالنقل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_37> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_37_defocc_245d43ac5519> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_37_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_37_19750926_OpEnact_8711e17fc0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_37_obligation_0_84417e8a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 37" ;
    dzdoc:position 39 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_399> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_399" ;
    dzdoc:fullText "يعتبر من بيده السفتجة أنه حاملها الشرعي إذا أثبت حقه بسلسلة غير منقطعة من التظهيرات ولو كان آخرها تظهيرا على بياض والتظهيرات المشطبة تعد على هذا الوضع كأن لم تكن. وإذا كان التظهير على بياض متبوعا بتظهير آخر اعتبر موقع هذا التظهير الأخير أنه اكتسب السفتجة بمقتضى التظهير على بياض . وإذا زالت يد شخص عن السفتجة بحادث من الحوادث فحاملها الذي يثبت حقه على النحو المبين بالفقرة السابقة لا يلزم بالتخلي عنها إلا إذا كان قد اكتسبها عن سوء نية أو كان ارتكب خطأ جسيما عند اكتسابها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_399> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_399_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_399_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_399_19750926_OpEnact_6ab39e9136> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 399" ;
    dzdoc:position 404 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_399> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_399> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_399_condition_0_18b65b4d> ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:blank_endorsement,
        dzterm:lawful_bearer .

<https://legal.dz/resource/order/1975-09-26/75-59#art_418> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_7> ;
    dzdoc:eId "art_418" ;
    dzdoc:fullText "إذا لم تقدم السفتجة للوفاء يوم الاستحقاق أو في أحد يومي العمل التاليين له فيحق لكل مدين تسليم المبلغ على وجه الوديعة إلى صندوق الودائع والأمانات على نفقة وتبعة الحامل ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_418_right_0_6dc219b0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_418> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_418_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_418_19750926_OpEnact_156660cf8f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "418" ;
    dzdoc:position 423 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_418_condition_0_301c12a4> ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:holder .

<https://legal.dz/resource/order/1975-09-26/75-59#art_420> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_7> ;
    dzdoc:eId "art_420" ;
    dzdoc:fullText "إذا ضاعت سفتجة غير مقبولة ، جاز لصاحبها أن يطالب بوفائها بموجب نسختها الثانية أو الثالثة أو الرابعة الخ..."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_420_right_0_6e8f5700> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_420> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_420_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_420_19750926_OpEnact_4ce82c8a09> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "420" ;
    dzdoc:position 425 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_420_condition_0_9fa27311> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_463> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_13> ;
    dzdoc:eId "art_463" ;
    dzdoc:fullText "تشبه بأيام الأعياد الرسمية الأيام التي لا يمكن فيها المطالبة بأي وفاء أو القيام بتحرير أي احتجاج وفقا لأحكام التشريع الجاري به العمل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_463_permission_0_71d87ed7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_463> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_463_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_463_19750926_OpEnact_423f4ee983> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 463" ;
    dzdoc:position 468 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_471> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_2> ;
    dzdoc:eId "art_471" ;
    dzdoc:fullText "إن السندات لأمر الواجب دفعها بعد مدة من الإطلاع عليها يجب أن تعرض على محررها للتأشير عليها وذلك في الآجال المعينة ( المادة 403 ) ، ويبتدىء الأجل الذي يحرر بعد الإطلاع من تاريخ التأشير الموقع من المحرر على السند فإذا امتنع المحرر عن وضع التأشير بتاريخه وجب إثبات امتناعه باحتجاج ( المادة 405 ) ويكون تاريخه مبدأ سريان مدة الاطلاع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_471> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_471_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_471_19750926_OpEnact_f859c9a956> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_471_obligation_0_2ec345c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "471" ;
    dzdoc:position 476 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_403>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_405> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_403>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_405> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_471_condition_0_67f05fe5> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_483> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_483" ;
    dzdoc:fullText "كل شيك له مقابل وفاء مطابق وموجود تحت تصرف الساحب يجب على المسحوب عليه المصادقة عليه إذا طلب الساحب أو الحامل ذلك ، إلا في حالة رغبة المسحوب عليه أن يعوض الشيك بشيك آخر يتم سحبه حسب الشروط المشار إليها في الفقرة الثالثة من المادة 477 . ويبقى مقابل وفاء الشيك المعتمد تحت مسؤولية المسحوب عليه لمصلحة الحامل إلى نهاية أجل التقديم المحدد بموجب المادة 509 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_483> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_483_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_483_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_483_19750926_OpEnact_9ad355bfcc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_483_obligation_0_9890b042> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "483" ;
    dzdoc:position 488 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_477>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_509> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_477>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_509> ;
    dzdoc:usesTerm dzterm:cheque,
        dzterm:drawee,
        dzterm:drawer .

<https://legal.dz/resource/order/1975-09-26/75-59#art_491> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_2> ;
    dzdoc:eId "art_491" ;
    dzdoc:fullText "يعتبر من يحوز شيكا قابلا للتظهير أنه حامله الشرعي متى أثبت أنه صاحب الحق فيه بسلسلة غير منقطعة من التظهيرات ولو كان آخر تظهير على بياض ، وتعد التظهيرات المشطبة على هذا الوضع كأن لم تكن، وإذا كان التظهير على بياض متبوعا بتظهير آخر فإن الموقع على هذا التظهير الأخير يعتبر قد اكتسب الشيك ، بموجب تظهير على بياض ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_491> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_491_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_491_19750926_OpEnact_68bb796087> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "491" ;
    dzdoc:position 496 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_491_condition_0_01ef02c9> ;
    dzdoc:usesTerm dzterm:blank_endorsement,
        dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_500> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_4> ;
    dzdoc:eId "art_500" ;
    dzdoc:fullText "إن الشيك واجب الوفاء لدى الإطلاع وكل شرط مخالف لذلك يعتبر كأن لم يكن. إذا قدم الشيك للوفاء قبل اليوم المعين فيه كتاريخ لإصداره يكون واجب الوفاء في يوم تقديمه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_500> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_500_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_500_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_500_19750926_OpEnact_5131d63524> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_500_obligation_0_c75b4475>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_500_obligation_1_cc8a96f9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "500" ;
    dzdoc:position 505 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_500_condition_0_dfde315a> ;
    dzdoc:usesTerm dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_520> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_6> ;
    dzdoc:eId "art_520" ;
    dzdoc:fullText "يمكن ل حامل الشيك مطالبة من له حق الرجوع عليه بما يلي : مبلغ الشيك غير المدفوع، مصاريف الاحتجاج والإخطارات الصادرة وغيرها من المصاريف."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_520_permission_0_5af6a840> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_520_right_0_184152d9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_520> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_520_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_520_19750926_OpEnact_07c4f4a31a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 520" ;
    dzdoc:position 525 ;
    dzdoc:usesTerm dzterm:holder .

<https://legal.dz/resource/order/1975-09-26/75-59#art_521> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_6> ;
    dzdoc:eId "art_521" ;
    dzdoc:fullText "يمكن لمن أوفى شيكا أن يطالب ضمانيه بما يلي: كامل المبلغ الذي أوفاه والمصاريف التي أنفقها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_521_permission_0_171a6330> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_521_right_0_c9bc51b7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_521> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_521_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_521_19750926_OpEnact_701733c7dc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 521" ;
    dzdoc:position 526 ;
    dzdoc:usesTerm dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_522> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_6> ;
    dzdoc:eId "art_522" ;
    dzdoc:fullText "يحق لكل ملزم استعمل ضده حق الرجوع أو كان مستهدفا لذلك أن يطلب في حالة تسديده قيمة الشيك ، تسليمه هذا الأخير مع الاحتجاج وحساب بالمخالصة. ويجوز لكل مظهر سدد قيمة الشيك أن يشطب تظهيره وتظهيرات المظهرين التابعين له."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_522_right_0_22319896>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_522_right_1_ad0107a7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_522> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_522_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_522_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_522_19750926_OpEnact_8364a4e336> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 522" ;
    dzdoc:position 527 ;
    dzdoc:usesTerm dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_8_bis> ;
    dzdoc:eId "art_526_bis" ;
    dzdoc:fullText "يجب على البنوك و الهيئات المالية المؤهلة قانونا ، قبل تسليم دفاتر الشيكات إلى زبائنها، أن تطلع فورا على فهرس مركزية المستحقات غير المدفوعة لبنك الجزائر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_19750926_OpEnact_75fb30b61f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_obligation_0_feb161a9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "526 مكرر" ;
    dzdoc:position 532 ;
    dzdoc:usesTerm dzterm:banks,
        dzterm:financial_institutions .

<https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_8_bis> ;
    dzdoc:eId "art_526_bis_1" ;
    dzdoc:fullText "يجب على المسحوب عليه تبليغ مركزية المستحقات غير المدفوعة بكل عارض دفع لعدم وجود أو عدم كفاية الرصيد خلال أيام العمل الأربعة (4) الموالية لتاريخ تقديم الشيك ، بأي شكل من الأشكال المنصوص عليها في المادة 502 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_526_bis_1_19750926_OpEnact_b426b19a93> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_526_bis_1_obligation_0_e93bc767> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "526 مكرر 1" ;
    dzdoc:position 533 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_502> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_502> ;
    dzdoc:usesTerm dzterm:drawee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_546> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_sec_التمهيدي> ;
    dzdoc:eId "art_546" ;
    dzdoc:fullText "يحدد شكل الشركة ومدتها التي لا يمكن أن تتجاوز 99 سنة ، وكذلك عنوانها أو اسمها ومركزها وموضوعها ومبلغ رأسمالها في قانونها الأساسي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_546_permission_0_878759b2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_546> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_546_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_546_19750926_OpEnact_90a15895f8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "546" ;
    dzdoc:position 593 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_546_condition_0_ad14985b> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_548> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_sec_التمهيدي> ;
    dzdoc:eId "art_548" ;
    dzdoc:fullText "يجب أن تودع العقود التأسيسية والعقود المعدلة للشركات التجارية لدى المركز الوطني للسجل التجاري وتنشر حسب الأوضاع الخاصة بكل شكل من أشكال الشركات وإلا كانت باطلة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_548> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_548_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_548_19750926_OpEnact_40085aa2a6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_548_obligation_0_f5725f92> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "548" ;
    dzdoc:position 595 ;
    dzdoc:usesTerm dzterm:cnrc .

<https://legal.dz/resource/order/1975-09-26/75-59#art_549> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_sec_التمهيدي> ;
    dzdoc:eId "art_549" ;
    dzdoc:fullText "لا تتمتع الشركة بـ الشخصية المعنوية إلا من تاريخ قيدها في السجل التجاري . وقبل إتمام هذا الإجراء يكون الأشخاص الذين تعهدوا باسم الشركة والحسابها متضامنين من غير تحديد أموالهم، إلا إذا قبلت الشركة، بعد تأسيسها بصفة قانونية أن تأخذ على عاتقها التعهدات المتخذة . فتعتبر التعهدات بمثابة تعهدات الشركة منذ تأسيسها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_549> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_549_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_549_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_549_19750926_OpEnact_678cdd70b8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "549" ;
    dzdoc:position 596 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_549_condition_0_393db997>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_549_condition_1_23db5781> ;
    dzdoc:usesTerm dzterm:legal_personality .

<https://legal.dz/resource/order/1975-09-26/75-59#art_555> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_555" ;
    dzdoc:fullText "تكون الشركة ملزمة بما يقوم به المدير من تصرفات تدخل في موضوع الشركة، وذلك في علاقاتها مع الغير . عند تعدد المديرين يتمتع كل واحد منهم منفردا بالسلطات المنصوص عليها في الفقرة المتقدمة. لا أثر لمعارضة أحد المديرين لأعمال مدير آخر بالنسبة للغير ما لم يثبت أنه كان عالما به. لا يحتج على الغير بالشروط المحددة لسلطات المديرين الناتجة عن هذه المادة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_555> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_555_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_555_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_555_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_555_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_555_19750926_OpEnact_f2f2758476> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_555_obligation_0_3b13c363> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "555" ;
    dzdoc:position 602 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_590> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_590" ;
    dzdoc:fullText "لا يسوغ أن يتجاوز عدد الشركاء في شركة ذات مسؤولية محدودة عشرين شريكا. وإذا أصبحت الشركة مشتملة على أكثر من عشرين شريكا وجب تحويلها إلى شركة مساهمة في أجل سنة واحدة . وعند عدم ذلك تنحل الشركة ما لم يصبح عدد الشركاء في تلك الفترة من الزمن مساويا لعشرين شريكا أو أقل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_590> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_590_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_590_19750926_OpEnact_0ae3574445> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_590_obligation_0_2fdd6b5b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "590" ;
    dzdoc:position 647 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_590_condition_0_e55ea278> ;
    dzdoc:usesTerm dzterm:company,
        dzterm:partners,
        dzterm:sarl .

<https://legal.dz/resource/order/1975-09-26/75-59#art_600> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_600" ;
    dzdoc:fullText "يقوم المؤسسون بعد التصريح بالاكتتاب والدفعات باستدعاء المكتتبين إلى جمعية عامة تأسيسية حسب الأشكال والآجال المنصوص عليها عن طريق التنظيم . تثبت هذه الجمعية أن رأس المال مكتتب به تماما، وأن مبلغ الأسهم مستحق الدفع. وتبدي رأيها في المصادقة على القانون الأساسي الذي لا يقبل التعديل إلا بإجماع آراء جميع المكتتبين، وتعين القائمين بالإدارة الأولين أو أعضاء مجلس المراقبة وتعين واحد أو أكثر من مندوبي الحسابات. كما يجب أن يتضمن محضر الجلسة الخاص بالجمعية عند الاقتضاء إثبات قبول القائمين بالإدارة أو أعضاء مجلس المراقبة ومندوبي الحسابات وظائفهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_600> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_600_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_600_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_600_19750926_OpEnact_a9abcd316f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_600_obligation_0_2f57e81a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "600" ;
    dzdoc:position 659 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_63> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_3> ;
    dzdoc:eId "art_63" ;
    dzdoc:fullText "يجوز إعفاء الناقل من المسؤولية الكلية أو الجزئية من أجل عدم تنفيذ التزاماته أو الإخلال بها أو التأخير فيها بشرط أن يثبت أن ذلك ناشئ عن قوة قاهرة أو خطأ المسافر ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_63_permission_0_9323a7ae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_63> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_63_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_63_19750926_OpEnact_4b6f0afb97> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 63" ;
    dzdoc:position 65 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_63_condition_0_bc9571e3> ;
    dzdoc:usesTerm dzterm:carrier .

<https://legal.dz/resource/order/1975-09-26/75-59#art_636> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_636" ;
    dzdoc:fullText "يعين الرئيس لمدة لا تتجاوز مدة نيابته كقائم بالإدارة وهو قابل لإعادة انتخابه. ويجوز ل مجلس الإدارة أن يعزله في أي وقت . ويعد كل حكم مخالف لذلك كأن لم يكن."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_636_right_0_994c8b58> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_636> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_636_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_636_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_636_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_636_19750926_OpEnact_5d23c01b86> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 636" ;
    dzdoc:position 695 ;
    dzdoc:usesTerm dzterm:board_of_directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_658> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_658" ;
    dzdoc:fullText "خلافا لـ المادة السابقة ، يمكن تجاوز عدد الأعضاء المقدر بإثني عشر عضوا حتى يعادل العدد الإجمالي لأعضاء مجلس المراقبة الممارسين منذ أكثر من ستة أشهر في الشركات المدمجة وذلك دون أن يتجاوز العدد أربع وعشرين (24) عضوا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_658_permission_0_5bd8fce8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_658> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_658_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_658_19750926_OpEnact_c1ec6aea8f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 658" ;
    dzdoc:position 717 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_657> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_657> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_658_condition_0_88ea4b7e> ;
    dzdoc:usesTerm dzterm:board_of_auditors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_661> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_661" ;
    dzdoc:fullText "لا يمكن أي عضو من مجلس المراقبة الانتماء إلى مجلس المديرين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_661_permission_0_6ae49f04> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_661> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_661_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_661_19750926_OpEnact_5fa33f18fc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_661_obligation_0_2dd8feb6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 661" ;
    dzdoc:position 720 ;
    dzdoc:usesTerm dzterm:board_of_auditors,
        dzterm:board_of_directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_667> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_667" ;
    dzdoc:fullText "لا تصح مداولة مجلس المراقبة ، إلا بحضور نصف عدد أعضائه على الأقل . تتخذ القرارات بأغلبية الأعضاء الحاضرين أو الممثلين ما لم ينص القانون الأساسي على أغلبية أكثر. ويرجح صوت الرئيس عند تعادل الأصوات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_667> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_667_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_667_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_667_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_667_19750926_OpEnact_c4d4facfb0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 667" ;
    dzdoc:position 726 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_667_condition_0_54029123> ;
    dzdoc:usesTerm dzterm:supervisory_board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_1> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "لا يعتبر زوج التاجر تاجرا إذا كان يمارس نشاطا تجاريا تابعا لنشاط زوجه . ولا يعتبر تاجرا إلا إذا كان يمارس نشاطا تجاريا منفصلا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_7_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_7_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_7_19750926_OpEnact_2d0fb292d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 7" ;
    dzdoc:position 7 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_7_condition_0_f77f3d52>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_7_condition_1_6328b541> ;
    dzdoc:usesTerm dzterm:merchant,
        dzterm:spouse_of_merchant .

<https://legal.dz/resource/order/1975-09-26/75-59#art_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_3> ;
    dzdoc:eId "art_70" ;
    dzdoc:fullText "يجوز إعفاء الوكيل بالعمولة كليا أو جزئيا من مسؤوليته من أجل عدم تنفيذ التزاماته أو الإخلال بها أو التأخير فيها بشرط أن يثبت أن ذلك ناشئ عن قوة قاهرة أو خطأ المسافر ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_70_permission_0_51d5d9cb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_70_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_70_19750926_OpEnact_73c3713ca1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 70" ;
    dzdoc:position 72 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_70_condition_0_bc9571e3> ;
    dzdoc:usesTerm dzterm:commission_agent .

<https://legal.dz/resource/order/1975-09-26/75-59#art_702> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_702" ;
    dzdoc:fullText "يجب ألا يقل الأجل الممنوح للمساهمين لممارسة حق الاكتتاب عن ثلاثين يوما ابتداء من تاريخ افتتاح الاكتتاب. ويقفل أجل الاكتئاب قبل الأجل المحدد له بمجرد القيام بممارسة جميع حقوق الاكتتاب غير قابلة للتخفيض."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_702> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_702_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_702_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_702_19750926_OpEnact_3081b05fd4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_702_obligation_0_bbc35f15> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "702" ;
    dzdoc:position 761 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_71> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_3> ;
    dzdoc:eId "art_71" ;
    dzdoc:fullText "يعد باطلا كل اشتراط بإعفاء الوكيل بالعمولة كليا أو جزئيا من مسؤوليته عن الأضرار البدنية الحاصلة للمسافر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_71> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_71_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_71_19750926_OpEnact_310bc82c46> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 71" ;
    dzdoc:position 73 ;
    dzdoc:usesTerm dzterm:commission_agent .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_715" ;
    dzdoc:fullText "عندما يتم اكتتاب الأسهم أو حيازتها من شخص يتصرف باسمه لحساب الشركة ، يتعين على هذا الشخص تسديد قيمة الأسهم بالتضامن مع المؤسسين، أو حسب الحالة، مع أعضاء مجلس الإدارة أو مجلس المديرين . يعتبر هذا الشخص، علاوة على ذلك كأنه اكتتب لحسابه الخاص."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_19750926_OpEnact_8785a1739b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_obligation_0_ddc9ae11> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715" ;
    dzdoc:position 773 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_condition_0_eed7ff52> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_101> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_101" ;
    dzdoc:fullText "لا يقبل أصحاب سندات الاستحقاق بصفة فردية لممارسة الرقابة على عمليات الشركة أو لطلب الإطلاع على وثائقها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_101> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_101_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_101_19750926_OpEnact_bcee5c1a0d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_101_obligation_0_70787abd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 101" ;
    dzdoc:position 875 ;
    dzdoc:usesTerm dzterm:bondholders .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_102> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_102" ;
    dzdoc:fullText "تلغى سندات الاستحقاق التي أعادت شراءها الشركة المصدرة، وكذا سندات الاستحقاق الناجمة عن قرعة والمسددة، و لا يمكن إعادة تداولها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_102_permission_0_8bda0384> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_102> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_102_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_102_19750926_OpEnact_4bb59d7624> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_102_obligation_0_60c0e4f6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 102" ;
    dzdoc:position 876 ;
    dzdoc:usesTerm dzterm:bondholders .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_106> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_106" ;
    dzdoc:fullText "في حالة إفلاس الشركة أو تسويتها القضائية ، يؤهل ممثلو الجماعة للتصرف باسم جميع سندات الاستحقاق . ويصرحون في خصوم التسوية القضائية بالمبلغ الأصلي لسندات الاستحقاق التي لا تزال متداولة، مع قسیمات فوائد مستحقة وغير مسددة، يعد تفصيل حسابها ممثل الدائنين. ولا يلزمون بتقديم سندات موكليهم لدعم هذا التقديم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_106_right_0_531c253c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_106> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_106_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_106_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_106_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_106_19750926_OpEnact_3198bfd345> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 106" ;
    dzdoc:position 880 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_106_condition_0_b6452fe9> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_6> ;
    dzdoc:eId "art_715_bis_114" ;
    dzdoc:fullText "يجوز للشركات المساهمة المستوفية للشروط المنصوص عليها في المادة 715 مكرر 82 ، إصدار سندات استحقاق قابلة للتحويل إلى أسهم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_114_permission_0_b2efc851> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_114_right_0_80d92c60> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_114> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_114_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_114_19750926_OpEnact_e6f4cd4714> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 114" ;
    dzdoc:position 888 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_82> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_82> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_121> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_6> ;
    dzdoc:eId "art_715_bis_121" ;
    dzdoc:fullText "ابتداء من تاريخ تصويت الجمعية العامة التي ترخص الإصدار وما دامت سندات الاستحقاق القابلة للتحويل إلى أسهم متوفرة ، يخضع إصدار الأسهم الواجب اكتتابها نقدا وإدماج الاحتياطات والأرباح أو منح الإصدار في رأس المال وتوزيع الاحتياطات الخاصة بالنقد أو السندات إلى بعض الإجراءات والشروط التي تحددها السلطة المكلفة بتنظيم عمليات البورصة ومراقبتها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_121> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_121_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_121_19750926_OpEnact_3a6eb8aba9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_121_obligation_0_80977484> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 121" ;
    dzdoc:position 895 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_121_condition_0_ecdc6dcd> ;
    dzdoc:usesTerm dzterm:cosob .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_123> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_6> ;
    dzdoc:eId "art_715_bis_123" ;
    dzdoc:fullText "في حالة إصدار أسهم يجب اكتتابها بمقابل نقدي أو إصدار سندات استحقاق جديدة قابلة للتحويل وذلك إذا قررت الجمعية العامة للمساهمين إلغاء الحق التفضيلي في الاكتتاب ينبغي أن تصادق الجمعية العامة لأصحاب سندات الاستحقاق المعنيين، على هذا القرار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_123> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_123_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_123_19750926_OpEnact_5f8ff3561b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_123_obligation_0_a732014b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 123" ;
    dzdoc:position 897 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_123_condition_0_36381525> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_7> ;
    dzdoc:eId "art_715_bis_14" ;
    dzdoc:fullText "يكون مندوبو الحسابات مسؤولون، سواء إزاء الشركة أو إزاء الغير، عن الأضرار الناجمة عن الأخطاء واللامبالاة التي يكونون قد ارتكبوها في ممارسة وظائفهم . ولا يكونون مسؤولين مدنيا عن المخالفات التي يرتكبها القائمون بالإدارة أو أعضاء مجلس المديرين، حسب الحالة، إلا إذا لم يكشفوا عنها في تقريرهم للجمعية العامة و/أو لوكيل الجمهورية رغم إطلاعهم عليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_14_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_14_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_14_19750926_OpEnact_ab0a9c203f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_14_obligation_0_a84f2d47> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 14" ;
    dzdoc:position 788 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_14_condition_0_77c6a1cf> ;
    dzdoc:usesTerm dzterm:auditors,
        dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_10> ;
    dzdoc:eId "art_715_bis_28" ;
    dzdoc:fullText "عندما تكون الشركة خاضعة لأحكام المواد من 644 إلى 672 المذكورة أعلاه ، فإن أعضاء مجلس المديرين يخضعون لنفس مسؤولية القائمين بالإدارة . وفي حالة الإفلاس أو التسوية القضائية، يمكن أن يتحمل أعضاء مجلس المديرين المسؤولية عن ديون الشركة ويخضعون للموانع وسقوط الحق المنصوص عليها في الموضوع."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_28_permission_0_c4a18c94> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_28_19750926_OpEnact_bc37fe25ce> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_28_obligation_0_6ad601c0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 28" ;
    dzdoc:position 802 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_644>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_672> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_644>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_672> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_28_condition_0_087c51a7> ;
    dzdoc:usesTerm dzterm:management_board .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:قيم_منقولة ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_1> ;
    dzdoc:eId "art_715_bis_30" ;
    dzdoc:fullText "القيم المنقولة هي سندات قابلة للتداول تصدرها شركات المساهمة وتكون مسعرة في البورصة أو يمكن أن تسعر ، وتمنح حقوقا مماثلة حسب الصنف وتسمح بالدخول بصورة مباشرة أو غير مباشرة في حصة معينة من رأسمال الشركة المصدرة أو حق مديونية عام على أموالها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_30_permission_0_92b8a3b7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_30> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_30_defocc_fd1c3e0950c8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_30_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_30_19750926_OpEnact_c40b7e0c3d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 30" ;
    dzdoc:position 804 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_1> ;
    dzdoc:eId "art_715_bis_31" ;
    dzdoc:fullText "يحظر إصدار حصص المستفيدين أو حصص المؤسسين ، تحت طائلة تطبيق العقوبات المنصوص عليها في المادة 811 أدناه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_31_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_31_19750926_OpEnact_e0b2ff03bc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_31_obligation_0_c9b07081> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_31_prohibition_0_895f3f68> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 31" ;
    dzdoc:position 805 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_811> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_811> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_35> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_1> ;
    dzdoc:eId "art_715_bis_35" ;
    dzdoc:fullText "يجوز لكل مالك لسندات إصدار تتضمن سندات للحامل، أن يطلب تحويلها إلى سندات اسمية أو العكس."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_35_permission_0_4d7a6fec> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_35_right_0_4d7a6fec> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_35> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_35_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_35_19750926_OpEnact_8c7ac4ce24> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 35" ;
    dzdoc:position 809 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_1> ;
    dzdoc:eId "art_715_bis_37" ;
    dzdoc:fullText "يمكن أن تكتسي القيم الصادرة بالجزائر إما شكلا ماديا بتسليم سند أو أن تكون موضوع تسجيل في الحساب. تمسك الشركة المصدرة الحساب عندما تكتسي القيم الصادرة الشكل الاسمي أو عن طريق وسيط مؤهل عندما تكتسي قيم لحاملها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_37_permission_0_66d1887a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_37_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_37_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_37_19750926_OpEnact_8aaf5b83e1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_37_obligation_0_0875eff6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 37" ;
    dzdoc:position 811 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_46> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_46" ;
    dzdoc:fullText "يحظر استهلاك الأسهم عن طريق سحب القرعة . تعد كل مداولة تتخذ خرقا لهذا المنع، باطلة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_46> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_46_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_46_19750926_OpEnact_2ccd17926e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_46_obligation_0_571ee464> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_46_prohibition_0_afa2b929> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 46" ;
    dzdoc:position 820 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_7> ;
    dzdoc:eId "art_715_bis_5" ;
    dzdoc:fullText "عند انتهاء مهام مندوب الحسابات ، يقترح على الجمعية العامة عدم تجديد عضويته و يجب على الجمعية العامة سماعه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_5_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_5_19750926_OpEnact_7f835b39cc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_5_obligation_0_9f0f20ca> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 5" ;
    dzdoc:position 779 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_5_condition_0_d40efc76> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_4> ;
    dzdoc:eId "art_715_bis_76" ;
    dzdoc:fullText "لا تكون سندات المساهمة قابلة التسديد إلا في حالة تصفية الشركة أو بمبادرة منها، بعد انتهاء أجل لا يمكن أن يقل عن خمس سنوات حسب الشروط المنصوص عليها في عقد الإصدار ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_76_permission_0_422b8948> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_76_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_76_19750926_OpEnact_9d7c19811c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 76" ;
    dzdoc:position 850 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_76_condition_0_83ffd63e> ;
    dzdoc:usesTerm dzterm:participation_bonds .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_4> ;
    dzdoc:eId "art_715_bis_79" ;
    dzdoc:fullText "يحضر ممثلو جماعة حاملي السندات جمعيات المساهمين . و يمكن استشارتهم في جميع المسائل المدرجة في جدول الأعمال، باستثناء المسائل المتعلقة بتوظيف مسيري الشركة أو إقالتهم ، و يمكنهم التدخل أثناء الجمعية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_79_right_0_fbea0be4>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_79_right_1_1e886fe4>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_79_right_2_0a014a62> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_79_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_79_19750926_OpEnact_38346b7cdf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 79" ;
    dzdoc:position 853 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_83> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_83" ;
    dzdoc:fullText "تكون سندات الاستحقاق حسب كل حالة مقترنة بشروط أو بنود التسديد أو الاستهلاك عند حلول الأجل أو عن طريق السحب. وفي الحالات المنصوص عليها صراحة عند الإصدار ، يمكن أن يكون سند الاستحقاق دخلا دائما يسمح بدخل متغير وقابل للتحويل إلى رأسمال بدون تعويض الأصل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_83_permission_0_77cfb06a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_83> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_83_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_83_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_83_19750926_OpEnact_17bfc59001> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 83" ;
    dzdoc:position 857 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_83_condition_0_342dd74f> ;
    dzdoc:usesTerm dzterm:سند_الاستحقاق,
        dzterm:سندات_الاستحقاق .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_84> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_84" ;
    dzdoc:fullText "تكون الجمعية العامة للمساهمين مؤهلة وحدها لتقرير إصدار سندات الاستحقاق وتحديد شروطها أو السماح بذلك. ويجوز لها أن تفوض سلطاتها إلى مجلس الإدارة أو مجلس المراقبة أو مجلس المديرين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_84> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_84_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_84_19750926_OpEnact_dbf773bce5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 84" ;
    dzdoc:position 858 ;
    dzdoc:usesTerm dzterm:سندات_الاستحقاق .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_97> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_97" ;
    dzdoc:fullText "يجوز أن يشارك في الجمعية العامة، أصحاب سندات الاستحقاق المستهلكة وغير المسددة من جراء تخلف الشركة المدينة أو بسبب خلاف يتعلق بشروط التسديد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_97_permission_0_9ad4f0c5> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_97_right_0_a7b003bc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_97> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_97_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_97_19750926_OpEnact_4ace606a21> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 97" ;
    dzdoc:position 871 ;
    dzdoc:usesTerm dzterm:bondholders .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_98> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_98" ;
    dzdoc:fullText "تتداول الجمعية العامة لأصحاب سندات الاستحقاق في كل المسائل المتعلقة بحماية أصحاب سندات الاستحقاق وتنفيذ عقد القرض، كما تتداول في كل اقتراح يهدف إلى تعديل العقد أو بعض عناصره. يحق لكل صاحب سندات استحقاق الإطلاع على الوثائق التي تقدم للجمعية العامة لأصحاب سندات الاستحقاق والإطلاع على المحاضر وأوراق الحضور ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_98_right_0_1d2f2fbe> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_98> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_98_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_98_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_98_19750926_OpEnact_91052d49e6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 98" ;
    dzdoc:position 872 ;
    dzdoc:usesTerm dzterm:bondholders .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_bis> ;
    dzdoc:eId "art_715_ثالثا_1" ;
    dzdoc:fullText "يعين المسير الأول أو المسيرون الأولون بموجب القانون الأساسي وينجزون إجراءات التأسيس التي يكلف بها مؤسسو شركات المساهمة. تعين الجمعية العامة العادية المسير أو المسيرين خلال وجود الشركة، بموافقة كل الشركاء المتضامنين، إلا في حالة وجود شرط مخالف في القانون الأساسي . يعزل المسير ، شريكا كان أم لا، وفقا للشروط المنصوص عليها في القانون الأساسي. ويكون المسير علاوة على ذلك قابلا للعزل من المحكمة لسبب شرعي بناء على طلب من أي شريك أو من الشركة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1_para_3> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715___1_19750926_OpEnact_44aeb88971> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 ثالثا 1" ;
    dzdoc:position 908 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_1_condition_0_f17cdf45> ;
    dzdoc:usesTerm dzterm:manager .

<https://legal.dz/resource/order/1975-09-26/75-59#art_719> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_719" ;
    dzdoc:fullText "إن مصاريف تأسيس الشركة تستهلك قبل كل توزيع للأرباح ، مع مراعاة الفقرة الثانية من المادة 725 . وتستهلك مصاريف زيادة رأس المال على الأكثر عند انقضاء السنة المالية الخامسة والتالية للسنة المالية التي صرفت خلالها. ويسوغ خصم هذه المصاريف من مبلغ علاوات الإصدار المتعلقة بهذه الزيادة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_719> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_719_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_719_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_719_19750926_OpEnact_0d3fc8c8a0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_719_obligation_0_cfce866c>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_719_obligation_1_a2672100> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "719" ;
    dzdoc:position 921 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_725> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_725> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_726> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_726" ;
    dzdoc:fullText "لا يجوز طلب استرداد أي ربح من المساهمين أو حاملي الأسهم ماعدا حالة التوزيع الجاري خلافا لأحكام المادتين 724 و 725 ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_726_permission_0_cee2a319> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_726> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_726_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_726_19750926_OpEnact_7aa23bed18> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_726_prohibition_0_cee2a319> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "726" ;
    dzdoc:position 928 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_724>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_725> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_724>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_725> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_727> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_727" ;
    dzdoc:fullText "إن دفع المكافآت لأعضاء مجلس الإدارة متوقف حسب كل حالة على دفع الأرباح للمساهمين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_727> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_727_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_727_19750926_OpEnact_af3826e3d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "727" ;
    dzdoc:position 929 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_727_condition_0_7189e5ab> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_752> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_752" ;
    dzdoc:fullText "يوضع تقرير مندوب الحسابات في المقر الرئيسي ويجعل تحت تصرف الشركاء أو المساهمين في ظرف الخمسة عشر يوما السابقة لانعقاد الجمعية المدعوة للنظر في مشروع الإدماج أو الانفصال . وفي حالة الاستشارة الكتابية ، يوجه هذا التقرير للشركاء مع مشروع القرار المعروض عليهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_752> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_752_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_752_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_752_19750926_OpEnact_37c17ece79> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_752_obligation_0_4865fbb6>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_752_obligation_1_b13076f8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 752" ;
    dzdoc:position 959 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_752_condition_0_57b4691c> ;
    dzdoc:usesTerm dzterm:auditor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_753> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_753" ;
    dzdoc:fullText "يحقق المندوبون المكلفون بتقرير الحصص المقدمة خصوصا بأن مبلغ رأس المال الصافي الذي قدمته الشركات المدمجة يعادل على الأقل مبلغ زيادة رأس مال الشركة المدمجة أو مبلغ رأس مال الشركة الجديدة الناتجة عن الإدماج . ويجري نفس هذا التحقيق بالنسبة لرأس مال الشركات المستفيدة من الانفصال ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_753> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_753_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_753_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_753_19750926_OpEnact_df23a90805> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_753_obligation_0_f9cf4d3d>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_753_obligation_1_e599412a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 753" ;
    dzdoc:position 960 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_787> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_787" ;
    dzdoc:fullText "يستدعي المصفي في ظرف ستة أشهر من تسميته جمعية الشركاء التي يقدم لها تقريرا عن أصول وخصوم الشركة وعن متابعة عمليات التصفية وعن الأجل الضروري لإتمامها. وفي حالة انعدام ذلك تستدعى الجمعية سواء من طرف هيئة المراقبة إن كانت أو من طرف وكيل معين بقرار قضائي بناء على طلب كل من يهمه الأمر. إذا تعذر انعقاد الجمعية أو لم يتخذ قرار ، فإن المصفي يطلب من القضاء الإذن اللازم للوصول إلى التصفية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_787> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_787_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_787_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_787_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_787_19750926_OpEnact_9d006f70a0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_787_obligation_0_3686bd14> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "787" ;
    dzdoc:position 994 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_787_condition_0_267bd5c4> ;
    dzdoc:usesTerm dzterm:liquidator .

<https://legal.dz/resource/order/1975-09-26/75-59#art_792> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_792" ;
    dzdoc:fullText "في حالة استمرار استغلال الشركة ، يتعين على المصفي استدعاء جمعية الشركاء حسب الشروط المنصوص عليها في المادة 789 ، وإلا جاز لكل من يهمه الأمر أن يطلب الاستدعاء سواء بواسطة مندوبي الحسابات أو هيئة المراقبة أو من وكيل معين بقرار قضائي ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_792_right_0_0ed31a96> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_792> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_792_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_792_19750926_OpEnact_2e3d40272a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_792_obligation_0_49215d6b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "792" ;
    dzdoc:position 999 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_789> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_789> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_792_condition_0_6e624abc> ;
    dzdoc:usesTerm dzterm:liquidator .

<https://legal.dz/resource/order/1975-09-26/75-59#art_795> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_795" ;
    dzdoc:fullText "تودع المبالغ المخصصة للتوزيع بين الشركاء والدائنين في أجل خمسة عشر يوما ابتداء من قرار التوزيع، في بنك باسم الشركة الموضوعة تحت التصفية . و يجوز سحب المبالغ بمجرد توقيع مصف واحد وتحت مسؤوليته ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_795_right_0_172eac37> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_795> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_795_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_795_19750926_OpEnact_b35cbc380b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_795_obligation_0_bdb1a9d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "795" ;
    dzdoc:position 1002 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_795_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_795_bis_1" ;
    dzdoc:fullText "يجوز تأسيس شركات محاصة بين شخصين طبيعيين أو أكثر، تتولى إنجاز عمليات تجارية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_795_bis_1_permission_0_fdf21bfe> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_795_bis_1_right_0_68a12665> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_795_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_795_bis_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_795_bis_1_19750926_OpEnact_798b675435> ;
