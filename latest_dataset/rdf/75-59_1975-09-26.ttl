<https://legal.dz/resource/order/1975-09-26/75-59#version_art_22> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن للأشخاص الطبيعيين أو المعنويين الخاضعين للتسجيل في السجل التجاري والذين لم يبادروا بتسجيل أنفسهم عند انقضاء مهلة شهرين أن يتمسكوا بصفتهم كتجار، لدى الغير أو لدى الإدارات العمومية إلا بعد تسجيلهم . غير أنه لا يمكن لهم الاستناد لعدم تسجيلهم في السجل بقصد تهربهم من المسؤوليات والواجبات الملازمة لهذه الصفة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_22_19750926_OpEnact_1559f49e0f> ;
    dzdoc:replacementText "لا يمكن للأشخاص الطبيعيين أو المعنويين الخاضعين للتسجيل في السجل التجاري والذين لم يبادروا بتسجيل أنفسهم عند انقضاء مهلة شهرين أن يتمسكوا بصفتهم كتجار، لدى الغير أو لدى الإدارات العمومية إلا بعد تسجيلهم . غير أنه لا يمكن لهم الاستناد لعدم تسجيلهم في السجل بقصد تهربهم من المسؤوليات والواجبات الملازمة لهذه الصفة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_22> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
