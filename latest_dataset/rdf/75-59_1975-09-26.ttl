<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_106> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة إفلاس الشركة أو تسويتها القضائية ، يؤهل ممثلو الجماعة للتصرف باسم جميع سندات الاستحقاق . ويصرحون في خصوم التسوية القضائية بالمبلغ الأصلي لسندات الاستحقاق التي لا تزال متداولة، مع قسیمات فوائد مستحقة وغير مسددة، يعد تفصيل حسابها ممثل الدائنين. ولا يلزمون بتقديم سندات موكليهم لدعم هذا التقديم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_106_19750926_OpEnact_3198bfd345> ;
    dzdoc:replacementText "في حالة إفلاس الشركة أو تسويتها القضائية ، يؤهل ممثلو الجماعة للتصرف باسم جميع سندات الاستحقاق . ويصرحون في خصوم التسوية القضائية بالمبلغ الأصلي لسندات الاستحقاق التي لا تزال متداولة، مع قسیمات فوائد مستحقة وغير مسددة، يعد تفصيل حسابها ممثل الدائنين. ولا يلزمون بتقديم سندات موكليهم لدعم هذا التقديم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_106> ;
