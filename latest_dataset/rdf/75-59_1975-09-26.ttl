    dznorm:position 1 ;
    dznorm:provisionText "تجتمع جماعة حاملي سندات المساهمة بقوة القانون مرة في السنة للاستماع إلى تقرير مسيري الشركة عن السنة المالية المنصرمة وتقرير مندوبي الحسابات حول حسابات السنة المالية والعناصر التي تستعمل لتحديد أجرة سندات المساهمة"@ar ;
    dznorm:sourceArticle "art_715_bis_78" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_78_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_78> ;
    dzdoc:position 0 ;
