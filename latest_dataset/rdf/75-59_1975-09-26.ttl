    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_314> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_317_condition_0_a15c2467>,
