<https://legal.dz/resource/order/1975-09-26/75-59#version_art_766> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعتبر الشركة في حالة تصفية من وقت حلها مهما كان السبب . ويتبع عنوان أو اسم الشركة بالبيان التالي \" شركة في حالة تصفية \". وتبقى الشخصية المعنوية للشركة قائمة لاحتياجات التصفية إلى أن يتم إقفالها . ولا ينتج حل الشركة آثاره على الغير إلا ابتداء من اليوم الذي تنشر فيه في السجل التجاري ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_766_19750926_OpEnact_73f93403f9> ;
    dzdoc:replacementText "تعتبر الشركة في حالة تصفية من وقت حلها مهما كان السبب . ويتبع عنوان أو اسم الشركة بالبيان التالي \" شركة في حالة تصفية \". وتبقى الشخصية المعنوية للشركة قائمة لاحتياجات التصفية إلى أن يتم إقفالها . ولا ينتج حل الشركة آثاره على الغير إلا ابتداء من اليوم الذي تنشر فيه في السجل التجاري ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_766> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_766> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
