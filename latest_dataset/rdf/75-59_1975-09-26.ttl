<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_105> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يتم تكوين ضمانات خاصة من الشركة المصدرة بواسطة سندات الاستحقاق قبل إصدار هذه السندات . تنشئ الأجهزة المؤهلة للشركة هذه الضمانات لفائدة جماعة أصحاب سندات الاستحقاق. يترتب عن الضمانات القيام بإشهار قبل كل اكتتاب حسب الكيفيات المحددة عن طريق التنظيم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_105_19750926_OpEnact_66f5d9b5b7> ;
    dzdoc:replacementText "يجب أن يتم تكوين ضمانات خاصة من الشركة المصدرة بواسطة سندات الاستحقاق قبل إصدار هذه السندات . تنشئ الأجهزة المؤهلة للشركة هذه الضمانات لفائدة جماعة أصحاب سندات الاستحقاق. يترتب عن الضمانات القيام بإشهار قبل كل اكتتاب حسب الكيفيات المحددة عن طريق التنظيم ."@ar ;
