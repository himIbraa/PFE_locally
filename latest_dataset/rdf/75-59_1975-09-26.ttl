<https://legal.dz/resource/order/1975-09-26/75-59#version_art_353> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوزع مبلغ الأصول، بعد طرح المصاريف وكذلك مصاريف الإفلاس والإعلانات الممنوحة للمدين أو لأسرته والمبالغ المدفوعة للدائنين ذوي الامتياز، بين جميع الدائنين بنسبة ديونهم المحققة والمقبولة . ويحتفظ بالحصة المطابقة للديون التي لم يتم البت فيها نهائيا وخاصة أجور مديري الشركة طالما لم يفصل في وضعيتهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_353_19750926_OpEnact_83d5eded74> ;
