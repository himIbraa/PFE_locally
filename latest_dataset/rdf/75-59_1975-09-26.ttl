<https://legal.dz/resource/order/1975-09-26/75-59#version_art_106> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان الشطب الذي لم يوافق عليه الدائن مطلوبا عن طريق دعوى أصلية ، فيجب رفع هذه الدعوى أمام محكمة المكان الذي حصل فيه القيد. وإذا كانت الدعوى تتعلق بطلب شطب قيود متممة في دائرات اختصاص مختلفة، على محل تجاري وفروعه ، فترفع بالنسبة لجميعها أمام المحكمة التي تقع بدائرتها المؤسسة الأصلية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_106_19750926_OpEnact_6dcd984f53> ;
    dzdoc:replacementText "إذا كان الشطب الذي لم يوافق عليه الدائن مطلوبا عن طريق دعوى أصلية ، فيجب رفع هذه الدعوى أمام محكمة المكان الذي حصل فيه القيد. وإذا كانت الدعوى تتعلق بطلب شطب قيود متممة في دائرات اختصاص مختلفة، على محل تجاري وفروعه ، فترفع بالنسبة لجميعها أمام المحكمة التي تقع بدائرتها المؤسسة الأصلية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_106> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_106> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_107> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على مأموري السجل التجاري أن يسلموا لكل طالب جدولا بالقيود الموجودة مع البيانات المتعلقة بالأسبقية أو الشطب الجزئي أو الكلي أو الحلول الجزئي أو الكلي وإما شهادة بعدم وجود قيد أو بوجوده بدون تفصيل. كما يجب أن يسلم لكل طالب جدول بالقيود أو البيانات التي تمت ب المعهد الجزائري للملكية الصناعية وتنظيمها . ويجوز للموظف العمومي المكلف ببيع محل تجاري متى رأى لزوما لذلك أن يحصل من مأموري السجل التجاري على جداول القيد المودعة ب المركز الوطني للسجل التجاري والمتعلقة بالمحل التجاري."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_107_19750926_OpEnact_6cb4f59824> ;
    dzdoc:replacementText "يجب على مأموري السجل التجاري أن يسلموا لكل طالب جدولا بالقيود الموجودة مع البيانات المتعلقة بالأسبقية أو الشطب الجزئي أو الكلي أو الحلول الجزئي أو الكلي وإما شهادة بعدم وجود قيد أو بوجوده بدون تفصيل. كما يجب أن يسلم لكل طالب جدول بالقيود أو البيانات التي تمت ب المعهد الجزائري للملكية الصناعية وتنظيمها . ويجوز للموظف العمومي المكلف ببيع محل تجاري متى رأى لزوما لذلك أن يحصل من مأموري السجل التجاري على جداول القيد المودعة ب المركز الوطني للسجل التجاري والمتعلقة بالمحل التجاري."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_107> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
