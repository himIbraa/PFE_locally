<https://legal.dz/resource/order/1975-09-26/75-59#version_art_296> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة فسخ الإيجارات المنصوص عليها في المادتين 278 و 279 المتقدمتين يكون للمالك امتياز عن السنتين الأخيرتين من الأجرة المستحقة قبل الحكم بإشهار الإفلاس أو بالتسوية القضائية وعن السنة الجارية مقابل كل ما يخص تنفيذ الإجارة. وفي حالة عدم الفسخ فليس للمؤجر بعد استيفاء كل الإيجارات المستحقة أن يطالب بسداد الإيجارات الجارية أو المستقبلة ما دامت التأمينات التي كانت معطاة له لا تزال قائمة أو تلك التي أعطيت له منذ التوقف عن الدفع قد اعتبرت كافية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_296_19750926_OpEnact_9ed157f3e9> ;
    dzdoc:replacementText "في حالة فسخ الإيجارات المنصوص عليها في المادتين 278 و 279 المتقدمتين يكون للمالك امتياز عن السنتين الأخيرتين من الأجرة المستحقة قبل الحكم بإشهار الإفلاس أو بالتسوية القضائية وعن السنة الجارية مقابل كل ما يخص تنفيذ الإجارة. وفي حالة عدم الفسخ فليس للمؤجر بعد استيفاء كل الإيجارات المستحقة أن يطالب بسداد الإيجارات الجارية أو المستقبلة ما دامت التأمينات التي كانت معطاة له لا تزال قائمة أو تلك التي أعطيت له منذ التوقف عن الدفع قد اعتبرت كافية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_296> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_296> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_297> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا بيعت المنقولات المؤثثة بها الأماكن المؤجرة، ونقلت منها ، جاز للمؤجر ممارسة امتیازه حسبما هو مقرر لحالة الفسخ طبقا ل المادة السابقة . وتكون له فضلا عن ذلك أجرة السنة التي تستحق اعتبارا من العام الصادر فيه الحكم بإشهار الإفلاس أو بالتسوية القضائية، وذلك سواء كان للإجارة تاريخ ثابت أم لم يكن."@ar ;
