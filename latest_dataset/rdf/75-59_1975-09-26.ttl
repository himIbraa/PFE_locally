    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_646> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_646_condition_1_9b419ffc> a dznorm:Condition ;
    dznorm:conditionText "وفي حالة الشغور"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_646> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_646_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_646> ;
    dzdoc:position 0 ;
    dzdoc:text "يحدد القانون الأساسي مدة عضوية مجلس المديرين ضمن حدود تتراوح من عامين إلى ست سنوات، وعند عدم وجود أحكام قانونية أساسية صريحة تقدر مدة العضوية بأربع سنوات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_646_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_646> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي حالة الشغور، يتم تعيين الخلف للفترة المتبقية إلى غاية تجديد مجلس المديرين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_647_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_647> ;
    dzdoc:position 0 ;
    dzdoc:text "يحدد عقد التعيين كيفية دفع أجر أعضاء مجلس المديرين ومبلغ ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_648_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_648> ;
    dzdoc:position 0 ;
    dzdoc:text "يتمتع مجلس المديرين بالسلطات الواسعة للتصرف باسم الشركة في كل الظروف."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_648_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_648> ;
    dzdoc:position 1 ;
    dzdoc:text "ويمارس هذه السلطات في حدود موضوع الشركة مع مراعاة السلطات التي يخولها القانون صراحة لمجلس المراقبة وجمعيات المساهمين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_649_condition_0_0ffb70ac> a dznorm:Condition ;
    dznorm:conditionText "ما لم يثبت أن الغير كان يعلم أن العمل يتجاوز هذا الموضوع أو لا يمكنه تجاهله نظرا للظروف"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_649> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_649_obligation_0_1bdf15e4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_649> ;
    dznorm:position 0 ;
    dznorm:provisionText "تكون الشركة ملزمة في علاقاتها مع الغير، حتى بأعمال مجلس المديرين غير التابعة لموضوع الشركة"@ar ;
    dznorm:sourceArticle "art_649" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_649_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_649> ;
    dzdoc:position 0 ;
    dzdoc:text "تكون الشركة ملزمة في علاقاتها مع الغير، حتى بأعمال مجلس المديرين غير التابعة لموضوع الشركة ما لم يثبت أن الغير كان يعلم أن العمل يتجاوز هذا الموضوع أو لا يمكنه تجاهله نظرا للظروف مع استبعاد كون نشر القانون الأساسي يكفي وحده لتأسيس هذه البينة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_649_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_649> ;
    dzdoc:position 1 ;
    dzdoc:text "لا يحتج على الغير بأحكام القانون الأساسي التي تحدد سلطات مجلس المديرين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_64_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_64> ;
    dzdoc:position 0 ;
    dzdoc:text "تترتب مسؤولية الناقل إزاء المسافر ابتداء من تكلفه به."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_650_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_650> ;
    dzdoc:position 0 ;
    dzdoc:text "يتداول مجلس المديرين ويتخذ قراراته حسب الشروط التي يحددها القانون الأساسي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_651_condition_0_c6f8b960> a dznorm:Condition ;
    dznorm:conditionText "إذا ما تقرر نقله خارج هذه المدينة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_651> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_651_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_651> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم نقل مقر الشركة في نفس المدينة بقرار مجلس المراقبة، وإذا ما تقرر نقله خارج هذه المدينة، فإن القرار يكون من اختصاص الجمعية العامة العادية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_652_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_652> ;
    dzdoc:position 0 ;
    dzdoc:text "يمثل رئيس مجلس المديرين الشركة في علاقاتها مع الغير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_652_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_652> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أنه يجوز أن يؤهل القانون الأساسي مجلس المراقبة لمنح نفس سلطة التمثيل لعضو أو عدة أعضاء آخرين في مجلس المديرين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_652_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_652> ;
    dzdoc:position 2 ;
    dzdoc:text "لا يحتج على الغير بأحكام القانون الأساسي التي تحدد سلطة تمثيل أعضاء مجلس المديرين."@ar .

