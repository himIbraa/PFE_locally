<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_122> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا قامت الشركة بإصدار سندات استحقاق جديدة قابلة للتحويل أو سندات استحقاق مع قسيمات اكتتاب وجب عليها إخبار أصحاب سندات الاستحقاق بواسطة إعلان ينشر حسب شروط يحددها نظام السلطة المكلفة بتنظيم عمليات البورصة ومراقبتها للسماح لهم باختيار التحويل في الأجل الذي يحدده الإعلان المذكور ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
