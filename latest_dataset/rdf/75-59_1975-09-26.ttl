<https://legal.dz/resource/order/1975-09-26/75-59#version_art_186> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة ما إذا ثبت أن المؤجر لم يمارس الحقوق المسندة له بموجب المادة 177 وما يليها إلا بنية تعطيل حقوق المستأجر بطريقة تدليسية، خاصة إذا قام بعمليات تأجير وإعادة بيع ، فإنه يبقى للمستأجر الحق في قبض تعويض يكون مساويا لمبلغ الضرر الذي لحق به ، وذلك سواء كانت العمليات التي قام بها المؤجر ذات طابع مدني أو تجاري."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_186_19750926_OpEnact_55b402e121> ;
    dzdoc:replacementText "في حالة ما إذا ثبت أن المؤجر لم يمارس الحقوق المسندة له بموجب المادة 177 وما يليها إلا بنية تعطيل حقوق المستأجر بطريقة تدليسية، خاصة إذا قام بعمليات تأجير وإعادة بيع ، فإنه يبقى للمستأجر الحق في قبض تعويض يكون مساويا لمبلغ الضرر الذي لحق به ، وذلك سواء كانت العمليات التي قام بها المؤجر ذات طابع مدني أو تجاري."@ar ;
