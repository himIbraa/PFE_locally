<https://legal.dz/resource/order/1975-09-26/75-59#version_art_146> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعرض على رئيس المحكمة في شهر ديسمبر من كل سنة، الدفاتر المنصوص عليها في المواد أعلاه، وبعد مراجعة محتواها والتأكد من أن القيد قد اتبع على وجه الدقة، يصادق عليها في ذيل آخر قيد."@ar ;
