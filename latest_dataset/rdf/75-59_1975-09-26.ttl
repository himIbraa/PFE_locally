<https://legal.dz/resource/order/1975-09-26/75-59#art_42_condition_0_6f214722> a dznorm:Condition ;
    dznorm:conditionText "ما دامت في حيازة الناقل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_42> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_42_condition_1_f8b49b6a> a dznorm:Condition ;
    dznorm:conditionText "بشرط أن يدفع له أجرة النقل عن المسافة المقطوعة وأن يعرض له ما صرفه وما لحقه من الضرر بسبب استردادها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_42> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_42_condition_2_d2b01de1> a dznorm:Condition ;
    dznorm:conditionText "إذا تم تسليم سند النقل إلى المرسل إليه فينتقل إليه هذا الحق"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_42> ;
    dznorm:position 2 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_42_condition_3_55c24cc4> a dznorm:Condition ;
    dznorm:conditionText "إذا كان المرسل تسلم سند النقل وعجز عن تقديمه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_42> ;
    dznorm:position 3 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_42_condition_4_2941de5c> a dznorm:Condition ;
    dznorm:conditionText "إذا طلب المرسل إليه استلام الأشياء بعد وصولها إلى المكان الموجهة إليه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_42> ;
    dznorm:position 4 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_42_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_42> ;
    dzdoc:position 0 ;
    dzdoc:text "يحق للمرسل إبدال اسم المرسل إليه أو استرداد الأشياء المنقولة ما دامت في حيازة الناقل، بشرط أن يدفع له أجرة النقل عن المسافة المقطوعة وأن يعرض له ما صرفه وما لحقه من الضرر بسبب استردادها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_42_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_42> ;
    dzdoc:position 1 ;
    dzdoc:text "على أنه لا يجوز للمرسل أن يمارس هذا الحق : إذا تم تسليم سند النقل إلى المرسل إليه فينتقل إليه هذا الحق، إذا كان المرسل تسلم سند النقل وعجز عن تقديمه، إذا طلب المرسل إليه استلام الأشياء بعد وصولها إلى المكان الموجهة إليه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_42_permission_0_d36d5835> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_42_permission_0_d36d5835_action_6cd555cdfe> ;
