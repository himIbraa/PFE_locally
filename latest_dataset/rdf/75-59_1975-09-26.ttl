<https://legal.dz/resource/order/1975-09-26/75-59#version_art_149> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز أن يتدخل بطريق مباشر أو غير مباشر ولو بالتبعية كسماسرة أو وسطاء أو مستشارين مهنيين في التنازلات والرهون المتعلقة بالمحلات التجارية كما لا يجوز لهم أن يكونوا تحت أي اسم كان مودعين لأثمان بيع المحلات التجارية : الأفراد المحكوم عليهم بجريمة أو تفليس أو سرقة أو خيانة الأمانة أو الاحتيال أو اختلاس مرتكب من مودع عمومي أو ابتزاز الأموال أو التوقيع أو القيم أو إصدار شيك عن سوء نية بدون رصيد أو المس باعتماد الدولة أو اليمين الكاذبة أو الشهادة الكاذبة أو إغراء شاهد أو المحاولة أو الاشتراك في إحدى "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_149_19750926_OpEnact_59a3150e7e> ;
    dzdoc:replacementText "لا يجوز أن يتدخل بطريق مباشر أو غير مباشر ولو بالتبعية كسماسرة أو وسطاء أو مستشارين مهنيين في التنازلات والرهون المتعلقة بالمحلات التجارية كما لا يجوز لهم أن يكونوا تحت أي اسم كان مودعين لأثمان بيع المحلات التجارية : الأفراد المحكوم عليهم بجريمة أو تفليس أو سرقة أو خيانة الأمانة أو الاحتيال أو اختلاس مرتكب من مودع عمومي أو ابتزاز الأموال أو التوقيع أو القيم أو إصدار شيك عن سوء نية بدون رصيد أو المس باعتماد الدولة أو اليمين الكاذبة أو الشهادة الكاذبة أو إغراء شاهد أو المحاولة أو الاشتراك في إحدى الجرائم أو الجنح المشار إليها أعلاه ، المفلسون الذين لم يرد لهم اعتبارهم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_149> ;
