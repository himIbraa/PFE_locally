<https://legal.dz/resource/order/1975-09-26/75-59#version_art_663> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز تعيين شخص معنوي في مجلس المراقبة ، و عليه أن يعين ممثلا دائما عند تعيينه ، يخضع لنفس الشروط والالتزامات، ويتحمل نفس المسؤوليات الجزائية والمدنية كما لو كان عضوا باسمه الخاص ، دون المساس بالمسؤولية التضامنية للشخص المعنوي ممثله الذي يمثله و إذا عزل الشخص المعنوي وجب عليه استخلافه في الوقت نفسه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_663_19750926_OpEnact_94d3549462> ;
    dzdoc:replacementText "يجوز تعيين شخص معنوي في مجلس المراقبة ، و عليه أن يعين ممثلا دائما عند تعيينه ، يخضع لنفس الشروط والالتزامات، ويتحمل نفس المسؤوليات الجزائية والمدنية كما لو كان عضوا باسمه الخاص ، دون المساس بالمسؤولية التضامنية للشخص المعنوي ممثله الذي يمثله و إذا عزل الشخص المعنوي وجب عليه استخلافه في الوقت نفسه ."@ar ;
