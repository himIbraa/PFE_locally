    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_259_obligation_0_d4d6e6f8_ref_011228d7dcbe> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_258> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_258> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_259> ;
    dznorm:position 0 ;
    dznorm:provisionText "يقوم رئيس المحكمة الذي وضع الأختام في الأحوال المنصوص عليها في المادة السابقة بإبلاغ رئيس المحكمة الذي حكم بشهر الإفلاس أو التسوية القضائية بلا إبطاء بحصول وضع الأختام"@ar ;
    dznorm:sourceArticle "art_259" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_259_obligation_0_d4d6e6f8_ref_011228d7dcbe> a dzdoc:Reference ;
    rdfs:label "المادة السابقة"@ar ;
    dzdoc:frbrUri "#art_258"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1975-09-26/75-59#art_258> ;
    dzdoc:sourceEId "art_259" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يقوم رئيس المحكمة الذي وضع الأختام في الأحوال المنصوص عليها في المادة السابقة بإبلاغ رئيس المحكمة الذي حكم بشهر الإفلاس أو التسوية القضائية بلا إبطاء بحصول وضع الأختام"@ar ;
    dzdoc:targetEId "art_258" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_259_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_259> ;
    dzdoc:position 0 ;
    dzdoc:text "يقوم رئيس المحكمة الذي وضع الأختام في الأحوال المنصوص عليها في المادة السابقة بإبلاغ رئيس المحكمة الذي حكم بشهر الإفلاس أو التسوية القضائية بلا إبطاء بحصول وضع الأختام."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_25_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_25> ;
    dzdoc:position 0 ;
    dzdoc:text "تسري أحكام المادة السابقة حتى فيما إذا كانت الوقائع موضوع نشر قانوني آخر، وذلك : 1 - في حالة الرجوع عن ترشيد التاجر القاصر تطبيقا لأحكام التشريع الخاص بالأسرة وعند إلغاء الإذن المسلم لقاصر الخاص بممارسة التجارة، 2 – في حالة صدور أحكام نهائية تقضي بالحجز على تاجر وبتعيين إما وصي قضائي وإما متصرف على أمواله، 3 - في حالة صدور أحكام نهائية تقضي ببطلان شركة تجارية بحلها، 4 – في حالة إنهاء أو إلغاء سلطات كل شخص ذي صفة ملزمة لمسؤولية تاجر أو شركة أو مؤسسة اشتراكية، 5 – في حالة صدور قرار من جمعية عامة لشركة مساهمة أو ذات مسؤولية محدودة يتضمن الأمر باتخاذ قرار من الجمعية العامة في حالة خسارة 3/4 من مالية الشركة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_260_condition_0_c3113ed3> a dznorm:Condition ;
    dznorm:conditionText "إذا أمرت المحكمة بوضع الأختام"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_260> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_260_obligation_0_9c35edcd> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_260> ;
    dznorm:position 0 ;
    dznorm:provisionText "ويقوم وكيل التفليسة بتحرير قائمة جرد بالأشياء المشار إليها في هذه المادة مع تقويمها ويكون هذا بحضور القاضي المنتدب الذي يوقع المحضر"@ar ;
    dznorm:sourceArticle "art_260" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_260_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_260> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا أمرت المحكمة بوضع الأختام فللقاضي المنتدب بناء على طلب وكيل التفليسة إعفاءه من وضع الأختام على الأشياء التالية أو الإذن له باستخراجها: المنقولات والأمتعة اللازمة للمدين ولأسرته، طبقا للبيان المعروض عليه، الأشياء المعروضة للتلف القريب أو انخفاض القيمة الوشيك، ما يلزم استعماله في نشاطه الصناعي أو مؤسسته إن كان رخص له باستمرار الاستغلال."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_260_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_260> ;
    dzdoc:position 1 ;
    dzdoc:text "ويقوم وكيل التفليسة بتحرير قائمة جرد بالأشياء المشار إليها في هذه المادة مع تقويمها ويكون هذا بحضور القاضي المنتدب الذي يوقع المحضر."@ar .

