<https://legal.dz/resource/order/1975-09-26/75-59#art_787_condition_0_267bd5c4> a dznorm:Condition ;
    dznorm:conditionText "إذا تعذر انعقاد الجمعية أو لم يتخذ قرار"@ar ;
