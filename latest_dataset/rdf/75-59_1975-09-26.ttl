<https://legal.dz/resource/order/1975-09-26/75-59#art_785_obligation_1_bf1be255> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
