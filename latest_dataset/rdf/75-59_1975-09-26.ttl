<https://legal.dz/resource/order/1975-09-26/75-59#art_590_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_590> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يسوغ أن يتجاوز عدد الشركاء في شركة ذات مسؤولية محدودة عشرين شريكا. وإذا أصبحت الشركة مشتملة على أكثر من عشرين شريكا وجب تحويلها إلى شركة مساهمة في أجل سنة واحدة. وعند عدم ذلك تنحل الشركة ما لم يصبح عدد الشركاء في تلك الفترة من الزمن مساويا لعشرين شريكا أو أقل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_591_obligation_0_0e884ae7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
