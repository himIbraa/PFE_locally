<https://legal.dz/resource/order/1975-09-26/75-59#version_art_732_bis_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما تأخذ شركة، خلال سنة مالية مساهمة في شركة يوجد مركزها بالجزائر، أو تحصلت على أكثر من نصف رأسمال هذه الشركة ، يذكر ذلك في التقرير الذي يقدم للشركاء والمتعلق بالعمليات التي تم إجراؤها خلال السنة المالية، وعند الاقتضاء، في تقرير محافظي الحسابات . يشير مجلس الإدارة أو مجلس المديرين أو المسير في تقريره إلى نشاط الشركات التابعة حسب مجال النشاط كما يظهر النتائج المحصل عليها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_732_bis_1_19750926_OpEnact_bbdcdf36f5> ;
    dzdoc:replacementText "عندما تأخذ شركة، خلال سنة مالية مساهمة في شركة يوجد مركزها بالجزائر، أو تحصلت على أكثر من نصف رأسمال هذه الشركة ، يذكر ذلك في التقرير الذي يقدم للشركاء والمتعلق بالعمليات التي تم إجراؤها خلال السنة المالية، وعند الاقتضاء، في تقرير محافظي الحسابات . يشير مجلس الإدارة أو مجلس المديرين أو المسير في تقريره إلى نشاط الشركات التابعة حسب مجال النشاط كما يظهر النتائج المحصل عليها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_1> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
