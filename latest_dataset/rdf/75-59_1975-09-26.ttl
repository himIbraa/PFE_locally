<https://legal.dz/resource/order/1975-09-26/75-59#art_822_obligation_0_2601fe38> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
