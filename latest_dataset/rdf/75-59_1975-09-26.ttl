    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_705> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_706_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_706> ;
    dzdoc:position 0 ;
    dzdoc:text "يثبت الاكتتاب والدفعات بشهادة المودع المعتمد المعدة وقت إيداع الأموال بناء على تقديم بطاقة الاكتتاب."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_706_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_706> ;
    dzdoc:position 1 ;
    dzdoc:text "ويتم إثبات وفاء الأسهم بالمقاصة لديون نقدية ومستحقة الأداء على الشركة بواسطة تصريح موثق صادر إما عن مجلس الإدارة أو مجلس المديرين أو موكليهما. ويقوم هذا التصريح الموثق مقام شهادة المودع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_707_condition_0_ba7ab775> a dznorm:Condition ;
    dznorm:conditionText "في حالة ما إذا كانت الحصص المقدمة عينية أو كان هناك اشتراط منافع خاصة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_707> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_707_condition_1_52cbb777> a dznorm:Condition ;
    dznorm:conditionText "إذا أقرت الجمعية العامة تقدير الحصص ومنح المنافع الخاصة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_707> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_707_condition_2_25e69ae5> a dznorm:Condition ;
    dznorm:conditionText "وإذا خفضت الجمعية تقدير الحصص المقدمة ومكافأة المنافع الخاصة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_707> ;
    dznorm:position 2 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_707_obligation_0_81b7013f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_707_obligation_0_81b7013f_ref_1b598dc1a5a8> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_679> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_679> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_707> ;
    dznorm:position 0 ;
    dznorm:provisionText "ويخضع هؤلاء المندوبون للتنافي المنصوص عليه في المادة 679."@ar ;
    dznorm:sourceArticle "art_707" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_707_obligation_0_81b7013f_ref_1b598dc1a5a8> a dzdoc:Reference ;
    rdfs:label "المادة 679"@ar ;
    dzdoc:frbrUri "#art_679"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1975-09-26/75-59#art_679> ;
    dzdoc:sourceEId "art_707" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "ويخضع هؤلاء المندوبون للتنافي المنصوص عليه في المادة 679."@ar ;
    dzdoc:targetEId "art_679" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_707_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_707> ;
    dzdoc:position 0 ;
    dzdoc:text "في حالة ما إذا كانت الحصص المقدمة عينية أو كان هناك اشتراط منافع خاصة، فإنه يعين واحد أو أكثر من المندوبين المكلفين بتقدير الحصص العينية بقرار قضائي بناء على طلب رئيس مجلس الإدارة أو مجلس المديرين ويخضع هؤلاء المندوبون للتنافي المنصوص عليه في المادة 679."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_707_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_707> ;
    dzdoc:position 1 ;
    dzdoc:text "ويتم تقدير الحصص العينية والامتيازات خاصة تحت مسؤولية هؤلاء المندوبين، ويوضع تقريرهم تحت تصرف المساهمين قبل ثمانية أيام على الأقل من تاريخ انعقاد الجمعية. وتطبق أحكام المادة 603 على الجمعية العامة غير العادية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_707_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_707> ;
    dzdoc:position 2 ;
    dzdoc:text "إذا أقرت الجمعية العامة تقدير الحصص ومنح المنافع الخاصة، فإنها تثبت تحقيق زيادة رأس المال."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_707_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_707> ;
    dzdoc:position 3 ;
    dzdoc:text "وإذا خفضت الجمعية تقدير الحصص المقدمة ومكافأة المنافع الخاصة، فإن المصادقة الصريحة لتعديلات مقدمي الحصص أو المستفيدين أو وكلائهم المرخص لهم قانونا بهذا الشأن، تعد واجبة. فإذا لم يتحقق ذلك فإن زيادة رأس المال تبقى غير محققة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_707_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_707> ;
    dzdoc:position 4 ;
    dzdoc:text "وتصبح أسهم الحصص المقدمة بكاملها مسددة بمجرد إصدارها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_708_condition_0_e1e92ac2> a dznorm:Condition ;
    dznorm:conditionText "في حالة تخصيص أسهم جديدة للمساهمين بعد إلحاق الاحتياطات أو أرباح أو علاوات الإصدار إلى رأس المال"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_708> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_708_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_708> ;
    dzdoc:position 0 ;
    dzdoc:text "في حالة تخصيص أسهم جديدة للمساهمين بعد إلحاق الاحتياطات أو أرباح أو علاوات الإصدار إلى رأس المال، فإن الحق المخول على هذا الشكل يكون قابلا للتداول أو التحويل. ويبقى تابعا لمالك الرقبة مع مراعاة حقوق صاحب حق الانتفاع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_708_right_0_23bc5385> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
