<https://legal.dz/resource/order/1975-09-26/75-59#version_art_832> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 20.000 دج إلى 100.000 دج أو بإحدى هاتين العقوبتين فقط، رئيس شركة المساهمة أو القائمون بإدارتها في حالة ما إذا أصبح المال الصافي للشركة - بسبب الخسائر الثابتة بمستندات الحساب - أقل من ربع رأس المال : امتنعوا متعمدين عن استدعاء الجمعية العامة في الأربعة أشهر التي تلي المصادقة على الحسابات المثبتة للخسائر لأجل البت عند الاقتضاء في حل الشركة مسبقا، تعمدوا عدم الإيداع بكتابة المحكمة القرار المصادق عليه من الجمعية العامة بعد نشره في النشرة الرسمية للإعلانا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_832_19750926_OpEnact_ff50d029ae> ;
    dzdoc:replacementText "يعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 20.000 دج إلى 100.000 دج أو بإحدى هاتين العقوبتين فقط، رئيس شركة المساهمة أو القائمون بإدارتها في حالة ما إذا أصبح المال الصافي للشركة - بسبب الخسائر الثابتة بمستندات الحساب - أقل من ربع رأس المال : امتنعوا متعمدين عن استدعاء الجمعية العامة في الأربعة أشهر التي تلي المصادقة على الحسابات المثبتة للخسائر لأجل البت عند الاقتضاء في حل الشركة مسبقا، تعمدوا عدم الإيداع بكتابة المحكمة القرار المصادق عليه من الجمعية العامة بعد نشره في النشرة الرسمية للإعلانات القانونية وفضلا عن ذلك في جريدة مختصة بقبول الإعلانات القانونية وتقييده بالسجل التجاري."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_832> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_832> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
