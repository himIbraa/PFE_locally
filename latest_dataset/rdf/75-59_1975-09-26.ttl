<https://legal.dz/resource/order/1975-09-26/75-59#art_382_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_382> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق عقوبات التفليس بالتدليس على : الأشخاص الذين يثبت أنهم قد اختلسوا لمصلحة المدين أو أخفوا أو خبؤا كل أو بعض أمواله المنقولة أو العقارية وذلك بغير مساس بما عدا ذلك من أحوال نصت عليها المادتان 42 و 43 من قانون العقوبات، الأشخاص الذين يثبت أنهم قدموا في التفليسة أو التسوية القضائية بطريق التدليس ديونا وهمية سواء باسمهم أو بوساطة آخرين، الأشخاص الذين مارسوا التجارة خفية باسم الغير أو باسم وهمي وارتكبوا أحد الأفعال المنصوص عليها في المادة 374 من هذا القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_383_extref_6b0d8851> a dzdoc:ExternalReference ;
    rdfs:label "المادة 380"@ar ;
    dzdoc:frbrUri "/akn/dz/act/order/1966-06-08/66-156#art_380"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/order/1966-06-08/66-156#art_380"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/order/1966-06-08/66-156#art_380" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/order/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:targetEId "art_380" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_383_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_383> ;
    dzdoc:position 0 ;
    dzdoc:text "تسري على زوج المدين وأصوله وفروعه أو أنسابه من نفس الدرجة الذين يكونون قد بددوا أو أخفوا أو غيروا مال أشياء تتبع أصول التفليسة دون أن يكونوا شركاء للمدين، العقوبات المنصوص عليها في الفقرة الأولى من المادة 380 من قانون العقوبات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_384_condition_0_130a4a6f> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_384_condition_0_130a4a6f_ref_915e85e0357d> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_380> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_380> ;
    dznorm:conditionText "عند الحكم في إحدى الحالات المنصوص عليها في المواد المتقدمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_384> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_384_condition_0_130a4a6f_ref_915e85e0357d> a dzdoc:Reference ;
    rdfs:label "المواد المتقدمة"@ar ;
    dzdoc:frbrUri "#art_380"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1975-09-26/75-59#art_380> ;
    dzdoc:sourceEId "art_384" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "عند الحكم في إحدى الحالات المنصوص عليها في المواد المتقدمة"@ar ;
    dzdoc:targetEId "art_380" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_384_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_384> ;
    dzdoc:position 0 ;
    dzdoc:text "عند الحكم في إحدى الحالات المنصوص عليها في المواد المتقدمة تفصل المحكمة المعروض عليها الموضوع، ولو قضت بالإعفاء من التهمة : 1 - تلقائيا في أن تضاف لجانب جماعة الدائنين الأموال والحقوق أو الدعاوى التي أبعدت بطريق التدليس، 2 - فيما يطلب من تعويضات عن الضرر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_385_extref_3c0a3197> a dzdoc:ExternalReference ;
    rdfs:label "الفقرة الأولى من المادة 380 من قانون العقوبات"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-156#art_380"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-156#art_380"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-156#art_380" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:targetEId "art_380" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_385_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_385> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق العقوبات المنصوص عليها في الفقرة الأولى من المادة 380 من قانون العقوبات على الدائن الذي اشترط لنفسه سواء مع المدين أو مع أشخاص سواه، مزايا خاصة في إعطاء صوته في مداولات جماعة الدائنين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_386_obligation_0_4dc6e4ea> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_386_obligation_0_4dc6e4ea_role_856ff98b23> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_386> ;
    dznorm:position 0 ;
    dznorm:provisionText "ويتعين على الدائن بأن يرد لصاحب الشأن المبالغ أو القيم المنقولة التي قبضها بموجب الاتفاقات المحكوم ببطلانها"@ar ;
    dznorm:sourceArticle "art_386" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_386_obligation_0_4dc6e4ea_role_856ff98b23> a dznorm:Role ;
    rdfs:label "الدائن بأن يرد لصاحب"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "ويتعين على الدائن بأن يرد لصاحب الشأن المبالغ أو القيم المنقولة التي قبضها بموجب الاتفاقات المحكوم ببطلانها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_386> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_386_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_386> ;
    dzdoc:position 0 ;
    dzdoc:text "يقضى، فضلا عن ذلك، ببطلان تلك الاتفاقات بالنسبة لجميع الأشخاص المذكورين أعلاه بما فيهم المدين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_386_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_386> ;
    dzdoc:position 1 ;
    dzdoc:text "ويتعين على الدائن بأن يرد لصاحب الشأن المبالغ أو القيم المنقولة التي قبضها بموجب الاتفاقات المحكوم ببطلانها."@ar .

