<https://legal.dz/resource/order/1975-09-26/75-59#version_art_9> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل شخص طبيعي أو معنوي له صفة التاجر ملزم بمسك دفتر لليومية يقيد فيه يوما بيوم عمليات المقاولة أو أن يراجع على الأقل نتائج هذه العمليات شهريا بشرط أن يحتفظ في هذه الحالة بكافة الوثائق التي يمكن معها مراجعة تلك العمليات يوميا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_9_19750926_OpEnact_f09acc53be> ;
