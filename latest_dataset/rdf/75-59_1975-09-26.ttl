    dzdoc:sourceTextSpan "وفي حالة إهمال الإجراءات المقررة بالفقرة السابقة يمكن أن يسقط حق امتياز الدائن المقيد إذا ثبت أنه تسبب بتقصيره في إلحاق الضرر بغير المتعاقدين الذين وقع تغليطهم في الوقف على الحالة القانونية للمحل التجاري."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_123> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_123_permission_1_0381f3a0> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
