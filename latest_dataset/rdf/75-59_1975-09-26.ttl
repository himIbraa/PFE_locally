    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_107> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب على مأموري السجل التجاري أن يسلموا لكل طالب جدولا بالقيود الموجودة مع البيانات المتعلقة بالأسبقية أو الشطب الجزئي أو الكلي أو الحلول الجزئي أو الكلي وإما شهادة بعدم وجود قيد أو بوجوده بدون تفصيل."@ar ;
    dznorm:sourceArticle "art_107" .

