    dzdoc:position 835 ;
    dzdoc:usesTerm dzterm:investment_certificates,
        dzterm:voting_right_certificates .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_68> a dzdoc:Article ;
