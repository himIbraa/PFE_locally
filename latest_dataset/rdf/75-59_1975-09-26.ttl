<https://legal.dz/resource/order/1975-09-26/75-59#version_art_49> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا قام عدة ناقلين على وجه التعاقب بتنفيذ عقد النقل ذاته : 1 - يكون أول الناقلين وآخرهم مسؤولين بالتضامن فيما بينهما تجاه المرسل والمرسل إليه عن مجموع النقل وضمن نفس الشروط المترتبة فيما لو قام كل منهما بتمام النقل ، 2 - ويعد كل من الناقلين الوسطاء تجاه المرسل والمرسل إليه وكذلك تجاه أول وآخر ناقل، مسؤولا عن الضرر الحاصل بالنسبة للمسافة التي قطعها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_49_19750926_OpEnact_b3bd248a09> ;
    dzdoc:replacementText "إذا قام عدة ناقلين على وجه التعاقب بتنفيذ عقد النقل ذاته : 1 - يكون أول الناقلين وآخرهم مسؤولين بالتضامن فيما بينهما تجاه المرسل والمرسل إليه عن مجموع النقل وضمن نفس الشروط المترتبة فيما لو قام كل منهما بتمام النقل ، 2 - ويعد كل من الناقلين الوسطاء تجاه المرسل والمرسل إليه وكذلك تجاه أول وآخر ناقل، مسؤولا عن الضرر الحاصل بالنسبة للمسافة التي قطعها."@ar ;
