<https://legal.dz/resource/order/1975-09-26/75-59#version_art_344> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجري بغير إبطاء تحقيق ما يقدم من مستندات الديون عملا ب المادة السابقة . ولا يكون ثمة محل لتحقيق جديد للديون السابق قبولها بغير إخلال مع ذلك برفض أو تخفيض الديون التي قد تكون من ذلك الحين قد وفيت كليا أو جزئيا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_344_19750926_OpEnact_feb24f8935> ;
