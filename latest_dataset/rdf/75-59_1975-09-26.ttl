<https://legal.dz/resource/order/1975-09-26/75-59#version_art_587> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ما عدا حالة إحالة حصص للغير يجب أن تكون قرارات الجمعيات غير العادية، مسبوقة بتقرير يحرره خبير معتمد عن وضع الشركة ."@ar ;
