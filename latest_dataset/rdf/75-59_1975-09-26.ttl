<https://legal.dz/resource/order/1975-09-26/75-59#art_368> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_2> ;
    dzdoc:eId "art_368" ;
    dzdoc:fullText "تعفى إجراءات رد الاعتبار المنصوص عليها في هذا الباب من رسوم الطابع والتسجيل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_368> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_368_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_368_19750926_OpEnact_8166b40958> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 368" ;
    dzdoc:position 373 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_369> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_3_sec_1> ;
    dzdoc:eId "art_369" ;
    dzdoc:fullText "تطبق العقوبات المنصوص عليها في المادة 383 من قانون العقوبات ، على الأشخاص الذين تثبت إدانتهم بـ التفليس بالتقصير أو بـ التدليس ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_369> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_369_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_369_19750926_OpEnact_61181eb9e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 369" ;
    dzdoc:position 374 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_369_extref_f2125953> ;
    dzdoc:usesTerm dzterm:bankruptcy_fraud,
        dzterm:bankruptcy_negligence,
        dzterm:sanctions .

<https://legal.dz/resource/order/1975-09-26/75-59#art_375> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_375" ;
    dzdoc:fullText "تطبق المادتان 372 و 373 على المتابعات بتهمة التفليس بالتدليس ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_375> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_375_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_375_19750926_OpEnact_5accee2eff> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
