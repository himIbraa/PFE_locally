<https://legal.dz/resource/order/1975-09-26/75-59#version_art_230> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوجه كاتب ضبط المحكمة فورا إلى وكيل الدولة المختص ملخصا للأحكام الصادرة بشهر الإفلاس أو التسوية القضائية . ويتضمن هذا الملخص البيانات الرئيسية لتلك الأحكام ونصوصها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
