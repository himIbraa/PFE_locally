<https://legal.dz/resource/order/1975-09-26/75-59#art_323_condition_0_1a5e0928> a dznorm:Condition ;
    dznorm:conditionText "وفي حالة المعارضة التسويفية أو التعسفية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_323> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_323_obligation_0_0f67f7ba> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_323> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتعين إبلاغها للمدين ووكيل التفليسة في الثمانية أيام التالية للصلح، وإلا كانت ،باطلة، وتتضمن إعلانات بالحضور لأول جلسة للمحكمة"@ar ;
    dznorm:sourceArticle "art_323" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_323_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_323> ;
    dzdoc:position 0 ;
    dzdoc:text "يحق لجميع الدائنين الذين كان لهم حق المشاركة في الصلح أو الذين حصل إقرار بحقوقهم منذ إبرامه أن يعارضوا فيه. وتكون المعارضة مسببة ويتعين إبلاغها للمدين ووكيل التفليسة في الثمانية أيام التالية للصلح، وإلا كانت ،باطلة، وتتضمن إعلانات بالحضور لأول جلسة للمحكمة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_323_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_323> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي حالة المعارضة التسويفية أو التعسفية يجوز أن تطبق على المعارضة غرامة مدنية لا تتجاوز 5.000 دج."@ar .

