<https://legal.dz/resource/order/1975-09-26/75-59#art_614_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_614> ;
    dzdoc:position 0 ;
