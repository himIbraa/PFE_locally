<https://legal.dz/resource/order/1975-09-26/75-59#version_art_392> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كتب مبلغ السفتجة بالأحرف الكاملة والأرقام معا فالعبرة عند الاختلاف للمبلغ المحرر بالأحرف الكاملة. وإذا كتب مبلغ السفتجة عدة مرات بالأحرف أو بالأرقام فالعبرة عند الاختلاف لأقلها مبلغا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_392_19750926_OpEnact_a3fb16d093> ;
    dzdoc:replacementText "إذا كتب مبلغ السفتجة بالأحرف الكاملة والأرقام معا فالعبرة عند الاختلاف للمبلغ المحرر بالأحرف الكاملة. وإذا كتب مبلغ السفتجة عدة مرات بالأحرف أو بالأرقام فالعبرة عند الاختلاف لأقلها مبلغا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_392> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
