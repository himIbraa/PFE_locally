    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_13> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق الأحكام التي تحكم السند لأمر ما لم ينص هذا الفصل على خلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_15_obligation_0_687aa9bd> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
