    dznorm:provisionText "يجب أن تتم الإشارة إلى هذه المهلة في التبليغ المنصوص عليه في الفقرة السابقة، وإلا كان باطلا"@ar ;
    dznorm:sourceArticle "art_179" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_179_obligation_3_e9e36dfe_action_1479453c0b> a dznorm:Action ;
