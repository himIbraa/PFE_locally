    dzdoc:replacementText "يجب أن تودع العقود التأسيسية والعقود المعدلة للشركات التجارية لدى المركز الوطني للسجل التجاري وتنشر حسب الأوضاع الخاصة بكل شكل من أشكال الشركات وإلا كانت باطلة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_548> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_548> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_549> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تتمتع الشركة بـ الشخصية المعنوية إلا من تاريخ قيدها في السجل التجاري . وقبل إتمام هذا الإجراء يكون الأشخاص الذين تعهدوا باسم الشركة والحسابها متضامنين من غير تحديد أموالهم، إلا إذا قبلت الشركة، بعد تأسيسها بصفة قانونية أن تأخذ على عاتقها التعهدات المتخذة . فتعتبر التعهدات بمثابة تعهدات الشركة منذ تأسيسها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_549_19750926_OpEnact_678cdd70b8> ;
    dzdoc:replacementText "لا تتمتع الشركة بـ الشخصية المعنوية إلا من تاريخ قيدها في السجل التجاري . وقبل إتمام هذا الإجراء يكون الأشخاص الذين تعهدوا باسم الشركة والحسابها متضامنين من غير تحديد أموالهم، إلا إذا قبلت الشركة، بعد تأسيسها بصفة قانونية أن تأخذ على عاتقها التعهدات المتخذة . فتعتبر التعهدات بمثابة تعهدات الشركة منذ تأسيسها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_549> ;
