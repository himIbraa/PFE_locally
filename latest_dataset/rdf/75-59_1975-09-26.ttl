    dznorm:position 0 ;
    dznorm:provisionText "لا يجوز له أن يظهر السفتجة من جديد"@ar ;
    dznorm:sourceArticle "art_454" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_454_obligation_0_65d11655_action_3e799bf835> a dznorm:Action ;
    rdfs:label "له أن يظهر السفتجة من"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "لا يجوز له أن يظهر السفتجة من جديد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_454> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_454_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_454> ;
    dzdoc:position 0 ;
    dzdoc:text "يكتسب الموفي بطريق التدخل الحقوق الناتجة عن السفتجة على من قام بالوفاء عنه وعلى الملزمين له بمقتضى السفتجة ، إلا أنه لا يجوز له أن يظهر السفتجة من جديد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_454_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_454> ;
    dzdoc:position 1 ;
    dzdoc:text "وتبرأ ذمم المظهرين اللاحقين للموقع الذي تم الوفاء لمصلحته."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_454_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_454> ;
    dzdoc:position 2 ;
    dzdoc:text "وفي حالة تعدد المتدخلين للوفاء يفضل عليهم من يترتب على إيفائه إبراء أكثر عدد من الملزمين، ومن تدخل خلافا لهذه القاعدة مع علمه بها يفقد حق الرجوع على من كانت تبرأ ذمته لولا هذا التدخل."@ar .

