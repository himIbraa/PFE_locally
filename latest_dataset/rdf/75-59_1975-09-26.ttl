<https://legal.dz/resource/order/1975-09-26/75-59#version_art_108> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز ل مأموري السجل التجاري في سائر الأحوال أن يمتنعوا عن القيام بالقيود أو تسليم الجداول أو الشهادات المطلوبة. ويعدون مسؤولين عن الإهمال الحاصل في دفاتر القيود المطلوبة في المركز الوطني للسجل التجاري وكذلك عن عدم التأشير في الجداول أو شهادات القيد أو القيود المتعددة الموجودة لديهم، إلا إذا كان الخطأ في هذه الحالة الأخيرة ناتجا عن بيانات غير كافية لا يمكن إسنادها إليهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_108_19750926_OpEnact_ce3a718503> ;
    dzdoc:replacementText "لا يجوز ل مأموري السجل التجاري في سائر الأحوال أن يمتنعوا عن القيام بالقيود أو تسليم الجداول أو الشهادات المطلوبة. ويعدون مسؤولين عن الإهمال الحاصل في دفاتر القيود المطلوبة في المركز الوطني للسجل التجاري وكذلك عن عدم التأشير في الجداول أو شهادات القيد أو القيود المتعددة الموجودة لديهم، إلا إذا كان الخطأ في هذه الحالة الأخيرة ناتجا عن بيانات غير كافية لا يمكن إسنادها إليهم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
