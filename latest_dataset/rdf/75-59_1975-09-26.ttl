<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_9_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_9> ;
    dzdoc:position 0 ;
    dzdoc:text "يأخذ سند النقل حسب الشروط المنصوص عليها في المادة السابقة، شكل السند التجاري، سواء كانت البضاعة في طريق النقل أو وصلت إلى الجهة المقصودة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_obligation_0_60ed7df5> a dznorm:Obligation ;
