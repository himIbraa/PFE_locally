<https://legal.dz/resource/order/1975-09-26/75-59#version_art_553> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعود إدارة الشركة لكافة الشركاء ما لم يشترط في القانون الأساسي على خلاف ذلك. ويجوز أن يعين في القانون المشار إليه مدير أو أكثر من الشركاء أو غير الشركاء، أو ينص على هذا التعيين بموجب عقد لاحق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_553_19750926_OpEnact_c28ee33c91> ;
    dzdoc:replacementText "تعود إدارة الشركة لكافة الشركاء ما لم يشترط في القانون الأساسي على خلاف ذلك. ويجوز أن يعين في القانون المشار إليه مدير أو أكثر من الشركاء أو غير الشركاء، أو ينص على هذا التعيين بموجب عقد لاحق."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_553> ;
