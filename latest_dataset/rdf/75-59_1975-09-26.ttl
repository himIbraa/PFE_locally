<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_1> ;
    dzdoc:eId "art_715_bis_34" ;
    dzdoc:fullText "تكتسي القيم المنقولة ، التي تصدرها شركات المساهمة، شكل سندات للحامل أو سندات اسمية. ويمكن أن يفرض الشكل الاسمي للقيم المنقولة عن طريق أحكام قانونية أو أحكام القانون الأساسي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_34_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_34_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_34_19750926_OpEnact_0d7c440f9a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 34" ;
    dzdoc:position 808 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_34_condition_0_84c64407> ;
    dzdoc:usesTerm dzterm:قيم_منقولة .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_48" ;
    dzdoc:fullText "يعد المساهم المتخلف والمحال لهم المتتابعون والمكتتبون، ملزمين بالتضامن بمبلغ السهم غير المسدد ويمكن الشخص الذي سدد ما للشركة من دين، المطالبة بالكل ضد أصحاب السهم المتتابعين، ويبقى العبء النهائي للدين على عاتق الأخير منهم. كل مكتتب أو مساهم أحال سنده، لا يبقى ملزما عن سداد الأقساط التي لا زالت لم تطلب، بعد سنتين من إثبات التنازل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_48_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_48_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_48_19750926_OpEnact_fe5b1ae96d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_48_obligation_0_2f56e36e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 48" ;
    dzdoc:position 822 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_48_condition_0_51278ece> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_4> ;
    dzdoc:eId "art_715_bis_78" ;
    dzdoc:fullText "يجتمع بقوة القانون حاملو سندات المساهمة التي هي من نفس الإصدار لتمثيل مصالحهم المشتركة في جماعة تتمتع بالشخصية المدنية ، ويخضعون للأحكام المنصوص عليها بالنسبة لأصحاب سندات الاستحقاق. تجتمع جماعة حاملي سندات المساهمة بقوة القانون مرة في السنة للاستماع إلى تقرير مسيري الشركة عن السنة المالية المنصرمة وتقرير مندوبي الحسابات حول حسابات السنة المالية والعناصر التي تستعمل لتحديد أجرة سندات المساهمة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_78> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_78_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_78_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_78_19750926_OpEnact_f3cd4badfc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_78_obligation_0_fec89461>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_78_obligation_1_1cdd261c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 78" ;
    dzdoc:position 852 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_99> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_99" ;
    dzdoc:fullText "يجب أن يكون حق التصويت المرتبط ب سندات الاستحقاق متناسبا مع قيمة مبلغ القرض الذي تمثله . يمنح كل سند استحقاق الحق في صوت واحد على الأقل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_99> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_99_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_99_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_99_19750926_OpEnact_6dce88702c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_99_obligation_0_c2d97b43> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 99" ;
    dzdoc:position 873 ;
    dzdoc:usesTerm dzterm:bondholders .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_bis> ;
    dzdoc:eId "art_715_ثالثا_5" ;
    dzdoc:fullText "يتمتع المسيرون في حالة تعددهم كل على حدة بالسلطات المذكورة في المادة السابقة . لا تشكل معارضة الأعمال التي يقوم بها مسير إزاء مسير آخر، أثرا على الغير، إلا إذا ثبت أنهم على علم بذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_5_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_5_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715___5_19750926_OpEnact_49817da94b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 ثالثا 5" ;
    dzdoc:position 912 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_4> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_5_condition_0_b2b12304> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_bis> ;
    dzdoc:eId "art_715_ثالثا_8" ;
    dzdoc:fullText "يقتضي تعديل القانون الأساسي موافقة كل الشركاء المتضامنين ولأغلبية ثلثي رأس مال الشركاء الموصين . يثبت المسيرون تعديل القانون الأساسي المترتب عن زيادة في رأس المال ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_8_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_8_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715___8_19750926_OpEnact_4bb248a3b4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_8_obligation_0_b62fc1ad> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 ثالثا 8" ;
    dzdoc:position 915 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_8_condition_0_e41d222f> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_732_bis_3" ;
    dzdoc:fullText "تلزم الشركات القابضة التي تلجأ علنيا للادخار و/أو المسعرة في البورصة، بإعداد الحسابات المدعمة ونشرها كما هو محدد في المادة 732 مكرر 4 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_732_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_732_bis_3_19750926_OpEnact_e13446432a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_3_obligation_0_3d6ad874> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "732 مكرر 3" ;
    dzdoc:position 938 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_4> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_4> ;
    dzdoc:usesTerm dzterm:holding_company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_747> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_747" ;
    dzdoc:fullText "يحدد مجلس الإدارة مشروع الإدماج أو الانفصال سواء لكل واحدة من الشركات المساهمة في الإدماج أو للشركة المقرر إدماجها . ويجب أن يتضمن البيانات التالية: أسباب الإدماج أو الانفصال وأهدافه وشروطه، تواريخ قفل حسابات الشركات المعنية، المستعملة لتحديد شروط العملية، تعيين وتقديم الأموال والديون المقرر نقلها للشركات المدمجة أو الجديدة، تقرير روابط مبادلة الحصص، المبلغ المحدد لقسط الإدماج أو الانفصال. يبين المشروع أو أي بيان ملحق به طرق التقديم المستعملة وأسباب خيار روابط مبادلة الحصص."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_747> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_747_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_747_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_747_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_747_19750926_OpEnact_1f0c139404> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_747_obligation_0_14483c9d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "747" ;
    dzdoc:position 954 ;
    dzdoc:usesTerm dzterm:board_of_directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_75> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:exemption_clause ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_4> ;
    dzdoc:eId "art_75" ;
    dzdoc:fullText "يعد كاشتراط بالإعفاء بالنسبة للمواد 52 و 65 و 66 و 71 و 72 الاشتراط الذي يضع بصفة مباشرة أو غير مباشرة التأمين الكلي أو الجزئي لمسؤولية الناقل أو الوكيل بالعمولة على عاتق المرسل أو المرسل إليه أو المسافر أو الموكل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_75> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_75_defocc_b05a4bb5ccf3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_75_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_75_19750926_OpEnact_cb99266bff> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "75" ;
    dzdoc:position 77 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_52>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_65>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_66>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_71>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_72> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_52>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_65>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_66>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_71>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_72> ;
