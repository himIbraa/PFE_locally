<https://legal.dz/resource/order/1975-09-26/75-59#version_art_638> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتولى رئيس مجلس الإدارة تحت مسؤوليته، الإدارة العامة للشركة ويمثل الشركة في علاقاتها مع الغير . يتمتع الرئيس بالسلطات الواسعة للتصرف باسم الشركة في كل الظروف مع مراعاة السلطات التي يخولها القانون صراحة لجمعيات المساهمين وكذا السلطات المخصصة بكيفية خاصة ل مجلس الإدارة وفي حدود موضوع الشركة. وفي علاقاتها مع الغير، تكون الشركة ملتزمة حتى بأعمال رئيس مجلس الإدارة غير التابعة لموضوع الشركة ما لم يثبت أن الغير كان يعلم أن العمل يتجاوز هذا الموضوع أو لا يمكنه تجاهله نظرا للظروف ، مع استبعاد كون نشر الق"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_638_19750926_OpEnact_8e13f793f7> ;
    dzdoc:replacementText "يتولى رئيس مجلس الإدارة تحت مسؤوليته، الإدارة العامة للشركة ويمثل الشركة في علاقاتها مع الغير . يتمتع الرئيس بالسلطات الواسعة للتصرف باسم الشركة في كل الظروف مع مراعاة السلطات التي يخولها القانون صراحة لجمعيات المساهمين وكذا السلطات المخصصة بكيفية خاصة ل مجلس الإدارة وفي حدود موضوع الشركة. وفي علاقاتها مع الغير، تكون الشركة ملتزمة حتى بأعمال رئيس مجلس الإدارة غير التابعة لموضوع الشركة ما لم يثبت أن الغير كان يعلم أن العمل يتجاوز هذا الموضوع أو لا يمكنه تجاهله نظرا للظروف ، مع استبعاد كون نشر القانون الأساسي يكفي وحده لتأسيس هذه البينة. لا يحتج على الغير بأحكام القانون الأساسي أو قرارات مجلس الإدارة المحددة لهذه السلطات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_638> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_638> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

