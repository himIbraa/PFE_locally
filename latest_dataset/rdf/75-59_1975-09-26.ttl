<https://legal.dz/resource/order/1975-09-26/75-59#version_art_453> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن الوفاء بطريق التدخل يجب إثباته بإبراء يدرج على السفتجة ويعين فيه الشخص الذي حصل الوفاء لمصلحته وإذا لم يعين هذا الشخص عد الوفاء حاصلا لمصلحة الساحب. يجب أن تسلم السفتجة و الاحتجاج إذا كان قد سبق تحريره إلى الموفي بطريق التدخل ."@ar ;
