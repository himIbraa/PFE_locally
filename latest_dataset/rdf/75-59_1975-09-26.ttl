<https://legal.dz/resource/order/1975-09-26/75-59#version_art_563> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة إفلاس أحد الشركاء أو منعه من ممارسة مهنته التجارية أو فقدان أهليته ، تنحل الشركة، ما لم ينص القانون الأساسي على استمرارها أو يقرر باقي الشركاء ذلك بإجماع الآراء . وفي حالة الاستمرار تعين حقوق الشريك الفاقد لهذه الصفة والواجب أداؤها له، طبقا للفقرة الأولى من المادة 559 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_19750926_OpEnact_9ea5aab6b6> ;
    dzdoc:replacementText "في حالة إفلاس أحد الشركاء أو منعه من ممارسة مهنته التجارية أو فقدان أهليته ، تنحل الشركة، ما لم ينص القانون الأساسي على استمرارها أو يقرر باقي الشركاء ذلك بإجماع الآراء . وفي حالة الاستمرار تعين حقوق الشريك الفاقد لهذه الصفة والواجب أداؤها له، طبقا للفقرة الأولى من المادة 559 ."@ar ;
