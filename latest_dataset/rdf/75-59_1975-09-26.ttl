<https://legal.dz/resource/order/1975-09-26/75-59#version_art_787> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يستدعي المصفي في ظرف ستة أشهر من تسميته جمعية الشركاء التي يقدم لها تقريرا عن أصول وخصوم الشركة وعن متابعة عمليات التصفية وعن الأجل الضروري لإتمامها. وفي حالة انعدام ذلك تستدعى الجمعية سواء من طرف هيئة المراقبة إن كانت أو من طرف وكيل معين بقرار قضائي بناء على طلب كل من يهمه الأمر. إذا تعذر انعقاد الجمعية أو لم يتخذ قرار ، فإن المصفي يطلب من القضاء الإذن اللازم للوصول إلى التصفية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_787_19750926_OpEnact_9d006f70a0> ;
    dzdoc:replacementText "يستدعي المصفي في ظرف ستة أشهر من تسميته جمعية الشركاء التي يقدم لها تقريرا عن أصول وخصوم الشركة وعن متابعة عمليات التصفية وعن الأجل الضروري لإتمامها. وفي حالة انعدام ذلك تستدعى الجمعية سواء من طرف هيئة المراقبة إن كانت أو من طرف وكيل معين بقرار قضائي بناء على طلب كل من يهمه الأمر. إذا تعذر انعقاد الجمعية أو لم يتخذ قرار ، فإن المصفي يطلب من القضاء الإذن اللازم للوصول إلى التصفية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_787> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
