<https://legal.dz/resource/order/1975-09-26/75-59#version_art_300> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "بناء على مقترحات وكيل التفليسة ، يأذن القاضي المنتدب إن وجد محلا لذلك وطبقا لبيان كشف الدائنين الممتازين المنصوص عليه في المادة 282 ، بالسداد لهؤلاء الدائنين من حصيلة أول إيرادات . وتقضي المحكمة إن وقعت منازعة في الامتياز."@ar ;
