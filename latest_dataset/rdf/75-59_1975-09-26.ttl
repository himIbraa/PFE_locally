<https://legal.dz/resource/order/1975-09-26/75-59#version_art_5> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للقاصر المرشد، ذكرا أم أنثى البالغ من العمر ثمانية عشر سنة كاملة والذي يريد مزاولة التجارة أن يبدأ في العمليات التجارية، كما لا يمكن اعتباره راشدا بالنسبة للتعهدات التي يبرمها عن أعمال تجارية : إذا لم يكن قد حصل مسبقا على إذن والده أو أمه أو على قرار من مجلس العائلة مصدق عليه من المحكمة، فيما إذا كان والده متوفيا أو غائبا أو سقطت عنه سلطته الأبوية أو استحال عليه مباشرتها أو في حالة انعدام الأب والأم . ويجب أن يقدم هذا الإذن الكتابي دعما لطلب التسجيل في السجل التجاري ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_5_19750926_OpEnact_24c8a35aa5> ;
    dzdoc:replacementText "لا يجوز للقاصر المرشد، ذكرا أم أنثى البالغ من العمر ثمانية عشر سنة كاملة والذي يريد مزاولة التجارة أن يبدأ في العمليات التجارية، كما لا يمكن اعتباره راشدا بالنسبة للتعهدات التي يبرمها عن أعمال تجارية : إذا لم يكن قد حصل مسبقا على إذن والده أو أمه أو على قرار من مجلس العائلة مصدق عليه من المحكمة، فيما إذا كان والده متوفيا أو غائبا أو سقطت عنه سلطته الأبوية أو استحال عليه مباشرتها أو في حالة انعدام الأب والأم . ويجب أن يقدم هذا الإذن الكتابي دعما لطلب التسجيل في السجل التجاري ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
