    dzdoc:position 0 ;
    dzdoc:text "إن المظهر ضامن للوفاء ما لم يشترط خلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_490_para_1> a dzdoc:Paragraph ;
