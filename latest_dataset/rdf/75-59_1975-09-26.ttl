<https://legal.dz/resource/order/1975-09-26/75-59#version_art_485> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن الشيك المشترط دفعه إلى شخص مسمى بموجب اشتراط صريح \" للأمر\" أو بدونه يكون قابلا للتداول بطريق التظهير . أما الشيك المشترط دفعه إلى شخص مسمى مع شرط \" ليس لأمر\" أو شرط مماثل لا يكون قابلا للتداول إلا حسب الأوضاع المقررة للإحالة العادية وبما يترتب عليها من النتائج."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
