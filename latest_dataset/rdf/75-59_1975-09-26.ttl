    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "نشر البيانات التي تدرج بسجل التجارة، طبقا للفقرة الأولى من هذه المادة، في النشرة الرسمية للإعلانات القانونية خلال خمسة عشر يوما من النطق بالحكم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_228> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_228_obligation_4_a8f79a1e_ref_ce1336d16af2> a dzdoc:Reference ;
    rdfs:label "هذه المادة"@ar ;
    dzdoc:frbrUri "#art_228"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1975-09-26/75-59#art_228> ;
    dzdoc:sourceEId "art_228" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "نشر البيانات التي تدرج بسجل التجارة، طبقا للفقرة الأولى من هذه المادة، في النشرة الرسمية للإعلانات القانونية خلال خمسة عشر يوما من النطق بالحكم"@ar ;
    dzdoc:targetEId "art_228" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_228_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_228> ;
    dzdoc:position 0 ;
    dzdoc:text "تسجل الأحكام الصادرة بالتسوية القضائية أو بشهر الإفلاس في السجل التجاري ويجب إعلانها لمدة ثلاثة أشهر بقاعة جلسات المحكمة وأن ينشر ملخصها في النشرة الرسمية للإعلانات القانونية للمكان الذي يقع فيه مقر المحكمة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_228_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_228> ;
    dzdoc:position 1 ;
    dzdoc:text "ويتعين أن يجري النشر نفسه في الأماكن التي يكون فيها للمدين مؤسسات تجارية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_228_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_228> ;
    dzdoc:position 2 ;
    dzdoc:text "ويجري نشر البيانات التي تدرج بسجل التجارة، طبقا للفقرة الأولى من هذه المادة، في النشرة الرسمية للإعلانات القانونية خلال خمسة عشر يوما من النطق بالحكم. ويتضمن هذا النشر بيان اسم المدين وموطنه أو مركزه الرئيسي ورقم قيده بسجل التجارة وتاريخ الحكم الذي قضى بالتسوية القضائية أو شهر الإفلاس ورقم عدد صحيفة الإعلانات القانونية التي نشر فيها الملخص المشار إليه في الفقرة الأولى."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_228_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_228> ;
    dzdoc:position 3 ;
    dzdoc:text "ويتم النشر المذكور أعلاه تلقائيا من طرف كاتب الضبط."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_229_condition_0_be7f63c4> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_229_condition_0_be7f63c4_role_4f6738846b> ;
    dznorm:conditionText "عندما لا تكون الأموال الخاصة بالتفليسة كافية على الفور لتغطية مصاريف التسوية القضائية أو شهر الإفلاس ولإعلان ونشر هذا الحكم في الصحف واللصق ووضع الأختام ورفعها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_229> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_229_condition_0_be7f63c4_role_4f6738846b> a dznorm:Role ;
    rdfs:label "الفور لتغطية مصاريف التسوية"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "عندما لا تكون الأموال الخاصة بالتفليسة كافية على الفور لتغطية مصاريف التسوية القضائية أو شهر الإفلاس ولإعلان ونشر هذا الحكم في الصحف واللصق ووضع الأختام ورفعها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_229> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_229_condition_1_18d84444> a dznorm:Condition ;
    dznorm:conditionText "إذا كان هو الذي رفع الدعوى لدى المحكمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_229> ;
