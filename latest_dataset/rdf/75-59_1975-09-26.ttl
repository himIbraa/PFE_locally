<https://legal.dz/resource/order/1975-09-26/75-59#version_art_732_bis_4> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقصد بالحسابات المدعمة، تقديم الوضعية المالية ونتائج مجموعة الشركات وكأنها تشكل نفس الوحدة . وتخضع لنفس قواعد التقديم والمراقبة والمصادقة والنشر التي تخضع لها الحسابات السنوية الفردية. تحدد كيفيات تطبيق هذه المادة، عند الاقتضاء، عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_732_bis_4_19750926_OpEnact_15b2982d8a> ;
    dzdoc:replacementText "يقصد بالحسابات المدعمة، تقديم الوضعية المالية ونتائج مجموعة الشركات وكأنها تشكل نفس الوحدة . وتخضع لنفس قواعد التقديم والمراقبة والمصادقة والنشر التي تخضع لها الحسابات السنوية الفردية. تحدد كيفيات تطبيق هذه المادة، عند الاقتضاء، عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_4> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
