<https://legal.dz/resource/order/1975-09-26/75-59#version_art_262> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "اعتبارا من الحكم القاضي ب التسوية القضائية أو شهر الإفلاس لشخص معنوي، لا يجوز للمديرين بحكم القانون أو الواقع أن يحولوا الحصص أو الأسهم التي تتكون منها حقوقهم في الشركة إلا بإذن القاضي المنتدب . و تقضي المحكمة بعدم قبول حوالة الأسهم والحصص في الشركة والتي يملكها كل شخص تدخل في إدارة أموال شخص معنوي مهما كان الزمن الذي ثبت فيه هذا التدخل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_262_19750926_OpEnact_368eb985f9> ;
    dzdoc:replacementText "اعتبارا من الحكم القاضي ب التسوية القضائية أو شهر الإفلاس لشخص معنوي، لا يجوز للمديرين بحكم القانون أو الواقع أن يحولوا الحصص أو الأسهم التي تتكون منها حقوقهم في الشركة إلا بإذن القاضي المنتدب . و تقضي المحكمة بعدم قبول حوالة الأسهم والحصص في الشركة والتي يملكها كل شخص تدخل في إدارة أموال شخص معنوي مهما كان الزمن الذي ثبت فيه هذا التدخل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_262> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
