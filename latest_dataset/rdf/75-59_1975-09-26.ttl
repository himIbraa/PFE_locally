    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "وجب تبليغ الرفض بناء على إجراء كتابة ضبط لموطن القائم بالإصدار ضمن عشرين يوما من تاريخ الإصدار"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_428> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_428_obligation_3_0813a1b9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_428_obligation_3_0813a1b9_ref_e4b40aec7395> ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_428_obligation_3_0813a1b9_ref_e4b40aec7395> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_428> ;
    dznorm:position 3 ;
    dznorm:provisionText "يمدد هذا الأجل لغاية اليوم الأول التالي لانتهاء هذا الأجل طبقا لمقتضيات المادة 464 وما يليها من قانون الإجراءات المدنية"@ar ;
    dznorm:sourceArticle "art_428" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_428_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_428> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا رضي الحامل في مقابل الوفاء أن يقبل إما شيكا عاديا وإما أمرا بالحوالة على البنك المركزي الجزائري وإما شيكا بريديا، وجب أن يذكر في الشيك أو الحوالة عدد السندات المدفوعة على الشكل المذكور وتاريخ استحقاقها، بيد أن هذا البيان لا يكون واجبا بالنسبة للشيكات أو أوامر الحوالة المنشأة للتسوية بين المصاريف فيما يخص رصيد العمليات المتممة فيما بينها بواسطة غرفة المقاصة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_428_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_428> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا وقعت التسوية بمقتضى شيك عاد ولم يقع أداؤه، فإنه يقع الاحتجاج لعدم وفاء هذا الشيك في موطن وفاء السفتجة في الأجل المنصوص عليه في المادة 516. ويقع الاحتجاج لعدم وفاء الشيك وكذلك التبليغ بموجب إجراء واحد من كتابة الضبط إلا في حالة وجود دواع تتعلق بالاختصاص المحلي واقتضاء تدخل كتابتي ضبط."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_428_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_428> ;
    dzdoc:position 2 ;
    dzdoc:text "وإذا حصلت التسوية بواسطة أمر بالحوالة ورفضها البنك المركزي الجزائري أو بواسطة صك بريدي رفضه مركز الصكوك البريدية هو الآخر الحائز لحساب من سيقيد عليه، وجب تبليغ الرفض بناء على إجراء كتابة ضبط لموطن القائم بالإصدار ضمن عشرين يوما من تاريخ الإصدار، ويقوم كاتب الضبط بإعداد هذا الإجراء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_428_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_428> ;
    dzdoc:position 3 ;
    dzdoc:text "وإذا كان اليوم الأخير الممنوح لاستكمال إجراء تبليغ بعدم تنفيذ أمر الحوالة أو الشيك البريدي هو يوم عطلة يمدد هذا الأجل لغاية اليوم الأول التالي لانتهاء هذا الأجل طبقا لمقتضيات المادة 464 وما يليها من قانون الإجراءات المدنية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_429_condition_0_67fc3710> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يرد المسحوب عليه السفتجة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_429> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_429_extref_02fdd0c2> a dzdoc:ExternalReference ;
    rdfs:label "المادة 376 من قانون العقوبات"@ar ;
