<https://legal.dz/resource/order/1975-09-26/75-59#version_art_697> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للجمعية العامة، التي تقرر زيادة رأس المال أن تلغي حق التفاضل في الاكتتاب. وتفصل تحت طائلة بطلان المداولة بهذا الشأن، بناء على تقرير مجلس الإدارة أو مجلس المديرين ، حسب الحالة، وتقرير مجلس مندوبي الحسابات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_697_19750926_OpEnact_67ddadde8a> ;
    dzdoc:replacementText "يجوز للجمعية العامة، التي تقرر زيادة رأس المال أن تلغي حق التفاضل في الاكتتاب. وتفصل تحت طائلة بطلان المداولة بهذا الشأن، بناء على تقرير مجلس الإدارة أو مجلس المديرين ، حسب الحالة، وتقرير مجلس مندوبي الحسابات."@ar ;
