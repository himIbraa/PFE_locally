<https://legal.dz/resource/order/1975-09-26/75-59#version_art_240> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للقاضي المنتدب أن يعين في أي وقت بأمر يصدره، مراقبا أو أثنين من بين الدائنين . ولا يجوز أن يعين مراقبا أو ممثلا لشخص معنوي معين كمراقب، أي قريب أو نسيب للمدين لغاية الدرجة الرابعة ."@ar ;
