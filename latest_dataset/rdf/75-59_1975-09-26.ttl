<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_38> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحول السند للحامل عن طريق مجرد تسليم أو بواسطة قيد في الحسابات. ويحول السند الاسمي إزاء الغير وإزاء الشخص المعنوي المصدر عن طريق نقله في السجلات التي تمسكها الشركة لهذا الغرض. وتحدد الشروط التي تمسك وفقها هذه السجلات عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_38_19750926_OpEnact_689f6981ee> ;
    dzdoc:replacementText "يحول السند للحامل عن طريق مجرد تسليم أو بواسطة قيد في الحسابات. ويحول السند الاسمي إزاء الغير وإزاء الشخص المعنوي المصدر عن طريق نقله في السجلات التي تمسكها الشركة لهذا الغرض. وتحدد الشروط التي تمسك وفقها هذه السجلات عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_38> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_38> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_39> a dzdoc:AmendmentEvent,
