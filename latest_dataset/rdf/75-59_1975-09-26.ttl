<https://legal.dz/resource/order/1975-09-26/75-59#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:commercial_act_by_accessory ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_1> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "يعد عملا تجاريا بالتبعية : الأعمال التي يقوم بها التاجر والمتعلقة بممارسة تجارته أو حاجات متجره، الالتزامات بين التجار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_4> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_4_defocc_0271da9225f7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_4_19750926_OpEnact_d8282b02b1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "4" ;
    dzdoc:position 4 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_419> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_7> ;
    dzdoc:eId "art_419" ;
    dzdoc:fullText "لا تقبل المعارضة في الوفاء إلا في حالة ضياع السفتجة أو إفلاس حاملها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_419> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_419_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_419_19750926_OpEnact_a7dc786dc8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "419" ;
    dzdoc:position 424 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_419_condition_0_c3af1fb3> ;
    dzdoc:usesTerm dzterm:bill_of_exchange .

<https://legal.dz/resource/order/1975-09-26/75-59#art_467> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_2> ;
    dzdoc:eId "art_467" ;
    dzdoc:fullText "تطبق على السند لأمر الأحكام المتعلقة بـ السفتجة فيما لا يتعارض مع طبيعته وذلك في الأحوال الآتية : التظهير \" المادة من 396 إلى 402 \"، الاستحقاق \" المادة من 410 إلى 413 \"، الوفاء \" المادة من 414 إلى 425 \"، الرجوع لعدم الوفاء \" المادة من 426 إلى 435 و المادة 437 و 438 و 439 و 440 \"، الاحتجاجات \" المادة من 441 إلى 444 \"، سند الرجوع \" المادة من 445 إلى 447 \"، الوفاء بطريق التدخل \" المادة من 448 و 450 إلى 454 \"، النسخ \" المادة 458 و المادة 459 \"، التحريف \" المادة 460 \"، التقادم \" المادة 461 \". أيام الأعياد الرسمية وأيام العمل المشبهة بها وحساب الآجال ومنح أجال الإمهال طبقا لأحكام \" المواد 464 و 463 و 462 \""@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_467> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_467_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_467_para_1> ;
