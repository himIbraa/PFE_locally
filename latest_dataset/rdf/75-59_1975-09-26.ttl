<https://legal.dz/resource/order/1975-09-26/75-59#version_art_220> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز طلب شهر الإفلاس أو التسوية القضائية في أجل عام من شطب المدين من سجل التجارة إن كان التوقف عن الدفع سابقا لهذا الشطب . ويجوز طلب شهر الإفلاس أو التسوية القضائية لشريك متضامن في أجل عام من قيد انسحابه في سجل التجارة إذا كان التوقف عن الدفع سابقا لهذا القيد ."@ar ;
