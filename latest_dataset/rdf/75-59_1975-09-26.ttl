    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_62_19750926_OpEnact_8e5a0c1c39> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 62" ;
    dzdoc:position 836 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_63> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:voting_right_certificates ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_3> ;
    dzdoc:eId "art_715_bis_63" ;
    dzdoc:fullText "تمثل شهادات الحق في التصويت حقوقا أخرى غير الحقوق المالية المرتبطة بالأسهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_63> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_63_defocc_f45b6717bd14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_63_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_63_19750926_OpEnact_2bdcea7e25> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 63" ;
    dzdoc:position 837 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_4> ;
    dzdoc:eId "art_715_bis_77" ;
    dzdoc:fullText "يرخص بإصدار سندات المساهمة وتعويضها حسب الشروط المنصوص عليها في المواد من 715 مكرر 84 إلى 715 مكرر 87 ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_77_permission_0_08203e09> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_77_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_77_19750926_OpEnact_76a830f5fd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 77" ;
    dzdoc:position 851 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_84>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_87> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_84>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_87> ;
    dzdoc:usesTerm dzterm:participation_bonds .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_81> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:سندات_الاستحقاق ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_81" ;
    dzdoc:fullText "سندات الاستحقاق هي سندات قابلة للتداول، تخول بالنسبة للإصدار الواحد نفس حقوق الدين بالنسبة لنفس القيمة الاسمية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_81> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_81_defocc_83a2fdaa3380> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_81_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_81_19750926_OpEnact_4e299b21cf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 81" ;
    dzdoc:position 855 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_89> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_89" ;
    dzdoc:fullText "يمثل جماعة أصحاب سندات الاستحقاق وكيل أو عدة وكلاء، يعينون في الجمعية العامة غير العادية. تحدد الشروط التي يجب أن يستوفيها وكلاء سندات الاستحقاق وكذا حقوقهم وقوانينهم الأساسية عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_89> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_89_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_89_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_89_19750926_OpEnact_16f5da20de> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 89" ;
    dzdoc:position 863 ;
    dzdoc:usesTerm dzterm:سندات_الاستحقاق .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_bis> ;
    dzdoc:eId "art_715_ثالثا_10" ;
    dzdoc:fullText "تقرر الجمعية العامة غير العادية بموافقة أغلبية الشركاء المتضامنين، تحويل شركة التوصية بالأسهم إلى شركة مساهمة أو شركة ذات مسؤولية محدودة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_10_right_0_9a0044f5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا_10_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715___10_19750926_OpEnact_03eec0d348> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 ثالثا 10" ;
    dzdoc:position 917 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_720> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:net_profits ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_720" ;
    dzdoc:fullText "تشكل الأرباح الصافية من الناتج الصافي من السنة المالية بعد طرح المصاريف العامة وتكاليف الشركة الأخرى بإدراج جميع الاستهلاكات والمؤونات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_720> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_720_defocc_47d7e04edcdd> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_720_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_720_19750926_OpEnact_090ef1d889> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "720" ;
    dzdoc:position 922 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_733> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_733" ;
    dzdoc:fullText "لا يحصل بطلان شركة أو عقد معدل للقانون الأساسي إلا بنص صريح في هذا القانون أو القانون الذي يسرى على بطلان العقود. وفيما يتعلق بـ الشركات ذات المسؤولية المحدودة أو الشركات المساهمة ، فإن البطلان لا يحصل من عيب في القبول ولا من فقد الأهلية ما لم يشمل هذا الفقد كافة الشركاء المؤسسين. كما أن هذا البطلان لا يحصل من بطلان الشروط المحظورة بالفقرة الأولى من المادة 426 من القانون المدني . لا يحصل بطلان العقود أو المداولات غير التي نصت عليها الفقرة المتقدمة إلا من مخالفة نص ملزم من هذا القانون أو من القوانين التي تسري على العقود."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_733> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_733_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_733_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_733_19750926_OpEnact_3da89e94e8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "733" ;
    dzdoc:position 940 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_733_extref_2b07af3b> ;
    dzdoc:usesTerm dzterm:joint_stock_companies,
        dzterm:limited_liability_companies .

<https://legal.dz/resource/order/1975-09-26/75-59#art_735> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_735" ;
    dzdoc:fullText "تنقضي دعوى البطلان إذا انقطع سبب البطلان في اليوم الذي تتولى فيه المحكمة النظر في الأصل ابتدائيا ، إلا إذا كان هذا البطلان مبنيا على عدم قانونية موضوع الشركة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_735> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_735_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_735_19750926_OpEnact_6b3244169f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "735" ;
    dzdoc:position 942 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_735_condition_0_0eccfdca> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_741> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_741" ;
    dzdoc:fullText "يشرع في تصفية الشركة متى قضي ببطلانها طبقا لأحكام القانون الأساسي والقسم الخامس من هذا الفصل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_741> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_741_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_741_19750926_OpEnact_384ed88fbc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_741_obligation_0_4eb4eeb3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 741" ;
    dzdoc:position 948 ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_775> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_775" ;
    dzdoc:fullText "ينشر إعلان إقفال التصفية الموقع عليه من المصفي، بطلب منه في النشرة الرسمية للإعلانات القانونية أو في جريدة معتمدة بتلقي الإعلانات القانونية ويتضمن هذا الإعلان البيانات التالية : 1- العنوان أو التسمية التجارية متبوعة عند الاقتضاء بمختصر اسم الشركة، 2- نوع الشركة متبوع ببيان \" في حالة التصفية \"، 3- مبلغ رأس مالها، 4- عنوان المقر الرئيسي، 5 أرقام قيد الشركة في السجل التجاري، 6- أسماء المصفين وألقابهم وموطنهم، 7- تاريخ ومحل انعقاد الجمعية المكلفة بالإقفال إذا كانت هي التي وافقت على حسابات المصفين أو عند عدم ذلك، تاريخ الحكم القضائي المنصوص عليه في المادة المتقدمة وكذلك بيان المحكمة التي أصدرت الحكم، 8- ذكر كتابة المحكمة التي أودعت فيها حسابات المصفين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_775> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_775_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_775_19750926_OpEnact_488d02fcee> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_775_obligation_0_2ad38a39> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "775" ;
    dzdoc:position 982 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_774> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_774> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_779> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_779" ;
    dzdoc:fullText "تنتهي سلطات مجلس الإدارة أو المسيرين اعتبارا من تاريخ الأمر المستعجل المتخذ طبقا ل المادة المتقدمة أو من تاريخ انحلال الشركة إن كان لاحقا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_779> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_779_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_779_19750926_OpEnact_c04dc31bd3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_779_obligation_0_9f5e5613> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "779" ;
    dzdoc:position 986 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_778> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_778> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_793> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_793" ;
    dzdoc:fullText "تتم قسمة المال الصافي المتبقي بعد سداد الأسهم الاسمية أو حصص الشركة بين الشركاء بنفس نسبة مساهمتهم في رأس مال الشركة وذلك باستثناء الشروط المخالفة للقانون الأساسي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_793> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_793_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_793_19750926_OpEnact_f542f4efd0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_793_obligation_0_5a7814e8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "793" ;
    dzdoc:position 1000 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_5> ;
    dzdoc:eId "art_799_bis" ;
    dzdoc:fullText "يتمتع التجمع بالشخصية المعنوية وبالأهلية التامة ابتداء من تاريخ تسجيله في السجل التجاري . ويحدد العقد الخاضع للإشهار القانوني، شروط التجمع وموضوعه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis_right_0_f7ffad6e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_799_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_799_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_799_bis_19750926_OpEnact_cc729194ee> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 799 مكرر" ;
    dzdoc:position 1012 ;
    dzdoc:usesTerm dzterm:السجل_التجاري .

<https://legal.dz/resource/order/1975-09-26/75-59#art_80> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_80" ;
    dzdoc:fullText "يكون البائع ملزما بضمان ما ينشأ عن بياناته غير الصحيحة حسب الشروط المقررة في المادتين 376 و 379 من القانون المدني بالرغم من كل شرط مخالف في العقد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_80> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_80_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_80_19750926_OpEnact_9dd853b4a9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_80_obligation_0_2111f0e6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "80" ;
    dzdoc:position 82 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_80_extref_4f8ad691>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_80_extref_93f18756> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_802> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_1> ;
    dzdoc:eId "art_802" ;
    dzdoc:fullText "يعاقب بالحبس من شهر واحد إلى ثلاثة أشهر وبغرامة من 20.000 دج إلى 200.000 دج، أو بإحدى هاتين العقوبتين فقط ، المديرون الذين لم يعملوا على انعقاد جمعية الشركاء في أجل ستة (6) أشهر من تاريخ اختتام السنة المالية أو في حالة تمديد الأجل المحدد بمدة لا تتجاوز الستة (6) أشهر، بقرار قضائي أو لم يعرضوا تلك المستندات المنصوص عليها في المادة 801 أولا على تلك الجمعية للموافقة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_802> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_802_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_802_19750926_OpEnact_8a7be75dc6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_802_obligation_0_23b66c48> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "802" ;
    dzdoc:position 1019 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_801> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_801> ;
    dzdoc:usesTerm dzterm:manager .

<https://legal.dz/resource/order/1975-09-26/75-59#art_809> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_809" ;
    dzdoc:fullText "يعاقب بالعقوبات المنصوص عليها في المادة 808 كل شخص تعمد الاشتراك في المعاملات أو قام بوضع قيم للأسهم أو قدم وعودا بالأسهم المشار إليها في المادة السابقة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_809> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_809_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_809_19750926_OpEnact_5adbefc35a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_809_obligation_0_e793808b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "809" ;
    dzdoc:position 1026 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_808> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_808> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_813> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_813" ;
    dzdoc:fullText "يعاقب بالغرامة من 20.000 دج إلى 200.000 دج الرئيس و القائمون بالإدارة أو المديرون العامون للشركة المساهمة والذين: يتخلفون في كل سنة مالية عن وضع حساب الاستغلال العام وحساب النتائج والجرد والميزانية والتقرير الكتابي عن حالة الشركة ونشاطها أثناء السنة المنصرمة، يتخلفون في إعداد هاته المستندات عن استعمال نفس الأشكال وطرق التقدير المتبعة في السنين السابقة وذلك مع مراعاة التعديلات المقدمة طبقا ل المادة 548 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_813> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_813_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_813_19750926_OpEnact_e724cb154a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_813_obligation_0_935c757d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "813" ;
    dzdoc:position 1030 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_548> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_548> ;
    dzdoc:usesTerm dzterm:chairman,
        dzterm:directors,
        dzterm:general_managers .

<https://legal.dz/resource/order/1975-09-26/75-59#art_819> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_3> ;
    dzdoc:eId "art_819" ;
    dzdoc:fullText """يعاقب بغرامة من 20.000 دج إلى 200.000 دج رئيس شركة المساهمة والقائمون بإدارتها أو مديروها العامون الذين لم يضعوا تحت تصرف كل مساهم بمركز الشركة أو بمديرية إدارتها : 1- السندات الآتي ذكرها في أجل خمسة عشر يوما السابقة لانعقاد الجمعية العامة العادية السنوية وهي:
                أ) الجرد وحساب الاستغلال العام وحساب النتائج والميزانية وقائمة القائمين بالإدارة،
                ب) تقارير مجلس الإدارة ومندوبي الحسابات التي تعرض على الجمعية،
                ج) نص وبيان الأسباب المتعلقة بالقرارات المقترحة وكذا المعلومات الخاصة بالمرشحين لمجلس الإدارة عند الاقتضاء،
                د) المبلغ الإجمالي المصادق عليه من طرف مندوبي الحسابات والأجور المدفوعة للأشخاص الذين يتلقون أعلى الأجور باعتبار أن عدد الأشخاص يتغير بين 10 أو 5 حسب عدد العاملين الذي يتجاوز أو يقل عن مائتين من ذوي الأجور. 2 - نص القرارات المقترحة وتقرير مجلس الإدارة وعند الاقتضاء تقرير مندوبي الحسابات ومشروع الإدماج وذلك في أجل خمسة عشر يوما السابقة لانعقاد الجمعية العامة غير العادية، 3- قائمة المساهمين المحددة في اليوم السادس عشر السابق لذلك الاجتماع والمتضمنة أسماء وألقاب وموطن كل صاحب أسهم مقيد في ذلك التاريخ في سجل الشركة وكذا عدد الأسهم التي يملكها كل مساهم وذلك قبل خمسة عشر يوما من انعقاد الجمعية العامة، 4- السندات الآتي ذكرها الخاصة بالسنوات المالية الثلاث الأخيرة والمقدمة للجمعية العامة وهي: حساب الاستغلال العام والجرد وحسابات النتائج والميزانيات وتقارير مجلس الإدارة وتقارير مندوبي الحسابات وأوراق الحضور ومحاضر الجمعيات وذلك في أي وقت من السنة."""@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_819> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_819_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_819_19750926_OpEnact_f377f879d6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_819_obligation_0_5a1bb523> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "819" ;
    dzdoc:position 1036 ;
    dzdoc:usesTerm dzterm:chairman .

<https://legal.dz/resource/order/1975-09-26/75-59#art_821> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_3> ;
    dzdoc:eId "art_821" ;
    dzdoc:fullText "يعاقب بالغرامة المنصوص عليها في المادة السابقة رئيس الجلسة وأعضاء مكتب الجمعية الذين لم يحترموا أثناء اجتماع جمعية المساهمين الأحكام المتعلقة بحقوق التصويت والملحقة بالأسهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_821> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_821_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_821_19750926_OpEnact_f08fa050b6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_821_obligation_0_3fd6df83> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "821" ;
    dzdoc:position 1038 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_820> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_820> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_822> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_822" ;
    dzdoc:fullText "يعاقب بغرامة من 20.000 دج إلى 200.000 دج رئيس شركة المساهمة و القائمون بإدارتها الذين أصدروا وقت زيادة رأس المال أسهما: أ) إما قبل تعديل القانون الأساسي الناتج عن تلك الزيادة في رأس المال قد وقع تسجيل معدل في السجل التجاري، ب) إذا وقع تسجيل هذا التعديل عن طريق التدليس في أي زمن كان، ج) وإما قبل أن تنتهي بصفة منتظمة إجراءات تكوين هذه الشركة أو زيادة رأسمالها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_822> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_822_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_822_19750926_OpEnact_1362217a67> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_822_obligation_0_2601fe38> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "822" ;
    dzdoc:position 1039 ;
    dzdoc:usesTerm dzterm:chairman,
        dzterm:directors .

<https://legal.dz/resource/order/1975-09-26/75-59#art_824> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_824" ;
    dzdoc:fullText "يعاقب بالسجن من سنة واحدة إلى خمس سنوات وبغرامة من 20.000 دج إلى 2.500.000 دج الأشخاص الذين ارتكبوا المخالفات المنصوص عليها في المادة السابقة قصد حرمان المساهمين أو البعض منهم من حصة واحدة من حقهم في مال الشركة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_824> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_824_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_824_19750926_OpEnact_65d745a820> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_824_obligation_0_e9ab9802> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "824" ;
    dzdoc:position 1041 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_823> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_823> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_837> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_837" ;
    dzdoc:fullText "يعاقب بالحبس من ستة أشهر إلى سنتين وبغرامة من 20.000 دج إلى 200.000 دج أو بإحدى هاتين العقوبتين فقط ، رؤساء كل شركة و القائمون بإدارتها و مديروها العامون الذين يتعمدون: عدم الإشارة في التقرير السنوي المقدم للشركاء عن عمليات النشاط إلى حيازتهم ضمن شركة لها مركزها بتراب الجمهورية الجزائرية وإلى امتلاك نصف رأسمال الحسابات الذين لم يشيروا في تقريرهم لنفس هذه الشركة، وتسري نفس العقوبات على مندوبي البيانات ، عدم بيان نشاط الشركات التابعة للشركة في تقريرهم بحسب كل فرع من النشاط . وعدم إظهار النتائج المحصل عليها، عدم إلحاق الجدول المنصوص عليه في المادة 558 في ميزانية الشركة والمتضمن المعلومات التي يراد بها إظهار حالة الشركات التابعة والمساهمات. يكونون قد تحصلوا على مساهمات في شركة مخالفين بذلك أحكام المادة 731 من هذا القانون، لم يعدوا أو لم يقدموا و / أو لم ينشروا الحسابات المدعمة كما هو محدد في المادة 732 مكرر 3 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_837> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_837_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_837_19750926_OpEnact_973e0263bf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_837_obligation_0_dac56d2b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "837" ;
    dzdoc:position 1054 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_558>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_731>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_3> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_558>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_731>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_732_bis_3> ;
    dzdoc:usesTerm dzterm:administrators,
        dzterm:auditors,
        dzterm:general_managers,
        dzterm:heads_of_company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_840> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_840" ;
    dzdoc:fullText "يعاقب بالسجن من سنة واحدة إلى خمس سنوات وبغرامة من 20.000 دج إلى 200.000 دج أو بإحدى هاتين العقوبتين فقط ، المصفي الذي يقوم عن سوء نية: 1- باستعمال أموال أو ائتمان الشركة التي تجري تصفيتها وهو يعلم أنه مخالف لمصالح الشركة تلبية لأغراض شخصية أو لتفضيل شركة أخرى أو مؤسسة له فيها مصالح مباشرة أو غير مباشرة، 2- بالتخلي عن كل أو جزء من مال الشركة التي تجري تصفيتها خلافا لأحكام المادتين 770 و 771 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_840> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_840_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_840_19750926_OpEnact_7ceb23f003> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_840_obligation_0_a6f24f81> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
