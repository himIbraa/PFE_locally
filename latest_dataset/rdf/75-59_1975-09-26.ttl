<https://legal.dz/resource/order/1975-09-26/75-59#version_art_535> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يتجدد الدين بقبول دائن تسلم شيكا وفاء لدينه. ويترتب على ذلك أن الدين الأصلي يبقى قائما بكل ما له من ضمانات إلى أن يتم وفاء قيمة هذا الشيك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_535_19750926_OpEnact_c8a48f7eb9> ;
    dzdoc:replacementText "لا يتجدد الدين بقبول دائن تسلم شيكا وفاء لدينه. ويترتب على ذلك أن الدين الأصلي يبقى قائما بكل ما له من ضمانات إلى أن يتم وفاء قيمة هذا الشيك ."@ar ;
