<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_70> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة زيادة نقدية في رأس المال ، تصدر شهادات استثمار جديدة بعدد يحافظ فيه على التناسب الذي كان قائما قبل الزيادة بين الأسهم العادية وشهادات الاستثمار بعد الزيادة التي يفترض تحققها كاملا. لمالكي شهادات الاستثمار ، حق الأفضلية في الاكتتاب بما يتناسب وعدد السندات التي يمتلكونها، بصفة غير قابلة للتخفيض في شهادات الاستثمار الجديدة ، و يجوز لمالكي شهادات الاستثمار التنازل عن هذا الحق ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_70_19750926_OpEnact_0ff83d1fba> ;
    dzdoc:replacementText "في حالة زيادة نقدية في رأس المال ، تصدر شهادات استثمار جديدة بعدد يحافظ فيه على التناسب الذي كان قائما قبل الزيادة بين الأسهم العادية وشهادات الاستثمار بعد الزيادة التي يفترض تحققها كاملا. لمالكي شهادات الاستثمار ، حق الأفضلية في الاكتتاب بما يتناسب وعدد السندات التي يمتلكونها، بصفة غير قابلة للتخفيض في شهادات الاستثمار الجديدة ، و يجوز لمالكي شهادات الاستثمار التنازل عن هذا الحق ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_70> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
