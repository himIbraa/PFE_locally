<https://legal.dz/resource/order/1975-09-26/75-59#version_art_493> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا زالت يد شخص عن الشيك للأمر من شخص بأي حادث من الحوادث فلا يلزم المستفيد الذي يثبت أنه صاحب الحق فيه على الكيفية المبينة في المادة 491 بالتخلي عنه إلا إذا كان قد اكتسبه عن سوء نية أو كان قد ارتكب خطأ جسيما عند اكتسابه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_493_19750926_OpEnact_9660376fc8> ;
