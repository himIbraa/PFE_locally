    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_81_defocc_83a2fdaa3380> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:merchant ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_1> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "يعد تاجرا كل شخص طبيعي أو معنوي يباشر عملا تجاريا ويتخذه مهنة معتادة له ، ما لم يقض القانون بخلاف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_1> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_1_defocc_09659babb66f> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_1_19750926_OpEnact_7d719c1ee5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة الأولى" ;
    dzdoc:position 0 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_1_condition_0_e6b77528> ;
    dzdoc:usesTerm dzterm:merchant .

<https://legal.dz/resource/order/1975-09-26/75-59#art_115> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_115" ;
    dzdoc:fullText "كل فسخ قضائي أو صلحي للبيع ينشر من الطرف الذي حصل عليه، وذلك حسب الشروط المقررة للبيع نفسه خلال الخمسة عشر يوما التي تلي التاريخ الذي يصبح فيه الفسخ نهائيا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_115> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_115_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_115_19750926_OpEnact_b8557b1993> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_115_obligation_0_e442ff4b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "115" ;
    dzdoc:position 117 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_136> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_136" ;
    dzdoc:fullText "على المزايد بالزيادة أن يتمم الإجراءات والبيع وإذا لم يفعل فيحق القيام بذلك لكل دائن مقيد أو مشتر، على نفقة ومسؤولية وتبعة المزايد بالزيادة ويبقى ضمانه ساريا على حسب القواعد المقررة في المادة 125 الفقرات من 5 إلى 8 والمواد 126 و 127 و 130 الفقرة 3 أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_136> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_136_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_136_19750926_OpEnact_8923b3198b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_136_obligation_0_ee8e185f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 136" ;
    dzdoc:position 138 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_125>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_126>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_127>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_130> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_125>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_126>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_127>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_130> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_144> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_5> ;
    dzdoc:eId "art_144" ;
    dzdoc:fullText "يثبت إيداع عقد البيع أو الرهن الحيازي للمحل التجاري المنصوص عليه في المادتين 98 و 99 في دفتر خاص من طرف - مأموري السجل التجاري . يقسم هذا الدفتر إلى عمودين : يشتمل العمود الأول على رقم ترتيبي للدفتر، ويسجل في العمود الثاني محضر الإيداع يتضمن تاريخ الإيداع، وبيان تاريخ وكلفة تسجيل العقد ورقم وروده ونوعه وبيان اسم الدائن والمدين أو البائع والمشتري ونوع المحل التجاري وعنوانه. ويوقع مأمورو السجل التجاري على هذا المحضر و بعد إتمام دفتر الإيداع بالفهرس الأبجدي وأسماء المدينين أو البائعين يرقم ويوقع عليه باختصار ثم يقفل كما هو مبين في المادة 142 السابقة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_144> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_144_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_144_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_144_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_144_19750926_OpEnact_6b54b6ffeb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "144" ;
    dzdoc:position 146 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_142>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_98>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_99> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_142>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_98>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_99> ;
    dzdoc:usesTerm dzterm:commercial_register_officer .

<https://legal.dz/resource/order/1975-09-26/75-59#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_2> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "إذا رفض الطرف الذي يعرض عليه الإثبات بالدفاتر ، تقديم هذه الأخيرة ، جاز للقاضي توجيه اليمين إلى الطرف الآخر ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_18_right_0_56b72485> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_18_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_18_19750926_OpEnact_7387d98a68> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "18" ;
    dzdoc:position 19 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_18_condition_0_e2c60554> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:merchant_status ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_3_sec_2> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "كل شخص طبيعي أو معنوي مسجل في السجل التجاري يعد مكتسبا صفة التاجر إزاء القوانين المعمول بها و يخضع لكل النتائج الناجمة عن هذه الصفة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_21> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_21_defocc_b43c7048aace> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_21_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_21_19750926_OpEnact_1a20d98941> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_21_obligation_0_2cd8df49> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "21" ;
    dzdoc:position 23 ;
    dzdoc:usesTerm dzterm:commercial_register .

<https://legal.dz/resource/order/1975-09-26/75-59#art_219> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_2> ;
    dzdoc:eId "art_219" ;
    dzdoc:fullText "إذا توفي تاجر وهو في حالة توقف عن الدفع ترفع الدعوى لمحكمة التجارة في أجل عام من الوفاة بمقتضى إقرار أحد الورثة أو بإعلان من جانب أحد الدائنين. وللمحكمة أن تفتح الإجراءات تلقائيا خلال نفس ذلك الأجل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_219> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_219_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_219_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_219_19750926_OpEnact_fb33621d7f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "219" ;
    dzdoc:position 223 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_219_condition_0_287ddeb3> ;
    dzdoc:usesTerm dzterm:cessation_of_payment,
        dzterm:trader .

<https://legal.dz/resource/order/1975-09-26/75-59#art_222> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_2> ;
    dzdoc:eId "art_222" ;
    dzdoc:fullText "في أول جلسة يثبت فيها لدى المحكمة التوقف عن الدفع فإنها تحدد تاريخه كما تقضي بـ التسوية القضائية أو الإفلاس . فإن لم يحدد تاريخ التوقف عن الدفع ، عد هذا التوقف واقعا بتاريخ الحكم المقرر له وذلك مع مراعاة أحكام المادة 233 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_222> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_222_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_222_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_222_19750926_OpEnact_ca79febdb4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "222" ;
    dzdoc:position 226 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_233> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_233> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_222_condition_0_6b0a66fd> ;
    dzdoc:usesTerm dzterm:bankruptcy,
        dzterm:cessation_of_payment,
        dzterm:judicial_settlement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_223> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_2> ;
    dzdoc:eId "art_223" ;
    dzdoc:fullText "في حالة قبول تسوية قضائية أو إشهار إفلاس شركة مشتملة على شركاء مسؤولين بالتضامن عن ديون الشركة ، ينتج الحكم آثاره بالنسبة لهؤلاء الشركاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_223> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_223_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_223_19750926_OpEnact_bbaaf3f056> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "223" ;
    dzdoc:position 227 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_223_condition_0_4fdc915c> ;
    dzdoc:usesTerm dzterm:bankruptcy,
        dzterm:judicial_settlement .

<https://legal.dz/resource/order/1975-09-26/75-59#art_230> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_2> ;
    dzdoc:eId "art_230" ;
    dzdoc:fullText "يوجه كاتب ضبط المحكمة فورا إلى وكيل الدولة المختص ملخصا للأحكام الصادرة بشهر الإفلاس أو التسوية القضائية . ويتضمن هذا الملخص البيانات الرئيسية لتلك الأحكام ونصوصها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_230> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_230_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_230_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_230_19750926_OpEnact_75e417f6df> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_230_obligation_0_215b6979> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 230" ;
    dzdoc:position 234 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_231> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_3> ;
    dzdoc:eId "art_231" ;
    dzdoc:fullText "مهلة المعارضة في الأحكام الصادرة في مادة التسوية القضائية أو شهر الإفلاس هي عشرة أيام اعتبارا من تاريخ الحكم ، وبالنسبة للأحكام الخاضعة لإجراءات الإعلان والنشر في الصحف المعتمدة لنشر الإعلانات القانونية أو في النشرة الرسمية للإعلانات القانونية فإنه لا يسري الميعاد بشأنها إلا من إتمام آخر إجراء مطلوب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_231> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_231_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_231_19750926_OpEnact_2620b6e572> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 231" ;
    dzdoc:position 235 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_231_condition_0_b6d72feb>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_231_condition_1_45391d18> ;
    dzdoc:usesTerm dzterm:bankruptcy_declaration,
        dzterm:judicial_settlement,
        dzterm:opposition_period .

<https://legal.dz/resource/order/1975-09-26/75-59#art_239> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_239" ;
    dzdoc:fullText "يفصل القاضي المنتدب خلال ثلاثة أيام في كل مطالبة تقوم ضد أي عمل قام به وكيل التفليسة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_239> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_239_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_239_19750926_OpEnact_87e49f05f5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_239_obligation_0_b29d65af> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 239" ;
    dzdoc:position 243 ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:trustee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_243> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_243" ;
    dzdoc:fullText "يخضع المدين الذي أشهر إفلاسه للمحظورات وسقوط الحق المنصوص عليها في القانون . وتستمر هذه المحظورات وسقوط الحق قائمة حتى رد الاعتبار، ما لم توجد أحكام قانونية تخالف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_243> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_243_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_243_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_243_19750926_OpEnact_c0cfeb8e69> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_243_obligation_0_6430420a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "243" ;
    dzdoc:position 247 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_3_sec_2> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "تسري أحكام المادة السابقة حتى فيما إذا كانت الوقائع موضوع نشر قانوني آخر، وذلك : 1 - في حالة الرجوع عن ترشيد التاجر القاصر تطبيقا لأحكام التشريع الخاص بالأسرة وعند إلغاء الإذن المسلم لقاصر الخاص بممارسة التجارة، 2 – في حالة صدور أحكام نهائية تقضي بالحجز على تاجر وبتعيين إما وصي قضائي وإما متصرف على أمواله، 3 - في حالة صدور أحكام نهائية تقضي ببطلان شركة تجارية بحلها، 4 – في حالة إنهاء أو إلغاء سلطات كل شخص ذي صفة ملزمة لمسؤولية تاجر أو شركة أو مؤسسة اشتراكية، 5 – في حالة صدور قرار من جمعية عامة لشركة مساهمة أو ذات مسؤولية محدودة يتضمن الأمر باتخاذ قرار من الجمعية العامة في حالة خسارة 3/4 من مالية الشركة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_25> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_25_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_25_19750926_OpEnact_cd255adebe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "25" ;
    dzdoc:position 27 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_24> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_24> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_256> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_2> ;
    dzdoc:eId "art_256" ;
    dzdoc:fullText "في حالة ما إذا كان المدين لم يودع الميزانية ، يقوم وكيل التفليسة بوضعها فورا مستعينا بالدفاتر والمستندات الحسابية والأوراق والمعلومات التي يحصل عليها ثم يودعها بكتابة ضبط المحكمة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_256> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_256_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_256_19750926_OpEnact_862216591d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_256_obligation_0_5b1d5e39> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "256" ;
    dzdoc:position 261 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_256_condition_0_4565afbc> ;
    dzdoc:usesTerm dzterm:receiver .

<https://legal.dz/resource/order/1975-09-26/75-59#art_263> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_3> ;
    dzdoc:eId "art_263" ;
    dzdoc:fullText "يتقدم وكيل التفليسة بطلب خلال ثلاثة أيام لرفع الأختام لأجل مباشرة عمليات الجرد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_263> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_263_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_263_19750926_OpEnact_8ecdddeff8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_263_obligation_0_9136321a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "263" ;
    dzdoc:position 268 ;
    dzdoc:usesTerm dzterm:trustee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_265> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_4> ;
    dzdoc:eId "art_265" ;
    dzdoc:fullText "إذا حكم بالتسوية القضائية أو شهر الإفلاس بعد الوفاة ولم تكن قد حررت قائمة الجرد، أو كانت وفاة المدين حاصلة قبل إقفال قائمة الجرد ، فتحرر هذه الأخيرة أو تستكمل بحضور الورثة المعروفين أو بعد استدعائهم قانونا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_265> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_265_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_265_19750926_OpEnact_c9e12d41f1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_265_obligation_0_75557fdf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "265" ;
    dzdoc:position 270 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_265_condition_0_9fd2fe83> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_267> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_4> ;
    dzdoc:eId "art_267" ;
    dzdoc:fullText "عند إتمام قائمة الجرد في حالة شهر الإفلاس ، تسلم ل وكيل التفليسة البضائع والنقود وسندات الحقوق والدفاتر والأوراق ومنقولات وحاجات المدين ومن ثم تأخذها في عهدته بإقرار يحرره في أسفل قائمة الجرد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_267> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_267_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_267_19750926_OpEnact_caf94d7a06> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_267_obligation_0_1e5a53fb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "267" ;
    dzdoc:position 272 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_267_condition_0_29b513d3> ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:trustee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_3_sec_2> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "كل شخص طبيعي أو معنوي ، غير مسجل في السجل التجاري ، يمارس بصفة عادية نشاطا تجاريا ، يكون قد ارتكب مخالفة تعاين و يعاقب عليها طبقا للأحكام القانونية السارية في هذا المجال. وتأمر المحكمة التي تقضي بالغرامة بتسجيل الإشارات أو الشطب الواجب إدراجه في السجل التجاري خلال مهلة معينة و على نفقة المعني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_28_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_28_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_28_19750926_OpEnact_549d2f31a8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 28" ;
    dzdoc:position 30 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_28_condition_0_0d308ecd> ;
    dzdoc:usesTerm dzterm:commercial_register,
        dzterm:legal_person,
        dzterm:natural_person .

<https://legal.dz/resource/order/1975-09-26/75-59#art_302> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_4> ;
    dzdoc:eId "art_302" ;
    dzdoc:fullText "إذا سبق توزيع ثمن العقارات توزيع أو أكثر للأموال المنقولة فإن المقبولين من الدائنين الممتازين أو المرتهنين عقاريا يشاركون في التوزيعات بنسبة حقوقهم الإجمالية ، إلا في حالة الإستبعادات المشار إليها في المادة التالية عند الاقتضاء."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_302_right_0_7290296e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_302> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_302_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_302_19750926_OpEnact_838ef27b0b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "302" ;
    dzdoc:position 307 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_303> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_303> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_302_condition_0_34531bcc> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_321> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_2> ;
    dzdoc:eId "art_321" ;
    dzdoc:fullText "للدائنين أن يحضروا بأشخاصهم الجمعيات المنصوص عليها في المادتين 317 و 320 أو أن ينيبوا عنهم من يمثلهم فيها مزودا بتفويض ما لم يكن معفى من تقديمه قانونا . ويعتبر توقيع الدائن أو نائبه على أوراق التصويت المرفقة بالمحضر بمثابة توقيع على المحضر ذاته."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_321_right_0_d1104364> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_321> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_321_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_321_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_321_19750926_OpEnact_9457c6f76a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "321" ;
    dzdoc:position 326 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_317>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_320> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_317>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_320> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_327> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_3> ;
    dzdoc:eId "art_327" ;
    dzdoc:fullText "ترفض المحكمة التصديق على الصلح في حالة عدم مراعاة القواعد المفروضة فيما تقدم أو قيام أسباب ترجع إما للمصلحة العامة أو لمصلحة الدائنين تكون بحكم طبيعتها حائلا دون الصلح ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_327> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_327_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_327_19750926_OpEnact_c54dff42ca> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_327_obligation_0_7532efae> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 327" ;
    dzdoc:position 332 ;
    dzdoc:usesTerm dzterm:conciliation .

<https://legal.dz/resource/order/1975-09-26/75-59#art_329> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_3> ;
    dzdoc:eId "art_329" ;
    dzdoc:fullText "يتعين نشر أحكام التصديق على الصلح تبعا للقواعد المحددة في المادة 228 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_329> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_329_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_329_19750926_OpEnact_07d8712d10> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_329_obligation_0_12a4570d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 329" ;
    dzdoc:position 334 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_228> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_228> ;
    dzdoc:usesTerm dzterm:conciliation .

<https://legal.dz/resource/order/1975-09-26/75-59#art_331> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_4> ;
    dzdoc:eId "art_331" ;
    dzdoc:fullText "لا تقبل بعد التصديق أية دعوى ببطلان الصلح إلا لسبب الغش الذي يكتشف بعد هذا التصديق نتيجة إخفاء بعض الأصول أو المبالغة في الخصوم . ويبرئ هذا الإبطال بحكم القانون ذمة الكفلاء ما عدا من كان منهم عالما بالغش عند الالتزام."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_331> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_331_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_331_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_331_19750926_OpEnact_2e033f1cad> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 331" ;
    dzdoc:position 336 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_331_condition_0_ba236879> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_333> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_4> ;
    dzdoc:eId "art_333" ;
    dzdoc:fullText "يمكن أن يشترط في الصلح تقسيط دفع الديون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_333_permission_0_b892acc3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_333> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_333_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_333_19750926_OpEnact_23df0413db> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 333" ;
    dzdoc:position 338 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_335> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_4> ;
    dzdoc:eId "art_335" ;
    dzdoc:fullText "يبقى الرهن العقاري لجماعة الدائنين لسداد حصص المصالحة. وتنحصر آثار قيد الرهن العقاري في مبلغ تقدره المحكمة في حكم التصديق. وللمندوب المكلف بتنفيذ المصالحة الأهلية في منح رفع اليد عن القيد المتخذ تنفيذا للفقرة السابقة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_335> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_335_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_335_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_335_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_335_19750926_OpEnact_8f5e9f174b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 335" ;
    dzdoc:position 340 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_344> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_7_subsec_6> ;
    dzdoc:eId "art_344" ;
    dzdoc:fullText "يجري بغير إبطاء تحقيق ما يقدم من مستندات الديون عملا ب المادة السابقة . ولا يكون ثمة محل لتحقيق جديد للديون السابق قبولها بغير إخلال مع ذلك برفض أو تخفيض الديون التي قد تكون من ذلك الحين قد وفيت كليا أو جزئيا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_344> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_344_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_344_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_344_19750926_OpEnact_feb24f8935> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_344_obligation_0_1b628b88> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "344" ;
    dzdoc:position 349 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_343> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_343> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_361> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_2> ;
    dzdoc:eId "art_361" ;
    dzdoc:fullText "على كاتب المحكمة أن يعلن الطلب عن طريق نشره في إحدى الصحف المتعمدة لقبول الإعلانات القانونية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_361> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_361_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_361_19750926_OpEnact_7f60cd2fb4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_361_obligation_0_12ac6289> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 361" ;
    dzdoc:position 366 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_364> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_2> ;
    dzdoc:eId "art_364" ;
    dzdoc:fullText "بعد انقضاء المواعيد المنصوص عليها في المادتين 362 و 363 ، يحيل وكيل الدولة إلى المحكمة المرفوع إليها الطلب نتيجة التحقيقات المنصوص عليها فيما تقدم مشفوعة برأيه المسبب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_364> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_364_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_364_19750926_OpEnact_d1ef1bc092> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_364_obligation_0_fc3635d1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 364" ;
    dzdoc:position 369 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_362>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_363> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_362>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_363> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_364_condition_0_750f6ec3> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_366> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_2> ;
    dzdoc:eId "art_366" ;
    dzdoc:fullText "لا يقبل رد الاعتبار وفقا لأحكام هذا الباب للأشخاص المحكوم عليهم في جناية أو جنحة ما دام من آثار الإدانة منعهم من ممارسة تجارية أو صناعية أو حرفية يدوية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_366> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_366_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_366_19750926_OpEnact_3065bcca5f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 366" ;
    dzdoc:position 371 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_366_condition_0_a1f328ee> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_1> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "يتكون عقد النقل أو عقد العمولة للنقل باتفاق الطرفين وحده."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_38_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_38_19750926_OpEnact_b7f8a60365> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 38" ;
    dzdoc:position 40 ;
    dzdoc:usesTerm dzterm:transport_commission_contract,
        dzterm:transport_contract .

<https://legal.dz/resource/order/1975-09-26/75-59#art_394> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_394" ;
    dzdoc:fullText "الساحب ضامن قبول السفتجة ووفاءها. ويمكن له أن يعفي نفسه من ضمان القبول. وكل شرط يقضي بإعفائه من ضمان الوفاء يعد كأن لم يكن."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_394> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_394_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_394_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_394_19750926_OpEnact_003a412b0f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_394_obligation_0_aa14403b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 394" ;
    dzdoc:position 399 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_439> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_8> ;
    dzdoc:eId "art_439" ;
    dzdoc:fullText "لا تعتبر من قبيل القوة القاهرة الأفعال الشخصية المحضة المتصلة بالحامل أو بالشخص الذي كلفه بتقديم السفتجة أو الاحتجاج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_439> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_439_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_439_19750926_OpEnact_07efcca2da> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "439" ;
    dzdoc:position 444 ;
    dzdoc:usesTerm dzterm:bill_of_exchange,
        dzterm:force_majeure,
        dzterm:protest .

<https://legal.dz/resource/order/1975-09-26/75-59#art_441> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_1_sec_1_subsec_8> ;
    dzdoc:eId "art_441" ;
    dzdoc:fullText "يحرر الاحتجاج لعدم القبول أو الوفاء بواسطة إجراء لدى كتابة الضبط وتترك نسخة حرفية منه للمسحوب عليه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_441> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_441_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_441_19750926_OpEnact_5b6fdefc54> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "441" ;
    dzdoc:position 446 ;
    dzdoc:usesTerm dzterm:protest .

<https://legal.dz/resource/order/1975-09-26/75-59#art_494> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_2> ;
    dzdoc:eId "art_494" ;
    dzdoc:fullText "ليس لمن رفعت عليهم دعوى بموجب الشيك أن يحتجوا على حامله بدفوع مبنية على علاقاتهم الشخصية بساحبه أو بحملته السابقين ما لم يكن حامله قد تعمد الحصول على الشيك للإضرار بالمدين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_494> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_494_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_494_19750926_OpEnact_31994de4a5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "494" ;
    dzdoc:position 499 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_494_condition_0_9ba0caca> ;
    dzdoc:usesTerm dzterm:cheque .

<https://legal.dz/resource/order/1975-09-26/75-59#art_525> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_2_sec_7> ;
    dzdoc:eId "art_525" ;
    dzdoc:fullText "وفاء الشيك بموجب أحد نظائره مبرئ للذمة ولو لم يكن مشترطا به إن هذا الوفاء يبطل مفعول النظائر الأخرى. إن المظهر الذي أحال النظائر لأشخاص مختلفين وكذلك مظهريها اللاحقين ملزمون بموجب جميع النظائر التي تحمل توقيعهم ولم يحصل استردادها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_525> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_525_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_525_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_525_19750926_OpEnact_a25623801b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_525_obligation_0_305afdf8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 525" ;
    dzdoc:position 530 ;
    dzdoc:usesTerm dzterm:cheque,
        dzterm:endorser .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_3> ;
    dzdoc:eId "art_543_bis_15" ;
    dzdoc:fullText "يجب أن يبلغ المدين فورا بنقل حقوق الديون التجارية إلى الوسيط بواسطة رسالة موصى عليها مع وصل الاستلام."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_15_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_15_19750926_OpEnact_22f67d74ea> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_15_obligation_0_687aa9bd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 15" ;
    dzdoc:position 581 ;
    dzdoc:usesTerm dzterm:factor .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_4_sec_1> ;
    dzdoc:eId "art_543_bis_20" ;
    dzdoc:fullText "يكون الأمر بالتحويل غير قابل للرجوع فيه ابتداء من تاريخ الاقتطاع من حساب الأمر بالتحويل . يعتبر التحويل نهائيا ابتداء من تاريخ دخول المبلغ المحول إلى حساب المستفيد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_20> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_20_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_20_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_20_19750926_OpEnact_70d0617b56> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 20" ;
    dzdoc:position 586 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_20_condition_0_fcf07489> ;
    dzdoc:usesTerm dzterm:transfer_order .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_1> ;
    dzdoc:eId "art_543_bis_5" ;
    dzdoc:fullText "تحدد مختلف الأشكال التي يمكن أن يكتسيها سند الخزن عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_5_permission_0_01f013af> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_5_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_5_19750926_OpEnact_6f2d6ed042> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 5" ;
    dzdoc:position 571 ;
    dzdoc:usesTerm dzterm:سند_الخزن .

<https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:definesTerm dzterm:قيمة_البضاعة ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_4_chp_3_sec_1> ;
    dzdoc:eId "art_543_bis_6" ;
    dzdoc:fullText "قيمة البضاعة هي القيمة المحددة وقت الإيداع، إلا إذا تعلق الأمر باختيار عمليات لأجل ، وبهذا الشرط الأخير فإن القيمة التي ينبغي أخذها بعين الاعتبار، تصبح القيمة المحددة بالنسبة لاختيار عمليات لأجل على البضائع أو المنتوجات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_6> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_6_defocc_4636a18137f9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_6_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_6_19750926_OpEnact_a0bdb1efb3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543 مكرر 6" ;
    dzdoc:position 572 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_543_bis_6_condition_0_e16a0e54> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_547> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_sec_التمهيدي> ;
    dzdoc:eId "art_547" ;
    dzdoc:fullText "يكون موطن الشركة في مركز الشركة. تخضع الشركات التي تمارس نشاطها في الجزائر للتشريع الجزائري ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_547> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_547_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_547_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_547_19750926_OpEnact_eded4b32ca> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_547_obligation_0_78ff54ad> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "547" ;
    dzdoc:position 594 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_562> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1> ;
    dzdoc:eId "art_562" ;
    dzdoc:fullText "تنتهي الشركة بوفاة أحد الشركاء ما لم يكن هناك شرط مخالف في القانون الأساسي . ويعتبر القاصر أو القصر من ورثة الشريك، في حالة استمرار الشركة غير مسؤولين عن ديون الشركة مدة قصورهم إلا بقدر أموال تركة مورثهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_562> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_562_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_562_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_562_19750926_OpEnact_e8ce947ce8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "562" ;
    dzdoc:position 609 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_562_condition_0_24a63041> ;
    dzdoc:usesTerm dzterm:partners .

<https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1_bis> ;
    dzdoc:eId "art_563_bis" ;
    dzdoc:fullText "تطبق الأحكام المتعلقة ب شركات التضامن على شركات التوصية البسيطة مع مراعاة القواعد المنصوص عليها في هذا الفصل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_19750926_OpEnact_71cdc47f9c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_obligation_0_8a88d95d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "563 مكرر" ;
    dzdoc:position 611 ;
    dzdoc:usesTerm dzterm:general_partnership,
        dzterm:limited_partnership .

<https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1_bis> ;
    dzdoc:eId "art_563_bis_3" ;
    dzdoc:fullText "يجب أن يتضمن القانون الأساسي للشركة بالتوصية البسيطة البيانات التالية : 1) مبلغ أو قيمة حصص كل الشركاء، 2) حصة كل شريك متضامن أو شريك موص في هذا المبلغ أو القيمة، 3) الحصة الإجمالية للشركاء المتضامنين وحصتهم في الأرباح وكذا حصتهم في الفائض من التصفية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_3_19750926_OpEnact_fed8e1f567> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_3_obligation_0_fb5065a9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "563 مكرر 3" ;
    dzdoc:position 614 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1_bis> ;
    dzdoc:eId "art_563_bis_4" ;
    dzdoc:fullText "تتخذ القرارات وفق الشروط المحددة في القانون الأساسي. غير أن انعقاد جمعية كل الشركاء تكون قانونية، إذا طالب بها الشريك المتضامن أو الشركاء الموصون الذين يمثلون ربع رأس المال ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_4_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_4_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_4_19750926_OpEnact_bcd01605ee> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "563 مكرر 4" ;
    dzdoc:position 615 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_4_condition_0_f2844512> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_1_bis> ;
    dzdoc:eId "art_563_bis_8" ;
    dzdoc:fullText "يمكن تقرير تعديل القوانين الأساسية بموافقة كل الشركاء المتضامنين والشركاء الموصين الممثلين أغلبية رأسمال."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_8_permission_0_89300bba> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_563_bis_8_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_563_bis_8_19750926_OpEnact_66e9595ca5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "563 مكرر 8" ;
    dzdoc:position 619 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_565> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_565" ;
    dzdoc:fullText "يجب أن يتولى إبرام عقد تأسيس الشركة جميع الشركاء بأنفسهم أو بواسطة وكلاء يثبتون تفويضهم الخاص لذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_565> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_565_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_565_19750926_OpEnact_c683419fc3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_565_obligation_0_40800e91> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "565" ;
    dzdoc:position 623 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_576> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_576" ;
    dzdoc:fullText "يدير الشركة ذات المسؤولية المحدودة شخص أو عدة أشخاص طبيعيين. ويجوز اختيارهم خارجا عن الشركاء. ويعينهم الشركاء في القانون الأساسي أو بعقد لاحق حسب الشروط المنصوص عليها في الفقرة الأولى من المادة 582 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_576> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_576_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_576_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_576_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_576_19750926_OpEnact_b121631adb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "576" ;
    dzdoc:position 634 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_582> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_582> ;
    dzdoc:usesTerm dzterm:limited_liability_company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_587> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_2> ;
    dzdoc:eId "art_587" ;
    dzdoc:fullText "ما عدا حالة إحالة حصص للغير يجب أن تكون قرارات الجمعيات غير العادية، مسبوقة بتقرير يحرره خبير معتمد عن وضع الشركة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_587> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_587_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_587_19750926_OpEnact_3a7eaa799b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_587_obligation_0_a7604a4f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "587" ;
    dzdoc:position 644 ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-59#art_597> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_597" ;
    dzdoc:fullText "يتم إثبات الاكتتاب بالأسهم النقدية بموجب بطاقة اكتتاب تعد حسب الشروط المحددة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_597> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_597_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_597_19750926_OpEnact_4ad2afc903> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "597" ;
    dzdoc:position 656 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_605> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_605" ;
    dzdoc:fullText "المادة 605 : تطبق أحكام الفقرة الأولى أعلاه ما عدا المواد 595 و 597 و 600 و 601 \"المقاطع 2 و 3 و 4\" و 602 و 603 ، عندما لا يتم اللجوء علانية للادخار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_605> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_605_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_605_19750926_OpEnact_92b6c36d94> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "605" ;
    dzdoc:position 664 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_595>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_597>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_600>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_601>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_602>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_603> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_595>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_597>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_600>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_601>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_602>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_603> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_608> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_608" ;
    dzdoc:fullText "المادة 608 : يوقع المساهمون القانون الأساسي، إما بأنفسهم أو بواسطة وكيل مزود بتفويض خاص ، بعد التصريح الموثق بالدفعات وبعد وضع التقرير المشار إليه في المادة السابقة تحت تصرف المساهمين حسب الشروط والآجال المحددة عن طريق التنظيم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_608> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_608_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_608_19750926_OpEnact_dc97d4876f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_608_obligation_0_10774729> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "608" ;
    dzdoc:position 667 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_607> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_607> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_608_condition_0_331a45ad> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_609> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_609" ;
    dzdoc:fullText "المادة 609 : يعين القائمون بالإدارة الأولون وأعضاء مجلس المراقبة الأولون ومندوبو الحسابات الأولون في القوانين الأساسية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_609> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_609_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_609_19750926_OpEnact_148fbc3b5d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "609" ;
    dzdoc:position 668 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_625> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_625" ;
    dzdoc:fullText "المادة 625 : يكون نقل مقر الشركة في نفس المدينة بقرار مجلس الإدارة . أما إذا تقرر نقله خارج هذه المدينة ، فإن القرار يكون من اختصاص الجمعية العامة العادية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_625> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_625_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_625_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_625_19750926_OpEnact_9295fa688e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "625" ;
    dzdoc:position 684 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_625_condition_0_073769c5> ;
    dzdoc:usesTerm dzterm:board_of_directors,
        dzterm:general_assembly .

<https://legal.dz/resource/order/1975-09-26/75-59#art_627> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_627" ;
    dzdoc:fullText "المادة 627 : يتعين على القائمين بالإدارة ومجموع الأشخاص المدعوين لحضور اجتماعات مجلس الإدارة، كتم المعلومات ذات الطابع السري أو التي تعتبر كذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_627> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_627_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_627_19750926_OpEnact_44e1903705> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_627_obligation_0_44993a80> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "627" ;
    dzdoc:position 686 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_3> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "تترتب مسؤولية الناقل إزاء المسافر ابتداء من تكلفه به."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_64_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_64_19750926_OpEnact_35af4f7c0b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 64" ;
    dzdoc:position 66 ;
    dzdoc:usesTerm dzterm:carrier .

<https://legal.dz/resource/order/1975-09-26/75-59#art_684> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_684" ;
    dzdoc:fullText "مع مراعاة الأحكام الواردة في المادتين 603 و 685 ، يكون حق التصويت المرتبط بأسهم رأس المال أو الانتفاع متناسبا مع حصة رأس المال التي تنوب عنها . ولكل سهم صوت على الأقل. ويعتبر كل شرط مخالف لذلك كأن لم يكن."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_684_right_0_cbcb0dc6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_684> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_684_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_684_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_684_19750926_OpEnact_09499f12c4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "684" ;
    dzdoc:position 743 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_603>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_685> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_603>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_685> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_689> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_689" ;
    dzdoc:fullText "لا تقرر زيادة رأس المال بإضافة القيمة الاسمية للأسهم إلا بقبول المساهمين بالإجماع ، ما عدا إذا تحقق ذلك بإلحاق الاحتياط أو الأرباح أو علاوات الإصدار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_689> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_689_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_689_19750926_OpEnact_c299d425c3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_689_obligation_0_e25e47e2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "689" ;
    dzdoc:position 748 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_689_condition_0_6f5db2eb> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_4_subsec_3> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "زيادة على الالتزامات المترتبة على ناقل الأشخاص والمنصوص عليها في المادة 65 ، يعد الوكيل ابتداء من تكلفه بالمسافر، مسؤولا عن الأضرار البدنية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_69_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_69_19750926_OpEnact_6d0b21ddee> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 69" ;
    dzdoc:position 71 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_65> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_65> ;
    dzdoc:usesTerm dzterm:carrier,
        dzterm:commission_agent .

<https://legal.dz/resource/order/1975-09-26/75-59#art_695> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_6> ;
    dzdoc:eId "art_695" ;
    dzdoc:fullText "إذا لم يكتتب بعض المساهمين في الأسهم التي كان لهم حق الاكتتاب فيها على أساس غير قابل للتخفيض ، فإن الأسهم التي تصبح متوفرة على هذا الشكل تمنح للمساهمين الذين اكتتبوا على أساس قابل للتخفيض في عدد من الأسهم تزيد عن العدد الذي يستطيعون الاكتتاب فيه على أساس التفاضل بنسبة حقوق الاكتتاب الحائزين عليها، في حدود طلباتهم على أي حال."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_695> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_695_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_695_19750926_OpEnact_d4926bc744> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 695" ;
    dzdoc:position 754 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_695_condition_0_ec8de082> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_5> ;
    dzdoc:eId "art_715_bis_100" ;
    dzdoc:fullText "تتكفل الشركة المدينة بمصاريف تنظيم الجمعيات العامة لأصحاب سندات الاستحقاق وسيرها ، كما تتكفل بدفع مرتب ممثلي أصحاب سندات الاستحقاق ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_100> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_100_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_100_19750926_OpEnact_72bf9ff8a3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_100_obligation_0_263f1c8a>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_100_obligation_1_3052c1ba> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 100" ;
    dzdoc:position 874 ;
    dzdoc:usesTerm dzterm:bondholders .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_122> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_6> ;
    dzdoc:eId "art_715_bis_122" ;
    dzdoc:fullText "إذا قامت الشركة بإصدار سندات استحقاق جديدة قابلة للتحويل أو سندات استحقاق مع قسيمات اكتتاب وجب عليها إخبار أصحاب سندات الاستحقاق بواسطة إعلان ينشر حسب شروط يحددها نظام السلطة المكلفة بتنظيم عمليات البورصة ومراقبتها للسماح لهم باختيار التحويل في الأجل الذي يحدده الإعلان المذكور ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_122> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_122_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_122_19750926_OpEnact_e632c3a76a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_122_obligation_0_27650e02> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 122" ;
    dzdoc:position 896 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_122_condition_0_9cceb663> ;
    dzdoc:usesTerm dzterm:cosob .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_10> ;
    dzdoc:eId "art_715_bis_27" ;
    dzdoc:fullText "في حالة التسوية القضائية للشركة أو إفلاسها، يمكن أن يكون الأشخاص، الذين أشارت إليهم الأحكام المتعلقة بالتسوية القضائية أو الإفلاس أو التفليس، مسؤولين عن ديون الشركة وفقا للشروط المنصوص عليها في الأحكام المذكورة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_27_permission_0_8bf21271> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_27_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_27_19750926_OpEnact_0cba6f6f21> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 27" ;
    dzdoc:position 801 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_44" ;
    dzdoc:fullText "يمكن تقسيم الأسهم العادية الاسمية إلى فئتين اثنتين حسب إرادة الجمعية العامة التأسيسية، تتمتع الفئة الأولى بحق تصويت يفوق عدد الأسهم التي بحوزتها، أما الفئة الثانية فتتمتع بامتياز الأولوية في الاكتتاب لأسهم أو سندات استحقاق جديدة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_44_permission_0_d1b4b6d5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_44_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_44_19750926_OpEnact_1713d38070> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 44" ;
    dzdoc:position 818 ;
    dzdoc:usesTerm dzterm:ordinary_shares .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_58> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_2> ;
    dzdoc:eId "art_715_bis_58" ;
    dzdoc:fullText "إذا أعطت الشركة موافقتها على مشروع رهن حيازي للأسهم، حسب الشروط المنصوص عليها في المادة 715 مكرر 56 أعلاه ، فإنه يترتب على هذه الموافقة قبول المحال إليه في حالة البيع الجبري للأسهم المرهونة طبقا لأحكام المادة 981 من القانون المدني ، إلا إذا فضلت الشركة بعد الإحالة استرجاع الأسهم بالشراء من دون تأخير، قصد خفض رأسمالها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_58> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_58_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_58_19750926_OpEnact_615fcafc37> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 58" ;
    dzdoc:position 832 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_56> ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_58_extref_eb4c2851> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_56> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_58_condition_0_feff4910> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
