<https://legal.dz/resource/order/1975-09-26/75-59#version_art_599> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون الاكتتابات والمبالغ المدفوعة مثبتة في تصريح المؤسسين بواسطة عقد موثق. يؤكد الموثق بناء على تقديم بطاقات الاكتتاب في مضمون العقد الذي يحرره، أن مبلغ الدفعات المصرح بها من المؤسسين يطابق مقدار المبالغ المودعة إما بين يديه أو لدى المؤسسات المالية المؤهلة قانونا."@ar ;
