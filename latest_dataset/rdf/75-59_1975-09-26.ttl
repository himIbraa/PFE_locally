<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تؤسس شركة التوصية بالأسهم التي يكون رأسمالها مقسما إلى أسهم، بين شريك متضامن أو أكثر له صفة تاجر ومسؤول دائما وبصفة متضامنة عن ديون الشركة وشركاء موصين لهم صفة مساهمين ولا يتحملون الخسائر إلا بما يعادل حصصهم. لا يمكن أن يكون عدد الشركاء الموصين أقل من ثلاثة (03) ولا يذكر أسهم في اسم الشركة. تطبق القواعد المتعلقة بشركات التوصية البسيطة وشركات المساهمة باستثناء المواد 610 إلى 673 المذكورة أعلاه، على شركات التوصية بالأسهم ما دامت تتطابق مع الأحكام الخاصة المنصوص عليها في هذا الفصل."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_19750926_OpEnact_ed6ea33de4> ;
    dzdoc:replacementText "تؤسس شركة التوصية بالأسهم التي يكون رأسمالها مقسما إلى أسهم، بين شريك متضامن أو أكثر له صفة تاجر ومسؤول دائما وبصفة متضامنة عن ديون الشركة وشركاء موصين لهم صفة مساهمين ولا يتحملون الخسائر إلا بما يعادل حصصهم. لا يمكن أن يكون عدد الشركاء الموصين أقل من ثلاثة (03) ولا يذكر أسهم في اسم الشركة. تطبق القواعد المتعلقة بشركات التوصية البسيطة وشركات المساهمة باستثناء المواد 610 إلى 673 المذكورة أعلاه، على شركات التوصية بالأسهم ما دامت تتطابق مع الأحكام الخاصة المنصوص عليها في هذا الفصل."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_715_ثالثا> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
