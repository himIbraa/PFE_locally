<https://legal.dz/resource/order/1975-09-26/75-59#version_art_707> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة ما إذا كانت الحصص المقدمة عينية أو كان هناك اشتراط منافع خاصة ، فإنه يعين واحد أو أكثر من المندوبين المكلفين بتقدير الحصص العينية بقرار قضائي بناء على طلب رئيس مجلس الإدارة أو مجلس المديرين ويخضع هؤلاء المندوبون للتنافي المنصوص عليه في المادة 679 . ويتم تقدير الحصص العينية والامتيازات خاصة تحت مسؤولية هؤلاء المندوبين، ويوضع تقريرهم تحت تصرف المساهمين قبل ثمانية أيام على الأقل من تاريخ انعقاد الجمعية. وتطبق أحكام المادة 603 على الجمعية العامة غير العادية. إذا أقرت الجمعية العامة تقدير الح"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_707_19750926_OpEnact_d3d9f8578e> ;
    dzdoc:replacementText "في حالة ما إذا كانت الحصص المقدمة عينية أو كان هناك اشتراط منافع خاصة ، فإنه يعين واحد أو أكثر من المندوبين المكلفين بتقدير الحصص العينية بقرار قضائي بناء على طلب رئيس مجلس الإدارة أو مجلس المديرين ويخضع هؤلاء المندوبون للتنافي المنصوص عليه في المادة 679 . ويتم تقدير الحصص العينية والامتيازات خاصة تحت مسؤولية هؤلاء المندوبين، ويوضع تقريرهم تحت تصرف المساهمين قبل ثمانية أيام على الأقل من تاريخ انعقاد الجمعية. وتطبق أحكام المادة 603 على الجمعية العامة غير العادية. إذا أقرت الجمعية العامة تقدير الحصص ومنح المنافع الخاصة ، فإنها تثبت تحقيق زيادة رأس المال. وإذا خفضت الجمعية تقدير الحصص المقدمة ومكافأة المنافع الخاصة ، فإن المصادقة الصريحة لتعديلات مقدمي الحصص أو المستفيدين أو وكلائهم المرخص لهم قانونا بهذا الشأن، تعد واجبة. فإذا لم يتحقق ذلك فإن زيادة رأس المال تبقى غير محققة. وتصبح أسهم الحصص المقدمة بكاملها مسددة بمجرد إصدارها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_707> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_707> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
