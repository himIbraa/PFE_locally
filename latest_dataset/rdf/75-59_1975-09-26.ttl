<https://legal.dz/resource/order/1975-09-26/75-59#version_art_618> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعرض التعيينات التي يقوم بها المجلس بمقتضى المقطعين 1 و 3 من المادة 617 أعلاه، على الجمعية العامة العادية المقبلة للمصادقة عليها. وعند عدم المصادقة، فإن المداولات المتخذة والتصرفات التي قام بها المجلس سابقا تعتبر صحيحة على أي حال. وإذا أهمل المجلس القيام بالتعيينات المطلوبة أو استدعاء الجمعية ، جاز لكل معني بالأمر أن يطلب من القضاء تعيين وكيل يكلف باستدعاء الجمعية العامة لإجراء التعيينات أو المصادقة على التعيينات المذكورة في المادة السابقة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_618_19750926_OpEnact_2359b87486> ;
    dzdoc:replacementText "تعرض التعيينات التي يقوم بها المجلس بمقتضى المقطعين 1 و 3 من المادة 617 أعلاه، على الجمعية العامة العادية المقبلة للمصادقة عليها. وعند عدم المصادقة، فإن المداولات المتخذة والتصرفات التي قام بها المجلس سابقا تعتبر صحيحة على أي حال. وإذا أهمل المجلس القيام بالتعيينات المطلوبة أو استدعاء الجمعية ، جاز لكل معني بالأمر أن يطلب من القضاء تعيين وكيل يكلف باستدعاء الجمعية العامة لإجراء التعيينات أو المصادقة على التعيينات المذكورة في المادة السابقة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
