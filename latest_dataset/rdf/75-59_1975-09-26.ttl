    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 20.000 دج إلى 200.000 دج أو بإحدى هاتين العقوبتين فقط"@ar ;
    dznorm:sourceArticle "art_838" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_838_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_838> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 20.000 دج إلى 200.000 دج أو بإحدى هاتين العقوبتين فقط، مصفي الشركة الذي : 1- لم يقم عمدا في ظرف شهر من تعيينه بنشر الأمر المتضمن تعيينه مصفيا بجريدة خاصة لقبول الإعلانات القانونية بالولاية التي يوجد بها ولم يودع بالسجل التجاري القرارات التي قضت بالحل 2- ولم يستدع عمدا الشركاء في نهاية التصفية لأجل البت في الحساب النهائي وعلى إبراء إدارته وإخلاء ذمته من توكيله وإثبات اختتام التصفية أو لم يضع حساباته بكتابة المحكمة ولم يطلب من القضاء المصادقة عليها وذلك في الحالة المنصوص عليها في المادة 774."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_839_obligation_0_078f6eaf> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_839_obligation_0_078f6eaf_ref_1f71d1b47dcb> ;
