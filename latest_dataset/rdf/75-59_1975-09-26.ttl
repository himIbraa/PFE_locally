<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا_9> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يتحمل أعضاء مجلس المراقبة أية مسؤولية تتعلق بأعمال التسيير والنتائج المترتبة عنها. ويمكن اعتبار أعضاء مجلس المراقبة مسؤولين مدنيا عن الجنح التي ارتكبها المسيرون، إذا كانوا على علم بذلك ولم يصرحوا بها إلى الجمعية العامة . ويكونون مسؤولين عن الأخطاء الشخصية المرتكبة خلال مدة وكالتهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715___9_19750926_OpEnact_8f76e1f2a1> ;
    dzdoc:replacementText "لا يتحمل أعضاء مجلس المراقبة أية مسؤولية تتعلق بأعمال التسيير والنتائج المترتبة عنها. ويمكن اعتبار أعضاء مجلس المراقبة مسؤولين مدنيا عن الجنح التي ارتكبها المسيرون، إذا كانوا على علم بذلك ولم يصرحوا بها إلى الجمعية العامة . ويكونون مسؤولين عن الأخطاء الشخصية المرتكبة خلال مدة وكالتهم ."@ar ;
