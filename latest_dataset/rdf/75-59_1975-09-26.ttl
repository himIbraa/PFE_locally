    dznorm:sourceArticle "art_290" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_291_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_291> ;
