    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_718> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "حتى في حال انعدام وعدم كفاية الأرباح، فإنه يشرع في الاستهلاكات وجمع المؤونات الضرورية لكي تكون الميزانية صحيحة. وإن نقص قيمة الأصول الملحقة بالأصول الثابتة سواء أكانت مسببة بالاستهلاك أو بتغيير الوسائل الفنية أو أي سبب آخر يجب أن تكون ثابتة بالاستهلاكات، كما يجب أن يكون النقص في القيمة لبقية عناصر مال الشركة والخسائر والتكاليف المحتملة، محل مؤونات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_718_19750926_OpEnact_d384310c7e> ;
    dzdoc:replacementText "حتى في حال انعدام وعدم كفاية الأرباح، فإنه يشرع في الاستهلاكات وجمع المؤونات الضرورية لكي تكون الميزانية صحيحة. وإن نقص قيمة الأصول الملحقة بالأصول الثابتة سواء أكانت مسببة بالاستهلاك أو بتغيير الوسائل الفنية أو أي سبب آخر يجب أن تكون ثابتة بالاستهلاكات، كما يجب أن يكون النقص في القيمة لبقية عناصر مال الشركة والخسائر والتكاليف المحتملة، محل مؤونات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_718> ;
