<https://legal.dz/resource/order/1975-09-26/75-59#version_art_442> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يتم الاحتجاج : في موطن الشخص الذي كان يجب عليه وفاء السفتجة أو بآخر موطن معروف له، وفي موطن الأشخاص المعينين في السفتجة لوفائها عند الحاجة، وفي موطن الغير الذي قبلها بطريقة التدخل. ويجب أن يتم كل ذلك بإجراء واحد. وعند وجود بيان مزيف بالنسبة للموطن يتم إجراء التفتيش قبل الاحتجاج ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_442_19750926_OpEnact_085902a461> ;
    dzdoc:replacementText "يجب أن يتم الاحتجاج : في موطن الشخص الذي كان يجب عليه وفاء السفتجة أو بآخر موطن معروف له، وفي موطن الأشخاص المعينين في السفتجة لوفائها عند الحاجة، وفي موطن الغير الذي قبلها بطريقة التدخل. ويجب أن يتم كل ذلك بإجراء واحد. وعند وجود بيان مزيف بالنسبة للموطن يتم إجراء التفتيش قبل الاحتجاج ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
