<https://legal.dz/resource/order/1975-09-26/75-59#art_838_obligation_0_4ab1fcef> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
