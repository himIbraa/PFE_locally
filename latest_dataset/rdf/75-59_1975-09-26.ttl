    dznorm:provisionText "وله أن يمنع تظهيرها من جديد وفي هذه الحالة لا يكون ملزما بالضمان للأشخاص الذين تظهر لهم السفتجة فيما بعد."@ar ;
    dznorm:sourceArticle "art_398" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_398_prohibition_0_18b6151b_action_f9568edd9a> a dznorm:Action ;
    rdfs:label "تظهيرها من جديد وفي هذه"@ar ;
