<https://legal.dz/resource/order/1975-09-26/75-59#version_art_615> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للأجير المساهم في الشركة أن يعين قائما بالإدارة إلا إذا كان عقد عمله سابقا بسنة واحدة على الأقل لتعيينه ومطابقا لمنصب العمل الفعلي ، دون أن يضيع منفعة عقد العمل. ويعتبر كل تعيين مخالف لأحكام هذه الفقرة باطلا . ولا يؤدي هذا البطلان إلى إلغاء المداولات التي ساهم فيها القائم بالإدارة المعين بصورة مخالفة للقانون. في حالة الدمج ، يمكن أن يكون عقد العمل قد أبرم مع إحدى الشركات المدمجة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_615_19750926_OpEnact_b7afd84795> ;
    dzdoc:replacementText "لا يجوز للأجير المساهم في الشركة أن يعين قائما بالإدارة إلا إذا كان عقد عمله سابقا بسنة واحدة على الأقل لتعيينه ومطابقا لمنصب العمل الفعلي ، دون أن يضيع منفعة عقد العمل. ويعتبر كل تعيين مخالف لأحكام هذه الفقرة باطلا . ولا يؤدي هذا البطلان إلى إلغاء المداولات التي ساهم فيها القائم بالإدارة المعين بصورة مخالفة للقانون. في حالة الدمج ، يمكن أن يكون عقد العمل قد أبرم مع إحدى الشركات المدمجة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
