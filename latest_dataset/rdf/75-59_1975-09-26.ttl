    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_372>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_373> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_372>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_373> ;
    dzdoc:usesTerm dzterm:fraudulent_bankruptcy .

<https://legal.dz/resource/order/1975-09-26/75-59#art_377> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_3_sec_1_subsec_3> ;
    dzdoc:eId "art_377" ;
    dzdoc:fullText "تبقى المستندات والسندات والأوراق التي قدمها وكيل التفليسة أثناء سير الدعوى قيد الإطلاع بكتابة الضبط."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_377> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_377_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_377_19750926_OpEnact_f40eb6ad65> ;
