<https://legal.dz/resource/order/1975-09-26/75-59#art_194_obligation_1_c8853d41> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_194_obligation_1_c8853d41_action_875764c43b> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_194> ;
    dznorm:position 1 ;
    dznorm:provisionText "يلحق تقرير الخبرة، الذي يجب إيداعه في ظرف شهرين بكتابة الضبط، بملف الدعوى المرفوعة أمام المحكمة المختصة التي تفصل في الموضوع بعد إيداع التقرير المذكور"@ar ;
    dznorm:sourceArticle "art_194" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_194_obligation_1_c8853d41_action_875764c43b> a dznorm:Action ;
