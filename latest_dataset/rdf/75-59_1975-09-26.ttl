<https://legal.dz/resource/order/1975-09-26/75-59#art_382_extref_cc83b4af> a dzdoc:ExternalReference ;
    rdfs:label "المادتان 42"@ar ;
    dzdoc:frbrUri "/akn/dz/act/order/1966-06-08/66-156#art_42"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/order/1966-06-08/66-156#art_42"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/order/1966-06-08/66-156#art_42" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/order/1966-06-08/66-156"^^xsd:anyURI ;
