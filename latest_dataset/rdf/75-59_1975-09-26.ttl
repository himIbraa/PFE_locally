<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_ثالثا_4> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتمتع المسير بأوسع السلطات للتصرف باسم الشركة في كل الظروف . يخضع المسير لنفس الالتزامات التي يخضع لها مجلس إدارة شركات المساهمة ، مع مراعاة أحكام هذا الفصل. وفي إطار العلاقات مع الغير، تلتزم الشركة حتى بأعمال المسير التي لا تخضع لموضوع الشركة إلا إذا توصلت إلى إثبات أن الغير كان على إطلاع بأن نشاط المسير بعيد عن موضوعها أو لا يمكنه تجاهله نظرا للظروف مع استثناء أن مجرد نشر القانون الأساسي يكفي وحده لتأسيس هذه البينة. تكون بنود القانون الأساسي التي تحد سلطات المسير والمترتبة عن هذه المادة، غير ق"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715___4_19750926_OpEnact_ed348abf2c> ;
    dzdoc:replacementText "يتمتع المسير بأوسع السلطات للتصرف باسم الشركة في كل الظروف . يخضع المسير لنفس الالتزامات التي يخضع لها مجلس إدارة شركات المساهمة ، مع مراعاة أحكام هذا الفصل. وفي إطار العلاقات مع الغير، تلتزم الشركة حتى بأعمال المسير التي لا تخضع لموضوع الشركة إلا إذا توصلت إلى إثبات أن الغير كان على إطلاع بأن نشاط المسير بعيد عن موضوعها أو لا يمكنه تجاهله نظرا للظروف مع استثناء أن مجرد نشر القانون الأساسي يكفي وحده لتأسيس هذه البينة. تكون بنود القانون الأساسي التي تحد سلطات المسير والمترتبة عن هذه المادة، غير قابلة للاحتجاج بها على الغير."@ar ;
    dzdoc:resolutionStatus "resolved" ;
