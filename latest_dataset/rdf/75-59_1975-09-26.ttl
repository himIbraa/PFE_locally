<https://legal.dz/resource/order/1975-09-26/75-59#version_art_28> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل شخص طبيعي أو معنوي ، غير مسجل في السجل التجاري ، يمارس بصفة عادية نشاطا تجاريا ، يكون قد ارتكب مخالفة تعاين و يعاقب عليها طبقا للأحكام القانونية السارية في هذا المجال. وتأمر المحكمة التي تقضي بالغرامة بتسجيل الإشارات أو الشطب الواجب إدراجه في السجل التجاري خلال مهلة معينة و على نفقة المعني."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_28_19750926_OpEnact_549d2f31a8> ;
    dzdoc:replacementText "كل شخص طبيعي أو معنوي ، غير مسجل في السجل التجاري ، يمارس بصفة عادية نشاطا تجاريا ، يكون قد ارتكب مخالفة تعاين و يعاقب عليها طبقا للأحكام القانونية السارية في هذا المجال. وتأمر المحكمة التي تقضي بالغرامة بتسجيل الإشارات أو الشطب الواجب إدراجه في السجل التجاري خلال مهلة معينة و على نفقة المعني."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_28> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_28> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
