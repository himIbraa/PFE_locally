<https://legal.dz/resource/order/1975-09-26/75-59#version_art_136> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "على المزايد بالزيادة أن يتمم الإجراءات والبيع وإذا لم يفعل فيحق القيام بذلك لكل دائن مقيد أو مشتر، على نفقة ومسؤولية وتبعة المزايد بالزيادة ويبقى ضمانه ساريا على حسب القواعد المقررة في المادة 125 الفقرات من 5 إلى 8 والمواد 126 و 127 و 130 الفقرة 3 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_136_19750926_OpEnact_8923b3198b> ;
    dzdoc:replacementText "على المزايد بالزيادة أن يتمم الإجراءات والبيع وإذا لم يفعل فيحق القيام بذلك لكل دائن مقيد أو مشتر، على نفقة ومسؤولية وتبعة المزايد بالزيادة ويبقى ضمانه ساريا على حسب القواعد المقررة في المادة 125 الفقرات من 5 إلى 8 والمواد 126 و 127 و 130 الفقرة 3 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
