    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_453> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_453_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_453> ;
    dzdoc:position 0 ;
    dzdoc:text "إن الوفاء بطريق التدخل يجب إثباته بإبراء يدرج على السفتجة ويعين فيه الشخص الذي حصل الوفاء لمصلحته وإذا لم يعين هذا الشخص عد الوفاء حاصلا لمصلحة الساحب."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_453_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_453> ;
    dzdoc:position 1 ;
    dzdoc:text "يجب أن تسلم السفتجة والاحتجاج إذا كان قد سبق تحريره إلى الموفي بطريق التدخل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_454_condition_0_96033c01> a dznorm:Condition ;
    dznorm:conditionText "وفي حالة تعدد المتدخلين للوفاء"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_454> ;
    dznorm:position 0 .

