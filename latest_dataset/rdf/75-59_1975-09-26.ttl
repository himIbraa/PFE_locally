    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "وإذا لم تقبل الشركة المحال إليها المقترح ، يتعين على الهيئات المؤهلة في الشركة في أجل شهرين ابتداء من تاريخ إبلاغ الرفض، إما العمل على أن يشتري الأسهم أحد المساهمين أو أن يشتريها من الغير، وإما أن تشتريها الشركة بموافقة المحيل قصد تخفيض رأس المال . وإذا لم يتحقق الشراء عند انقضاء الأجل المنصوص عليه في المقطع أعلاه ، تعتبر الموافقة كأنها صادرة. غير أنه يجوز تمديد هذا الأجل بقرار من رئيس المحكمة بناء على طلب الشركة. في حالة عدم الاتفاق على سعر الأسهم ، تبت الجهة القضائية المختصة في هذا الشأن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_57_19750926_OpEnact_006f1a46ba> ;
    dzdoc:replacementText "وإذا لم تقبل الشركة المحال إليها المقترح ، يتعين على الهيئات المؤهلة في الشركة في أجل شهرين ابتداء من تاريخ إبلاغ الرفض، إما العمل على أن يشتري الأسهم أحد المساهمين أو أن يشتريها من الغير، وإما أن تشتريها الشركة بموافقة المحيل قصد تخفيض رأس المال . وإذا لم يتحقق الشراء عند انقضاء الأجل المنصوص عليه في المقطع أعلاه ، تعتبر الموافقة كأنها صادرة. غير أنه يجوز تمديد هذا الأجل بقرار من رئيس المحكمة بناء على طلب الشركة. في حالة عدم الاتفاق على سعر الأسهم ، تبت الجهة القضائية المختصة في هذا الشأن."@ar ;
    dzdoc:resolutionStatus "resolved" ;
