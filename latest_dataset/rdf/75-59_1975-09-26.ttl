<https://legal.dz/resource/order/1975-09-26/75-59#art_132_condition_1_bc61440e> a dznorm:Condition ;
    dznorm:conditionText "وإذا شمل عقد الشراء الذي أحرز عليه المالك الجديد عناصر مختلفة لمحل تجاري، منها ما هو مثقل بقيود ومنها ما هو غير مثقل بقيود، وكانت موجودة بدائرة محكمة واحدة أم لا ووقع بيعها جملة وبثمن واحد أو بأثمان مختلفة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_132> ;
    dznorm:position 1 .

