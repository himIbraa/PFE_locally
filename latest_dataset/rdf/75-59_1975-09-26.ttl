<https://legal.dz/resource/order/1975-09-26/75-59#version_art_72> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للوكيل بالعمولة ، استنادا لاشتراط كتابي مدرج في سند النقل ومطابق للقوانين والأنظمة الجاري بها العمل ومبلغ للمسافر ، و فيما عدا حالة الخطأ العمدي أو الجسيم والمرتكب إما منه بنفسه أو من مستخدمه، وإما من الناقل أو مستخدم هذا الأخير ، أن يشترط إعفاءه كليا أو جزئيا من مسؤوليته عن التأخير أو الأضرار غير البدنية الحاصلة للمسافر."@ar ;
