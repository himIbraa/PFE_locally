<https://legal.dz/resource/order/1975-09-26/75-59#version_art_113> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا طلب بيع المحل التجاري بالمزايدة العلنية سواء كان بطلب وكيل التفليسة، أو التسوية القضائية، أو المصفين أو كان الطلب صادرا عن أي صاحب حق آخر ، وجب على الطالب إبلاغ طلبه بواسطة إجراء غير قضائي للبائعين السابقين في محل الإقامة المختار والمعين في قيودهم مع التصريح بأنهم إذا لم يرفعوا دعوى الفسخ خلال شهر من تاريخ التبليغ سقط حقهم فيها تجاه الراسي عليه المزاد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_113_19750926_OpEnact_6b7b9b13ab> ;
    dzdoc:replacementText "إذا طلب بيع المحل التجاري بالمزايدة العلنية سواء كان بطلب وكيل التفليسة، أو التسوية القضائية، أو المصفين أو كان الطلب صادرا عن أي صاحب حق آخر ، وجب على الطالب إبلاغ طلبه بواسطة إجراء غير قضائي للبائعين السابقين في محل الإقامة المختار والمعين في قيودهم مع التصريح بأنهم إذا لم يرفعوا دعوى الفسخ خلال شهر من تاريخ التبليغ سقط حقهم فيها تجاه الراسي عليه المزاد ."@ar ;
