<https://legal.dz/resource/order/1975-09-26/75-59#art_83_obligation_2_e2346af7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_83_obligation_2_e2346af7_action_745963d298> ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-59#art_83_obligation_2_e2346af7_role_057af1bfa2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_83_obligation_2_e2346af7_role_4430bfa066> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_83> ;
    dznorm:position 2 ;
    dznorm:provisionText "ويجب أن يشتمل الملخص المذكور تحت طائلة الإبطال كذلك، على تواريخ ومقادير التحصيل ورقمه أو في حالة التصريح البسيط، على تاريخ ورقم الإيصال الخاص بهذا التصريح، والإشارة في الحالتين، إلى المكتب الذي تمت فيه هذه العمليات."@ar ;
    dznorm:sourceArticle "art_83" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_83_obligation_2_e2346af7_action_745963d298> a dznorm:Action ;
