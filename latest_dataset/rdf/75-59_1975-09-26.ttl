<https://legal.dz/resource/order/1975-09-26/75-59#art_100_condition_0_67e2262c> a dznorm:Condition ;
    dznorm:conditionText "إذا نشأ عنه ضرر لغير المتعاقدين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_100> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_100_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_100> ;
    dzdoc:position 0 ;
    dzdoc:text "يترتب على إهمال واحد أو أكثر من البيانات الواردة في المادة 98 بطلان إذا نشأ عنه ضرر لغير المتعاقدين. ولا يجوز أن يطلب الحكم بهذا البطلان إلا الأشخاص الذين لحقهم ضرر من جراء الإهمال أو الإخلال ويمكن للمحاكم أن تقرر حسب أهمية الضرر ونوعه إبطال وحصر مفعوله."@ar .

