<https://legal.dz/resource/order/1975-09-26/75-59#version_art_424> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على مالك السفتجة الضائعة لأجل الحصول على نسخة ثانية منها أن يطلب من المظهر الأخير قبله أن يمده بما هو واجب عليه من المساعدة باسمه وعنايته للسعي لدى المظهر له السابق وهكذا يجري الرجوع على هذا المنوال من مظهر إلى مظهر حتى يصل إلى ساحب السفتجة ويتحمل مالك السفتجة الضائعة المصاريف ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_424_19750926_OpEnact_ecb06f2e0f> ;
