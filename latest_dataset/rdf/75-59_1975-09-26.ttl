<https://legal.dz/resource/order/1975-09-26/75-59#version_art_502> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد التقديم المادي للشيك إلى إحدى غرف المقاصة بمثابة تقديم للوفاء. يمكن أن يتم هذا التقديم أيضا، بأية وسيلة تبادل إلكترونية محددة في التشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_502_19750926_OpEnact_f4434b41e6> ;
