    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_251_19750926_OpEnact_d242df8d87> ;
    dzdoc:replacementText "لا يصح التمسك قبل جماعة الدائنين بالرهون الحيازية والامتيازات التي سجلت بعد صدور الحكم الذي قضى بالتسوية القضائية أو شهر الإفلاس . غير أن الخزينة العامة تبقى متمسكة بامتيازها على الديون التي كانت غير ملزمة بتسجيلها في تاريخ الحكم الذي قضى بالتسوية القضائية أو شهر الإفلاس وللديون المعروضة للتحصيل بعد ذلك التاريخ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_251> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_251> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_252> a dzdoc:AmendmentEvent,
