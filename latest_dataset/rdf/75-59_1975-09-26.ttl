<https://legal.dz/resource/order/1975-09-26/75-59#art_176_obligation_0_a25ce180_ref_c071a27adec4> a dzdoc:Reference ;
    rdfs:label "المادة 177"@ar ;
    dzdoc:frbrUri "#art_177"^^xsd:anyURI ;
