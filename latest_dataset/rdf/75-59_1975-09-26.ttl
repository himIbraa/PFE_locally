    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "إذا لم تتمكن الجمعية المكلفة بإقفال التصفية المنصوص عليها في المادة السابقة أو رفضت التصديق عن حسابات المصفي"@ar ;
    dzdoc:targetEId "art_773" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_774_obligation_0_741c5049> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_774> ;
    dznorm:position 0 ;
    dznorm:provisionText "يضع المصفي حساباته بكتابة المحكمة"@ar ;
    dznorm:sourceArticle "art_774" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_774_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_774> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا لم تتمكن الجمعية المكلفة بإقفال التصفية المنصوص عليها في المادة السابقة أو رفضت التصديق عن حسابات المصفي فإنه يحكم بقرار قضائي بطلب من المصفي أو كل من يهمه الأمر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_774_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_774> ;
    dzdoc:position 1 ;
    dzdoc:text "ولهذا الغرض يضع المصفي حساباته بكتابة المحكمة حيث يتمكن كل معني بالأمر من أن يطلع عليها ويحصل على نسخة منها على نفقته."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_774_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_774> ;
    dzdoc:position 2 ;
    dzdoc:text "وتتولى المحكمة النظر في هذه الحسابات وعند الاقتضاء في إقفال التصفية حالة بذلك محل جمعية المشتركين أو المساهمين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_774_right_0_2fe2336f> a dznorm:Right ;
