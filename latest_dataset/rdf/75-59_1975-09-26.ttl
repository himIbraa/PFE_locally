<https://legal.dz/resource/order/1975-09-26/75-59#version_art_202> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان المؤجر في نفس الوقت مالكا للعمارة المؤجرة والمحل التجاري المستغل وكان الإيجار يشمل العمارة والمتجر في نفس الوقت ، فإنه يجب على المؤجر أن يسدد للمستأجر عند مغادرته، تعويضا يكون مطابقا للفائدة التي يمكن له أن يحصل عليها من زيادة القيمة الحاصلة سواء من المتجر أو القيمة الايجارية للعمارة بفضل التحسينات المادية التي قام بها المستأجر بالاتفاق مع المالك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_202_19750926_OpEnact_06d6bd7f6a> ;
    dzdoc:replacementText "إذا كان المؤجر في نفس الوقت مالكا للعمارة المؤجرة والمحل التجاري المستغل وكان الإيجار يشمل العمارة والمتجر في نفس الوقت ، فإنه يجب على المؤجر أن يسدد للمستأجر عند مغادرته، تعويضا يكون مطابقا للفائدة التي يمكن له أن يحصل عليها من زيادة القيمة الحاصلة سواء من المتجر أو القيمة الايجارية للعمارة بفضل التحسينات المادية التي قام بها المستأجر بالاتفاق مع المالك ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_202> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
