<https://legal.dz/resource/order/1975-09-26/75-59#version_art_710> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تفقد الأسهم المستهلكة كليا أو جزئيا ما يعادل الحق في الربح الأولي وإذا اقتضى الأمر، في تعويض القيمة الاسمية، وتحتفظ بكل الحقوق الأخرى."@ar ;
    dzdoc:isAuthoritative true ;
