<https://legal.dz/resource/order/1975-09-26/75-59#art_174_obligation_4_eae6018b_ref_b5e8f2a9d00d> a dzdoc:Reference ;
    rdfs:label "المادة 194"@ar ;
    dzdoc:frbrUri "#art_194"^^xsd:anyURI ;
