<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_28_obligation_0_6ad601c0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_28> ;
    dznorm:position 0 ;
    dznorm:provisionText "يخضعون لنفس مسؤولية القائمين بالإدارة"@ar ;
    dznorm:sourceArticle "art_715_bis_28" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_28_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_28> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما تكون الشركة خاضعة لأحكام المواد من 644 إلى 672 المذكورة أعلاه، فإن أعضاء مجلس المديرين يخضعون لنفس مسؤولية القائمين بالإدارة. وفي حالة الإفلاس أو التسوية القضائية، يمكن أن يتحمل أعضاء مجلس المديرين المسؤولية عن ديون الشركة ويخضعون للموانع وسقوط الحق المنصوص عليها في الموضوع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_28_permission_0_c4a18c94> a dznorm:Permission ;
