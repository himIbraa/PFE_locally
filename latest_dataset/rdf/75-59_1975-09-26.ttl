    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_187> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_187_obligation_1_a8b66081> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-59#art_187_obligation_1_a8b66081_ref_96d0f97fe7a0> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_178> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_178> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_187> ;
    dznorm:position 1 ;
    dznorm:provisionText "يلزم المستأجر بمغادرة الأماكن في الحالة المنصوص عليها في الفقرة الثانية من المادة 178 ، فور سداد التعويض المؤقت الذي يحدده رئيس المحكمة الذي يبت في القضية"@ar ;
    dznorm:sourceArticle "art_187" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_187_obligation_1_a8b66081_ref_96d0f97fe7a0> a dzdoc:Reference ;
    rdfs:label "المادة 178"@ar ;
    dzdoc:frbrUri "#art_178"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1975-09-26/75-59#art_178> ;
    dzdoc:sourceEId "art_187" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يلزم المستأجر بمغادرة الأماكن في الحالة المنصوص عليها في الفقرة الثانية من المادة 178 ، فور سداد التعويض المؤقت الذي يحدده رئيس المحكمة الذي يبت في القضية"@ar ;
    dzdoc:targetEId "art_178" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_187_obligation_2_bf1c0c79> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_187> ;
    dznorm:position 2 ;
    dznorm:provisionText "تسلم الأماكن للمؤجر في أول يوم من الأجل المألوف والتالي لانقضاء مهلة الخمسة عشر يوما اعتبارا من يوم تسديد التعويض للمستأجر نفسه، أو احتماليا بين أيدي حارس قضائي"@ar ;
    dznorm:sourceArticle "art_187" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_187_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_187> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يجوز إلزام أي مستأجر يمكنه المطالبة بـ تعويض الإخلاء بمغادرة الأماكن قبل قبض التعويض. وله الحق في البقاء في هذه الأماكن أن يدفع له هذا التعويض طبقا لشروط وبنود عقد الإيجار الذي انقضى أجله. غير أن التعويض الخاص بالشغل يحدد طبقا لأحكام الفصل الخامس مع أخذ العناصر التقديرية بعين الاعتبار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_187_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_187> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أنه وخلافا لأحكام الفقرة السابقة، يلزم المستأجر بمغادرة الأماكن في الحالة المنصوص عليها في الفقرة الثانية من المادة 178 ، فور سداد التعويض المؤقت الذي يحدده رئيس المحكمة الذي يبت في القضية، وذلك بناء على الخبرة التي يكون سبق أن أمر بها وفقا للأوضاع المنصوص عليها في الفقرة الثانية من المادة 194."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_187_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_187> ;
    dzdoc:position 2 ;
    dzdoc:text "وفي حالة الإخلاء، تسلم الأماكن للمؤجر في أول يوم من الأجل المألوف والتالي لانقضاء مهلة الخمسة عشر يوما اعتبارا من يوم تسديد التعويض للمستأجر نفسه، أو احتماليا بين أيدي حارس قضائي، وفي حالة عدم حصول اتفاق بين الطرفين يعين الحارس القضائي بموجب حكم يقضي بدفع التعويض وإلا فبمجرد أمر مستعجل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_187_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_187> ;
    dzdoc:position 3 ;
    dzdoc:text "يدفع الحارس القضائي التعويض للمستأجر مقابل إيصال منه فقط إن لم تقع معارضة من الدائنين، ولقاء تسليم مفاتيح المحل الفارغ إذا قدم ما يثبت دفع الضرائب والأجور ومع مراعاة التعويضات المتعلقة بالإيجار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_187_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_187> ;
    dzdoc:position 4 ;
    dzdoc:text "وفي حالة عدم تسليم المفاتيح في التاريخ المحدد وبعد الإنذار، يمسك الحارس القضائي واحدا بالمائة من مبلغ التعويض عن كل يوم تأخير ، ويسلم هذا المبلغ المقتطع للمؤجر، مقابل إيصال منه فقط."@ar .

