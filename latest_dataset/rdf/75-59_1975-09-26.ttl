<https://legal.dz/resource/order/1975-09-26/75-59#art_137> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_137" ;
    dzdoc:fullText "إذا لم تحصل مزايدة عد الدائن المزايد بالزيادة الراسي على المزايد. يتعين على الراسي عليه المزاد أن يتسلم المعدات والبضائع الموجودة بالمحل عند حيازته له بالثمن على أساس الخبرة الرضائية أو القضائية بحضور كل من المشتري المزاد عليه وبائعه والراسي عليه المزاد. ويكون ملزما زيادة على مبلغ مرسى المزاد بأن يسدد للمشتري الذي انتزعت منه الحيازة، النفقات والمصاريف القانونية لعقد شرائه مع مصاريف التبليغات والقيد والنشر المشار إليها في المواد 83 و 84 و 97 و 109 ومن 116 إلى 119 أعلاه ولمن كان لهم الحق فيها للتوصل لإعادة البيع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_137> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_137_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_137_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_137_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_137_19750926_OpEnact_516c54bdf8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_137_obligation_0_26f944b9>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_137_obligation_1_ab6d3f4d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 137" ;
    dzdoc:position 139 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_109>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_116>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_119>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_83>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_84>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_97> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_109>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_116>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_119>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_83>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_84>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_97> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_137_condition_0_c0931230> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_153> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_8> ;
    dzdoc:eId "art_153" ;
    dzdoc:fullText "يجب أن يقيد الرهن الحيازي، طبقا للشروط الواردة في المادتين 120 و 121 و في مهلة ثلاثين يوما من تاريخ العقد المنشئ للرهن الحيازي، وإلا عد باطلا . و يجب أن يبرم عقد الرهن في مهلة أقصاها شهر واحد ابتداء من تاريخ تسليم معدات التجهيز بنفس المكان الذي يجب إنشاؤها فيه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_153> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_153_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_153_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_153_19750926_OpEnact_3bacb6031f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_153_obligation_0_32aa2b14>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_153_obligation_1_24429b56> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 153" ;
    dzdoc:position 155 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_120>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_121> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_120>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_121> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_180> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_2_sec_3> ;
    dzdoc:eId "art_180" ;
    dzdoc:fullText "عندما تزيد مساحة العمارة التي أعيد بناؤها حسب الشروط المنصوص عليها في المادة 177 عن مساحة العمارة القديمة ، يقتصر حق الأولوية على محلات تكون مساحتها مماثلة لمساحة المحلات المشغولة سابقا أو التي من شأنها أن تلبي نفس الحاجات التجارية التي كانت عليها هذه المحلات الأخيرة . وعندما لا تسمح العمارة التي أعيد بناؤها بإعادة جميع الشاغلين ، تمنح الأفضلية للمستأجرين أصحاب الإيجارات الأكثر قدما، والذين أعربوا عن نيتهم في شغل هذه الأماكن ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_180_right_0_b1abcf2e>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_180_right_1_87b7cc10> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_180> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_180_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_180_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_180_19750926_OpEnact_887b844a0b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 180" ;
    dzdoc:position 182 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_177> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_177> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_180_condition_0_58061f90>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_180_condition_1_40382651> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_185> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_2_sec_3> ;
    dzdoc:eId "art_185" ;
    dzdoc:fullText "لا يجوز رفض تجديد الإيجارات الخاصة بالعمارات التابعة للدولة أو الولايات أو البلديات أو المؤسسات العمومية دون أن تكون الجماعة المالكة ملزمة بسداد تعويض الإخلاء المنصوص عليه في المادة 176 حتى ولو كان رفضها مبررا بباعث المنفعة العمومية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_185_permission_0_80d0c901> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_185> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_185_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_185_19750926_OpEnact_06f33f473b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_185_obligation_0_13fc057c> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_185_prohibition_0_80d0c901> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "185" ;
    dzdoc:position 187 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-59#art_176> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-59#art_176> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_229> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_2> ;
    dzdoc:eId "art_229" ;
    dzdoc:fullText "عندما لا تكون الأموال الخاصة بالتفليسة كافية على الفور لتغطية مصاريف التسوية القضائية أو شهر الإفلاس ولإعلان ونشر هذا الحكم في الصحف واللصق ووضع الأختام ورفعها ، فإن هذه المصاريف قد يسبقها أحد الدائنين إذا كان هو الذي رفع الدعوى لدى المحكمة . و إذا كانت المحكمة هي التي تولت فصل القضية تلقائيا تسبق المصاريف الخزينة العامة. وعلى كل حال تسدد التسبيقات على وجه الامتياز من أول التحصيلات . ويسري هذا التدبير على إجراءات استئناف الحكم الصادر بالتسوية القضائية أو شهر الإفلاس."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_229> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_229_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_229_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_229_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_229_19750926_OpEnact_43cf895b29> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_229_obligation_0_fafc7674> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 229" ;
    dzdoc:position 233 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_229_condition_0_be7f63c4>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_229_condition_1_18d84444>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_229_condition_2_c1e588fb> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_260> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_5_subsec_3> ;
    dzdoc:eId "art_260" ;
    dzdoc:fullText "إذا أمرت المحكمة بوضع الأختام فللقاضي المنتدب بناء على طلب وكيل التفليسة إعفاءه من وضع الأختام على الأشياء التالية أو الإذن له باستخراجها : المنقولات والأمتعة اللازمة للمدين ولأسرته، طبقا للبيان المعروض عليه، الأشياء المعروضة للتلف القريب أو انخفاض القيمة الوشيك، ما يلزم استعماله في نشاطه الصناعي أو مؤسسته إن كان رخص له باستمرار الاستغلال. ويقوم وكيل التفليسة بتحرير قائمة جرد بالأشياء المشار إليها في هذه المادة مع تقويمها ويكون هذا بحضور القاضي المنتدب الذي يوقع المحضر ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_260_right_0_732feb64> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_260> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_260_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_260_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_260_19750926_OpEnact_a8ab5a5ae2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_260_obligation_0_9c35edcd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "260" ;
    dzdoc:position 265 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_260_condition_0_c3113ed3> ;
    dzdoc:usesTerm dzterm:trustee .

<https://legal.dz/resource/order/1975-09-26/75-59#art_308> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_3_chp_1_sec_6_subsec_5> ;
    dzdoc:eId "art_308" ;
    dzdoc:fullText "يجوز استرداد البضائع التي فسخ بيعها قبل الحكم بالتسوية القضائية أو بالإفلاس سواء كان هذا بحكم قضائي أو من جراء شرط فسخ اتفاقي، وذلك ما دامت هذه البضائع قائمة عينا كلها أو بعضها ويتعين أيضا قبول الاسترداد رغم الحكم بفسخ البيع أو تقرير وجوده بمقتضى حكم قضائي تال للحكم بالتسوية القضائية أو بالإفلاس، وذلك متى كانت دعوى الاسترداد أو الفسخ قد رفعها البائع، الذي لم يستوف الثمن قبل الحكم المنشيء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_308_permission_0_bcc2d799> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_308_right_0_1b0dc435> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_308> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_308_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_308_19750926_OpEnact_b1048c6af9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "308" ;
    dzdoc:position 313 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_308_condition_0_1410172c>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_308_condition_1_b588bf26> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_32> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_1_chp_4_sec_2> ;
    dzdoc:eId "art_32" ;
    dzdoc:fullText "لا يستمر الامتياز في جميع الأحوال على المرهون إلا إذا وضع هذا الأخير في حيازة الدائن وبقي لديه أو لدى الغير المتفق عليه بين الطرفين . ويعتبر الدائن حائزا للبضائع متى كانت تحت تصرفه في مخازنه أو سفنه، أو في الجمرك أو في مستودع عمومي أو كان بيد الدائن قبل وصولها وثيقة الشحن أو أي سند نقل آخر معادل لها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_32> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_32_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_32_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_32_19750926_OpEnact_4b10b5f196> ;
