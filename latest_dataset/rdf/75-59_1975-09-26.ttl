<https://legal.dz/resource/order/1975-09-26/75-59#version_art_557> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعرض التقرير الصادر عن عمليات السنة المالية وإجراء الجرد، وحساب الاستغلال العام وحساب النتائج والميزانية الموضوعة من المديرين على جمعية الشركاء للمصادقة عليها، وذلك في أجل ستة أشهر ابتداء من قفل السنة المالية . ولهذا الغرض توجه المستندات المشار إليها في الفقرة المتقدمة وكذلك نص القرارات المقترحة، إلى الشركاء قبل خمسة عشر يوما من اجتماع الجمعية . ويمكن إبطال كل مداولة جارية خلافا لهذه الفقرة. لا تسري أحكام هذه المادة إذا كان جميع الشركاء مديرين. ويعتبر كل شرط مخالف لأحكام هذه المادة كأن لم يكن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_557_19750926_OpEnact_c2cf34b7bf> ;
    dzdoc:replacementText "يعرض التقرير الصادر عن عمليات السنة المالية وإجراء الجرد، وحساب الاستغلال العام وحساب النتائج والميزانية الموضوعة من المديرين على جمعية الشركاء للمصادقة عليها، وذلك في أجل ستة أشهر ابتداء من قفل السنة المالية . ولهذا الغرض توجه المستندات المشار إليها في الفقرة المتقدمة وكذلك نص القرارات المقترحة، إلى الشركاء قبل خمسة عشر يوما من اجتماع الجمعية . ويمكن إبطال كل مداولة جارية خلافا لهذه الفقرة. لا تسري أحكام هذه المادة إذا كان جميع الشركاء مديرين. ويعتبر كل شرط مخالف لأحكام هذه المادة كأن لم يكن."@ar ;
    dzdoc:resolutionStatus "resolved" ;
