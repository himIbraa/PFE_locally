<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_89_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_89> ;
    dzdoc:position 0 ;
    dzdoc:text "يمثل جماعة أصحاب سندات الاستحقاق وكيل أو عدة وكلاء، يعينون في الجمعية العامة غير العادية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_89_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_89> ;
    dzdoc:position 1 ;
    dzdoc:text "تحدد الشروط التي يجب أن يستوفيها وكلاء سندات الاستحقاق وكذا حقوقهم وقوانينهم الأساسية عن طريق التنظيم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_8_condition_0_6a6c08fa> a dznorm:Condition ;
    dznorm:conditionText "وإذا تمت تلبية الطلب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_8> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_8_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_8> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز لمساهم أو عدة مساهمين يمثلون على الأقل عشر (10/1) رأسمال الشركة، في الشركات التي تلجأ علنية للإدخار، أن يطلبوا من العدالة، وبناء على سبب مبرر، رفض مندوب، أو مندوبي الحسابات الذين عينتهم الجمعية العامة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_8_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_8> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا تمت تلبية الطلب، تعين العدالة مندوبا جديدا للحسابات ويبقى هذا الأخير في وظيفته حتى قدوم مندوب الحسابات الذي تعينه الجمعية العامة."@ar .

