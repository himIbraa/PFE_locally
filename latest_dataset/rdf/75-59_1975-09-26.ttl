    dzdoc:number "715 مكرر 49" ;
    dzdoc:position 823 ;
    dzdoc:usesTerm dzterm:shares .

<https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_67> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_3_subsec_11_subsubsec_3> ;
    dzdoc:eId "art_715_bis_67" ;
    dzdoc:fullText "لا يجوز التنازل عن شهادة الحق في التصويت إلا إذا كانت مرفقة بشهادة الاستثمار ، غير أنه يجوز التنازل عنها لحامل شهادة الاستثمار . ويعاد تكوين السهم بقوة القانون بين يدي حامل شهادة الاستثمار وشهادة الحق في التصويت. ولا يجوز منح شهادة تمثل أقل من حق واحد في التصويت."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_67_permission_0_676cade1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_67_permission_1_06e7806a> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_67_right_0_bfa3e25d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_67> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_67_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_67_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_67_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_67_19750926_OpEnact_4f91043559> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_67_obligation_0_2ccf76e2>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_67_obligation_1_06e7806a> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_67_prohibition_0_676cade1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "715 مكرر 67" ;
    dzdoc:position 841 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_785> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_5_chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_785" ;
    dzdoc:fullText "لا يجوز أن تتجاوز مدة وكالة المصفي ثلاثة أعوام ، غير أنه يمكن تجديد هذه الوكالة من طرف الشركاء أو رئيس المحكمة بحسب ما إذا كان المصفي قد عين من طرف الشركاء أو بقرار قضائي. إذا لم يكن بالإمكان انعقاد جمعية الشركاء بصفة قانونية ، جددت الوكالة بقرار قضائي بناء على طلب المصفي . يجب على المصفي عند طلب تجديد وكالته أن يبين الأسباب التي حالت دون إقفال التصفية والتدابير التي ينوي اتخاذها والآجال التي يقتضيها إتمام التصفية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-59#art_785_permission_0_ccb9523e> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-59#art_785_right_0_9bce528b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_785> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_785_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_785_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_785_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_785_19750926_OpEnact_e3f1b7eb58> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_785_obligation_0_d055b64c>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_785_obligation_1_bf1be255> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-59#art_785_prohibition_0_ccb9523e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "785" ;
    dzdoc:position 992 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_785_condition_0_6c9c8b82> ;
    dzdoc:usesTerm dzterm:liquidator .

<https://legal.dz/resource/order/1975-09-26/75-59#art_99> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_99" ;
    dzdoc:fullText "إذا كان البيع أو التنازل عن المحل التجاري يشتمل على علامات المصنع والتجارة أو الرسوم أو النماذج الصناعية بما فيها الرهون الحيازية المتعلقة بالمحل التجاري والشاملة لبراءات الاختراع أو الرخص أو العلامات أو الرسوم أو النماذج ، فيجب زيادة على ما تقدم، قيد هذه الرهون في المعهد الجزائري للملكية الصناعية وتنظيمها بناء على تقديم شهادة القيد المسلمة من مأموري السجل التجاري في حدود الثلاثين يوما التابعة لهذا القيد ، تحت طائلة البطلان تجاه الغير والبيوعات والتنازلات أو الرهون بشمول البيع ببراءات الاختراع والرخص والعلامات التجارية والأشكال والنماذج الصناعية. وتبقى براءات الاختراع التي شملها التنازل عن المحل التجاري خاضعة فيما يخص طرق انتقالها إلى القواعد التي يقررها التشريع الساري المفعول."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-59#version_art_99> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-59#art_99_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-59#art_99_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_99_19750926_OpEnact_c5e8e44ed6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-59#art_99_obligation_0_049787dc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "99" ;
    dzdoc:position 101 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-59#art_99_condition_0_193249c0> .

