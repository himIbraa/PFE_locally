<https://legal.dz/resource/order/1975-09-26/75-59#version_art_60> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للموكل أن يرفع مباشرة على الناقل كل دعوى متولدة عن عقد النقل ، و يكون الوكيل بالعمولة مكلفا قانونا بالحضور فيها . ويجوز للناقل أن يرفع مباشرة على الموكل دعوى بطلب التعويض عن الأضرار الحاصلة له من جراء تنفيذ عقد النقل ، و يكون الوكيل بالعمولة مكلفا قانونا بالحضور فيها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_60_19750926_OpEnact_c73c312021> ;
    dzdoc:replacementText "يجوز للموكل أن يرفع مباشرة على الناقل كل دعوى متولدة عن عقد النقل ، و يكون الوكيل بالعمولة مكلفا قانونا بالحضور فيها . ويجوز للناقل أن يرفع مباشرة على الموكل دعوى بطلب التعويض عن الأضرار الحاصلة له من جراء تنفيذ عقد النقل ، و يكون الوكيل بالعمولة مكلفا قانونا بالحضور فيها ."@ar ;
