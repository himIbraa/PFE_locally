    dzdoc:position 0 ;
    dzdoc:text "إن دفع المكافآت لأعضاء مجلس الإدارة متوقف حسب كل حالة على دفع الأرباح للمساهمين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_728_obligation_0_3cd78e26> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
