    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_559> ;
    dznorm:position 3 .

<https://legal.dz/resource/order/1975-09-26/75-59#art_559_obligation_0_b4d758b0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
