<https://legal.dz/resource/order/1975-09-26/75-59#art_449_obligation_2_3af1ff3d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-59#art_449_obligation_2_3af1ff3d_action_689c9ee098> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_449> ;
    dznorm:position 2 ;
    dznorm:provisionText "يجب أن يتضمن تعيين الشخص الذي صدر لحسابه"@ar ;
    dznorm:sourceArticle "art_449" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_449_obligation_2_3af1ff3d_action_689c9ee098> a dznorm:Action ;
    rdfs:label "أن يتضمن تعيين الشخص الذي"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب أن يتضمن تعيين الشخص الذي صدر لحسابه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_449> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_449_obligation_3_9df57d8c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_449> ;
    dznorm:position 3 ;
    dznorm:provisionText "من قبل بطريق التدخل يكون ملزما قبل الحامل والمظهرين اللاحقين لمن صدر التدخل لمصلحته، بما الزم به هذا الأخير"@ar ;
    dznorm:sourceArticle "art_449" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_449_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_449> ;
    dzdoc:position 0 ;
    dzdoc:text "إن القبول بطريق التدخل يمكن حصوله في جميع الأحوال التي تكون فيها لحامل سفتجة واجبة التقديم للقبول حق الرجوع قبل الاستحقاق."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_449_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_449> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا تضمنت السفتجة تعيين من يقبلها أو يدفع قيمتها عند الاقتضاء في مكان الأداء، فلا يمكن للحامل ممارسة حقوقه في الرجوع قبل الاستحقاق على من صدر منه هذا التعيين أو على الموقعين اللاحقين له إلا إذا قدم السفتجة للشخص المعين فرفض قبولها وأثبت هذا الرفض باحتجاج."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_449_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_449> ;
    dzdoc:position 2 ;
    dzdoc:text "وفي غير ذلك من أحوال التدخل يمكن للحامل رفض القبول عن طريق التدخل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_449_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_449> ;
    dzdoc:position 3 ;
    dzdoc:text "بيد أنه إذا رضي بالتدخل، فإنه يفقد حقه في الرجوع قبل الاستحقاق على الشخص الذي حصل القبول لمصلحته وعلى الموقعين اللاحقين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_449_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_449> ;
    dzdoc:position 4 ;
    dzdoc:text "ويذكر القبول بطريق التدخل في السفتجة. ويوقع من طرف المتدخل. كما يجب أن يتضمن تعيين الشخص الذي صدر لحسابه، وإذا أقفل هذا البيان عد القبول صادرا لمصلحة الساحب."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_449_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_449> ;
    dzdoc:position 5 ;
    dzdoc:text "من قبل بطريق التدخل يكون ملزما قبل الحامل والمظهرين اللاحقين لمن صدر التدخل لمصلحته، بما الزم به هذا الأخير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_449_para_6> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_449> ;
    dzdoc:position 6 ;
    dzdoc:text "وبالرغم من القبول بطريق التدخل يحق لمن صدر لمصلحته ولضامنيه أن يطلبوا من الحامل مقابل تسديد المبلغ المبين في المادة 433 تسلم السفتجة والاحتجاج مع إيصال بالإبراء عند الاقتضاء."@ar .

