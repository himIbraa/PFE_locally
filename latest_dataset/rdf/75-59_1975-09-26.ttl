<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_11> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لمندوب الحسابات أن يطلب توضيحات من رئيس مجلس الإدارة أو مجلس المديرين الذي يتعين عليه أن يرد على كل الوقائع التي من شأنها أن تعرقل استمرار الاستغلال والتي اكتشفها أثناء ممارسة مهامه . وفي حالة انعدام الرد أو إذا كان هذا الرد ناقصا يطلب مندوب الحسابات من الرئيس أو مجلس المديرين استدعاء مجلس الإدارة أو مجلس المراقبة للمداولة في الوقائع الملاحظة ، ويتم استدعاء مندوب الحسابات في هذه الجلسة. وفي حالة عدم احترام هذه الأحكام، أو إذا لاحظ مندوب الحسابات أنه رغم اتخاذ هذه القرارات بقيت مواصلة الاستغ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_11_19750926_OpEnact_480c3d6c41> ;
    dzdoc:replacementText "يجوز لمندوب الحسابات أن يطلب توضيحات من رئيس مجلس الإدارة أو مجلس المديرين الذي يتعين عليه أن يرد على كل الوقائع التي من شأنها أن تعرقل استمرار الاستغلال والتي اكتشفها أثناء ممارسة مهامه . وفي حالة انعدام الرد أو إذا كان هذا الرد ناقصا يطلب مندوب الحسابات من الرئيس أو مجلس المديرين استدعاء مجلس الإدارة أو مجلس المراقبة للمداولة في الوقائع الملاحظة ، ويتم استدعاء مندوب الحسابات في هذه الجلسة. وفي حالة عدم احترام هذه الأحكام، أو إذا لاحظ مندوب الحسابات أنه رغم اتخاذ هذه القرارات بقيت مواصلة الاستغلال معرقلة فإنه يقوم حينئذ بإعداد تقرير خاص يقدمه لأقرب جمعية عامة مقبلة أو لجمعية عامة غير عادية، في حالة الاستعجال ، يقوم هو نفسه باستدعائها لتقديم خلاصاته ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_11> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-59#art_715_bis_11> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-59#version_art_715_bis_110> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ترخص الجمعية العامة غير العادية للمساهمين بإصدار القيم المنقولة ، بناء على تقرير مجلس الإدارة أو مجلس المراقبة أو مجلس المديرين و مندوب الحسابات . ويجيز قرار الجمعية العامة غير العادية بقوة القانون لصالح حاملي هذه القيم المنقولة ، تنازل المساهمين عن حقهم في الأفضلية للاكتتاب في السندات التي تعطي الحق فيه."@ar ;
