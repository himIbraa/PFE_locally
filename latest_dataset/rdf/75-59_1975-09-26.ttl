<https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_3> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن المودع الذي يريد بيع بضاعته إذا لم تكن مرهونة ، أن يظهر الوصل لإذن المشتري ويرفقه بسند الخزن . لا يظهر المودع الذي اقترض على البضاعة، إلا الوصل ويعتبر منذ ذلك الوقت ملزما بتسديد سند الخزن مسبقا أو بإيداع المبلغ لدى إدارة المخزن العام المعني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_543_bis_3_19750926_OpEnact_d10426b961> ;
