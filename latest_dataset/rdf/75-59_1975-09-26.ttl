<https://legal.dz/resource/order/1975-09-26/75-59#version_art_212> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد باطلا، كل عقد بتأجير التسيير أو اتفاق آخر يتضمن شروطا مماثلة وافق عليها المالك أو المستغل للمحل التجاري دون أن تتوفر فيها الشروط المنصوص عليها في المواد المشار إليه أعلاه ، غير أنه لا يجوز للمتعاقدين التمسك بهذا البطلان تجاه الغير. ويترتب على البطلان المنصوص عليه في الفقرة السابقة بالنسبة للمتعاقدين سقوط الحق الذي قد يحصلون عليه من جراء الأحكام المتعلقة بالإيجارات التجارية المحددة للعلاقات التي تقوم بين المؤجرين والمستأجرين وذلك فيما يتعلق بتجديد إيجارات العقارات أو الأماكن ذات الاستعمال الت"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-59#version_art_212_19750926_OpEnact_8817e1fa5d> ;
    dzdoc:replacementText "يعد باطلا، كل عقد بتأجير التسيير أو اتفاق آخر يتضمن شروطا مماثلة وافق عليها المالك أو المستغل للمحل التجاري دون أن تتوفر فيها الشروط المنصوص عليها في المواد المشار إليه أعلاه ، غير أنه لا يجوز للمتعاقدين التمسك بهذا البطلان تجاه الغير. ويترتب على البطلان المنصوص عليه في الفقرة السابقة بالنسبة للمتعاقدين سقوط الحق الذي قد يحصلون عليه من جراء الأحكام المتعلقة بالإيجارات التجارية المحددة للعلاقات التي تقوم بين المؤجرين والمستأجرين وذلك فيما يتعلق بتجديد إيجارات العقارات أو الأماكن ذات الاستعمال التجاري أو الصناعي أو الحرفي."@ar ;
