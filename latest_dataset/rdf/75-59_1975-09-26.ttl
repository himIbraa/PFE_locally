    dzdoc:hasPeriod <https://legal.dz/resource/order/1975-09-26/75-59#art_125_obligation_2_0757cb8e_period_97e297cd8d> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_125> ;
    dznorm:position 2 ;
    dznorm:provisionText "يجب أن تبت المحكمة في الدعوى خلال شهرين من أول جلسة بموجب حكم غير قابل للمعارضة فيه وقابل للتنفيذ بالرغم من جميع طرق الطعن"@ar ;
    dznorm:sourceArticle "art_125" .

<https://legal.dz/resource/order/1975-09-26/75-59#art_125_obligation_2_0757cb8e_action_a114e5050b> a dznorm:Action ;
    rdfs:label "أن تبت المحكمة في الدعوى"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب أن تبت المحكمة في الدعوى خلال شهرين من أول جلسة بموجب حكم غير قابل للمعارضة فيه وقابل للتنفيذ بالرغم من جميع طرق الطعن"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_125> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_125_obligation_2_0757cb8e_period_97e297cd8d> a dznorm:Period ;
    rdfs:label "خلال شهرين من أول جلسة بموجب حكم غي"@ar ;
    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "يجب أن تبت المحكمة في الدعوى خلال شهرين من أول جلسة بموجب حكم غير قابل للمعارضة فيه وقابل للتنفيذ بالرغم من جميع طرق الطعن"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_125> .

<https://legal.dz/resource/order/1975-09-26/75-59#art_125_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_125> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز لكل دائن يباشر إجراء حجز تنفيذي وللمدين المعرض لهذا الإجراء، أن يطلب من المحكمة التي يقع بدائرتها المحل التجاري، بيع المحل التجاري المحجوز عليه مع المعدات والبضائع التابعة له."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_125_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_125> ;
    dzdoc:position 1 ;
    dzdoc:text "وتقرر المحكمة بطلب من الدائن القائم بالملاحقة أنه في حالة عدم قيام المدين بالدفع في المهلة المحددة يقع بيع المحل التجاري بناء على طلب الدائن وذلك بعد إتمام الإجراءات المقررة في المادة 127 التالية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_125_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_125> ;
    dzdoc:position 2 ;
    dzdoc:text "ويجري مثل ذلك، بالنسبة للدعوى المرفوعة من المدين، فيما إذا طلب الدائن متابعة بيع المحل التجاري."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_125_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_125> ;
    dzdoc:position 3 ;
    dzdoc:text "وإذا لم يطالب الدائن ذلك، تحدد المحكمة المهلة التي يجب أن يتم فيها البيع بناء على طلب المدين حسب الأوضاع المقررة في المادة 127 الآتي ذكرها بعده، وتأمر بأنه إذا لم يباشر المدين البيع في المهلة المذكورة يستأنف السير بإجراءات الحجز التنفيذي وتتابع ابتداء من آخر إجراء وقفت عنده."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_125_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_125> ;
    dzdoc:position 4 ;
    dzdoc:text "تعين المحكمة عند الاقتضاء متصرفا مؤقتا لإدارة المحل التجاري، وتحدد السعر الافتتاحي المطروح للمزايدة وتضبط الشروط الأساسية التي يجب إتمام البيع على مقتضاها، وتعهد بإجراء البيع إلى الموظف العمومي الذي باشر تحرير دفتر الشروط."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_125_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_125> ;
    dzdoc:position 5 ;
    dzdoc:text "وإذا ظهر من المفيد القيام بإجراءات النشر الاستثنائية وجب ضبطها في الحكم وإلا فبموجب أمر يصدر من رئيس المحكمة بناء على عريضة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_125_para_6> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_125> ;
    dzdoc:position 6 ;
    dzdoc:text "يجوز للمحكمة أن تأذن بحكمها للشخص القائم بالملاحقة، إذا لم يكن هناك دائن مقيد أو معارض وبشرط اقتطاع المصاريف الممتازة لمن له الحق فيها بأن يقبض الثمن مباشرة مقابل مجرد إيصال، من الموظف العمومي القائم بالبيع وذلك لطرحه من دينه أو تسديدا لدينه الأصلي مع المصاريف."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_125_para_7> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_125> ;
    dzdoc:position 7 ;
    dzdoc:text "يجب أن تبت المحكمة في الدعوى خلال شهرين من أول جلسة بموجب حكم غير قابل للمعارضة فيه وقابل للتنفيذ بالرغم من جميع طرق الطعن."@ar .

<https://legal.dz/resource/order/1975-09-26/75-59#art_125_para_8> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-59#art_125> ;
    dzdoc:position 8 ;
    dzdoc:text "ويرفع الاستئناف خلال الثلاثين يوما من تبليغه إلى الطرف المعني."@ar .

