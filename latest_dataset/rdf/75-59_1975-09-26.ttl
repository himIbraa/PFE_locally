<https://legal.dz/resource/order/1975-09-26/75-59#version_art_227> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-59> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون جميع الأحكام والأوامر الصادرة بمقتضى هذا الباب معجلة التنفيذ رغم المعارضة أو الاستئناف و ذلك باستثناء الحكم الذي يقضي بالمصادقة على الصلح ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
