<https://legal.dz/resource/order/1975-09-26/75-59#art_674_obligation_1_a99c349a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
