<https://legal.dz/resource/order/2022-05-05/22-09#art_3_obligation_2_4c6181ad> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/order/2022-05-05/22-09#art_3_obligation_2_4c6181ad_period_aabcaa19ec> ;
    dzdoc:hasRole <https://legal.dz/resource/order/2022-05-05/22-09#art_3_obligation_2_4c6181ad_role_11e204fadc> ;
