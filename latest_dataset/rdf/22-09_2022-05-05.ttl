<https://legal.dz/resource/order/2022-05-05/22-09#subsec_12_art_2_dup_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/2022-05-05/22-09> ;
    dzdoc:definesTerm dzterm:commercial_nature ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/2022-05-05/22-09#subsec_12> ;
    dzdoc:eId "subsec_12_art_2_dup_1" ;
    dzdoc:fullText "تعدل وتتمم المادة 544 من الأمر رقم 75-59 المؤرخ في 20 رمضان عام 1395 الموافق 26 سبتمبر سنة 1975 والمذكور أعلاه، وتحرر كما يأتي : \" المادة 544 : يحدد الطابع التجاري للشركة إما بشكلها أو موضوعها . تعد شركات التضامن وشركات التوصية والشركات ذات المسؤولية المحدودة وشركات المساهمة وشركات المساهمة البسيطة تجارية بحكم شكلها ومهما يكن موضوعها\"."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/2022-05-05/22-09#subsec_12_art_2_dup_1_defocc_7a122f36a644> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/2022-05-05/22-09#subsec_12_art_2_dup_1_para_0>,
        <https://legal.dz/resource/order/2022-05-05/22-09#subsec_12_art_2_dup_1_para_1>,
        <https://legal.dz/resource/order/2022-05-05/22-09#subsec_12_art_2_dup_1_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:number "المادة 2" ;
    dzdoc:originalEId "subsec_12_art_2" ;
    dzdoc:position 4 ;
    dzdoc:references <https://legal.dz/resource/order/2022-05-05/22-09#art_544> ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/2022-05-05/22-09#subsec_12_art_2_dup_1_extref_02ce7b14> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/2022-05-05/22-09#art_544> .

