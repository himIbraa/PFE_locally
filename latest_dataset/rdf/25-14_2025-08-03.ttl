<https://legal.dz/resource/law/2025-08-03/25-14#version_art_168> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText """يطلب من الشهود ، قبل سماع شهادتهم عن الوقائع ، أن يذكر كل منهم اسمه ولقبه وعمره وحالته ومهنته وسكنه و إن كانت له قرابة أو نسب مع الخصوم أو ملحق بخدمتهم أو كان فاقدا للأهلية وينوه في المحضر عن هذه الأسئلة والأجوبة. ويؤدي اليمين ، كل شاهد ويده اليمنى مرفوعة بالصيغة الآتية :
                "أقسم بالله العظيم أن أتكلم بغير حقد ولا خوف وأن أقول كل الحق ولا شيء غير الحق". وتسمع شهادة الأطفال إلى سن السادسة عشر (16) بغير حلف اليمين."""@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_168_20250803_OpEnact_f08709c55d> ;
    dzdoc:replacementText """يطلب من الشهود ، قبل سماع شهادتهم عن الوقائع ، أن يذكر كل منهم اسمه ولقبه وعمره وحالته ومهنته وسكنه و إن كانت له قرابة أو نسب مع الخصوم أو ملحق بخدمتهم أو كان فاقدا للأهلية وينوه في المحضر عن هذه الأسئلة والأجوبة. ويؤدي اليمين ، كل شاهد ويده اليمنى مرفوعة بالصيغة الآتية :
                "أقسم بالله العظيم أن أتكلم بغير حقد ولا خوف وأن أقول كل الحق ولا شيء غير الحق". وتسمع شهادة الأطفال إلى سن السادسة عشر (16) بغير حلف اليمين."""@ar ;
    dzdoc:resolutionStatus "resolved" ;
