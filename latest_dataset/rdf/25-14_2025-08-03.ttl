<https://legal.dz/resource/law/2025-08-03/25-14#version_art_286> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم بإجراء التحقيقات التكميلية طبقا للأحكام المتعلقة بالتحقيق السابق إما أحد أعضاء غرفة الاتهام وإما قاضي التحقيق الذي تندبه لهذا الغرض، و يجوز للنائب العام، في كل وقت أن يطلب الاطلاع على أوراق التحقيق على أن يردها خلال خمسة (5) أيام ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_286_20250803_OpEnact_541de5f073> ;
    dzdoc:replacementText "يقوم بإجراء التحقيقات التكميلية طبقا للأحكام المتعلقة بالتحقيق السابق إما أحد أعضاء غرفة الاتهام وإما قاضي التحقيق الذي تندبه لهذا الغرض، و يجوز للنائب العام، في كل وقت أن يطلب الاطلاع على أوراق التحقيق على أن يردها خلال خمسة (5) أيام ."@ar ;
