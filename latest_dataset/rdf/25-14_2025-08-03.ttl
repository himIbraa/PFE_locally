    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_470> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_470_obligation_0_623f6934> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_470_obligation_0_623f6934_action_e7613c9da6> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_470> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب إبداء الدفوع الأولية قبل أي دفاع في الموضوع"@ar ;
    dznorm:sourceArticle "art_470" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_470_obligation_0_623f6934_action_e7613c9da6> a dznorm:Action ;
