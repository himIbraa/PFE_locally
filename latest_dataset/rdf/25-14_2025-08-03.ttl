<https://legal.dz/resource/law/2025-08-03/25-14#version_art_219> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن يمنح تعويض للشخص الذي كان محل حبس مؤقت غير مبرر خلال متابعة جزائية انتهت في حقه بصدور قرار نهائي قضى بألا وجه للمتابعة أو بالبراءة إذا ألحق به هذا الحبس ضررا ثابتا ومتميزا . ويكون التعويض الممنوح طبقا للفقرة السابقة على عاتق الخزينة العمومية ، مع احتفاظ هذه الأخيرة بحق الرجوع على الشخص المبلغ سيء النية أو شاهد الزور الذي تسبب في الحبس المؤقت."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_219_20250803_OpEnact_2c69207e9a> ;
    dzdoc:replacementText "يمكن أن يمنح تعويض للشخص الذي كان محل حبس مؤقت غير مبرر خلال متابعة جزائية انتهت في حقه بصدور قرار نهائي قضى بألا وجه للمتابعة أو بالبراءة إذا ألحق به هذا الحبس ضررا ثابتا ومتميزا . ويكون التعويض الممنوح طبقا للفقرة السابقة على عاتق الخزينة العمومية ، مع احتفاظ هذه الأخيرة بحق الرجوع على الشخص المبلغ سيء النية أو شاهد الزور الذي تسبب في الحبس المؤقت."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_219> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
