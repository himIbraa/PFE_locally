    dznorm:position 0 ;
    dznorm:provisionText "يجوز لقاضي التحقيق استدعاء مترجم غير أمين الضبط، والشهود."@ar ;
    dznorm:sourceArticle "art_166" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_166_permission_0_c3461e28_action_14e388bf68> a dznorm:Action ;
