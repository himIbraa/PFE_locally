    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_398> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجوز أن يباشر وظيفة المحلفين، الأشخاص جزائريو الجنسية البالغون من العمر ثلاثين (30)سنة كاملة، الملمون بالقراءة والكتابة والمتمتعون بالحقوق الوطنية والمدنية والعائلية والذين لا يوجدون في أية حالة من حالات فقد الأهلية أو التعارض المحددة في المادتين 399 و 400 أدناه."@ar ;
    dznorm:sourceArticle "art_398" .

