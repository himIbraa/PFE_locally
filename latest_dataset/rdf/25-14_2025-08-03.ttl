<https://legal.dz/resource/law/2025-08-03/25-14#version_art_802> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على أمين الضبط، قبل تحرير القسيمة رقم 3 ، أن يتحقق من الحالة المدنية لصاحب الشأن . فإذا كانت نتيجة فحص سجلات الحالة المدنية سلبية ، يرفض تسليم القسيمة ويرفع الأمر إلى النائب العام أو وكيل الجمهورية . وإذا كانت السلطة التي تحرر القسيمة رقم 3 ليس تحت يدها وثائق الحالة المدنية فيؤشر بشكل واضح على القسيمة بعبارة (غير محقق الهوية)."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_802_20250803_OpEnact_0dfffc8191> ;
    dzdoc:replacementText "يجب على أمين الضبط، قبل تحرير القسيمة رقم 3 ، أن يتحقق من الحالة المدنية لصاحب الشأن . فإذا كانت نتيجة فحص سجلات الحالة المدنية سلبية ، يرفض تسليم القسيمة ويرفع الأمر إلى النائب العام أو وكيل الجمهورية . وإذا كانت السلطة التي تحرر القسيمة رقم 3 ليس تحت يدها وثائق الحالة المدنية فيؤشر بشكل واضح على القسيمة بعبارة (غير محقق الهوية)."@ar ;
    dzdoc:resolutionStatus "resolved" ;
