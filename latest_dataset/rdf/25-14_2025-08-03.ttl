    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_770> ;
    dznorm:position 0 ;
    dznorm:provisionText "جاز لطرف الخصومة المطالب بالمتابعة، بمجرد تبليغ الإعلان المنصوص عليه في المادة 769 أعلاه، أن يعارض في الإفراج عنه بأن يستصدر من النيابة العامة أمرا يوجه منها إلى مدير المؤسسة العقابية بإبقائه في الحبس"@ar ;
    dznorm:sourceArticle "art_770" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_770_right_0_fdf72550_ref_c7a50986988f> a dzdoc:Reference ;
