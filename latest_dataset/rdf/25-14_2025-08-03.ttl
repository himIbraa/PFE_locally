<https://legal.dz/resource/law/2025-08-03/25-14#version_art_113> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتخذ إجراءات المتابعة الجزائية إذا لم يقم الشخص المعنوي بتنفيذ الالتزامات المنصوص عليها في اتفاقية إرجاء المتابعة كليا أو جزئيا . في حالة ما إذا تمت متابعة الشخص المعنوي للأسباب المذكورة في الفقرة الأولى ، لا يجوز استعمال محتوى التصريحات التي أدلى بها ممثله القانوني في مواجهته أمام جهة التحقيق أو جهة الحكم، ما لم تكن النيابة العامة على علم مسبق بها. يتعين على جهة الحكم أن تراعي في حكمها ما تم تنفيذه جزئيا من التزامات من طرف الشخص المعنوي قبل توقيف تنفيذ اتفاقية إرجاء المتابعة ، وتفصل في المصاريف"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_113_20250803_OpEnact_a1d3c7f8be> ;
    dzdoc:replacementText "تتخذ إجراءات المتابعة الجزائية إذا لم يقم الشخص المعنوي بتنفيذ الالتزامات المنصوص عليها في اتفاقية إرجاء المتابعة كليا أو جزئيا . في حالة ما إذا تمت متابعة الشخص المعنوي للأسباب المذكورة في الفقرة الأولى ، لا يجوز استعمال محتوى التصريحات التي أدلى بها ممثله القانوني في مواجهته أمام جهة التحقيق أو جهة الحكم، ما لم تكن النيابة العامة على علم مسبق بها. يتعين على جهة الحكم أن تراعي في حكمها ما تم تنفيذه جزئيا من التزامات من طرف الشخص المعنوي قبل توقيف تنفيذ اتفاقية إرجاء المتابعة ، وتفصل في المصاريف القضائية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_113> ;
