<https://legal.dz/resource/law/2025-08-03/25-14#version_art_164> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتعين على كل شخص استدعي بواسطة أحد أعوان القوة العمومية لسماع شهادته أن يحضر ويؤدي اليمين، عند الاقتضاء، ويدلي بشهادته وإلا عوقب بمقتضى نص المادة 172 أدناه. غير أنه يمكن بالنسبة لمن توجه ضده شكوى مصحوبة بادعاء مدني أن يرفض سماعه بصفته شاهدا ، وعلى قاضي التحقيق أن ينبهه إلى ذلك بعد أن يحيطه علما بالشكوى أو بالقرائن الموجودة ضده، وينوه بذلك في المحضر، ولا يجوز لقاضي التحقيق في حالة الرفض، أن يستجوبه، حينئذ، إلا بوصفه متهما. ولا يجوز لقاضي التحقيق المناط به إجراء تحقيق ما، ولا للقضاة وضباط الشرطة ا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_164_20250803_OpEnact_b2319dcb32> ;
    dzdoc:replacementText "يتعين على كل شخص استدعي بواسطة أحد أعوان القوة العمومية لسماع شهادته أن يحضر ويؤدي اليمين، عند الاقتضاء، ويدلي بشهادته وإلا عوقب بمقتضى نص المادة 172 أدناه. غير أنه يمكن بالنسبة لمن توجه ضده شكوى مصحوبة بادعاء مدني أن يرفض سماعه بصفته شاهدا ، وعلى قاضي التحقيق أن ينبهه إلى ذلك بعد أن يحيطه علما بالشكوى أو بالقرائن الموجودة ضده، وينوه بذلك في المحضر، ولا يجوز لقاضي التحقيق في حالة الرفض، أن يستجوبه، حينئذ، إلا بوصفه متهما. ولا يجوز لقاضي التحقيق المناط به إجراء تحقيق ما، ولا للقضاة وضباط الشرطة القضائية المعهود إليهم القيام بإجراء، بمقتضى إنابة قضائية، بغية إحباط حقوق الدفاع، الاستماع إلى شهادة أشخاص تقوم ضدهم دلائل قوية ومتوافقة على قيام اتهام في حقهم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_164> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_164> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_165> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
