<https://legal.dz/resource/law/2025-08-03/25-14#art_8_obligation_0_4ff732de> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_8_obligation_0_4ff732de_role_c1a16f57e9> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_8> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا تحرك الدعوى العمومية ضد مسيري المؤسسات العمومية الاقتصادية التي تملك الدولة كل رأسمالها أو ذات الرأسمال المختلط عن أعمال التسيير التي تؤدي إلى سرقة أو تبديد أو اختلاس أو تلف أو ضياع أموال عمومية أو خاصة إلا بناء على شكوى مسبقة من الهيئات الاجتماعية للمؤسسة"@ar ;
    dznorm:sourceArticle "art_8" .

