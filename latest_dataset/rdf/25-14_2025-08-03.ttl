<https://legal.dz/resource/law/2025-08-03/25-14#art_837_condition_0_6097816c> a dznorm:Condition ;
    dznorm:conditionText "بعد انتهاء فترة اختبار خمس (5) سنوات بالنسبة للحبس، وسنة بالنسبة للغرامة، ما لم يحصل إلغاء وقف التنفيذ"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_837> ;
