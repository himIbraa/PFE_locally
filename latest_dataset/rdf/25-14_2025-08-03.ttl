<https://legal.dz/resource/law/2025-08-03/25-14#version_art_710> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يطرح النزاع على الجهة الأعلى درج المشتركة حسب التدرج في السلك القضائي. وإذا كانت تلك الجهة مجلسا قضائيا ، فحص النزاع لدى غرفة الاتهام. وإذا لم توجد جهة عليا مشتركة ، فإن كل نزاع بين جهات التحقيق وجهات الحكم العادية أو الاستثنائية يطرح على الغرفة الجزائية بالمحكمة العليا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_710_20250803_OpEnact_d31ac611bc> ;
    dzdoc:replacementText "يطرح النزاع على الجهة الأعلى درج المشتركة حسب التدرج في السلك القضائي. وإذا كانت تلك الجهة مجلسا قضائيا ، فحص النزاع لدى غرفة الاتهام. وإذا لم توجد جهة عليا مشتركة ، فإن كل نزاع بين جهات التحقيق وجهات الحكم العادية أو الاستثنائية يطرح على الغرفة الجزائية بالمحكمة العليا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_710> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_710> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
