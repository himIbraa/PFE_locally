    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_693_prohibition_0_6348d5b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "693" ;
    dzdoc:position 691 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_693_condition_0_b85d8301>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_693_condition_1_c4bb443e>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_693_condition_2_d9252cd7> ;
