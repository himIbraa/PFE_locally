<https://legal.dz/resource/law/2025-08-03/25-14#version_art_136> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لجهة الحكم، تلقائيا أو بطلب من الأطراف، سماع الشاهد مخفي الهوية عن طريق وضع وسائل تقنية تسمح بكتمان هويته ، بما في ذلك السماع عن طريق المحادثة المرئية عن بعد و استعمال الأساليب التي لا تسمح بمعرفة صورة الشخص وصوته. إذا كانت تصريحات الشاهد مخفي الهوية هي أدلة الاتهام الوحيدة يجوز للمحكمة السماح بالكشف عن هويته بعد موافقته ، بشرط أخذ التدابير الكافية لضمان حمايته . و إذا لم يتم الكشف عن هوية الشاهد ، تعتبر المعلومات التي يكشف عنها مجرد استدلالات ولا تشكل لوحدها دليلا يمكن اعتماده كأساس للحكم "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_136_20250803_OpEnact_84f7034229> ;
    dzdoc:replacementText "يجوز لجهة الحكم، تلقائيا أو بطلب من الأطراف، سماع الشاهد مخفي الهوية عن طريق وضع وسائل تقنية تسمح بكتمان هويته ، بما في ذلك السماع عن طريق المحادثة المرئية عن بعد و استعمال الأساليب التي لا تسمح بمعرفة صورة الشخص وصوته. إذا كانت تصريحات الشاهد مخفي الهوية هي أدلة الاتهام الوحيدة يجوز للمحكمة السماح بالكشف عن هويته بعد موافقته ، بشرط أخذ التدابير الكافية لضمان حمايته . و إذا لم يتم الكشف عن هوية الشاهد ، تعتبر المعلومات التي يكشف عنها مجرد استدلالات ولا تشكل لوحدها دليلا يمكن اعتماده كأساس للحكم بالإدانة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_136> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_136> ;
