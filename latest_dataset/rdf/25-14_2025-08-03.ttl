    dzdoc:text "يسوغ دائما للمدعي المدني أن يمثله محام ويكون القرار الذي يصدر في هذه الحالة حضوريا بالنسبة له، حتى ولو لم يحضر المدعي المدني بالجلسة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_382_right_0_0a0ed717> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
