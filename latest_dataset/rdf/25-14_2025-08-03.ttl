dzterm:abandonment a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يعد تاركا لادعائه المدني كل ضحية أو مدع مدني يتخلف عن الحضور أو لا يحضر عنه من يمثله في الجلسة رغم تكليفه بالحضور تكليفا قانونيا."@ar ;
