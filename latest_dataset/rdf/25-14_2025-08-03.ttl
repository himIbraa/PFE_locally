<https://legal.dz/resource/law/2025-08-03/25-14#version_art_439> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "متى انتهى التحقيق بالجلسة ، سمعت أقوال الضحية أو المدعي المدني أو محاميهما . وتبدي النيابة التماساتها . ويعرض المحامي والمتهم أوجه الدفاع ويسمح للضحية أو المدعي المدني والنيابة العامة بالرد ، ويكون المتهم ومحاميه آخر من يتكلم دائما ."@ar ;
