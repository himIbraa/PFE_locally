<https://legal.dz/resource/law/2025-08-03/25-14#version_art_724> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يتسبب عن إيداع عريضة طلب الرد تنحي القاضي المطلوب، رده ، وذلك فيما عدا الحالة المنصوص عليها في المادة 728 أدناه ، غير أنه يجوز للرئيس المعروض عليه الطلب بعد استطلاع رأي النائب العام ، أن يأمر بإيقافه إما عن مواصلة التحقيقات أو المرافعات وإما عن النطق بالحكم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_724_20250803_OpEnact_569974f6d9> ;
    dzdoc:replacementText "لا يتسبب عن إيداع عريضة طلب الرد تنحي القاضي المطلوب، رده ، وذلك فيما عدا الحالة المنصوص عليها في المادة 728 أدناه ، غير أنه يجوز للرئيس المعروض عليه الطلب بعد استطلاع رأي النائب العام ، أن يأمر بإيقافه إما عن مواصلة التحقيقات أو المرافعات وإما عن النطق بالحكم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_724> ;
