<https://legal.dz/resource/law/2025-08-03/25-14#version_art_54> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن وكيل الجمهورية ، تلقائيا أو بناء على طلب أي شخص أو جهة لهما مصلحة في ذلك، أن يطلب من رئيس المحكمة الترخيص بإتلاف أو تخصيص أو التصرف في الأملاك المحجوزة و أخذ عينات عنها، عند الاقتضاء، مع مراعاة حقوق الغير حسن النية . في حالة بيع الأملاك المحجوزة ، تودع المبالغ المتحصل عليها في حساب خاص للخزينة العمومية إلى حين صدور حكم أو قرار نهائي في الدعوى يفصل في مالها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_54_20250803_OpEnact_639367a20b> ;
    dzdoc:replacementText "يمكن وكيل الجمهورية ، تلقائيا أو بناء على طلب أي شخص أو جهة لهما مصلحة في ذلك، أن يطلب من رئيس المحكمة الترخيص بإتلاف أو تخصيص أو التصرف في الأملاك المحجوزة و أخذ عينات عنها، عند الاقتضاء، مع مراعاة حقوق الغير حسن النية . في حالة بيع الأملاك المحجوزة ، تودع المبالغ المتحصل عليها في حساب خاص للخزينة العمومية إلى حين صدور حكم أو قرار نهائي في الدعوى يفصل في مالها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_54> ;
