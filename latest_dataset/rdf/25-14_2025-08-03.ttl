    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_11_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_11> ;
    dzdoc:position 1 ;
    dzdoc:text "وتكون مدة التقادم عشر (10) سنوات كاملة، إذا كانت عقوبة الحبس المقررة قانونا تزيد عن خمس (5) سنوات."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_11_para_2> a dzdoc:Paragraph ;
