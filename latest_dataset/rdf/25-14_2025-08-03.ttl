<https://legal.dz/resource/law/2025-08-03/25-14#version_art_121> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقصد بالتسرب قيام ضابط أو عون الشرطة القضائية، تحت مسؤولية ضابط الشرطة القضائية المكلف بتنسيق العملية، بمراقبة الأشخاص المشتبه في ارتكابهم جناية أو جنحة بإيهامهم أنه فاعل معهم أو شريك لهم أو خاف. يسمح لـ ضابط أو عون الشرطة القضائية أن يستعمل لهذا الغرض، هوية مستعارة و أن يرتكب، عند الضرورة ، الأفعال المذكورة في المادة 123 أدناه ، ولا يجوز، تحت طائلة البطلان، أن تشكل هذه الأفعال تحريضا على ارتكاب جرائم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_121_20250803_OpEnact_3dc43dd814> ;
    dzdoc:replacementText "يقصد بالتسرب قيام ضابط أو عون الشرطة القضائية، تحت مسؤولية ضابط الشرطة القضائية المكلف بتنسيق العملية، بمراقبة الأشخاص المشتبه في ارتكابهم جناية أو جنحة بإيهامهم أنه فاعل معهم أو شريك لهم أو خاف. يسمح لـ ضابط أو عون الشرطة القضائية أن يستعمل لهذا الغرض، هوية مستعارة و أن يرتكب، عند الضرورة ، الأفعال المذكورة في المادة 123 أدناه ، ولا يجوز، تحت طائلة البطلان، أن تشكل هذه الأفعال تحريضا على ارتكاب جرائم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_121> ;
