    skos:prefLabel "صحيفة السوابق القضائية للشخص المعنوي هي بيان كامل عن مجموع العقوبات والجزاءات الخاصة به والتي لم يمحها رد الاعتبار."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_818_defocc_4ebbd0ac6935> .

dzterm:cyber_crimes a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يقصد، في مفهوم هذا القانون بالجرائم المتصلة بتكنولوجيات الإعلام والاتصال، أي جريمة ترتكب أو يسهل ارتكابها استعمال منظومة معلوماتية أو نظام للاتصالات الإلكترونية أو أي وسيلة أخرى أو آلية ذات صلة بتكنولوجيات الإعلام والاتصال"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_335_defocc_83cf7ce6fc59> .

dzterm:detention_order a skos:Concept,
        dzdoc:LegalTerm ;
