<https://legal.dz/resource/law/2025-08-03/25-14#version_art_103> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تمت المتابعة الجزائية للشخص المعنوي وممثله القانوني في نفس الوقت، أو إذا لم يوجد أي شخص مؤهل لتمثيله ، يعين رئيس المحكمة، بناء على طلب النيابة العامة، ممثلا عنه من ضمن مستخدمي الشخص المعنوي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_103_20250803_OpEnact_f605824588> ;
    dzdoc:replacementText "إذا تمت المتابعة الجزائية للشخص المعنوي وممثله القانوني في نفس الوقت، أو إذا لم يوجد أي شخص مؤهل لتمثيله ، يعين رئيس المحكمة، بناء على طلب النيابة العامة، ممثلا عنه من ضمن مستخدمي الشخص المعنوي ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_103> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_103> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
