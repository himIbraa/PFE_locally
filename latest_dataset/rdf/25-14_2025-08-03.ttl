<https://legal.dz/resource/law/2025-08-03/25-14#version_art_528> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رفع الأمر في موضوع القضية إلى المجلس القضائي ، أصبح مختصا بالفصل في طلبات الاسترداد بالأوضاع المنصوص عليها في المواد من 522 إلى 525 من هذا القانون. ويظل مختصا حتى بعد صدور قرار نهائي في الموضوع برد الأشياء بالأوضاع المنصوص عليها في الفقرتين 1 و 2 من المادة 527 أعلاه. يجوز تنفيذ قرار الاسترداد في حالة صدور حكم أو قرار بالبراءة بالرغم من طعن النيابة العامة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_528_20250803_OpEnact_baf2899f1c> ;
    dzdoc:replacementText "إذا رفع الأمر في موضوع القضية إلى المجلس القضائي ، أصبح مختصا بالفصل في طلبات الاسترداد بالأوضاع المنصوص عليها في المواد من 522 إلى 525 من هذا القانون. ويظل مختصا حتى بعد صدور قرار نهائي في الموضوع برد الأشياء بالأوضاع المنصوص عليها في الفقرتين 1 و 2 من المادة 527 أعلاه. يجوز تنفيذ قرار الاسترداد في حالة صدور حكم أو قرار بالبراءة بالرغم من طعن النيابة العامة ."@ar ;
