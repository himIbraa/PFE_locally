    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_793> ;
    dznorm:position 0 ;
    dznorm:provisionText "يقوم أمين ضبط المجلس القضائي لمحل الميلاد أو القاضي المكلف بالمصلحة المركزية لصحيفة السوابق القضائية بمجرد استلامه قسيمة التعديل المنصوص عليها في المادة 794 أدناه ، بقيد البيانات الآتية على البطاقات رقم 1"@ar ;
    dznorm:sourceArticle "art_793" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_793_obligation_0_21a3b701_ref_5d1f319e3d47> a dzdoc:Reference ;
