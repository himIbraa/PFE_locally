<https://legal.dz/resource/law/2025-08-03/25-14#version_art_327> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبقى الأوامر بالقبض وأوامر الوضع رهن الحبس المؤقت الصادرة منتجة لآثارها إلى غاية صدور أمر مخالف عن قاضي التحقيق بالقطب الجزائي الوطني الاقتصادي والمالي الذي يصبح الضامن لشرعية وصحة إجراءات الحبس المؤقت. لا تجدد إجراءات المتابعة والتحقيق وكذا الإجراءات الشكلية المتخذة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_327_20250803_OpEnact_c3e44d71a7> ;
    dzdoc:replacementText "تبقى الأوامر بالقبض وأوامر الوضع رهن الحبس المؤقت الصادرة منتجة لآثارها إلى غاية صدور أمر مخالف عن قاضي التحقيق بالقطب الجزائي الوطني الاقتصادي والمالي الذي يصبح الضامن لشرعية وصحة إجراءات الحبس المؤقت. لا تجدد إجراءات المتابعة والتحقيق وكذا الإجراءات الشكلية المتخذة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_327> ;
