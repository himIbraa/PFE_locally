<https://legal.dz/resource/law/2025-08-03/25-14#version_art_855> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ما لم يتم التوصل بإشعار من السلطات الأجنبية المختصة باستفادة المحكوم عليه من رد الاعتبار عن العقوبات الصادرة عن الجهات القضائية الأجنبية والمقيدة في صحيفة السوابق القضائية طبقا لأحكام المادة 812 أعلاه ، تطبق بشأن هذه العقوبات أحكام رد الاعتبار المنصوص عليها في المادتين 836 و 837 من هذا القانون. وإذا تعلق الأمر بجناية ، يقدم طلب رد الاعتبار إلى غرفة الاتهام، بعد مضي مهلة خمس (5) سنوات، تحسب من تاريخ انتهاء تنفيذ العقوبة التي تفصل فيه بعد تحقيق تجريه حول سيرة وسلوك المعني ، ويكون قرارها قابلا للطع"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_855_20250803_OpEnact_7e548849e0> ;
    dzdoc:replacementText "ما لم يتم التوصل بإشعار من السلطات الأجنبية المختصة باستفادة المحكوم عليه من رد الاعتبار عن العقوبات الصادرة عن الجهات القضائية الأجنبية والمقيدة في صحيفة السوابق القضائية طبقا لأحكام المادة 812 أعلاه ، تطبق بشأن هذه العقوبات أحكام رد الاعتبار المنصوص عليها في المادتين 836 و 837 من هذا القانون. وإذا تعلق الأمر بجناية ، يقدم طلب رد الاعتبار إلى غرفة الاتهام، بعد مضي مهلة خمس (5) سنوات، تحسب من تاريخ انتهاء تنفيذ العقوبة التي تفصل فيه بعد تحقيق تجريه حول سيرة وسلوك المعني ، ويكون قرارها قابلا للطعن وفقا للأحكام المحددة في هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_855> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_855> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_856> a dzdoc:AmendmentEvent,
