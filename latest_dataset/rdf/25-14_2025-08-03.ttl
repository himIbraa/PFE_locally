<https://legal.dz/resource/law/2025-08-03/25-14#art_451_condition_0_0930dd10> a dznorm:Condition ;
    dznorm:conditionText "إذا تغيب المتهم المتابع بجناية عن الحضور بالجلسة رغم تبليغه قانونا بتاريخ انعقادها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_451> ;
