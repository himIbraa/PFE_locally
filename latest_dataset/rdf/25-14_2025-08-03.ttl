<https://legal.dz/resource/law/2025-08-03/25-14#version_art_808> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقدم الطلب في شكل عريضة إلى رئيس المحكمة أو رئيس المجلس القضائي الذي أصدر الحكم أو القرار ، و إذا كان الحكم صادر من محكمة الجنايات فيقدم الطلب إلى مقر محكمة الجنايات ويطلع الرئيس النيابة العامة على العريضة المقدمة من الطالب، كما يعين قاضيا من أجل كتابة تقرير. و للجهة القضائية المرفوع إليها الطلب أن تقوم بكل إجراءات التحقيق التي تراها ضرورية ولها أن تأمر بتبليغ الشخص الذي يدعي الطالب أنه هو المحكوم عليه. وتجري المرافعة كما يصدر الحكم في غرفة المشورة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_808_20250803_OpEnact_2aa0d53250> ;
    dzdoc:replacementText "يقدم الطلب في شكل عريضة إلى رئيس المحكمة أو رئيس المجلس القضائي الذي أصدر الحكم أو القرار ، و إذا كان الحكم صادر من محكمة الجنايات فيقدم الطلب إلى مقر محكمة الجنايات ويطلع الرئيس النيابة العامة على العريضة المقدمة من الطالب، كما يعين قاضيا من أجل كتابة تقرير. و للجهة القضائية المرفوع إليها الطلب أن تقوم بكل إجراءات التحقيق التي تراها ضرورية ولها أن تأمر بتبليغ الشخص الذي يدعي الطالب أنه هو المحكوم عليه. وتجري المرافعة كما يصدر الحكم في غرفة المشورة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
