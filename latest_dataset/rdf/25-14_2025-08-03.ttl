<https://legal.dz/resource/law/2025-08-03/25-14#version_art_483> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا قررت المحكمة تأجيل القضية ، يمكنها بعد الاستماع إلى طلبات النيابة والمتهم ودفاعه ، اتخاذ أحد التدابير الآتية : ترك المتهم حرا، إخضاع المتهم لتدبير أو أكثر من تدابير الرقابة القضائية المنصوص عليها في المادة 198 من هذا القانون، وضع المتهم في الحبس المؤقت. لا يجوز الاستئناف في الأوامر التي تصدرها المحكمة وفقا لهذه المادة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_483_20250803_OpEnact_da910bffae> ;
    dzdoc:replacementText "إذا قررت المحكمة تأجيل القضية ، يمكنها بعد الاستماع إلى طلبات النيابة والمتهم ودفاعه ، اتخاذ أحد التدابير الآتية : ترك المتهم حرا، إخضاع المتهم لتدبير أو أكثر من تدابير الرقابة القضائية المنصوص عليها في المادة 198 من هذا القانون، وضع المتهم في الحبس المؤقت. لا يجوز الاستئناف في الأوامر التي تصدرها المحكمة وفقا لهذه المادة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_483> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_483> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

