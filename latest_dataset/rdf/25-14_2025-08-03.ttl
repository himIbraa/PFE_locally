<https://legal.dz/resource/law/2025-08-03/25-14#art_505_obligation_1_42fab319> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_505> ;
    dznorm:position 1 ;
    dznorm:provisionText "يخبر الرئيس أطراف الدعوى الحاضرين باليوم الذي سينطق فيه بالحكم"@ar ;
    dznorm:sourceArticle "art_505" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_505_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_505> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب أن يصدر الحكم في جلسة علنية في الجلسة نفسها التي سمعت ، فيها المرافعات أو في جلسة لاحقة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_505_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_505> ;
    dzdoc:position 1 ;
    dzdoc:text "و في الحالة الأخيرة، يخبر الرئيس أطراف الدعوى الحاضرين باليوم الذي سينطق فيه بالحكم و أن هذا الأخير يصدر حضوريا في مواجهتهم حتى وإن تخلفوا عن الحضور."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_506_condition_0_741d16c3> a dznorm:Condition ;
    dznorm:conditionText "إذا تبين أنه من اللازم إجراء تحقيق تكميلي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_506> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_506_obligation_0_891334b6> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_506_obligation_0_891334b6_action_476a0cd720> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_506> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب أن يكون ذلك بحكم"@ar ;
    dznorm:sourceArticle "art_506" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_506_obligation_0_891334b6_action_476a0cd720> a dznorm:Action ;
    rdfs:label "أن يكون ذلك بحكم"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب أن يكون ذلك بحكم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_506> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_506_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_506> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا تبين أنه من اللازم إجراء تحقيق تكميلي، يجب أن يكون ذلك بحكم، ويقوم بهذا الإجراء القاضي نفسه والذي يتمتع لهذا الغرض بالسلطات المنصوص عليها في المواد من 234 الى 238 من هذا القانون."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_506_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_506> ;
    dzdoc:position 1 ;
    dzdoc:text "ويخضع هذا التحقيق التكميلي للقواعد المقررة في المواد من 180 إلى 183 من هذا القانون."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_506_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_506> ;
    dzdoc:position 2 ;
    dzdoc:text "لوكيل الجمهورية أن يطلع بطريق المطالبة ، عند الاقتضاء، على الملف في أي وقت أثناء إجراء التحقيق التكميلي، على أن يعيد الأوراق في ظرف أربع وعشرين (24) ساعة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_506_right_0_8088f6d2> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_506_right_0_8088f6d2_role_8b44615e9b> ;
