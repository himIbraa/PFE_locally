<https://legal.dz/resource/law/2025-08-03/25-14#version_art_18> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "بعد الفصل في الدعوى العمومية ، تخضع إجراءات التحقيق التي أمر بها القاضي الجزائي في الحقوق المدنية لقواعد الإجراءات المدنية."@ar ;
