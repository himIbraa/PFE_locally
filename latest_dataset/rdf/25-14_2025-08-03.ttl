<https://legal.dz/resource/law/2025-08-03/25-14#art_296_obligation_0_b12b3b42> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
