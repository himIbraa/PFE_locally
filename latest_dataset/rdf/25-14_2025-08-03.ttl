<https://legal.dz/resource/law/2025-08-03/25-14#version_art_866> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم النائب العام باستجواب الشخص الأجنبي للتحقق من شخصيته ويبلغه بالمستند الذي قبض بموجبه وذلك خلال الأربع والعشرين (24) ساعة التالية عليه للقبض عليه . ويحرر محضرا بهذه الإجراءات."@ar ;
