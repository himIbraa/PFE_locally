        <https://legal.dz/resource/law/2025-08-03/25-14#art_86_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_86_20250803_OpEnact_ed3139378a> ;
