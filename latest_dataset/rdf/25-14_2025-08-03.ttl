<https://legal.dz/resource/law/2025-08-03/25-14#version_art_55> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "اذا ارتكب مسؤول محلي فعلا يحتمل عدم ارتباطه بأفعال التسيير ، يستطلع وكيل الجمهورية وجوبا، عن طريق النائب العام، رأي السلطة الوصية للمعني ، على سبيل التحقق والتأكيد والتي يجب عليها أن تبدي رأيها المعلل في أجل لا يتعدى ثلاثين (30) يوما من تاريخ إخطارها ، ويرفق الرأي بملف الإجراءات. يقصد بالمسؤول المحلي، الولاة والولاة المنتدبون والأمناء العامون للولايات ورؤساء الدوائر والمدراء التنفيذيون والمنتخبون المحليون المسيرون . تخضع ملاءمة المتابعة لتقدير النيابة العامة ولا يمكن، في أي حال، تحريك الدعوى الع"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_55_20250803_OpEnact_4dc915b5e0> ;
    dzdoc:replacementText "اذا ارتكب مسؤول محلي فعلا يحتمل عدم ارتباطه بأفعال التسيير ، يستطلع وكيل الجمهورية وجوبا، عن طريق النائب العام، رأي السلطة الوصية للمعني ، على سبيل التحقق والتأكيد والتي يجب عليها أن تبدي رأيها المعلل في أجل لا يتعدى ثلاثين (30) يوما من تاريخ إخطارها ، ويرفق الرأي بملف الإجراءات. يقصد بالمسؤول المحلي، الولاة والولاة المنتدبون والأمناء العامون للولايات ورؤساء الدوائر والمدراء التنفيذيون والمنتخبون المحليون المسيرون . تخضع ملاءمة المتابعة لتقدير النيابة العامة ولا يمكن، في أي حال، تحريك الدعوى العمومية إلا بناء على بلاغ معلوم المصدر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_55> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
