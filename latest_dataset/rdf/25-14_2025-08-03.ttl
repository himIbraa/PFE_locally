    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_443> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_443_obligation_0_8228e49d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_443_obligation_0_8228e49d_role_1c1c56a2c3> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_443> ;
    dznorm:position 0 ;
    dznorm:provisionText "يأمر رئيس المحكمة رئيس الخدمة المكلف بالمحافظة على النظام بإخراج المتهم المحبوس من قاعة الجلسة، وبمراقبة المتهم غير المحبوس المتابع بجناية و عدم السماح له بمغادرة مقر المحكمة حتى صدور الحكم، وبحراسة المنافذ المؤدية إلى غرفة المداولة حتى لا يتسنى لأحد أن ينفذ إليها لأي سبب من الأسباب بدون إذن الرئيس."@ar ;
    dznorm:sourceArticle "art_443" .

