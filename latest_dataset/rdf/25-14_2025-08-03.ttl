    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن المحكوم عليه بـ الإكراه البدني الذي يتعذر عليه تسديد المبلغ المدان به كاملا، أن يوقف أثاره بدفع مبلغ لا يقل عن نصف المبلغ المدان به ، مع الالتزام بأداء باقي المبلغ كليا أو على أقساط، في الآجال التي يحددها وكيل الجمهورية وبعد موافقة طالب الإكراه البدني . ويفرج وكيل الجمهورية على المحكوم عليه بـ الإكراه البدني المحبوس بعد التحقق من توفر الشروط المنصوص عليها في هذه المادة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_773_20250803_OpEnact_1a9f9895d5> ;
    dzdoc:replacementText "يمكن المحكوم عليه بـ الإكراه البدني الذي يتعذر عليه تسديد المبلغ المدان به كاملا، أن يوقف أثاره بدفع مبلغ لا يقل عن نصف المبلغ المدان به ، مع الالتزام بأداء باقي المبلغ كليا أو على أقساط، في الآجال التي يحددها وكيل الجمهورية وبعد موافقة طالب الإكراه البدني . ويفرج وكيل الجمهورية على المحكوم عليه بـ الإكراه البدني المحبوس بعد التحقق من توفر الشروط المنصوص عليها في هذه المادة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_773> ;
