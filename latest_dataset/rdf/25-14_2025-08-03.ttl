<https://legal.dz/resource/law/2025-08-03/25-14#art_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "تطبق على الشخص المعنوي قواعد المتابعة والتحقيق والمحاكمة المنصوص عليها في هذا القانون ، مع مراعاة الأحكام الواردة في هذا الفصل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_100> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_100_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_100_20250803_OpEnact_2fac782fd2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_100_obligation_0_bd2eb00a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "100" ;
    dzdoc:position 99 ;
    dzdoc:usesTerm dzterm:legal_person .

<https://legal.dz/resource/law/2025-08-03/25-14#art_101> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_101" ;
    dzdoc:fullText "يتحدد الاختصاص المحلي للجهة القضائية بمكان ارتكاب الجريمة أو مكان وجود المقر الاجتماعي ل الشخص المعنوي . غير أنه إذا تمت متابعة أشخاص طبيعية في الوقت ذاته مع الشخص المعنوي ، تختص الجهات القضائية المرفوعة أمامها دعوى الأشخاص الطبيعية بمتابعة الشخص المعنوي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_101> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_101_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_101_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_101_20250803_OpEnact_689da1f9f2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "101" ;
    dzdoc:position 100 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_101_condition_0_20da347b> ;
    dzdoc:usesTerm dzterm:legal_person .

<https://legal.dz/resource/law/2025-08-03/25-14#art_115> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_4> ;
    dzdoc:eId "art_115" ;
    dzdoc:fullText "تتم العمليات المحددة في المادة 114 أعلاه، دون المساس بـ السر المهني المنصوص عليه في المادة 76 أعلاه. إذا اكتشفت جرائم أخرى غير تلك التي ورد ذكرها في إذن القاضي ، فإن ذلك لا يكون سببا لبطلان الإجراءات العارضة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_115> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_115_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_115_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_115_20250803_OpEnact_f3e66e62dd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 115" ;
    dzdoc:position 114 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_114>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_76> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_114>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_76> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_115_condition_0_cda13c46> ;
    dzdoc:usesTerm dzterm:professional_secrecy .

<https://legal.dz/resource/law/2025-08-03/25-14#art_117> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_4> ;
    dzdoc:eId "art_117" ;
    dzdoc:fullText "يجوز لـ وكيل الجمهورية أو ضابط الشرطة القضائية الذي أذن له، و لـ قاضي التحقيق أو ضابط الشرطة القضائية الذي ينيبه أن يسخر كل عون مؤهل لدى مصلحة أو وحدة أو هيئة عمومية أو خاصة مكلفة بالمواصلات السلكية واللاسلكية للتكفل بالجوانب التقنية للعمليات المذكورة في المادة 114 أعلاه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_117_permission_0_52c96c1f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_117> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_117_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_117_20250803_OpEnact_693f3543af> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 117" ;
    dzdoc:position 116 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_114> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_114> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:judicial_police_officer,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_138> a dzdoc:Article ;
