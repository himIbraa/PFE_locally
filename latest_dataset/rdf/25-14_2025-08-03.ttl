<https://legal.dz/resource/law/2025-08-03/25-14#art_9_condition_0_fb077c61> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_9_condition_0_fb077c61_role_57d235ffa3> ;
    dznorm:conditionText "إذا أدت المتابعة إلى الإدانة وكشفت عن أن الحكم أو القرار الذي قضى بانقضاء الدعوى العمومية مبني على تزوير أو استعمال مزور"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_9> ;
