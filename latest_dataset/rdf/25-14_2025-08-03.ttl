<https://legal.dz/resource/law/2025-08-03/25-14#version_art_433> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يأمر الرئيس أمين ضبط الجلسة بأن ينادي الشهود الذين يتعين انسحابهم إلى القاعة المخصصة لهم . ولا يخرجون منها إلا للإدلاء بشهادتهم . ويتحقق الرئيس من وجود المترجم عندما يكون وجوده لازما للرجوع إليه، عند الاقتضاء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_433_20250803_OpEnact_3837c870b2> ;
    dzdoc:replacementText "يأمر الرئيس أمين ضبط الجلسة بأن ينادي الشهود الذين يتعين انسحابهم إلى القاعة المخصصة لهم . ولا يخرجون منها إلا للإدلاء بشهادتهم . ويتحقق الرئيس من وجود المترجم عندما يكون وجوده لازما للرجوع إليه، عند الاقتضاء ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
