<https://legal.dz/resource/law/2025-08-03/25-14#version_art_660> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرفع الطعن بتصريح لدى أمانة ضبط الجهة التي أصدرت الحكم أو القرار المطعون فيه . ويجب توقيع التصريح بالطعن من أمين الضبط والطاعن بنفسه أو بواسطة محاميه أو وكيل خاص مفوض عنه ، وفي الحالة الأخيرة، يرفق التوكيل بمحضر التصريح بالطعن المحرر من أمين الضبط ، وإذا كان الطاعن لا يستطيع التوقيع نوه أمين الضبط عن ذلك. ترفق نسخة من محضر التصريح بالطعن وكذا ما يثبت حصول تبليغ الحكم أو القرار المطعون فيه بملف القضية . يتعين على أمين الضبط تسليم وصل إلى الطاعن عند تلقيه التصريح بالطعن . يجوز أن يرفع الطعن بكتاب "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_660_20250803_OpEnact_3c638a616d> ;
    dzdoc:replacementText "يرفع الطعن بتصريح لدى أمانة ضبط الجهة التي أصدرت الحكم أو القرار المطعون فيه . ويجب توقيع التصريح بالطعن من أمين الضبط والطاعن بنفسه أو بواسطة محاميه أو وكيل خاص مفوض عنه ، وفي الحالة الأخيرة، يرفق التوكيل بمحضر التصريح بالطعن المحرر من أمين الضبط ، وإذا كان الطاعن لا يستطيع التوقيع نوه أمين الضبط عن ذلك. ترفق نسخة من محضر التصريح بالطعن وكذا ما يثبت حصول تبليغ الحكم أو القرار المطعون فيه بملف القضية . يتعين على أمين الضبط تسليم وصل إلى الطاعن عند تلقيه التصريح بالطعن . يجوز أن يرفع الطعن بكتاب أو ببرقية إذا تعلق بمحكوم عليهم يقيمون في الخارج ، غير أنه يشترط أنه في خلال مهلة الشهر (1) المقررة في المادة 654 أعلاه يصدق على الطعن محام معتمد لدى المحكمة العليا يباشر عمله بالجزائر، ويكون مكتبه موطنا مختارا حتما، ما لم يكن المحكوم عليه محل أمر بالقبض . ويترتب على مخالفة هذا الشرط عدم قبول الطعن. وإذا كان المتهم محبوسا، فيجوز رفع الطعن أمام أمين ضبط المؤسسة العقابية المحبوس بها ، ويوقع على التصريح كل من المعني و أمين الضبط . يتعين على مدير المؤسسة العقابية إرسال نسخة من التصريح إلى أمانة ضبط الجهة القضائية التي أصدرت الحكم أو القرار المطعون فيه خلال 48 ساعة ، ويقوم أمين ضبط الجهة القضائية بقيده في سجل الطعون بالنقض."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_660> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_660> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_661> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على الطاعن بالنقض أن يودع لدى أمانة ضبط الجهة القضائية التي أصدرت الحكم أو القرار المطعون فيه مذكرة بأوجه الطعن موقعة من محام أو أكثر معتمد لدى المحكمة العليا مرفقة بنسخ بقدر ما يوجد في الدعوى من أطراف معنيين بالطعن خلال ستين (60) يوما، ابتداء من تاريخ الطعن . يثبت أمين ضبط الجهة القضائية المذكورة تاريخ الإيداع، ويسلم للطاعن نسخا من مذكرة الطعن بعدد الأطراف المعنية بالطعن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_661_20250803_OpEnact_02da6ed12e> ;
    dzdoc:replacementText "يجب على الطاعن بالنقض أن يودع لدى أمانة ضبط الجهة القضائية التي أصدرت الحكم أو القرار المطعون فيه مذكرة بأوجه الطعن موقعة من محام أو أكثر معتمد لدى المحكمة العليا مرفقة بنسخ بقدر ما يوجد في الدعوى من أطراف معنيين بالطعن خلال ستين (60) يوما، ابتداء من تاريخ الطعن . يثبت أمين ضبط الجهة القضائية المذكورة تاريخ الإيداع، ويسلم للطاعن نسخا من مذكرة الطعن بعدد الأطراف المعنية بالطعن."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_661> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_661> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
