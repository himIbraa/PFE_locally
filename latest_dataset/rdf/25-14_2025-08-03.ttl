<https://legal.dz/resource/law/2025-08-03/25-14#version_art_705> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان تقرير محكمة الجنايات لا سبيل لإعادته أو كانت القضية قد قضي فيها غيابيا أو لم يكن ثمة أي محرر كتابي ، أعيد التحقيق ابتداء من النقطة التي تبين فيها فقد الأوراق. وكذلك الشأن في جميع المواد إذا لم يمكن العثور على نسخة رسمية من الحكم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_705_20250803_OpEnact_15ffd138a6> ;
    dzdoc:replacementText "إذا كان تقرير محكمة الجنايات لا سبيل لإعادته أو كانت القضية قد قضي فيها غيابيا أو لم يكن ثمة أي محرر كتابي ، أعيد التحقيق ابتداء من النقطة التي تبين فيها فقد الأوراق. وكذلك الشأن في جميع المواد إذا لم يمكن العثور على نسخة رسمية من الحكم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_705> ;
