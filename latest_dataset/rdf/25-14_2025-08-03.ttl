<https://legal.dz/resource/law/2025-08-03/25-14#version_art_683> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز ل المحكمة العليا ، فضلا عن ذلك، في حالة رفض الطعن إذا ما أنطوى الطعن على تعسف : أن تحكم على الطاعن بغرامة لا تتجاوز 30.000 دج لصالح الخزينة، أن تحكم عليه بالتعويضات المدنية للمطعون ضده إذا طلبها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
