    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_107> ;
    dznorm:position 2 ;
    dznorm:provisionText "الخضوع لبرنامج إصلاح داخلي لدعم النزاهة والوقاية من الجرائم المنصوص عليها في المادة 106 أعلاه، يتولى إعداده ومتابعة تنفيذه الخبير أو الخبراء أو الهيئة المؤهلة الذين يتم تعيينهم من قبل وكيل الجمهورية، الخضوع إلى أي التزام آخر يراه وكيل الجمهورية مناسبا"@ar ;
    dznorm:sourceArticle "art_107" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_107_obligation_2_10efbb6f_ref_6b83bc3e12b3> a dzdoc:Reference ;
    rdfs:label "المادة 106"@ar ;
    dzdoc:frbrUri "#art_106"^^xsd:anyURI ;
