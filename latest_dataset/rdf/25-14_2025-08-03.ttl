<https://legal.dz/resource/law/2025-08-03/25-14#art_271> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:definesTerm dzterm:new_evidence ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_14> ;
    dzdoc:eId "art_271" ;
    dzdoc:fullText "المتهم الذي صدر بالنسبة إليه أمر من قاضي التحقيق بألا وجه للمتابعة لا يجوز متابعته من أجل الواقعة نفسها ما لم تطرأ أدلة جديدة . وتعد أدلة جديدة ، أقوال الشهود والأوراق والمحاضر التي لم يمكن عرضها على قاضي التحقيق لتمحيصها، مع أن من شأنها تعزيز الأدلة التي سبق أن وجدها ضعيفة أو أن من شأنها أن تعطي الوقائع تطورات نافعة لإظهار الحقيقة . و للنيابة العامة وحدها تقرير ما إذا كان ثمة محل لطلب إعادة التحقيق بناء على الأدلة الجديدة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_271_permission_0_77e23e0b>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_271_permission_1_f2f93f68> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_271_right_0_e6830a47> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_271> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_271_defocc_fd9ef01b74b8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_271_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_271_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_271_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_271_20250803_OpEnact_47c8537c87> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_271_obligation_0_6d0b89f1> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_271_prohibition_0_77e23e0b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 271" ;
    dzdoc:position 270 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_271_condition_0_74a17abb> ;
    dzdoc:usesTerm dzterm:accused,
        dzterm:investigating_judge .

<https://legal.dz/resource/law/2025-08-03/25-14#art_374> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_1_sec_1> ;
    dzdoc:eId "art_374" ;
    dzdoc:fullText "إذا تبين من المناقشات شهادة الزور في أقوال شاهد فللرئيس، أن يأمر ، إما من تلقاء نفسه أو بناء على طلب النيابة العامة أو أحد الأطراف، هذا الشاهد على وجه الخصوص بأن يلزم مكانه ويحضر المناقشات وأن لا يبرح مكانه لحين النطق بالحكم ، و في حالة مخالفة هذا الأمر يأمر الرئيس بالقبض على هذا الشاهد. ويوجه الرئيس، قبل النطق بإقفال باب المناقشة، إلى من يظن فيه شهادة الزور دعوة أخيرة ليقول الحق ويحذره بعد ذلك، من أن أقواله سيعتد بها منذ الآن من أجل تطبيق العقوبات المقررة لشهادة الزور، عند الاقتضاء . ويكلف الرئيس أمين ضبط الجلسة بتحرير محضر بالإضافات والتبديلات والمفارقات التي قد توجد بين شهادة الشاهد وأقواله السابقة . وبعد صدور الحكم في موضوع الدعوى أو في حالة تأجيل القضية، يأمر الرئيس بأن يقتاد الشاهد بواسطة القوة العمومية بغير تمهل إلى وكيل الجمهورية الذي يطلب افتتاح التحقيق معه . ويرسل أمين الضبط إلى وكيل الجمهورية نسخة من المحضر الذي حرره تطبيقا للفقرة الثالثة من هذه المادة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_374> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_374_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_374_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_374_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_374_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_374_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_374_20250803_OpEnact_2447d8a64a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_374_obligation_0_39ad79e4>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_374_obligation_1_dd076891>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_374_obligation_2_3ead8920>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_374_obligation_3_69df697f>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_374_obligation_4_a5967de5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "374" ;
    dzdoc:position 373 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_374> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_374> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_374_condition_0_0591b63f>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_374_condition_1_9b9402d4> ;
    dzdoc:usesTerm dzterm:false_testimony,
        dzterm:prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_407> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_4> ;
    dzdoc:eId "art_407" ;
    dzdoc:fullText "يقوم رئيس محكمة الجنايات الابتدائية أو القاضي الذي يفوضه باستجواب المتهم المتابع بجناية في أقرب وقت . يستجوب الرئيس المتهم عن هويته ويتحقق مما إذا كان قد تلقى تبليغا بقرار الإحالة ، فإن لم يكن قد بلغ به سلمت إليه نسخة منه ويكون لتسليم هذه النسخة أثر التبليغ ، و يطلب الرئيس من المتهم اختيار محام للدفاع عنه ، فإن لم يختر المتهم محاميا عين له الرئيس من تلقاء نفسه محاميا . ويحرر محضر بكل ذلك يوقع عليه كل من الرئيس وأمين الضبط والمتهم، وعند الاقتضاء، المترجم ، فإذا لم يكن في استطاعة المتهم التوقيع أو امتنع عنه، ذكر ذلك المحضر . ويجب إجراء الاستجواب المنصوص عليه في هذه المادة قبل انعقاد الجلسة بثمانية (8) أيام، على الأقل . ويجوز للمتهم والمحاميه التنازل عن هذا الأجل . و في حالة الاستئناف ، يقتصر الاستجواب على تأكد رئيس محكمة الجنايات الاستئنافية من قيام المتهم بتأسيس محام للدفاع عنه، فإن لم يقم بذلك عين له محاميا تلقائيا ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_407_right_0_0f13440d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_407> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_407_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_407_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_407_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_407_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_407_para_4>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_407_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_407_20250803_OpEnact_d4de09d8d3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_407_obligation_0_ee25f878>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_407_obligation_1_ed687369>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_407_obligation_2_96473f5b>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_407_obligation_3_95adbfab>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_407_obligation_4_e9ce891b>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_407_obligation_5_e930f140> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "407" ;
    dzdoc:position 406 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_407_condition_0_5579c669>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_407_condition_1_277b47e3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_407_condition_2_d53d23a1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_407_condition_3_aa13684f> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_445> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_7_subsec_1> ;
    dzdoc:eId "art_445" ;
    dzdoc:fullText "تعود المحكمة بعد ذلك إلى قاعة الجلسة، وينادي الرئيس على الأطراف ويستحضر المتهم ويتلو الإجابات التي أعطيت عن كل سؤال. يشير رئيس الجلسة إلى مواد القانون التي طبقت، وينوه عن ذلك بالحكم. ينطق بالحكم بالإدانة أو بالإعفاء من العقاب أو بالبراءة، وينفذ فورا وفقا للأوضاع المشار إليها في المادة 444 أعلاه، ضد المتهم غير المحبوس المتابع بجناية الذي تمت إدانته بها. في حالة الإدانة ، يلزم الحكم المحكوم عليه بالمصاريف لصالح الدولة، وينص فيه على مصادرة المحجوزات ومدة الإكراه البدني، مع مراعاة أحكام المادة 765 أدناه. وكذلك الشأن في حالة الإعفاء من العقاب، ما لم تقض محكمة الجنايات بقرار خاص مسبب، بإعفاء المحكوم عليه من المصاريف كلها أو بعضها. فإذا كانت الإدانة لا تتناول جميع الجرائم موضوع المتابعة، أو لم تكن إلا عن جرائم جرى عليها تعيل الوصف القانوني للوقائع موضوع الاتهام، سواء أكان ذلك أثناء سير التحقيق أو كان وقت النطق بالحكم ، وكذلك في حالة إخراج متهمين معينين من الدعوى ، تعين على المحكمة أن تقضي بقرار معلل بإعفاء المحكوم عليه من جزء من المصاريف القضائية التي لا تترتب مباشرة على الجريمة التي نجمت عنها الإدانة في الموضوع، وتعين المحكمة بنفسها مقدار المصاريف التي أعفي منها المحكوم عليه، وتوضع هذه المصاريف على عاتق الخزينة العمومية أو المدعي المدني حسب الظروف. فإذا خلا حكم المحكمة من الفصل في المصاريف القضائية جزئيا أو كليا ، فصلت غرفة الاتهام في ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_445> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_445_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_445_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_445_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_445_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_445_para_4>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_445_para_5>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_445_para_6> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_445_20250803_OpEnact_68d82b0c04> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_445_obligation_0_cc3eaa6e>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_445_obligation_1_0a8316ec>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_445_obligation_2_d2509074>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_445_obligation_3_095dded0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_445_obligation_4_22909b51>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_445_obligation_5_0cdd2cd1> ;
