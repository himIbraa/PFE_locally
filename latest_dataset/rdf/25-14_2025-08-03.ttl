<https://legal.dz/resource/law/2025-08-03/25-14#art_676_condition_0_648230c7> a dznorm:Condition ;
    dznorm:conditionText "إذا تبين من فحص القضية، بوضوح، وجود :"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_676> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_676_obligation_0_eb979e34> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_676> ;
    dznorm:position 0 ;
    dznorm:provisionText "يصدر رئيس الغرفة أو من ينوبه أمرا بعدم قبول الطعن"@ar ;
    dznorm:sourceArticle "art_676" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_676_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_676> ;
    dzdoc:position 0 ;
    dzdoc:text "يصدر رئيس الغرفة أو من ينوبه أمرا بعدم قبول الطعن إذا تبين من فحص القضية، بوضوح، وجود : عدم جواز الطعن وفقا للمواد 651 و 652 و 653 و 656 أعلاه ، سقوط حق الطعن لرفعه خارج الأجل القانوني المحدد بالمادة 654 أعلاه ، عدم قبول الطعن لمخالفة القواعد الإجرائية المحددة بالمواد 660 و 661 و 662 و 663 و 665 و 668 و 669 من هذا القانون."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_677_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_677> ;
    dzdoc:position 0 ;
    dzdoc:text "بعد المناداة على القضية بالجلسة، يتلو المستشار المقرر المكلف بها تقريره."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_677_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_677> ;
    dzdoc:position 1 ;
    dzdoc:text "إن إجراءات النقض كتابية ويجوز السماح لمحامي أطراف الدعوى ، عند الاقتضاء، بأن يتقدموا بملاحظات شفوية موجزة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_677_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_677> ;
    dzdoc:position 2 ;
    dzdoc:text "وتبدي النيابة العامة طلباتها قبل إقفال باب المناقشة، وبعد ذلك تحال القضية للمداولة لكي تصدر المحكمة العليا القرار في تاريخ محدد."@ar .

