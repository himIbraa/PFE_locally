<https://legal.dz/resource/law/2025-08-03/25-14#version_art_849> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تفصل غرفة الاتهام في الطلب خلال شهرين (2) بعد إبداء طلبات النائب العام وسماع أقوال الطرف الذي يعنيه الأمر أو محاميه، أو بعد ، استدعائه بصفة قانونية ."@ar ;
    dzdoc:isAuthoritative true ;
