<https://legal.dz/resource/law/2025-08-03/25-14#art_370_condition_0_2ef68cb4> a dznorm:Condition ;
    dznorm:conditionText "بعد إذن الرئيس وتحت رقابته"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_370> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_370_condition_1_66fb8b7e> a dznorm:Condition ;
    dznorm:conditionText "ما لم يقرر الرئيس غير ذلك"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_370> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_370_obligation_0_4853a05c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_370> ;
    dznorm:position 0 ;
    dznorm:provisionText "يؤدي الشهود شهادتهم شفويا"@ar ;
    dznorm:sourceArticle "art_370" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_370_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_370> ;
    dzdoc:position 0 ;
    dzdoc:text "يؤدي الشهود شهادتهم شفويا. غير أنه يجوز لهم بصفة استثنائية، الاستعانة بمستندات بترخيص من الرئيس."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_370_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_370> ;
    dzdoc:position 1 ;
    dzdoc:text "ويقوم الرئيس، بعد أداء كل شاهد لشهادته، بتوجيه ما يراه لازما من أسئلة على الشاهد و ما يطرحه عليه أطراف الدعوى من الأسئلة إن كان ثمة محل لذلك."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_370_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_370> ;
    dzdoc:position 2 ;
    dzdoc:text "ولـ النيابة العامة حرية توجيه ما تراه من الأسئلة مباشرة إلى المتهمين وإلى الشهود وإلى الضحايا والأطراف المدنية. ويجوز لدفاع كل من المتهم أو الضحية أو الطرف المدني توجيه الأسئلة مباشرة إلى كل شخص يتم سماعه في الجلسة، بعد إذن الرئيس وتحت رقابته والذي له أن يأمر بعدم الإجابة عن السؤال."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_370_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_370> ;
    dzdoc:position 3 ;
    dzdoc:text "يجوز للشاهد أن ينسحب من قاعة الجلسة بعد أداء شهادته، ما لم يقرر الرئيس غير ذلك."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_370_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_370> ;
    dzdoc:position 4 ;
    dzdoc:text "ويجوز لـ النيابة العامة وكذلك للضحية وللمدعي المدني وللمتهم أن يطلبوا انسحاب الشاهد مؤقتا من قاعة الجلسة بعد أداء شهادته، لكي يتسنى إعادة إدخاله إليها وسماعه من جديد إذا كان ثمة محل لذلك، مع إجراء مواجهات بين الشهود أو عدم إجرائها وللرئيس من تلقاء نفسه أن يأمر بهذا الإجراء."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_370_permission_0_166f8c12> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
