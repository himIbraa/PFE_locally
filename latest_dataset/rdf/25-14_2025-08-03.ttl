    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_846> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_846_obligation_0_78a5a5bc> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
