<https://legal.dz/resource/law/2025-08-03/25-14#version_art_285> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز أيضا لغرفة الاتهام، بالنسبة للجرائم الناتجة من ملف الدعوى، أن تقرر توجيه التهمة طبقا للأوضاع المنصوص عليها في المادة 286 أدناه ، إلى أشخاص لم يكونوا قد أحيلوا إليها ما لم يسبق بشأنهم صدور أمر نهائي بألا وجه للمتابعة أو بحكم أو قرار حائز لقوة الشيء المقضي فيه ولا يجوز الطعن في هذا الأمر بطريق النقض."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_285_20250803_OpEnact_3ec38e96e9> ;
    dzdoc:replacementText "يجوز أيضا لغرفة الاتهام، بالنسبة للجرائم الناتجة من ملف الدعوى، أن تقرر توجيه التهمة طبقا للأوضاع المنصوص عليها في المادة 286 أدناه ، إلى أشخاص لم يكونوا قد أحيلوا إليها ما لم يسبق بشأنهم صدور أمر نهائي بألا وجه للمتابعة أو بحكم أو قرار حائز لقوة الشيء المقضي فيه ولا يجوز الطعن في هذا الأمر بطريق النقض."@ar ;
    dzdoc:resolutionStatus "resolved" ;
