    dznorm:position 0 ;
    dznorm:provisionText "يتعين على كل سلطة نظامية و كل ضابط أو موظف عمومي يصل إلى علمه ، أثناء مباشرته مهام وظيفته، خبر ارتكاب جناية أو جنحة ، إبلاغ النيابة العامة بغير توان و أن يوافيها بكافة المعلومات، ويرسل إليها المحاضر والمستندات المتعلقة بها"@ar ;
    dznorm:sourceArticle "art_42" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_466_obligation_0_9275f0c9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
