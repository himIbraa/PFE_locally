<https://legal.dz/resource/law/2025-08-03/25-14#art_756_obligation_0_65f49997> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/law/2025-08-03/25-14#art_756_obligation_0_65f49997_ref_35c37f597ce9> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_756_obligation_0_65f49997_role_5638c41abf> ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_754> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_754> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_756> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتعين على رئيس المجلس القضائي أو المحكمة، بعد النطق بحكم الإدانة طبقا للمادة 754 أعلاه، أن ينذر المحكوم عليه بأنه في حالة صدور حكم جديد عليه بالإدانة، فإن العقوبة الأولى ستنفذ عليه دون أن يكون من الممكن أن تلتبس بالعقوبة الثانية"@ar ;
    dznorm:sourceArticle "art_756" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_756_obligation_0_65f49997_ref_35c37f597ce9> a dzdoc:Reference ;
    rdfs:label "للمادة 754"@ar ;
    dzdoc:frbrUri "#art_754"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2025-08-03/25-14#art_754> ;
    dzdoc:sourceEId "art_756" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يتعين على رئيس المجلس القضائي أو المحكمة، بعد النطق بحكم الإدانة طبقا للمادة 754 أعلاه، أن ينذر المحكوم عليه بأنه في حالة صدور حكم جديد عليه بالإدانة، فإن العقوبة الأولى ستنفذ عليه دون أن يكون من الممكن أن تلتبس بالعقوبة الثانية"@ar ;
    dzdoc:targetEId "art_754" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_756_obligation_0_65f49997_role_5638c41abf> a dznorm:Role ;
    rdfs:label "رئيس المجلس القضائي أو"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يتعين على رئيس المجلس القضائي أو المحكمة، بعد النطق بحكم الإدانة طبقا للمادة 754 أعلاه، أن ينذر المحكوم عليه بأنه في حالة صدور حكم جديد عليه بالإدانة، فإن العقوبة الأولى ستنفذ عليه دون أن يكون من الممكن أن تلتبس بالعقوبة الثانية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_756> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_756_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_756> ;
    dzdoc:position 0 ;
    dzdoc:text "يتعين على رئيس المجلس القضائي أو المحكمة، بعد النطق بحكم الإدانة طبقا للمادة 754 أعلاه، أن ينذر المحكوم عليه بأنه في حالة صدور حكم جديد عليه بالإدانة، فإن العقوبة الأولى ستنفذ عليه دون أن يكون من الممكن أن تلتبس بالعقوبة الثانية كما يستحق عقوبات العود بنصوص المواد 85 و 86 من قانون العقوبات."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_757_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_757> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يمتد إيقاف العقوبة إلى دفع مصاريف الدعوى أو التعويضات المدنية، كما لا يمتد أيضا إلى عدم الأهلية الناتجة عن حكم الإدانة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_757_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_757> ;
    dzdoc:position 1 ;
    dzdoc:text "ومع ذلك، فإن عدم الأهلية يوقف أثرها من اليوم الذي يصير فيه حكم الإدانة كأن لم يكن تطبيقا لأحكام المادة 767 أدناه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_758_condition_0_3a314017> a dznorm:Condition ;
    dznorm:conditionText "إذا حدث بعد هروب متابع تم إمساكه أو حصل في أية حالة أخرى، أن كانت هوية المحكوم عليه محل نزاع"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_758> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_758_condition_1_51b10191> a dznorm:Condition ;
    dznorm:conditionText "فإذا ثار النزاع في ذلك أثناء سير وبمناسبة متابعة جديدة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_758> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_758_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_758> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا حدث بعد هروب متابع تم إمساكه أو حصل في أية حالة أخرى، أن كانت هوية المحكوم عليه محل نزاع، يفصل في هذا النزاع وفق القواعد المقررة في مادة إشكالات التنفيذ، غير أن الجلسة تكون علنية. فإذا ثار النزاع في ذلك أثناء سير وبمناسبة متابعة جديدة، قام بحسمه المجلس القضائي أو المحكمة المطروحة أمامها هذه المتابعة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_759_obligation_0_c1ca67bf> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
