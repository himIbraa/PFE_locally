<https://legal.dz/resource/law/2025-08-03/25-14#version_art_265> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقيد الأوامر الصادرة عن قاضي التحقيق عملا بأحكام هذا القسم في ذيل صحيفة طلبات وكيل الجمهورية . وتتضمن اسم المتهم ولقبه ونسبه وتاريخ ومكان مولده وموطنه ومهنته . كما يذكر بها الوصف القانوني للواقعة المنسوبة إليه، وتحدد على وجه الدقة الأسباب التي من أجلها توجد أو لا توجد ضده دلائل كافية والمواد القانونية المطبقة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_265_20250803_OpEnact_4381e13510> ;
    dzdoc:replacementText "تقيد الأوامر الصادرة عن قاضي التحقيق عملا بأحكام هذا القسم في ذيل صحيفة طلبات وكيل الجمهورية . وتتضمن اسم المتهم ولقبه ونسبه وتاريخ ومكان مولده وموطنه ومهنته . كما يذكر بها الوصف القانوني للواقعة المنسوبة إليه، وتحدد على وجه الدقة الأسباب التي من أجلها توجد أو لا توجد ضده دلائل كافية والمواد القانونية المطبقة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_265> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_265> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_266> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ل وكيل الجمهورية الحق في أن يستأنف أمام غرفة الاتهام جميع أوامر قاضي التحقيق . ويكون هذا الاستئناف بتقرير بأمانة ضبط المحكمة، و يجب أن يرفع في ثلاثة (3) أيام من تاريخ صدور الأمر . مع مراعاة أحكام المادة 259 أعلاه ، متى رفع الاستئناف من النيابة العامة، بقي المتهم المحبوس مؤقتا في حبسه حتى يفصل في الاستئناف ويبقى كذلك، في جميع الأحوال، إلى حين انقضاء أجل استئناف وكيل الجمهورية ، إلا إذا وافق وكيل الجمهورية على الإفراج عن المتهم في الحال."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_266_20250803_OpEnact_852b17d863> ;
    dzdoc:replacementText "ل وكيل الجمهورية الحق في أن يستأنف أمام غرفة الاتهام جميع أوامر قاضي التحقيق . ويكون هذا الاستئناف بتقرير بأمانة ضبط المحكمة، و يجب أن يرفع في ثلاثة (3) أيام من تاريخ صدور الأمر . مع مراعاة أحكام المادة 259 أعلاه ، متى رفع الاستئناف من النيابة العامة، بقي المتهم المحبوس مؤقتا في حبسه حتى يفصل في الاستئناف ويبقى كذلك، في جميع الأحوال، إلى حين انقضاء أجل استئناف وكيل الجمهورية ، إلا إذا وافق وكيل الجمهورية على الإفراج عن المتهم في الحال."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_266> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_266> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_267> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحق الاستئناف أيضا للنائب العام في جميع الأحوال ، و يجب أن يبلغ استئنافه للخصوم خلال العشرين (20) يوما التالية لصدور أمر قاضي التحقيق . ولا يوقف هذا الأجل ولا رفع الاستئناف تنفيذ الأمر بالإفراج."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_267_20250803_OpEnact_443e1b4552> ;
    dzdoc:replacementText "يحق الاستئناف أيضا للنائب العام في جميع الأحوال ، و يجب أن يبلغ استئنافه للخصوم خلال العشرين (20) يوما التالية لصدور أمر قاضي التحقيق . ولا يوقف هذا الأجل ولا رفع الاستئناف تنفيذ الأمر بالإفراج."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_267> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
