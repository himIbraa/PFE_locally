<https://legal.dz/resource/law/2025-08-03/25-14#version_art_504> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يكن ممكنا إنهاء المرافعات أثناء الجلسة نفسها ، حددت المحكمة بحكم تاريخ اليوم الذي يكون فيه استمرار المرافعة و يتعين أن يحضر فيه أطراف الدعوى والشهود الذين لم يسمعوا ومن أمرت المحكمة بإبقائهم تحت تصرفها لحين إتمام المرافعة، وذلك بغير تكليف آخر بحضور جلسة التأجيل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_504_20250803_OpEnact_9f8a4a234e> ;
    dzdoc:replacementText "إذا لم يكن ممكنا إنهاء المرافعات أثناء الجلسة نفسها ، حددت المحكمة بحكم تاريخ اليوم الذي يكون فيه استمرار المرافعة و يتعين أن يحضر فيه أطراف الدعوى والشهود الذين لم يسمعوا ومن أمرت المحكمة بإبقائهم تحت تصرفها لحين إتمام المرافعة، وذلك بغير تكليف آخر بحضور جلسة التأجيل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_504> ;
