    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_107> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_107_obligation_1_a198b377> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
