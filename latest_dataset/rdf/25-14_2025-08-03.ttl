    dznorm:sourceArticle "art_304" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_304_right_0_3f5689a9_action_1cbfc61cca> a dznorm:Action ;
    rdfs:label "لضابط أو عون الشرطة القضائية"@ar ;
    dzdoc:confidenceScore 0.62 ;
