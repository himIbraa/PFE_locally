    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_609> ;
    dznorm:conditionText "وتعتبر المعارضة كأن لم تكن إذا لم يحضر المعارض في التاريخ المحدد له في التبليغ الصادر إليه شفويا أو لمحاميه والمثبت في محضر الطعن بالمعارضة في وقت المعارضة أو بتكليف بالحضور جديد مسلم لمن يعنيه الأمر طبقا للمواد 609 وما يليها من هذا القانون"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_583> ;
    dznorm:position 0 .

