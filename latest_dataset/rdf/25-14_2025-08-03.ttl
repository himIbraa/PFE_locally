<https://legal.dz/resource/law/2025-08-03/25-14#version_art_688> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يثبت التنازل عن الطعن بالنقض بموجب أمر من الرئيس الأول للمحكمة العليا أو من رئيس الغرفة المختصة ، وذلك في أية حالة كانت عليها الإجراءات. يؤشر على طلب التنازل عن الطعن بالنقض أمين ضبط المؤسسة العقابية أو أمين ضبط الجهة القضائية المطعون في قرارها أو أمين ضبط المحكمة العليا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_688_20250803_OpEnact_253497e7d3> ;
    dzdoc:replacementText "يثبت التنازل عن الطعن بالنقض بموجب أمر من الرئيس الأول للمحكمة العليا أو من رئيس الغرفة المختصة ، وذلك في أية حالة كانت عليها الإجراءات. يؤشر على طلب التنازل عن الطعن بالنقض أمين ضبط المؤسسة العقابية أو أمين ضبط الجهة القضائية المطعون في قرارها أو أمين ضبط المحكمة العليا ."@ar ;
