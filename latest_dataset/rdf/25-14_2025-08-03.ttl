<https://legal.dz/resource/law/2025-08-03/25-14#version_art_577> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل شخص كلف بالحضور تكليفا صحيحا وتخلف عن الحضور في اليوم والساعة المحددين في أمر التكليف ، يحكم عليه غيابيا وفقا لأحكام المادة 496 أعلاه ، وذلك فيما عدا الحالات المنصوص عليها في المواد 382 و 495 و 497 و 499 و 500 من هذا القانون. غير أنه إذا كانت المخالفة لا تستوجب غير عقوبة الغرامة ، جاز للمتهم أن ينيب للحضور عنه أحد أعضاء عائلته بموجب توكيل خاص ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
