<https://legal.dz/resource/law/2025-08-03/25-14#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_1> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "يقوم هذا القانون على مبادئ الشرعية و المحاكمة العادلة واحترام كرامة و حقوق الإنسان ، ويأخذ بعين الاعتبار، على الخصوص: أن كل شخص يعتبر بريئا ما لم تثبت إدانته بحكم قضائي حائز لقوة الشيء المقضي فيه ، أنه لا يجوز متابعة أو محاكمة أو معاقبة شخص مرتين (2) من أجل نفس الأفعال و لو تم إعطاؤها وصفا مغايرا ، أن تجري المتابعة والإجراءات التي تليها في آجال معقولة ودون تأخير غير مبرر ، و تعطى الأولوية للقضية التي يكون فيها المتهم موقوفا ، أن يفسر الشك، في كل الأحوال، لصالح المتهم ، أن السلطة القضائية تسهر على إعلام ذوي الحقوق المدنية وضمان حماية حقوقهم خلال كافة الإجراءات ، وجوب أن تكون الأحكام والقرارات والأوامر القضائية معللة ، أن لكل شخص حكم عليه الحق في أن تنظر في قضيته جهة قضائية عليا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_1_permission_0_977a8e59> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_1_right_0_9e6fe298>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_1_right_1_1e358868> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_1_20250803_OpEnact_792a5551d6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_1_obligation_0_95cc424a>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_1_obligation_1_694c0a53>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_1_obligation_2_b3832476>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_1_obligation_3_b6b91c8d>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_1_obligation_4_1d949b9e>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_1_obligation_5_c1dd4aee> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_1_prohibition_0_977a8e59> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة الأولى" ;
    dzdoc:position 0 ;
    dzdoc:usesTerm dzterm:fair_trial,
        dzterm:human_dignity,
        dzterm:human_rights,
        dzterm:legality .

<https://legal.dz/resource/law/2025-08-03/25-14#art_207> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_7> ;
    dzdoc:eId "art_207" ;
    dzdoc:fullText "يجوز لـ قاضي التحقيق في جميع المواد أن يأمر من تلقاء نفسه بالإفراج ما لم يكن لازما بقوة القانون وذلك بعد استطلاع رأي وكيل الجمهورية ، شريطة أن يتعهد المتهم بالحضور في جميع إجراءات التحقيق بمجرد استدعائه وأن يخطر القاضي المحقق بجميع تنقلاته . كما يجوز لـ وكيل الجمهورية طلب الإفراج في كل وقت ، و على قاضي التحقيق أن يبت في ذلك خلال ثمان وأربعين (48) ساعة من تاريخ هذا الطلب ، و عند انتهاء هذه المهلة و في حالة ما إذا لم يبت قاضي التحقيق ، يفرج على المتهم في الحين بسعي من النيابة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_207_permission_0_800d1e26>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_207_permission_1_5b42bdd1> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_207_right_0_7f98f388>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_207_right_1_51b6dca9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_207> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_207_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_207_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_207_20250803_OpEnact_cae09fdc3c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_207_obligation_0_67972998> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "207" ;
    dzdoc:position 206 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_207_condition_0_abebc29a>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_207_condition_1_7baaeeaf> ;
    dzdoc:usesTerm dzterm:accused,
        dzterm:investigating_judge,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_24> a dzdoc:Article ;
