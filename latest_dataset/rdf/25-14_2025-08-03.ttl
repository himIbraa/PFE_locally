    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_645> ;
    dznorm:position 0 ;
    dznorm:provisionText "حقوقه المنصوص عليها في المادة 201 أعلاه"@ar ;
    dznorm:sourceArticle "art_645" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_645_right_0_566469c9_ref_0c9c16f454a2> a dzdoc:Reference ;
