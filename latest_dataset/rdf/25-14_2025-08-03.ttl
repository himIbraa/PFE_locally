<https://legal.dz/resource/law/2025-08-03/25-14#version_art_486> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يقدم مرتكب الجنحة المتلبس بها ضمانات كافية للحضور أمام القضاء ، وكانت الجنحة معاقبا عليها بعقوبة الحبس حدها الأدنى يساوي أو يفوق ستة (6) أشهر ولم يكن قاضي التحقيق قد أخطر بها يصدر وكيل الجمهورية ، استثناء، أمرا بإيداع المتهم الحبس بعد استجوابه عن هويته وعن الأفعال والتهم المنسوبة إليه، ثم يحيله فورا على المحكمة ، على أن تحدد جلسة النظر في القضية في أجل أقصاه خمسة (5) أيام، ابتداء من يوم صدور الأمر بالإيداع . تطبق مقتضيات المادتين 475 و 477 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_486_20250803_OpEnact_c93c5b0b58> ;
    dzdoc:replacementText "إذا لم يقدم مرتكب الجنحة المتلبس بها ضمانات كافية للحضور أمام القضاء ، وكانت الجنحة معاقبا عليها بعقوبة الحبس حدها الأدنى يساوي أو يفوق ستة (6) أشهر ولم يكن قاضي التحقيق قد أخطر بها يصدر وكيل الجمهورية ، استثناء، أمرا بإيداع المتهم الحبس بعد استجوابه عن هويته وعن الأفعال والتهم المنسوبة إليه، ثم يحيله فورا على المحكمة ، على أن تحدد جلسة النظر في القضية في أجل أقصاه خمسة (5) أيام، ابتداء من يوم صدور الأمر بالإيداع . تطبق مقتضيات المادتين 475 و 477 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_486> ;
