<https://legal.dz/resource/law/2025-08-03/25-14#version_art_29> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد من أعوان الضبط القضائي ، موظفو مصالح الشرطة، وذوو الرتب في الدرك الوطني، والدركيون، ومستخدمو المصالح العسكرية للأمن، ومفتشو الملاحة والعمل البحري، وكذا أعوان حرس السواحل التابعون للمصلحة الوطنية لحرس السواحل، الذين ليست لهم صفة ضابط الشرطة القضائية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_29_20250803_OpEnact_5ce016c1da> ;
    dzdoc:replacementText "يعد من أعوان الضبط القضائي ، موظفو مصالح الشرطة، وذوو الرتب في الدرك الوطني، والدركيون، ومستخدمو المصالح العسكرية للأمن، ومفتشو الملاحة والعمل البحري، وكذا أعوان حرس السواحل التابعون للمصلحة الوطنية لحرس السواحل، الذين ليست لهم صفة ضابط الشرطة القضائية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
