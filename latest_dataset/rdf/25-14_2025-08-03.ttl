    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "609" ;
    dzdoc:position 608 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_609_condition_0_8e3567d9> ;
