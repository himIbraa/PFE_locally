<https://legal.dz/resource/law/2025-08-03/25-14#art_57_condition_0_4d6cde22> a dznorm:Condition ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2025-08-03/25-14#art_57_condition_0_4d6cde22_period_74b2b9cc06> ;
    dznorm:conditionText "في الوقائع التي تكتسي وصف مخالفة أو جنحة قليلة الخطورة معاقب عليها بالغرامة و / أو الحبس لمدة لا تتجاوز الثلاث (3) سنوات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_57> ;
    dznorm:position 0 .

