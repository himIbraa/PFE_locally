    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "804" ;
    dzdoc:position 802 ;
    dzdoc:usesTerm dzterm:bulletin_2,
        dzterm:bulletin_3,
        dzterm:central_criminal_record,
        dzterm:clerk,
        dzterm:judge,
        dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_823> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_3> ;
    dzdoc:eId "art_823" ;
    dzdoc:fullText "تتلق صحيفة مخالفات المرور بأمانة ضبط المجلس القضائي ، البطاقات المنصوص عليها في المادة 824 أدناه ، الخاصة بالأشخاص المولودين في دائرة ذلك المجلس. وتتلقى صحيفة مخالفات المرور بالمصلحة المركزية لصحيفة السوابق القضائية بوزارة العدل البطاقات الخاصة بالأشخاص المولودين في الخارج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_823> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_823_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_823_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_823_20250803_OpEnact_65a0ecb76a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "823" ;
    dzdoc:position 821 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_824> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_824> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_829> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_4> ;
    dzdoc:eId "art_829" ;
    dzdoc:fullText "تتلقى صحيفة الإدمان على المواد الكحولية والمخدرات والمؤثرات العقلية بأمانة ضبط المجلس القضائي البطاقات المنصوص عليها في المادة 830 أدناه، الخاصة بالأشخاص المولودين في دائرة اختصاص هذا المجلس. وتتلقى الصحيفة الموجودة بالمصلحة المركزية لصحيفة السوابق القضائية بوزارة العدل البطاقات الخاصة بالأشخاص المولودين في الخارج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_829> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_829_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_829_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_829_20250803_OpEnact_ad10f62844> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "829" ;
    dzdoc:position 827 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_830> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_830> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_839> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_6_sec_2> ;
    dzdoc:eId "art_839" ;
    dzdoc:fullText "يتعين أن يشمل طلب رد الاعتبار مجموع العقوبات الصادرة التي لم يحصل محوها عن طريق رد اعتبار سابق أو بصدور عفو شامل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_839> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_839_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_839_20250803_OpEnact_6f8e6ba759> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_839_obligation_0_aae2b6ef> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "839" ;
    dzdoc:position 837 ;
    dzdoc:usesTerm dzterm:rehabilitation_request .

<https://legal.dz/resource/law/2025-08-03/25-14#art_862> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_1_sec_1> ;
    dzdoc:eId "art_862" ;
    dzdoc:fullText "مع مراعاة الاستثناءات المنصوص عليها فيما يلي، لا يقبل التسليم إلا بشرط أن لا يكون الشخص المسلم موضوع متابعة أو أن لا يحكم عليه في جريمة خلاف تلك التي بررت التسليم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_862> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_862_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_862_20250803_OpEnact_aba0f316f0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_862_obligation_0_531655b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "862" ;
    dzdoc:position 860 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_887> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_3> ;
    dzdoc:eId "art_887" ;
    dzdoc:fullText "يخضع تنفيذ الإجراءات أو أعمال الإجراءات المنصوص عليها في المواد 883 و 884 و 885 و 886 أعلاه، لـ شرط المعاملة بالمثل من جانب الدولة الصادرة منها الطلبات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_887> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_887_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_887_20250803_OpEnact_030cb8e04a> ;
