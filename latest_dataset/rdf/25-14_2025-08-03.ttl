<https://legal.dz/resource/law/2025-08-03/25-14#version_art_112> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة ما إذا لم تحترم الالتزامات الواقعة على عاتق الشخص المعنوي بصفة كلية أو جزئية ، يقوم وكيل الجمهورية بإبلاغ ممثله القانوني بوقف تنفيذ اتفاقية إرجاء المتابعة الجزائية . يسري توقيف تنفيذ الاتفاقية فور تبليغه للممثل القانوني للشخص المعنوي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_112_20250803_OpEnact_054a43c817> ;
    dzdoc:replacementText "في حالة ما إذا لم تحترم الالتزامات الواقعة على عاتق الشخص المعنوي بصفة كلية أو جزئية ، يقوم وكيل الجمهورية بإبلاغ ممثله القانوني بوقف تنفيذ اتفاقية إرجاء المتابعة الجزائية . يسري توقيف تنفيذ الاتفاقية فور تبليغه للممثل القانوني للشخص المعنوي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
