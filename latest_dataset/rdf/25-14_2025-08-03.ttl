    dznorm:provisionText "تطبق أمام المجلس القضائي القواعد المقررة للمحاكم"@ar ;
    dznorm:sourceArticle "art_600" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_600_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_600> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق أمام المجلس القضائي القواعد المقررة للمحاكم مع مراعاة ما ورد من استثناء في أحكام المواد الواردة في هذا القسم."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_601_condition_0_4c502b40> a dznorm:Condition ;
    dznorm:conditionText "عند الفصل في الاستئناف"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_601> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_601_condition_1_dd173f6e> a dznorm:Condition ;
    dznorm:conditionText "إذا أمر المجلس بسماعهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_601> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_601_obligation_0_ad2e06c4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_601_obligation_0_ad2e06c4_role_8649cd031c> ;
