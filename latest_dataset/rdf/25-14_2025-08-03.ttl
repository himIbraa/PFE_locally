    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "فإذا لم توجد في قضية جنائية نسخة رسمية من الحكم ولكن وجد تقرير محكمة الجنايات حسبما هو مقرر في المادة 449 (النقطة 8) أعلاه ، سارت الإجراءات على مقتضى هذا التقرير إلى حين صدور حكم جديد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_704_20250803_OpEnact_5a3773d87a> ;
