<https://legal.dz/resource/law/2025-08-03/25-14#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:definesTerm dzterm:statute_of_limitations_misdemeanor ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_1> ;
    dzdoc:eId "art_11" ;
    dzdoc:fullText "تتقادم الدعوى العمومية في مواد الجنح بمرور خمس (5) سنوات كاملة . وتكون مدة التقادم عشر (10) سنوات كاملة، إذا كانت عقوبة الحبس المقررة قانونا تزيد عن خمس (5) سنوات . وتتبع في كيفيات احتساب آجال التقادم، الأحكام الموضحة في المادة 10 أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_11> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_11_defocc_5889f1b9bf77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_11_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_11_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_11_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_11_20250803_OpEnact_ad35e989c2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "11" ;
    dzdoc:position 10 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_10> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_10> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_11_condition_0_b184c963> ;
    dzdoc:usesTerm dzterm:public_action .

<https://legal.dz/resource/law/2025-08-03/25-14#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "يوقف سريان اجال تقادم الدعوى العمومية خلال فترة تنفيذ اتفاقية إرجاء المتابعة الجزائية . تنقضي الدعوى العمومية بتنفيذ الشخص المعنوي كل الالتزامات الواقعة عليه بموجب اتفاقية إرجاء المتابعة . يقوم وكيل الجمهورية بإبلاغ الشخص المعنوي المعني وباقي الأطراف بانقضاء الدعوى العمومية. لا يحول انقضاء الدعوى العمومية دون مواصلة الأطراف الأخرى المتضررة من الجريمة استيفاء حقوقهم المدنية أمام القضاء المدني ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_110_right_0_b55e8544> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_110_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_110_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_110_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_110_20250803_OpEnact_a0516a8b51> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_110_obligation_0_c420e45f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 110" ;
    dzdoc:position 109 ;
    dzdoc:usesTerm dzterm:deferral_agreement,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_116> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_4> ;
    dzdoc:eId "art_116" ;
    dzdoc:fullText "يجب أن يتضمن الإذن المذكور في المادة 114 أعلاه، كل العناصر التي تسمح بالتعرف على الاتصالات المطلوب التقاطها والأماكن المقصودة، سكنية أو غيرها، والجريمة التي تبرر اللجوء إلى هذه التدابير ، ومدتها. يسلم الإذن مكتوبا لمدة أقصاها أربعة (4) أشهر قابلة للتجديد ضمن نفس الشروط الشكلية والزمنية إلى غاية انتهاء مقتضيات التحري أو التحقيق القضائي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_116> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_116_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_116_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_116_20250803_OpEnact_457bc750ba> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_116_obligation_0_54f0a6fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 116" ;
    dzdoc:position 115 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_114> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_114> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_119> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_4> ;
    dzdoc:eId "art_119" ;
    dzdoc:fullText "يصف أو ينسخ ضابط الشرطة القضائية المأذون له أو المناب المراسلات أو الصور أو المحادثات المسجلة والمفيدة في إظهار الحقيقة في محضر يودع بالملف ، و ترفق به الدعامة الإلكترونية إذا طلبها وكيل الجمهورية . تنسخ وتترجم المكالمات التي تتم باللغات الأجنبية، عند الاقتضاء ، بمساعدة مترجم يسخر لهذا الغرض ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_119> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_119_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_119_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_119_20250803_OpEnact_55c559d703> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_119_obligation_0_e5d82c90>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_119_obligation_1_752fcff6>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_119_obligation_2_4930da15> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "119" ;
    dzdoc:position 118 ;
    dzdoc:usesTerm dzterm:judicial_police_officer,
        dzterm:public_prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_127> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_5> ;
    dzdoc:eId "art_127" ;
    dzdoc:fullText "يجوز سماع ضابط الشرطة القضائية الذي تجري عملية التسرب تحت مسؤوليته دون سواه بوصفه شاهدا عن العملية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_127_permission_0_b0238dea> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_127_right_0_1d133427> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_127> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_127_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_127_20250803_OpEnact_f850a2dc12> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "127" ;
    dzdoc:position 126 ;
    dzdoc:usesTerm dzterm:police_officer .

<https://legal.dz/resource/law/2025-08-03/25-14#art_133> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_6> ;
    dzdoc:eId "art_133" ;
    dzdoc:fullText "إذا رأى قاضي التحقيق أن أحد الأشخاص المذكورين في هذا الفصل معرض للأخطار المذكورة في المادة 128 أعلاه، وقرر عدم ذكر هويته وكذا البيانات المنصوص عليها في المادة 132 أعلاه ، فإنه ينبغي أن يشير فيه السماع إلى الأسباب التي بررت ذلك . تحفظ المعلومات السرية في ملف خاص يمسكه قاضي التحقيق ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_133> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_133_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_133_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_133_20250803_OpEnact_12763b1306> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_133_obligation_0_36b2d2d0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_133_obligation_1_444c0f1e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 133" ;
    dzdoc:position 132 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_128>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_132> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_128>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_132> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_133_condition_0_6387e71b> ;
    dzdoc:usesTerm dzterm:investigating_judge .

<https://legal.dz/resource/law/2025-08-03/25-14#art_163> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_4> ;
    dzdoc:eId "art_163" ;
    dzdoc:fullText "يستدعي قاض التحقيق أمامه، بصفته شاهدا، كل شخص يرى فائدة من سماع شهادته. يتم استدعاء الشهود برسالة عادية أو برسالة موصى عليها أو بالطريق الإلكتروني، كما يمكنهم المثول طواعية. كما يمكن قاضي التحقيق استدعاء الشاهد بواسطة أحد أعوان القوة العمومية ، وتسلم نسخة من الاستدعاء إلى الشخص المطلوب حضوره."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_163_permission_0_3264a6d5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_163> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_163_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_163_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_163_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_163_20250803_OpEnact_dcd3691967> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 163" ;
    dzdoc:position 162 ;
    dzdoc:usesTerm dzterm:investigating_judge .

<https://legal.dz/resource/law/2025-08-03/25-14#art_169> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_4> ;
    dzdoc:eId "art_169" ;
    dzdoc:fullText "يوقع على كل صفحة من صفحات محضر التحقيق من قاضي التحقيق و أمين الضبط والشاهد ويدعى الأخير إلى إعادة تلاوة فحوى شهادته بنصها الذي حررت به والتوقيع إن أصر عليها، فإذا لم يكن الشاهد ملما بالقراءة يتلى عليه بمعرفة أمين الضبط . و إن امتنع الشاهد عن التوقيع أو تعذر عليه نوه عن ذلك في المحضر . يوقع أيضا على كل صفحة بهذه الكيفية من المترجم إن كان ثمة محل لذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_169> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_169_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_169_20250803_OpEnact_9786887c92> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_169_obligation_0_3643c76b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 169" ;
    dzdoc:position 168 ;
    dzdoc:usesTerm dzterm:clerk .

<https://legal.dz/resource/law/2025-08-03/25-14#art_171> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_4> ;
    dzdoc:eId "art_171" ;
    dzdoc:fullText "يجوز للقاضي مناقشة الشاهد ومواجهته بشهود آخرين أو بالمتهم و أن يجري بمشاركتهم كل الإجراءات والتجارب الخاصة بإعادة تمثيل الجريمة مما يراه لازما لإظهار الحقيقة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_171_permission_0_86ae872a> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_171_right_0_1fd1d38f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_171> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_171_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_171_20250803_OpEnact_176bae0d94> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 171" ;
    dzdoc:position 170 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_174> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_4> ;
    dzdoc:eId "art_174" ;
    dzdoc:fullText "إذا تعذر على شاهد الحضور انتقل إليه قاضي التحقيق برفقة أمين الضبط ، وبعد إخطار وكيل الجمهورية ، لسماع شهادته أو اتخذ لهذا الغرض طريق الإنابة القضائية. فإذا تحقق من أن شاهدا قد أدعى كذبا عدم استطاعته الحضور جاز له أن يتخذ ضده الإجراءات القانونية طبقا لأحكام المادة 172 أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_174> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_174_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_174_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_174_20250803_OpEnact_73a0e0d165> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 174" ;
    dzdoc:position 173 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_172> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_172> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_174_condition_0_413204f8>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_174_condition_1_a065013b> ;
    dzdoc:usesTerm dzterm:clerk,
        dzterm:investigating_judge,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_178> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_5> ;
    dzdoc:eId "art_178" ;
    dzdoc:fullText "يجوز للضحية وللمدعي المدني الذي استوفي شروط صحة ادعائه أن يستعين بمحام منذ أول يوم تسمع فيه أقواله ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_178_permission_0_8ac8da0e> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_178_right_0_6320fba4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_178> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_178_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_178_20250803_OpEnact_c3af843ec4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 178" ;
    dzdoc:position 177 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_179> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_5> ;
    dzdoc:eId "art_179" ;
    dzdoc:fullText "يجوز للمتهم وللضحية و للمدعي المدني أن يحيطوا قاضي التحقيق ، في كل دور من أدوار التحقيق، علما بالمحامي الذي وقع اختيار كل منهما عليه ، وإذا اختير عدة محامين فإنه يكفي استدعاء أو تبليغ أحدهم بالحضور."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_179_permission_0_c92091c9> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_179_right_0_6d8f62ec> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_179> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_179_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_179_20250803_OpEnact_372c599aa3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 179" ;
    dzdoc:position 178 ;
    dzdoc:usesTerm dzterm:investigating_judge .

<https://legal.dz/resource/law/2025-08-03/25-14#art_187> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_6> ;
    dzdoc:eId "art_187" ;
    dzdoc:fullText "يجب أن يستجوب في الحال، كل من سيق أمام قاضي التحقيق تنفيذا لأمر إحضار، بمساعدة محاميه ، فإذا تعذر استجوابه على الفور ، قدم أمام وكيل الجمهورية الذي يطلب من القاضي المكلف بالتحقيق، وفي حالة غيابه فمن أي قاض آخر من قضاة ، هيئة القضاء أن يقوم باستجواب المتهم في الحال وإلا أخلي سبيله."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_187> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_187_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_187_20250803_OpEnact_545fccb015> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_187_obligation_0_ad39b8f2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "187" ;
    dzdoc:position 186 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_187_condition_0_eee08470> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_220> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:definesTerm dzterm:committee,
        dzterm:compensation_committee ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_8> ;
    dzdoc:eId "art_220" ;
    dzdoc:fullText "يمنح التعويض المنصوص عليه في المادة 219 أعلاه، بقرار من لجنة تنشأ على مستوى المحكمة العليا تدعى \"لجنة التعويض\" والمسماة في هذا القانون \"اللجنة\" ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_220> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_220_defocc_af8a84c47e3c>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_220_defocc_ba3595adb803> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_220_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_220_20250803_OpEnact_ac25452ee7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 220" ;
    dzdoc:position 219 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_219> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_219> ;
    dzdoc:usesTerm dzterm:supreme_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_222> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_8> ;
    dzdoc:eId "art_222" ;
    dzdoc:fullText "تكتسي اللجنة طابع جهة قضائية مدنية. يتولى مهام النيابة العامة النائب العام لدى المحكمة العليا أو مساعده. يتولى مهام أمين اللجنة أحد أمناء ضبط المحكمة العليا، يلحق بها من طرف الرئيس الأول للمحكمة العليا. تجتمع اللجنة في غرفة المشورة وتصدر قراراتها في جلسة علنية. قرارات اللجنة غير قابلة لأي طعن، ولها القوة التنفيذية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_222> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_222_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_222_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_222_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_222_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_222_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_222_20250803_OpEnact_8da9966ce8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 222" ;
    dzdoc:position 221 ;
    dzdoc:usesTerm dzterm:committee .

<https://legal.dz/resource/law/2025-08-03/25-14#art_224> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_8> ;
    dzdoc:eId "art_224" ;
    dzdoc:fullText "يرسل أمين اللجنة نسخة من العريضة إلى الوكيل القضائي للخزينة برسالة موصى عليها مع إشعار بالاستلام في أجل لا يتعدى عشرين (20) يوما، ابتداء من تاريخ استلامها. يطلب أمين اللجنة الملف الجزائي من أمانة ضبط الجهة القضائية التي أصدرت قرارا بألا وجه للمتابعة أو بالبراءة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_224> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_224_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_224_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_224_20250803_OpEnact_3429721181> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_224_obligation_0_1f8ab40e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 224" ;
    dzdoc:position 223 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:definesTerm dzterm:judicial_police_officer ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "يتمتع بصفة ضابط الشرطة القضائية : 1 - رؤساء المجالس الشعبية البلدية، 2- ضباط الدرك الوطني، 3- الموظفون التابعون للأسلاك الخاصة للمراقبين، ومحافظي، وضباط الشرطة للأمن الوطني، 4- ضباط الصف الذين أمضوا في سلك الدرك الوطني ثلاث (3) سنوات، على الأقل، وتم تعيينهم بموجب قرار مشترك صادر عن وزير الدفاع الوطني و وزير العدل ، بعد موافقة لجنة خاصة، 5- الموظفون التابعون للأسلاك الخاصة للمفتشين ومحققي وحفاظ وأعوان الشرطة للأمن الوطني الذين أمضوا ثلاث (3) سنوات، على الأقل، بهذه الصفة والذين تم تعيينهم بموجب قرار مشترك صادر عن وزير العدل و وزير الداخلية بعد موافقة لجنة خاصة، 6- ضباط وضباط الصف التابعون للمصالح العسكرية للأمن الذين تم تعيينهم خصيصا بموجب قرار مشترك صادر عن وزير الدفاع الوطني و وزير العدل ، 7- المتصرفون الإداريون في الشؤون البحرية وقادة الوحدات العائمة التابعون للمصلحة الوطنية لحرس السواحل، في حدود صلاحياتهم المنصوص عليها في التشريع والتنظيم الساريي المفعول، 8- مفتشو الملاحة والعمل البحري وأعوان حرس السواحل التابعون للمصلحة الوطنية لحرس السواحل، الذين قضوا في الخدمة بهذه الصفة ثلاث (3) سنوات، على الأقل، وعينوا بموجب قرار مشترك بين وزير الدفاع الوطني و وزير العدل ، بعد رأي اللجنة الخاصة المذكورة في هذه المادة ، في حدود صلاحياتهم المنصوص عليها في التشريع والتنظيم الساريي المفعول. تحدد تشكيلة اللجنة المنصوص عليها في هذه المادة وتسييرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_23> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_23_defocc_2dfb3539a719> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_23_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_23_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_23_20250803_OpEnact_8fd25fc940> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 23" ;
    dzdoc:position 22 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_23> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_23> ;
    dzdoc:usesTerm dzterm:judicial_police_officer,
        dzterm:minister_defense,
        dzterm:minister_interior,
        dzterm:minister_justice .

<https://legal.dz/resource/law/2025-08-03/25-14#art_231> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_8> ;
    dzdoc:eId "art_231" ;
    dzdoc:fullText "إذا منحت اللجنة تعويضا يتم دفعه وفقا للتشريع المعمول به من طرف أمين خزينة ولاية الجزائر . في حالة رفض الدعوى ، يتحمل المدعي المصاريف إلا إذا قررت اللجنة إعفاءه جزئيا أو كليا منها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_231> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_231_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_231_20250803_OpEnact_74bd5f632c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_231_obligation_0_e7083100>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_231_obligation_1_8c9d1c47> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 231" ;
    dzdoc:position 230 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_231_condition_0_99d87885>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_231_condition_1_acdd4269> ;
    dzdoc:usesTerm dzterm:plaintiff .

<https://legal.dz/resource/law/2025-08-03/25-14#art_236> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_9> ;
    dzdoc:eId "art_236" ;
    dzdoc:fullText "يتعين على كل شاهد استدعي لسماع شهادته أثناء تنفيذ إنابة قضائية، الحضور وحلف اليمين والإدلاء بشهادته. فإذا تخلف عن القيام بهذه الواجبات ، أخطر القاضي المنيب الذي يسوغ له أن يجبر الشاهد على الحضور بواسطة القوة العمومية وأن يطبق في حقه العقوبات المنصوص عليها في الفقرة 2 من المادة 172 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_236> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_236_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_236_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_236_20250803_OpEnact_2f299bce33> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_236_obligation_0_4dd9232c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "236" ;
    dzdoc:position 235 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_172> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_172> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_236_condition_0_eb7c7128> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_243> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_10> ;
    dzdoc:eId "art_243" ;
    dzdoc:fullText "يجوز ل قاضي التحقيق ندب خبير أو خبراء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_243_permission_0_4c7acc79> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_243_right_0_f91da2e8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_243> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_243_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_243_20250803_OpEnact_e55d6a13e8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "243" ;
    dzdoc:position 242 ;
    dzdoc:usesTerm dzterm:investigating_judge .

<https://legal.dz/resource/law/2025-08-03/25-14#art_252> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_10> ;
    dzdoc:eId "art_252" ;
    dzdoc:fullText "إذا حدث في جلسة لإحدى الجهات القضائية أن ناقض شخص يجري سماعه كشاهد أو على سبيل الاستدلال نتائج الخبرة أو أورد في المسألة الفنية بيانات جديدة ، يطلب الرئيس من الخبراء والنيابة العامة والدفاع والضحية والمدعي المدني، إن كان ثمة محل لذلك، أن يبدوا ملاحظاتهم، و على الجهة القضائية أن تصدر قرارا مسببا إما بصرف النظر عن ذلك، وإما بتأجيل القضية إلى تاريخ لاحق، وفي الحالة الأخيرة يسوغ لهذه الجهة القضائية أن تتخذ بشأن الخبرة كل ما تراه لازما من الإجراءات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_252> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_252_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_252_20250803_OpEnact_75224682e0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "252" ;
    dzdoc:position 251 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_252_condition_0_dc33acb1> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_303> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_2_subsec_3> ;
    dzdoc:eId "art_303" ;
    dzdoc:fullText "يرفع الأمر لغرفة الاتهام إما من النائب العام أو من رئيسها عن الإخلالات المنسوبة لضباط وأعوان الشرطة القضائية والموظفين والأعوان المنوطة بهم بعض مهام الضبط القضائي في مباشرة وظائفهم، ولها أن تنظر في ذلك من تلقاء نفسها بمناسبة النظر في قضية مطروحة عليها. يتم إعلام النائب العام العسكري المختص إقليميا إذا تعلق الأمر بضباط الشرطة القضائية للدرك الوطني . غير أن غرفة الاتهام لدى مجلس قضاء الجزائر تعتبر صاحبة الاختصاص وحدها ، إذا تعلق الأمر بضباط وأعوان الشرطة القضائية للمصالح العسكرية للأمن ، وتحال عليها القضية من طرف النائب العام لدى نفس المجلس القضائي، بعد رأي النائب العام العسكري المختص إقليميا، الذي يبديه في أجل خمسة عشر (15) يوما من إخطاره."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_303> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_303_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_303_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_303_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_303_20250803_OpEnact_b333fd1089> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_303_obligation_0_64310c84> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 303" ;
    dzdoc:position 302 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_303_condition_0_5abde601> ;
    dzdoc:usesTerm dzterm:algiers_indictment_chamber,
        dzterm:military_prosecutor,
        dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_306> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_2_subsec_3> ;
    dzdoc:eId "art_306" ;
    dzdoc:fullText "إذا رأت غرفة الاتهام أن أحد ضباط أو أعوان الشرطة القضائية أو الموظفين والأعوان المنوطة بهم بعض مهام الضبط القضائي قد ارتكب جريمة من الجرائم المنصوص عليها في التشريع الجزائي ، تأمر ، فضلا عما تقدم، بإرسال الملف إلى النائب العام . و إذا تعلق الأمر بضابط الشرطة القضائية للمصالح العسكرية للأمن يرفع الأمر إلى وزير الدفاع الوطني لاتخاذ الإجراء اللازم في شأنه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_306> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_306_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_306_20250803_OpEnact_5d35acacdc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_306_obligation_0_6bed1c4b>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_306_obligation_1_ab02368a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 306" ;
    dzdoc:position 305 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_306_condition_0_462a0c46>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_306_condition_1_fb7cc03d> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_35> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_35" ;
    dzdoc:fullText "يجوز لـ وكيل الجمهورية ولـ قاضي التحقيق ولـ ضابط الشرطة القضائية طلب يد المساعدة من الموظفين وأعوان الإدارات والمصالح العمومية المكلفين ببعض مهام الضبط القضائي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_35_permission_0_0a37b598> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_35_right_0_fccdec31> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_35> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_35_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_35_20250803_OpEnact_1933642bba> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "35" ;
    dzdoc:position 34 ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:judicial_police,
        dzterm:judicial_police_officer,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_368> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_1_sec_1> ;
    dzdoc:eId "art_368" ;
    dzdoc:fullText "تقبل شهادة الشخص الذي أبلغ العدالة بوقائع الدعوى ، قياما بـ بالتزام قانوني أو من تلقاء نفسه، ولكن الرئيس يخطر الجهة القضائية بذلك، كما يقبل سماع شهادة من يقرر له القانون مكافأة مالية لإبلاغه بالحادث ، وذلك ما لم تعارض النيابة العامة في سماع شهادته ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_368_right_0_8aa5d28e>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_368_right_1_d05d3c3c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_368> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_368_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_368_20250803_OpEnact_1b230e5e91> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_368_obligation_0_f9d7fac5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "368" ;
    dzdoc:position 367 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_368_condition_0_135bc267> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2025-08-03/25-14#art_410> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_4> ;
    dzdoc:eId "art_410" ;
    dzdoc:fullText "يبلغ المتهم إلى النيابة العامة والضحية والمدعي المدني، قبل افتتاح المرافعات بثلاثة (3) أيام، على الأقل، قائمة بأسماء شهوده تكون مصاريف استدعاء الشهود و سداد نفقات تنقلهم على عاتقه إلا إذا رأى النائب العام لزوم استدعائهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_410> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_410_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_410_20250803_OpEnact_ce4217f052> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_410_obligation_0_37e1b7e2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "410" ;
    dzdoc:position 409 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_410_condition_0_c1a0f394> ;
    dzdoc:usesTerm dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_414> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_4> ;
    dzdoc:eId "art_414" ;
    dzdoc:fullText "يجوز للرئيس، سواء من تلقاء نفسه أو بناء على طلب النيابة العامة ، أن يأمر بتأجيل قضايا يراها غير مهيأة للفصل فيها خلال الدورة المقيدة بجدولها إلى آخر الدورة أو إلى الدورة التي تليها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_414_permission_0_2b44c222> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_414> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_414_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_414_20250803_OpEnact_c0883705ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "414" ;
    dzdoc:position 413 ;
    dzdoc:usesTerm dzterm:prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_424> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_6_subsec_1> ;
    dzdoc:eId "art_424" ;
    dzdoc:fullText "يجوز لممثل النيابة العامة والمحامي المتهم أو الضحية أو الطرف المدني توجيه الأسئلة مباشرة إلى كل شخص يتم سماعه في الجلسة بعد إذن الرئيس وتحت رقابته، الذي له أن يأمر بسحب السؤال أو عدم الإجابة عنه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_424_permission_0_f1839a69> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_424> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_424_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_424_20250803_OpEnact_117dff2e0f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "424" ;
    dzdoc:position 423 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_438> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_6_subsec_3> ;
    dzdoc:eId "art_438" ;
    dzdoc:fullText "يجوز للمحكمة، في أية حال كانت عليها الدعوى، إما من تلقاء نفسها أو بطلب معلل من النيابة العامة أو من محامي المتهم، أن تأمر بتأجيل القضية إلى آخر الدورة أو إلى الدورة التي تليها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_438_permission_0_f6a6b1c8> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_438_right_0_d7f64358> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_438> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_438_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_438_20250803_OpEnact_fcc9fa90c9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "438" ;
    dzdoc:position 437 ;
    dzdoc:usesTerm dzterm:prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_464> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_10> ;
    dzdoc:eId "art_464" ;
    dzdoc:fullText "للاستئناف أثر ناقل للدعوى في حدود التصريح بالاستئناف وصفة المستأنف. إذا رأت محكمة الجنايات الاستئنافية أن الاستئناف رفع خارج الآجال أو كان غير صحيح ، شكلا ، قررت عدم قبوله. إذا قبلت محكمة الجنايات الاستئنافية الاستئناف شكلا فلها أن تفصل في الدعويين العمومية والمدنية بالتأييد أو بالتعديل أو بالإلغاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_464> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_464_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_464_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_464_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_464_20250803_OpEnact_c2a92d9ddb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "464" ;
    dzdoc:position 463 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_464_condition_0_25d3ef0f>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_464_condition_1_b44ec627> ;
    dzdoc:usesTerm dzterm:criminal_appeals_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_475> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_475" ;
    dzdoc:fullText "كل شخص تقدم بشكوى يبلغ بمعرفة النيابة بتاريخ الجلسة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_475> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_475_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_475_20250803_OpEnact_8866b4bc17> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "475" ;
    dzdoc:position 474 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_491> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_3> ;
    dzdoc:eId "art_491" ;
    dzdoc:fullText "يجب أن تصدر أحكام المحكمة من القاضي الذي ترأس جميع جلسات الدعوى وإلا كانت باطلة . و إذا طرأ مانع في حضوره أثناء نظر القضية ، يتعين نظرها كاملا من جديد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_491> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_491_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_491_20250803_OpEnact_b5d7e92555> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_491_obligation_0_e906f153>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_491_obligation_1_83f431a8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "491" ;
    dzdoc:position 490 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_491_condition_0_4f5b36fd> ;
    dzdoc:usesTerm dzterm:court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_515> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_6> ;
    dzdoc:eId "art_515" ;
    dzdoc:fullText "يخلي سبيل المتهم المحبوس مؤقتا فور صدور الحكم ببراءته أو بإعفائه من العقوبة أو الحكم عليه بعقوبة العمل للنفع العام أو بالحبس مع إيقاف التنفيذ أو بالغرامة ، وذلك رغم الاستئناف ما لم يكن محبوسا لسبب آخر. وكذلك الشأن بالنسبة للمتهم المحبوس مؤقتا إذا حكم عليه بعقوبة الحبس بمجرد أن تستنفد مدة حبسه المؤقت مدة العقوبة المقضي بها عليه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_515_right_0_0e59f64d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_515> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_515_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_515_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_515_20250803_OpEnact_544260e985> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "515" ;
    dzdoc:position 514 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_532> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_7> ;
    dzdoc:eId "art_532" ;
    dzdoc:fullText "لا تطبق إجراءات الأمر الجزائي المنصوص عليها في هذا القسم : إذا كان المتهم طفلا ، إذا اقترنت الجنحة أو المخالفة بجنحة أو مخالفة أخرى لا تتوفر فيها شروط تطبيق إجراءات الأمر الجزائي ، إذا كانت ثمة حقوق مدنية تستوجب مناقشة وجاهية للفصل فيها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_532> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_532_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_532_20250803_OpEnact_712bf60517> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_532_obligation_0_8b3a7e9f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 532" ;
    dzdoc:position 531 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_532_condition_0_3127b345>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_532_condition_1_1e30430b>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_532_condition_2_863bb672> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_533> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_7> ;
    dzdoc:eId "art_533" ;
    dzdoc:fullText "إذا قرر وكيل الجمهورية اتباع إجراءات الأمر الجزائي ، يحيل ملف المتابعة مرفقا بطلباته، حسب الحالة، إلى محكمة الجنح أو المخالفات. يفصل القاضي دون مرافعة مسبقة بأمر جزائي يقضي بالبراءة أو بعقوبة الغرامة. وإذا رأى القاضي أن الشروط المنصوص عليها قانونا للأمر الجزائي غير متوفرة ، فإنه يعيد ملف المتابعة للنيابة العامة لاتخاذ ما تراه مناسبا وفقا للقانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_533> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_533_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_533_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_533_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_533_20250803_OpEnact_1bd470a710> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 533" ;
    dzdoc:position 532 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_533_condition_0_a810adab>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_533_condition_1_fe435c11> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_537> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_7> ;
    dzdoc:eId "art_537" ;
    dzdoc:fullText "يجوز للمتهم أن يتنازل صراحة عن اعتراضه قبل فتح باب المرافعة ، و في هذه الحالة يستعيد الأمر الجزائي قوته التنفيذية، ولا يكون قابلا لأي طعن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_537_permission_0_d1e83d3b> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_537_right_0_edb2101c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_537> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_537_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_537_20250803_OpEnact_f2cc7955da> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 537" ;
    dzdoc:position 536 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_572> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_2_subsec_3> ;
    dzdoc:eId "art_572" ;
    dzdoc:fullText "المادة 572 : إذا رأت المحكمة أن الواقعة تكون مخالفة ، نطقت بالعقوبة. وتقضي، عند الاقتضاء، في الدعوى المدنية طبقا لأحكام الفقرتين الثانية والثالثة من المادة 507 أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_572> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_572_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_572_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_572_20250803_OpEnact_e63cf5ac52> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "572" ;
    dzdoc:position 571 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_507> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_507> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_572_condition_0_f237db84> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_587> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_4_subsec_1> ;
    dzdoc:eId "art_587" ;
    dzdoc:fullText "يتعلق حق الاستئناف : بالمتهم، أو محاميه إذا لم يكن المتهم محل أمر بالقبض، والمسؤول عن الحقوق المدنية، ووكيل الجمهورية، والنائب العام، والإدارات العمومية في الأحوال التي تباشر فيها الدعوى العمومية، والمدعي المدني. و في حالة الحكم بالتعويض المدني، يتعلق حق الاستئناف بالمتهم وبالمسؤول عن الحقوق المدنية. ويتعلق هذا الحق بالمدعي المدني فيما يتصل بحقوقه المدنية فقط."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_587_right_0_5347d7ef>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_587_right_1_5347d7ef> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_587> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_587_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_587_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_587_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_587_20250803_OpEnact_4f606a6807> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "587" ;
    dzdoc:position 586 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_594> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_4_subsec_1> ;
    dzdoc:eId "art_594" ;
    dzdoc:fullText "يجب أن يبلغ الاستئناف المرفوع من النائب العام وفق المادة 589 أعلاه ، إلى المتهم ، وعند الاقتضاء، إلى المسؤول عن الحقوق المدنية ، غير أن هذا التبليغ يكون إجراؤه صحيحا بالنسبة للمتهم الحاضر إذا حصل بتقرير بجلسة المجلس القضائي إذا كانت القضية قد قدمت إلى تلك الجلسة في مهلة الاستئناف المقررة للنائب العام، وذلك بناء على استئناف المتهم أو أي خصم آخر في الدعوى ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_594> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_594_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_594_20250803_OpEnact_aaa656c4fb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_594_obligation_0_8aea96cf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "594" ;
    dzdoc:position 593 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_589> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_589> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_594_condition_0_291a1c6c> ;
    dzdoc:usesTerm dzterm:accused,
        dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_610> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_4> ;
    dzdoc:eId "art_610" ;
    dzdoc:fullText "يجب أن يتضمن التكليف بالحضور البيانات الآتية : تحديد الجهة أو الشخص الطالب للتكليف بالحضور، اسم و لقب الشخص المراد تبليغه وصفته في الدعوى وموطنه، وإذا تعلق الأمر بشخص معنوي يشار إلى تسميته وطبيعته ومقره الاجتماعي واسم وصفة الشخص الذي يتلقى التكليف بالحضور، التكييف القانوني للأفعال محل المتابعة والمواد القانونية المعاقب بها، الجهة القضائية المطروحة أمامها الدعوى ومكان وساعة وتاريخ الجلسة ورقم القضية، تبليغ الشخص المكلف بالحضور بأنه سوف يحكم عليه حضوريا إن كان متهما أو مسؤولا مدنيا، وإن كان ضحية أو طرفا مدنيا فإنه يعد تاركا لدعواه وتطبق عليه أحكام الفقرة الأولى من المادة 383 أعلاه، وإن كان شاهدا فعدم حضوره أو رفضه الإدلاء بالشهادة أو الإدلاء بشهادة مزورة تعد أفعالا يعاقب عليها القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_610> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_610_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_610_20250803_OpEnact_1a5981f6d2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_610_obligation_0_74f46a02> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "610" ;
    dzdoc:position 609 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_383> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_383> ;
    dzdoc:usesTerm dzterm:summons .

<https://legal.dz/resource/law/2025-08-03/25-14#art_614> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_4> ;
    dzdoc:eId "art_614" ;
    dzdoc:fullText "يجب أن يتم التبليغ إلى المراد تبليغه شخصيا. ويعتبر الشخص المعنوي مبلغا شخصيا، إذا سلم محضر التبليغ إلى ممثله القانوني أو الاتفاقي أو لأي شخص تم تعيينه لهذا الغرض."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_614> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_614_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_614_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_614_20250803_OpEnact_5f5cc0342f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_614_obligation_0_271330a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 614" ;
    dzdoc:position 612 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_614_condition_0_bd9bf278> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_621> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:definesTerm dzterm:agency ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_5> ;
    dzdoc:eId "art_621" ;
    dzdoc:fullText "تنشأ وكالة وطنية لتسيير الممتلكات المجمدة و/أو المحجوزة و/أو المصادرة الناتجة عن الجرائم المنصوص عليها في قانون العقوبات والتي تدعى في صلب هذا النص \"الوكالة\" ، تخطر من قبل الجهة القضائية المختصة. تعد الوكالة مؤسسة عمومية ذات طابع خاص، تتمتع بالشخصية المعنوية والاستقلال المالي. تحدد كيفيات تنظيم الوكالة وسيرها، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_621> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_621_defocc_2906b97dd89f> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_621_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_621_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_621_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_621_20250803_OpEnact_ad8c1428e1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_621_obligation_0_82750e8c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "621" ;
    dzdoc:position 619 ;
    dzdoc:usesTerm dzterm:agency .

<https://legal.dz/resource/law/2025-08-03/25-14#art_624> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_5> ;
    dzdoc:eId "art_624" ;
    dzdoc:fullText "تعالج الوكالة البيانات ذات الطابع الشخصي التي تمركز قرارات التجميد و الحجز والمصادرة والمعلومات المرتبطة بها، في إطار احترام حقوق الأشخاص وحياتهم الخاصة طبقا للأحكام المنصوص عليها في التشريع الساري المفعول ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_624_right_0_754287fa> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_624> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_624_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_624_20250803_OpEnact_b34c8ff26a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_624_obligation_0_2025c2c9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 624" ;
    dzdoc:position 622 ;
    dzdoc:usesTerm dzterm:agency .

<https://legal.dz/resource/law/2025-08-03/25-14#art_628> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_4_sec_1> ;
    dzdoc:eId "art_628" ;
    dzdoc:fullText "يختص قسم تطبيق العقوبات في البت بموجب حكم في طلبات الوضع في الإفراج المشروط و التوقيف المؤقت لتطبيق العقوبة و الوضع تحت المراقبة الإلكترونية و العمل للنفع العام و الإفراج المشروط لأسباب صحية و الوضع في نظام الحرية النصفية . يحدد الاختصاص المحلي ل قسم تطبيق العقوبات كما يأتي : بالنسبة للمحكوم عليه المحبوس ، يؤول الاختصاص لمحكمة مقر المجلس القضائي الذي تتواجد بدائرة اختصاصه المؤسسة العقابية المحبوس بها، بالنسبة للمحكوم عليه غير المحبوس ، يؤول الاختصاص لمحكمة مقر المجلس القضائي الذي يتواجد بدائرة اختصاصه مكان الإقامة الاعتيادي للمحكوم عليه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_628> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_628_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_628_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_628_20250803_OpEnact_f06464a72b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_628_obligation_0_42d1173a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "628" ;
    dzdoc:position 626 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_628_condition_0_d73561f8>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_628_condition_1_1e79441f> ;
    dzdoc:usesTerm dzterm:community_service,
        dzterm:conditional_release,
        dzterm:electronic_monitoring,
        dzterm:medical_conditional_release,
        dzterm:punishment_application_department,
        dzterm:semi_liberty,
        dzterm:temporary_suspension .

<https://legal.dz/resource/law/2025-08-03/25-14#art_629> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:definesTerm dzterm:punishment_application_judge ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_4_sec_1> ;
    dzdoc:eId "art_629" ;
    dzdoc:fullText "يعتبر قاضي تطبيق العقوبات قاضي حكم يختار من بين القضاة المختصين في مجال السجون . يتولى قاضي تطبيق العقوبات المهام المحددة له في هذا القانون و في التشريع الساري المفعول، على مستوى الجهات القضائية والمؤسسات العقابية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_629> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_629_defocc_a501295fa548> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_629_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_629_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_629_20250803_OpEnact_3d09c06e23> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_629_obligation_0_30897ba1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "629" ;
    dzdoc:position 627 ;
    dzdoc:usesTerm dzterm:punishment_application_judge .

<https://legal.dz/resource/law/2025-08-03/25-14#art_633> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_4_sec_2> ;
    dzdoc:eId "art_633" ;
    dzdoc:fullText "يصدر الحكم أو القرار فور انتهاء الجلسة أو ، بعد وضع الملف في المداولة، في التاريخ الذي يحددهالقاضي. يجب أن تكون الأحكام والقرارات الصادرة في طلبات تكييف العقوبة مسببة ، وهي قابلة للطعن فيها من طرف المحكوم عليه والنيابة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_633_right_0_5a95f423> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_633> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_633_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_633_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_633_20250803_OpEnact_9dbc70988e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_633_obligation_0_0d20fcc8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "633" ;
    dzdoc:position 631 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "لا يجوز الطعن في اتفاق الوساطة بأي طريق من طرق الطعن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_64_permission_0_0e3d1272> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_64_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_64_20250803_OpEnact_21bb2da060> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_64_prohibition_0_0e3d1272> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 64" ;
    dzdoc:position 63 ;
    dzdoc:usesTerm dzterm:mediation .

<https://legal.dz/resource/law/2025-08-03/25-14#art_669> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_3> ;
    dzdoc:eId "art_669" ;
    dzdoc:fullText "يجب أن تستوفي المذكرات المودعة باسم الأطراف الشروط الآتية : 1 - ذكر اسم و لقب وصفة الطاعن وممثله وكذلك موطنه الحقيقي، إذا لزم الأمر، 2 - ذكر تلك البيانات نفسها لكل من الخصوم المطعون ضدهم، مع استبعاد الذين لم تعد لهم مصالح في القضية، 3- أن تشتمل على عرض ملخص للوقائع وعرض لأوجه الطعن المؤيدة له والإشارة إلى الأوراق المقدمة والنصوص القانونية المعدة سندا لتدعيمه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_669> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_669_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_669_20250803_OpEnact_130b6a128f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_669_obligation_0_7f010b5d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 669" ;
    dzdoc:position 667 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_671> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_4> ;
    dzdoc:eId "art_671" ;
    dzdoc:fullText "يقوم أمين ضبط الجهة القضائية التي أصدرت الحكم أو القرار المطعون فيه بتشكيل الملف وإرساله إلى النائب العام الذي يحيله بدوره إلى النيابة العامة لدى المحكمة العليا ، مع جرد بالوثائق يتضمن وجوبا ما يثبت حصول تبليغ الحكم أو القرار إلى من يهمه الأمر، في ظرف عشرين (20) يوما من تاريخ انتهاء أجال إيداع المذكرات المنصوص عليها في المواد 661 و 662 و 663 من هذا القانون . يقوم النائب العام لدى المحكمة العليا بإرسال الملف في ظرف ثمانية (8) أيام من استلامه إلى الرئيس الأول للمحكمة العليا الذي يحيله بدوره إلى رئيس الغرفة المختصة لأجل تعيين مستشار مقرر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_671> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_671_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_671_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_671_20250803_OpEnact_6386d4aa50> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_671_obligation_0_2b188ca7>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_671_obligation_1_c94afed2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "671" ;
    dzdoc:position 669 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_661>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_662>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_663> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_661>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_662>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_663> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_671_condition_0_5978cfbd> ;
    dzdoc:usesTerm dzterm:clerk,
        dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_713> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_5> ;
    dzdoc:eId "art_713" ;
    dzdoc:fullText "للنائب العام لدى المحكمة العليا وحده الصفة في رفع الأمر إلى المحكمة المذكورة بشأن طلبات الإحالة لداعي الأمن العمومي أو لحسن سير القضاء . وأما العريضة بطلب الإحالة بسبب قيام الشبهة المشروعة، فيجوز تقديمها من النائب العام لدى المحكمة العليا أو من النيابة العامة لدى الجهة القضائية المنظور أمامها النزاع أو من المتهم أو الضحية أو المدعي المدني أو محاميهم ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_713_right_0_df6be056> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_713> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_713_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_713_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_713_20250803_OpEnact_1658457728> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_713_obligation_0_e80494a2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "713" ;
    dzdoc:position 711 ;
    dzdoc:usesTerm dzterm:prosecutor_general,
        dzterm:public_prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_719> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_6> ;
    dzdoc:eId "art_719" ;
    dzdoc:fullText "لا يجوز رد قضاة النيابة العامة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_719_permission_0_a8f3f3c9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_719> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_719_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_719_20250803_OpEnact_f2c050ab99> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_719_prohibition_0_a8f3f3c9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "719" ;
    dzdoc:position 717 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_721> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_6> ;
    dzdoc:eId "art_721" ;
    dzdoc:fullText "يجوز طلب الرد من جانب المتهم أو من كل خصم في الدعوى أو محاميهم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_721_permission_0_054bf1d3> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_721_right_0_ee9e2eba> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_721> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_721_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_721_20250803_OpEnact_06c70832e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "721" ;
    dzdoc:position 719 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_730> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_6> ;
    dzdoc:eId "art_730" ;
    dzdoc:fullText "لا يجوز لأي من القضاة المشار إليهم في المادة 718 أعلاه، أن يرد نفسه بنفسه عن نظر الدعوى تلقائيا بدون إذن من رئيس المجلس القضائي الذي يكون قراره الصادر بعد استطلاع رأي النائب العام غير قابل لأي طريق من طرق الطعن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_730_permission_0_8d19f92e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_730> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_730_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_730_20250803_OpEnact_2d11a1b1e3> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_730_prohibition_0_8d19f92e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "730" ;
    dzdoc:position 728 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_718> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_718> ;
    dzdoc:usesTerm dzterm:judges,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_747> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_9> ;
    dzdoc:eId "art_747" ;
    dzdoc:fullText "كل من كان في الإقليم الوطني، شريكا أو محرضا في جناية أو جنحة مرتكبة في الخارج يجوز أن يتابع من أجلها ويحكم عليه فيها بمعرفة الجهات القضائية الجزائرية إذا كانت الواقعة معاقبا عليها في كلا القانونين الأجنبي والجزائري ، بشرط أن تكون تلك الواقعة الموصوفة بأنها جناية أو جنحة قد ثبت ارتكابها بقرار نهائي من الجهة القضائية الأجنبية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_747_permission_0_f24c7df8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_747> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_747_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_747_20250803_OpEnact_4d087eeaa6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "747" ;
    dzdoc:position 745 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_747_condition_0_1fe8239b>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_747_condition_1_074a34f9> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_753> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_10> ;
    dzdoc:eId "art_753" ;
    dzdoc:fullText "تختص الجهات القضائية الجزائرية بنظر الجنايات والجنح التي ترتكب على متن طائرات جزائرية أيا كانت جنسية مرتكب الجريمة. كما أنها تختص أيضا بنظر الجنايات أو الجنح التي ترتكب على متن طائرات أجنبية إذا كان الجاني أو المجني عليه جزائري الجنسية أو إذا هبطت الطائرة بالجزائر بعد وقوع الجناية أو الجنحة . وتختص بنظرها المحاكم التي وقع بدائرة اختصاصها هبوط الطائرة في حالة القبض على الجاني وقت هبوطها أو لمكان القبض على الجاني في حالة ما إذا قد تم القبض عليه بالجزائر فيما بعد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_753> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_753_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_753_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_753_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_753_20250803_OpEnact_ba46f7a605> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "753" ;
    dzdoc:position 751 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_753_condition_0_ba0af164>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_753_condition_1_0eb5e4b3> ;
    dzdoc:usesTerm dzterm:judicial_authorities .

<https://legal.dz/resource/law/2025-08-03/25-14#art_766> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_3> ;
    dzdoc:eId "art_766" ;
    dzdoc:fullText "لا يجوز المطالبة بتطبيق الإكراه البدني ضد الزوج وزوجته، في آن واحد حتى ولو كان ذلك لتغطية وفاء مبالغ متعلقة بأحكام مختلفة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_766_permission_0_1d4c7d86> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_766> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_766_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_766_20250803_OpEnact_524ab9f4cc> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_766_prohibition_0_1d4c7d86> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 766" ;
    dzdoc:position 764 ;
    dzdoc:usesTerm dzterm:physical_coercion .

<https://legal.dz/resource/law/2025-08-03/25-14#art_781> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_4> ;
    dzdoc:eId "art_781" ;
    dzdoc:fullText "لا يجوز أن يتقدم المحكوم عليهم غيابيا أو بسبب تخلفهم عن الحضور إذا ما تقادمت عقوبتهم لإعادة المحاكمة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_781_permission_0_ac82b40e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_781> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_781_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_781_20250803_OpEnact_a8f5a442fd> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_781_prohibition_0_ac82b40e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "781" ;
    dzdoc:position 779 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_821> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_2> ;
    dzdoc:eId "art_821" ;
    dzdoc:fullText "يسلم مستخرج صحيفة السوابق القضائية للشخص المعنوي، بناء على طلب، إلى النيابة العامة والقضاة ووزير الدفاع الوطني ووزير الداخلية ووزير المالية ووزير التجارة والإدارات والمؤسسات العمومية التي تتلقى عروض الصفقات العمومية. ويسلم المستخرج أيضا للممثل القانوني للشخص المعنوي أو من ينوبه بعد التأكد من هويته وصفته."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_821_right_0_ca0b8619>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_821_right_1_3667e49d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_821> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_821_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_821_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_821_20250803_OpEnact_d7db3d98b6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 821" ;
    dzdoc:position 819 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_826> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:definesTerm dzterm:traffic_violations_record ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_3> ;
    dzdoc:eId "art_826" ;
    dzdoc:fullText "صحيفة مخالفات المرور هي بيان كامل بالعقوبات المتعلقة بالشخص نفسه التي لم يمحهارد الاعتبار . فإذا لم توجد عقوبات ، تذكر في القسيمة عبارة \"لا شيء\". لا تسلم صحيفة مخالفات المرور إلا إلى : المعني بالأمر، القضاة، وزير الدفاع الوطني ، وزير الداخلية . وزير النقل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_826> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_826_defocc_a4e474c12d92> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_826_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_826_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_826_20250803_OpEnact_bbf61cf617> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_826_obligation_0_47d99322> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "826" ;
    dzdoc:position 824 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_826_condition_0_8e78fc9d> ;
    dzdoc:usesTerm dzterm:minister_defense,
        dzterm:minister_interior,
        dzterm:minister_transport .

<https://legal.dz/resource/law/2025-08-03/25-14#art_848> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_6_sec_2> ;
    dzdoc:eId "art_848" ;
    dzdoc:fullText "يقوم النائب العام برفع الطلب إلى غرفة الاتهام بالمجلس القضائي . ويجوز للطالب أن يقدم مباشرة إلى غرفة الاتهام سائر المستندات المفيدة"@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_848_right_0_c1bf471d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_848> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_848_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_848_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_848_20250803_OpEnact_798228a271> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_848_obligation_0_5b1c9a8b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 848" ;
    dzdoc:position 846 ;
    dzdoc:usesTerm dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_850> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_6_sec_2> ;
    dzdoc:eId "art_850" ;
    dzdoc:fullText "يجوز الطعن في قرار غرفة الاتهام لدى المحكمة العليا ضمن الكيفيات المنصوص عليها في هذا القانون ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_850_permission_0_83ff6a89> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_850_right_0_b2cb2d41> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_850> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_850_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_850_20250803_OpEnact_507c1a1300> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 850" ;
    dzdoc:position 848 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_853> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_6_sec_2> ;
    dzdoc:eId "art_853" ;
    dzdoc:fullText "في الحالة التي تصدر فيها المحكمة العليا قرارا بالإدانة بعد رفع الأمر إليها كاملا ، فإن هذه الجهة القضائية تكون وحدها المختصة بالفصل في طلب الاعتبار . ويجري التحقيق، حينئذ، في الطلب بمعرفة النائب العام لدى المحكمة المذكورة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_853> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_853_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_853_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_853_20250803_OpEnact_025c5f4111> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_853_obligation_0_e99ff9a8>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_853_obligation_1_314535a9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 853" ;
    dzdoc:position 851 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_853_condition_0_f8df3503> ;
    dzdoc:usesTerm dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_855> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_6_sec_2> ;
    dzdoc:eId "art_855" ;
    dzdoc:fullText "ما لم يتم التوصل بإشعار من السلطات الأجنبية المختصة باستفادة المحكوم عليه من رد الاعتبار عن العقوبات الصادرة عن الجهات القضائية الأجنبية والمقيدة في صحيفة السوابق القضائية طبقا لأحكام المادة 812 أعلاه ، تطبق بشأن هذه العقوبات أحكام رد الاعتبار المنصوص عليها في المادتين 836 و 837 من هذا القانون. وإذا تعلق الأمر بجناية ، يقدم طلب رد الاعتبار إلى غرفة الاتهام، بعد مضي مهلة خمس (5) سنوات، تحسب من تاريخ انتهاء تنفيذ العقوبة التي تفصل فيه بعد تحقيق تجريه حول سيرة وسلوك المعني ، ويكون قرارها قابلا للطعن وفقا للأحكام المحددة في هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_855> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_855_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_855_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_855_20250803_OpEnact_7e548849e0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_855_obligation_0_b67c89a4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "855" ;
    dzdoc:position 853 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_812>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_836>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_837> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_812>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_836>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_837> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_855_condition_0_a4ff2ca6>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_855_condition_1_aff06172> ;
    dzdoc:usesTerm dzterm:rehabilitation .

<https://legal.dz/resource/law/2025-08-03/25-14#art_882> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_1_sec_5> ;
    dzdoc:eId "art_882" ;
    dzdoc:fullText "تقرر المحكمة العليا ما إذا كان هناك محل لإرسال كافة الأوراق التجارية أو القيم والنقود أو غيرها من الأشياء المحجوزة أو جزء منها إلى الحكومة الطالبة. ويجوز أن يحصل هذا الإرسال ولو تعذر التسليم بسب هروب الشخص المطلوب أو وفاته . وتأمر المحكمة العليا برد المستندات وغيرها من الأشياء المعددة أعلاه ، التي لا تتعلق بالفعل المنسوب إلى الشخص الأجنبي، وتفصل، عند الاقتضاء، في المطالبات التي يتقدم بها الغير من الحائزين وغيرهم من ذوي الحقوق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_882> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_882_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_882_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_882_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_882_20250803_OpEnact_f13dae7ce9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_882_obligation_0_0dd08c59> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "882" ;
    dzdoc:position 880 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_882_condition_0_6c65081e> ;
    dzdoc:usesTerm dzterm:supreme_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_90> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_90" ;
    dzdoc:fullText "ترفع يد ضابط الشرطة القضائية عن التحقيق بوصول وكيل الجمهورية لمكان الحادث . ويقوم وكيل الجمهورية بإتمام جميع أعمال الضبط القضائي المنصوص عليها في هذا الفصل . كما يسوغ له أن يكلف كل ضابط للشرطة القضائية بمتابعة الإجراءات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_90> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_90_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_90_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_90_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_90_20250803_OpEnact_ddc930448a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_90_obligation_0_471f752b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "90" ;
    dzdoc:position 89 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_90_condition_0_7e1bd512> ;
    dzdoc:usesTerm dzterm:judicial_police_officer .

<https://legal.dz/resource/law/2025-08-03/25-14#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "يقوم ضباط الشرطة القضائية ، وتحت رقابتهم ، أعوان الشرطة القضائية ، بالتحقيقات الابتدائية بمجرد علمهم بوقوع الجريمة إما بناء على تعليمات وكيل الجمهورية وإما من تلقاء أنفسهم ، و في هذه الحالة يجب عليهم إخطار وكيل الجمهورية فورا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_96_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_96_20250803_OpEnact_57c6b39d9f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_96_obligation_0_6f577cce>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_96_obligation_1_c048ec61> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "96" ;
    dzdoc:position 95 ;
    dzdoc:usesTerm dzterm:police_agents,
        dzterm:police_officers,
        dzterm:prosecutor .

