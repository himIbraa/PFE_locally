    dznorm:conditionText "إذا رأت المحكمة أن الأشياء الموضوعة تحت تصرف القضاء نافعة لإظهار الحقيقة أو قابلة للمصادرة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_525> ;
