<https://legal.dz/resource/law/2025-08-03/25-14#version_art_620> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبلغ القرارات والأحكام والأوامر فيما قضت به في الدعويين العمومية والمدنية في الحالات التي يكون فيها ضروريا، بناء على طلب النيابة العامة أو طلب الطرف المدني أو من الإدارات المرخص لها قانونا."@ar ;
    dzdoc:isAuthoritative true ;
