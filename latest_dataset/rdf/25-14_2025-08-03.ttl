<https://legal.dz/resource/law/2025-08-03/25-14#version_art_183> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحرر محاضر الاستجواب والسماع والمواجهات وفق الأوضاع المنصوص عليها في المادتين 169 و 170 أعلاه، وتطبق أحكام المادتين 166 و 167 أعلاه في حالة استدعاء مترجم. يجب على قاضي التحقيق في مواد الجنايات إجراء استجواب إجمالي قبل إقفال التحقيق ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_183_20250803_OpEnact_4075b769f2> ;
    dzdoc:replacementText "تحرر محاضر الاستجواب والسماع والمواجهات وفق الأوضاع المنصوص عليها في المادتين 169 و 170 أعلاه، وتطبق أحكام المادتين 166 و 167 أعلاه في حالة استدعاء مترجم. يجب على قاضي التحقيق في مواد الجنايات إجراء استجواب إجمالي قبل إقفال التحقيق ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_183> ;
