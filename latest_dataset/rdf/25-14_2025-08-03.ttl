<https://legal.dz/resource/law/2025-08-03/25-14#version_art_627> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتولى قسم تطبيق العقوبات بمحكمة مقر المجلس القضائي، الذي يرأسه قاضي تطبيق العقوبات ، الفصل في طلبات تكييف العقوبات السالبة للحرية . تفصل غرفة تطبيق العقوبات بالمجلس القضائي في استئناف الأحكام الصادرة عن قسم تطبيق العقوبات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_627_20250803_OpEnact_09204d6f27> ;
