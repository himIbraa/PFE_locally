<https://legal.dz/resource/law/2025-08-03/25-14#version_art_296> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوقع على قرارات غرفة الاتهام من الرئيس وأمين الضبط وتذكر بها أسماء الأعضاء والإشارة إلى إيداع المستندات والمذكرات و إلى تلاوة التقرير وإلى طلبات النيابة العامة . وتحتفظ غرفة الاتهام بالفصل في المصاريف إذا كان قرارها لا ينهي الدعوى التي نظرت فيها ، و في الحال العكسية وكذلك في حالة إخلاء سبيل المتهم، تصف المصاريف وتحكم بها على الطرف الخاسر في الدعوى. غير أنه يجوز إعفاء الضحية و/أو المدعي المدني حسن النية من المصاريف كلها أو جزء منها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_296_20250803_OpEnact_d83f2a5dac> ;
    dzdoc:replacementText "يوقع على قرارات غرفة الاتهام من الرئيس وأمين الضبط وتذكر بها أسماء الأعضاء والإشارة إلى إيداع المستندات والمذكرات و إلى تلاوة التقرير وإلى طلبات النيابة العامة . وتحتفظ غرفة الاتهام بالفصل في المصاريف إذا كان قرارها لا ينهي الدعوى التي نظرت فيها ، و في الحال العكسية وكذلك في حالة إخلاء سبيل المتهم، تصف المصاريف وتحكم بها على الطرف الخاسر في الدعوى. غير أنه يجوز إعفاء الضحية و/أو المدعي المدني حسن النية من المصاريف كلها أو جزء منها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_296> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
