<https://legal.dz/resource/law/2025-08-03/25-14#art_78_permission_2_066787d3> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_78_permission_2_066787d3_action_11127698b3> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_78_permission_2_066787d3_role_fb9b48c3b6> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_78> ;
    dznorm:position 2 ;
    dznorm:provisionText "وعندما يتعلق الأمر بجرائم القتل العمدي، والمخدرات والمؤثرات العقلية، والجريمة المنظمة عبر الحدود الوطنية، والجرائم المتصلة بتكنولوجيات الإعلام والاتصال، وجرائم تبييض الأموال والإرهاب، والجرائم المتعلقة بالتشريع الخاص بالصرف وحركة رؤوس الأموال من و إلى الخارج، وجرائم الفساد، وجرائم التهريب، وجرائم الاتجار بالبشر، وجرائم الاتجار بالأعضاء ، وجرائم تهريب المهاجرين، وجرائم اختطاف الأشخاص، فإنه يجوز إجراء التفتيش والمعاينة والحجز في كل محل سكني أو غير سكني في كل ساعة من ساعات النهار أو الليل ، وذلك بناء على إذن مكتوب مسبق من وكيل الجمهورية المختص."@ar ;
    dznorm:sourceArticle "art_78" .

