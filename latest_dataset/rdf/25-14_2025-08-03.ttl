<https://legal.dz/resource/law/2025-08-03/25-14#version_art_752> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تختص الجهات القضائية الجزائرية بالنظر في الجنايات والجنح التي ترتكب في عرض البحر على بواخر تحمل الراية الجزائرية أيا كانت جنسية مرتكبيها. وكذلك الشأن بالنسبة للجنايات والجنح التي ترتكب في ميناء بحرية جزائرية على ظهر باخرة تجارية أجنبية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_752_20250803_OpEnact_ab81b70ccf> ;
    dzdoc:replacementText "تختص الجهات القضائية الجزائرية بالنظر في الجنايات والجنح التي ترتكب في عرض البحر على بواخر تحمل الراية الجزائرية أيا كانت جنسية مرتكبيها. وكذلك الشأن بالنسبة للجنايات والجنح التي ترتكب في ميناء بحرية جزائرية على ظهر باخرة تجارية أجنبية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
