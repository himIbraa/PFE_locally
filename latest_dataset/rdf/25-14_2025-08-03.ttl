<https://legal.dz/resource/law/2025-08-03/25-14#version_art_172> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل شخص استدعي لسماع شهادته ملزم بالحضور وحلف اليمين وأداء الشهادة ، مع مراعاة الأحكام القانونية المتعلقة ب سر المهنة . وإذا لم يحضر الشاهد ، فيجوز ل قاضي التحقيق ، بناء على طلب وكيل الجمهورية ، استحضاره جبرا بواسطة القوة العمومية والحكم عليه بغرامة من 10.000 دج إلى 20.000 دج، غير أنه إذا حضر فيما بعد و أبدى أعذارا محقة ومدعمة بما يؤيد صحتها جاز ل قاضي التحقيق ، بعد سماع طلبات وكيل الجمهورية ، إعفاءه من الغرامة كلها أو جزء منها. ويجوز توقيع العقوبة نفسها، بناء على طلب وكيل الجمهورية ، على الشاهد "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_172_20250803_OpEnact_9e97223f3d> ;
    dzdoc:replacementText "كل شخص استدعي لسماع شهادته ملزم بالحضور وحلف اليمين وأداء الشهادة ، مع مراعاة الأحكام القانونية المتعلقة ب سر المهنة . وإذا لم يحضر الشاهد ، فيجوز ل قاضي التحقيق ، بناء على طلب وكيل الجمهورية ، استحضاره جبرا بواسطة القوة العمومية والحكم عليه بغرامة من 10.000 دج إلى 20.000 دج، غير أنه إذا حضر فيما بعد و أبدى أعذارا محقة ومدعمة بما يؤيد صحتها جاز ل قاضي التحقيق ، بعد سماع طلبات وكيل الجمهورية ، إعفاءه من الغرامة كلها أو جزء منها. ويجوز توقيع العقوبة نفسها، بناء على طلب وكيل الجمهورية ، على الشاهد الذي يمتنع رغم حضوره ، عن أداء اليمين أو الإدلاء بشهادته. وتصدر العقوبة المشار إليها في الفقرتين السابقتين بأمر من قاضي التحقيق ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_172> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_172> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_173> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل شخص، بعد تصريحه علانية بأنه يعرف مرتكبي جناية أو جنحة، يرفض الإجابة على الأسئلة التي توجه إليه في هذا الشأن بمعرفة قاضي التحقيق ، يجوز إحالته على المحكمة المختصة والحكم عليه بالحبس من شهرين (2) إلى سنة (1) وبغرامة من 20.000 دج إلى 100.000 دج أو بإحدى هاتين العقوبتين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_173_20250803_OpEnact_7f7e07b801> ;
    dzdoc:replacementText "كل شخص، بعد تصريحه علانية بأنه يعرف مرتكبي جناية أو جنحة، يرفض الإجابة على الأسئلة التي توجه إليه في هذا الشأن بمعرفة قاضي التحقيق ، يجوز إحالته على المحكمة المختصة والحكم عليه بالحبس من شهرين (2) إلى سنة (1) وبغرامة من 20.000 دج إلى 100.000 دج أو بإحدى هاتين العقوبتين."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_173> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_173> ;
