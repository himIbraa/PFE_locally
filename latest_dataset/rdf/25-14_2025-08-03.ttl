<https://legal.dz/resource/law/2025-08-03/25-14#version_art_62> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يدون اتفاق الوساطة في محضر يتضمن هوية وعنوان الأطراف و عرضا وجيزا عن الأفعال وتكييفها القانوني والمواد القانونية المطبقة وتاريخ ومكان وقوعها ومضمون اتفاق الوساطة وأجال تنفيذه. يوقع المحضر من طرف وكيل الجمهورية أو الوسيط المفوض و أمين الضبط والأطراف، وتسلم نسخة منه إلى كل طرف."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_62_20250803_OpEnact_08991e36dc> ;
