<https://legal.dz/resource/law/2025-08-03/25-14#version_art_476> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن المدعي المدني أن يكلف المتهم مباشرة بالحضور أمام المحكمة في الحالات الآتية : ترك الأسرة، عدم تسليم الطفل، انتهاك حرمة المنزل القذف إصدار صك بدون رصيد، السب العلني، التهديد، عدم دفع النفقة المساس بحرمة الحياة الخاصة للأشخاص، الوشاية الكاذبة، خيانة الأمانة. و في الحالات الأخرى، ينبغي الحصول على ترخيص من النيابة العامة للقيام بالتكليف المباشر بالحضور . ينبغي على المدعي المدني الذي يكلف متهما تكليفا مباشرا بالحضور أمام المحكمة أن يودع، مقدما، لدى أمين الضبط المبلغ الذي يقدره وكيل الجمهورية لتغط"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_476_20250803_OpEnact_7bd5685882> ;
    dzdoc:replacementText "يمكن المدعي المدني أن يكلف المتهم مباشرة بالحضور أمام المحكمة في الحالات الآتية : ترك الأسرة، عدم تسليم الطفل، انتهاك حرمة المنزل القذف إصدار صك بدون رصيد، السب العلني، التهديد، عدم دفع النفقة المساس بحرمة الحياة الخاصة للأشخاص، الوشاية الكاذبة، خيانة الأمانة. و في الحالات الأخرى، ينبغي الحصول على ترخيص من النيابة العامة للقيام بالتكليف المباشر بالحضور . ينبغي على المدعي المدني الذي يكلف متهما تكليفا مباشرا بالحضور أمام المحكمة أن يودع، مقدما، لدى أمين الضبط المبلغ الذي يقدره وكيل الجمهورية لتغطية المصاريف القضائية ، و أن ينوه في ورقة التكليف بالحضور عن هوية المشتكى منه وعنوانه وعن اختيار موطن له داخل الإقليم الوطني ، ويترتب البطلان على مخالفة شيء من ذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_476> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_476> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_477> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقصد بإجراءات الإخطار الفوري، المنصوص عليها في هذا القسم، إجراءات المثول الفوري وإجراءات الجنح المتلبس بها . يقدم الأشخاص المعنيون بإجراءات الإخطار الفوري أمام وكيل الجمهورية المختص إذا كانوا لا يقدمون ضمانات كافية للحضور أمام القضاء . يمكن ضابط الشرطة القضائية استدعاء شهود الجنحة المتلبس بها أو الجنحة المهيئة للفصل شفاهة، و هم ملزمون بالحضور تحت طائلة العقوبات المنصوص عليها قانونا . كما يمكنه استدعاء الضحايا، وفقا لنفس الأشكال."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_477_20250803_OpEnact_d2b5868e4f> ;
    dzdoc:replacementText "يقصد بإجراءات الإخطار الفوري، المنصوص عليها في هذا القسم، إجراءات المثول الفوري وإجراءات الجنح المتلبس بها . يقدم الأشخاص المعنيون بإجراءات الإخطار الفوري أمام وكيل الجمهورية المختص إذا كانوا لا يقدمون ضمانات كافية للحضور أمام القضاء . يمكن ضابط الشرطة القضائية استدعاء شهود الجنحة المتلبس بها أو الجنحة المهيئة للفصل شفاهة، و هم ملزمون بالحضور تحت طائلة العقوبات المنصوص عليها قانونا . كما يمكنه استدعاء الضحايا، وفقا لنفس الأشكال."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_477> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
