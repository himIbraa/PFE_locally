    dzdoc:usesTerm dzterm:supreme_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_700> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_1> ;
    dzdoc:eId "art_700" ;
    dzdoc:fullText "إذا حصل أثناء جلسة بمحكمة أو مجلس قضائي أن أدعي بتزوير ورقة من أوراق الدعوى أو أحد المستندات المقدمة ، فلتلك الجهة القضائية أن تقرر، بعد أخذ ملاحظات النيابة العامة و أطراف الدعوى، ما إذا كان ثمة محل لإيقاف الدعوى أو عدم إيقافها ريثما يفصل في التزوير من الجهة القضائية المختصة. وإذا انقضت الدعوى العمومية ، أو كان لا يمكن مباشرتها عن تهمة التزوير ، و إذا لم يتبين أن من قدم الورقة كان قد استعملها متعمدا عن قصد التزوير ، قضت المحكمة أو المجلس المطروحة أمامه الدعوى الأصلية بصفة فرعية في صفة الورقة المدعى بتزويرها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_700_permission_0_256bfca7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_700> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_700_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_700_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_700_20250803_OpEnact_5963ef3d2d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "700" ;
    dzdoc:position 698 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_700_condition_0_0dcdda22>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_700_condition_1_5495b021> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_710> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_4> ;
    dzdoc:eId "art_710" ;
    dzdoc:fullText "يطرح النزاع على الجهة الأعلى درج المشتركة حسب التدرج في السلك القضائي. وإذا كانت تلك الجهة مجلسا قضائيا ، فحص النزاع لدى غرفة الاتهام. وإذا لم توجد جهة عليا مشتركة ، فإن كل نزاع بين جهات التحقيق وجهات الحكم العادية أو الاستثنائية يطرح على الغرفة الجزائية بالمحكمة العليا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_710> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_710_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_710_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_710_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_710_20250803_OpEnact_d31ac611bc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_710_obligation_0_7424d2cc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "710" ;
    dzdoc:position 708 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_710_condition_0_1f75d1bb>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_710_condition_1_0cffc5d1> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_712> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_5> ;
    dzdoc:eId "art_712" ;
    dzdoc:fullText "يجوز للمحكمة العليا في مواد الجنايات أو الجنح أو المخالفات ، إما لداعي الأمن العمومي أو لحسن سير القضاء أو أيضا بسبب قيام شبهة مشروعة ، أن تأمر بتخلي أية جهة قضائية عن نظر الدعوى وإحالتها إلى جهة قضائية أخرى من الدرجة نفسها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_712_permission_0_2cc978c2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_712> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_712_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_712_20250803_OpEnact_76fc5eda79> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "712" ;
    dzdoc:position 710 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_712_condition_0_34825cde> ;
    dzdoc:usesTerm dzterm:supreme_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_717> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_5> ;
    dzdoc:eId "art_717" ;
    dzdoc:fullText "إذا كان المحكوم عليه بعقوبة سالبة للحرية محبوسا ولم يكن ثمة مجال لتطبيق المادة 716 أعلاه ، تعين اتخاذ الإجراءات المتبعة في حالة تنازع الاختصاص بين القضاة، ولكن بناء على طلب من النيابة العامة وحدها بقصد إحالة الدعوى من الجهة القضائية المطروح أمامها النزاع إلى الجهة التي بها مكان الحبس."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_717> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_717_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_717_20250803_OpEnact_9b4c0296e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "717" ;
    dzdoc:position 715 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_716> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_716> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_717_condition_0_4e8ace5e> ;
    dzdoc:usesTerm dzterm:public_prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_751> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_9> ;
    dzdoc:eId "art_751" ;
    dzdoc:fullText "لا يجوز مباشرة إجراء أية متابعة من أجل جناية أو جنحة ارتكبت في الجزائر ضد أجنبي يكون قد أثبت أنه حوكم نهائيا من أجل هذه الجناية أو الجنحة في الخارج وأن يثبت في حالة الإدانة أنه قضى العقوبة أو تقادمت أو صدر عفو عنها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_751_permission_0_67c45e4f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_751> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_751_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_751_20250803_OpEnact_2165c97a03> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_751_obligation_0_97baf395> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_751_prohibition_0_67c45e4f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "751" ;
    dzdoc:position 749 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_786> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_1> ;
    dzdoc:eId "art_786" ;
    dzdoc:fullText "يدير مصلحة النظام الآلي الوطني لصحيفة السوابق القضائية لوزارة العدل، قاض. ترتبط مصلحة النظام الآلي الوطني لصحيفة السوابق القضائية بالمصلحة المنصوص عليها في المادة 783 أعلاه، وبالجهات القضائية. تكلف مصلحة النظام الآلي الوطني لصحيفة السوابق القضائية بتسيير وإدارة النظام الآلي الوطني لصحيفة السوابق القضائية طبقا لأحكام هذا القانون. يتولى القاضي المكلف بالنظام الآلي الوطني لصحيفة السوابق القضائية ما يأتي : التأشير على القسائم رقم (2) و رقم (3) لصحيفة السوابق القضائية قبل تسليمها، الإشراف على النظام الآلي وعمليات البحث والتحقق من الهوية في قاعدة المعطيات الوطنية. يرتبط النظام الآلي الوطني لصحيفة السوابق القضائية بالسجل الآلي الوطني للحالة المدنية. تحدد شروط وكيفيات تنظيم مصلحة النظام الآلي الوطني لصحيفة السوابق القضائية وسيرها، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_786> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_786_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_786_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_786_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_786_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_786_para_4>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_786_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_786_20250803_OpEnact_e10dbd6be1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_786_obligation_0_1c54f29f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "786" ;
    dzdoc:position 784 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_783> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_783> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_799> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_1> ;
    dzdoc:eId "art_799" ;
    dzdoc:fullText "يجب على أمين الضبط قبل تحرير القسيمة رقم 2 أن يتحقق من الحالة المدنية لصاحب الشأن . فإذا كانت نتيجة فحص سجلات الحالة المدنية سلبية ، أشر على البطاقة كالآتي : (لا تنطبق عليه أية شهادة ميلاد) دون إضافة أي بيان آخر. فإذا كانت السلطة التي تحرر القسيمة رقم 2 ليس تحت يدها وثائق الحالة المدنية ، فيؤشر بشكل واضح على القسيمة بعبارة (غير محقق الهوية)، وإذا لم توجد قسيمة تحمل رقم 1 في ملف صحيفة السوابق القضائية للشخص فإن البطاقة رقم 2 التي تخصه تسلم وعليها عبارة (لا يوجد)."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_799> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_799_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_799_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_799_20250803_OpEnact_b2167cdefd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_799_obligation_0_5f3a0fc1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "799" ;
    dzdoc:position 797 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_799_condition_0_1947afff>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_799_condition_1_a39635df> ;
    dzdoc:usesTerm dzterm:bulletin_no2 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_830> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_4> ;
    dzdoc:eId "art_830" ;
    dzdoc:fullText "تحرر نسخة ثانية طبق الأصل عن جميع البطاقات رقم 1 المثبتة للعقوبات الصادرة تطبيقا للنصوص التشريعية المتعلقة بالوقاية من الإدمان على المواد الكحولية والمخدرات والمؤثرات العقلية ومكافحتها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_830> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_830_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_830_20250803_OpEnact_130e5aeefd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_830_obligation_0_8fe2543b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "830" ;
    dzdoc:position 828 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_846> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_6_sec_2> ;
    dzdoc:eId "art_846" ;
    dzdoc:fullText "يقوم وكيل الجمهورية بإجراء تحقيق في الجهات التي أقام بها المحكوم عليه بمعرفة مصالح الدرك الوطني أو الأمن الوطني أو المصالح الخارجية لإدارة السجون المكلفة بإعادة الإدماج الاجتماعي للمحبوسين . ويستطلع، عند الاقتضاء ، رأي قاضي تطبيق العقوبات . إذا تعلق الأمر بطلب رد الاعتبار لشخص معنوي ، يقوم وكيل الجمهورية بإجراء تحقيق ويحاط بكل المعلومات الضرورية و يستطلع رأي الإدارات العمومية المعنية إذا رأى محلا لذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_846> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_846_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_846_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_846_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_846_20250803_OpEnact_0fa3212589> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_846_obligation_0_78a5a5bc>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_846_obligation_1_4bc9a0af> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 846" ;
    dzdoc:position 844 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_846_condition_0_1b1645cd>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_846_condition_1_264edb72> ;
    dzdoc:usesTerm dzterm:judge_execution,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_851> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_6_sec_2> ;
    dzdoc:eId "art_851" ;
    dzdoc:fullText "لا يجوز في حالة رفض الطلب في الموضوع تقديم طلب جديد حتى ولو في الحالة المنصوص عليها في المادة 844 أعلاه، قبل انقضاء مهلة سنتين (2) اعتبارا من تاريخ الرفض ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_851_permission_0_a381fac7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_851> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_851_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_851_20250803_OpEnact_c5d4fa6945> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_851_obligation_0_2c230399> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_851_prohibition_0_a381fac7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 851" ;
    dzdoc:position 849 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_844> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_844> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_863> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_1_sec_1> ;
    dzdoc:eId "art_863" ;
    dzdoc:fullText "لا يتم تسليم الشخص الاجنبي في حالة ما إذا كان موضوع متابعة في الجزائر أو كان قد حكم عليه فيها وطلب تسليمه بسبب جريمة مغايرة إلا بعد الانتهاء من تلك المتابعة أو بعد تنفيذ العقوبة في حالة الحكم عليه . ومع ذلك، فلا يحول هذا النص دون إمكان إرسال الشخص الأجنبي مؤقتا للمثول أمام محاكم الدولة الطالبة، على أن يشترط صراحة أن يعاد بمجرد قيام القضاء الأجنبي بالفصل في الجريمة . وتطبق نصوص هذه المادة على الحالة التي يكون فيها الشخص الأجنبي خاضعا للإكراه البدني طبقا للقوانين الجزائرية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_863> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_863_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_863_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_863_20250803_OpEnact_6246bf42f3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_863_obligation_0_9078dcf9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "863" ;
    dzdoc:position 861 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_863> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_863> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_863_condition_0_b2084b70> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_883> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_2> ;
    dzdoc:eId "art_883" ;
    dzdoc:fullText "في حالة المتابعات الجزائية، غير السياسية، في بلد أجنبي ، تسلم الإنابات القضائية الصادرة من السلطة الأجنبية بالطريق الدبلوماسي وترسل إلى وزارة العدل بالأوضاع المنصوص عليها في المادة 865 أعلاه ، و تنفذ الإنابات القضائية إذا كان لها محل وفقا للقانون الجزائري وكل ذلك بشرط المعاملة بالمثل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_883> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_883_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_883_20250803_OpEnact_d399441290> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_883_obligation_0_0046893d>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_883_obligation_1_24e3dcf7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 883" ;
    dzdoc:position 881 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_865> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_865> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_883_condition_0_c7005412>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_883_condition_1_d16ad4fb> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_93> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_93" ;
    dzdoc:fullText "إذا حضر قاضي التحقيق لمكان الحادث ، فإنه يقوم بإتمام أعمال ضباط الشرطة القضائية المنصوص عليها في هذا الفصل. وله أن يكلف أحد ضباط الشرطة القضائية بمتابعة تلك الإجراءات. ويرسل قاضي التحقيق، عند انتهاء الإجراءات، جميع أوراق التحقيق إلى وكيل الجمهورية ليتخذ اللازم بشأنها . وإذا وصل وكيل الجمهورية وقاضي التحقيق إلى مكان الحادث، في آن واحد ، جاز لوكيل الجمهورية أن يطلب من قاضي التحقيق الحاضر افتتاح محضر تحقيق قانوني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_93> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_93_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_93_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_93_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_93_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_93_20250803_OpEnact_1fb030c9ff> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_93_obligation_0_359b859e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "93" ;
    dzdoc:position 92 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_93_condition_0_df999eaa>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_93_condition_1_84e3a4bc> .

