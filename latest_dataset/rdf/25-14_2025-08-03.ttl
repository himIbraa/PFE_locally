<https://legal.dz/resource/law/2025-08-03/25-14#version_art_725> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يطلب الرئيس المعروض عليه الطلب من القاضي المطلوب رده أن يقدم إيضاحاته ، كما أن له أن يطلب استيضاحات الطالب التكميلية إن رأى لزوما لها، ثم يستطلع رأى النائب العام ويفصل في الطلب."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
