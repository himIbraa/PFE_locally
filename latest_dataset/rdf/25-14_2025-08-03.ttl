    dznorm:conditionText "إذا رأت محكمة الجنايات الاستئنافية أن الاستئناف رفع خارج الآجال أو كان غير صحيح ، شكلا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_464> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_464_condition_1_b44ec627> a dznorm:Condition ;
    dznorm:conditionText "إذا قبلت محكمة الجنايات الاستئنافية الاستئناف شكلا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_464> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_464_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_464> ;
    dzdoc:position 0 ;
    dzdoc:text "للاستئناف أثر ناقل للدعوى في حدود التصريح بالاستئناف وصفة المستأنف."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_464_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_464> ;
    dzdoc:position 1 ;
    dzdoc:text "إذا رأت محكمة الجنايات الاستئنافية أن الاستئناف رفع خارج الآجال أو كان غير صحيح ، شكلا، قررت عدم قبوله."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_464_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_464> ;
    dzdoc:position 2 ;
    dzdoc:text "إذا قبلت محكمة الجنايات الاستئنافية الاستئناف شكلا فلها أن تفصل في الدعويين العمومية والمدنية بالتأييد أو بالتعديل أو بالإلغاء."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_465_obligation_0_649282fb> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_465> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتعين الفصل في شكل الاستئناف من طرف القضاة المشكلين لمحكمة الجنايات الاستئنافية قبل إجراء القرعة لاستخراج أسماء المحلفين"@ar ;
    dznorm:sourceArticle "art_465" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_465_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_465> ;
    dzdoc:position 0 ;
    dzdoc:text "يتعين الفصل في شكل الاستئناف من طرف القضاة المشكلين لمحكمة الجنايات الاستئنافية قبل إجراء القرعة لاستخراج أسماء المحلفين."@ar .

