    dznorm:position 0 ;
    dznorm:provisionText "تلتزم برد الأوراق والمستندات في أقصر أجل"@ar ;
    dznorm:sourceArticle "art_885" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_885_para_0> a dzdoc:Paragraph ;
