    dzdoc:sourceTextSpan "ويخضع المحكوم عليه الذي تقادمت عقوبته بقوة القانون لحظر الإقامة لمدة خمس (5) سنوات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_778> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_778_obligation_1_73945b90> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_778> ;
    dznorm:position 1 ;
    dznorm:provisionText "كما يخضع المحكوم عليه بعقوبة مؤبدة إذا تقادمت عقوبته بقوة القانون لحظر الإقامة طيلة مدة حياته"@ar ;
    dznorm:sourceArticle "art_778" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_778_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_778> ;
    dzdoc:position 0 ;
    dzdoc:text "تتقادم العقوبات الصادرة بحكم في المواضيع الجنائية بعد مضي عشرين (20) سنة كاملة، ابتداء من التاريخ الذي يصبح فيه الحكم نهائيا وحائزا لقوة الشيء المقضي فيه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_778_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_778> ;
    dzdoc:position 1 ;
    dzdoc:text "ويخضع المحكوم عليه الذي تقادمت عقوبته بقوة القانون لحظر الإقامة لمدة خمس (5) سنوات، اعتبارا من تاريخ اكتمال لمدة التقادم في نطاق إقليم الولاية التي يقيم بها المجني عليه في الجناية أو ورثته المباشرون."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_778_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_778> ;
    dzdoc:position 2 ;
    dzdoc:text "كما يخضع المحكوم عليه بعقوبة مؤبدة إذا تقادمت عقوبته بقوة القانون لحظر الإقامة طيلة مدة حياته في نطاق إقليم الولاية التي يقيم بها المجني عليه في الجناية أو ورثته المباشرون."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_779_condition_0_7853e8ee> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_779_condition_0_7853e8ee_role_14ed584e10> ;
    dznorm:conditionText "غير أنه إذا كانت عقوبة الحبس المقضي بها تزيد على الخمس (5) سنوات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_779> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_779_condition_0_7853e8ee_role_14ed584e10> a dznorm:Role ;
    rdfs:label "الخمس (5) سنوات"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "غير أنه إذا كانت عقوبة الحبس المقضي بها تزيد على الخمس (5) سنوات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_779> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_779_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_779> ;
    dzdoc:position 0 ;
    dzdoc:text "تتقادم العقوبات الصادرة بقرار أو بحكم يتعلق بموضوع الجنح بعد مضي خمس (5) سنوات كاملة، ابتداء من التاريخ الذي يصبح فيه هذا القرار أو الحكم نهائيا وحائزا لقوة الشيء المقضي فيه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_779_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_779> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أنه إذا كانت عقوبة الحبس المقضي بها تزيد على الخمس (5) سنوات، فإن مدة التقادم تكون مساوية لهذه المدة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_77_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_77> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة تتراوح بين 50.000 دج إلى 150.000 دج ، كل من أفشى مستندا ناتجا من التفتيش أو أطلع عليه شخصا لا صفة له قانونا في الاطلاع عليه وذلك بغير إذن من المتهم أو من ذوي حقوقه أو من الموقع على هذا المستند أو من المرسل إليه ما لم تستدع ضرورات التحقيق غير ذلك."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_780_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_780> ;
    dzdoc:position 0 ;
    dzdoc:text "تتقادم العقوبات التي تصدر بقرار أو بحكم فيما يتعلق بالمخالفات ، بعد مضي سنتين (2) كاملتين ابتداء من التاريخ الذي يصبح فيه ذلك القرار أو الحكم نهائيا وحائزا لقوة الشيء المقضي فيه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_781_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_781> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يجوز أن يتقدم المحكوم عليهم غيابيا أو بسبب تخلفهم عن الحضور إذا ما تقادمت عقوبتهم لإعادة المحاكمة."@ar .

