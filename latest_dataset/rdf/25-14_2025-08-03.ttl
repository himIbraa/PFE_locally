<https://legal.dz/resource/law/2025-08-03/25-14#version_art_642> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان الشخص غير الموقوف المراد سماعه أو استجوابه أو تبليغه أو إجراء المواجهة معه، مقيما بدائرة اختصاص محكمة أخرى ، توجه جهة التحقيق المختصة طلبا لوكيل الجمهورية للمحكمة الأقرب لمحل إقامته قصد استدعائه للتاريخ المحدد للقيام بالإجراء. و في هذه الحالة، يجب على جهة التحقيق تطبيق الأحكام المقررة في المادة 180 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_642_20250803_OpEnact_b5cdefa6df> ;
    dzdoc:replacementText "إذا كان الشخص غير الموقوف المراد سماعه أو استجوابه أو تبليغه أو إجراء المواجهة معه، مقيما بدائرة اختصاص محكمة أخرى ، توجه جهة التحقيق المختصة طلبا لوكيل الجمهورية للمحكمة الأقرب لمحل إقامته قصد استدعائه للتاريخ المحدد للقيام بالإجراء. و في هذه الحالة، يجب على جهة التحقيق تطبيق الأحكام المقررة في المادة 180 أعلاه."@ar ;
