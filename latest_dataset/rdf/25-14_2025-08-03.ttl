    dznorm:provisionText "ويجب أن تؤسس"@ar ;
    dznorm:sourceArticle "art_693" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_693_obligation_0_d0e43144_action_0fa03ac9f5> a dznorm:Action ;
    rdfs:label "أن تؤسس"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "ويجب أن تؤسس"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_693> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_693_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_693> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يسمح بطلبات إعادة النظر، إلا بالنسبة للقرارات الصادرة عن المجالس القضائية أو للأحكام الصادرة عن المحاكم إذا حازت قوة الشيء المقضي فيه، وكانت تقضي بالإدانة في جناية أو جنحة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_693_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_693> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجب أن تؤسس : 1 - إما على تقديم مستندات بعد الحكم بالإدانة في جناية قتل يترتب عليها قيام أدلة كافية على وجود المجني عليه المزعوم قتله على قيد الحياة، 2 - أو إذا أدين بشهادة الزور ضد المحكوم عليه ، شاهد سبق أن ساهم بشهادته في إثبات إدانة المحكوم عليه، 3 – أو على إدانة متهم آخر من أجل ارتكاب الجناية أو الجنحة نفسها، بحيث لا يمكن التوفيق بين الحكمين، 4 - أو أخيرا بكشف واقعة جديدة أو تقديم مستندات كانت مجهولة من القضاة الذين حكموا بالإدانة مع أنه يبدو منها أن من شأنها التدليل على براءة المحكوم عليه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_693_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_693> ;
    dzdoc:position 2 ;
    dzdoc:text "ويرفع الأمر إلى المحكمة العليا بالنسبة للحالات الثلاث الأولى مباشرة إما من وزير العدل أو من المحكوم عليه، أو من نائبه القانوني في حالة عدم أهليته، أو من زوجه أو فروعه أو أصوله في حالة وفاته أو ثبوت غيابه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_693_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_693> ;
    dzdoc:position 3 ;
    dzdoc:text "و في الحالة الرابعة، لا يجوز ذلك لغير النائب العام لدى المحكمة العليا متصرفا بناء على طلب وزير العدل."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_693_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_693> ;
    dzdoc:position 4 ;
    dzdoc:text "وتفصل المحكمة العليا في الموضوع في دعوى إعادة النظر، ويقوم القاضي المقرر بجميع إجراءات التحقيق، وعند الضرورة، بطريق الإنابة القضائية."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_693_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_693> ;
    dzdoc:position 5 ;
    dzdoc:text "وإذا قبلت المحكمة العليا الطلب، قضت، بغير إحالة، ببطلان أحكام الإدانة التي تثبت عدم صحتها."@ar .

