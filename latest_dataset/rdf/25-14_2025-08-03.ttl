<https://legal.dz/resource/law/2025-08-03/25-14#version_art_461> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يبقى المتهم المحبوس المحكوم عليه بعقوبة سالبة للحرية نافذة من أجل جنحة، رهن الحبس إلى غاية الفصل في الاستئناف، ما لم يكن قد استنفد العقوبة المحكوم بها عليه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
