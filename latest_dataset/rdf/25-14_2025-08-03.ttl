    dznorm:provisionText "فعليه أن يصدر في ذلك أمرا معللا في أجل عشرة (10) أيام من تاريخ استلامه الطلب"@ar ;
    dznorm:sourceArticle "art_239" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_239_obligation_0_de32de72_period_c37d20e576> a dznorm:Period ;
