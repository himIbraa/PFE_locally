<https://legal.dz/resource/law/2025-08-03/25-14#art_770_condition_0_5c256388> a dznorm:Condition ;
    dznorm:conditionText "إذا كان المنفذ عليه بالإكراه البدني محبوسا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_770> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_770_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_770> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان المنفذ عليه بالإكراه البدني محبوسا، جاز لطرف الخصومة المطالب بالمتابعة، بمجرد تبليغ الإعلان المنصوص عليه في المادة 769 أعلاه، أن يعارض في الإفراج عنه بأن يستصدر من النيابة العامة أمرا يوجه منها إلى مدير المؤسسة العقابية بإبقائه في الحبس."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_770_right_0_fdf72550> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
