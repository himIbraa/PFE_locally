<https://legal.dz/resource/law/2025-08-03/25-14#version_art_758> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا حدث بعد هروب متابع تم إمساكه أو حصل في أية حالة أخرى، أن كانت هوية المحكوم عليه محل نزاع ، يفصل في هذا النزاع وفق القواعد المقررة في مادة إشكالات التنفيذ ، غير أن الجلسة تكون علنية. فإذا ثار النزاع في ذلك أثناء سير وبمناسبة متابعة جديدة ، قام بحسمه المجلس القضائي أو المحكمة المطروحة أمامها هذه المتابعة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_758_20250803_OpEnact_06038a9f5d> ;
    dzdoc:replacementText "إذا حدث بعد هروب متابع تم إمساكه أو حصل في أية حالة أخرى، أن كانت هوية المحكوم عليه محل نزاع ، يفصل في هذا النزاع وفق القواعد المقررة في مادة إشكالات التنفيذ ، غير أن الجلسة تكون علنية. فإذا ثار النزاع في ذلك أثناء سير وبمناسبة متابعة جديدة ، قام بحسمه المجلس القضائي أو المحكمة المطروحة أمامها هذه المتابعة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
