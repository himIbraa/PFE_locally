<https://legal.dz/resource/law/2025-08-03/25-14#version_art_399> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز أن يكون من المحلفين : الأشخاص المحكوم عليهم بعقوبة جنائية أو بعقوبة سالبة للحرية أو بغرامة لا تقل عن 20.000 دج الأشخاص الذين يكونون في حالة اتهام أو محكوما عليهم غيابيا من محكمة الجنايات والصادر في شأنهم أمر بالإيداع أو بالقبض، موظفو الدولة وأعوانها وموظفو الولايات والبلديات المعزولون من وظائفهم، أعضاء النقابات المهنية الممنوعون قضائيا من مباشرة العمل، المفلسون الذين لم يرد إليهم اعتبارهم، المحجور عليهم والأشخاص المعين عليهم قيم قضائي أو المودعون بمستشفى الأمراض العقلية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_399_20250803_OpEnact_90bcfc3ea2> ;
    dzdoc:replacementText "لا يجوز أن يكون من المحلفين : الأشخاص المحكوم عليهم بعقوبة جنائية أو بعقوبة سالبة للحرية أو بغرامة لا تقل عن 20.000 دج الأشخاص الذين يكونون في حالة اتهام أو محكوما عليهم غيابيا من محكمة الجنايات والصادر في شأنهم أمر بالإيداع أو بالقبض، موظفو الدولة وأعوانها وموظفو الولايات والبلديات المعزولون من وظائفهم، أعضاء النقابات المهنية الممنوعون قضائيا من مباشرة العمل، المفلسون الذين لم يرد إليهم اعتبارهم، المحجور عليهم والأشخاص المعين عليهم قيم قضائي أو المودعون بمستشفى الأمراض العقلية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_399> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
