<https://legal.dz/resource/law/2025-08-03/25-14#version_art_643> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تعذر استخراج أو تحويل المتهم أو الشخص المحبوس لأحد الأسباب المنصوص عليها في المادة 639 أعلاه ، يمكن جهة التحقيق، بعد إخطار مدير المؤسسة العقابية، سماعه بها عن طريق استعمال المحادثة المرئية عن بعد بحضور أمين ضبط المؤسسة العقابية. يحرر أمين ضبط المؤسسة العقابية محضرا عن سير عملية استعمال هذه التقنية ويوقعه ثم يرسله بمعرفة مدير المؤسسة العقابية إلى الجهة القضائية المختصة لإلحاقه بملف الإجراءات. يحق للمحامي الحضور رفقة موكله بمكان سماعه و/ أو أمام جهة التحقيق المختصة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_643_20250803_OpEnact_8f3596f724> ;
    dzdoc:replacementText "إذا تعذر استخراج أو تحويل المتهم أو الشخص المحبوس لأحد الأسباب المنصوص عليها في المادة 639 أعلاه ، يمكن جهة التحقيق، بعد إخطار مدير المؤسسة العقابية، سماعه بها عن طريق استعمال المحادثة المرئية عن بعد بحضور أمين ضبط المؤسسة العقابية. يحرر أمين ضبط المؤسسة العقابية محضرا عن سير عملية استعمال هذه التقنية ويوقعه ثم يرسله بمعرفة مدير المؤسسة العقابية إلى الجهة القضائية المختصة لإلحاقه بملف الإجراءات. يحق للمحامي الحضور رفقة موكله بمكان سماعه و/ أو أمام جهة التحقيق المختصة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
