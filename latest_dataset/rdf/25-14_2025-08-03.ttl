<https://legal.dz/resource/law/2025-08-03/25-14#version_art_206> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لكل متهم انتهت محاكمته بالبراءة أن يطلب من الجهة القضائية التي أصدرت هذا الحكم الأمر بنشره حسب الوسائل التي يراها مناسبة، على نفقة الشاكي ."@ar ;
    dzdoc:isAuthoritative true ;
