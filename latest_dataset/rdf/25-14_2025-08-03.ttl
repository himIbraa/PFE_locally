<https://legal.dz/resource/law/2025-08-03/25-14#version_art_300> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يراقب رئيس غرفة الاتهام ويشرف على مجرى إجراءات التحقيق المتبعة في جميع مكاتب التحقيق بدائرة المجلس ، ويتحقق بالأخص من تطبيق شروط الفقرتين 5 و 6 من المادة 141 أعلاه، ويبذل جهده في ألا يطرأ على الإجراءات أي تأخير بغير مسوغ. وتحقيقا لهذا الغرض، تعد كل ثلاثة (3) أشهر بكل مكتب تحقيق قائمة ببيان جميع القضايا المتداولة ، مع ذكر تاريخ آخر إجراء من إجراءات التحقيق تم تنفيذه في كل قضية منها. وتبين القضايا التي فيها متهمون محبوسون مؤقتا في قائمة خاصة، وتقدم هذه القوائم المنصوص عليها في هذه المادة لـ رئيس غ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_300_20250803_OpEnact_aa0e0d4c38> ;
    dzdoc:replacementText "يراقب رئيس غرفة الاتهام ويشرف على مجرى إجراءات التحقيق المتبعة في جميع مكاتب التحقيق بدائرة المجلس ، ويتحقق بالأخص من تطبيق شروط الفقرتين 5 و 6 من المادة 141 أعلاه، ويبذل جهده في ألا يطرأ على الإجراءات أي تأخير بغير مسوغ. وتحقيقا لهذا الغرض، تعد كل ثلاثة (3) أشهر بكل مكتب تحقيق قائمة ببيان جميع القضايا المتداولة ، مع ذكر تاريخ آخر إجراء من إجراءات التحقيق تم تنفيذه في كل قضية منها. وتبين القضايا التي فيها متهمون محبوسون مؤقتا في قائمة خاصة، وتقدم هذه القوائم المنصوص عليها في هذه المادة لـ رئيس غرفة الاتهام و لـ النائب العام ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_300> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_300> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_301> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يراقب رئيس غرفة الاتهام الحبس المؤقت . و يتعين عليه أن يقوم بزيارة كل مؤسسة عقابية بدائرة اختصاص المجلس القضائي مرة كل ثلاثة (3) أشهر، على الأقل، لتفقد وضعية المحبوسين مؤقتا ، و إذا ما بدا له أن الحبس غير مبرر يوجه إلى قاضي التحقيق الملاحظات اللازمة لاتخاذ الإجراءات المناسبة. ويجوز لـ رئيس غرفة الاتهام أن يفوض سلطته إلى قاض من قضاة الحكم التابعين إلى غرفة الاتهام أو إلى قاض آخر بالمجلس القضائي. وفي كل الأحوال، يجوز له أن يخطر غرفة الاتهام كي تفصل في استمرار حبس متهم مؤقتا، وفقا للإجراءات المنصوص"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_301_20250803_OpEnact_4cb4751726> ;
    dzdoc:replacementText "يراقب رئيس غرفة الاتهام الحبس المؤقت . و يتعين عليه أن يقوم بزيارة كل مؤسسة عقابية بدائرة اختصاص المجلس القضائي مرة كل ثلاثة (3) أشهر، على الأقل، لتفقد وضعية المحبوسين مؤقتا ، و إذا ما بدا له أن الحبس غير مبرر يوجه إلى قاضي التحقيق الملاحظات اللازمة لاتخاذ الإجراءات المناسبة. ويجوز لـ رئيس غرفة الاتهام أن يفوض سلطته إلى قاض من قضاة الحكم التابعين إلى غرفة الاتهام أو إلى قاض آخر بالمجلس القضائي. وفي كل الأحوال، يجوز له أن يخطر غرفة الاتهام كي تفصل في استمرار حبس متهم مؤقتا، وفقا للإجراءات المنصوص عليها في هذا الفصل."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_301> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_301> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_302> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تراقب غرفة الاتهام أعمال ضباط وأعوان الشرطة القضائية والموظفين والأعوان المنوطة بهم بعض مهام الضبط القضائي الذين يمارسونها حسب الشروط المحددة في المواد 31 وما يليها من هذا القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_302_20250803_OpEnact_4e12576642> ;
    dzdoc:replacementText "تراقب غرفة الاتهام أعمال ضباط وأعوان الشرطة القضائية والموظفين والأعوان المنوطة بهم بعض مهام الضبط القضائي الذين يمارسونها حسب الشروط المحددة في المواد 31 وما يليها من هذا القانون ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_302> ;
