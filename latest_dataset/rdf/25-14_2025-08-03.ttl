    dznorm:provisionText "ويجب أن يساعدهم أحد ضباط الشرطة القضائية الذي يمارس وظائفه في المجموعة السكنية المعنية"@ar ;
    dznorm:sourceArticle "art_24" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_24_obligation_1_573f20d8_action_fe6d9e232e> a dznorm:Action ;
    rdfs:label "أن يساعدهم أحد ضباط الشرطة"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "ويجب أن يساعدهم أحد ضباط الشرطة القضائية الذي يمارس وظائفه في المجموعة السكنية المعنية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_24> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_24_obligation_2_c4419b2d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_24> ;
    dznorm:position 2 ;
    dznorm:provisionText "يتعين عليهم أن يخبروا مسبقا وكيل الجمهورية الذي يباشرون مهمتهم في دائرة اختصاصه"@ar ;
    dznorm:sourceArticle "art_24" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_24_obligation_3_34c6b21d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_24> ;
    dznorm:position 3 ;
    dznorm:provisionText "ويعلم وكيل الجمهورية المختص إقليميا بذلك في جميع الحالات"@ar ;
    dznorm:sourceArticle "art_24" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_24_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_24> ;
    dzdoc:position 0 ;
    dzdoc:text "يمارس ضباط الشرطة القضائية اختصاصهم المحلي في الحدود التي يباشرون ضمنها وظائفهم المعتادة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_24_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_24> ;
    dzdoc:position 1 ;
    dzdoc:text "إلا أنه يجوز لهم، في حالة الاستعجال، أن يباشروا مهمتهم في كافة دائرة اختصاص المجلس القضائي الملحقون به."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_24_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_24> ;
    dzdoc:position 2 ;
    dzdoc:text "ويجوز لهم أيضا، في حالة الاستعجال، أن يباشروا مهمتهم في كافة الإقليم الوطني إذا طلب منهم أداء ذلك من القاضي المختص قانونا، ويجب أن يساعدهم أحد ضباط الشرطة القضائية الذي يمارس وظائفه في المجموعة السكنية المعنية."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_24_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_24> ;
    dzdoc:position 3 ;
    dzdoc:text "و في الحالات المنصوص عليها في الفقرتين السابقتين، يتعين عليهم أن يخبروا مسبقا وكيل الجمهورية الذي يباشرون مهمتهم في دائرة اختصاصه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_24_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_24> ;
    dzdoc:position 4 ;
    dzdoc:text "وفي كل مجموعة سكنية عمرانية مقسمة إلى دوائر للشرطة، فإن اختصاص محافظي وضباط الشرطة الذين يمارسون وظائفهم في إحداها، يشمل كافة المجموعة السكنية."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_24_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_24> ;
    dzdoc:position 5 ;
    dzdoc:text "لا تطبق أحكام الفقرات الثانية والثالثة والرابعة والخامسة من هذه المادة على ضباط الشرطة القضائية للمصالح العسكرية للأمن أو للمصالح المركزية للشرطة القضائية، الذين لهم الاختصاص في كافة الإقليم الوطني."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_24_para_6> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_24> ;
    dzdoc:position 6 ;
    dzdoc:text "غير أنه فيما يتعلق ببحث ومعاينة جرائم القتل العمدي، والمخدرات والمؤثرات العقلية، والجريمة المنظمة عبر الحدود الوطنية، والجرائم المتصلة بتكنولوجيات الإعلام والاتصال، وجرائم تبييض الأموال والإرهاب، والجرائم المتعلقة بالتشريع الخاص بالصرف وحركة رؤوس الأموال من و إلى الخارج، وجرائم الفساد، وجرائم التهريب، وجرائم الاتجار بالبشر، وجرائم الاتجار بالأعضاء، وجرائم تهريب المهاجرين، وجرائم اختطاف الأشخاص، يمتد اختصاص ضباط الشرطة القضائية إلى كامل الإقليم الوطني."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_24_para_7> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_24> ;
    dzdoc:position 7 ;
    dzdoc:text "ويعمل هؤلاء تحت إشراف النائب العام لدى المجلس القضائي المختص إقليميا، ويعلم وكيل الجمهورية المختص إقليميا بذلك في جميع الحالات."@ar .

