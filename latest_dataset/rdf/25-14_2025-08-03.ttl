<https://legal.dz/resource/law/2025-08-03/25-14#version_art_673> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمستشار المقرر أن يمنح الخصوم ما يلزم من آجال لتمكينهم من استيفاء أسانيدهم . وعليه أن يستبعد من القضية كل مذكرة تودع بعد إيداع مذكرة الرد أو تقدم بعد آخر أجل ممنوح ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_673_20250803_OpEnact_5c972bcf3c> ;
