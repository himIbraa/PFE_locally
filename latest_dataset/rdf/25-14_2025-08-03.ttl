<https://legal.dz/resource/law/2025-08-03/25-14#version_art_466> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز ل محكمة الجنايات الاستئنافية ، إذا كان الاستئناف مرفوعا من المتهم وحده أو من المسؤول عن الحقوق المدنية وحده ، أن تسيء حالة المستأنف . ولا يجوز للطرف المدني أن يقدم طلبا جديدا ، غير أنه يمكنه أن يطلب زيادة التعويضات المدنية بالنسبة للضرر الذي لحق به منذ صدور حكم محكمة الجنايات الابتدائية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_466_20250803_OpEnact_cc8d0a4c6f> ;
    dzdoc:replacementText "لا يجوز ل محكمة الجنايات الاستئنافية ، إذا كان الاستئناف مرفوعا من المتهم وحده أو من المسؤول عن الحقوق المدنية وحده ، أن تسيء حالة المستأنف . ولا يجوز للطرف المدني أن يقدم طلبا جديدا ، غير أنه يمكنه أن يطلب زيادة التعويضات المدنية بالنسبة للضرر الذي لحق به منذ صدور حكم محكمة الجنايات الابتدائية ."@ar ;
