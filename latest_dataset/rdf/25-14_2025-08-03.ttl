<https://legal.dz/resource/law/2025-08-03/25-14#version_art_241> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText """يحلف الخبير المقيد لأول مرة بالجدول الخاص بالمجلس القضائي أمام القاضي وبحضور أمين الضبط يمينا أمام ذلك المجلس بالصيغة الآتي بيانها :
                "أقسم بالله العظيم وأتعهد بأن أقوم بأداء مهمتي كخبير على خير وجه وبكل إخلاص وأن أبدي رأيي بكل نزاهة واستقلال " . ولا يجدد هذا القسم ما دام الخبير مقيدا في الجدول. ويؤدي الخبير الذي يختار من خارج الجدول، قبل مباشرة مهمته، اليمين السابق بيانها أمام قاضي التحقيق أو القاضي المعين من الجهة القضائية . ويوقع على محضر أداء اليمين من القاضي المختص والخبير وأ"""@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_241_20250803_OpEnact_edc312e626> ;
    dzdoc:replacementText """يحلف الخبير المقيد لأول مرة بالجدول الخاص بالمجلس القضائي أمام القاضي وبحضور أمين الضبط يمينا أمام ذلك المجلس بالصيغة الآتي بيانها :
                "أقسم بالله العظيم وأتعهد بأن أقوم بأداء مهمتي كخبير على خير وجه وبكل إخلاص وأن أبدي رأيي بكل نزاهة واستقلال " . ولا يجدد هذا القسم ما دام الخبير مقيدا في الجدول. ويؤدي الخبير الذي يختار من خارج الجدول، قبل مباشرة مهمته، اليمين السابق بيانها أمام قاضي التحقيق أو القاضي المعين من الجهة القضائية . ويوقع على محضر أداء اليمين من القاضي المختص والخبير وأمين الضبط. ويجوز، في حالة قيام مانع من حلف اليمين لأسباب يتعين ذكرها بالتحديد ، أداء اليمين بالكتابة ويرفق الكتاب المتضمن ذلك بملف التحقيق ."""@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_241> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_241> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
