<https://legal.dz/resource/law/2025-08-03/25-14#art_412_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_412> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز لرئيس محكمة الجنايات، إذا رأى أن التحقيق غير واف أو اكتشف عناصر جديدة بعد صدور قرار الإحالة، أن يأمر باتخاذ أي إجراء من إجراءات التحقيق."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_412_para_1> a dzdoc:Paragraph ;
