    dznorm:position 2 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_886_condition_3_6264fd99> a dznorm:Condition ;
    dznorm:conditionText "ما لم تحل اعتبارات خاصة دون إجابته"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_886> ;
