    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_115> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_115_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_115> ;
    dzdoc:position 0 ;
    dzdoc:text "تتم العمليات المحددة في المادة 114 أعلاه، دون المساس بـالسر المهني المنصوص عليه في المادة 76 أعلاه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_115_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_115> ;
    dzdoc:position 1 ;
    dzdoc:text "إذا اكتشفت جرائم أخرى غير تلك التي ورد ذكرها في إذن القاضي، فإن ذلك لا يكون سببا لبطلان الإجراءات العارضة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_116_obligation_0_54f0a6fe> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
