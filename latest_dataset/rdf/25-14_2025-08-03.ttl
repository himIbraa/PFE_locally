<https://legal.dz/resource/law/2025-08-03/25-14#version_art_358> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "بعد اتخاذ الإجراءات المنصوص عليها في المادة 493 أدناه ، يأمر الرئيس عند الاقتضاء، الشهود بالانسحاب إلى الغرفة المخصصة لهم، ولا يخرجون منها إلا عند مناداتهم لأداء الشهادة. ويتخذ الرئيس عند الضرورة كل الإجراءات اللازمة لمنع الشهود من التحدث فيما بينهم قبل أداء الشهادة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_358_20250803_OpEnact_7aa9828954> ;
