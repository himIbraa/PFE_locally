    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_27> ;
    dznorm:position 3 ;
    dznorm:provisionText "يجب أن ينوه في المحاضر عن صفة الضبط القضائي الخاصة بمحرريها"@ar ;
    dznorm:sourceArticle "art_27" .

