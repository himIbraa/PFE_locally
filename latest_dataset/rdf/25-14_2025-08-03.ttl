<https://legal.dz/resource/law/2025-08-03/25-14#version_art_703> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وجدت نسخة رسمية من الحكم الصادر عن المحكمة أو القرار الصادر عن المجلس القضائي ، اعتبرت بمثابة النسخة الأصلية وسلمت، تبعا لذلك، من كل ضابط عمومي أو أمين إلى أمانة ضبط الجهة القضائية التي أصدرت الحكم أو القرار بناء على أمر من رئيس تلك الجهة. ويعد هذا الأمر بمثابة تبرئة للذمة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_703_20250803_OpEnact_ef39cd7a38> ;
    dzdoc:replacementText "إذا وجدت نسخة رسمية من الحكم الصادر عن المحكمة أو القرار الصادر عن المجلس القضائي ، اعتبرت بمثابة النسخة الأصلية وسلمت، تبعا لذلك، من كل ضابط عمومي أو أمين إلى أمانة ضبط الجهة القضائية التي أصدرت الحكم أو القرار بناء على أمر من رئيس تلك الجهة. ويعد هذا الأمر بمثابة تبرئة للذمة."@ar ;
