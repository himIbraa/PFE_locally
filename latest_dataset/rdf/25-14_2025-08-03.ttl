<https://legal.dz/resource/law/2025-08-03/25-14#version_art_571> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المادة 571 : إذا اقتضى الحال إجراء تحقيق إضافي ، قام بإجرائه قاضي المحكمة وفقا للمواد من 180 إلى 183 أعلاه. وتطبق أحكام الفقرة الثالثة من المادة 506 أعلاه."@ar ;
