<https://legal.dz/resource/law/2025-08-03/25-14#version_art_674> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رأى المستشار المقرر أن القضية مهيأة للفصل فيها ، أودع تقريره وأصدر أمرا بإطلاع النيابة العامة عليه. و على النيابة العامة أن تودع مذكرتها الكتابية في ظرف ثلاثين (30) يوما من استلام ذلك الأمر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_674_20250803_OpEnact_bcabe3c096> ;
    dzdoc:replacementText "إذا رأى المستشار المقرر أن القضية مهيأة للفصل فيها ، أودع تقريره وأصدر أمرا بإطلاع النيابة العامة عليه. و على النيابة العامة أن تودع مذكرتها الكتابية في ظرف ثلاثين (30) يوما من استلام ذلك الأمر ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_674> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
