<https://legal.dz/resource/law/2025-08-03/25-14#version_art_438> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمحكمة، في أية حال كانت عليها الدعوى، إما من تلقاء نفسها أو بطلب معلل من النيابة العامة أو من محامي المتهم، أن تأمر بتأجيل القضية إلى آخر الدورة أو إلى الدورة التي تليها ."@ar ;
    dzdoc:isAuthoritative true ;
