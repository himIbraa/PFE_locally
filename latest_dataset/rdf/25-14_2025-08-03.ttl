<https://legal.dz/resource/law/2025-08-03/25-14#version_art_525> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رأت المحكمة أن الأشياء الموضوعة تحت تصرف القضاء نافعة لإظهار الحقيقة أو قابلة للمصادرة ، أرجأت الفصل في شأنها ريثما يصدر حكم في الموضوع . ويكون الحكم بإرجاء الفصل في هذه الحالة غير قابل لأي طعن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_525_20250803_OpEnact_211a13be93> ;
