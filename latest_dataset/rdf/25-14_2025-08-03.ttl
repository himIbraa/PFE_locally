<https://legal.dz/resource/law/2025-08-03/25-14#version_art_479> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتحقق وكيل الجمهورية من هوية الشخص المقدم أمامه، ثم يبلغه بالأفعال المنسوبة إليه ووصفها القانوني ويخبره بأنه سيمثل فورا أمام المحكمة . كما يبلغ الضحية والشهود بذلك."@ar ;
    dzdoc:isAuthoritative true ;
