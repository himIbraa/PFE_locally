<https://legal.dz/resource/law/2025-08-03/25-14#version_art_362> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤدي الشهود بعد ، ذلك، شهادتهم متفرقين سواء أكانت عن الوقائع المسندة إلى المتهم أم عن شخصيته وأخلاقه. وتسمع أولا، من بين الشهود المستدعين، شهادة من تقدم بهم أطراف الدعوى طالبو المتابعة ما لم ير الرئيس، بما له من سلطة، أن ينظم بنفسه ترتيب سماع الشهود. كما يجوز، في الجنح و المخالفات، أن يقبل، بناء على ترخيص من الجهة القضائية، سماع شهادة الأشخاص الذين يستشهد بهم الخصوم أو يقدمونهم للمحكمة عند افتتاح المرافعة دون أن يكونوا قد استدعوا استدعاء قانونيا لأداء الشهادة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_362_20250803_OpEnact_c24a5a2b87> ;
    dzdoc:replacementText "يؤدي الشهود بعد ، ذلك، شهادتهم متفرقين سواء أكانت عن الوقائع المسندة إلى المتهم أم عن شخصيته وأخلاقه. وتسمع أولا، من بين الشهود المستدعين، شهادة من تقدم بهم أطراف الدعوى طالبو المتابعة ما لم ير الرئيس، بما له من سلطة، أن ينظم بنفسه ترتيب سماع الشهود. كما يجوز، في الجنح و المخالفات، أن يقبل، بناء على ترخيص من الجهة القضائية، سماع شهادة الأشخاص الذين يستشهد بهم الخصوم أو يقدمونهم للمحكمة عند افتتاح المرافعة دون أن يكونوا قد استدعوا استدعاء قانونيا لأداء الشهادة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_362> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_362> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_363> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتعين على كل شاهد لدى طلب الرئيس أن يذكر اسمه ولقبه وسنه ومهنته وموطنه و ما إذا كان يمت للمتهم أو للمسؤول عن الحقوق المدنية أو للضحية أو للمدعي المدني بقرابة أو مصاهرة أو يعمل في خدمة أحد منهم . ويطلب الرئيس من الشهود عند الاقتضاء، أن يوضحوا علاقاتهم القائمة أو التي كانت تربطهم بالمتهم أو بالمسؤول عن الحقوق المدنية أو بالضحية أو بالمدعي المدني."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_363_20250803_OpEnact_d89f8f802d> ;
    dzdoc:replacementText "يتعين على كل شاهد لدى طلب الرئيس أن يذكر اسمه ولقبه وسنه ومهنته وموطنه و ما إذا كان يمت للمتهم أو للمسؤول عن الحقوق المدنية أو للضحية أو للمدعي المدني بقرابة أو مصاهرة أو يعمل في خدمة أحد منهم . ويطلب الرئيس من الشهود عند الاقتضاء، أن يوضحوا علاقاتهم القائمة أو التي كانت تربطهم بالمتهم أو بالمسؤول عن الحقوق المدنية أو بالضحية أو بالمدعي المدني."@ar ;
