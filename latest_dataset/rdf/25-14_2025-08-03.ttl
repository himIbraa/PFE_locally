<https://legal.dz/resource/law/2025-08-03/25-14#version_art_56> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يستطلع وكيل الجمهورية ، عند الاقتضاء، عن طريق النائب العام، رأي المجلس الوطني للصفقات العمومية في الجرائم المتعلقة بالصفقات العمومية، والذي يتعين عليه أن يبدي رأيه في أجل لا يتعدى ثلاثين (30) يوما من تاريخ إخطاره ، ويرفق الرأي بملف الإجراءات. تخضع ملاءمة المتابعة لتقدير النيابة العامة، ولا يمكن، في أي حال، تحريك الدعوى العمومية إلا بناء على بلاغ معلوم المصدر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_56_20250803_OpEnact_d7079d7b5e> ;
    dzdoc:replacementText "يستطلع وكيل الجمهورية ، عند الاقتضاء، عن طريق النائب العام، رأي المجلس الوطني للصفقات العمومية في الجرائم المتعلقة بالصفقات العمومية، والذي يتعين عليه أن يبدي رأيه في أجل لا يتعدى ثلاثين (30) يوما من تاريخ إخطاره ، ويرفق الرأي بملف الإجراءات. تخضع ملاءمة المتابعة لتقدير النيابة العامة، ولا يمكن، في أي حال، تحريك الدعوى العمومية إلا بناء على بلاغ معلوم المصدر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_56> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
