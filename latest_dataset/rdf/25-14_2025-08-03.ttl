<https://legal.dz/resource/law/2025-08-03/25-14#version_art_261> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أحيلت الدعوى إلى المحكمة ، يرسل قاضي التحقيق الملف مع أمر الإحالة الصادر عنه إلى وكيل الجمهورية ، و يتعين على هذا الأخير أن يرسله بغير تمهل إلى أمانة ضبط الجهة القضائية . و يقوم وكيل الجمهورية بتكليف المتهم بالحضور في أقرب جلسة قادمة أمام الجهة القضائية المختصة ، مع مراعاة مواعيد الحضور. وإذا كان المتهم محبوسا مؤقتا ، يجب أن تنعقد الجلسة في أجل لا يتجاوز شهرا واحدا (1) ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_261_20250803_OpEnact_ca3a4011ab> ;
    dzdoc:replacementText "إذا أحيلت الدعوى إلى المحكمة ، يرسل قاضي التحقيق الملف مع أمر الإحالة الصادر عنه إلى وكيل الجمهورية ، و يتعين على هذا الأخير أن يرسله بغير تمهل إلى أمانة ضبط الجهة القضائية . و يقوم وكيل الجمهورية بتكليف المتهم بالحضور في أقرب جلسة قادمة أمام الجهة القضائية المختصة ، مع مراعاة مواعيد الحضور. وإذا كان المتهم محبوسا مؤقتا ، يجب أن تنعقد الجلسة في أجل لا يتجاوز شهرا واحدا (1) ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_261> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_261> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_262> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رأى قاضي التحقيق أن الوقائع تكون جريمة وصفها القانوني جناية يأمر بإرسال ملف الدعوى وقائمة بأدلة الإثبات بمعرفة وكيل الجمهورية ، بغير تمهل، إلى النائب العام لدى المجلس القضائي لاتخاذ الإجراءات وفقا لماهو مقرر في الفصل الخاص بغرفة الاتهام. يستمر أمر الإيداع أو القبض الصادر عن جهة التحقيق منتجا لأثره إلى حين الفصل في القضية من طرف الجهة المحال عليها، أو القضاء بألا وجه للمتابعة من طرف غرفة الاتهام، ما لم يفرج عن المتهم قبل ذلك. ويحتفظ بأدلة الإثبات لدى أمانة ضبط المحكمة إن لم يقرر خلاف ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_262_20250803_OpEnact_b5333d27c4> ;
    dzdoc:replacementText "إذا رأى قاضي التحقيق أن الوقائع تكون جريمة وصفها القانوني جناية يأمر بإرسال ملف الدعوى وقائمة بأدلة الإثبات بمعرفة وكيل الجمهورية ، بغير تمهل، إلى النائب العام لدى المجلس القضائي لاتخاذ الإجراءات وفقا لماهو مقرر في الفصل الخاص بغرفة الاتهام. يستمر أمر الإيداع أو القبض الصادر عن جهة التحقيق منتجا لأثره إلى حين الفصل في القضية من طرف الجهة المحال عليها، أو القضاء بألا وجه للمتابعة من طرف غرفة الاتهام، ما لم يفرج عن المتهم قبل ذلك. ويحتفظ بأدلة الإثبات لدى أمانة ضبط المحكمة إن لم يقرر خلاف ذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_262> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
