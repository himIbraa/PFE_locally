    dznorm:conditionText "إذا تسبب تماطلهم أو امتناعهم في عرقلة السير الحسن لإجراءات التحقيق القضائي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_331> ;
