<https://legal.dz/resource/law/2025-08-03/25-14#version_art_249> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحرر الخبراء ، لدى انتهاء أعمال الخبرة، تقريرا مشتركا يجب أن يشتمل على وصف ما قاموا به من أعمال ونتائجها ، و على الخبراء أن يشهدوا بقيامهم شخصيا بمباشرة هذه الأعمال التي عهد إليهم باتخاذها ويوقعوا على تقريرهم . فإذا اختلفوا في الرأي أو كانت لهم تحفظات في شأن النتائج المشتركة ، أبدى كل منهم رأيه أو تحفظاته على حدة، مع تعليل وجهة نظره. ويودع التقرير والأحراز أو ما تبقى منها لدى أمين ضبط الجهة القضائية التي أمرت بالخبرة ويثبت هذا الإيداع بمحضر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_249_20250803_OpEnact_c9a7bee35b> ;
    dzdoc:replacementText "يحرر الخبراء ، لدى انتهاء أعمال الخبرة، تقريرا مشتركا يجب أن يشتمل على وصف ما قاموا به من أعمال ونتائجها ، و على الخبراء أن يشهدوا بقيامهم شخصيا بمباشرة هذه الأعمال التي عهد إليهم باتخاذها ويوقعوا على تقريرهم . فإذا اختلفوا في الرأي أو كانت لهم تحفظات في شأن النتائج المشتركة ، أبدى كل منهم رأيه أو تحفظاته على حدة، مع تعليل وجهة نظره. ويودع التقرير والأحراز أو ما تبقى منها لدى أمين ضبط الجهة القضائية التي أمرت بالخبرة ويثبت هذا الإيداع بمحضر ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_249> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_249> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_25> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن ضباط الشرطة القضائية ، وتحت سلطتهم أعوان الشرطة القضائية ، ما لم يعترض على ذلك وكيل الجمهورية المختص بعد إخباره ، أن يمددوا عبر كامل الإقليم الوطني عمليات مراقبة الأشخاص الذين يوجد ضدهم مبرر مقبول أو أكثر يحمل على الاشتباه فيهم بارتكاب الجرائم المبينة في المادة 24 أعلاه، أو مراقبة وجهة أو نقل أشياء أو أموال أو متحصلات من ارتكاب هذه الجرائم أو قد تستعمل في ارتكابها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_25_20250803_OpEnact_b3a3d2738b> ;
    dzdoc:replacementText "يمكن ضباط الشرطة القضائية ، وتحت سلطتهم أعوان الشرطة القضائية ، ما لم يعترض على ذلك وكيل الجمهورية المختص بعد إخباره ، أن يمددوا عبر كامل الإقليم الوطني عمليات مراقبة الأشخاص الذين يوجد ضدهم مبرر مقبول أو أكثر يحمل على الاشتباه فيهم بارتكاب الجرائم المبينة في المادة 24 أعلاه، أو مراقبة وجهة أو نقل أشياء أو أموال أو متحصلات من ارتكاب هذه الجرائم أو قد تستعمل في ارتكابها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_25> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_25> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
