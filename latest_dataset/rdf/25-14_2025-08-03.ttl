<https://legal.dz/resource/law/2025-08-03/25-14#version_art_247> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لـ للخبراء ، على سبيل المعلومات وفي الحدود اللازمة لأداء مهمتهم، أن يتلقوا أقوال أشخاص غير المتهم . وعليهم أن يخطروا الخصوم بأن لهم الحق في إبداء ملاحظاتهم المكتوبة في موضوع المهمة المنوط بهم أداؤها دون الإخلال بأحكام المادة 248 أدناه . وإذا رأوا محلا لاستجواب المتهم ، فإن هذا الإجراء يقوم به بحضورهم قاضي التحقيق أو القاضي المعين من المحكمة على أن تراعى في جميع الأحوال الأوضاع والشروط المنصوص عليها في المادتين 180 و 181 من هذا القانون . غير أنه يجوز لـ للمتهم أن يتنازل عن الاستفادة من هذا ا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_247_20250803_OpEnact_4638c8d451> ;
    dzdoc:replacementText "يجوز لـ للخبراء ، على سبيل المعلومات وفي الحدود اللازمة لأداء مهمتهم، أن يتلقوا أقوال أشخاص غير المتهم . وعليهم أن يخطروا الخصوم بأن لهم الحق في إبداء ملاحظاتهم المكتوبة في موضوع المهمة المنوط بهم أداؤها دون الإخلال بأحكام المادة 248 أدناه . وإذا رأوا محلا لاستجواب المتهم ، فإن هذا الإجراء يقوم به بحضورهم قاضي التحقيق أو القاضي المعين من المحكمة على أن تراعى في جميع الأحوال الأوضاع والشروط المنصوص عليها في المادتين 180 و 181 من هذا القانون . غير أنه يجوز لـ للمتهم أن يتنازل عن الاستفادة من هذا الحكم بتقرير صريح منه أمام قاضي التحقيق أو القاضي المعين من المحكمة ، وأن يمد الخبراء ، بحضور محاميه أو بعد استدعائه قانونا، بالإيضاحات اللازمة لتنفيذ مهمتهم، كما يجوز لـ للمتهم أيضا، بإقرار كتابي يقدمه لـ للخبراء ويرفقونه بتقريرهم، أن يتنازل عن مساعدة محاميه له في جلسة أو أكثر من جلسات سماع أقواله . غير أنه يجوز لـ الخبراء الأطباء المكلفين بفحص المتهم ، أن يوجهوا إليه الأسئلة اللازمة لأداء مهمتهم بغير حضور قاض ولا محام."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_247> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_247> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_248> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لأطراف الخصومة، أثناء إجراء أعمال الخبرة، أن يطلبوا من الجهة القضائية التي أمرت بها أن تكلف الخبراء بإجراء أبحاث معينة أو سماع أي شخص معين باسمه قد يكون قادرا على مدهم بالمعلومات ذات الطابع الفني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_248_20250803_OpEnact_09ea533ef7> ;
    dzdoc:replacementText "يجوز لأطراف الخصومة، أثناء إجراء أعمال الخبرة، أن يطلبوا من الجهة القضائية التي أمرت بها أن تكلف الخبراء بإجراء أبحاث معينة أو سماع أي شخص معين باسمه قد يكون قادرا على مدهم بالمعلومات ذات الطابع الفني ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_248> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
