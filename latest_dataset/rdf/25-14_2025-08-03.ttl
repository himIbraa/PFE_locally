<https://legal.dz/resource/law/2025-08-03/25-14#version_art_349> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز إثبات الجرائم بأي طريق من طرق الإثبات، بما فيها الإلكترونية، ما عدا الأحوال التي ينص فيها القانون على غير ذلك، و للقاضي أن يصدر حكمه تبعا لاقتناعه الخاص . ولا يسوغ للقاضي أن يبني قراره إلا على الأدلة المقدمة له في معرض المرافعات والتي حصلت المناقشة فيها حضوريا أمامه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_349_20250803_OpEnact_fa58b65386> ;
    dzdoc:replacementText "يجوز إثبات الجرائم بأي طريق من طرق الإثبات، بما فيها الإلكترونية، ما عدا الأحوال التي ينص فيها القانون على غير ذلك، و للقاضي أن يصدر حكمه تبعا لاقتناعه الخاص . ولا يسوغ للقاضي أن يبني قراره إلا على الأدلة المقدمة له في معرض المرافعات والتي حصلت المناقشة فيها حضوريا أمامه."@ar ;
