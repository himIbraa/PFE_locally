<https://legal.dz/resource/law/2025-08-03/25-14#version_art_16> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوقف أجل التقادم في حالة وجود مانع قانوني كما هو الشأن في الحصانة البرلمانية والدبلوماسية أو مانع مادي يستحيل دفعه كالقوة القاهرة والكوارث الطبيعية، يحول دون إمكانية مباشرة أو ممارسة الدعوى العمومية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_16_20250803_OpEnact_ba3c48e001> ;
    dzdoc:replacementText "يوقف أجل التقادم في حالة وجود مانع قانوني كما هو الشأن في الحصانة البرلمانية والدبلوماسية أو مانع مادي يستحيل دفعه كالقوة القاهرة والكوارث الطبيعية، يحول دون إمكانية مباشرة أو ممارسة الدعوى العمومية ."@ar ;
