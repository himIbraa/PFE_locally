<https://legal.dz/resource/law/2025-08-03/25-14#art_806> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_1> ;
    dzdoc:eId "art_806" ;
    dzdoc:fullText "إذا فقد أحد الأشخاص المستندات الخاصة بهويته أو إذا سرقت منه فعلى النائب العام أو وكيل الجمهورية الواقع بدائرة اختصاصه مكان الفقد أن يرسل إخطارا عن المحضر المحرر عن الفقد أو السرقة إلى المجلس الواقع في دائرة اختصاصه محل الميلاد أو إلى القاضي المكلف بمصلحة صحيفة السوابق القضائية المركزية . ويودع هذا الإخطار في صحيفة السوابق القضائية ، و كلما تلقى أمين ضبط الجهة القضائية لمحل الميلاد أو القاضي المكلف بمصلحة السوابق القضائية المركزية طلبا خاصا بـ القسيمة رقم 2 أو بـ القسيمة رقم 3 المتعلقة بالأشخاص الذين حرر لهم محضر فقد أو سرقة مستندات الهوية فإنه لا يسلم المستخرجات المطلوبة إلا بعد التأكد من هوية الأشخاص الذين قدموا هذه الطلبات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_806> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_806_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_806_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_806_20250803_OpEnact_517b2cf7e7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_806_obligation_0_86f8ada5>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_806_obligation_1_8db80d1e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "806" ;
    dzdoc:position 804 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_806_condition_0_6407bfb6>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_806_condition_1_455c9639> ;
    dzdoc:usesTerm dzterm:bulletin_2,
        dzterm:bulletin_3,
        dzterm:central_criminal_record,
        dzterm:clerk,
        dzterm:criminal_record,
        dzterm:judge,
        dzterm:prosecutor,
        dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_808> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_1> ;
    dzdoc:eId "art_808" ;
    dzdoc:fullText "يقدم الطلب في شكل عريضة إلى رئيس المحكمة أو رئيس المجلس القضائي الذي أصدر الحكم أو القرار ، و إذا كان الحكم صادر من محكمة الجنايات فيقدم الطلب إلى مقر محكمة الجنايات ويطلع الرئيس النيابة العامة على العريضة المقدمة من الطالب، كما يعين قاضيا من أجل كتابة تقرير. و للجهة القضائية المرفوع إليها الطلب أن تقوم بكل إجراءات التحقيق التي تراها ضرورية ولها أن تأمر بتبليغ الشخص الذي يدعي الطالب أنه هو المحكوم عليه. وتجري المرافعة كما يصدر الحكم في غرفة المشورة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_808> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_808_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_808_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_808_20250803_OpEnact_2aa0d53250> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_808_obligation_0_3fb86fac> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "808" ;
    dzdoc:position 806 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_808_condition_0_dad9d226> ;
    dzdoc:usesTerm dzterm:council_president,
        dzterm:court_president,
        dzterm:judge,
        dzterm:prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_824> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_3> ;
    dzdoc:eId "art_824" ;
    dzdoc:fullText "تحرر نسخة ثانية طبق الأصل عن جميع البطاقات رقم 1 المثبتة للعقوبات الخاصة بمخالفات المرور المنصوص عليها في التشريع الساري المفعول ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_824> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_824_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_824_20250803_OpEnact_67c7b7e46e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_824_obligation_0_6dc71b36> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "824" ;
    dzdoc:position 822 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_837> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_6_sec_1> ;
    dzdoc:eId "art_837" ;
    dzdoc:fullText "يرد الاعتبار بقوة القانون لكل محكوم عليه بعقوبة الحبس أو الغرامة موقوفة التنفيذ وذلك بعد انتهاء فترة اختبار خمس (5) سنوات بالنسبة للحبس، وسنة بالنسبة للغرامة، ما لم يحصل إلغاء وقف التنفيذ ، دون الإخلال بأحكام الفقرة الأخيرة من المادة 755 أعلاه. وتبتدئ هذه المهلة من يوم صيرورة الحكم أو القرار بالإدانة حائزا لقوة الشيء المقضي فيه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_837_right_0_b691ec62> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_837> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_837_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_837_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_837_20250803_OpEnact_88ed9d8efa> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "837" ;
    dzdoc:position 835 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_755> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_755> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_837_condition_0_6097816c> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_872> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_1_sec_2> ;
    dzdoc:eId "art_872" ;
    dzdoc:fullText "إذا أصدرت المحكمة العليا رأيا مسببا برفض طلب التسليم ، فإن هذا الرأي يكون نهائيا و لا يجوز قبول التسليم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_872_permission_0_58fe37f9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_872> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_872_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_872_20250803_OpEnact_8503ef5611> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_872_obligation_0_0954e164> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "872" ;
    dzdoc:position 870 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_872_condition_0_6d042f12> ;
    dzdoc:usesTerm dzterm:supreme_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_879> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_1_sec_3> ;
    dzdoc:eId "art_879" ;
    dzdoc:fullText "يعتبر الشخص المسلم الذي كان في إمكانه مغادرة أراضي الدولة الطالبة خلال الثلاثين (30) يوما تبدأ من تاريخ إخلاء سبيله نهائيا، خاضعا بغير تحفظ لقوانين تلك الدولة بالنسبة لأي فعل سابق على تسليمه ومختلف عن الجريمة التي بررت هذا التسليم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_879> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_879_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_879_20250803_OpEnact_3f6eeb5dfe> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "879" ;
    dzdoc:position 877 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "يجب أن تحرر المحاضر التي يضعها ضابط الشرطة القضائية طبقا للقانون في الحال، وعليه أن يوقع على كل ورقة من أوراقها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_88_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_88_20250803_OpEnact_597fa0c3c2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_88_obligation_0_4fe2bbf2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "88" ;
    dzdoc:position 87 ;
    dzdoc:usesTerm dzterm:judicial_police_officer .

<https://legal.dz/resource/law/2025-08-03/25-14#art_885> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_3> ;
    dzdoc:eId "art_885" ;
    dzdoc:fullText "إذا رأت الحكومة الأجنبية في دعوى جزائية يتم التحقيق فيها في الخارج أنه من الضروري طلب إرسال أدلة إثبات أو مستندات توجد تحت يد السلطات الجزائرية فيقدم طلب عنها بالطريق الدبلوماسي ويجاب هذا الطلب على أن تلتزم برد الأوراق والمستندات في أقصر أجل وذلك ما لم تحل اعتبارات خاصة دون إجابته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_885> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_885_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_885_20250803_OpEnact_622f124b05> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_885_obligation_0_47703d3f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "885" ;
    dzdoc:position 883 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_885_condition_0_c38a0baa>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_885_condition_1_6264fd99> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_91> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_91" ;
    dzdoc:fullText "يسوغ لـ وكيل الجمهورية أو لـ قاضي التحقيق عندما يباشر الإجراءات حسبما هو موضح في هذا الفصل أن ينتقل إلى دوائر اختصاص المحاكم المتاخمة لدائرة الاختصاص التي يزاول فيها مهام وظيفته لمتابعة تحرياته إذا ما تطلبت ذلك مقتضيات التحقيق . و يجب عليه أن يخطر مقدما وكيل الجمهورية بالدائرة التي ينتقل إليها . ويذكر في محضره الأسباب التي اقتضت هذا الانتقال، كما يحيط النائب العام علما به."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_91> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_91_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_91_20250803_OpEnact_2fef916687> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_91_obligation_0_b1666734> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "91" ;
    dzdoc:position 90 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_91_condition_0_82d9f9e7> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:prosecutor .

