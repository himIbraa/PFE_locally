        dzdoc:LegalTerm ;
    skos:prefLabel "المثول بناء على الاعتراف المسبق بالذنب"@ar .

dzterm:hidden_crime a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تكون الجريمة خفية إذا كانت طبيعة ركنها المادي تحول دون اكتشافها من قبل الضحية أو من السلطة القضائية"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_15_defocc_61f3ea3eeaec> .

dzterm:immediate_notification_procedures a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يقصد بإجراءات الإخطار الفوري، المنصوص عليها في هذا القسم، إجراءات المثول الفوري وإجراءات الجنح المتلبس بها"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_477_defocc_6a3c91409b65> .

dzterm:judicial_authorities a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الجهات القضائية الجزائرية"@ar .

dzterm:judicial_bailiff a skos:Concept,
