    dzdoc:sourceEId "art_454" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "تطبق إجراءات التبليغ والمعارضة المنصوص عليها في المواد من 579 إلى 583 من هذا القانون"@ar ;
