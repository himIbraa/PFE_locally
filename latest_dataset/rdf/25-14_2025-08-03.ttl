<https://legal.dz/resource/law/2025-08-03/25-14#version_art_560> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تطبق أحكام المواد من 550 إلى 559 من هذا القانون في الأحوال الآتية : إذا كانت المخالفة المحرر عنها المحضر تعرض فاعلها لجزاء غير الجزاء المالي أو لتعويض الأضرار اللاحقة بالأشخاص أو الأشياء أو لعقوبات تتعلق بالعود، إذا كان ثمة تحقيق قضائي، إذا أثبت نفس المحضر أكثر من مخالفتين بالنسبة لمتهم واحد، في الأحوال التي ينص فيها تشريع خاص على استبعاد إجراء غرامة الصلح."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_560_20250803_OpEnact_bcb17be1fd> ;
    dzdoc:replacementText "لا تطبق أحكام المواد من 550 إلى 559 من هذا القانون في الأحوال الآتية : إذا كانت المخالفة المحرر عنها المحضر تعرض فاعلها لجزاء غير الجزاء المالي أو لتعويض الأضرار اللاحقة بالأشخاص أو الأشياء أو لعقوبات تتعلق بالعود، إذا كان ثمة تحقيق قضائي، إذا أثبت نفس المحضر أكثر من مخالفتين بالنسبة لمتهم واحد، في الأحوال التي ينص فيها تشريع خاص على استبعاد إجراء غرامة الصلح."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_560> ;
