<https://legal.dz/resource/law/2025-08-03/25-14#version_art_43> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمثل النائب العام النيابة العامة أمام المجلس القضائي ومجموعة المحاكم التابعة لاختصاصه . و يباشر قضاة النيابة العامة الدعوى العمومية تحت إشرافه . يعمل النائب العام على تنفيذ السياسة الجزائية التي يعدها وزير العدل ، ويرفع له تقريرا دوريا عن ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_43_20250803_OpEnact_81ef4475c1> ;
    dzdoc:replacementText "يمثل النائب العام النيابة العامة أمام المجلس القضائي ومجموعة المحاكم التابعة لاختصاصه . و يباشر قضاة النيابة العامة الدعوى العمومية تحت إشرافه . يعمل النائب العام على تنفيذ السياسة الجزائية التي يعدها وزير العدل ، ويرفع له تقريرا دوريا عن ذلك ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_43> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
