<https://legal.dz/resource/law/2025-08-03/25-14#version_art_634> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتضمن الحكم أو القرار إما الموافقة وإما الرفض، و في حالة الرفض لا يجوز للمحكوم عليه تقديم طلب آخر إلا لأسباب جديدة أو بعد انقضاء مهلة ثلاثة (3) أشهر من تاريخ الرفض . كما يمكن أن يتضمن الحكم أو القرار في حالة قبول الطلب، إخضاع المستفيد لالتزام أو أكثر يحدده القاضي، وينوه فيه أنه في حالة الإخلال بهذا الالتزام أو إذا صدر حكم جديد بالإدانة بعقوبة سالبة للحرية يسقط حقه في الاستفادة بقوة القانون . يبلغ الأطراف بالحكم أو بالقرار بسعي من النيابة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_634_20250803_OpEnact_2b0eee7dd6> ;
    dzdoc:replacementText "يتضمن الحكم أو القرار إما الموافقة وإما الرفض، و في حالة الرفض لا يجوز للمحكوم عليه تقديم طلب آخر إلا لأسباب جديدة أو بعد انقضاء مهلة ثلاثة (3) أشهر من تاريخ الرفض . كما يمكن أن يتضمن الحكم أو القرار في حالة قبول الطلب، إخضاع المستفيد لالتزام أو أكثر يحدده القاضي، وينوه فيه أنه في حالة الإخلال بهذا الالتزام أو إذا صدر حكم جديد بالإدانة بعقوبة سالبة للحرية يسقط حقه في الاستفادة بقوة القانون . يبلغ الأطراف بالحكم أو بالقرار بسعي من النيابة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_634> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_634> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_635> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن الأحكام التي يصدرها قسم تطبيق العقوبات قابلة للاستئناف من طرف النيابة والمحكوم عليه و/أو محاميه ، ويرفع الاستئناف في مهلة عشرة (10) أيام، اعتبارا من يوم النطق بالحكم بالنسبة لوكيل الجمهورية ومن تاريخ التبليغ بالنسبة للمحكوم عليه، إذا صدر الحكم في غيبته . فيما عدا الحكم الصادر في غياب المحكوم عليه غير المحبوس ، أو الصادر في الإفراج المشروط لأسباب صحية، يكون للاستئناف أثر موقف . يقدم النائب العام استئنافه في مهلة شهر (1)، اعتبارا من يوم النطق بالحكم ولا تحول هذه المهلة دون تنفيذ الحكم. يرفع الا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_635_20250803_OpEnact_f753028515> ;
    dzdoc:replacementText "إن الأحكام التي يصدرها قسم تطبيق العقوبات قابلة للاستئناف من طرف النيابة والمحكوم عليه و/أو محاميه ، ويرفع الاستئناف في مهلة عشرة (10) أيام، اعتبارا من يوم النطق بالحكم بالنسبة لوكيل الجمهورية ومن تاريخ التبليغ بالنسبة للمحكوم عليه، إذا صدر الحكم في غيبته . فيما عدا الحكم الصادر في غياب المحكوم عليه غير المحبوس ، أو الصادر في الإفراج المشروط لأسباب صحية، يكون للاستئناف أثر موقف . يقدم النائب العام استئنافه في مهلة شهر (1)، اعتبارا من يوم النطق بالحكم ولا تحول هذه المهلة دون تنفيذ الحكم. يرفع الاستئناف بموجب تقرير يودع لدى أمانة ضبط المحكمة، كما يجوز التصريح به أمام كتابة الضبط القضائية بالمؤسسة العقابية التي تتولى إرساله إلى الجهة القضائية المختصة، خلال 24 ساعة من تاريخ تلقيه. في حالة الاستئناف، يرسل الملف بمعرفة وكيل الجمهورية إلى المجلس القضائي في أجل خمسة (5) أيام، على الأكثر، من تاريخ انقضاء أجال الاستئناف . تتولى النيابة العامة جدولة الملف المرسل إليها من المحكمة، خلال أجل لا يتجاوز عشرة (10) أيام من تاريخ استلامها إياه ، و تسهر على إخطار المحبوس و / أو محاميه بتاريخ الجلسة خلال 48 ساعة قبل تاريخ انعقادها ، ويوضع الملف تحت تصرف المحامي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_635> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_635> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_636> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تفصل غرفة تطبيق العقوبات بالمجلس القضائي في الاستئناف بتشكيلة تتكون من ثلاث قضاة ، ويباشر مهام النيابة العامة النائب العام أو أحد مساعديه ويمارس مهام أمانة الضبط أمين ضبط الجلسة. يفصل في الاستئناف، في أحسن الآجال في جلسة علنية، بعد تقرير شفوي من أحد المستشارين وسماع المعني و/أو دفاعه وتقديم النيابة العامة لطلباتها. إن حضور المحكوم عليه غير إلزامي على مستوى الاستئناف."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_636_20250803_OpEnact_4862909caa> ;
    dzdoc:replacementText "تفصل غرفة تطبيق العقوبات بالمجلس القضائي في الاستئناف بتشكيلة تتكون من ثلاث قضاة ، ويباشر مهام النيابة العامة النائب العام أو أحد مساعديه ويمارس مهام أمانة الضبط أمين ضبط الجلسة. يفصل في الاستئناف، في أحسن الآجال في جلسة علنية، بعد تقرير شفوي من أحد المستشارين وسماع المعني و/أو دفاعه وتقديم النيابة العامة لطلباتها. إن حضور المحكوم عليه غير إلزامي على مستوى الاستئناف."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_636> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_636> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
