<https://legal.dz/resource/law/2025-08-03/25-14#version_art_255> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يترتب البطلان أيضا، على مخالفة الأحكام الجوهرية المقررة في هذا الباب خلافا للأحكام المقررة في المادتين 175 و 180 أعلاه ، إذا ترتب على مخالفتها إخلال بحقوق الدفاع أو حقوق أي خصم في الدعوى . وتقرر غرفة الاتهام ما إذا كان البطلان يتعين قصره على الإجراء المطعون فيه أو امتداده جزئيا أو كليا إلى الإجراءات اللاحقة له. ويجوز دائما للخصم التنازل عن التمسك بالبطلان المقرر لمصلحته وحده ، ويتعين أن يكون هذا التنازل صريحا . ويرفع الأمر لغرفة الاتهام طبقا لـ المادة 254 أعلاه، وتفصل فيه طبقا لما هو مقرر في الم"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_255_20250803_OpEnact_392479d5b9> ;
    dzdoc:replacementText "يترتب البطلان أيضا، على مخالفة الأحكام الجوهرية المقررة في هذا الباب خلافا للأحكام المقررة في المادتين 175 و 180 أعلاه ، إذا ترتب على مخالفتها إخلال بحقوق الدفاع أو حقوق أي خصم في الدعوى . وتقرر غرفة الاتهام ما إذا كان البطلان يتعين قصره على الإجراء المطعون فيه أو امتداده جزئيا أو كليا إلى الإجراءات اللاحقة له. ويجوز دائما للخصم التنازل عن التمسك بالبطلان المقرر لمصلحته وحده ، ويتعين أن يكون هذا التنازل صريحا . ويرفع الأمر لغرفة الاتهام طبقا لـ المادة 254 أعلاه، وتفصل فيه طبقا لما هو مقرر في المادة 287 أدناه."@ar ;
