<https://legal.dz/resource/law/2025-08-03/25-14#version_art_175> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتحقق قاضي التحقيق ، حين مثول المتهم أمامه لأول مرة ، من هويته ويحيطه علما صراحة بكل واقعة من الوقائع المنسوبة إليه والاتهام الموجه إليه والمواد القانونية المطبقة، وينبهه بأنه حر في عدم الإدلاء بأي تصريح، وينوه عن ذلك التنبيه في المحضر . فإذا أراد المتهم أن يدلي بأقواله ، تلقاها قاضي التحقيق منه على الفور. وينبغي على قاضي التحقيق أن يعلم المتهم قبل تلقي تصريحاته بأن له الحق في اختيار محام عنه و منه أجلا لذلك ، فإن لم يقم بذلك ، عين له محاميا من تلقاء نفسه إذا طلب منه ذلك وينوه عن ذلك بالمحضر. يج"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_175_20250803_OpEnact_3d893a083f> ;
    dzdoc:replacementText "يتحقق قاضي التحقيق ، حين مثول المتهم أمامه لأول مرة ، من هويته ويحيطه علما صراحة بكل واقعة من الوقائع المنسوبة إليه والاتهام الموجه إليه والمواد القانونية المطبقة، وينبهه بأنه حر في عدم الإدلاء بأي تصريح، وينوه عن ذلك التنبيه في المحضر . فإذا أراد المتهم أن يدلي بأقواله ، تلقاها قاضي التحقيق منه على الفور. وينبغي على قاضي التحقيق أن يعلم المتهم قبل تلقي تصريحاته بأن له الحق في اختيار محام عنه و منه أجلا لذلك ، فإن لم يقم بذلك ، عين له محاميا من تلقاء نفسه إذا طلب منه ذلك وينوه عن ذلك بالمحضر. يجوز للمحامي الحاضر مع المتهم ، بعد إذن قاضي التحقيق ، تقديم ملاحظات أثناء السماع ، وتضمن هذه الملاحظات بالمحضر أو ترفق به، حتى ولو تم رفضها من قاضي التحقيق . يتعين على قاضي التحقيق أن يعلم المتهم بإمكانية استدعائه أو تبليغه عن طريق عنوانه الإلكتروني أو رقم هاتفه ، فإذا وافق صراحة على ذلك ، وجب التنويه عن ذلك ، في محضر الاستجواب. كما ينبغي على قاضي التحقيق ، علاوة على ذلك، أن ينبه المتهم إلى وجوب إخطاره بكل تغيير يطرأ على عنوانه أو عنوانه الإلكتروني أو رقم هاتفه . ويجوز للمتهم اختيار موطن له في دائرة اختصاص المحكمة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_175> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_175> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_176> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
