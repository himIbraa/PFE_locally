<https://legal.dz/resource/law/2025-08-03/25-14#version_art_716> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان المحكوم عليه بعقوبة سالبة للحرية، محبوسا سواء أكان نهائيا أم لا ، فإنه يكون لوكيل الجمهورية أو لقاضي التحقيق أو للمحاكم أو للمجالس بدائرة محل الحبس الاختصاص بنظر جميع الجرائم المنسوبة إليه فيما خرج عن القواعد المنصوص عليها في المواد 58 و 70 و 468 (الفقرة الأولى) من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_716_20250803_OpEnact_3b61118282> ;
    dzdoc:replacementText "إذا كان المحكوم عليه بعقوبة سالبة للحرية، محبوسا سواء أكان نهائيا أم لا ، فإنه يكون لوكيل الجمهورية أو لقاضي التحقيق أو للمحاكم أو للمجالس بدائرة محل الحبس الاختصاص بنظر جميع الجرائم المنسوبة إليه فيما خرج عن القواعد المنصوص عليها في المواد 58 و 70 و 468 (الفقرة الأولى) من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_716> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_716> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
