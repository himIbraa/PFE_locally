<https://legal.dz/resource/law/2025-08-03/25-14#version_art_114> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا اقتضت ضرورات التحري في الجريمة المتلبس بها أو التحقيق الابتدائي في جرائم القتل العمدي، والمخدرات والمؤثرات العقلية، والجريمة المنظمة عبر الحدود الوطنية ، والجرائم المتصلة بتكنولوجيات الإعلام والاتصال، وجرائم تبييض الأموال والإرهاب، والجرائم المتعلقة بالتشريع الخاص بالصرف وحركة رؤوس الأموال من و إلى الخارج، وجرائم الفساد ، وجرائم التهريب، وجرائم الاتجار بالبشر، وجرائم الاتجار بالأعضاء، وجرائم تهريب المهاجرين ، وجرائم اختطاف الأشخاص ، يجوز لـ وكيل الجمهورية المختص أن يأذن بما يأتي: اعتراض المر"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_114_20250803_OpEnact_79fff2d956> ;
    dzdoc:replacementText "إذا اقتضت ضرورات التحري في الجريمة المتلبس بها أو التحقيق الابتدائي في جرائم القتل العمدي، والمخدرات والمؤثرات العقلية، والجريمة المنظمة عبر الحدود الوطنية ، والجرائم المتصلة بتكنولوجيات الإعلام والاتصال، وجرائم تبييض الأموال والإرهاب، والجرائم المتعلقة بالتشريع الخاص بالصرف وحركة رؤوس الأموال من و إلى الخارج، وجرائم الفساد ، وجرائم التهريب، وجرائم الاتجار بالبشر، وجرائم الاتجار بالأعضاء، وجرائم تهريب المهاجرين ، وجرائم اختطاف الأشخاص ، يجوز لـ وكيل الجمهورية المختص أن يأذن بما يأتي: اعتراض المراسلات التي تتم عن طريق وسائل الاتصال السلكية واللاسلكية، وضع الترتيبات التقنية، دون موافقة المعنيين، من أجل التقاط وتثبيت وبث وتسجيل الكلام المتفوه به بصفة خاصة أو سرية من طرف شخص أو عدة أشخاص في أماكن خاصة أو عمومية أو التقاط صور لشخص أو عدة أشخاص يتواجدون في مكان خاص. يسمح الإذن المسلم بغرض وضع الترتيبات التقنية بالدخول إلى المحلات السكنية أو غيرها ولو خارج المواعيد المحددة في المادة 78 ،أعلاه ، وبغير علم أو رضا الأشخاص الذين لهم حق على تلك الأماكن. تنفذ العمليات المأذون بها على هذا الأساس تحت المراقبة المباشرة لـ وكيل الجمهورية المختص. في حالة فتح تحقيق قضائي ، تتم العمليات المذكورة بناء على إذن من قاضي التحقيق وتحت مراقبته المباشرة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_114> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_114> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

