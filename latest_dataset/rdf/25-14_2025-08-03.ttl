<https://legal.dz/resource/law/2025-08-03/25-14#version_art_253> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تراعى الأحكام المقررة في المادة 175 أعلاه المتعلقة باستجواب المتهمين ، و المادة 180 أعلاه المتعلقة بسماع الضحية و المدعي المدني ، وإلا ترتب على مخالفتها بطلان الإجراء نفسه وما يليه من إجراءات. ويجوز للطرف الذي لم تراع في حقه أحكام هذه المواد، أو لمحاميه أن يتنازل عن التمسك بالبطلان ويصحح بذلك الإجراء ، ويتعين أن يكون التنازل صريحا ولا يجوز أن يبدى إلا في حضور المحامي أو بعد استدعائه قانونا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_253_20250803_OpEnact_e5a8b5dde5> ;
    dzdoc:replacementText "تراعى الأحكام المقررة في المادة 175 أعلاه المتعلقة باستجواب المتهمين ، و المادة 180 أعلاه المتعلقة بسماع الضحية و المدعي المدني ، وإلا ترتب على مخالفتها بطلان الإجراء نفسه وما يليه من إجراءات. ويجوز للطرف الذي لم تراع في حقه أحكام هذه المواد، أو لمحاميه أن يتنازل عن التمسك بالبطلان ويصحح بذلك الإجراء ، ويتعين أن يكون التنازل صريحا ولا يجوز أن يبدى إلا في حضور المحامي أو بعد استدعائه قانونا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_253> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
