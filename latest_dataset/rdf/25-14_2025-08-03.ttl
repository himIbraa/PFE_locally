<https://legal.dz/resource/law/2025-08-03/25-14#version_art_414> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للرئيس، سواء من تلقاء نفسه أو بناء على طلب النيابة العامة ، أن يأمر بتأجيل قضايا يراها غير مهيأة للفصل فيها خلال الدورة المقيدة بجدولها إلى آخر الدورة أو إلى الدورة التي تليها."@ar ;
