<https://legal.dz/resource/law/2025-08-03/25-14#version_art_412> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لرئيس محكمة الجنايات، إذا رأى أن التحقيق غير واف أو اكتشف عناصر جديدة بعد صدور قرار الإحالة ، أن يأمر باتخاذ أي إجراء من إجراءات التحقيق. ويجوز له أن يفوض لإجراء ذلك قاضيا من أعضاء المحكمة، وتطبق في هذا الصدد الأحكام الخاصة بالتحقيق القضائي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_412_20250803_OpEnact_0b335226e9> ;
    dzdoc:replacementText "يجوز لرئيس محكمة الجنايات، إذا رأى أن التحقيق غير واف أو اكتشف عناصر جديدة بعد صدور قرار الإحالة ، أن يأمر باتخاذ أي إجراء من إجراءات التحقيق. ويجوز له أن يفوض لإجراء ذلك قاضيا من أعضاء المحكمة، وتطبق في هذا الصدد الأحكام الخاصة بالتحقيق القضائي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_412> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
