<https://legal.dz/resource/law/2025-08-03/25-14#version_art_179> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمتهم وللضحية و للمدعي المدني أن يحيطوا قاضي التحقيق ، في كل دور من أدوار التحقيق، علما بالمحامي الذي وقع اختيار كل منهما عليه ، وإذا اختير عدة محامين فإنه يكفي استدعاء أو تبليغ أحدهم بالحضور."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
