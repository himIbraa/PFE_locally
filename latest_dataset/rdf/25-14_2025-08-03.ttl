<https://legal.dz/resource/law/2025-08-03/25-14#version_art_631> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتولى قاضي تطبيق العقوبات تشكيل الملف وإرساله إلى النيابة التي تتولى جدولته في أجل أقصاه خمسة (5) أيام من تاريخ استلامه ، و تسهر على إخطار المحبوس و / أو محاميه بتاريخ الجلسة خلال مهلة 48 ساعة ، على الأقل، قبل انعقادها ، ويوضع الملف تحت تصرف المحامي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_631_20250803_OpEnact_73bc4d182e> ;
