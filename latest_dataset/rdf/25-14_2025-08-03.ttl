<https://legal.dz/resource/law/2025-08-03/25-14#version_art_174> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تعذر على شاهد الحضور انتقل إليه قاضي التحقيق برفقة أمين الضبط ، وبعد إخطار وكيل الجمهورية ، لسماع شهادته أو اتخذ لهذا الغرض طريق الإنابة القضائية. فإذا تحقق من أن شاهدا قد أدعى كذبا عدم استطاعته الحضور جاز له أن يتخذ ضده الإجراءات القانونية طبقا لأحكام المادة 172 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_174_20250803_OpEnact_73a0e0d165> ;
    dzdoc:replacementText "إذا تعذر على شاهد الحضور انتقل إليه قاضي التحقيق برفقة أمين الضبط ، وبعد إخطار وكيل الجمهورية ، لسماع شهادته أو اتخذ لهذا الغرض طريق الإنابة القضائية. فإذا تحقق من أن شاهدا قد أدعى كذبا عدم استطاعته الحضور جاز له أن يتخذ ضده الإجراءات القانونية طبقا لأحكام المادة 172 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_174> ;
