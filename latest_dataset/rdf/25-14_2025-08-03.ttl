    dzdoc:replacementText "ينطق بقرارات المحكمة العليا في جلسة علنية ما لم توجد أحكام قانونية مخالفة لذلك ، وتبلغ بعناية أمين ضبط الجلسة برسالة مسجلة بعلم الوصول إلى أطراف الدعوى وإلى محاميهم. وتنقل بنصها الكامل لتحاط بها الجهة القضائية التي أصدرت القرار المطعون فيه علما ، وذلك بعناية النائب العام لدى المحكمة العليا . وإذا قضي برفض الطعن ، يرسل الملف بالطريقة نفسها إلى الجهة القضائية الأصلية. ويؤشر بمعرفة أمانة الضبط على هامش النسخة الأصلية للقرار المطعون فيه بقرار المحكمة العليا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_680> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_680> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_681> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا قبل الطعن ، قضت المحكمة العليا ببطلان الحكم أو القرار المطعون فيه كليا أو جزئيا و أحالت الدعوى إما إلى الجهة القضائية نفسها مشكلة تشكيلا آخرا، أو إلى جهة قضائية أخرى من درجة الجهة التي أصدرت الحكم أو القرار المنقوض. ويتعين، في حالة نقض الحكم أو القرار لعدم اختصاص الجهة التي أصدرته ، أن تحال القضية إلى الجهة القضائية المختصة في العادة بنظرها. إذا استند الطعن على أوجه غير جدية تتعلق بالموضوع ولا تقبل أي مناقشة قانونية ، أصدرت المحكمة العليا قرارا برفضه لهذا السبب دون تسبيب خاص."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_681_20250803_OpEnact_960d416182> ;
    dzdoc:replacementText "إذا قبل الطعن ، قضت المحكمة العليا ببطلان الحكم أو القرار المطعون فيه كليا أو جزئيا و أحالت الدعوى إما إلى الجهة القضائية نفسها مشكلة تشكيلا آخرا، أو إلى جهة قضائية أخرى من درجة الجهة التي أصدرت الحكم أو القرار المنقوض. ويتعين، في حالة نقض الحكم أو القرار لعدم اختصاص الجهة التي أصدرته ، أن تحال القضية إلى الجهة القضائية المختصة في العادة بنظرها. إذا استند الطعن على أوجه غير جدية تتعلق بالموضوع ولا تقبل أي مناقشة قانونية ، أصدرت المحكمة العليا قرارا برفضه لهذا السبب دون تسبيب خاص."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_681> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
