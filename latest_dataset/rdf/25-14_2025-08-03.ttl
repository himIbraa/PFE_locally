    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_765> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_767> ;
    dznorm:position 0 ;
    dznorm:provisionText "تحدد مدة الإكراه البدني من قبل الجهة القضائية المنصوص عليها في المادة 765 أعلاه"@ar ;
    dznorm:sourceArticle "art_767" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_767_obligation_0_e204782d_ref_62a806da3137> a dzdoc:Reference ;
    rdfs:label "المادة 765"@ar ;
    dzdoc:frbrUri "#art_765"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2025-08-03/25-14#art_765> ;
    dzdoc:sourceEId "art_767" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "تحدد مدة الإكراه البدني من قبل الجهة القضائية المنصوص عليها في المادة 765 أعلاه"@ar ;
    dzdoc:targetEId "art_765" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_767_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_767> ;
    dzdoc:position 0 ;
    dzdoc:text "تحدد مدة الإكراه البدني من قبل الجهة القضائية المنصوص عليها في المادة 765 أعلاه ، و عند الاقتضاء، بأمر على عريضة يصدره رئيس الجهة القضائية التي أصدرت الحكم أو التي يقع في دائرة اختصاصها مكان التنفيذ بناء على طلب النيابة العامة أو طلب المحكوم له وبعد التماسات النيابة العامة، في نطاق الحدود الآتية، ما لم تنص قوانين خاصة على خلاف ذلك : من يومين (2) الى عشرة (10) أيام، إذا كان مقدار الغرامة أو الأحكام المالية الأخرى لا يتجاوز 100.000 دج ، من أحد عشر (11) يوما إلى عشرين (20) يوما، إذا زاد عن 500.000 دج ولم يتجاوز 100.000 دج، من واحد وعشرين (21) يوما إلى شهرين (2)، إذا زاد عن 500.000 دج ولم يتجاوز 1.000.000 دج ، أكثر من شهرين (2) إلى أربعة (4) أشهر، إذا زاد عن 1.000.000 دج ولم يتجاوز 3.000.000 دج ، أكثر من أربعة (4) أشهر إلى ثمانية (8) أشهر، إذا زاد عن 3.000.000 دج ولم يتجاوز 6.000.000 دج، أكثر من ثمانية (8) أشهر إلى سنة واحدة (1)، إذا زاد عن 6.000.000 دج ولم يتجاوز 10.000.000 دج ، أكثر من سنة واحدة (1) إلى سنتين (2)، إذا زاد عن 10.000.000 دج ولم يتجاوز 30.000.000 دج ، أكثر من سنتين (2) إلى خمس (5) سنوات، إذا زاد عن 30.000.000 دج."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_767_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_767> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا كان الإكراه البدني يهدف إلى الوفاء بعدة مطالبات، تحسب مدته طبقا لمجموع المبالغ المحكوم بها."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_768_obligation_0_2d9b2fa8> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_768> ;
    dznorm:position 0 ;
    dznorm:provisionText "يوقف تنفيذ الإكراه البدني لصالح المحكوم عليه الذي يثبت لدى النيابة، بأي وسيلة، عسره المالي"@ar ;
    dznorm:sourceArticle "art_768" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_768_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_768> ;
    dzdoc:position 0 ;
    dzdoc:text "يوقف تنفيذ الإكراه البدني لصالح المحكوم عليه الذي يثبت لدى النيابة، بأي وسيلة، عسره المالي."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_768_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_768> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أنه لا يستفيد من أحكام الفقرة الأولى المحكوم عليه سبب جناية أو جنحة اقتصادية أو أعمال الإرهاب والتخريب أو الجرائم الماسة بأمن الدولة أو الجريمة العابرة للحدود الوطنية وكذا الجنايات والجنح المرتكبة ضد الأحداث."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_769_condition_0_b1e782da> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_769_condition_0_b1e782da_action_492477d498> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_769_condition_0_b1e782da_role_6535824417> ;
    dznorm:conditionText "لا يجوز القبض على المحكوم عليه بالإكراه البدني وحبسه إلا بعد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_769> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_769_condition_0_b1e782da_action_492477d498> a dznorm:Action ;
    rdfs:label "القبض على المحكوم عليه بالإكراه"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "لا يجوز القبض على المحكوم عليه بالإكراه البدني وحبسه إلا بعد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_769> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_769_condition_0_b1e782da_role_6535824417> a dznorm:Role ;
    rdfs:label "المحكوم عليه بالإكراه البدني"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "لا يجوز القبض على المحكوم عليه بالإكراه البدني وحبسه إلا بعد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_769> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_769_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_769> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يجوز القبض على المحكوم عليه بالإكراه البدني وحبسه إلا بعد : أن يوجه إليه تنبيه بالوفاء ويظل بغير جدوى لمدة تزيد على عشرة (10) أيام، أن يقدم طلب بحبسه من طرف الخصم المتابع له. وبعد الاطلاع على هذين المستندين، يوجه وكيل الجمهورية الأوامر اللازمة إلى القوة العمومية ويصير إلقاء القبض على المحكوم عليه المنفذ عليه بالإكراه البدني."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_769_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_769> ;
    dzdoc:position 1 ;
    dzdoc:text "الشروط المقررة في تنفيذ الأوامر القضائية بالقبض."@ar .

