<https://legal.dz/resource/law/2025-08-03/25-14#art_569> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_2_subsec_3> ;
    dzdoc:eId "art_569" ;
    dzdoc:fullText "المادة 569 : تطبق أيضا القواعد المقررة في المواد من 376 إلى 384 المتعلقة بالادعاء المدني و في المواد من 349 إلى 374 المتعلقة بإقامة الدليل مع التحفظات الواردة بالمادة 570 والمواد من 375 الى 502 المتعلقة بطلبات النيابة العامة ومذكرات الخصوم الختامية والمادة 505 المتعلقة بالحكم من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_569> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_569_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_569_20250803_OpEnact_ae61a09b23> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "569" ;
    dzdoc:position 568 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_349>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_374>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_375>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_376>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_384>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_502>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_505>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_570> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_349>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_374>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_375>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_376>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_384>,
