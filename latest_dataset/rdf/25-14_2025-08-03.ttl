<https://legal.dz/resource/law/2025-08-03/25-14#version_art_191> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "أمر الإيداع هو الأمر الذي يصدره القاضي المختص إلى مدير المؤسسة العقابية باستلام وحبس المتهم ، ويرخص هذا الأمر أيضا لـ القوة العمومية بالبحث عن المتهم ونقله إلى المؤسسة العقابية إذا كان قد بلغ به من قبل. يبلغ قاضي التحقيق هذا الأمر لـ المتهم ، و يتعين أن ينص عن هذا التبليغ بمحضر الاستجواب . ويمكن وكيل الجمهورية إصدار أمر بإيداع المتهم ضمن الشروط المنصوص عليها في المادة 486 من هذا القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_191_20250803_OpEnact_87135f3096> ;
    dzdoc:replacementText "أمر الإيداع هو الأمر الذي يصدره القاضي المختص إلى مدير المؤسسة العقابية باستلام وحبس المتهم ، ويرخص هذا الأمر أيضا لـ القوة العمومية بالبحث عن المتهم ونقله إلى المؤسسة العقابية إذا كان قد بلغ به من قبل. يبلغ قاضي التحقيق هذا الأمر لـ المتهم ، و يتعين أن ينص عن هذا التبليغ بمحضر الاستجواب . ويمكن وكيل الجمهورية إصدار أمر بإيداع المتهم ضمن الشروط المنصوص عليها في المادة 486 من هذا القانون ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_191> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
