<https://legal.dz/resource/law/2025-08-03/25-14#version_art_185> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الأمر بالإحضار هو ذلك الأمر الذي يصدره قاضي التحقيق إلى القوة العمومية لاقتياد المتهم ومثوله أمامه على الفور . ويبلغ ذلك الأمر وينفذ بمعرف وفة أحد ضباط أو أعوان الضبط القضائي أو أحد أعوان القوة العمومية الذي يتعين عليه عرضه على المتهم وتسليمه نسخة منه . يجوز ل وكيل الجمهورية إصدار أمر إحضار ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_185_20250803_OpEnact_94924cd85f> ;
    dzdoc:replacementText "الأمر بالإحضار هو ذلك الأمر الذي يصدره قاضي التحقيق إلى القوة العمومية لاقتياد المتهم ومثوله أمامه على الفور . ويبلغ ذلك الأمر وينفذ بمعرف وفة أحد ضباط أو أعوان الضبط القضائي أو أحد أعوان القوة العمومية الذي يتعين عليه عرضه على المتهم وتسليمه نسخة منه . يجوز ل وكيل الجمهورية إصدار أمر إحضار ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_185> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
