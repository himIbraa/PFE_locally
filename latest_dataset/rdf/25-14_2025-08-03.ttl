    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_9_condition_1_4beb7684_role_6ad0689bc6> ;
    dznorm:conditionText "متى نص القانون على ذلك"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_9> ;
