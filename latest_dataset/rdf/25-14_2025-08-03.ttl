<https://legal.dz/resource/law/2025-08-03/25-14#version_art_514> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رأت المحكمة أن الواقعة موضوع المتابعة لا تشكل أية جريمة في التشريع الجزائي أو أنها غير ثابتة أو غير مسندة للمتهم ، قضت ببراءته من المتابعة بغير عقوبة ولا مصاريف قضائية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_514_20250803_OpEnact_c919d72208> ;
