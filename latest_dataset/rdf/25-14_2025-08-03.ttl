<https://legal.dz/resource/law/2025-08-03/25-14#version_art_570> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المادة 570 : تثبت المخالفات إما بمحاضر أو بتقارير وإما بشهادة الشهود في حالة عدم وجود محاضر أو تقارير مثبتة لها. ويؤخذ بالمحاضر والتقارير المحررة بمعرفة ضباط أو أعوان الشرطة القضائية والضباط المنوطه بهم مهام معينة للضبط القضائي الذين خول لهم القانون سلطة إثبات المخالفات كدليل إثبات إلى أن يقوم الدليل العكسي على ما تضمنته، وذلك عدا الحالات التي ينص فيها القانون على خلاف ذلك. ولا يجوز أن يقوم الدليل العكسي إلا بالكتابة أو بشهادة الشهود."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_570_20250803_OpEnact_41a75e268e> ;
    dzdoc:replacementText "المادة 570 : تثبت المخالفات إما بمحاضر أو بتقارير وإما بشهادة الشهود في حالة عدم وجود محاضر أو تقارير مثبتة لها. ويؤخذ بالمحاضر والتقارير المحررة بمعرفة ضباط أو أعوان الشرطة القضائية والضباط المنوطه بهم مهام معينة للضبط القضائي الذين خول لهم القانون سلطة إثبات المخالفات كدليل إثبات إلى أن يقوم الدليل العكسي على ما تضمنته، وذلك عدا الحالات التي ينص فيها القانون على خلاف ذلك. ولا يجوز أن يقوم الدليل العكسي إلا بالكتابة أو بشهادة الشهود."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_570> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
