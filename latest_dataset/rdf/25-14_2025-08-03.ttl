    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_863_condition_0_b2084b70_role_ec4e59603d> a dznorm:Role ;
    rdfs:label "أن يشترط صراحة أن"@ar ;
