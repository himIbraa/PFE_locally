<https://legal.dz/resource/law/2025-08-03/25-14#art_855_condition_1_aff06172> a dznorm:Condition ;
    dznorm:conditionText "وإذا تعلق الأمر بجناية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_855> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_855_obligation_0_b67c89a4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
