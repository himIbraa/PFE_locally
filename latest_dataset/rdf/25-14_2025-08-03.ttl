    dznorm:sourceArticle "art_160" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_160_obligation_3_d3af6026> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_160_obligation_3_d3af6026_action_028a16ecdc> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_160> ;
    dznorm:position 3 ;
    dznorm:provisionText "لا يجوز لقاضي التحقيق أن يضبط غير الأشياء والوثائق النافعة في إظهار الحقيقة أو التي قد يضر إفشاؤها بسير التحقيق"@ar ;
    dznorm:sourceArticle "art_160" .

