    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_237> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_237_obligation_1_bc5ddd73> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
