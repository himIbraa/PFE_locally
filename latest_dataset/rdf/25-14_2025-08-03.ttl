<https://legal.dz/resource/law/2025-08-03/25-14#version_art_236> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتعين على كل شاهد استدعي لسماع شهادته أثناء تنفيذ إنابة قضائية، الحضور وحلف اليمين والإدلاء بشهادته. فإذا تخلف عن القيام بهذه الواجبات ، أخطر القاضي المنيب الذي يسوغ له أن يجبر الشاهد على الحضور بواسطة القوة العمومية وأن يطبق في حقه العقوبات المنصوص عليها في الفقرة 2 من المادة 172 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_236_20250803_OpEnact_2f299bce33> ;
    dzdoc:replacementText "يتعين على كل شاهد استدعي لسماع شهادته أثناء تنفيذ إنابة قضائية، الحضور وحلف اليمين والإدلاء بشهادته. فإذا تخلف عن القيام بهذه الواجبات ، أخطر القاضي المنيب الذي يسوغ له أن يجبر الشاهد على الحضور بواسطة القوة العمومية وأن يطبق في حقه العقوبات المنصوص عليها في الفقرة 2 من المادة 172 من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_236> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_236> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
