        dzterm:supreme_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_609> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_4> ;
    dzdoc:eId "art_609" ;
    dzdoc:fullText "تطبق أحكام هذا الباب في مواد التكليف بالحضور و التبليغات ما لم توجد نصوص مخالفة في القانون . تتم إجراءات التكليف بالحضور و التبليغات من طرف النيابة العامة عن طريق المحضر القضائي ، أو بواسطة الوسائل الإلكترونية ، إذا كان المعني قد وافق عليها ، أو عن طريق البريد أو أمانة الضبط ، أو عند الاقتضاء، عن طريق الضبطية القضائية. تتم إجراءات التكليف بالحضور أو التبليغات من قبل الطرف المدني عن طريق المحضر القضائي . لا يجوز للقائم بالتبليغ أو بالتكليف بالحضور أن يتولى إجراء التبليغ لنفسه أو لزوجه أو لأحد أقاربه أو لأصهاره أو أصهار زوجه على عمود النسب إلى ما لا نهاية أو لأقاربه أو لأصهاره من الحواشي إلى درجة تشمل بما فيه ابن العم الشقيق أو ابن الخال الشقيق ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_609_permission_0_50cd4723> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_609> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_609_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_609_para_1>,
