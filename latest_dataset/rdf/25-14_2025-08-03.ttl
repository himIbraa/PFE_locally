<https://legal.dz/resource/law/2025-08-03/25-14#art_442_obligation_0_4738753b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_442> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتلو الرئيس قبل مغادرة المحكمة لقاعة الجلسة، التعليمات الآتية التي تعلق فضلا عن ذلك بحروف كبيرة في أظهر مكان من غرفة المداولة"@ar ;
    dznorm:sourceArticle "art_442" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_442_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_442> ;
    dzdoc:position 0 ;
    dzdoc:text """يتلو الرئيس قبل مغادرة المحكمة لقاعة الجلسة، التعليمات الآتية التي تعلق فضلا عن ذلك بحروف كبيرة في أظهر مكان من غرفة المداولة :
                "إن القانون لا يطلب من القضاة أن يقدموا حسابا عن الوسائل التي بها قد وصلوا إلى تكوين اقتناعهم، ولا يرسم لهم قواعد بها يتعين عليهم أن يخضعوا لها على الأخص تقدير تمام أو كفاية دليل ،ما ، و لكنه يأمرهم أن يسألوا أنفسهم في صمت وتدبر، وأن يبحثوا بإخلاص ضمائرهم في أي تأثير قد أحدثته في إدراكهم الأدلة المسندة إلى المتهم و أوجه الدفاع عنها، ولم يضع لهم القانون سوى هذا السؤال الذي يتضمن كل نطاق واجباتهم : هل لديكم اقتناع شخصي"."""@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_443_condition_0_d5c550c8> a dznorm:Condition ;
