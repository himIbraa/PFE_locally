    dznorm:provisionText "يراقب رئيس غرفة الاتهام الحبس المؤقت"@ar ;
    dznorm:sourceArticle "art_301" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_301_obligation_1_b03087ef> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
