<https://legal.dz/resource/law/2025-08-03/25-14#art_835_defocc_09cd971c7e2b> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 216 ;
    dzdoc:charStart 141 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:rehabilitation_effect ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_835> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_835_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يجوز رد اعتبار كل شخص طبيعي أو معنوي محكوم عليه بجناية أو بجنحة أو بمخالفة من جهة قضائية جزائرية، بحكم أو قرار نهائي حائز لقوة الشيء المقضي ويمحو رد الاعتبار في المستقبل كل آثار العقوبة وما نجم عنها من حرمان الأهليات."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_835_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_835> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز رد اعتبار كل شخص طبيعي أو معنوي محكوم عليه بجناية أو بجنحة أو بمخالفة من جهة قضائية جزائرية، بحكم أو قرار نهائي حائز لقوة الشيء المقضي ويمحو رد الاعتبار في المستقبل كل آثار العقوبة وما نجم عنها من حرمان الأهليات."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_836_defocc_f69a006258f3> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 25 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:rehabilitation ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_836> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_836_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يرد الاعتبار بقوة القانون للشخص الطبيعي المحكوم عليه من أجل جنحة أو مخالفة الذي لم يصدر ضده، خلال المهل الآتي بيانها ، حكم أو قرار جديد بعقوبة الحبس أو بعقوبة أخرى أكثر منها جسامة لارتكاب جناية أو جنحة :
              
              
              1- فيما يخص عقوبة الغرامة بعد مهلة ثلاث (3) سنوات اعتبارا من يوم سداد الغرامة أو تنفيذ الإكراه البدني أو مضي آجال التقادم،
              
              
              2- فيما يخص عقوبة العمل للنفع العام بعد مهلة أربع (4) سنوات من قضاء العقوبة
              
              
              3- فيما يخص الحكم مرة واحدة بعقوبة الحبس الذي لا تتجاوز مدته سنة واحدة (1) أو بعقوبات متعددة بالحبس لا يتجاوز مجموعها سنة واحدة (1) بعد مضي مهلة ست (6) سنوات، اعتبارا إما من انتهاء العقوبة أو من مضي أجل التقادم،
              
              
              4- فيما يخص الحكم مرة واحدة بعقوبة الحبس الذي لا تتجاوز مدته سنتين (2) أو بعقوبات متعددة بالحبس لا يتجاوز مجموعها سنتين (2) بعد مضي مهلة ثماني (8) سنوات، اعتبارا إما من انتهاء العقوبة أو من مضي أجل التقادم،
              
              
              5- فيما يخص العقوبة الوحيدة بالحبس لمدة لا تتجاوز خمس (5) سنوات أو بعقوبات متعددة بالحبس لا يتجاوز مجموعها ثلاث (3) سنوات، بعد مضي مهلة اثنتي عشرة (12) سنة، اعتبارا إما من انتهاء العقوبة أو من أجل التقادم،
              
              
              6- فيما يخص العقوبة الوحيدة بالحبس لمدة تتجاوز خمس (5) سنوات أو بعقوبات متعددة بالحبس لا يتجاوز مجموعها خمس (5) سنوات بعد مضي مهلة خمس عشرة (15) سنة، اعتبارا إما من انتهاء العقوبة أو من مضي أجل التقادم."""@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_836_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_836> ;
    dzdoc:position 0 ;
    dzdoc:text "يرد الاعتبار بقوة القانون للشخص الطبيعي المحكوم عليه من أجل جنحة أو مخالفة الذي لم يصدر ضده، خلال المهل الآتي بيانها ، حكم أو قرار جديد بعقوبة الحبس أو بعقوبة أخرى أكثر منها جسامة لارتكاب جناية أو جنحة : 1- فيما يخص عقوبة الغرامة بعد مهلة ثلاث (3) سنوات اعتبارا من يوم سداد الغرامة أو تنفيذ الإكراه البدني أو مضي آجال التقادم، 2- فيما يخص عقوبة العمل للنفع العام بعد مهلة أربع (4) سنوات من قضاء العقوبة 3- فيما يخص الحكم مرة واحدة بعقوبة الحبس الذي لا تتجاوز مدته سنة واحدة (1) أو بعقوبات متعددة بالحبس لا يتجاوز مجموعها سنة واحدة (1) بعد مضي مهلة ست (6) سنوات، اعتبارا إما من انتهاء العقوبة أو من مضي أجل التقادم، 4- فيما يخص الحكم مرة واحدة بعقوبة الحبس الذي لا تتجاوز مدته سنتين (2) أو بعقوبات متعددة بالحبس لا يتجاوز مجموعها سنتين (2) بعد مضي مهلة ثماني (8) سنوات، اعتبارا إما من انتهاء العقوبة أو من مضي أجل التقادم، 5- فيما يخص العقوبة الوحيدة بالحبس لمدة لا تتجاوز خمس (5) سنوات أو بعقوبات متعددة بالحبس لا يتجاوز مجموعها ثلاث (3) سنوات، بعد مضي مهلة اثنتي عشرة (12) سنة، اعتبارا إما من انتهاء العقوبة أو من أجل التقادم، 6- فيما يخص العقوبة الوحيدة بالحبس لمدة تتجاوز خمس (5) سنوات أو بعقوبات متعددة بالحبس لا يتجاوز مجموعها خمس (5) سنوات بعد مضي مهلة خمس عشرة (15) سنة، اعتبارا إما من انتهاء العقوبة أو من مضي أجل التقادم."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_859_defocc_7b3525894099> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 63 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:extradition_acts ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_859> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_859_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """الأفعال التي تجيز التسليم، سواء كان مطلوبا أو مقبولا، هي الآتية :
              
              
              1 - جميع الأفعال التي يعاقب عليها قانون الدولة الطالبة بعقوبة جناية،
              
              
              2 - الأفعال التي يعاقب عليها قانون الدولة الطالبة بعقوبة جنحة إذا كان الحد الأقصى للعقوبة المقررة طبقا لنصوص ذلك القانون سنتين (2)، على الأقل، أو إذا تعلق الأمر بمحكوم عليه من الجهة القضائية للدولة الطالبة بعقوبة تساوي أو تجاوز الحبس لمدة شهرين (2)."""@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_859_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_859> ;
    dzdoc:position 0 ;
    dzdoc:text "الأفعال التي تجيز التسليم، سواء كان مطلوبا أو مقبولا، هي الآتية : 1 - جميع الأفعال التي يعاقب عليها قانون الدولة الطالبة بعقوبة جناية، 2 - الأفعال التي يعاقب عليها قانون الدولة الطالبة بعقوبة جنحة إذا كان الحد الأقصى للعقوبة المقررة طبقا لنصوص ذلك القانون سنتين (2)، على الأقل، أو إذا تعلق الأمر بمحكوم عليه من الجهة القضائية للدولة الطالبة بعقوبة تساوي أو تجاوز الحبس لمدة شهرين (2)."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_9_defocc_bb3fe0047321> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 143 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:extinction_public_action ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_9> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_9_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "تنقضي الدعوى العمومية الرامية إلى تطبيق العقوبة بوفاة المتهم وبالتقادم و بالعفو الشامل وبإلغاء نص التجريم وبصدور حكم حائز لقوة الشيء المقضي فيه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_9_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_9> ;
    dzdoc:position 0 ;
    dzdoc:text "تنقضي الدعوى العمومية الرامية إلى تطبيق العقوبة بوفاة المتهم وبالتقادم و بالعفو الشامل وبإلغاء نص التجريم وبصدور حكم حائز لقوة الشيء المقضي فيه."@ar .

