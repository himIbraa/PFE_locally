<https://legal.dz/resource/law/2025-08-03/25-14#version_art_133> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رأى قاضي التحقيق أن أحد الأشخاص المذكورين في هذا الفصل معرض للأخطار المذكورة في المادة 128 أعلاه، وقرر عدم ذكر هويته وكذا البيانات المنصوص عليها في المادة 132 أعلاه ، فإنه ينبغي أن يشير فيه السماع إلى الأسباب التي بررت ذلك . تحفظ المعلومات السرية في ملف خاص يمسكه قاضي التحقيق ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
