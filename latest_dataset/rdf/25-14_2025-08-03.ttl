<https://legal.dz/resource/law/2025-08-03/25-14#art_750_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_750> ;
    dzdoc:position 0 ;
    dzdoc:text "تجوز متابعة ومحاكمة كل أجنبي، وفقا لأحكام القانون الجزائري، ارتكب خارج الإقليم الجزائري بصفة فاعل أصلي أو شريك أو محرض في جناية أو جنحة ضد أمن الدولة الجزائرية أو مصالحها الأساسية أو المقرات الدبلوماسية والقنصلية الجزائرية أو أعوانها، أو تزييفا لنقود أو أوراق مصرفية وطنية متداولة قانونا في الجزائر أو أي جناية أو جنحة ترتكب إضرارا بمواطن جزائري."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_751_obligation_0_97baf395> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_751_obligation_0_97baf395_action_520f92a790> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_751> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يجوز مباشرة إجراء أية متابعة من أجل جناية أو جنحة ارتكبت في الجزائر ضد أجنبي يكون قد أثبت أنه حوكم نهائيا من أجل هذه الجناية أو الجنحة في الخارج وأن يثبت في حالة الإدانة أنه قضى العقوبة أو تقادمت أو صدر عفو عنها"@ar ;
    dznorm:sourceArticle "art_751" .

