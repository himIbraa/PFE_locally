    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_239> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_239_obligation_1_815535a1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_239_obligation_1_815535a1_action_c75c24e0eb> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_239> ;
    dznorm:position 1 ;
    dznorm:provisionText "لا يمكن لقاضي التحقيق أن يتصرف في الملف قبل صدور قرار غرفة الاتهام"@ar ;
    dznorm:sourceArticle "art_239" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_239_obligation_1_815535a1_action_c75c24e0eb> a dznorm:Action ;
