<https://legal.dz/resource/law/2025-08-03/25-14#version_art_501> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن للمتهم الحاضر الاستعانة بمحام عنه . إذا لم يقم المتهم باختيار محام قبل الجلسة وطلب مع ذلك حضور محام عنه ، يعين الرئيس محاميا له تلقائيا. و يكون تعيين محام لتمثيل المتهم وجوبيا إذا كان المتهم مصابا بعاهة طبيعية تعوق دفاعه ."@ar ;
