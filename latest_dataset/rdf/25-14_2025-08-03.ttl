<https://legal.dz/resource/law/2025-08-03/25-14#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "يقوم الموظفون وأعوان الإدارات والمصالح العمومية المكلفون ببعض مهام الضبط القضائي بتتبع الأشياء المنزوعة وضبطها في الأماكن التي تنقل إليها ووضعها تحت الحراسة . غير أنه لا يسوغ لهم الدخول إلى المنازل والمعامل أو المباني أو الأفنية والأماكن المسورة المتجاورة إلا بحضور أحد ضباط الشرطة القضائية ، ولا يجوز لهذا الضابط أن يمتنع عن مصاحبتهم وعليه أن يوقع على المحضر الذي يحرر عن العملية التي شاهدها ولا يجوز أن تجري هذه المعاينات قبل الساعة الخامسة (5:00) صباحا وبعد الساعة الثامنة مساء (20:00) ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_33_permission_0_6a98baf3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_33_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_33_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_33_20250803_OpEnact_c75ce84b74> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_33_obligation_0_7e95ba7b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "33" ;
    dzdoc:position 32 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_33_condition_0_c0bed914>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_33_condition_1_2291413b> ;
    dzdoc:usesTerm dzterm:judicial_police,
        dzterm:judicial_police_officer,
        dzterm:officials .

<https://legal.dz/resource/law/2025-08-03/25-14#art_332> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_4_sec_2> ;
    dzdoc:eId "art_332" ;
    dzdoc:fullText "تودع المنقولات المحجوزة في إطار التحقيق المنصوص عليه في المادتين 330 و 331 أعلاه، على مستوى أمانة ضبط القطب الجزائي الوطني الاقتصادي والمالي، وتودع المبالغ المحجوزة في حساب الخزينة المفتوح لهذا الغرض. تبلغ إلى إدارة أملاك الدولة، قائمة العقارات المحجوزة تطبيقا لأحكام المادة 330 أعلاه. لا يمكن أن تكون الأموال غير القابلة للحجز وفقا للتشريع الوطني محل حجز. يمكن لوكيل الجمهورية لدى القطب الجزائي الوطني الاقتصادي والمالي الترخيص بالتصرف في الأموال المحجوزة قصد تصفية المبالغ المصادرة والغرامات والمصاريف القضائية المحكوم بها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_332_permission_0_57659ece>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_332_permission_1_df594b50> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_332_right_0_069be402> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_332> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_332_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_332_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_332_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_332_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_332_20250803_OpEnact_65fcbb7c4e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 332" ;
    dzdoc:position 331 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_330>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_331> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_330>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_331> ;
    dzdoc:usesTerm dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_369> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_1_sec_1> ;
    dzdoc:eId "art_369" ;
    dzdoc:fullText "لا يجوز سماع شهادة محامي المتهم فيما وصل إلى علمه بهذه الصفة ، أما الأشخاص الآخرون المقيدون بـ السر المهني فيجوز سماعهم بالشروط والحدود التي عينها لهم القانون ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_369_permission_0_c07e26e4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_369> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_369_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_369_20250803_OpEnact_95ba519a8a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_369_obligation_0_44371ad6> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_369_prohibition_0_c07e26e4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "369" ;
    dzdoc:position 368 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_369_condition_0_b6d7c131> ;
    dzdoc:usesTerm dzterm:professional_secrecy .

<https://legal.dz/resource/law/2025-08-03/25-14#art_398> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_398" ;
    dzdoc:fullText "يجوز أن يباشر وظيفة المحلفين ، الأشخاص جزائريو الجنسية البالغون من العمر ثلاثين (30)سنة كاملة، الملمون بالقراءة والكتابة والمتمتعون بالحقوق الوطنية والمدنية والعائلية والذين لا يوجدون في أية حالة من حالات فقد الأهلية أو التعارض المحددة في المادتين 399 و 400 أدناه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_398_permission_0_c069c7c5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_398> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_398_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_398_20250803_OpEnact_c5576ccf8d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 398" ;
    dzdoc:position 397 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_399>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_400> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_399>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_400> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_398_condition_0_0af3d85a> ;
    dzdoc:usesTerm dzterm:juror .

<https://legal.dz/resource/law/2025-08-03/25-14#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_1> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "يجوز مباشرة الدعوى المدنية مع الدعوى العمومية في وقت واحد أمام الجهة القضائية الجزائية . وتكون هذه الجهة القضائية مختصة أيا كان الشخص الطبيعي أو المعنوي المعتبر مسؤولا مدنيا عن الضرر. وكذلك الحال بالنسبة للدولة، والولاية، والبلدية أو إحدى المؤسسات العمومية ذات الطابع الإداري إذا كانت دعوى المسؤولية تهدف إلى التعويض عن ضرر سببته مركبة . تقبل دعوى المسؤولية المدنية عن كافة أوجه الضرر، سواء كانت مادية أو جسمانية أو أدبية، ما دامت ناجمة عن الوقائع موضوع المتابعة الجزائية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_4_permission_0_12f11934> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_4_right_0_9228fa6d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_4_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_4_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_4_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_4_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_4_20250803_OpEnact_ed19acf685> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_4_obligation_0_5b8019e6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 4" ;
    dzdoc:position 3 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_4_condition_0_99e921f1> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_418> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_5_subsec_1> ;
    dzdoc:eId "art_418" ;
    dzdoc:fullText "يصدر الرئيس والقضاة أعضاء المحكمة، بعد سماع أقوال النيابة العامة ، حكما معللا، بكل الأوامر المتخذة وفقا لأحكام المادة 417 أعلاه. ولا يجوز الطعن في هذا الحكم بطريق الاستئناف، و يجوز الطعن فيه بالنقض مع الطعن في الحكم الصادر في الموضوع إذا كان صادرا عن محكمة الجنايات الاستئنافية . وكل تعديل في قائمة المحلفين يجب تبليغه بمعرفة أمانة الضبط إلى المتهم قبل استجوابه عن هويته ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_418_permission_0_44c5b159> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_418_right_0_7db7a30a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_418> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_418_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_418_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_418_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_418_20250803_OpEnact_172e318721> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_418_obligation_0_ed98bd16> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "418" ;
    dzdoc:position 417 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_417> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_417> ;
    dzdoc:usesTerm dzterm:prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_561> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_561" ;
    dzdoc:fullText "يمكن أن تنقضي الدعوى العمومية الناشئة عن مخالفة، في المواد المنصوص عليها بصفة خاصة في القانون، بدفع غرامة جزافية لا تخضع لقاعدة العود . ويمكن أن يتم تسديد الغرامة، خلال ثلاثين (30) يوما من تحقق المخالفة، لدى المصلحة المذكورة في الإخطار بالمخالفة بواسطة طابع غرامة يعادل مبلغ الغرامة الواجبة الأداء. وإذا لم يتم التسديد في المهلة المنصوص عليها في الفقرة 2 ، يحال محضر المخالفة على وكيل الجمهورية الذي يرفعه بدوره إلى القاضي مشفوعا بطلباته ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_561_permission_0_917437ac> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_561_right_0_8d1a8d08> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_561> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_561_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_561_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_561_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_561_20250803_OpEnact_5322c6a0cd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_561_obligation_0_22575c40> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "561" ;
    dzdoc:position 560 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_561_condition_0_36ef1cc9> ;
    dzdoc:usesTerm dzterm:fine .

<https://legal.dz/resource/law/2025-08-03/25-14#art_589> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_4_subsec_1> ;
    dzdoc:eId "art_589" ;
    dzdoc:fullText "يقدم النائب العام استئنافه في مهلة شهرين (2) اعتبارا من يوم النطق بالحكم . ولا تحول هذه المهلة دون تنفيذ الحكم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_589> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_589_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_589_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_589_20250803_OpEnact_9752ea21a4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_589_obligation_0_932cb1f6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "589" ;
    dzdoc:position 588 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_599> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_4_subsec_2> ;
    dzdoc:eId "art_599" ;
    dzdoc:fullText "يفصل المجلس القضائي في استئنافات مواد الجنح و المخالفات مشكلا من ثلاثة (3) قضاة، على الأقل، من قضاة المجلس. ويقوم النائب العام أو أحد مساعديه بمباشرة مهام النيابة العامة، وأعمال أمانة الضبط يؤديها أمين ضبط الجلسة. و إذا كان المستأنف، محبوسا ، تنعقد الجلسة وجوبا خلال شهرين (2) من تاريخ الاستئناف وإلا أخلي سبيله . يمكن، عند الضرورة ولحسن سير العدالة ، أن تنعقد الجلسة في أي محكمة بدائرة اختصاص المجلس القضائي بناء على أمر من رئيس المجلس."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_599_permission_0_36b00e48> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_599> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_599_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_599_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_599_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_599_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_599_20250803_OpEnact_66cf789f4a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_599_obligation_0_b6d1af27> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "599" ;
    dzdoc:position 598 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_599_condition_0_4c76ae24>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_599_condition_1_5d7f5b5c> ;
    dzdoc:usesTerm dzterm:council,
        dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_607> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_4_subsec_3> ;
    dzdoc:eId "art_607" ;
    dzdoc:fullText "إذا كان الحكم مستوجب الإلغاء، لأن المجلس القضائي قد رأى أن الواقعة بطبيعتها تستوجب وصفا جنائيا قضى بعدم اختصاصه و أحال الدعوى إلى النيابة العامة لاتخاذ ما تراه مناسبا. يجوز للمجلس ، بعد سماع أقوال النيابة العامة، أن يصدر في القرار نفسه أمرا بإيداع المتهم المؤسسة العقابية أو بالقبض عليه . وتطبق فضلا عن ذلك المادة 513 أعلاه ، عند الاقتضاء."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_607_permission_0_e97decb9> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_607_right_0_cf687445> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_607> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_607_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_607_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_607_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_607_20250803_OpEnact_4d7f0dc33b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 607" ;
    dzdoc:position 606 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_513> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_513> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_607_condition_0_32ff8c41> ;
    dzdoc:usesTerm dzterm:judicial_council .

<https://legal.dz/resource/law/2025-08-03/25-14#art_672> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_4> ;
    dzdoc:eId "art_672" ;
    dzdoc:fullText "يناط بالمستشار المقرر توجيه الإجراءات والقيام بتهيئة ملفات الطعون التي عين فيها . ولهذا الغرض، فهو يسهر على حسن إدارة وسرعة تنفيذ كافة أعمال أمانة الضبط ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_672> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_672_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_672_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_672_20250803_OpEnact_67c280945c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_672_obligation_0_6dd56bd0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_672_obligation_1_715c478e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "672" ;
    dzdoc:position 670 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_675> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_4> ;
    dzdoc:eId "art_675" ;
    dzdoc:fullText "سواء أو دعت النيابة العامة مذكرتها في الميعاد المشار إليه أنفا أم لم تودعه، فإن القضية تقيد بجدول الجلسة من طرف رئيس الغرفة وبعد استطلاع رأي النيابة العامة. ويجب تبليغ جميع أطراف الدعوى المعنيين بتاريخ الجلسة قبل انعقادها بخمسة (5) أيام، على الأقل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_675> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_675_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_675_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_675_20250803_OpEnact_b859a77091> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_675_obligation_0_7c86a802> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "675" ;
    dzdoc:position 673 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_677> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_4> ;
    dzdoc:eId "art_677" ;
    dzdoc:fullText "بعد المناداة على القضية بالجلسة، يتلو المستشار المقرر المكلف بها تقريره. إن إجراءات النقض كتابية و يجوز السماح لمحامي أطراف الدعوى ، عند الاقتضاء، بأن يتقدموا بملاحظات شفوية موجزة . وتبدي النيابة العامة طلباتها قبل إقفال باب المناقشة، وبعد ذلك تحال القضية للمداولة لكي تصدر المحكمة العليا القرار في تاريخ محدد."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_677_right_0_c7e13587> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_677> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_677_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_677_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_677_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_677_20250803_OpEnact_b3fcbdf491> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "677" ;
    dzdoc:position 675 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_736> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_8> ;
    dzdoc:eId "art_736" ;
    dzdoc:fullText "إذا كان أحد أعضاء الحكومة أو أحد قضاة المحكمة العليا أو مجلس الدولة أو محكمة التنازع أو أحد الولاة أو رئيس أحد المجالس القضائية أو إحدى المحاكم الإدارية للاستئناف أو النائب العام لدى مجلس قضائي أو محافظ الدولة لدى محكمة إدارية للاستئناف، قابلا للاتهام بارتكاب جناية أو جنحة أثناء مباشرة مهامه أو بمناسبتها ، يحيل وكيل الجمهورية الذي يخطر بالقضية، الملف بالطريق السلمي، على النائب العام لدى المحكمة العليا الذي يخطر الرئيس الأول للمحكمة العليا الذي يعين محكمة أخرى، لمباشرة إجراءات المتابعة والتحقيق والمحاكمة . غير أنه لا تطبق أحكام الفقرة الأولى، إذا كان وكيل الجمهورية لدى القطب الوطني، قد أبدى التماساته للمطالبة بملف الإجراءات خلال مرحلة التحريات الأولية أو مرحلة المتابعة وفقا لأحكام المادة 322 من هذا القانون . لا تحرك الدعوى العمومية في الحالات المنصوص عليها في الفقرة الأولى من هذه المادة و المواد 737 و 738 و 739 أدناه ، إلا من قبل النيابة العامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_736> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_736_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_736_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_736_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_736_20250803_OpEnact_ac6686300c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_736_obligation_0_6fdd3c77> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "736" ;
    dzdoc:position 734 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_322>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_737>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_738>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_739> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_322>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_737>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_738>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_739> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_736_condition_0_09fee6fb>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_736_condition_1_41498749> ;
    dzdoc:usesTerm dzterm:administrative_court_appeal,
        dzterm:conflict_tribunal,
        dzterm:government_member,
        dzterm:judicial_council_president,
        dzterm:prosecutor_general,
        dzterm:state_commissioner,
        dzterm:state_council,
        dzterm:supreme_court_judge,
        dzterm:wali .

<https://legal.dz/resource/law/2025-08-03/25-14#art_737> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_8> ;
    dzdoc:eId "art_737" ;
    dzdoc:fullText "إذا كان الاتهام موجها إلى أحد قضاة مجلس قضائي أو محكمة إدارية للاستئناف أو رئيس محكمة أو وكيل جمهورية أو رئيس محكمة إدارية أو محافظ دولة لدى محكمة إدارية أو رئيس قطب قضائي أو وكيل جمهورية لدى قطب قضائي أو رئيس محكمة تجارية متخصصة ، أرسل الملف بالطريق السلمي من وكيل الجمهورية إلى النائب العام لدى المحكمة العليا الذي يرفع الأمر إلى الرئيس الأول للمحكمة العليا إذا ما قرر أن ثمة محلا للمتابعة، ويندب الرئيس الأول للمحكمة العليا قاضيا للتحقيق من خارج دائرة اختصاص المجلس الذي يقوم بالعمل فيه القاضي المتابع . فإذا انتهى التحقيق ، أحيل المتهم، عند الاقتضاء، إلى الجهة القضائية المختصة بمقر قاضي التحقيق أو أمام غرفة الاتهام بدائرة المجلس القضائي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_737> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_737_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_737_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_737_20250803_OpEnact_6855741f5e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_737_obligation_0_88a818d7>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_737_obligation_1_292f4fb3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "737" ;
    dzdoc:position 735 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_737_condition_0_14665b82>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_737_condition_1_468dc75d> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_762> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_3> ;
    dzdoc:eId "art_762" ;
    dzdoc:fullText "يجوز تقسيط الغرامة بأمر، غير قابل للطعن، من رئيس الجهة القضائية لمكان إقامة المحكوم عليه بناء على طلب مبرر من المعني وبعد استطلاع رأي النيابة العامة. في حالة عدم احترام جدول التسديد، كما هو محدد في الأمر القضائي المذكور أعلاه ، تسهر النيابة العامة على تحصيل المبلغ الواجب دفعه للخزينة العمومية كاملا وبدون أجل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_762_permission_0_a58555e2> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_762_right_0_674a188c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_762> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_762_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_762_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_762_20250803_OpEnact_b6a9df9997> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_762_obligation_0_17ea7939> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 762" ;
    dzdoc:position 760 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_762_condition_0_e167a20e> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_774> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_3> ;
    dzdoc:eId "art_774" ;
    dzdoc:fullText "يجوز أن ينفذ الإكراه البدني من جديد على المدين الذي لم ينفذ الالتزامات التي أدت إلى إيقاف تنفيذ الإكراه البدني عليه وذلك بالنسبة لمقدار المبالغ الباقية في ذمته."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_774_permission_0_9ab7f3dd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_774> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_774_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_774_20250803_OpEnact_6983115351> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "774" ;
    dzdoc:position 772 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_774_condition_0_b39126d1> ;
    dzdoc:usesTerm dzterm:bodily_coercion .

<https://legal.dz/resource/law/2025-08-03/25-14#art_775> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_3> ;
    dzdoc:eId "art_775" ;
    dzdoc:fullText "إذا ما انتهى الإكراه البدني لأي سبب كان، باستثناء الحالة المنصوص عليها في المادة 774 أعلاه ، فلا يجوز مباشرته بعد ذلك لا من أجل الدين نفسه ولا من أجل أحكام لاحقة لتنفيذه ما لم تكن هذه الأحكام تستلزم بسبب مجموع مبالغها مدة إكراه أطول من المدة التي تم تنفيذها على المحكوم عليه ، و في هذه الحالة يتعين دائما إسقاط مدة الحبس الأول من الإكراه الجديد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_775_permission_0_59ae6754> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_775> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_775_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_775_20250803_OpEnact_535725decd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_775_obligation_0_766fdc8e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "775" ;
    dzdoc:position 773 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_774> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_774> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_775_condition_0_f0771dc8>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_775_condition_1_7de385f6> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "إذا حدث أثناء التحري في جريمة متلبس بها أو تحقيق متعلق بإحدى الجرائم المذكورة في المادة 78 الفقرة (3) أعلاه، إن كان الشخص الذي يتم تفتيش مسكنه موقوفا للنظر أو محبوسا في مكان آخر و أن الحال يقتضي عدم نقله إلى ذلك المكان بسبب مخاطر جسيمة قد تمس بالنظام العام أو لاحتمال فراره، أو اختفاء الأدلة خلال المدة اللازمة لنقله ، يمكن أن يجرى التفتيش بعد الموافقة المكتوبة المسبقة من وكيل الجمهورية أو قاضي التحقيق وبحضور شاهدين (2) مسخرين طبقا لأحكام المادة 76 أعلاه، أو بحضور ممثل يعينه صاحب المسكن محل التفتيش."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_79_permission_0_3a9574ae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_79_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_79_20250803_OpEnact_b8f01ee8cf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 79" ;
    dzdoc:position 78 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_76>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_78> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_76>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_78> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_79_condition_0_e3d58a69> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_798> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_1> ;
    dzdoc:eId "art_798" ;
    dzdoc:fullText "يمكن كل شخص أن يحاط علما بالبيانات المدونة في القسيمة رقم 2 من صحيفة سوابقه القضائية بناء على طلب يوجه إلى النائب العام أو إلى وكيل الجمهورية لأي جهة قضائية أو إلى القاضي المكلف بالمصلحة المركزية لصحيفة السوابق القضائية، إذا كان المعني مولودا بالخارج . لا يقوم هذا العلم مقام تبليغ الأحكام والقرارات القضائية ولا لحساب أجال الطعن. لا تسلم، بأي حال من الأحوال، للمعني نسخة من القسيمة رقم 2 ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_798_permission_0_74383fff> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_798_right_0_6e6dc424> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_798> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_798_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_798_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_798_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_798_20250803_OpEnact_25ac5d3756> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_798_obligation_0_ee628176> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "798" ;
    dzdoc:position 796 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_798_condition_0_8134cd7d> ;
    dzdoc:usesTerm dzterm:bulletin_no2,
        dzterm:prosecutor_general,
        dzterm:republic_prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_801> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_1> ;
    dzdoc:eId "art_801" ;
    dzdoc:fullText "ليس لغير الشخص الذي تخصه القسيمة رقم 3 أن يطلب نسخة منها ولا تسلم إليه إلا بعد التحقق من هويته . ولا تسلم إلى الغير إلا بوكالة خاصة . إذا كان الشخص متواجدا بالخارج تسلم له عبر مركز دبلوماسي أو قنصلي. ويمكن أيضا الحصول على القسيمة رقم 3 إلكترونيا ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_801_right_0_07d117c3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_801> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_801_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_801_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_801_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_801_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_801_20250803_OpEnact_a86233b9eb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "801" ;
    dzdoc:position 799 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_801_condition_0_d12634ae>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_801_condition_1_2c876dd4>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_801_condition_2_cc73ae64> ;
    dzdoc:usesTerm dzterm:bulletin_no3 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_875> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_1_sec_2> ;
    dzdoc:eId "art_875" ;
    dzdoc:fullText "يجوز أن يفرج عن الشخص الذي قبض عليه مؤقتا وفقا للشروط المنصوص عليها في المادة 867 أعلاه، إذا لم تتلق الحكومة الجزائرية المستندات الواردة في المادة 864 أعلاه ، خلال خمسة وأربعين (45) يوما من تاريخ إلقاء القبض عليه . ويتقرر الإفراج بناء على عريضة توجه إلى المحكمة العليا التي تفصل فيها خلال ثمانية (8) أيام بقرار لا يقبل الطعن فيه، و إذا وصلت المستندات المشار إليها أعلاه بعد ذلك إلى الحكومة الجزائرية ، فتستأنف الإجراءات طبقا للمواد 865 وما يليها من هذا القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_875_permission_0_dd02789d> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_875_right_0_f82ef8e8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_875> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_875_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_875_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_875_20250803_OpEnact_7e7f250e63> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "875" ;
    dzdoc:position 873 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_864>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_865>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_867> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_864>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_865>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_867> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_875_condition_0_db41764e>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_875_condition_1_baf18f58> ;
    dzdoc:usesTerm dzterm:supreme_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_880> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_1_sec_3> ;
    dzdoc:eId "art_880" ;
    dzdoc:fullText "إذا حصلت الحكومة الجزائرية على تسليم شخص أجنبي ثم طلبت حكومة أخرى بدورها من الحكومة الجزائرية تسليمها نفس الشخص بسبب فعل سابق على التسليم ويغاير ذلك الذي يحاكم من أجله في الجزائر وغير مرتبط به فإن الحكومة لا توافق على طلب التسليم المذكور إذا كان له محل إلا بعد التأكد من موافقة الدولة التي كانت قد وافقت على التسليم . ومع ذلك، فإن الموافقة المنصوص عليها في الفقرة السابقة لا تكون واجبة إذا كان في إمكان الشخص المسلم مغادرة الأراضي الجزائرية خلال الأجل المحد دد في المادة 879 أعلاه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_880> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_880_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_880_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_880_20250803_OpEnact_98690cf4b9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_880_obligation_0_fe9958ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "880" ;
    dzdoc:position 878 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_879> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_879> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_880_condition_0_455e9efb>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_880_condition_1_da69eef6> ;
    dzdoc:usesTerm dzterm:government .

