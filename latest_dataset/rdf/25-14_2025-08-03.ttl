<https://legal.dz/resource/law/2025-08-03/25-14#version_art_221> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتشكل اللجنة المذكورة في المادة 220 أعلاه، من : الرئيس الأول للمحكمة العليا أو ممثله، رئيسا، قاضيي (2) حكم لدى نفس المحكمة بدرجة رئيس غرفة أو رئيس قسم أو مستشار ، عضوين. يعين أعضاء اللجنة سنويا من طرف مكتب المحكمة العليا ، كما يعين هذا الأخير ثلاثة (3) أعضاء احتياطيين لاستخلاف الأعضاء الأصليين عند حدوث مانع. ويمكن المكتب أن يقرر ، حسب نفس الشروط ، أن تضم اللجنة عدة تشكيلات"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_221_20250803_OpEnact_947261b45c> ;
    dzdoc:replacementText "تتشكل اللجنة المذكورة في المادة 220 أعلاه، من : الرئيس الأول للمحكمة العليا أو ممثله، رئيسا، قاضيي (2) حكم لدى نفس المحكمة بدرجة رئيس غرفة أو رئيس قسم أو مستشار ، عضوين. يعين أعضاء اللجنة سنويا من طرف مكتب المحكمة العليا ، كما يعين هذا الأخير ثلاثة (3) أعضاء احتياطيين لاستخلاف الأعضاء الأصليين عند حدوث مانع. ويمكن المكتب أن يقرر ، حسب نفس الشروط ، أن تضم اللجنة عدة تشكيلات"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_221> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_221> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
