<https://legal.dz/resource/law/2025-08-03/25-14#art_107_obligation_2_10efbb6f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
