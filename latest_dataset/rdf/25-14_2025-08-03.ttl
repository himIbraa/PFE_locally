<https://legal.dz/resource/law/2025-08-03/25-14#art_668_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_668> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يجوز للنيابة العامة الطعن إلا ضد الأحكام والقرارات الفاصلة في الدعوى العمومية، خلال الأجل المنصوص عليه في المادة 654 وفقا لأحكام المواد 651 و 652 و 653 من هذا القانون."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_668_para_1> a dzdoc:Paragraph ;
