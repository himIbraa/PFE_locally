<https://legal.dz/resource/law/2025-08-03/25-14#version_art_340> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "دون الإخلال بأحكام المادتين 337 و 338 أعلاه، يمارس وكيل الجمهورية لدى القطب الجزائي الوطني لمكافحة الجرائم المتصلة بتكنولوجيات الإعلام والاتصال و قاضي التحقيق ورئيس ذات القطب، اختصاصا مشترکا مع الاختصاص الناتج عن تطبيق المواد 58 و 70 و 468 من هذا القانون، بالنسبة للجرائم المتصلة بتكنولوجيات الإعلام والاتصال والجرائم المرتبطة بها. تطبق في هذه الحالة الإجراءات المنصوص عليها في المواد من 317 إلى 329 من هذا القانون، أمام القطب الجزائي الوطني لمكافحة الجرائم المتصلة بتكنولوجيات الإعلام والاتصال."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_340_20250803_OpEnact_a798a76cba> ;
    dzdoc:replacementText "دون الإخلال بأحكام المادتين 337 و 338 أعلاه، يمارس وكيل الجمهورية لدى القطب الجزائي الوطني لمكافحة الجرائم المتصلة بتكنولوجيات الإعلام والاتصال و قاضي التحقيق ورئيس ذات القطب، اختصاصا مشترکا مع الاختصاص الناتج عن تطبيق المواد 58 و 70 و 468 من هذا القانون، بالنسبة للجرائم المتصلة بتكنولوجيات الإعلام والاتصال والجرائم المرتبطة بها. تطبق في هذه الحالة الإجراءات المنصوص عليها في المواد من 317 إلى 329 من هذا القانون، أمام القطب الجزائي الوطني لمكافحة الجرائم المتصلة بتكنولوجيات الإعلام والاتصال."@ar ;
