    dznorm:sourceArticle "art_68" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_68_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_68> ;
    dzdoc:position 0 ;
    dzdoc:text "يتعرض للعقوبات المقررة للجريمة المنصوص عليها في المطة الثانية من المادة 147 من قانون العقوبات، الشخص الذي يمتنع عمدا عن تنفيذ اتفاق الوساطة عند انقضاء الأجل المحدد لذلك."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_690_condition_0_ea2bdcee> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2025-08-03/25-14#art_690_condition_0_ea2bdcee_ref_4f20dab9603b> ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_664> ;
