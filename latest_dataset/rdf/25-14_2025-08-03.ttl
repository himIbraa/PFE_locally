    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_296> ;
    dznorm:position 0 ;
    dznorm:provisionText "يوقع على قرارات غرفة الاتهام من الرئيس وأمين الضبط وتذكر بها أسماء الأعضاء والإشارة إلى إيداع المستندات والمذكرات و إلى تلاوة التقرير وإلى طلبات النيابة العامة"@ar ;
    dznorm:sourceArticle "art_296" .

