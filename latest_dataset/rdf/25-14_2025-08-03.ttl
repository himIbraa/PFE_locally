<https://legal.dz/resource/law/2025-08-03/25-14#version_art_279> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسمح للخصوم ومحاميهم إلى اليوم المحدد للجلسة، بتقديم مذكرات يطلعون عليها النيابة العامة والخصوم الآخرين ، و تودع هذه المذكرات لدى أمانة ضبط غرفة الاتهام، ويؤشر عليها أمين الضبط مع ذكر يوم وساعة الإيداع ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_279_20250803_OpEnact_56adf2e2eb> ;
    dzdoc:replacementText "يسمح للخصوم ومحاميهم إلى اليوم المحدد للجلسة، بتقديم مذكرات يطلعون عليها النيابة العامة والخصوم الآخرين ، و تودع هذه المذكرات لدى أمانة ضبط غرفة الاتهام، ويؤشر عليها أمين الضبط مع ذكر يوم وساعة الإيداع ."@ar ;
