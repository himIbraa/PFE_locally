    dznorm:provisionText "يحيل هذا الأخير ، فورا ، النسخة الثانية إلى وكيل الجمهورية لدى القطب القضائي المتخصص"@ar ;
    dznorm:sourceArticle "art_311" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_311_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_311> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما يتعلق الأمر بإحدى الجرائم المنصوص عليها في المادة 310 أعلاه، يخبر ضباط الشرطة القضائية فورا وكيل الجمهورية لدى المحكمة المختصة إقليميا ، ويرسلون له الأصل و نسختين (2) من إجراءات التحقيق، ويحيل هذا الأخير ، فورا ، النسخة الثانية إلى وكيل الجمهورية لدى القطب القضائي المتخصص."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_312_obligation_0_bb835d0e_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/law/2025-08-03/25-14#art_312_obligation_0_bb835d0e> ;
    dznorm:conditionText "إذا اعتبر أن الجريمة تدخل ضمن اختصاص القطب القضائي المتخصص"@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_312_obligation_1_ee999c0f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_312> ;
    dznorm:position 1 ;
    dznorm:provisionText "يتلقى ضباط الشرطة القضائية العاملون بدائرة اختصاص هذا القطب التعليمات مباشرة من وكيل الجمهورية لدى القطب القضائي المتخصص"@ar ;
    dznorm:sourceArticle "art_312" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_312_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_312> ;
    dzdoc:position 0 ;
    dzdoc:text "يطالب وكيل الجمهورية لدى القطب القضائي المتخصص، بعد أخذ رأي النائب العام، بالإجراءات فورا إذا اعتبر أن الجريمة تدخل ضمن اختصاص القطب القضائي المتخصص ، و في هذه الحالة، يتلقى ضباط الشرطة القضائية العاملون بدائرة اختصاص هذا القطب التعليمات مباشرة من وكيل الجمهورية لدى القطب القضائي المتخصص."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_313_condition_0_66591911> a dznorm:Condition ;
    dznorm:conditionText "و في حالة فتح تحقيق قضائي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_313> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_313_obligation_0_698d200f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
