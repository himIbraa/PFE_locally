<https://legal.dz/resource/law/2025-08-03/25-14#version_art_38> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لكل وال ، في حالة وقوع جناية أو جنحة ضد أمن الدولة وعند الاستعجال فحسب، إذا لم يكن قد وصل إلى علمه أن السلطة القضائية قد أخطرت بالحادث ، أن يقوم بنفسه باتخاذ جميع الإجراءات الضرورية لإثبات الجنايات أو الجنح الموضحة آنفا، أو يكلف بذلك، كتابة ، ضباط الشرطة القضائية المختصين. وإذا استعمل الوالي هذا الحق المخول له ، فإنه يتعين عليه أن يقوم فورا بتبليغ وكيل الجمهورية خلال 48 ساعة التالية لبدء هذه الإجراءات، وأن يتخلى عنها للسلطة القضائية، ويرسل الأوراق ل وكيل الجمهورية ويقدم له جميع الأشخاص المض"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_38_20250803_OpEnact_d9af6c7b8f> ;
    dzdoc:replacementText "يجوز لكل وال ، في حالة وقوع جناية أو جنحة ضد أمن الدولة وعند الاستعجال فحسب، إذا لم يكن قد وصل إلى علمه أن السلطة القضائية قد أخطرت بالحادث ، أن يقوم بنفسه باتخاذ جميع الإجراءات الضرورية لإثبات الجنايات أو الجنح الموضحة آنفا، أو يكلف بذلك، كتابة ، ضباط الشرطة القضائية المختصين. وإذا استعمل الوالي هذا الحق المخول له ، فإنه يتعين عليه أن يقوم فورا بتبليغ وكيل الجمهورية خلال 48 ساعة التالية لبدء هذه الإجراءات، وأن يتخلى عنها للسلطة القضائية، ويرسل الأوراق ل وكيل الجمهورية ويقدم له جميع الأشخاص المضبوطين . يتعين على كل ضابط من ضباط الشرطة القضائية تلقى تسخيرات من الوالي ، حال قيامه بالعمل بموجب الأحكام السابقة، وعلى كل موظف بلغ بحصول الإخطار طبقا للأحكام ذاتها، أن ينفذ هذه التسخيرات وأن يخطر بغير تأخير وكيل الجمهورية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_38> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_38> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

