    dznorm:conditionText "إذا لم يمكن العثور على نسخة رسمية من الحكم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_705> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_705_condition_1_c1efe112_action_8541a17317> a dznorm:Action ;
