<https://legal.dz/resource/law/2025-08-03/25-14#version_art_503> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا ما انتهى التحقيق بالجلسة ، سمعت أقوال الضحية والمدعي المدني في طلباته والتماسات النيابة العامة ودفاع المتهم، وعند الاقتضاء ، أقوال المسؤول عن الحقوق المدنية. يحق للضحية و للمدعي المدني والنيابة العامة الرد على دفاع باقي الخصوم . ويكون المتهم أو محاميه آخر من يتكلم دائما ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_503_20250803_OpEnact_38e760c0f0> ;
    dzdoc:replacementText "إذا ما انتهى التحقيق بالجلسة ، سمعت أقوال الضحية والمدعي المدني في طلباته والتماسات النيابة العامة ودفاع المتهم، وعند الاقتضاء ، أقوال المسؤول عن الحقوق المدنية. يحق للضحية و للمدعي المدني والنيابة العامة الرد على دفاع باقي الخصوم . ويكون المتهم أو محاميه آخر من يتكلم دائما ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_503> ;
