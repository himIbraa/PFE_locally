<https://legal.dz/resource/law/2025-08-03/25-14#version_art_521> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تصفى المصاريف والرسوم بالحكم، و يجوز لكل ذي مصلحة في حالة عدم وجود قرار بتطبيق المواد 517 وما يليها من هذا القانون أو وجود صعوبات في تنفيذ حكم الإدانة بالمصاريف والرسوم أن يرفع الأمر إلى الجهة القضائية التي أصدرت الحكم في الموضوع ، وذلك وفقا للقواعد المقررة في مادة إشكالات التنفيذ، لكي تستكمل حكمها في هذه النقطة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_521_20250803_OpEnact_aa16c71dcb> ;
    dzdoc:replacementText "تصفى المصاريف والرسوم بالحكم، و يجوز لكل ذي مصلحة في حالة عدم وجود قرار بتطبيق المواد 517 وما يليها من هذا القانون أو وجود صعوبات في تنفيذ حكم الإدانة بالمصاريف والرسوم أن يرفع الأمر إلى الجهة القضائية التي أصدرت الحكم في الموضوع ، وذلك وفقا للقواعد المقررة في مادة إشكالات التنفيذ، لكي تستكمل حكمها في هذه النقطة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_521> ;
