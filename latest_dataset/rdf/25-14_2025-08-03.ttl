    skos:prefLabel "الجنحة"@ar,
        "جنحة"@ar .

dzterm:new_evidence a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "وتعد أدلة جديدة ، أقوال الشهود والأوراق والمحاضر التي لم يمكن عرضها على قاضي التحقيق لتمحيصها، مع أن من شأنها تعزيز الأدلة التي سبق أن وجدها ضعيفة أو أن من شأنها أن تعطي الوقائع تطورات نافعة لإظهار الحقيقة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_271_defocc_fd9ef01b74b8> .

dzterm:police_judiciaire_mission a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "ويناط بالشرطة القضائية مهمة البحث والتحري عن الجرائم المقررة في التشريع الجزائي وجمع الأدلة عنها والبحث عن مرتكبيها والمساهمين فيها مادام لم يبدأ فيها تحقيق قضائي"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_20_defocc_50105087a7ff> .

dzterm:president_of_judicial_council a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "رئيس المجلس القضائي"@ar .

dzterm:provisional_detention a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الحبس المؤقت"@ar .

dzterm:rehabilitation_effect a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يمحو رد الاعتبار في المستقبل كل آثار العقوبة وما نجم عنها من حرمان الأهليات"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_835_defocc_09cd971c7e2b> .

dzterm:remote_visual_conversation a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المحادثة المرئية عن بعد"@ar .

dzterm:specialized_judicial_poles a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الأقطاب القضائية المتخصصة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_310_defocc_e35d138edd8e> .

dzterm:statute_of_limitations_felony a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تتقادم الدعوى العمومية في مواد الجنايات بانقضاء خمس عشرة (15) سنة كاملة تسري من يوم اقتراف الجريمة إذا لم يتخذ في تلك الفترة أي إجراء من إجراءات البحث والتحري أو إجراءات مباشرة الدعوى العمومية أو إجراءات التحقيق القضائي أو المحاكمة، ما لم يقرر القانون مددا أخرى"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_10_defocc_69e4724a4c11> .

dzterm:statute_of_limitations_misdemeanor a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تتقادم الدعوى العمومية في مواد الجنح بمرور خمس (5) سنوات كاملة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_11_defocc_5889f1b9bf77> .

dzterm:territorial_crime a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تعد مرتكبة في الإقليم الوطني، كل جريمة يكون عمل من الأعمال المميزة لأحد أركانها المكونة لها قد تم في الجزائر"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_748_defocc_ef0141a1f71a> .

dzterm:wali a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوالي"@ar,
        "الولاة"@ar,
        "وال"@ar .

dzterm:witnesses a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الشهود"@ar .

