<https://legal.dz/resource/law/2025-08-03/25-14#version_art_505> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يصدر الحكم في جلسة علنية في الجلسة نفسها التي سمعت ، فيها المرافعات أو في جلسة لاحقة. و في الحالة الأخيرة، يخبر الرئيس أطراف الدعوى الحاضرين باليوم الذي سينطق فيه بالحكم و أن هذا الأخير يصدر حضوريا في مواجهتهم حتى وإن تخلفوا عن الحضور."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_505_20250803_OpEnact_d6a24e13f4> ;
    dzdoc:replacementText "يجب أن يصدر الحكم في جلسة علنية في الجلسة نفسها التي سمعت ، فيها المرافعات أو في جلسة لاحقة. و في الحالة الأخيرة، يخبر الرئيس أطراف الدعوى الحاضرين باليوم الذي سينطق فيه بالحكم و أن هذا الأخير يصدر حضوريا في مواجهتهم حتى وإن تخلفوا عن الحضور."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_505> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_505> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
