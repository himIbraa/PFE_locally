<https://legal.dz/resource/law/2025-08-03/25-14#art_500_obligation_0_7520624e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_500> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتعين استدعاء المتهم لحضورها"@ar ;
    dznorm:sourceArticle "art_500" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_500_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_500> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كانت حالة المتهم الصحية لا تمكنه من الحضور أمام المحكمة ووجدت أسباب خطيرة لعدم تأجيل القضية أو إذا اقتضى حسن العدالة الفصل فيها، أمرت المحكمة، بقرار خاص و مسبب باستجوابه بحضور محاميه، بمسكنه أو بالمؤسسة الاستشفائية المتواجد بها أو بالمؤسسة العقابية التي يكون محبوسا بها، وذلك بواسطة قاض منتدب لهذا الغرض مصحوبا بأمين ضبط."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_500_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_500> ;
    dzdoc:position 1 ;
    dzdoc:text "ويحرر محضرا بهذا الاستجواب الذي تأمر به المحكمة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_500_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_500> ;
    dzdoc:position 2 ;
    dzdoc:text "وتؤجل القضية بتاريخ محدد لأقرب جلسة مناسبة، ويتعين استدعاء المتهم لحضورها."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_500_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_500> ;
    dzdoc:position 3 ;
    dzdoc:text "و في جميع هذه الأحوال، يكون الحكم على المتهم حضوريا."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_500_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_500> ;
    dzdoc:position 4 ;
    dzdoc:text "ويجوز أن يوكل عنه محاميا يمثله."@ar .

