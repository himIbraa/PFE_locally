<https://legal.dz/resource/law/2025-08-03/25-14#version_art_397> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للقاضي الذي سبق له النظر في قضية، بوصفه قاضيا للتحقيق أو الحكم أو عضوا بغرفة الاتهام أو ممثلا للنيابة العامة، أن يجلس للفصل فيها بمحكمة الجنايات . كما لا يجوز لمحلف سبق له أن شارك في الفصل في القضية أن يجلس للفصل فيها من جديد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_397_20250803_OpEnact_cfc6d0e29e> ;
    dzdoc:replacementText "لا يجوز للقاضي الذي سبق له النظر في قضية، بوصفه قاضيا للتحقيق أو الحكم أو عضوا بغرفة الاتهام أو ممثلا للنيابة العامة، أن يجلس للفصل فيها بمحكمة الجنايات . كما لا يجوز لمحلف سبق له أن شارك في الفصل في القضية أن يجلس للفصل فيها من جديد ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_397> ;
