<https://legal.dz/resource/law/2025-08-03/25-14#art_132> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_6> ;
    dzdoc:eId "art_132" ;
    dzdoc:fullText "تتمثل تدابير الحماية الإجرائية للشخص المستفيد منها فيما يأتي: عدم الإشارة لهويته أو ذكر هوية مستعارة في أوراق الإجراءات، عدم الإشارة لعنوانه الحقيقي في أوراق الإجراءات، الإشارة، بدلا من عنوانه الحقيقي، إلى مقر الشرطة القضائية المختصة أين تم سماعه أو إلى الجهة القضائية التي سيؤول إليها النظر في القضية. تحفظ الهوية والعنوان الحقيقيان للأشخاص المذكورين في هذا الفصل المستفيدين من تدابير الحماية الإجرائية في ملف خاص يمسكه وكيل الجمهورية . يتلقى المعني التكاليف بالحضور عن طريق النيابة العامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_132> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_132_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_132_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_132_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_132_20250803_OpEnact_d29de8fe50> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_132_obligation_0_c7c2ac43> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "132" ;
    dzdoc:position 131 ;
    dzdoc:usesTerm dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_156> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_3> ;
    dzdoc:eId "art_156" ;
    dzdoc:fullText "يجوز ل قاضي التحقيق أن ينتقل رفقة أمين الضبط ، بعد إخطار وكيل الجمهورية بمحكمته، إلى دوائراختصاص المحاكم المجاورة للدائرة التي يباشر فيها وظيفته للقيام بجميع إجراءات التحقيق إذا ما استلزمت ضرورات التحقيق ذلك ، على أن يخطر مقدما وكيل الجمهورية بالمحكمة التي سينتقل إلى دائر تها ، و ينوه في محضره عن الأسباب التي دعت إلى انتقاله ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_156_permission_0_d0cc40b8> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_156_right_0_6063d7a5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_156> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_156_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_156_20250803_OpEnact_8fcc6b75da> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_156_obligation_0_ddb03644>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_156_obligation_1_90c9ca7c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "156" ;
    dzdoc:position 155 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_156_condition_0_24f172e9> ;
    dzdoc:usesTerm dzterm:clerk,
        dzterm:investigating_judge,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_166> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_4> ;
    dzdoc:eId "art_166" ;
    dzdoc:fullText """يجوز لقاضي التحقيق استدعاء مترجم غير أمين الضبط ، والشهود. إذا لم يكن المترجم قد سبق له أن أدى اليمين ، فإنه يحلف بالصيغة الآتية :
                "أقسم بالله العظيم وأتعهد بأن أترجم بإخلاص الأقوال التي تلفظ أو تتبادل بين الأشخاص معبرة بلغات مختلفة"."""@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_166_permission_0_c3461e28> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_166> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_166_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_166_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_166_20250803_OpEnact_72973c8eee> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 166" ;
    dzdoc:position 165 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_166_condition_0_9030983b> ;
    dzdoc:usesTerm dzterm:clerk .

<https://legal.dz/resource/law/2025-08-03/25-14#art_168> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_4> ;
    dzdoc:eId "art_168" ;
    dzdoc:fullText """يطلب من الشهود ، قبل سماع شهادتهم عن الوقائع ، أن يذكر كل منهم اسمه ولقبه وعمره وحالته ومهنته وسكنه و إن كانت له قرابة أو نسب مع الخصوم أو ملحق بخدمتهم أو كان فاقدا للأهلية وينوه في المحضر عن هذه الأسئلة والأجوبة. ويؤدي اليمين ، كل شاهد ويده اليمنى مرفوعة بالصيغة الآتية :
                "أقسم بالله العظيم أن أتكلم بغير حقد ولا خوف وأن أقول كل الحق ولا شيء غير الحق". وتسمع شهادة الأطفال إلى سن السادسة عشر (16) بغير حلف اليمين."""@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_168> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_168_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_168_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_168_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_168_20250803_OpEnact_f08709c55d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_168_obligation_0_d1739bfa> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 168" ;
    dzdoc:position 167 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_200> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_7> ;
    dzdoc:eId "art_200" ;
    dzdoc:fullText "تدخل الرقابة القضائية حيز التطبيق ابتداء من التاريخ المحدد في الأمر أو القرار الصادر عن جهة التحقيق، وتنتهي بقوة القانون بأمر أو قرار نهائي بألا وجه لإقامة الدعوى، و في حالة إحالة المتهم أمام جهة الحكم تبقى الرقابة القضائية قائمة إلى أن ترفعه الجهة القضائية المعنية. وفي حالة ما إذا أجلت الحكم في القضية إلى جلسة أخرى أو أمرت بتكملة التحقيق ، يمكن هذه الأخيرة إبقاء المتهم أو الأمر بوضعه تحت الرقابة القضائية . يجب على جهة الحكم التصدي للرقابة القضائية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_200_permission_0_ec731493> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_200> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_200_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_200_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_200_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_200_20250803_OpEnact_ef588c5d8c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_200_obligation_0_dd0d716b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "200" ;
    dzdoc:position 199 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_200_condition_0_f1071bed> ;
    dzdoc:usesTerm dzterm:accused,
        dzterm:judicial_control .

<https://legal.dz/resource/law/2025-08-03/25-14#art_213> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_7> ;
    dzdoc:eId "art_213" ;
    dzdoc:fullText "يجوز أن يكون الإفراج لأجنبي مشروطا بتقديم كفالة، وذلك في جميع الحالات التي لا يكون فيها الإفراج بقوة القانون. وهذه الكفالة تضمن : مثول المتهم في جميع إجراءات الدعوى لتنفيذ الحكم، أداء ما يلزم حسب الترتيب الآتي بيانه: أ) المصاريف التي سبق أن قام بدفعها الضحية أو المدعي المدني، ب) المصاريف التي أنفقها القائم بالدعوى العمومية، ج) الغرامات، د) المبالغ المحكوم بردها، ه) التعويضات المدنية. ويحدد قرار الإفراج المبلغ المخصص لكل جزء من جزءي (2) الكفالة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_213_permission_0_600675ef> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_213> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_213_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_213_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_213_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_213_20250803_OpEnact_431addb47f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "213" ;
    dzdoc:position 212 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_216> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_7> ;
    dzdoc:eId "art_216" ;
    dzdoc:fullText "يرد دائما الجزء الثاني من مبلغ الكفالة إلى المتهم إذا صدر أمر نهائي أو قرار بألا وجه للمتابعة أو حكم نهائي بالإعفاء من العقوبة أو بالبراءة. أما إذا صدر ضده حكم نهائي بالإدانة، فيخصص ذلك الجزء لسداد المصاريف وأداء الغرامة ورد المحكوم برده و دفع التعويضات المدنية المقررة للمدعي المدني بالترتيب الموضح ب المادة 213 أعلاه. ويرد الباقي من مبلغ الكفالة للمتهم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_216_right_0_07a129db> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_216> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_216_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_216_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_216_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_216_20250803_OpEnact_e0f51b4243> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "216" ;
    dzdoc:position 215 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_213> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_213> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_226> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_8> ;
    dzdoc:eId "art_226" ;
    dzdoc:fullText "يبلغ أمين اللجنة المدعي بمذكرات الوكيل القضائي للخزينة بموجب رسالة موصى عليها مع إشعار بالاستلام في أجل أقصاه عشرون (20) يوما، ابتداء من تاريخ إيداعها . يسلم المدعي أو يوجه لأمانة اللجنة ردوده في أجل أقصاه ثلاثون (30) يوما، ابتداء من تاريخ التبليغ المذكور في الفقرة الأولى أعلاه . عند انقضاء الأجل المنصوص عليه في الفقرة 2 أعلاه ، يقوم أمين اللجنة بإرسال الملف إلى النائب العام لدى المحكمة العليا الذي يودع مذكراته في الشهر الموالي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_226> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_226_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_226_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_226_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_226_20250803_OpEnact_71e8f2eb98> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_226_obligation_0_87868347>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_226_obligation_1_eb155b75>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_226_obligation_2_0b056ee6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 226" ;
    dzdoc:position 225 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_226_condition_0_87e0674c> ;
    dzdoc:usesTerm dzterm:judicial_agent,
        dzterm:plaintiff,
        dzterm:prosecutor_general,
        dzterm:secretary .

<https://legal.dz/resource/law/2025-08-03/25-14#art_254> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_11> ;
    dzdoc:eId "art_254" ;
    dzdoc:fullText "إذا تراءى لقاضي التحقيق أن إجراء من إجراءات التحقيق مشوب بالبطلان ، فعليه أن يرفع الأمر لغرفة الاتهام بالمجلس القضائي بطلب إبطال هذا الإجراء بعد استطلاع رأي وكيل الجمهورية وإخطار المتهم والضحية والمدعي المدني . فإذا تبين لوكيل الجمهورية أن بطلانا قد وقع فإنه يطلب إلى قاضي التحقيق أن يوافيه بملف الدعوى ليرسله إلى غرفة الاتهام، ويرفع لها طلبا بالبطلان . و في كلتا الحالتين ، تتخذ غرفة الاتهام إجراءها وفق ما ورد في المادة 287 أدناه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_254> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_254_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_254_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_254_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_254_20250803_OpEnact_00cfd04ff6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_254_obligation_0_887bb4c9>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_254_obligation_1_602f8dd0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "254" ;
    dzdoc:position 253 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_287> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_287> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_254_condition_0_666a9178>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_254_condition_1_021efb0e> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_262> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_12> ;
    dzdoc:eId "art_262" ;
    dzdoc:fullText "إذا رأى قاضي التحقيق أن الوقائع تكون جريمة وصفها القانوني جناية يأمر بإرسال ملف الدعوى وقائمة بأدلة الإثبات بمعرفة وكيل الجمهورية ، بغير تمهل، إلى النائب العام لدى المجلس القضائي لاتخاذ الإجراءات وفقا لماهو مقرر في الفصل الخاص بغرفة الاتهام. يستمر أمر الإيداع أو القبض الصادر عن جهة التحقيق منتجا لأثره إلى حين الفصل في القضية من طرف الجهة المحال عليها، أو القضاء بألا وجه للمتابعة من طرف غرفة الاتهام، ما لم يفرج عن المتهم قبل ذلك. ويحتفظ بأدلة الإثبات لدى أمانة ضبط المحكمة إن لم يقرر خلاف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_262> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_262_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_262_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_262_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_262_20250803_OpEnact_b5333d27c4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "262" ;
    dzdoc:position 261 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_262_condition_0_97d139fa> ;
    dzdoc:usesTerm dzterm:attorney_general,
        dzterm:investigating_judge,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_283> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_283" ;
    dzdoc:fullText "يجوز لغرفة الاتهام أن تأمر، من تلقاء نفسها أو بناء على طلبات النائب العام، بإجراء تحقيقات بالنسبة للمتهمين المحالين إليها بشأن جميع الاتهامات في الجنايات والجنح و المخالفات ، أصلية كانت أو مرتبطة بغيرها، الناتجة من ملف الدعوى والتي لا يكون قد تناول الإشارة إليها أمر الإحالة الصادر من قاضي التحقيق أو التي تكون قد استبعدت بأمر يتضمن القضاء بصفة جزئية بألا وجه للمتابعة أو بفصل جرائم بعضها عن البعض أو إحالتها إلى الجهة القضائية المختصة. ويسوغ لها إصدار قرارها دون أن تأمر بإجراء تحقيق جديد إذا كانت أوجه المتابعة المنوه عنها في الفقرة السابقة قد تناولتها أوصاف الاتهام التي أقرها قاضي التحقيق ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_283_permission_0_db15073d> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_283_right_0_1fb420b0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_283> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_283_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_283_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_283_20250803_OpEnact_525cadd7af> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "283" ;
    dzdoc:position 282 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_283_condition_0_81d97db1> ;
    dzdoc:usesTerm dzterm:investigating_judge .

<https://legal.dz/resource/law/2025-08-03/25-14#art_288> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_288" ;
    dzdoc:fullText "إذا كانت غرفة الاتهام قد فصلت في استئناف الأمر الصادر عن قاضي التحقيق في موضوع حبس المتهم مؤقتا ، فسواء أيدت الأمر أم ألغته وقررت الإفراج عن المتهم أو باستمرار حبسه أو أصدرت أمرا بإيداعه الحبس أو بالقبض عليه، فعلى النائب العام إعادة الملف، بغير تمهل، إلى قاضي التحقيق بعد العمل على تنفيذ القرار . وإذا حدث، في أي موضوع آخر، أن ألغت غرفة الاتهام أمر قاضي التحقيق ، فإن لها أن تتصدى للموضوع أو تحيل الملف إلى قاضي التحقيق نفسه أو إلى قاض غيره لمواصلة التحقيق ما لم يكن قرار الإلغاء قد أنهى التحقيق. وإذا أيدت غرفة الاتهام أمر قاضي التحقيق المستأنف ، ترتب عليه أثره كاملا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_288> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_288_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_288_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_288_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_288_20250803_OpEnact_88ade19003> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_288_obligation_0_6bd1f411> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "288" ;
    dzdoc:position 287 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_288_condition_0_1043cca3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_288_condition_1_f74a5491>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_288_condition_2_1847515b> ;
    dzdoc:usesTerm dzterm:chamber_of_accusation,
        dzterm:investigating_judge,
        dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_301> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_301" ;
    dzdoc:fullText "يراقب رئيس غرفة الاتهام الحبس المؤقت . و يتعين عليه أن يقوم بزيارة كل مؤسسة عقابية بدائرة اختصاص المجلس القضائي مرة كل ثلاثة (3) أشهر، على الأقل، لتفقد وضعية المحبوسين مؤقتا ، و إذا ما بدا له أن الحبس غير مبرر يوجه إلى قاضي التحقيق الملاحظات اللازمة لاتخاذ الإجراءات المناسبة. ويجوز لـ رئيس غرفة الاتهام أن يفوض سلطته إلى قاض من قضاة الحكم التابعين إلى غرفة الاتهام أو إلى قاض آخر بالمجلس القضائي. وفي كل الأحوال، يجوز له أن يخطر غرفة الاتهام كي تفصل في استمرار حبس متهم مؤقتا، وفقا للإجراءات المنصوص عليها في هذا الفصل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_301_permission_0_80fea6e6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_301> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_301_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_301_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_301_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_301_20250803_OpEnact_4cb4751726> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_301_obligation_0_e40f9795>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_301_obligation_1_b03087ef> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 301" ;
    dzdoc:position 300 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_301_condition_0_c77ffca3> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:president_indictment_chamber .

<https://legal.dz/resource/law/2025-08-03/25-14#art_360> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_1_sec_1> ;
    dzdoc:eId "art_360" ;
    dzdoc:fullText "يجوز للجهة القضائية، بناء على طلب النيابة العامة ، معاقبة كل شاهد يتخلف عن الحضور أو يمتنع عن حلف اليمين أو أداء الشهادة بالعقوبة المنصوص عليها في المادة 172 أعلاه. ويجوز للجهة القضائية عند تخلف شاهد عن الحضور بغير عذر تراه مقبولا ومشروعا، أن تأمر بناء على طلب النيابة العامة أو من تلقاء نفسها باستحضاره إليها، على الفور، بواسطة القوة العمومية لسماع أقواله ، أو تأجيل القضية لجلسة قريبة. و في الحالة الأخيرة، يجعل الحكم على عاتق الشاهد المتخلف مصاريف التكليف بالحضور والإجراءات والانتقال وغيرها. ويجوز للشاهد الذي حكم عليه بغرامة أو بمصاريف لعدم الحضور، أن يرفع معارضة أمام نفس الجهة القضائية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_360_permission_0_e39a9637> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_360_right_0_9ba8f128> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_360> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_360_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_360_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_360_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_360_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_360_20250803_OpEnact_9d3c1d8bf4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "360" ;
    dzdoc:position 359 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_172> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_172> ;
    dzdoc:usesTerm dzterm:prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_375> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_1_sec_1> ;
    dzdoc:eId "art_375" ;
    dzdoc:fullText "يتقدم ممثل النيابة العامة بطلباته الكتابية أو الشفوية التي يراها مناسبة لصالح العدالة. وعلى أمين ضبط الجلسة، في حالة تقديم طلبات كتابية، أن ينوه على ذلك بمذكرات الجلسة ، و يتعين على الجهة القضائية أن تجيب عليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_375> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_375_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_375_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_375_20250803_OpEnact_0f29ebee63> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_375_obligation_0_91f9d99f>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_375_obligation_1_daa0b8ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "375" ;
    dzdoc:position 374 ;
    dzdoc:usesTerm dzterm:prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_390> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_2> ;
    dzdoc:eId "art_390" ;
    dzdoc:fullText "تنعقد دورات محكمة الجنايات الابتدائية أو الاستئنافية كل ثلاثة (3) أشهر، و يجوز تمديدها بموجب أوامر إضافية ، كما يجوز، بناء على اقتراح النائب العام ، تقرير انعقاد دورة إضافية أو أكثر متى دعت الحاجة إلى ذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_390_permission_0_830f6d37> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_390_right_0_a2475f43>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_390_right_1_0d918bc9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_390> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_390_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_390_20250803_OpEnact_faac84b6b6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 390" ;
    dzdoc:position 389 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_390_condition_0_7f741ca5> ;
    dzdoc:usesTerm dzterm:criminal_court,
        dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_406> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_4> ;
    dzdoc:eId "art_406" ;
    dzdoc:fullText "يرسل النائب العام إلى أمانة ضبط محكمة الجنايات الابتدائية ملف الدعوى و أدلة الإقناع فور صدور قرار الإحالة . و في حالة الاستئناف ، يرسل ملف الدعوى وأدلة الإقناع إلى محكمة الجنايات الاستئنافية . ينقل المتهم المحبوس إلى المؤسسة العقابية الكائنة بدائرة اختصاص المحكمة ويقدم للمحاكمة في أقرب دورة جنائية . يحاكم غيابيا المتهم الذي هو في حالة فرار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_406> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_406_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_406_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_406_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_406_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_406_20250803_OpEnact_a0325a0e0f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_406_obligation_0_903c313e>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_406_obligation_1_009b1daa>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_406_obligation_2_4f117ebd>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_406_obligation_3_2c8520e0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "406" ;
    dzdoc:position 405 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_406_condition_0_aa13684f> ;
    dzdoc:usesTerm dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_443> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_6_subsec_4> ;
    dzdoc:eId "art_443" ;
    dzdoc:fullText "يأمر رئيس المحكمة رئيس الخدمة المكلف بالمحافظة على النظام بإخراج المتهم المحبوس من قاعة الجلسة، وبمراقبة المتهم غير المحبوس المتابع بجناية و عدم السماح له بمغادرة مقر المحكمة حتى صدور الحكم، وبحراسة المنافذ المؤدية إلى غرفة المداولة حتى لا يتسنى لأحد أن ينفذ إليها لأي سبب من الأسباب بدون إذن الرئيس. ويعلن الرئيس رفع الجلسة وتنسحب المحكمة إلى غرفة المداولة. و خلال المداولة ، تكون أوراق الدعوى تحت تصرف المحكمة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_443_right_0_e86e34b6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_443> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_443_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_443_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_443_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_443_20250803_OpEnact_9b3bd5688b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_443_obligation_0_8228e49d>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_443_obligation_1_0081349e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "443" ;
    dzdoc:position 442 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_443_condition_0_d5c550c8> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2025-08-03/25-14#art_448> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_7_subsec_2> ;
    dzdoc:eId "art_448" ;
    dzdoc:fullText "بعد أن ينطق رئيس محكمة الجنايات الابتدائية بالحكم، ينبه المحكوم عليه بأن له مدة عشرة (10) أيام كاملة، منذ اليوم الموالي للنطق بالحكم، للطعن فيه بالاستئناف . و في حالة الفصل على مستوى محكمة الجنايات الاستئنافية ، ينبه الرئيس المحكوم عليه بأن له مدة ثمانية (8) أيام كاملة، منذ اليوم الموالي للنطق بالحكم، للطعن فيه بالنقض . ويحكم على المدعي المدني الذي خسر دعواه بالمصاريف القضائية إذا كان هو الذي حرك الدعوى العمومية بنفسه ، غير أن لمحكمة الجنايات، تبعا لوقائع الدعوى، أن تعفيه من جميع المصاريف القضائية أو من جزء منها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_448_right_0_9f23e03c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_448> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_448_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_448_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_448_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_448_20250803_OpEnact_aacc537c4d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_448_obligation_0_5fe8925e>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_448_obligation_1_2e4182b8>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_448_obligation_2_f0d25045> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "448" ;
    dzdoc:position 447 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_448_condition_0_1b7e6eb3> ;
    dzdoc:usesTerm dzterm:criminal_court_appeal,
        dzterm:president_criminal_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_482> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_482" ;
    dzdoc:fullText "يقوم الرئيس بتنبيه المتهم أن له الحق في طلب مهلة لتحضير دفاعه ، وينوه عن هذا التنبيه وإجابة المتهم في الحكم. إذا استعمل المتهم حقه المنوه عنه في الفقرة السابقة ، منحته المحكمة مهلة ثلاثة (3) أيام على الأقل . إذا لم تكن الدعوى مهيأة للحكم ، أمرت المحكمة بتأجيلها إلى أقرب جلسة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_482_right_0_19ee6a63> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_482> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_482_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_482_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_482_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_482_20250803_OpEnact_db1f289454> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_482_obligation_0_185f5f01>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_482_obligation_1_52b5007a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 482" ;
    dzdoc:position 481 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_482_condition_0_1feffaee>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_482_condition_1_865b46b8> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_497> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_5> ;
    dzdoc:eId "art_497" ;
    dzdoc:fullText "يكون الحكم حضوريا على المتهم الطليق : الذي يجيب على نداء اسمه ويغادر باختياره قاعة الجلسة، الذي رغم حضوره بالجلسة يرفض الإجابة أو يقرر التخلف عن الحضور، الذي بعد حضوره بإحدى الجلسات الأولى يمتنع باختياره عن الحضور بالجلسات التي تؤجل إليها الدعوى أو بجلسة المحاكمة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_497> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_497_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_497_20250803_OpEnact_cbd9308e3d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "497" ;
    dzdoc:position 496 ;
    dzdoc:usesTerm dzterm:accused .

<https://legal.dz/resource/law/2025-08-03/25-14#art_501> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_5> ;
    dzdoc:eId "art_501" ;
    dzdoc:fullText "يمكن للمتهم الحاضر الاستعانة بمحام عنه . إذا لم يقم المتهم باختيار محام قبل الجلسة وطلب مع ذلك حضور محام عنه ، يعين الرئيس محاميا له تلقائيا. و يكون تعيين محام لتمثيل المتهم وجوبيا إذا كان المتهم مصابا بعاهة طبيعية تعوق دفاعه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_501_permission_0_d4d98329> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_501_right_0_5b55babb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_501> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_501_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_501_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_501_20250803_OpEnact_c8ffd92c82> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_501_obligation_0_06ca7508> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "501" ;
    dzdoc:position 500 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_501_condition_0_c829a3c9>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_501_condition_1_84025c69> ;
    dzdoc:usesTerm dzterm:accused,
        dzterm:president .

<https://legal.dz/resource/law/2025-08-03/25-14#art_505> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_6> ;
    dzdoc:eId "art_505" ;
    dzdoc:fullText "يجب أن يصدر الحكم في جلسة علنية في الجلسة نفسها التي سمعت ، فيها المرافعات أو في جلسة لاحقة. و في الحالة الأخيرة، يخبر الرئيس أطراف الدعوى الحاضرين باليوم الذي سينطق فيه بالحكم و أن هذا الأخير يصدر حضوريا في مواجهتهم حتى وإن تخلفوا عن الحضور."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_505> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_505_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_505_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_505_20250803_OpEnact_d6a24e13f4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_505_obligation_0_a3ef8574>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_505_obligation_1_42fab319> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "505" ;
    dzdoc:position 504 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2025-08-03/25-14#art_592> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_4_subsec_1> ;
    dzdoc:eId "art_592" ;
    dzdoc:fullText "إذا كان المستأنف محبوسا جاز له كذلك أن يعمل تقرير استئنافه في المواعيد المنصوص عليها في المادة 588 أعلاه لدى أمين ضبط المؤسسة العقابية ، حيث يتلقى ويقيد في الحال في سجل خاص. ويسلم إليه إيصال عنه. ويتعين على مدير المؤسسة العقابية، تحت طائلة العقوبات التأديبية، أن يرسل نسخة من هذا التقرير خلال أربع وعشرين (24) ساعة إلى أمانة ضبط الجهة القضائية التي أصدرت الحكم المطعون فيه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_592_right_0_0600e77c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_592> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_592_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_592_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_592_20250803_OpEnact_4bc310fe68> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_592_obligation_0_b3ba8aa2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "592" ;
    dzdoc:position 591 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_588> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_588> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_592_condition_0_ff544e5a> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_640> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_5_chp_1> ;
    dzdoc:eId "art_640" ;
    dzdoc:fullText "يتم استجواب المتهم غير المحبوس أو سماعه أو إجراء مواجهة بينه وبين غيره في مرحلتي التحقيق القضائي أو المحاكمة، باستعمال تقنية المحادثة المرئية عن بعد ، بمقر المحكمة الأقرب من مكان إقامته، ويتم تلقي تصريحاته بحضور أمين ضبط وبعد تحقق وكيل الجمهورية المختص إقليميا من هويته. يحرر أمين الضبط محضرا عن سير عملية استعمال المحادثة المرئية عن بعد ويوقعه ثم يرسله بمعرفة وكيل الجمهورية إلى الجهة القضائية المختصة، لإلحاقه بملف الإجراءات. تطبق نفس الإجراءات المنصوص عليها في هذه المادة عندما يتعلق الأمر بباق الأطراف والشهود والخبراء والمترجمين. كما يمكن لوكيل الجمهورية أو لقاضي التحقيق اللجوء إلى المحادثة المرئية عن بعد في حالة تمديد التوقيف للنظر وكذا في حالة القبض على المتهم خارج دائرة اختصاص جهة التحقيق أو الحكم التي أصدرت الأمر بالقبض، ويشار إلى ذلك في المحاضر المحررة في الحالتين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_640_permission_0_6d7f44ea> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_640> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_640_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_640_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_640_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_640_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_640_20250803_OpEnact_35b1bed1db> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "640" ;
    dzdoc:position 638 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_640> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_640> ;
    dzdoc:usesTerm dzterm:remote_visual_conversation .

<https://legal.dz/resource/law/2025-08-03/25-14#art_651> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_1> ;
    dzdoc:eId "art_651" ;
    dzdoc:fullText "يجوز الطعن بالنقض أمام المحكمة العليا : 1- في قرارات غرفة الإتهام الفاصلة في الموضوع أو الفاصلة في الاختصاص أو التي تتضمن مقتضيات نهائية ليس في استطاعة القاضي أن يعدلها، 2- في أحكام المحاكم وقرارات المجالس القضائية الفاصلة في الموضوع في آخر درجة في مواد الجنايات والجنح أو المقضي فيها بقرار مستقل في الاختصاص أو التي تنهي السير في الدعوى العمومية، 3- في قرارات المجالس القضائية الفاصلة في الاستئناف الذي تضرر منه الطاعن رغم عدم استئنافه، 4- في أحكام المحاكم وقرارات المجالس القضائية الفاصلة في الموضوع في آخر درجة في مواد المخالفات القاضية بعقوبة الحبس، بما فيها المشمولة بوقف التنفيذ، 5- الأحكام والقرارات الصادرة عن الجهات القضائية لتطبيق العقوبات، مع مراعاة أحكام المادة 652 (الحالة 7) أدناه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_651_permission_0_ee8c09fd> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_651_right_0_b3c9d617> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_651> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_651_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_651_20250803_OpEnact_4467f9cac1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "651" ;
    dzdoc:position 649 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_652> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_652> ;
    dzdoc:usesTerm dzterm:supreme_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_705> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_2> ;
    dzdoc:eId "art_705" ;
    dzdoc:fullText "إذا كان تقرير محكمة الجنايات لا سبيل لإعادته أو كانت القضية قد قضي فيها غيابيا أو لم يكن ثمة أي محرر كتابي ، أعيد التحقيق ابتداء من النقطة التي تبين فيها فقد الأوراق. وكذلك الشأن في جميع المواد إذا لم يمكن العثور على نسخة رسمية من الحكم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_705_permission_0_f7c5202b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_705> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_705_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_705_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_705_20250803_OpEnact_15ffd138a6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "705" ;
    dzdoc:position 703 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_705_condition_0_8ca69510>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_705_condition_1_c1efe112> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_71> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_71" ;
    dzdoc:fullText "يجوز لقاضي التحقيق ، تلقائيا أو بناء على طلب النيابة العامة وطوال مدة الإجراءات، أن يأمر باتخاذ كل إجراء تحفظي أو تدبير أمن زيادة على حجز الأموال المتحصل عليها من الجريمة أو التي استعملت في ارتكابها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_71_permission_0_3db38c0a> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_71_right_0_72898548> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_71> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_71_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_71_20250803_OpEnact_634ba858ae> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 71" ;
    dzdoc:position 70 ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:public_prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_714> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_5> ;
    dzdoc:eId "art_714" ;
    dzdoc:fullText "تبلغ العريضة المودعة لدى أمانة ضبط المحكمة العليا إلى جميع الخصوم المعنيين بالأمر ، ولهم مهلة عشرة (10) أيام لإيداع مذكرة لدى أمانة الضبط وذلك في جميع حالات الإحالة . وليس لتقديم العريضة أثر موقف مالم يؤمر بغير ذلك من المحكمة العليا ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_714_right_0_f58f9495> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_714> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_714_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_714_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_714_20250803_OpEnact_b2461c5b56> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_714_obligation_0_40815183> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "714" ;
    dzdoc:position 712 ;
    dzdoc:usesTerm dzterm:supreme_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_739> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_8> ;
    dzdoc:eId "art_739" ;
    dzdoc:fullText "إذا كان أحد ضباط الشرطة القضائية قابلا للاتهام بارتكاب جناية أو جنحة خارج دائرة مباشرة أعمال وظيفته، أو أثناء مباشرتها في الدائرة التي يختص فيها محليا ، اتخذت بشأنه الإجراءات طبقا لأحكام المادة 738 أعلاه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_739> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_739_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_739_20250803_OpEnact_ff0af1ef64> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_739_obligation_0_21660bbf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "739" ;
    dzdoc:position 737 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_738> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_738> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_739_condition_0_84c95b1a> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_800> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:definesTerm dzterm:bulletin_no3 ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_1> ;
    dzdoc:eId "art_800" ;
    dzdoc:fullText "القسيمة رقم 3 هي بيان للأحكام الصادرة من إحدى الجهات القضائية للجمهورية الجزائرية في جناية أو جنحة قضت بعقوبات مقيدة للحرية تفوق شهرا واحدا . غير أنه عندما تكون العقوبة القصوى المقررة قانونا تفوق ثلاث (3) سنوات حبسا ، تقيد بها حتى العقوبات التي تساوي أو تقل عن شهر، ما لم تأمر الجهة القضائية، تلقائيا أو بناء على طلب المعني، بعدم قيد العقوبة في القسيمة رقم 3 من صحيفة السوابق القضائية إذا ثبت لها أنه تم جبر الضرر ووضع حد للإخلال الناتج عن الجنحة . ولا تثبت في القسيمة رقم 3 إلا الأحكام المشار إليها فيما تقدم والتي لم يمحها رد الاعتبار ولم تكن مشمولة بوقف النفاذ إلا إذا صدر حكم جديد يح ماحب الشأن من الاستفادة من وقف النفاذ إذا تضمن الحكم عقوبة تكميلية بالحرمان أو بإسقاط حق أو بعدم الأهلية فإن هذه العقوبة تكميلية تسجل في القسيمة رقم 3 طيلة فترة تنفيذها، وتسجل أيضا العقوبة الأصلية مهما كانت نوعيتها نافذة أو غير نافذة. ويوضح في القسيمة صراحة أنها سلمت وفقا لأحكام هذه المادة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_800> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_800_defocc_62b145e1121f> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_800_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_800_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_800_20250803_OpEnact_d1af5a9b44> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "800" ;
    dzdoc:position 798 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_800> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_800> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_800_condition_0_fb1086e5>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_800_condition_1_510996e0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_800_condition_2_0651bae7> ;
    dzdoc:usesTerm dzterm:bulletin_no3 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_81> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_81" ;
    dzdoc:fullText "إذا اقتضى الأمر إجراء معاينات لا يمكن تأخيرها فلضابط الشرطة القضائية أن يستعين بأشخاص مؤهلين لذلك. وعلى هؤلاء الأشخاص الذين يستدعيهم لهذا الإجراء أن يؤدوا اليمين كتابة على إبداء رأيهم بما يمليه عليهم الشرف والضمير ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_81_permission_0_f1409edb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_81> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_81_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_81_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_81_20250803_OpEnact_6bd172c332> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_81_obligation_0_3ad5c616> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 81" ;
    dzdoc:position 80 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_81_condition_0_d82a5605> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_835> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:definesTerm dzterm:rehabilitation_effect ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_6> ;
    dzdoc:eId "art_835" ;
    dzdoc:fullText "يجوز رد اعتبار كل شخص طبيعي أو معنوي محكوم عليه بجناية أو بجنحة أو بمخالفة من جهة قضائية جزائرية، بحكم أو قرار نهائي حائز لقوة الشيء المقضي و يمحو رد الاعتبار في المستقبل كل آثار العقوبة وما نجم عنها من حرمان الأهليات . ويرد الاعتبار إما بقوة القانون أو بحكم قضائي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_835_permission_0_e5d511f9> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_835_right_0_f39ab922> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_835> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_835_defocc_09cd971c7e2b> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_835_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_835_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_835_20250803_OpEnact_9a2bd74ccb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "835" ;
    dzdoc:position 833 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_835_condition_0_43869ac8>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_835_condition_1_a15a6b1a> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_852> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_6_sec_2> ;
    dzdoc:eId "art_852" ;
    dzdoc:fullText "ينوه عن القرار الصادر برد الاعتبار على هامش الأحكام والقرارات الصادرة بالعقوبة بصحيفة السوابق القضائية . و في هذه الحالة ، لا ينوه عن العقوبة في القسيمتين 2 و 3 من صحيفة السوابق القضائية . ويجوز لمن يرد اعتباره أن يستلم ، بدون مصاريف، نسخة من القرار الصادر برد الاعتبار ومستخرجا من صحيفة السوابق القضائية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_852_right_0_616256b3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_852> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_852_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_852_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_852_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_852_20250803_OpEnact_875eef158c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_852_obligation_0_a75e7333>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_852_obligation_1_dd06218f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 852" ;
    dzdoc:position 850 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_852_condition_0_476f9433> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_860> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_1_sec_1> ;
    dzdoc:eId "art_860" ;
    dzdoc:fullText "لا يقبل التسليم في الحالات الآتية : إذا كان الشخص المطلوب تسليمه جزائري الجنسية والعبرة في تقدير هذه الصفة بوقت وقوع الجريمة المطلوب التسليم من أجلها، إذا كانت للجناية أو الجنحة صبغة سياسية أو إذا تبين من الظروف أن التسليم مطلوب لغرض سياسي ، إذا ارتكبت الجناية أو الجنحة في الأراضي الجزائرية ، إذا تمت متابعة الجناية أو الجنحة والحكم فيها نهائيا في الأراضي الجزائرية ولو كانت قد ارتكبت خارجها ، إذا كانت الدعوى العمومية قد سقطت بالتقادم قبل تقديم الطلب أو كانت العقوبة قد انقضت بالتقادم قبل القبض على الشخص المطلوب تسليمه ، وعلى العموم كلما انقضت الدعوى العمومية في الدولة الطالبة وذلك طبقا لقوانين الدولة الطالبة أو الدولة المطلوب منها التسليم، إذا صدر عفو في الدولة الطالبة أو الدولة المطلوب منها التسليم ، ويشترط في الحالة الأخيرة أن تكون الجريمة من عداد تلك التي كان من الجائز أن تكون موضوع متابعة في هذه الدولة إذا ارتكبت خارج إقليمها من شخص أجنبي عنها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_860> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_860_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_860_20250803_OpEnact_da95a48002> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_860_obligation_0_247034a5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "860" ;
    dzdoc:position 858 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_860_condition_0_fc4ec058>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_860_condition_1_1b177039>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_860_condition_2_43d8e3fc>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_860_condition_3_9bd5a22a>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_860_condition_4_bbe62e04>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_860_condition_5_45b4c090> ;
    dzdoc:usesTerm dzterm:public_action .

<https://legal.dz/resource/law/2025-08-03/25-14#art_884> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_2> ;
    dzdoc:eId "art_884" ;
    dzdoc:fullText "في حالة المتابعات الجزائية الواقعة في الخارج إذا رأت حكومة أجنبية أنه من الضروري تبليغ ورقة من أوراق الإجراءات أو حكم أو قرار إلى شخص مقيم في الأراضي الجزائرية ، فيرسل المستند وفقا للأوضاع المنصوص عليها في المادتين 864 و 865 أعلاه، مصحوبا بترجمة للغة الوطنية الرسمية ، عند الاقتضاء ، و يحصل التبليغ إلى الشخص بناء على طلب النيابة العامة وذلك بواسطة المندوب المختص ، و يعاد الأصل المثبت للتبليغ إلى الحكومة الطالبة بنفس الطريق ، وكل ذلك بشرط المعاملة بالمثل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_884> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_884_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_884_20250803_OpEnact_575a50ccfc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_884_obligation_0_14c08aff>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_884_obligation_1_1714d1a7>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_884_obligation_2_c405da73> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 884" ;
    dzdoc:position 882 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_864>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_865> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_864>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_865> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_884_condition_0_bfa390d8>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_884_condition_1_d16ad4fb> ;
    dzdoc:usesTerm dzterm:prosecution .

