<https://legal.dz/resource/law/2025-08-03/25-14#version_art_194> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يستجوب وكيل الجمهورية الشخص المقبوض عليه ويتأكد من هويته و من سريان الأمر بالقبض ، فإذا كان هذا الأمر قد تم تنفيذه من قبل أو أصبح غير ساري المفعول بسبب صدور أمر أو قرار بألا وجه للمتابعة أو حكم أو قرار ببراءة المتهم أو إدانته بالحبس مع وقف التنفيذ أو بالغرامة أو الإدانة مع الإعفاء من العقوبة أو بانقضاء الدعوى العمومية أو بالاستفادة من العفو ، أخلى سبيل المتهم . وإذا كان الأمر لا يزال ساري المفعول ، يحال المتهم مباشرة أمام القاضي الأمر أو يقتاد إلى المؤسسة العقابية إذا تعذر على القاضي الآمر استجو"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_194_20250803_OpEnact_636431b8f0> ;
    dzdoc:replacementText "يستجوب وكيل الجمهورية الشخص المقبوض عليه ويتأكد من هويته و من سريان الأمر بالقبض ، فإذا كان هذا الأمر قد تم تنفيذه من قبل أو أصبح غير ساري المفعول بسبب صدور أمر أو قرار بألا وجه للمتابعة أو حكم أو قرار ببراءة المتهم أو إدانته بالحبس مع وقف التنفيذ أو بالغرامة أو الإدانة مع الإعفاء من العقوبة أو بانقضاء الدعوى العمومية أو بالاستفادة من العفو ، أخلى سبيل المتهم . وإذا كان الأمر لا يزال ساري المفعول ، يحال المتهم مباشرة أمام القاضي الأمر أو يقتاد إلى المؤسسة العقابية إذا تعذر على القاضي الآمر استجوابه في نفس اليوم . يستجوب المتهم خلال ثمان وأربعين (48) ساعة من حبسه ، فإن مضت هذه المهلة دون استجوابه يقتاد فورا أمام وكيل الجمهورية الذي يطلب من القاضي المكلف بالتحقيق ، و في حالة غيابه، فمن أي قاض آخر من قضاة الحكم، ليقوم باستجوابه في الحال وإلا أخلي سبيله . بعد استجواب المتهم، يمكن قاضي التحقيق أو القاضي المذكور في الفقرة السابقة أن يخلي سبيله أو يضعه رهن الحبس المؤقت طبقا لأحكام المادة 201 أدناه ، أو يخضعه لالتزامات الرقابة القضائية . يبقى الأمر بالقبض الصادر عن جهة التحقيق منتجا لأثره بعد صدور أمر أو قرار الإحالة أو إرسال المستندات، ويبقى المقبوض عليه محبوسا إلى أن تقرر جهة الحكم خلاف ذلك، دون المساس بحقه في طلب الإفراج . كل متهم ضبط بمقتضى أمر بالقبض وبقي في مؤسسة عقابية أكثر من ثمان وأربعين (48) ساعة دون أن يستجوب اعتبر محبوسا تعسفيا، و يجب عرضه على القاضي المختص لاتخاذ الإجراء المناسب بشأنه . كل قاض أو موظف أمر بهذا الحبس أو تسامح فيه عن علم، يتعرض للعقوبات المقررة للحبس التعسفي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_194> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_194> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_195> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا قبض على المتهم خارج دائرة اختصاص القاضي الذي أصدر الأمر ، اقتيد في الحال إلى وكيل الجمهورية لمحل القبض الذي يتلقى أقواله بعد تنبيهه بأنه حر في عدم الإدلاء بأي أقوال ، وينوه عن ذلك التنبيه في المحضر، وتطبق فضلا عن ذلك أحكام الفقرة الأولى من المادة 194 أعلاه. إذا كان الأمر بالقبض مازال ساري المفعول ، يقوم وكيل الجمهورية ، بغير تمهل، بإخطار وكيل الجمهورية بدائرة اختصاص القاضي الذي أصدر الأمر بالقبض، ويطلب نقل المتهم ، فإن تعذر ذلك في الحال فعلى وكيل الجمهورية أن يعرض الموضوع على القاضي الأمر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_195_20250803_OpEnact_ec6358774d> ;
    dzdoc:replacementText "إذا قبض على المتهم خارج دائرة اختصاص القاضي الذي أصدر الأمر ، اقتيد في الحال إلى وكيل الجمهورية لمحل القبض الذي يتلقى أقواله بعد تنبيهه بأنه حر في عدم الإدلاء بأي أقوال ، وينوه عن ذلك التنبيه في المحضر، وتطبق فضلا عن ذلك أحكام الفقرة الأولى من المادة 194 أعلاه. إذا كان الأمر بالقبض مازال ساري المفعول ، يقوم وكيل الجمهورية ، بغير تمهل، بإخطار وكيل الجمهورية بدائرة اختصاص القاضي الذي أصدر الأمر بالقبض، ويطلب نقل المتهم ، فإن تعذر ذلك في الحال فعلى وكيل الجمهورية أن يعرض الموضوع على القاضي الأمر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_195> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_195> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
