<https://legal.dz/resource/law/2025-08-03/25-14#version_art_59> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لـ وكيل الجمهورية ، قبل أي متابعة جزائية، أن يقرر ، بمبادرة منه أو بناء على طلب الضحية أو المشتكى منه، إجراء وساطة عندما يكون من شأنها وضع حد للإخلال الناتج عن الجريمة أو جبر الضرر المترتب عنها. تتم الوساطة بموجب اتفاق مكتوب بين مرتكب الأفعال المجرمة والضحية وبحضور ممثلها القانوني إذا كانت طفلا. يتولى وكيل الجمهورية إجراء الوساطة أو يفوض للقيام بذلك أحد الوسطاء ، و في هذه الحالة، يتعين على الوسيط المفوض أن يعرض محضر الوساطة على وكيل الجمهورية لاعتماده والتأشير عليه. يؤدي الوسطاء المفوضون ال"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_59_20250803_OpEnact_acba5b5e4f> ;
    dzdoc:replacementText """يجوز لـ وكيل الجمهورية ، قبل أي متابعة جزائية، أن يقرر ، بمبادرة منه أو بناء على طلب الضحية أو المشتكى منه، إجراء وساطة عندما يكون من شأنها وضع حد للإخلال الناتج عن الجريمة أو جبر الضرر المترتب عنها. تتم الوساطة بموجب اتفاق مكتوب بين مرتكب الأفعال المجرمة والضحية وبحضور ممثلها القانوني إذا كانت طفلا. يتولى وكيل الجمهورية إجراء الوساطة أو يفوض للقيام بذلك أحد الوسطاء ، و في هذه الحالة، يتعين على الوسيط المفوض أن يعرض محضر الوساطة على وكيل الجمهورية لاعتماده والتأشير عليه. يؤدي الوسطاء المفوضون اليمين أمام المجلس القضائي الذي يعينون بدائرة اختصاصه لأول مرة ، وفق الصيغة الآتية:
                " اقسم بالله العظيم أن أقوم بأداء مهامي على أحسن وجه وأن أحافظ على سرية المعلومات التي اطلع عليها أثناء أو بمناسبة أداء مهامي". تتم الوساطة ، في جميع الحالات، في مقر المحكمة. تحدد شروط اختيار الوسطاء المفوضين وكيفيات تعيينهم وكذا قانونهم الأساسي ونظامهم التعويض عن طريق التنظيم."""@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_59> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_59> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

