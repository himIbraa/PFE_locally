    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_421>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_422>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_424>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_425>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_432>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_493> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_421>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_422>,
