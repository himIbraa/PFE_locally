<https://legal.dz/resource/law/2025-08-03/25-14#version_art_717> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان المحكوم عليه بعقوبة سالبة للحرية محبوسا ولم يكن ثمة مجال لتطبيق المادة 716 أعلاه ، تعين اتخاذ الإجراءات المتبعة في حالة تنازع الاختصاص بين القضاة، ولكن بناء على طلب من النيابة العامة وحدها بقصد إحالة الدعوى من الجهة القضائية المطروح أمامها النزاع إلى الجهة التي بها مكان الحبس."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_717_20250803_OpEnact_9b4c0296e5> ;
    dzdoc:replacementText "إذا كان المحكوم عليه بعقوبة سالبة للحرية محبوسا ولم يكن ثمة مجال لتطبيق المادة 716 أعلاه ، تعين اتخاذ الإجراءات المتبعة في حالة تنازع الاختصاص بين القضاة، ولكن بناء على طلب من النيابة العامة وحدها بقصد إحالة الدعوى من الجهة القضائية المطروح أمامها النزاع إلى الجهة التي بها مكان الحبس."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_717> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_717> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
