<https://legal.dz/resource/law/2025-08-03/25-14#version_art_458> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتعلق حق الاستئناف بما يأتي : المتهم، والنيابة العامة، والطرف المدني، فيما يخص حقوقه المدنية، والمسؤول عن الحقوق المدنية والإدارات العمومية في الأحوال التي تباشر فيها الدعوى العمومية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
