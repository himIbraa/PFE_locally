<https://legal.dz/resource/law/2025-08-03/25-14#version_art_111> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة ما إذا كانت الأفعال المجرمة المنسوبة للشخص المعنوي ذات طابع عابر للحدود وكانت جهة قضائية أجنبية قد أخطرت بها ، يجوز للنيابة العامة أن تقوم، عن طريق وزارة العدل، بتطبيق الإجراءات المنصوص عليها في هذا الفصل بالتشاور مع الجهة القضائية الأجنبية، في إطار الاتفاقيات الدولية ذات الصلة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_111_20250803_OpEnact_e112f9ab92> ;
    dzdoc:replacementText "في حالة ما إذا كانت الأفعال المجرمة المنسوبة للشخص المعنوي ذات طابع عابر للحدود وكانت جهة قضائية أجنبية قد أخطرت بها ، يجوز للنيابة العامة أن تقوم، عن طريق وزارة العدل، بتطبيق الإجراءات المنصوص عليها في هذا الفصل بالتشاور مع الجهة القضائية الأجنبية، في إطار الاتفاقيات الدولية ذات الصلة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
