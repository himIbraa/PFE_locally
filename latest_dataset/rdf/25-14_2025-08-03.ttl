        <https://legal.dz/resource/law/2025-08-03/25-14#art_86_obligation_1_cfdd99e5>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_86_obligation_2_d43bd891>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_86_obligation_3_57f5333a> ;
