<https://legal.dz/resource/law/2025-08-03/25-14#version_art_675> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "سواء أو دعت النيابة العامة مذكرتها في الميعاد المشار إليه أنفا أم لم تودعه، فإن القضية تقيد بجدول الجلسة من طرف رئيس الغرفة وبعد استطلاع رأي النيابة العامة. ويجب تبليغ جميع أطراف الدعوى المعنيين بتاريخ الجلسة قبل انعقادها بخمسة (5) أيام، على الأقل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_675_20250803_OpEnact_b859a77091> ;
    dzdoc:replacementText "سواء أو دعت النيابة العامة مذكرتها في الميعاد المشار إليه أنفا أم لم تودعه، فإن القضية تقيد بجدول الجلسة من طرف رئيس الغرفة وبعد استطلاع رأي النيابة العامة. ويجب تبليغ جميع أطراف الدعوى المعنيين بتاريخ الجلسة قبل انعقادها بخمسة (5) أيام، على الأقل ."@ar ;
