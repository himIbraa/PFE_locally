    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_799> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_799_obligation_0_5f3a0fc1_role_1736d342a1> a dznorm:Role ;
    rdfs:label "أمين الضبط قبل تحرير"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يجب على أمين الضبط قبل تحرير القسيمة رقم 2 أن يتحقق من الحالة المدنية لصاحب الشأن"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_799> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_799_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_799> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب على أمين الضبط قبل تحرير القسيمة رقم 2 أن يتحقق من الحالة المدنية لصاحب الشأن. فإذا كانت نتيجة فحص سجلات الحالة المدنية سلبية، أشر على البطاقة كالآتي : (لا تنطبق عليه أية شهادة ميلاد) دون إضافة أي بيان آخر."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_799_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_799> ;
    dzdoc:position 1 ;
    dzdoc:text "فإذا كانت السلطة التي تحرر القسيمة رقم 2 ليس تحت يدها وثائق الحالة المدنية، فيؤشر بشكل واضح على القسيمة بعبارة (غير محقق الهوية)، وإذا لم توجد قسيمة تحمل رقم 1 في ملف صحيفة السوابق القضائية للشخص فإن البطاقة رقم 2 التي تخصه تسلم وعليها عبارة (لا يوجد)."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_79_condition_0_e3d58a69> a dznorm:Condition ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2025-08-03/25-14#art_79_condition_0_e3d58a69_period_0865ac586c>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_79_condition_0_e3d58a69_period_6e6ecf9e81> ;
    dzdoc:hasReference <https://legal.dz/resource/law/2025-08-03/25-14#art_79_condition_0_e3d58a69_ref_a98e7aea1378> ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_78> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_78> ;
    dznorm:conditionText "إذا حدث أثناء التحري في جريمة متلبس بها أو تحقيق متعلق بإحدى الجرائم المذكورة في المادة 78 الفقرة (3) أعلاه، إن كان الشخص الذي يتم تفتيش مسكنه موقوفا للنظر أو محبوسا في مكان آخر و أن الحال يقتضي عدم نقله إلى ذلك المكان بسبب مخاطر جسيمة قد تمس بالنظام العام أو لاحتمال فراره، أو اختفاء الأدلة خلال المدة اللازمة لنقله"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_79> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_79_condition_0_e3d58a69_period_0865ac586c> a dznorm:Period ;
    rdfs:label "خلال المدة اللازمة لنقله"@ar ;
    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "إذا حدث أثناء التحري في جريمة متلبس بها أو تحقيق متعلق بإحدى الجرائم المذكورة في المادة 78 الفقرة (3) أعلاه، إن كان الشخص الذي يتم تفتيش مسكنه موقوفا للنظر أو محبوسا في مكان آخر و أن الحال يقتضي عدم نقله إلى ذلك المكان بسبب مخاطر جسيمة قد تمس بالنظام العام أو لاحتمال فراره، أو اختفاء الأدلة خلال المدة اللازمة لنقله"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_79> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_79_condition_0_e3d58a69_period_6e6ecf9e81> a dznorm:Period ;
    rdfs:label "لمدة اللازمة لنقله"@ar ;
    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "إذا حدث أثناء التحري في جريمة متلبس بها أو تحقيق متعلق بإحدى الجرائم المذكورة في المادة 78 الفقرة (3) أعلاه، إن كان الشخص الذي يتم تفتيش مسكنه موقوفا للنظر أو محبوسا في مكان آخر و أن الحال يقتضي عدم نقله إلى ذلك المكان بسبب مخاطر جسيمة قد تمس بالنظام العام أو لاحتمال فراره، أو اختفاء الأدلة خلال المدة اللازمة لنقله"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_79> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_79_condition_0_e3d58a69_ref_a98e7aea1378> a dzdoc:Reference ;
    rdfs:label "المادة 78"@ar ;
    dzdoc:frbrUri "#art_78"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2025-08-03/25-14#art_78> ;
    dzdoc:sourceEId "art_79" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "إذا حدث أثناء التحري في جريمة متلبس بها أو تحقيق متعلق بإحدى الجرائم المذكورة في المادة 78 الفقرة (3) أعلاه، إن كان الشخص الذي يتم تفتيش مسكنه موقوفا للنظر أو محبوسا في مكان آخر و أن الحال يقتضي عدم نقله إلى ذلك المكان بسبب مخاطر جسيمة قد تمس بالنظام العام أو لاحتمال فراره، أو اختفاء الأدلة خلال المدة اللازمة لنقله"@ar ;
    dzdoc:targetEId "art_78" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_79_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_79> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا حدث أثناء التحري في جريمة متلبس بها أو تحقيق متعلق بإحدى الجرائم المذكورة في المادة 78 الفقرة (3) أعلاه، إن كان الشخص الذي يتم تفتيش مسكنه موقوفا للنظر أو محبوسا في مكان آخر و أن الحال يقتضي عدم نقله إلى ذلك المكان بسبب مخاطر جسيمة قد تمس بالنظام العام أو لاحتمال فراره، أو اختفاء الأدلة خلال المدة اللازمة لنقله، يمكن أن يجرى التفتيش بعد الموافقة المكتوبة المسبقة من وكيل الجمهورية أو قاضي التحقيق وبحضور شاهدين (2) مسخرين طبقا لأحكام المادة 76 أعلاه، أو بحضور ممثل يعينه صاحب المسكن محل التفتيش."@ar .

