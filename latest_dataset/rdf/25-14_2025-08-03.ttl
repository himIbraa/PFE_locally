<https://legal.dz/resource/law/2025-08-03/25-14#version_art_328> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يترتب على التخلي عن ملف الإجراءات تحويل إلى وكيل الجمهورية وقاضي التحقيق بالقطب الجزائي الوطني الاقتصادي والمالي سلطات إدارة ومراقبة أعمال الضبطية القضائية بخصوص الإجراءات المنجزة أو الجارية أو المزمع اتخاذها بخصوص الجرائم المنصوص عليها في المادة 317 من هذا القانون. يتلقى ضباط الشرطة القضائية، بغض النظر عن مكان تواجد المحكمة التي يتبعون لدائرة اختصاصها، التعليمات والإنابات القضائية مباشرة من وكيل الجمهورية وقاضي التحقيق لدى القطب الجزائي الوطني الاقتصادي والمالي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_328_20250803_OpEnact_3172287ca0> ;
    dzdoc:replacementText "يترتب على التخلي عن ملف الإجراءات تحويل إلى وكيل الجمهورية وقاضي التحقيق بالقطب الجزائي الوطني الاقتصادي والمالي سلطات إدارة ومراقبة أعمال الضبطية القضائية بخصوص الإجراءات المنجزة أو الجارية أو المزمع اتخاذها بخصوص الجرائم المنصوص عليها في المادة 317 من هذا القانون. يتلقى ضباط الشرطة القضائية، بغض النظر عن مكان تواجد المحكمة التي يتبعون لدائرة اختصاصها، التعليمات والإنابات القضائية مباشرة من وكيل الجمهورية وقاضي التحقيق لدى القطب الجزائي الوطني الاقتصادي والمالي ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_328> ;
