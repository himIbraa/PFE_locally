<https://legal.dz/resource/law/2025-08-03/25-14#art_865> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_1_sec_2> ;
    dzdoc:eId "art_865" ;
    dzdoc:fullText "يتولى وزير الشؤون الخارجية تحويل طلب التسليم، بعد فحص المستندات ، ومعه الملف، إلى وزير العدل الذي يتحقق من سلامة الطلب ويعطيه التتبع الإجرائي الملائم الذي يتطلبه القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_865> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_865_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_865_20250803_OpEnact_659853e342> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "865" ;
    dzdoc:position 863 ;
    dzdoc:usesTerm dzterm:minister_foreign_affairs,
        dzterm:minister_justice .

