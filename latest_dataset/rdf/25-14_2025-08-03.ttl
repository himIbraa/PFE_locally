    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_166> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_167_condition_0_738b6044> a dznorm:Condition ;
    dznorm:conditionText "إذا كان الشاهد أصما أو أبكما"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_167> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_167_condition_1_2ca2138d> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يكن يعرف الكتابة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_167> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_167_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_167> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان الشاهد أصما أو أبكما، توضع الأسئلة وتكون الإجابات بالكتابة ، وإذا لم يكن يعرف الكتابة، يندب له قاضي التحقيق، من تلقاء نفسه، مترجما قادرا على التحدث معه، ويذكر في المحضر اسم المترجم المنتدب ولقبه ومهنته وموطنه، وينوه عن حلفه اليمين ، ثم يوقع على المحضر."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_168_obligation_0_d1739bfa> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_168> ;
    dznorm:position 0 ;
    dznorm:provisionText "يطلب من الشهود ، قبل سماع شهادتهم عن الوقائع ، أن يذكر كل منهم اسمه ولقبه وعمره وحالته ومهنته وسكنه و إن كانت له قرابة أو نسب مع الخصوم أو ملحق بخدمتهم أو كان فاقدا للأهلية"@ar ;
    dznorm:sourceArticle "art_168" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_168_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_168> ;
    dzdoc:position 0 ;
    dzdoc:text "يطلب من الشهود ، قبل سماع شهادتهم عن الوقائع ، أن يذكر كل منهم اسمه ولقبه وعمره وحالته ومهنته وسكنه و إن كانت له قرابة أو نسب مع الخصوم أو ملحق بخدمتهم أو كان فاقدا للأهلية وينوه في المحضر عن هذه الأسئلة والأجوبة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_168_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_168> ;
    dzdoc:position 1 ;
    dzdoc:text """ويؤدي اليمين ، كل شاهد ويده اليمنى مرفوعة بالصيغة الآتية :
                "أقسم بالله العظيم أن أتكلم بغير حقد ولا خوف وأن أقول كل الحق ولا شيء غير الحق"."""@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_168_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_168> ;
    dzdoc:position 2 ;
    dzdoc:text "وتسمع شهادة الأطفال إلى سن السادسة عشر (16) بغير حلف اليمين."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_169_obligation_0_3643c76b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_169_obligation_0_3643c76b_role_be63a61c94> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_169> ;
    dznorm:position 0 ;
    dznorm:provisionText "يوقع على كل صفحة من صفحات محضر التحقيق من قاضي التحقيق و أمين الضبط والشاهد"@ar ;
    dznorm:sourceArticle "art_169" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_169_obligation_0_3643c76b_role_be63a61c94> a dznorm:Role ;
    rdfs:label "كل صفحة من صفحات"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يوقع على كل صفحة من صفحات محضر التحقيق من قاضي التحقيق و أمين الضبط والشاهد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_169> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_169_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_169> ;
    dzdoc:position 0 ;
    dzdoc:text "يوقع على كل صفحة من صفحات محضر التحقيق من قاضي التحقيق و أمين الضبط والشاهد ويدعى الأخير إلى إعادة تلاوة فحوى شهادته بنصها الذي حررت به والتوقيع إن أصر عليها، فإذا لم يكن الشاهد ملما بالقراءة يتلى عليه بمعرفة أمين الضبط. و إن امتنع الشاهد عن التوقيع أو تعذر عليه نوه عن ذلك في المحضر . يوقع أيضا على كل صفحة بهذه الكيفية من المترجم إن كان ثمة محل لذلك."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_16_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_16> ;
    dzdoc:position 0 ;
    dzdoc:text "يوقف أجل التقادم في حالة وجود مانع قانوني كما هو الشأن في الحصانة البرلمانية والدبلوماسية أو مانع مادي يستحيل دفعه كالقوة القاهرة والكوارث الطبيعية، يحول دون إمكانية مباشرة أو ممارسة الدعوى العمومية."@ar .

