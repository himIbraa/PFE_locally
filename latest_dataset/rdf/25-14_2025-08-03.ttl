<https://legal.dz/resource/law/2025-08-03/25-14#art_678> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_4> ;
    dzdoc:eId "art_678" ;
    dzdoc:fullText "تطبق أمام المحكمة العليا القواعد المتعلقة بعلنية وضبط الجلسة المنصوص عليها في هذا القانون. يناط بالرئيس ضبط الجلسة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_678> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_678_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_678_para_1> ;
