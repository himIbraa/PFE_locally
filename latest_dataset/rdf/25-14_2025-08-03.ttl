<https://legal.dz/resource/law/2025-08-03/25-14#version_art_775> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا ما انتهى الإكراه البدني لأي سبب كان، باستثناء الحالة المنصوص عليها في المادة 774 أعلاه ، فلا يجوز مباشرته بعد ذلك لا من أجل الدين نفسه ولا من أجل أحكام لاحقة لتنفيذه ما لم تكن هذه الأحكام تستلزم بسبب مجموع مبالغها مدة إكراه أطول من المدة التي تم تنفيذها على المحكوم عليه ، و في هذه الحالة يتعين دائما إسقاط مدة الحبس الأول من الإكراه الجديد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_775_20250803_OpEnact_535725decd> ;
    dzdoc:replacementText "إذا ما انتهى الإكراه البدني لأي سبب كان، باستثناء الحالة المنصوص عليها في المادة 774 أعلاه ، فلا يجوز مباشرته بعد ذلك لا من أجل الدين نفسه ولا من أجل أحكام لاحقة لتنفيذه ما لم تكن هذه الأحكام تستلزم بسبب مجموع مبالغها مدة إكراه أطول من المدة التي تم تنفيذها على المحكوم عليه ، و في هذه الحالة يتعين دائما إسقاط مدة الحبس الأول من الإكراه الجديد ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_775> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
