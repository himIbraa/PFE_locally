<https://legal.dz/resource/law/2025-08-03/25-14#version_art_210> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون جهة التحقيق أو الحكم التي تترك أو تخلي سبيل متهم ذي جنسية أجنبية هي وحدها المختصة بتحديد محل الإقامة الذي يحظر على المتهم الابتعاد عنه إلا بترخيص ، وذلك قبل صدور أمر نهائي أو قرار في الدعوى بأن لا وجه للمتابعة أو حكم نهائي ، ويعاقب المتهم الذي يخالف ذلك بالحبس من ثلاثة (3) أشهر إلى ثلاث (3) سنوات، وبغرامة من 30.000 دج إلى 300.000 دج أو بإحدى هاتين العقوبتين، و يحكم عليه وجوبا بسحب جواز السفر مؤقتا . ويجوز لجهة التحقيق أو الحكم أن تمنعه من مغادرة التراب الوطني. ويبلغ قرار تحديد محل الإقامة ا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_210_20250803_OpEnact_29a748e565> ;
    dzdoc:replacementText "تكون جهة التحقيق أو الحكم التي تترك أو تخلي سبيل متهم ذي جنسية أجنبية هي وحدها المختصة بتحديد محل الإقامة الذي يحظر على المتهم الابتعاد عنه إلا بترخيص ، وذلك قبل صدور أمر نهائي أو قرار في الدعوى بأن لا وجه للمتابعة أو حكم نهائي ، ويعاقب المتهم الذي يخالف ذلك بالحبس من ثلاثة (3) أشهر إلى ثلاث (3) سنوات، وبغرامة من 30.000 دج إلى 300.000 دج أو بإحدى هاتين العقوبتين، و يحكم عليه وجوبا بسحب جواز السفر مؤقتا . ويجوز لجهة التحقيق أو الحكم أن تمنعه من مغادرة التراب الوطني. ويبلغ قرار تحديد محل الإقامة الإجبارية لوزير الداخلية باتخاذ إجراءات لمراقبة محل الإقامة المحدد، وتسليم التراخيص المؤقتة بالتنقل داخل الإقليم الوطني، عند الاقتضاء. وتخطر جهة التحقيق بذلك. ويعاقب من تهرب من إجراءات المراقبة بالعقوبات المنصوص عليها في الفقرة الأولى من هذه المادة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_210> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_210> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_211> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا طرح الأمر على جهة الحكم في الأحوال المنصوص عليها في المادتين 209 و 210 أعلاه ، استدعي الخصوم ومحاموهم برسالة موصى عليها وينطق بالحكم بعد سماع أقوال النيابة العامة والخصوم ومحاميهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_211_20250803_OpEnact_f909144cea> ;
