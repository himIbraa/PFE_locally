<https://legal.dz/resource/law/2025-08-03/25-14#art_24_condition_2_15ae196b> a dznorm:Condition ;
    dznorm:conditionText "و في الحالات المنصوص عليها في الفقرتين السابقتين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_24> ;
