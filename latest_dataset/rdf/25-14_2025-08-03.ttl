<https://legal.dz/resource/law/2025-08-03/25-14#art_238_condition_0_f7d1bffa> a dznorm:Condition ;
    dznorm:conditionText "إذا تضمنت الإنابة القضائية إجراءات، اتخاذها في وقت واحد في جهات مختلفة من الإقليم الوطني"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_238> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_238_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_238> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا تضمنت الإنابة القضائية إجراءات، اتخاذها في وقت واحد في جهات مختلفة من الإقليم الوطني جاز، بموجب أمر من قاضي التحقيق المنيب أن يوجه إلى قضاة التحقيق المكلفين بتنفيذ تلك الإنابة إما نسخا أصلية منها أو صورا كاملة من الأصل. ويجوز في حالة الاستعجال إذاعة نص الإنابة القضائية بجميع الوسائل، غير أنه يجب أن توضح في كل إذاعة البيانات الجوهرية من واقع النسخة الأصلية، وبالأخص نوع التهمة واسم وصفة القاضي المنيب."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_239_condition_0_36b328f4> a dznorm:Condition ;
    dznorm:conditionText "وإذا رأى قاضي التحقيق أنه لا موجب للاستجابة لطلب الخبرة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_239> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_239_condition_1_a7177928> a dznorm:Condition ;
    dznorm:conditionText "و إذا لم يبت قاضي التحقيق في الأجل المذكور"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_239> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_239_obligation_0_de32de72> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2025-08-03/25-14#art_239_obligation_0_de32de72_period_c37d20e576> ;
