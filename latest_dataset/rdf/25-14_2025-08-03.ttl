<https://legal.dz/resource/law/2025-08-03/25-14#version_art_437> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعرض الرئيس على المتهم، إن لزم الأمر، أثناء استجوابه أو أثناء سماع أقوال الشهود أو بعد ذلك مباشرة، بطلب منه أو من محاميه، أدلة الإقناع أو محضر الحجز أو الاعتراف بهذه الأدلة، كما يعرضها على الشهود أو الخبراء أو المحلفين إذا كان ثمة محل لذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_437_20250803_OpEnact_5cea0c2367> ;
    dzdoc:replacementText "يعرض الرئيس على المتهم، إن لزم الأمر، أثناء استجوابه أو أثناء سماع أقوال الشهود أو بعد ذلك مباشرة، بطلب منه أو من محاميه، أدلة الإقناع أو محضر الحجز أو الاعتراف بهذه الأدلة، كما يعرضها على الشهود أو الخبراء أو المحلفين إذا كان ثمة محل لذلك ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_437> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_437> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
