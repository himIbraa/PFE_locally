<https://legal.dz/resource/law/2025-08-03/25-14#version_art_264> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبلغ الأوامر القضائية في أربع وعشرين (24) ساعة برسالة موصى عليها إلى محامي المتهم ، وإلى الضحية و المدعي المدني أو محاميهما . ويحاط المتهم علما بأوامر التصرف في التحقيق بعد انتهائه، ويحاط الضحية أو المدعي المدني علما بأوامر الإحالة أو أوامر إرسال ملف الدعوى إلى النائب العام ، وذلك بالأوضاع والآجال نفسها ، و إذا كان المتهم محبوسا فيحاط علما بواسطة مدير المؤسسة العقابية . وتبلغ للمتهم أو الضحية أو المدعي المدني الأوامر التي يجوز لهم الطعن فيها بالاستئناف، وذلك في ظرف أربع وعشرين (24) ساعة . ويخطر "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_264_20250803_OpEnact_2c36586b1f> ;
    dzdoc:replacementText "تبلغ الأوامر القضائية في أربع وعشرين (24) ساعة برسالة موصى عليها إلى محامي المتهم ، وإلى الضحية و المدعي المدني أو محاميهما . ويحاط المتهم علما بأوامر التصرف في التحقيق بعد انتهائه، ويحاط الضحية أو المدعي المدني علما بأوامر الإحالة أو أوامر إرسال ملف الدعوى إلى النائب العام ، وذلك بالأوضاع والآجال نفسها ، و إذا كان المتهم محبوسا فيحاط علما بواسطة مدير المؤسسة العقابية . وتبلغ للمتهم أو الضحية أو المدعي المدني الأوامر التي يجوز لهم الطعن فيها بالاستئناف، وذلك في ظرف أربع وعشرين (24) ساعة . ويخطر أمين الضبط وكيل الجمهورية بجميع أوامر قاضي التحقيق في اليوم نفسه التي تصدر فيه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_264> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_264> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
