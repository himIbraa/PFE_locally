<https://legal.dz/resource/law/2025-08-03/25-14#art_210_obligation_1_042917a9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_210> ;
    dznorm:position 1 ;
    dznorm:provisionText "يحكم عليه وجوبا بسحب جواز السفر مؤقتا"@ar ;
    dznorm:sourceArticle "art_210" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_210_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_210> ;
    dzdoc:position 0 ;
    dzdoc:text "تكون جهة التحقيق أو الحكم التي تترك أو تخلي سبيل متهم ذي جنسية أجنبية هي وحدها المختصة بتحديد محل الإقامة الذي يحظر على المتهم الابتعاد عنه إلا بترخيص، وذلك قبل صدور أمر نهائي أو قرار في الدعوى بأن لا وجه للمتابعة أو حكم نهائي ، ويعاقب المتهم الذي يخالف ذلك بالحبس من ثلاثة (3) أشهر إلى ثلاث (3) سنوات، وبغرامة من 30.000 دج إلى 300.000 دج أو بإحدى هاتين العقوبتين، ويحكم عليه وجوبا بسحب جواز السفر مؤقتا."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_210_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_210> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجوز لجهة التحقيق أو الحكم أن تمنعه من مغادرة التراب الوطني."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_210_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_210> ;
    dzdoc:position 2 ;
    dzdoc:text "ويبلغ قرار تحديد محل الإقامة الإجبارية لوزير الداخلية باتخاذ إجراءات لمراقبة محل الإقامة المحدد، وتسليم التراخيص المؤقتة بالتنقل داخل الإقليم الوطني، عند الاقتضاء."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_210_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_210> ;
    dzdoc:position 3 ;
    dzdoc:text "وتخطر جهة التحقيق بذلك."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_210_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_210> ;
    dzdoc:position 4 ;
    dzdoc:text "ويعاقب من تهرب من إجراءات المراقبة بالعقوبات المنصوص عليها في الفقرة الأولى من هذه المادة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_210_prohibition_0_aafde5c7> a dznorm:Prohibition ;
    dzdoc:confidenceScore 0.72 ;
