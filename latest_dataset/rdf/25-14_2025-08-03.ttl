<https://legal.dz/resource/law/2025-08-03/25-14#version_art_167> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان الشاهد أصما أو أبكما ، توضع الأسئلة وتكون الإجابات بالكتابة ، و إذا لم يكن يعرف الكتابة ، يندب له قاضي التحقيق ، من تلقاء نفسه، مترجما قادرا على التحدث معه، ويذكر في المحضر اسم المترجم المنتدب ولقبه ومهنته وموطنه، وينوه عن حلفه اليمين ، ثم يوقع على المحضر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_167_20250803_OpEnact_8cde4ab70e> ;
    dzdoc:replacementText "إذا كان الشاهد أصما أو أبكما ، توضع الأسئلة وتكون الإجابات بالكتابة ، و إذا لم يكن يعرف الكتابة ، يندب له قاضي التحقيق ، من تلقاء نفسه، مترجما قادرا على التحدث معه، ويذكر في المحضر اسم المترجم المنتدب ولقبه ومهنته وموطنه، وينوه عن حلفه اليمين ، ثم يوقع على المحضر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
