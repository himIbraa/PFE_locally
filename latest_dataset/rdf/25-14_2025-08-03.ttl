    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_361> ;
    dznorm:position 0 ;
    dznorm:provisionText "يقوم الرئيس باستجواب المتهم، قبل سماع الشهود، ويتلقى أقواله"@ar ;
    dznorm:sourceArticle "art_361" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_361_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_361> ;
    dzdoc:position 0 ;
    dzdoc:text "يقوم الرئيس باستجواب المتهم، قبل سماع الشهود، ويتلقى أقواله، ويجوز للنيابة العامة وللدفاع توجيه أسئلة إلى المتهم كما يجوز ذلك للمدعي المدني عن طريق الرئيس."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_361_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_361> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجوز للرئيس منع الإجابة عن السؤال إذا كان غير منتج أو غير ملائم."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_361_permission_0_ad436d86> a dznorm:Permission ;
