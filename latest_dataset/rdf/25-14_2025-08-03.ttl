<https://legal.dz/resource/law/2025-08-03/25-14#version_art_770> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان المنفذ عليه بالإكراه البدني محبوسا ، جاز لطرف الخصومة المطالب بالمتابعة، بمجرد تبليغ الإعلان المنصوص عليه في المادة 769 أعلاه، أن يعارض في الإفراج عنه بأن يستصدر من النيابة العامة أمرا يوجه منها إلى مدير المؤسسة العقابية بإبقائه في الحبس ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_770_20250803_OpEnact_5983e6ad11> ;
    dzdoc:replacementText "إذا كان المنفذ عليه بالإكراه البدني محبوسا ، جاز لطرف الخصومة المطالب بالمتابعة، بمجرد تبليغ الإعلان المنصوص عليه في المادة 769 أعلاه، أن يعارض في الإفراج عنه بأن يستصدر من النيابة العامة أمرا يوجه منها إلى مدير المؤسسة العقابية بإبقائه في الحبس ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_770> ;
