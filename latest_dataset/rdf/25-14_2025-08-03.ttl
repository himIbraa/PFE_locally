<https://legal.dz/resource/law/2025-08-03/25-14#version_art_805> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخطر النائب العام أو وكيل الجمهورية أمين ضبط المحكمة الكائن بدائرتها محل الميلاد أو القاضي المكلف بمصلحة صحيفة السوابق القضائية المركزية بأوامر القبض وبالأحكام والقرارات الصادرة بعقوبات مقيدة للحرية حضورية كانت أو غيابية والتي لم يجر تنفيذها . و تحفظ هذه الإخطارات بملف صحيفة السوابق القضائية ، ويعاد إرسالها ومعها كافة الإيضاحات الموصلة إلى تنفيذ الأوامر والأحكام والقرارات إلى السلطات القضائية التي أصدرتها بمعرفة أمين ضبط محكمة محل الميلاد أو القاضي المكلف بمصلحة صحيفة السوابق القضائية المركزية ،"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_805_20250803_OpEnact_801f3c74c9> ;
    dzdoc:replacementText "يخطر النائب العام أو وكيل الجمهورية أمين ضبط المحكمة الكائن بدائرتها محل الميلاد أو القاضي المكلف بمصلحة صحيفة السوابق القضائية المركزية بأوامر القبض وبالأحكام والقرارات الصادرة بعقوبات مقيدة للحرية حضورية كانت أو غيابية والتي لم يجر تنفيذها . و تحفظ هذه الإخطارات بملف صحيفة السوابق القضائية ، ويعاد إرسالها ومعها كافة الإيضاحات الموصلة إلى تنفيذ الأوامر والأحكام والقرارات إلى السلطات القضائية التي أصدرتها بمعرفة أمين ضبط محكمة محل الميلاد أو القاضي المكلف بمصلحة صحيفة السوابق القضائية المركزية ، وذلك كلما طلب أصحاب الشأن نسخة من القسيمة رقم 3 أو كلما طلبت بشأنهم قسيمة رقم 2 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_805> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_805> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_806> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا فقد أحد الأشخاص المستندات الخاصة بهويته أو إذا سرقت منه فعلى النائب العام أو وكيل الجمهورية الواقع بدائرة اختصاصه مكان الفقد أن يرسل إخطارا عن المحضر المحرر عن الفقد أو السرقة إلى المجلس الواقع في دائرة اختصاصه محل الميلاد أو إلى القاضي المكلف بمصلحة صحيفة السوابق القضائية المركزية . ويودع هذا الإخطار في صحيفة السوابق القضائية ، و كلما تلقى أمين ضبط الجهة القضائية لمحل الميلاد أو القاضي المكلف بمصلحة السوابق القضائية المركزية طلبا خاصا بـ القسيمة رقم 2 أو بـ القسيمة رقم 3 المتعلقة بالأشخاص ا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_806_20250803_OpEnact_517b2cf7e7> ;
    dzdoc:replacementText "إذا فقد أحد الأشخاص المستندات الخاصة بهويته أو إذا سرقت منه فعلى النائب العام أو وكيل الجمهورية الواقع بدائرة اختصاصه مكان الفقد أن يرسل إخطارا عن المحضر المحرر عن الفقد أو السرقة إلى المجلس الواقع في دائرة اختصاصه محل الميلاد أو إلى القاضي المكلف بمصلحة صحيفة السوابق القضائية المركزية . ويودع هذا الإخطار في صحيفة السوابق القضائية ، و كلما تلقى أمين ضبط الجهة القضائية لمحل الميلاد أو القاضي المكلف بمصلحة السوابق القضائية المركزية طلبا خاصا بـ القسيمة رقم 2 أو بـ القسيمة رقم 3 المتعلقة بالأشخاص الذين حرر لهم محضر فقد أو سرقة مستندات الهوية فإنه لا يسلم المستخرجات المطلوبة إلا بعد التأكد من هوية الأشخاص الذين قدموا هذه الطلبات ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_806> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_806> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_807> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجرى تصحيح البيانات الواردة بـ صحيفة السوابق القضائية إما بناء على طلب الشخص الذي ورد البيان المطلوب تصحيحه بـ القسيمة رقم 1 الخاصة به، وإما بمعرفة النيابة العامة من تلقاء نفسها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_807_20250803_OpEnact_77e2f18510> ;
    dzdoc:replacementText "يجرى تصحيح البيانات الواردة بـ صحيفة السوابق القضائية إما بناء على طلب الشخص الذي ورد البيان المطلوب تصحيحه بـ القسيمة رقم 1 الخاصة به، وإما بمعرفة النيابة العامة من تلقاء نفسها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
