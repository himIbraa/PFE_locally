    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_552_20250803_OpEnact_029458c58f> ;
    dzdoc:replacementText "ترسل النيابة العامة إلى المخالف في خلال خمسة عشر (15) يوما من تاريخ الاخطار ، بموجب خطاب موصى عليه بعلم الوصول مذكورا فيه موطنه و محل ارتكاب المخالفة وتاريخها وسببها والنص القانوني المطبق بشأنها ومقدار غرامة الصلح والمهل وطرق الدفع المحددة في المادة 553 أدناه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_552> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
