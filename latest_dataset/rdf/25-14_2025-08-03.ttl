    dznorm:position 0 ;
    dznorm:provisionText "وعلى الخبراء، بعد أن يقوموا بعرض تقريرهم، حضور المرافعات ما لم يصرح لهم الرئيس بالانسحاب من الجلسة"@ar ;
    dznorm:sourceArticle "art_251" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_251_obligation_0_7854cbac_role_915ababf0c> a dznorm:Role ;
