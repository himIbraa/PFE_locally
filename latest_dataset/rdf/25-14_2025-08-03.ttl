    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_289> ;
    dznorm:position 0 ;
    dznorm:provisionText "يخطر النائب العام في الحال كلا من أطراف الدعوى ومحاميهم بهذا الإيداع برسالة موصى عليها"@ar ;
    dznorm:sourceArticle "art_289" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_289_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_289> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا قررت غرفة الاتهام إجراء تحقيق تكميلي و كلفت به أحد أعضائها ثم أنهي ذلك التحقيق فإنها تأمر بإيداع ملف التحقيق لدى أمانة الضبط ، ويخطر النائب العام في الحال كلا من أطراف الدعوى ومحاميهم بهذا الإيداع برسالة موصى عليها، ويبقى ملف الدعوى مودعا لدى أمانة الضبط طيلة خمسة (5) أيام مهما كان نوع القضية."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_289_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_289> ;
    dzdoc:position 1 ;
    dzdoc:text "وتتبع ، عندئذ ، أحكام المواد 278 و 279 و 280 من هذا القانون."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_28_obligation_0_91a5070d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
