    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_881_condition_2_f0f8802f_role_7b6b940b8d> ;
    dznorm:conditionText "ولا يجوز إعطاء هذا الإذن بالتسليم بطريق العبور إلا إلى الدول التي تمنح هذا الحق على أراضيها إلى الحكومة الجزائرية"@ar ;
