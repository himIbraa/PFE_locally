    dzdoc:text "يصدر القانون الآتي نصه :"@ar .

dzterm:arrest_warrant a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "أمر القبض"@ar,
        "الأمر بالإحضار هو ذلك الأمر الذي يصدره قاضي التحقيق إلى القوة العمومية لاقتياد المتهم ومثوله أمامه على الفور"@ar,
        "الأمر بالقبض هو الأمر الذي يصدره القاضي المختص إلى القوة العمومية بالبحث عن المتهم حد الشروط المحددة في الفقرة 2 من هذه المادة ، واقتياده أمام وكيل الجمهورية الموجود في دائرة اختصاص القاضي الأمر"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_185_defocc_616abd5d075e>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_193_defocc_7d61e2c22282> .

dzterm:attorney_general a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "النائب العام"@ar .

dzterm:bulletin_no3 a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "القسيمة رقم 3"@ar,
        "القسيمة رقم 3 هي بيان للأحكام الصادرة من إحدى الجهات القضائية للجمهورية الجزائرية في جناية أو جنحة قضت بعقوبات مقيدة للحرية تفوق شهرا واحدا"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_800_defocc_62b145e1121f> .

dzterm:experts a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الخبراء"@ar,
        "خبراء"@ar,
        "للخبراء"@ar .

dzterm:punishment_application_judge a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "قاضي تطبيق العقوبات"@ar,
        "يعتبر قاضي تطبيق العقوبات قاضي حكم يختار من بين القضاة المختصين في مجال السجون"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_629_defocc_a501295fa548> .

dzterm:rehabilitation a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "رد الاعتبار"@ar,
        "يرد الاعتبار بقوة القانون"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_836_defocc_f69a006258f3> .

