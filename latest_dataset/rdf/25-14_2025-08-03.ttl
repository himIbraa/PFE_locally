<https://legal.dz/resource/law/2025-08-03/25-14#art_421_condition_0_32bf73b1> a dznorm:Condition ;
    dznorm:conditionText "جلسات المحكمة علنية، ة، ما لم يكن في علنيتها مساس بالنظام العام أو الآداب العامة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_421> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_421_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_421> ;
    dzdoc:position 0 ;
    dzdoc:text "جلسات المحكمة علنية، ة، ما لم يكن في علنيتها مساس بالنظام العام أو الآداب العامة ، و في هذه الحالة تصدر المحكمة حكما علنيا بعقد جلسة سرية، غير أن للرئيس أن يحظر على القصر دخول قاعة الجلسة، وإذا تقررت سرية الجلسة تعين صدور الحكم في الموضوع في جلسة علنية."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_421_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_421> ;
    dzdoc:position 1 ;
    dzdoc:text "تتواصل جلسة المحكمة دون انقطاع إلى حين صدور الحكم، ويجوز إيقافها الراحة القضاة أو المحلفين أو الأطراف أو المحامين."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_421_prohibition_0_670d4ffe> a dznorm:Prohibition ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_prohibition_cue" ;
