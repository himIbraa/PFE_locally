<https://legal.dz/resource/law/2025-08-03/25-14#version_art_834> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن العقوبات المقيدة في صحيفة السوابق القضائية لا يمكن أن تشكل، بأي صفة، مانعا لتوظيف الأشخاص الذين تتعلق بهم لدى الإدارات والمؤسسات العمومية ، ما لم تتناف الجريمة المرتكبة مع ممارسة الوظيفة المراد شغلها . كما لا يمكن أن تشكل عائقا لممارسة نشاط اجتماعي أو اقتصادي أو نشاط في مؤسسات القطاع الخاص ، ما لم ينص القانون على خلاف ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_834_20250803_OpEnact_0adaf02133> ;
    dzdoc:replacementText "إن العقوبات المقيدة في صحيفة السوابق القضائية لا يمكن أن تشكل، بأي صفة، مانعا لتوظيف الأشخاص الذين تتعلق بهم لدى الإدارات والمؤسسات العمومية ، ما لم تتناف الجريمة المرتكبة مع ممارسة الوظيفة المراد شغلها . كما لا يمكن أن تشكل عائقا لممارسة نشاط اجتماعي أو اقتصادي أو نشاط في مؤسسات القطاع الخاص ، ما لم ينص القانون على خلاف ذلك ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_834> ;
