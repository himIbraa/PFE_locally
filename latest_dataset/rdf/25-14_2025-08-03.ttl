<https://legal.dz/resource/law/2025-08-03/25-14#version_art_532> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تطبق إجراءات الأمر الجزائي المنصوص عليها في هذا القسم : إذا كان المتهم طفلا ، إذا اقترنت الجنحة أو المخالفة بجنحة أو مخالفة أخرى لا تتوفر فيها شروط تطبيق إجراءات الأمر الجزائي ، إذا كانت ثمة حقوق مدنية تستوجب مناقشة وجاهية للفصل فيها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_532_20250803_OpEnact_712bf60517> ;
    dzdoc:replacementText "لا تطبق إجراءات الأمر الجزائي المنصوص عليها في هذا القسم : إذا كان المتهم طفلا ، إذا اقترنت الجنحة أو المخالفة بجنحة أو مخالفة أخرى لا تتوفر فيها شروط تطبيق إجراءات الأمر الجزائي ، إذا كانت ثمة حقوق مدنية تستوجب مناقشة وجاهية للفصل فيها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
