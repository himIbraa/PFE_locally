    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "ترسل النيابة العامة إلى المخالف في خلال خمسة عشر (15) يوما من تاريخ الاخطار"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_552> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_552_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_552> ;
    dzdoc:position 0 ;
    dzdoc:text "ترسل النيابة العامة إلى المخالف في خلال خمسة عشر (15) يوما من تاريخ الاخطار، بموجب خطاب موصى عليه بعلم الوصول مذكورا فيه موطنه و محل ارتكاب المخالفة وتاريخها وسببها والنص القانوني المطبق بشأنها ومقدار غرامة الصلح والمهل وطرق الدفع المحددة في المادة 553 أدناه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_553_obligation_0_88fc8834> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
