dzterm:agency a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوكالة"@ar,
        "وكالة وطنية لتسيير الممتلكات المجمدة و/أو المحجوزة و/أو المصادرة الناتجة عن الجرائم المنصوص عليها في قانون العقوبات والتي تدعى في صلب هذا النص \"الوكالة\""@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_621_defocc_2906b97dd89f> .

