<https://legal.dz/resource/law/2025-08-03/25-14#version_art_447> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا ظهرت أثناء المناقشات دلائل جديدة ضد المتهم بسبب وقائع أخرى ، وأبدت النيابة العامة تمسكها بحق المتابعة عنها ، أمر الرئيس بأن يقتاد المتهم الذي قضي ببراءته بغير تمهل بواسطة القوة العمومية إلى وكيل الجمهورية بمقر محكمة الجنايات لكي يطلب في الحال فتح تحقيق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_447_20250803_OpEnact_0031f924a5> ;
    dzdoc:replacementText "إذا ظهرت أثناء المناقشات دلائل جديدة ضد المتهم بسبب وقائع أخرى ، وأبدت النيابة العامة تمسكها بحق المتابعة عنها ، أمر الرئيس بأن يقتاد المتهم الذي قضي ببراءته بغير تمهل بواسطة القوة العمومية إلى وكيل الجمهورية بمقر محكمة الجنايات لكي يطلب في الحال فتح تحقيق."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_447> ;
