<https://legal.dz/resource/law/2025-08-03/25-14#art_144> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_144" ;
    dzdoc:fullText "يجوز لـ المتهم أو محاميه ، و/أو الطرف المدني أو محاميه، و/أو الضحية أو محاميه، في أية مرحلة من مراحل التحقيق، أن يطلب من قاضي التحقيق تلقي تصريحاته أو سماع شاهد أو إجراء معاينة لإظهار الحقيقة . إذا رأى قاضي التحقيق أنه لا موجب لاتخاذ الإجراءات المطلوبة منه ، يتعين عليه أن يصدر أمرا معللا خلال العشرة (10) أيام التالية لطلب الأطراف أو محاميهم . وإذا لم يبت قاضي التحقيق في الطلب خلال الأجل المذكور ، يجوز للطرف المعني أو محاميه أن يرفع طلبه خلال عشرة (10) أيام، مباشرة إلى غرفة الاتهام التي تبت فيه خلال أجل ثلاثين (30) يوما يسري من تاريخ إخطارها ، ويكون قرارها غير قابل لأي طعن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_144_permission_0_7e65b34e>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_144_permission_1_0a1bf27b> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_144_right_0_7c2f26a4>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_144_right_1_f606e29e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_144> ;
