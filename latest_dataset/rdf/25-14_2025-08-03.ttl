<https://legal.dz/resource/law/2025-08-03/25-14#version_art_722> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "على كل من ينوي الرد أن يقوم به قبل كل مرافعة في الموضوع ، وإذا كان القاضي المطلوب رده مكلفا بالتحقيق فيكون إبداء الرد قبل كل استجواب أو سماع أقوال في الموضوع ما لم تكن أسباب الرد قد تحققت أو تكشفت فيما بعد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_722_20250803_OpEnact_325a91ed30> ;
    dzdoc:replacementText "على كل من ينوي الرد أن يقوم به قبل كل مرافعة في الموضوع ، وإذا كان القاضي المطلوب رده مكلفا بالتحقيق فيكون إبداء الرد قبل كل استجواب أو سماع أقوال في الموضوع ما لم تكن أسباب الرد قد تحققت أو تكشفت فيما بعد."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_722> ;
