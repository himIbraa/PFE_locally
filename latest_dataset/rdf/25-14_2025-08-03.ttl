<https://legal.dz/resource/law/2025-08-03/25-14#version_art_37> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرسل ذوو الرتب في الشرطة البلدية محاضرهم إلى وكلاء الجمهورية المختصين، عن طريق ضابط الشرطة القضائية الأقرب . ويجب أن ترسل هذه المحاضر خلال الأيام الخمسة (5) الموالية لتاريخ معاينة الجريمة على الأكثر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
