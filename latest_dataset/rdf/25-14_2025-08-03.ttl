<https://legal.dz/resource/law/2025-08-03/25-14#version_art_869> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ترفع المحاضر المشار إليها أعلاه وكافة المستندات الأخرى في الحال، إلى الغرفة الجنائية بالمحكمة العليا، ويمثل الشخص الأجنبي أمامها في ميعاد أقصاه ثمانية (8) أيام، تبدأ من تاريخ تبليغ المستندات، و يجوز أن يمنح مدة ثمانية (8) أيام قبل المرافعات ، وذلك بناء على طلب النيابة العامة أو الشخص الأجنبي، ثم يجرى بعد ذلك استجوابه ويحرر محضرا بهذا الاستجواب، وتكون الجلسة علنية مالم يتقرر خلاف ذلك بناء على طلب النيابة أو الحاضر. تقدم النيابة العامة التماساتها، ويتم الاستماع لصاحب الشأن و يجوز لهذا الأخير أن يس"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_869_20250803_OpEnact_4bc0017598> ;
    dzdoc:replacementText "ترفع المحاضر المشار إليها أعلاه وكافة المستندات الأخرى في الحال، إلى الغرفة الجنائية بالمحكمة العليا، ويمثل الشخص الأجنبي أمامها في ميعاد أقصاه ثمانية (8) أيام، تبدأ من تاريخ تبليغ المستندات، و يجوز أن يمنح مدة ثمانية (8) أيام قبل المرافعات ، وذلك بناء على طلب النيابة العامة أو الشخص الأجنبي، ثم يجرى بعد ذلك استجوابه ويحرر محضرا بهذا الاستجواب، وتكون الجلسة علنية مالم يتقرر خلاف ذلك بناء على طلب النيابة أو الحاضر. تقدم النيابة العامة التماساتها، ويتم الاستماع لصاحب الشأن و يجوز لهذا الأخير أن يستعين بمحام مقبول أمامها وبمترجم . ويجوز أن يفرج عنه في أي وقت أثناء الإجراءات ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_869> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_869> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_87> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقيد البيانات والتأشيرات المنصوص عليها في المادة 86 أعلاه ، على هامش السجلات التي يلتزم ضابط الشرطة القضائية بمسكها في الهيئات والمصالح التي يتبعونها لإثبات الإقرارات، وتنسخ البيانات وحدها في المحضر الذي يرسل للسلطة القضائية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_87_20250803_OpEnact_e3344237aa> ;
