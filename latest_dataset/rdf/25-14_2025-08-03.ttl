<https://legal.dz/resource/law/2025-08-03/25-14#version_art_626> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تدفع المبالغ المالية المصادرة، بناء على أحكام قضائية نهائية صادرة بشأن الممتلكات التي كلفت الوكالة بتسييرها والأموال المستر جعة من الخارج وناتج بيع الأملاك المصادرة أو المسترجعة وكذا الأموال الناتجة عن التصرف قبل صدور حكم قضائي نهائي ، في حساب التخصيص المحدد لهذا الغرض و المنصوص التشريع الساري المفعول . يستفيد مالكو الممتلكات المحجوزة التي تم التصرف فيها من قبل الوكالة ، قبل الحكم النهائي، من استرجاع المبلغ المودع لدى الوكالة ، في حالة الاستفادة من البراءة بموجب حكم نهائي أو بأمر أو قرار بألا وج"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_626_20250803_OpEnact_35296d6a1d> ;
    dzdoc:replacementText "تدفع المبالغ المالية المصادرة، بناء على أحكام قضائية نهائية صادرة بشأن الممتلكات التي كلفت الوكالة بتسييرها والأموال المستر جعة من الخارج وناتج بيع الأملاك المصادرة أو المسترجعة وكذا الأموال الناتجة عن التصرف قبل صدور حكم قضائي نهائي ، في حساب التخصيص المحدد لهذا الغرض و المنصوص التشريع الساري المفعول . يستفيد مالكو الممتلكات المحجوزة التي تم التصرف فيها من قبل الوكالة ، قبل الحكم النهائي، من استرجاع المبلغ المودع لدى الوكالة ، في حالة الاستفادة من البراءة بموجب حكم نهائي أو بأمر أو قرار بألا وجه للمتابعة نهائيين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_626> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
