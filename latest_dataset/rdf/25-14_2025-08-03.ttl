    dznorm:conditionText "في حالة وجود مانع لدى أحد المحلفين الأصليين"@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_396_obligation_1_7fc2048f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
