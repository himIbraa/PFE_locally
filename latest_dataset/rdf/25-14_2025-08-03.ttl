<https://legal.dz/resource/law/2025-08-03/25-14#version_art_557> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرسل إلى المحصل، في ظرف ثلاثة (3) أيام، كشف إجمالي بالإخطارات الموجهة من النيابة . كما يرسل كشف إجمالي من النيابة العامة إلى محصل المالية في الأسبوع الأول من كل شهر عن التبليغات المسلمة في الشهر السابق تنفيذا للمادة 555 أعلاه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
