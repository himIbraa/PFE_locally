<https://legal.dz/resource/law/2025-08-03/25-14#version_art_11> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتقادم الدعوى العمومية في مواد الجنح بمرور خمس (5) سنوات كاملة . وتكون مدة التقادم عشر (10) سنوات كاملة، إذا كانت عقوبة الحبس المقررة قانونا تزيد عن خمس (5) سنوات . وتتبع في كيفيات احتساب آجال التقادم، الأحكام الموضحة في المادة 10 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_11_20250803_OpEnact_ad35e989c2> ;
    dzdoc:replacementText "تتقادم الدعوى العمومية في مواد الجنح بمرور خمس (5) سنوات كاملة . وتكون مدة التقادم عشر (10) سنوات كاملة، إذا كانت عقوبة الحبس المقررة قانونا تزيد عن خمس (5) سنوات . وتتبع في كيفيات احتساب آجال التقادم، الأحكام الموضحة في المادة 10 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
