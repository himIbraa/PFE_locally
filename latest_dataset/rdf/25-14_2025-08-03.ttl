    dznorm:sourceArticle "art_104" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_104_permission_0_a6669e9c_action_364307e9ce> a dznorm:Action ;
    rdfs:label "لقاضي التحقيق أن يخضع الشخص"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجوز لقاضي التحقيق أن يخضع الشخص المعنوي لتدبير أو أكثر من التدابير الآتية: إيداع كفالة، تقديم تأمينات عينية لضمان حقوق الضحية، المنع من إصدار الشيكات و / أو الأوراق المالية أو غيرها من السندات ذات الصلة أو استعمال بطاقات الدفع، مع مراعاة حقوق الغير المنع من ممارسة بعض النشاطات المهنية أو الاجتماعية المرتبطة بالجريمة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_104> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_104_permission_0_a6669e9c_activity_a9da4bf2ff> a dznorm:Activity ;
    rdfs:label "ممارسة بعض النشاطات المهنية أو الاجتماعية المرت"@ar ;
    dzdoc:confidenceScore 0.6 ;
    dzdoc:extractionMethod "lexical_activity_pattern" ;
    dzdoc:sourceTextSpan "يجوز لقاضي التحقيق أن يخضع الشخص المعنوي لتدبير أو أكثر من التدابير الآتية: إيداع كفالة، تقديم تأمينات عينية لضمان حقوق الضحية، المنع من إصدار الشيكات و / أو الأوراق المالية أو غيرها من السندات ذات الصلة أو استعمال بطاقات الدفع، مع مراعاة حقوق الغير المنع من ممارسة بعض النشاطات المهنية أو الاجتماعية المرتبطة بالجريمة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_104> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_105_condition_0_ac587abb> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_105_condition_0_ac587abb_action_4178718b86> ;
    dzdoc:hasReference <https://legal.dz/resource/law/2025-08-03/25-14#art_105_condition_0_ac587abb_ref_6b83bc3e12b3> ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_106> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_106> ;
    dznorm:conditionText "يمكن وكيل الجمهورية، قبل تحريك الدعوى العمومية، أن يعقد مع الشخص المعنوي الخاضع للقانون الخاص الضالع أو الشريك في جريمة أو أكثر من الجرائم المنصوص عليها في المادة 106 أدناه ، اتفاقية تتضمن إرجاء المتابعة الجزائية ضده، مقابل إرجاعه الأموال والممتلكات والعائدات المتصرف فيها أو المحولة إلى خارج التراب الوطني أو ما يمثل قيمتها و دفع كامل المبالغ المستحقة للخزينة العمومية و للأطراف العمومية المتضررة من الجرائم المنسوبة إليه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_105> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_105_condition_0_ac587abb_action_4178718b86> a dznorm:Action ;
    rdfs:label "وكيل الجمهورية"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يمكن وكيل الجمهورية، قبل تحريك الدعوى العمومية، أن يعقد مع الشخص المعنوي الخاضع للقانون الخاص الضالع أو الشريك في جريمة أو أكثر من الجرائم المنصوص عليها في المادة 106 أدناه ، اتفاقية تتضمن إرجاء المتابعة الجزائية ضده، مقابل إرجاعه الأموال والممتلكات والعائدات المتصرف فيها أو المحولة إلى خارج التراب الوطني أو ما يمثل قيمتها و دفع كامل المبالغ المستحقة للخزينة العمومية و للأطراف العمومية المتضررة من الجرائم المنسوبة إليه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_105> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_105_condition_0_ac587abb_ref_6b83bc3e12b3> a dzdoc:Reference ;
    rdfs:label "المادة 106"@ar ;
    dzdoc:frbrUri "#art_106"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2025-08-03/25-14#art_106> ;
    dzdoc:sourceEId "art_105" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "يمكن وكيل الجمهورية، قبل تحريك الدعوى العمومية، أن يعقد مع الشخص المعنوي الخاضع للقانون الخاص الضالع أو الشريك في جريمة أو أكثر من الجرائم المنصوص عليها في المادة 106 أدناه ، اتفاقية تتضمن إرجاء المتابعة الجزائية ضده، مقابل إرجاعه الأموال والممتلكات والعائدات المتصرف فيها أو المحولة إلى خارج التراب الوطني أو ما يمثل قيمتها و دفع كامل المبالغ المستحقة للخزينة العمومية و للأطراف العمومية المتضررة من الجرائم المنسوبة إليه"@ar ;
    dzdoc:targetEId "art_106" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_105_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_105> ;
    dzdoc:position 0 ;
    dzdoc:text """يمكن وكيل الجمهورية، قبل تحريك الدعوى العمومية، أن يعقد مع الشخص المعنوي الخاضع للقانون الخاص الضالع أو الشريك في جريمة أو أكثر من الجرائم المنصوص عليها في المادة 106 أدناه ، اتفاقية تتضمن إرجاء المتابعة الجزائية ضده، مقابل إرجاعه الأموال والممتلكات والعائدات المتصرف فيها أو المحولة إلى خارج التراب الوطني أو ما يمثل قيمتها و دفع كامل المبالغ المستحقة للخزينة العمومية و للأطراف العمومية المتضررة من الجرائم المنسوبة إليه، إذا:
                
                
                توصل التحقيق الابتدائي إلى جمع أعباء كافية تجعل إدانة الشخص المعنوي جد مرجحة في حال متابعته،
                
                
                كان خيار إرجاء المتابعة يحقق النتيجة المرجوة من المحاكمة ويوفر الوقت الذي قد يستغرقه التحقيق القضائي،
                
                
                أمكن تقييم كافة الأضرار الناتجة عن الجريمة بالنسبة للخزينة العمومية وللمؤسسات العمومية،
                
                
                كانت المصلحة العامة وتحصيل حقوق الخزينة والأطراف العمومية المتضررة أكثر جدوى من العقوبات الأخرى التي قد تسلط على الشخص المعنوي،
                
                
                أبدى الشخص المعنوي تعاونه لأجل وضع حد للجريمة،
                
                
                اتخذ الشخص المعنوي إجراءات تأديبية ضد الشخص الطبيعي الذي ارتكب الجريمة باسمه أو لصالحه وبلغ السلطات القضائية به. توصل التحقيق الابتدائي إلى جمع أعباء كافية تجعل إدانة الشخص المعنوي جد مرجحة في حال متابعته، كان خيار إرجاء المتابعة يحقق النتيجة المرجوة من المحاكمة ويوفر الوقت الذي قد يستغرقه التحقيق القضائي، أمكن تقييم كافة الأضرار الناتجة عن الجريمة بالنسبة للخزينة العمومية وللمؤسسات العمومية، كانت المصلحة العامة وتحصيل حقوق الخزينة والأطراف العمومية المتضررة أكثر جدوى من العقوبات الأخرى التي قد تسلط على الشخص المعنوي، أبدى الشخص المعنوي تعاونه لأجل وضع حد للجريمة، اتخذ الشخص المعنوي إجراءات تأديبية ضد الشخص الطبيعي الذي ارتكب الجريمة باسمه أو لصالحه وبلغ السلطات القضائية به."""@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_105_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_105> ;
    dzdoc:position 1 ;
    dzdoc:text """لا يمكن اقتراح اتفاقية إرجاء المتابعة، إذا :
                
                
                تبين أن تأسيس الشخص المعنوي كان لأغراض احتيالية أو إجرامية،
                
                
                كان الشخص المعنوي مسبوقا في جريمة من الجرائم المنصوص عليها في المادة 106 أدناه. تبين أن تأسيس الشخص المعنوي كان لأغراض احتيالية أو إجرامية، كان الشخص المعنوي مسبوقا في جريمة من الجرائم المنصوص عليها في المادة 106 أدناه."""@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_105_permission_0_bcc5ba0a> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_105_permission_0_bcc5ba0a_action_96f4f9446d> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_105_permission_0_bcc5ba0a_role_5bd17d796a> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_105> ;
    dznorm:position 0 ;
    dznorm:provisionText """يمكن وكيل الجمهورية، قبل تحريك الدعوى العمومية، أن يعقد مع الشخص المعنوي الخاضع للقانون الخاص الضالع أو الشريك في جريمة أو أكثر من الجرائم المنصوص عليها في المادة 106 أدناه ، اتفاقية تتضمن إرجاء المتابعة الجزائية ضده، مقابل إرجاعه الأموال والممتلكات والعائدات المتصرف فيها أو المحولة إلى خارج التراب الوطني أو ما يمثل قيمتها و دفع كامل المبالغ المستحقة للخزينة العمومية و للأطراف العمومية المتضررة من الجرائم المنسوبة إليه، إذا:
                
                
                توصل التحقيق الابتدائي إلى جمع أعباء كافية تجعل إدانة الشخص المعنوي جد مرجحة في حال متابعته،
                
                
                كان خيار إرجاء المتابعة يحقق النتيجة المرجوة من المحاكمة ويوفر الوقت الذي قد يستغرقه التحقيق القضائي،
                
                
                أمكن تقييم كافة الأضرار الناتجة عن الجريمة بالنسبة للخزينة العمومية وللمؤسسات العمومية،
                
                
                كانت المصلحة العامة وتحصيل حقوق الخزينة والأطراف العمومية المتضررة أكثر جدوى من العقوبات الأخرى التي قد تسلط على الشخص المعنوي،
                
                
                أبدى الشخص المعنوي تعاونه لأجل وضع حد للجريمة،
                
                
                اتخذ الشخص المعنوي إجراءات تأديبية ضد الشخص الطبيعي الذي ارتكب الجريمة باسمه أو لصالحه وبلغ السلطات القضائية به. توصل التحقيق الابتدائي إلى جمع أعباء كافية تجعل إدانة الشخص المعنوي جد مرجحة في حال متابعته، كان خيار إرجاء المتابعة يحقق النتيجة المرجوة من المحاكمة ويوفر الوقت الذي قد يستغرقه التحقيق القضائي، أمكن تقييم كافة الأضرار الناتجة عن الجريمة بالنسبة للخزينة العمومية وللمؤسسات العمومية، كانت المصلحة العامة وتحصيل حقوق الخزينة والأطراف العمومية المتضررة أكثر جدوى من العقوبات الأخرى التي قد تسلط على الشخص المعنوي، أبدى الشخص المعنوي تعاونه لأجل وضع حد للجريمة، اتخذ الشخص المعنوي إجراءات تأديبية ضد الشخص الطبيعي الذي ارتكب الجريمة باسمه أو لصالحه وبلغ السلطات القضائية به."""@ar ;
    dznorm:sourceArticle "art_105" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_105_permission_0_bcc5ba0a_action_96f4f9446d> a dznorm:Action ;
    rdfs:label "وكيل الجمهورية"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan """يمكن وكيل الجمهورية، قبل تحريك الدعوى العمومية، أن يعقد مع الشخص المعنوي الخاضع للقانون الخاص الضالع أو الشريك في جريمة أو أكثر من الجرائم المنصوص عليها في المادة 106 أدناه ، اتفاقية تتضمن إرجاء المتابعة الجزائية ضده، مقابل إرجاعه الأموال والممتلكات والعائدات المتصرف فيها أو المحولة إلى خارج التراب الوطني أو ما يمثل قيمتها و دفع كامل المبالغ المستحقة للخزينة العمومية و للأطراف العمومية المتضررة من الجرائم المنسوبة إليه، إذا:
                
                
                توصل التحقيق الابتدائي إلى جمع أعباء كافية تجعل إدانة الشخص المعنوي جد مرجحة في حال متابعته،
                
                
                كان خيار إرجاء المتابعة يحقق النتيجة المرجوة من المحاكمة ويوفر الوقت الذي قد يستغرقه التحقيق القضائي،
                
                
                أمكن تقييم كافة الأضرار الناتجة عن الجريمة بالنسبة للخزينة العمومية وللمؤسسات العمومية،
                
                
                كانت المصلحة العامة وتحصيل حقوق الخزينة والأطراف العمومية المتضررة أكثر جدوى من العقوبات الأخرى التي قد تسلط على الشخص المعنوي،
                
                
                أبدى الشخص المعنوي تعاونه لأجل وضع حد للجريمة،
                
                
                اتخذ الشخص المعنوي إجراءات تأديبية ضد الشخص الطبيعي الذي ارتكب الجريمة باسمه أو لصالحه وبلغ السلطات القضائية به. توصل التحقيق الابتدائي إلى جمع أعباء كافية تجعل إدانة الشخص المعنوي جد مرجحة في حال متابعته، كان خيار إرجاء المتابعة يحقق النتيجة المرجوة من المحاكمة ويوفر الوقت الذي قد يستغرقه التحقيق القضائي، أمكن تقييم كافة الأضرار الناتجة عن الجريمة بالنسبة للخزينة العمومية وللمؤسسات العمومية، كانت المصلحة العامة وتحصيل حقوق الخزينة والأطراف العمومية المتضررة أكثر جدوى من العقوبات الأخرى التي قد تسلط على الشخص المعنوي، أبدى الشخص المعنوي تعاونه لأجل وضع حد للجريمة، اتخذ الشخص المعنوي إجراءات تأديبية ضد الشخص الطبيعي الذي ارتكب الجريمة باسمه أو لصالحه وبلغ السلطات القضائية به."""@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_105> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_105_permission_0_bcc5ba0a_role_5bd17d796a> a dznorm:Role ;
