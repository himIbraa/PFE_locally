<https://legal.dz/resource/law/2025-08-03/25-14#art_519_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_519> ;
    dzdoc:position 0 ;
    dzdoc:text "يلزم المدعي المدني الذي خسر دعواه بالمصاريف القضائية حتى في الحالة المشار إليها في المادة 383 أعلاه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_519_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_519> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أن للمحكمة مع ذلك أن تعفيه منها كلها أو جزء منها."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_51_condition_0_287553a0> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2025-08-03/25-14#art_51_condition_0_287553a0_ref_83be30c70842> ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_50> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_50> ;
    dznorm:conditionText "إذا كان طلب التجميد و/ أو الحجز يستند إلى أسباب كافية أو إلى عناصر معقولة ترجح أن تكون الممتلكات والأموال عائدات غير مشروعة لإحدى الجرائم المنصوص عليها في المادة 50 أعلاه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_51> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_51_condition_0_287553a0_ref_83be30c70842> a dzdoc:Reference ;
    rdfs:label "المادة 50"@ar ;
    dzdoc:frbrUri "#art_50"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2025-08-03/25-14#art_50> ;
    dzdoc:sourceEId "art_51" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "إذا كان طلب التجميد و/ أو الحجز يستند إلى أسباب كافية أو إلى عناصر معقولة ترجح أن تكون الممتلكات والأموال عائدات غير مشروعة لإحدى الجرائم المنصوص عليها في المادة 50 أعلاه"@ar ;
    dzdoc:targetEId "art_50" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_51_condition_1_4f27e90a> a dznorm:Condition ;
    dznorm:conditionText "إذا فتح تحقيق قضائي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_51> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_51_obligation_0_ab856ed0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_51> ;
    dznorm:position 0 ;
    dznorm:provisionText "يقدم وكيل الجمهورية إلى رئيس المحكمة المختص عريضة يبين فيها الأسباب التي تبرر اتخاذ الإجراءات التحفظية المذكورة أعلاه"@ar ;
    dznorm:sourceArticle "art_51" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_51_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_51> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن وكيل الجمهورية تلقائيا أو بناء على طلب مسبب من ضابط الشرطة القضائية، خلال التحريات الأولية، أن يطلب من رئيس المحكمة المختص اتخان إجراءات تحفظية لحجز الأموال و/ أو تجميد أي عملية بنكية لأي شخص طبيعي أو معنوي تقع عليه شبهات قوية لتورطه في إحدى الجرائم المنصوص عليها في المادة 50 أعلاه، فضلا عن إمكانية إخطار الهيئة المختصة في مجال الوقاية من جرائم تبييض الأموال وتمويل الإرهاب ومكافحتها قصد الاعتراض التحفظي على التحويلات البنكية وفقا للتشريع الساري المفعول."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_51_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_51> ;
    dzdoc:position 1 ;
    dzdoc:text "يقدم وكيل الجمهورية إلى رئيس المحكمة المختص عريضة يبين فيها الأسباب التي تبرر اتخاذ الإجراءات التحفظية المذكورة أعلاه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_51_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_51> ;
    dzdoc:position 2 ;
    dzdoc:text "إذا كان طلب التجميد و/ أو الحجز يستند إلى أسباب كافية أو إلى عناصر معقولة ترجح أن تكون الممتلكات والأموال عائدات غير مشروعة لإحدى الجرائم المنصوص عليها في المادة 50 أعلاه، يأمر رئيس المحكمة فورا بتجميد و/أو بحجز الأموال والممتلكات موضوع الطلب."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_51_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_51> ;
    dzdoc:position 3 ;
    dzdoc:text "إذا فتح تحقيق قضائي، يكون قاضي التحقيق مختصا في اتخاذ الإجراءات التحفظية المنصوص عليها في هذه المادة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_51_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_51> ;
    dzdoc:position 4 ;
    dzdoc:text "ينفذ الأمر المتضمن الإجراءات التحفظية بسعي من النيابة العامة بناء على نسخته الأصلية وقبل تبليغه للطرف المعني بالعملية."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_51_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_51> ;
    dzdoc:position 5 ;
    dzdoc:text "يمكن تبليغ الأمر المذكور، بسعي من النيابة العامة إلى المؤسسات المالية مباشرة أو عن طريق الهيئة المختصة في مجال الوقاية من جرائم تبييض الأموال وتمويل الإرهاب ومكافحتها، التي ترسل لها نسخة منه."@ar .

