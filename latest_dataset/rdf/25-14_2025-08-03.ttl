<https://legal.dz/resource/law/2025-08-03/25-14#version_art_645> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أمر قاضي التحقيق وضع المتهم المسموع عن طريق المحادثة المرئية عن بعد رهن الحبس المؤقت ، يقوم عن طريق نفس التقنية، بتبليغه هذا الأمر شفاهة ويحيطه علما بـ حقوقه المنصوص عليها في المادة 201 أعلاه ، وينوه عن ذلك في محضر السماع. ترسل نسخة من الأمر بالإيداع للتنفيذ، عن طريق إحدى وسائل الاتصال، حسب الحالة، إلى وكيل الجمهورية أو مدير المؤسسة العقابية عن طريق وكيل الجمهورية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_645_20250803_OpEnact_2ba90138c5> ;
    dzdoc:replacementText "إذا أمر قاضي التحقيق وضع المتهم المسموع عن طريق المحادثة المرئية عن بعد رهن الحبس المؤقت ، يقوم عن طريق نفس التقنية، بتبليغه هذا الأمر شفاهة ويحيطه علما بـ حقوقه المنصوص عليها في المادة 201 أعلاه ، وينوه عن ذلك في محضر السماع. ترسل نسخة من الأمر بالإيداع للتنفيذ، عن طريق إحدى وسائل الاتصال، حسب الحالة، إلى وكيل الجمهورية أو مدير المؤسسة العقابية عن طريق وكيل الجمهورية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_645> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
