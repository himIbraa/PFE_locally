<https://legal.dz/resource/law/2025-08-03/25-14#version_art_147> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لكل شخص متضرر من جناية أو جنحة غير مرتبطتين بوقائع معروضة على القضاء، أن يدعي مدنيا بأن يتقدم بشكواه أمام قاضي التحقيق المختص . لا تكون الشكوى المصحوبة بادعاء مدني مقبولة إلا إذا أثبت المعني أنه سبق له تقديم شكوى من أجل نفس الأفعال وضد نفس الشخص أو الأشخاص أمام وكيل الجمهورية وتم حفظها أو أنه مر على إيداعها أجل أربعة (4) أشهر وتأكد قاضي التحقيق أنه لم يتخذ بشأنها قرارا بتحريك الدعوى العمومية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_147_20250803_OpEnact_1aed610704> ;
    dzdoc:replacementText "يجوز لكل شخص متضرر من جناية أو جنحة غير مرتبطتين بوقائع معروضة على القضاء، أن يدعي مدنيا بأن يتقدم بشكواه أمام قاضي التحقيق المختص . لا تكون الشكوى المصحوبة بادعاء مدني مقبولة إلا إذا أثبت المعني أنه سبق له تقديم شكوى من أجل نفس الأفعال وضد نفس الشخص أو الأشخاص أمام وكيل الجمهورية وتم حفظها أو أنه مر على إيداعها أجل أربعة (4) أشهر وتأكد قاضي التحقيق أنه لم يتخذ بشأنها قرارا بتحريك الدعوى العمومية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_147> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
