<https://legal.dz/resource/law/2025-08-03/25-14#version_art_158> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا حصل التفتيش في مسكن المتهم ، فعلى قاضي التحقيق أن يلتزم بأحكام المواد من 76 إلى 78 من هذا القانون ، غير أنه يجوز له وحده في مواد الجنايات أن يقوم بتفتيش مسكن المتهم في غير الساعات المحددة في المادة 78 أعلاه ، ده، بشرط أن يباشر التفتيش بنفسه وأن يتم ذلك بحضور وكيل الجمهورية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_158_20250803_OpEnact_c2f23fa700> ;
    dzdoc:replacementText "إذا حصل التفتيش في مسكن المتهم ، فعلى قاضي التحقيق أن يلتزم بأحكام المواد من 76 إلى 78 من هذا القانون ، غير أنه يجوز له وحده في مواد الجنايات أن يقوم بتفتيش مسكن المتهم في غير الساعات المحددة في المادة 78 أعلاه ، ده، بشرط أن يباشر التفتيش بنفسه وأن يتم ذلك بحضور وكيل الجمهورية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
