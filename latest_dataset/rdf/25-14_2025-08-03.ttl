<https://legal.dz/resource/law/2025-08-03/25-14#version_art_862> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مع مراعاة الاستثناءات المنصوص عليها فيما يلي، لا يقبل التسليم إلا بشرط أن لا يكون الشخص المسلم موضوع متابعة أو أن لا يحكم عليه في جريمة خلاف تلك التي بررت التسليم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_862_20250803_OpEnact_aba0f316f0> ;
