<https://legal.dz/resource/law/2025-08-03/25-14#version_art_592> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان المستأنف محبوسا جاز له كذلك أن يعمل تقرير استئنافه في المواعيد المنصوص عليها في المادة 588 أعلاه لدى أمين ضبط المؤسسة العقابية ، حيث يتلقى ويقيد في الحال في سجل خاص. ويسلم إليه إيصال عنه. ويتعين على مدير المؤسسة العقابية، تحت طائلة العقوبات التأديبية، أن يرسل نسخة من هذا التقرير خلال أربع وعشرين (24) ساعة إلى أمانة ضبط الجهة القضائية التي أصدرت الحكم المطعون فيه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_592_20250803_OpEnact_4bc310fe68> ;
    dzdoc:replacementText "إذا كان المستأنف محبوسا جاز له كذلك أن يعمل تقرير استئنافه في المواعيد المنصوص عليها في المادة 588 أعلاه لدى أمين ضبط المؤسسة العقابية ، حيث يتلقى ويقيد في الحال في سجل خاص. ويسلم إليه إيصال عنه. ويتعين على مدير المؤسسة العقابية، تحت طائلة العقوبات التأديبية، أن يرسل نسخة من هذا التقرير خلال أربع وعشرين (24) ساعة إلى أمانة ضبط الجهة القضائية التي أصدرت الحكم المطعون فيه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_592> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
