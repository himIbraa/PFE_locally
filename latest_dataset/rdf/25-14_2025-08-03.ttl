<https://legal.dz/resource/law/2025-08-03/25-14#version_art_759> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتولى المصالح المختصة التابعة للجهات القضائية تحصيل مبلغ الغرامات والمصاريف القضائية . يعتبر مستخرج الحكم النهائي بالعقوبة سندا يسوغ بمقتضاه متابعة استخلاص الأداء بكل الطرق القانونية من مال المحكوم عليه. يكون الأداء واجبا بمجرد صيرورة الأوامر والأحكام والقرارات الجزائية القاضية بالإدانة حائزة على قوة الشيء المقضي به . تحدد شروط وكيفيات تطبيق هذه المادة، عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_759_20250803_OpEnact_3260ffd06f> ;
    dzdoc:replacementText "تتولى المصالح المختصة التابعة للجهات القضائية تحصيل مبلغ الغرامات والمصاريف القضائية . يعتبر مستخرج الحكم النهائي بالعقوبة سندا يسوغ بمقتضاه متابعة استخلاص الأداء بكل الطرق القانونية من مال المحكوم عليه. يكون الأداء واجبا بمجرد صيرورة الأوامر والأحكام والقرارات الجزائية القاضية بالإدانة حائزة على قوة الشيء المقضي به . تحدد شروط وكيفيات تطبيق هذه المادة، عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_759> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
