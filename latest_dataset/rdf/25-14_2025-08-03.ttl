<https://legal.dz/resource/law/2025-08-03/25-14#art_121_condition_0_664a2209> a dznorm:Condition ;
    dznorm:conditionText "عند الضرورة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_121> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_121_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_121> ;
    dzdoc:position 1 ;
    dzdoc:text "يسمح لـضابط أو عون الشرطة القضائية أن يستعمل لهذا الغرض، هوية مستعارة و أن يرتكب، عند الضرورة، الأفعال المذكورة في المادة 123 أدناه ، ولا يجوز، تحت طائلة البطلان، أن تشكل هذه الأفعال تحريضا على ارتكاب جرائم."@ar .

