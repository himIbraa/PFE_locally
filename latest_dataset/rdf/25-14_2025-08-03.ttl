<https://legal.dz/resource/law/2025-08-03/25-14#art_562_obligation_0_f6a5a741> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
