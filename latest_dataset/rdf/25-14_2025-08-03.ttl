    dzdoc:number "887" ;
    dzdoc:position 885 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_883>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_884>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_885>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_886> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_883>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_884>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_885>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_886> ;
