<https://legal.dz/resource/law/2025-08-03/25-14#art_445_condition_0_78fe66ea> a dznorm:Condition ;
    dznorm:conditionText "في حالة الإدانة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_445> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_445_condition_1_f802d73c> a dznorm:Condition ;
    dznorm:conditionText "فإذا كانت الإدانة لا تتناول جميع الجرائم موضوع المتابعة، أو لم تكن إلا عن جرائم جرى عليها تعيل الوصف القانوني للوقائع موضوع الاتهام، سواء أكان ذلك أثناء سير التحقيق أو كان وقت النطق بالحكم ، وكذلك في حالة إخراج متهمين معينين من الدعوى"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_445> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_445_condition_2_9a1d2e2d> a dznorm:Condition ;
