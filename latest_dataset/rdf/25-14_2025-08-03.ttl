    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_575_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_575> ;
    dzdoc:position 0 ;
    dzdoc:text "المادة 575 : إذا كان المتهم يستفيد من أي عذر يعفيه من العقاب، قضت بإعفائه وتفصل، عند الاقتضاء، في الدعوى المدنية كما هو وارد في المادة 572 أعلاه."@ar .

