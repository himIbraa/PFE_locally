    dznorm:sourceArticle "art_303" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_303_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_303> ;
    dzdoc:position 0 ;
    dzdoc:text "يرفع الأمر لغرفة الاتهام إما من النائب العام أو من رئيسها عن الإخلالات المنسوبة لضباط وأعوان الشرطة القضائية والموظفين والأعوان المنوطة بهم بعض مهام الضبط القضائي في مباشرة وظائفهم، ولها أن تنظر في ذلك من تلقاء نفسها بمناسبة النظر في قضية مطروحة عليها."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_303_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_303> ;
    dzdoc:position 1 ;
    dzdoc:text "يتم إعلام النائب العام العسكري المختص إقليميا إذا تعلق الأمر بضباط الشرطة القضائية للدرك الوطني."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_303_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_303> ;
    dzdoc:position 2 ;
    dzdoc:text "غير أن غرفة الاتهام لدى مجلس قضاء الجزائر تعتبر صاحبة الاختصاص وحدها ، إذا تعلق الأمر بضباط وأعوان الشرطة القضائية للمصالح العسكرية للأمن، وتحال عليها القضية من طرف النائب العام لدى نفس المجلس القضائي، بعد رأي النائب العام العسكري المختص إقليميا، الذي يبديه في أجل خمسة عشر (15) يوما من إخطاره."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_304_condition_0_b2b60ee4> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_304_condition_0_b2b60ee4_role_f92c8732fe> ;
    dznorm:conditionText "إذا ما طرح الأمر على غرفة الاتهام"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_304> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_304_condition_0_b2b60ee4_role_f92c8732fe> a dznorm:Role ;
    rdfs:label "غرفة الاتهام"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "إذا ما طرح الأمر على غرفة الاتهام"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_304> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_304_obligation_0_ebcf36d7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_304> ;
    dznorm:position 0 ;
    dznorm:provisionText "تأمر بإجراء تحقيق و تسمع طلبات النائب العام وأوجه دفاع ضابط أو عون الشرطة القضائية أو الموظف أو العون المنوطة به بعض مهام الضبط القضائي، صاحب الشأن"@ar ;
    dznorm:sourceArticle "art_304" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_304_obligation_1_97b3366b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_304_obligation_1_97b3366b_role_892d5e97ad> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_304> ;
    dznorm:position 1 ;
    dznorm:provisionText "يتعين أن يكون هذا الأخير قد مكن مقدما من الاطلاع على ملفه المحفوظ لدى النيابة العامة للمجلس القضائي"@ar ;
    dznorm:sourceArticle "art_304" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_304_obligation_1_97b3366b_role_892d5e97ad> a dznorm:Role ;
    rdfs:label "ملفه المحفوظ لدى النيابة"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يتعين أن يكون هذا الأخير قد مكن مقدما من الاطلاع على ملفه المحفوظ لدى النيابة العامة للمجلس القضائي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_304> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_304_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_304> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا ما طرح الأمر على غرفة الاتهام، فإنها تأمر بإجراء تحقيق و تسمع طلبات النائب العام وأوجه دفاع ضابط أو عون الشرطة القضائية أو الموظف أو العون المنوطة به بعض مهام الضبط القضائي، صاحب الشأن، ويتعين أن يكون هذا الأخير قد مكن مقدما من الاطلاع على ملفه المحفوظ لدى النيابة العامة للمجلس القضائي."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_304_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_304> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجوز لضابط أو عون الشرطة القضائية أو الموظف أو العون المنوطة به بعض مهام الضبط القضائي محل الإجراء التأديبي أن يستعين بمحام للدفاع عنه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_304_right_0_3f5689a9> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
