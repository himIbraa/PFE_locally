    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 612" ;
    dzdoc:position 611 ;
    dzdoc:usesTerm dzterm:clerk_office,
        dzterm:judicial_bailiff,
        dzterm:judicial_police,
        dzterm:summons .

<https://legal.dz/resource/law/2025-08-03/25-14#art_627> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_4_sec_1> ;
    dzdoc:eId "art_627" ;
    dzdoc:fullText "يتولى قسم تطبيق العقوبات بمحكمة مقر المجلس القضائي، الذي يرأسه قاضي تطبيق العقوبات ، الفصل في طلبات تكييف العقوبات السالبة للحرية . تفصل غرفة تطبيق العقوبات بالمجلس القضائي في استئناف الأحكام الصادرة عن قسم تطبيق العقوبات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_627> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_627_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_627_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_627_20250803_OpEnact_09204d6f27> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_627_obligation_0_579d93a1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_627_obligation_1_19153c6a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "627" ;
    dzdoc:position 625 ;
    dzdoc:usesTerm dzterm:punishment_application_chamber,
        dzterm:punishment_application_department,
        dzterm:punishment_application_judge .

<https://legal.dz/resource/law/2025-08-03/25-14#art_636> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_4_sec_2> ;
    dzdoc:eId "art_636" ;
    dzdoc:fullText "تفصل غرفة تطبيق العقوبات بالمجلس القضائي في الاستئناف بتشكيلة تتكون من ثلاث قضاة ، ويباشر مهام النيابة العامة النائب العام أو أحد مساعديه ويمارس مهام أمانة الضبط أمين ضبط الجلسة. يفصل في الاستئناف، في أحسن الآجال في جلسة علنية، بعد تقرير شفوي من أحد المستشارين وسماع المعني و/أو دفاعه وتقديم النيابة العامة لطلباتها. إن حضور المحكوم عليه غير إلزامي على مستوى الاستئناف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_636> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_636_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_636_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_636_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_636_20250803_OpEnact_4862909caa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_636_obligation_0_5b4ce7c8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "636" ;
    dzdoc:position 634 ;
    dzdoc:usesTerm dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_645> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_5_chp_2> ;
    dzdoc:eId "art_645" ;
    dzdoc:fullText "إذا أمر قاضي التحقيق وضع المتهم المسموع عن طريق المحادثة المرئية عن بعد رهن الحبس المؤقت ، يقوم عن طريق نفس التقنية، بتبليغه هذا الأمر شفاهة ويحيطه علما بـ حقوقه المنصوص عليها في المادة 201 أعلاه ، وينوه عن ذلك في محضر السماع. ترسل نسخة من الأمر بالإيداع للتنفيذ، عن طريق إحدى وسائل الاتصال، حسب الحالة، إلى وكيل الجمهورية أو مدير المؤسسة العقابية عن طريق وكيل الجمهورية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_645_right_0_566469c9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_645> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_645_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_645_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_645_20250803_OpEnact_2ba90138c5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "645" ;
    dzdoc:position 643 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_201> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_201> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_645_condition_0_6abd5b38> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_646> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_5_chp_3> ;
    dzdoc:eId "art_646" ;
    dzdoc:fullText "المادة 646 : يمكن جهات الحكم أن تلجأ لاستعمال المحادثة المرئية عن بعد ، من تلقاء نفسها أو بناء على طلب النيابة العامة أو أحد الخصوم أو دفاعهم، في استجواب أو سماع شخص أو في إجراء المواجهة بين الأشخاص."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_646_permission_0_e112cdd1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_646> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_646_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_646_20250803_OpEnact_b4da212e6c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "646" ;
    dzdoc:position 644 ;
    dzdoc:usesTerm dzterm:judicial_body,
        dzterm:public_prosecution,
        dzterm:video_conferencing .

<https://legal.dz/resource/law/2025-08-03/25-14#art_649> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_5_chp_3> ;
    dzdoc:eId "art_649" ;
    dzdoc:fullText "تطبق أحكام الحالة 2 من المادة 497 أعلاه، في حال رفض المتهم الإجابة أو قرر التخلف عن الحضور إذا تقرر إجراء المحاكمة باستعمال المحادثة المرئية عن بعد. يمكن استعمال المحادثة المرئية عن بعد عند النطق بالحكم، ويكون الحكم في هذه الحالة حضوريا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_649_permission_0_0cc6ea2f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_649> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_649_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_649_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_649_20250803_OpEnact_a5da49c4fa> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "649" ;
    dzdoc:position 647 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_497> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_497> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_670> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_3> ;
    dzdoc:eId "art_670" ;
    dzdoc:fullText "مع مراعاة أحكام المادة 664 أعلاه ، يجب أن تكون مذكرات الطعن مصحوبة، بما يثبت سداد الرسم القضائي إما بحوالة بريد مرسلة باسم أمين الضبط الرئيسي للمحكمة العليا بقيمة مبلغ الرسم القضائي أو بإيصال يثبت دفع الرسم المذكور."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_670> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_670_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_670_20250803_OpEnact_458323d067> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_670_obligation_0_d5121f93> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 670" ;
    dzdoc:position 668 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_664> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_664> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_670_condition_0_4820630e> ;
    dzdoc:usesTerm dzterm:chief_clerk,
        dzterm:judicial_fee .

<https://legal.dz/resource/law/2025-08-03/25-14#art_688> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_6> ;
    dzdoc:eId "art_688" ;
    dzdoc:fullText "يثبت التنازل عن الطعن بالنقض بموجب أمر من الرئيس الأول للمحكمة العليا أو من رئيس الغرفة المختصة ، وذلك في أية حالة كانت عليها الإجراءات. يؤشر على طلب التنازل عن الطعن بالنقض أمين ضبط المؤسسة العقابية أو أمين ضبط الجهة القضائية المطعون في قرارها أو أمين ضبط المحكمة العليا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_688> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_688_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_688_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_688_20250803_OpEnact_253497e7d3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_688_obligation_0_8963ee47> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 688" ;
    dzdoc:position 686 ;
    dzdoc:usesTerm dzterm:cassation_appeal,
        dzterm:chamber_president,
        dzterm:clerk,
        dzterm:first_president .

<https://legal.dz/resource/law/2025-08-03/25-14#art_698> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_1> ;
    dzdoc:eId "art_698" ;
    dzdoc:fullText "يجوز ل قاضي التحقيق أن يكلف من تخصه جميع أوراق المضاهاة بتسليمها ويتخذ إجراء بحجزها. ويوقع على هذه الأوراق بإمضائه وإمضاء أمين الضبط الذي يحرر عنها محضرا بأوصافها حسبماهو مقرر ب المادة 697 أعلاه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_698_permission_0_7506c7d2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_698> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_698_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_698_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_698_20250803_OpEnact_8a0b2c3dd2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "698" ;
    dzdoc:position 696 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_697> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_697> ;
    dzdoc:usesTerm dzterm:investigating_judge .

<https://legal.dz/resource/law/2025-08-03/25-14#art_715> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_5> ;
    dzdoc:eId "art_715" ;
    dzdoc:fullText "إذا انقضت مهلة الإيداع المحددة في المادة 714 أعلاه ، فإنه يفصل في الطلبات خلال عشرة (10) أيام بغرفة المشورة من الرئيس الأول ورؤساء الغرف بالمحكمة العليا . ويبلغ القرار إلى أطراف النزاع الذين يعنيهم الأمر من طرف مصالح النيابة العامة لدى المحكمة المذكورة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_715> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_715_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_715_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_715_20250803_OpEnact_39101fcb00> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_715_obligation_0_1ba3770d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "715" ;
    dzdoc:position 713 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_714> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_714> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_715_condition_0_00977add> ;
    dzdoc:usesTerm dzterm:public_prosecution,
        dzterm:supreme_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_722> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_6> ;
    dzdoc:eId "art_722" ;
    dzdoc:fullText "على كل من ينوي الرد أن يقوم به قبل كل مرافعة في الموضوع ، وإذا كان القاضي المطلوب رده مكلفا بالتحقيق فيكون إبداء الرد قبل كل استجواب أو سماع أقوال في الموضوع ما لم تكن أسباب الرد قد تحققت أو تكشفت فيما بعد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_722> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_722_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_722_20250803_OpEnact_325a91ed30> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_722_obligation_0_50f735d8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "722" ;
    dzdoc:position 720 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_722_condition_0_3e325074> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_723> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_6> ;
    dzdoc:eId "art_723" ;
    dzdoc:fullText "يقدم طلب الرد كتابة . ويجب، تحت طائلة البطلان، أن يعين فيه اسم ولقب القاضي المطلوب رده، و أن يشتمل عرض الأوجه المدعى بها، وأن يكون مصحوبا بكل المبررات اللازمة، وأن يوقع عليه من الطالب شخصيا ويوجه إلى رئيس المجلس القضائي إذا تعلق بقاض من قضاة محاكم دائرة ذلك المجلس أو إلى الرئيس الأول للمحكمة العليا إذا تعلق بأحد قضاة مجلس قضائي ، وذلك مع مراعاة أحكام المادة 727 أدناه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_723> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_723_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_723_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_723_20250803_OpEnact_e758892331> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_723_obligation_0_5818b93a>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_723_obligation_1_2846dfca> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "723" ;
    dzdoc:position 721 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_727> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_727> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_733> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_7> ;
    dzdoc:eId "art_733" ;
    dzdoc:fullText "إذا ارتكبت جنحة أو مخالفة في جلسة محكمة تنظر فيها قضايا الجنح أو المخالفات ، أمر الرئيس بتحرير محضر عنها وقضى فيها في الحال بعد سماع أقوال المتهم والشهود و النيابة العامة والدفاع، عند الاقتضاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_733> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_733_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_733_20250803_OpEnact_990e908bc7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "733" ;
    dzdoc:position 731 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_733_condition_0_78148b41> ;
    dzdoc:usesTerm dzterm:president,
        dzterm:public_prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_749> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_9> ;
    dzdoc:eId "art_749" ;
    dzdoc:fullText "تجرى المتابعة بناء على طلب النيابة العامة لمحل إقامة المتهم أو مكان آخر محل إقامة معروف له أو مكان القبض عليه ، إذا لم يتقرر اختصاص إقليمي آخر بموجب القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_749> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_749_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_749_20250803_OpEnact_699b849f52> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_749_obligation_0_5dd70704> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "749" ;
    dzdoc:position 747 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_749_condition_0_6473d52d> ;
    dzdoc:usesTerm dzterm:prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_761> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_3> ;
    dzdoc:eId "art_761" ;
    dzdoc:fullText "يستفيد المحكوم عليه من تخفيض نسبته %10 من قيمة الغرامة المحكوم بها ، في حالة تسديدها طوعا لدى المصالح المختصة بالجهات القضائية خلال ثلاثين (30) يوما من تاريخ تبليغه بالإشعار بالدفع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_761_right_0_475a6df9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_761> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_761_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_761_20250803_OpEnact_2468bdfe29> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 761" ;
    dzdoc:position 759 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_761_condition_0_29583d59> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_772> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_3> ;
    dzdoc:eId "art_772" ;
    dzdoc:fullText "إذا حصل نزاع يقتاد المحكوم عليه بـ الإكراه البدني المقبوض عليه أو المحبوس إلى رئيس المحكمة التي يقع بدائرتها محل القبض عليه أو حبسه. فإذا كان النزاع يتعلق بصحة إجراءات الإكراه البدني ، يقوم رئيس المحكمة بالفصل فيه على وجه الاستعجال ، ويكون قراره واجب النفاذ رغم الاستئناف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_772> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_772_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_772_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_772_20250803_OpEnact_984301095b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "772" ;
    dzdoc:position 770 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_772_condition_0_d1abd770>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_772_condition_1_1987d232> ;
    dzdoc:usesTerm dzterm:bodily_coercion,
        dzterm:convicted .

<https://legal.dz/resource/law/2025-08-03/25-14#art_779> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_4> ;
    dzdoc:eId "art_779" ;
    dzdoc:fullText "تتقادم العقوبات الصادرة بقرار أو بحكم يتعلق بموضوع الجنح بعد مضي خمس (5) سنوات كاملة، ابتداء من التاريخ الذي يصبح فيه هذا القرار أو الحكم نهائيا وحائزا لقوة الشيء المقضي فيه. غير أنه إذا كانت عقوبة الحبس المقضي بها تزيد على الخمس (5) سنوات ، فإن مدة التقادم تكون مساوية لهذه المدة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_779> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_779_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_779_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_779_20250803_OpEnact_014f4fa137> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "779" ;
    dzdoc:position 777 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_779_condition_0_7853e8ee> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_787> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_1> ;
    dzdoc:eId "art_787" ;
    dzdoc:fullText "يوجه طلب صحيفة السوابق القضائية إلى النائب العام أو إلى وكيل الجمهورية لدى المحكمة المرتبطة بالنظام الآلي الوطني لصحيفة السوابق القضائية . يحرر ويوقع أمين الضبط القسائم رقم 2 والقسائم رقم 3 المسلمة من طرف الجهات القضائية المرتبطة بالنظام الآلي الوطني لصحيفة السوابق القضائية، ويؤشر عليها النائب العام أو وكيل الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_787> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_787_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_787_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_787_20250803_OpEnact_667d14b1e9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_787_obligation_0_0a81d357>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_787_obligation_1_e20cd45f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "787" ;
    dzdoc:position 785 ;
    dzdoc:usesTerm dzterm:clerk,
        dzterm:criminal_record,
        dzterm:prosecutor,
        dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_792> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_1> ;
    dzdoc:eId "art_792" ;
    dzdoc:fullText "تحرر القسائم رقم 1 المثبتة لقرار تأديبي صادر من سلطة إدارية يترتب عليه أو يقرر التجريد من بعض الأهليات بمعرفة أمانة ضبط المحكمة أو المجلس القضائي التي يقع بدائرتها محل ميلاد الشخص الذي أفقدت أهليته أو صحيفة السوابق القضائية المركزية، إذا كان الشخص المذكور مولودا خارج الجزائر وذلك بعد الإبلاغ عن ذلك القرار بواسطة الجهة التي أصدرته . وتحرر القسائم رقم 1 المثبتة لقرار الطرد أو الإبعاد بمعرفة وزارة الداخلية وترسل للمصلحة المركزية لصحيفة السوابق القضائية أو مصلحة صحيفة السوابق القضائية بمحل الميلاد، إذا كان المستبعد مولودا بالجزائر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_792> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_792_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_792_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_792_20250803_OpEnact_64fb8c0746> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_792_obligation_0_8c6ee5dc>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_792_obligation_1_16d9afe0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "792" ;
    dzdoc:position 790 ;
    dzdoc:usesTerm dzterm:ministry_interior .

<https://legal.dz/resource/law/2025-08-03/25-14#art_803> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_1> ;
    dzdoc:eId "art_803" ;
    dzdoc:fullText "إذا لم توجد قسيمة تحمل رقم 1 في ملف صحيفة السوابق القضائية للشخص، أو إذا كانت البيانات التي تحويها القسيمة رقم 1 مما يجب أن لا يثبت على القسيمة رقم 3 ، فإن هذه الأخيرة يصير إلغاؤها بخط مستعرض."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_803> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_803_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_803_20250803_OpEnact_a901a75790> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "803" ;
    dzdoc:position 801 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_803_condition_0_bc3a5436> ;
    dzdoc:usesTerm dzterm:bulletin_1,
        dzterm:bulletin_3,
        dzterm:criminal_record .

<https://legal.dz/resource/law/2025-08-03/25-14#art_805> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_1> ;
    dzdoc:eId "art_805" ;
    dzdoc:fullText "يخطر النائب العام أو وكيل الجمهورية أمين ضبط المحكمة الكائن بدائرتها محل الميلاد أو القاضي المكلف بمصلحة صحيفة السوابق القضائية المركزية بأوامر القبض وبالأحكام والقرارات الصادرة بعقوبات مقيدة للحرية حضورية كانت أو غيابية والتي لم يجر تنفيذها . و تحفظ هذه الإخطارات بملف صحيفة السوابق القضائية ، ويعاد إرسالها ومعها كافة الإيضاحات الموصلة إلى تنفيذ الأوامر والأحكام والقرارات إلى السلطات القضائية التي أصدرتها بمعرفة أمين ضبط محكمة محل الميلاد أو القاضي المكلف بمصلحة صحيفة السوابق القضائية المركزية ، وذلك كلما طلب أصحاب الشأن نسخة من القسيمة رقم 3 أو كلما طلبت بشأنهم قسيمة رقم 2 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_805> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_805_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_805_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_805_20250803_OpEnact_801f3c74c9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_805_obligation_0_7187a1d8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "805" ;
    dzdoc:position 803 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_805_condition_0_e66673d6> ;
    dzdoc:usesTerm dzterm:bulletin_2,
        dzterm:bulletin_3,
        dzterm:central_criminal_record,
        dzterm:clerk,
        dzterm:criminal_record,
        dzterm:judge,
        dzterm:prosecutor,
        dzterm:prosecutor_general .

<https://legal.dz/resource/law/2025-08-03/25-14#art_811> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_1> ;
    dzdoc:eId "art_811" ;
    dzdoc:fullText "تحرر صورة ثانية طبق الأصل من القسيمة رقم 1 خلاف تلك المنوه عليها في المادة 796 أعلاه، وذلك عن كل العقوبات المقيدة للحرية أو الصادرة بالغرامة في جناية أو جنحة ضد شخص أجنبي ينتمي إلى أحد البلدان التي يجري معها التبادل الدولي . وترسل هذه الصورة الثانية لوزير العدل من أجل توجيهها بالطريق الدبلوماسي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_811> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_811_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_811_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_811_20250803_OpEnact_fd67030d0c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_811_obligation_0_e4871b0a>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_811_obligation_1_db2a42a4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "811" ;
    dzdoc:position 809 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_796> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_796> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_818> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:definesTerm dzterm:criminal_record_definition ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_2> ;
    dzdoc:eId "art_818" ;
    dzdoc:fullText "صحيفة السوابق القضائية للشخص المعنوي هي بيان كامل عن مجموع العقوبات والجزاءات الخاصة به والتي لم يمحها رد الاعتبار. وعند عدم وجود عقوبة أو جزاء ، تسلم صحيفة السوابق القضائية وتحمل عبارة \"لا شيء\"."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_818> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_818_defocc_4ebbd0ac6935> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_818_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_818_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_818_20250803_OpEnact_752fce8a67> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 818" ;
    dzdoc:position 816 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_818_condition_0_5ad306de> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_832> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:definesTerm dzterm:addiction_record ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_4> ;
    dzdoc:eId "art_832" ;
    dzdoc:fullText "صحيفة الإدمان على المواد الكحولية والمخدرات والمؤثرات العقلية هي بيان كامل بالعقوبات المتعلقة بالشخص نفسه التي لم يمحها رد الاعتبار . فإذا لم توجد عقوبات ، تذكر في القسيمة عبارة \"لا شيء\". لا تسلم صحيفة الإدمان على المواد الكحولية والمخدرات والمؤثرات العقلية، إلا إلى : المعني بالأمر، القضاة ، وزير الدفاع الوطني ، وزير الداخلية . وزير النقل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_832> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_832_defocc_6429e2dc2634> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_832_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_832_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_832_20250803_OpEnact_6c960579f2> ;
