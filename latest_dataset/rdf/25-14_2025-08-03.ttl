    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_114> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_116> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب أن يتضمن الإذن المذكور في المادة 114 أعلاه، كل العناصر التي تسمح بالتعرف على الاتصالات المطلوب التقاطها والأماكن المقصودة، سكنية أو غيرها، والجريمة التي تبرر اللجوء إلى هذه التدابير ، ومدتها."@ar ;
    dznorm:sourceArticle "art_116" .

