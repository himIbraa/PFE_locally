    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_423> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_424_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_424> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز لممثل النيابة العامة والمحامي المتهم أو الضحية أو الطرف المدني توجيه الأسئلة مباشرة إلى كل شخص يتم سماعه في الجلسة بعد إذن الرئيس وتحت رقابته، الذي له أن يأمر بسحب السؤال أو عدم الإجابة عنه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_424_permission_0_f1839a69> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
