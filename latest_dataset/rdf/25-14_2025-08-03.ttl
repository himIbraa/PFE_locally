<https://legal.dz/resource/law/2025-08-03/25-14#version_art_182> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز لمحامي المتهم ولا لمحامي الضحية أو المدعى المدني أن يتناولوا الكلام، فيما عدا توجيه ملاحظات و / أو أسئلة مباشرة ، بعد إذن قاضي التحقيق وتحت رقابته والذي له أن يأمر بعدم الإجابة عنها ، و يضمن نص الملاحظات و/أو الأسئلة بالمحضر أو يرفق به في جميع الحالات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
