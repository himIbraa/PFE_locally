<https://legal.dz/resource/law/2025-08-03/25-14#version_art_464> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للاستئناف أثر ناقل للدعوى في حدود التصريح بالاستئناف وصفة المستأنف. إذا رأت محكمة الجنايات الاستئنافية أن الاستئناف رفع خارج الآجال أو كان غير صحيح ، شكلا ، قررت عدم قبوله. إذا قبلت محكمة الجنايات الاستئنافية الاستئناف شكلا فلها أن تفصل في الدعويين العمومية والمدنية بالتأييد أو بالتعديل أو بالإلغاء."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_464_20250803_OpEnact_c2a92d9ddb> ;
    dzdoc:replacementText "للاستئناف أثر ناقل للدعوى في حدود التصريح بالاستئناف وصفة المستأنف. إذا رأت محكمة الجنايات الاستئنافية أن الاستئناف رفع خارج الآجال أو كان غير صحيح ، شكلا ، قررت عدم قبوله. إذا قبلت محكمة الجنايات الاستئنافية الاستئناف شكلا فلها أن تفصل في الدعويين العمومية والمدنية بالتأييد أو بالتعديل أو بالإلغاء."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_464> ;
