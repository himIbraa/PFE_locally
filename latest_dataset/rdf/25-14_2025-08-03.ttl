<https://legal.dz/resource/law/2025-08-03/25-14#version_art_95> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا عثر على جثة شخص وكان سبب الوفاة مجهولا أو مشتبها فيه، سواء كانت الوفاة نتيجة عنف أو بغير عنف ، فعلى ضابط الشرطة القضائية الذي أبلغ بالحادث أن يخطر وكيل الجمهورية على الفور وينتقل بغير تمهل إلى مكان الحادث للقيام بعمل المعاينات الأولية . وينتقل وكيل الجمهورية إلى المكان إذا رأى لذلك ضرورة. ويصطحب معه أشخاصا قادرين على تقدير ظروف الوفاة. كما يمكنه أن يندب لإجراء ذلك من يرى ندبه من ضباط الشرطة القضائية. ويحلف الأشخاص الذين يرافقون وكيل الجمهورية اليمين كتابة على أن يبدوا رأيهم بما يمليه عليهم ا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_95_20250803_OpEnact_9b07613546> ;
    dzdoc:replacementText "إذا عثر على جثة شخص وكان سبب الوفاة مجهولا أو مشتبها فيه، سواء كانت الوفاة نتيجة عنف أو بغير عنف ، فعلى ضابط الشرطة القضائية الذي أبلغ بالحادث أن يخطر وكيل الجمهورية على الفور وينتقل بغير تمهل إلى مكان الحادث للقيام بعمل المعاينات الأولية . وينتقل وكيل الجمهورية إلى المكان إذا رأى لذلك ضرورة. ويصطحب معه أشخاصا قادرين على تقدير ظروف الوفاة. كما يمكنه أن يندب لإجراء ذلك من يرى ندبه من ضباط الشرطة القضائية. ويحلف الأشخاص الذين يرافقون وكيل الجمهورية اليمين كتابة على أن يبدوا رأيهم بما يمليه عليهم الشرف والضمير . ويجوز أيضا لوكيل الجمهورية أن يطلب إجراء التحقيق للبحث عن سبب الوفاة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_95> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_95> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_96> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم ضباط الشرطة القضائية ، وتحت رقابتهم ، أعوان الشرطة القضائية ، بالتحقيقات الابتدائية بمجرد علمهم بوقوع الجريمة إما بناء على تعليمات وكيل الجمهورية وإما من تلقاء أنفسهم ، و في هذه الحالة يجب عليهم إخطار وكيل الجمهورية فورا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_96_20250803_OpEnact_57c6b39d9f> ;
    dzdoc:replacementText "يقوم ضباط الشرطة القضائية ، وتحت رقابتهم ، أعوان الشرطة القضائية ، بالتحقيقات الابتدائية بمجرد علمهم بوقوع الجريمة إما بناء على تعليمات وكيل الجمهورية وإما من تلقاء أنفسهم ، و في هذه الحالة يجب عليهم إخطار وكيل الجمهورية فورا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_96> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_96> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
