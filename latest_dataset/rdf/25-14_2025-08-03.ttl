<https://legal.dz/resource/law/2025-08-03/25-14#version_art_727> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل طلب يهدف إلى رد رئيس المجلس القضائي يجب أن يكون في عريضة ترفع إلى الرئيس الأول للمحكمة العليا، ويفصل هذا الأخير في الطلب بعد استطلاع رأي النائب العام لدى المحكمة العليا، ويكون ذلك بقرار لا يجوز أن يكون قابلا لأي طريق من طرق الطعن، على أن تطبق أحكام المادة 724 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_727_20250803_OpEnact_6c7d570daf> ;
    dzdoc:replacementText "كل طلب يهدف إلى رد رئيس المجلس القضائي يجب أن يكون في عريضة ترفع إلى الرئيس الأول للمحكمة العليا، ويفصل هذا الأخير في الطلب بعد استطلاع رأي النائب العام لدى المحكمة العليا، ويكون ذلك بقرار لا يجوز أن يكون قابلا لأي طريق من طرق الطعن، على أن تطبق أحكام المادة 724 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_727> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
