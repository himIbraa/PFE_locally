<https://legal.dz/resource/law/2025-08-03/25-14#version_art_383> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد تاركا لادعائه المدني كل ضحية أو مدع مدني يتخلف عن الحضور أو لا يحضر عنه من يمثله في الجلسة رغم تكليفه بالحضور تكليفا قانونيا. إذا لم يحضر الضحية أو المدعي المدني رغم تكليفه تكليفا قانونيا ، يحكم في غيبته بحفظ حقوقه."@ar ;
    dzdoc:isAuthoritative true ;
