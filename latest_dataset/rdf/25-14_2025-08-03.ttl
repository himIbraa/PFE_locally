    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_530> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تؤرخ نسخة الحكم الأصلية ويذكر بها اسم القاضي الذي أصدر الحكم، واسم ممثل النيابة العامة وأمين ضبط الجلسة، واسم المترجم، عند الاقتضاء . بعد أن يوقع كل من الرئيس وأمين ضبط الجلسة عليها، تودع لدى أمانة ضبط المحكمة في خلال ثلاثة (3) أيام، على الأكثر، من تاريخ النطق بالحكم ، وينوه عن هذا الإيداع بالسجل المخصص لهذا الغرض بأمانة الضبط."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_530_20250803_OpEnact_1ce6c25f05> ;
    dzdoc:replacementText "تؤرخ نسخة الحكم الأصلية ويذكر بها اسم القاضي الذي أصدر الحكم، واسم ممثل النيابة العامة وأمين ضبط الجلسة، واسم المترجم، عند الاقتضاء . بعد أن يوقع كل من الرئيس وأمين ضبط الجلسة عليها، تودع لدى أمانة ضبط المحكمة في خلال ثلاثة (3) أيام، على الأكثر، من تاريخ النطق بالحكم ، وينوه عن هذا الإيداع بالسجل المخصص لهذا الغرض بأمانة الضبط."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_530> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
