<https://legal.dz/resource/law/2025-08-03/25-14#version_art_7> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا حركت الدعوى العمومية ، تبقى الجهة القضائية المدنية التي رفعت أمامها الدعوى الاستعجالية مختصة لاتخاذ أية تدابير مؤقتة تتعلق بالوقائع موضوع المتابعة متى كان وجود الالتزام لا يثير نزاعا جديا حتى ولو تأسس المدعي طرفا مدنيا أمام الجهة القضائية الجزائية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
