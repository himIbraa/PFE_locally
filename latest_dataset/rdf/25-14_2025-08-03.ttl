<https://legal.dz/resource/law/2025-08-03/25-14#version_art_677> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "بعد المناداة على القضية بالجلسة، يتلو المستشار المقرر المكلف بها تقريره. إن إجراءات النقض كتابية و يجوز السماح لمحامي أطراف الدعوى ، عند الاقتضاء، بأن يتقدموا بملاحظات شفوية موجزة . وتبدي النيابة العامة طلباتها قبل إقفال باب المناقشة، وبعد ذلك تحال القضية للمداولة لكي تصدر المحكمة العليا القرار في تاريخ محدد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_677_20250803_OpEnact_b3fcbdf491> ;
    dzdoc:replacementText "بعد المناداة على القضية بالجلسة، يتلو المستشار المقرر المكلف بها تقريره. إن إجراءات النقض كتابية و يجوز السماح لمحامي أطراف الدعوى ، عند الاقتضاء، بأن يتقدموا بملاحظات شفوية موجزة . وتبدي النيابة العامة طلباتها قبل إقفال باب المناقشة، وبعد ذلك تحال القضية للمداولة لكي تصدر المحكمة العليا القرار في تاريخ محدد."@ar ;
