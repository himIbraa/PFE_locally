        <https://legal.dz/resource/law/2025-08-03/25-14#art_838_condition_1_72b1d19b>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_838_condition_2_0e271fd7>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_838_condition_3_c23ce626>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_838_condition_4_d0ca4dfa>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_838_condition_5_14e55d50> ;
