    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقرر وكيل الجمهورية ، بالتشاور مع السلطات المختصة، اتخاذ التدابير المناسبة قصد ضمان الحماية الفعالة للأشخاص المذكورين في هذا الفصل المعرضين للخطر . بمجرد فتح تحقيق قضائي ، تؤول هذه السلطة لـ قاضي التحقيق المخطر. تبقى التدابير المتخذة سارية ما دامت الأسباب التي بررتها قائمة. ويمكن تعديلها بالنظر لخطورة التهديد. يعمل وكيل الجمهورية على تنفيذ ومتابعة تدابير الحماية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_131_20250803_OpEnact_974ece7d1c> ;
    dzdoc:replacementText "يقرر وكيل الجمهورية ، بالتشاور مع السلطات المختصة، اتخاذ التدابير المناسبة قصد ضمان الحماية الفعالة للأشخاص المذكورين في هذا الفصل المعرضين للخطر . بمجرد فتح تحقيق قضائي ، تؤول هذه السلطة لـ قاضي التحقيق المخطر. تبقى التدابير المتخذة سارية ما دامت الأسباب التي بررتها قائمة. ويمكن تعديلها بالنظر لخطورة التهديد. يعمل وكيل الجمهورية على تنفيذ ومتابعة تدابير الحماية ."@ar ;
