<https://legal.dz/resource/law/2025-08-03/25-14#art_223_obligation_0_d9bb7b7a_period_243efa3b3d> a dznorm:Period ;
    rdfs:label "في أجل لا يتعدى ستة (6) أشهر"@ar ;
    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "تخطر اللجنة بعريضة في أجل لا يتعدى ستة (6) أشهر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_223> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_223_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_223> ;
    dzdoc:position 0 ;
    dzdoc:text "تخطر اللجنة بعريضة في أجل لا يتعدى ستة (6) أشهر ، ابتداء من التاريخ الذي يصبح فيه القرار القاضي بألا وجه للمتابعة أو بالبراءة نهائيا و حائزا لقوة الشيء المقضي فيه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_223_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_223> ;
    dzdoc:position 1 ;
    dzdoc:text "تودع العريضة الموقعة من طرف المدعي أو محاميه لدى أمين اللجنة أو ترسل إليه إلكترونيا، مقابل وصل. تتضمن العريضة وقائع القضية والإجراءات وجميع البيانات الضرورية، لا سيما : 1- تاريخ وطبيعة القرار الذي أمر بالحبس المؤقت، وكذا المؤسسة العقابية التي نفذ فيها ومدة الحبس، 2 - الجهة القضائية التي أصدرت قرارا بألا وجه للمتابعة أو بالبراءة، وكذا تاريخ هذا القرار، 3 - طبيعة وقيمة الأضرار المطالب بها، 4 - عنوان المدعي الذي يتلقى فيه التبليغات."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_224_obligation_0_1f8ab40e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_224> ;
    dznorm:position 0 ;
    dznorm:provisionText "يرسل أمين اللجنة نسخة من العريضة إلى الوكيل القضائي للخزينة"@ar ;
    dznorm:sourceArticle "art_224" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_224_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_224> ;
    dzdoc:position 0 ;
    dzdoc:text "يرسل أمين اللجنة نسخة من العريضة إلى الوكيل القضائي للخزينة برسالة موصى عليها مع إشعار بالاستلام في أجل لا يتعدى عشرين (20) يوما، ابتداء من تاريخ استلامها."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_224_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_224> ;
    dzdoc:position 1 ;
    dzdoc:text "يطلب أمين اللجنة الملف الجزائي من أمانة ضبط الجهة القضائية التي أصدرت قرارا بألا وجه للمتابعة أو بالبراءة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_225_obligation_0_c3c32a0c> a dznorm:Obligation ;
