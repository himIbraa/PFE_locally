<https://legal.dz/resource/law/2025-08-03/25-14#version_art_297> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخطر محامو المتهمين والضحايا والمدعون بالحق المدني بمنطوق قرارات غرفة الاتهام في أجل ثلاثة (3) أيام برسالة موصى عليها ، وذلك فيما عدا الحالة المنصوص عليها في المادة 277 أعلاه. كما يخطر المتهمون بمنطوق القرارات الصادرة بألا وجه للمتابعة، ويخطر المتهمون والضحايا والمدعون بالحق المدني بقرارات الإحالة إلى محكمة الجنح أو المخالفات، وذلك ضمن الأوضاع والآجال نفسها ، أما القرارات التي يجوز للمتهمين أو الضحايا أو المدعين بالحق المدني الطعن فيها بطريق النقض فإنها تبلغ إليهم بناء على طلب النائب العام في أج"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_297_20250803_OpEnact_3eed201b29> ;
    dzdoc:replacementText "يخطر محامو المتهمين والضحايا والمدعون بالحق المدني بمنطوق قرارات غرفة الاتهام في أجل ثلاثة (3) أيام برسالة موصى عليها ، وذلك فيما عدا الحالة المنصوص عليها في المادة 277 أعلاه. كما يخطر المتهمون بمنطوق القرارات الصادرة بألا وجه للمتابعة، ويخطر المتهمون والضحايا والمدعون بالحق المدني بقرارات الإحالة إلى محكمة الجنح أو المخالفات، وذلك ضمن الأوضاع والآجال نفسها ، أما القرارات التي يجوز للمتهمين أو الضحايا أو المدعين بالحق المدني الطعن فيها بطريق النقض فإنها تبلغ إليهم بناء على طلب النائب العام في أجل ثلاثة (3) أيام ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_297> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
