<https://legal.dz/resource/law/2025-08-03/25-14#version_art_644> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مع مراعاة أحكام المادة 183 أعلاه، يوقع الشخص الذي تم سماعه عن بعد على نسخة المحضر المرسل إليه بأية وسيلة من وسائل الاتصال، بعد توقيعه مباشرة من القاضي و أمين الضبط لدى الجهة القضائية المختصة، وإن امتنع عن التوقيع أو تعذر عليه ، نوه عن ذلك على نسخة المحضر . تعاد النسخة المذكورة بنفس وسيلة الإرسال إلى الجهة القضائية المختصة لتلحق بملف الإجراءات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_644_20250803_OpEnact_e9fc64e2e4> ;
    dzdoc:replacementText "مع مراعاة أحكام المادة 183 أعلاه، يوقع الشخص الذي تم سماعه عن بعد على نسخة المحضر المرسل إليه بأية وسيلة من وسائل الاتصال، بعد توقيعه مباشرة من القاضي و أمين الضبط لدى الجهة القضائية المختصة، وإن امتنع عن التوقيع أو تعذر عليه ، نوه عن ذلك على نسخة المحضر . تعاد النسخة المذكورة بنفس وسيلة الإرسال إلى الجهة القضائية المختصة لتلحق بملف الإجراءات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_644> ;
