<https://legal.dz/resource/law/2025-08-03/25-14#version_art_497> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون الحكم حضوريا على المتهم الطليق : الذي يجيب على نداء اسمه ويغادر باختياره قاعة الجلسة، الذي رغم حضوره بالجلسة يرفض الإجابة أو يقرر التخلف عن الحضور، الذي بعد حضوره بإحدى الجلسات الأولى يمتنع باختياره عن الحضور بالجلسات التي تؤجل إليها الدعوى أو بجلسة المحاكمة."@ar ;
