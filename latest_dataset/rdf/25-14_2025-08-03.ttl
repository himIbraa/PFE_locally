    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_519_20250803_OpEnact_83b3b8767f> ;
    dzdoc:replacementText "يلزم المدعي المدني الذي خسر دعواه بالمصاريف القضائية حتى في الحالة المشار إليها في المادة 383 أعلاه. غير أن للمحكمة مع ذلك أن تعفيه منها كلها أو جزء منها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_519> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
