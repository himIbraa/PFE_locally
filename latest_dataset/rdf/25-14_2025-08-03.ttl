<https://legal.dz/resource/law/2025-08-03/25-14#art_195_obligation_0_1fe43894> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_195> ;
    dznorm:position 0 ;
    dznorm:provisionText "اقتيد في الحال إلى وكيل الجمهورية لمحل القبض الذي يتلقى أقواله بعد تنبيهه بأنه حر في عدم الإدلاء بأي أقوال"@ar ;
    dznorm:sourceArticle "art_195" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_195_obligation_1_40b90c47> a dznorm:Obligation ;
