    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يقوم أمين ضبط المجلس القضائي لمحل الميلاد أو القاضي المكلف بالمصلحة المركزية لصحيفة السوابق القضائية بمجرد استلامه قسيمة التعديل المنصوص عليها في المادة 794 أدناه ، بقيد البيانات الآتية على البطاقات رقم 1"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_793> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_793_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_793> ;
    dzdoc:position 0 ;
    dzdoc:text "يقوم أمين ضبط المجلس القضائي لمحل الميلاد أو القاضي المكلف بالمصلحة المركزية لصحيفة السوابق القضائية بمجرد استلامه قسيمة التعديل المنصوص عليها في المادة 794 أدناه ، بقيد البيانات الآتية على البطاقات رقم 1 : العفو واستبدال العقوبة بأخرى أو تخفيضها، قرارات إيقاف تنفيذ عقوبة أولى وقرارات إلغائها، الإشعارات بانتهاء تنفيذ عقوبة العمل للنفع العام أو الإخلال بالتزامات هذه العقوبة وتنفيذ العقوبة الأصلية، مقررات الإفراج المشروط و مقررات إلغائها، أحكام وقرارات رد الاعتبار القضائي، القرارات الخاصة بالإبعاد، القرارات الخاصة بإلغاء أو إيقاف إجراءات الإبعاد، مقررات الوضع تحت المراقبة الإلكترونية أو مقررات إلغائها."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_793_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_793> ;
    dzdoc:position 1 ;
    dzdoc:text "ويذكر أمين الضبط، فضلا عن ذلك، تاريخ انتهاء العقوبة وتاريخ سداد الغرامة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_794_condition_0_6ed63bbf> a dznorm:Condition ;
    dznorm:conditionText "إذا كان الأمر متعلقا بالعفو أو باستبدال العقوبة أو بتخفيضها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_794> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_794_condition_1_f8997b33> a dznorm:Condition ;
    dznorm:conditionText "إذا تعلق الأمر بتواريخ انتهاء العقوبة السالبة للحرية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_794> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_794_condition_2_bf65c31a> a dznorm:Condition ;
    dznorm:conditionText "إذا كان الأمر يتعلق بتسديد الغرامات والمصاريف القضائية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_794> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_794_condition_3_445d641e> a dznorm:Condition ;
    dznorm:conditionText "إذا تعلق الأمر بانتهاء تنفيذ هذه العقوبة أو بتنفيذ العقوبة الأصلية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_794> ;
    dznorm:position 3 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_794_obligation_0_f95f8a19> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
