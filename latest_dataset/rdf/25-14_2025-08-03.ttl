    dznorm:position 0 ;
    dznorm:provisionText "لوكيل الجمهورية أن يطلع بطريق المطالبة ، عند الاقتضاء، على الملف في أي وقت أثناء إجراء التحقيق التكميلي"@ar ;
    dznorm:sourceArticle "art_506" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_506_right_0_8088f6d2_role_8b44615e9b> a dznorm:Role ;
    rdfs:label "الملف في أي وقت"@ar ;
