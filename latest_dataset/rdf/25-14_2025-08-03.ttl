<https://legal.dz/resource/law/2025-08-03/25-14#version_art_873> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في الحالة العكسية، يعرض وزير العدل للتوقيع إذا كان هناك محل لذلك ، مرسوما بالإذن بالتسليم و إذا انقضى ميعاد شهر من تاريخ تبليغ هذا المرسوم إلى حكومة الدولة الطالبة دون أن يقوم ممثلو تلك الدولة باستلام الشخص المقرر تسليمه فيفرج عنه ، و لا يجوز المطالبة به بعد ذلك لنفس السبب ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_873_20250803_OpEnact_09c9686ab2> ;
    dzdoc:replacementText "في الحالة العكسية، يعرض وزير العدل للتوقيع إذا كان هناك محل لذلك ، مرسوما بالإذن بالتسليم و إذا انقضى ميعاد شهر من تاريخ تبليغ هذا المرسوم إلى حكومة الدولة الطالبة دون أن يقوم ممثلو تلك الدولة باستلام الشخص المقرر تسليمه فيفرج عنه ، و لا يجوز المطالبة به بعد ذلك لنفس السبب ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_873> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
