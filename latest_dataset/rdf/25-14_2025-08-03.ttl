    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_749_20250803_OpEnact_699b849f52> ;
    dzdoc:replacementText "تجرى المتابعة بناء على طلب النيابة العامة لمحل إقامة المتهم أو مكان آخر محل إقامة معروف له أو مكان القبض عليه ، إذا لم يتقرر اختصاص إقليمي آخر بموجب القانون ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_749> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
