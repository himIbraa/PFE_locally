<https://legal.dz/resource/law/2025-08-03/25-14#art_541_obligation_0_6c27878b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_541_obligation_0_6c27878b_action_668d5b11fd> ;
