        <https://legal.dz/resource/law/2025-08-03/25-14#art_674>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_715_bis_136>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_715_bis_137>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_715_bis_143>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_715_ter_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_715_ter_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_799_bis_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_8> ;
