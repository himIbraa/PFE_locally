dzterm:infiltration a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "عملية التسرب"@ar,
        "يقصد بالتسرب قيام ضابط أو عون الشرطة القضائية، تحت مسؤولية ضابط الشرطة القضائية المكلف بتنسيق العملية، بمراقبة الأشخاص المشتبه في ارتكابهم جناية أو جنحة بإيهامهم أنه فاعل معهم أو شريك لهم أو خاف."@ar ;
