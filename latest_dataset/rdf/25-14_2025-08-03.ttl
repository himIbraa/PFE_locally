<https://legal.dz/resource/law/2025-08-03/25-14#art_550_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_550> ;
    dzdoc:position 0 ;
    dzdoc:text "قبل كل تكليف بالحضور أمام المحكمة، يقوم قاضي النيابة العامة المختص المحال عليه محضر مثبت لمخالفة بإخطار المخالف بأنه مرخص له بدفع مبلغ على سبيل غرامة صلح مساويا للحد الأدنى المنصوص عليه قانونا لعقوبة المخالفة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_551_condition_0_2a56b652> a dznorm:Condition ;
    dznorm:conditionText "إذا رفعت مخالفتان في محضر واحد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_551> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_551_obligation_0_f0697879> a dznorm:Obligation ;
