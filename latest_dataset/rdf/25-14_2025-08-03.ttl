<https://legal.dz/resource/law/2025-08-03/25-14#version_art_485> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تمت إدانة المتهم بعقوبة سالبة للحرية نافذة ، يمكن للمحكمة أن تصدر أمرا بإيداعه في الجلسة بصرف النظر عن الأحكام المقررة في المادة 508 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
