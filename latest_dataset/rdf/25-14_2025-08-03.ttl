<https://legal.dz/resource/law/2025-08-03/25-14#version_art_146> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لـ وكيل الجمهورية أو المتهم أو الطرف المدني أو الضحية ، لحسن سير العدالة، طلب تنحية الملف من قاضي التحقيق لفائدة قاض آخر من قضاة التحقيق . يرفع طلب التنحية بعريضة مسببة إلى رئيس غرفة الاتهام ، وتبلغ إلى القاضي المعني الذي يجوز له تقديم ملاحظاته الكتابية . يصدر رئيس غرفة الاتهام قراره في ظرف ثلاثين (30) يوما من تاريخ إيداع الطلب بعد استطلاع رأي النائب العام ، ويكون هذا القرار غير قابل لأي طعن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_146_20250803_OpEnact_f60bd453a0> ;
    dzdoc:replacementText "يجوز لـ وكيل الجمهورية أو المتهم أو الطرف المدني أو الضحية ، لحسن سير العدالة، طلب تنحية الملف من قاضي التحقيق لفائدة قاض آخر من قضاة التحقيق . يرفع طلب التنحية بعريضة مسببة إلى رئيس غرفة الاتهام ، وتبلغ إلى القاضي المعني الذي يجوز له تقديم ملاحظاته الكتابية . يصدر رئيس غرفة الاتهام قراره في ظرف ثلاثين (30) يوما من تاريخ إيداع الطلب بعد استطلاع رأي النائب العام ، ويكون هذا القرار غير قابل لأي طعن."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_146> ;
