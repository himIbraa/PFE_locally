<https://legal.dz/resource/law/2025-08-03/25-14#version_art_94> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحق لكل شخص في حالات الجناية أو الجنحة المتلبس بها والمعاقب عليها بعقوبة الحبس، ضبط الفاعل واقتياده إلى أقرب مقر للشرطة القضائية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_94_20250803_OpEnact_042c94fbf4> ;
    dzdoc:replacementText "يحق لكل شخص في حالات الجناية أو الجنحة المتلبس بها والمعاقب عليها بعقوبة الحبس، ضبط الفاعل واقتياده إلى أقرب مقر للشرطة القضائية ."@ar ;
