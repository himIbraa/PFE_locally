<https://legal.dz/resource/law/2025-08-03/25-14#art_766_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_766> ;
    dzdoc:position 0 ;
