    dzdoc:number "19" ;
    dzdoc:position 18 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_26> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_26> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_19_condition_0_df257e89>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_19_condition_1_02fc36e3> ;
