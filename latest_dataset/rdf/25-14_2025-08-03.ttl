    dzdoc:sourceEId "art_745" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "بالشروط المنصوص عليها في الفقرة 2 من المادة 744 أعلاه"@ar ;
    dzdoc:targetEId "art_744" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_745_condition_1_21f89ec4> a dznorm:Condition ;
