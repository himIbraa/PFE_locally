<https://legal.dz/resource/law/2025-08-03/25-14#version_art_735> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا ارتكبت جناية في جلسة محكمة أو مجلس قضائي أو محكمة جنايات ، فإن تلك الجهة القضائية تحرر محضرا وتستجوب الفاعل وتسوقه ومعه أوراق الدعوى إلى وكيل الجمهورية الذي يطلب افتتاح تحقيق قضائي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_735_20250803_OpEnact_e492c4d4eb> ;
    dzdoc:replacementText "إذا ارتكبت جناية في جلسة محكمة أو مجلس قضائي أو محكمة جنايات ، فإن تلك الجهة القضائية تحرر محضرا وتستجوب الفاعل وتسوقه ومعه أوراق الدعوى إلى وكيل الجمهورية الذي يطلب افتتاح تحقيق قضائي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_735> ;
