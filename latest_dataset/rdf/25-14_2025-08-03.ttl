    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 244" ;
    dzdoc:position 243 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_240> ;
