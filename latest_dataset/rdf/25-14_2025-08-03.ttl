<https://legal.dz/resource/law/2025-08-03/25-14#version_art_698> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز ل قاضي التحقيق أن يكلف من تخصه جميع أوراق المضاهاة بتسليمها ويتخذ إجراء بحجزها. ويوقع على هذه الأوراق بإمضائه وإمضاء أمين الضبط الذي يحرر عنها محضرا بأوصافها حسبماهو مقرر ب المادة 697 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_698_20250803_OpEnact_8a0b2c3dd2> ;
    dzdoc:replacementText "يجوز ل قاضي التحقيق أن يكلف من تخصه جميع أوراق المضاهاة بتسليمها ويتخذ إجراء بحجزها. ويوقع على هذه الأوراق بإمضائه وإمضاء أمين الضبط الذي يحرر عنها محضرا بأوصافها حسبماهو مقرر ب المادة 697 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_698> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
