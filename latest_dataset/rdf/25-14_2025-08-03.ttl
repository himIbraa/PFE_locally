    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_313> ;
    dznorm:position 0 ;
    dznorm:provisionText "يصدر قاضي التحقيق أمرا بالتخلي عن الإجراءات لفائدة قاضي التحقيق لدى القطب القضائي المتخصص"@ar ;
    dznorm:sourceArticle "art_313" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_313_obligation_1_393dd036> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_313> ;
