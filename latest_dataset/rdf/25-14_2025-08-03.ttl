<https://legal.dz/resource/law/2025-08-03/25-14#art_106_extref_d5d56c8b> a dzdoc:ExternalReference ;
    rdfs:label "المواد 119 مكرر"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/penal#art_119_bis"^^xsd:anyURI ;
