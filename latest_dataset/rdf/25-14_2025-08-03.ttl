    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_267> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_267_obligation_0_d0083e83_period_44357e1a10> a dznorm:Period ;
    rdfs:label "خلال العشرين (20) يوما التالية لصدو"@ar ;
    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "يجب أن يبلغ استئنافه للخصوم خلال العشرين (20) يوما التالية لصدور أمر قاضي التحقيق"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_267> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_267_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_267> ;
    dzdoc:position 0 ;
    dzdoc:text "يحق الاستئناف أيضا للنائب العام في جميع الأحوال، ويجب أن يبلغ استئنافه للخصوم خلال العشرين (20) يوما التالية لصدور أمر قاضي التحقيق."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_267_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_267> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا يوقف هذا الأجل ولا رفع الاستئناف تنفيذ الأمر بالإفراج."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_267_right_0_2108e978> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_267> ;
    dznorm:position 0 ;
    dznorm:provisionText "يحق الاستئناف أيضا للنائب العام في جميع الأحوال"@ar ;
    dznorm:sourceArticle "art_267" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_268_condition_0_b585c16e> a dznorm:Condition ;
    dznorm:conditionText "وإذا كان المتهم محبوسا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_268> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_268_obligation_0_a6aab1c6> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_268_obligation_0_a6aab1c6_role_9533691924> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_268> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتعين على المراقب الرئيسي للمؤسسة العقابية تسليم هذه العريضة لأمانة ضبط المحكمة في ظرف أربع وعشرين (24) ساعة"@ar ;
    dznorm:sourceArticle "art_268" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_268_obligation_0_a6aab1c6_role_9533691924> a dznorm:Role ;
    rdfs:label "المراقب الرئيسي للمؤسسة العقابية"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يتعين على المراقب الرئيسي للمؤسسة العقابية تسليم هذه العريضة لأمانة ضبط المحكمة في ظرف أربع وعشرين (24) ساعة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_268> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_268_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_268> ;
    dzdoc:position 0 ;
    dzdoc:text "للمتهم أو لمحاميه الحق في رفع استئناف أمام غرفة الاتهام بالمجلس القضائي ضد الأوامر المنصوص عليها في المواد 104 و 144 و 149 و 198 و 199 و 201 و 203 و 204 و 205 و 208 و 239 و 250 أعلاه ، وكذلك عن الأوامر التي يصدرها قاضي التحقيق في اختصاصه بنظر الدعوى، إما من تلقاء نفسه أو بناء على دفع أحد الخصوم بعدم الاختصاص."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_268_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_268> ;
    dzdoc:position 1 ;
    dzdoc:text "ويرفع الاستئناف بعريضة تودع لدى أمانة ضبط المحكمة في ظرف ثلاثة (3) أيام من تبليغ الأمر إلى المتهم طبقا لالمادة 264 أعلاه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_268_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_268> ;
    dzdoc:position 2 ;
    dzdoc:text "وإذا كان المتهم محبوسا ، تكون هذه العريضة صحيحة إذا تلقاها أمين ضبط المؤسسة العقابية، حيث تقيد على الفور في سجل خاص ، ويتعين على المراقب الرئيسي للمؤسسة العقابية تسليم هذه العريضة لأمانة ضبط المحكمة في ظرف أربع وعشرين (24) ساعة، وإلا تعرض لجزاءات تأديبية."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_268_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_268> ;
    dzdoc:position 3 ;
    dzdoc:text "وليس للاستئناف المرفوع من طرف المتهم ضد الأوامر المتعلقة بالحبس المؤقت أو الرقابة القضائية أثر موقف."@ar .

