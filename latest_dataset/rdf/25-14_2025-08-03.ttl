    dzdoc:sourceTextSpan "يجب أن لا يؤسس أمر الوضع في الحبس المؤقت إلا على معطيات مستخرجة من ملف القضية تفيد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_201> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_201_obligation_1_e3183846> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_201> ;
    dznorm:position 1 ;
    dznorm:provisionText "يبلغ قاضي التحقيق أمر الوضع في الحبس شفاهة إلى المتهم"@ar ;
    dznorm:sourceArticle "art_201" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_201_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_201> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب أن لا يؤسس أمر الوضع في الحبس المؤقت إلا على معطيات مستخرجة من ملف القضية تفيد : انعدام موطن مستقر للمتهم أو عدم تقديمه ضمانات كافية للمثول أمام القضاء أو كانت الأفعال جد خطيرة، أن الحبس المؤقت هو الإجراء الوحيد للحفاظ على الحجج أو الأدلة المادية أو لمنع الضغوط على الشهود أو الضحايا أو الأطراف المدنية، أو لتفادي تواطؤ بين المتهمين والشركاء قد يؤدي إلى عرقلة الكشف عن الحقيقة، أن الحبس ضروري لحماية المتهم أو وضع حد للجريمة، أو الوقاية من حدوثها من جديد، عدم تقيد المتهم بالالتزامات المترتبة على إجراءات الرقابة القضائية دون مبرر جدي."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_201_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_201> ;
    dzdoc:position 1 ;
    dzdoc:text "يبلغ قاضي التحقيق أمر الوضع في الحبس شفاهة إلى المتهم، وينبهه بأن له ثلاثة (3) أيام من تاريخ هذا التبليغ لاستئنافه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_201_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_201> ;
    dzdoc:position 2 ;
    dzdoc:text "يشار إلى هذا التبليغ في المحضر ."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_201_right_0_bd874709> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_201> ;
    dznorm:position 0 ;
    dznorm:provisionText "ثلاثة (3) أيام من تاريخ هذا التبليغ لاستئنافه"@ar ;
    dznorm:sourceArticle "art_201" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_202_condition_0_0171d09f> a dznorm:Condition ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2025-08-03/25-14#art_202_condition_0_0171d09f_period_f0ad0ea00b> ;
    dznorm:conditionText "إذا كان الحد الأقصى للعقوبة المقررة في القانون هو الحبس لمدة تساوي أو تقل عن ثلاث (3) سنوات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_202> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_202_condition_0_0171d09f_period_f0ad0ea00b> a dznorm:Period ;
    rdfs:label "لمدة تساوي أو تقل عن ثلاث (3) سنوات"@ar ;
    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "إذا كان الحد الأقصى للعقوبة المقررة في القانون هو الحبس لمدة تساوي أو تقل عن ثلاث (3) سنوات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_202> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_202_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_202> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يجوز في مواد الجنح ، أن يحبس المتهم المقيم بالجزائر حبسا مؤقتا إذا كان الحد الأقصى للعقوبة المقررة في القانون هو الحبس لمدة تساوي أو تقل عن ثلاث (3) سنوات، باستثناء الجرائم التي نتجت عنها وفاة إنسان أو التي أدت إلى إخلال ظاهر بالنظام العام، وفي هذه الحالة لا تتعدى مدة الحبس المؤقت شهرا واحدا (1) غير قابل للتجديد."@ar .

