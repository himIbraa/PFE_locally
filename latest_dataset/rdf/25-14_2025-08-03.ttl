<https://legal.dz/resource/law/2025-08-03/25-14#version_art_682> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على الجهة القضائية التي تحال إليها القضية بعد النقض أن تخضع لقرار الإحالة فيما يتعلق بالنقطة القانونية التي قطعت فيها المحكمة العليا . وإن لم يدع قرار المحكمة العليا من النزاع شيئا يفصل فيه ، نقض الحكم المطعون فيه دون إحالة. ويحكم على الخصم الذي خسر طعنه بالمصاريف القضائية، فيما عدا النيابة العامة. ويجوز تقدير المصاريف القضائية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_682_20250803_OpEnact_b71f1aba02> ;
    dzdoc:replacementText "يجب على الجهة القضائية التي تحال إليها القضية بعد النقض أن تخضع لقرار الإحالة فيما يتعلق بالنقطة القانونية التي قطعت فيها المحكمة العليا . وإن لم يدع قرار المحكمة العليا من النزاع شيئا يفصل فيه ، نقض الحكم المطعون فيه دون إحالة. ويحكم على الخصم الذي خسر طعنه بالمصاريف القضائية، فيما عدا النيابة العامة. ويجوز تقدير المصاريف القضائية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_682> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_682> ;
