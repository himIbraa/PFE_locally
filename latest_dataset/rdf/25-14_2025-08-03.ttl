<https://legal.dz/resource/law/2025-08-03/25-14#version_art_298> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تطبق على هذا الباب أحكام المواد 253 و 255 و 256 أعلاه المتعلقة ببطلان إجراءات التحقيق على صحة قرارات غرفة الاتهام وكذلك على صحة إجراءات التحقيق السابقة لها إذا كان قرار الغرفة قد فصل في صحتها ، تخضع لرقابة المحكمة العليا وحدها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
