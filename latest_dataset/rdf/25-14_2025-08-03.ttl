<https://legal.dz/resource/law/2025-08-03/25-14#version_art_602> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رأى المجلس أن الاستئناف قد تأخر رفعه أو كان غير صحيح شكلا ، قرر عدم قبوله. و إذا ما رأى أن الاستئناف، رغم كونه مقبولا شكلا، ليس قائما على أساس قضى بتأييد الحكم المطعون فيه. و في كلتا الحالتين، يلزم المستأنف بالمصاريف القضائية ما لم يكن الاستئناف صادرا من النيابة العامة فإن المصاريف تترك إذ ذاك على عاتق الخزينة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_602_20250803_OpEnact_4f3721d787> ;
    dzdoc:replacementText "إذا رأى المجلس أن الاستئناف قد تأخر رفعه أو كان غير صحيح شكلا ، قرر عدم قبوله. و إذا ما رأى أن الاستئناف، رغم كونه مقبولا شكلا، ليس قائما على أساس قضى بتأييد الحكم المطعون فيه. و في كلتا الحالتين، يلزم المستأنف بالمصاريف القضائية ما لم يكن الاستئناف صادرا من النيابة العامة فإن المصاريف تترك إذ ذاك على عاتق الخزينة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_602> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_602> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
