<https://legal.dz/resource/law/2025-08-03/25-14#version_art_120> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما تقتضي ضرورات التحري أو التحقيق في إحدى الجرائم المذكورة في المادة 114 أعلاه ، يجوز لـ وكيل الجمهورية أو لـ قاضي التحقيق ، بعد إخطار وكيل الجمهورية ، أن يأذن، تحت رقابته، حساب الحالة، بمباشرة عملية التسرب ضمن الشروط المبينة في المواد أدناه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_120_20250803_OpEnact_b83cb62938> ;
    dzdoc:replacementText "عندما تقتضي ضرورات التحري أو التحقيق في إحدى الجرائم المذكورة في المادة 114 أعلاه ، يجوز لـ وكيل الجمهورية أو لـ قاضي التحقيق ، بعد إخطار وكيل الجمهورية ، أن يأذن، تحت رقابته، حساب الحالة، بمباشرة عملية التسرب ضمن الشروط المبينة في المواد أدناه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
