<https://legal.dz/resource/law/2025-08-03/25-14#version_art_291> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رأت غرفة الاتهام أن الوقائع لا تشكل جناية أو جنحة أو مخالفة أو لا تتوفر دلائل كافية لإدانة المتهم أو كان مرتكب الجريمة لا يزال مجهولا ، أصدرت قرارها بألا وجه للمتابعة ، و يفرج عن المتهمين المحبوسين مؤقتا في الحال ما لم يكونوا محبوسين لسبب آخر ، وتفصل غرفة الاتهام في القرار نفسه في رد الأشياء المحجوزة وتظل مختصة بالفصل في أمر رد هذه الأشياء، عند الاقتضاء، بعد صدور ذلك القرار."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_291_20250803_OpEnact_4a10523cc9> ;
    dzdoc:replacementText "إذا رأت غرفة الاتهام أن الوقائع لا تشكل جناية أو جنحة أو مخالفة أو لا تتوفر دلائل كافية لإدانة المتهم أو كان مرتكب الجريمة لا يزال مجهولا ، أصدرت قرارها بألا وجه للمتابعة ، و يفرج عن المتهمين المحبوسين مؤقتا في الحال ما لم يكونوا محبوسين لسبب آخر ، وتفصل غرفة الاتهام في القرار نفسه في رد الأشياء المحجوزة وتظل مختصة بالفصل في أمر رد هذه الأشياء، عند الاقتضاء، بعد صدور ذلك القرار."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_291> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_291> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
