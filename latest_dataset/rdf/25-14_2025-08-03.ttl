<https://legal.dz/resource/law/2025-08-03/25-14#version_art_803> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم توجد قسيمة تحمل رقم 1 في ملف صحيفة السوابق القضائية للشخص، أو إذا كانت البيانات التي تحويها القسيمة رقم 1 مما يجب أن لا يثبت على القسيمة رقم 3 ، فإن هذه الأخيرة يصير إلغاؤها بخط مستعرض."@ar ;
