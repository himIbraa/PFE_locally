<https://legal.dz/resource/law/2025-08-03/25-14#version_art_275> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتولى النائب العام تهيئة القضية خلال خمسة (5) أيام، على الأكثر ، من استلام أوراقها ويقدمها مع طلباته فيها إلى غرفة الاتهام ، و يتعين على غرفة الاتهام أن تصدر قرارها في موضوع الحبس المؤقت في أقرب أجل، بحيث لا يتأخر ذلك عن عشرين (20) يوما من تاريخ استئناف الأوامر المنصوص عليها في المادة 268 أعلاه وإلا أفرج عن المتهم تلقائيا ما لم يتقرر إجراء تحقيق إضافي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_275_20250803_OpEnact_0f7657a499> ;
    dzdoc:replacementText "يتولى النائب العام تهيئة القضية خلال خمسة (5) أيام، على الأكثر ، من استلام أوراقها ويقدمها مع طلباته فيها إلى غرفة الاتهام ، و يتعين على غرفة الاتهام أن تصدر قرارها في موضوع الحبس المؤقت في أقرب أجل، بحيث لا يتأخر ذلك عن عشرين (20) يوما من تاريخ استئناف الأوامر المنصوص عليها في المادة 268 أعلاه وإلا أفرج عن المتهم تلقائيا ما لم يتقرر إجراء تحقيق إضافي ."@ar ;
