<https://legal.dz/resource/law/2025-08-03/25-14#version_art_119> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يصف أو ينسخ ضابط الشرطة القضائية المأذون له أو المناب المراسلات أو الصور أو المحادثات المسجلة والمفيدة في إظهار الحقيقة في محضر يودع بالملف ، و ترفق به الدعامة الإلكترونية إذا طلبها وكيل الجمهورية . تنسخ وتترجم المكالمات التي تتم باللغات الأجنبية، عند الاقتضاء ، بمساعدة مترجم يسخر لهذا الغرض ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
