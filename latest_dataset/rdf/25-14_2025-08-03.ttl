<https://legal.dz/resource/law/2025-08-03/25-14#version_art_751> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز مباشرة إجراء أية متابعة من أجل جناية أو جنحة ارتكبت في الجزائر ضد أجنبي يكون قد أثبت أنه حوكم نهائيا من أجل هذه الجناية أو الجنحة في الخارج وأن يثبت في حالة الإدانة أنه قضى العقوبة أو تقادمت أو صدر عفو عنها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_751_20250803_OpEnact_2165c97a03> ;
    dzdoc:replacementText "لا يجوز مباشرة إجراء أية متابعة من أجل جناية أو جنحة ارتكبت في الجزائر ضد أجنبي يكون قد أثبت أنه حوكم نهائيا من أجل هذه الجناية أو الجنحة في الخارج وأن يثبت في حالة الإدانة أنه قضى العقوبة أو تقادمت أو صدر عفو عنها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_751> ;
