<https://legal.dz/resource/law/2025-08-03/25-14#version_art_809> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحكم على الطالب بالمصروفات إذا رفض الطلب . و في حالة قبول الطلب تقضي الجهة القضائية بالإشارة إلى حكمها على هامش الحكم موضوع طلب التصحيح، ويرسل مستخرجا من حكمها إلى مصلحة صحيفة السوابق القضائية لتصحيح القسيمة رقم 1 . ويتحمل المصروفات، من كان سببا في الإدانة الخاطئة إذا كان قد بلغ بالحضور للجلسة ، و في الحالة العكسية وكذلك في حالة إعساره تكون المصروفات على عاتق الخزينة العمومية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_809_20250803_OpEnact_e506aef2ec> ;
    dzdoc:replacementText "يحكم على الطالب بالمصروفات إذا رفض الطلب . و في حالة قبول الطلب تقضي الجهة القضائية بالإشارة إلى حكمها على هامش الحكم موضوع طلب التصحيح، ويرسل مستخرجا من حكمها إلى مصلحة صحيفة السوابق القضائية لتصحيح القسيمة رقم 1 . ويتحمل المصروفات، من كان سببا في الإدانة الخاطئة إذا كان قد بلغ بالحضور للجلسة ، و في الحالة العكسية وكذلك في حالة إعساره تكون المصروفات على عاتق الخزينة العمومية ."@ar ;
