<https://legal.dz/resource/law/2025-08-03/25-14#art_147> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_147" ;
    dzdoc:fullText "يجوز لكل شخص متضرر من جناية أو جنحة غير مرتبطتين بوقائع معروضة على القضاء، أن يدعي مدنيا بأن يتقدم بشكواه أمام قاضي التحقيق المختص . لا تكون الشكوى المصحوبة بادعاء مدني مقبولة إلا إذا أثبت المعني أنه سبق له تقديم شكوى من أجل نفس الأفعال وضد نفس الشخص أو الأشخاص أمام وكيل الجمهورية وتم حفظها أو أنه مر على إيداعها أجل أربعة (4) أشهر وتأكد قاضي التحقيق أنه لم يتخذ بشأنها قرارا بتحريك الدعوى العمومية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_147_permission_0_ed946906> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_147_right_0_3588a9a1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_147> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_147_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_147_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_147_20250803_OpEnact_1aed610704> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "147" ;
    dzdoc:position 146 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_147_condition_0_c574ac04> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_181> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_5> ;
    dzdoc:eId "art_181" ;
    dzdoc:fullText "يجوز ل وكيل الجمهورية حضور استجواب المتهمين ومواجهاتهم وسماع أقوال المدعي المدني . و يجوز له أن يوجه مباشرة ما يراه لازما من الأسئلة . ويتعين على أمين ضبط التحقيق في كل مرة يبدي فيها وكيل الجمهورية ل قاضي التحقيق رغبته في حضور الاستجواب أن يخطره بمذكرة بسيطة قبل الاستجواب بيومين (2)، على الأقل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_181_permission_0_00d65a13> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_181_right_0_c414c411>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_181_right_1_d96abfe9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_181> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_181_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_181_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_181_20250803_OpEnact_80b3787f86> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_181_obligation_0_708a642c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 181" ;
    dzdoc:position 180 ;
    dzdoc:usesTerm dzterm:clerk,
        dzterm:investigating_judge,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_202> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_7> ;
    dzdoc:eId "art_202" ;
    dzdoc:fullText "لا يجوز في مواد الجنح ، أن يحبس المتهم المقيم بالجزائر حبسا مؤقتا إذا كان الحد الأقصى للعقوبة المقررة في القانون هو الحبس لمدة تساوي أو تقل عن ثلاث (3) سنوات ، باستثناء الجرائم التي نتجت عنها وفاة إنسان أو التي أدت إلى إخلال ظاهر بالنظام العام، وفي هذه الحالة لا تتعدى مدة الحبس المؤقت شهرا واحدا (1) غير قابل للتجديد."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_202_permission_0_bb655b11> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_202> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_202_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_202_20250803_OpEnact_1f0a64d38f> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_202_prohibition_0_bb655b11> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "202" ;
    dzdoc:position 201 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_202_condition_0_0171d09f> ;
    dzdoc:usesTerm dzterm:accused .

<https://legal.dz/resource/law/2025-08-03/25-14#art_345> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_4_sec_4> ;
    dzdoc:eId "art_345" ;
    dzdoc:fullText "يختص وكيل الجمهورية و قاضي التحقيق بمحكمة مقر مجلس قضاء الجزائر حصريا بالمتابعة والتحقيق في جرائم الإرهاب المنصوص عليها في المطات 6 و 9 و 10 و 12 و 13 من المادة 87 مكرر ، والفقرة 2 من المادة 87 مكرر 6 من قانون العقوبات والجرائم المرتبطة بها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_345> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_345_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_345_20250803_OpEnact_f4c37788e9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_345_obligation_0_9f038fb0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "345" ;
    dzdoc:position 344 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2025-08-03/25-14#art_345_extref_4beb54d6>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_345_extref_a8586201> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_370> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_1_sec_1> ;
    dzdoc:eId "art_370" ;
    dzdoc:fullText "يؤدي الشهود شهادتهم شفويا . غير أنه يجوز لهم بصفة استثنائية، الاستعانة بمستندات بترخيص من الرئيس . ويقوم الرئيس ، بعد أداء كل شاهد لشهادته، بتوجيه ما يراه لازما من أسئلة على الشاهد و ما يطرحه عليه أطراف الدعوى من الأسئلة إن كان ثمة محل لذلك. ولـ النيابة العامة حرية توجيه ما تراه من الأسئلة مباشرة إلى المتهمين وإلى الشهود وإلى الضحايا والأطراف المدنية . و يجوز لدفاع كل من المتهم أو الضحية أو الطرف المدني توجيه الأسئلة مباشرة إلى كل شخص يتم سماعه في الجلسة ، بعد إذن الرئيس وتحت رقابته والذي له أن يأمر بعدم الإجابة عن السؤال. يجوز للشاهد أن ينسحب من قاعة الجلسة بعد أداء شهادته ، ما لم يقرر الرئيس غير ذلك . ويجوز لـ النيابة العامة وكذلك للضحية وللمدعي المدني وللمتهم أن يطلبوا انسحاب الشاهد مؤقتا من قاعة الجلسة بعد أداء شهادته، لكي يتسنى إعادة إدخاله إليها وسماعه من جديد إذا كان ثمة محل لذلك، مع إجراء مواجهات بين الشهود أو عدم إجرائها وللرئيس من تلقاء نفسه أن يأمر بهذا الإجراء."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_370_permission_0_166f8c12>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_370_permission_1_273d6584> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_370_right_0_57851666>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_370_right_1_870d8ce7>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_370_right_2_438d726f>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_370_right_3_bdf53f68> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_370> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_370_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_370_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_370_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_370_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_370_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_370_20250803_OpEnact_c2b252e20f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_370_obligation_0_4853a05c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "370" ;
    dzdoc:position 369 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_370_condition_0_2ef68cb4>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_370_condition_1_66fb8b7e> ;
    dzdoc:usesTerm dzterm:president,
        dzterm:public_prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_420> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_5_subsec_2> ;
    dzdoc:eId "art_420" ;
    dzdoc:fullText """تنعقد محكمة الجنايات الابتدائية أو الاستئنافية في اليوم المحدد لكل قضية وتستحضر المتهم أمامها. ويقوم الرئيس ، بعدئذ، بإجراء القرعة على المحلفين المستدعين للجلوس بجانب قضاة المحكمة. ويجوز أو لا للمتهم أو لمحاميه، ثم من بعده للنيابة العامة وقت استخراج أسماء المحلفين من صندوق القرعة أن يقوم المتهم برد ثلاثة (3) من المحلفين والنيابة برد اثنين (2). ويكون الرد بغير إبداء أسباب. فإذا تعدد المتهمون ، جاز لهم أن يجتمعوا على مباشرة حقهم في رد المحلفين وذلك بحيث لا يتعدى عدد من يقر الرأي على ردهم عن العدد المقرر لمتهم واحد. وإذا لم يتفق المتهمون ، باشروا منفردين حق الرد حسب الترتيب المعين في القرعة، بحيث لا يمكنهم مباشرة أكثر من إجراء رد واحد دفعة واحدة وبحيث لا يتعدى عدد المردودين ما هو مقرر لمتهم واحد. وبعد ذلك يؤدي كل محلف على حدة أمام الرئيس اليمين الآتي نصها :
                "أقسم بالله وأتعهد أمامه وأمام الناس، بأن أمحص بالاهتمام البالغ غاية الدقة، ما يقع من دلائل اتهام على عاتق فلان ( يذكر اسم المتهم)، وألا أبخسه حقوقه أو أخون عهود المجتمع الذي يتهمه، وألا أخابر أحدا ريثما أصدر قراري، وألا أستمع إلى صوت الحقد أو الخبث أو الخوف أو الميل، وأن أصدر قراري حسبما يستبين من الدلائل ووسائل الدفاع وحسبما يرتضيه ضميري ويقتضيه اقتناعي الشخصي، بغير تحيز وبالحزم الجدير بالرجل النزيه الحر، وبأن أحفظ سر المداولات حتى بعد انقضاء مهامي" ويحرر محضر خاص بإثبات هذه الإجراءات يوقع عليه كل من الرئيس وأمين ضبط الجلسة ، كما تجوز الإشارة إلى هذه الإجراءات في محضر المناقشات. ويفترض استيفاء الإجراءات الشكلية المقررة قانونا لتشكيل محكمة الجنايات ، ولا ينقض هذا الافتراض إلا بتضمين في المحضر أو في الحكم أو في إشهاد يفهم منه صراحة وجود نقص في استيفاء الإجراءات."""@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_420_right_0_19a7622a>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_420_right_1_8690f70d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_420> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_420_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_420_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_420_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_420_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_420_para_4>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_420_para_5>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_420_para_6>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_420_para_7> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_420_20250803_OpEnact_adc4f6eea3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_420_obligation_0_1ee9c435>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_420_obligation_1_0fc5b55a>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_420_obligation_2_657b32e9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "420" ;
    dzdoc:position 419 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_420_condition_0_643a10a7>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_420_condition_1_9e484570> ;
    dzdoc:usesTerm dzterm:criminal_court,
        dzterm:president .

<https://legal.dz/resource/law/2025-08-03/25-14#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "يمكن تجميد و / أو حجز الممتلكات والأموال والعائدات غير المشروعة الناتجة عن ارتكاب جريمة أو أكثر من جرائم المخدرات والمؤثرات العقلية و/أو جرائم التهريب و/ أو جرائم الاتجار بالبشر و/أو جرائم الاتجار بالأعضاء و/أو جرائم تهريب المهاجرين و/أو اختطاف الأشخاص و أو المضاربة غير المشروعة و/أو جرائم تبييض الأموال وتمويل الإرهاب وتمويل انتشار أسلحة الدمار الشامل و/ أو جرائم الفساد و/أو جرائم مخالفة التشريع المتعلق بالصرف وحركة الأموال من و إلى الخارج و/أو جرائم مخالفة القانون النقدي والمصرفي و/أو جرائم التهرب والغش الضريبيين و / أو جرائم الإرهاب و /أو الجرائم المتصلة بتكنولوجيات الإعلام والاتصال. يمكن أن تشمل الإجراءات التحفظية التجميد و/أو الحجز الجزئي أو الكلي لممتلكات وأموال الشخص المشتبه فيه وممتلكات وأموال أشخاص لهم صلة به وتوجد قرائن قوية على أنها من العائدات الإجرامية للأفعال محل التحقيقات الجارية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_50_permission_0_bdb5b24e>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_50_permission_1_7a98db4d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_50> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_50_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_50_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_50_20250803_OpEnact_7605c08b46> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "50" ;
    dzdoc:position 49 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_582> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_3_subsec_2> ;
    dzdoc:eId "art_582" ;
    dzdoc:fullText "إذا لم يحصل التبليغ لشخص المتهم ، تعين تقديم المعارضة في المواعيد السابق ذكرها أنفا والتي تسري اعتبارا من تبليغ الحكم بالموطن أو بمقر المجلس الشعبي البلدي أو النيابة. غير أنه إذا لم يحصل التبليغ الشخص المتهم ولم يخلص من إجراء تنفيذي ما اذا كان المتهم قد أحيط علما بحكم الإدانة أو إذا قدم المتهم عذرا بواسطة محاميه أو بواسطة شخص آخر ، فإن معارضته تكون جائزة القبول حتى بالنسبة للحقوق المدنية. وتسري مهلة المعارضة في الحالة المشار إليها في الفقرة السابقة اعتبارا من اليوم الذي أحيط به المتهم علما بالحكم. ويجوز الطعن في الحكم الغيابي بالمعارضة بتقرير كتابي أو شفوي لدى أمانة ضبط الجهة القضائية التي أصدرت الحكم وذلك في مهلة عشرة (10) أيام من التبليغ . ويحكم في المعارضة من الجهة القضائية التي أصدرت الحكم الغيابي"@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_582_right_0_2223eff6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_582> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_582_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_582_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_582_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_582_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_582_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_582_20250803_OpEnact_2b3733743a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "582" ;
    dzdoc:position 581 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_582_condition_0_293446ba>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_582_condition_1_1e7df2a0> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_583> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_3_subsec_2> ;
    dzdoc:eId "art_583" ;
    dzdoc:fullText "تلغي المعارضة المقبولة شكلا ، الصادرة من المتهم أو محاميه، الحكم الصادر غيابيا حتى بالنسبة لما قضى به في شأن طلب المدعي المدني، ويتعين على الجهة القضائية أن تتصدى للموضوع . وأما المعارضة الصادرة من الضحية و / أو من المدعي المدني أو من المسؤول عن الحقوق المدنية فلا أثر لها إلا على ما يتعلق بالحقوق المدنية. وتعتبر المعارضة كأن لم تكن إذا لم يحضر المعارض في التاريخ المحدد له في التبليغ الصادر إليه شفويا أو لمحاميه والمثبت في محضر الطعن بالمعارضة في وقت المعارضة أو بتكليف بالحضور جديد مسلم لمن يعنيه الأمر طبقا للمواد 609 وما يليها من هذا القانون ، وفي هذه الحالة يكون الحكم الصادر في حقه حضوريا. إذا تم الطعن بالمعارضة من طرف المحامي وفق الأوضاع المقررة في المادة 579 (الفقرة 6) أعلاه ، يجب توجيه تكليف بالحضور إلى المتهم . ويتعين، في جميع الأحوال أن يتسلم أطراف الدعوى الآخرون تكليفا جديدا بالحضور ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_583> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_583_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_583_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_583_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_583_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_583_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_583_20250803_OpEnact_1fbcadad89> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_583_obligation_0_d98e89f0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_583_obligation_1_94ea8353>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_583_obligation_2_2d16365f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 583" ;
    dzdoc:position 582 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_579>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_609> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_579>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_609> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_583_condition_0_2048c3ce>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_583_condition_1_e3a10496> ;
    dzdoc:usesTerm dzterm:opposition .

<https://legal.dz/resource/law/2025-08-03/25-14#art_662> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_3> ;
    dzdoc:eId "art_662" ;
    dzdoc:fullText "يجب على الطاعن بالنقض تبليغ مذكرة الطعن بكل وسيلة قانونية إلى باقي الأطراف المعنيين بالطعن في ظرف ثلاثين (30) يوما، ابتداء من تاريخ إيداع المذكرة المذكورة في المادة 661 أعلاه . وإذا كان الطاعن محبوسا يتولى محاميه تبليغ مذكرة الطعن لباقي الأطراف. ويتم التبليغ للنيابة العامة من طرف أمين الضبط في نفس الأجل المنصوص عليه في الفقرة الأولى أعلاه. إذا كان المطعون ضده محبوسا، يبلغ شخصيا بنفس الأشكال المذكورة في الفقرة الأولى أعلاه بواسطة أمين ضبط المؤسسة العقابية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_662> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_662_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_662_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_662_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_662_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_662_20250803_OpEnact_4cfa522966> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_662_obligation_0_ed9acf26> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "662" ;
    dzdoc:position 660 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_661> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_661> ;
    dzdoc:usesTerm dzterm:clerk .

<https://legal.dz/resource/law/2025-08-03/25-14#art_664> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_3> ;
    dzdoc:eId "art_664" ;
    dzdoc:fullText "يخضع الطعن بالنقض لدفع الرسم القضائي تحت طائلة عدم القبول باستثناء الطعون المقدمة من النيابة العامة والدولة والجماعات المحلية. ويسدد هذا الرسم في وقت رفع الطعن، تحت طائلة عدم قبول الطعن شكلا ، وذلك ما لم تكن المساعدة القضائية قد طلبت . ويعفى من دفع الرسم المحكوم عليهم بعقوبات جنائية، والمحبوسون بعقوبة الحبس . ويكون سداد الرسم لأمانة ضبط الجهة التي أصدرت الحكم أو القرار المطعون فيه. تدرج نسخة من وصل سداد الرس سم أو مستخرج من الوضعية الجزائية للطاعن المحبوس، ضمن الملف."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_664_right_0_d1d9fe8e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_664> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_664_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_664_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_664_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_664_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_664_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_664_20250803_OpEnact_106862d35c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_664_obligation_0_ec619f6d>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_664_obligation_1_e5d4665f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "664" ;
    dzdoc:position 662 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_664_condition_0_3b6163db> ;
    dzdoc:usesTerm dzterm:cassation_appeal,
        dzterm:court_fee,
        dzterm:public_prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_70" ;
    dzdoc:fullText "يتحدد اختصاص قاضي التحقيق محليا بمكان وقوع الجريمة أو محل إقامة أحد المتهمين أو المشتبه فيهم ارتكابها أو المساهمة في ارتكابها أو بمحل القبض على أحد هؤلاء الأشخاص حتى ولو كان هذا القبض قد حصل لسبب آخر، ما لم ينص القانون على اختصاص آخر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_70_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_70_20250803_OpEnact_608d1bfed6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 70" ;
    dzdoc:position 69 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_70_condition_0_2fd38ae2> ;
    dzdoc:usesTerm dzterm:investigating_judge .

<https://legal.dz/resource/law/2025-08-03/25-14#art_881> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_1_sec_4> ;
    dzdoc:eId "art_881" ;
    dzdoc:fullText "يجوز الإذن بتسليم شخص من أية جنسية ركانت مسلم إلى حكومة أخرى بناء على طلب بالطريق الدبلوماسي مؤيد بالمستندات اللازمة لإثبات أن الأمر لا يتعلق بجنحة سياسية ، وذلك بطريق المرور عبر الأراضي الجزائرية أو بطريق بواخر الخطوط البحرية الجزائرية. و في حالة الهبوط الاضطراري إذا كان الطريق الجوي هو الذي استعمل فإن هذا التبليغ ينتج آثار طلب القبض المؤقت المشار إليه في المادة 874 أعلاه، و على الدولة الطالبة أن توجه طلبا بالعبور بالشروط المنصوص عليها في الفقرة الأولى من هذه المادة . ولا يجوز إعطاء هذا الإذن بالتسليم بطريق العبور إلا إلى الدول التي تمنح هذا الحق على أراضيها إلى الحكومة الجزائرية . ويتم النقل بواسطة المندوبين الجزائريين وعلى نفقة الحكومة الطالبة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_881_permission_0_5f2a4e07>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_881_permission_1_cdbd7cc0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_881> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_881_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_881_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_881_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_881_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_881_20250803_OpEnact_d1c4806b6d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_881_obligation_0_c22bd762> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "881" ;
    dzdoc:position 879 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_874> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_874> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_881_condition_0_054c5f84>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_881_condition_1_41e52fc2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_881_condition_2_f0f8802f> .

dzterm:supreme_court a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المحكمة العليا"@ar,
        "بالمحكمة العليا"@ar,
        "للمحكمة العليا"@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_199> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_7> ;
    dzdoc:eId "art_199" ;
    dzdoc:fullText "يأمر قاضي التحقيق برفع الرقابة القضائية ، سواء تلقائيا أو بطلب من وكيل الجمهورية أو بطلب من المتهم ، بعد استطلاع رأي وكيل الجمهورية . يفصل قاضي التحقيق في طلب المتهم بأمر مسبب أجل خمسة عشر (15) يوما، ابتداء من يوم تقديم الطلب. و إذا لم يفصل قاضي التحقيق في هذا الأجل ، يمكن المتهم أو وكيل الجمهورية أن يلتجئ مباشرة إلى غرفة الاتهام التي تصدر قرارها في أجل عشرين (20) يوما من تاريخ إخطارها . في كل الأحوال، لا يجوز تجديد طلب رفع الرقابة القضائية المقدم من المتهم أو من محاميه إلا بانتهاء مهلة شهر من تاريخ رفض الطلب السابق."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_199_permission_0_c4e33982>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_199_permission_1_f70800db> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_199_right_0_8b02ec8e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_199> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_199_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_199_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_199_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_199_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_199_20250803_OpEnact_e6ad6e048d> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_199_prohibition_0_f70800db> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "199" ;
    dzdoc:position 198 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_199_condition_0_31fccf3f> ;
    dzdoc:usesTerm dzterm:accused,
        dzterm:investigating_judge,
        dzterm:judicial_control,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_416> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_5_subsec_1> ;
    dzdoc:eId "art_416" ;
    dzdoc:fullText "تنعقد محكمة الجنايات الابتدائية أو الاستئنافية في المكان واليوم والساعة المحدين لافتتاح الدورة . و في حالة تأجيل القضية لأي سبب تراه المحكمة ، فإنها تفصل، عند الاقتضاء، في طلب الإفراج. وإذا قررت المحكمة السير في الدعوى ، يقوم أمين ضبط الجلسة بالمناداة على المحلفين المقيدين في القوائم المعدة طبقا ل المادة 403 أعلاه. ويفصل الرئيس والقضاة أعضاء المحكمة في أمر المحلفين الغائبين، و يحكم على كل محلف تخلف بغير عذر مشروع عن الاستجابة للاستدعاء الذي بلغ إليه أو استجاب إليه ثم انسحب قبل إنهاء مهمته بغرامة من 5000 دج إلى 10.000 دج . ويجوز الطعن بالمعارضة في حكم الإدانة في أجل ثلاثة (3) أيام من التبليغ ، وتفصل فيه محكمة الجنايات خلال الدورة ذاتها أو خلال دورة لاحقة وهي مشكلة من القضاة دون المحلفين."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_416_right_0_ba036b53> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_416> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_416_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_416_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_416_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_416_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_416_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_416_20250803_OpEnact_3383192ef2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_416_obligation_0_0fb85032>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_416_obligation_1_f5c32b18> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "416" ;
    dzdoc:position 415 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_403> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_403> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_416_condition_0_77de986a>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_416_condition_1_c1cd336c> ;
    dzdoc:usesTerm dzterm:clerk,
        dzterm:criminal_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_46> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_46" ;
    dzdoc:fullText """يمكن النيابة العامة الاستعانة في المسائل الفنية بأشخاص مؤهلين ، يتم اختيارهم من بين الأشخاص ذوي الاختصاص، و إذا تعذر ذلك يمكن اختيارهم من جدول الخبراء القضائيين . يؤدي الشخص المؤهل قبل أدائه مهمته اليمين أمام رئيس المحكمة بالصيغة الآتي بيانها:
                "أقسم بالله العظيم بأن أقوم بأداء مهامي على أحسن وجه وأن أحافظ على سرية المعلومات التي أطلع عليها بمناسبة أداء أعمالي" . يقوم الأشخاص المؤهلون بإنجاز المهام المسندة إليهم، تحت إشراف النيابة العامة التي يمكنها إطلاعهم على ملف الإجراءات ، وتتلقى توضيحاتهم الشفوية و/أو المكتوبة في كل المسائل التي ترى فيها ضرورة. تنجز الأعمال التي يقوم بها الأشخاص المؤهلون في شكل تقارير تلخيصية أو تحليلية يمكن أن ترفق بالتماسات النيابة العامة . تحدد شروط وكيفيات اختيار الأشخاص المؤهلين ونظامهم التعويضي عن طريق التنظيم."""@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_46_permission_0_4f77f971>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_46_permission_1_5764e1a3> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_46_right_0_13135a0f>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_46_right_1_ee18e187> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_46> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_46_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_46_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_46_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_46_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_46_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_46_20250803_OpEnact_e607095332> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_46_obligation_0_0b093f15>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_46_obligation_1_0cea6995> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "46" ;
    dzdoc:position 45 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_46_condition_0_1f627b0d> ;
    dzdoc:usesTerm dzterm:public_prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_500> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_5> ;
    dzdoc:eId "art_500" ;
    dzdoc:fullText "إذا كانت حالة المتهم الصحية لا تمكنه من الحضور أمام المحكمة ووجدت أسباب خطيرة لعدم تأجيل القضية أو إذا اقتضى حسن العدالة الفصل فيها ، أمرت المحكمة، بقرار خاص و مسبب باستجوابه بحضور محاميه، بمسكنه أو بالمؤسسة الاستشفائية المتواجد بها أو بالمؤسسة العقابية التي يكون محبوسا بها، وذلك بواسطة قاض منتدب لهذا الغرض مصحوبا بأمين ضبط. ويحرر محضرا بهذا الاستجواب الذي تأمر به المحكمة. وتؤجل القضية بتاريخ محدد لأقرب جلسة مناسبة، و يتعين استدعاء المتهم لحضورها . و في جميع هذه الأحوال، يكون الحكم على المتهم حضوريا. ويجوز أن يوكل عنه محاميا يمثله ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_500_right_0_502ca243> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_500> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_500_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_500_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_500_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_500_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_500_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_500_20250803_OpEnact_918bd313d1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_500_obligation_0_7520624e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "500" ;
    dzdoc:position 499 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_500_condition_0_8c61fd87> ;
    dzdoc:usesTerm dzterm:accused .

<https://legal.dz/resource/law/2025-08-03/25-14#art_73> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_73" ;
    dzdoc:fullText "يجب على ضابط الشرطة القضائية الذي بلغ بجناية في حالة تلبس أن يخطر بها وكيل الجمهورية على الفور ثم ينتقل بدون تمهل إلى مكان الجناية، ويتخذ جميع التحريات اللازمة . وعليه أن يسهر على المحافظة على الآثار التي يخشى أن تختفي . وأن يضبط كل ما يمكن أن يؤدي إلى إظهار الحقيقة . وأن يعرض الأشياء المضبوطة على الأشخاص المشتبه في مساهمتهم في الجناية للتعرف عليها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_73_permission_0_4f443185> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_73> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_73_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_73_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_73_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_73_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_73_20250803_OpEnact_5adedab92c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_73_obligation_0_911b9f23>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_73_obligation_1_133ca883>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_73_obligation_2_b1291a78>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_73_obligation_3_6a54617d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "73" ;
    dzdoc:position 72 ;
    dzdoc:usesTerm dzterm:judicial_police_officer,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_744> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_9> ;
    dzdoc:eId "art_744" ;
    dzdoc:fullText "كل واقعة موصوفة بأنها جناية معاقب عليها في القانون الجزائري ارتكبها جزائري خارج الإقليم الوطني، يجوز أن تتابع ويحكم فيها في الجزائر. غير أنه لا يجوز أن تجرى المتابعة أو المحاكمة إلا إذا لم يثبت الجاني أنه حكم عليه نهائيا في الخارج وأن يثبت في حالة الحكم بالإدانة أنه قضى العقوبة أو سقطت عنه بالتقادم أو حصل على العفو عنها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_744_permission_0_171e8421>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_744_permission_1_6fe05606> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_744> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_744_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_744_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_744_20250803_OpEnact_c791a23bae> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_744_prohibition_0_6fe05606> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "744" ;
    dzdoc:position 742 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_744_condition_0_04a0d612> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_765> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_3> ;
    dzdoc:eId "art_765" ;
    dzdoc:fullText "يتعين على كل جهة قضائية جزائية حينما تصدر حكما بعقوبة غرامة أو رد ما يلزم رده أو تقضي بتعويض مدني أو بمصاريف، أن تحدد مدة الإكراه البدني . غير أنه لا يجوز الحكم بـ الإكراه البدني أو تطبيقه في الأحوال الآتية : في قضايا الجرائم السياسية، في حالة الحكم بعقوبة الإعدام أو السجن المؤبد، إذا كان عمر الفاعل يوم ارتكاب الجريمة يقل عن الثامنة عشرة (18) سنة، إذا ما بلغ المحكوم عليه الخامسة والستين (65) سنة من عمره، ضد المدين لصالح زوجه أو أصوله أو فروعه أو إخوته أو أخواته أو عمه أو عمته أو خالته أو أخيه أو أخته أو ابن أحدهما أو أصهاره من الدرجة نفسها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_765_permission_0_557126c1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_765> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_765_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_765_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_765_20250803_OpEnact_19955bed89> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_765_obligation_0_c6284e2d> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_765_prohibition_0_557126c1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 765" ;
    dzdoc:position 763 ;
    dzdoc:usesTerm dzterm:physical_coercion .

<https://legal.dz/resource/law/2025-08-03/25-14#art_834> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_5> ;
    dzdoc:eId "art_834" ;
    dzdoc:fullText "إن العقوبات المقيدة في صحيفة السوابق القضائية لا يمكن أن تشكل، بأي صفة، مانعا لتوظيف الأشخاص الذين تتعلق بهم لدى الإدارات والمؤسسات العمومية ، ما لم تتناف الجريمة المرتكبة مع ممارسة الوظيفة المراد شغلها . كما لا يمكن أن تشكل عائقا لممارسة نشاط اجتماعي أو اقتصادي أو نشاط في مؤسسات القطاع الخاص ، ما لم ينص القانون على خلاف ذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_834_permission_0_d010204d>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_834_permission_1_115409ad> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_834_right_0_e09332f5>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_834_right_1_e38c7c96> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_834> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_834_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_834_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_834_20250803_OpEnact_0adaf02133> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "834" ;
    dzdoc:position 832 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_834_condition_0_b42237e8>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_834_condition_1_df257e89> ;
    dzdoc:usesTerm dzterm:criminal_record,
        dzterm:penalties .

