<https://legal.dz/resource/law/2025-08-03/25-14#version_art_529> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن ينص كل حكم على هوية الأطراف وحضورهم أو غيابهم يوم النطق بالحكم . و يجب أن يشتمل على أسباب ومنطوق . وتكون الأسباب أساس الحكم. ويبين المنطوق الجرائم التي تقرر إدانة الأشخاص المذكورين أو مسؤوليتهم أو مساءلتهم عنها، كما تذكر به العقوبة ونصوص القانون المطبقة وما قضى به في الدعوى المدنية. يقوم الرئيس بتلاوة منطوق الحكم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_529_20250803_OpEnact_f6b137f5d9> ;
    dzdoc:replacementText "يجب أن ينص كل حكم على هوية الأطراف وحضورهم أو غيابهم يوم النطق بالحكم . و يجب أن يشتمل على أسباب ومنطوق . وتكون الأسباب أساس الحكم. ويبين المنطوق الجرائم التي تقرر إدانة الأشخاص المذكورين أو مسؤوليتهم أو مساءلتهم عنها، كما تذكر به العقوبة ونصوص القانون المطبقة وما قضى به في الدعوى المدنية. يقوم الرئيس بتلاوة منطوق الحكم ."@ar ;
