<https://legal.dz/resource/law/2025-08-03/25-14#version_art_857> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز تسليم شخص إلى حكومة أجنبية ما لم يكن قد اتخذت في شأنه إجراءات متابعة عن جريمة منصوص عليها في هذا الباب أو حكم عليه فيها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_857_20250803_OpEnact_ffdb604d11> ;
    dzdoc:replacementText "لا يجوز تسليم شخص إلى حكومة أجنبية ما لم يكن قد اتخذت في شأنه إجراءات متابعة عن جريمة منصوص عليها في هذا الباب أو حكم عليه فيها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
