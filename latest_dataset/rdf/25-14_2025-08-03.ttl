        <https://legal.dz/resource/law/2025-08-03/25-14#art_198_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_198_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_198_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_198_para_4>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_198_para_5>,
