<https://legal.dz/resource/law/2025-08-03/25-14#version_art_184> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز ل قاضي التحقيق ، حسبما تقتضي الحالة، أن يصدر أمرا بإحضار المتهم أو بإيداعه الحبس أو بإلقاء القبض عليه . ويتعين أن يذكر في كل أمر نوع التهمة والمواد القانونية المطبقة، مع إيضاح هوية المتهم ويؤرخ الأمر ويوقع عليه من القاضي الذي أصدره ويمهر بختمه . وتكون تلك الأوامر نافذة المفعول في جميع أنحاء الأراضي الجزائرية. ويجب أن يؤشر على الأوامر التي يصدرها قاضي التحقيق من وكيل الجمهورية ، وأن ترسل بمعرفته ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_184_20250803_OpEnact_b18c2fd019> ;
    dzdoc:replacementText "يجوز ل قاضي التحقيق ، حسبما تقتضي الحالة، أن يصدر أمرا بإحضار المتهم أو بإيداعه الحبس أو بإلقاء القبض عليه . ويتعين أن يذكر في كل أمر نوع التهمة والمواد القانونية المطبقة، مع إيضاح هوية المتهم ويؤرخ الأمر ويوقع عليه من القاضي الذي أصدره ويمهر بختمه . وتكون تلك الأوامر نافذة المفعول في جميع أنحاء الأراضي الجزائرية. ويجب أن يؤشر على الأوامر التي يصدرها قاضي التحقيق من وكيل الجمهورية ، وأن ترسل بمعرفته ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_184> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_184> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
