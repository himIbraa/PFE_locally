    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_216> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرد دائما الجزء الثاني من مبلغ الكفالة إلى المتهم إذا صدر أمر نهائي أو قرار بألا وجه للمتابعة أو حكم نهائي بالإعفاء من العقوبة أو بالبراءة. أما إذا صدر ضده حكم نهائي بالإدانة، فيخصص ذلك الجزء لسداد المصاريف وأداء الغرامة ورد المحكوم برده و دفع التعويضات المدنية المقررة للمدعي المدني بالترتيب الموضح ب المادة 213 أعلاه. ويرد الباقي من مبلغ الكفالة للمتهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_216_20250803_OpEnact_e0f51b4243> ;
    dzdoc:replacementText "يرد دائما الجزء الثاني من مبلغ الكفالة إلى المتهم إذا صدر أمر نهائي أو قرار بألا وجه للمتابعة أو حكم نهائي بالإعفاء من العقوبة أو بالبراءة. أما إذا صدر ضده حكم نهائي بالإدانة، فيخصص ذلك الجزء لسداد المصاريف وأداء الغرامة ورد المحكوم برده و دفع التعويضات المدنية المقررة للمدعي المدني بالترتيب الموضح ب المادة 213 أعلاه. ويرد الباقي من مبلغ الكفالة للمتهم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_216> ;
