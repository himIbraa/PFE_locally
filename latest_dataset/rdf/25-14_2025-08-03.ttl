    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_39> ;
    dznorm:position 3 ;
    dznorm:provisionText "تتولى العمل على تنفيذ أحكام القضاء"@ar ;
    dznorm:sourceArticle "art_39" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_39_obligation_3_d9795f63_role_d81bcc26a2> a dznorm:Role ;
    rdfs:label "تنفيذ أحكام القضاء"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "تتولى العمل على تنفيذ أحكام القضاء"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_39> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_39_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_39> ;
    dzdoc:position 0 ;
    dzdoc:text "تباشر النيابة العامة الدعوى العمومية باسم المجتمع، وتطالب بتطبيق القانون، وهي تمثل أمام كل جهة قضائية، ويحضر ممثلها أمام جهات التحقيق والحكم، ويتعين أن ينطق بالأحكام في حضوره، كما تتولى العمل على تنفيذ أحكام القضاء ، ولها، في سبيل مباشرة وظائفها، أن تلجأ إلى القوة العمومية. كما تستعين بضباط وأعوان الشرطة القضائية."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_3_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_3> ;
    dzdoc:position 0 ;
    dzdoc:text "يتعلق الحق في مباشرة الدعوى المدنية للمطالبة بتعويض الضرر الناجم عن جناية أو جنحة أو مخالفة لكل من أصابهم شخصيا ضرر نتج مباشرة عن الجريمة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_3_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_3> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا يترتب على التنازل عن الدعوى المدنية أو عدم مباشرتها أمام الجهة القضائية الجزائية، إيقاف أو إرجاء مباشرة الدعوى العمومية، وذلك مع مراعاة الحالات المشار إليها في الفقرة 3 من المادة 9 أدناه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_3_right_0_8a37bd9e> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
