    dzdoc:evidenceText "يتحدد الاختصاص المحلي للجهة القضائية بمكان ارتكاب الجريمة أو مكان وجود المقر الاجتماعي ل الشخص المعنوي . غير أنه إذا تمت متابعة أشخاص طبيعية في الوقت ذاته مع الشخص المعنوي ، تختص الجهات القضائية المرفوعة أمامها دعوى الأشخاص الطبيعية بمتابعة الشخص المعنوي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_101_20250803_OpEnact_689da1f9f2> ;
    dzdoc:replacementText "يتحدد الاختصاص المحلي للجهة القضائية بمكان ارتكاب الجريمة أو مكان وجود المقر الاجتماعي ل الشخص المعنوي . غير أنه إذا تمت متابعة أشخاص طبيعية في الوقت ذاته مع الشخص المعنوي ، تختص الجهات القضائية المرفوعة أمامها دعوى الأشخاص الطبيعية بمتابعة الشخص المعنوي ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
