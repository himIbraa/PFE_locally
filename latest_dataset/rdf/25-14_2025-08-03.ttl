<https://legal.dz/resource/law/2025-08-03/25-14#version_art_293> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رأت غرفة الاتهام أن وقائع الدعوى المنسوبة إلى المتهم تشكل جريمة لها قانونا وصف الجناية ، فإنها تقضي بإحالة المتهم أمام محكمة الجنايات الابتدائية، ولها أيضا أن ترفع إلى تلك المحكمة قضايا الجرائم المرتبطة بتلك الجناية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_293_20250803_OpEnact_d8eceae419> ;
    dzdoc:replacementText "إذا رأت غرفة الاتهام أن وقائع الدعوى المنسوبة إلى المتهم تشكل جريمة لها قانونا وصف الجناية ، فإنها تقضي بإحالة المتهم أمام محكمة الجنايات الابتدائية، ولها أيضا أن ترفع إلى تلك المحكمة قضايا الجرائم المرتبطة بتلك الجناية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_293> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
