    dznorm:provisionText "مددت المهلة إلى أول يوم تال له من أيام العمل"@ar ;
    dznorm:sourceArticle "art_654" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_654_obligation_1_21a0a500> a dznorm:Obligation ;
