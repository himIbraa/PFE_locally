<https://legal.dz/resource/law/2025-08-03/25-14#version_art_800> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "القسيمة رقم 3 هي بيان للأحكام الصادرة من إحدى الجهات القضائية للجمهورية الجزائرية في جناية أو جنحة قضت بعقوبات مقيدة للحرية تفوق شهرا واحدا . غير أنه عندما تكون العقوبة القصوى المقررة قانونا تفوق ثلاث (3) سنوات حبسا ، تقيد بها حتى العقوبات التي تساوي أو تقل عن شهر، ما لم تأمر الجهة القضائية، تلقائيا أو بناء على طلب المعني، بعدم قيد العقوبة في القسيمة رقم 3 من صحيفة السوابق القضائية إذا ثبت لها أنه تم جبر الضرر ووضع حد للإخلال الناتج عن الجنحة . ولا تثبت في القسيمة رقم 3 إلا الأحكام المشار إليها "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_800_20250803_OpEnact_d1af5a9b44> ;
    dzdoc:replacementText "القسيمة رقم 3 هي بيان للأحكام الصادرة من إحدى الجهات القضائية للجمهورية الجزائرية في جناية أو جنحة قضت بعقوبات مقيدة للحرية تفوق شهرا واحدا . غير أنه عندما تكون العقوبة القصوى المقررة قانونا تفوق ثلاث (3) سنوات حبسا ، تقيد بها حتى العقوبات التي تساوي أو تقل عن شهر، ما لم تأمر الجهة القضائية، تلقائيا أو بناء على طلب المعني، بعدم قيد العقوبة في القسيمة رقم 3 من صحيفة السوابق القضائية إذا ثبت لها أنه تم جبر الضرر ووضع حد للإخلال الناتج عن الجنحة . ولا تثبت في القسيمة رقم 3 إلا الأحكام المشار إليها فيما تقدم والتي لم يمحها رد الاعتبار ولم تكن مشمولة بوقف النفاذ إلا إذا صدر حكم جديد يح ماحب الشأن من الاستفادة من وقف النفاذ إذا تضمن الحكم عقوبة تكميلية بالحرمان أو بإسقاط حق أو بعدم الأهلية فإن هذه العقوبة تكميلية تسجل في القسيمة رقم 3 طيلة فترة تنفيذها، وتسجل أيضا العقوبة الأصلية مهما كانت نوعيتها نافذة أو غير نافذة. ويوضح في القسيمة صراحة أنها سلمت وفقا لأحكام هذه المادة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_800> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_800> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
