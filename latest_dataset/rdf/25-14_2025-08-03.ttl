<https://legal.dz/resource/law/2025-08-03/25-14#version_art_244> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل أمر يصدر بندب خبراء يجب أن تحدد فيه مهلة لإنجاز مهمتهم ، ويجوز أن تمدد هذه المهلة بناء على طلب الخبراء إذا اقتضت ذلك أسباب خاصة ، ويكون ذلك بأمر معلل يصدره القاضي أو الجهة التي ندبتهم، و إذا لم يودع الخبراء تقاريرهم في الميعاد المحدد لهم جاز في الحال أن يستبدل بهم غيرهم و عليهم، إذ ذاك، أن يقدموا نتائج ما قاموا به من أبحاث ، كما عليهم أن يردوا في ظرف ثمان وأربعين (48) ساعة جميع الأشياء والأوراق والوثائق التي تكون قد عهد بها إليهم على ذمة إنجاز مهمتهم ، وعلاوة على ذلك، فمن الجائز أن تترتب عليه"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_244_20250803_OpEnact_dbd32663b6> ;
    dzdoc:replacementText "كل أمر يصدر بندب خبراء يجب أن تحدد فيه مهلة لإنجاز مهمتهم ، ويجوز أن تمدد هذه المهلة بناء على طلب الخبراء إذا اقتضت ذلك أسباب خاصة ، ويكون ذلك بأمر معلل يصدره القاضي أو الجهة التي ندبتهم، و إذا لم يودع الخبراء تقاريرهم في الميعاد المحدد لهم جاز في الحال أن يستبدل بهم غيرهم و عليهم، إذ ذاك، أن يقدموا نتائج ما قاموا به من أبحاث ، كما عليهم أن يردوا في ظرف ثمان وأربعين (48) ساعة جميع الأشياء والأوراق والوثائق التي تكون قد عهد بها إليهم على ذمة إنجاز مهمتهم ، وعلاوة على ذلك، فمن الجائز أن تترتب عليهم المسؤولية المدنية وتتخذ ضدهم تدابير تأديبية قد تصل إلى شطب أسمائهم من جدول الخبراء المنصوص عليه في المادة 240 أعلاه. ويجب على الخبراء ، عند القيام بمهمتهم، أن يكونوا على اتصال بـ قاضي التحقيق أو بـ القاضي المنتدب ، وأن يحيطوه علما بتطورات الأعمال التي يقومون بها، ويمكنوه من كل ما يجعله في كل حين قادرا على اتخاذ الإجراءات اللازمة . ويجوز دائما لـ قاضي التحقيق ، أثناء إجراءاته، أن يستعين بـ الخبراء إذا رأى لزوما لذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_244> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_244> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_245> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا طلب الخبراء الاستنارة في مسألة خارجة عن نطاق تخصصهم ، فيجوز لـ القاضي أن يرخص لهم بضم فنيين يعينون بأسمائهم ويكونون، على الخصوص، مختارين لتخصصهم. ويحلف الفنيون المعينون على هذا الوجه، اليمين ضمن الشروط المنصوص عليها في المادة 241 أعلاه . ويرفق تقريرهم بكامله بالتقرير المنوه عنه في المادة 249 أدناه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_245_20250803_OpEnact_179be14c1f> ;
    dzdoc:replacementText "إذا طلب الخبراء الاستنارة في مسألة خارجة عن نطاق تخصصهم ، فيجوز لـ القاضي أن يرخص لهم بضم فنيين يعينون بأسمائهم ويكونون، على الخصوص، مختارين لتخصصهم. ويحلف الفنيون المعينون على هذا الوجه، اليمين ضمن الشروط المنصوص عليها في المادة 241 أعلاه . ويرفق تقريرهم بكامله بالتقرير المنوه عنه في المادة 249 أدناه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_245> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
