<https://legal.dz/resource/law/2025-08-03/25-14#version_art_333> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يختم التحقيق المنصوص عليه في المادة 330 أعلاه وما بعدها، في حالة قيام المحكوم عليه بالدفع . إذا قدر وكيل الجمهورية إغلاق التحقيق ، يعلم بقراره مصلحة تنفيذ العقوبات و مصلحة تحصيل الغرامات الجزائية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_333_20250803_OpEnact_1dd1a71e73> ;
    dzdoc:replacementText "يختم التحقيق المنصوص عليه في المادة 330 أعلاه وما بعدها، في حالة قيام المحكوم عليه بالدفع . إذا قدر وكيل الجمهورية إغلاق التحقيق ، يعلم بقراره مصلحة تنفيذ العقوبات و مصلحة تحصيل الغرامات الجزائية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_333> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
