<https://legal.dz/resource/law/2025-08-03/25-14#art_7_condition_0_282f5582> a dznorm:Condition ;
    dznorm:conditionText "إذا حركت الدعوى العمومية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_7> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_7_condition_1_e5f9e44d> a dznorm:Condition ;
    dznorm:conditionText "متى كان وجود الالتزام لا يثير نزاعا جديا حتى ولو تأسس المدعي طرفا مدنيا أمام الجهة القضائية الجزائية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_7> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_7_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_7> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا حركت الدعوى العمومية، تبقى الجهة القضائية المدنية التي رفعت أمامها الدعوى الاستعجالية مختصة لاتخاذ أية تدابير مؤقتة تتعلق بالوقائع موضوع المتابعة متى كان وجود الالتزام لا يثير نزاعا جديا حتى ولو تأسس المدعي طرفا مدنيا أمام الجهة القضائية الجزائية."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_800_condition_0_fb1086e5> a dznorm:Condition ;
    dznorm:conditionText "عندما تكون العقوبة القصوى المقررة قانونا تفوق ثلاث (3) سنوات حبسا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_800> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_800_condition_1_510996e0> a dznorm:Condition ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2025-08-03/25-14#art_800_condition_1_510996e0_period_7cae5690e8> ;
    dznorm:conditionText "إذا ثبت لها أنه تم جبر الضرر ووضع حد للإخلال الناتج عن الجنحة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_800> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_800_condition_1_510996e0_period_7cae5690e8> a dznorm:Period ;
    rdfs:label "خلال الناتج عن الجنحة"@ar ;
    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "إذا ثبت لها أنه تم جبر الضرر ووضع حد للإخلال الناتج عن الجنحة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_800> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_800_condition_2_0651bae7> a dznorm:Condition ;
    dznorm:conditionText "إذا تضمن الحكم عقوبة تكميلية بالحرمان أو بإسقاط حق أو بعدم الأهلية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_800> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_800_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_800> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أنه عندما تكون العقوبة القصوى المقررة قانونا تفوق ثلاث (3) سنوات حبسا، تقيد بها حتى العقوبات التي تساوي أو تقل عن شهر، ما لم تأمر الجهة القضائية، تلقائيا أو بناء على طلب المعني، بعدم قيد العقوبة في القسيمة رقم 3 من صحيفة السوابق القضائية إذا ثبت لها أنه تم جبر الضرر ووضع حد للإخلال الناتج عن الجنحة. ولا تثبت في القسيمة رقم 3 إلا الأحكام المشار إليها فيما تقدم والتي لم يمحها رد الاعتبار ولم تكن مشمولة بوقف النفاذ إلا إذا صدر حكم جديد يح ماحب الشأن من الاستفادة من وقف النفاذ إذا تضمن الحكم عقوبة تكميلية بالحرمان أو بإسقاط حق أو بعدم الأهلية فإن هذه العقوبة تكميلية تسجل في القسيمة رقم 3 طيلة فترة تنفيذها، وتسجل أيضا العقوبة الأصلية مهما كانت نوعيتها نافذة أو غير نافذة. ويوضح في القسيمة صراحة أنها سلمت وفقا لأحكام هذه المادة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_801_condition_0_d12634ae> a dznorm:Condition ;
    dznorm:conditionText "بعد التحقق من هويته"@ar ;
