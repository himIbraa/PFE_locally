    dznorm:conditionText "عندما تقتضي ضرورات التحري أو التحقيق في إحدى الجرائم المذكورة في المادة 114 أعلاه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_120> ;
