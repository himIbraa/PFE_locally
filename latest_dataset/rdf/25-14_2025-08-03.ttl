<https://legal.dz/resource/law/2025-08-03/25-14#version_art_229> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد رئيس اللجنة تاريخ الجلسة بعد استشارة النائب العام ، و يبلغ هذا تاريخ من طرف أمين اللجنة برسالة موصى عليها مع إشعار بالاستلام للمدعي و للوكيل القضائي للخزينة في ظرف شهر، على الأقل، قبل تاريخ الجلسة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_229_20250803_OpEnact_aaf6a12b22> ;
    dzdoc:replacementText "يحدد رئيس اللجنة تاريخ الجلسة بعد استشارة النائب العام ، و يبلغ هذا تاريخ من طرف أمين اللجنة برسالة موصى عليها مع إشعار بالاستلام للمدعي و للوكيل القضائي للخزينة في ظرف شهر، على الأقل، قبل تاريخ الجلسة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_229> ;
