<https://legal.dz/resource/law/2025-08-03/25-14#version_art_715> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا انقضت مهلة الإيداع المحددة في المادة 714 أعلاه ، فإنه يفصل في الطلبات خلال عشرة (10) أيام بغرفة المشورة من الرئيس الأول ورؤساء الغرف بالمحكمة العليا . ويبلغ القرار إلى أطراف النزاع الذين يعنيهم الأمر من طرف مصالح النيابة العامة لدى المحكمة المذكورة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_715_20250803_OpEnact_39101fcb00> ;
    dzdoc:replacementText "إذا انقضت مهلة الإيداع المحددة في المادة 714 أعلاه ، فإنه يفصل في الطلبات خلال عشرة (10) أيام بغرفة المشورة من الرئيس الأول ورؤساء الغرف بالمحكمة العليا . ويبلغ القرار إلى أطراف النزاع الذين يعنيهم الأمر من طرف مصالح النيابة العامة لدى المحكمة المذكورة ."@ar ;
