<https://legal.dz/resource/law/2025-08-03/25-14#version_art_526> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون الحكم برفض طلب الاسترداد قابلا للاستئناف من جانب من تقدم بهذا الطلب. والحكم الصادر بالموافقة على رد الأشياء المستردة قابل للاستئناف من جانب كل من النيابة العامة والمتهم والمسؤول عن الحقوق المدنية والضحية والمدعي المدني إذا كان يلحقهم ضرر من هذا الحكم . ولا يرفع الأمر للمجلس القضائ إلا بعد أن تفصل المحكمة في الموضوع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_526_20250803_OpEnact_70a6004143> ;
    dzdoc:replacementText "يكون الحكم برفض طلب الاسترداد قابلا للاستئناف من جانب من تقدم بهذا الطلب. والحكم الصادر بالموافقة على رد الأشياء المستردة قابل للاستئناف من جانب كل من النيابة العامة والمتهم والمسؤول عن الحقوق المدنية والضحية والمدعي المدني إذا كان يلحقهم ضرر من هذا الحكم . ولا يرفع الأمر للمجلس القضائ إلا بعد أن تفصل المحكمة في الموضوع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_526> ;
