    dzdoc:position 2 ;
    dzdoc:text "وتتبع في كيفيات احتساب آجال التقادم، الأحكام الموضحة في المادة 10 أعلاه."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_120_condition_0_a0458e89> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2025-08-03/25-14#art_120_condition_0_a0458e89_ref_a2d261251286> ;
