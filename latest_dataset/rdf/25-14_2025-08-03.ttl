    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_885> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رأت الحكومة الأجنبية في دعوى جزائية يتم التحقيق فيها في الخارج أنه من الضروري طلب إرسال أدلة إثبات أو مستندات توجد تحت يد السلطات الجزائرية فيقدم طلب عنها بالطريق الدبلوماسي ويجاب هذا الطلب على أن تلتزم برد الأوراق والمستندات في أقصر أجل وذلك ما لم تحل اعتبارات خاصة دون إجابته ."@ar ;
