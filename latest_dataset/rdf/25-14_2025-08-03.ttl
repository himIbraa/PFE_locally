    dzdoc:referencesTarget <https://legal.dz/resource/law/2025-08-03/25-14#art_717> ;
    dzdoc:sourceEId "art_468" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "الأوضاع المنصوص عليها في المادتين 716 و 717 من هذا القانون"@ar ;
    dzdoc:targetEId "art_717" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_468_condition_0_affcb4cf_ref_7a03e8722a0d> a dzdoc:Reference ;
    rdfs:label "المادتين 716"@ar ;
    dzdoc:frbrUri "#art_716"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2025-08-03/25-14#art_716> ;
    dzdoc:sourceEId "art_468" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "الأوضاع المنصوص عليها في المادتين 716 و 717 من هذا القانون"@ar ;
    dzdoc:targetEId "art_716" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_468_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_468> ;
    dzdoc:position 0 ;
    dzdoc:text "تختص محليا بالنظر في الجنحة محكمة مكان وقوع الجريمة أو محل إقامة أحد المتهمين أو شركائهم أو محل القبض عليهم ولو كان هذا القبض قد وقع لسبب آخر."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_468_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_468> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا تكون محكمة محل حبس المحكوم عليه مختصة إلا وفق الأوضاع المنصوص عليها في المادتين 716 و 717 من هذا القانون."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_468_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_468> ;
    dzdoc:position 2 ;
    dzdoc:text "كما تختص المحكمة كذلك بالنظر في الجنح والمخالفات غير القابلة للتجزئة أو المرتبطة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_468_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_468> ;
    dzdoc:position 3 ;
    dzdoc:text "وتختص المحكمة التي ارتكبت في نطاق دائرتها المخالفة أو المحكمة الموجود بها محل إقامة مرتكب المخالفة بالنظر في تلك المخالفة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_469_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_469> ;
    dzdoc:position 0 ;
    dzdoc:text "تختص المحكمة المطروحة أمامها الدعوى العمومية بالفصل في جميع الدفوع التي يبديها المتهم دفاعا عن نفسه ما لم ينص القانون على غير ذلك."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_46_condition_0_1f627b0d> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_46_condition_0_1f627b0d_action_d78ee33a5b> ;
    dznorm:conditionText "إذا تعذر ذلك يمكن اختيارهم من جدول الخبراء القضائيين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_46> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_46_condition_0_1f627b0d_action_d78ee33a5b> a dznorm:Action ;
    rdfs:label "اختيارهم من جدول الخبراء القضائيين"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "إذا تعذر ذلك يمكن اختيارهم من جدول الخبراء القضائيين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_46> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_46_obligation_0_0b093f15> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_46_obligation_0_0b093f15_role_9df79cb50f>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_46_obligation_0_0b093f15_role_c250ca09e6> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_46> ;
    dznorm:position 0 ;
    dznorm:provisionText """يؤدي الشخص المؤهل قبل أدائه مهمته اليمين أمام رئيس المحكمة بالصيغة الآتي بيانها:
                "أقسم بالله العظيم بأن أقوم بأداء مهامي على أحسن وجه وأن أحافظ على سرية المعلومات التي أطلع عليها بمناسبة أداء أعمالي\""""@ar ;
    dznorm:sourceArticle "art_46" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_46_obligation_0_0b093f15_role_9df79cb50f> a dznorm:Role ;
    rdfs:label "سرية المعلومات التي أطلع"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan """يؤدي الشخص المؤهل قبل أدائه مهمته اليمين أمام رئيس المحكمة بالصيغة الآتي بيانها:
                "أقسم بالله العظيم بأن أقوم بأداء مهامي على أحسن وجه وأن أحافظ على سرية المعلومات التي أطلع عليها بمناسبة أداء أعمالي\""""@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_46> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_46_obligation_0_0b093f15_role_c250ca09e6> a dznorm:Role ;
    rdfs:label "أحسن وجه وأن أحافظ"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan """يؤدي الشخص المؤهل قبل أدائه مهمته اليمين أمام رئيس المحكمة بالصيغة الآتي بيانها:
                "أقسم بالله العظيم بأن أقوم بأداء مهامي على أحسن وجه وأن أحافظ على سرية المعلومات التي أطلع عليها بمناسبة أداء أعمالي\""""@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_46> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_46_obligation_1_0cea6995> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_46> ;
    dznorm:position 1 ;
    dznorm:provisionText "يقوم الأشخاص المؤهلون بإنجاز المهام المسندة إليهم، تحت إشراف النيابة العامة"@ar ;
    dznorm:sourceArticle "art_46" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_46_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_46> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن النيابة العامة الاستعانة في المسائل الفنية بأشخاص مؤهلين ، يتم اختيارهم من بين الأشخاص ذوي الاختصاص، وإذا تعذر ذلك يمكن اختيارهم من جدول الخبراء القضائيين."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_46_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_46> ;
    dzdoc:position 1 ;
    dzdoc:text """يؤدي الشخص المؤهل قبل أدائه مهمته اليمين أمام رئيس المحكمة بالصيغة الآتي بيانها:
                "أقسم بالله العظيم بأن أقوم بأداء مهامي على أحسن وجه وأن أحافظ على سرية المعلومات التي أطلع عليها بمناسبة أداء أعمالي"."""@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_46_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_46> ;
    dzdoc:position 2 ;
    dzdoc:text "يقوم الأشخاص المؤهلون بإنجاز المهام المسندة إليهم، تحت إشراف النيابة العامة التي يمكنها إطلاعهم على ملف الإجراءات، وتتلقى توضيحاتهم الشفوية و/أو المكتوبة في كل المسائل التي ترى فيها ضرورة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_46_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_46> ;
    dzdoc:position 3 ;
    dzdoc:text "تنجز الأعمال التي يقوم بها الأشخاص المؤهلون في شكل تقارير تلخيصية أو تحليلية يمكن أن ترفق بالتماسات النيابة العامة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_46_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_46> ;
    dzdoc:position 4 ;
    dzdoc:text "تحدد شروط وكيفيات اختيار الأشخاص المؤهلين ونظامهم التعويضي عن طريق التنظيم."@ar .

