<https://legal.dz/resource/law/2025-08-03/25-14#version_art_299> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يباشر رئيس غرفة الاتهام السلط المحددة في هذا القسم. وفي حالة وجود مانع لديه تمنح السلطات الخاصة به، بقرار من رئيس المجلس القضائي ، لقاض من قضاة الحكم بنفس المجلس القضائي. ويسوغ للرئيس أن يفوض هذه السلطات إلى قاض من قضاة الحكم بغرفة الاتهام من أجل القيام بأعمال معينة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_299_20250803_OpEnact_4c10829843> ;
    dzdoc:replacementText "يباشر رئيس غرفة الاتهام السلط المحددة في هذا القسم. وفي حالة وجود مانع لديه تمنح السلطات الخاصة به، بقرار من رئيس المجلس القضائي ، لقاض من قضاة الحكم بنفس المجلس القضائي. ويسوغ للرئيس أن يفوض هذه السلطات إلى قاض من قضاة الحكم بغرفة الاتهام من أجل القيام بأعمال معينة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_299> ;
