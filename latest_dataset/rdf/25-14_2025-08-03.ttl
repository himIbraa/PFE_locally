<https://legal.dz/resource/law/2025-08-03/25-14#art_285_condition_0_3ba182b3> a dznorm:Condition ;
    dznorm:conditionText "ما لم يسبق بشأنهم صدور أمر نهائي بألا وجه للمتابعة أو بحكم أو قرار حائز لقوة الشيء المقضي فيه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_285> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_285_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_285> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز أيضا لغرفة الاتهام، بالنسبة للجرائم الناتجة من ملف الدعوى، أن تقرر توجيه التهمة طبقا للأوضاع المنصوص عليها في المادة 286 أدناه ، إلى أشخاص لم يكونوا قد أحيلوا إليها ما لم يسبق بشأنهم صدور أمر نهائي بألا وجه للمتابعة أو بحكم أو قرار حائز لقوة الشيء المقضي فيه ولا يجوز الطعن في هذا الأمر بطريق النقض."@ar .

