<https://legal.dz/resource/law/2025-08-03/25-14#version_art_12> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تنقضي الدعوى العمومية بالتقادم في الجنايات والجنح الموصوفة بأفعال إرهابية وتخريبية وفي الجنايات الأخرى الماسة بأمن الدولة وتلك المتعلقة بالجريمة المنظمة العابرة للحدود الوطنية وجرائم الفساد واختلاس الأموال العمومية إذا تم تحويل عائدات الجريمة إلى خارج الوطن . لا تتقادم الدعوى المدنية للمطالبة بالتعويض عن الضرر الناجم عن الجنايات والجنح المنصوص عليها في الفقرة الأولى من هذه المادة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_12_20250803_OpEnact_df919869b0> ;
    dzdoc:replacementText "لا تنقضي الدعوى العمومية بالتقادم في الجنايات والجنح الموصوفة بأفعال إرهابية وتخريبية وفي الجنايات الأخرى الماسة بأمن الدولة وتلك المتعلقة بالجريمة المنظمة العابرة للحدود الوطنية وجرائم الفساد واختلاس الأموال العمومية إذا تم تحويل عائدات الجريمة إلى خارج الوطن . لا تتقادم الدعوى المدنية للمطالبة بالتعويض عن الضرر الناجم عن الجنايات والجنح المنصوص عليها في الفقرة الأولى من هذه المادة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_12> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
