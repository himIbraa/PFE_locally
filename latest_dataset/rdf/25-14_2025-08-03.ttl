<https://legal.dz/resource/law/2025-08-03/25-14#version_art_657> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز أن تثار من الخصوم أوجه البطلان في الشكل أو في الإجراءات لأول مرة أمام المحكمة العليا ، غير أنه تستثنى من ذلك أوجه البطلان المتعلقة بالقرار المطعون فيه والتي لم تكن لتعرف قبل النطق به . ويجوز إبداء الأوجه الأخرى في أية حالة كانت عليها الدعوى. يجب على المحكمة العليا الإجابة على جميع أوجه الطعن، سواء عند قبول الطعن أو عند رفضه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_657_20250803_OpEnact_64b9e825d9> ;
    dzdoc:replacementText "لا يجوز أن تثار من الخصوم أوجه البطلان في الشكل أو في الإجراءات لأول مرة أمام المحكمة العليا ، غير أنه تستثنى من ذلك أوجه البطلان المتعلقة بالقرار المطعون فيه والتي لم تكن لتعرف قبل النطق به . ويجوز إبداء الأوجه الأخرى في أية حالة كانت عليها الدعوى. يجب على المحكمة العليا الإجابة على جميع أوجه الطعن، سواء عند قبول الطعن أو عند رفضه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
