<https://legal.dz/resource/law/2025-08-03/25-14#version_art_757> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمتد إيقاف العقوبة إلى دفع مصاريف الدعوى أو التعويضات المدنية، كما لا يمتد أيضا إلى عدم الأهلية الناتجة عن حكم الإدانة. ومع ذلك، فإن عدم الأهلية يوقف أثرها من اليوم الذي يصير فيه حكم الإدانة كأن لم يكن تطبيقا لأحكام المادة 767 أدناه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_757_20250803_OpEnact_2b33f607f3> ;
    dzdoc:replacementText "لا يمتد إيقاف العقوبة إلى دفع مصاريف الدعوى أو التعويضات المدنية، كما لا يمتد أيضا إلى عدم الأهلية الناتجة عن حكم الإدانة. ومع ذلك، فإن عدم الأهلية يوقف أثرها من اليوم الذي يصير فيه حكم الإدانة كأن لم يكن تطبيقا لأحكام المادة 767 أدناه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
