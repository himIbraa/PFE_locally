<https://legal.dz/resource/law/2025-08-03/25-14#version_art_324> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يصدر وكيل الجمهورية المختص إقليميا، خلال مرحلة التحريات الأولية والمتابعة عند توصله بالتماسات وكيل الجمهورية لدى القطب الجزائي الوطني الاقتصادي والمالي المتضمنة المطالبة بملف الإجراءات، مقررا بالتخلي لصالح هذا الأخير ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_324_20250803_OpEnact_f4e75f10d3> ;
