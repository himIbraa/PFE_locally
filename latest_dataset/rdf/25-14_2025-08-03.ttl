<https://legal.dz/resource/law/2025-08-03/25-14#version_art_637> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رأت غرفة تطبيق العقوبات أن الاستئناف قد جاء خارج أجال رفعه أو كان غير صحيح شكلا ، قررت عدم قبوله. وفي حالة قبول الاستئناف، تتصدى بالفصل فيه إما بالتأييد أو بالتعديل أو بالإلغاء."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_637_20250803_OpEnact_148b06d692> ;
    dzdoc:replacementText "إذا رأت غرفة تطبيق العقوبات أن الاستئناف قد جاء خارج أجال رفعه أو كان غير صحيح شكلا ، قررت عدم قبوله. وفي حالة قبول الاستئناف، تتصدى بالفصل فيه إما بالتأييد أو بالتعديل أو بالإلغاء."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_637> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_637> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
