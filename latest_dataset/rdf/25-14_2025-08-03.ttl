<https://legal.dz/resource/law/2025-08-03/25-14#art_98_condition_0_c7a91c57> a dznorm:Condition ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2025-08-03/25-14#art_98_condition_0_c7a91c57_period_c5fe6cbebd> ;
