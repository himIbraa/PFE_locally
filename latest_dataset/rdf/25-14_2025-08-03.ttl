<https://legal.dz/resource/law/2025-08-03/25-14#version_art_398> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز أن يباشر وظيفة المحلفين ، الأشخاص جزائريو الجنسية البالغون من العمر ثلاثين (30)سنة كاملة، الملمون بالقراءة والكتابة والمتمتعون بالحقوق الوطنية والمدنية والعائلية والذين لا يوجدون في أية حالة من حالات فقد الأهلية أو التعارض المحددة في المادتين 399 و 400 أدناه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_398_20250803_OpEnact_c5576ccf8d> ;
    dzdoc:replacementText "يجوز أن يباشر وظيفة المحلفين ، الأشخاص جزائريو الجنسية البالغون من العمر ثلاثين (30)سنة كاملة، الملمون بالقراءة والكتابة والمتمتعون بالحقوق الوطنية والمدنية والعائلية والذين لا يوجدون في أية حالة من حالات فقد الأهلية أو التعارض المحددة في المادتين 399 و 400 أدناه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_398> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
