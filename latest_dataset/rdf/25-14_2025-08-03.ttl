<https://legal.dz/resource/law/2025-08-03/25-14#version_art_360> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للجهة القضائية، بناء على طلب النيابة العامة ، معاقبة كل شاهد يتخلف عن الحضور أو يمتنع عن حلف اليمين أو أداء الشهادة بالعقوبة المنصوص عليها في المادة 172 أعلاه. ويجوز للجهة القضائية عند تخلف شاهد عن الحضور بغير عذر تراه مقبولا ومشروعا، أن تأمر بناء على طلب النيابة العامة أو من تلقاء نفسها باستحضاره إليها، على الفور، بواسطة القوة العمومية لسماع أقواله ، أو تأجيل القضية لجلسة قريبة. و في الحالة الأخيرة، يجعل الحكم على عاتق الشاهد المتخلف مصاريف التكليف بالحضور والإجراءات والانتقال وغيرها. ويجو"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_360_20250803_OpEnact_9d3c1d8bf4> ;
    dzdoc:replacementText "يجوز للجهة القضائية، بناء على طلب النيابة العامة ، معاقبة كل شاهد يتخلف عن الحضور أو يمتنع عن حلف اليمين أو أداء الشهادة بالعقوبة المنصوص عليها في المادة 172 أعلاه. ويجوز للجهة القضائية عند تخلف شاهد عن الحضور بغير عذر تراه مقبولا ومشروعا، أن تأمر بناء على طلب النيابة العامة أو من تلقاء نفسها باستحضاره إليها، على الفور، بواسطة القوة العمومية لسماع أقواله ، أو تأجيل القضية لجلسة قريبة. و في الحالة الأخيرة، يجعل الحكم على عاتق الشاهد المتخلف مصاريف التكليف بالحضور والإجراءات والانتقال وغيرها. ويجوز للشاهد الذي حكم عليه بغرامة أو بمصاريف لعدم الحضور، أن يرفع معارضة أمام نفس الجهة القضائية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_360> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_360> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_361> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم الرئيس باستجواب المتهم، قبل سماع الشهود، ويتلقى أقواله ، ويجوز للنيابة العامة وللدفاع توجيه أسئلة إلى المتهم كما يجوز ذلك للمدعي المدني عن طريق الرئيس. ويجوز للرئيس منع الإجابة عن السؤال إذا كان غير منتج أو غير ملائم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_361_20250803_OpEnact_bd69629563> ;
    dzdoc:replacementText "يقوم الرئيس باستجواب المتهم، قبل سماع الشهود، ويتلقى أقواله ، ويجوز للنيابة العامة وللدفاع توجيه أسئلة إلى المتهم كما يجوز ذلك للمدعي المدني عن طريق الرئيس. ويجوز للرئيس منع الإجابة عن السؤال إذا كان غير منتج أو غير ملائم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_361> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
