<https://legal.dz/resource/law/2025-08-03/25-14#art_693_obligation_0_d0e43144> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
