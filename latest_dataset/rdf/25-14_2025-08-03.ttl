<https://legal.dz/resource/law/2025-08-03/25-14#version_art_522> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لكل من المتهم والضحية والمدعي المدني والمسؤول المدني أن يطلب من المحكمة المنظورة أمامها الدعوى رد الأشياء الموضوعة تحت تصرف القضاء . ويجوز للمحكمة أن تأمر بهذا الرد من تلقاء نفسها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_522_20250803_OpEnact_5a374ea540> ;
    dzdoc:replacementText "يجوز لكل من المتهم والضحية والمدعي المدني والمسؤول المدني أن يطلب من المحكمة المنظورة أمامها الدعوى رد الأشياء الموضوعة تحت تصرف القضاء . ويجوز للمحكمة أن تأمر بهذا الرد من تلقاء نفسها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_522> ;
