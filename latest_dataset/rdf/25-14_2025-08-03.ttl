<https://legal.dz/resource/law/2025-08-03/25-14#art_335_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_335> ;
    dzdoc:position 0 ;
    dzdoc:text "يوجد في دائرة اختصاص مجلس قضاء الجزائر، قطب جزائي وطني متخصص في المتابعة والتحقيق في الجرائم المتصلة بتكنولوجيات الإعلام والاتصال والجرائم المرتبطة بها. كما يختص بالحكم في الجرائم المنصوص عليها في هذا الفصل إذا كانت تشكل جنحا."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_336_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_336> ;
    dzdoc:position 0 ;
    dzdoc:text "يمارس وكيل الجمهورية لدى القطب الجزائي الوطني لمكافحة الجرائم المتصلة بتكنولوجيات الإعلام والاتصال وقاضي التحقيق ورئيس ذات القطب صلاحياتهم في كامل الإقليم الوطني."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_337_condition_0_8a6308ef> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2025-08-03/25-14#art_337_condition_0_8a6308ef_ref_9528dbd27a1e> ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_335> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_335> ;
    dznorm:conditionText "مع مراعاة أحكام الفقرة 2 من المادة 335 أعلاه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_337> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_337_condition_0_8a6308ef_ref_9528dbd27a1e> a dzdoc:Reference ;
    rdfs:label "المادة 335"@ar ;
    dzdoc:frbrUri "#art_335"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2025-08-03/25-14#art_335> ;
    dzdoc:sourceEId "art_337" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "مع مراعاة أحكام الفقرة 2 من المادة 335 أعلاه"@ar ;
    dzdoc:targetEId "art_335" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_337_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_337> ;
    dzdoc:position 0 ;
    dzdoc:text """مع مراعاة أحكام الفقرة 2 من المادة 335 أعلاه، يختص وكيل الجمهورية لدى القطب الجزائي الوطني لمكافحة الجرائم المتصلة بتكنولوجيات الإعلام والاتصال وقاضي التحقيق ورئيس ذات القطب، حصريا، بالمتابعة والتحقيق والحكم في الجرائم المتصلة بتكنولوجيات الإعلام والاتصال المذكورة أدناه ، وكذا الجرائم المرتبطة بها:
              
              الجرائم التي تمس بأمن الدولة أو بالدفاع الوطني،
              جرائم نشر و ترويج أخبار كاذبة بين الجمهور من شأنها المساس بالأمن أو السكينة العامة أو استقرار المجتمع،
              جرائم نشر و ترويج أنباء مغرضة تمس بالنظام والأمن العموميين ذات الطابع المنظم أو العابر للحدود الوطنية،
              جرائم المساس بأنظمة المعالجة الآلية للمعطيات المتعلقة بالإدارات والمؤسسات العمومية،
              جرائم الاتجار بالبشر أو بالأعضاء البشرية أو بتهريب المهاجرين،
              جرائم التمييز وخطاب الكراهية. الجرائم التي تمس بأمن الدولة أو بالدفاع الوطني، جرائم نشر و ترويج أخبار كاذبة بين الجمهور من شأنها المساس بالأمن أو السكينة العامة أو استقرار المجتمع، جرائم نشر و ترويج أنباء مغرضة تمس بالنظام والأمن العموميين ذات الطابع المنظم أو العابر للحدود الوطنية، جرائم المساس بأنظمة المعالجة الآلية للمعطيات المتعلقة بالإدارات والمؤسسات العمومية، جرائم الاتجار بالبشر أو بالأعضاء البشرية أو بتهريب المهاجرين، جرائم التمييز وخطاب الكراهية."""@ar .

