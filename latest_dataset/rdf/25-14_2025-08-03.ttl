<https://legal.dz/resource/law/2025-08-03/25-14#version_art_754> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمجالس القضائية و للمحاكم ، في حالة الحكم بالحبس أو الغرامة إذا لم يكن المحكوم عليه قد سبق الحكم عليه بالحبس لجناية أو لجنحة من جرائم القانون العام ، أن تأمر بحكم معلل بالإيقاف الكلي أو الجزئي لتنفيذ العقوبة الأصلية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_754_20250803_OpEnact_efaba8d992> ;
    dzdoc:replacementText "يجوز للمجالس القضائية و للمحاكم ، في حالة الحكم بالحبس أو الغرامة إذا لم يكن المحكوم عليه قد سبق الحكم عليه بالحبس لجناية أو لجنحة من جرائم القانون العام ، أن تأمر بحكم معلل بالإيقاف الكلي أو الجزئي لتنفيذ العقوبة الأصلية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_754> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_754> ;
