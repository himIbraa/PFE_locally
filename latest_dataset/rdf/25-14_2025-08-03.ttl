    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "789" ;
    dzdoc:position 787 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_804> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_5_sec_1> ;
    dzdoc:eId "art_804" ;
    dzdoc:fullText "يوقع عليها أمين الضبط الذي حررها ويؤشر عليها النائب العام أو القاضي المكلف بمصلحة صحيفة السوابق القضائية المركزية القسائم رقم 2 و القسائم رقم 3 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_804> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_804_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_804_20250803_OpEnact_04f6ac34a5> ;
