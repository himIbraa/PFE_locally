<https://legal.dz/resource/law/2025-08-03/25-14#version_art_665> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبلغ طعون المحكوم عليه والطرف المدني والمسؤول المدني من قبل أمانة الضبط إلى النيابة العامة . ويبلغ طعن النيابة العامة إلى المحكوم عليه بواسطة أمانة الضبط. ويبلغ الطعن بالنقض المقدم من المحكوم عليه إلى باقي الخصوم في النقض بأي وسيلة قانونية في أجل لا يتعدى خمسة عشر (15) يوما، اعتبارا من تاريخ التصريح بالطعن . لا يعتد بفوات هذا الأجل في قبول الطعن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_665_20250803_OpEnact_6388da404a> ;
    dzdoc:replacementText "تبلغ طعون المحكوم عليه والطرف المدني والمسؤول المدني من قبل أمانة الضبط إلى النيابة العامة . ويبلغ طعن النيابة العامة إلى المحكوم عليه بواسطة أمانة الضبط. ويبلغ الطعن بالنقض المقدم من المحكوم عليه إلى باقي الخصوم في النقض بأي وسيلة قانونية في أجل لا يتعدى خمسة عشر (15) يوما، اعتبارا من تاريخ التصريح بالطعن . لا يعتد بفوات هذا الأجل في قبول الطعن."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_665> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
