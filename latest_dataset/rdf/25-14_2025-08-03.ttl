    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ﻳﺮﻓﻊ ﺍﻻﺳﺘﺌﻨﺎﻑ ﺑﺘﺼﺮﻳﺢ ﻛﺘﺎﺑﻲ ﺃﻭ ﺷﻔﻮﻱ ﺃﻣﺎﻡ ﺃﻣﺎﻧﺔ ﺿﺒﻂ ﺍلمحكمة ﺍﻟﺘﻲ ﺃﺻﺪﺭﺕ ﺍﳊﻜﻢ ﺍﳌﻄﻌﻮﻥ ﻓﻴﻪ، ﺃﻭ ﺃﻣﺎﻡ أمين ﺿﺒﻂ المؤسسة العفابية ﺇﺫﺍ ﻛﺎﻥ المتهم ﻣﺤﺒﻮﺳﺎ، ﻭﻓﻘﺎ لمقتضيات المادتين 591 ﻭ 592 ﻣﻦ ﻫﺬﺍ ﺍﻟﻘﺎﻧﻮﻥ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_459_20250803_OpEnact_4b3f65adcf> ;
    dzdoc:replacementText "ﻳﺮﻓﻊ ﺍﻻﺳﺘﺌﻨﺎﻑ ﺑﺘﺼﺮﻳﺢ ﻛﺘﺎﺑﻲ ﺃﻭ ﺷﻔﻮﻱ ﺃﻣﺎﻡ ﺃﻣﺎﻧﺔ ﺿﺒﻂ ﺍلمحكمة ﺍﻟﺘﻲ ﺃﺻﺪﺭﺕ ﺍﳊﻜﻢ ﺍﳌﻄﻌﻮﻥ ﻓﻴﻪ، ﺃﻭ ﺃﻣﺎﻡ أمين ﺿﺒﻂ المؤسسة العفابية ﺇﺫﺍ ﻛﺎﻥ المتهم ﻣﺤﺒﻮﺳﺎ، ﻭﻓﻘﺎ لمقتضيات المادتين 591 ﻭ 592 ﻣﻦ ﻫﺬﺍ ﺍﻟﻘﺎﻧﻮﻥ."@ar ;
