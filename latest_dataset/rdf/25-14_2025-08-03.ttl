<https://legal.dz/resource/law/2025-08-03/25-14#version_art_847> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتحصل وكيل الجمهورية على : 1) نسخة من الأحكام والقرارات الصادرة بالعقوبة، 2) مستخرج من سجل الإيداع بالمؤسسات العقابية التي قضى بها المحكوم عليه مدة عقوبته، وكذا رأي مدير المؤسسة العقابية عن سلوكه في الحبس، 3) القسيمة رقم 2 من صحيفة السوابق القضائية. ثم ترسل هذه المستندات مشفوعة برأيه إلى النائب العام ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_847_20250803_OpEnact_7c25557dca> ;
    dzdoc:replacementText "يتحصل وكيل الجمهورية على : 1) نسخة من الأحكام والقرارات الصادرة بالعقوبة، 2) مستخرج من سجل الإيداع بالمؤسسات العقابية التي قضى بها المحكوم عليه مدة عقوبته، وكذا رأي مدير المؤسسة العقابية عن سلوكه في الحبس، 3) القسيمة رقم 2 من صحيفة السوابق القضائية. ثم ترسل هذه المستندات مشفوعة برأيه إلى النائب العام ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_847> ;
