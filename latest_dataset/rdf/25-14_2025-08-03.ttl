        <https://legal.dz/resource/law/2025-08-03/25-14#art_376_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_376_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
