<https://legal.dz/resource/law/2025-08-03/25-14#art_106> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_106" ;
    dzdoc:fullText "يمكن أن تعقد اتفاقية إرجاء المتابعة في الجنح المنصوص عليها في : المواد 119 مكرر و 418 و 419 من قانون العقوبات، القانون المتعلق بالوقاية من الفساد ومكافحته، باستثناء جرائم الرشوة القانون المتعلق بقمع مخالفة التشريع والتنظيم الخاصين بالصرف وحركة رؤوس الأموال من و إلى الخارج، التشريع المتعلق بمكافحة التهريب، التشريع الساري المفعول المتعلق بالفوترة، القانون النقدي والمصرفي، التشريع المتعلق ببورصة القيم المنقولة، قانون الجمارك، جنح التهرب والغش الضريبيين المنصوص عليها في التشريع الجبائي والمالي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_106_permission_0_153313c8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_106> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_106_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_106_20250803_OpEnact_0c6c64e660> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 106" ;
    dzdoc:position 105 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2025-08-03/25-14#art_106_extref_0a3baece>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_106_extref_4d48a2e7>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_106_extref_d5d56c8b> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_106_condition_0_1407d5ee> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_128> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_6> ;
    dzdoc:eId "art_128" ;
    dzdoc:fullText "يمكن إفادة الشهود و الخبراء و المدعين المدنيين و الضحايا و الأطراف المدنية و المبلغين من تدبير أو أكثر من تدابير الحماية غير الإجرائية و/أو الإجرائية المنصوص عليها في هذا الفصل إذا كانت حياتهم أو سلامتهم الجسدية أو حياة أو سلامة أفراد عائلاتهم أو أقاربهم أو مصالحهم الأساسية معرضة لتهديد خطير بسبب المعلومات التي يمكنهم تقديمها للقضاء والتي تكون ضرورية لإظهار الحقيقة في قضايا الجريمة المنظمة، والإرهاب، والجرائم ضد أمن الدولة، والفساد، والمتاجرة بالمخدرات والمؤثرات العقلية، وتبييض الأموال، وجرائم الاتجار بالبشر، وجرائم الاتجار بالأعضاء، وجرائم تهريب المهاجرين . يمكن تمديد الحماية المنصوص عليها في هذا الفصل إلى جرائم أخرى إذا كانت حالة المعني تستوجب ذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_128_permission_0_aab7dbb0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_128_permission_1_6582c2aa> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_128_right_0_f8a318da> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_128> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_128_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_128_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_128_20250803_OpEnact_a172d37ff0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "128" ;
    dzdoc:position 127 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_128_condition_0_fe8bb379>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_128_condition_1_179ba4be> ;
    dzdoc:usesTerm dzterm:civil_parties,
        dzterm:civil_plaintiffs,
        dzterm:experts,
        dzterm:victims,
        dzterm:whistleblowers,
        dzterm:witnesses .

<https://legal.dz/resource/law/2025-08-03/25-14#art_149> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_149" ;
    dzdoc:fullText "يجوز الادعاء مدنيا في أي وقت أثناء سير التحقيق ، و يحيط قاضي التحقيق باقي أطراف الدعوى علما بذلك . وتجوز المنازعة في طلب الادعاء المدني من جانب النيابة العامة أو من جانب المتهم أو من مدع مدني آخر. ويفصل قاضي التحقيق في حالة المنازعة أو في حالة ما إذا رأى من تلقاء نفسه عدم قبول الادعاء المدني، وذلك بقرار مسبب بعد عرض الملف على النيابة العامة لإبداء طلباتها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_149_permission_0_4389a036> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_149_right_0_9bd05972> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_149> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_149_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_149_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_149_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_149_20250803_OpEnact_377b056ef0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_149_obligation_0_b0879fb3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_149_obligation_1_2640bc22> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "149" ;
    dzdoc:position 148 ;
    dzdoc:usesTerm dzterm:investigating_judge .

<https://legal.dz/resource/law/2025-08-03/25-14#art_197> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_7> ;
    dzdoc:eId "art_197" ;
    dzdoc:fullText "يبقى المتهم حرا أثناء إجراءات التحقيق القضائي . غير أنه إذا اقتضت الضرورة اتخاذ إجراءات لضمان مثوله أمام القضاء أو لمقتضيات حسن سير التحقيق ، يمكن إخضاعه لالتزامات الرقابة القضائية . أما إذا تبين أن هذه التدابير غير كافية ، يمكن، بصفة استثنائية ، أن يؤمر بـ الحبس المؤقت بموجب أمر معلل وفقا لأحكام المادة 201 أدناه. إذا تبين أن الحبس المؤقت لم يعد مبررا، على الأقل، بأحد الأسباب المذكورة في المادة 201 أدناه ، يتعين على قاضي التحقيق إما الإفراج عن المتهم أو إخضاعه لتدابير الرقابة القضائية ، بعد استطلاع رأي وكيل الجمهورية، إن لم يكن محبوسا لسبب آخر ، مع مراعاة الأحكام المقررة في هذا القسم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_197_permission_0_06d149ba>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_197_permission_1_da957673> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_197_right_0_6e96ed1e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_197> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_197_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_197_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_197_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_197_20250803_OpEnact_8f4c40799d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_197_obligation_0_fbd98a49> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "197" ;
    dzdoc:position 196 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_201> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_201> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_197_condition_0_0ca959d7>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_197_condition_1_c98c52f9>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_197_condition_2_32494d1f> ;
    dzdoc:usesTerm dzterm:accused,
        dzterm:judicial_control,
        dzterm:pre_trial_detention .

<https://legal.dz/resource/law/2025-08-03/25-14#art_205> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_7> ;
    dzdoc:eId "art_205" ;
    dzdoc:fullText "إذا أمر قاضي التحقيق في مواد الجنايات أو في مواد الجنح المتعلقة بالمخدرات والمؤثرات العقلية والجريمة المنظمة عبر الحدود الوطنية والجرائم المتصلة بتكنولوجيات الإعلام والاتصال وتبييض الأموال والإرهاب وجرائم أمن الدولة والجرائم المتعلقة بالتشريع الخاص بالصرف وحركة رؤوس الأموال من و إلى الخارج والفساد والتهريب والاتجار بالبشر والاتجار بالأعضاء وتهريب المهاجرين واختطاف الأشخاص، بإجراء خبرة أو اتخاذ إجراءات خارج التراب الوطني لجمع أدلة أو تلقي شهادات وكانت نتائجها تبدو حاسمة لإظهار الحقيقة ، يمكنه في أجل شهر قبل انتهاء المدد القصوى للحبس، أن يطلب من غرفة الاتهام وفقا للأشكال المنصوص عليها في الفقرات 5 و 6 و 7 و 8 من المادة 204 أعلاه، تمديد الحبس المؤقت . يجوز لـ غرفة الاتهام تمديد الحبس المؤقت لمدة أربعة (4) أشهر قابلة للتجديد أربع (4) مرات بنفس الأشكال المذكورة في الفقرة الأولى. كل تمديد لـ الحبس المؤقت لا يمكن أن يتجاوز أربعة (4) أشهر في كل مرة. وتطبق في هذه الحالة أحكام الفقرتين 11 و 12 من المادة 204 أعلاه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_205_permission_0_7f99953c>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_205_permission_1_2eeae66d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_205> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_205_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_205_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_205_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_205_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_205_20250803_OpEnact_3da7a32e0a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 205" ;
    dzdoc:position 204 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_204> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_204> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_205_condition_0_a08aab6d> ;
    dzdoc:usesTerm dzterm:indictment_chamber,
        dzterm:pre_trial_detention .

<https://legal.dz/resource/law/2025-08-03/25-14#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "إذا ما افتتح تحقيق قضائي ، يجب على الضبط القضائي تنفيذ تفويضات جهات التحقيق وأوامرها وتسخيراتها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_21_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_21_20250803_OpEnact_9ec5f261f6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_21_obligation_0_c8091503> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "21" ;
    dzdoc:position 20 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_21_condition_0_96409c30> ;
    dzdoc:usesTerm dzterm:police_judiciaire .

<https://legal.dz/resource/law/2025-08-03/25-14#art_237> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_9> ;
    dzdoc:eId "art_237" ;
    dzdoc:fullText "إذا اقتضت الضرورة لتنفيذ الإنابة القضائية أن يلجأ ضابط الشرطة القضائية لتوقيف شخص للنظر ، فعليه حتما تقديمه خلال ثمان وأربعين (48) ساعة إلى قاضي التحقيق في الدائرة التي يجري فيها تنفيذ الإنابة. وبعد استماع قاضي التحقيق إلى أقوال الشخص المقدم له يجوز له الموافقة على منح إذن كتابي يمدد توقيفه للنظر مدة ثمان وأربعين (48) ساعة أخرى. ويجوز، بصفة استثنائية، إصدار هذا الإذن بأمر معلل دون أن يقتاد الشخص أمام قاضي التحقيق . تطبق الأحكام المنصوص عليها في المادتين 84 و 85 من هذا القانون، على إجراءات التوقيف للنظر التي تتخذ في إطار هذا القسم. يمارس قاضي التحقيق الصلاحيات المخولة ل وكيل الجمهورية بمقتضى المادتين 83 و 86 (الفقرة الأخيرة) أعلاه. وينوه في المحاضر ، طبقا للأوضاع المنصوص عليها في المادتين 86 و 87 أعلاه، بإجراءات التوقيف للنظر التي تتخذ بهذه الكيفية بمعرفة ضابط الشرطة القضائية . ويحدد قاضي التحقيق المهلة التي يتعين فيها على ضباط الشرطة القضائية موافاته بالمحاضر التي يحررونها. فإن لم يحدد أجلا لذلك ، فيتعين أن ترسل إليه هذه المحاضر خلال الثمانية (8) أيام التالية لانتهاء الإجراءات المتخذة بموجب الإنابة القضائية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_237_permission_0_f3f9cb75> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_237> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_237_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_237_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_237_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_237_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_237_para_4>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_237_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_237_20250803_OpEnact_65d8f2bbc5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_237_obligation_0_f7693a24>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_237_obligation_1_bc5ddd73> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "237" ;
    dzdoc:position 236 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_83>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_84>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_85>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_86>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_87> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_83>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_84>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_85>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_86>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_87> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_237_condition_0_cadb034a>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_237_condition_1_2e377774> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:judicial_police_officer,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_244> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_10> ;
    dzdoc:eId "art_244" ;
    dzdoc:fullText "كل أمر يصدر بندب خبراء يجب أن تحدد فيه مهلة لإنجاز مهمتهم ، ويجوز أن تمدد هذه المهلة بناء على طلب الخبراء إذا اقتضت ذلك أسباب خاصة ، ويكون ذلك بأمر معلل يصدره القاضي أو الجهة التي ندبتهم، و إذا لم يودع الخبراء تقاريرهم في الميعاد المحدد لهم جاز في الحال أن يستبدل بهم غيرهم و عليهم، إذ ذاك، أن يقدموا نتائج ما قاموا به من أبحاث ، كما عليهم أن يردوا في ظرف ثمان وأربعين (48) ساعة جميع الأشياء والأوراق والوثائق التي تكون قد عهد بها إليهم على ذمة إنجاز مهمتهم ، وعلاوة على ذلك، فمن الجائز أن تترتب عليهم المسؤولية المدنية وتتخذ ضدهم تدابير تأديبية قد تصل إلى شطب أسمائهم من جدول الخبراء المنصوص عليه في المادة 240 أعلاه. ويجب على الخبراء ، عند القيام بمهمتهم، أن يكونوا على اتصال بـ قاضي التحقيق أو بـ القاضي المنتدب ، وأن يحيطوه علما بتطورات الأعمال التي يقومون بها، ويمكنوه من كل ما يجعله في كل حين قادرا على اتخاذ الإجراءات اللازمة . ويجوز دائما لـ قاضي التحقيق ، أثناء إجراءاته، أن يستعين بـ الخبراء إذا رأى لزوما لذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_244> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_244_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_244_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_244_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_244_20250803_OpEnact_dbd32663b6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_244_obligation_0_46ae1ada>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_244_obligation_1_7aa0a818>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_244_obligation_2_71134435>,
