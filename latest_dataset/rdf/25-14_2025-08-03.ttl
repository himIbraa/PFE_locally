<https://legal.dz/resource/law/2025-08-03/25-14#version_art_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تحرك الدعوى العمومية ضد مسيري المؤسسات العمومية الاقتصادية التي تملك الدولة كل رأسمالها أو ذات الرأسمال المختلط عن أعمال التسيير التي تؤدي إلى سرقة أو تبديد أو اختلاس أو تلف أو ضياع أموال عمومية أو خاصة إلا بناء على شكوى مسبقة من الهيئات الاجتماعية للمؤسسة المنصوص عليها في المواد من 576 إلى 578 ، و 580 و 583 ، و من 610 إلى 612 ، و 624 ، و 635 ، و 638 ، و 639 ، و من 642 إلى 648 ، و 652 ، و 654 ، و 663 ، و 674 ، و 715 مكرر 136 ، و 715 مكرر 137 ، و 715 مكرر 143 ، و 715 ثالثا 1 ، و 715 ثالثا 2 ، "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_8_20250803_OpEnact_a9387dd1dc> ;
    dzdoc:replacementText "لا تحرك الدعوى العمومية ضد مسيري المؤسسات العمومية الاقتصادية التي تملك الدولة كل رأسمالها أو ذات الرأسمال المختلط عن أعمال التسيير التي تؤدي إلى سرقة أو تبديد أو اختلاس أو تلف أو ضياع أموال عمومية أو خاصة إلا بناء على شكوى مسبقة من الهيئات الاجتماعية للمؤسسة المنصوص عليها في المواد من 576 إلى 578 ، و 580 و 583 ، و من 610 إلى 612 ، و 624 ، و 635 ، و 638 ، و 639 ، و من 642 إلى 648 ، و 652 ، و 654 ، و 663 ، و 674 ، و 715 مكرر 136 ، و 715 مكرر 137 ، و 715 مكرر 143 ، و 715 ثالثا 1 ، و 715 ثالثا 2 ، و 799 مكرر 2 من القانون التجاري ، و في التشريع الساري المفعول. يتعرض أعضاء الهيئات الاجتماعية للمؤسسة الذين لا يبلغون عن الوقائع ذات الطابع الجزائي التي تصل إلى علمهم أو يطلعون عليها أثناء أو بمناسبة تأدية مهامهم في المؤسسات المذكورة في الفقرة الأولى من هذه المادة ، للعقوبات المقررة في قانون العقوبات، والقانون المتعلق بالوقاية من الفساد ومكافحته ، و في التشريع الجزائي ذي الصلة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_8> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_8> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

