<https://legal.dz/resource/law/2025-08-03/25-14#version_art_30> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم أعوان الضبط القضائي بمعاونة ضباط الشرطة القضائية في مباشرة وظائفهم و يثبتون الجرائم المقررة في التشريع الجزائي ممتثلين في ذلك لأوامر رؤسائهم مع الخضوع لنظام الهيئة التي ينتمون إليها ، و يقومون بجمع كافة المعلومات الكاشفة عن مرتكبي تلك الجرائم والمساهمين فيها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_30_20250803_OpEnact_04c2b22a1e> ;
    dzdoc:replacementText "يقوم أعوان الضبط القضائي بمعاونة ضباط الشرطة القضائية في مباشرة وظائفهم و يثبتون الجرائم المقررة في التشريع الجزائي ممتثلين في ذلك لأوامر رؤسائهم مع الخضوع لنظام الهيئة التي ينتمون إليها ، و يقومون بجمع كافة المعلومات الكاشفة عن مرتكبي تلك الجرائم والمساهمين فيها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_30> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
