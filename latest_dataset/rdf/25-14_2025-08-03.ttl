<https://legal.dz/resource/law/2025-08-03/25-14#version_art_373> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم أمين الضبط، تحت إشراف الرئيس، بإثبات سير المناقشات ، ولاسيما أقوال الشهود وأجوبة المتهم. يوقع أمين الضبط على مذكرات الجلسة ويؤشر عليها من الرئيس في ظرف الثلاثة (3) أيام التالية لكل جلسة، على الأكثر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_373_20250803_OpEnact_3190b3048c> ;
    dzdoc:replacementText "يقوم أمين الضبط، تحت إشراف الرئيس، بإثبات سير المناقشات ، ولاسيما أقوال الشهود وأجوبة المتهم. يوقع أمين الضبط على مذكرات الجلسة ويؤشر عليها من الرئيس في ظرف الثلاثة (3) أيام التالية لكل جلسة، على الأكثر ."@ar ;
