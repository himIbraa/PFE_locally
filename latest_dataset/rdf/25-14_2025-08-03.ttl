<https://legal.dz/resource/law/2025-08-03/25-14#version_art_713> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للنائب العام لدى المحكمة العليا وحده الصفة في رفع الأمر إلى المحكمة المذكورة بشأن طلبات الإحالة لداعي الأمن العمومي أو لحسن سير القضاء . وأما العريضة بطلب الإحالة بسبب قيام الشبهة المشروعة، فيجوز تقديمها من النائب العام لدى المحكمة العليا أو من النيابة العامة لدى الجهة القضائية المنظور أمامها النزاع أو من المتهم أو الضحية أو المدعي المدني أو محاميهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_713_20250803_OpEnact_1658457728> ;
    dzdoc:replacementText "للنائب العام لدى المحكمة العليا وحده الصفة في رفع الأمر إلى المحكمة المذكورة بشأن طلبات الإحالة لداعي الأمن العمومي أو لحسن سير القضاء . وأما العريضة بطلب الإحالة بسبب قيام الشبهة المشروعة، فيجوز تقديمها من النائب العام لدى المحكمة العليا أو من النيابة العامة لدى الجهة القضائية المنظور أمامها النزاع أو من المتهم أو الضحية أو المدعي المدني أو محاميهم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_713> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
