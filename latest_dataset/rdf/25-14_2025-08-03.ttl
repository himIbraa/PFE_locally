<https://legal.dz/resource/law/2025-08-03/25-14#version_art_407> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم رئيس محكمة الجنايات الابتدائية أو القاضي الذي يفوضه باستجواب المتهم المتابع بجناية في أقرب وقت . يستجوب الرئيس المتهم عن هويته ويتحقق مما إذا كان قد تلقى تبليغا بقرار الإحالة ، فإن لم يكن قد بلغ به سلمت إليه نسخة منه ويكون لتسليم هذه النسخة أثر التبليغ ، و يطلب الرئيس من المتهم اختيار محام للدفاع عنه ، فإن لم يختر المتهم محاميا عين له الرئيس من تلقاء نفسه محاميا . ويحرر محضر بكل ذلك يوقع عليه كل من الرئيس وأمين الضبط والمتهم، وعند الاقتضاء، المترجم ، فإذا لم يكن في استطاعة المتهم التوقيع أو"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_407_20250803_OpEnact_d4de09d8d3> ;
    dzdoc:replacementText "يقوم رئيس محكمة الجنايات الابتدائية أو القاضي الذي يفوضه باستجواب المتهم المتابع بجناية في أقرب وقت . يستجوب الرئيس المتهم عن هويته ويتحقق مما إذا كان قد تلقى تبليغا بقرار الإحالة ، فإن لم يكن قد بلغ به سلمت إليه نسخة منه ويكون لتسليم هذه النسخة أثر التبليغ ، و يطلب الرئيس من المتهم اختيار محام للدفاع عنه ، فإن لم يختر المتهم محاميا عين له الرئيس من تلقاء نفسه محاميا . ويحرر محضر بكل ذلك يوقع عليه كل من الرئيس وأمين الضبط والمتهم، وعند الاقتضاء، المترجم ، فإذا لم يكن في استطاعة المتهم التوقيع أو امتنع عنه، ذكر ذلك المحضر . ويجب إجراء الاستجواب المنصوص عليه في هذه المادة قبل انعقاد الجلسة بثمانية (8) أيام، على الأقل . ويجوز للمتهم والمحاميه التنازل عن هذا الأجل . و في حالة الاستئناف ، يقتصر الاستجواب على تأكد رئيس محكمة الجنايات الاستئنافية من قيام المتهم بتأسيس محام للدفاع عنه، فإن لم يقم بذلك عين له محاميا تلقائيا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_407> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_407> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_408> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للمتهم المحبوس أن يتصل بحرية، بمحاميه الذي يجوز له الإطلاع على جميع أوراق ملف الدعوى في مكان وجودها دون أن يترتب على ذلك تأخير في سير الإجراءات ، و يوضع هذا الملف تحت تصرف المحامي قبل الجلسة بخمسة (5) أيام، على الأقل ."@ar ;
