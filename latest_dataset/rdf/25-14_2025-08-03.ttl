<https://legal.dz/resource/law/2025-08-03/25-14#version_art_593> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز إيداع عريضة تتضمن أوجه الاستئناف في أمانة ضبط المحكمة التي أصدرت الحكم في المواعيد المنصوص عليها لتقرير الاستئناف ، ويوقع عليها المستأنف أو محام أو وكيل خاص مفوض بالتوقيع. وترسل العريضة و كذلك أوراق الدعوى بمعرفة وكيل الجمهورية إلى المجلس القضائي في أجل شهر (1) على الأكثر. وإذا كان المتهم مقبوضا عليه ، أحيل كذلك في أقصر مهلة وبأمر من وكيل الجمهورية إلى المؤسسة العقابية الكائنة بمقر المجلس القضائي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_593_20250803_OpEnact_9c8aa4ca41> ;
    dzdoc:replacementText "يجوز إيداع عريضة تتضمن أوجه الاستئناف في أمانة ضبط المحكمة التي أصدرت الحكم في المواعيد المنصوص عليها لتقرير الاستئناف ، ويوقع عليها المستأنف أو محام أو وكيل خاص مفوض بالتوقيع. وترسل العريضة و كذلك أوراق الدعوى بمعرفة وكيل الجمهورية إلى المجلس القضائي في أجل شهر (1) على الأكثر. وإذا كان المتهم مقبوضا عليه ، أحيل كذلك في أقصر مهلة وبأمر من وكيل الجمهورية إلى المؤسسة العقابية الكائنة بمقر المجلس القضائي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_593> ;
