    dznorm:conditionText "على الأقل، عشرة (10) أيام قبل تاريخ الجلسة ما لم ينص هذا القانون على آجال أخرى"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_611> ;
    dznorm:position 0 .

