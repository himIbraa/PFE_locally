<https://legal.dz/resource/law/2025-08-03/25-14#version_art_640> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم استجواب المتهم غير المحبوس أو سماعه أو إجراء مواجهة بينه وبين غيره في مرحلتي التحقيق القضائي أو المحاكمة، باستعمال تقنية المحادثة المرئية عن بعد ، بمقر المحكمة الأقرب من مكان إقامته، ويتم تلقي تصريحاته بحضور أمين ضبط وبعد تحقق وكيل الجمهورية المختص إقليميا من هويته. يحرر أمين الضبط محضرا عن سير عملية استعمال المحادثة المرئية عن بعد ويوقعه ثم يرسله بمعرفة وكيل الجمهورية إلى الجهة القضائية المختصة، لإلحاقه بملف الإجراءات. تطبق نفس الإجراءات المنصوص عليها في هذه المادة عندما يتعلق الأمر بباق ال"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_640_20250803_OpEnact_35b1bed1db> ;
    dzdoc:replacementText "يتم استجواب المتهم غير المحبوس أو سماعه أو إجراء مواجهة بينه وبين غيره في مرحلتي التحقيق القضائي أو المحاكمة، باستعمال تقنية المحادثة المرئية عن بعد ، بمقر المحكمة الأقرب من مكان إقامته، ويتم تلقي تصريحاته بحضور أمين ضبط وبعد تحقق وكيل الجمهورية المختص إقليميا من هويته. يحرر أمين الضبط محضرا عن سير عملية استعمال المحادثة المرئية عن بعد ويوقعه ثم يرسله بمعرفة وكيل الجمهورية إلى الجهة القضائية المختصة، لإلحاقه بملف الإجراءات. تطبق نفس الإجراءات المنصوص عليها في هذه المادة عندما يتعلق الأمر بباق الأطراف والشهود والخبراء والمترجمين. كما يمكن لوكيل الجمهورية أو لقاضي التحقيق اللجوء إلى المحادثة المرئية عن بعد في حالة تمديد التوقيف للنظر وكذا في حالة القبض على المتهم خارج دائرة اختصاص جهة التحقيق أو الحكم التي أصدرت الأمر بالقبض، ويشار إلى ذلك في المحاضر المحررة في الحالتين."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_640> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_640> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_641> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن جهات التحقيق أن تستعمل المحادثة المرئية عن بعد في استجواب أو سماع شخص و في إجراء المواجهة بين الأشخاص، و في التبليغات التي يستوجب قانون الإجراءات الجزائية تحرير محاضر بشأنها. يجب أن يتم الإجراء طبقا لأحكام المادة 19 أعلاه. يقصد بجهات التحقيق في مفهوم هذا الباب، قاضي التحقيق وغرفة الاتهام وجهة الحكم في حالة تطبيق أحكام المادة 506 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_641_20250803_OpEnact_866b9f2b6c> ;
    dzdoc:replacementText "يمكن جهات التحقيق أن تستعمل المحادثة المرئية عن بعد في استجواب أو سماع شخص و في إجراء المواجهة بين الأشخاص، و في التبليغات التي يستوجب قانون الإجراءات الجزائية تحرير محاضر بشأنها. يجب أن يتم الإجراء طبقا لأحكام المادة 19 أعلاه. يقصد بجهات التحقيق في مفهوم هذا الباب، قاضي التحقيق وغرفة الاتهام وجهة الحكم في حالة تطبيق أحكام المادة 506 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_641> ;
