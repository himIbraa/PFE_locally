    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_609_obligation_0_9b438f2c>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_609_obligation_1_bb554998> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_609_prohibition_0_50cd4723> ;
