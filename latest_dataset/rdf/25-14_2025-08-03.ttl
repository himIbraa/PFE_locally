<https://legal.dz/resource/law/2025-08-03/25-14#art_783_obligation_0_21a5ebf5> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_783> ;
    dznorm:position 0 ;
    dznorm:provisionText "تتلقى أمانة ضبط كل مجلس قضائي"@ar ;
    dznorm:sourceArticle "art_783" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_783_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_783> ;
    dzdoc:position 0 ;
    dzdoc:text "تتلقى أمانة ضبط كل مجلس قضائي، فيما يتعلق بالأشخاص المولودين في دائرة ذلك المجلس وبعد التحقق من هويتهم، من واقع سجلات الحالة المدنية أو من السجل الآلي الوطني للحالة المدنية، قسائم مثبتا فيها : أحكام وقرارات الإدانة الحضورية أو أحكام وقرارات الإدانة الغيابية غير المطعون فيها بالمعارضة المحكوم بها في جناية أو جنحة من أية جهة قضائية، بما في ذلك الأحكام المشمولة بوقف التنفيذ، الأوامر الجزائية غير المعترض عليها، أحكام وقرارات الإدانة الحضورية أو أحكام وقرارات الإدانة الغيابية غير المطعون فيها بالمعارضة، الصادرة في المخالفات، إذا كانت العقوبة المقررة قانونا تزيد على الحبس لمدة عشرة (10) أيام أو خمسة آلاف دينار (5000 دج) غرامة، بما في ذلك الأحكام والقرارات المشمولة بوقف التنفيذ، الأحكام والقرارات الصادرة عن الجهات القضائية الخاصة بالأحداث، الأحكام والقرارات المقررة لإشهار الإفلاس أو التسوية القضائية، الأحكام والقرارات المتعلقة بالحرمان من ممارسة الحقوق العائلية، الأحكام والقرارات القاضية بالعقوبات البديلة، إجراءات الإبعاد المتخذة ضد الأجانب، الأوامر الجزائية المتعلقة بالغرامات الجزافية المنصوص عليها في هذا القانون."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_784_condition_0_c991e962> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_784_condition_0_c991e962_action_12f2a0c17b> ;
    dznorm:conditionText "غير أنه يمكن عند الاقتضاء"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_784> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_784_condition_0_c991e962_action_12f2a0c17b> a dznorm:Action ;
    rdfs:label "عند الاقتضاء"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "غير أنه يمكن عند الاقتضاء"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_784> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_784_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_784> ;
    dzdoc:position 0 ;
    dzdoc:text "توجد لدى كل مجلس قضائي مصلحة لصحيفة السوابق القضائية يديرها أمين ضبط ذلك المجلس تحت إشراف النائب العام."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_784_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_784> ;
    dzdoc:position 1 ;
    dzdoc:text "تختص هذه المصلحة بمسك صحيفة السوابق القضائية لجميع الأشخاص المولودين بدائرة ذلك المجلس."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_784_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_784> ;
    dzdoc:position 2 ;
    dzdoc:text "غير أنه يمكن عند الاقتضاء، إحداث مصلحة لصحيفة السوابق القضائية على مستوى المحكمة، بقرار من وزير العدل."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_784_permission_0_dbbfb93b> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
