    dznorm:conditionText "إذا كانت دعوى المسؤولية تهدف إلى التعويض عن ضرر سببته مركبة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_4> ;
