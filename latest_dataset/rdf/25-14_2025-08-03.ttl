<https://legal.dz/resource/law/2025-08-03/25-14#version_art_40> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسوغ ل وزير العدل أن يخطر النائب العام بالجرائم المتعلقة بالتشريع الجزائي . كما يسوغ له، فضلا عن ذلك، أن يكلفه كتابة بأن يباشر أو يعهد بمباشرة متابعات أو يخطر الجهة القضائية المختصة بما يراه ملائما من طلبات كتابية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_40_20250803_OpEnact_eeda9f9a9f> ;
    dzdoc:replacementText "يسوغ ل وزير العدل أن يخطر النائب العام بالجرائم المتعلقة بالتشريع الجزائي . كما يسوغ له، فضلا عن ذلك، أن يكلفه كتابة بأن يباشر أو يعهد بمباشرة متابعات أو يخطر الجهة القضائية المختصة بما يراه ملائما من طلبات كتابية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
