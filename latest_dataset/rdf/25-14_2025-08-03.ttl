<https://legal.dz/resource/law/2025-08-03/25-14#version_art_841> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمحكوم عليه من أجل جناية تقديم طلب رد الاعتبار بعد انقضاء أجل خمس (5) سنوات . ويخفض هذا الأجل إلى ثلاث (3) سنوات بالنسبة للمحكوم عليه من أجل جنحة وإلى سنة واحدة (1) إذا كانت العقوبة من أجل مخالفة. يبدأ حساب الأجل بالنسبة للمحكوم عليه بعقوبة مقيدة للحرية نافذة من يوم الإفراج عنه. إذا اشتملت العقوبة على الغرامة والحبس النافذ معا ، فإن الأجل يبدأ من يوم الإفراج. وبالنسبة لعقوبة الغرامة وحدها، يجوز تقديم طلب رد الاعتبار بعد انقضاء أجل سنة واحدة (1) من يوم صيرورة الحكم نهائيا ، بشرط سداد الغرام"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_841_20250803_OpEnact_3455eb4f1e> ;
    dzdoc:replacementText "يجوز للمحكوم عليه من أجل جناية تقديم طلب رد الاعتبار بعد انقضاء أجل خمس (5) سنوات . ويخفض هذا الأجل إلى ثلاث (3) سنوات بالنسبة للمحكوم عليه من أجل جنحة وإلى سنة واحدة (1) إذا كانت العقوبة من أجل مخالفة. يبدأ حساب الأجل بالنسبة للمحكوم عليه بعقوبة مقيدة للحرية نافذة من يوم الإفراج عنه. إذا اشتملت العقوبة على الغرامة والحبس النافذ معا ، فإن الأجل يبدأ من يوم الإفراج. وبالنسبة لعقوبة الغرامة وحدها، يجوز تقديم طلب رد الاعتبار بعد انقضاء أجل سنة واحدة (1) من يوم صيرورة الحكم نهائيا ، بشرط سداد الغرامة . إذا استفاد المحكوم عليه من الإفراج المشروط ، فإن بداية الأجل تكون من تاريخ الإفراج ، ما لم يتم إلغاء الإفراج المشروط. في حالة الحكم بعقوبة تكميلية ، فإنه لا يجوز تقديم طلب رد الاعتبار إلا بعد تنفيذها. يقوم العفو من العقوبة مقام تنفيذها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_841> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_841> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_842> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للمحكوم عليه الذي يكون في حالة العود القانوني أو لمن حكم عليه بعقوبة جديدة بعد رد اعتباره، أن يقدم طلبا برد الاعتبار إلا بعد مضي مهلة ست (6) سنوات من يوم الإفراج عنه. غير أنه إذا كانت العقوبة الجديدة لجناية ، رفعت فترة الاختبار إلى عشر (10) سنوات. وفيما عدا الحالة المنصوص: عليها في المادة 844 أدناه، فلا يجوز للمحكوم عليه الذي انقضت عقوبته بالتقادم أن يحصل على رد الاعتبار القضائي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_842_20250803_OpEnact_b14e051783> ;
    dzdoc:replacementText "لا يجوز للمحكوم عليه الذي يكون في حالة العود القانوني أو لمن حكم عليه بعقوبة جديدة بعد رد اعتباره، أن يقدم طلبا برد الاعتبار إلا بعد مضي مهلة ست (6) سنوات من يوم الإفراج عنه. غير أنه إذا كانت العقوبة الجديدة لجناية ، رفعت فترة الاختبار إلى عشر (10) سنوات. وفيما عدا الحالة المنصوص: عليها في المادة 844 أدناه، فلا يجوز للمحكوم عليه الذي انقضت عقوبته بالتقادم أن يحصل على رد الاعتبار القضائي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_842> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
