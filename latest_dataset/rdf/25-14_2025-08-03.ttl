<https://legal.dz/resource/law/2025-08-03/25-14#version_art_671> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم أمين ضبط الجهة القضائية التي أصدرت الحكم أو القرار المطعون فيه بتشكيل الملف وإرساله إلى النائب العام الذي يحيله بدوره إلى النيابة العامة لدى المحكمة العليا ، مع جرد بالوثائق يتضمن وجوبا ما يثبت حصول تبليغ الحكم أو القرار إلى من يهمه الأمر، في ظرف عشرين (20) يوما من تاريخ انتهاء أجال إيداع المذكرات المنصوص عليها في المواد 661 و 662 و 663 من هذا القانون . يقوم النائب العام لدى المحكمة العليا بإرسال الملف في ظرف ثمانية (8) أيام من استلامه إلى الرئيس الأول للمحكمة العليا الذي يحيله بدوره إلى رئ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_671_20250803_OpEnact_6386d4aa50> ;
    dzdoc:replacementText "يقوم أمين ضبط الجهة القضائية التي أصدرت الحكم أو القرار المطعون فيه بتشكيل الملف وإرساله إلى النائب العام الذي يحيله بدوره إلى النيابة العامة لدى المحكمة العليا ، مع جرد بالوثائق يتضمن وجوبا ما يثبت حصول تبليغ الحكم أو القرار إلى من يهمه الأمر، في ظرف عشرين (20) يوما من تاريخ انتهاء أجال إيداع المذكرات المنصوص عليها في المواد 661 و 662 و 663 من هذا القانون . يقوم النائب العام لدى المحكمة العليا بإرسال الملف في ظرف ثمانية (8) أيام من استلامه إلى الرئيس الأول للمحكمة العليا الذي يحيله بدوره إلى رئيس الغرفة المختصة لأجل تعيين مستشار مقرر ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_671> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_671> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_672> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يناط بالمستشار المقرر توجيه الإجراءات والقيام بتهيئة ملفات الطعون التي عين فيها . ولهذا الغرض، فهو يسهر على حسن إدارة وسرعة تنفيذ كافة أعمال أمانة الضبط ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
