<https://legal.dz/resource/law/2025-08-03/25-14#version_art_88> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن تحرر المحاضر التي يضعها ضابط الشرطة القضائية طبقا للقانون في الحال، وعليه أن يوقع على كل ورقة من أوراقها ."@ar ;
