<https://legal.dz/resource/law/2025-08-03/25-14#art_161_obligation_0_7b71eae7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
