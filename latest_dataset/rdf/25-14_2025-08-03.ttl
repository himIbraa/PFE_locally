    dznorm:position 0 ;
    dznorm:provisionText "وكل تعديل في قائمة المحلفين يجب تبليغه بمعرفة أمانة الضبط إلى المتهم قبل استجوابه عن هويته"@ar ;
    dznorm:sourceArticle "art_418" .

