<https://legal.dz/resource/law/2025-08-03/25-14#version_art_252> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا حدث في جلسة لإحدى الجهات القضائية أن ناقض شخص يجري سماعه كشاهد أو على سبيل الاستدلال نتائج الخبرة أو أورد في المسألة الفنية بيانات جديدة ، يطلب الرئيس من الخبراء والنيابة العامة والدفاع والضحية والمدعي المدني، إن كان ثمة محل لذلك، أن يبدوا ملاحظاتهم، و على الجهة القضائية أن تصدر قرارا مسببا إما بصرف النظر عن ذلك، وإما بتأجيل القضية إلى تاريخ لاحق، وفي الحالة الأخيرة يسوغ لهذه الجهة القضائية أن تتخذ بشأن الخبرة كل ما تراه لازما من الإجراءات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_252_20250803_OpEnact_75224682e0> ;
    dzdoc:replacementText "إذا حدث في جلسة لإحدى الجهات القضائية أن ناقض شخص يجري سماعه كشاهد أو على سبيل الاستدلال نتائج الخبرة أو أورد في المسألة الفنية بيانات جديدة ، يطلب الرئيس من الخبراء والنيابة العامة والدفاع والضحية والمدعي المدني، إن كان ثمة محل لذلك، أن يبدوا ملاحظاتهم، و على الجهة القضائية أن تصدر قرارا مسببا إما بصرف النظر عن ذلك، وإما بتأجيل القضية إلى تاريخ لاحق، وفي الحالة الأخيرة يسوغ لهذه الجهة القضائية أن تتخذ بشأن الخبرة كل ما تراه لازما من الإجراءات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_252> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_252> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
