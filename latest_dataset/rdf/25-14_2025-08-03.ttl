<https://legal.dz/resource/law/2025-08-03/25-14#version_art_276> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رأى النائب العام في الدعاوى المنظورة أمام المحاكم، فيما عدا محكمة الجنايات، أن الوقائع قابلة لوصفها جناية فله إلى ما قبل افتتاح المرافعة أن يأمر بإحضار الأوراق وإعداد القضية وتقديمها ومعها طلباته فيها إلى غرفة الاتهام ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_276_20250803_OpEnact_d728c219be> ;
