<https://legal.dz/resource/law/2025-08-03/25-14#art_131> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_6> ;
    dzdoc:eId "art_131" ;
    dzdoc:fullText "يقرر وكيل الجمهورية ، بالتشاور مع السلطات المختصة، اتخاذ التدابير المناسبة قصد ضمان الحماية الفعالة للأشخاص المذكورين في هذا الفصل المعرضين للخطر . بمجرد فتح تحقيق قضائي ، تؤول هذه السلطة لـ قاضي التحقيق المخطر. تبقى التدابير المتخذة سارية ما دامت الأسباب التي بررتها قائمة. ويمكن تعديلها بالنظر لخطورة التهديد. يعمل وكيل الجمهورية على تنفيذ ومتابعة تدابير الحماية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_131> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_131_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_131_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_131_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_131_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_131_20250803_OpEnact_974ece7d1c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_131_obligation_0_fceff75a>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_131_obligation_1_fd8d3476> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "131" ;
    dzdoc:position 130 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_131_condition_0_40becbf5> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:prosecutor .

