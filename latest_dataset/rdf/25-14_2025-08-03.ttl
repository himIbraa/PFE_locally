<https://legal.dz/resource/law/2025-08-03/25-14#version_art_533> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا قرر وكيل الجمهورية اتباع إجراءات الأمر الجزائي ، يحيل ملف المتابعة مرفقا بطلباته، حسب الحالة، إلى محكمة الجنح أو المخالفات. يفصل القاضي دون مرافعة مسبقة بأمر جزائي يقضي بالبراءة أو بعقوبة الغرامة. وإذا رأى القاضي أن الشروط المنصوص عليها قانونا للأمر الجزائي غير متوفرة ، فإنه يعيد ملف المتابعة للنيابة العامة لاتخاذ ما تراه مناسبا وفقا للقانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_533_20250803_OpEnact_1bd470a710> ;
    dzdoc:replacementText "إذا قرر وكيل الجمهورية اتباع إجراءات الأمر الجزائي ، يحيل ملف المتابعة مرفقا بطلباته، حسب الحالة، إلى محكمة الجنح أو المخالفات. يفصل القاضي دون مرافعة مسبقة بأمر جزائي يقضي بالبراءة أو بعقوبة الغرامة. وإذا رأى القاضي أن الشروط المنصوص عليها قانونا للأمر الجزائي غير متوفرة ، فإنه يعيد ملف المتابعة للنيابة العامة لاتخاذ ما تراه مناسبا وفقا للقانون."@ar ;
