    dznorm:provisionText "يتعين أن ينطق بالأحكام في حضوره"@ar ;
    dznorm:sourceArticle "art_39" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_39_obligation_3_d9795f63> a dznorm:Obligation ;
