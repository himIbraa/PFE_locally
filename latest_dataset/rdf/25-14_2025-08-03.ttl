<https://legal.dz/resource/law/2025-08-03/25-14#art_126_obligation_0_e0f08ac1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/law/2025-08-03/25-14#art_126_obligation_0_e0f08ac1_ref_4470d3447e09> ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_120> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_120> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_126> ;
    dznorm:position 0 ;
    dznorm:provisionText "يخبر القاضي الذي أصدر الرخصة المنصوص عليها في المادة 120 أعلاه، في أقرب الآجال"@ar ;
    dznorm:sourceArticle "art_126" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_126_obligation_0_e0f08ac1_ref_4470d3447e09> a dzdoc:Reference ;
    rdfs:label "المادة 120"@ar ;
    dzdoc:frbrUri "#art_120"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2025-08-03/25-14#art_120> ;
    dzdoc:sourceEId "art_126" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يخبر القاضي الذي أصدر الرخصة المنصوص عليها في المادة 120 أعلاه، في أقرب الآجال"@ar ;
    dzdoc:targetEId "art_120" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_126_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_126> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا تقرر وقف العملية ، أو عند انقضاء المهلة المحددة في رخصة التسرب ، و في حالة عدم تمديدها، يمكن العون المتسرب مواصلة النشاطات المذكورة في المادة 123 أعلاه، للوقت الضروري الكافي لتوقيف عمليات المراقبة في ظروف تضمن أمنه دون أن يكون مسؤولا جزائيا، على ألا يتجاوز ذلك مدة أربعة (4) أشهر."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_126_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_126> ;
    dzdoc:position 1 ;
    dzdoc:text "يخبر القاضي الذي أصدر الرخصة المنصوص عليها في المادة 120 أعلاه، في أقرب الآجال. وإذا انقضت مهلة الأربعة (4) أشهر دون أن يتمكن العون المتسرب من توقيف نشاطه في ظروف تضمن أمنه، يمكن هذا القاضي أن يرخص بتمديدها لمدة أربعة (4) أشهر على الأكثر."@ar .

