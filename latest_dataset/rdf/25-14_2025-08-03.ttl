<https://legal.dz/resource/law/2025-08-03/25-14#version_art_776> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يترتب على تقادم العقوبة تخلص المحكوم عليه من آثار الحكم بالإدانة إذا لم تكن العقوبة قد نفذت في المهل المحددة في المواد من 778 إلى 780 أدناه . غير أنه لا يترتب عليه سقوط عدم الأهلية إذا تقرر في حكم الإدانة أو كان الحكم يؤدي إليه قانونا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_776_20250803_OpEnact_98dc137224> ;
