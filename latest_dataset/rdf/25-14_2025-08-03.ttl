        <https://legal.dz/resource/law/2025-08-03/25-14#art_9_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_9_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_9_para_3> ;
