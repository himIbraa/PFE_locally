    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_197> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_197_permission_1_da957673> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_197> ;
    dznorm:position 1 ;
    dznorm:provisionText "أما إذا تبين أن هذه التدابير غير كافية، يمكن، بصفة استثنائية ، أن يؤمر بـ الحبس المؤقت بموجب أمر معلل وفقا لأحكام المادة 201 أدناه."@ar ;
    dznorm:sourceArticle "art_197" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_197_right_0_6e96ed1e> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
