<https://legal.dz/resource/law/2025-08-03/25-14#version_art_292> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا رأت غرفة الاتهام أن الوقائع تشكل جنحة أو مخالفة ، فإنها تقضي بإحالة القضية إلى المحكمة المختصة، و في حالة الإحالة أمام محكمة الجنح ظل المتهم المقبوض عليه محبوسا مؤقتا إذا كان موضوع الدعوى معاقبا عليه بالحبس ، وذلك مع مراعاة أحكام المادة 202 أعلاه. فإذا كانت الوقائع القائمة في الدعوى لا تخضع لعقوبة الحبس أو لا تشكل سوى مخالفة ، فإن المتهم يخلى سبيله في الحال ، ما لم يكن محبوسا لسبب آخر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_292_20250803_OpEnact_fb4ed722bf> ;
    dzdoc:replacementText "إذا رأت غرفة الاتهام أن الوقائع تشكل جنحة أو مخالفة ، فإنها تقضي بإحالة القضية إلى المحكمة المختصة، و في حالة الإحالة أمام محكمة الجنح ظل المتهم المقبوض عليه محبوسا مؤقتا إذا كان موضوع الدعوى معاقبا عليه بالحبس ، وذلك مع مراعاة أحكام المادة 202 أعلاه. فإذا كانت الوقائع القائمة في الدعوى لا تخضع لعقوبة الحبس أو لا تشكل سوى مخالفة ، فإن المتهم يخلى سبيله في الحال ، ما لم يكن محبوسا لسبب آخر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_292> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
