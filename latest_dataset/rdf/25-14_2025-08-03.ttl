<https://legal.dz/resource/law/2025-08-03/25-14#version_art_355> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنظم القوانين الخاصة المواد التي تحرر عنها محاضر ذات حجية في الإثبات إلى أن يطعن فيها بالتزوير. وعند عدم وجود نصوص صريحة، تتخذ إجراءات الطعن بالتزوير وفق ما هو منصوص عليه في الباب الأول من الكتاب السابع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_355_20250803_OpEnact_ea26b6de9c> ;
    dzdoc:replacementText "تنظم القوانين الخاصة المواد التي تحرر عنها محاضر ذات حجية في الإثبات إلى أن يطعن فيها بالتزوير. وعند عدم وجود نصوص صريحة، تتخذ إجراءات الطعن بالتزوير وفق ما هو منصوص عليه في الباب الأول من الكتاب السابع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_355> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
