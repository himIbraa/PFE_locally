    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_153> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_153_condition_0_9a881d8d_ref_8507d56c2417> a dzdoc:Reference ;
    rdfs:label "المادة 70"@ar ;
    dzdoc:frbrUri "#art_70"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2025-08-03/25-14#art_70> ;
    dzdoc:sourceEId "art_153" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "إذا لم يكن قاضي التحقيق مختصا إقليميا طبقا لنص المادة 70 أعلاه"@ar ;
    dzdoc:targetEId "art_70" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_153_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_153> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا لم يكن قاضي التحقيق مختصا إقليميا طبقا لنص المادة 70 أعلاه، أصدر بعد سماع طلبات النيابة العامة أمرا بإحالة المدعي المدني إلى الجهة القضائية التي يراها مختصة بقبول الادعاء المدني."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_154_condition_0_dcfec69f> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_154_condition_0_dcfec69f_role_706d9c6149> ;
    dznorm:conditionText "إذا صدر، بعد إجراء تحقيق مفتوح بناء على ادعاء مدني، قرار نهائي وحائز لقوة الشيء المقضي فيه بألا وجه لمتابعة المتهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_154> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_154_condition_0_dcfec69f_role_706d9c6149> a dznorm:Role ;
    rdfs:label "ادعاء مدني"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "إذا صدر، بعد إجراء تحقيق مفتوح بناء على ادعاء مدني، قرار نهائي وحائز لقوة الشيء المقضي فيه بألا وجه لمتابعة المتهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_154> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_154_obligation_0_64697e50> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_154_obligation_0_64697e50_action_26541483d9> ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2025-08-03/25-14#art_154_obligation_0_64697e50_period_e5d4a159a0> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_154> ;
    dznorm:position 0 ;
    dznorm:provisionText "ويجب أن ترفع دعوى التعويض المدني خلال ثلاثة (3) أشهر من تاريخ صيرورة الأمر الصادر بالا وجه للمتابعة نهائيا وحائزا لقوة الشيء المقضي فيه"@ar ;
    dznorm:sourceArticle "art_154" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_154_obligation_0_64697e50_action_26541483d9> a dznorm:Action ;
