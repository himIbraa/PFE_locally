    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يبلغ الحكم الصادر غيابيا إلى الطرف المتخلف عن الحضور، وينوه في التبليغ على أن المعارضة جائزة القبول في مهلة عشرة (10) أيام، اعتبارا من تاريخ تبليغ الحكم إذا كان التبليغ لشخص المتهم . و تمدد هذه المهلة إلى شهرين (2) إذا كان الطرف المتخلف يقيم خارج التراب الوطني."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_581_20250803_OpEnact_ee351fc845> ;
    dzdoc:replacementText "يبلغ الحكم الصادر غيابيا إلى الطرف المتخلف عن الحضور، وينوه في التبليغ على أن المعارضة جائزة القبول في مهلة عشرة (10) أيام، اعتبارا من تاريخ تبليغ الحكم إذا كان التبليغ لشخص المتهم . و تمدد هذه المهلة إلى شهرين (2) إذا كان الطرف المتخلف يقيم خارج التراب الوطني."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_581> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
