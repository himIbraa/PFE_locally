<https://legal.dz/resource/law/2025-08-03/25-14#version_art_515> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخلي سبيل المتهم المحبوس مؤقتا فور صدور الحكم ببراءته أو بإعفائه من العقوبة أو الحكم عليه بعقوبة العمل للنفع العام أو بالحبس مع إيقاف التنفيذ أو بالغرامة ، وذلك رغم الاستئناف ما لم يكن محبوسا لسبب آخر. وكذلك الشأن بالنسبة للمتهم المحبوس مؤقتا إذا حكم عليه بعقوبة الحبس بمجرد أن تستنفد مدة حبسه المؤقت مدة العقوبة المقضي بها عليه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_515_20250803_OpEnact_544260e985> ;
    dzdoc:replacementText "يخلي سبيل المتهم المحبوس مؤقتا فور صدور الحكم ببراءته أو بإعفائه من العقوبة أو الحكم عليه بعقوبة العمل للنفع العام أو بالحبس مع إيقاف التنفيذ أو بالغرامة ، وذلك رغم الاستئناف ما لم يكن محبوسا لسبب آخر. وكذلك الشأن بالنسبة للمتهم المحبوس مؤقتا إذا حكم عليه بعقوبة الحبس بمجرد أن تستنفد مدة حبسه المؤقت مدة العقوبة المقضي بها عليه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_515> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
