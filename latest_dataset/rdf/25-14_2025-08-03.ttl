    dznorm:provisionText "لا تسلم صحيفة مخالفات المرور إلا إلى"@ar ;
    dznorm:sourceArticle "art_826" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_826_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_826> ;
    dzdoc:position 1 ;
    dzdoc:text """فإذا لم توجد عقوبات، تذكر في القسيمة عبارة "لا شيء". لا تسلم صحيفة مخالفات المرور إلا إلى :
              
              المعني بالأمر،
              القضاة،
              وزير الدفاع الوطني،
              وزير الداخلية.
              وزير النقل. المعني بالأمر، القضاة، وزير الدفاع الوطني، وزير الداخلية. وزير النقل."""@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_827_para_0> a dzdoc:Paragraph ;
