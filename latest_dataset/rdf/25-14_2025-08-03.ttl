<https://legal.dz/resource/law/2025-08-03/25-14#version_art_15> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسري مدة تقادم الدعوى العمومية في الجرائم الخفية أو المخفية ابتداء من ظهورها إلى العلن ومعاينتها في ظروف تسمح بتحريك الدعوى العمومية ، على ألا تتجاوز المدة القصوى للتقادم ابتداء من يوم اقتراف الجريمة: خمسا وعشرين (25) سنة كاملة بالنسبة للجنايات خمس عشرة (15) سنة كاملة بالنسبة للجنح التي يفوق الحد الأقصى لعقوبة الحبس المقررة لها خمس (5) سنوات، عشر (10) سنوات بالنسبة للجنح التي لا يتجاوز الحد الأقصى لعقوبة الحبس المقررة لها خمس (5) سنوات. يعد تسجيل العقود والمحررات الرسمية و/أو شهرها وفقا للأحكام "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_15_20250803_OpEnact_f730e02407> ;
    dzdoc:replacementText "تسري مدة تقادم الدعوى العمومية في الجرائم الخفية أو المخفية ابتداء من ظهورها إلى العلن ومعاينتها في ظروف تسمح بتحريك الدعوى العمومية ، على ألا تتجاوز المدة القصوى للتقادم ابتداء من يوم اقتراف الجريمة: خمسا وعشرين (25) سنة كاملة بالنسبة للجنايات خمس عشرة (15) سنة كاملة بالنسبة للجنح التي يفوق الحد الأقصى لعقوبة الحبس المقررة لها خمس (5) سنوات، عشر (10) سنوات بالنسبة للجنح التي لا يتجاوز الحد الأقصى لعقوبة الحبس المقررة لها خمس (5) سنوات. يعد تسجيل العقود والمحررات الرسمية و/أو شهرها وفقا للأحكام المنصوص عليها في التشريع الساري المفعول، بمثابة ظهور للعلن. تكون الجريمة خفية إذا كانت طبيعة ركنها المادي تحول دون اكتشافها من قبل الضحية أو من السلطة القضائية . تكون الجريمة مخفية عندما يستعمل الجاني عمدا أي مناورة تحول دون اكتشافها . وتتبع في كيفيات احتساب أجال التقادم ، الأحكام الموضحة في المادة 10 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_15> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_15> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_150> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتعين على المدعي المدني الذي يحرك الدعوى العمومية، إذا لم يكن قد حصل على المساعدة القضائية، أن يودع لدى أمانة الضبط، بأمر من قاضي التحقيق وضمن الأجل الذي يحدده ، المبلغ المقدر لزومه لمصاريف الدعوى، تحت طائلة عدم قبول الشكوى . يمكن للمدعي المدني استئناف أمر قاضي التحقيق المتضمن تحديد مبلغ الكفالة، أمام غرفة الاتهام، في أجل ثلاثة (3) أيام من تاريخ تبليغه ، والتي تفصل فيه بقرار غير قابل لأي طعن في أجل أقصاه ثمانية (8) أيام من تاريخ الاستئناف."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_150_20250803_OpEnact_ab786c0e7f> ;
    dzdoc:replacementText "يتعين على المدعي المدني الذي يحرك الدعوى العمومية، إذا لم يكن قد حصل على المساعدة القضائية، أن يودع لدى أمانة الضبط، بأمر من قاضي التحقيق وضمن الأجل الذي يحدده ، المبلغ المقدر لزومه لمصاريف الدعوى، تحت طائلة عدم قبول الشكوى . يمكن للمدعي المدني استئناف أمر قاضي التحقيق المتضمن تحديد مبلغ الكفالة، أمام غرفة الاتهام، في أجل ثلاثة (3) أيام من تاريخ تبليغه ، والتي تفصل فيه بقرار غير قابل لأي طعن في أجل أقصاه ثمانية (8) أيام من تاريخ الاستئناف."@ar ;
    dzdoc:resolutionStatus "resolved" ;
