<https://legal.dz/resource/law/2025-08-03/25-14#version_art_523> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز أيضا لكل شخص، غير المتهم والضحية والمدعي المدني والمسؤول المدني، يدعي بأن له حقا على أشياء موضوعة تحت تصرف القضاء أن يطلب بردها من المحكمة المنظورة أمامها الدعوى . ولا يجوز له الاطلاع إذ ذاك على غير المحاضر المتعلقة بضبط تلك الأشياء. وتقضي المحكمة في ذلك بحكم، على حدة ، بعد سماع أطراف الدعوى."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_523_20250803_OpEnact_00c926cf63> ;
    dzdoc:replacementText "يجوز أيضا لكل شخص، غير المتهم والضحية والمدعي المدني والمسؤول المدني، يدعي بأن له حقا على أشياء موضوعة تحت تصرف القضاء أن يطلب بردها من المحكمة المنظورة أمامها الدعوى . ولا يجوز له الاطلاع إذ ذاك على غير المحاضر المتعلقة بضبط تلك الأشياء. وتقضي المحكمة في ذلك بحكم، على حدة ، بعد سماع أطراف الدعوى."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_523> ;
