<https://legal.dz/resource/law/2025-08-03/25-14#art_375_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_375> ;
    dzdoc:position 1 ;
