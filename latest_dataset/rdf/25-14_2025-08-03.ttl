<https://legal.dz/resource/law/2025-08-03/25-14#version_art_739> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان أحد ضباط الشرطة القضائية قابلا للاتهام بارتكاب جناية أو جنحة خارج دائرة مباشرة أعمال وظيفته، أو أثناء مباشرتها في الدائرة التي يختص فيها محليا ، اتخذت بشأنه الإجراءات طبقا لأحكام المادة 738 أعلاه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_739_20250803_OpEnact_ff0af1ef64> ;
    dzdoc:replacementText "إذا كان أحد ضباط الشرطة القضائية قابلا للاتهام بارتكاب جناية أو جنحة خارج دائرة مباشرة أعمال وظيفته، أو أثناء مباشرتها في الدائرة التي يختص فيها محليا ، اتخذت بشأنه الإجراءات طبقا لأحكام المادة 738 أعلاه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_739> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_739> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_74> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحظر، في مكان ارتكاب جناية على كل شخص لا صفة له، أن يقوم بإجراء أي تغيير على حالة الأماكن التي وقعت فيها الجريمة أو ينزع أي شيء منها قبل الإجراءات الأولية للتحقيق القضائي ، وإلا عوقب بغرامة من 20.000 دج إلى 100.000 دج. غير أنه يستثنى من هذا الحظر حالة ما إذا كانت التغييرات أو نزع الأشياء ضرورية للسلامة والصحة العمومية أو تستلزمها معالجة الضحايا . وإذا كان المقصود من طمس الآثار أو نزع الأشياء هو عرقلة سير العدالة ، فيعاقب على هذا الفعل بالحبس من ثلاثة (3) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_74_20250803_OpEnact_cc0ce8e3d3> ;
    dzdoc:replacementText "يحظر، في مكان ارتكاب جناية على كل شخص لا صفة له، أن يقوم بإجراء أي تغيير على حالة الأماكن التي وقعت فيها الجريمة أو ينزع أي شيء منها قبل الإجراءات الأولية للتحقيق القضائي ، وإلا عوقب بغرامة من 20.000 دج إلى 100.000 دج. غير أنه يستثنى من هذا الحظر حالة ما إذا كانت التغييرات أو نزع الأشياء ضرورية للسلامة والصحة العمومية أو تستلزمها معالجة الضحايا . وإذا كان المقصود من طمس الآثار أو نزع الأشياء هو عرقلة سير العدالة ، فيعاقب على هذا الفعل بالحبس من ثلاثة (3) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 150.000 دج."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_74> ;
