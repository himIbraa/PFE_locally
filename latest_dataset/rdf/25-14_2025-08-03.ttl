<https://legal.dz/resource/law/2025-08-03/25-14#version_art_500> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كانت حالة المتهم الصحية لا تمكنه من الحضور أمام المحكمة ووجدت أسباب خطيرة لعدم تأجيل القضية أو إذا اقتضى حسن العدالة الفصل فيها ، أمرت المحكمة، بقرار خاص و مسبب باستجوابه بحضور محاميه، بمسكنه أو بالمؤسسة الاستشفائية المتواجد بها أو بالمؤسسة العقابية التي يكون محبوسا بها، وذلك بواسطة قاض منتدب لهذا الغرض مصحوبا بأمين ضبط. ويحرر محضرا بهذا الاستجواب الذي تأمر به المحكمة. وتؤجل القضية بتاريخ محدد لأقرب جلسة مناسبة، و يتعين استدعاء المتهم لحضورها . و في جميع هذه الأحوال، يكون الحكم على المتهم حض"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_500_20250803_OpEnact_918bd313d1> ;
    dzdoc:replacementText "إذا كانت حالة المتهم الصحية لا تمكنه من الحضور أمام المحكمة ووجدت أسباب خطيرة لعدم تأجيل القضية أو إذا اقتضى حسن العدالة الفصل فيها ، أمرت المحكمة، بقرار خاص و مسبب باستجوابه بحضور محاميه، بمسكنه أو بالمؤسسة الاستشفائية المتواجد بها أو بالمؤسسة العقابية التي يكون محبوسا بها، وذلك بواسطة قاض منتدب لهذا الغرض مصحوبا بأمين ضبط. ويحرر محضرا بهذا الاستجواب الذي تأمر به المحكمة. وتؤجل القضية بتاريخ محدد لأقرب جلسة مناسبة، و يتعين استدعاء المتهم لحضورها . و في جميع هذه الأحوال، يكون الحكم على المتهم حضوريا. ويجوز أن يوكل عنه محاميا يمثله ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_500> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
