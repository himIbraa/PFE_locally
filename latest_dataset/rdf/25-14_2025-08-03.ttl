<https://legal.dz/resource/law/2025-08-03/25-14#version_art_662> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على الطاعن بالنقض تبليغ مذكرة الطعن بكل وسيلة قانونية إلى باقي الأطراف المعنيين بالطعن في ظرف ثلاثين (30) يوما، ابتداء من تاريخ إيداع المذكرة المذكورة في المادة 661 أعلاه . وإذا كان الطاعن محبوسا يتولى محاميه تبليغ مذكرة الطعن لباقي الأطراف. ويتم التبليغ للنيابة العامة من طرف أمين الضبط في نفس الأجل المنصوص عليه في الفقرة الأولى أعلاه. إذا كان المطعون ضده محبوسا، يبلغ شخصيا بنفس الأشكال المذكورة في الفقرة الأولى أعلاه بواسطة أمين ضبط المؤسسة العقابية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_662_20250803_OpEnact_4cfa522966> ;
    dzdoc:replacementText "يجب على الطاعن بالنقض تبليغ مذكرة الطعن بكل وسيلة قانونية إلى باقي الأطراف المعنيين بالطعن في ظرف ثلاثين (30) يوما، ابتداء من تاريخ إيداع المذكرة المذكورة في المادة 661 أعلاه . وإذا كان الطاعن محبوسا يتولى محاميه تبليغ مذكرة الطعن لباقي الأطراف. ويتم التبليغ للنيابة العامة من طرف أمين الضبط في نفس الأجل المنصوص عليه في الفقرة الأولى أعلاه. إذا كان المطعون ضده محبوسا، يبلغ شخصيا بنفس الأشكال المذكورة في الفقرة الأولى أعلاه بواسطة أمين ضبط المؤسسة العقابية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_662> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_662> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_663> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للمطعون ضده في الطعن مهلة ثلاثين (30) يوما، يبدأ حسابها من تاريخ تبليغه بمذكرة الطعن من أجل إيداع مذكرة جوابية موقعة من محام معتمد لدى المحكمة العليا مرفقة بنسخ بقدر عدد أطراف الدعوى . يجب أن تشير إجراءات التبليغ المنصوص عليها في المادة 662 أعلاه إلى هذا الأجل ، وأنه في حال انقضاء المهلة المذكورة يعد القرار الفاصل في الطعن حضوريا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_663_20250803_OpEnact_d64f14d78b> ;
    dzdoc:replacementText "للمطعون ضده في الطعن مهلة ثلاثين (30) يوما، يبدأ حسابها من تاريخ تبليغه بمذكرة الطعن من أجل إيداع مذكرة جوابية موقعة من محام معتمد لدى المحكمة العليا مرفقة بنسخ بقدر عدد أطراف الدعوى . يجب أن تشير إجراءات التبليغ المنصوص عليها في المادة 662 أعلاه إلى هذا الأجل ، وأنه في حال انقضاء المهلة المذكورة يعد القرار الفاصل في الطعن حضوريا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_663> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_663> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_664> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخضع الطعن بالنقض لدفع الرسم القضائي تحت طائلة عدم القبول باستثناء الطعون المقدمة من النيابة العامة والدولة والجماعات المحلية. ويسدد هذا الرسم في وقت رفع الطعن، تحت طائلة عدم قبول الطعن شكلا ، وذلك ما لم تكن المساعدة القضائية قد طلبت . ويعفى من دفع الرسم المحكوم عليهم بعقوبات جنائية، والمحبوسون بعقوبة الحبس . ويكون سداد الرسم لأمانة ضبط الجهة التي أصدرت الحكم أو القرار المطعون فيه. تدرج نسخة من وصل سداد الرس سم أو مستخرج من الوضعية الجزائية للطاعن المحبوس، ضمن الملف."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_664_20250803_OpEnact_106862d35c> ;
    dzdoc:replacementText "يخضع الطعن بالنقض لدفع الرسم القضائي تحت طائلة عدم القبول باستثناء الطعون المقدمة من النيابة العامة والدولة والجماعات المحلية. ويسدد هذا الرسم في وقت رفع الطعن، تحت طائلة عدم قبول الطعن شكلا ، وذلك ما لم تكن المساعدة القضائية قد طلبت . ويعفى من دفع الرسم المحكوم عليهم بعقوبات جنائية، والمحبوسون بعقوبة الحبس . ويكون سداد الرسم لأمانة ضبط الجهة التي أصدرت الحكم أو القرار المطعون فيه. تدرج نسخة من وصل سداد الرس سم أو مستخرج من الوضعية الجزائية للطاعن المحبوس، ضمن الملف."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_664> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
