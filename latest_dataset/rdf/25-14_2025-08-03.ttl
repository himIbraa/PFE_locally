<https://legal.dz/resource/law/2025-08-03/25-14#version_art_372> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للجهة القضائية، إما من تلقاء نفسها أو بناء على طلب النيابة العامة أو الضحية أو المدعي المدني أو المتهم أو محاميهم، أن تأمر بإجراء الانتقالات اللازمة لإظهار الحقيقة. يستدعى أطراف الدعوى ومحاموهم لحضوره الانتقالات و يحرر محضر بهذه الإجراءات ."@ar ;
    dzdoc:isAuthoritative true ;
