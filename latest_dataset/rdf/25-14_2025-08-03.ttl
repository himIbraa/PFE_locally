<https://legal.dz/resource/law/2025-08-03/25-14#version_art_763> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم تكن أموال المحكوم عليه كافية لتغطية المصاريف والغرامة أو رد ما يلزم رده أو التعويضات المدنية ، خصص المبلغ الموجود فعلا لديه حسب ترتيب الأولية الآتي : المصاريف القضائية، رد ما يلزم رده، التعويضات المدنية، الغرامة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_763_20250803_OpEnact_ded5d0fa1c> ;
    dzdoc:replacementText "إذا لم تكن أموال المحكوم عليه كافية لتغطية المصاريف والغرامة أو رد ما يلزم رده أو التعويضات المدنية ، خصص المبلغ الموجود فعلا لديه حسب ترتيب الأولية الآتي : المصاريف القضائية، رد ما يلزم رده، التعويضات المدنية، الغرامة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
