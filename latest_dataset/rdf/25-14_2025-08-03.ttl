<https://legal.dz/resource/law/2025-08-03/25-14#version_art_588> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرفع الاستئناف في مهلة عشرة (10) أيام اعتبارا من يوم النطق بالحكم الحضوري ، بما فيها الحالة المذكورة في المادة 505 أعلاه. غير أن مهلة الاستئناف لا تسري إلا اعتبارا من التبليغ للشخص أو للموطن وإلا فلمقر المجلس الشعبي البلدي أو للنيابة العامة بالحكم إذا كان قد صدر غيابيا أو حضوريا في الحالات المنصوص عليها في المواد 495 (الفقرة الأولى) و 497 و 500 من هذا القانون. وفي حالة استئناف أحد الخصوم في المواعيد المقررة ، تكون للخصوم الآخرين مهلة إضافية مدتها خمسة (5) أيام لرفع الاستئناف. ويكون الاستئناف الم"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_588_20250803_OpEnact_f216a40dfe> ;
    dzdoc:replacementText "يرفع الاستئناف في مهلة عشرة (10) أيام اعتبارا من يوم النطق بالحكم الحضوري ، بما فيها الحالة المذكورة في المادة 505 أعلاه. غير أن مهلة الاستئناف لا تسري إلا اعتبارا من التبليغ للشخص أو للموطن وإلا فلمقر المجلس الشعبي البلدي أو للنيابة العامة بالحكم إذا كان قد صدر غيابيا أو حضوريا في الحالات المنصوص عليها في المواد 495 (الفقرة الأولى) و 497 و 500 من هذا القانون. وفي حالة استئناف أحد الخصوم في المواعيد المقررة ، تكون للخصوم الآخرين مهلة إضافية مدتها خمسة (5) أيام لرفع الاستئناف. ويكون الاستئناف المقدم من المتهم الذي أحيط علما بالحكم من غير حالات التبليغ، مقبولا."@ar ;
