<https://legal.dz/resource/law/2025-08-03/25-14#version_art_44> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "النيابة العامة لدى المجلس القضائي يمثلها النائب العام . يساعد النائب العام ، نائب عام مساعد أول وعدة نواب عامين مساعدين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_44_20250803_OpEnact_2686d082fd> ;
    dzdoc:replacementText "النيابة العامة لدى المجلس القضائي يمثلها النائب العام . يساعد النائب العام ، نائب عام مساعد أول وعدة نواب عامين مساعدين."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_44> ;
