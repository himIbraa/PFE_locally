    dzdoc:sourceTextSpan "لا يجوز للمكلف بتنفيذ أمر القبض أن يدخل مسكن أي شخص قبل الساعة الخامسة (5) صباحا ولا بعد الساعة الثامنة (8) مساء."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_196> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_196_obligation_1_0d1ef4f5> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2025-08-03/25-14#art_196_obligation_1_0d1ef4f5_role_59cd395e9d> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_196> ;
    dznorm:position 1 ;
    dznorm:provisionText "ويتعين على هذه القوة الامتثال لما تضمنه أمر القبض من طلبات."@ar ;
    dznorm:sourceArticle "art_196" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_196_obligation_1_0d1ef4f5_role_59cd395e9d> a dznorm:Role ;
