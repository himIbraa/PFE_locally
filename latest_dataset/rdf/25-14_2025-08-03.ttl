<https://legal.dz/resource/law/2025-08-03/25-14#art_27_obligation_2_a000c8d5> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_27> ;
    dznorm:position 2 ;
    dznorm:provisionText "وعليهم، بمجرد إنجاز أعمالهم، أن يوافوه مباشرة بأصول المحاضر التي يحررونها مصحوبة بنسخة منها مؤشر عليها بأنها مطابقة لأصول تلك المحاضر التي حرروها، وبجميع المستندات والوثائق المتعلقة بها، وكذا الأشياء المضبوطة، وأن يقدموا أمامه الأشخاص المشتبه فيهم إذا طلب منهم ذلك"@ar ;
    dznorm:sourceArticle "art_27" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_27_obligation_3_bed74b6b> a dznorm:Obligation ;
