    dznorm:conditionText "إذا كانت حالة المتهم الصحية لا تمكنه من الحضور أمام المحكمة ووجدت أسباب خطيرة لعدم تأجيل القضية أو إذا اقتضى حسن العدالة الفصل فيها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_500> ;
