<https://legal.dz/resource/law/2025-08-03/25-14#version_art_39> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تباشر النيابة العامة الدعوى العمومية باسم المجتمع، وتطالب بتطبيق القانون ، وهي تمثل أمام كل جهة قضائية، و يحضر ممثلها أمام جهات التحقيق والحكم ، و يتعين أن ينطق بالأحكام في حضوره ، كما تتولى العمل على تنفيذ أحكام القضاء ، ولها، في سبيل مباشرة وظائفها، أن تلجأ إلى القوة العمومية . كما تستعين بضباط وأعوان الشرطة القضائية ."@ar ;
