<https://legal.dz/resource/law/2025-08-03/25-14#version_art_17> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مع مراعاة أحكام الفقرة 2 من المادة 12 أعلاه، تتقادم الدعوى المدنية وفق أحكام القانون المدني. غير أنه لا يجوز رفع هذه الدعوى أمام الجهة القضائية الجزائية بعد انقضاء أجل تقادم الدعوى العمومية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_17_20250803_OpEnact_f2ee2f9589> ;
