    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_864> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_864_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_864> ;
    dzdoc:position 0 ;
    dzdoc:text "يوجه طلب التسليم إلى الحكومة الجزائرية بالطريق الدبلوماسي، ويرفق به، إما الحكم أو القرار الصادر بالعقوبة حتى ولو كان غيابيا، و إما أوراق الإجراءات الجزائية التي صدر بها الأمر رسميا بإحالة المتهم إلى جهة القضاء الجزائي أو التي تؤدي إلى ذلك بقوة القانون، وإما أمر القبض أو أية ورقة صادرة من السلطة القضائية ولها ذات القوة، على أن تتضمن هذه الأوراق الأخيرة بيانا دقيقا للفعل الذي صدرت من أجله وتاريخ هذا الفعل."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_864_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_864> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجب أن تقدم أصول الأوراق المبينة أعلاه أو نسخ رسمية منها."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_864_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_864> ;
    dzdoc:position 2 ;
    dzdoc:text "ويجب على الحكومة الطالبة أن تقدم، في الوقت ذاته، نسخة من النصوص المطبقة على الفعل المكون للجريمة، وأن ترفق بيانا بوقائع الدعوى."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_865_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_865> ;
    dzdoc:position 0 ;
    dzdoc:text "يتولى وزير الشؤون الخارجية تحويل طلب التسليم، بعد فحص المستندات ، ومعه الملف، إلى وزير العدل الذي يتحقق من سلامة الطلب ويعطيه التتبع الإجرائي الملائم الذي يتطلبه القانون."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_866_obligation_0_c8220fdc> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2025-08-03/25-14#art_866_obligation_0_c8220fdc_period_55c5c07b1f> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_866> ;
    dznorm:position 0 ;
    dznorm:provisionText "يقوم النائب العام باستجواب الشخص الأجنبي للتحقق من شخصيته ويبلغه بالمستند الذي قبض بموجبه وذلك خلال الأربع والعشرين (24) ساعة التالية عليه للقبض عليه"@ar ;
    dznorm:sourceArticle "art_866" .

