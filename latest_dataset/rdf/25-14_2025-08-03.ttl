<https://legal.dz/resource/law/2025-08-03/25-14#version_art_744> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل واقعة موصوفة بأنها جناية معاقب عليها في القانون الجزائري ارتكبها جزائري خارج الإقليم الوطني، يجوز أن تتابع ويحكم فيها في الجزائر. غير أنه لا يجوز أن تجرى المتابعة أو المحاكمة إلا إذا لم يثبت الجاني أنه حكم عليه نهائيا في الخارج وأن يثبت في حالة الحكم بالإدانة أنه قضى العقوبة أو سقطت عنه بالتقادم أو حصل على العفو عنها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_744_20250803_OpEnact_c791a23bae> ;
    dzdoc:replacementText "كل واقعة موصوفة بأنها جناية معاقب عليها في القانون الجزائري ارتكبها جزائري خارج الإقليم الوطني، يجوز أن تتابع ويحكم فيها في الجزائر. غير أنه لا يجوز أن تجرى المتابعة أو المحاكمة إلا إذا لم يثبت الجاني أنه حكم عليه نهائيا في الخارج وأن يثبت في حالة الحكم بالإدانة أنه قضى العقوبة أو سقطت عنه بالتقادم أو حصل على العفو عنها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_744> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_744> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
