<https://legal.dz/resource/law/2025-08-03/25-14#version_art_506> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تبين أنه من اللازم إجراء تحقيق تكميلي ، يجب أن يكون ذلك بحكم ، ويقوم بهذا الإجراء القاضي نفسه والذي يتمتع لهذا الغرض بالسلطات المنصوص عليها في المواد من 234 الى 238 من هذا القانون. ويخضع هذا التحقيق التكميلي للقواعد المقررة في المواد من 180 إلى 183 من هذا القانون. لوكيل الجمهورية أن يطلع بطريق المطالبة ، عند الاقتضاء، على الملف في أي وقت أثناء إجراء التحقيق التكميلي ، على أن يعيد الأوراق في ظرف أربع وعشرين (24) ساعة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_506_20250803_OpEnact_1e29913a4f> ;
    dzdoc:replacementText "إذا تبين أنه من اللازم إجراء تحقيق تكميلي ، يجب أن يكون ذلك بحكم ، ويقوم بهذا الإجراء القاضي نفسه والذي يتمتع لهذا الغرض بالسلطات المنصوص عليها في المواد من 234 الى 238 من هذا القانون. ويخضع هذا التحقيق التكميلي للقواعد المقررة في المواد من 180 إلى 183 من هذا القانون. لوكيل الجمهورية أن يطلع بطريق المطالبة ، عند الاقتضاء، على الملف في أي وقت أثناء إجراء التحقيق التكميلي ، على أن يعيد الأوراق في ظرف أربع وعشرين (24) ساعة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_506> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_506> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
