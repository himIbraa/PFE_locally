    dznorm:position 0 ;
    dznorm:provisionText "يجب على أمين الضبط قبل تحرير القسيمة رقم 2 أن يتحقق من الحالة المدنية لصاحب الشأن"@ar ;
    dznorm:sourceArticle "art_799" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_799_obligation_0_5f3a0fc1_action_bb63d2d023> a dznorm:Action ;
