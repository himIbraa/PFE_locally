<https://legal.dz/resource/law/2025-08-03/25-14#version_art_601> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عند الفصل في الاستئناف ، يتصدى المجلس لموضوع الدعوى بناء على تقرير شفوي من أحد المستشارين، ويستجوب المتهم . ولا تسمع شهادة الشهود إلا إذا أمر المجلس بسماعهم . وتسمع أقوال أطراف الدعوى حسب الترتيب الآتي: المستأنفون فالمستأنف عليهم ، وإذا ما تعدد المستأنفون والمستأنف عليهم فللرئيس تحديد دور كل منهم في إبداء أقواله. ويكون المتهم ومحاميه آخر من يتكلم دائما."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_601_20250803_OpEnact_66b6ef8ff4> ;
    dzdoc:replacementText "عند الفصل في الاستئناف ، يتصدى المجلس لموضوع الدعوى بناء على تقرير شفوي من أحد المستشارين، ويستجوب المتهم . ولا تسمع شهادة الشهود إلا إذا أمر المجلس بسماعهم . وتسمع أقوال أطراف الدعوى حسب الترتيب الآتي: المستأنفون فالمستأنف عليهم ، وإذا ما تعدد المستأنفون والمستأنف عليهم فللرئيس تحديد دور كل منهم في إبداء أقواله. ويكون المتهم ومحاميه آخر من يتكلم دائما."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_601> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_601> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
