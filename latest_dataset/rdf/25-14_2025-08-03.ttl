<https://legal.dz/resource/law/2025-08-03/25-14#version_art_180> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز سماع المتهم أو الضحية أو المدعي المدني أو إجراء مواجهة بينهما إلا بحضور محاميه أو بعد دعوته قانونا ما لم يتنازل صراحة عن ذلك ، وينوه عن هذا التنازل في المحضر. يستدعى المحامي برسالة موصى عليها ترسل إليه بيومين (2) ، على الأقل، قبل استجواب المتهم أو سماع الضحية أو الطرف المدني، حسب الحالة . يمكن أيضا استدعاء محامي الأطراف بأي وسيلة إلكترونية أخرى ويثبت ذلك بمحضر. ويجب أن يوضع ملف الإجراءات تحت طلب محامي المتهم قبل كل استجواب بأربع وعشرين (24) ساعة، على الأقل ، كما يجب أن يوضع تحت طلب محامي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_180_20250803_OpEnact_08ce000b74> ;
    dzdoc:replacementText "لا يجوز سماع المتهم أو الضحية أو المدعي المدني أو إجراء مواجهة بينهما إلا بحضور محاميه أو بعد دعوته قانونا ما لم يتنازل صراحة عن ذلك ، وينوه عن هذا التنازل في المحضر. يستدعى المحامي برسالة موصى عليها ترسل إليه بيومين (2) ، على الأقل، قبل استجواب المتهم أو سماع الضحية أو الطرف المدني، حسب الحالة . يمكن أيضا استدعاء محامي الأطراف بأي وسيلة إلكترونية أخرى ويثبت ذلك بمحضر. ويجب أن يوضع ملف الإجراءات تحت طلب محامي المتهم قبل كل استجواب بأربع وعشرين (24) ساعة، على الأقل ، كما يجب أن يوضع تحت طلب محامي الضحية أو المدعي المدني قبل سماع أقواله بأربع وعشرين (24) ساعة على الأقل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_180> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_180> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_181> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز ل وكيل الجمهورية حضور استجواب المتهمين ومواجهاتهم وسماع أقوال المدعي المدني . و يجوز له أن يوجه مباشرة ما يراه لازما من الأسئلة . ويتعين على أمين ضبط التحقيق في كل مرة يبدي فيها وكيل الجمهورية ل قاضي التحقيق رغبته في حضور الاستجواب أن يخطره بمذكرة بسيطة قبل الاستجواب بيومين (2)، على الأقل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_181_20250803_OpEnact_80b3787f86> ;
    dzdoc:replacementText "يجوز ل وكيل الجمهورية حضور استجواب المتهمين ومواجهاتهم وسماع أقوال المدعي المدني . و يجوز له أن يوجه مباشرة ما يراه لازما من الأسئلة . ويتعين على أمين ضبط التحقيق في كل مرة يبدي فيها وكيل الجمهورية ل قاضي التحقيق رغبته في حضور الاستجواب أن يخطره بمذكرة بسيطة قبل الاستجواب بيومين (2)، على الأقل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_181> ;
