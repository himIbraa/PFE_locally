<https://legal.dz/resource/law/2025-08-03/25-14#version_art_169> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوقع على كل صفحة من صفحات محضر التحقيق من قاضي التحقيق و أمين الضبط والشاهد ويدعى الأخير إلى إعادة تلاوة فحوى شهادته بنصها الذي حررت به والتوقيع إن أصر عليها، فإذا لم يكن الشاهد ملما بالقراءة يتلى عليه بمعرفة أمين الضبط . و إن امتنع الشاهد عن التوقيع أو تعذر عليه نوه عن ذلك في المحضر . يوقع أيضا على كل صفحة بهذه الكيفية من المترجم إن كان ثمة محل لذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_169_20250803_OpEnact_9786887c92> ;
    dzdoc:replacementText "يوقع على كل صفحة من صفحات محضر التحقيق من قاضي التحقيق و أمين الضبط والشاهد ويدعى الأخير إلى إعادة تلاوة فحوى شهادته بنصها الذي حررت به والتوقيع إن أصر عليها، فإذا لم يكن الشاهد ملما بالقراءة يتلى عليه بمعرفة أمين الضبط . و إن امتنع الشاهد عن التوقيع أو تعذر عليه نوه عن ذلك في المحضر . يوقع أيضا على كل صفحة بهذه الكيفية من المترجم إن كان ثمة محل لذلك."@ar ;
