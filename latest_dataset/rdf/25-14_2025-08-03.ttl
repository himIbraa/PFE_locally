<https://legal.dz/resource/law/2025-08-03/25-14#art_165_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_165> ;
    dzdoc:position 0 ;
    dzdoc:text "يؤدي الشهود شهادتهم فرادى أمام قاضي التحقيق ويعاونه أمين ضبط دون حضور المتهم، ويحرر محضرا بأقوالهم."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_166_condition_0_9030983b> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يكن المترجم قد سبق له أن أدى اليمين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_166> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_166_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_166> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز لقاضي التحقيق استدعاء مترجم غير أمين الضبط، والشهود."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_166_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_166> ;
    dzdoc:position 1 ;
    dzdoc:text """إذا لم يكن المترجم قد سبق له أن أدى اليمين ، فإنه يحلف بالصيغة الآتية :
                "أقسم بالله العظيم وأتعهد بأن أترجم بإخلاص الأقوال التي تلفظ أو تتبادل بين الأشخاص معبرة بلغات مختلفة"."""@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_166_permission_0_c3461e28> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_166_permission_0_c3461e28_action_14e388bf68> ;
