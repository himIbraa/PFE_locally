<https://legal.dz/resource/law/2025-08-03/25-14#version_art_225> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن المدعي أو الوكيل القضائي للخزينة أو محاميهما الاطلاع على ملف القضية بأمانة اللجنة . يودع الوكيل القضائي للخزينة مذكراته لدى أمانة اللجنة في أجل لا يتعدى شهرين (2) ، ابتداء من تاريخ استلام الرسالة الموصى عليها المنصوص عليها في المادة 224 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_225_20250803_OpEnact_125b7b5731> ;
    dzdoc:replacementText "يمكن المدعي أو الوكيل القضائي للخزينة أو محاميهما الاطلاع على ملف القضية بأمانة اللجنة . يودع الوكيل القضائي للخزينة مذكراته لدى أمانة اللجنة في أجل لا يتعدى شهرين (2) ، ابتداء من تاريخ استلام الرسالة الموصى عليها المنصوص عليها في المادة 224 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_225> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
