<https://legal.dz/resource/law/2025-08-03/25-14#version_art_404> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يبلغ النائب العام كل محلف نسخة من جدول الدورة الخاصة به، و ذلك قبل افتتاح الدورة بثمانية أيام، على الأقل . ويذكر هذا اليوم في التبليغ الذي يجب أن يتضمن أيضا تنبيها بالحضور في اليوم والساعة المحددين وإلا طبقت عليه العقوبات التي نصت عليها المادة 416 أدناه . و إذا لم يكن التبليغ لشخصه ، فلموطنه ولرئيس المجلس الشعبي البلدي الذي يتعين عليه إحاطته علما بتعيينه محلفا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_404_20250803_OpEnact_5f4f6df9f8> ;
    dzdoc:replacementText "يبلغ النائب العام كل محلف نسخة من جدول الدورة الخاصة به، و ذلك قبل افتتاح الدورة بثمانية أيام، على الأقل . ويذكر هذا اليوم في التبليغ الذي يجب أن يتضمن أيضا تنبيها بالحضور في اليوم والساعة المحددين وإلا طبقت عليه العقوبات التي نصت عليها المادة 416 أدناه . و إذا لم يكن التبليغ لشخصه ، فلموطنه ولرئيس المجلس الشعبي البلدي الذي يتعين عليه إحاطته علما بتعيينه محلفا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_404> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
