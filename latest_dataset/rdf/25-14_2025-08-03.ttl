<https://legal.dz/resource/law/2025-08-03/25-14#version_art_700> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا حصل أثناء جلسة بمحكمة أو مجلس قضائي أن أدعي بتزوير ورقة من أوراق الدعوى أو أحد المستندات المقدمة ، فلتلك الجهة القضائية أن تقرر، بعد أخذ ملاحظات النيابة العامة و أطراف الدعوى، ما إذا كان ثمة محل لإيقاف الدعوى أو عدم إيقافها ريثما يفصل في التزوير من الجهة القضائية المختصة. وإذا انقضت الدعوى العمومية ، أو كان لا يمكن مباشرتها عن تهمة التزوير ، و إذا لم يتبين أن من قدم الورقة كان قد استعملها متعمدا عن قصد التزوير ، قضت المحكمة أو المجلس المطروحة أمامه الدعوى الأصلية بصفة فرعية في صفة الورقة الم"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_700_20250803_OpEnact_5963ef3d2d> ;
    dzdoc:replacementText "إذا حصل أثناء جلسة بمحكمة أو مجلس قضائي أن أدعي بتزوير ورقة من أوراق الدعوى أو أحد المستندات المقدمة ، فلتلك الجهة القضائية أن تقرر، بعد أخذ ملاحظات النيابة العامة و أطراف الدعوى، ما إذا كان ثمة محل لإيقاف الدعوى أو عدم إيقافها ريثما يفصل في التزوير من الجهة القضائية المختصة. وإذا انقضت الدعوى العمومية ، أو كان لا يمكن مباشرتها عن تهمة التزوير ، و إذا لم يتبين أن من قدم الورقة كان قد استعملها متعمدا عن قصد التزوير ، قضت المحكمة أو المجلس المطروحة أمامه الدعوى الأصلية بصفة فرعية في صفة الورقة المدعى بتزويرها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
