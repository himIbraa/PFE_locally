<https://legal.dz/resource/law/2025-08-03/25-14#version_art_846> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم وكيل الجمهورية بإجراء تحقيق في الجهات التي أقام بها المحكوم عليه بمعرفة مصالح الدرك الوطني أو الأمن الوطني أو المصالح الخارجية لإدارة السجون المكلفة بإعادة الإدماج الاجتماعي للمحبوسين . ويستطلع، عند الاقتضاء ، رأي قاضي تطبيق العقوبات . إذا تعلق الأمر بطلب رد الاعتبار لشخص معنوي ، يقوم وكيل الجمهورية بإجراء تحقيق ويحاط بكل المعلومات الضرورية و يستطلع رأي الإدارات العمومية المعنية إذا رأى محلا لذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_846_20250803_OpEnact_0fa3212589> ;
    dzdoc:replacementText "يقوم وكيل الجمهورية بإجراء تحقيق في الجهات التي أقام بها المحكوم عليه بمعرفة مصالح الدرك الوطني أو الأمن الوطني أو المصالح الخارجية لإدارة السجون المكلفة بإعادة الإدماج الاجتماعي للمحبوسين . ويستطلع، عند الاقتضاء ، رأي قاضي تطبيق العقوبات . إذا تعلق الأمر بطلب رد الاعتبار لشخص معنوي ، يقوم وكيل الجمهورية بإجراء تحقيق ويحاط بكل المعلومات الضرورية و يستطلع رأي الإدارات العمومية المعنية إذا رأى محلا لذلك ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_846> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
