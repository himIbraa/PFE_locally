<https://legal.dz/resource/law/2025-08-03/25-14#art_447_obligation_0_eb1f8704> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_447> ;
    dznorm:position 0 ;
    dznorm:provisionText "أمر الرئيس بأن يقتاد المتهم الذي قضي ببراءته بغير تمهل بواسطة القوة العمومية إلى وكيل الجمهورية بمقر محكمة الجنايات لكي يطلب في الحال فتح تحقيق."@ar ;
    dznorm:sourceArticle "art_447" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_447_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_447> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا ظهرت أثناء المناقشات دلائل جديدة ضد المتهم بسبب وقائع أخرى ، وأبدت النيابة العامة تمسكها بحق المتابعة عنها ، أمر الرئيس بأن يقتاد المتهم الذي قضي ببراءته بغير تمهل بواسطة القوة العمومية إلى وكيل الجمهورية بمقر محكمة الجنايات لكي يطلب في الحال فتح تحقيق."@ar .

