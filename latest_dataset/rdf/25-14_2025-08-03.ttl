    dzdoc:position 2 ;
    dzdoc:text "كما يذكر بها الوصف القانوني للواقعة المنسوبة إليه، وتحدد على وجه الدقة الأسباب التي من أجلها توجد أو لا توجد ضده دلائل كافية والمواد القانونية المطبقة."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_266_condition_0_9a32af00> a dznorm:Condition ;
    dznorm:conditionText "متى رفع الاستئناف من النيابة العامة، بقي المتهم المحبوس مؤقتا في حبسه حتى يفصل في الاستئناف"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_266> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_266_obligation_0_45f8ab96> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_266_obligation_0_45f8ab96_action_df5366fc02> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_266> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب أن يرفع في ثلاثة (3) أيام من تاريخ صدور الأمر"@ar ;
    dznorm:sourceArticle "art_266" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_266_obligation_0_45f8ab96_action_df5366fc02> a dznorm:Action ;
    rdfs:label "أن يرفع في ثلاثة (3)"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب أن يرفع في ثلاثة (3) أيام من تاريخ صدور الأمر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_266> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_266_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_266> ;
    dzdoc:position 0 ;
    dzdoc:text "لوكيل الجمهورية الحق في أن يستأنف أمام غرفة الاتهام جميع أوامر قاضي التحقيق. ويكون هذا الاستئناف بتقرير بأمانة ضبط المحكمة، ويجب أن يرفع في ثلاثة (3) أيام من تاريخ صدور الأمر."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_266_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_266> ;
    dzdoc:position 1 ;
    dzdoc:text "مع مراعاة أحكام المادة 259 أعلاه ، متى رفع الاستئناف من النيابة العامة، بقي المتهم المحبوس مؤقتا في حبسه حتى يفصل في الاستئناف ويبقى كذلك، في جميع الأحوال، إلى حين انقضاء أجل استئناف وكيل الجمهورية، إلا إذا وافق وكيل الجمهورية على الإفراج عن المتهم في الحال."@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_266_right_0_21ed0c0f> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_266> ;
    dznorm:position 0 ;
    dznorm:provisionText "لوكيل الجمهورية الحق في أن يستأنف أمام غرفة الاتهام جميع أوامر قاضي التحقيق"@ar ;
    dznorm:sourceArticle "art_266" .

<https://legal.dz/resource/law/2025-08-03/25-14#art_267_obligation_0_d0083e83> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
