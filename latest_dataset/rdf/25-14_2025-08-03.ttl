    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_20>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_21>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_38>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_73> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_26_condition_0_29e08498>,
