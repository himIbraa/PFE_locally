<https://legal.dz/resource/law/2025-08-03/25-14#version_art_591> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يوقع على تقرير الاستئناف من أمين ضبط الجهة القضائية التي حكمت، ومن المستأنف نفسه أو من محام أو من وكيل خاص مفوض عنه بالتوقيع إذا لم يكن المتهم محل أمر بالقبض ، و في الحالة الأخيرة يرفق التفويض بالمحرر الذي دونه أمين الضبط ، و إذا كان المستأنف لا يستطيع التوقيع ذكر أمين الضبط ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_591_20250803_OpEnact_5f95c615a1> ;
    dzdoc:replacementText "يجب أن يوقع على تقرير الاستئناف من أمين ضبط الجهة القضائية التي حكمت، ومن المستأنف نفسه أو من محام أو من وكيل خاص مفوض عنه بالتوقيع إذا لم يكن المتهم محل أمر بالقبض ، و في الحالة الأخيرة يرفق التفويض بالمحرر الذي دونه أمين الضبط ، و إذا كان المستأنف لا يستطيع التوقيع ذكر أمين الضبط ذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_591> ;
