<https://legal.dz/resource/law/2025-08-03/25-14#version_art_92> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لـ وكيل الجمهورية في حالة الجناية المتلبس بها ، إذا لم يكن قاضي التحقيق قد أبلغ بها بعد ، أن يصدر أمرا بإحضار المشتبه بمساهمته في الجريمة. ويقوم وكيل الجمهورية باستجواب الشخص المقدم إليه بحضور محاميه، إن وجد ، فإذا حضر ذلك الشخص من تلقاء نفسه، ومعه محاميه، استجوب بحضور هذا الأخير. يمكن للمحامي تقديم ملاحظات بعد إذن وكيل الجمهورية وتحت رقابته ، وينوه عن ذلك في محضر الاستجواب."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_92_20250803_OpEnact_c73965391c> ;
    dzdoc:replacementText "يجوز لـ وكيل الجمهورية في حالة الجناية المتلبس بها ، إذا لم يكن قاضي التحقيق قد أبلغ بها بعد ، أن يصدر أمرا بإحضار المشتبه بمساهمته في الجريمة. ويقوم وكيل الجمهورية باستجواب الشخص المقدم إليه بحضور محاميه، إن وجد ، فإذا حضر ذلك الشخص من تلقاء نفسه، ومعه محاميه، استجوب بحضور هذا الأخير. يمكن للمحامي تقديم ملاحظات بعد إذن وكيل الجمهورية وتحت رقابته ، وينوه عن ذلك في محضر الاستجواب."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_92> ;
