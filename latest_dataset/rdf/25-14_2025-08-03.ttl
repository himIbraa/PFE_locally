<https://legal.dz/resource/law/2025-08-03/25-14#version_art_57> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن وكيل الجمهورية ، في الوقائع التي تكتسي وصف مخالفة أو جنحة قليلة الخطورة معاقب عليها بالغرامة و / أو الحبس لمدة لا تتجاوز الثلاث (3) سنوات ، للحفاظ على روابط القرابة أو الجوار، أن يوجه مباشرة أو عن طريق ضابط الشرطة القضائية تنبيها لمرتكبها لوضع حد للجريمة. يجوز لـ وكيل الجمهورية حفظ الملف بعد سماع الضحية والتأكد أن الفاعل قد التزم بالتنبيه الذي وجه له ووضع حدا للأفعال الصادرة عنه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_57_20250803_OpEnact_d62266374b> ;
    dzdoc:replacementText "يمكن وكيل الجمهورية ، في الوقائع التي تكتسي وصف مخالفة أو جنحة قليلة الخطورة معاقب عليها بالغرامة و / أو الحبس لمدة لا تتجاوز الثلاث (3) سنوات ، للحفاظ على روابط القرابة أو الجوار، أن يوجه مباشرة أو عن طريق ضابط الشرطة القضائية تنبيها لمرتكبها لوضع حد للجريمة. يجوز لـ وكيل الجمهورية حفظ الملف بعد سماع الضحية والتأكد أن الفاعل قد التزم بالتنبيه الذي وجه له ووضع حدا للأفعال الصادرة عنه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
