<https://legal.dz/resource/law/2025-08-03/25-14#art_76_obligation_4_74038325> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2025-08-03/25-14#art_76_obligation_4_74038325_action_3457879767> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_76> ;
