<https://legal.dz/resource/law/2025-08-03/25-14#version_art_871> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقوم المحكمة العليا في الحالة العكسية بإبداء رأيها المعلل في طلب التسليم. ويكون هذا الرأي في غير صالح الطلب إذا تراءى للمحكمة العليا وجود خطأ و أن الشروط القانونية غير مستوفاة . ويجب إعادة الملف إلى وزير العدل خلال ثمانية (8) أيام تبدأ من انقضاء المواعيد المنصوص عليها في المادة 869 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_871_20250803_OpEnact_dc9ad37a32> ;
    dzdoc:replacementText "تقوم المحكمة العليا في الحالة العكسية بإبداء رأيها المعلل في طلب التسليم. ويكون هذا الرأي في غير صالح الطلب إذا تراءى للمحكمة العليا وجود خطأ و أن الشروط القانونية غير مستوفاة . ويجب إعادة الملف إلى وزير العدل خلال ثمانية (8) أيام تبدأ من انقضاء المواعيد المنصوص عليها في المادة 869 أعلاه."@ar ;
