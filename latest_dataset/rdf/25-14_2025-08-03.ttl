    dznorm:expressedIn <https://legal.dz/resource/law/2025-08-03/25-14#art_873> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_873_condition_1_d6d1ff9d> a dznorm:Condition ;
    dznorm:conditionText "إذا انقضى ميعاد شهر من تاريخ تبليغ هذا المرسوم إلى حكومة الدولة الطالبة دون أن يقوم ممثلو تلك الدولة باستلام الشخص المقرر تسليمه"@ar ;
