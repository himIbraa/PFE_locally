<https://legal.dz/resource/law/2025-08-03/25-14#version_art_288> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كانت غرفة الاتهام قد فصلت في استئناف الأمر الصادر عن قاضي التحقيق في موضوع حبس المتهم مؤقتا ، فسواء أيدت الأمر أم ألغته وقررت الإفراج عن المتهم أو باستمرار حبسه أو أصدرت أمرا بإيداعه الحبس أو بالقبض عليه، فعلى النائب العام إعادة الملف، بغير تمهل، إلى قاضي التحقيق بعد العمل على تنفيذ القرار . وإذا حدث، في أي موضوع آخر، أن ألغت غرفة الاتهام أمر قاضي التحقيق ، فإن لها أن تتصدى للموضوع أو تحيل الملف إلى قاضي التحقيق نفسه أو إلى قاض غيره لمواصلة التحقيق ما لم يكن قرار الإلغاء قد أنهى التحقيق. وإذ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_288_20250803_OpEnact_88ade19003> ;
    dzdoc:replacementText "إذا كانت غرفة الاتهام قد فصلت في استئناف الأمر الصادر عن قاضي التحقيق في موضوع حبس المتهم مؤقتا ، فسواء أيدت الأمر أم ألغته وقررت الإفراج عن المتهم أو باستمرار حبسه أو أصدرت أمرا بإيداعه الحبس أو بالقبض عليه، فعلى النائب العام إعادة الملف، بغير تمهل، إلى قاضي التحقيق بعد العمل على تنفيذ القرار . وإذا حدث، في أي موضوع آخر، أن ألغت غرفة الاتهام أمر قاضي التحقيق ، فإن لها أن تتصدى للموضوع أو تحيل الملف إلى قاضي التحقيق نفسه أو إلى قاض غيره لمواصلة التحقيق ما لم يكن قرار الإلغاء قد أنهى التحقيق. وإذا أيدت غرفة الاتهام أمر قاضي التحقيق المستأنف ، ترتب عليه أثره كاملا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_288> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_288> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2025-08-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2025-08-03/25-14#version_art_289> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا قررت غرفة الاتهام إجراء تحقيق تكميلي و كلفت به أحد أعضائها ثم أنهي ذلك التحقيق فإنها تأمر بإيداع ملف التحقيق لدى أمانة الضبط ، و يخطر النائب العام في الحال كلا من أطراف الدعوى ومحاميهم بهذا الإيداع برسالة موصى عليها ، ويبقى ملف الدعوى مودعا لدى أمانة الضبط طيلة خمسة (5) أيام مهما كان نوع القضية. وتتبع ، عندئذ ، أحكام المواد 278 و 279 و 280 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_289_20250803_OpEnact_472106873f> ;
    dzdoc:replacementText "إذا قررت غرفة الاتهام إجراء تحقيق تكميلي و كلفت به أحد أعضائها ثم أنهي ذلك التحقيق فإنها تأمر بإيداع ملف التحقيق لدى أمانة الضبط ، و يخطر النائب العام في الحال كلا من أطراف الدعوى ومحاميهم بهذا الإيداع برسالة موصى عليها ، ويبقى ملف الدعوى مودعا لدى أمانة الضبط طيلة خمسة (5) أيام مهما كان نوع القضية. وتتبع ، عندئذ ، أحكام المواد 278 و 279 و 280 من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
