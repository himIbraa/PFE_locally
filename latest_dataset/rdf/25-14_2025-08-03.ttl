<https://legal.dz/resource/law/2025-08-03/25-14#art_661> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_3> ;
    dzdoc:eId "art_661" ;
    dzdoc:fullText "يجب على الطاعن بالنقض أن يودع لدى أمانة ضبط الجهة القضائية التي أصدرت الحكم أو القرار المطعون فيه مذكرة بأوجه الطعن موقعة من محام أو أكثر معتمد لدى المحكمة العليا مرفقة بنسخ بقدر ما يوجد في الدعوى من أطراف معنيين بالطعن خلال ستين (60) يوما، ابتداء من تاريخ الطعن . يثبت أمين ضبط الجهة القضائية المذكورة تاريخ الإيداع، ويسلم للطاعن نسخا من مذكرة الطعن بعدد الأطراف المعنية بالطعن."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_661> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_661_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_661_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_661_20250803_OpEnact_02da6ed12e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_661_obligation_0_72719e5d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "661" ;
    dzdoc:position 659 ;
    dzdoc:usesTerm dzterm:clerk .

