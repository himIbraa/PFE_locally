dzterm:public_action a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الدعوى العمومية"@ar .

<https://legal.dz/resource/law/2025-08-03/25-14#art_123> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_5> ;
    dzdoc:eId "art_123" ;
    dzdoc:fullText "يمكن ضباط وأعوان الشرطة القضائية المرخص لهم بإجراء عملية التسرب والأشخاص الذين يسخرونهم لهذا الغرض، دون أن يكونوا مسؤولين جزائيا، القيام بما يأتي : اقتناء أو حيازة أو نقل أو تسليم أو إعطاء مواد أو أموال أو منتوجات أو وثائق أو معلومات متحصل عليها من ارتكاب الجرائم أو مستعملة في ارتكابها، استعمال أو وضع تحت تصرف مرتكبي هذه الجرائم الوسائل ذات الطابع القانوني أو المالي و كذا و سائل النقل أو التخزين أو الإيواء أو الحفظ أو الاتصال."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_123_permission_0_99c7f2c8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_123> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_123_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_123_20250803_OpEnact_2c3a92cb61> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "123" ;
    dzdoc:position 122 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_124> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_5> ;
    dzdoc:eId "art_124" ;
    dzdoc:fullText "يجب أن يكون الإذن المسلم تطبيقا لـ المادة 120 أعلاه، مكتوبا ومسببا، وذلك تحت طائلة البطلان. تذكر في الإذن، الجريمة التي تبرر اللجوء إلى هذا الإجراء وهوية ضابط الشرطة القضائية الذي تتم العملية تحت مسؤوليته. ويحدد هذا الإذن مدة عملية التسرب التي لا يمكن أن تتجاوز أربعة (4) أشهر. يمكن أن تجدد العملية حسب مقتضيات التحري أو التحقيق ضمن نفس الشروط الشكلية والزمنية. ويجوز للقاضي الذي رخص بإجرائها أن يأمر، في أي وقت، بوقفها قبل انقضاء المدة المحددة. تودع الرخصة في ملف الإجراءات بعد الانتهاء من عملية التسرب."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_124_permission_0_efc1f1b4>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_124_permission_1_e330f5e5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_124> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_124_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_124_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_124_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_124_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_124_para_4>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_124_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_124_20250803_OpEnact_dd06111702> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_124_obligation_0_28733256> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "124" ;
    dzdoc:position 123 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_120> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_120> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_134> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_6> ;
    dzdoc:eId "art_134" ;
    dzdoc:fullText "يجوز للنيابة العامة أو المتهم أو الضحية أو المدعي المدني أو الطرف المدني أو محاميهم عرض الأسئلة المراد طرحها للشاهد على قاضي التحقيق قبل أو عند سماع الشاهد . يتخذ قاضي التحقيق كل التدابير الضرورية للحفاظ على سرية هوية الشاهد و يمنعه من الجواب على الأسئلة التي قد تؤدي إلى الكشف عن هويته ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_134_permission_0_ad8cb894> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_134_right_0_03500a56> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_134> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_134_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_134_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_134_20250803_OpEnact_82164a1b31> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_134_obligation_0_bc5e77fc>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_134_obligation_1_91d6a401> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 134" ;
    dzdoc:position 133 ;
    dzdoc:usesTerm dzterm:investigating_judge .

<https://legal.dz/resource/law/2025-08-03/25-14#art_158> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_3> ;
    dzdoc:eId "art_158" ;
    dzdoc:fullText "إذا حصل التفتيش في مسكن المتهم ، فعلى قاضي التحقيق أن يلتزم بأحكام المواد من 76 إلى 78 من هذا القانون ، غير أنه يجوز له وحده في مواد الجنايات أن يقوم بتفتيش مسكن المتهم في غير الساعات المحددة في المادة 78 أعلاه ، ده، بشرط أن يباشر التفتيش بنفسه وأن يتم ذلك بحضور وكيل الجمهورية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_158_permission_0_4c48391f> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_158_right_0_5b4028c5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_158> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_158_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_158_20250803_OpEnact_c2f23fa700> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_158_obligation_0_82f18db6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "158" ;
    dzdoc:position 157 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_76>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_78> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_76>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_78> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_158_condition_0_9df655bf>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_158_condition_1_6cb69223> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_167> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_4> ;
    dzdoc:eId "art_167" ;
    dzdoc:fullText "إذا كان الشاهد أصما أو أبكما ، توضع الأسئلة وتكون الإجابات بالكتابة ، و إذا لم يكن يعرف الكتابة ، يندب له قاضي التحقيق ، من تلقاء نفسه، مترجما قادرا على التحدث معه، ويذكر في المحضر اسم المترجم المنتدب ولقبه ومهنته وموطنه، وينوه عن حلفه اليمين ، ثم يوقع على المحضر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_167> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_167_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_167_20250803_OpEnact_8cde4ab70e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 167" ;
    dzdoc:position 166 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_167_condition_0_738b6044>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_167_condition_1_2ca2138d> ;
    dzdoc:usesTerm dzterm:investigating_judge .

<https://legal.dz/resource/law/2025-08-03/25-14#art_184> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_6> ;
    dzdoc:eId "art_184" ;
    dzdoc:fullText "يجوز ل قاضي التحقيق ، حسبما تقتضي الحالة، أن يصدر أمرا بإحضار المتهم أو بإيداعه الحبس أو بإلقاء القبض عليه . ويتعين أن يذكر في كل أمر نوع التهمة والمواد القانونية المطبقة، مع إيضاح هوية المتهم ويؤرخ الأمر ويوقع عليه من القاضي الذي أصدره ويمهر بختمه . وتكون تلك الأوامر نافذة المفعول في جميع أنحاء الأراضي الجزائرية. ويجب أن يؤشر على الأوامر التي يصدرها قاضي التحقيق من وكيل الجمهورية ، وأن ترسل بمعرفته ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_184_permission_0_f1f3f8c1> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_184_right_0_3f71c984> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_184> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_184_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_184_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_184_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_184_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_184_20250803_OpEnact_b18c2fd019> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_184_obligation_0_e7629b30>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_184_obligation_1_e6806519> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "184" ;
    dzdoc:position 183 ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_215> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_7> ;
    dzdoc:eId "art_215" ;
    dzdoc:fullText "يرد الجزء الأول من مبلغ الكفالة إذا حضر المتهم أو مثل في جميع إجراءات الدعوى، وتقدم لتنفيذ الحكم. ويصبح هذا الجزء ملكا للدولة منذ اللحظة التي يتخلف فيها المتهم ، بغير عذر مشروع، عن أي إجراء من إجراءات الدعوى أو عن تنفيذ الحكم. غير أنه يجوز لقاضي التحقيق، في حالة إصداره أمرا بألا وجه للمتابعة ، أن يأمر برد ذلك الجزء من مبلغ الكفالة إلىالمتهم ، كما يجوز ذلك لجهة الحكم في حالة إعفاء المتهم أو في حالة تبرئته."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_215_permission_0_c29340a9> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_215_right_0_1547b9ed> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_215> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_215_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_215_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_215_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_215_20250803_OpEnact_6d6578c6b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "215" ;
    dzdoc:position 214 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_234> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_9> ;
    dzdoc:eId "art_234" ;
    dzdoc:fullText "يجوز ل قاضي التحقيق أن يكلف بطريق الإنابة القضائية أي قاض من قضاة محكمته أو أي ضابط من ضباط الشرطة القضائية المختص بالعمل في تلك الدائرة أو أي قاض من قضاة التحقيق بالقيام بما يراه لازما من إجراءات التحقيق في الأماكن الخاضعة للجهة القضائية التي يتبعها كل منهم. ويذكر في الإنابة القضائية نوع الجريمة موضوع المتابعة والنصوص القانونية المطبقة، وتؤرخ وتوقع من القاضي الذي أصدرها، وتمهر بختمه. ولا يجوز أن يؤمر فيها إلا باتخاذ إجراءات التحقيق المتعلقة مباشرة بالمعاقبة على الجريمة التي تنصب عليها المتابعة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_234_permission_0_5e1f0a41>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_234_permission_1_f47e64ec> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_234> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_234_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_234_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_234_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_234_20250803_OpEnact_5ca5abc62a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "234" ;
    dzdoc:position 233 ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:judicial_police_officer .

<https://legal.dz/resource/law/2025-08-03/25-14#art_248> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_10> ;
    dzdoc:eId "art_248" ;
    dzdoc:fullText "يجوز لأطراف الخصومة، أثناء إجراء أعمال الخبرة، أن يطلبوا من الجهة القضائية التي أمرت بها أن تكلف الخبراء بإجراء أبحاث معينة أو سماع أي شخص معين باسمه قد يكون قادرا على مدهم بالمعلومات ذات الطابع الفني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_248_permission_0_c50f5002> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_248_right_0_316bc1e3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_248> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_248_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_248_20250803_OpEnact_09ea533ef7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "248" ;
    dzdoc:position 247 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_269> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_1_subsec_13> ;
    dzdoc:eId "art_269" ;
    dzdoc:fullText "يجوز للضحية أو المدعي المدني أو لمحاميهما أن يطعن بطريق الاستئناف في الأوامر الصادرة بعدم إجراء التحقيق، أو بألا وجه للمتابعة أو الأوامر التي تمس حقوقه المدنية ، غير أن استئنافه لا يمكن أن ينصب، في أي حال من الأحوال، على أمر أو على شق من أمر متعلق بحبس المتهم مؤقتا. ويجوز له استئناف الأمر الذي بموجبه حكم القاضي في أمر اختصاصه بنظر الدعوى ، سواء من تلقاء نفسه أو بناء على دفع الخصوم بعدم الاختصاص. ويرفع استئناف الضحية أو المدعي المدني وفقا للأشكال المنصوص عليها في الفقرة 2 من المادة 268 أعلاه ، خلال ثلاثة (3) أيام من تاريخ تبليغهم بالأمر في الموطن المختار من طرفهم. وتطبق نفس الأحكام المذكورة في الفقرة 3 على الشاهد الذي يستأنف الأمر المنصوص عليه في المادة 172 أعلاه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_269_permission_0_cf30576f> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_269_right_0_35fdf70b>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_269_right_1_6bd37e20> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_269> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_269_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_269_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_269_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_269_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_269_20250803_OpEnact_99e5d92c6c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "269" ;
    dzdoc:position 268 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_172>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_268> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_172>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_268> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_296> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_296" ;
    dzdoc:fullText "يوقع على قرارات غرفة الاتهام من الرئيس وأمين الضبط وتذكر بها أسماء الأعضاء والإشارة إلى إيداع المستندات والمذكرات و إلى تلاوة التقرير وإلى طلبات النيابة العامة . وتحتفظ غرفة الاتهام بالفصل في المصاريف إذا كان قرارها لا ينهي الدعوى التي نظرت فيها ، و في الحال العكسية وكذلك في حالة إخلاء سبيل المتهم، تصف المصاريف وتحكم بها على الطرف الخاسر في الدعوى. غير أنه يجوز إعفاء الضحية و/أو المدعي المدني حسن النية من المصاريف كلها أو جزء منها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_296_permission_0_a0d672a9> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_296_right_0_985294d8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_296> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_296_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_296_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_296_20250803_OpEnact_d83f2a5dac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_296_obligation_0_b12b3b42> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "296" ;
    dzdoc:position 295 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_296_condition_0_ea72ef99> ;
    dzdoc:usesTerm dzterm:indictment_chamber .

<https://legal.dz/resource/law/2025-08-03/25-14#art_310> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:definesTerm dzterm:specialized_judicial_poles ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_310" ;
    dzdoc:fullText "يجوز تمديد الاختصاص المحلي لوكيل الجمهورية و قاضي التحقيق والمحكمة إلى دائرة اختصاص محاكم أخرى، عن طريق التنظيم، في جرائم المخدرات والمؤثرات العقلية، وجرائم التهريب، وجرائم الاتجار بالبشر، وجرائم الاتجار بالأعضاء، وجرائم تهريب المهاجرين واختطاف الأشخاص، والمضاربة غير المشروعة ، وتدعى هذه الجهات القضائية في صلب النص \" الأقطاب القضائية المتخصصة \"."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_310_permission_0_99589590> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_310> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_310_defocc_e35d138edd8e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_310_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_310_20250803_OpEnact_209b6b57aa> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "310" ;
    dzdoc:position 309 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_310_condition_0_2be1f309> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_401> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_401" ;
    dzdoc:fullText "تعد سنويا في دائرة اختصاص كل مجلس قضائي قائمتان للمحلفين، تخص الأولى محكمة الجنايات الابتدائية ، والثانية محكمة الجنايات الاستئنافية ، توضعان خلال الفصل الأخير من كل سنة للسنة التي تليها من قبل لجنة يرأسها رئيس المجلس القضائي وتحدد تشكيلتها بقرار من وزير العدل وتجتمع بمقر المجلس القضائي . تتضمن كل قائمة أربعة وعشرين (24) محلفا من كل دائرة اختصاص المجلس القضائي. تستدعى اللجنة من قبل رئيسها خمسة عشر (15) يوما، على الأقل، قبل موعد اجتماعها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_401> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_401_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_401_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_401_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_401_20250803_OpEnact_1804ab1d54> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_401_obligation_0_7263516d>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_401_obligation_1_d726321a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "401" ;
    dzdoc:position 400 ;
    dzdoc:usesTerm dzterm:appeals_criminal_court,
        dzterm:judicial_council,
        dzterm:minister_of_justice,
        dzterm:primary_criminal_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_408> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_4> ;
    dzdoc:eId "art_408" ;
    dzdoc:fullText "للمتهم المحبوس أن يتصل بحرية، بمحاميه الذي يجوز له الإطلاع على جميع أوراق ملف الدعوى في مكان وجودها دون أن يترتب على ذلك تأخير في سير الإجراءات ، و يوضع هذا الملف تحت تصرف المحامي قبل الجلسة بخمسة (5) أيام، على الأقل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_408_permission_0_d38d2221> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_408_right_0_af764dbd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_408> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_408_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_408_20250803_OpEnact_80e97c6f3b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_408_obligation_0_b2d45140> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "408" ;
    dzdoc:position 407 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_455> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_8> ;
    dzdoc:eId "art_455" ;
    dzdoc:fullText "لا يجوز الطعن في الحكم الغيابي بأي طريق من طرق الطعن إلا من طرف المحكوم عليه شخصيا في حالة صدور أمر بالقبض ضده. ويجوز للنيابة العامة أن تطعن بالاستئناف أو بالنقض في الحكم بالبراءة ، غير أنه في حالة الحكم بالإدانة فإنه لا يجوز لها ذلك إلا بعد انتهاء أجل المعارضة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_455_permission_0_ccace030>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_455_permission_1_d50e70b7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_455> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_455_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_455_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_455_20250803_OpEnact_b277f0f513> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_455_prohibition_0_ccace030>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_455_prohibition_1_d50e70b7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "455" ;
    dzdoc:position 454 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_462> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_2_sec_9> ;
    dzdoc:eId "art_462" ;
    dzdoc:fullText "يجوز للمتهم ، إذا كان مستأنفا وحده دون النيابة العامة، التنازل عن استئنافه فيما يتعلق بالدعوى العمومية ، ويكون ذلك قبل بداية تشكيل المحكمة . كما يجوز له و للطرف المدني فيما يتعلق بالدعوى المدنية، التنازل في أية مرحلة عن استئنافهما . ويتم إثبات التنازل بأمر من رئيس محكمة الجنايات الاستئنافية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_462_permission_0_5656a1b7>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_462_permission_1_8deac9d7> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_462_right_0_b7fa3c4f>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_462_right_1_3dda7709> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_462> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_462_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_462_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_462_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_462_20250803_OpEnact_e6253f6173> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "462" ;
    dzdoc:position 461 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_462_condition_0_6b943d48> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_476> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_476" ;
    dzdoc:fullText "يمكن المدعي المدني أن يكلف المتهم مباشرة بالحضور أمام المحكمة في الحالات الآتية : ترك الأسرة، عدم تسليم الطفل، انتهاك حرمة المنزل القذف إصدار صك بدون رصيد، السب العلني، التهديد، عدم دفع النفقة المساس بحرمة الحياة الخاصة للأشخاص، الوشاية الكاذبة، خيانة الأمانة. و في الحالات الأخرى، ينبغي الحصول على ترخيص من النيابة العامة للقيام بالتكليف المباشر بالحضور . ينبغي على المدعي المدني الذي يكلف متهما تكليفا مباشرا بالحضور أمام المحكمة أن يودع، مقدما، لدى أمين الضبط المبلغ الذي يقدره وكيل الجمهورية لتغطية المصاريف القضائية ، و أن ينوه في ورقة التكليف بالحضور عن هوية المشتكى منه وعنوانه وعن اختيار موطن له داخل الإقليم الوطني ، ويترتب البطلان على مخالفة شيء من ذلك."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_476_permission_0_86590917> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_476_right_0_f4589839> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_476> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_476_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_476_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_476_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_476_20250803_OpEnact_7bd5685882> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_476_obligation_0_6786e5d6>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_476_obligation_1_8620ff6b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "476" ;
    dzdoc:position 475 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_476_condition_0_22710492> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_486> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_486" ;
    dzdoc:fullText "إذا لم يقدم مرتكب الجنحة المتلبس بها ضمانات كافية للحضور أمام القضاء ، وكانت الجنحة معاقبا عليها بعقوبة الحبس حدها الأدنى يساوي أو يفوق ستة (6) أشهر ولم يكن قاضي التحقيق قد أخطر بها يصدر وكيل الجمهورية ، استثناء، أمرا بإيداع المتهم الحبس بعد استجوابه عن هويته وعن الأفعال والتهم المنسوبة إليه، ثم يحيله فورا على المحكمة ، على أن تحدد جلسة النظر في القضية في أجل أقصاه خمسة (5) أيام، ابتداء من يوم صدور الأمر بالإيداع . تطبق مقتضيات المادتين 475 و 477 أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_486> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_486_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_486_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_486_20250803_OpEnact_c93c5b0b58> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_486_obligation_0_b708811f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "486" ;
    dzdoc:position 485 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_475>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_477> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_475>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_477> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_486_condition_0_e0e16ae8>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_486_condition_1_9686edfa> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_506> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_6> ;
    dzdoc:eId "art_506" ;
    dzdoc:fullText "إذا تبين أنه من اللازم إجراء تحقيق تكميلي ، يجب أن يكون ذلك بحكم ، ويقوم بهذا الإجراء القاضي نفسه والذي يتمتع لهذا الغرض بالسلطات المنصوص عليها في المواد من 234 الى 238 من هذا القانون. ويخضع هذا التحقيق التكميلي للقواعد المقررة في المواد من 180 إلى 183 من هذا القانون. لوكيل الجمهورية أن يطلع بطريق المطالبة ، عند الاقتضاء، على الملف في أي وقت أثناء إجراء التحقيق التكميلي ، على أن يعيد الأوراق في ظرف أربع وعشرين (24) ساعة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_506_right_0_8088f6d2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_506> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_506_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_506_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_506_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_506_20250803_OpEnact_1e29913a4f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_506_obligation_0_891334b6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "506" ;
    dzdoc:position 505 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_180>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_183>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_234>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_238> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_180>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_183>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_234>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_238> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_506_condition_0_741d16c3> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_507> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_6> ;
    dzdoc:eId "art_507" ;
    dzdoc:fullText "إذا رأت المحكمة أن الواقعة تكون جنحة وثبتت الإدانة ، قضت بالعقوبة. وتحكم، عند الاقتضاء، في الدعوى المدنية ولها أن تأمر بحكم قابل للتنفيذ رغم المعارضة أو الاستئناف، بأن يدفع مؤقتا كل أو جزء من التعويضات المدنية المقدرة. كما أن لها السلطة ، إن لم يكن ممكنا إصدار حكم في طلب التعويض المدني بحالته ، أن تقرر للمدعي المدني مبلغا مؤقتا قابلا للتنفيذ رغم المعارضة أو الاستئناف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_507> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_507_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_507_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_507_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_507_20250803_OpEnact_cc08780e9f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "507" ;
    dzdoc:position 506 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_507_condition_0_85da45f3> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_517> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_6> ;
    dzdoc:eId "art_517" ;
    dzdoc:fullText "ينص في كل حكم يصدر بالإدانة ضد المتهم، وعند الاقتضاء، ضد المسؤول عن الحقوق المدنية على إلزامهما بالرسوم والمصاريف القضائية لصالح الدولة ، كما ينص فيه ، بالنسبة للمتهم على مدة الإكراه البدني، مع مراعاة أحكام المادة 765 من هذا القانون. كذلك الشأن في حالة الإعفاء من العقوبة ما لم تقض المحكمة بقرار خاص مسبب بإعفاء المتهم والمسؤول عن الحقوق المدنية من المصاريف القضائية كلها أو بعضها. ولا يلزم المدعي المدني الذي قبل ادعاؤه بالمصاريف القضائية ما دام الشخص المدعى ضده مدنيا قد اعتبر مدانا في جريمة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_517> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_517_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_517_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_517_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_517_20250803_OpEnact_ba5d1a7a96> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_517_obligation_0_9ef3f9a6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "517" ;
    dzdoc:position 516 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_765> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_765> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_523> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_6> ;
    dzdoc:eId "art_523" ;
    dzdoc:fullText "يجوز أيضا لكل شخص، غير المتهم والضحية والمدعي المدني والمسؤول المدني، يدعي بأن له حقا على أشياء موضوعة تحت تصرف القضاء أن يطلب بردها من المحكمة المنظورة أمامها الدعوى . ولا يجوز له الاطلاع إذ ذاك على غير المحاضر المتعلقة بضبط تلك الأشياء. وتقضي المحكمة في ذلك بحكم، على حدة ، بعد سماع أطراف الدعوى."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_523_permission_0_24728289>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_523_permission_1_ea4acd13> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_523_right_0_3f01ab39> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_523> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_523_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_523_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_523_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_523_20250803_OpEnact_00c926cf63> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "523" ;
    dzdoc:position 522 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_543> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_8> ;
    dzdoc:eId "art_543" ;
    dzdoc:fullText "إذا رفض المتهم اقتراح وكيل الجمهورية أو لم يبد موافقته عليه خلال الأجل الممنوح له ، يتخذ وكيل الجمهورية الإجراء الذي يراه مناسبا بشأنه، فإذا كان المتهم محبوسا وجب ضمان مثوله أمام جهة الحكم أو قاضي التحقيق بعد ذلك، قبل زوال أثر الأمر بالحبس المؤقت المذكور في المادة 542 أعلاه . وإذا أحيل الملف أمام المحكمة وقررت تأجيل القضية ، بقي الأمر بالحبس المذكور في المادة 542 منتجا لأثره إلى غاية الفصل في القضية ما لم تقرر المحكمة الإفراج عنه. أما إذا أخطر قاضي التحقيق ، وجب عليه الفصل في بقاء المتهم محبوسا أو الإفراج عنه، و/أو إخضاعه لالتزامات الرقابة القضائية . لا يمكن، في أي حال من الأحوال ، أن يفصل في القضية القاضي الذي أمر بالحبس المؤقت بموجب المادة 542 ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_543_permission_0_015071f5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_543> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_543_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_543_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_543_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_543_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_543_20250803_OpEnact_8b294c1239> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_543_obligation_0_3d3b2bac>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_543_obligation_1_5bbd51a1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_543_obligation_2_42f22801> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "543" ;
    dzdoc:position 542 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_542> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_542> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_543_condition_0_4becd1ce>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_543_condition_1_d94adc06>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_543_condition_2_809cbe2f> ;
    dzdoc:usesTerm dzterm:accused,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_546> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_1_subsec_8> ;
    dzdoc:eId "art_546" ;
    dzdoc:fullText "إذا تم استئناف الحكم القاضي بالمصادقة على المحضر أو الحكم برفض المصادقة عليه، وكان المتهم موقوفا ، وجب على المجلس القضائي الفصل في القضية في أجل أقصاه شهران (2) من يوم الاستئناف . إذا قضى المجلس بإلغاء الحكم القاضي بالمصادقة على المحضر أو بتأييد حكم رفض المصادقة عليه ، وجب عليه أن يفصل في بقاء المتهم محبوسا أو الإفراج عنه، ويحيل الملف وجوبا على النيابة العامة لاتخاذ ما تراه مناسبا في أجل أقصاه عشرون (20) يوما و إلا أخلي سبيل المتهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_546> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_546_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_546_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_546_20250803_OpEnact_3a15ecc63c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_546_obligation_0_f64f0bb0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_546_obligation_1_b87d6584> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "546" ;
    dzdoc:position 545 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_546_condition_0_c57b78bf>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_546_condition_1_1b8e3383> ;
    dzdoc:usesTerm dzterm:accused .

<https://legal.dz/resource/law/2025-08-03/25-14#art_555> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_555" ;
    dzdoc:fullText "يبلغ المحصل النيابة لدى المحكمة بدفع غرامة الصلح إذا تم صحيحا وذلك في ظرف عشرة (10) أيام من تاريخ الدفع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_555> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_555_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_555_20250803_OpEnact_4a329ce256> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_555_obligation_0_5c73a2f0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 555" ;
    dzdoc:position 554 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_619> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_3_chp_4> ;
    dzdoc:eId "art_619" ;
    dzdoc:fullText "يمكن للنيابة العامة أن ترسل التكليف بالحضور بالطريق الإلكتروني متى كان المعني قد أبدى قبوله بذلك . يجب أن تضمن الوسائل التقنية المستعملة : التعرف الموثوق على أطراف التراسل الإلكتروني، سلامة الوثائق المرسلة، أمن وسرية التراسل، الإشعار بالاستلام الإلكتروني الوارد من المرسل إليه المتضمن تاريخ وساعة الاستلام، حفظ المعطيات بما يسمح بتحديد تاريخ الإرسال والاستلام من طرف المرسل إليه بصفة أكيدة. وتتمتع الوثيقة المرسلة بالطريق الإلكتروني، المعدة وفقا للشروط المنصوص عليها في الفقرة السابقة ، بحجية الوثيقة المبلغة في الشكل الورقي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_619_permission_0_2d5e352f>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_619_permission_1_d33e1f72> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_619> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_619_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_619_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_619_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_619_20250803_OpEnact_f6c1c61349> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_619_obligation_0_c1357cc8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 619" ;
    dzdoc:position 617 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_619_condition_0_1309d4b7>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_619_condition_1_b99dffa6> ;
    dzdoc:usesTerm dzterm:prosecution .

<https://legal.dz/resource/law/2025-08-03/25-14#art_673> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_4> ;
    dzdoc:eId "art_673" ;
    dzdoc:fullText "يجوز للمستشار المقرر أن يمنح الخصوم ما يلزم من آجال لتمكينهم من استيفاء أسانيدهم . وعليه أن يستبعد من القضية كل مذكرة تودع بعد إيداع مذكرة الرد أو تقدم بعد آخر أجل ممنوح ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_673_permission_0_362dc2fe> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_673_right_0_c8a809b6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_673> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_673_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_673_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_673_20250803_OpEnact_5c972bcf3c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_673_obligation_0_27a02ebe> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "673" ;
    dzdoc:position 671 .

<https://legal.dz/resource/law/2025-08-03/25-14#art_674> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_4> ;
    dzdoc:eId "art_674" ;
    dzdoc:fullText "إذا رأى المستشار المقرر أن القضية مهيأة للفصل فيها ، أودع تقريره وأصدر أمرا بإطلاع النيابة العامة عليه. و على النيابة العامة أن تودع مذكرتها الكتابية في ظرف ثلاثين (30) يوما من استلام ذلك الأمر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_674> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_674_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_674_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_674_20250803_OpEnact_bcabe3c096> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_674_obligation_0_0d8d672e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "674" ;
    dzdoc:position 672 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_674_condition_0_c42db9c3> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_682> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_6_chp_1_sec_5> ;
    dzdoc:eId "art_682" ;
    dzdoc:fullText "يجب على الجهة القضائية التي تحال إليها القضية بعد النقض أن تخضع لقرار الإحالة فيما يتعلق بالنقطة القانونية التي قطعت فيها المحكمة العليا . وإن لم يدع قرار المحكمة العليا من النزاع شيئا يفصل فيه ، نقض الحكم المطعون فيه دون إحالة. ويحكم على الخصم الذي خسر طعنه بالمصاريف القضائية، فيما عدا النيابة العامة. ويجوز تقدير المصاريف القضائية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_682_right_0_aa54b4f6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_682> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_682_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_682_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_682_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_682_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_682_20250803_OpEnact_b71f1aba02> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_682_obligation_0_4bf990c6>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_682_obligation_1_19cdb26f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "682" ;
    dzdoc:position 680 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_682_condition_0_93dffa3a> ;
    dzdoc:usesTerm dzterm:supreme_court .

<https://legal.dz/resource/law/2025-08-03/25-14#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "تناط بقاضي التحقيق إجراءات البحث والتحري و لا يجوز له أن يشترك في الحكم في قضايا نظرها بصفته قاضيا للتحقيق وإلا كان ذلك الحكم باطلا . وله في سبيل مباشرة مهام وظيفته أن يستعين مباشرة بالقوة العمومية . ويختص بالتحقيق بناء على طلب من وكيل الجمهورية أو على شكوى مصحوبة بادعاء مدني ضمن الشروط المنصوص عليها في المادتين 140 و 147 أدناه . في حالة الجناية أو الجنحة المتلبس بها ، يباشر قاضي التحقيق السلطات المخولة له بمقتضى المادة 91 وما يليها من هذا القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_69_permission_0_16fd2863> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_69_right_0_1526fa12> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_69_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_69_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_69_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_69_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_69_20250803_OpEnact_1c2b025c0c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_69_obligation_0_fa7f3bfa>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_69_obligation_1_c967d0af> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "المادة 69" ;
    dzdoc:position 68 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_140>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_147>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_91> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_140>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_147>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_91> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_69_condition_0_f9fb13cf>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_69_condition_1_f9c043c5> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_716> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_7_chp_5> ;
    dzdoc:eId "art_716" ;
    dzdoc:fullText "إذا كان المحكوم عليه بعقوبة سالبة للحرية، محبوسا سواء أكان نهائيا أم لا ، فإنه يكون لوكيل الجمهورية أو لقاضي التحقيق أو للمحاكم أو للمجالس بدائرة محل الحبس الاختصاص بنظر جميع الجرائم المنسوبة إليه فيما خرج عن القواعد المنصوص عليها في المواد 58 و 70 و 468 (الفقرة الأولى) من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_716> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_716_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_716_20250803_OpEnact_3b61118282> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "716" ;
    dzdoc:position 714 ;
    dzdoc:references <https://legal.dz/resource/law/2025-08-03/25-14#art_468>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_58>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_70> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2025-08-03/25-14#art_468>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_58>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_70> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_716_condition_0_6484795b> ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:prosecutor_republic .

<https://legal.dz/resource/law/2025-08-03/25-14#art_773> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_3> ;
    dzdoc:eId "art_773" ;
    dzdoc:fullText "يمكن المحكوم عليه بـ الإكراه البدني الذي يتعذر عليه تسديد المبلغ المدان به كاملا، أن يوقف أثاره بدفع مبلغ لا يقل عن نصف المبلغ المدان به ، مع الالتزام بأداء باقي المبلغ كليا أو على أقساط، في الآجال التي يحددها وكيل الجمهورية وبعد موافقة طالب الإكراه البدني . ويفرج وكيل الجمهورية على المحكوم عليه بـ الإكراه البدني المحبوس بعد التحقق من توفر الشروط المنصوص عليها في هذه المادة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_773_permission_0_5838a262> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_773_right_0_6ffc13d7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_773> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_773_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_773_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_773_20250803_OpEnact_1a9f9895d5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_773_obligation_0_176fb71f>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_773_obligation_1_22154728> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "773" ;
    dzdoc:position 771 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_773_condition_0_fd67b6b3> ;
    dzdoc:usesTerm dzterm:bodily_coercion,
        dzterm:convicted,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2025-08-03/25-14#art_836> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:definesTerm dzterm:rehabilitation ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_8_chp_6_sec_1> ;
    dzdoc:eId "art_836" ;
    dzdoc:fullText "يرد الاعتبار بقوة القانون للشخص الطبيعي المحكوم عليه من أجل جنحة أو مخالفة الذي لم يصدر ضده، خلال المهل الآتي بيانها ، حكم أو قرار جديد بعقوبة الحبس أو بعقوبة أخرى أكثر منها جسامة لارتكاب جناية أو جنحة : 1- فيما يخص عقوبة الغرامة بعد مهلة ثلاث (3) سنوات اعتبارا من يوم سداد الغرامة أو تنفيذ الإكراه البدني أو مضي آجال التقادم، 2- فيما يخص عقوبة العمل للنفع العام بعد مهلة أربع (4) سنوات من قضاء العقوبة 3- فيما يخص الحكم مرة واحدة بعقوبة الحبس الذي لا تتجاوز مدته سنة واحدة (1) أو بعقوبات متعددة بالحبس لا يتجاوز مجموعها سنة واحدة (1) بعد مضي مهلة ست (6) سنوات، اعتبارا إما من انتهاء العقوبة أو من مضي أجل التقادم، 4- فيما يخص الحكم مرة واحدة بعقوبة الحبس الذي لا تتجاوز مدته سنتين (2) أو بعقوبات متعددة بالحبس لا يتجاوز مجموعها سنتين (2) بعد مضي مهلة ثماني (8) سنوات، اعتبارا إما من انتهاء العقوبة أو من مضي أجل التقادم، 5- فيما يخص العقوبة الوحيدة بالحبس لمدة لا تتجاوز خمس (5) سنوات أو بعقوبات متعددة بالحبس لا يتجاوز مجموعها ثلاث (3) سنوات، بعد مضي مهلة اثنتي عشرة (12) سنة، اعتبارا إما من انتهاء العقوبة أو من أجل التقادم، 6- فيما يخص العقوبة الوحيدة بالحبس لمدة تتجاوز خمس (5) سنوات أو بعقوبات متعددة بالحبس لا يتجاوز مجموعها خمس (5) سنوات بعد مضي مهلة خمس عشرة (15) سنة، اعتبارا إما من انتهاء العقوبة أو من مضي أجل التقادم. إذا اشتملت العقوبة الواحدة على عقوبة حبس نافذة وأخرى بالحبس غير النافذ ، تحسب آجال العقوبة النافذة. وتعتبر العقوبات التي صدر حكم بدمجها بمثابة عقوبة واحدة في مجال تطبيق الأحكام السابقة. يقوم الإعفاء الكلي أو الجزئي من العقوبة بطريق العفو مقام تنفيذها الكلي أو الجزئي."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2025-08-03/25-14#art_836_right_0_6abb8308> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_836> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2025-08-03/25-14#art_836_defocc_f69a006258f3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_836_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_836_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_836_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_836_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_836_20250803_OpEnact_b3f44fdbd2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "836" ;
    dzdoc:position 834 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_836_condition_0_c400f376>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_836_condition_1_aa8ca142> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_858> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_9_chp_1_sec_1> ;
    dzdoc:eId "art_858" ;
    dzdoc:fullText "يجوز للحكومة الجزائرية أن تسلم شخصا غير جزائري إلى حكومة أجنبية بناء على طلبها إذا وجد في أراضي الجمهورية وكانت قد اتخذت في شأنه إجراءات متابعة باسم الدولة الطالبة أو صدر حكم ضده عن جهاتها القضائية . ومع ذلك لا يجوز التسليم إلا إذا كانت الجريمة موضوع الطلب قد ارتكبت : إما في أراضي الدولة الطالبة من أحد رعاياها أو من شخص أجنبي، وإما خارج أراضيها من أحد رعايا هذه الدولة، وإما خارج أراضيها من أحد الأجانب عن هذه الدولة إذا كانت الجريمة من عداد الجرائم التي يجيز القانون الجزائري المتابعة فيها في الجزائر حتى ولو ارتكبت من شخص أجنبي في الخارج."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2025-08-03/25-14#art_858_permission_0_88ff0d4d>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_858_permission_1_2e3fabd5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_858> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_858_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_858_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_858_20250803_OpEnact_a450dee976> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_858_obligation_0_96721333> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2025-08-03/25-14#art_858_prohibition_0_2e3fabd5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "858" ;
    dzdoc:position 856 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_858_condition_0_46127f96> .

<https://legal.dz/resource/law/2025-08-03/25-14#art_95> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2025-08-03/25-14#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_95" ;
    dzdoc:fullText "إذا عثر على جثة شخص وكان سبب الوفاة مجهولا أو مشتبها فيه، سواء كانت الوفاة نتيجة عنف أو بغير عنف ، فعلى ضابط الشرطة القضائية الذي أبلغ بالحادث أن يخطر وكيل الجمهورية على الفور وينتقل بغير تمهل إلى مكان الحادث للقيام بعمل المعاينات الأولية . وينتقل وكيل الجمهورية إلى المكان إذا رأى لذلك ضرورة. ويصطحب معه أشخاصا قادرين على تقدير ظروف الوفاة. كما يمكنه أن يندب لإجراء ذلك من يرى ندبه من ضباط الشرطة القضائية. ويحلف الأشخاص الذين يرافقون وكيل الجمهورية اليمين كتابة على أن يبدوا رأيهم بما يمليه عليهم الشرف والضمير . ويجوز أيضا لوكيل الجمهورية أن يطلب إجراء التحقيق للبحث عن سبب الوفاة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2025-08-03/25-14#version_art_95> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2025-08-03/25-14#art_95_para_0>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_95_para_1>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_95_para_2>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_95_para_3>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_95_para_4>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_95_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_95_20250803_OpEnact_9b07613546> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2025-08-03/25-14#art_95_obligation_0_24d72193>,
        <https://legal.dz/resource/law/2025-08-03/25-14#art_95_obligation_1_60be8c71> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:introducedOn "2025-08-03"^^xsd:date ;
    dzdoc:number "95" ;
    dzdoc:position 94 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2025-08-03/25-14#art_95_condition_0_5f7e33ca> ;
    dzdoc:usesTerm dzterm:judicial_police_officer .

