<https://legal.dz/resource/law/2025-08-03/25-14#version_art_406> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرسل النائب العام إلى أمانة ضبط محكمة الجنايات الابتدائية ملف الدعوى و أدلة الإقناع فور صدور قرار الإحالة . و في حالة الاستئناف ، يرسل ملف الدعوى وأدلة الإقناع إلى محكمة الجنايات الاستئنافية . ينقل المتهم المحبوس إلى المؤسسة العقابية الكائنة بدائرة اختصاص المحكمة ويقدم للمحاكمة في أقرب دورة جنائية . يحاكم غيابيا المتهم الذي هو في حالة فرار ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_406_20250803_OpEnact_a0325a0e0f> ;
    dzdoc:replacementText "يرسل النائب العام إلى أمانة ضبط محكمة الجنايات الابتدائية ملف الدعوى و أدلة الإقناع فور صدور قرار الإحالة . و في حالة الاستئناف ، يرسل ملف الدعوى وأدلة الإقناع إلى محكمة الجنايات الاستئنافية . ينقل المتهم المحبوس إلى المؤسسة العقابية الكائنة بدائرة اختصاص المحكمة ويقدم للمحاكمة في أقرب دورة جنائية . يحاكم غيابيا المتهم الذي هو في حالة فرار ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2025-08-03/25-14#art_406> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2025-08-03/25-14> ;
