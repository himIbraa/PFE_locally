<https://legal.dz/resource/law/2025-08-03/25-14#version_art_132> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2025-08-03/25-14> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتمثل تدابير الحماية الإجرائية للشخص المستفيد منها فيما يأتي: عدم الإشارة لهويته أو ذكر هوية مستعارة في أوراق الإجراءات، عدم الإشارة لعنوانه الحقيقي في أوراق الإجراءات، الإشارة، بدلا من عنوانه الحقيقي، إلى مقر الشرطة القضائية المختصة أين تم سماعه أو إلى الجهة القضائية التي سيؤول إليها النظر في القضية. تحفظ الهوية والعنوان الحقيقيان للأشخاص المذكورين في هذا الفصل المستفيدين من تدابير الحماية الإجرائية في ملف خاص يمسكه وكيل الجمهورية . يتلقى المعني التكاليف بالحضور عن طريق النيابة العامة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2025-08-03/25-14#version_art_132_20250803_OpEnact_d29de8fe50> ;
    dzdoc:replacementText "تتمثل تدابير الحماية الإجرائية للشخص المستفيد منها فيما يأتي: عدم الإشارة لهويته أو ذكر هوية مستعارة في أوراق الإجراءات، عدم الإشارة لعنوانه الحقيقي في أوراق الإجراءات، الإشارة، بدلا من عنوانه الحقيقي، إلى مقر الشرطة القضائية المختصة أين تم سماعه أو إلى الجهة القضائية التي سيؤول إليها النظر في القضية. تحفظ الهوية والعنوان الحقيقيان للأشخاص المذكورين في هذا الفصل المستفيدين من تدابير الحماية الإجرائية في ملف خاص يمسكه وكيل الجمهورية . يتلقى المعني التكاليف بالحضور عن طريق النيابة العامة."@ar ;
