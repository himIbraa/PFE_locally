    dznorm:position 0 ;
    dznorm:provisionText "لا يمكن الإبقاء على التدابير التحفظية التي تأمر بها الهيئة المتخصصة بعد انقضاء مدة 72 ساعة إلا بقرار قضائي."@ar ;
    dznorm:sourceArticle "art_18" .

<https://legal.dz/resource/law/2005-02-06/05-01#art_18_obligation_0_fd0dc301_action_8ae33dcbaf> a dznorm:Action ;
