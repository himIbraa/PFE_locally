<https://legal.dz/resource/law/2005-02-06/05-01#version_art_15_bis_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتعاون الهيئة المتخصصة والسلطات المختصة وتنسقان أعمالهما لإعداد وتنفيذ استراتيجيات وأعمال الوقاية من تبييض الأموال و تمويل الإرهاب ومكافحتهما. تحدد كيفيات تطبيق هذه المادة عند الاقتضاء، عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_15_bis_1_20050206_OpEnact_02d7b55c3b> ;
    dzdoc:replacementText "تتعاون الهيئة المتخصصة والسلطات المختصة وتنسقان أعمالهما لإعداد وتنفيذ استراتيجيات وأعمال الوقاية من تبييض الأموال و تمويل الإرهاب ومكافحتهما. تحدد كيفيات تطبيق هذه المادة عند الاقتضاء، عن طريق التنظيم."@ar ;
