    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2005-02-06/05-01#version_art_18> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن الإبقاء على التدابير التحفظية التي تأمر بها الهيئة المتخصصة بعد انقضاء مدة 72 ساعة إلا بقرار قضائي. يمكن رئيس محكمة الجزائر، بناء على طلب الهيئة المتخصصة وبعد استطلاع رأي وكيل الجمهورية لدى محكمة الجزائر، أن يمدد الأجل المحدد في الفقرة أعلاه، أو يأمر بالحراسة القضائية المؤقتة على الأموال والحسابات والسندات موضوع الإخطار. يمكن وكيل الجمهورية لدى محكمة الجزائر تقديم عريضة لنفس الغرض. ينفذ الأمر الذي يستجيب لهذا الطلب، بناء على النسخة الأصلية، قبل تبليغ الطرف المعني بالعملية. إذا لم يتضمن ا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_18_20050206_OpEnact_04adc633b0> ;
    dzdoc:replacementText "لا يمكن الإبقاء على التدابير التحفظية التي تأمر بها الهيئة المتخصصة بعد انقضاء مدة 72 ساعة إلا بقرار قضائي. يمكن رئيس محكمة الجزائر، بناء على طلب الهيئة المتخصصة وبعد استطلاع رأي وكيل الجمهورية لدى محكمة الجزائر، أن يمدد الأجل المحدد في الفقرة أعلاه، أو يأمر بالحراسة القضائية المؤقتة على الأموال والحسابات والسندات موضوع الإخطار. يمكن وكيل الجمهورية لدى محكمة الجزائر تقديم عريضة لنفس الغرض. ينفذ الأمر الذي يستجيب لهذا الطلب، بناء على النسخة الأصلية، قبل تبليغ الطرف المعني بالعملية. إذا لم يتضمن الإشعار باستلام وصل الإخطار بالشبهة التدابير التحفظية المنصوص عليها أعلاه، أو لم يبلغ أي قرار صادر عن رئيس محكمة الجزائر أو قاضي التحقيق الجاري أمامه التحقيق عن الاقتضاء، للأشخاص والهيئات المذكورة في المادتين 19 و 21 من هذا القانون في أجل أقصاه 72 ساعة ، فإنه يمكنهم تنفيذ العملية موضوع الإخطار."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_18> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_18> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-02-06"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2005-02-06/05-01#version_art_18_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن رئيس محكمة الجزائر أن يأمر بتجميد و/أو حجز كل أو جزء من الأموال التي تكون ملكا لإرهابيين أو منظمات إرهابية أو الموجهة لهم وعائداتها لمدة شهر قابل للتجديد ، بناء على طلب الهيئة المتخصصة أو وكيل الجمهورية لدى محكمة الجزائر أو الهيئات الدولية المؤهلة. يكون هذا الأمر قابلا للاعتراض أمام نفس الجهة التي أصدرته، في أجل يومين (2) من تاريخ تبليغه . ينفذ هذا الأمر وفقا لأحكام الفقرة 4 من المادة 18 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_18_bis_20050206_OpEnact_599f4d6d9c> ;
    dzdoc:replacementText "يمكن رئيس محكمة الجزائر أن يأمر بتجميد و/أو حجز كل أو جزء من الأموال التي تكون ملكا لإرهابيين أو منظمات إرهابية أو الموجهة لهم وعائداتها لمدة شهر قابل للتجديد ، بناء على طلب الهيئة المتخصصة أو وكيل الجمهورية لدى محكمة الجزائر أو الهيئات الدولية المؤهلة. يكون هذا الأمر قابلا للاعتراض أمام نفس الجهة التي أصدرته، في أجل يومين (2) من تاريخ تبليغه . ينفذ هذا الأمر وفقا لأحكام الفقرة 4 من المادة 18 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_18_bis> ;
