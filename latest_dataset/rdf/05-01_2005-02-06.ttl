<https://legal.dz/resource/law/2005-02-06/05-01#version_art_33__معدلة> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب مسيرو وأعوان المؤسسات المالية و الخاضعون الذين أبلغوا عمدا صاحب الأموال أو العمليات موضوع الإخطار بالشبهة ، بوجود هذا الإخطار أو أطلعوه على المعلومات حول النتائج التي تخصه، بغرامة من 2.000.000 دج إلى 20.000.000 دج دون الإخلال بعقوبات أشد وبأية عقوبة تأديبية أخرى ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_33_20050206_OpEnact_fc0c6eb68c> ;
    dzdoc:replacementText "يعاقب مسيرو وأعوان المؤسسات المالية و الخاضعون الذين أبلغوا عمدا صاحب الأموال أو العمليات موضوع الإخطار بالشبهة ، بوجود هذا الإخطار أو أطلعوه على المعلومات حول النتائج التي تخصه، بغرامة من 2.000.000 دج إلى 20.000.000 دج دون الإخلال بعقوبات أشد وبأية عقوبة تأديبية أخرى ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_33__معدلة> ;
