<https://legal.dz/resource/law/2005-02-06/05-01#art_21_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_21> ;
    dzdoc:position 1 ;
    dzdoc:text "تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar .

