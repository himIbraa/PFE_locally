<https://legal.dz/resource/law/2005-02-06/05-01#version_art_25> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن الهيئة المتخصصة أن تطلع هيئات الدول الأخرى التي تمارس مهام مماثلة، على المعلومات التي تتوفر لديها حول العمليات التي يبدو أنها تهدف إلى تبييض الأموال أو تمويل الإرهاب ، مع مراعاة المعاملة بالمثل وعدم استعمال هذه المعلومات لأغراض غير تلك المنصوص عليها في هذا القانون . كما يمكن الهيئة المتخصصة الحصول على معلومات من الخاضعين ومن السلطات المختصة بعد تلقي طلبات من هيئات الدول الأخرى التي تمارس مهام مماثلة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_25_20050206_OpEnact_20b601a9d9> ;
    dzdoc:replacementText "يمكن الهيئة المتخصصة أن تطلع هيئات الدول الأخرى التي تمارس مهام مماثلة، على المعلومات التي تتوفر لديها حول العمليات التي يبدو أنها تهدف إلى تبييض الأموال أو تمويل الإرهاب ، مع مراعاة المعاملة بالمثل وعدم استعمال هذه المعلومات لأغراض غير تلك المنصوص عليها في هذا القانون . كما يمكن الهيئة المتخصصة الحصول على معلومات من الخاضعين ومن السلطات المختصة بعد تلقي طلبات من هيئات الدول الأخرى التي تمارس مهام مماثلة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_25> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-01> ;
