<https://legal.dz/resource/law/2005-02-06/05-01#version_art_34> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب مسيرو وأعوان المؤسسات المالية والمؤسسات والمهن غير المالية الذين يخالفون عمدا وبصفة متكررة، تدابير الوقاية من تبييض الأموال و تمويل الإرهاب المنصوص عليها في المواد 7 و 8 و 9 و 10 و 10 مكرر و 10 مكرر 1 و 10 مكرر 2 و 14 من هذا القانون، بغرامة من 500.000 دج إلى 10.000.000 دج . ويعاقب الأشخاص المعنويون المنصوص عليهم في هذه المادة بغرامة من 10.000.000 دج إلى 50.000.000 دج، دون الإخلال بعقوبات أشد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_34_20050206_OpEnact_dd4d62e5f2> ;
    dzdoc:replacementText "يعاقب مسيرو وأعوان المؤسسات المالية والمؤسسات والمهن غير المالية الذين يخالفون عمدا وبصفة متكررة، تدابير الوقاية من تبييض الأموال و تمويل الإرهاب المنصوص عليها في المواد 7 و 8 و 9 و 10 و 10 مكرر و 10 مكرر 1 و 10 مكرر 2 و 14 من هذا القانون، بغرامة من 500.000 دج إلى 10.000.000 دج . ويعاقب الأشخاص المعنويون المنصوص عليهم في هذه المادة بغرامة من 10.000.000 دج إلى 50.000.000 دج، دون الإخلال بعقوبات أشد ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_34> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-01> ;
