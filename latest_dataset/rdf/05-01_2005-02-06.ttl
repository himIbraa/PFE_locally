<https://legal.dz/resource/law/2005-02-06/05-01#version_art_7> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على الخاضعين أن يتأكدوا من موضوع وطبيعة النشاط وهوية زبائنهم وعناوينهم، كل فيما يخصه، قبل فتح حساب أو دفتر، أو حفظ سندات أو قيم أو إيصالات، أو تأجير صندوق أو القيام بأي عملية أو ربط أي علاقة أعمال أخرى. يتم التأكد من هوية الشخص الطبيعي بتقديم وثيقة رسمية أصلية، سارية الصلاحية متضمنة للصورة، ومن عنوانه بتقديم وثيقة رسمية تثبت ذلك. ويتعين الاحتفاظ بنسخة من كل وثيقة. يتم التأكد من هوية الشخص المعنوي بتقديم قانونه الأساسي وأية وثيقة تثبت تسجيله أو اعتماده وبأن له وجودا فعليا أثناء إثبات شخصيته. "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_7_20050206_OpEnact_ea0f430647> ;
    dzdoc:replacementText "يجب على الخاضعين أن يتأكدوا من موضوع وطبيعة النشاط وهوية زبائنهم وعناوينهم، كل فيما يخصه، قبل فتح حساب أو دفتر، أو حفظ سندات أو قيم أو إيصالات، أو تأجير صندوق أو القيام بأي عملية أو ربط أي علاقة أعمال أخرى. يتم التأكد من هوية الشخص الطبيعي بتقديم وثيقة رسمية أصلية، سارية الصلاحية متضمنة للصورة، ومن عنوانه بتقديم وثيقة رسمية تثبت ذلك. ويتعين الاحتفاظ بنسخة من كل وثيقة. يتم التأكد من هوية الشخص المعنوي بتقديم قانونه الأساسي وأية وثيقة تثبت تسجيله أو اعتماده وبأن له وجودا فعليا أثناء إثبات شخصيته. ويتعين الاحتفاظ بنسخة من كل وثيقة. يجب تحيين المعلومات المذكورة في الفقرتين الثانية والثالثة سنويا وعند كل تغيير لها. يتعين على الوكلاء والمستخدمين الذين يعملون لحساب الغير أن يقدموا، فضلا عن الوثائق المذكورة أعلاه، التفويض بالسلطات المخولة لهم بالإضافة إلى الوثائق التي تثبت شخصية وعنوان أصحاب الأموال الحقيقيين."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_7> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_7> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-02-06"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

