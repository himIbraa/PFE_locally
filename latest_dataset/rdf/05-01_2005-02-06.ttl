<https://legal.dz/resource/law/2005-02-06/05-01#version_art_15> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتولى الهيئة المتخصصة تحليل واستغلال المعلومات التي ترد إليها من السلطات المختصة والخاضعين قصد تحديد مصدر الأموال ووجهتها. كما يمكنها أن تطلب من السلطات المختصة أو من الخاضعين، في إطار كل إخطار بالشبهة أو تقرير سري تستلمه، أي معلومات إضافية تراها ضرورية لممارسة مهامها. تكتسي المعلومات المبلغة إلى الهيئة المتخصصة طابعا سريا ، و لا يجوز استعمالها لأغراض غير تلك المنصوص عليها في هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_15_20050206_OpEnact_8d3fe309bc> ;
    dzdoc:replacementText "تتولى الهيئة المتخصصة تحليل واستغلال المعلومات التي ترد إليها من السلطات المختصة والخاضعين قصد تحديد مصدر الأموال ووجهتها. كما يمكنها أن تطلب من السلطات المختصة أو من الخاضعين، في إطار كل إخطار بالشبهة أو تقرير سري تستلمه، أي معلومات إضافية تراها ضرورية لممارسة مهامها. تكتسي المعلومات المبلغة إلى الهيئة المتخصصة طابعا سريا ، و لا يجوز استعمالها لأغراض غير تلك المنصوص عليها في هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_15> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-01> ;
