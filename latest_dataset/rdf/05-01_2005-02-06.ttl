<https://legal.dz/resource/law/2005-02-06/05-01#version_art_6> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يتم كل دفع يفوق مبلغا يتم تحديده عن طريق التنظيم، بواسطة وسائل الدفع وعن طريق القنوات البنكية والمالية. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_6_20050206_OpEnact_6a3894f52c> ;
    dzdoc:replacementText "يجب أن يتم كل دفع يفوق مبلغا يتم تحديده عن طريق التنظيم، بواسطة وسائل الدفع وعن طريق القنوات البنكية والمالية. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
