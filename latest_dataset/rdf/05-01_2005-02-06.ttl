<https://legal.dz/resource/law/2005-02-06/05-01#version_art_32> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب كل خاضع يمتنع عمدا وبسابق معرفة، عن تحرير و/أو إرسال الإخطار بالشبهة المنصوص عليه في هذا القانون، بغرامة من 1.000.000 دج إلى 10.000.000 دج دون الإخلال بعقوبات أشد وبأية عقوبة تأديبية أخرى ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_32_20050206_OpEnact_016a1774a4> ;
    dzdoc:replacementText "يعاقب كل خاضع يمتنع عمدا وبسابق معرفة، عن تحرير و/أو إرسال الإخطار بالشبهة المنصوص عليه في هذا القانون، بغرامة من 1.000.000 دج إلى 10.000.000 دج دون الإخلال بعقوبات أشد وبأية عقوبة تأديبية أخرى ."@ar ;
