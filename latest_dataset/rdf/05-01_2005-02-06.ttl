<https://legal.dz/resource/law/2005-02-06/05-01#version_art_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "فضلا عن الأحكام الواردة في قانون العقوبات ، يهدف هذا القانون إلى الوقاية من تبييض الأموال و تمويل الإرهاب ومكافحتهما."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_1_20050206_OpEnact_556ae8802b> ;
    dzdoc:replacementText "فضلا عن الأحكام الواردة في قانون العقوبات ، يهدف هذا القانون إلى الوقاية من تبييض الأموال و تمويل الإرهاب ومكافحتهما."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_1> ;
