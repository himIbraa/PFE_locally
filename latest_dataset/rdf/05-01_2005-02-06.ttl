<https://legal.dz/resource/law/2005-02-06/05-01#version_art_36> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 27 ذي الحجة عام 1425 الموافق 6 فبراير سنة 2005. عبد العزيز بوتفليقة"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_36_20050206_OpEnact_b1597c9b25> ;
    dzdoc:replacementText "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 27 ذي الحجة عام 1425 الموافق 6 فبراير سنة 2005. عبد العزيز بوتفليقة"@ar ;
    dzdoc:resolutionStatus "resolved" ;
