<https://legal.dz/resource/law/2005-02-06/05-01#version_art_5> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن اتخاذ إجراءات المتابعة الجزائية من أجل تبييض الأموال و/أو تمويل الإرهاب ، إلا إذا كانت الأفعال الأصلية المرتكبة في الخارج تكتسي طابعا إجراميا في قانون البلد الذي ارتكبت فيه وفي القانون الجزائري ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_5_20050206_OpEnact_aacc46e5d6> ;
    dzdoc:replacementText "لا يمكن اتخاذ إجراءات المتابعة الجزائية من أجل تبييض الأموال و/أو تمويل الإرهاب ، إلا إذا كانت الأفعال الأصلية المرتكبة في الخارج تكتسي طابعا إجراميا في قانون البلد الذي ارتكبت فيه وفي القانون الجزائري ."@ar ;
