<https://legal.dz/resource/law/2005-02-06/05-01#version_art_12> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تباشر اللجنة المصرفية فيما يخصها ، إجراء تأديبيا طبقا للقانون ضد البنك أو المؤسسة المالية التي تثبت عجزا في إجراءاتها الداخلية الخاصة بالرقابة في مجال الوقاية من تبييض الأموال و تمويل الإرهاب ومكافحتها، ويمكنها التحري عن وجود التقرير المذكور في المادة 10 أعلاه والمطالبة بالاطلاع عليه. يرفع تقرير بخصوص المصالح المالية لبريد الجزائر إلى السلطة الوصية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_12_20050206_OpEnact_655e54375b> ;
    dzdoc:replacementText "تباشر اللجنة المصرفية فيما يخصها ، إجراء تأديبيا طبقا للقانون ضد البنك أو المؤسسة المالية التي تثبت عجزا في إجراءاتها الداخلية الخاصة بالرقابة في مجال الوقاية من تبييض الأموال و تمويل الإرهاب ومكافحتها، ويمكنها التحري عن وجود التقرير المذكور في المادة 10 أعلاه والمطالبة بالاطلاع عليه. يرفع تقرير بخصوص المصالح المالية لبريد الجزائر إلى السلطة الوصية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_12> ;
