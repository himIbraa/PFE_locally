        dzterm:non_financial_professions .

<https://legal.dz/resource/law/2005-02-06/05-01#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#sec_2> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "إذا تمت عملية ما في ظروف من التعقيد غير عادية أو غير مبررة أو تبدو أنها لا تستند إلى مبرر اقتصادي أو إلى محل مشروع أو في الحالات التي يفوق مبلغ العملية حدا يتم تحديده عن طريق التنظيم ، يتعين على الخاضعين أن يولوها عناية خاصة والاستعلام عن مصدر الأموال ووجهتها وكذا محل العملية وهوية المتعاملين الاقتصاديين. يحرر تقرير سري ويحفظ دون الإخلال بتطبيق المواد من 15 إلى 22 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-01#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-01#art_10_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_10_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_10_20050206_OpEnact_3c0b3249eb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-01#art_10_obligation_0_e6b65987> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "10" ;
    dzdoc:position 12 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-01#art_15>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_22> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-01#art_15>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_22> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-01#art_10_condition_0_4fa0426a> ;
    dzdoc:usesTerm dzterm:subject_entities .

<https://legal.dz/resource/law/2005-02-06/05-01#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#sec_4> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "يمكن الهيئة المتخصصة أن تطلع هيئات الدول الأخرى التي تمارس مهام مماثلة، على المعلومات التي تتوفر لديها حول العمليات التي يبدو أنها تهدف إلى تبييض الأموال أو تمويل الإرهاب ، مع مراعاة المعاملة بالمثل وعدم استعمال هذه المعلومات لأغراض غير تلك المنصوص عليها في هذا القانون . كما يمكن الهيئة المتخصصة الحصول على معلومات من الخاضعين ومن السلطات المختصة بعد تلقي طلبات من هيئات الدول الأخرى التي تمارس مهام مماثلة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-01#art_25_permission_0_f3055a2d>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_25_permission_1_07af5bfc> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-01#art_25_right_0_e7765c06>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_25_right_1_87c65256> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-01#version_art_25> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-01#art_25_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_25_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_25_20050206_OpEnact_20b601a9d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "25" ;
    dzdoc:position 35 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-01#art_25_condition_0_3f66f087> ;
    dzdoc:usesTerm dzterm:money_laundering,
        dzterm:specialized_body,
        dzterm:terrorism_financing .

<https://legal.dz/resource/law/2005-02-06/05-01#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#sec_2> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "يجب على الخاضعين أن يتأكدوا من موضوع وطبيعة النشاط وهوية زبائنهم وعناوينهم، كل فيما يخصه، قبل فتح حساب أو دفتر، أو حفظ سندات أو قيم أو إيصالات، أو تأجير صندوق أو القيام بأي عملية أو ربط أي علاقة أعمال أخرى. يتم التأكد من هوية الشخص الطبيعي بتقديم وثيقة رسمية أصلية، سارية الصلاحية متضمنة للصورة، ومن عنوانه بتقديم وثيقة رسمية تثبت ذلك. ويتعين الاحتفاظ بنسخة من كل وثيقة. يتم التأكد من هوية الشخص المعنوي بتقديم قانونه الأساسي وأية وثيقة تثبت تسجيله أو اعتماده وبأن له وجودا فعليا أثناء إثبات شخصيته. ويتعين الاحتفاظ بنسخة من كل وثيقة. يجب تحيين المعلومات المذكورة في الفقرتين الثانية والثالثة سنويا وعند كل تغيير لها. يتعين على الوكلاء والمستخدمين الذين يعملون لحساب الغير أن يقدموا، فضلا عن الوثائق المذكورة أعلاه، التفويض بالسلطات المخولة لهم بالإضافة إلى الوثائق التي تثبت شخصية وعنوان أصحاب الأموال الحقيقيين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-01#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-01#art_7_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_7_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_7_para_2>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_7_para_3>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_7_para_4>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_7_para_5>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_7_para_6> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_7_20050206_OpEnact_ea0f430647> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-01#art_7_obligation_0_fef42534>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_7_obligation_1_9c3d5269>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_7_obligation_2_9c3d5269>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_7_obligation_3_20327274>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_7_obligation_4_2111128e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "7" ;
    dzdoc:position 8 ;
    dzdoc:usesTerm dzterm:subject_entities .

<https://legal.dz/resource/law/2005-02-06/05-01#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#sec_3> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "لا يمكن الإبقاء على التدابير التحفظية التي تأمر بها الهيئة المتخصصة بعد انقضاء مدة 72 ساعة إلا بقرار قضائي. يمكن رئيس محكمة الجزائر، بناء على طلب الهيئة المتخصصة وبعد استطلاع رأي وكيل الجمهورية لدى محكمة الجزائر، أن يمدد الأجل المحدد في الفقرة أعلاه، أو يأمر بالحراسة القضائية المؤقتة على الأموال والحسابات والسندات موضوع الإخطار. يمكن وكيل الجمهورية لدى محكمة الجزائر تقديم عريضة لنفس الغرض. ينفذ الأمر الذي يستجيب لهذا الطلب، بناء على النسخة الأصلية، قبل تبليغ الطرف المعني بالعملية. إذا لم يتضمن الإشعار باستلام وصل الإخطار بالشبهة التدابير التحفظية المنصوص عليها أعلاه، أو لم يبلغ أي قرار صادر عن رئيس محكمة الجزائر أو قاضي التحقيق الجاري أمامه التحقيق عن الاقتضاء، للأشخاص والهيئات المذكورة في المادتين 19 و 21 من هذا القانون في أجل أقصاه 72 ساعة ، فإنه يمكنهم تنفيذ العملية موضوع الإخطار."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-01#art_18_permission_0_fd0dc301>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_18_permission_1_620ce0e2>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_18_permission_2_08adee8f> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-01#art_18_right_0_620ce0e2>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_18_right_1_08adee8f>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_18_right_2_48185f8c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-01#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-01#art_18_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_18_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_18_para_2>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_18_para_3>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_18_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_18_20050206_OpEnact_04adc633b0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-01#art_18_obligation_0_fd0dc301> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "18" ;
    dzdoc:position 27 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-01#art_19>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_21> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-01#art_19>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_21> ;
