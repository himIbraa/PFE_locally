<https://legal.dz/resource/law/2005-02-06/05-01#version_art_23> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن اتخاذ أية متابعة من أجل انتهاك السر البنكي أو المهني ضد الأشخاص أو المسيرين والأعوان الخاضعين للإخطار بالشبهة الذين أرسلوا بحسن نية المعلومات أو قاموا بالإخطارات المنصوص عليها في هذا القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_23_20050206_OpEnact_dad8f12c1f> ;
    dzdoc:replacementText "لا يمكن اتخاذ أية متابعة من أجل انتهاك السر البنكي أو المهني ضد الأشخاص أو المسيرين والأعوان الخاضعين للإخطار بالشبهة الذين أرسلوا بحسن نية المعلومات أو قاموا بالإخطارات المنصوص عليها في هذا القانون ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_23> ;
