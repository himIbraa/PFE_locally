<https://legal.dz/resource/law/2005-02-06/05-01#version_art_26> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم التعاون وتبادل المعلومات المذكورة في المادة 25 أعلاه، في إطار احترام الاتفاقيات الدولية والأحكام القانونية الداخلية المطبقة في مجال حماية الحياة الخاصة وتبليغ المعطيات الشخصية مع مراعاة أن تكون الهيئات الأجنبية المختصة خاضعة لنفس واجبات السر المهني مثل الهيئة المتخصصة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_26_20050206_OpEnact_0851900175> ;
    dzdoc:replacementText "يتم التعاون وتبادل المعلومات المذكورة في المادة 25 أعلاه، في إطار احترام الاتفاقيات الدولية والأحكام القانونية الداخلية المطبقة في مجال حماية الحياة الخاصة وتبليغ المعطيات الشخصية مع مراعاة أن تكون الهيئات الأجنبية المختصة خاضعة لنفس واجبات السر المهني مثل الهيئة المتخصصة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
