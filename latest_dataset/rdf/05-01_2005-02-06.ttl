    dznorm:sourceArticle "art_36" .

<https://legal.dz/resource/law/2005-02-06/05-01#art_36_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_36> ;
