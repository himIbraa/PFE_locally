<https://legal.dz/resource/law/2005-02-06/05-01#art_24_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_24> ;
    dzdoc:position 0 ;
    dzdoc:text "يعفى الأشخاص الطبيعيون والمعنويون الخاضعون للإخطار بالشبهة والذين تصرفوا بحسن نية، من أية مسؤولية إدارية أو مدنية أو جزائية."@ar .

<https://legal.dz/resource/law/2005-02-06/05-01#art_24_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_24> ;
    dzdoc:position 1 ;
    dzdoc:text "ويبقى هذا الإعفاء من المسؤولية قائما حتى لو لم تؤد التحقيقات إلى أية نتيجة، أو انتهت المتابعات بقرارات بألا وجه للمتابعة أو التسريح أو البراءة."@ar .

<https://legal.dz/resource/law/2005-02-06/05-01#art_24_right_0_568b6e8f> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_24> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعفى الأشخاص الطبيعيون والمعنويون الخاضعون للإخطار بالشبهة والذين تصرفوا بحسن نية، من أية مسؤولية إدارية أو مدنية أو جزائية"@ar ;
    dznorm:sourceArticle "art_24" .

<https://legal.dz/resource/law/2005-02-06/05-01#art_25_condition_0_3f66f087> a dznorm:Condition ;
    dznorm:conditionText "مع مراعاة المعاملة بالمثل وعدم استعمال هذه المعلومات لأغراض غير تلك المنصوص عليها في هذا القانون"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_25> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2005-02-06/05-01#art_25_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_25> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن الهيئة المتخصصة أن تطلع هيئات الدول الأخرى التي تمارس مهام مماثلة، على المعلومات التي تتوفر لديها حول العمليات التي يبدو أنها تهدف إلى تبييض الأموال أو تمويل الإرهاب، مع مراعاة المعاملة بالمثل وعدم استعمال هذه المعلومات لأغراض غير تلك المنصوص عليها في هذا القانون."@ar .

<https://legal.dz/resource/law/2005-02-06/05-01#art_25_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_25> ;
    dzdoc:position 1 ;
    dzdoc:text "كما يمكن الهيئة المتخصصة الحصول على معلومات من الخاضعين ومن السلطات المختصة بعد تلقي طلبات من هيئات الدول الأخرى التي تمارس مهام مماثلة."@ar .

