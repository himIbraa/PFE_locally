<https://legal.dz/resource/law/2005-02-06/05-01#version_art_4_bis_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤدي أعضاء الهيئة المتخصصة الذين لم يسبق لهم تأدية اليمين، في إطار ممارسة مهامهم، والمستخدمون المؤهلون للاطلاع على المعلومات ذات الطابع السري، اليمين أمام المجلس القضائي قبل تنصيبهم بالعبارات الآتية : \"أقسم بالله العلي العظيم أن أقوم بمهامي أحسن قيام وأن أخلص في تأديتها وأكتم سرها وأسلك في كل الظروف سلوكا شريفا \"."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_4_bis_1_20050206_OpEnact_871e514a2c> ;
    dzdoc:replacementText "يؤدي أعضاء الهيئة المتخصصة الذين لم يسبق لهم تأدية اليمين، في إطار ممارسة مهامهم، والمستخدمون المؤهلون للاطلاع على المعلومات ذات الطابع السري، اليمين أمام المجلس القضائي قبل تنصيبهم بالعبارات الآتية : \"أقسم بالله العلي العظيم أن أقوم بمهامي أحسن قيام وأن أخلص في تأديتها وأكتم سرها وأسلك في كل الظروف سلوكا شريفا \"."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_4_bis_1> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-01> ;
