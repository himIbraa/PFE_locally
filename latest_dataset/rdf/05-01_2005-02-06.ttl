<https://legal.dz/resource/law/2005-02-06/05-01#version_art_29> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم التعاون القضائي بين الجهات القضائية الجزائرية والأجنبية خلال التحقيقات والمتابعات والإجراءات القضائية المتعلقة بـ تبييض الأموال و تمويل الإرهاب ، مع مراعاة المعاملة بالمثل وفي إطار احترام الاتفاقيات الثنائية والمتعددة الأطراف المطبقة في هذا المجال والمصادق عليها من قبل الجزائر طبقا للتشريع الداخلي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_29_20050206_OpEnact_d99ce6a3eb> ;
    dzdoc:replacementText "يتم التعاون القضائي بين الجهات القضائية الجزائرية والأجنبية خلال التحقيقات والمتابعات والإجراءات القضائية المتعلقة بـ تبييض الأموال و تمويل الإرهاب ، مع مراعاة المعاملة بالمثل وفي إطار احترام الاتفاقيات الثنائية والمتعددة الأطراف المطبقة في هذا المجال والمصادق عليها من قبل الجزائر طبقا للتشريع الداخلي ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
