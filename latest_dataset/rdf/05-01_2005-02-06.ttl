<https://legal.dz/resource/law/2005-02-06/05-01#art_20_obligation_0_6b004a85> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
