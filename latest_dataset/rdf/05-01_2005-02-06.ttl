    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_20> .

<https://legal.dz/resource/law/2005-02-06/05-01#art_20_obligation_1_91af8ef7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_20> ;
    dznorm:position 1 ;
    dznorm:provisionText "ويتعين القيام بهذا الإخطار بمجرد وجود الشبهة حتى ولو تعذر تأجيل تنفيذ تلك العمليات أو بعد إنجازها"@ar ;
    dznorm:sourceArticle "art_20" .

<https://legal.dz/resource/law/2005-02-06/05-01#art_20_obligation_2_fe161119> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2005-02-06/05-01#art_20_obligation_2_fe161119_action_f52028de32> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_20> ;
    dznorm:position 2 ;
    dznorm:provisionText "يجب إبلاغ كل معلومات ترمي إلى تأكيد الشبهة أو نفيها دون تأخير إلى الهيئة المتخصصة"@ar ;
    dznorm:sourceArticle "art_20" .

<https://legal.dz/resource/law/2005-02-06/05-01#art_20_obligation_2_fe161119_action_f52028de32> a dznorm:Action ;
    rdfs:label "إبلاغ كل معلومات ترمي إلى"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب إبلاغ كل معلومات ترمي إلى تأكيد الشبهة أو نفيها دون تأخير إلى الهيئة المتخصصة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_20> .

<https://legal.dz/resource/law/2005-02-06/05-01#art_20_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_20> ;
    dzdoc:position 0 ;
    dzdoc:text "دون الإخلال بأحكام المادة 32 من قانون الإجراءات الجزائية، يتعين على الخاضعين، إبلاغ الهيئة المتخصصة بكل عملية تتعلق بأموال يشتبه أنها متحصل عليها من جريمة أو يبدو أنها موجهة لتبييض الأموال و/ أو تمويل الإرهاب."@ar .

<https://legal.dz/resource/law/2005-02-06/05-01#art_20_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_20> ;
    dzdoc:position 1 ;
    dzdoc:text "ويتعين القيام بهذا الإخطار بمجرد وجود الشبهة حتى ولو تعذر تأجيل تنفيذ تلك العمليات أو بعد إنجازها."@ar .

<https://legal.dz/resource/law/2005-02-06/05-01#art_20_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_20> ;
    dzdoc:position 2 ;
    dzdoc:text "يجب إبلاغ كل معلومات ترمي إلى تأكيد الشبهة أو نفيها دون تأخير إلى الهيئة المتخصصة."@ar .

<https://legal.dz/resource/law/2005-02-06/05-01#art_20_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_20> ;
    dzdoc:position 3 ;
    dzdoc:text "يحدد شكل الإخطار بالشبهة ونموذجه ومحتواه ووصل استلامه عن طريق التنظيم بناء على اقتراح من الهيئة المتخصصة."@ar .

<https://legal.dz/resource/law/2005-02-06/05-01#art_21_obligation_0_f933d883> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2005-02-06/05-01#art_21_obligation_0_f933d883_period_7e539739b0> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_21> ;
    dznorm:position 0 ;
    dznorm:provisionText "ترسل المفتشية العامة للمالية ومصالح الضرائب والجمارك وأملاك الدولة والخزينة لعمومية، وبنك الجزائر ، بصفة عاجلة تقريرا سريا إلى الهيئة المتخصصة فور اكتشافها خلال قيامها بمهامها الخاصة بالمراقبة والتحقيق، وجود أموال أو عمليات يشتبه أنها متحصل عليها من جريمة، أو يبدو أنها موجهة لتبييض الأموال و/ أو تمويل الإرهاب"@ar ;
    dznorm:sourceArticle "art_21" .

