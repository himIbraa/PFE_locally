<https://legal.dz/resource/law/2005-02-06/05-01#version_art_10> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تمت عملية ما في ظروف من التعقيد غير عادية أو غير مبررة أو تبدو أنها لا تستند إلى مبرر اقتصادي أو إلى محل مشروع أو في الحالات التي يفوق مبلغ العملية حدا يتم تحديده عن طريق التنظيم ، يتعين على الخاضعين أن يولوها عناية خاصة والاستعلام عن مصدر الأموال ووجهتها وكذا محل العملية وهوية المتعاملين الاقتصاديين. يحرر تقرير سري ويحفظ دون الإخلال بتطبيق المواد من 15 إلى 22 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_10_20050206_OpEnact_3c0b3249eb> ;
    dzdoc:replacementText "إذا تمت عملية ما في ظروف من التعقيد غير عادية أو غير مبررة أو تبدو أنها لا تستند إلى مبرر اقتصادي أو إلى محل مشروع أو في الحالات التي يفوق مبلغ العملية حدا يتم تحديده عن طريق التنظيم ، يتعين على الخاضعين أن يولوها عناية خاصة والاستعلام عن مصدر الأموال ووجهتها وكذا محل العملية وهوية المتعاملين الاقتصاديين. يحرر تقرير سري ويحفظ دون الإخلال بتطبيق المواد من 15 إلى 22 من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_10> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-01> ;
