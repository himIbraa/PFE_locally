<https://legal.dz/resource/law/2005-02-06/05-01#art_35_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_35> ;
    dzdoc:position 0 ;
    dzdoc:text "تلغى أحكام المواد من 104 إلى 110 من القانون رقم 02-11 المؤرخ في 20 شوال عام 1413 الموافق 24 ديسمبر سنة 2002 والمتضمن قانون المالية لسنة 2003."@ar .

<https://legal.dz/resource/law/2005-02-06/05-01#art_36_obligation_0_da3a9505> a dznorm:Obligation ;
