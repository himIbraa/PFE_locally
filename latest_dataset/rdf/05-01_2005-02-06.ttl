    dznorm:sourceArticle "art_14" .

<https://legal.dz/resource/law/2005-02-06/05-01#art_14_obligation_0_1ef11299_role_cc52b11f63> a dznorm:Role ;
    rdfs:label "الخاضعين الاحتفاظ بالوثائق الآتي"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
