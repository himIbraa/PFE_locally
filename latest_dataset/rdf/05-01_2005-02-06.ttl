<https://legal.dz/resource/law/2005-02-06/05-01#version_art_10_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتولى السلطات التي لها صلاحيات الضبط و/أو الإشراف و / أو الرقابة التي يتبعها الخاضعون ، سن تنظيمات في مجال الوقاية من تبييض الأموال وتمويل الإرهاب ومكافحتهما ، ومساعدة الخاضعين على احترام الواجبات المنصوص عليها في هذا القانون. تحدد شروط و کیفیات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_10_bis_20050206_OpEnact_c2b8921989> ;
    dzdoc:replacementText "تتولى السلطات التي لها صلاحيات الضبط و/أو الإشراف و / أو الرقابة التي يتبعها الخاضعون ، سن تنظيمات في مجال الوقاية من تبييض الأموال وتمويل الإرهاب ومكافحتهما ، ومساعدة الخاضعين على احترام الواجبات المنصوص عليها في هذا القانون. تحدد شروط و کیفیات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_10_bis> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_10_bis> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-02-06"^^xsd:date ;
