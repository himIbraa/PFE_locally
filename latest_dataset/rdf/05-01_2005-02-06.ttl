<https://legal.dz/resource/law/2005-02-06/05-01#art_1_extref_6091b5e0> a dzdoc:ExternalReference ;
    rdfs:label "قانون العقوبات"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-156" ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/1966-06-08/66-156> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
