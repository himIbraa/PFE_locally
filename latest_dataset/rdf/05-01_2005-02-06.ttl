<https://legal.dz/resource/law/2005-02-06/05-01#version_art_16> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسلم الهيئة المتخصصة وصل الإخطار بالشبهة وتقوم بجمع كل المعلومات والبيانات التي تسمح باكتشاف مصدر الأموال أو الطبيعة الحقيقية للعمليات موضوع الإخطار ، و تقوم بإرسال الملف لوكيل الجمهورية المختص طبقا للقانون، في كل مرة يحتمل فيها أن تكون الوقائع المصرح بها مرتبطة بجريمة تبييض الأموال أو تمويل الإرهاب ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_16_20050206_OpEnact_6138bb16c8> ;
    dzdoc:replacementText "تسلم الهيئة المتخصصة وصل الإخطار بالشبهة وتقوم بجمع كل المعلومات والبيانات التي تسمح باكتشاف مصدر الأموال أو الطبيعة الحقيقية للعمليات موضوع الإخطار ، و تقوم بإرسال الملف لوكيل الجمهورية المختص طبقا للقانون، في كل مرة يحتمل فيها أن تكون الوقائع المصرح بها مرتبطة بجريمة تبييض الأموال أو تمويل الإرهاب ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_16> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-01> ;
