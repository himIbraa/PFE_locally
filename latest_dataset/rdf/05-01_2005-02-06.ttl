    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب كل من يقوم بدفع أو يقبل دفعا خرقا لأحكام المادة 6 أعلاه ، بغرامة من 500.000 دج إلى 5.000.000 دج ."@ar ;
