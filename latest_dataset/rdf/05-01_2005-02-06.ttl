dzterm:specialized_body a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "\" الهيئة المتخصصة \""@ar,
        "الهيئة المتخصصة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-01#art_4_bis_defocc_7eee4c3da247>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_4_defocc_70483e2df4fe> .

<https://legal.dz/resource/law/2005-02-06/05-01#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#sec_3> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "تتولى الهيئة المتخصصة تحليل واستغلال المعلومات التي ترد إليها من السلطات المختصة والخاضعين قصد تحديد مصدر الأموال ووجهتها. كما يمكنها أن تطلب من السلطات المختصة أو من الخاضعين، في إطار كل إخطار بالشبهة أو تقرير سري تستلمه، أي معلومات إضافية تراها ضرورية لممارسة مهامها. تكتسي المعلومات المبلغة إلى الهيئة المتخصصة طابعا سريا ، و لا يجوز استعمالها لأغراض غير تلك المنصوص عليها في هذا القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-01#art_15_permission_0_70514ed3> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-01#art_15_right_0_0909667c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-01#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-01#art_15_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_15_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_15_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_15_20050206_OpEnact_8d3fe309bc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-01#art_15_obligation_0_a7202e70>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_15_obligation_1_efd5c4af>,
        <https://legal.dz/resource/law/2005-02-06/05-01#art_15_obligation_2_d7468879> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
