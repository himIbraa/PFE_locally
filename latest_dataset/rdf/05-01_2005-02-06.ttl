<https://legal.dz/resource/law/2005-02-06/05-01#version_art_10_bis_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على الخاضعين ، في إطار الوقاية من تبييض الأموال وتمويل الإرهاب ومكافحتهما، وضع وتنفيذ برامج تضمن الرقابة الداخلية والتكوين المستمر لمستخدميهم. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_10_bis_1_20050206_OpEnact_870ad640b6> ;
    dzdoc:replacementText "يجب على الخاضعين ، في إطار الوقاية من تبييض الأموال وتمويل الإرهاب ومكافحتهما، وضع وتنفيذ برامج تضمن الرقابة الداخلية والتكوين المستمر لمستخدميهم. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_10_bis_1> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-01> ;
