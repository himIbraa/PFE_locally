    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_20> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتعين على الخاضعين، إبلاغ الهيئة المتخصصة بكل عملية تتعلق بأموال يشتبه أنها متحصل عليها من جريمة أو يبدو أنها موجهة لتبييض الأموال و/ أو تمويل الإرهاب"@ar ;
    dznorm:sourceArticle "art_20" .

<https://legal.dz/resource/law/2005-02-06/05-01#art_20_obligation_0_6b004a85_role_f003b8ab1d> a dznorm:Role ;
