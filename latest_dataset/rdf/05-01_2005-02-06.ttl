    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتعين على الخاضعين الاحتفاظ بالوثائق الآتي ذكرها وجعلها في متناول السلطات المختصة : 1 - الوثائق المتعلقة بهوية الزبائن وعناوينهم خلال فترة خمس (5) سنوات على الأقل، بعد غلق الحسابات أو وقف علاقة التعامل. 2 - الوثائق المتعلقة بالعمليات التي أجراها الزبائن خلال فترة خمس (5) سنوات على الأقل، بعد تنفيذ العملية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_14_20050206_OpEnact_407d69af7b> ;
    dzdoc:replacementText "يتعين على الخاضعين الاحتفاظ بالوثائق الآتي ذكرها وجعلها في متناول السلطات المختصة : 1 - الوثائق المتعلقة بهوية الزبائن وعناوينهم خلال فترة خمس (5) سنوات على الأقل، بعد غلق الحسابات أو وقف علاقة التعامل. 2 - الوثائق المتعلقة بالعمليات التي أجراها الزبائن خلال فترة خمس (5) سنوات على الأقل، بعد تنفيذ العملية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-01#art_14> ;
