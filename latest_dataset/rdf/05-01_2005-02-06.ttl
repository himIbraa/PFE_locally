    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "ترسل المفتشية العامة للمالية ومصالح الضرائب والجمارك وأملاك الدولة والخزينة لعمومية، وبنك الجزائر ، بصفة عاجلة تقريرا سريا إلى الهيئة المتخصصة فور اكتشافها خلال قيامها بمهامها الخاصة بالمراقبة والتحقيق، وجود أموال أو عمليات يشتبه أنها متحصل عليها من جريمة، أو يبدو أنها موجهة لتبييض الأموال و/ أو تمويل الإرهاب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-01#art_21> .

