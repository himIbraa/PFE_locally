<https://legal.dz/resource/law/2005-02-06/05-01#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#sec_1> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "فضلا عن الأحكام الواردة في قانون العقوبات ، يهدف هذا القانون إلى الوقاية من تبييض الأموال و تمويل الإرهاب ومكافحتهما."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-01#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-01#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_1_20050206_OpEnact_556ae8802b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "الأولى" ;
    dzdoc:position 0 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2005-02-06/05-01#art_1_extref_6091b5e0> ;
    dzdoc:usesTerm dzterm:money_laundering,
        dzterm:terrorism_financing .

<https://legal.dz/resource/law/2005-02-06/05-01#art_10_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-01#sec_2> ;
    dzdoc:eId "art_10_bis_3" ;
    dzdoc:fullText "تطبق التنظيمات التي يتخذها مجلس النقد والقرض في مجال الوقاية من تبييض الأموال و تمويل الإرهاب ومكافحتهما، على البنوك والمؤسسات المالية وعلى المصالح المالية لبريد الجزائر التي تخضع لرقابة اللجنة المصرفية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-01#version_art_10_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-01#art_10_bis_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-01#version_art_10_bis_3_20050206_OpEnact_565dee3fe9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-01> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "10 مكرر 3" ;
    dzdoc:position 16 ;
    dzdoc:usesTerm dzterm:banking_commission,
        dzterm:monetary_and_credit_council,
        dzterm:money_laundering,
        dzterm:terrorism_financing .

