<https://legal.dz/resource/law/2015-09-16/15-247#version_art_141> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المتعامل المتعاقد هو المسؤول الوحيد تجاه المصلحة المتعاقدة عن تنفيذ جزء الصفقة المتعامل فيها بالمناولة ."@ar ;
