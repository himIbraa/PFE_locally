    dznorm:sourceArticle "art_90" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_90_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_90> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما تتعارض المصالح الخاصة لموظف عمومي يشارك في إبرام أو مراقبة أو تنفيذ صفقة عمومية مع المصلحة العامة ويكون من شأن ذلك التأثير في ممارسته لمهامه بشكل عاد، فإنه يتعين عليه أن يخبر سلطته السلمية بذلك ويتنحى عن هذه المهمة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_91_condition_0_e222407b> a dznorm:Condition ;
