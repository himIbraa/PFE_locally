<https://legal.dz/resource/law/2015-09-16/15-247#version_art_109> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقصد في مفهوم المادة 108 أعلاه بما يأتي التسبيق : هو كل مبلغ يدفع قبل تنفيذ الخدمات موضوع العقد، وبدون مقابل للتنفيذ المادي للخدمة ، الدفع على الحساب : هو كل دفع تقوم به المصلحة المتعاقدة مقابل تنفيذ جزئي لموضوع الصفقة ، التسوية على رصيد حساب : هو الدفع المؤقت أو النهائي للسعر المنصوص عليه في الصفقة بعد التنفيذ الكامل والمرضي لموضوعها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_109_20150916_OpEnact_218c1a4e40> ;
    dzdoc:replacementText "يقصد في مفهوم المادة 108 أعلاه بما يأتي التسبيق : هو كل مبلغ يدفع قبل تنفيذ الخدمات موضوع العقد، وبدون مقابل للتنفيذ المادي للخدمة ، الدفع على الحساب : هو كل دفع تقوم به المصلحة المتعاقدة مقابل تنفيذ جزئي لموضوع الصفقة ، التسوية على رصيد حساب : هو الدفع المؤقت أو النهائي للسعر المنصوص عليه في الصفقة بعد التنفيذ الكامل والمرضي لموضوعها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_109> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_109> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
