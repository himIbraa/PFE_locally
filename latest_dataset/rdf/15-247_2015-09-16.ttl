<https://legal.dz/resource/law/2015-09-16/15-247#version_art_121> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن تحدد الصفقة الآجال المخولة ل المصلحة المتعاقدة لتقوم بعمليات الإثبات التي تعطي الحق في الدفع . ويبدأ سريان الآجال اعتبارا من تقديم صاحب الصفقة العمومية طلبا بذلك مدعما بالمبررات الضرورية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_121_20150916_OpEnact_05ed947834> ;
