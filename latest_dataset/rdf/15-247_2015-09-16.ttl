    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_162> ;
    dznorm:position 1 ;
    dznorm:provisionText "ويجب أن تسهر المصلحة المتعاقدة على أن يسمح عدد الأعضاء الحاضرين بضمان شفافية الإجراء."@ar ;
    dznorm:sourceArticle "art_162" .

