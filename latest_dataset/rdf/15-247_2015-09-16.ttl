    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_27>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_37> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_27>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_37> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_31_condition_0_fd9815a5> ;
