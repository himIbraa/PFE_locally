<https://legal.dz/resource/law/2015-09-16/15-247#art_210_defocc_41ba011e9aab> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 76 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:management ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_210> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_210_para_10> ;
    dzdoc:paragraphPosition 10 ;
    dzdoc:snippet "التسيير: تعهد السلطة المفوضة للمفوض له بتسيير أو بتسيير وصيانة المرفق العام. ويستغل المفوض له المرفق العام لحساب السلطة المفوضة التي تمول بنفسها المرفق العام وتحتفظ بإدارته."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_210_defocc_8f12029bb254> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 92 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:lease ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_210> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_210_para_5> ;
    dzdoc:paragraphPosition 5 ;
    dzdoc:snippet "الإيجار: تعهد السلطة المفوضة للمفوض له بتسيير مرفق عام وصيانته مقابل إتاوة سنوية يدفعها لها. ويتصرف المفوض له حينئذ لحسابه وعلى مسؤوليته."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_210_defocc_b05715e2c246> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 85 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:incentive_agency ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_210> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_210_para_7> ;
    dzdoc:paragraphPosition 7 ;
    dzdoc:snippet "الوكالة المحفزة : تعهد السلطة المفوضة للمفوض له بتسيير أو بتسيير وصيانة المرفق العام. ويقوم المفوض له باستغلال المرفق العام لحساب السلطة المفوضة التي تمول بنفسها إقامة المرفق العام وتحتفظ بإدارته."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_210_defocc_e08555454509> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 150 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:concession ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_210> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_210_para_2> ;
    dzdoc:paragraphPosition 2 ;
    dzdoc:snippet "الامتياز تعهد السلطة المفوضة للمفوض له إما إنجاز منشآت أو اقتناء ممتلكات ضرورية لإقامة المرفق العام واستغلاله، وإما تعهد له فقط باستغلال المرفق العام."@ar .

