<https://legal.dz/resource/law/2015-09-16/15-247#version_art_30> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن تلجأ المصلحة المتعاقدة إلى صفقات تشتمل على قسط ثابت وقسط أو أكثر اشتراطي، عندما تبرر شروط اقتصادية و / أو مالية ذلك . ويجب أن يكون القسط الثابت وكل قسط اشتراطي مشروعا وظيفيا. يخضع تنفيذ كل قسط اشتراطي إلى قرار من المصلحة المتعاقدة يبلغ إلى المتعامل المتعاقد حسب الشروط المحددة في دفتر الشروط ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_30_20150916_OpEnact_8287cb75e3> ;
    dzdoc:replacementText "يمكن أن تلجأ المصلحة المتعاقدة إلى صفقات تشتمل على قسط ثابت وقسط أو أكثر اشتراطي، عندما تبرر شروط اقتصادية و / أو مالية ذلك . ويجب أن يكون القسط الثابت وكل قسط اشتراطي مشروعا وظيفيا. يخضع تنفيذ كل قسط اشتراطي إلى قرار من المصلحة المتعاقدة يبلغ إلى المتعامل المتعاقد حسب الشروط المحددة في دفتر الشروط ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
