dzterm:call_for_tenders a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "طلب العروض"@ar,
        "طلب العروض هو إجراء يستهدف الحصول على عروض من عدة متعهدين متنافسين مع تخصيص الصفقة دون مفاوضات للمتعهد الذي يقدم أحسن عرض من حيث المزايا الاقتصادية استنادا إلى معايير اختيار موضوعية، تعد قبل إطلاق الإجراء."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_40_defocc_bbaac17eb5b7> .

dzterm:mutual_agreement a skos:Concept,
