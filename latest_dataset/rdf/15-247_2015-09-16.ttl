        <https://legal.dz/resource/law/2015-09-16/15-247#art_125_obligation_0_013c7e0c_role_c3b5b27ff6> ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_184> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_184> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_125> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب على المتعهدين، فيما يخص الصفقات العمومية للأشغال واللوازم التي تتجاوز مبالغها الحدود المنصوص عليها في المطتين الأولى والثانية على التوالي من المادة 184 من هذا المرسوم ، تقديم كفالة تعهد تفوق واحدا في المائة (1) من مبلغ العرض"@ar ;
    dznorm:sourceArticle "art_125" .

