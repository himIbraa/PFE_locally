<https://legal.dz/resource/law/2015-09-16/15-247#art_23_obligation_2_5d2d0cf1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2015-09-16/15-247#art_23_obligation_2_5d2d0cf1_period_5e511aa7c9> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2015-09-16/15-247#art_23_obligation_2_5d2d0cf1_role_e45c5c400a> ;
