    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_49> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_4_condition_0_a9610a96> a dznorm:Condition ;
    dznorm:conditionText "لا تصح الصفقات ولا تكون نهائية إلا إذا وافقت عليها السلطة المختصة المذكورة أدناه، حسب الحالة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_4> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_4_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_4> ;
    dzdoc:position 0 ;
    dzdoc:text "لا تصح الصفقات ولا تكون نهائية إلا إذا وافقت عليها السلطة المختصة المذكورة أدناه، حسب الحالة: مسؤول الهيئة العمومية، الوزير، الوالي، رئيس المجلس الشعبي البلدي، المدير العام أو مدير المؤسسة العمومية."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_4_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_4> ;
    dzdoc:position 1 ;
    dzdoc:text "يمكن كل سلطة من هذه السلطات أن تفوض صلاحياتها في هذا المجال إلى المسؤولين المكلفين، بأي حال، بإبرام وتنفيذ الصفقات العمومية طبقا للأحكام التشريعية والتنظيمية المعمول بها."@ar .

