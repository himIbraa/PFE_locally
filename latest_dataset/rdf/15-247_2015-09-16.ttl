<https://legal.dz/resource/law/2015-09-16/15-247#version_art_137> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخضع الملحق للشروط الاقتصادية الأساسية للصفقة . وفي حالة تعذر الأخذ بالأسعار التعاقدية المحددة في الصفقة ، بالنسبة للخدمات التكميلية الواردة في ملحق ، فإنه يمكن أن تحدد أسعار جديدة، عند الاقتضاء."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_137_20150916_OpEnact_226e673238> ;
    dzdoc:replacementText "يخضع الملحق للشروط الاقتصادية الأساسية للصفقة . وفي حالة تعذر الأخذ بالأسعار التعاقدية المحددة في الصفقة ، بالنسبة للخدمات التكميلية الواردة في ملحق ، فإنه يمكن أن تحدد أسعار جديدة، عند الاقتضاء."@ar ;
