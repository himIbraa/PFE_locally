<https://legal.dz/resource/law/2015-09-16/15-247#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#body> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "يتم تطبيق سياسة إعداد وإبرام وتنفيذ ومراقبة الصفقات العمومية وتفويضات المرفق العام التي تبرمها على التوالي المصالح المتعاقدة و السلطات المفوضة طبقا للقوانين والتنظيمات المعمول بها وأحكام هذا المرسوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_1_20150916_OpEnact_d9217b6079> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "الأولى" ;
    dzdoc:position 0 ;
    dzdoc:usesTerm dzterm:contracting_authorities,
        dzterm:delegating_authorities,
        dzterm:public_procurement_policy .

<https://legal.dz/resource/law/2015-09-16/15-247#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_1_subsec_2_subsubsec_2> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "تعفى الصفقات العمومية المبرمة حسب الشروط المنصوص عليها في المادة 49 من هذا المرسوم، من الاستشارة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_15_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_15_20150916_OpEnact_e8bb8823a4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "15" ;
    dzdoc:position 14 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_49> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_49> ;
    dzdoc:usesTerm dzterm:public_contract .

<https://legal.dz/resource/law/2015-09-16/15-247#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_التمهيدي> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "تمارس على الصفقات العمومية مختلف أنواع الرقابة المنصوص عليها في هذا المرسوم كيفما كان نوعها وفي حدود معينة، دون المساس بالأحكام القانونية الأخرى التي تطبق عليها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_157_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_157_20150916_OpEnact_cacd6e8240> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "157" ;
    dzdoc:position 156 ;
    dzdoc:usesTerm dzterm:public_procurement .

<https://legal.dz/resource/law/2015-09-16/15-247#art_161> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_1_subsubsec_1> ;
    dzdoc:eId "art_161" ;
    dzdoc:fullText "تقوم لجنة فتح الأظرفة وتقييم العروض بعمل إداري وتقني تعرضه على المصلحة المتقاعدة التي تقوم بمنح الصفقة أو الإعلان عن عدم جدوى الإجراء أو إلغائه أو إلغاء المنح المؤقت للصفقة. وتصدر في هذا الشأن رأيا مبررا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_161> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_161_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_161_20150916_OpEnact_8b9a9e48dd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "161" ;
    dzdoc:position 160 ;
    dzdoc:usesTerm dzterm:bid_opening_evaluation_committee,
        dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_168> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2> ;
    dzdoc:eId "art_168" ;
    dzdoc:fullText "تختص بالرقابة الخارجية القبلية للصفقات العمومية التي تبرمها وزارة الدفاع الوطني، حصريا، لجنة أو لجان موضوعة لدى وزارة الدفاع الوطني التي تحدد تشكيلتها وصلاحياتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_168> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_168_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_168_20150916_OpEnact_066d6e5863> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "168" ;
    dzdoc:position 167 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_170> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_1> ;
    dzdoc:eId "art_170" ;
    dzdoc:fullText "تمارس الرقابة الخارجية هيئات الرقابة التي يحدد تشكيلها واختصاصاتها أدناه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_170> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_170_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_170_20150916_OpEnact_ddff14f2f9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "170" ;
    dzdoc:position 169 ;
    dzdoc:usesTerm dzterm:external_control .

<https://legal.dz/resource/law/2015-09-16/15-247#art_178> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_1> ;
    dzdoc:eId "art_178" ;
    dzdoc:fullText "تتوج الرقابة التي تمارسها لجنة صفقات المصلحة المتعاقدة بمقرر منح التأشيرة أو رفضها خلال أجل أقصاه عشرون (20) يوما، ابتداء من تاريخ إيداع الملف كاملا لدى كتابة هذه اللجنة. ويسير أجل دراسة الطعون بموجب أحكام المادة 82 من هذا المرسوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_178> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_178_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_178_20150916_OpEnact_dcd5ec1d72> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 178" ;
    dzdoc:position 177 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_82> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_82> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_180> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_2> ;
    dzdoc:eId "art_180" ;
    dzdoc:fullText "تتمثل صلاحيات اللجنة القطاعية للصفقات فيما يأتي : مراقبة صحة إجراءات إبرام الصفقات العمومية ، مساعدة المصالح المتعاقدة التابعة لها في مجال تحضير الصفقات العمومية وإتمام تراتيبها، المساهمة في تحسين ظروف مراقبة صحة إجراءات إبرام الصفقات العمومية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_180> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_180_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_180_20150916_OpEnact_ce84dccb5c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 180" ;
    dzdoc:position 179 ;
    dzdoc:usesTerm dzterm:contracting_authorities,
        dzterm:public_procurement,
        dzterm:sectoral_commission .

<https://legal.dz/resource/law/2015-09-16/15-247#art_182> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_2> ;
    dzdoc:eId "art_182" ;
    dzdoc:fullText "تختص اللجنة القطاعية للصفقات في مجال الرقابة بدراسة مشاريع دفاتر الشروط والصفقات والملاحق والطعون المنصوص عليها في المادة 82 من هذا المرسوم المتعلقة بكل المصالح المتعاقدة التابعة للقطاع المعني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_182> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_182_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_182_20150916_OpEnact_921373b399> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 182" ;
    dzdoc:position 181 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_82> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_82> ;
    dzdoc:usesTerm dzterm:contracting_authorities,
        dzterm:sectoral_commission .

<https://legal.dz/resource/law/2015-09-16/15-247#art_189> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_2> ;
    dzdoc:eId "art_189" ;
    dzdoc:fullText "تتوج الرقابة التي تمارسها اللجنة القطاعية للصفقات بمقرر منح أو رفض التأشيرة في أجل أقصاه خمسة وأربعون (45) يوما، ابتداء من تاريخ إيداع الملف كاملا لدى كتابة هذه اللجنة ويسير أجل دراسة الطعون بموجب أحكام المادة 82 من هذا المرسوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_189> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_189_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_189_20150916_OpEnact_69dcaf09e2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "189" ;
    dzdoc:position 188 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_82> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_82> ;
    dzdoc:usesTerm dzterm:sectoral_procurement_committee .

<https://legal.dz/resource/law/2015-09-16/15-247#art_199> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_3> ;
    dzdoc:eId "art_199" ;
    dzdoc:fullText "تتولى الكتابة الدائمة للجنة الموضوعة تحت سلطة رئيس اللجنة القيام بمجموع المهام المادية التي يقتضيها عملها، لا سيما منها ما يأتي : التأكد من أن الملف المقدم كامل بالاستناد إلى أحكام هذا المرسوم وحسب ما هو مبين في النظام الداخلي، تسجيل ملفات مشاريع الصفقات ومشاريع الملاحق، وكذلك أية وثيقة تكميلية، وإعطاء إشعار بالتسليم مقابل ذلك، إعداد جدول الأعمال، إعداد استدعاءات أعضاء اللجنة وممثلي المصلحة المتعاقدة والمستشارين المحتملين، إرسال الملفات إلى المقررين إرسال المذكرة التحليلية لمشروع الصفقة أو الملحق والتقرير التقديمي إلى أعضاء اللجنة، إرسال ملفات مشاريع دفاتر الشروط والطعون إلى أعضاء اللجنة، تحرير التأشيرات والمذكرات ومحاضر الجلسات، إعداد التقارير الفصلية عن النشاط، تمكين أعضاء اللجنة من الاطلاع على المعلومات والوثائق الموجودة لديها، متابعة رفع التحفظات المنصوص عليها في المادة 195 من هذا المرسوم بالاتصال مع المقرر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_199> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_199_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_199_20150916_OpEnact_58a50914bf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 199" ;
    dzdoc:position 198 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_195> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_195> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_217> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_5> ;
    dzdoc:eId "art_217" ;
    dzdoc:fullText "يوضح قرار مشترك بين الوزير المكلف بالمالية والوزير أو مسؤول الهيئة العمومية المعني، عند الحاجة ، كيفيات تطبيق الأحكام الخاصة بكل قطاع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_217> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_217_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_217_20150916_OpEnact_e838e9bb76> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 217" ;
    dzdoc:position 216 ;
    dzdoc:usesTerm dzterm:finance_minister .

<https://legal.dz/resource/law/2015-09-16/15-247#art_218> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_5> ;
    dzdoc:eId "art_218" ;
    dzdoc:fullText "تبقى النصوص المتخذة تطبيقا لأحكام المرسوم الرئاسي رقم 10-236 المؤرخ في 28 شوال عام 1431 الموافق 7 أكتوبر سنة 2010 والمذكور أعلاه، التي تمت إعادة إدراجها في هذا المرسوم، سارية المفعول حتى نشر النصوص الجديدة المتخذة تطبيقا لأحكام هذا المرسوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_218> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_218_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_218_20150916_OpEnact_cd3ac69c17> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 218" ;
    dzdoc:position 217 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2015-09-16/15-247#art_218_extref_c278586b> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_219> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_5> ;
    dzdoc:eId "art_219" ;
    dzdoc:fullText "تحدد بداية سريان أحكام هذا المرسوم بعد ثلاثة (3) أشهر من تاريخ نشره في الجريدة الرسمية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_219> ;
