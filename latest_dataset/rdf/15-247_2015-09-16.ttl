<https://legal.dz/resource/law/2015-09-16/15-247#art_216_obligation_0_a8608f81> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
