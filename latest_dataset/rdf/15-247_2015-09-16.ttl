<https://legal.dz/resource/law/2015-09-16/15-247#version_art_99> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المصلحة المتعاقدة تبليغ الصفقة للمتعهد المقبول قبل انقضاء آجال صلاحية العروض. يمكن المصلحة المتعاقدة في حالة ما إذا لم يكن في استطاعتها منح الصفقة وتبليغها قبل انقضاء آجال صلاحية العروض ، تمديدها بعد موافقة المتعهدين المعنيين. وفي حالة المؤسسة الحائزة صفقة عمومية ، تمدد أجال صلاحية العروض تلقائيا بشهر إضافي. ومهما يكن من أمر، فإن تجاوز مدة صلاحية العروض يعطي للمتعهد المعني الحق في تحيين الأسعار حسب الشروط المنصوص عليها في المادة 100 أدناه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_99_20150916_OpEnact_3857f8f19e> ;
    dzdoc:replacementText "يجب على المصلحة المتعاقدة تبليغ الصفقة للمتعهد المقبول قبل انقضاء آجال صلاحية العروض. يمكن المصلحة المتعاقدة في حالة ما إذا لم يكن في استطاعتها منح الصفقة وتبليغها قبل انقضاء آجال صلاحية العروض ، تمديدها بعد موافقة المتعهدين المعنيين. وفي حالة المؤسسة الحائزة صفقة عمومية ، تمدد أجال صلاحية العروض تلقائيا بشهر إضافي. ومهما يكن من أمر، فإن تجاوز مدة صلاحية العروض يعطي للمتعهد المعني الحق في تحيين الأسعار حسب الشروط المنصوص عليها في المادة 100 أدناه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
