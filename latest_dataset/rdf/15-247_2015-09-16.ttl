    dznorm:hasCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_66_obligation_2_8f3b5210_condition_0> ;
    dznorm:position 2 ;
    dznorm:provisionText "تحدد المصلحة المتعاقدة أجل تحضير العروض بالاستناد إلى تاريخ أول نشر لإعلان المنافسة، عندما يكون مطلوبا، في النشرة الرسمية لصفقات المتعامل العمومي أو في الصحافة أو في بوابة الصفقات العمومية"@ar ;
    dznorm:sourceArticle "art_66" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_66_right_0_5c205b39> a dznorm:Right ;
