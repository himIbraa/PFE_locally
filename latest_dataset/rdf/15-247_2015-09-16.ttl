<https://legal.dz/resource/law/2015-09-16/15-247#art_136_permission_4_71f4c146> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2015-09-16/15-247#art_136_permission_4_71f4c146_action_bc8a2d63ed> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2015-09-16/15-247#art_136_permission_4_71f4c146_role_f5ffbd93f9> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_136> ;
    dznorm:position 8 ;
    dznorm:provisionText "عندما يتجاوز مبلغ ملحق يتعلق بزيادة في الخدمات أو القيمة الإجمالية للعديد من الملاحق، باستثناء التبعات التقنية غير المتوقعة التي سبق ذكرها، نسبة خمسة عشر في المائة (15) من المبلغ الأصلي للصفقة في حالة صفقات اللوازم والدراسات والخدمات وعشرين في المائة (20%) في حالة صفقات الأشغال، فإنه يجب على المصلحة المتعاقدة أن تبرر لدى لجنة الصفقات المختصة أنه لم يتم المساس بالشروط الأصلية للمنافسة، وأنه لم يتم التراجع فيها وأن إعلان إجراء جدید، بعنوان الخدمات بالزيادة، لا يسمح بإنجاز المشروع حسب الشروط المثلى للآجال والسعر."@ar ;
    dznorm:sourceArticle "art_136" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_136_permission_4_71f4c146_action_bc8a2d63ed> a dznorm:Action ;
    rdfs:label "المتعاقدة أن تبرر لدى لجنة"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
