<https://legal.dz/resource/law/2015-09-16/15-247#version_art_203> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تؤسس بوابة إلكترونية للصفقات العمومية ، تسير من طرف الوزارة المكلفة بالمالية و الوزارة المكلفة بتكنولوجيات الإعلام والاتصال ، كل فيما يخصه ، ويحدد في هذا المجال، قرار مشترك بين الوزير المكلف بالمالية و الوزير المكلف بتكنولوجيات الإعلام والاتصال صلاحيات كل دائرة وزارية. يحدد محتوى البوابة وكيفيات تسييرها بموجب قرار من الوزير المكلف بالمالية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_203_20150916_OpEnact_00c339f8c2> ;
    dzdoc:replacementText "تؤسس بوابة إلكترونية للصفقات العمومية ، تسير من طرف الوزارة المكلفة بالمالية و الوزارة المكلفة بتكنولوجيات الإعلام والاتصال ، كل فيما يخصه ، ويحدد في هذا المجال، قرار مشترك بين الوزير المكلف بالمالية و الوزير المكلف بتكنولوجيات الإعلام والاتصال صلاحيات كل دائرة وزارية. يحدد محتوى البوابة وكيفيات تسييرها بموجب قرار من الوزير المكلف بالمالية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
