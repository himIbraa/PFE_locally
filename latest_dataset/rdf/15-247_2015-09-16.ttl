    dzdoc:definesTerm dzterm:oversight_purpose ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_1_subsubsec_3> ;
    dzdoc:eId "art_164" ;
    dzdoc:fullText "تتمثل غاية رقابة الوصاية التي تمارسها السلطة الوصية في مفهوم هذا المرسوم، في التحقق من مطابقة الصفقات التي تبرمها المصلحة المتعاقدة لأهداف الفعالية والاقتصاد والتأكد من كون العملية التي هي موضوع الصفقة تدخل فعلا في إطار البرامج والأسبقيات المرسومة للقطاع. وتعد المصلحة المتعاقدة ، عند الاستلام النهائي للمشروع، تقريرا تقييميا عن ظروف إنجازه وكلفته الإجمالية مقارنة بالهدف المسطر أصلا. ويرسل هذا التقرير، حسب طبيعة النفقة الملتزم بها إلى مسؤول الهيئة العمومية أو الوزير أو الوالي أو رئيس المجلس الشعبي البلدي المعني، وكذلك إلى هيئة الرقابة الخارجية المختصة. وترسل نسخة من هذا التقرير إلى سلطة ضبط الصفقات العمومية وتفويضات المرفق العام المنشأة بموجب أحكام المادة 213 من هذا المرسوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_164> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_164_defocc_26c519ff1ed8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_164_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_164_para_1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_164_para_2>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_164_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_164_20150916_OpEnact_f1ee6c87dc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_164_obligation_0_3d23bd12>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_164_obligation_1_1de5f5c4>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_164_obligation_2_44031987> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 164" ;
    dzdoc:position 163 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_213> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_213> ;
    dzdoc:usesTerm dzterm:apc_president,
        dzterm:contracting_authority,
        dzterm:minister,
        dzterm:oversight,
        dzterm:oversight_authority,
        dzterm:public_procurement_authority,
        dzterm:wali .

<https://legal.dz/resource/law/2015-09-16/15-247#art_205> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_6_subsec_2> ;
    dzdoc:eId "art_205" ;
    dzdoc:fullText "تستعمل المعلومات والوثائق التي تعبر على البوابة لتشكيل قاعدة بيانات في ظل احترام الأحكام التشريعية والتنظيمية المعمول بها. وبهذه الصفة، يتم حفظ ملفات الترشيحات للمتعهدين لاستعمالها في الإجراءات اللاحقة. وزيادة على ذلك، لا تطلب من المتعهدين الوثائق التي يمكن المصلحة المتعاقدة طلبها بطريقة إلكترونية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_205_permission_0_88f8dacd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_205> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_205_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_205_para_1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_205_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_205_20150916_OpEnact_57a975d94e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_205_obligation_0_d1543abb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "205" ;
    dzdoc:position 204 ;
    dzdoc:usesTerm dzterm:contracting_authorities .

<https://legal.dz/resource/law/2015-09-16/15-247#art_206> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_6_subsec_2> ;
    dzdoc:eId "art_206" ;
    dzdoc:fullText "يمكن المصلحة المتعاقدة لاختيار أحسن عرض من حيث الامتيازات الاقتصادية في حالة صفقات اقتناء اللوازم وتقديم الخدمات العادية، اللجوء : لإجراء المزاد الإلكتروني العكسي، بالسماح للمتعهدين بمراجعة أسعارهم أو عناصر أخرى من عروضهم القابلة للقياس الكمي. للفهارس الإلكترونية للمتعهدين، في إطار نظام اقتناء دائم، تنفيذا لعقد برنامج أو عقد طلبات. تحدد كيفيات تطبيق أحكام هذه المادة بموجب قرار من الوزير المكلف بالمالية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_206_permission_0_92fc216e> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2015-09-16/15-247#art_206_right_0_7d90fe42> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_206> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_206_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_206_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_206_20150916_OpEnact_d13c4f8978> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "206" ;
    dzdoc:position 205 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_206> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_206> ;
    dzdoc:usesTerm dzterm:contracting_authorities,
        dzterm:finance_minister .

<https://legal.dz/resource/law/2015-09-16/15-247#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_1_subsec_2_subsubsec_4> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "يمكن المصلحة المتعاقدة اللجوء إلى الإجراءات المكيفة عندما يتعلق الأمر بالخدمات المتعلقة بالنقل والفندقة والإطعام والخدمات القانونية، مهما كانت مبالغها . إذا تجاوز مبلغ الطلب مبلغ تقديم الخدمات المذكورة في الفقرة الأولى من المادة 13 أعلاه ، تقدم الصفقة لرقابة لجنة الصفقات المختصة التي تدرس قبل ذلك الطعون التي قد يقدمها لها المتعاملون الاقتصاديون الذين تمت استشارتهم، عند الاقتضاء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_24_permission_0_1e032937> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2015-09-16/15-247#art_24_right_0_e8a5d8ce> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_24_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_24_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_24_20150916_OpEnact_b7f4160537> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_24_obligation_0_0e1af92a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "24" ;
    dzdoc:position 23 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_13> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_13> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_24_condition_0_fc22c6e6>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_24_condition_1_e3f5bb7e> ;
    dzdoc:usesTerm dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "يمكن المتعامل المتعاقد أن يكون شخصا أو عدة أشخاص طبيعيين أو معنويين يلتزمون بمقتضى الصفقة إما فرادى وإما في إطار تجمع مؤقت لمؤسسات كما هو محدد في المادة 81 أدناه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_37_permission_0_02b0c22e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_37_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_37_20150916_OpEnact_6f8b97d5aa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_37_obligation_0_f30b4128> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 37" ;
    dzdoc:position 36 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_81> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_81> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_37_condition_0_2dfba9ed> ;
    dzdoc:usesTerm dzterm:contractor,
        dzterm:public_procurement .

<https://legal.dz/resource/law/2015-09-16/15-247#art_54> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_2_dup_1> ;
    dzdoc:eId "art_54" ;
    dzdoc:fullText "يتعين على المصلحة المتعاقدة أن تتأكد من قدرات المرشحين والمتعهدين التقنية والمهنية والمالية قبل القيام بتقييم العروض التقنية . يجب أن يستند تقييم الترشيحات إلى معايير غير تمييزية، لها علاقة بموضوع الصفقة ومتناسبة مع مداها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_54> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_54_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_54_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_54_20150916_OpEnact_570661d911> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_54_obligation_0_cd36c415>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_54_obligation_1_6dc6827c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "54" ;
    dzdoc:position 53 ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:public_procurement .

<https://legal.dz/resource/law/2015-09-16/15-247#art_58> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_2_dup_1> ;
    dzdoc:eId "art_58" ;
    dzdoc:fullText "تمسك بطاقية وطنية للمتعاملين الاقتصاديين وبطاقيات قطاعية وبطاقية على مستوى كل مصلحة متعاقدة، وتحين بانتظام . ويحدد محتوى هذه البطاقيات وشروط تحيينها بموجب قرار من الوزير المكلف بالمالية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_58> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_58_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_58_20150916_OpEnact_bf9516b00f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_58_obligation_0_1c46b5ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "58" ;
    dzdoc:position 57 ;
    dzdoc:usesTerm dzterm:minister_of_finance .

<https://legal.dz/resource/law/2015-09-16/15-247#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_3_dup_1> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "يحتوي ملف استشارة المؤسسات الذي يوضع تحت تصرف المتعهدين على جميع المعلومات الضرورية التي تمكنهم من تقديم عروض مقبولة، لا سيما ما يأتي : الوصف الدقيق لموضوع الخدمات المطلوبة أو كل المتطلبات بما في ذلك المواصفات التقنية وإثبات المطابقة، والمقاييس التي يجب أن تتوفر في المنتجات أو الخدمات، وكذلك التصاميم والرسوم والتعليمات الضرورية، إن اقتضى الأمر ذلك ، الشروط ذات الطابع الاقتصادي والتقني، والضمانات المالية، حسب الحالة، المعلومات أو الوثائق التكميلية المطلوبة من المتعهدين، اللغة أو اللغات الواجب استعمالها في تقديم التعهدات والوثائق التي تصاحبها، كيفيات التسديد وعملة العرض، إذا اقتضى الأمر ، كل الكيفيات الأخرى والشروط التي تحددها المصلحة المتعاقدة والتي يجب أن تخضع لها الصفقة ، الأجل الممنوح لتحضير العروض، أجل صلاحية العروض أو الأسعار، تاريخ وآخر ساعة لإيداع العروض والشكلية الحجية المعتمدة فيه، تاريخ وساعة فتح الأظرفة، العنوان الدقيق حيث يجب أن تودع التعهدات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_64_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_64_20150916_OpEnact_282cf793c6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 64" ;
    dzdoc:position 63 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_64_condition_0_df394f1e>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_64_condition_1_e8d178d6> ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:public_procurement .

<https://legal.dz/resource/law/2015-09-16/15-247#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "لا يمكن متعهدا أو مرشحا ، وحده أو في إطار تجمع، أن يقدم أكثر من عرض واحد في كل إجراء لإبرام صفقة عمومية . و لا يمكن نفس الشخص أن يمثل أكثر من متعهد أو مرشح في نفس الصفقة العمومية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_77_permission_0_efc1ea7a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_77_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_77_20150916_OpEnact_e2374e3fac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_77_obligation_0_2a1ef565>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_77_obligation_1_d0a18d4c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "77" ;
    dzdoc:position 76 ;
    dzdoc:usesTerm dzterm:public_procurement .

<https://legal.dz/resource/law/2015-09-16/15-247#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_8> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "تعد سلطة ضبط الصفقات العمومية وتفويضات المرفق العام المنشأة بموجب أحكام المادة 213 من هذا المرسوم، مدونة أدبيات وأخلاقيات المهنة للأعوان العموميين المتدخلين في مراقبة وإبرام وتنفيذ الصفقات العمومية وتفويضات المرفق العام ، يوافق عليها الوزير المكلف بالمالية . يطلع الأعوان العموميون المذكورون أعلاه على المدونة ، ويتعهدون باحترامها بموجب تصريح . كما يجب عليهم الإمضاء على تصريح بعدم وجود تضارب المصالح . ويرفق نموذجا هذين التصريحين بالمدونة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_88_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_88_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_88_20150916_OpEnact_322b39f9fc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_88_obligation_0_6f152954>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_88_obligation_1_fd97cc86>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_88_obligation_2_2f7daa87> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "88" ;
    dzdoc:position 87 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_213> ;
