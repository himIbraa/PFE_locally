<https://legal.dz/resource/law/2015-09-16/15-247#version_art_24> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن المصلحة المتعاقدة اللجوء إلى الإجراءات المكيفة عندما يتعلق الأمر بالخدمات المتعلقة بالنقل والفندقة والإطعام والخدمات القانونية، مهما كانت مبالغها . إذا تجاوز مبلغ الطلب مبلغ تقديم الخدمات المذكورة في الفقرة الأولى من المادة 13 أعلاه ، تقدم الصفقة لرقابة لجنة الصفقات المختصة التي تدرس قبل ذلك الطعون التي قد يقدمها لها المتعاملون الاقتصاديون الذين تمت استشارتهم، عند الاقتضاء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_24_20150916_OpEnact_b7f4160537> ;
    dzdoc:replacementText "يمكن المصلحة المتعاقدة اللجوء إلى الإجراءات المكيفة عندما يتعلق الأمر بالخدمات المتعلقة بالنقل والفندقة والإطعام والخدمات القانونية، مهما كانت مبالغها . إذا تجاوز مبلغ الطلب مبلغ تقديم الخدمات المذكورة في الفقرة الأولى من المادة 13 أعلاه ، تقدم الصفقة لرقابة لجنة الصفقات المختصة التي تدرس قبل ذلك الطعون التي قد يقدمها لها المتعاملون الاقتصاديون الذين تمت استشارتهم، عند الاقتضاء ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
