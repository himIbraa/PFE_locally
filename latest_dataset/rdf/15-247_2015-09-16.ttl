<https://legal.dz/resource/law/2015-09-16/15-247#version_art_20> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن تكون الطلبات المبرمة طبقا للإجراءات المكيفة محل سندات طلب أو في حالة الضرورة، عقود تحدد حقوق الأطراف وواجباتهم . وفيما يخص خدمات الدراسات فإنه يتعين على المصلحة المتعاقدة إبرام عقد مهما يكن مبلغ الطلب ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_20_20150916_OpEnact_7a69be8419> ;
    dzdoc:replacementText "يجب أن تكون الطلبات المبرمة طبقا للإجراءات المكيفة محل سندات طلب أو في حالة الضرورة، عقود تحدد حقوق الأطراف وواجباتهم . وفيما يخص خدمات الدراسات فإنه يتعين على المصلحة المتعاقدة إبرام عقد مهما يكن مبلغ الطلب ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_20> ;
