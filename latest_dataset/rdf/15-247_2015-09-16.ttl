<https://legal.dz/resource/law/2015-09-16/15-247#art_185_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_185> ;
    dzdoc:position 0 ;
    dzdoc:text "تتشكل اللجنة القطاعية للصفقات كما يأتي : الوزير المعني أو ممثله، رئيسا، ممثل الوزير المعني، نائب رئيس، ممثل المصلحة المتعاقدة، ممثلان (2) عن القطاع المعني، ممثلان (2) عن وزير المالية (المديرية العامة للميزانية والمديرية العامة للمحاسبة)، ممثل عن الوزير المكلف بالتجارة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_186_condition_0_43dc6546> a dznorm:Condition ;
    dznorm:conditionText "في حالة غياب رئيسها أو حدوث مانع له"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_186> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_186_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_186> ;
    dzdoc:position 0 ;
    dzdoc:text "يرأس اللجنة القطاعية للصفقات في حالة غياب رئيسها أو حدوث مانع له، نائب الرئيس المذكور في المادة 185 أعلاه."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_187_obligation_0_6b443653> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2015-09-16/15-247#art_187_obligation_0_6b443653_role_72eff8e429> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_187> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعين الوزير المعني، بموجب قرار أعضاء اللجنة القطاعية للصفقات ومستخلفيهم بأسمائهم، بناء على اقتراح الوزير الذي يخضعون لسلطته"@ar ;
    dznorm:sourceArticle "art_187" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_187_obligation_0_6b443653_role_72eff8e429> a dznorm:Role ;
