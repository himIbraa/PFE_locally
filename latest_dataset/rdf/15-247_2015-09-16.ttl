<https://legal.dz/resource/law/2015-09-16/15-247#art_28_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_28> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن المصلحة المتعاقدة أن تبرم صفقة عمومية واحدة أو أكثر بهدف تلبية حاجة معينة خاصة بالتسيير أو الاستثمار."@ar .

