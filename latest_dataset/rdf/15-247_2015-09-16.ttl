<https://legal.dz/resource/law/2015-09-16/15-247#art_12_condition_0_97a2b93e> a dznorm:Condition ;
    dznorm:conditionText "في حالة الاستعجال الملح المعلل بخطر داهم يتعرض له ملك أو استثمار قد تجسد في الميدان أو وجود خطر يهدد استثمارا أو ملكا للمصلحة المتعاقدة، أو الأمن العمومي ولا يسعه التكيف مع أجال إجراءات إبرام الصفقات العمومية، بشرط أنه لم يكن في وسع المصلحة المتعاقدة توقع الظروف المسببة لحالات الاستعجال، وأن لا تكون نتيجة مناورات للمماطلة من طرفها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_12> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_12_condition_1_b855cd8d> a dznorm:Condition ;
    dznorm:conditionText "عندما لا يسمح الاستعجال الملح بإعداد الصفقة قبل الشروع في بداية تنفيذ الخدمات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_12> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_12_obligation_0_4a56c558> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
