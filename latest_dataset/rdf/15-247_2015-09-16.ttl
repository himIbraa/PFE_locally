    dznorm:provisionText "تضبط المصلحة المتعاقدة، لتحديد حدود اختصاص لجان الصفقات، المبلغ الإجمالي للحاجات مع أخذ ما يأتي وجوبا بعين الاعتبار"@ar ;
    dznorm:sourceArticle "art_27" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_27_obligation_7_264e473b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2015-09-16/15-247#art_27_obligation_7_264e473b_action_6ef33af46f> ;
