<https://legal.dz/resource/law/2015-09-16/15-247#art_215_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_215> ;
    dzdoc:position 0 ;
    dzdoc:text "تلغى أحكام المرسوم الرئاسي رقم 10-236 المؤرخ في 28 شوال عام 1431 الموافق 7 أكتوبر سنة 2010 والمتضمن تنظيم الصفقات العمومية، المعدل والمتمم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_216_condition_0_23fafab4> a dznorm:Condition ;
