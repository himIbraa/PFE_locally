<https://legal.dz/resource/law/2015-09-16/15-247#art_100_condition_0_d723bbdf> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/2015-09-16/15-247#art_100_condition_0_d723bbdf_role_ea2bee43aa> ;
    dznorm:conditionText "إذا ورد في الصفقة بند ينص على تحيين الأسعار"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_100> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_100_condition_0_d723bbdf_role_ea2bee43aa> a dznorm:Role ;
    rdfs:label "تحيين الأسعار"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "إذا ورد في الصفقة بند ينص على تحيين الأسعار"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_100> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_100_condition_1_c4049560> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يتسبب في ذلك المتعامل المتعاقد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_100> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_100_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_100> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا ورد في الصفقة بند ينص على تحيين الأسعار، فإن تطبيق هذا البند يتوقف على الشروط الآتية : يحدد مبلغ التحيين بتطبيق صيغة مراجعة الأسعار دون الجزء الثابت التي ينبغي أن تستعمل كمرجع، باستثناء الحالات المبررة كما ينبغي، حتى وإن كانت الأسعار غير قابلة للمراجعة، لا يمكن تطبيق تحيين الأسعار إلا على الفترة التي تتراوح بين تاريخ آخر أجل لصلاحية العرض وتاريخ تبليغ الأمر بالشروع في الخدمات التعاقدية."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_100_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_100> ;
    dzdoc:position 1 ;
    dzdoc:text "الأرقام الاستدلالية القاعدية (I) التي يجب مراعاتها هي أرقام شهر نهاية صلاحية العرض."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_100_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_100> ;
    dzdoc:position 2 ;
    dzdoc:text "غير أنه، يمكن السماح بتحيين الأسعار في حالة التأخر في بداية تنفيذ الصفقة إذا لم يتسبب في ذلك المتعامل المتعاقد."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_100_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_100> ;
    dzdoc:position 3 ;
    dzdoc:text "وتطبق هذه الأحكام كذلك على الصفقات المبرمة بأسعار ثابتة وغير قابلة للمراجعة."@ar .

