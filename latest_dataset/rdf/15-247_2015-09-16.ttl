dzterm:bid_opening_evaluation_committee a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "لجنة فتح الأظرفة وتقييم العروض"@ar .

dzterm:competition a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المسابقة"@ar,
        "المسابقة هي إجراء يضع رجال الفن في منافسة لاختيار، بعد رأي لجنة التحكيم المذكورة في المادة 48 أدناه ، مخطط أو مشروع مصمم استجابة لبرنامج أعده صاحب المشروع، قصد إنجاز عملية تشتمل على جوانب تقنية أو اقتصادية أو جمالية أو فنية خاصة، قبل منح الصفقة لأحد الفائزين بالمسابقة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_47_defocc_3f8d84a14ccc> .

dzterm:concession a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الامتياز"@ar,
        "الامتياز تعهد السلطة المفوضة للمفوض له إما إنجاز منشآت أو اقتناء ممتلكات ضرورية لإقامة المرفق العام واستغلاله، وإما تعهد له فقط باستغلال المرفق العام."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_210_defocc_e08555454509> .

dzterm:contracting_party a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المتعامل المتعاقد"@ar .

dzterm:incentive_agency a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوكالة المحفزة"@ar,
        "الوكالة المحفزة : تعهد السلطة المفوضة للمفوض له بتسيير أو بتسيير وصيانة المرفق العام."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_210_defocc_b05715e2c246> .

dzterm:joint_consortium a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التجمع المؤقت لمؤسسات متضامنة"@ar,
        "تجمع مؤقت لمؤسسات متضامنة"@ar,
        "تجمعات مؤقتة لمؤسسات متضامنة"@ar,
        "يكون التجمع المؤقت لمؤسسات متضامنة، عندما يلتزم كل عضو من أعضاء التجمع بتنفيذ الصفقة كاملة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_81_defocc_5c756128ea7f> .

dzterm:lease a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الإيجار"@ar,
        "الإيجار: تعهد السلطة المفوضة للمفوض له بتسيير مرفق عام وصيانته مقابل إتاوة سنوية يدفعها لها."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_210_defocc_8f12029bb254> .

dzterm:limited_tender a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "طلب العروض المحدود"@ar,
        "طلب العروض المحدود هو إجراء لاستشارة انتقائية، يكون المرشحون الذين تم انتقاؤهم الأولي من قبل مدعوين وحدهم لتقديم تعهد."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_45_defocc_2633d108a759> .

dzterm:lump_sum_advance a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التسبيق الجزافي"@ar .

dzterm:management a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التسيير"@ar,
        "التسيير: تعهد السلطة المفوضة للمفوض له بتسيير أو بتسيير وصيانة المرفق العام."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_210_defocc_41ba011e9aab> .

dzterm:order_contract a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تشتمل صفقة الطلبات على إنجاز الأشغال أو اقتناء اللوازم أو تقديم الخدمات أو إنجاز الدراسات ذات النمط العادي والطابع المتكرر."@ar,
        "صفقات الطلبات"@ar,
        "صفقة الطلبات"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_34_defocc_33cf4d4791e7> .

dzterm:payment_on_account a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الدفع على الحساب"@ar,
        "الدفع على الحساب : هو كل دفع تقوم به المصلحة المتعاقدة مقابل تنفيذ جزئي لموضوع الصفقة"@ar,
        "دفع على الحساب"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_109_defocc_aa9296ead7bc> .

dzterm:public_service a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المرفق العام"@ar,
        "مرفق عام"@ar .

dzterm:services_contract a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تهدف الصفقة العمومية للخدمات المبرمة مع متعهد خدمات إلى إنجاز تقديم خدمات وهي صفقة عمومية تختلف عن صفقات الأشغال أو اللوازم أو الدراسات."@ar,
        "صفقة خدمات"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_29_defocc_bbf07aa35f77> .

dzterm:shared_consortium a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التجمع المؤقت لمؤسسات مشاركة"@ar,
        "تجمع مؤقت لمؤسسات متشاركة"@ar,
        "ويكون التجمع المؤقت لمؤسسات مشاركة ، عندما يلتزم كل عضو من أعضاء التجمع بتنفيذ الخدمات التي وضعت على عاتقه"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_81_defocc_8c8e48f88829> .

dzterm:study_contract a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الصفقة العمومية للدراسات"@ar,
        "تهدف الصفقة العمومية للدراسات إلى إنجاز خدمات فكرية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_29_defocc_1610d7aa2a21> .

dzterm:supply_contract a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الصفقة العمومية للوازم"@ar,
        "تهدف الصفقة العمومية للوازم إلى اقتناء أو إيجار أو بيع بالإيجار، بخيار أو بدون خيار الشراء، من طرف المصلحة المتعاقدة ، لعتاد أو مواد، مهما كان شكلها، موجهة لتلبية الحاجات المتصلة بنشاطها لدى مورد ."@ar,
        "صفقة لوازم"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_29_defocc_7ff72d5c4480> .

dzterm:tender_committee a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "لجنة الصفقات"@ar,
        "لجنة للصفقات"@ar .

dzterm:trade_minister a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوزير المكلف بالتجارة"@ar .

dzterm:work_process a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "وتتميز عملية الأشغال التي تخص منشأة واحدة أو عدة منشآت بوحدتها الوظيفية أو التقنية أو الاقتصادية"@ar,
        "وتقابل عملية الأشغال مجموعة أشغال مرتبطة بموضوعها وتنفذ في إقليم محدد وبنفس الطرق التقنية وتقيد في تمويل يرصد لهذا الغرض، والتي قررت المصلحة المتعاقدة إنجازها في آن واحد أو في تواريخ متقاربة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_27_defocc_a75536ca3b59>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_27_defocc_d635fa607617> .

dzterm:works_contract a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الصفقة العمومية للأشغال"@ar,
        "تهدف الصفقة العمومية للأشغال إلى إنجاز منشأة أو أشغال بناء أو هندسة مدنية من طرف مقاول، في ظل احترام الحاجات التي تحددها المصلحة المتعاقدة صاحبة المشروع."@ar,
        "صفقة أشغال"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_29_defocc_c64885aff58b> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_109_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_109> ;
    dzdoc:position 0 ;
    dzdoc:text "يقصد في مفهوم المادة 108 أعلاه بما يأتي التسبيق : هو كل مبلغ يدفع قبل تنفيذ الخدمات موضوع العقد، وبدون مقابل للتنفيذ المادي للخدمة، الدفع على الحساب : هو كل دفع تقوم به المصلحة المتعاقدة مقابل تنفيذ جزئي لموضوع الصفقة، التسوية على رصيد حساب : هو الدفع المؤقت أو النهائي للسعر المنصوص عليه في الصفقة بعد التنفيذ الكامل والمرضي لموضوعها."@ar .

