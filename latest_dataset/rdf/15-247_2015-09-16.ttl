<https://legal.dz/resource/law/2015-09-16/15-247#art_124> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_124" ;
    dzdoc:fullText "يجب على المصلحة المتعاقدة أن تحرص على إيجاد الضمانات الضرورية التي تتيح أحسن الشروط لاختيار المتعاملين معها و / أو أحسن الشروط لتنفيذ الصفقة . تحدد الضمانات المذكورة أعلاه وكذا كيفيات استرجاعها، حسب الحالة، في دفاتر الشروط أو في الأحكام التعاقدية للصفقة، استنادا إلى الأحكام القانونية أو التنظيمية المعمول بها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_124> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_124_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_124_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_124_20150916_OpEnact_c656759d56> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_124_obligation_0_8718c6f9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "124" ;
    dzdoc:position 123 ;
    dzdoc:usesTerm dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_129> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_129" ;
    dzdoc:fullText "يلزم المتعاملون المتعاقدون الأجانب، المستفيدون من هامش الأفضلية المنصوص عليه في المادة 83 من هذا المرسوم، باستعمال المواد والخدمات المنتجة محليا . ويجب على المصلحة المتعاقدة أن تتأكد من تنفيذ الالتزامات المتعهد بها في هذا الشأن ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_129> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_129_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_129_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_129_20150916_OpEnact_cbc10a7b5d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_129_obligation_0_a3352609>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_129_obligation_1_2b9ade89> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "129" ;
    dzdoc:position 128 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_83> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_83> ;
    dzdoc:usesTerm dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_137> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_5> ;
    dzdoc:eId "art_137" ;
    dzdoc:fullText "يخضع الملحق للشروط الاقتصادية الأساسية للصفقة . وفي حالة تعذر الأخذ بالأسعار التعاقدية المحددة في الصفقة ، بالنسبة للخدمات التكميلية الواردة في ملحق ، فإنه يمكن أن تحدد أسعار جديدة، عند الاقتضاء."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_137_permission_0_8bf8f450> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_137> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_137_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_137_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_137_20150916_OpEnact_226e673238> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_137_obligation_0_ab6e0ab5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "137" ;
    dzdoc:position 136 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_137_condition_0_8959b093> ;
    dzdoc:usesTerm dzterm:addendum,
        dzterm:contract .

<https://legal.dz/resource/law/2015-09-16/15-247#art_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_1_subsec_2_subsubsec_2> ;
    dzdoc:eId "art_14" ;
    dzdoc:fullText "يجب أن تكون الحاجات المذكورة أعلاه محل إشهار ملائم واستشارة متعاملين اقتصاديين مؤهلين، كتابيا، لانتقاء أحسن عرض من حيث المزايا الاقتصادية . وتنظم المصلحة المتعاقدة إجراء الاستشارة حسب طبيعة الحاجات الواجب تلبيتها مع الأخذ بعين الاعتبار عدد المتعاملين الاقتصاديين الذين بإمكانهم الاستجابة لها ، مع مراعاة أحكام المادة 5 من هذا المرسوم. يعلن عن عدم جدوى الاستشارة حسب الشروط المنصوص عليها في الفقرة 7 من المادة 52 من هذا المرسوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_14_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_14_para_1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_14_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_14_20150916_OpEnact_688cde4e53> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_14_obligation_0_e2b79fc5>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_14_obligation_1_a3eb81a1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "14" ;
    dzdoc:position 13 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_5>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_5>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:usesTerm dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_183> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_2> ;
    dzdoc:eId "art_183" ;
    dzdoc:fullText "تتولى اللجنة القطاعية للصفقات في مجال التنظيم، ما يأتي: تقترح أي تدبير من شأنه تحسين ظروف مراقبة صحة إبرام الصفقات العمومية ، تقترح النظام الداخلي النموذجي الذي يحكم عمل لجان الصفقات المذكور في المادتين 177 و 190 من هذا المرسوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_183> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_183_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_183_20150916_OpEnact_bd2949187f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 183" ;
    dzdoc:position 182 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_177>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_190> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_177>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_190> ;
    dzdoc:usesTerm dzterm:public_procurement,
        dzterm:sectoral_commission .

<https://legal.dz/resource/law/2015-09-16/15-247#art_187> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_2> ;
    dzdoc:eId "art_187" ;
    dzdoc:fullText "يعين الوزير المعني ، بموجب قرار أعضاء اللجنة القطاعية للصفقات ومستخلفيهم بأسمائهم، بناء على اقتراح الوزير الذي يخضعون لسلطته . ويختارون لذلك نظرا لكفاءتهم. وباستثناء الرئيس ونائب الرئيس يعين أعضاء اللجنة القطاعية للصفقات ومستخلفوهم من قبل إداراتهم بأسمائهم بهذه الصفة لمدة ثلاث (3) سنوات قابلة للتجديد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_187> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_187_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_187_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_187_20150916_OpEnact_653fa4b571> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_187_obligation_0_6b443653>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_187_obligation_1_0a4d602c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "187" ;
    dzdoc:position 186 ;
    dzdoc:usesTerm dzterm:minister,
        dzterm:sectoral_procurement_committee .

<https://legal.dz/resource/law/2015-09-16/15-247#art_198> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_3> ;
    dzdoc:eId "art_198" ;
    dzdoc:fullText "إذا لم تصدر التأشيرة في الآجال المحددة ، تخطر المصلحة المتعاقدة الرئيس الذي يجمع لجنة الصفقات المختصة في غضون الثمانية (8) أيام الموالية لهذا الإخطار . و يجب على هذه اللجنة أن تبت في الأمر حال انعقاد الجلسة بالأغلبية البسيطة للأعضاء الحاضرين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_198> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_198_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_198_20150916_OpEnact_1001f33203> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_198_obligation_0_3071d484>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_198_obligation_1_c60c3c05> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 198" ;
    dzdoc:position 197 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_198_condition_0_434dff38> ;
    dzdoc:usesTerm dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_1_subsec_2_subsubsec_2> ;
    dzdoc:eId "art_20" ;
    dzdoc:fullText "يجب أن تكون الطلبات المبرمة طبقا للإجراءات المكيفة محل سندات طلب أو في حالة الضرورة، عقود تحدد حقوق الأطراف وواجباتهم . وفيما يخص خدمات الدراسات فإنه يتعين على المصلحة المتعاقدة إبرام عقد مهما يكن مبلغ الطلب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_20> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_20_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_20_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_20_20150916_OpEnact_7a69be8419> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_20_obligation_0_70ff2ea4>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_20_obligation_1_9a5566ec> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "20" ;
    dzdoc:position 19 ;
    dzdoc:usesTerm dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_3_dup_1> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "يجب أن يحتوي إعلان طلب العروض على البيانات الإلزامية الآتية : تسمية المصلحة المتعاقدة وعنوانها ورقم تعريفها الجبائي، كيفية طلب العروض، شروط التأهيل أو الانتقاء الأولي، موضوع العملية، قائمة موجزة بالمستندات المطلوبة مع إحالة القائمة المفصلة إلى أحكام دفتر الشروط ذات الصلة، مدة تحضير العروض ومكان إيداع العروض، مدة صلاحية العروض، إلزامية كفالة التعهد، إذا اقتضى الأمر ، تقديم العروض في ظرف مغلق بإحكام، تكتب عليه عبارة \"لا يفتح إلا من طرف لجنة فتح الأظرفة وتقييم العروض\" ومراجع طلب العروض، ثمن الوثائق، عند الاقتضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_62_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_62_20150916_OpEnact_14542b485e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_62_obligation_0_41a933ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 62" ;
    dzdoc:position 61 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_62_condition_0_e8d178d6>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_62_condition_1_1b1645cd> ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:tender_specifications .

