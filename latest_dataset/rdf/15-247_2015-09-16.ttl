<https://legal.dz/resource/law/2015-09-16/15-247#version_art_110> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تدفع التسبيقات إلا في حالة الصفقات العمومية التي يفوق مبلغها الحدود المنصوص عليها في المادة 13 من هذا المرسوم ، و إذا قدم المتعامل المتعاقد مسبقا كفالة بقيمة معادلة بإرجاع تسبيقات يصدرها بنك خاضع للقانون الجزائري أو صندوق ضمان الصفقات العمومية، بالنسبة للمتعهدين الجزائريين . و يجب أن تصدر كفالة المتعهدين الأجانب من بنك خاضع للقانون الجزائري، يشملها ضمان مقابل صادر عن بنك أجنبي من الدرجة الأولى . وتحرر كفالة إرجاع التسبيقات حسب نموذج يحدد بموجب قرار من الوزير المكلف بالمالية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_110_20150916_OpEnact_2427334f26> ;
    dzdoc:replacementText "لا تدفع التسبيقات إلا في حالة الصفقات العمومية التي يفوق مبلغها الحدود المنصوص عليها في المادة 13 من هذا المرسوم ، و إذا قدم المتعامل المتعاقد مسبقا كفالة بقيمة معادلة بإرجاع تسبيقات يصدرها بنك خاضع للقانون الجزائري أو صندوق ضمان الصفقات العمومية، بالنسبة للمتعهدين الجزائريين . و يجب أن تصدر كفالة المتعهدين الأجانب من بنك خاضع للقانون الجزائري، يشملها ضمان مقابل صادر عن بنك أجنبي من الدرجة الأولى . وتحرر كفالة إرجاع التسبيقات حسب نموذج يحدد بموجب قرار من الوزير المكلف بالمالية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_110> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
