    dzdoc:eId "art_91" ;
    dzdoc:fullText "تتنافى العضوية في لجنة التحكيم والعضوية و / أو صفة مقرر في لجنة الصفقات العمومية مع العضوية في لجنة فتح الأظرفة وتقييم العروض، عندما يتعلق الأمر بنفس الملف ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_91> ;
