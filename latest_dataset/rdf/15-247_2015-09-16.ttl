<https://legal.dz/resource/law/2015-09-16/15-247#version_art_187> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعين الوزير المعني ، بموجب قرار أعضاء اللجنة القطاعية للصفقات ومستخلفيهم بأسمائهم، بناء على اقتراح الوزير الذي يخضعون لسلطته . ويختارون لذلك نظرا لكفاءتهم. وباستثناء الرئيس ونائب الرئيس يعين أعضاء اللجنة القطاعية للصفقات ومستخلفوهم من قبل إداراتهم بأسمائهم بهذه الصفة لمدة ثلاث (3) سنوات قابلة للتجديد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_187_20150916_OpEnact_653fa4b571> ;
    dzdoc:replacementText "يعين الوزير المعني ، بموجب قرار أعضاء اللجنة القطاعية للصفقات ومستخلفيهم بأسمائهم، بناء على اقتراح الوزير الذي يخضعون لسلطته . ويختارون لذلك نظرا لكفاءتهم. وباستثناء الرئيس ونائب الرئيس يعين أعضاء اللجنة القطاعية للصفقات ومستخلفوهم من قبل إداراتهم بأسمائهم بهذه الصفة لمدة ثلاث (3) سنوات قابلة للتجديد ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
