<https://legal.dz/resource/law/2015-09-16/15-247#art_70_obligation_7_f68b7fff> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
