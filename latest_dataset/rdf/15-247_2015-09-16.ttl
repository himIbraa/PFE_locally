    dznorm:sourceArticle "art_87" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_87_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_87> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما يمكن تلبية بعض حاجات المصالح المتعاقدة من قبل المؤسسات المصغرة، كما هي معرفة في التشريع والتنظيم المعمول بهما، فإنه يجب على المصالح المتعاقدة إلا في الحالات الاستثنائية المبررة قانونا كما ينبغي، تخصيص هذه الخدمات لها حصريا مع مراعاة أحكام هذا المرسوم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_87_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_87> ;
    dzdoc:position 1 ;
    dzdoc:text "يجب على المصلحة المتعاقدة تبرير الاستثناء المذكور في الفقرة السابقة، حسب الحالة في التقرير التقديمي لمشروع الصفقة أو الاستشارة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_87_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_87> ;
    dzdoc:position 2 ;
    dzdoc:text "يمكن أن تكون الحاجات المذكورة أعلاه، في حدود عشرين في المائة (20) على الأكثر من الطلب العام، حسب الحالة، محل دفتر شروط منفصل أو حصة من دفتر شروط مخصص، بغض النظر عن الأحكام المخالفة لالمادة 27 من هذا المرسوم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_87_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_87> ;
    dzdoc:position 3 ;
    dzdoc:text "لا يمكن بأي حال من الأحوال أن تتجاوز المبالغ السنوية القصوى مع احتساب كل الرسوم الممنوحة لكل مؤسسة مصغرة في هذا الإطار، المبالغ الآتية : اثني عشر مليون دينار (12.000.000 دج لخدمات الأشغال (هندسة مدنية وطرقات)، سبعة ملايين دينار (7.000.000 دج لخدمات الأشغال (أشغال البناء التقنية وأشغال البناء الثانوية)، مليوني دينار (2.000.000 دج) لخدمات الدراسات، أربعة ملايين دينار (4.000.000 دج) للخدمات، سبعة ملايين دينار (7.000.000 دج لخدمات اللوازم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_87_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_87> ;
    dzdoc:position 4 ;
    dzdoc:text "إذا تطلبت الظروف الاقتصادية ذلك، فإنه يمكن تحيين المبالغ المذكورة أعلاه، بصفة دورية، بموجب قرار من الوزير المكلف بالمالية."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_87_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_87> ;
    dzdoc:position 5 ;
    dzdoc:text "يتعين على المصالح المتعاقدة إبلاغ الهيئات المكلفة بترقية إنشاء المؤسسات المصغرة بكل المعلومات التي تخص منح الخدمات المذكورة أعلاه وتنفيذها."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_87_para_6> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_87> ;
    dzdoc:position 6 ;
    dzdoc:text "وتكلف هذه الهيئات بإبلاغ المصالح المتعاقدة المعنية بكل المعلومات الضرورية لتطبيق أحكام هذه المادة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_87_para_7> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_87> ;
    dzdoc:position 7 ;
    dzdoc:text "ويتم تبادل المعلومات المذكورة أعلاه، عن طريق الإرسال مع الإشعار بالاستلام."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_87_para_8> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_87> ;
    dzdoc:position 8 ;
    dzdoc:text "يجب على المصلحة المتعاقدة أن لا تشترط على المؤسسات المصغرة المنشأة حديثا التي لا يمكنها أن تقدم، على الأقل، حصيلة السنة الأولى من وجودها، إلا وثيقة من البنك أو من الهيئة المالية المعنية تبرر وضعيتها المالية. كما لا تشترط عليها المصلحة المتعاقدة المؤهلات المهنية المماثلة للصفقة المعنية، بل تأخذ بعين الاعتبار تلك المثبتة بالشهادات."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_87_para_9> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_87> ;
    dzdoc:position 9 ;
    dzdoc:text "توضح كيفيات تطبيق أحكام هذه المادة، عند الحاجة، بقرار من الوزير المكلف بالمالية."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_87_permission_0_fa6fd19d> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
