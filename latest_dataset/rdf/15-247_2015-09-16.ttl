<https://legal.dz/resource/law/2015-09-16/15-247#art_123> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_123" ;
    dzdoc:fullText "يمكن المصلحة المتعاقدة أن تمنح ، بصفة استثنائية، تسبيقا على دفع الحساب المنصوص عليه في المادة 108 من هذا المرسوم، مع مراعاة الأحكام التشريعية والتنظيمية المعمول بها وحسب الشروط الصريحة الآتية : إذا انقضى الأجل التعاقدي لتسوية طلب الدفع على الحساب الذي قدمه المتعامل المتعاقد ، يجب ألا يتجاوز مبلغ التسبيق، بأي حال من الأحوال، نسبة ثمانين في المائة (80%) من مبلغ الدفع على الحساب ، لا يجوز أن تتجاوز الاستفادة من هذا التسبيق الإضافي لدى جمعها مع التسبيقات الممنوحة، بأي حال من الأحوال، نسبة سبعين في المائة (70%) من المبلغ الإجمالي للصفقة . ويسدد هذا التسبيق خلال الآجال والإجراءات الأكثر سرعة . وتتم تسوية ذلك حسب الكيفيات نفسها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_123_permission_0_6d213991> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_123> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_123_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_123_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
