<https://legal.dz/resource/law/2015-09-16/15-247#art_149> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_10> ;
    dzdoc:eId "art_149" ;
    dzdoc:fullText "إذا لم ينفذ المتعاقد التزاماته ، توجه له المصلحة المتعاقدة إعذارا ليفي بالتزاماته التعاقدية في أجل محدد . وإذا لم يتدارك المتعاقد تقصيره في الأجل الذي حدده الإعذار المنصوص عليه أعلاه ، فإن المصلحة المتعاقدة يمكنها أن تقوم بفسخ الصفقة العمومية من جانب واحد . و يمكنها كذلك القيام بفسخ جزئي للصفقة . يحدد الوزير المكلف بالمالية ، بموجب قرار البيانات الواجب إدراجها في الإعذار ، وكذلك آجال نشره في شكل إعلانات قانونية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2015-09-16/15-247#art_149_right_0_25c74390>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_149_right_1_2a0f4f03> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_149> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_149_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_149_para_1>,
