    dzdoc:sourceEId "art_195" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يخضع مشروعا الصفقة والملحق لمداولة المجلس الشعبي البلدي ومراقبة الشرعية للدولة، طبقا لأحكام القانون رقم 11-10- المؤرخ في 22 يونيو سنة 2011 والمذكور أعلاه، قبل إرسالهما إلى لجنة الصفقات المختصة"@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/2011-06-22/11-10"^^xsd:anyURI ;
