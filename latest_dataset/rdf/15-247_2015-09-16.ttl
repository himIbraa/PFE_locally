    dznorm:sourceArticle "art_187" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_187_obligation_1_0a4d602c_period_8af077789f> a dznorm:Period ;
    rdfs:label "لمدة ثلاث (3) سنوات قابلة للتجديد"@ar ;
