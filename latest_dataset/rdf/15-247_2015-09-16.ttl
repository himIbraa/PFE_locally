    dznorm:provisionText "يتعين على أعضاء اللجنة أن يشاركوا شخصيا في اجتماعاتها"@ar ;
    dznorm:sourceArticle "art_191" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_191_obligation_1_dda7f3bd_role_07577ed220> a dznorm:Role ;
