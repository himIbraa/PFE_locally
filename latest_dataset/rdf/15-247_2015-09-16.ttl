<https://legal.dz/resource/law/2015-09-16/15-247#version_art_91> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتنافى العضوية في لجنة التحكيم والعضوية و / أو صفة مقرر في لجنة الصفقات العمومية مع العضوية في لجنة فتح الأظرفة وتقييم العروض، عندما يتعلق الأمر بنفس الملف ."@ar ;
    dzdoc:isAuthoritative true ;
