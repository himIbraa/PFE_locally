<https://legal.dz/resource/law/2015-09-16/15-247#version_art_25> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبرم الصفقات العمومية المتعلقة بتكاليف الماء والغاز والكهرباء والهاتف والأنترنت طبقا لأحكام المادة 34 من هذا المرسوم. ويمكن أن تكون الطلبات المتعلقة بـ الصفقات العمومية المذكورة أعلاه، محل تسوية استثنائيا، فور تبليغ الاعتمادات بغض النظر عن الأحكام المخالفة لـ المادة 27 أدناه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_25_20150916_OpEnact_0c5e207e17> ;
    dzdoc:replacementText "تبرم الصفقات العمومية المتعلقة بتكاليف الماء والغاز والكهرباء والهاتف والأنترنت طبقا لأحكام المادة 34 من هذا المرسوم. ويمكن أن تكون الطلبات المتعلقة بـ الصفقات العمومية المذكورة أعلاه، محل تسوية استثنائيا، فور تبليغ الاعتمادات بغض النظر عن الأحكام المخالفة لـ المادة 27 أدناه."@ar ;
