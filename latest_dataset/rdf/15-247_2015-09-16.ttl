<https://legal.dz/resource/law/2015-09-16/15-247#version_art_56> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تستعلم المصلحة المتعاقدة ، أثناء تقييم الترشيحات عند الاقتضاء، عن قدرات المتعهدين حتى يكون اختيارها لهم اختيارا سديدا ، مستعملة في ذلك كل وسيلة قانونية، ولا سيما لدى مصالح متعاقدة أخرى، وإدارات وهيئات مكلفة بمهمة المرفق العمومي، ولدى البنوك والممثليات الجزائرية في الخارج."@ar ;
    dzdoc:isAuthoritative true ;
