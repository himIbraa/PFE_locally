<https://legal.dz/resource/law/2015-09-16/15-247#art_103_condition_0_d6e8a0bb> a dznorm:Condition ;
    dznorm:conditionText "تطبق هذه الأرقام الاستدلالية ابتداء من تاريخ التصديق والموافقة عليها بقرار من الوزير الذي تتبعه الهيئة المعنية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_103> ;
