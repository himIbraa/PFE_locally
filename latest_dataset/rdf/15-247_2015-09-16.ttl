<https://legal.dz/resource/law/2015-09-16/15-247#art_45_obligation_3_f0fc6657> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2015-09-16/15-247#art_45_obligation_3_f0fc6657_action_73e2c9d5dc> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_45> ;
    dznorm:position 3 ;
    dznorm:provisionText "تحدد قائمة المشاريع التي يمكن أن تكون موضوع طلب العروض المحدود، بموجب مقرر من مسؤول الهيئة العمومية أو الوزير المعني، بعد أخد رأي لجنة الصفقات للهيئة العمومية أو اللجنة القطاعية للصفقات، حسب الحالة."@ar ;
    dznorm:sourceArticle "art_45" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_45_obligation_3_f0fc6657_action_73e2c9d5dc> a dznorm:Action ;
    rdfs:label "أن تكون موضوع طلب العروض"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "تحدد قائمة المشاريع التي يمكن أن تكون موضوع طلب العروض المحدود، بموجب مقرر من مسؤول الهيئة العمومية أو الوزير المعني، بعد أخد رأي لجنة الصفقات للهيئة العمومية أو اللجنة القطاعية للصفقات، حسب الحالة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_45> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_45_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_45> ;
    dzdoc:position 1 ;
    dzdoc:text "يمكن المصلحة المتعاقدة أن تحدد في دفتر الشروط العدد الأقصى للمرشحين الذين ستتم دعوتهم لتقديم تعهد، بعد انتقاء أولى بخمسة (5) منهم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_45_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_45> ;
    dzdoc:position 2 ;
    dzdoc:text "وتنفذ المصلحة المتعاقدة الانتقاء الأولي لاختيار المرشحين لإجراء المنافسة عندما يتعلق الأمر بالدراسات أو بالعمليات المعقدة و / أو ذات الأهمية الخاصة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_45_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_45> ;
    dzdoc:position 3 ;
    dzdoc:text "ويجري اللجوء إلى طلب العروض المحدود، عند تسلم العروض التقنية، إما على مرحلتين طبقا لأحكام المادة 46 أدناه، وإما على مرحلة واحدة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_45_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_45> ;
    dzdoc:position 4 ;
    dzdoc:text "1 على مرحلة واحدة : عندما يطلق الإجراء على أساس مواصفات تقنية مفصلة معدة بالرجوع لمقاييس و/أو نجاعة يتعين بلوغها أو متطلبات وظيفية."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_45_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_45> ;
    dzdoc:position 5 ;
    dzdoc:text "2 على مرحلتين : استثناء، عندما يطلق الإجراء على أساس برنامج وظيفي، إذا لم تكن المصلحة المتعاقدة قادرة على تحديد الوسائل التقنية لتلبية حاجاتها، حتى بصفقة دراسات."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_45_para_6> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_45> ;
    dzdoc:position 6 ;
    dzdoc:text "كما يمكن المصلحة المتعاقدة القيام باستشارة مباشرة للمتعاملين الاقتصاديين المؤهلين والمسجلين في قائمة مفتوحة تعدها المصلحة المتعاقدة على أساس انتقاء أولي، بمناسبة إنجاز عمليات دراسات أو هندسة مركبة أو ذات أهمية خاصة و/أو عمليات اقتناء لوازم خاصة ذات طابع تكراري. وفي هذه الحالة، يجب تجديد الانتقاء الأولي كل ثلاث (3) سنوات."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_45_para_7> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_45> ;
    dzdoc:position 7 ;
    dzdoc:text "ويجب أن يتم النص على كيفيات الانتقاء الأولي والاستشارة في إطار طلب العروض المحدود في دفتر الشروط."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_45_para_8> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_45> ;
    dzdoc:position 8 ;
    dzdoc:text "تحدد قائمة المشاريع التي يمكن أن تكون موضوع طلب العروض المحدود، بموجب مقرر من مسؤول الهيئة العمومية أو الوزير المعني، بعد أخد رأي لجنة الصفقات للهيئة العمومية أو اللجنة القطاعية للصفقات، حسب الحالة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_45_para_9> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_45> ;
    dzdoc:position 9 ;
    dzdoc:text "توضح كيفيات تطبيق أحكام هذه المادة، عند الحاجة، بموجب قرار من الوزير المكلف بالمالية."@ar .

