<https://legal.dz/resource/law/2015-09-16/15-247#version_art_199> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتولى الكتابة الدائمة للجنة الموضوعة تحت سلطة رئيس اللجنة القيام بمجموع المهام المادية التي يقتضيها عملها، لا سيما منها ما يأتي : التأكد من أن الملف المقدم كامل بالاستناد إلى أحكام هذا المرسوم وحسب ما هو مبين في النظام الداخلي، تسجيل ملفات مشاريع الصفقات ومشاريع الملاحق، وكذلك أية وثيقة تكميلية، وإعطاء إشعار بالتسليم مقابل ذلك، إعداد جدول الأعمال، إعداد استدعاءات أعضاء اللجنة وممثلي المصلحة المتعاقدة والمستشارين المحتملين، إرسال الملفات إلى المقررين إرسال المذكرة التحليلية لمشروع الصفقة أو الملح"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_199_20150916_OpEnact_58a50914bf> ;
    dzdoc:replacementText "تتولى الكتابة الدائمة للجنة الموضوعة تحت سلطة رئيس اللجنة القيام بمجموع المهام المادية التي يقتضيها عملها، لا سيما منها ما يأتي : التأكد من أن الملف المقدم كامل بالاستناد إلى أحكام هذا المرسوم وحسب ما هو مبين في النظام الداخلي، تسجيل ملفات مشاريع الصفقات ومشاريع الملاحق، وكذلك أية وثيقة تكميلية، وإعطاء إشعار بالتسليم مقابل ذلك، إعداد جدول الأعمال، إعداد استدعاءات أعضاء اللجنة وممثلي المصلحة المتعاقدة والمستشارين المحتملين، إرسال الملفات إلى المقررين إرسال المذكرة التحليلية لمشروع الصفقة أو الملحق والتقرير التقديمي إلى أعضاء اللجنة، إرسال ملفات مشاريع دفاتر الشروط والطعون إلى أعضاء اللجنة، تحرير التأشيرات والمذكرات ومحاضر الجلسات، إعداد التقارير الفصلية عن النشاط، تمكين أعضاء اللجنة من الاطلاع على المعلومات والوثائق الموجودة لديها، متابعة رفع التحفظات المنصوص عليها في المادة 195 من هذا المرسوم بالاتصال مع المقرر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_199> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_199> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2015-09-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2015-09-16/15-247#version_art_2> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الصفقات العمومية عقود مكتوبة في مفهوم التشريع المعمول به تبرم بمقابل مع متعاملين اقتصاديين وفق الشروط المنصوص عليها في هذا المرسوم ، لتلبية حاجات المصلحة المتعاقدة في مجال الأشغال واللوازم والخدمات والدراسات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_2_20150916_OpEnact_08f385cea4> ;
    dzdoc:replacementText "الصفقات العمومية عقود مكتوبة في مفهوم التشريع المعمول به تبرم بمقابل مع متعاملين اقتصاديين وفق الشروط المنصوص عليها في هذا المرسوم ، لتلبية حاجات المصلحة المتعاقدة في مجال الأشغال واللوازم والخدمات والدراسات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_2> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
