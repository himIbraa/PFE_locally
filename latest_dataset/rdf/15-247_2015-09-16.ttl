    dzdoc:evidenceText "يمكن المصلحة المتعاقدة أن تطلب من المتعهدين تدعيم عروضهم بعينات أو نماذج أو تصاميم عندما تستدعي مقارنة العروض فيما بينها ذلك . ويجب أن ينص دفتر الشروط على كيفيات تقديمها وتقييمها وإرجاعها، عند الاقتضاء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_68_20150916_OpEnact_d6d53d1a7e> ;
    dzdoc:replacementText "يمكن المصلحة المتعاقدة أن تطلب من المتعهدين تدعيم عروضهم بعينات أو نماذج أو تصاميم عندما تستدعي مقارنة العروض فيما بينها ذلك . ويجب أن ينص دفتر الشروط على كيفيات تقديمها وتقييمها وإرجاعها، عند الاقتضاء ."@ar ;
