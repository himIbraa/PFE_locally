<https://legal.dz/resource/law/2015-09-16/15-247#art_136_condition_2_ebb55ab7> a dznorm:Condition ;
    dznorm:conditionText "إذا قرر مسؤول الهيئة العمومية أو الوزير أو الوالي المعني ذلك، شريطة أن لا يكون في وسع المصلحة المتعاقدة توقع الظروف التي استدعت هذا التمديد، وأن لا تكون نتيجة ممارسات مماطلة من طرفها."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_136> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_136_condition_3_e86a6bec> a dznorm:Condition ;
