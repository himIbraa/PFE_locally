<https://legal.dz/resource/law/2015-09-16/15-247#art_136_obligation_5_db908bd2> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2015-09-16/15-247#art_136_obligation_5_db908bd2_action_0b59634f8d> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2015-09-16/15-247#art_136_obligation_5_db908bd2_role_f5bcb596cb> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_136> ;
    dznorm:position 5 ;
    dznorm:provisionText "يجب على المصلحة المتعاقدة أن تبرر لدى لجنة الصفقات المختصة أنه لم يتم المساس بالشروط الأصلية للمنافسة، وأنه لم يتم التراجع فيها وأن إعلان إجراء جدید، بعنوان الخدمات بالزيادة، لا يسمح بإنجاز المشروع حسب الشروط المثلى للآجال والسعر."@ar ;
    dznorm:sourceArticle "art_136" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_136_obligation_5_db908bd2_action_0b59634f8d> a dznorm:Action ;
