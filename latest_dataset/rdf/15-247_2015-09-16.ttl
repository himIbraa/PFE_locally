<https://legal.dz/resource/law/2015-09-16/15-247#version_art_44> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "طلب العروض المفتوح مع اشتراط قدرات دنيا هو إجراء يسمح فيه لكل المرشحين الذين تتوفر فيهم بعض الشروط الدنيا المؤهلة التي تحددها المصلحة المتعاقدة مسبقا قبل إطلاق الإجراء، بتقديم تعهد ولا يتم انتقاء قبلي للمرشحين من طرف المصلحة المتعاقدة. تخص الشروط المؤهلة القدرات التقنية والمالية والمهنية الضرورية لتنفيذ الصفقة. وتكون متناسبة مع طبيعة وتعقيد وأهمية المشروع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_44_20150916_OpEnact_ad87d237fe> ;
    dzdoc:replacementText "طلب العروض المفتوح مع اشتراط قدرات دنيا هو إجراء يسمح فيه لكل المرشحين الذين تتوفر فيهم بعض الشروط الدنيا المؤهلة التي تحددها المصلحة المتعاقدة مسبقا قبل إطلاق الإجراء، بتقديم تعهد ولا يتم انتقاء قبلي للمرشحين من طرف المصلحة المتعاقدة. تخص الشروط المؤهلة القدرات التقنية والمالية والمهنية الضرورية لتنفيذ الصفقة. وتكون متناسبة مع طبيعة وتعقيد وأهمية المشروع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_44> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
