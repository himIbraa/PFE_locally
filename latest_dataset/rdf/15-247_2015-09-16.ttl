dzterm:external_control a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الرقابة الخارجية"@ar .

dzterm:external_control_purpose a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تتمثل غاية الرقابة الخارجية، في مفهوم هذا المرسوم وفي إطار العمل الحكومي، في التحقق من مطابقة الصفقات العمومية المعروضة على الهيئات الخارجية المذكورة في القسم الثاني من هذا الفصل، للتشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_163_defocc_d0296a078c51> .

dzterm:financial_controller a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المراقب المالي"@ar .

dzterm:general_finance_inspectorate a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المفتشية العامة للمالية"@ar .

dzterm:government_guarantees a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الضمانات ذات الصيغة الحكومية التي تهم المؤسسات الأجنبية هي :"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_127_defocc_9a448ab40380> .

dzterm:index_numbers a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الأرقام الاستدلالية المعمول بها في صيغ مراجعة الأسعار"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_103_defocc_23bb468ada2e> .

dzterm:internal_control a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الرقابة الداخلية"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_159_defocc_a9db529fa4b9> .

dzterm:legal_person a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الشخص المعنوي الخاضع للقانون العام"@ar,
        "شخص معنوي خاضع للقانون العام"@ar,
        "للشخص المعنوي الخاضع للقانون العام"@ar .

dzterm:open_call_for_tenders a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "طلب العروض المفتوح هو إجراء يمكن من خلاله أي مترشح مؤهل أن يقدم تعهدا."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_43_defocc_ffad95258834> .

dzterm:open_call_for_tenders_with_minimum_capacities a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "طلب العروض المفتوح مع اشتراط قدرات دنيا هو إجراء يسمح فيه لكل المرشحين الذين تتوفر فيهم بعض الشروط الدنيا المؤهلة التي تحددها المصلحة المتعاقدة مسبقا قبل إطلاق الإجراء، بتقديم تعهد ولا يتم انتقاء قبلي للمرشحين من طرف المصلحة المتعاقدة."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_44_defocc_5d4387942467> .

dzterm:ordinary_supplies a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "ويقصد باللوازم العادية اللوازم الموجودة في السوق والتي هي غير مصنعة استنادا إلى مواصفات تقنية خصوصية أعدتها المصلحة المتعاقدة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_140_defocc_b4fef6db9dcf> .

dzterm:oversight_purpose a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تتمثل غاية رقابة الوصاية التي تمارسها السلطة الوصية في مفهوم هذا المرسوم، في التحقق من مطابقة الصفقات التي تبرمها المصلحة المتعاقدة لأهداف الفعالية والاقتصاد والتأكد من كون العملية التي هي موضوع الصفقة تدخل فعلا في إطار البرامج والأسبقيات المرسومة للقطاع."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_164_defocc_26c519ff1ed8> .

dzterm:performance_guarantees a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الضمانات الملائمة لحسن التنفيذ ومنها الضمانات التي تحصل عليها المصلحة المتعاقدة من المتعاملين المتعاقدين الأجانب، لا سيما في الميدان المالي، هي الضمانات النقدية التي تغطيها كفالة مصرفية يصدرها بنك خاضع للقانون الجزائري يشملها ضمان مقابل صادر عن بنك أجنبي من الدرجة الأولى"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_128_defocc_01468b6a7229> .

dzterm:procurement_committees a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "لجان الصفقات"@ar .

dzterm:program_contract a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يكتسي عقد البرنامج شكل اتفاقية سنوية أو متعددة السنوات تكون مرجعا، ويمكن أن يتداخل في سنتين ماليتين أو أكثر ، ويتم تنفيذها من خلال صفقات تطبيقية تبرم وفقا لأحكام هذا المرسوم"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_33_defocc_025e0023f1d7> .

dzterm:provisional_settlement a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تهدف التسوية على رصيد الحساب المؤقت إذا نصت عليها الصفقة، إلى دفع المبالغ المستحقة للمتعامل المتعاقد بعنوان التنفيذ العادي للخدمات المتعاقد عليها"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_119_defocc_5e960f0a8225> .

dzterm:public_body a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الهيئة العمومية"@ar .

dzterm:public_officials a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الموظفون والأعوان العموميون"@ar .

dzterm:public_service_delegations a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تفويضات المرفق العام"@ar .

