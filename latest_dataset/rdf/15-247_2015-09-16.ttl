<https://legal.dz/resource/law/2015-09-16/15-247#art_67_prohibition_0_506063a7_action_c4f6b7e7b2> a dznorm:Action ;
    rdfs:label "أن يرفق العرض بنسخة من"@ar ;
    dzdoc:confidenceScore 0.62 ;
