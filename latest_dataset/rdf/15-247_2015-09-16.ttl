    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "49" ;
    dzdoc:position 48 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_49_condition_0_110fa284>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_49_condition_1_40f48fb2>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_49_condition_2_06fd9c12>,
