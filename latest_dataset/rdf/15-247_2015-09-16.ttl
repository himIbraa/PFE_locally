<https://legal.dz/resource/law/2015-09-16/15-247#version_art_6> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تطبق أحكام هذا الباب إلا على الصفقات العمومية محل نفقات: الدولة، الجماعات الإقليمية، المؤسسات العمومية ذات الطابع الإداري، المؤسسات العمومية الخاضعة للتشريع الذي يحكم النشاط التجاري، عندما تكلف بإنجاز عملية ممولة، كليا أو جزئيا، بمساهمة مؤقتة أو نهائية من الدولة أو من الجماعات الإقليمية . وتدعى في صلب النص \" المصلحة المتعاقدة \"."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_6_20150916_OpEnact_3d2caa749f> ;
    dzdoc:replacementText "لا تطبق أحكام هذا الباب إلا على الصفقات العمومية محل نفقات: الدولة، الجماعات الإقليمية، المؤسسات العمومية ذات الطابع الإداري، المؤسسات العمومية الخاضعة للتشريع الذي يحكم النشاط التجاري، عندما تكلف بإنجاز عملية ممولة، كليا أو جزئيا، بمساهمة مؤقتة أو نهائية من الدولة أو من الجماعات الإقليمية . وتدعى في صلب النص \" المصلحة المتعاقدة \"."@ar ;
    dzdoc:resolutionStatus "resolved" ;
