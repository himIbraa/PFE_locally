<https://legal.dz/resource/law/2015-09-16/15-247#art_98> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_98" ;
    dzdoc:fullText "يمكن قبول تحيين الأسعار التي يحدد مبلغها طبقا ل المادة 100 من هذا المرسوم ، إذا كان يفصل بين التاريخ المحدد لإيداع العروض وتاريخ الأمر بالشروع في تنفيذ الخدمة، أجل يفوق مدة تحضير العرض زائد ثلاثة (3) أشهر، وكذلك إذا تطلبت الظروف الاقتصادية ذلك. الصفقات العمومية المبرمة عن طريق التراضي البسيط غير قابلة للتحيين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_98_permission_0_c607f8cf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_98> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_98_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_98_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_98_20150916_OpEnact_03e1da9a98> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 98" ;
    dzdoc:position 97 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_100> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_100> ;
