<https://legal.dz/resource/law/2015-09-16/15-247#version_art_140> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن المتعامل المتعاقد للمصلحة المتعاقدة منح تنفيذ جزء من الصفقة لمناول بواسطة عقد مناولة ، حسب الشروط المنصوص عليها في هذا المرسوم . ومهما يكن من أمر ، لا يمكن أن تتجاوز المناولة أربعين في المائة (40%) من المبلغ الإجمالي للصفقة . ولا يمكن أن تكون صفقات اللوازم العادية محل مناولة ويقصد باللوازم العادية اللوازم الموجودة في السوق والتي هي غير مصنعة استنادا إلى مواصفات تقنية خصوصية أعدتها المصلحة المتعاقدة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_140_20150916_OpEnact_4ca0ceab25> ;
    dzdoc:replacementText "يمكن المتعامل المتعاقد للمصلحة المتعاقدة منح تنفيذ جزء من الصفقة لمناول بواسطة عقد مناولة ، حسب الشروط المنصوص عليها في هذا المرسوم . ومهما يكن من أمر ، لا يمكن أن تتجاوز المناولة أربعين في المائة (40%) من المبلغ الإجمالي للصفقة . ولا يمكن أن تكون صفقات اللوازم العادية محل مناولة ويقصد باللوازم العادية اللوازم الموجودة في السوق والتي هي غير مصنعة استنادا إلى مواصفات تقنية خصوصية أعدتها المصلحة المتعاقدة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_140> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
