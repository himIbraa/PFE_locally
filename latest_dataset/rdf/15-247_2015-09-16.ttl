<https://legal.dz/resource/law/2015-09-16/15-247#art_138_obligation_1_0cd941d9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2015-09-16/15-247#art_138_obligation_1_0cd941d9_role_9d2c5da688> ;
