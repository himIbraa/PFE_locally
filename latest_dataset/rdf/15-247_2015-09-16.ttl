<https://legal.dz/resource/law/2015-09-16/15-247#version_art_151> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "زيادة على الفسخ من جانب واحد، المذكور في المادتين 149 و 150 أعلاه، يمكن القيام بالفسخ التعاقدي للصفقة العمومية ، عندما يكون مبررا بظروف خارجة عن إرادة المتعامل المتعاقد، حسب الشروط المنصوص عليها صراحة لهذا الغرض ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_151_20150916_OpEnact_45616af2d3> ;
    dzdoc:replacementText "زيادة على الفسخ من جانب واحد، المذكور في المادتين 149 و 150 أعلاه، يمكن القيام بالفسخ التعاقدي للصفقة العمومية ، عندما يكون مبررا بظروف خارجة عن إرادة المتعامل المتعاقد، حسب الشروط المنصوص عليها صراحة لهذا الغرض ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_151> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_151> ;
