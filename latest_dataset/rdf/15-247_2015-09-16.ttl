<https://legal.dz/resource/law/2015-09-16/15-247#art_83_condition_0_fc0b5199> a dznorm:Condition ;
    dznorm:conditionText "وتخضع الاستفادة من هذا الهامش في حالة ما إذا كان المتعهد تجمعا يتكون من مؤسسات خاضعة للقانون الجزائري، كما هو محدد في الفقرة السابقة، ومؤسسات أجنبية، إلى تبرير الحصص التي تحوزها المؤسسات الخاضعة للقانون الجزائري، والمؤسسات الأجنبية، من حيث الأعمال التي يتعين إنجازها ومبالغها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_83> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_83_obligation_0_bae98319> a dznorm:Obligation ;
