<https://legal.dz/resource/law/2015-09-16/15-247#version_art_115> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن أن يتجاوز المبلغ الجامع بين التسبيق الجزافي والتسبيقات على التموين بأي حال من الأحوال، نسبة خمسين في المائة (50%) من المبلغ الإجمالي للصفقة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_115_20150916_OpEnact_5b40a3c806> ;
    dzdoc:replacementText "لا يمكن أن يتجاوز المبلغ الجامع بين التسبيق الجزافي والتسبيقات على التموين بأي حال من الأحوال، نسبة خمسين في المائة (50%) من المبلغ الإجمالي للصفقة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
