    dzdoc:evidenceText "تتولى اللجنة القطاعية للصفقات في مجال التنظيم، ما يأتي: تقترح أي تدبير من شأنه تحسين ظروف مراقبة صحة إبرام الصفقات العمومية ، تقترح النظام الداخلي النموذجي الذي يحكم عمل لجان الصفقات المذكور في المادتين 177 و 190 من هذا المرسوم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
