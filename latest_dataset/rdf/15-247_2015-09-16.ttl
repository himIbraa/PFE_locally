    dznorm:position 1 ;
    dznorm:provisionText "يمكن المصلحة المتعاقدة مراعاة لاحترام الأسعار، تفضيل دفع مستحقات الصفقة وفق صيغة السعر الإجمالي والجزافي ."@ar ;
    dznorm:sourceArticle "art_96" .

