<https://legal.dz/resource/law/2015-09-16/15-247#art_8_obligation_0_6544a86c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
