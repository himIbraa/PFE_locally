<https://legal.dz/resource/law/2015-09-16/15-247#version_art_125> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المتعهدين، فيما يخص الصفقات العمومية للأشغال واللوازم التي تتجاوز مبالغها الحدود المنصوص عليها في المطتين الأولى والثانية على التوالي من المادة 184 من هذا المرسوم ، تقديم كفالة تعهد تفوق واحدا في المائة (1) من مبلغ العرض . ويجب النص على هذا المطلب في دفتر الشروط للدعوة للمنافسة. وتعد الكفالة بالرجوع لمبلغ العرض. تصدر كفالة تعهد المؤسسات الخاضعة للقانون الجزائري من طرف بنك خاضع للقانون الجزائري أو صندوق ضمان الصفقات العمومية وتصدر كفالة تعهد المتعهدين الأجانب من طرف بنك خاضع للقانون الجزا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_125_20150916_OpEnact_da847a369d> ;
    dzdoc:replacementText "يجب على المتعهدين، فيما يخص الصفقات العمومية للأشغال واللوازم التي تتجاوز مبالغها الحدود المنصوص عليها في المطتين الأولى والثانية على التوالي من المادة 184 من هذا المرسوم ، تقديم كفالة تعهد تفوق واحدا في المائة (1) من مبلغ العرض . ويجب النص على هذا المطلب في دفتر الشروط للدعوة للمنافسة. وتعد الكفالة بالرجوع لمبلغ العرض. تصدر كفالة تعهد المؤسسات الخاضعة للقانون الجزائري من طرف بنك خاضع للقانون الجزائري أو صندوق ضمان الصفقات العمومية وتصدر كفالة تعهد المتعهدين الأجانب من طرف بنك خاضع للقانون الجزائري يشملها ضمان مقابل صادر عن بنك أجنبي من الدرجة الأولى. في حالة الإجراءات المحدودة ، يجب إدراج كفالة التعهد المذكورة أعلاه إذا اقتضى الأمر في ظرف مقفل يحمل عبارة \"كفالة تعهد لا يفتح إلا عند فتح الأظرفة المالية\" . ترد كفالة المتعهد الذي لم يقبل، والذي لم يقدم طعنا، بعد يوم واحد من تاريخ انقضاء أجل الطعن كما هو محدد في المادة 82 أعلاه. ترد كفالة المتعهد الذي لم يقبل، والذي قدم طعنا، عند تبليغ قرار رفض الطعن، من طرف لجنة الصفقات المختصة. ترد كفالة الحاصل على صفقة عمومية بعد وضع كفالة حسن التنفيذ. وتحرر كفالة التعهد حسب نموذج يحدد بموجب قرار من الوزير المكلف بالمالية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_125> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_125> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2015-09-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2015-09-16/15-247#version_art_126> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
