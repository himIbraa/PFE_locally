    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_116> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_117_obligation_0_f24adf13> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
