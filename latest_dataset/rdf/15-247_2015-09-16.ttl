<https://legal.dz/resource/law/2015-09-16/15-247#version_art_202> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن اتخاذ مقرر التجاوز، في حالة رفض التأشيرة المعلل لعدم مطابقة الأحكام التشريعية . و في حالة رفض التأشيرة المعلل لعدم مطابقة الأحكام التنظيمية ، فإن مقرر التجاوز يفرض على المراقب المالي و المحاسب العمومي المكلف . ومهما يكن من أمر، فإنه لا يمكن اتخاذ مقرر التجاوز بعد أجل تسعين (90) يوما، ابتداء من تاريخ تبليغ رفض التأشيرة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_202_20150916_OpEnact_e340299f73> ;
    dzdoc:replacementText "لا يمكن اتخاذ مقرر التجاوز، في حالة رفض التأشيرة المعلل لعدم مطابقة الأحكام التشريعية . و في حالة رفض التأشيرة المعلل لعدم مطابقة الأحكام التنظيمية ، فإن مقرر التجاوز يفرض على المراقب المالي و المحاسب العمومي المكلف . ومهما يكن من أمر، فإنه لا يمكن اتخاذ مقرر التجاوز بعد أجل تسعين (90) يوما، ابتداء من تاريخ تبليغ رفض التأشيرة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_202> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_202> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2015-09-16"^^xsd:date ;
