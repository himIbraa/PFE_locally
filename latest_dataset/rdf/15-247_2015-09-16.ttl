<https://legal.dz/resource/law/2015-09-16/15-247#version_art_212> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يستفيد الموظفون والأعوان العموميون المكلفون بتحضير وإبرام وتنفيذ ومراقبة الصفقات العمومية و تفويضات المرفق العام من دورات تكوين وتحسين المستوى وتجديد المعارف تضمنها الهيئة المستخدمة، بالاتصال مع سلطة ضبط الصفقات العمومية وتفويضات المرفق العام ، وذلك من أجل تحسين مستمر لمؤهلاتهم وكفاءاتهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_212_20150916_OpEnact_060d7cc815> ;
    dzdoc:replacementText "يستفيد الموظفون والأعوان العموميون المكلفون بتحضير وإبرام وتنفيذ ومراقبة الصفقات العمومية و تفويضات المرفق العام من دورات تكوين وتحسين المستوى وتجديد المعارف تضمنها الهيئة المستخدمة، بالاتصال مع سلطة ضبط الصفقات العمومية وتفويضات المرفق العام ، وذلك من أجل تحسين مستمر لمؤهلاتهم وكفاءاتهم."@ar ;
