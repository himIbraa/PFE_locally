<https://legal.dz/resource/law/2015-09-16/15-247#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "لا تدفع التسبيقات إلا في حالة الصفقات العمومية التي يفوق مبلغها الحدود المنصوص عليها في المادة 13 من هذا المرسوم ، و إذا قدم المتعامل المتعاقد مسبقا كفالة بقيمة معادلة بإرجاع تسبيقات يصدرها بنك خاضع للقانون الجزائري أو صندوق ضمان الصفقات العمومية، بالنسبة للمتعهدين الجزائريين . و يجب أن تصدر كفالة المتعهدين الأجانب من بنك خاضع للقانون الجزائري، يشملها ضمان مقابل صادر عن بنك أجنبي من الدرجة الأولى . وتحرر كفالة إرجاع التسبيقات حسب نموذج يحدد بموجب قرار من الوزير المكلف بالمالية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_110_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_110_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_110_20150916_OpEnact_2427334f26> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_110_obligation_0_6b076524>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_110_obligation_1_54767793> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "110" ;
    dzdoc:position 109 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_13> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_13> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_110_condition_0_f547f013>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_110_condition_1_dee5faeb> ;
    dzdoc:usesTerm dzterm:advance_payment,
        dzterm:contracting_party,
        dzterm:minister_of_finance .

<https://legal.dz/resource/law/2015-09-16/15-247#art_160> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_1_subsubsec_1> ;
    dzdoc:eId "art_160" ;
    dzdoc:fullText "تحدث المصلحة المتعاقدة في إطار الرقابة الداخلية لجنة دائمة واحدة أو أكثر مكلفة بفتح الأظرفة وتحليل العروض والبدائل والأسعار الاختيارية عند الاقتضاء، تدعى في صلب النص \" لجنة فتح الأظرفة وتقييم العروض \". وتتشكل هذه اللجنة من موظفين مؤهلين تابعين للمصلحة المتعاقدة، يختارون لكفاءتهم. يمكن المصلحة المتعاقدة ، تحت مسؤوليتها، أن تنشئ لجنة تقنية تكلف بإعداد تقرير تحليل العروض، لحاجات لجنة فتح الأظرفة وتقييم العروض ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_160_permission_0_d7193b0c> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2015-09-16/15-247#art_160_right_0_d7193b0c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_160> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_160_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_160_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_160_20150916_OpEnact_647644367d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_160_obligation_0_35bd0f20> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "160" ;
    dzdoc:position 159 ;
    dzdoc:usesTerm dzterm:bid_opening_evaluation_committee,
        dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_216> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_5> ;
    dzdoc:eId "art_216" ;
    dzdoc:fullText "تستمر لجان الصفقات المختصة بدراسة مشاريع دفاتر الشروط والصفقات والملاحق المودعة لديها، قبل بداية سريان مفعول هذا المرسوم، بغض النظر عن المستويات الجديدة لاختصاص لجان الصفقات . تستمر دفاتر الشروط المؤشر عليها، قبل بداية سريان مفعول هذا المرسوم، في ترتيب آثارها إلى غاية اكتمال إجراءات منح الصفقة. وإذا قررت المصلحة المتعاقدة إجراء مطابقة دفاتر الشروط المذكورة أعلاه مع أحكام هذا المرسوم ، فإنه يجب عليها، في هذه الحالة، تقديمها إلى لجنة الصفقات المختصة لدراستها وفق المستويات الجديدة . تستمر اللجان المنشأة بموجب الأحكام السابقة عن هذا المرسوم بدراسة الملفات التي هي من اختصاصها حتى تنصيب اللجان المنشأة بموجب هذا المرسوم. تبقى إجراءات إبرام الصفقات العمومية التي تم إرسال إعلان طلبات العروض المتعلقة بها للنشر أو شرع في الاستشارة بشأنها، قبل صدور هذا المرسوم، خاضعة لأحكام المرسوم الرئاسي رقم 10-236 المؤرخ في 28 شوال عام 1431 الموافق 7 أكتوبر سنة 2010 والمذكور أعلاه. تبقى الصفقات العمومية المبلغة قبل بداية سريان هذا المرسوم، خاضعة لتنفيذها لأحكام المرسوم الرئاسي رقم 10-236 المؤرخ في 28 شوال عام 1431 الموافق 7 أكتوبر سنة 2010 والمذكور أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_216> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_216_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_216_para_1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_216_para_2>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_216_para_3>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_216_para_4>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_216_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_216_20150916_OpEnact_be78737b1f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_216_obligation_0_a8608f81> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 216" ;
    dzdoc:position 215 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2015-09-16/15-247#art_216_extref_c278586b> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_216_condition_0_23fafab4> ;
    dzdoc:usesTerm dzterm:procurement_committees,
        dzterm:public_procurement .

<https://legal.dz/resource/law/2015-09-16/15-247#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_1_subsec_2_subsubsec_3> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "تعفى من أحكام هذا الباب، لا سيما ما يتعلق منها بطريقة الإبرام الصفقات العمومية لاستيراد المنتجات والخدمات التي تتطلب من المصلحة المتعاقدة المعنية السرعة في اتخاذ القرار بحكم طبيعتها والتقلبات السريعة في أسعارها ومدى توفرها، وكذا الممارسات التجارية المطبقة عليها والتي لا تكون مكيفة مع هذه الصفقات. يقوم الوزير المعني ، بمناسبة كل عملية استيراد من العمليات المذكورة أعلاه، بتأسيس لجنة وزارية مشتركة خاصة، تتشكل من أعضاء مؤهلين في الميدان المعني، برئاسة ممثل المصلحة المتعاقدة ، وتكلف بإجراء المفاوضات واختيار الشريك المتعاقد . تحدد قائمة المنتجات والخدمات المذكورة أعلاه بموجب قرار مشترك بين الوزير المكلف بالمالية و الوزير المكلف بالتجارة و الوزير المعني . ومهما يكن من أمر، تحرر صفقة تسوية خلال أجل ثلاثة (3) أشهر، ابتداء من الشروع في تنفيذ الخدمات ، وتعرض على الهيئة المختصة بالرقابة الخارجية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_23_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_23_para_1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_23_para_2>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_23_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_23_20150916_OpEnact_71e8c09453> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_23_obligation_0_85f1590c>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_23_obligation_1_8225ac66>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_23_obligation_2_5d2d0cf1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "23" ;
    dzdoc:position 22 ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:contracting_partner,
        dzterm:finance_minister,
        dzterm:minister,
        dzterm:public_procurement,
        dzterm:trade_minister .

<https://legal.dz/resource/law/2015-09-16/15-247#art_73> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_3_dup_1> ;
    dzdoc:eId "art_73" ;
    dzdoc:fullText "عندما يتعلق الأمر بالصالح العام ، يمكن المصلحة المتعاقدة ، أثناء كل مراحل إبرام الصفقة العمومية ، إعلان إلغاء الإجراء و/أو المنح المؤقت للصفقة العمومية . و لا يمكن المتعهدين أن يطلبوا أي تعويض في حال عدم اختیار عروضهم أو في حال إلغاء الإجراء و/أو المنح المؤقت للصفقة العمومية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_73_permission_0_2422b3d6> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2015-09-16/15-247#art_73_right_0_9464996a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_73> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_73_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_73_20150916_OpEnact_7c328d3345> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_73_obligation_0_87e17b2c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 73" ;
    dzdoc:position 72 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_73_condition_0_8a13f4f7> ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:public_procurement .

<https://legal.dz/resource/law/2015-09-16/15-247#art_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_9" ;
    dzdoc:fullText "لا تخضع المؤسسات العمومية الاقتصادية لأحكام إبرام الصفقات العمومية المنصوص عليها في هذا الباب. ومع ذلك يتعين عليها إعداد إجراءات إبرام الصفقات حسب خصوصياتها، على أساس مبادئ حرية الاستفادة من الطلب و المساواة في التعامل مع المرشحين و شفافية الإجراءات ، والعمل على اعتمادها من طرف هيئاتها الاجتماعية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2015-09-16/15-247#art_9_right_0_101a1b2f>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_9_right_1_679b2aa3>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_9_right_2_394acbdc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_9_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_9_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_9_20150916_OpEnact_e19f4a8625> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_9_obligation_0_9fb7f2b1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_9_obligation_1_3e40cb25> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "9" ;
    dzdoc:position 8 ;
    dzdoc:usesTerm dzterm:public_economic_enterprises,
        dzterm:public_procurement .

<https://legal.dz/resource/law/2015-09-16/15-247#art_105> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_105" ;
    dzdoc:fullText "يدفع مقابل الخدمات المنجزة بعد الأجل التعاقدي للتنفيذ المتفق عليه، على أساس الأسعار المطبقة اعتمادا على السعر الذي يحتمل أن يكون قد تم تحيينه أو مراجعته محسوبا في نهاية الأجل التعاقدي ، في حالة ما إذا تسبب المتعاقد في تأخير تنفيذ الصفقة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_105> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_105_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_105_20150916_OpEnact_427b736f44> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_105_obligation_0_b111e13a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "105" ;
    dzdoc:position 104 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_105_condition_0_42ac2827> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_108> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_108" ;
    dzdoc:fullText "تتم التسوية المالية للصفقة بدفع التسبيقات و / أو الدفع على الحساب ، وبالتسويات على رصيد الحساب . لا يترتب على دفع ما يحتمل من تسبيقات و / أو دفع على الحساب أي أثر من شأنه أن يخفف مسؤولية المتعامل المتعاقد من حيث التنفيذ الكامل والمطابق والوفي للخدمات المتعاقد عليها. وبهذه الصفة، فإن هذه الدفعات لا تمثل تسديدا نهائيا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_108> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_108_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_108_para_1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_108_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_108_20150916_OpEnact_41e2c7cf7e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_108_obligation_0_eaed0310> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "108" ;
    dzdoc:position 107 ;
    dzdoc:usesTerm dzterm:advance_payment,
        dzterm:contracting_party,
        dzterm:payment_on_account .

<https://legal.dz/resource/law/2015-09-16/15-247#art_112> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_112" ;
    dzdoc:fullText "يمكن أن يدفع التسبيق الجزافي مرة واحدة . كما يمكن أن يدفع في عدة أقساط تنص الصفقة على تعاقبها الزمني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_112_permission_0_9217f8a3> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2015-09-16/15-247#art_112_right_0_32949239>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_112_right_1_cbaff9db> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_112> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_112_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_112_20150916_OpEnact_d32bc4c0ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "112" ;
    dzdoc:position 111 ;
    dzdoc:usesTerm dzterm:lump_sum_advance .

<https://legal.dz/resource/law/2015-09-16/15-247#art_176> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_1> ;
    dzdoc:eId "art_176" ;
    dzdoc:fullText "يعين أعضاء لجان الصفقات ومستخلفوهم، باستثناء من عين بحكم وظيفته من قبل إدارتهم بأسمائهم بهذه الصفة لمدة ثلاث (3) سنوات قابلة للتجديد . عند غياب رئيس لجنة الصفقات العمومية، أو حدوث مانع له ، يمكن المسؤول الأول للمصلحة المتعاقدة أو سلطة الوصاية، حسب الحالة، تعيين عضو مستخلف، من خارج اللجنة، لاستخلافه. يحضر الأعضاء الذين يمثلون المصلحة المتعاقدة والمصلحة المستفيدة من الخدمات الاجتماعات بانتظام وتبعا لجدول الأعمال، بصوت استشاري . و يكلف ممثل المصلحة المتعاقدة بتزويد لجنة الصفقات بجميع المعلومات الضرورية لاستيعاب محتوى الصفقة التي يتولى تقديمها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_176_permission_0_25bc50e9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_176> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_176_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_176_para_1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_176_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_176_20150916_OpEnact_eaeab2e77e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_176_obligation_0_f1aa650d>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_176_obligation_1_0eb28cfd>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_176_obligation_2_0393458a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 176" ;
    dzdoc:position 175 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_176_condition_0_8f0adeb7> ;
    dzdoc:usesTerm dzterm:committees .

<https://legal.dz/resource/law/2015-09-16/15-247#art_193> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_3> ;
    dzdoc:eId "art_193" ;
    dzdoc:fullText "يعين الرئيس أحد أعضاء لجنة صفقات المصلحة المتعاقدة ليقدم للجنة تقريرا تحليليا عن الملف. ويعين الرئيس أحد أعضاء اللجنة القطاعية للصفقات أو ، عند الحاجة، خبيرا، ليقدم للجنة تقريرا تحليليا عن الملف. ويتولى كل رئيس لجنة تعيين مقرر خصيصا لكل ملف. يجب أن يرسل الملف كاملا إلى المقرر قبل ثمانية (8) أيام، على الأقل، من انعقاد الاجتماع المخصص لدراسة هذا الملف . لا يمكن تعيين رئيس ونائب رئيس لجنة الصفقات بصفة مقرر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_193_permission_0_d9c1d379> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_193> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_193_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_193_para_1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_193_para_2>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_193_para_3>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_193_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_193_20150916_OpEnact_bb0e6d2779> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_193_obligation_0_40ff1ea4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "193" ;
    dzdoc:position 192 ;
    dzdoc:usesTerm dzterm:contracting_authority_procurement_committee,
        dzterm:sectoral_procurement_committee .

<https://legal.dz/resource/law/2015-09-16/15-247#art_201> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_3> ;
    dzdoc:eId "art_201" ;
    dzdoc:fullText "إذا رفضت لجنة الصفقات للهيئة العمومية أو اللجنة القطاعية للصفقات منح التأشيرة ، يمكن مسؤول الهيئة العمومية أو الوزير المعني، حسب الحالة، بناء على تقرير من المصلحة المتعاقدة أن يتجاوز ذلك بمقرر معلل . ترسل نسخة من مقرر التجاوز ، المعد حسب الشروط المنصوص عليها في التشريع والتنظيم المعمول بهما، إلى مجلس المحاسبة وإلى الوزير المكلف بالمالية سلطة ضبط الصفقات العمومية وتفويضات المرفق العام و المفتشية العامة للمالية ) وإلى لجنة الصفقات المعنية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_201_permission_0_f5786ec6> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2015-09-16/15-247#art_201_right_0_9acaf496> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_201> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_201_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_201_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_201_20150916_OpEnact_55959fbfce> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_201_obligation_0_76ff9a99> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 201" ;
    dzdoc:position 200 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_201_condition_0_c43a7691> ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:court_of_auditors,
        dzterm:general_finance_inspectorate,
        dzterm:minister,
        dzterm:minister_of_finance,
        dzterm:public_body,
        dzterm:public_body_tender_committee,
        dzterm:regulatory_authority,
        dzterm:sectoral_tender_committee,
        dzterm:tender_committee .

<https://legal.dz/resource/law/2015-09-16/15-247#art_207> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_2> ;
    dzdoc:eId "art_207" ;
    dzdoc:fullText "يمكن الشخص المعنوي الخاضع للقانون العام المسؤول عن مرفق عام ، أن يقوم بتفويض تسييره إلى مفوض له، وذلك ما لم يوجد حكم تشريعي مخالف . ويتم التكفل بأجر المفوض له بصفة أساسية، من استغلال المرفق العام . وتقوم السلطة المفوضة التي تتصرف لحساب شخص معنوي خاضع للقانون العام بتفويض تسيير المرفق العام بموجب اتفاقية. وبهذه الصفة، يمكن السلطة المفوضة أن تعهد للمفوض له إنجاز منشآت أو اقتناء ممتلكات ضرورية لسير عمل المرفق العام . تحدد كيفيات تطبيق أحكام هذا الباب بموجب مرسوم تنفيذي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_207_permission_0_92961743>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_207_permission_1_99d293a5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_207> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_207_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_207_para_1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_207_para_2>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_207_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_207_20150916_OpEnact_02d599e067> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 207" ;
    dzdoc:position 206 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_207_condition_0_5a568666> ;
    dzdoc:usesTerm dzterm:legal_person,
        dzterm:public_service .

<https://legal.dz/resource/law/2015-09-16/15-247#art_231> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_4> ;
    dzdoc:eId "art_231" ;
    dzdoc:fullText "يمكن تعويض كفالة حسن التنفيذ باقتطاعات حسن التنفيذ فيما يخص صفقات الدراسات والخدمات المذكورة في الفقرة 2 من المادة 130 أعلاه، عندما ينص دفتر شروط الدعوة للمنافسة على ذلك . وعندما يكون أجل الضمان منصوصا عليه في صفقات الدراسات أو الخدمات المذكورة في الفقرة أعلاه ، فإن الرصيد المكون من مجموع الاقتطاعات يحول إلى اقتطاع ضمان، عند الاستلام المؤقت."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_231_permission_0_5b9f3d63> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2015-09-16/15-247#art_231_right_0_c7ecfed7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_231> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_231_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_231_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_231_20150916_OpEnact_6276ac9d18> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 231" ;
    dzdoc:position 131 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_130> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_130> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_231_condition_0_5f007e28>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_231_condition_1_ee62b8f0> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_30" ;
    dzdoc:fullText "يمكن أن تلجأ المصلحة المتعاقدة إلى صفقات تشتمل على قسط ثابت وقسط أو أكثر اشتراطي، عندما تبرر شروط اقتصادية و / أو مالية ذلك . ويجب أن يكون القسط الثابت وكل قسط اشتراطي مشروعا وظيفيا. يخضع تنفيذ كل قسط اشتراطي إلى قرار من المصلحة المتعاقدة يبلغ إلى المتعامل المتعاقد حسب الشروط المحددة في دفتر الشروط ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_30_permission_0_b4a0ed70> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_30> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_30_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_30_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_30_20150916_OpEnact_8287cb75e3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_30_obligation_0_de07fab4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "30" ;
    dzdoc:position 29 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_30_condition_0_62932281> ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:contractor .

<https://legal.dz/resource/law/2015-09-16/15-247#art_63> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_3_dup_1> ;
    dzdoc:eId "art_63" ;
    dzdoc:fullText "تضع المصلحة المتعاقدة تحت تصرف المؤسسات دفتر الشروط والوثائق المنصوص عليها في المادة 64 أدناه . ويجب أن يسحب دفتر الشروط من طرف المرشح أو المتعهد أو من طرف ممثليهما المعينين لذلك . ويجب أن يسحب دفتر الشروط ، في إطار تجمع مؤقت لمؤسسات، من طرف الوكيل أو من طرف ممثله المعين لذلك ، إلا إذا تم الاتفاق على خلاف ذلك في اتفاقية التجمع . ويمكن أن ترسل هذه الوثائق إلى المترشح الذي يطلبها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_63> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_63_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_63_para_1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_63_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_63_20150916_OpEnact_4eea78f849> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_63_obligation_0_0741d65f>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_63_obligation_1_5dd0e782>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_63_obligation_2_5d1a68e0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 63" ;
    dzdoc:position 62 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_64> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_64> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_63_condition_0_c932757b> ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:tender_specifications .

<https://legal.dz/resource/law/2015-09-16/15-247#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_3_dup_1> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "يمكن المصلحة المتعاقدة أن تطلب من المتعهدين تدعيم عروضهم بعينات أو نماذج أو تصاميم عندما تستدعي مقارنة العروض فيما بينها ذلك . ويجب أن ينص دفتر الشروط على كيفيات تقديمها وتقييمها وإرجاعها، عند الاقتضاء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_68_permission_0_3cce4a02> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_68_para_0> ;
