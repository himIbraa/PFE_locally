<https://legal.dz/resource/law/2015-09-16/15-247#version_art_73> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يتعلق الأمر بالصالح العام ، يمكن المصلحة المتعاقدة ، أثناء كل مراحل إبرام الصفقة العمومية ، إعلان إلغاء الإجراء و/أو المنح المؤقت للصفقة العمومية . و لا يمكن المتعهدين أن يطلبوا أي تعويض في حال عدم اختیار عروضهم أو في حال إلغاء الإجراء و/أو المنح المؤقت للصفقة العمومية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_73_20150916_OpEnact_7c328d3345> ;
    dzdoc:replacementText "عندما يتعلق الأمر بالصالح العام ، يمكن المصلحة المتعاقدة ، أثناء كل مراحل إبرام الصفقة العمومية ، إعلان إلغاء الإجراء و/أو المنح المؤقت للصفقة العمومية . و لا يمكن المتعهدين أن يطلبوا أي تعويض في حال عدم اختیار عروضهم أو في حال إلغاء الإجراء و/أو المنح المؤقت للصفقة العمومية ."@ar ;
