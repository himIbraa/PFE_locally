<https://legal.dz/resource/law/2015-09-16/15-247#version_art_77> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن متعهدا أو مرشحا ، وحده أو في إطار تجمع، أن يقدم أكثر من عرض واحد في كل إجراء لإبرام صفقة عمومية . و لا يمكن نفس الشخص أن يمثل أكثر من متعهد أو مرشح في نفس الصفقة العمومية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_77_20150916_OpEnact_e2374e3fac> ;
    dzdoc:replacementText "لا يمكن متعهدا أو مرشحا ، وحده أو في إطار تجمع، أن يقدم أكثر من عرض واحد في كل إجراء لإبرام صفقة عمومية . و لا يمكن نفس الشخص أن يمثل أكثر من متعهد أو مرشح في نفس الصفقة العمومية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_77> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_77> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
