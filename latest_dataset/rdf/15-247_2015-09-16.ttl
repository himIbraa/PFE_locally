        <https://legal.dz/resource/law/2015-09-16/15-247#art_70_obligation_6_f66c0aee>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_70_obligation_7_f68b7fff> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "70" ;
    dzdoc:position 69 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_48>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_66> ;
