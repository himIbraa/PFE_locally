    dzdoc:definesTerm dzterm:services_contract ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_29> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_29_para_12> ;
    dzdoc:paragraphPosition 12 ;
    dzdoc:snippet "تهدف الصفقة العمومية للخدمات المبرمة مع متعهد خدمات إلى إنجاز تقديم خدمات وهي صفقة عمومية تختلف عن صفقات الأشغال أو اللوازم أو الدراسات."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_29_defocc_c64885aff58b> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 153 ;
    dzdoc:charStart 0 ;
