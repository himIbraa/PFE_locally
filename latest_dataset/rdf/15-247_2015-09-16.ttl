<https://legal.dz/resource/law/2015-09-16/15-247#art_95_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_95> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب أن تشير كل صفقة عمومية إلى التشريع والتنظيم المعمول بهما وإلى هذا المرسوم. ويجب أن تتضمن على الخصوص البيانات الآتية : التعريف الدقيق بالأطراف المتعاقدة، هوية الأشخاص المؤهلين قانونا لإمضاء الصفقة وصفتهم، موضوع الصفقة محددا وموصوفا وصفا دقيقا، المبلغ المفصل والموزع بالعملة الصعبة والدينار الجزائري، حسب الحالة، شروط التسديد، أجل تنفيذ الصفقة، بنك محل الوفاء، شروط فسخ الصفقة، تاريخ توقيع الصفقة ومكانه."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_95_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_95> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجب أن تحتوي الصفقة العمومية، فضلا عن ذلك، على البيانات التكميلية الآتية : كيفية إبرام الصفقة، الإشارة إلى دفاتر البنود الإدارية العامة ودفاتر التعليمات التقنية المشتركة المطبقة على الصفقات التي تشكل جزءا لا يتجزأ منها، شروط عمل المناولين واعتمادهم، إن وجدوا، بند التحيين ومراجعة الأسعار، بند الرهن الحيازي، إن كان مطلوبا نسب العقوبات المالية وكيفيات حسابها ، وشروط تطبيقها أو النص على حالات الإعفاء منها، كيفيات تطبيق حالات القوة القاهرة، شروط دخول الصفقة حيز التنفيذ، النص في عقود المساعدة التقنية على أنماط مناصب العمل، وقائمة المستخدمين الأجانب ومستوى تأهيلهم، وكذا نسب الأجور والمنافع الأخرى التي تمنح لهم، شروط استلام الصفقة، القانون المطبق وشرط تسوية الخلافات، بنود السرية والكتمان، بند التأمينات، بنود العمل التي تضمن احترام قانون العمل، البنود المتعلقة بحماية البيئة والتنمية المستدامة، البنود المتعلقة باستعمال اليد العاملة المحلية، وبالإدماج المهني للأشخاص المحرومين من سوق الشغل والمعوقين."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_96_obligation_0_72af8759> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_96> ;
    dznorm:position 0 ;
    dznorm:provisionText "يدفع أجر المتعامل المتعاقد وفق الكيفيات الآتية :"@ar ;
    dznorm:sourceArticle "art_96" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_96_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_96> ;
    dzdoc:position 0 ;
    dzdoc:text """يدفع أجر المتعامل المتعاقد وفق الكيفيات الآتية :
              
              
              بالسعر الإجمالي والجزافي،
              
              
              بناء على قائمة سعر الوحدة،
              
              
              بناء على النفقات المراقبة،
              
              
              بسعر مختلط بالسعر الإجمالي والجزافي، بناء على قائمة سعر الوحدة، بناء على النفقات المراقبة، بسعر مختلط"""@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_96_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_96> ;
    dzdoc:position 1 ;
    dzdoc:text "يمكن المصلحة المتعاقدة مراعاة لاحترام الأسعار، تفضيل دفع مستحقات الصفقة وفق صيغة السعر الإجمالي والجزافي ."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_96_permission_0_b8605d84> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
