<https://legal.dz/resource/law/2015-09-16/15-247#art_81_permission_1_26854307> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2015-09-16/15-247#art_81_permission_1_26854307_action_2a005f804c>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_81_permission_1_26854307_action_3d3d39d434> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_81> ;
    dznorm:position 1 ;
    dznorm:provisionText "يمكن المرشحين والمتعهدين، في إطار تجمع مؤقت لمؤسسات، أن يتقدموا في شكل تجمع مؤقت لمؤسسات متضامنة أو تجمع مؤقت لمؤسسات متشاركة. غير أنه إذا اقتضت طبيعة الصفقة العمومية ذلك، يمكن المصلحة المتعاقدة أن تلزم المرشحين والمتعهدين في دفتر الشروط، أن يتأسسوا في تجمعات مؤقتة لمؤسسات متضامنة."@ar ;
    dznorm:sourceArticle "art_81" .

