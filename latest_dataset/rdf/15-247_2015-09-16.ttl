    skos:prefLabel "التراضي"@ar,
        "التراضي هو إجراء تخصيص صفقة لمتعامل متعاقد واحد دون الدعوة الشكلية إلى المنافسة."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_41_defocc_3d757eab02d4> .

