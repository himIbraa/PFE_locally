<https://legal.dz/resource/law/2015-09-16/15-247#version_art_166> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعين أعضاء اللجان المنشأة بموجب أحكام المواد 171 و 173 و 174 أدناه، بموجب مقرر من رئيس اللجنة. ويعين أعضاء اللجان المنشأة، بموجب أحكام المادتين 172 و 175 أدناه، بموجب مقرر من السلطة الوصية على المؤسسة العمومية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
