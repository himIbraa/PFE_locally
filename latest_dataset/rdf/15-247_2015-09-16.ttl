<https://legal.dz/resource/law/2015-09-16/15-247#art_117_right_0_59d7021a> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2015-09-16/15-247#art_117_right_0_59d7021a_action_f9b2b7d3d1> ;
