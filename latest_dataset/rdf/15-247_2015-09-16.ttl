<https://legal.dz/resource/law/2015-09-16/15-247#version_art_113> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أصحاب صفقات عمومية للأشغال واللوازم أن يحصلوا بالإضافة إلى التسبيق الجزافي ، على تسبيق على التموين إذا أثبتوا حيازتهم عقودا أو طلبات مؤكدة للمواد أو المنتجات الضرورية لتنفيذ الصفقة . يمكن المصلحة المتعاقدة أن تطلب من المتعامل المتعاقد معها التزاما صريحا بإيداع المواد والمنتجات المعنية في الورشة أو في مكان التسليم خلال أجل يلائم الرزنامة التعاقدية تحت طائلة إرجاع التسبيق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_113_20150916_OpEnact_3d26f7395d> ;
    dzdoc:replacementText "يمكن أصحاب صفقات عمومية للأشغال واللوازم أن يحصلوا بالإضافة إلى التسبيق الجزافي ، على تسبيق على التموين إذا أثبتوا حيازتهم عقودا أو طلبات مؤكدة للمواد أو المنتجات الضرورية لتنفيذ الصفقة . يمكن المصلحة المتعاقدة أن تطلب من المتعامل المتعاقد معها التزاما صريحا بإيداع المواد والمنتجات المعنية في الورشة أو في مكان التسليم خلال أجل يلائم الرزنامة التعاقدية تحت طائلة إرجاع التسبيق."@ar ;
    dzdoc:resolutionStatus "resolved" ;
