<https://legal.dz/resource/law/2015-09-16/15-247#version_art_59> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد البحث عن الشروط الأكثر ملاءمة لتحقيق الأهداف المسطرة لـ المصلحة المتعاقدة في إطار مهمتها، اختيار كيفية إبرام الصفقات . ويدخل هذا الاختيار ضمن اختصاصات المصلحة المتعاقدة التي تتصرف طبقا لأحكام هذا المرسوم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_59_20150916_OpEnact_10cb5d3d55> ;
    dzdoc:replacementText "يحدد البحث عن الشروط الأكثر ملاءمة لتحقيق الأهداف المسطرة لـ المصلحة المتعاقدة في إطار مهمتها، اختيار كيفية إبرام الصفقات . ويدخل هذا الاختيار ضمن اختصاصات المصلحة المتعاقدة التي تتصرف طبقا لأحكام هذا المرسوم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
