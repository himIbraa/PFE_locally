    dznorm:conditionText "ثلاثة (3) أشهر، ابتداء من الشروع في تنفيذ الخدمات"@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_23_obligation_2_5d2d0cf1_period_5e511aa7c9> a dznorm:Period ;
    rdfs:label "خلال أجل ثلاثة (3) أشهر"@ar ;
