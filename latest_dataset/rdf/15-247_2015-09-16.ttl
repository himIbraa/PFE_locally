<https://legal.dz/resource/law/2015-09-16/15-247#version_art_116> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتم استعادة التسبيقات الجزافية والتسبيقات على التموين عن طريق اقتطاعات من المبالغ المدفوعة في شكل دفع على الحساب أو تسوية على رصيد الحساب، تقوم بها المصلحة المتعاقدة . ويبدأ استرداد التسبيقات بخصم من المبالغ التي يستحقها صاحب الصفقة العمومية ، على أبعد تقدير عندما يبلغ مجموع المبالغ المدفوعة نسبة خمسة وثلاثين في المائة (35) من المبلغ الأصلي للصفقة . ويجب أن ينتهي استرداد التسبيقات عندما يبلغ مجموع المبالغ المدفوعة نسبة ثمانين في المائة (80%) من المبلغ الأصلي للصفقة . يمكن أن يكون الاسترداد الجزئ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_116_20150916_OpEnact_dbed0d42f8> ;
    dzdoc:replacementText "تتم استعادة التسبيقات الجزافية والتسبيقات على التموين عن طريق اقتطاعات من المبالغ المدفوعة في شكل دفع على الحساب أو تسوية على رصيد الحساب، تقوم بها المصلحة المتعاقدة . ويبدأ استرداد التسبيقات بخصم من المبالغ التي يستحقها صاحب الصفقة العمومية ، على أبعد تقدير عندما يبلغ مجموع المبالغ المدفوعة نسبة خمسة وثلاثين في المائة (35) من المبلغ الأصلي للصفقة . ويجب أن ينتهي استرداد التسبيقات عندما يبلغ مجموع المبالغ المدفوعة نسبة ثمانين في المائة (80%) من المبلغ الأصلي للصفقة . يمكن أن يكون الاسترداد الجزئي للتسبيقات محل تحرير جزئي يعادله لكفالة استرجاع التسبيقات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_116> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_116> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2015-09-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2015-09-16/15-247#version_art_117> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن يقدم دفع على الحساب لكل صاحب صفقة عمومية ، إذا أثبت القيام بعمليات جوهرية في تنفيذ هذه الصفقة . غير أنه يجوز لأصحاب صفقات عمومية للأشغال أن يستفيدوا من دفعات على الحساب عند التموين بالمنتجات المسلمة في الورشة والتي لم تكن محل دفع عن طريق التسبيقات على التموين حتى نسبة ثمانين في المائة (80%) من مبلغها المحسوب بتطبيق الأسعار بالوحدة للتموين المعدة خصيصا للصفقة المقصودة على أساس الكميات المعاينة . ولا يستفيد المتعامل المتعاقد بأي حال من الأحوال من هذا الدفع على الحساب إلا فيما يخص التموينات"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_117_20150916_OpEnact_9a14d10ec4> ;
    dzdoc:replacementText "يمكن أن يقدم دفع على الحساب لكل صاحب صفقة عمومية ، إذا أثبت القيام بعمليات جوهرية في تنفيذ هذه الصفقة . غير أنه يجوز لأصحاب صفقات عمومية للأشغال أن يستفيدوا من دفعات على الحساب عند التموين بالمنتجات المسلمة في الورشة والتي لم تكن محل دفع عن طريق التسبيقات على التموين حتى نسبة ثمانين في المائة (80%) من مبلغها المحسوب بتطبيق الأسعار بالوحدة للتموين المعدة خصيصا للصفقة المقصودة على أساس الكميات المعاينة . ولا يستفيد المتعامل المتعاقد بأي حال من الأحوال من هذا الدفع على الحساب إلا فيما يخص التموينات المقتناة في الجزائر ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_117> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_117> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2015-09-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2015-09-16/15-247#version_art_118> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون الدفع على الحساب شهريا، غير أنه يمكن أن تنص الصفقة على فترة أطول تتلاءم مع طبيعة الخدمات. ويتوقف هذا الدفع على تقديم الوثائق المنصوص عليهم في دفتر الشروط، حسب الحالة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_118_20150916_OpEnact_00444d8b64> ;
    dzdoc:replacementText "يكون الدفع على الحساب شهريا، غير أنه يمكن أن تنص الصفقة على فترة أطول تتلاءم مع طبيعة الخدمات. ويتوقف هذا الدفع على تقديم الوثائق المنصوص عليهم في دفتر الشروط، حسب الحالة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_118> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
