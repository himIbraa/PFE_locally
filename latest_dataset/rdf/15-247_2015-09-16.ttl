    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_28> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_29_condition_0_15cdb361> a dznorm:Condition ;
    dznorm:conditionText "عندما تشمل الصفقة العمومية عدة عمليات من تلك المذكورة أعلاه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_29> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_29_condition_1_d917a64d> a dznorm:Condition ;
