<https://legal.dz/resource/law/2015-09-16/15-247#version_art_90> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما تتعارض المصالح الخاصة لموظف عمومي يشارك في إبرام أو مراقبة أو تنفيذ صفقة عمومية مع المصلحة العامة ويكون من شأن ذلك التأثير في ممارسته لمهامه بشكل عاد ، فإنه يتعين عليه أن يخبر سلطته السلمية بذلك ويتنحى عن هذه المهمة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
