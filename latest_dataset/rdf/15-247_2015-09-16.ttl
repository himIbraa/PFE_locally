    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_216> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب عليها، في هذه الحالة، تقديمها إلى لجنة الصفقات المختصة لدراستها وفق المستويات الجديدة"@ar ;
    dznorm:sourceArticle "art_216" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_216_obligation_0_a8608f81_action_7daa5b0276> a dznorm:Action ;
    rdfs:label "عليها"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب عليها، في هذه الحالة، تقديمها إلى لجنة الصفقات المختصة لدراستها وفق المستويات الجديدة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_216> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_216_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_216> ;
    dzdoc:position 0 ;
    dzdoc:text "تستمر لجان الصفقات المختصة بدراسة مشاريع دفاتر الشروط والصفقات والملاحق المودعة لديها، قبل بداية سريان مفعول هذا المرسوم، بغض النظر عن المستويات الجديدة لاختصاص لجان الصفقات."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_216_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_216> ;
    dzdoc:position 1 ;
    dzdoc:text "تستمر دفاتر الشروط المؤشر عليها، قبل بداية سريان مفعول هذا المرسوم، في ترتيب آثارها إلى غاية اكتمال إجراءات منح الصفقة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_216_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_216> ;
    dzdoc:position 2 ;
    dzdoc:text "وإذا قررت المصلحة المتعاقدة إجراء مطابقة دفاتر الشروط المذكورة أعلاه مع أحكام هذا المرسوم، فإنه يجب عليها، في هذه الحالة، تقديمها إلى لجنة الصفقات المختصة لدراستها وفق المستويات الجديدة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_216_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_216> ;
    dzdoc:position 3 ;
    dzdoc:text "تستمر اللجان المنشأة بموجب الأحكام السابقة عن هذا المرسوم بدراسة الملفات التي هي من اختصاصها حتى تنصيب اللجان المنشأة بموجب هذا المرسوم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_216_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_216> ;
    dzdoc:position 4 ;
    dzdoc:text "تبقى إجراءات إبرام الصفقات العمومية التي تم إرسال إعلان طلبات العروض المتعلقة بها للنشر أو شرع في الاستشارة بشأنها، قبل صدور هذا المرسوم، خاضعة لأحكام المرسوم الرئاسي رقم 10-236 المؤرخ في 28 شوال عام 1431 الموافق 7 أكتوبر سنة 2010 والمذكور أعلاه."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_216_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_216> ;
    dzdoc:position 5 ;
    dzdoc:text "تبقى الصفقات العمومية المبلغة قبل بداية سريان هذا المرسوم، خاضعة لتنفيذها لأحكام المرسوم الرئاسي رقم 10-236 المؤرخ في 28 شوال عام 1431 الموافق 7 أكتوبر سنة 2010 والمذكور أعلاه."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_217_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_217> ;
    dzdoc:position 0 ;
    dzdoc:text "يوضح قرار مشترك بين الوزير المكلف بالمالية والوزير أو مسؤول الهيئة العمومية المعني، عند الحاجة ، كيفيات تطبيق الأحكام الخاصة بكل قطاع."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_218_extref_c278586b> a dzdoc:ExternalReference ;
    rdfs:label "المرسوم الرئاسي رقم 10-236 المؤرخ في 28 شوال عام 1431 الموافق 7 أكتوبر سنة 2010"@ar ;
    dzdoc:frbrUri "/akn/dz/act/decree/2010-10-07/10-236"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/decree/2010-10-07/10-236"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/decree/2010-10-07/10-236" ;
    dzdoc:referencesTarget <https://legal.dz/resource/decree/2010-10-07/10-236> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/decree/2010-10-07/10-236"^^xsd:anyURI .

<https://legal.dz/resource/law/2015-09-16/15-247#art_218_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_218> ;
    dzdoc:position 0 ;
    dzdoc:text "تبقى النصوص المتخذة تطبيقا لأحكام المرسوم الرئاسي رقم 10-236 المؤرخ في 28 شوال عام 1431 الموافق 7 أكتوبر سنة 2010 والمذكور أعلاه، التي تمت إعادة إدراجها في هذا المرسوم، سارية المفعول حتى نشر النصوص الجديدة المتخذة تطبيقا لأحكام هذا المرسوم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_219_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_219> ;
    dzdoc:position 0 ;
    dzdoc:text "تحدد بداية سريان أحكام هذا المرسوم بعد ثلاثة (3) أشهر من تاريخ نشره في الجريدة الرسمية."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_21_obligation_0_f5296d1e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2015-09-16/15-247#art_21_obligation_0_f5296d1e_action_cd7c429f55>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_21_obligation_0_f5296d1e_action_d08c0dfb7d> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2015-09-16/15-247#art_21_obligation_0_f5296d1e_role_8eea5bb0f9> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_21> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب على المصلحة المتعاقدة أن لا تلجأ لنفس المتعامل الاقتصادي، عندما يمكن تلبية تلك الخدمات من طرف متعاملين اقتصاديين آخرين إلا في الحالات الاستثنائية المبررة كما ينبغي"@ar ;
    dznorm:sourceArticle "art_21" .

