<https://legal.dz/resource/law/2015-09-16/15-247#art_27_defocc_a75536ca3b59> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 96 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:work_process ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_27> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_27_para_9> ;
    dzdoc:paragraphPosition 9 ;
    dzdoc:snippet "وتتميز عملية الأشغال التي تخص منشأة واحدة أو عدة منشآت بوحدتها الوظيفية أو التقنية أو الاقتصادية."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_27_defocc_d635fa607617> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 190 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:work_process ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_27> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_27_para_10> ;
    dzdoc:paragraphPosition 10 ;
    dzdoc:snippet "وتقابل عملية الأشغال مجموعة أشغال مرتبطة بموضوعها وتنفذ في إقليم محدد وبنفس الطرق التقنية وتقيد في تمويل يرصد لهذا الغرض، والتي قررت المصلحة المتعاقدة إنجازها في آن واحد أو في تواريخ متقاربة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_27_para_10> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_27> ;
    dzdoc:position 10 ;
    dzdoc:text "وتقابل عملية الأشغال مجموعة أشغال مرتبطة بموضوعها وتنفذ في إقليم محدد وبنفس الطرق التقنية وتقيد في تمويل يرصد لهذا الغرض، والتي قررت المصلحة المتعاقدة إنجازها في آن واحد أو في تواريخ متقاربة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_27_para_9> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_27> ;
    dzdoc:position 9 ;
    dzdoc:text "وتتميز عملية الأشغال التي تخص منشأة واحدة أو عدة منشآت بوحدتها الوظيفية أو التقنية أو الاقتصادية."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_29_defocc_1610d7aa2a21> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 52 ;
    dzdoc:charStart 0 ;
