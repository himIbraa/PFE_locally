        <https://legal.dz/resource/law/2015-09-16/15-247#art_135>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_139> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_13>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_135>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_139> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_18_condition_0_b10bf326>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_18_condition_1_04d332a6>,
