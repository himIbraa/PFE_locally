    dznorm:hasCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_66_right_0_5c205b39_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يمكن المصلحة المتعاقدة أن تمدد الأجل المحدد لتحضير العروض، إذا اقتضت الظروف ذلك"@ar ;
    dznorm:sourceArticle "art_66" .

