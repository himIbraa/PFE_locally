<https://legal.dz/resource/law/2015-09-16/15-247#version_art_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتعين على المؤسسات المنصوص عليها في المطة الأخيرة من المادة 6 أعلاه، عندما تنجز عملية غير ممولة كليا أو جزئيا بمساهمة مؤقتة أو نهائية من الدولة أو الجماعات الإقليمية ، أن تكيف إجراءاتها الخاصة مع تنظيم الصفقات العمومية والعمل على اعتمادها من هيئاتها المؤهلة . يتعين على سلطة الوصاية لهذه المؤسسات العمومية أن تضع جهازا لمراقبة صفقاتها، وتوافق عليه ، طبقا لأحكام المادة 159 من هذا المرسوم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_8_20150916_OpEnact_f93987c237> ;
    dzdoc:replacementText "يتعين على المؤسسات المنصوص عليها في المطة الأخيرة من المادة 6 أعلاه، عندما تنجز عملية غير ممولة كليا أو جزئيا بمساهمة مؤقتة أو نهائية من الدولة أو الجماعات الإقليمية ، أن تكيف إجراءاتها الخاصة مع تنظيم الصفقات العمومية والعمل على اعتمادها من هيئاتها المؤهلة . يتعين على سلطة الوصاية لهذه المؤسسات العمومية أن تضع جهازا لمراقبة صفقاتها، وتوافق عليه ، طبقا لأحكام المادة 159 من هذا المرسوم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_8> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_8> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2015-09-16"^^xsd:date ;
