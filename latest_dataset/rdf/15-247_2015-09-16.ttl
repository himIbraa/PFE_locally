    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_68_obligation_0_6a7fab69> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "68" ;
