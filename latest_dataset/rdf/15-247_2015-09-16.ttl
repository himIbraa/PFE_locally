<https://legal.dz/resource/law/2015-09-16/15-247#art_116_condition_1_d383166d> a dznorm:Condition ;
    dznorm:conditionText "عندما يبلغ مجموع المبالغ المدفوعة نسبة ثمانين في المائة (80%) من المبلغ الأصلي للصفقة"@ar ;
