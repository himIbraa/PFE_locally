<https://legal.dz/resource/law/2015-09-16/15-247#version_art_9> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تخضع المؤسسات العمومية الاقتصادية لأحكام إبرام الصفقات العمومية المنصوص عليها في هذا الباب. ومع ذلك يتعين عليها إعداد إجراءات إبرام الصفقات حسب خصوصياتها، على أساس مبادئ حرية الاستفادة من الطلب و المساواة في التعامل مع المرشحين و شفافية الإجراءات ، والعمل على اعتمادها من طرف هيئاتها الاجتماعية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_9_20150916_OpEnact_e19f4a8625> ;
    dzdoc:replacementText "لا تخضع المؤسسات العمومية الاقتصادية لأحكام إبرام الصفقات العمومية المنصوص عليها في هذا الباب. ومع ذلك يتعين عليها إعداد إجراءات إبرام الصفقات حسب خصوصياتها، على أساس مبادئ حرية الاستفادة من الطلب و المساواة في التعامل مع المرشحين و شفافية الإجراءات ، والعمل على اعتمادها من طرف هيئاتها الاجتماعية."@ar ;
