    dzdoc:hasRole <https://legal.dz/resource/law/2015-09-16/15-247#art_8_obligation_0_6544a86c_role_1caf6f205e>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_8_obligation_0_6544a86c_role_941d2fe066> ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_6> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_6> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_8> ;
    dznorm:hasCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_8_obligation_0_6544a86c_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتعين على المؤسسات المنصوص عليها في المطة الأخيرة من المادة 6 أعلاه، عندما تنجز عملية غير ممولة كليا أو جزئيا بمساهمة مؤقتة أو نهائية من الدولة أو الجماعات الإقليمية، أن تكيف إجراءاتها الخاصة مع تنظيم الصفقات العمومية والعمل على اعتمادها من هيئاتها المؤهلة"@ar ;
    dznorm:sourceArticle "art_8" .

