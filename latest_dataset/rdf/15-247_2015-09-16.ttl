<https://legal.dz/resource/law/2015-09-16/15-247#art_106> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_106" ;
    dzdoc:fullText "يجب أن تبين الصفقة التي تؤخذ خدماتها في شكل نفقات مراقبة ، طبيعة مختلف العناصر التي تساعد على تحديد السعر الواجب دفعه، وكيفية حسابها وقيمتها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_106> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_106_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_106_20150916_OpEnact_eda9ca2eb5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_106_obligation_0_c976602c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "106" ;
    dzdoc:position 105 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:definesTerm dzterm:advance_payment,
        dzterm:balance_settlement,
        dzterm:payment_on_account ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_109" ;
    dzdoc:fullText "يقصد في مفهوم المادة 108 أعلاه بما يأتي التسبيق : هو كل مبلغ يدفع قبل تنفيذ الخدمات موضوع العقد، وبدون مقابل للتنفيذ المادي للخدمة ، الدفع على الحساب : هو كل دفع تقوم به المصلحة المتعاقدة مقابل تنفيذ جزئي لموضوع الصفقة ، التسوية على رصيد حساب : هو الدفع المؤقت أو النهائي للسعر المنصوص عليه في الصفقة بعد التنفيذ الكامل والمرضي لموضوعها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_109> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_109_defocc_0cfb10e0151c>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_109_defocc_8b133344c430>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_109_defocc_aa9296ead7bc> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_109_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_109_20150916_OpEnact_218c1a4e40> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "109" ;
    dzdoc:position 108 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_108> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_108> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_121> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_121" ;
    dzdoc:fullText "يجب أن تحدد الصفقة الآجال المخولة ل المصلحة المتعاقدة لتقوم بعمليات الإثبات التي تعطي الحق في الدفع . ويبدأ سريان الآجال اعتبارا من تقديم صاحب الصفقة العمومية طلبا بذلك مدعما بالمبررات الضرورية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2015-09-16/15-247#art_121_right_0_b03c2fb3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_121> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_121_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_121_20150916_OpEnact_05ed947834> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_121_obligation_0_0e9071e6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "121" ;
    dzdoc:position 120 ;
    dzdoc:usesTerm dzterm:contract,
        dzterm:contracting_authority,
        dzterm:contractor .

<https://legal.dz/resource/law/2015-09-16/15-247#art_144> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_6> ;
    dzdoc:eId "art_144" ;
    dzdoc:fullText "يجب أن يحتوي عقد المناولة، وجوبا، على المعلومات الآتية : اسم ولقب وجنسية الشخص الذي يلزم مؤسسة المناولة، اسم ومقر مؤسسة المناولة، عند الاقتضاء، موضوع ومبلغ الخدمات محل المناولة، الأجل والجدول الزمني لإنجاز الخدمات محل مناولة وكيفيات تطبيق العقوبات المالية، عند الاقتضاء، طبيعة الأسعار وكيفيات الدفع وتحيين الأسعار ومراجعتها، عند الاقتضاء، كيفيات استلام الخدمات تقديم الكفالات والمسؤوليات والتأمينات، تسوية النزاعات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_144> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_144_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_144_20150916_OpEnact_4b7277043d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_144_obligation_0_0975ed98> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "144" ;
    dzdoc:position 143 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_146> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_7> ;
    dzdoc:eId "art_146" ;
    dzdoc:fullText "يمكن صندوق ضمان الصفقات العمومية تمويل الصفقات العمومية لتسهيل تنفيذها، لا سيما منها تسديد كشوف أو فواتير، في إطار رصد ديون أصحاب الصفقات العمومية وكذلك : 1 - في إطار التمويل المسبق لتحسين خزينة صاحب الصفقة العمومية قبل أن تعترف له المصلحة المتعاقدة بحقوقه في التسديد، 2 - في إطار القرض مقابل الحقوق المكتسبة، 3 - في إطار الضمان على التسبيقات الاستثنائية الممنوحة مقابل الرهون الحيازية لمختلف الصفقات المبرمة من قبل المصالح المتعاقدة المذكورة في المادة 6 من هذا المرسوم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_146_permission_0_bdcdd14a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_146> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_146_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_146_20150916_OpEnact_38d4955eb4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "146" ;
    dzdoc:position 145 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_6> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_6> ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:public_procurement,
        dzterm:public_procurement_guarantee_fund .

<https://legal.dz/resource/law/2015-09-16/15-247#art_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_1_subsec_2_subsubsec_2> ;
    dzdoc:eId "art_17" ;
    dzdoc:fullText "في حالة طلبات الأشغال التي لا تتطلب شهادة تصنيف وتأهيل ، يمكن المصلحة المتعاقدة أن تستشير الحرفيين، كما هم معرفين بموجب التشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_17_permission_0_8d0a9c3d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_17> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_17_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_17_20150916_OpEnact_e0ffe0ceec> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "17" ;
    dzdoc:position 16 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_17_condition_0_c6a48138> ;
    dzdoc:usesTerm dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_1_subsec_2_subsubsec_2> ;
    dzdoc:eId "art_19" ;
    dzdoc:fullText "يجب على المصلحة المتعاقدة إرفاق الالتزام بالنفقة بتقرير تقديمي مفصل يبرر فيه الاستشارة وكيفية اختيار المتعامل الاقتصادي الذي رست عليه الاستشارة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_19_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_19_20150916_OpEnact_fd49bb4306> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_19_obligation_0_47da1f4b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "19" ;
    dzdoc:position 18 ;
    dzdoc:usesTerm dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_214> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_4_subsec_2> ;
    dzdoc:eId "art_214" ;
    dzdoc:fullText "لتمكين سلطة ضبط الصفقات العمومية وتفويضات المرفق العام من القيام بالإحصاء الاقتصادي المذكور في المادة 213 أعلاه، تعد المصلحة المتعاقدة بطاقات إحصائية وترسلها إليها . يحدد نموذج البطاقة السالفة الذكر وكذا كيفيات إجراء هذا الإحصاء بموجب قرار من الوزير المكلف بالمالية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_214> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_214_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_214_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_214_20150916_OpEnact_24902a066f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_214_obligation_0_e2734664>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_214_obligation_1_2b268f50> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 214" ;
    dzdoc:position 213 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_213> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_213> ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:minister_of_finance,
        dzterm:regulatory_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_1_dup_1> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "يمكن أن يكون طلب العروض وطنيا و / أو دوليا، ويمكن أن يتم حسب أحد الأشكال الآتية: طلب العروض المفتوح، طلب العروض المفتوح مع اشتراط قدرات دنيا، طلب العروض المحدود، المسابقة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_42_permission_0_0f52c108> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_42> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_42_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_42_20150916_OpEnact_fd2ff95a70> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "42" ;
    dzdoc:position 41 ;
    dzdoc:usesTerm dzterm:call_for_tenders .

<https://legal.dz/resource/law/2015-09-16/15-247#art_43> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:definesTerm dzterm:open_call_for_tenders ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_1_dup_1> ;
    dzdoc:eId "art_43" ;
    dzdoc:fullText "طلب العروض المفتوح هو إجراء يمكن من خلاله أي مترشح مؤهل أن يقدم تعهدا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_43_permission_0_3f2ffaa6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_43> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_43_defocc_ffad95258834> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_43_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_43_20150916_OpEnact_8f45b4f72a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "43" ;
    dzdoc:position 42 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:definesTerm dzterm:open_call_for_tenders_with_minimum_capacities ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_1_dup_1> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "طلب العروض المفتوح مع اشتراط قدرات دنيا هو إجراء يسمح فيه لكل المرشحين الذين تتوفر فيهم بعض الشروط الدنيا المؤهلة التي تحددها المصلحة المتعاقدة مسبقا قبل إطلاق الإجراء، بتقديم تعهد ولا يتم انتقاء قبلي للمرشحين من طرف المصلحة المتعاقدة. تخص الشروط المؤهلة القدرات التقنية والمالية والمهنية الضرورية لتنفيذ الصفقة. وتكون متناسبة مع طبيعة وتعقيد وأهمية المشروع."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_44_permission_0_f6f31f41> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_44> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_44_defocc_5d4387942467> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_44_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_44_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_44_20150916_OpEnact_ad87d237fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "44" ;
    dzdoc:position 43 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_1_dup_1> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "يجب على المصلحة المتعاقدة ، في إطار إجراء التراضي البسيط ، أن : تحدد حاجاتها، في ظل احترام أحكام المادة 27 أعلاه، إلا في الحالات الاستثنائية المنصوص عليها في هذا المرسوم، تتأكد من قدرات المتعامل الاقتصادي، كما هي محددة في المادة 54 من هذا المرسوم، تختار متعاملا اقتصاديا يقدم عرضا له مزايا من الناحية الاقتصادية، كما هي محددة في المادة 72 من هذا المرسوم، تنظم المفاوضات حسب الشروط المنصوص عليها في الفقرة 6 من المادة 52 أدناه، تؤسس المفاوضات المتعلقة بالعرض المالي على أسعار مرجعية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_50> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_50_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_50_20150916_OpEnact_d57da08257> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_50_obligation_0_a8dddafd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "50" ;
    dzdoc:position 49 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_27>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_52>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_54>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_72> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_27>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_52>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_54>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_72> ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:direct_negotiation .

<https://legal.dz/resource/law/2015-09-16/15-247#art_55> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_2_dup_1> ;
    dzdoc:eId "art_55" ;
    dzdoc:fullText "يمكن أن يكتسي التأهيل طابع شهادة تأهيل أو اعتماد إلزامي إذا ورد في نصوص تنظيمية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_55_permission_0_ce744953> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_55> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_55_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_55_20150916_OpEnact_b722b99b7e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "55" ;
    dzdoc:position 54 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_55_condition_0_f6bd8456> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_3_dup_1> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "يجب على المصلحة المتعاقدة أن تعلل اختيارها عند كل رقابة تمارسها أي سلطة مختصة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_60_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_60_20150916_OpEnact_4673cfebe5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_60_obligation_0_907efa7a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 60" ;
    dzdoc:position 59 ;
    dzdoc:usesTerm dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "تخضع الصفقات العمومية المبرمة من طرف صاحب مشروع منتدب باسم ولحساب صاحب مشروع تطبيقا لاتفاقية إشراف منتدب على مشروع، لأحكام هذا الباب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_10_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_10_20150916_OpEnact_ce6e051733> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_10_obligation_0_07f3d1b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "10" ;
    dzdoc:position 9 ;
    dzdoc:usesTerm dzterm:delegated_project_owner,
        dzterm:project_owner,
        dzterm:public_procurement .

<https://legal.dz/resource/law/2015-09-16/15-247#art_163> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:definesTerm dzterm:external_control_purpose ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_1_subsubsec_2> ;
    dzdoc:eId "art_163" ;
    dzdoc:fullText "تتمثل غاية الرقابة الخارجية ، في مفهوم هذا المرسوم وفي إطار العمل الحكومي، في التحقق من مطابقة الصفقات العمومية المعروضة على الهيئات الخارجية المذكورة في القسم الثاني من هذا الفصل، للتشريع والتنظيم المعمول بهما. وترمي الرقابة الخارجية أيضا إلى التحقق من مطابقة التزام المصلحة المتعاقدة للعمل المبرمج بكيفية نظامية . وتخضع الملفات التي تدخل في اختصاص لجان الصفقات للرقابة البعدية، طبقا للأحكام التشريعية والتنظيمية المعمول بها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_163> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_163_defocc_d0296a078c51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_163_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_163_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_163_20150916_OpEnact_cf9372bdf7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_163_obligation_0_c2f255c5>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_163_obligation_1_96d25d08> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "163" ;
    dzdoc:position 162 ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:decree,
        dzterm:external_control,
        dzterm:procurement_committees,
        dzterm:public_procurement .

<https://legal.dz/resource/law/2015-09-16/15-247#art_166> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2> ;
    dzdoc:eId "art_166" ;
    dzdoc:fullText "يعين أعضاء اللجان المنشأة بموجب أحكام المواد 171 و 173 و 174 أدناه، بموجب مقرر من رئيس اللجنة. ويعين أعضاء اللجان المنشأة، بموجب أحكام المادتين 172 و 175 أدناه، بموجب مقرر من السلطة الوصية على المؤسسة العمومية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_166> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_166_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_166_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_166_20150916_OpEnact_b26ad4b404> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_166_obligation_0_dabb057a>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_166_obligation_1_bcdb59d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "166" ;
    dzdoc:position 165 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_171>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_172>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_173>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_174>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_175> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_171>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_172>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_173>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_174>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_175> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_177> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_1> ;
    dzdoc:eId "art_177" ;
    dzdoc:fullText "يجب أن تعتمد لجنة صفقات المصلحة المتعاقدة النظام الداخلي النموذجي الموافق عليه وفق الشروط المنصوص عليها في المادة 183 أدناه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_177> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_177_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_177_20150916_OpEnact_12ebae9122> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_177_obligation_0_1ec38174> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 177" ;
    dzdoc:position 176 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_183> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_183> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_185> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_2> ;
    dzdoc:eId "art_185" ;
    dzdoc:fullText "تتشكل اللجنة القطاعية للصفقات كما يأتي : الوزير المعني أو ممثله، رئيسا، ممثل الوزير المعني ، نائب رئيس، ممثل المصلحة المتعاقدة ، ممثلان (2) عن القطاع المعني، ممثلان (2) عن وزير المالية (المديرية العامة للميزانية والمديرية العامة للمحاسبة)، ممثل عن الوزير المكلف بالتجارة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_185> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_185_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_185_20150916_OpEnact_0207f9b65d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "185" ;
    dzdoc:position 184 ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:minister,
        dzterm:minister_of_commerce,
        dzterm:minister_of_finance,
        dzterm:sectoral_procurement_committee .

<https://legal.dz/resource/law/2015-09-16/15-247#art_192> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_3> ;
    dzdoc:eId "art_192" ;
    dzdoc:fullText "تمنح تعويضات لأعضاء لجان الصفقات بصوت تداولي والمقررين والمسؤولين المكلفين بكتابات لجان الصفقات . تحدد كيفيات تطبيق أحكام هذه المادة بموجب مرسوم تنفيذي."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2015-09-16/15-247#art_192_right_0_cbf83910> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_192> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_192_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_192_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_192_20150916_OpEnact_d6e22b25c6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "192" ;
    dzdoc:position 191 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_192> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_192> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_197> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_3> ;
    dzdoc:eId "art_197" ;
    dzdoc:fullText "يبلغ أعضاء اللجنة بطاقة تحليلية وتقريرا تقديميا عن كل مشروع صفقة يشملان العناصر الأساسية لممارسة مهامهم و تتولى المصلحة المتعاقدة إعداد هذه المذكرة التحليلية المرفقة بالتقرير التقديمي، طبقا لنموذج يحدده النظام الداخلي وترسلها في أجل لا يقل عن ثمانية (8) أيام قبل انعقاد اجتماع اللجنة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_197> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_197_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_197_20150916_OpEnact_31df72e2f7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_197_obligation_0_ed0ff992>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_197_obligation_1_9c549594> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 197" ;
    dzdoc:position 196 ;
    dzdoc:usesTerm dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_209> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_2> ;
    dzdoc:eId "art_209" ;
    dzdoc:fullText "تخضع اتفاقيات تفويض المرفق العام لإبرامها إلى المبادئ المنصوص عليها في المادة 5 من هذا المرسوم . وزيادة على ذلك، يخضع المرفق العام عند تنفيذ اتفاقية تفويضه على الخصوص، إلى مبادئ الاستمرارية والمساواة وقابلية التكيف ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_209> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_209_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_209_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_209_20150916_OpEnact_af33fa7b9f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_209_obligation_0_aaf8e259>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_209_obligation_1_4bc37ed3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 209" ;
    dzdoc:position 208 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_5> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_5> ;
    dzdoc:usesTerm dzterm:public_service .

<https://legal.dz/resource/law/2015-09-16/15-247#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "يمكن المصلحة المتعاقدة من أجل تحقيق أهدافها أن تلجأ بغية تنفيذ خدماتها إلى إبرام صفقات تعقد مع المؤسسات الخاضعة للقانون الجزائري و / أو المؤسسات الأجنبية ، طبقا لأحكام هذا المرسوم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_38_permission_0_a223e734> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_38_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_38_20150916_OpEnact_531f7d6d23> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 38" ;
    dzdoc:position 37 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_38_condition_0_d19726c2> ;
    dzdoc:usesTerm dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_7> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "تخصص الخدمات المرتبطة بالنشاطات الحرفية الفنية للحرفيين ، كما هم معرفين في التشريع والتنظيم المعمول بهما، ماعدا في حالة الاستحالة المبررة قانونا من المصلحة المتعاقدة، باستثناء الخدمات المسيرة بقواعد خاصة. تحدد كيفيات تطبيق أحكام هذه المادة ، عند الحاجة، بموجب قرار من الوزير المكلف بالمالية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_86_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_86_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_86_20150916_OpEnact_6ad98e5179> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_86_obligation_0_b809c4b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "86" ;
    dzdoc:position 85 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_86> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_86> ;
    dzdoc:usesTerm dzterm:minister_finance .

<https://legal.dz/resource/law/2015-09-16/15-247#art_92> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_8> ;
    dzdoc:eId "art_92" ;
    dzdoc:fullText "لا يمكن المصلحة المتعاقدة ، ولمدة أربع (4) سنوات، أن تمنح صفقة عمومية، بأي شكل من الأشكال، لموظفيها السابقين الذين توقفوا عن أداء مهامهم، إلا في الحالات المنصوص عليها في التشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_92_permission_0_8612daaf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_92> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_92_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_92_20150916_OpEnact_918e5c1d4e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "92" ;
    dzdoc:position 91 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_92_condition_0_bc7a7ebf> ;
    dzdoc:usesTerm dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "يدفع أجر المتعامل المتعاقد وفق الكيفيات الآتية : بالسعر الإجمالي والجزافي، بناء على قائمة سعر الوحدة، بناء على النفقات المراقبة، بسعر مختلط يمكن المصلحة المتعاقدة مراعاة لاحترام الأسعار، تفضيل دفع مستحقات الصفقة وفق صيغة السعر الإجمالي والجزافي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_96_permission_0_b8605d84> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_96_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_96_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_96_20150916_OpEnact_708fb3cbca> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_96_obligation_0_72af8759> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 96" ;
    dzdoc:position 95 ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:contractor .

