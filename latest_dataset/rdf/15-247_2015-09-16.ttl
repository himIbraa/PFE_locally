<https://legal.dz/resource/law/2015-09-16/15-247#art_195_obligation_3_a450a44c_ref_b63036f4df24> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "القانون رقم 11-10- المؤرخ في 22 يونيو سنة 2011"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/2011-06-22/11-10#art_1"^^xsd:anyURI ;
