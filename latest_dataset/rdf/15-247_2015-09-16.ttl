<https://legal.dz/resource/law/2015-09-16/15-247#version_art_61> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون اللجوء إلى الإشهار الصحفي إلزاميا في الحالات الآتية : طلب العروض المفتوح، طلب العروض المفتوح مع اشتراط قدرات دنيا، طلب العروض المحدود، المسابقة، التراضي بعد الاستشارة، عند الاقتضاء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_61_20150916_OpEnact_a9d0786e77> ;
    dzdoc:replacementText "يكون اللجوء إلى الإشهار الصحفي إلزاميا في الحالات الآتية : طلب العروض المفتوح، طلب العروض المفتوح مع اشتراط قدرات دنيا، طلب العروض المحدود، المسابقة، التراضي بعد الاستشارة، عند الاقتضاء ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2015-09-16/15-247#art_61> ;
