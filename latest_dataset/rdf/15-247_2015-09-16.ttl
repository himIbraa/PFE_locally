<https://legal.dz/resource/law/2015-09-16/15-247#art_139_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_139> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يخضع الملحق في مفهوم المادة 136 أعلاه، إلى فحص هيئات الرقابة الخارجية القبلية، إذا كان موضوعه لا يعدل تسمية الأطراف المتعاقدة والضمانات التقنية والمالية وأجل التعاقد، وكان مبلغه أو المبلغ الإجمالي لمختلف الملاحق، لا يتجاوز ، زيادة أو نقصانا، نسبة عشرة في المائة (10) من المبلغ الأصلي للصفقة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_139_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_139> ;
    dzdoc:position 1 ;
    dzdoc:text "ويخضع الملحق لهيئة الرقابة الخارجية في حالة ما إذا تضمن خدمات تكميلية في مفهوم المادة 136 أعلاه تتجاوز مبالغها النسبة المحددة أعلاه."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_13_condition_0_53d90f81> a dznorm:Condition ;
    dznorm:conditionText "كل صفقة عمومية يساوي فيها المبلغ التقديري لحاجات المصلحة المتعاقدة اثني عشر مليون دينار 12.000.000 دج أو يقل عنه للأشغال أو اللوازم، وستة ملايين دينار 6.000.000 دج للدراسات أو الخدمات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_13> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_13_condition_1_322264db> a dznorm:Condition ;
