    dznorm:provisionText "تجتمع اللجنة القطاعية للصفقات ولجنة صفقات المصلحة المتعاقدة، التي تدعى كل منهما في صلب النص \"اللجنة\"، بمبادرة من رئيس كل منهما"@ar ;
    dznorm:sourceArticle "art_191" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_191_obligation_1_dda7f3bd> a dznorm:Obligation ;
