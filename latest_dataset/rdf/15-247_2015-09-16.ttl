<https://legal.dz/resource/law/2015-09-16/15-247#art_48_obligation_6_f50dc6b0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2015-09-16/15-247#art_48_obligation_6_f50dc6b0_action_60f0ab10e5> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_48> ;
    dznorm:position 6 ;
    dznorm:provisionText "يجب ألا ترد أي معلومة تتعلق بمبلغ العرض المالي في أظرفة الخدمات، ولا في أظرفة العروض التقنية، تحت طائلة رفض هذه العروض"@ar ;
    dznorm:sourceArticle "art_48" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_48_obligation_6_f50dc6b0_action_60f0ab10e5> a dznorm:Action ;
