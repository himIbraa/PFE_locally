        <https://legal.dz/resource/law/2015-09-16/15-247#art_155> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_154>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_155> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_153_condition_0_62004983>,
