<https://legal.dz/resource/law/2015-09-16/15-247#version_art_93> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن المتعامل الاقتصادي المتعهد في صفقة عمومية أن يكون في وضعية نزاع مصالح ذي علاقة بالصفقة المعنية. و في حالة ظهور هذه وضعية ، فإنه يجب عليه إعلام المصلحة المتعاقدة بذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_93_20150916_OpEnact_898adf07ea> ;
    dzdoc:replacementText "لا يمكن المتعامل الاقتصادي المتعهد في صفقة عمومية أن يكون في وضعية نزاع مصالح ذي علاقة بالصفقة المعنية. و في حالة ظهور هذه وضعية ، فإنه يجب عليه إعلام المصلحة المتعاقدة بذلك ."@ar ;
