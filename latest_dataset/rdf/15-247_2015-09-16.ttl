    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_167> ;
    dznorm:position 0 ;
    dznorm:provisionText "يحدد مسؤول الهيئة العمومية المنصوص عليها في المادة 4 أعلاه، تشكيلة لجنة الصفقات الموضوعة لدى المؤسسة المعنية."@ar ;
    dznorm:sourceArticle "art_167" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_167_obligation_0_dceb43db_ref_bb4e593479ad> a dzdoc:Reference ;
    rdfs:label "المادة 4"@ar ;
    dzdoc:frbrUri "#art_4"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2015-09-16/15-247#art_4> ;
    dzdoc:sourceEId "art_167" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يحدد مسؤول الهيئة العمومية المنصوص عليها في المادة 4 أعلاه، تشكيلة لجنة الصفقات الموضوعة لدى المؤسسة المعنية."@ar ;
    dzdoc:targetEId "art_4" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_167_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_167> ;
    dzdoc:position 0 ;
    dzdoc:text "يحدد مسؤول الهيئة العمومية المنصوص عليها في المادة 4 أعلاه، تشكيلة لجنة الصفقات الموضوعة لدى المؤسسة المعنية. وتكون اختصاصات هذه اللجنة وقواعد عملها هي تلك المنصوص عليها بخصوص اللجنة القطاعية للصفقات."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_167_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_167> ;
    dzdoc:position 1 ;
    dzdoc:text "تمارس الرقابة على الصفقات العمومية لمجلس الأمة والمجلس الشعبي الوطني وفق القواعد التي يسنها النظام الداخلي لكل منهما."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_168_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_168> ;
    dzdoc:position 0 ;
    dzdoc:text "تختص بالرقابة الخارجية القبلية للصفقات العمومية التي تبرمها وزارة الدفاع الوطني، حصريا، لجنة أو لجان موضوعة لدى وزارة الدفاع الوطني التي تحدد تشكيلتها وصلاحياتها."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_169_condition_0_58c2a36a> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2015-09-16/15-247#art_169_condition_0_58c2a36a_ref_9130659868fc> ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_82> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_82> ;
    dznorm:conditionText "الشروط المحددة في المادة 82 من هذا المرسوم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_169> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_169_condition_0_58c2a36a_ref_9130659868fc> a dzdoc:Reference ;
    rdfs:label "المادة 82"@ar ;
    dzdoc:frbrUri "#art_82"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2015-09-16/15-247#art_82> ;
    dzdoc:sourceEId "art_169" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "الشروط المحددة في المادة 82 من هذا المرسوم"@ar ;
    dzdoc:targetEId "art_82" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_169_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_169> ;
    dzdoc:position 0 ;
    dzdoc:text "تختص لجنة الصفقات بتقديم مساعدتها في مجال تحضير الصفقات العمومية وإتمام تراتيبها، ودراسة دفاتر الشروط والصفقات والملاحق ومعالجة الطعون التي يقدمها المتعهدون حسب الشروط المحددة في المادة 82 من هذا المرسوم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_16_condition_0_7dafa3ec> a dznorm:Condition ;
    dznorm:conditionText "في حالة الخدمات ذات النمط العادي والطابع المتكرر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_16> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_16_condition_1_0025ace7> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2015-09-16/15-247#art_16_condition_1_0025ace7_ref_99135948a979> ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_13> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_13> ;
    dznorm:conditionText "إذا تم تجاوز الحدود المنصوص عليها في المادة 13 أعلاه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_16> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_16_condition_1_0025ace7_ref_99135948a979> a dzdoc:Reference ;
    rdfs:label "المادة 13"@ar ;
    dzdoc:frbrUri "#art_13"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2015-09-16/15-247#art_13> ;
    dzdoc:sourceEId "art_16" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "إذا تم تجاوز الحدود المنصوص عليها في المادة 13 أعلاه"@ar ;
    dzdoc:targetEId "art_13" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_16_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_16> ;
    dzdoc:position 0 ;
    dzdoc:text "في حالة الخدمات ذات النمط العادي والطابع المتكرر ، يمكن المصلحة المتعاقدة اللجوء للاستشارة بغض النظر عن الأحكام المخالفة لـ المادة 27 أدناه."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_16_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_16> ;
    dzdoc:position 1 ;
    dzdoc:text "إذا تم تجاوز الحدود المنصوص عليها في المادة 13 أعلاه، فإنه لا يمكن الالتزام بأي نفقة مماثلة بالرجوع لتجانس الحاجات فيما يخص طلبات اللوازم والدراسات والخدمات وبالرجوع لنفس عملية الأشغال بالنسبة لطلبات الأشغال، دون اللجوء للإجراءات الشكلية، باستثناء الحالات المنصوص عليها في المادة 18 أدناه."@ar .

