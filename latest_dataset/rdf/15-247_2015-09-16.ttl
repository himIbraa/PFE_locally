    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_213> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_89> ;
    dznorm:position 1 ;
    dznorm:provisionText "تمسك سلطة ضبط الصفقات العمومية وتفويضات المرفق العام المنشأة بموجب أحكام المادة 213 من هذا المرسوم، قائمة المنع السالفة الذكر"@ar ;
    dznorm:sourceArticle "art_89" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_89_obligation_1_29afcfde_ref_16b6f38c794e> a dzdoc:Reference ;
    rdfs:label "المادة 213"@ar ;
    dzdoc:frbrUri "#art_213"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2015-09-16/15-247#art_213> ;
    dzdoc:sourceEId "art_89" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "تمسك سلطة ضبط الصفقات العمومية وتفويضات المرفق العام المنشأة بموجب أحكام المادة 213 من هذا المرسوم، قائمة المنع السالفة الذكر"@ar ;
    dzdoc:targetEId "art_213" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_89_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_89> ;
    dzdoc:position 0 ;
    dzdoc:text "دون الإخلال بالمتابعات الجزائية، كل من يقوم بأفعال أو مناورات ترمي إلى تقديم وعد لعون عمومي بمنح أو تخصيص، بصفة مباشرة أو غير مباشرة، إما لنفسه أو لكيان آخر ، مكافأة أو امتياز مهما كانت طبيعته، بمناسبة تحضيرصفقة عمومية أو ملحق أو إبرامه أو مراقبته أو التفاوض بشأن ذلك أو تنفيذه، من شأنه أن يشكل سببا كافيا لاتخاذ أي تدبير ردعي، لا سيما فسخ أو إلغاء الصفقة العمومية أو الملحق المعني وتسجيل المؤسسة المعنية في قائمة المتعاملين الاقتصاديين الممنوعين من المشاركة في الصفقات العمومية."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_89_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_89> ;
    dzdoc:position 1 ;
    dzdoc:text "يتعين على المتعامل المتعاقد اكتتاب التصريح بالنزاهة المنصوص على نموذجه في المادة 67 من هذا المرسوم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_89_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_89> ;
    dzdoc:position 2 ;
    dzdoc:text "تمسك سلطة ضبط الصفقات العمومية وتفويضات المرفق العام المنشأة بموجب أحكام المادة 213 من هذا المرسوم، قائمة المنع السالفة الذكر."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_89_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_89> ;
    dzdoc:position 3 ;
    dzdoc:text "تحدد كيفيات التسجيل والسحب من قائمة المنع بموجب قرار من الوزير المكلف بالمالية."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_8_obligation_0_6544a86c_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/law/2015-09-16/15-247#art_8_obligation_0_6544a86c> ;
    dznorm:conditionText "عندما تنجز عملية غير ممولة كليا أو جزئيا بمساهمة مؤقتة أو نهائية من الدولة أو الجماعات الإقليمية"@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_8_obligation_0_6544a86c_ref_623bcbdde96f> a dzdoc:Reference ;
    rdfs:label "المادة 6"@ar ;
    dzdoc:frbrUri "#art_6"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2015-09-16/15-247#art_6> ;
    dzdoc:sourceEId "art_8" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يتعين على المؤسسات المنصوص عليها في المطة الأخيرة من المادة 6 أعلاه، عندما تنجز عملية غير ممولة كليا أو جزئيا بمساهمة مؤقتة أو نهائية من الدولة أو الجماعات الإقليمية، أن تكيف إجراءاتها الخاصة مع تنظيم الصفقات العمومية والعمل على اعتمادها من هيئاتها المؤهلة"@ar ;
    dzdoc:targetEId "art_6" .

