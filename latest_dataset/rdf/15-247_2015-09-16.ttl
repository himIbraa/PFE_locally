    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_153> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_153_obligation_6_003b3598> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2015-09-16/15-247#art_153_obligation_6_003b3598_role_7c838ed8b8> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_153> ;
    dznorm:position 6 ;
    dznorm:provisionText "ويخضع لجوء المصالح المتعاقدة، في إطار تسوية النزاعات التي تطرأ عند تنفيذ الصفقات العمومية المبرمة مع متعاملين متعاقدين أجانب، إلى هيئة تحكيم دولية بناء على اقتراح من الوزير المعني، للموافقة المسبقة أثناء اجتماع الحكومة"@ar ;
    dznorm:sourceArticle "art_153" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_153_obligation_6_003b3598_role_7c838ed8b8> a dznorm:Role ;
    rdfs:label "اقتراح من الوزير المعني"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "ويخضع لجوء المصالح المتعاقدة، في إطار تسوية النزاعات التي تطرأ عند تنفيذ الصفقات العمومية المبرمة مع متعاملين متعاقدين أجانب، إلى هيئة تحكيم دولية بناء على اقتراح من الوزير المعني، للموافقة المسبقة أثناء اجتماع الحكومة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_153> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_153_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_153> ;
    dzdoc:position 0 ;
    dzdoc:text "تسوى النزاعات التي تطرأ عند تنفيذ الصفقة في إطار الأحكام التشريعية والتنظيمية المعمول بها."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_153_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_153> ;
    dzdoc:position 1 ;
    dzdoc:text "يجب على المصلحة المتعاقدة، دون المساس بتطبيق أحكام الفقرة أعلاه، أن تبحث عن حل ودي للنزاعات التي تطرأ عند تنفيذ صفقاتها كلما سمح هذا الحل بما يأتي : إيجاد التوازن للتكاليف المترتبة على كل طرف من الطرفين، التوصل إلى أسرع إنجاز لموضوع الصفقة، الحصول على تسوية نهائية أسرع وبأقل تكلفة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_153_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_153> ;
    dzdoc:position 2 ;
    dzdoc:text "وفي حالة عدم اتفاق الطرفين، يعرض النزاع أمام لجنة التسوية الودية للنزاعات المختصة، المنشأة بموجب أحكام المادة 154 أدناه لدراسته، حسب الشروط المنصوص عليها في المادة 155 أدناه."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_153_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_153> ;
    dzdoc:position 3 ;
    dzdoc:text "يجب على المصلحة المتعاقدة أن تدرج في دفتر الشروط، اللجوء لإجراء التسوية الودية للنزاعات هذا، قبل كل مقاضاة أمام العدالة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_153_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_153> ;
    dzdoc:position 4 ;
    dzdoc:text "ويجب على اللجنة أن تبحث على العناصر المتعلقة بالقانون أو الوقائع لإيجاد حل ودي ومنصف، حسب الشروط المذكورة أعلاه، للنزاعات الناجمة عن تنفيذ الصفقات والمطروحة أمامها."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_153_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_153> ;
    dzdoc:position 5 ;
    dzdoc:text "يجب أن لا يكون أعضاء اللجنة قد شاركوا في إجراءات إبرام ومراقبة وتنفيذ الصفقة المعنية."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_153_para_6> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_153> ;
    dzdoc:position 6 ;
    dzdoc:text "ويخضع لجوء المصالح المتعاقدة، في إطار تسوية النزاعات التي تطرأ عند تنفيذ الصفقات العمومية المبرمة مع متعاملين متعاقدين أجانب، إلى هيئة تحكيم دولية بناء على اقتراح من الوزير المعني، للموافقة المسبقة أثناء اجتماع الحكومة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_154_obligation_0_d8bcd03d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_154> ;
    dznorm:position 0 ;
    dznorm:provisionText "تنشأ لدى كل وزير ومسؤول هيئة عمومية وكل وال لجنة للتسوية الودية للنزاعات الناجمة عن تنفيذ الصفقات العمومية المبرمة مع المتعاملين الاقتصاديين الجزائريين"@ar ;
    dznorm:sourceArticle "art_154" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_154_obligation_1_a91c11e4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_154> ;
    dznorm:position 1 ;
    dznorm:provisionText "يعين أعضاء اللجان المختارون نظرا لكفاءتهم في الميدان المعني، بموجب مقرر من مسؤول الهيئة العمومية أو الوزير أو الوالي المعني"@ar ;
    dznorm:sourceArticle "art_154" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_154_obligation_2_c4f41a41> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_154> ;
    dznorm:position 2 ;
    dznorm:provisionText "ويعين رئيس اللجنة مقررا من ضمن أعضاء اللجنة"@ar ;
    dznorm:sourceArticle "art_154" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_154_obligation_3_9e9ee987> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_154> ;
    dznorm:position 3 ;
    dznorm:provisionText "توضع أمانة اللجنة لدى رئيس اللجنة"@ar ;
    dznorm:sourceArticle "art_154" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_154_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_154> ;
    dzdoc:position 0 ;
    dzdoc:text "تنشأ لدى كل وزير ومسؤول هيئة عمومية وكل وال لجنة للتسوية الودية للنزاعات الناجمة عن تنفيذ الصفقات العمومية المبرمة مع المتعاملين الاقتصاديين الجزائريين."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_154_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_154> ;
    dzdoc:position 1 ;
    dzdoc:text "1/ لجنة التسوية الودية للنزاعات في الوزارة والهيئة العمومية تختص بدراسة نزاعات الإدارة المركزية ومصالحها الخارجية أو الهيئة العمومية والمؤسسات العمومية الوطنية التابعة لها."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_154_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_154> ;
    dzdoc:position 2 ;
    dzdoc:text "تتشكل اللجنة كما يأتي : ممثل عن الوزير أو مسؤول الهيئة العمومية، رئيسا، ممثل عن المصلحة المتعاقدة، ممثل عن الوزارة المعنية بموضوع النزاع، ممثل عن المديرية العامة للمحاسبة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_154_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_154> ;
    dzdoc:position 3 ;
    dzdoc:text "2 لجنة التسوية الودية للنزاعات في الولاية تختص بدراسة نزاعات الولاية والبلديات والمؤسسات العمومية المحلية التابعة لها والمصالح غير الممركزة للدولة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_154_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_154> ;
    dzdoc:position 4 ;
    dzdoc:text "تتشكل اللجنة كما يأتي : ممثل عن الوالي، رئيسا، ممثل عن المصلحة المتعاقدة، ممثل عن المديرية التقنية للولاية المعنية بموضوع النزاع، ممثل عن المحاسب العمومي المكلف."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_154_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_154> ;
    dzdoc:position 5 ;
    dzdoc:text "يعين أعضاء اللجان المختارون نظرا لكفاءتهم في الميدان المعني، بموجب مقرر من مسؤول الهيئة العمومية أو الوزير أو الوالي المعني."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_154_para_6> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_154> ;
    dzdoc:position 6 ;
    dzdoc:text "ويمكن رئيس اللجنة أن يستعين على سبيل الاستشارة، بكل كفاءة من شأنها توضيح أشغال اللجنة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_154_para_7> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_154> ;
    dzdoc:position 7 ;
    dzdoc:text "ويعين رئيس اللجنة مقررا من ضمن أعضاء اللجنة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_154_para_8> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_154> ;
    dzdoc:position 8 ;
    dzdoc:text "توضع أمانة اللجنة لدى رئيس اللجنة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_154_right_0_de0fad76> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
