    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب عليها الرجوع لبطاقيتها المعدة طبقا لأحكام المادة 58 أدناه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_obligation_5_380212ba_ref_f1469234c1cc> a dzdoc:Reference ;
    rdfs:label "المادة 58"@ar ;
    dzdoc:frbrUri "#art_58"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2015-09-16/15-247#art_58> ;
    dzdoc:sourceEId "art_52" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يجب عليها الرجوع لبطاقيتها المعدة طبقا لأحكام المادة 58 أدناه"@ar ;
    dzdoc:targetEId "art_58" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:position 0 ;
    dzdoc:text "تستشير المصلحة المتعاقدة المؤسسات التي شاركت في طلب العروض برسالة استشارة، وبنفس دفتر الشروط، باستثناء الأحكام الخاصة بطلب العروض. ويمكن المصلحة المتعاقدة تقليص مدة تحضير العروض."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا يخضع دفتر الشروط لدراسة لجنة الصفقات العمومية."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_para_10> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:position 10 ;
    dzdoc:text "وفي حالة الخدمات التي تنفذ في الخارج أو تلك التي تكتسي طابعا سريا، يعوض إعلان المنح المؤقت للصفقة بمراسلة المتعاملين الاقتصاديين الذين تمت استشارتهم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_para_11> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:position 11 ;
    dzdoc:text "يمكن المتعهد الذي تمت استشارته وعارض اختيار المصلحة المتعاقدة أن يرفع طعنا حسب الشروط المحددة في المادة 82 من هذا المرسوم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_para_12> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:position 12 ;
    dzdoc:text "ولأخذ خصوصية بعض الصفقات بعين الاعتبار، ولا سيما منها تلك التي تنفذ في الخارج والتي تبرم مع الفنانين أو مع المؤسسات المصغرة، حسب الشروط المنصوص عليها في المادة 87 أدناه ، فإنه يمكن المصلحة المتعاقدة تكييف محتوى الملف الإداري المطلوب من المتعاملين الاقتصاديين الذين تمت استشارتهم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_para_13> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:position 13 ;
    dzdoc:text "إذا استشارت المصلحة المتعاقدة المتعاملين الاقتصاديين مباشرة، فإنه يجب عليها الرجوع لبطاقيتها المعدة طبقا لأحكام المادة 58 أدناه."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:position 2 ;
    dzdoc:text "وإذا قررت المصلحة المتعاقدة استشارة مؤسسات لم تشارك في طلب العروض، فإنه يجب عليها نشر الإعلان عن الاستشارة حسب الأشكال المنصوص عليها في هذا المرسوم. وتستعمل المصلحة المتعاقدة نفس دفتر الشروط باستثناء الأحكام الخاصة بطلب العروض."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:position 3 ;
    dzdoc:text "وإذا تحتم على المصلحة المتعاقدة تعديل بعض أحكام دفتر الشروط التي تمس شروط المنافسة، فإنه يجب عليها تقديمه لدراسة لجنة الصفقات العمومية المختصة وإطلاق طلب عروض جديد."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:position 4 ;
    dzdoc:text "تحدد قائمة الدراسات واللوازم والخدمات الخاصة والأشغال المذكورة في المطتين 2 و 3 من المادة 51 أعلاه، بموجب مقرر من سلطة الهيئة العمومية السيادية للدولة أو مسؤول الهيئة العمومية أو الوزير المعني، بعد أخد رأي لجنة الصفقات للهيئة العمومية أو اللجنة القطاعية للصفقات، حسب الحالة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:position 5 ;
    dzdoc:text "يتم لجوء المصلحة المتعاقدة إلى التراضي بعد الاستشارة في الحالات المنصوص عليها في المطات 2 و 3 و4 و5 من المادة 51 أعلاه، برسالة استشارة على أساس دفتر شروط يخضع قبل الشروع في الإجراء، لتأشيرة لجنة الصفقات المختصة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_para_6> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:position 6 ;
    dzdoc:text "وفيما يخص العروض التي تستجيب لحاجات المصالح المتعاقدة والتي تكون مطابقة بصفة جوهرية للمقتضيات التقنية والمالية المنصوص عليها في دفتر الشروط، فإنه يمكن لجنة فتح الأظرفة وتقييم العروض أن تطلب، بواسطة المصلحة المتعاقدة كتابيا، من المتعاملين الاقتصاديين الذين تمت استشارتهم، توضيحات أو تفصيلات بشأن عروضهم. كما يمكنها أن تطلب منهم استكمال عروضهم. ويمكن المصلحة المتعاقدة أن تتفاوض حول شروط تنفيذ الصفقة. وتجرى المفاوضات من طرف لجنة تعينها وترأسها المصلحة المتعاقدة، في ظل احترام الأحكام المنصوص عليها في المادة 5 من هذا المرسوم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_para_7> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:position 7 ;
    dzdoc:text "ويجب على المصلحة المتعاقدة السهر على ضمان إمكانية تتبع أطوار المفاوضات في محضر."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_para_8> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:position 8 ;
    dzdoc:text "عندما تلجأ المصلحة المتعاقدة مباشرة للتراضي بعد الاستشارة ولا تستلم أي عرض أو أنه لا يمكن، بعد تقييم العروض المستلمة، اختيار أي عرض، تعلن عدم جدوى الإجراء."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_para_9> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_52> ;
    dzdoc:position 9 ;
    dzdoc:text "يجب أن يكون المنح المؤقت للصفقة موضوع نشر حسب الشروط المحددة في المادة 65 من هذا المرسوم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_52_permission_0_f3f9a4e7> a dznorm:Permission ;
