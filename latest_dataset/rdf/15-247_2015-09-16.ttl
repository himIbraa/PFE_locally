<https://legal.dz/resource/law/2015-09-16/15-247#version_art_127> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الضمانات ذات الصيغة الحكومية التي تهم المؤسسات الأجنبية هي : استعمال القرض الناتج عن عقود حكومية مشتركة، الضمانات التي تستخدم مساهمة الهيئات المصرفية أو هيئات التأمينات ذات الصبغة العمومية أو شبه العمومية. يحظى بالأسبقية في اختيار المتعاملين المتعاقدين الأجانب من يقدم الضمانات المذكورة أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_127_20150916_OpEnact_62ef7a400a> ;
    dzdoc:replacementText "الضمانات ذات الصيغة الحكومية التي تهم المؤسسات الأجنبية هي : استعمال القرض الناتج عن عقود حكومية مشتركة، الضمانات التي تستخدم مساهمة الهيئات المصرفية أو هيئات التأمينات ذات الصبغة العمومية أو شبه العمومية. يحظى بالأسبقية في اختيار المتعاملين المتعاقدين الأجانب من يقدم الضمانات المذكورة أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
