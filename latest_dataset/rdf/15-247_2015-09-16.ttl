<https://legal.dz/resource/law/2015-09-16/15-247#version_art_74> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تنازل حائز صفقة عمومية قبل تبليغه الصفقة أو رفض استلام الإشعار بتبليغ الصفقة ، فإنه يمكن المصلحة المتعاقدة مواصلة تقييم العروض الباقية، بعد إلغاء المنح المؤقت للصفقة ، مع مراعاة مبدأ حرية المنافسة ومتطلبات اختيار أحسن عرض من حيث المزايا الاقتصادية، وأحكام المادة 99 من هذا المرسوم. ويبقى عرض المتعهد الذي يتنازل عن الصفقة التي منحت له في ترتيب العروض."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_74_20150916_OpEnact_f9ec974b3c> ;
    dzdoc:replacementText "إذا تنازل حائز صفقة عمومية قبل تبليغه الصفقة أو رفض استلام الإشعار بتبليغ الصفقة ، فإنه يمكن المصلحة المتعاقدة مواصلة تقييم العروض الباقية، بعد إلغاء المنح المؤقت للصفقة ، مع مراعاة مبدأ حرية المنافسة ومتطلبات اختيار أحسن عرض من حيث المزايا الاقتصادية، وأحكام المادة 99 من هذا المرسوم. ويبقى عرض المتعهد الذي يتنازل عن الصفقة التي منحت له في ترتيب العروض."@ar ;
    dzdoc:resolutionStatus "resolved" ;
