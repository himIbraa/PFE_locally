<https://legal.dz/resource/law/2015-09-16/15-247#version_art_40> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "طلب العروض هو إجراء يستهدف الحصول على عروض من عدة متعهدين متنافسين مع تخصيص الصفقة دون مفاوضات للمتعهد الذي يقدم أحسن عرض من حيث المزايا الاقتصادية استنادا إلى معايير اختيار موضوعية، تعد قبل إطلاق الإجراء. ويعلن عدم جدوى إجراء طلب العروض عندما لا يتم استلام أي عرض، أو عندما لا يتم الإعلان، بعد تقييم العروض، عن مطابقة أي عرض لموضوع الصفقة ولمحتوى دفتر الشروط، أو عندما لا يمكن ضمان تمويل الحاجات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_40_20150916_OpEnact_2167b67cb6> ;
    dzdoc:replacementText "طلب العروض هو إجراء يستهدف الحصول على عروض من عدة متعهدين متنافسين مع تخصيص الصفقة دون مفاوضات للمتعهد الذي يقدم أحسن عرض من حيث المزايا الاقتصادية استنادا إلى معايير اختيار موضوعية، تعد قبل إطلاق الإجراء. ويعلن عدم جدوى إجراء طلب العروض عندما لا يتم استلام أي عرض، أو عندما لا يتم الإعلان، بعد تقييم العروض، عن مطابقة أي عرض لموضوع الصفقة ولمحتوى دفتر الشروط، أو عندما لا يمكن ضمان تمويل الحاجات ."@ar ;
