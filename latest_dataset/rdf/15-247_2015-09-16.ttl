    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_70> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_70_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_70> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم فتح الأظرفة المتعلقة بملف الترشح والعروض التقنية والمالية في جلسة علنية، خلال نفس الجلسة، في تاريخ وساعة فتح الأظرفة المنصوص عليهما في المادة 66 من هذا المرسوم. وتدعو المصلحة المتعاقدة كل المرشحين أو المتعهدين لحضور جلسة فتح الأظرفة، حسب الحالة، في إعلان المنافسة أو عن طريق رسالة موجهة للمرشحين أو المتعهدين المعنيين."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_70_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_70> ;
    dzdoc:position 1 ;
    dzdoc:text "في حالة الإجراءات المحدودة، تفتح ملفات الترشيحات بصفة منفصلة."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_70_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_70> ;
    dzdoc:position 2 ;
    dzdoc:text "وفي حالة إجراء طلب العروض المحدود، يتم فتح الأظرفة المتعلقة بالعروض التقنية أو العروض التقنية النهائية والعروض المالية على مرحلتين."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_70_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_70> ;
    dzdoc:position 3 ;
    dzdoc:text "وفي حالة إجراء المسابقة، يتم فتح الأظرفة المتعلقة بالعروض التقنية والخدمات والعروض المالية على ثلاث (3) مراحل. ولا يتم فتح أظرفة الخدمات في جلسة علنية."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_70_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_70> ;
    dzdoc:position 4 ;
    dzdoc:text "ولا يتم فتح أظرفة العروض المالية للمسابقة إلا بعد نتيجة تقييم الخدمات من قبل لجنة تحكيم، كما هو منصوص عليه في المادة 48 من هذا المرسوم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_70_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_70> ;
    dzdoc:position 5 ;
    dzdoc:text "ويتعين على المصلحة المتعاقدة أن تضع في مكان مؤمن وتحت مسؤوليتها، الأظرفة المتعلقة بالعروض المالية إلى غاية فتحها."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_71_condition_0_dd098d3f> a dznorm:Condition ;
    dznorm:conditionText "تحت طائلة رفض عروضهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_71> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2015-09-16/15-247#art_71_obligation_0_a7fa4dc1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_71> ;
    dznorm:position 0 ;
    dznorm:provisionText "تدعو المرشحين أو المتعهدين عند الاقتضاء، كتابيا عن طريق المصلحة المتعاقدة، إلى استكمال عروضهم التقنية"@ar ;
    dznorm:sourceArticle "art_71" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_71_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_71> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم فتح الأظرفة من طرف لجنة فتح الأظرفة وتقييم العروض المنشأة بموجب أحكام المادة 160 من هذا المرسوم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_71_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_71> ;
    dzdoc:position 1 ;
    dzdoc:text "وبهذه الصفة، تقوم لجنة فتح الأظرفة وتقييم العروض بالمهام الآتية : تثبت صحة تسجيل العروض، تعد قائمة المرشحين أو المتعهدين حسب ترتيب تاريخ وصول أظرفة ملفات ترشحهم أو عروضهم مع توضيح محتوى ومبالغ المقترحات والتخفيضات المحتملة، تعد قائمة الوثائق التي يتكون منها كل عرض، توقع بالحروف الأولى على وثائق الأظرفة المفتوحة التي لا تكون محل طلب استكمال، تحرر المحضر أثناء انعقاد الجلسة الذي يوقعه جميع أعضاء اللجنة الحاضرين، والذي يجب أن يتضمن التحفظات المحتملة المقدمة من قبل أعضاء اللجنة، تدعو المرشحين أو المتعهدين عند الاقتضاء، كتابيا عن طريق المصلحة المتعاقدة، إلى استكمال عروضهم التقنية، تحت طائلة رفض عروضهم، بالوثائق الناقصة أو غير الكاملة المطلوبة، باستثناء المذكرة التقنية التبريرية، في أجل أقصاه عشرة (10) أيام ابتداء من تاريخ فتح الأظرفة ومهما يكن من أمر ، تستثنى من طلب الاستكمال كل الوثائق الصادرة عن المتعهد والمتعلقة بتقييم العروض، تقترح على المصلحة المتعاقدة، عند الاقتضاء، في المحضر ، إعلان عدم جدوى الإجراء حسب الشروط المنصوص عليها في المادة 40 من هذا المرسوم، ترجع عن طريق المصلحة المتعاقدة الأظرفة غير المفتوحة إلى أصحابها من المتعاملين الاقتصاديين، عند الاقتضاء، حسب الشروط المنصوص عليها في هذا المرسوم."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_72_condition_0_d8522002> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/2015-09-16/15-247#art_72_condition_0_d8522002_role_79798acd28> ;
    dznorm:conditionText "وفي حالة الإجراءات التي لا تحتوي على مرحلة انتقاء أولي، لا تفتح أظرفة العروض التقنية والمالية والخدمات، عند الاقتضاء، المتعلقة بالترشيحات المقصاة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_72> ;
    dznorm:position 0 .

