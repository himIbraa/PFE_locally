<https://legal.dz/resource/law/2015-09-16/15-247#art_104> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:definesTerm dzterm:base_indices ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_104" ;
    dzdoc:fullText "تطبق بنود مراجعة الأسعار مرة واحدة كل ثلاثة (3) أشهر ماعدا في حالة اتفاق مشترك بين الأطراف على تحديد فترة تطبيق أطول. الأرقام الاستدلالية القاعدية (10) المطلوب أخذها بعين الاعتبار هي الآتية : أرقام الشهر الذي أعطي فيه أمر الخدمة بالشروع في الأشغال عندما يكون الأمر بالخدمة قد صدر بعد انقضاء فترة صلاحية العرض أو الأسعار، أرقام الشهر الذي انتهت فيه صلاحية العرض عندما يكون أمر الخدمة بالشروع في الأشغال قد أعطي قبل انتهاء فترة صلاحية العرض أو الأسعار. عندما تسدد حصة من تسبيق على التموين من دفع على حساب أو تسوية على رصيد حساب ، فإنها تخصم بعد تطبيق مراجعة الأسعار، ، من مبلغ الدفع على الحساب أو التسوية على رصيد الحساب. عندما تسدد حصة من تسبيق جزافي من دفع على حساب أو تسوية على رصيد حساب ، فإنها تخصم قبل تطبيق مراجعة الأسعار من مبلغ الدفع على الحساب أو التسوية على رصيد الحساب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_104> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_104_defocc_f5ea72d95dee> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_104_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_104_para_1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_104_para_2>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_104_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_104_20150916_OpEnact_6936f5e963> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_104_obligation_0_b03f4ce6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "104" ;
    dzdoc:position 103 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_104_condition_0_0b33d925>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_104_condition_1_b827fe24> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_152> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_4_subsec_10> ;
    dzdoc:eId "art_152" ;
    dzdoc:fullText "لا يمكن الاعتراض على قرار المصلحة المتعاقدة بفسخ الصفقة العمومية عند تطبيقها البنود التعاقدية للضمان، والمتابعات الرامية إلى إصلاح الضرر الذي لحقها بسبب خطأ المتعاقد معها. وزيادة على ذلك، يتحمل هذا الأخير التكاليف الإضافية التي تنجم عن الصفقة الجديدة . وفي حالة فسخ صفقة عمومية جارية التنفيذ باتفاق مشترك ، يوقع الطرفان وثيقة الفسخ التي يجب أن تنص على تقديم الحسابات المعدة تبعا للأشغال المنجزة والأشغال الباقي تنفيذها وكذلك تطبيق مجموع بنود الصفقة بصفة عامة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_152_permission_0_f003f3c8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_152> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_152_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_152_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_152_20150916_OpEnact_93653a2b1e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_152_obligation_0_8ead32d1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_152_obligation_1_418d2f1d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 152" ;
    dzdoc:position 151 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_152_condition_0_bcd0dc74> ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:public_procurement .

<https://legal.dz/resource/law/2015-09-16/15-247#art_162> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_1_subsubsec_1> ;
    dzdoc:eId "art_162" ;
    dzdoc:fullText "يحدد مسؤول المصلحة المتعاقدة بموجب مقرر ، تشكيلة لجنة فتح الأظرفة وتقييم العروض وقواعد تنظيمها وسيرها ونصابها، في إطار الإجراءات القانونية والتنظيمية المعمول بها. غير أن اجتماعات لجنة فتح الأظرفة وتقييم العروض في حصة فتح الأظرفة، تصح مهما يكن عدد أعضائها الحاضرين. ويجب أن تسهر المصلحة المتعاقدة على أن يسمح عدد الأعضاء الحاضرين بضمان شفافية الإجراء. تسجل لجنة فتح الأظرفة وتقييم العروض أشغالها المتعلقة بفتح الأظرفة وتقييم العروض في سجلين خاصين يرقمهما الأمر بالصرف ويؤشر عليهما بالحروف الأولى."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_162_permission_0_3a58a8e4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_162> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_162_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_162_para_1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_162_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_162_20150916_OpEnact_484c741c87> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_162_obligation_0_9c91ee8f>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_162_obligation_1_38129590>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_162_obligation_2_2bd1cd16> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "162" ;
    dzdoc:position 161 ;
    dzdoc:usesTerm dzterm:authorizing_officer,
        dzterm:bid_opening_evaluation_committee,
        dzterm:contracting_authority .

<https://legal.dz/resource/law/2015-09-16/15-247#art_171> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_1> ;
    dzdoc:eId "art_171" ;
    dzdoc:fullText "تختص اللجنة الجهوية للصفقات ، ضمن حدود المستويات المحددة في المطات 1 إلى 4 من المادة 184 وفي المادة 139 من هذا المرسوم حسب الحالة بدراسة مشاريع دفاتر الشروط والصفقات والملاحق الخاصة بالمصالح الخارجية الجهوية للإدارات المركزية. وتتشكل اللجنة من : الوزير المعني أو ممثله، رئيسا، ممثل المصلحة المتعاقدة ممثلين اثنين (2) عن الوزير المكلف بالمالية مصلحة الميزانية ومصلحة المحاسبة)، ممثل عن الوزير المعني بالخدمة، حسب موضوع الصفقة بناء ، أشغال عمومية، ري)، عند الاقتضاء، ممثل عن الوزير المكلف بالتجارة . تحدد قائمة الهياكل التي يسمح لها بإنشاء هذه اللجنة بموجب قرار من الوزير المعني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_171_permission_0_2ac8423f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_171> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_171_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_171_para_1>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_171_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_171_20150916_OpEnact_d2cc737d12> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "171" ;
    dzdoc:position 170 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_139>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_184> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_139>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_184> ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:finance_minister,
        dzterm:minister,
        dzterm:regional_tenders_committee,
        dzterm:trade_minister .

<https://legal.dz/resource/law/2015-09-16/15-247#art_174> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_5_subsec_2_subsubsec_1> ;
    dzdoc:eId "art_174" ;
    dzdoc:fullText "تختص اللجنة البلدية للصفقات بدراسة مشاريع دفاتر الشروط والصفقات والملاحق الخاصة بالبلدية، ضمن حدود المستويات المنصوص عليها، حسب الحالة، في المادتين 139 و 173 من هذا المرسوم. وتتشكل اللجنة من : رئيس المجلس الشعبي البلدي أو ممثله، رئيسا، ممثل عن المصلحة المتعاقدة ، منتخبين اثنين (2) يمثلان المجلس الشعبي البلدي، ممثلين اثنين (2) عن الوزير المكلف بالمالية مصلحة الميزانية ومصلحة المحاسبة)، ممثل عن المصلحة التقنية المعنية بالخدمة للولاية، حسب موضوع الصفقة (بناء ، أشغال عمومية، ري)، عند الاقتضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_174> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_174_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_174_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_174_20150916_OpEnact_0066cbff3f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_174_obligation_0_368f64d3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "المادة 174" ;
    dzdoc:position 173 ;
    dzdoc:references <https://legal.dz/resource/law/2015-09-16/15-247#art_139>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_173> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2015-09-16/15-247#art_139>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_173> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_174_condition_0_1b1645cd> ;
    dzdoc:usesTerm dzterm:contracting_authority,
        dzterm:minister_of_finance,
        dzterm:municipal_procurement_committee .

<https://legal.dz/resource/law/2015-09-16/15-247#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:definesTerm dzterm:call_for_tenders ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_1_dup_1> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "طلب العروض هو إجراء يستهدف الحصول على عروض من عدة متعهدين متنافسين مع تخصيص الصفقة دون مفاوضات للمتعهد الذي يقدم أحسن عرض من حيث المزايا الاقتصادية استنادا إلى معايير اختيار موضوعية، تعد قبل إطلاق الإجراء. ويعلن عدم جدوى إجراء طلب العروض عندما لا يتم استلام أي عرض، أو عندما لا يتم الإعلان، بعد تقييم العروض، عن مطابقة أي عرض لموضوع الصفقة ولمحتوى دفتر الشروط، أو عندما لا يمكن ضمان تمويل الحاجات ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2015-09-16/15-247#art_40_permission_0_0ea29cef> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_40> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2015-09-16/15-247#art_40_defocc_bbaac17eb5b7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_40_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_40_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_40_20150916_OpEnact_2167b67cb6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "40" ;
    dzdoc:position 39 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_40_condition_0_b7d25f31> ;
    dzdoc:usesTerm dzterm:call_for_tenders .

<https://legal.dz/resource/law/2015-09-16/15-247#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#chp_1_sec_2_subsec_3_dup_1> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "لا تطلب الوثائق التي تبرر المعلومات التي يحتويها التصريح بالترشح إلا من الحائز على الصفقة العمومية الذي يجب عليه تقديمها في أجل أقصاه عشرة (10) أيام، ابتداء من تاريخ إخطاره، وعلى أي حال، قبل نشر إعلان المنح المؤقت للصفقة . وإذا لم تقدم الوثائق المذكورة أعلاه في الآجال المطلوبة أو تبين بعد تقديمها أنها تتضمن معلومات غير مطابقة لتلك المذكورة في التصريح بالترشح ، يرفض العرض المعني وتستأنف المصلحة المتعاقدة إجراء منح الصفقة وإذا اكتشفت المصلحة المتعاقدة ، بعد إمضاء الصفقة، أن المعلومات التي قدمها صاحب الصفقة العمومية زائفة ، فإنها تأمر بفسخ الصفقة تحت مسؤولية المتعامل المتعاقد دون سواه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2015-09-16/15-247#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2015-09-16/15-247#art_69_para_0>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_69_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2015-09-16/15-247#version_art_69_20150916_OpEnact_037d3c4cd9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2015-09-16/15-247#art_69_obligation_0_78390f58>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_69_obligation_1_b0765a6d>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_69_obligation_2_205f2526> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2015-09-16/15-247> ;
    dzdoc:introducedOn "2015-09-16"^^xsd:date ;
    dzdoc:number "69" ;
    dzdoc:position 68 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2015-09-16/15-247#art_69_condition_0_806e4d52>,
        <https://legal.dz/resource/law/2015-09-16/15-247#art_69_condition_1_1a42b419> ;
