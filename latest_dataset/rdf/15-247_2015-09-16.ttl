<https://legal.dz/resource/law/2015-09-16/15-247#art_143_obligation_1_a43ff622> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_143> ;
    dznorm:position 1 ;
    dznorm:provisionText "ينبغي أن يحظى اختيار المناول وشروطه المتعلقة بالدفع من طرف المتعامل المتعاقد، وجوبا، بموافقة المصلحة المتعاقدة مقدما وكتابيا"@ar ;
    dznorm:sourceArticle "art_143" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_143_obligation_2_1da6dc7a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_143> ;
    dznorm:position 2 ;
    dznorm:provisionText "تسلم وجوبا نسخة من عقد المناولة للمصلحة المتعاقدة من طرف المتعامل المتعاقد"@ar ;
    dznorm:sourceArticle "art_143" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_143_obligation_3_eb1684b0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2015-09-16/15-247#art_143_obligation_3_eb1684b0_action_98ba1fec7b> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_143> ;
    dznorm:position 3 ;
    dznorm:provisionText "يجب أن يحدد في عرض المتعهد المعني مبلغ الحصة القابلة للتحويل الموافق للخدمات التي تقدمها المؤسسات الخاضعة للقانون الجزائري في إطار المناولة"@ar ;
    dznorm:sourceArticle "art_143" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_143_obligation_3_eb1684b0_action_98ba1fec7b> a dznorm:Action ;
    rdfs:label "أن يحدد في عرض المتعهد"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب أن يحدد في عرض المتعهد المعني مبلغ الحصة القابلة للتحويل الموافق للخدمات التي تقدمها المؤسسات الخاضعة للقانون الجزائري في إطار المناولة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_143> .

<https://legal.dz/resource/law/2015-09-16/15-247#art_143_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_143> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن اللجوء إلى المناولة ضمن الشروط الآتية : يجب أن يحدد صراحة المجال الرئيسي لتدخل المناولة، بالرجوع إلى بعض المهام الأساسية التي يجب أن تنفذ من طرف المتعامل المتعاقد، في دفتر الشروط إذا أمكن ذلك وفي الصفقة. ويمكن التصريح بالمناول في العرض أو أثناء تنفيذ الصفقة. ويتم التصريح بالمناول أثناء تنفيذ الصفقة وقبول شروطه المتعلقة بالدفع طبقا للنموذج الذي يحدد بموجب قرار من الوزير المكلف بالمالية، ينبغي أن يحظى اختيار المناول وشروطه المتعلقة بالدفع من طرف المتعامل المتعاقد، وجوبا، بموافقة المصلحة المتعاقدة مقدما وكتابيا، مع مراعاة أحكام المادة 75 من هذا المرسوم، وذلك بعد التأكد من قدراته المهنية والتقنية والمالية."@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_143_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_143> ;
    dzdoc:position 1 ;
    dzdoc:text "ويقبض المناول المعتمد وفق الشروط المذكورة سابقا، مستحقاته مباشرة من المصلحة المتعاقدة، بعنوان الخدمات المنصوص عليها في الصفقة التي تكفل بتنفيذها، حسب كيفيات تحدد بموجب قرار من الوزير المكلف بالمالية،"@ar .

<https://legal.dz/resource/law/2015-09-16/15-247#art_143_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2015-09-16/15-247#art_143> ;
    dzdoc:position 2 ;
    dzdoc:text "تسلم وجوبا نسخة من عقد المناولة للمصلحة المتعاقدة من طرف المتعامل المتعاقد، يجب أن يحدد في عرض المتعهد المعني مبلغ الحصة القابلة للتحويل الموافق للخدمات التي تقدمها المؤسسات الخاضعة للقانون الجزائري في إطار المناولة."@ar .

