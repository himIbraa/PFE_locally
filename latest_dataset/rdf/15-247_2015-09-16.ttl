    dznorm:provisionText "يدرج إعلان المنح المؤقت للصفقة في الجرائد التي نشر فيها إعلان طلب العروض، عندما يكون ذلك ممكنا، مع تحديد السعر وأجال الإنجاز وكل العناصر التي سمحت باختيار حائز الصفقة العمومية"@ar ;
    dznorm:sourceArticle "art_65" .

<https://legal.dz/resource/law/2015-09-16/15-247#art_66_obligation_2_8f3b5210> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
