    dznorm:sourceArticle "art_16" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17_condition_0_38ac1843> a dznorm:Condition ;
    dznorm:conditionText "وفي هذه الحالة وإذا لم تكن اتفاقية خاصة بين الهيئة المستخدمة التي تدعى \"الهيئة \" والمخترع"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17> ;
    dznorm:position 0 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17_condition_1_22bc8859> a dznorm:Condition ;
    dznorm:conditionText "وإذا عبرت الهيئة صراحة عن تخليها عن هذا الحق"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17> ;
    dznorm:position 1 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي هذه الحالة وإذا لم تكن اتفاقية خاصة بين الهيئة المستخدمة التي تدعى \"الهيئة \" والمخترع، يعود إلى الهيئة حق امتلاك الاختراع."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17> ;
    dzdoc:position 2 ;
    dzdoc:text "وإذا عبرت الهيئة صراحة عن تخليها عن هذا الحق، فإنه يصبح ملكا للمخترع."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17> ;
    dzdoc:position 3 ;
    dzdoc:text "وفي أي حال من الأحوال، فإن لصاحب الاختراع الحق في ذكر صفة المخترع وفقا للفقرة 3 من المادة 10 أعلاه."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17> ;
    dzdoc:position 4 ;
    dzdoc:text "تحدد كيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar .

