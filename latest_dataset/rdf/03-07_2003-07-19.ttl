    dzdoc:text "يعد اختراع الخدمة، الاختراع الذي ينجزه شخص أو عدة أشخاص بمقتضى اتفاقية غير الاتفاقية المنصوص عليها في المادة 17 أعلاه، وذلك باستخدام تقنيات الهيئة و/أو وسائلها."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27_obligation_0_023c86d8> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27> ;
    dznorm:hasCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27_obligation_0_023c86d8_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "تقوم المصلحة المختصة بعد الإيداع بالتأكد من أن الشروط المتعلقة بإجراءات الإيداع المحددة في القسم الأول من الباب الثالث أعلاه و في النصوص المتخذة لتطبيقه متوفرة"@ar ;
    dznorm:sourceArticle "art_27" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_2_defocc_63d91b38c4fe> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 197 ;
    dzdoc:charStart 172 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:patent ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_2> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_2_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يقصد في مفهوم هذا الأمر بما يأتي:
          
          
          الاختراع : فكرة لمخترع ، تسمح عمليا بإيجاد حل لمشكل محدد في مجال التقنية،
          
          
          البراءة أو براءة الاختراع : وثيقة تسلم لحماية اختراع،
          
          
          المصلحة المختصة : المعهد الوطني الجزائري للملكية الصناعية،"""@ar .

