    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_39> ;
    dzdoc:sourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_39> ;
