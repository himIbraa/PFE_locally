<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10_condition_0_6525f30a> a dznorm:Condition ;
    dznorm:conditionText "إذا اشترك شخصان أو عدة أشخاص جماعيا في إنجاز اختراع"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10> ;
    dznorm:position 0 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10_condition_1_fdaf59f5> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يكن المودع هو المخترع أو المودعين هم المخترعين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10> ;
    dznorm:position 1 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10_obligation_0_27422b3b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10_obligation_0_27422b3b_action_e564cd5ecf> ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10> ;
    dznorm:position 0 ;
    dznorm:provisionText "الطلب يجب أن يرفق بتصريح يثبت به المودع أو المودعون حقهم في براءة الاختراع"@ar ;
    dznorm:sourceArticle "art_10" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10_obligation_0_27422b3b_action_e564cd5ecf> a dznorm:Action ;
    rdfs:label "أن يرفق بتصريح يثبت به"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "الطلب يجب أن يرفق بتصريح يثبت به المودع أو المودعون حقهم في براءة الاختراع"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10> .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10> ;
    dzdoc:position 0 ;
    dzdoc:text "الحق في براءة الاختراع ملك لصاحب الاختراع كما هو محدد في المواد من 3 إلى 8 أعلاه، أو ملك لخلفه ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10> ;
    dzdoc:position 1 ;
    dzdoc:text "إذا اشترك شخصان أو عدة أشخاص جماعيا في إنجاز اختراع، فإن الحق في ملكية براءة الاختراع يعد ملكا مشتركا بينهم باعتبارهم شركاء في الاختراع أو يعد ملكا لخلفائهم."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10> ;
    dzdoc:position 2 ;
    dzdoc:text "يحق للمخترع أو للمخترعين ذكرهم كمخترعين في براءة الاختراع"@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10> ;
    dzdoc:position 3 ;
    dzdoc:text "إذا لم يكن المودع هو المخترع أو المودعين هم المخترعين، فإن الطلب يجب أن يرفق بتصريح يثبت به المودع أو المودعون حقهم في براءة الاختراع."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10> ;
    dzdoc:position 4 ;
    dzdoc:text "لا يشترط التصريح المشار إليه في الفقرة أعلاه في حالة طلب يتضمن مطالبة بأولوية لإيداع سابق باسم المودع."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10> ;
    dzdoc:position 5 ;
    dzdoc:text "يحدد شكل و كيفيات إعداد التصريح المشار إليه أعلاه عن طريق التنظيم."@ar .

