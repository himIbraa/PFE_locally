<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:definesTerm dzterm:competent_authority,
        dzterm:invention,
        dzterm:patent ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_1> ;
    dzdoc:eId "art_2" ;
    dzdoc:fullText "يقصد في مفهوم هذا الأمر بما يأتي: الاختراع : فكرة لمخترع ، تسمح عمليا بإيجاد حل لمشكل محدد في مجال التقنية، البراءة أو براءة الاختراع : وثيقة تسلم لحماية اختراع، المصلحة المختصة : المعهد الوطني الجزائري للملكية الصناعية،"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_2> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_2_defocc_63d91b38c4fe>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_2_defocc_6766563bb5ea>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_2_defocc_fb5228d07ac9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_2_20030719_OpEnact_bac3053eb8> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 2" ;
    dzdoc:position 1 ;
    dzdoc:usesTerm dzterm:order .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_3_subsec_1> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "كل شخص عرض اختراعا في معرض دولي رسمي أو معترف به رسميا ، يمكنه في أجل إثني عشر شهرا الموالية لتاريخ اختتام المعرض، طلب حماية هذا الاختراع مع المطالبة بالأولوية ابتداء من تاريخ عرض موضوع هذا الاختراع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_24_right_0_f5d19607> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_24_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_24_20030719_OpEnact_ad7d4fc5ed> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "24" ;
    dzdoc:position 21 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_24_condition_0_23934864> .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_5_subsec_2> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "لا يمكن أن تمنح الرخصة الإجبارية المذكورة في المادة 38 أعلاه إلا للطالب الذي يقدم الضمانات الضرورية بخصوص استغلال من شأنه تدارك الخلل الذي أدى إلى الرخصة الإجبارية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_40_permission_0_b65aeee8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_40_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_40_20030719_OpEnact_82c9de0d27> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "40" ;
    dzdoc:position 36 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_38> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_38> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_40_condition_0_8c4cfa0c> ;
    dzdoc:usesTerm dzterm:compulsory_license .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_43> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_5_subsec_2> ;
    dzdoc:eId "art_43" ;
    dzdoc:fullText "تسجل الرخصة الإجبارية أو انتقالها لدى المصلحة المختصة ، بعد تسديد الرسم المحدد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_43> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_43_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_43_20030719_OpEnact_d684f50d76> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_43_obligation_0_c56f14bc> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "43" ;
    dzdoc:position 39 ;
    dzdoc:usesTerm dzterm:competent_authority,
        dzterm:compulsory_license .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_6_subsec_1> ;
    dzdoc:eId "art_52" ;
    dzdoc:fullText "إذا تم قيد إحدى الرخص المذكورة في الفصلين الثاني والثالث من الباب الخامس أعلاه في سجل البراءات ، فـ التخلي عن براءة الاختراع لا يقيد إلا بعد تقديم الحاصل على الرخصة تصريحا يقبل فيه هذا التخلي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_52_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_52_20030719_OpEnact_ec890febfd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_52_obligation_0_6c4e7b35> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 52" ;
    dzdoc:position 48 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_52_condition_0_cbf8a703> .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_7_subsec_2> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "يعاقب بنفس العقوبة التي يعاقب بها المقلد كل من يتعمد إخفاء شيء مقلد أو إخفاء عدة أشياء مقلدة أو يبيعها أو يعرضها للبيع أو يدخلها إلى التراب الوطني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_62_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_62_20030719_OpEnact_a5f00fd3b6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_62_obligation_0_4c7b24bb> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 62" ;
    dzdoc:position 57 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_9> ;
    dzdoc:eId "art_65" ;
    dzdoc:fullText "ينشر هذا الأمر في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 19 جمادى الأولى عام 1424 الموافق 19 يوليو سنة 2003. عبد العزيز بوتفليقة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_65> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65_para_1>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_65_20030719_OpEnact_f3866bf6d0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65_obligation_0_951f60cf> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 65" ;
    dzdoc:position 60 .

