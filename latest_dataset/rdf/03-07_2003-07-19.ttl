<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_46> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقدم طلب الرخصة الإجبارية لبراءة الاختراع للمصلحة المختصة مبررا بالحجج المذكورة في المادة 39 أعلاه. تستدعي المصلحة المختصة الطالب وصاحب البراءة أو من يمثلهما وتستمع إليهما. إذا منحت المصلحة المختصة الرخصة الإجبارية ، يجب عليها تحديد شروطها و مدتها وقيمة التعويض اللازم لصاحب البراءة إلا في حالة اتفاق الطرفين، دون الإضرار في هذه الحالة بالطعن لدى الجهة القضائية المختصة التي تفصل في الأمر ابتدائيا و نهائيا. تطبق أحكام هذه المادة في حالة انتقال الرخصة الإجبارية لبراءة اختراع وفقا لما نصت عليه المادة"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_46_20030719_OpEnact_b9a995df55> ;
    dzdoc:replacementText "يقدم طلب الرخصة الإجبارية لبراءة الاختراع للمصلحة المختصة مبررا بالحجج المذكورة في المادة 39 أعلاه. تستدعي المصلحة المختصة الطالب وصاحب البراءة أو من يمثلهما وتستمع إليهما. إذا منحت المصلحة المختصة الرخصة الإجبارية ، يجب عليها تحديد شروطها و مدتها وقيمة التعويض اللازم لصاحب البراءة إلا في حالة اتفاق الطرفين، دون الإضرار في هذه الحالة بالطعن لدى الجهة القضائية المختصة التي تفصل في الأمر ابتدائيا و نهائيا. تطبق أحكام هذه المادة في حالة انتقال الرخصة الإجبارية لبراءة اختراع وفقا لما نصت عليه المادة 42 من هذا الأمر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_46> ;
    dzdoc:sourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_46> ;
    dzdoc:targetDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_47> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يكن استغلال الاختراع المحمي ببراءة ممكنا دون المساس بالحقوق الناتجة عن براءة اختراع سابقة ، فإنه يمكن منح رخصة إجبارية لصاحب براءة الاختراع اللاحقة بناء على طلب منه . تمنح مثل هذه الرخصة في الحدود الضرورية لاستغلال الاختراع على أن يشكل هذا الاختراع تقدما تقنيا ملحوظا و مصلحة اقتصادية هامة بالنسبة للاختراع موضوع البراءة السابقة. لصاحب البراءة السابقة الحق في الرخصة المتبادلة بشروط معقولة لاستعمال الاختراع موضوع البراءة اللاحقة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_47_20030719_OpEnact_129b333703> ;
    dzdoc:replacementText "إذا لم يكن استغلال الاختراع المحمي ببراءة ممكنا دون المساس بالحقوق الناتجة عن براءة اختراع سابقة ، فإنه يمكن منح رخصة إجبارية لصاحب براءة الاختراع اللاحقة بناء على طلب منه . تمنح مثل هذه الرخصة في الحدود الضرورية لاستغلال الاختراع على أن يشكل هذا الاختراع تقدما تقنيا ملحوظا و مصلحة اقتصادية هامة بالنسبة للاختراع موضوع البراءة السابقة. لصاحب البراءة السابقة الحق في الرخصة المتبادلة بشروط معقولة لاستعمال الاختراع موضوع البراءة اللاحقة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_47> ;
    dzdoc:sourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_47> ;
    dzdoc:targetDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_48> a dzdoc:AmendmentEvent,
