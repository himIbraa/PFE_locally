<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_23> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "على كل من يرغب في المطالبة بأولوية إيداع سابق لنفس الاختراع أن يقدم تصريحا للأولوية ونسخة من الطلب السابق حسب الشروط والآجال المحددة عن طريق التنظيم ."@ar ;
