    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20> .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب على كل من يرغب في الحصول على براءة اختراع أن يقوم بتقديم طلب كتابي صريح إلى المصلحة المختصة."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20> ;
    dzdoc:position 1 ;
    dzdoc:text "يجب أن يتضمن طلب براءة الاختراع ما يأتي: استمارة طلب ووصف للاختراع و مطلب أو عدد من المطالب ورسم أو عدد من الرسومات عند اللزوم ، ووصف مختصر، وثائق إثبات تسديد الرسومات المحددة."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20> ;
    dzdoc:position 2 ;
    dzdoc:text "عدا حالة اتفاق متبادل، يتعين على المودعين المقيمين في الخارج تمثيلهم لدى المصلحة المختصة."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20> ;
    dzdoc:position 3 ;
    dzdoc:text "تحدد كيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_21_condition_0_c1fb19ff> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_21_condition_0_c1fb19ff_ref_8548a2cb4ca3> ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20> ;
    dznorm:conditionText "بغض النظر عن أحكام المادة 20 أعلاه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_21> ;
    dznorm:position 0 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_21_condition_0_c1fb19ff_ref_8548a2cb4ca3> a dzdoc:Reference ;
    rdfs:label "المادة 20"@ar ;
    dzdoc:frbrUri "#art_20"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20> ;
    dzdoc:sourceEId "art_21" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "بغض النظر عن أحكام المادة 20 أعلاه"@ar ;
    dzdoc:targetEId "art_20" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_21_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_21> ;
    dzdoc:position 0 ;
    dzdoc:text "بغض النظر عن أحكام المادة 20 أعلاه، يعتبر تاريخ إيداع طلب براءة الاختراع هو تاريخ استلام المصلحة المختصة على الأقل لما يأتي: أ) استمارة طلب كتابي تسمح بالتعرف على الطالب وعلى رغبته في الحصول على براءة اختراع، ب) وصف للاختراع مرفوقا بمطلب واحد على الأقل."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_21_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_21> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أن الطلب الدولي الذي حصل على تاريخ إيداع دولي بموجب اتفاق التعاون بشأن البراءات والذي يشمل الجزائر كبلد معني للحصول على براءة، يعد كأنه طلب براءة مودع بتاريخ إيداعه الدولي."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22_obligation_0_eadf5e73> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22> ;
    dznorm:position 0 ;
    dznorm:provisionText "يوصف الاختراع وصفا واضحا بما فيه الكفاية و کاملا حتى يتسنى لمحترف تنفيذه"@ar ;
    dznorm:sourceArticle "art_22" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22_obligation_1_ed1f632c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22> ;
    dznorm:position 1 ;
    dznorm:provisionText "يتعين أن يحدد المطلب أو المطالب التي يتضمنها الاختراع نطاق الحماية المطلوبة"@ar ;
    dznorm:sourceArticle "art_22" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يشمل طلب براءة الاختراع إلا اختراعا واحدا أو عدد من الاختراعات مرتبطة فيما بينها بحيث لا تمثل في مفهومها سوی اختراعا شاملا واحدا."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا تتضمن قيودا أو شروطا أو تحفظات أو تحديدا أو منح حقوق"@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22> ;
    dzdoc:position 2 ;
    dzdoc:text "يوصف الاختراع وصفا واضحا بما فيه الكفاية و کاملا حتى يتسنى لمحترف تنفيذه."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22> ;
    dzdoc:position 3 ;
    dzdoc:text "يتعين أن يحدد المطلب أو المطالب التي يتضمنها الاختراع نطاق الحماية المطلوبة، ويجب أن تكون واضحة ومختصرة و مبنية كليا على الوصف."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22> ;
    dzdoc:position 4 ;
    dzdoc:text "ويستخدم الوصف المختصر لغرض الانتفاع بالمعلومة التقنية فقط."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_23_obligation_0_722cebd7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_23_obligation_0_722cebd7_role_cb0e4804cc> ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_23> ;
    dznorm:position 0 ;
    dznorm:provisionText "على كل من يرغب في المطالبة بأولوية إيداع سابق لنفس الاختراع أن يقدم تصريحا للأولوية ونسخة من الطلب السابق حسب الشروط والآجال المحددة عن طريق التنظيم"@ar ;
    dznorm:sourceArticle "art_23" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_23_obligation_0_722cebd7_role_cb0e4804cc> a dznorm:Role ;
    rdfs:label "كل من يرغب في"@ar ;
