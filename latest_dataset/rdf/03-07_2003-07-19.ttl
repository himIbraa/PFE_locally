    dzdoc:targetDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_36> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون الحقوق الناجمة عن طلب براءة اختراع أو عن براءة اختراع و/أو شهادات الإضافة المحتملة المتصلة بها قابلة للانتقال كليا أو جزئيا . تشترط الكتابة في العقود المتضمنة انتقال الملكية أو التنازل عن حق الاستغلال أو توقف هذا الحق أو رهن أو رفع الرهن المتعلق بطلب براءة اختراع أو ببراءة اختراع وفقا للقانون الذي ينظم هذا العقد ، و يجب أن تقيد في سجل البراءات . لا تكون العقود المذكورة في الفقرة أعلاه ، نافذة في مواجهة الغير إلا بعد تسجيلها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_36_20030719_OpEnact_4a4749b715> ;
    dzdoc:replacementText "تكون الحقوق الناجمة عن طلب براءة اختراع أو عن براءة اختراع و/أو شهادات الإضافة المحتملة المتصلة بها قابلة للانتقال كليا أو جزئيا . تشترط الكتابة في العقود المتضمنة انتقال الملكية أو التنازل عن حق الاستغلال أو توقف هذا الحق أو رهن أو رفع الرهن المتعلق بطلب براءة اختراع أو ببراءة اختراع وفقا للقانون الذي ينظم هذا العقد ، و يجب أن تقيد في سجل البراءات . لا تكون العقود المذكورة في الفقرة أعلاه ، نافذة في مواجهة الغير إلا بعد تسجيلها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_36> ;
