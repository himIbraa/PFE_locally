<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_31> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تصدر براءات الاختراع ذات الطلبات المستوفية الشروط دون فحص مسبق وتحت مسؤولية الطالبين ومن غير أي ضمان ، سواء تعلق الأمر بواقع الاختراع أو جدته أو جدارته أو تعلق الأمر بوفاء الوصف و بدقته . و تسلم المصلحة المختصة للطالب شهادة تثبت صحة الطلب وتمثل براءة الاختراع . ترفق الشهادة المذكورة في الفقرة أعلاه بنسخة من الوصف والمطالب والرسومات بعد إثبات مطابقتها للأصل عند الحاجة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_31_20030719_OpEnact_274f671a46> ;
    dzdoc:replacementText "تصدر براءات الاختراع ذات الطلبات المستوفية الشروط دون فحص مسبق وتحت مسؤولية الطالبين ومن غير أي ضمان ، سواء تعلق الأمر بواقع الاختراع أو جدته أو جدارته أو تعلق الأمر بوفاء الوصف و بدقته . و تسلم المصلحة المختصة للطالب شهادة تثبت صحة الطلب وتمثل براءة الاختراع . ترفق الشهادة المذكورة في الفقرة أعلاه بنسخة من الوصف والمطالب والرسومات بعد إثبات مطابقتها للأصل عند الحاجة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_31> ;
