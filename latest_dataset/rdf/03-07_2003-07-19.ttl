<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_37> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن صاحب براءة الاختراع أو طالبها أن يمنح لشخص آخر رخصة استغلال اختراعه بموجب عقد . تعد باطلة البنود الواردة في العقود بالرخصة إذا فرضت على مشتري الرخصة، في المجال الصناعي أو التجاري ، تحديدات تمثل استعمالا تعسفيا للحقوق التي تخولها براءة الاختراع بحيث يكون لاستخدامها أثر مضر على المنافسة في السوق الوطنية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_37_20030719_OpEnact_b91b9c2421> ;
    dzdoc:replacementText "يمكن صاحب براءة الاختراع أو طالبها أن يمنح لشخص آخر رخصة استغلال اختراعه بموجب عقد . تعد باطلة البنود الواردة في العقود بالرخصة إذا فرضت على مشتري الرخصة، في المجال الصناعي أو التجاري ، تحديدات تمثل استعمالا تعسفيا للحقوق التي تخولها براءة الاختراع بحيث يكون لاستخدامها أثر مضر على المنافسة في السوق الوطنية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_37> ;
    dzdoc:sourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
