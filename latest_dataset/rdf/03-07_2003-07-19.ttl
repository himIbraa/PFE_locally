    dznorm:sourceArticle "art_36" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_37_condition_0_8f17a8ae> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_37_condition_0_8f17a8ae_role_93f3739d57>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_37_condition_0_8f17a8ae_role_a702d6bd54> ;
    dznorm:conditionText "إذا فرضت على مشتري الرخصة، في المجال الصناعي أو التجاري ، تحديدات تمثل استعمالا تعسفيا للحقوق التي تخولها براءة الاختراع بحيث يكون لاستخدامها أثر مضر على المنافسة في السوق الوطنية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_37> ;
    dznorm:position 0 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_37_condition_0_8f17a8ae_role_93f3739d57> a dznorm:Role ;
