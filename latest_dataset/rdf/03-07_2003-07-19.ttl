<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_15_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_15> ;
    dzdoc:position 3 ;
    dzdoc:text "تنتهي صلاحية شهادات الإضافة بانقضاء البراءة الرئيسية."@ar .

