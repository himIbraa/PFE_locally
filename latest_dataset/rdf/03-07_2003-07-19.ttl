<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن الحصول على براءات اختراع بموجب هذا الأمر بالنسبة لما يأتي: الأنواع النباتية أو الأجناس الحيوانية وكذلك الطرق البيولوجية المحضة للحصول على نباتات أو حيوانات الاختراعات التي يكون تطبيقها على الإقليم الجزائري مخلا بالنظام أو الآداب العامة، الاختراعات التي يكون استغلالها على الإقليم الجزائري مضرا بصحة و حياة الأشخاص والحيوانات أو مضرا بحفظ النباتات أو يشكل خطرا جسيما على حماية البيئة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_8_20030719_OpEnact_0d8ebcb91d> ;
    dzdoc:replacementText "لا يمكن الحصول على براءات اختراع بموجب هذا الأمر بالنسبة لما يأتي: الأنواع النباتية أو الأجناس الحيوانية وكذلك الطرق البيولوجية المحضة للحصول على نباتات أو حيوانات الاختراعات التي يكون تطبيقها على الإقليم الجزائري مخلا بالنظام أو الآداب العامة، الاختراعات التي يكون استغلالها على الإقليم الجزائري مضرا بصحة و حياة الأشخاص والحيوانات أو مضرا بحفظ النباتات أو يشكل خطرا جسيما على حماية البيئة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_8> ;
    dzdoc:sourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_8> ;
    dzdoc:targetDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_9> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مدة براءة الاختراع هي عشرون (20) سنة ابتداء من تاريخ إيداع الطلب مع مراعاة دفع رسوم التسجيل ورسوم الإبقاء على سريان المفعول وفقا للتشريع المعمول به ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_9_20030719_OpEnact_8e184eadb2> ;
    dzdoc:replacementText "مدة براءة الاختراع هي عشرون (20) سنة ابتداء من تاريخ إيداع الطلب مع مراعاة دفع رسوم التسجيل ورسوم الإبقاء على سريان المفعول وفقا للتشريع المعمول به ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_9> ;
    dzdoc:sourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_9> ;
    dzdoc:targetDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
