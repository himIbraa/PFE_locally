dzterm:compulsory_license a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الرخصة الإجبارية"@ar,
        "رخصة إجبارية"@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_3_subsec_2> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "تقوم المصلحة بالتأكد من أن موضوع الطلب غير مدرج في الميادين المذكورة في المادة 7 وغير مقصى بداهة من الحماية بموجب المواد من 3 إلى 6 و 8 . تعلم المصلحة المختصة صاحب الطلب ، عند الاقتضاء ، بأن طلبه لا يسمح بمنحه براءة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_28_permission_0_484377f3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_28_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_28_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_28_20030719_OpEnact_e1a04aa47f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_28_obligation_0_f9c10667>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_28_obligation_1_6957ab97> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 28" ;
    dzdoc:position 25 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_3>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_6>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_7>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_8> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_3>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_6>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_7>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_8> .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_6_subsec_2> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "تعلن الجهة القضائية المختصة البطلان الكلي أو الجزئي لمطلب أو لعدة مطالب تتعلق ب براءة اختراع ، بناء على طلب أي شخص معني في الحالات الآتية : إذا لم تتوفر في موضوع براءة الاختراع الأحكام الواردة في المواد من 3 إلى 8 أعلاه، إذا لم تتوفر في وصف الاختراع أحكام المادة 22 (الفقرة 3) أعلاه، وإذا لم تحدد مطالب براءة الاختراع الحماية المطلوبة، إذا كان الاختراع ذاته موضوع براءة اختراع في الجزائر تبعا لطلب سابق أو كان مستفيدا من أولوية سابقة. عندما يصبح قرار الإبطال نهائيا ، يتولى الطرف الذي يعنيه التعجيل، تبليغه بقوة القانون إلى المصلحة المختصة التي تقوم بقيده ونشره ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_53_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_53_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_53_20030719_OpEnact_89987ad4a4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_53_obligation_0_e7509a8a> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "53" ;
    dzdoc:position 49 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_3>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_8> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_3>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_8> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_53_condition_0_d833fc48>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_53_condition_1_6c4cc3db> ;
    dzdoc:usesTerm dzterm:judicial_authority,
        dzterm:patent .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_7_subsec_1> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "يمكن المدعى عليه في أية قضية من القضايا المذكورة في المادتين 58 و 59 أعلاه، رفع دعوى بطلان براءة الاختراع عن طريق نفس الإجراء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_60_permission_0_96a2fc7a> ;
    dzdoc:grantsRight <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_60_right_0_5854e3d3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_60_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_60_20030719_OpEnact_f19db24cd1> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 60" ;
    dzdoc:position 55 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_58>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_58>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59> .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_5_subsec_2> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "لا يمكن نقل الرخصة الإجبارية إلا مع جزء المؤسسة أو المحل التجاري المنتفع بها. ولا يتم هذا الانتقال إلا بعد موافقة المصلحة المختصة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_42_permission_0_4293c1f2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_42> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_42_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_42_20030719_OpEnact_a7af3b287b> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "42" ;
    dzdoc:position 38 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_42_condition_0_9721d0a3> ;
    dzdoc:usesTerm dzterm:competent_authority,
        dzterm:compulsory_license .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_5_subsec_2> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "يمكن المصلحة المختصة تعديل قرار منح الرخصة الإجبارية ، بطلب من صاحب براءة الاختراع أو المستفيد من الرخصة الإجبارية، إذا ظهرت أحداث جديدة تبرر هذا التعديل و خاصة إذا كان صاحب البراءة يمنح رخصا تعاقدية بشروط أكثر امتيازا للمرخص التعاقدي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_44_permission_0_53ad6724> ;
    dzdoc:grantsRight <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_44_right_0_9e04be25> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_44_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_44_20030719_OpEnact_ce7c77a919> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "44" ;
    dzdoc:position 40 ;
    dzdoc:usesTerm dzterm:competent_authority,
        dzterm:compulsory_license .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_61> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_7_subsec_2> ;
    dzdoc:eId "art_61" ;
    dzdoc:fullText "يعد كل عمل متع يرتكب مفهوم المادة 56 أعلاه، جنحة تقليد يعاقب على جنحة التقليد بالحبس من ستة (6) أشهر إلى سنتين وبغرامة من مليونين وخمسمائة ألف دينار ( 2.500.000 دج) إلى عشرة ملايين دينار (10.000.000 دج) أو بإحدى هاتين العقوبتين فقط."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_61> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_61_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_61_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_61_20030719_OpEnact_5e5fde43e5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_61_obligation_0_0c8f9ee5> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 61" ;
    dzdoc:position 56 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_56> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_56> ;
    dzdoc:usesTerm dzterm:counterfeiting_offense .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_2_subsec_1> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "لا تعد من قبيل الاختراعات في مفهوم هذا الأمر المبادئ والنظريات والاكتشافات ذات الطابع العلمي وكذلك المناهج الرياضية. الخطط والمبادئ والمناهج الرامية إلى القيام بأعمال ذات طابع ثقافي أو ترفيهي محض المناهج ومنظومات التعليم والتنظيم والإدارة التسيير، طرق علاج جسم الإنسان أو الحيوان بالجراحة أو المداواة وكذلك مناهج التشخيص، مجرد تقديم المعلومات، برامج الحاسوب، الابتكارات ذات الطابع التزييني المحض."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_7_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_7_20030719_OpEnact_b8b02b59a4> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "7" ;
    dzdoc:position 5 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_2_subsec_2> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "لا تشمل الحقوق الواردة عن براءة الاختراع إلا الأعمال ذات الأغراض الصناعية أو التجارية . ولا تشمل هذه الحقوق ما يأتي: الأعمال المؤداة لأغراض البحث العلمي فقط، الأعمال التي تخص المنتوج الذي تشمله البراءة و ذلك بعد رض هذا المنتوج في السوق شرعا، استعمال وسائل محمية ببراءة على متن البواخر والسفن الفضائية أو أجهزة النقل الجوية أو البرية الأجنبية التي تدخل المياه الإقليمية أو المجال الجوي أو التراب الوطني دخولا مؤقتا أو اضطراريا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_12_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_12_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_12_20030719_OpEnact_84654f8981> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 12" ;
    dzdoc:position 10 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_2_subsec_3> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "طالما لم تسلم شهادة الإضافة ، بإمكان طالب هذه الشهادة تحويل طلبه إلى طلب براءة اختراع يكون تاريخ إيداعها هو تاريخ إيداع طلب شهادة الإضافة. يترتب على البراءة المتحصل عليها تبعا للتحويل المذكور في الفقرة الأولى أعلاه، تسديد رسوم الإبقاء على سريان المفعول ابتداء من تاريخ إيداع طلب شهادة الإضافة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_16_right_0_9b2f85be> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_16_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_16_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_16_20030719_OpEnact_41ddd8a41d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_16_obligation_0_c2f2c818> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 16" ;
    dzdoc:position 13 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_16_condition_0_9a1be9da> .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_4_subsec_2> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "تنشر المصلحة المختصة نشرة رسمية للبراءات"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_33_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_33_20030719_OpEnact_5ca2934bf0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_33_obligation_0_fed2ceec> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 33" ;
    dzdoc:position 29 ;
    dzdoc:usesTerm dzterm:competent_authority .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_5_subsec_1> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "تكون الحقوق الناجمة عن طلب براءة اختراع أو عن براءة اختراع و/أو شهادات الإضافة المحتملة المتصلة بها قابلة للانتقال كليا أو جزئيا . تشترط الكتابة في العقود المتضمنة انتقال الملكية أو التنازل عن حق الاستغلال أو توقف هذا الحق أو رهن أو رفع الرهن المتعلق بطلب براءة اختراع أو ببراءة اختراع وفقا للقانون الذي ينظم هذا العقد ، و يجب أن تقيد في سجل البراءات . لا تكون العقود المذكورة في الفقرة أعلاه ، نافذة في مواجهة الغير إلا بعد تسجيلها."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_36_right_0_87f9d9cf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_36_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_36_para_1>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_36_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_36_20030719_OpEnact_4a4749b715> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_36_obligation_0_35d3a4ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "36" ;
    dzdoc:position 32 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_36__para_2> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_36__para_2> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_36_condition_0_949e83be> ;
    dzdoc:usesTerm dzterm:patent .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_5_subsec_2> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "يمكن الوزير المكلف بالملكية الصناعية في أي وقت، منح رخصة إجبارية لمصلحة من مصالح الدولة أو للغير الذي يتم تعيينه من طرفه، لطلب براءة أو لبراءة اختراع ، و ذلك في إحدى الحالات الآتية : عند ما تستدعي المصلحة العامة و خاصة الأمن الوطني، التغذية، الصحة، أو تنمية قطاعات اقتصادية وطنية أخرى، و لا سيما عندما يكون سعر المواد الصيدلانية المحمية بواسطة البراءة مخالفا ومرتفعا بالنسبة للأسعار المتوسطة للسوق . عند ما ترى هيئة قضائية أو إدارية، أن صاحب البراءة أو من هو مرخص له باستغلالها، يستغل البراءة بطريقة مخالفة للقواعد التنافسية، وعندما يرى الوزير المكلف بالملكية الصناعية أن استغلال البراءة تطبيقا لهذه الفقرة يسمح بالعدول عن هذا التصرف ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_49_permission_0_23a38eff> ;
    dzdoc:grantsRight <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_49_right_0_c0d7ff06> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_49_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_49_20030719_OpEnact_3ba6a34518> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "49" ;
    dzdoc:position 45 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_49_condition_0_c4249987>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_49_condition_1_5f1b8b16> ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_6_subsec_1> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "يمكن صاحب براءة الاختراع أن يتخلى، كليا أو جزئيا و في أي وقت، عن مطلب أو عدة مطالب تتعلق ببراءته بتقديم تصريح مكتوب إلى المصلحة المختصة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_51_permission_0_15379fe0> ;
    dzdoc:grantsRight <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_51_right_0_7b0943c2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_51_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_51_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_51_20030719_OpEnact_826fe7d5eb> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 51" ;
    dzdoc:position 47 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_51_condition_0_e854c5b5> ;
    dzdoc:usesTerm dzterm:competent_authority,
        dzterm:patent_owner .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_2_subsec_1> ;
    dzdoc:eId "art_9" ;
    dzdoc:fullText "مدة براءة الاختراع هي عشرون (20) سنة ابتداء من تاريخ إيداع الطلب مع مراعاة دفع رسوم التسجيل ورسوم الإبقاء على سريان المفعول وفقا للتشريع المعمول به ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_9_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_9_20030719_OpEnact_8e184eadb2> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "9" ;
    dzdoc:position 7 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_9_condition_0_f6f51b52> .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_2_subsec_3> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "طوال صلاحية البراءة يحق لمالكها أو لذوي الحقوق إدخال تغييرات أو تحسينات أو إضافات على اختراعه مع استيفاء الإجراءات المطلوبة لإيداع الطلب المحددة في المواد 20 إلى 25 أدناه . يتم إثبات هذه التغييرات أو التحسينات أو الإضافات بشهادات تسلم بنفس الشكل الذي تم بالنسبة للبراءة الرئيسية و يكون لها نفس الأثر. يترتب على كل طلب شهادة إضافة تسديد الرسوم المحددة وفقا للتشريع الساري المفعول . تنتهي صلاحية شهادات الإضافة بانقضاء البراءة الرئيسية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_15_right_0_dfd6f171> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_15_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_15_para_1>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_15_para_2>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_15_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_15_20030719_OpEnact_6720fc36f8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_15_obligation_0_139d09ff>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_15_obligation_1_0c2b8c46> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 15" ;
    dzdoc:position 12 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_25> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_25> ;
    dzdoc:usesTerm dzterm:patent .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_3_subsec_2> ;
    dzdoc:eId "art_27" ;
    dzdoc:fullText "تقوم المصلحة المختصة بعد الإيداع بالتأكد من أن الشروط المتعلقة بإجراءات الإيداع المحددة في القسم الأول من الباب الثالث أعلاه و في النصوص المتخذة لتطبيقه متوفرة . إذا لم يستوف الطلب هذه الشروط ، يستدعى طالب البراءة أو وكيله لتصحيح الملف في أجل شهرين ويمكن أن يمدد هذا الأجل، عند الضرورة، المعللة بطلب من المودع أو من وكيله. يحتفظ الطلب المصحح في هذا الأجل بتاريخ الإيداع الأول. في حالة عدم تصحيح ملف الطلب في الأجل المحدد ، يعتبر الطلب مسحوبا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27_para_1>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27_para_2>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_27_20030719_OpEnact_9ed043b6a1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27_obligation_0_023c86d8>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27_obligation_1_ebd423b8> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 27" ;
    dzdoc:position 24 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27_condition_0_6e0b336b>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27_condition_1_f87370e8> ;
    dzdoc:usesTerm dzterm:competent_service .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_3_subsec_2> ;
    dzdoc:eId "art_29" ;
    dzdoc:fullText "إذا كان واضحا أن أي طلب لا يتوافق وأحكام الفقرة الأولى من المادة 22 أعلاه ، فإنه يمكن تجزئة هذا الطلب و تقسيمه إلى عدد من الطلبات بحيث ينفرد كل واحد منهم بتاريخ إيداع الطلب ذلك الأصلي و في الآجال المحددة عن طريق التنظيم . يجب أن لا يتعدى موضوع كل طلب مجزأ محتوى الطلب الأصلي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_29_permission_0_b098bbe6> ;
    dzdoc:grantsRight <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_29_right_0_06eda9be> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_29_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_29_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_29_20030719_OpEnact_81aefb7f2a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_29_obligation_0_4029fe2f> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 29" ;
    dzdoc:position 26 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_29_condition_0_412944bf> .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_5_subsec_2> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "يمكن صاحب براءة الاختراع أو طالبها أن يمنح لشخص آخر رخصة استغلال اختراعه بموجب عقد . تعد باطلة البنود الواردة في العقود بالرخصة إذا فرضت على مشتري الرخصة، في المجال الصناعي أو التجاري ، تحديدات تمثل استعمالا تعسفيا للحقوق التي تخولها براءة الاختراع بحيث يكون لاستخدامها أثر مضر على المنافسة في السوق الوطنية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_37_permission_0_46f2744b> ;
    dzdoc:grantsRight <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_37_right_0_7567e155> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_37_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_37_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_37_20030719_OpEnact_b91b9c2421> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "37" ;
    dzdoc:position 33 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_37_condition_0_8f17a8ae> ;
    dzdoc:usesTerm dzterm:exploitation_license,
        dzterm:patent_owner .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_5_subsec_2> ;
    dzdoc:eId "art_39" ;
    dzdoc:fullText "على كل شخص يطلب رخصة إجبارية وفقا ل المادتين 38 و 47 من هذا الأمر ، أن يثبت بأنه قام بتقديم طلب لصاحب البراءة ولم يستطع الحصول منه على رخصة تعاقدية بشروط منصفة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_39> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_39_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_39_20030719_OpEnact_23a7736f29> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_39_obligation_0_855ed610> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "39" ;
    dzdoc:position 35 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_38>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_47> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_38>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_47> ;
    dzdoc:usesTerm dzterm:compulsory_license .

