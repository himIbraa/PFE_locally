<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_51> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن صاحب براءة الاختراع أن يتخلى، كليا أو جزئيا و في أي وقت، عن مطلب أو عدة مطالب تتعلق ببراءته بتقديم تصريح مكتوب إلى المصلحة المختصة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_51_20030719_OpEnact_826fe7d5eb> ;
