<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_27> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقوم المصلحة المختصة بعد الإيداع بالتأكد من أن الشروط المتعلقة بإجراءات الإيداع المحددة في القسم الأول من الباب الثالث أعلاه و في النصوص المتخذة لتطبيقه متوفرة . إذا لم يستوف الطلب هذه الشروط ، يستدعى طالب البراءة أو وكيله لتصحيح الملف في أجل شهرين ويمكن أن يمدد هذا الأجل، عند الضرورة، المعللة بطلب من المودع أو من وكيله. يحتفظ الطلب المصحح في هذا الأجل بتاريخ الإيداع الأول. في حالة عدم تصحيح ملف الطلب في الأجل المحدد ، يعتبر الطلب مسحوبا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_27_20030719_OpEnact_9ed043b6a1> ;
    dzdoc:replacementText "تقوم المصلحة المختصة بعد الإيداع بالتأكد من أن الشروط المتعلقة بإجراءات الإيداع المحددة في القسم الأول من الباب الثالث أعلاه و في النصوص المتخذة لتطبيقه متوفرة . إذا لم يستوف الطلب هذه الشروط ، يستدعى طالب البراءة أو وكيله لتصحيح الملف في أجل شهرين ويمكن أن يمدد هذا الأجل، عند الضرورة، المعللة بطلب من المودع أو من وكيله. يحتفظ الطلب المصحح في هذا الأجل بتاريخ الإيداع الأول. في حالة عدم تصحيح ملف الطلب في الأجل المحدد ، يعتبر الطلب مسحوبا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27> ;
