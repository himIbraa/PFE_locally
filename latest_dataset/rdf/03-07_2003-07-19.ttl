<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_63_extref_b9ab7ebd> a dzdoc:ExternalReference ;
    rdfs:label "المرسوم التشريعي"@ar,
        "المرسوم التشريعي رقم 93-17 المؤرخ في 23 جمادى الثانية عام 1414 الموافق 7 ديسمبر سنة 1993"@ar ;
    dzdoc:frbrUri "/akn/dz/act/legislativeOrder/1993-12-07/93-17"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/decree/1993-12-07/93-17"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/legislativeOrder/1993-12-07/93-17" ;
    dzdoc:resolutionReason "unindexed_text_pattern" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/decree/1993-12-07/93-17"^^xsd:anyURI .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_63_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_63> ;
    dzdoc:position 0 ;
    dzdoc:text "تبقى البراءات الصادرة بموجب المرسوم التشريعي رقم 93-17 المؤرخ في 23 جمادى الثانية عام 1414 الموافق 7 ديسمبر سنة 1993 والمتعلق بـ حماية الاختراعات وكذا شهادات الإضافة المتعلقة بها، خاضعة لأحكام نفس المرسوم التشريعي."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_64_extref_f3471967> a dzdoc:ExternalReference ;
    rdfs:label "المرسوم التشريعي رقم 93-17 المؤرخ في 23 جمادى الثانية عام 1414 الموافق 7 ديسمبر سنة 1993 والمتعلق بحماية الاختراعات"@ar ;
    dzdoc:frbrUri "/akn/dz/act/decree/1993-12-07/93-17"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/decree/1993-12-07/93-17"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/decree/1993-12-07/93-17" ;
    dzdoc:referencesTarget <https://legal.dz/resource/decree/1993-12-07/93-17> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/decree/1993-12-07/93-17"^^xsd:anyURI .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_64_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_64> ;
    dzdoc:position 0 ;
    dzdoc:text "تلغى أحكام المرسوم التشريعي رقم 93-17 المؤرخ في 23 جمادى الثانية عام 1414 الموافق 7 ديسمبر سنة 1993 والمتعلق بحماية الاختراعات، مع مراعاة أحكام المادتين 61 و62 أعلاه."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65_obligation_0_951f60cf> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65> ;
    dznorm:position 0 ;
    dznorm:provisionText "ينشر هذا الأمر في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية."@ar ;
    dznorm:sourceArticle "art_65" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65> ;
    dzdoc:position 0 ;
    dzdoc:text "ينشر هذا الأمر في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65> ;
    dzdoc:position 1 ;
    dzdoc:text "حرر بالجزائر في 19 جمادى الأولى عام 1424 الموافق 19 يوليو سنة 2003."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65> ;
    dzdoc:position 2 ;
    dzdoc:text "عبد العزيز بوتفليقة"@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_7_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_7> ;
    dzdoc:position 0 ;
    dzdoc:text "لا تعد من قبيل الاختراعات في مفهوم هذا الأمر المبادئ والنظريات والاكتشافات ذات الطابع العلمي وكذلك المناهج الرياضية. الخطط والمبادئ والمناهج الرامية إلى القيام بأعمال ذات طابع ثقافي أو ترفيهي محض المناهج ومنظومات التعليم والتنظيم والإدارة التسيير، طرق علاج جسم الإنسان أو الحيوان بالجراحة أو المداواة وكذلك مناهج التشخيص، مجرد تقديم المعلومات، برامج الحاسوب، الابتكارات ذات الطابع التزييني المحض."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_8_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_8> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يمكن الحصول على براءات اختراع بموجب هذا الأمر بالنسبة لما يأتي: الأنواع النباتية أو الأجناس الحيوانية وكذلك الطرق البيولوجية المحضة للحصول على نباتات أو حيوانات الاختراعات التي يكون تطبيقها على الإقليم الجزائري مخلا بالنظام أو الآداب العامة، الاختراعات التي يكون استغلالها على الإقليم الجزائري مضرا بصحة و حياة الأشخاص والحيوانات أو مضرا بحفظ النباتات أو يشكل خطرا جسيما على حماية البيئة."@ar .

