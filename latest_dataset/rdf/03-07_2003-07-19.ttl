<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_35_right_0_712dcd7a> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_35_right_0_712dcd7a_role_34d88bfbfe> ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_35> ;
    dznorm:hasCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_35_right_0_712dcd7a_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "باستطاعة أي شخص الاطلاع عليها و الحصول على نسخ منها بدفع المستحقات المترتبة عليها"@ar ;
    dznorm:sourceArticle "art_35" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_38_right_0_f966dafc> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_38_right_0_f966dafc_action_4051820679> ;
    dzdoc:hasRole <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_38_right_0_f966dafc_role_6c38d36644> ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_38> ;
    dznorm:hasCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_38_right_0_f966dafc_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يمكن أي شخص في أي وقت، بعد انقضاء أربع (4) سنوات ابتداء من تاريخ إيداع طلب براءة الاختراع أو ثلاث (3) سنوات ابتداء من تاريخ صدور براءة الاختراع ، أن يتحصل من المصلحة المختصة على رخصة استغلال بسبب عدم استغلال الاختراع أو نقص فيه"@ar ;
    dznorm:sourceArticle "art_38" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_44_right_0_9e04be25> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_44_right_0_9e04be25_action_88d785427a> ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_44> ;
    dznorm:hasCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_44_right_0_9e04be25_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يمكن المصلحة المختصة تعديل قرار منح الرخصة الإجبارية، بطلب من صاحب براءة الاختراع أو المستفيد من الرخصة الإجبارية، إذا ظهرت أحداث جديدة تبرر هذا التعديل و خاصة إذا كان صاحب البراءة يمنح رخصا تعاقدية بشروط أكثر امتيازا للمرخص التعاقدي"@ar ;
    dznorm:sourceArticle "art_44" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_4_defocc_2db5cdbedd8d> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 53 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:new_invention ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_4> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_4_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يعتبر الاختراع جديدا إذا لم يكن مدرجا في حالة التقنية، وتتضمن هذه الحالة كل ما وضع في متناول الجمهور عن طريق وصف كتابي أو شفوي أو استعمال أو أي وسيلة أخرى عبر العالم، وذلك قبل يوم إيداع طلب الحماية أو تاريخ مطالبة الأولوية بها."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_4_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_4> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر الاختراع جديدا إذا لم يكن مدرجا في حالة التقنية، وتتضمن هذه الحالة كل ما وضع في متناول الجمهور عن طريق وصف كتابي أو شفوي أو استعمال أو أي وسيلة أخرى عبر العالم، وذلك قبل يوم إيداع طلب الحماية أو تاريخ مطالبة الأولوية بها."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_5_defocc_d8f99c756e55> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 75 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:inventive_step ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_5> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_5_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يعتبر الاختراع ناتجا عن نشاط اختراعي إذا لم يكن ناجما بداهة من حالة التقنية."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_5_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_5> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر الاختراع ناتجا عن نشاط اختراعي إذا لم يكن ناجما بداهة من حالة التقنية."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_62_obligation_0_4c7b24bb> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_62> ;
    dznorm:hasCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_62_obligation_0_4c7b24bb_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بنفس العقوبة التي يعاقب بها المقلد كل من يتعمد إخفاء شيء مقلد أو إخفاء عدة أشياء مقلدة أو يبيعها أو يعرضها للبيع أو يدخلها إلى التراب الوطني."@ar ;
    dznorm:sourceArticle "art_62" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#preamble_segment_0> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#preamble> ;
    dzdoc:position 0 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "بناء على الدستور ، لاسيما المواد 38 و52 و 122 و 124 منه،"@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#preamble_segment_12> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#preamble> ;
    dzdoc:position 12 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "و بعد الاستماع إلى مجلس الوزراء،"@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_10_20030719_OpEnact_ffbb61d2d8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_10> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_10> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "الحق في براءة الاختراع ملك لصاحب الاختراع كما هو محدد في المواد من 3 إلى 8 أعلاه، أو ملك لخلفه . إذا اشترك شخصان أو عدة أشخاص جماعيا في إنجاز اختراع ، فإن الحق في ملكية براءة الاختراع يعد ملكا مشتركا بينهم باعتبارهم شركاء في الاختراع أو يعد ملكا لخلفائهم . يحق للمخترع أو للمخترعين ذكرهم كمخترعين في براءة الاختراع إذا لم يكن المودع هو المخترع أو المودعين هم المخترعين ، فإن الطلب يجب أن يرفق بتصريح يثبت به المودع أو المودعون حقهم في براءة الاختراع . لا يشترط التصريح المشار إليه في الفقرة أعلاه في حالة طلب يتضمن مطالبة بأولوية لإيداع سابق باسم المودع. يحدد شكل و كيفيات إعداد التصريح المشار إليه أعلاه عن طريق التنظيم."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_11_20030719_OpEnact_24129acbbc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_11> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_11> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_11> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "مع مراعاة المادة 14 أدناه، تخول براءة الاختراع لمالكها الحقوق الاستئثارية الآتية : في حالة ما إذا كان موضوع الاختراع منتوجا ، يمنع الغير من القيام بصناعة المنتوج أو استعماله أو بيعه أو عرضه للبيع أو استيراده لهذه الأغراض دون رضاه إذا كان موضوع الاختراع طريقة صنع ، يمنع الغير من استعمال طريقة الصنع واستعمال المنتوج الناتج مباشرة عن هذه الطريقة أو بيعه أو عرضا للبيع أو استيراده لهذه الأغراض دون رضاه. لصاحب البراءة الحق كذلك في التنازل عنها أو في تحويلها عن طريق الإرث و إبرام عقود تراخيص ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_12_20030719_OpEnact_84654f8981> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_12> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_12> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_12> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "لا تشمل الحقوق الواردة عن براءة الاختراع إلا الأعمال ذات الأغراض الصناعية أو التجارية . ولا تشمل هذه الحقوق ما يأتي: الأعمال المؤداة لأغراض البحث العلمي فقط، الأعمال التي تخص المنتوج الذي تشمله البراءة و ذلك بعد رض هذا المنتوج في السوق شرعا، استعمال وسائل محمية ببراءة على متن البواخر والسفن الفضائية أو أجهزة النقل الجوية أو البرية الأجنبية التي تدخل المياه الإقليمية أو المجال الجوي أو التراب الوطني دخولا مؤقتا أو اضطراريا."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_14_20030719_OpEnact_eccdbb486c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_14> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_14> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_14> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "عند تاريخ إيداع طلب براءة الاختراع أو تاريخ الأولوية المطالب به قانونا إذا قام أحد عن حسن نية : بصنع المنتوج أو استعمال طريقة الصنع موضوع الاختراع المحمي بالبراءة، بتحضيرات جادة لمباشرة هذا الصنع أو هذا الاستعمال، يحق له الاستمرار في مباشرة عمله على الرغم من وجود براءة الاختراع المذكورة . إن حق المستخدم السابق لا يمكن تحويله أو نقله إلا مع المؤسسة أو الشركة أو الفروع التابعة لهما واللتين حدث فيهما الاستخدام أو التحضير للاستخدام."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_15_20030719_OpEnact_6720fc36f8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_15> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_15> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_15> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "طوال صلاحية البراءة يحق لمالكها أو لذوي الحقوق إدخال تغييرات أو تحسينات أو إضافات على اختراعه مع استيفاء الإجراءات المطلوبة لإيداع الطلب المحددة في المواد 20 إلى 25 أدناه . يتم إثبات هذه التغييرات أو التحسينات أو الإضافات بشهادات تسلم بنفس الشكل الذي تم بالنسبة للبراءة الرئيسية و يكون لها نفس الأثر. يترتب على كل طلب شهادة إضافة تسديد الرسوم المحددة وفقا للتشريع الساري المفعول . تنتهي صلاحية شهادات الإضافة بانقضاء البراءة الرئيسية."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_16_20030719_OpEnact_41ddd8a41d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_16> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_16> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_16> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "طالما لم تسلم شهادة الإضافة ، بإمكان طالب هذه الشهادة تحويل طلبه إلى طلب براءة اختراع يكون تاريخ إيداعها هو تاريخ إيداع طلب شهادة الإضافة. يترتب على البراءة المتحصل عليها تبعا للتحويل المذكور في الفقرة الأولى أعلاه، تسديد رسوم الإبقاء على سريان المفعول ابتداء من تاريخ إيداع طلب شهادة الإضافة ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_17_20030719_OpEnact_577ba14868> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_17> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يعد من قبيل اختراع الخدمة، الاختراع الذي ينجزه شخص أو عدة أشخاص خلال تنفيذ عقد عمل يتضمن مهمة اختراعية تسند إليهم صراحة وفي هذه الحالة وإذا لم تكن اتفاقية خاصة بين الهيئة المستخدمة التي تدعى \"الهيئة \" والمخترع ، يعود إلى الهيئة حق امتلاك الاختراع. وإذا عبرت الهيئة صراحة عن تخليها عن هذا الحق ، فإنه يصبح ملكا للمخترع. وفي أي حال من الأحوال، فإن لصاحب الاختراع الحق في ذكر صفة المخترع وفقا للفقرة 3 من المادة 10 أعلاه. تحدد كيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_18_20030719_OpEnact_9c236be542> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_18> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_18> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_18> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يعد اختراع الخدمة، الاختراع الذي ينجزه شخص أو عدة أشخاص بمقتضى اتفاقية غير الاتفاقية المنصوص عليها في المادة 17 أعلاه، وذلك باستخدام تقنيات الهيئة و/أو وسائلها . تحدد كيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_19_20030719_OpEnact_ea66292a3b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_19> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_19> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_19> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يمكن أن تعتبر سرية الاختراعات التي تهم الأمن الوطني و الاختراعات ذات الأثر الخاص على الصالح العام دون المساس ب الحقوق المادية والمعنوية للمخترع . تحدد كيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_1_20030719_OpEnact_7d11e63e3f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_1> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يهدف هذا الأمر إلى تحديد شروط حماية الاختراعات ، كما يحدد وسائل هذه الحماية وآثارها."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_20_20030719_OpEnact_b5f016c121> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_20> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يجب على كل من يرغب في الحصول على براءة اختراع أن يقوم بتقديم طلب كتابي صريح إلى المصلحة المختصة . يجب أن يتضمن طلب براءة الاختراع ما يأتي : استمارة طلب ووصف للاختراع و مطلب أو عدد من المطالب ورسم أو عدد من الرسومات عند اللزوم ، ووصف مختصر، وثائق إثبات تسديد الرسومات المحددة. عدا حالة اتفاق متبادل ، يتعين على المودعين المقيمين في الخارج تمثيلهم لدى المصلحة المختصة . تحدد كيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_21_20030719_OpEnact_218981ccf3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_21> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_21> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_21> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "بغض النظر عن أحكام المادة 20 أعلاه ، يعتبر تاريخ إيداع طلب براءة الاختراع هو تاريخ استلام المصلحة المختصة على الأقل لما يأتي: أ) استمارة طلب كتابي تسمح بالتعرف على الطالب وعلى رغبته في الحصول على براءة اختراع ، ب) وصف للاختراع مرفوقا بمطلب واحد على الأقل. غير أن الطلب الدولي الذي حصل على تاريخ إيداع دولي بموجب اتفاق التعاون بشأن البراءات والذي يشمل الجزائر كبلد معني للحصول على براءة، يعد كأنه طلب براءة مودع بتاريخ إيداعه الدولي."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_22_20030719_OpEnact_8149500003> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_22> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_22> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "لا يشمل طلب براءة الاختراع إلا اختراعا واحدا أو عدد من الاختراعات مرتبطة فيما بينها بحيث لا تمثل في مفهومها سوی اختراعا شاملا واحدا. ولا تتضمن قيودا أو شروطا أو تحفظات أو تحديدا أو منح حقوق يوصف الاختراع وصفا واضحا بما فيه الكفاية و کاملا حتى يتسنى لمحترف تنفيذه . يتعين أن يحدد المطلب أو المطالب التي يتضمنها الاختراع نطاق الحماية المطلوبة ، ويجب أن تكون واضحة ومختصرة و مبنية كليا على الوصف. ويستخدم الوصف المختصر لغرض الانتفاع بالمعلومة التقنية فقط."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_23_20030719_OpEnact_c9df02a3b6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_23> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_23> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_23> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "على كل من يرغب في المطالبة بأولوية إيداع سابق لنفس الاختراع أن يقدم تصريحا للأولوية ونسخة من الطلب السابق حسب الشروط والآجال المحددة عن طريق التنظيم ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_24_20030719_OpEnact_ad7d4fc5ed> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_24> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_24> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_24> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "كل شخص عرض اختراعا في معرض دولي رسمي أو معترف به رسميا ، يمكنه في أجل إثني عشر شهرا الموالية لتاريخ اختتام المعرض، طلب حماية هذا الاختراع مع المطالبة بالأولوية ابتداء من تاريخ عرض موضوع هذا الاختراع ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_25_20030719_OpEnact_e35d1396b6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_25> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_25> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_25> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يمكن المودع سحب طلبه كليا أو جزئيا قبل صدور براءة الاختراع ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_26_20030719_OpEnact_42eac28acb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_26> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_26> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_26> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "قبل إصدار براءة الاختراع وبعد تسديد الرسوم المحددة ، يجوز للمودع تصحيح الأخطاء المادية المثبتة قانونا في الوثائق المودعة إذا طلب ذلك في حالة عدم تسديد الرسم المطلوب أو عدم القيام بالتعديلات في الأجل المحدد والذي يمكن أن يمدد عند الضرورة المبررة ، فإن البراءة تسلم في حالتها."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_27_20030719_OpEnact_9ed043b6a1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_27> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_27> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تقوم المصلحة المختصة بعد الإيداع بالتأكد من أن الشروط المتعلقة بإجراءات الإيداع المحددة في القسم الأول من الباب الثالث أعلاه و في النصوص المتخذة لتطبيقه متوفرة . إذا لم يستوف الطلب هذه الشروط ، يستدعى طالب البراءة أو وكيله لتصحيح الملف في أجل شهرين ويمكن أن يمدد هذا الأجل، عند الضرورة، المعللة بطلب من المودع أو من وكيله. يحتفظ الطلب المصحح في هذا الأجل بتاريخ الإيداع الأول. في حالة عدم تصحيح ملف الطلب في الأجل المحدد ، يعتبر الطلب مسحوبا."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_28_20030719_OpEnact_e1a04aa47f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_28> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_28> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_28> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تقوم المصلحة بالتأكد من أن موضوع الطلب غير مدرج في الميادين المذكورة في المادة 7 وغير مقصى بداهة من الحماية بموجب المواد من 3 إلى 6 و 8 . تعلم المصلحة المختصة صاحب الطلب ، عند الاقتضاء ، بأن طلبه لا يسمح بمنحه براءة ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_29_20030719_OpEnact_81aefb7f2a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_29> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_29> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_29> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "إذا كان واضحا أن أي طلب لا يتوافق وأحكام الفقرة الأولى من المادة 22 أعلاه ، فإنه يمكن تجزئة هذا الطلب و تقسيمه إلى عدد من الطلبات بحيث ينفرد كل واحد منهم بتاريخ إيداع الطلب ذلك الأصلي و في الآجال المحددة عن طريق التنظيم . يجب أن لا يتعدى موضوع كل طلب مجزأ محتوى الطلب الأصلي ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_2_20030719_OpEnact_bac3053eb8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_2> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يقصد في مفهوم هذا الأمر بما يأتي: الاختراع : فكرة لمخترع ، تسمح عمليا بإيجاد حل لمشكل محدد في مجال التقنية، البراءة أو براءة الاختراع : وثيقة تسلم لحماية اختراع، المصلحة المختصة : المعهد الوطني الجزائري للملكية الصناعية،"@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_31_20030719_OpEnact_274f671a46> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_31> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_31> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_31> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تصدر براءات الاختراع ذات الطلبات المستوفية الشروط دون فحص مسبق وتحت مسؤولية الطالبين ومن غير أي ضمان ، سواء تعلق الأمر بواقع الاختراع أو جدته أو جدارته أو تعلق الأمر بوفاء الوصف و بدقته . و تسلم المصلحة المختصة للطالب شهادة تثبت صحة الطلب وتمثل براءة الاختراع . ترفق الشهادة المذكورة في الفقرة أعلاه بنسخة من الوصف والمطالب والرسومات بعد إثبات مطابقتها للأصل عند الحاجة ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_32_20030719_OpEnact_f3158b443a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_32> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_32> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_32> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تحفظ المصلحة المختصة سجلا تدون فيه كل براءات الاختراع المذكورة في المادة 31 أعلاه تسلسل صدورها وكل العمليات الواجب قيدها بموجب هذا الأمر والنصوص المتخذة لتطبيقه . تحدد كيفيات مسك السجل عن طريق التنظيم . و تمسك المصلحة المختصة مستخرجا للسجل المرقم والمؤشر عليه . يمكن أي شخص الاطلاع على سجل براءات الاختراع والحصول على مستخرجات منه بعد تسديد الرسم المحدد ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_33_20030719_OpEnact_5ca2934bf0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_33> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_33> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_33> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تنشر المصلحة المختصة نشرة رسمية للبراءات"@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_34_20030719_OpEnact_3794572359> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_34> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_34> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_34> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "مع مراعاة أحكام المادة 19 أعلاه ، تنشر المصلحة المختصة دوريا، في نشرتها الرسمية، براءات الاختراع و الأعمال المنصوص عليها في المادة 32 أعلاه ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_35_20030719_OpEnact_cde2682c98> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_35> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_35> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_35> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تحفظ المصلحة المختصة وثائق وصف براءة الاختراع والمطالب والرسومات بعد نشرها في النشرة المذكورة في المادة 33 أعلاه، وتبلغ عند كل طلب قضائي . باستطاعة أي شخص الاطلاع عليها و الحصول على نسخ منها بدفع المستحقات المترتبة عليها . تطبق أحكام الفقرتين السابقتين على النسخ الرسمية المقدمة من الطالبين المتمسكين بمطالبة الأولوية لإيداع سابق. يمكن طالب البراءة المتمسك بمطالبة الأولوية لإيداعه في الخارج قبل تسلمه البراءة، الحصول على نسخة رسمية لطلبه ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_36_20030719_OpEnact_4a4749b715> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_36> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_36> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_36> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تكون الحقوق الناجمة عن طلب براءة اختراع أو عن براءة اختراع و/أو شهادات الإضافة المحتملة المتصلة بها قابلة للانتقال كليا أو جزئيا . تشترط الكتابة في العقود المتضمنة انتقال الملكية أو التنازل عن حق الاستغلال أو توقف هذا الحق أو رهن أو رفع الرهن المتعلق بطلب براءة اختراع أو ببراءة اختراع وفقا للقانون الذي ينظم هذا العقد ، و يجب أن تقيد في سجل البراءات . لا تكون العقود المذكورة في الفقرة أعلاه ، نافذة في مواجهة الغير إلا بعد تسجيلها."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_37_20030719_OpEnact_b91b9c2421> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_37> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_37> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_37> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يمكن صاحب براءة الاختراع أو طالبها أن يمنح لشخص آخر رخصة استغلال اختراعه بموجب عقد . تعد باطلة البنود الواردة في العقود بالرخصة إذا فرضت على مشتري الرخصة، في المجال الصناعي أو التجاري ، تحديدات تمثل استعمالا تعسفيا للحقوق التي تخولها براءة الاختراع بحيث يكون لاستخدامها أثر مضر على المنافسة في السوق الوطنية ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_38_20030719_OpEnact_dbcdbc30fe> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_38> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_38> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_38> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يمكن أي شخص في أي وقت، بعد انقضاء أربع (4) سنوات ابتداء من تاريخ إيداع طلب براءة الاختراع أو ثلاث (3) سنوات ابتداء من تاريخ صدور براءة الاختراع ، أن يتحصل من المصلحة المختصة على رخصة استغلال بسبب عدم استغلال الاختراع أو نقص فيه . لتقدير الأجل المذكور في الفقرة أعلاه، تطبق المصلحة المختصة أقصى الآجال . لا يمكن منح الرخصة الإجبارية إلا إذا تحققت المصلحة المختصة من عدم الاستغلال أو نقص فيه ومن عدم وجود ظروف تبرر ذلك ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_39_20030719_OpEnact_23a7736f29> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_39> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_39> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_39> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "على كل شخص يطلب رخصة إجبارية وفقا ل المادتين 38 و 47 من هذا الأمر ، أن يثبت بأنه قام بتقديم طلب لصاحب البراءة ولم يستطع الحصول منه على رخصة تعاقدية بشروط منصفة ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_3_20030719_OpEnact_aa077b8f0e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_3> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_3> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_3> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يمكن أن تحمي بواسطة براءة الاختراع ، الاختراعات الجديدة والناتجة عن نشاط اختراعي والقابلة للتطبيق الصناعي . يمكن أن يتضمن الاختراع منتوجا أو طريقة."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_40_20030719_OpEnact_82c9de0d27> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_40> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_40> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_40> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "لا يمكن أن تمنح الرخصة الإجبارية المذكورة في المادة 38 أعلاه إلا للطالب الذي يقدم الضمانات الضرورية بخصوص استغلال من شأنه تدارك الخلل الذي أدى إلى الرخصة الإجبارية ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_41_20030719_OpEnact_195dc927c3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_41> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_41> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_41> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تمنح الرخصة الإجبارية مقابل تعويض مناسب، و حسب الحالة، فإنه يراعى القيمة الاقتصادية لها."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_42_20030719_OpEnact_a7af3b287b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_42> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_42> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_42> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "لا يمكن نقل الرخصة الإجبارية إلا مع جزء المؤسسة أو المحل التجاري المنتفع بها. ولا يتم هذا الانتقال إلا بعد موافقة المصلحة المختصة ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_43_20030719_OpEnact_d684f50d76> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_43> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_43> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_43> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تسجل الرخصة الإجبارية أو انتقالها لدى المصلحة المختصة ، بعد تسديد الرسم المحدد ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_44_20030719_OpEnact_ce7c77a919> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_44> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_44> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_44> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يمكن المصلحة المختصة تعديل قرار منح الرخصة الإجبارية ، بطلب من صاحب براءة الاختراع أو المستفيد من الرخصة الإجبارية، إذا ظهرت أحداث جديدة تبرر هذا التعديل و خاصة إذا كان صاحب البراءة يمنح رخصا تعاقدية بشروط أكثر امتيازا للمرخص التعاقدي ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_45_20030719_OpEnact_2f1209f397> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_45> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_45> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_45> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "دون الإخلال بأحكام الفقرة الأخيرة من هذه المادة، يمكن المصلحة المختصة أن تسحب الرخصة الإجبارية بطلب من صاحب براءة الاختراع في الحالات الآتية : (1) إذا زالت الشروط التي بررت منح الرخصة الإجبارية ، (2) إذا تبين أن الشروط المحددة لم تعد متوفرة في المستفيد من الرخصة الإجبارية . لا تسحب المصلحة المختصة الرخصة الإجبارية إذا اقتنعت بوجود ظروف تبرر الإبقاء عليها وخصوصا في الحالة المذكورة في النقطة (1) أعلاه، إذا كان المستفيد من الرخصة يستغل الاختراع المحمي بالبراءة صناعيا أو قام بتحضيرات جادة من أجل ذلك"@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_46_20030719_OpEnact_b9a995df55> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_46> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_46> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_46> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يقدم طلب الرخصة الإجبارية لبراءة الاختراع للمصلحة المختصة مبررا بالحجج المذكورة في المادة 39 أعلاه. تستدعي المصلحة المختصة الطالب وصاحب البراءة أو من يمثلهما وتستمع إليهما. إذا منحت المصلحة المختصة الرخصة الإجبارية ، يجب عليها تحديد شروطها و مدتها وقيمة التعويض اللازم لصاحب البراءة إلا في حالة اتفاق الطرفين، دون الإضرار في هذه الحالة بالطعن لدى الجهة القضائية المختصة التي تفصل في الأمر ابتدائيا و نهائيا. تطبق أحكام هذه المادة في حالة انتقال الرخصة الإجبارية لبراءة اختراع وفقا لما نصت عليه المادة 42 من هذا الأمر."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_47_20030719_OpEnact_129b333703> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_47> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_47> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_47> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "إذا لم يكن استغلال الاختراع المحمي ببراءة ممكنا دون المساس بالحقوق الناتجة عن براءة اختراع سابقة ، فإنه يمكن منح رخصة إجبارية لصاحب براءة الاختراع اللاحقة بناء على طلب منه . تمنح مثل هذه الرخصة في الحدود الضرورية لاستغلال الاختراع على أن يشكل هذا الاختراع تقدما تقنيا ملحوظا و مصلحة اقتصادية هامة بالنسبة للاختراع موضوع البراءة السابقة. لصاحب البراءة السابقة الحق في الرخصة المتبادلة بشروط معقولة لاستعمال الاختراع موضوع البراءة اللاحقة ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_48_20030719_OpEnact_edd72703c4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_48> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_48> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_48> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تكون الرخصة الإجبارية المذكورة في المادة 38 أعلاه، غير استئثارية ويكون هدفها الأساسي تموين السوق الوطنية."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_49_20030719_OpEnact_3ba6a34518> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_49> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_49> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_49> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يمكن الوزير المكلف بالملكية الصناعية في أي وقت، منح رخصة إجبارية لمصلحة من مصالح الدولة أو للغير الذي يتم تعيينه من طرفه، لطلب براءة أو لبراءة اختراع ، و ذلك في إحدى الحالات الآتية : عند ما تستدعي المصلحة العامة و خاصة الأمن الوطني، التغذية، الصحة، أو تنمية قطاعات اقتصادية وطنية أخرى، و لا سيما عندما يكون سعر المواد الصيدلانية المحمية بواسطة البراءة مخالفا ومرتفعا بالنسبة للأسعار المتوسطة للسوق . عند ما ترى هيئة قضائية أو إدارية، أن صاحب البراءة أو من هو مرخص له باستغلالها، يستغل البراءة بطريقة مخالفة للقواعد التنافسية، وعندما يرى الوزير المكلف بالملكية الصناعية أن استغلال البراءة تطبيقا لهذه الفقرة يسمح بالعدول عن هذا التصرف ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_4_20030719_OpEnact_2b425854d7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_4> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_4> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_4> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يعتبر الاختراع جديدا إذا لم يكن مدرجا في حالة التقنية ، وتتضمن هذه الحالة كل ما وضع في متناول الجمهور عن طريق وصف كتابي أو شفوي أو استعمال أو أي وسيلة أخرى عبر العالم، وذلك قبل يوم إيداع طلب الحماية أو تاريخ مطالبة الأولوية بها. لا يعتبر الاختراع في متناول الجمهور بما تعرف عليه الجمهور خلال الإثني عشر شهرا التي تسبق تاريخ إيداع البراءة أو تاريخ الأولوية إثر فعل قام به المودع أو سابقه في الحق طبقا ل المادة 14 أدناه أو جراء تعسف من الغير إزاء المودع أو إزاء سابقه في الحق."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_50_20030719_OpEnact_e5be002e47> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_50> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_50> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_50> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تطبق المواد من 43 إلى 46 و 48 مع ما يلزم من تغيير على الرخصة الإجبارية للمنفعة العامة ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_51_20030719_OpEnact_826fe7d5eb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_51> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_51> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_51> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يمكن صاحب براءة الاختراع أن يتخلى، كليا أو جزئيا و في أي وقت، عن مطلب أو عدة مطالب تتعلق ببراءته بتقديم تصريح مكتوب إلى المصلحة المختصة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_52_20030719_OpEnact_ec890febfd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_52> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_52> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_52> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "إذا تم قيد إحدى الرخص المذكورة في الفصلين الثاني والثالث من الباب الخامس أعلاه في سجل البراءات ، فـ التخلي عن براءة الاختراع لا يقيد إلا بعد تقديم الحاصل على الرخصة تصريحا يقبل فيه هذا التخلي ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_53_20030719_OpEnact_89987ad4a4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_53> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_53> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_53> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تعلن الجهة القضائية المختصة البطلان الكلي أو الجزئي لمطلب أو لعدة مطالب تتعلق ب براءة اختراع ، بناء على طلب أي شخص معني في الحالات الآتية : إذا لم تتوفر في موضوع براءة الاختراع الأحكام الواردة في المواد من 3 إلى 8 أعلاه، إذا لم تتوفر في وصف الاختراع أحكام المادة 22 (الفقرة 3) أعلاه، وإذا لم تحدد مطالب براءة الاختراع الحماية المطلوبة، إذا كان الاختراع ذاته موضوع براءة اختراع في الجزائر تبعا لطلب سابق أو كان مستفيدا من أولوية سابقة. عندما يصبح قرار الإبطال نهائيا ، يتولى الطرف الذي يعنيه التعجيل، تبليغه بقوة القانون إلى المصلحة المختصة التي تقوم بقيده ونشره ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_54_20030719_OpEnact_6a3dba6289> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_54> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_54> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_54> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تسقط براءة الاختراع عند عدم تسديد رسوم الإبقاء على سريان المفعول السنوية الموافقة لتاريخ الإيداع والمنصوص عليها في المادة 9 أعلاه . غير أن لصاحب البراءة أو طلب البراءة مهلة ستة (6) أشهر تحسب ابتداء من هذا التاريخ لتسديد الرسوم المستحقة إضافة إلى غرامة تأخير . ومع ذلك، وبطلب معلل من صاحب البراءة يقدم في أجل أقصاه ستة (6) أشهر بعد انقضاء الأجل القانوني ، يمكن المصلحة المختصة تقرير إعادة تأهيل البراءة وذلك بعد تسديد الرسوم المستحقة ورسم إعادة التأهيل ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_55_20030719_OpEnact_5552e1e8f8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_55> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_55> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_55> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "إذا انقضت سنتان على منح الرخصة الإجبارية ولم يدرك عدم الاستغلال أو النقص فيه لاختراع حاز على براءة ، لأسباب تقع على عاتق صاحبها ، يمكن الجهة القضائية المختصة بناء على طلب الوزير المعني و بعد استشارة الوزير المكلف بالملكية الصناعية ، أن تصدر حكما بسقوط براءة الاختراع ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_56_20030719_OpEnact_279b2dd9a2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_56> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_56> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_56> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "مع مراعاة المادتين 12 14 أعلاه ، يعتبر مساسا بالحقوق الناجمة عن براءة الاختراع كل عمل من الأعمال المنصوص عليها في المادة 11 أعلاه يتم بدون موافقة صاحب البراءة ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_58_20030719_OpEnact_067bb47a6c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_58> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_58> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_58> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يمكن صاحب براءة الاختراع أو خلفه رفع دعوى قضائية ضد أي شخص قام أو يقوم بإحدى الأعمال حسب مفهوم المادة 56 أعلاه . وإذا أثبت المدعي ارتكاب أحد الأعمال المذكورة في الفقرة أعلاه ، فإن الجهة القضائية المختصة تقضي بمنح التعويضات المدنية و يمكنها الأمر بمنع مواصلة هذه الأعمال واتخاذ أي إجراء آخر منصوص عليه في التشريع الساري المفعول ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_59_20030719_OpEnact_9f2f2cd74f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_59> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "بغض النظر عن أحكام الفقرة 2 من المادة 58 أعلاه، و حتى إثبات العكس، يعتبر كل منتوج مطابق صنع بدون رضا صاحب البراءة منتوجا حصل عليه بالطريقة التي تشملها البراءة و ذلك على الأقل في إحدى الحالتين الآتيتين : عندما يكون موضوع البراءة طريقة تتعلق بالحصول على منتوج جديد، عندما يوجد احتمال كبير بأن المنتوج المطابق حصل عليه بالطريقة التي تشملها البراءة وأن صاحب البراءة لم يستطع برغم الجهود المبذولة، شرح الطريقة المستعملة. وفي هذه الحالة، يمكن الجهة القضائية المختصة أن تأمر المدعى عليه بتقديم الأدلة التي تثبت أن الطريقة المستعملة للحصول على منتوج مطابق تختلف عن الطريقة التي تشملها البراءة . فعلى الجهة القضائية المختصة أن تأخذ بعين الاعتبار المصالح المشروعة للمدعى عليه عند اعتمادها لأي أدلة تطلبها، وذلك بعدم الفصح عن أسراره الصناعية والتجارية ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_5_20030719_OpEnact_8d53c9f625> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_5> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_5> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_5> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يعتبر الاختراع ناتجا عن نشاط اختراعي إذا لم يكن ناجما بداهة من حالة التقنية ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_60_20030719_OpEnact_f19db24cd1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_60> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_60> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_60> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يمكن المدعى عليه في أية قضية من القضايا المذكورة في المادتين 58 و 59 أعلاه، رفع دعوى بطلان براءة الاختراع عن طريق نفس الإجراء ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_61_20030719_OpEnact_5e5fde43e5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_61> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_61> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_61> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يعد كل عمل متع يرتكب مفهوم المادة 56 أعلاه، جنحة تقليد يعاقب على جنحة التقليد بالحبس من ستة (6) أشهر إلى سنتين وبغرامة من مليونين وخمسمائة ألف دينار ( 2.500.000 دج) إلى عشرة ملايين دينار (10.000.000 دج) أو بإحدى هاتين العقوبتين فقط."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_62_20030719_OpEnact_a5f00fd3b6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_62> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_62> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_62> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "يعاقب بنفس العقوبة التي يعاقب بها المقلد كل من يتعمد إخفاء شيء مقلد أو إخفاء عدة أشياء مقلدة أو يبيعها أو يعرضها للبيع أو يدخلها إلى التراب الوطني ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_63_20030719_OpEnact_49f40aed5d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_63> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_63> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_63> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تبقى البراءات الصادرة بموجب المرسوم التشريعي رقم 93-17 المؤرخ في 23 جمادى الثانية عام 1414 الموافق 7 ديسمبر سنة 1993 والمتعلق بـ حماية الاختراعات وكذا شهادات الإضافة المتعلقة بها، خاضعة لأحكام نفس المرسوم التشريعي ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_64_20030719_OpEnact_d91125f3b3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_64> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_64> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_64> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "تلغى أحكام المرسوم التشريعي رقم 93-17 المؤرخ في 23 جمادى الثانية عام 1414 الموافق 7 ديسمبر سنة 1993 والمتعلق بحماية الاختراعات ، مع مراعاة أحكام المادتين 61 و 62 أعلاه."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_65_20030719_OpEnact_f3866bf6d0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_65> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_65> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "ينشر هذا الأمر في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 19 جمادى الأولى عام 1424 الموافق 19 يوليو سنة 2003. عبد العزيز بوتفليقة"@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_7_20030719_OpEnact_b8b02b59a4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_7> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_7> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_7> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "لا تعد من قبيل الاختراعات في مفهوم هذا الأمر المبادئ والنظريات والاكتشافات ذات الطابع العلمي وكذلك المناهج الرياضية. الخطط والمبادئ والمناهج الرامية إلى القيام بأعمال ذات طابع ثقافي أو ترفيهي محض المناهج ومنظومات التعليم والتنظيم والإدارة التسيير، طرق علاج جسم الإنسان أو الحيوان بالجراحة أو المداواة وكذلك مناهج التشخيص، مجرد تقديم المعلومات، برامج الحاسوب، الابتكارات ذات الطابع التزييني المحض."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_8_20030719_OpEnact_0d8ebcb91d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_8> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_8> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_8> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "لا يمكن الحصول على براءات اختراع بموجب هذا الأمر بالنسبة لما يأتي: الأنواع النباتية أو الأجناس الحيوانية وكذلك الطرق البيولوجية المحضة للحصول على نباتات أو حيوانات الاختراعات التي يكون تطبيقها على الإقليم الجزائري مخلا بالنظام أو الآداب العامة، الاختراعات التي يكون استغلالها على الإقليم الجزائري مضرا بصحة و حياة الأشخاص والحيوانات أو مضرا بحفظ النباتات أو يشكل خطرا جسيما على حماية البيئة."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_9_20030719_OpEnact_8e184eadb2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_9> ;
    dzdoc:versionOf <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_9> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_9> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:versionText "مدة براءة الاختراع هي عشرون (20) سنة ابتداء من تاريخ إيداع الطلب مع مراعاة دفع رسوم التسجيل ورسوم الإبقاء على سريان المفعول وفقا للتشريع المعمول به ."@ar .

