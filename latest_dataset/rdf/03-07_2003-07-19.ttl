<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_58> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن صاحب براءة الاختراع أو خلفه رفع دعوى قضائية ضد أي شخص قام أو يقوم بإحدى الأعمال حسب مفهوم المادة 56 أعلاه . وإذا أثبت المدعي ارتكاب أحد الأعمال المذكورة في الفقرة أعلاه ، فإن الجهة القضائية المختصة تقضي بمنح التعويضات المدنية و يمكنها الأمر بمنع مواصلة هذه الأعمال واتخاذ أي إجراء آخر منصوص عليه في التشريع الساري المفعول ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_58_20030719_OpEnact_067bb47a6c> ;
    dzdoc:replacementText "يمكن صاحب براءة الاختراع أو خلفه رفع دعوى قضائية ضد أي شخص قام أو يقوم بإحدى الأعمال حسب مفهوم المادة 56 أعلاه . وإذا أثبت المدعي ارتكاب أحد الأعمال المذكورة في الفقرة أعلاه ، فإن الجهة القضائية المختصة تقضي بمنح التعويضات المدنية و يمكنها الأمر بمنع مواصلة هذه الأعمال واتخاذ أي إجراء آخر منصوص عليه في التشريع الساري المفعول ."@ar ;
