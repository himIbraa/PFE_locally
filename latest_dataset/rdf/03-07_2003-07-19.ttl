    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان واضحا أن أي طلب لا يتوافق وأحكام الفقرة الأولى من المادة 22 أعلاه ، فإنه يمكن تجزئة هذا الطلب و تقسيمه إلى عدد من الطلبات بحيث ينفرد كل واحد منهم بتاريخ إيداع الطلب ذلك الأصلي و في الآجال المحددة عن طريق التنظيم . يجب أن لا يتعدى موضوع كل طلب مجزأ محتوى الطلب الأصلي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_29_20030719_OpEnact_81aefb7f2a> ;
    dzdoc:replacementText "إذا كان واضحا أن أي طلب لا يتوافق وأحكام الفقرة الأولى من المادة 22 أعلاه ، فإنه يمكن تجزئة هذا الطلب و تقسيمه إلى عدد من الطلبات بحيث ينفرد كل واحد منهم بتاريخ إيداع الطلب ذلك الأصلي و في الآجال المحددة عن طريق التنظيم . يجب أن لا يتعدى موضوع كل طلب مجزأ محتوى الطلب الأصلي ."@ar ;
