<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_11> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مع مراعاة المادة 14 أدناه، تخول براءة الاختراع لمالكها الحقوق الاستئثارية الآتية : في حالة ما إذا كان موضوع الاختراع منتوجا ، يمنع الغير من القيام بصناعة المنتوج أو استعماله أو بيعه أو عرضه للبيع أو استيراده لهذه الأغراض دون رضاه إذا كان موضوع الاختراع طريقة صنع ، يمنع الغير من استعمال طريقة الصنع واستعمال المنتوج الناتج مباشرة عن هذه الطريقة أو بيعه أو عرضا للبيع أو استيراده لهذه الأغراض دون رضاه. لصاحب البراءة الحق كذلك في التنازل عنها أو في تحويلها عن طريق الإرث و إبرام عقود تراخيص ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_11_20030719_OpEnact_24129acbbc> ;
    dzdoc:replacementText "مع مراعاة المادة 14 أدناه، تخول براءة الاختراع لمالكها الحقوق الاستئثارية الآتية : في حالة ما إذا كان موضوع الاختراع منتوجا ، يمنع الغير من القيام بصناعة المنتوج أو استعماله أو بيعه أو عرضه للبيع أو استيراده لهذه الأغراض دون رضاه إذا كان موضوع الاختراع طريقة صنع ، يمنع الغير من استعمال طريقة الصنع واستعمال المنتوج الناتج مباشرة عن هذه الطريقة أو بيعه أو عرضا للبيع أو استيراده لهذه الأغراض دون رضاه. لصاحب البراءة الحق كذلك في التنازل عنها أو في تحويلها عن طريق الإرث و إبرام عقود تراخيص ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_11> ;
    dzdoc:sourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_11> ;
    dzdoc:targetDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
