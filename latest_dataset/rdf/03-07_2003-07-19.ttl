    dzdoc:heading "أحكام عامة"@ar ;
    dzdoc:number "الثاني" ;
    dzdoc:position 1 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:definesTerm dzterm:inventive_step ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_2_subsec_1> ;
    dzdoc:eId "art_5" ;
    dzdoc:fullText "يعتبر الاختراع ناتجا عن نشاط اختراعي إذا لم يكن ناجما بداهة من حالة التقنية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_5> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_5_defocc_d8f99c756e55> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_5_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_5_20030719_OpEnact_8d53c9f625> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "5" ;
    dzdoc:position 4 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_9> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "تلغى أحكام المرسوم التشريعي رقم 93-17 المؤرخ في 23 جمادى الثانية عام 1414 الموافق 7 ديسمبر سنة 1993 والمتعلق بحماية الاختراعات ، مع مراعاة أحكام المادتين 61 و 62 أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_64_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_64_20030719_OpEnact_d91125f3b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 64" ;
    dzdoc:position 59 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_61>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_62> ;
    dzdoc:referencesExternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_64_extref_f3471967> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_61>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_62> .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_2_subsec_1> a dzdoc:Subsection ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_2> ;
    dzdoc:directlyContains <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_3>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_4>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_5>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_7>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_8>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_9> ;
    dzdoc:eId "chp_2_subsec_1" ;
    dzdoc:hasArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_3>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_4>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_5>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_7>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_8>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_9> ;
    dzdoc:heading "شروط أهلية الاختراع للحصول على البراءة"@ar ;
    dzdoc:number "الأول" ;
    dzdoc:position 0 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:definesTerm dzterm:service_invention ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_2_subsec_4> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "يعد اختراع الخدمة، الاختراع الذي ينجزه شخص أو عدة أشخاص بمقتضى اتفاقية غير الاتفاقية المنصوص عليها في المادة 17 أعلاه، وذلك باستخدام تقنيات الهيئة و/أو وسائلها . تحدد كيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_18> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_18_defocc_f178987875da> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_18_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_18_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_18_20030719_OpEnact_9c236be542> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 18" ;
    dzdoc:position 15 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_17> .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_3_subsec_1> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "بغض النظر عن أحكام المادة 20 أعلاه ، يعتبر تاريخ إيداع طلب براءة الاختراع هو تاريخ استلام المصلحة المختصة على الأقل لما يأتي: أ) استمارة طلب كتابي تسمح بالتعرف على الطالب وعلى رغبته في الحصول على براءة اختراع ، ب) وصف للاختراع مرفوقا بمطلب واحد على الأقل. غير أن الطلب الدولي الذي حصل على تاريخ إيداع دولي بموجب اتفاق التعاون بشأن البراءات والذي يشمل الجزائر كبلد معني للحصول على براءة، يعد كأنه طلب براءة مودع بتاريخ إيداعه الدولي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_21_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_21_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_21_20030719_OpEnact_218981ccf3> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "21" ;
    dzdoc:position 18 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_20> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_21_condition_0_c1fb19ff> ;
    dzdoc:usesTerm dzterm:competent_authority,
        dzterm:patent .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_3_subsec_1> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "على كل من يرغب في المطالبة بأولوية إيداع سابق لنفس الاختراع أن يقدم تصريحا للأولوية ونسخة من الطلب السابق حسب الشروط والآجال المحددة عن طريق التنظيم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_23_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_23_20030719_OpEnact_c9df02a3b6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_23_obligation_0_722cebd7> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "23" ;
    dzdoc:position 20 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_4_subsec_2> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "مع مراعاة أحكام المادة 19 أعلاه ، تنشر المصلحة المختصة دوريا، في نشرتها الرسمية، براءات الاختراع و الأعمال المنصوص عليها في المادة 32 أعلاه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_34_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_34_20030719_OpEnact_3794572359> ;
    dzdoc:imposesObligation <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_34_obligation_0_4505258d> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 34" ;
    dzdoc:position 30 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_19>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_32> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_19>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_32> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_34_condition_0_6ab05312> ;
    dzdoc:usesTerm dzterm:competent_authority .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:definesTerm dzterm:new_invention ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_2_subsec_1> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "يعتبر الاختراع جديدا إذا لم يكن مدرجا في حالة التقنية ، وتتضمن هذه الحالة كل ما وضع في متناول الجمهور عن طريق وصف كتابي أو شفوي أو استعمال أو أي وسيلة أخرى عبر العالم، وذلك قبل يوم إيداع طلب الحماية أو تاريخ مطالبة الأولوية بها. لا يعتبر الاختراع في متناول الجمهور بما تعرف عليه الجمهور خلال الإثني عشر شهرا التي تسبق تاريخ إيداع البراءة أو تاريخ الأولوية إثر فعل قام به المودع أو سابقه في الحق طبقا ل المادة 14 أدناه أو جراء تعسف من الغير إزاء المودع أو إزاء سابقه في الحق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_4> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_4_defocc_2db5cdbedd8d> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_4_para_0>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_4_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_4_20030719_OpEnact_2b425854d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "4" ;
    dzdoc:position 3 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_14> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_14> .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_5_subsec_2> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "تكون الرخصة الإجبارية المذكورة في المادة 38 أعلاه، غير استئثارية ويكون هدفها الأساسي تموين السوق الوطنية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_48_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_48_20030719_OpEnact_edd72703c4> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "48" ;
    dzdoc:position 44 ;
