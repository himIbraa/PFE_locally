<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_45_condition_0_ffbc8a26> a dznorm:Condition ;
    dznorm:conditionText "إذا زالت الشروط التي بررت منح الرخصة الإجبارية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_45> ;
