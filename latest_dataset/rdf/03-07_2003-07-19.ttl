    dzdoc:confidenceScore 0.45 ;
    dzdoc:evidenceText "وبمقتضى المرسوم الرئاسي رقم 99-92 المؤرخ في 29 ذي الحجة عام 1419 الموافق 15 أبريل سنة 1999 والمتضمن المصادقة بتحفظ على معاهدة التعاون بشأن البراءات المبرمة في واشنطن بتاريخ 19 يونيو سنة 1970 و المعدلة في : 28 سبتمبر سنة 1979، وفي 3 فبراير سنة 1984، وعلى لائحتها التنفيذية،"@ar ;
    dzdoc:extractionMethod "text_pattern_doc_type_number" ;
    dzdoc:isInferred true ;
    dzdoc:sourceSegment <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#preamble_segment_11> .

