<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_61> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد كل عمل متع يرتكب مفهوم المادة 56 أعلاه، جنحة تقليد يعاقب على جنحة التقليد بالحبس من ستة (6) أشهر إلى سنتين وبغرامة من مليونين وخمسمائة ألف دينار ( 2.500.000 دج) إلى عشرة ملايين دينار (10.000.000 دج) أو بإحدى هاتين العقوبتين فقط."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_61_20030719_OpEnact_5e5fde43e5> ;
