<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_7> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تعد من قبيل الاختراعات في مفهوم هذا الأمر المبادئ والنظريات والاكتشافات ذات الطابع العلمي وكذلك المناهج الرياضية. الخطط والمبادئ والمناهج الرامية إلى القيام بأعمال ذات طابع ثقافي أو ترفيهي محض المناهج ومنظومات التعليم والتنظيم والإدارة التسيير، طرق علاج جسم الإنسان أو الحيوان بالجراحة أو المداواة وكذلك مناهج التشخيص، مجرد تقديم المعلومات، برامج الحاسوب، الابتكارات ذات الطابع التزييني المحض."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_7_20030719_OpEnact_b8b02b59a4> ;
    dzdoc:replacementText "لا تعد من قبيل الاختراعات في مفهوم هذا الأمر المبادئ والنظريات والاكتشافات ذات الطابع العلمي وكذلك المناهج الرياضية. الخطط والمبادئ والمناهج الرامية إلى القيام بأعمال ذات طابع ثقافي أو ترفيهي محض المناهج ومنظومات التعليم والتنظيم والإدارة التسيير، طرق علاج جسم الإنسان أو الحيوان بالجراحة أو المداواة وكذلك مناهج التشخيص، مجرد تقديم المعلومات، برامج الحاسوب، الابتكارات ذات الطابع التزييني المحض."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_7> ;
    dzdoc:sourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
