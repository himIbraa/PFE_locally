    rdfs:label "الرخصة تصريحا يقبل فيه"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "التخلي عن براءة الاختراع لا يقيد إلا بعد تقديم الحاصل على الرخصة تصريحا يقبل فيه هذا التخلي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_52> .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_52_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_52> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا تم قيد إحدى الرخص المذكورة في الفصلين الثاني والثالث من الباب الخامس أعلاه في سجل البراءات، فـالتخلي عن براءة الاختراع لا يقيد إلا بعد تقديم الحاصل على الرخصة تصريحا يقبل فيه هذا التخلي."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_53_condition_0_d833fc48> a dznorm:Condition ;
