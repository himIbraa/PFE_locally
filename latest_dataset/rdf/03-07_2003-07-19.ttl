<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_12> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تشمل الحقوق الواردة عن براءة الاختراع إلا الأعمال ذات الأغراض الصناعية أو التجارية . ولا تشمل هذه الحقوق ما يأتي: الأعمال المؤداة لأغراض البحث العلمي فقط، الأعمال التي تخص المنتوج الذي تشمله البراءة و ذلك بعد رض هذا المنتوج في السوق شرعا، استعمال وسائل محمية ببراءة على متن البواخر والسفن الفضائية أو أجهزة النقل الجوية أو البرية الأجنبية التي تدخل المياه الإقليمية أو المجال الجوي أو التراب الوطني دخولا مؤقتا أو اضطراريا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_12_20030719_OpEnact_84654f8981> ;
    dzdoc:replacementText "لا تشمل الحقوق الواردة عن براءة الاختراع إلا الأعمال ذات الأغراض الصناعية أو التجارية . ولا تشمل هذه الحقوق ما يأتي: الأعمال المؤداة لأغراض البحث العلمي فقط، الأعمال التي تخص المنتوج الذي تشمله البراءة و ذلك بعد رض هذا المنتوج في السوق شرعا، استعمال وسائل محمية ببراءة على متن البواخر والسفن الفضائية أو أجهزة النقل الجوية أو البرية الأجنبية التي تدخل المياه الإقليمية أو المجال الجوي أو التراب الوطني دخولا مؤقتا أو اضطراريا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_12> ;
    dzdoc:sourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_12> ;
    dzdoc:targetDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_14> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عند تاريخ إيداع طلب براءة الاختراع أو تاريخ الأولوية المطالب به قانونا إذا قام أحد عن حسن نية : بصنع المنتوج أو استعمال طريقة الصنع موضوع الاختراع المحمي بالبراءة، بتحضيرات جادة لمباشرة هذا الصنع أو هذا الاستعمال، يحق له الاستمرار في مباشرة عمله على الرغم من وجود براءة الاختراع المذكورة . إن حق المستخدم السابق لا يمكن تحويله أو نقله إلا مع المؤسسة أو الشركة أو الفروع التابعة لهما واللتين حدث فيهما الاستخدام أو التحضير للاستخدام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_14_20030719_OpEnact_eccdbb486c> ;
    dzdoc:replacementText "عند تاريخ إيداع طلب براءة الاختراع أو تاريخ الأولوية المطالب به قانونا إذا قام أحد عن حسن نية : بصنع المنتوج أو استعمال طريقة الصنع موضوع الاختراع المحمي بالبراءة، بتحضيرات جادة لمباشرة هذا الصنع أو هذا الاستعمال، يحق له الاستمرار في مباشرة عمله على الرغم من وجود براءة الاختراع المذكورة . إن حق المستخدم السابق لا يمكن تحويله أو نقله إلا مع المؤسسة أو الشركة أو الفروع التابعة لهما واللتين حدث فيهما الاستخدام أو التحضير للاستخدام."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_14> ;
    dzdoc:sourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_14> ;
    dzdoc:targetDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_15> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "طوال صلاحية البراءة يحق لمالكها أو لذوي الحقوق إدخال تغييرات أو تحسينات أو إضافات على اختراعه مع استيفاء الإجراءات المطلوبة لإيداع الطلب المحددة في المواد 20 إلى 25 أدناه . يتم إثبات هذه التغييرات أو التحسينات أو الإضافات بشهادات تسلم بنفس الشكل الذي تم بالنسبة للبراءة الرئيسية و يكون لها نفس الأثر. يترتب على كل طلب شهادة إضافة تسديد الرسوم المحددة وفقا للتشريع الساري المفعول . تنتهي صلاحية شهادات الإضافة بانقضاء البراءة الرئيسية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_15_20030719_OpEnact_6720fc36f8> ;
    dzdoc:replacementText "طوال صلاحية البراءة يحق لمالكها أو لذوي الحقوق إدخال تغييرات أو تحسينات أو إضافات على اختراعه مع استيفاء الإجراءات المطلوبة لإيداع الطلب المحددة في المواد 20 إلى 25 أدناه . يتم إثبات هذه التغييرات أو التحسينات أو الإضافات بشهادات تسلم بنفس الشكل الذي تم بالنسبة للبراءة الرئيسية و يكون لها نفس الأثر. يترتب على كل طلب شهادة إضافة تسديد الرسوم المحددة وفقا للتشريع الساري المفعول . تنتهي صلاحية شهادات الإضافة بانقضاء البراءة الرئيسية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_15> ;
    dzdoc:sourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_15> ;
    dzdoc:targetDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2003-07-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_16> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "طالما لم تسلم شهادة الإضافة ، بإمكان طالب هذه الشهادة تحويل طلبه إلى طلب براءة اختراع يكون تاريخ إيداعها هو تاريخ إيداع طلب شهادة الإضافة. يترتب على البراءة المتحصل عليها تبعا للتحويل المذكور في الفقرة الأولى أعلاه، تسديد رسوم الإبقاء على سريان المفعول ابتداء من تاريخ إيداع طلب شهادة الإضافة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_16_20030719_OpEnact_41ddd8a41d> ;
    dzdoc:replacementText "طالما لم تسلم شهادة الإضافة ، بإمكان طالب هذه الشهادة تحويل طلبه إلى طلب براءة اختراع يكون تاريخ إيداعها هو تاريخ إيداع طلب شهادة الإضافة. يترتب على البراءة المتحصل عليها تبعا للتحويل المذكور في الفقرة الأولى أعلاه، تسديد رسوم الإبقاء على سريان المفعول ابتداء من تاريخ إيداع طلب شهادة الإضافة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_16> ;
    dzdoc:sourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_16> ;
    dzdoc:targetDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2003-07-19"^^xsd:date ;
