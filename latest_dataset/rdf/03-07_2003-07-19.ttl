<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_24> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل شخص عرض اختراعا في معرض دولي رسمي أو معترف به رسميا ، يمكنه في أجل إثني عشر شهرا الموالية لتاريخ اختتام المعرض، طلب حماية هذا الاختراع مع المطالبة بالأولوية ابتداء من تاريخ عرض موضوع هذا الاختراع ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_24_20030719_OpEnact_ad7d4fc5ed> ;
