<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_44> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن المصلحة المختصة تعديل قرار منح الرخصة الإجبارية ، بطلب من صاحب براءة الاختراع أو المستفيد من الرخصة الإجبارية، إذا ظهرت أحداث جديدة تبرر هذا التعديل و خاصة إذا كان صاحب البراءة يمنح رخصا تعاقدية بشروط أكثر امتيازا للمرخص التعاقدي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_44_20030719_OpEnact_ce7c77a919> ;
    dzdoc:replacementText "يمكن المصلحة المختصة تعديل قرار منح الرخصة الإجبارية ، بطلب من صاحب براءة الاختراع أو المستفيد من الرخصة الإجبارية، إذا ظهرت أحداث جديدة تبرر هذا التعديل و خاصة إذا كان صاحب البراءة يمنح رخصا تعاقدية بشروط أكثر امتيازا للمرخص التعاقدي ."@ar ;
