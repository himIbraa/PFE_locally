    dzdoc:evidenceText "وبمقتضى الأمر رقم 75-02 المؤرخ في 26 ذي الحجة عام 1394 الموافق 9 يناير سنة 1975 والمتضمن المصادقة على اتفاقية باريس لحماية الملكية الصناعية المبرمة في 20 مارس سنة 1883 والمعدلة ببروكسل في 14 ديسمبر سنة 1900، وواشنطن في 2 يونيو سنة 1911 ولا هاي في 6 نوفمبر سنة 1925 ولندن في 2 يونيو سنة 1934 ولشبونة في 31 أكتوبر سنة 1958 و استوكهولم في 14 يوليو سنة 1967،"@ar ;
    dzdoc:extractionMethod "text_pattern_doc_type_number" ;
    dzdoc:isInferred true ;
    dzdoc:sourceSegment <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#preamble_segment_5> .

