<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_45> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "دون الإخلال بأحكام الفقرة الأخيرة من هذه المادة، يمكن المصلحة المختصة أن تسحب الرخصة الإجبارية بطلب من صاحب براءة الاختراع في الحالات الآتية : (1) إذا زالت الشروط التي بررت منح الرخصة الإجبارية ، (2) إذا تبين أن الشروط المحددة لم تعد متوفرة في المستفيد من الرخصة الإجبارية . لا تسحب المصلحة المختصة الرخصة الإجبارية إذا اقتنعت بوجود ظروف تبرر الإبقاء عليها وخصوصا في الحالة المذكورة في النقطة (1) أعلاه، إذا كان المستفيد من الرخصة يستغل الاختراع المحمي بالبراءة صناعيا أو قام بتحضيرات جادة من أجل ذلك"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_45_20030719_OpEnact_2f1209f397> ;
    dzdoc:replacementText "دون الإخلال بأحكام الفقرة الأخيرة من هذه المادة، يمكن المصلحة المختصة أن تسحب الرخصة الإجبارية بطلب من صاحب براءة الاختراع في الحالات الآتية : (1) إذا زالت الشروط التي بررت منح الرخصة الإجبارية ، (2) إذا تبين أن الشروط المحددة لم تعد متوفرة في المستفيد من الرخصة الإجبارية . لا تسحب المصلحة المختصة الرخصة الإجبارية إذا اقتنعت بوجود ظروف تبرر الإبقاء عليها وخصوصا في الحالة المذكورة في النقطة (1) أعلاه، إذا كان المستفيد من الرخصة يستغل الاختراع المحمي بالبراءة صناعيا أو قام بتحضيرات جادة من أجل ذلك"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_45> ;
    dzdoc:sourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
