<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_26> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "قبل إصدار براءة الاختراع وبعد تسديد الرسوم المحددة ، يجوز للمودع تصحيح الأخطاء المادية المثبتة قانونا في الوثائق المودعة إذا طلب ذلك في حالة عدم تسديد الرسم المطلوب أو عدم القيام بالتعديلات في الأجل المحدد والذي يمكن أن يمدد عند الضرورة المبررة ، فإن البراءة تسلم في حالتها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_26_20030719_OpEnact_42eac28acb> ;
    dzdoc:replacementText "قبل إصدار براءة الاختراع وبعد تسديد الرسوم المحددة ، يجوز للمودع تصحيح الأخطاء المادية المثبتة قانونا في الوثائق المودعة إذا طلب ذلك في حالة عدم تسديد الرسم المطلوب أو عدم القيام بالتعديلات في الأجل المحدد والذي يمكن أن يمدد عند الضرورة المبررة ، فإن البراءة تسلم في حالتها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_26> ;
    dzdoc:sourceDocument <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
