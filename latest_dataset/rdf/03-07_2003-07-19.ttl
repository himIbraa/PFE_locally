<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_56_condition_1_c274bf99> a dznorm:Condition ;
    dznorm:conditionText "بدون موافقة صاحب البراءة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_56> ;
    dznorm:position 1 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_56_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_56> ;
    dzdoc:position 0 ;
    dzdoc:text "مع مراعاة المادتين 12 14 أعلاه ، يعتبر مساسا بالحقوق الناجمة عن براءة الاختراع كل عمل من الأعمال المنصوص عليها في المادة 11 أعلاه يتم بدون موافقة صاحب البراءة."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_56_right_0_bbf22233> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_56> ;
    dznorm:position 0 ;
    dznorm:provisionText "بالحقوق الناجمة عن براءة الاختراع"@ar ;
    dznorm:sourceArticle "art_56" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_58_condition_0_ee10c336> a dznorm:Condition ;
    dznorm:conditionText "وإذا أثبت المدعي ارتكاب أحد الأعمال المذكورة في الفقرة أعلاه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_58> ;
    dznorm:position 0 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_58_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_58> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن صاحب براءة الاختراع أو خلفه رفع دعوى قضائية ضد أي شخص قام أو يقوم بإحدى الأعمال حسب مفهوم المادة 56 أعلاه."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_58_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_58> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا أثبت المدعي ارتكاب أحد الأعمال المذكورة في الفقرة أعلاه، فإن الجهة القضائية المختصة تقضي بمنح التعويضات المدنية و يمكنها الأمر بمنع مواصلة هذه الأعمال واتخاذ أي إجراء آخر منصوص عليه في التشريع الساري المفعول."@ar .

