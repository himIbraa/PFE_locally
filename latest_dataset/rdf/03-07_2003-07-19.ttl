<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59_obligation_0_862986e3> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59_obligation_0_862986e3_role_8b4919d7f8> ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59> ;
    dznorm:position 0 ;
    dznorm:provisionText "فعلى الجهة القضائية المختصة أن تأخذ بعين الاعتبار المصالح المشروعة للمدعى عليه عند اعتمادها لأي أدلة تطلبها، وذلك بعدم الفصح عن أسراره الصناعية والتجارية"@ar ;
    dznorm:sourceArticle "art_59" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59_obligation_0_862986e3_role_8b4919d7f8> a dznorm:Role ;
    rdfs:label "الجهة القضائية المختصة أن"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "فعلى الجهة القضائية المختصة أن تأخذ بعين الاعتبار المصالح المشروعة للمدعى عليه عند اعتمادها لأي أدلة تطلبها، وذلك بعدم الفصح عن أسراره الصناعية والتجارية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59> .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59> ;
    dzdoc:position 0 ;
    dzdoc:text "بغض النظر عن أحكام الفقرة 2 من المادة 58 أعلاه، و حتى إثبات العكس، يعتبر كل منتوج مطابق صنع بدون رضا صاحب البراءة منتوجا حصل عليه بالطريقة التي تشملها البراءة و ذلك على الأقل في إحدى الحالتين الآتيتين : عندما يكون موضوع البراءة طريقة تتعلق بالحصول على منتوج جديد، عندما يوجد احتمال كبير بأن المنتوج المطابق حصل عليه بالطريقة التي تشملها البراءة وأن صاحب البراءة لم يستطع برغم الجهود المبذولة، شرح الطريقة المستعملة."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي هذه الحالة، يمكن الجهة القضائية المختصة أن تأمر المدعى عليه بتقديم الأدلة التي تثبت أن الطريقة المستعملة للحصول على منتوج مطابق تختلف عن الطريقة التي تشملها البراءة."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_59> ;
    dzdoc:position 2 ;
    dzdoc:text "فعلى الجهة القضائية المختصة أن تأخذ بعين الاعتبار المصالح المشروعة للمدعى عليه عند اعتمادها لأي أدلة تطلبها، وذلك بعدم الفصح عن أسراره الصناعية والتجارية."@ar .

