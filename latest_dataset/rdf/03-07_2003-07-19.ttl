dzterm:order a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الأمر"@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_2_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_2> ;
    dzdoc:position 0 ;
    dzdoc:text "يقصد في مفهوم هذا الأمر بما يأتي: الاختراع : فكرة لمخترع ، تسمح عمليا بإيجاد حل لمشكل محدد في مجال التقنية، البراءة أو براءة الاختراع : وثيقة تسلم لحماية اختراع، المصلحة المختصة : المعهد الوطني الجزائري للملكية الصناعية،"@ar .

