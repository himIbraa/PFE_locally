<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_1> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "يهدف هذا الأمر إلى تحديد شروط حماية الاختراعات ، كما يحدد وسائل هذه الحماية وآثارها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_1_20030719_OpEnact_7d11e63e3f> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة الأولى" ;
    dzdoc:position 0 ;
    dzdoc:usesTerm dzterm:inventions,
        dzterm:order .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_41> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_5_subsec_2> ;
    dzdoc:eId "art_41" ;
    dzdoc:fullText "تمنح الرخصة الإجبارية مقابل تعويض مناسب، و حسب الحالة، فإنه يراعى القيمة الاقتصادية لها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_41> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_41_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_41_20030719_OpEnact_195dc927c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "41" ;
    dzdoc:position 37 ;
    dzdoc:usesTerm dzterm:compulsory_license .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_5_subsec_2> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "تطبق المواد من 43 إلى 46 و 48 مع ما يلزم من تغيير على الرخصة الإجبارية للمنفعة العامة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_50> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_50_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_50_20030719_OpEnact_e5be002e47> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "50" ;
    dzdoc:position 46 ;
    dzdoc:references <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_43>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_46>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_48> ;
    dzdoc:referencesInternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_43>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_46>,
        <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_48> ;
    dzdoc:usesTerm dzterm:public_interest_license .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_63> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#chp_8> ;
    dzdoc:eId "art_63" ;
    dzdoc:fullText "تبقى البراءات الصادرة بموجب المرسوم التشريعي رقم 93-17 المؤرخ في 23 جمادى الثانية عام 1414 الموافق 7 ديسمبر سنة 1993 والمتعلق بـ حماية الاختراعات وكذا شهادات الإضافة المتعلقة بها، خاضعة لأحكام نفس المرسوم التشريعي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_63> ;
    dzdoc:hasParagraph <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_63_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_63_20030719_OpEnact_49f40aed5d> ;
    dzdoc:introducedBy <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:introducedOn "2003-07-19"^^xsd:date ;
    dzdoc:number "المادة 63" ;
    dzdoc:position 58 ;
    dzdoc:referencesExternal <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_63_extref_b9ab7ebd> ;
    dzdoc:usesTerm dzterm:addition_certificates,
        dzterm:patents,
        dzterm:protection_of_inventions .

