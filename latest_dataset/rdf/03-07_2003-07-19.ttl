<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_11_right_0_8f4e431b> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_11> ;
    dznorm:position 0 ;
    dznorm:provisionText "الحقوق الاستئثارية"@ar ;
    dznorm:sourceArticle "art_11" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_11_right_1_5882ea9d> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_11> ;
    dznorm:position 1 ;
    dznorm:provisionText "لصاحب البراءة الحق كذلك في التنازل عنها أو في تحويلها عن طريق الإرث و إبرام عقود تراخيص"@ar ;
    dznorm:sourceArticle "art_11" .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_12_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_12> ;
    dzdoc:position 0 ;
    dzdoc:text "لا تشمل الحقوق الواردة عن براءة الاختراع إلا الأعمال ذات الأغراض الصناعية أو التجارية ."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_12_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_12> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا تشمل هذه الحقوق ما يأتي: الأعمال المؤداة لأغراض البحث العلمي فقط، الأعمال التي تخص المنتوج الذي تشمله البراءة و ذلك بعد رض هذا المنتوج في السوق شرعا، استعمال وسائل محمية ببراءة على متن البواخر والسفن الفضائية أو أجهزة النقل الجوية أو البرية الأجنبية التي تدخل المياه الإقليمية أو المجال الجوي أو التراب الوطني دخولا مؤقتا أو اضطراريا."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_14_condition_0_cd7c8b17> a dznorm:Condition ;
    dznorm:conditionText "عند تاريخ إيداع طلب براءة الاختراع أو تاريخ الأولوية المطالب به قانونا إذا قام أحد عن حسن نية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_14> ;
    dznorm:position 0 .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_14_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_14> ;
    dzdoc:position 0 ;
    dzdoc:text "عند تاريخ إيداع طلب براءة الاختراع أو تاريخ الأولوية المطالب به قانونا إذا قام أحد عن حسن نية : بصنع المنتوج أو استعمال طريقة الصنع موضوع الاختراع المحمي بالبراءة، بتحضيرات جادة لمباشرة هذا الصنع أو هذا الاستعمال، يحق له الاستمرار في مباشرة عمله على الرغم من وجود براءة الاختراع المذكورة."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_14_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_14> ;
    dzdoc:position 1 ;
    dzdoc:text "إن حق المستخدم السابق لا يمكن تحويله أو نقله إلا مع المؤسسة أو الشركة أو الفروع التابعة لهما واللتين حدث فيهما الاستخدام أو التحضير للاستخدام."@ar .

<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_14_permission_0_8179cec6> a dznorm:Permission ;
