<https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_52> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/presidential-decree/2003-07-19/03-07> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تم قيد إحدى الرخص المذكورة في الفصلين الثاني والثالث من الباب الخامس أعلاه في سجل البراءات ، فـ التخلي عن براءة الاختراع لا يقيد إلا بعد تقديم الحاصل على الرخصة تصريحا يقبل فيه هذا التخلي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#version_art_52_20030719_OpEnact_ec890febfd> ;
    dzdoc:replacementText "إذا تم قيد إحدى الرخص المذكورة في الفصلين الثاني والثالث من الباب الخامس أعلاه في سجل البراءات ، فـ التخلي عن براءة الاختراع لا يقيد إلا بعد تقديم الحاصل على الرخصة تصريحا يقبل فيه هذا التخلي ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/presidential-decree/2003-07-19/03-07#art_52> ;
