    dznorm:sourceArticle "art_91" .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_92_extref_3f285270> a dzdoc:ExternalReference ;
    rdfs:label "الدستور"@ar ;
    dzdoc:frbrUri "/akn/dz/act/constitution/2020-12-30/1#"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/constitution/2020-12-30/1"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/constitution/2020-12-30/1#" ;
    dzdoc:referencesTarget <https://legal.dz/resource/constitution/2020-12-30/1> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/constitution/2020-12-30/1"^^xsd:anyURI .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_92_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_92> ;
    dzdoc:position 0 ;
    dzdoc:text "يعين رئيس الجمهورية، لاسيما في الوظائف والمهام الآتية : الوظائف والمهام المنصوص عليها في الدستور، الوظائف المدنية والعسكرية في الدولة، التعيينات التي تتم في مجلس الوزراء باقتراح من الوزير الأول أو رئيس الحكومة، حسب الحالة، الرئيس الأول للمحكمة العليا، رئيس مجلس الدولة، الأمين العام للحكومة محافظ بنك الجزائر، القضاة، مسؤولى أجهزة الأمن الولاة، الأعضاء المسيرين لسلطات الضبط."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_92_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_92> ;
    dzdoc:position 1 ;
    dzdoc:text "ويعين رئيس الجمهورية سفراء الجمهورية والمبعوثين فوق العادة إلى الخارج، وينهى مهامهم."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_92_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_92> ;
    dzdoc:position 2 ;
    dzdoc:text "ويتسلم أوراق اعتماد الممثلين الدبلوماسيين الأجانب وأوراق إنهاء مهامهم."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_92_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_92> ;
    dzdoc:position 3 ;
    dzdoc:text "بالإضافة إلى الوظائف المنصوص عليها في الحالتين 4 و 5 أعلاه، يحدد قانون عضوي الوظائف القضائية الأخرى التي يعين فيها رئيس الجمهورية."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_93_extref_3f285270> a dzdoc:ExternalReference ;
