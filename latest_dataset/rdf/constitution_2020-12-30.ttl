<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_114> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمارس السلطة التشريعية برلمان يتكون من غرفتين، وهما المجلس الشعبي الوطني و مجلس الأمة . كل غرفة من غرفتي البرلمان لها السيادة في إعداد القانون والتصويت عليه ."@ar ;
    dzdoc:isAuthoritative true ;
