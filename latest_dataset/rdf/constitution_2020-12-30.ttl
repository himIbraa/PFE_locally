<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_193> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تخطر المحكمة الدستورية من رئيس الجمهورية أو رئيس مجلس الأمة أو رئيس المجلس الشعبي الوطني أو من الوزير الأول أو رئيس الحكومة، حسب الحالة. يمكن إخطارها كذلك من أربعين (40) نائبا أو خمسة وعشرين (25) عضوا في مجلس الأمة. لا تمتد ممارسة الإخطار المبين في الفقرتين الأولى والثانية إلى الإخطار بالدفع بعدم الدستورية المبين في المادة 195 أدناه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_193_20201230_OpEnact_a70c5a0c5d> ;
    dzdoc:replacementText "تخطر المحكمة الدستورية من رئيس الجمهورية أو رئيس مجلس الأمة أو رئيس المجلس الشعبي الوطني أو من الوزير الأول أو رئيس الحكومة، حسب الحالة. يمكن إخطارها كذلك من أربعين (40) نائبا أو خمسة وعشرين (25) عضوا في مجلس الأمة. لا تمتد ممارسة الإخطار المبين في الفقرتين الأولى والثانية إلى الإخطار بالدفع بعدم الدستورية المبين في المادة 195 أدناه."@ar ;
