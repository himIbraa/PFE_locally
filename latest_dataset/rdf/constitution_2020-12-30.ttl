<https://legal.dz/resource/constitution/2020-12-30/2020#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_3> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "الدولة مسؤولة عن أمن الأشخاص والممتلكات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_28_20201230_OpEnact_ff22726058> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_28_obligation_0_d71a2dbc> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 28" ;
    dzdoc:position 27 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_32> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_3> ;
    dzdoc:eId "art_32" ;
    dzdoc:fullText "الجزائر متضامنة مع جميع الشعوب التي تكافح من أجل التحرر السياسي والاقتصادي، و الحق في تقرير المصير ، وضد كل تمييز عنصري."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_32_right_0_804d9170> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_32> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_32_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_32_20201230_OpEnact_f3e96c20ec> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 32" ;
    dzdoc:position 31 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "تحمي الدولة المرأة من كل أشكال العنف في كل الأماكن والظروف، في الفضاء العمومي و في المجالين المهني والخاص . ويضمن القانون استفادة الضحايا من هياكل الاستقبال ومن أنظمة التكفل ، و من مساعدة قضائية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_40_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_40_20201230_OpEnact_11483f0d5c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_40_obligation_0_452e9be9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "40" ;
    dzdoc:position 39 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_61> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_61" ;
    dzdoc:fullText "حرية التجارة والاستثمار والمقاولة مضمونة ، وتمارس في إطار القانون"@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_61_right_0_dcd7ae92> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_61> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_61_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_61_20201230_OpEnact_85741b62ef> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 61" ;
    dzdoc:position 60 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_90> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_1> ;
    dzdoc:eId "art_90" ;
    dzdoc:fullText "يؤدي رئيس الجمهورية اليمين حسب النص الآتي : \"بسم الله الرحمن الرحيم وفاء للتضحيات الكبرى، ولأرواح شهدائنا الأبرار، وقيم ثورة نوفمبر الخالدة، أقسم بالله العلي العظيم، أن أحترم الدين الإسلامي وأمجده، وأدافع عن الدستور، وأسهر على استمرارية الدولة، وأعمل على توفير الشروط اللازمة للسير العادي للمؤسسات والنظام الدستوري، وأسعى من أجل تدعيم المسار الديمقراطي، وأحترم حرية اختيار الشعب، ومؤسسات الجمهورية وقوانينها، وأحافظ على الممتلكات والمال العام، وأحافظ على سلامة ووحدة التراب الوطني، ووحدة الشعب والأمة، وأحمي الحريات والحقوق الأساسية للإنسان والمواطن، وأعمل بدون هوادة من أجل تطور الشعب وازدهاره، وأسعى بكل قواي في سبيل تحقيق المثل العليا للعدالة والحرية والسلم في العالم. والله على ما أقول شهيد\"."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_90> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_90_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_90_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_90_20201230_OpEnact_98b59cb8e7> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 90" ;
    dzdoc:position 89 ;
    dzdoc:usesTerm dzterm:president .

