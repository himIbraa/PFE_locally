<https://legal.dz/resource/constitution/2020-12-30/2020#art_97_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_97> ;
    dzdoc:position 2 ;
    dzdoc:text "يحدد قانون عضوي تنظيم حالة الطوارئ وحالة الحصار."@ar .

