<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_144> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تودع مشاريع القوانين المتعلقة بالتنظيم المحلي وتهيئة الإقليم والتقسيم الإقليمي لدى مكتب مجلس الأمة . باستثناء الحالات المبينة في الفقرة أعلاه، تودع كل مشاريع القوانين الأخرى لدى مكتب المجلس الشعبي الوطني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_144_20201230_OpEnact_37501d03e4> ;
    dzdoc:replacementText "تودع مشاريع القوانين المتعلقة بالتنظيم المحلي وتهيئة الإقليم والتقسيم الإقليمي لدى مكتب مجلس الأمة . باستثناء الحالات المبينة في الفقرة أعلاه، تودع كل مشاريع القوانين الأخرى لدى مكتب المجلس الشعبي الوطني ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
