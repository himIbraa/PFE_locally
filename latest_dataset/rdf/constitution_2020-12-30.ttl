<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_178> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل أجهزة الدولة المختصة مطالبة في كل وقت وفي كل مكان، و في جميع الظروف، بالسهر على تنفيذ أحكام القضاء . يعاقب القانون كل من يمس باستقلالية القاضي ، أو يعرقل حسن سير العدالة وتنفيذ قراراتها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_178_20201230_OpEnact_5be6a7d023> ;
    dzdoc:replacementText "كل أجهزة الدولة المختصة مطالبة في كل وقت وفي كل مكان، و في جميع الظروف، بالسهر على تنفيذ أحكام القضاء . يعاقب القانون كل من يمس باستقلالية القاضي ، أو يعرقل حسن سير العدالة وتنفيذ قراراتها."@ar ;
