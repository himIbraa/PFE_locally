<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_158> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أعضاء البرلمان أن يوجهوا أي سؤال شفوي أو كتابي إلى أي عضو في الحكومة . يكون الجواب عن السؤال الكتابي كتابيا خلال أجل أقصاه ثلاثون (30) يوما . بالنسبة للأسئلة الشفوية، يجب ألا يتعدى أجل الجواب ثلاثين (30) يوما . يعقد كل من المجلس الشعبي الوطني و مجلس الأمة ، بالتداول، جلسة أسبوعية تخصص لأجوبة الحكومة على الأسئلة الشفوية للنواب وأعضاء مجلس الأمة . إذا رأت أي من الغرفتين أن جواب عضو الحكومة ، شفويا كان أو كتابيا، يبرر إجراء مناقشة ، تجري المناقشة حسب الشروط التي ينص عليها النظام الداخلي للمجلس"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_158_20201230_OpEnact_f9ec8d41dc> ;
    dzdoc:replacementText "يمكن أعضاء البرلمان أن يوجهوا أي سؤال شفوي أو كتابي إلى أي عضو في الحكومة . يكون الجواب عن السؤال الكتابي كتابيا خلال أجل أقصاه ثلاثون (30) يوما . بالنسبة للأسئلة الشفوية، يجب ألا يتعدى أجل الجواب ثلاثين (30) يوما . يعقد كل من المجلس الشعبي الوطني و مجلس الأمة ، بالتداول، جلسة أسبوعية تخصص لأجوبة الحكومة على الأسئلة الشفوية للنواب وأعضاء مجلس الأمة . إذا رأت أي من الغرفتين أن جواب عضو الحكومة ، شفويا كان أو كتابيا، يبرر إجراء مناقشة ، تجري المناقشة حسب الشروط التي ينص عليها النظام الداخلي للمجلس الشعبي الوطني ومجلس الأمة . تنشر الأسئلة والأجوبة طبقا للشروط التي يخضع لها نشر محاضر مناقشات البرلمان ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_158> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_158> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2020-12-30"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_159> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن كل غرفة من البرلمان ، في إطار اختصاصاتها، أن تنشئ في أي وقت لجان تحقيق في قضايا ذات مصلحة عامة . لا يمكن إنشاء لجنة تحقيق بخصوص وقائع تكون محل إجراء قضائي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_159_20201230_OpEnact_71d062419b> ;
