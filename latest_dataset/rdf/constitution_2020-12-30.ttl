<https://legal.dz/resource/constitution/2020-12-30/2020#art_142> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_142" ;
    dzdoc:fullText "لرئيس الجمهورية أن يشرع بأوامر في مسائل عاجلة في حالة شغور المجلس الشعبي الوطني أو خلال العطلة البرلمانية بعد رأي مجلس الدولة . يخطر رئيس الجمهورية وجوبا المحكمة الدستورية بشأن دستورية هذه الأوامر ، على أن تفصل فيها في أجل أقصاه عشرة (10) أيام. يعرض رئيس الجمهورية الأوامر التي اتخذها على كل غرفة من البرلمان في بداية الدورة القادمة لتوافق عليها . تعد لاغية الأوامر التي لا يوافق عليها البرلمان. يمكن رئيس الجمهورية أن يشرع بأوامر في الحالة الاستثنائية المذكورة في المادة 98 من الدستور . تتخذ الأوامر في مجلس الوزراء."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_142_permission_0_91dd9528> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_142_right_0_15e0183a>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_142_right_1_4f483027> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_142> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_142_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_142_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_142_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_142_para_3>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_142_para_4>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_142_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_142_20201230_OpEnact_1d74b1a715> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_142_obligation_0_a1ed38ba>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_142_obligation_1_bb1bac6c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "142" ;
    dzdoc:position 141 ;
    dzdoc:referencesExternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_142_extref_4ab143b5> ;
