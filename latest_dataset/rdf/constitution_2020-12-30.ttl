<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_221> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا ارتأت المحكمة الدستورية أن مشروع أي تعديل دستوري لا يمس البتة المبادئ العامة التي تحكم المجتمع الجزائري، وحقوق الإنسان والمواطن وحرياتهما، ولا يمس بأي كيفية التوازنات الأساسية للسلطات والمؤسسات الدستورية، وعللت رأيها ، أمكن رئيس الجمهورية أن يصدر القانون الذي يتضمن التعديل الدستوري مباشرة دون أن يعرضه على الاستفتاء الشعبي، متى أحرز ثلاثة أرباع (4/3) أصوات أعضاء غرفتي البرلمان ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_221_20201230_OpEnact_956e193dd3> ;
    dzdoc:replacementText "إذا ارتأت المحكمة الدستورية أن مشروع أي تعديل دستوري لا يمس البتة المبادئ العامة التي تحكم المجتمع الجزائري، وحقوق الإنسان والمواطن وحرياتهما، ولا يمس بأي كيفية التوازنات الأساسية للسلطات والمؤسسات الدستورية، وعللت رأيها ، أمكن رئيس الجمهورية أن يصدر القانون الذي يتضمن التعديل الدستوري مباشرة دون أن يعرضه على الاستفتاء الشعبي، متى أحرز ثلاثة أرباع (4/3) أصوات أعضاء غرفتي البرلمان ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_221> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_221> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2020-12-30"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_222> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن ثلاثة أرباع (4/3) أعضاء غرفتي البرلمان المجتمعين معا، أن يبادروا باقتراح تعديل الدستور على رئيس الجمهورية الذي يمكنه عرضه على الاستفتاء الشعبي. ويصدره في حالة الموافقة عليه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
