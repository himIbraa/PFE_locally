    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_215_20201230_OpEnact_d6e8dc2bc4> ;
    dzdoc:replacementText "يقدم المجلس الأعلى للشباب آراء وتوصيات حول المسائل المتعلقة بحاجات الشباب وازدهاره في المجالات الاقتصادية والاجتماعية والثقافية والرياضية يساهم المجلس الأعلى للشباب في ترقية القيم الوطنية والضمير الوطني والحس المدني والتضامن الاجتماعي في أوساط الشباب."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_215> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/2020-12-30/2020> ;
