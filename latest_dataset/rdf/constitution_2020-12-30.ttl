<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "السلطة التأسيسية ملك للشعب . يمارس الشعب سيادته بواسطة المؤسسات الدستورية التي يختارها. يمارس الشعب هذه السيادة أيضا عن طريق الاستفتاء وبواسطة ممثليه المنتخبين. لـ رئيس الجمهورية أن يلتجئ إلى إرادة الشعب مباشرة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_8_20201230_OpEnact_7369f18663> ;
