<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_179> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تمثل المحكمة العليا الهيئة المقومة لأعمال المجالس القضائية والمحاكم. يمثل مجلس الدولة الهيئة المقومة لأعمال المحاكم الإدارية للاستئناف والمحاكم الإدارية والجهات الأخرى الفاصلة في المواد الإدارية. تضمن المحكمة العليا و مجلس الدولة توحيد الاجتهاد القضائي في جميع أنحاء البلاد، ويسهران على احترام القانون. تفصل محكمة التنازع في حالات تنازع الاختصاص بين هيئات القضاء العادي وهيئات القضاء الإداري. يحدد قانون عضوي تنظيم المحكمة العليا و مجلس الدولة و محكمة التنازع ، وسيرها واختصاصاتها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_179_20201230_OpEnact_278fe79848> ;
    dzdoc:replacementText "تمثل المحكمة العليا الهيئة المقومة لأعمال المجالس القضائية والمحاكم. يمثل مجلس الدولة الهيئة المقومة لأعمال المحاكم الإدارية للاستئناف والمحاكم الإدارية والجهات الأخرى الفاصلة في المواد الإدارية. تضمن المحكمة العليا و مجلس الدولة توحيد الاجتهاد القضائي في جميع أنحاء البلاد، ويسهران على احترام القانون. تفصل محكمة التنازع في حالات تنازع الاختصاص بين هيئات القضاء العادي وهيئات القضاء الإداري. يحدد قانون عضوي تنظيم المحكمة العليا و مجلس الدولة و محكمة التنازع ، وسيرها واختصاصاتها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_179> ;
