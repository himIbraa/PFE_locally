<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_194> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتداول المحكمة الدستورية فى جلسة مغلقة، وتصدر قرارها في ظرف ثلاثين (30) يوما من تاريخ إخطارها. وفي حال وجود طارئ، وبطلب من رئيس الجمهورية، يخفض هذا الأجل إلى عشرة (10) أيام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_194_20201230_OpEnact_166db86e0e> ;
