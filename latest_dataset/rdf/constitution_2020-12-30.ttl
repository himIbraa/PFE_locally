<https://legal.dz/resource/constitution/2020-12-30/2020#art_199_defocc_80c13aec0935> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 13 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:court_of_accounts ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_199> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_199_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "مجلس المحاسبة مؤسسة عليا مستقلة للرقابة على الممتلكات والأموال العمومية. يكلف بالرقابة البعدية على أموال الدولة والجماعات المحلية والمرافق العمومية، وكذلك رؤوس الأموال التجارية التابعة للدولة."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_199_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_199> ;
    dzdoc:position 0 ;
    dzdoc:text "مجلس المحاسبة مؤسسة عليا مستقلة للرقابة على الممتلكات والأموال العمومية. يكلف بالرقابة البعدية على أموال الدولة والجماعات المحلية والمرافق العمومية، وكذلك رؤوس الأموال التجارية التابعة للدولة."@ar .

