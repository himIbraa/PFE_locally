<https://legal.dz/resource/constitution/2020-12-30/2020#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_1> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "الجزائر جمهورية ديمقراطية شعبية، وهي وحدة لا تتجزا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_1_20201230_OpEnact_b36444e0cd> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "الأولى" ;
    dzdoc:position 0 ;
    dzdoc:usesTerm dzterm:algeria .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_112> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_2> ;
    dzdoc:eId "art_112" ;
    dzdoc:fullText "يمارس الوزير الأول أو رئيس الحكومة ، حسب الحالة زيادة على السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور، الصلاحيات الآتية : يوجه وينسق ويراقب عمل الحكومة، يوزع الصلاحيات بين أعضاء الحكومة مع احترام الأحكام الدستورية، يقوم بتطبيق القوانين والتنظيمات، يرأس اجتماعات الحكومة، يوقع المراسيم التنفيذية، يعين في الوظائف المدنية للدولة التي لا تندرج ضمن سلطة التعيين لرئيس الجمهورية أو تلك التي يفوضها له هذا الأخير، يسهر على حسن سير الإدارة العمومية والمرافق العمومية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_112> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_112_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_112_20201230_OpEnact_7901467f33> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 112" ;
    dzdoc:position 111 ;
    dzdoc:usesTerm dzterm:head_of_government,
        dzterm:prime_minister .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_117> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_117" ;
    dzdoc:fullText "يبقى البرلمان في إطار اختصاصاته الدستورية، وفيا لثقة الشعب وتطلعاته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_117> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_117_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_117_20201230_OpEnact_67d914582e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 117" ;
    dzdoc:position 116 ;
    dzdoc:usesTerm dzterm:parliament .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_124> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_124" ;
    dzdoc:fullText "إثبات عضوية النواب وأعضاء مجلس الأمة من اختصاص كل غرفة على حدة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_124> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_124_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_124_20201230_OpEnact_0668b3e71a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
