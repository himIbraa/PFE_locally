        <https://legal.dz/resource/constitution/2020-12-30/2020#art_66_para_3>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_66_para_4>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_66_para_5>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_66_para_6>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_66_para_7> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_66_20201230_OpEnact_aee5ebf831> ;
