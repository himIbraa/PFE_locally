<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_44> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يتابع أحد، ولا يوقف أو يحتجز ، إلا ضمن الشروط المحددة بالقانون، وطبقا للأشكال التي نص عليها . يتعين إعلام كل شخص موقوف بأسباب توقيفه . الحبس المؤقت إجراء استثنائي، يحدد القانون أسبابه ومدته وشروط تمديده. يعاقب القانون على أعمال وأفعال الاعتقال التعسفي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_44_20201230_OpEnact_4d90bed75a> ;
    dzdoc:replacementText "لا يتابع أحد، ولا يوقف أو يحتجز ، إلا ضمن الشروط المحددة بالقانون، وطبقا للأشكال التي نص عليها . يتعين إعلام كل شخص موقوف بأسباب توقيفه . الحبس المؤقت إجراء استثنائي، يحدد القانون أسبابه ومدته وشروط تمديده. يعاقب القانون على أعمال وأفعال الاعتقال التعسفي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_44> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_44> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2020-12-30"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_45> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخضع التوقيف للنظر في مجال التحريات الجزائية للرقابة القضائية ، و لا يمكن أن يتجاوز مدة ثمان وأربعين (48) ساعة . يملك الشخص الذي يوقف للنظر حق الاتصال فورا بأسرته . يجب إعلام الشخص الذي يوقف للنظر بحقه أيضا في الاتصال بمحاميه ، ويمكن القاضي أن يحد من ممارسة هذا الحق في إطار ظروف استثنائية ينص عليها القانون. لا يمكن تمديد مدة التوقيف للنظر، إلا استثناء، ووفقا للشروط المحددة بالقانون. عند انتهاء مدة التوقيف للنظر ، يجب أن يجرى فحص طبي على الشخص الموقوف، إن طلب ذلك ، على أن يعلم بهذه الإمكانية، في "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_45_20201230_OpEnact_25c003a192> ;
    dzdoc:replacementText "يخضع التوقيف للنظر في مجال التحريات الجزائية للرقابة القضائية ، و لا يمكن أن يتجاوز مدة ثمان وأربعين (48) ساعة . يملك الشخص الذي يوقف للنظر حق الاتصال فورا بأسرته . يجب إعلام الشخص الذي يوقف للنظر بحقه أيضا في الاتصال بمحاميه ، ويمكن القاضي أن يحد من ممارسة هذا الحق في إطار ظروف استثنائية ينص عليها القانون. لا يمكن تمديد مدة التوقيف للنظر، إلا استثناء، ووفقا للشروط المحددة بالقانون. عند انتهاء مدة التوقيف للنظر ، يجب أن يجرى فحص طبي على الشخص الموقوف، إن طلب ذلك ، على أن يعلم بهذه الإمكانية، في كل الحالات. يخضع القصر إجباريا لفحص طبي . يحدد القانون كيفيات تطبيق هذه المادة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
