<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_153> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يصادق رئيس الجمهورية على اتفاقيات الهدنة ، ومعاهدات السلم، والتحالف والاتحاد، والمعاهدات المتعلقة بحدود الدولة والمعاهدات المتعلقة بقانون الأشخاص، والمعاهدات التي تترتب عليها نفقات غير واردة في ميزانية الدولة، والاتفاقات الثنائية أو المتعددة الأطراف المتعلقة بمناطق التبادل الحر والشراكة وبالتكامل الاقتصادي ، بعد أن توافق عليها كل غرفة من البرلمان صراحة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_153_20201230_OpEnact_6fa063b874> ;
    dzdoc:replacementText "يصادق رئيس الجمهورية على اتفاقيات الهدنة ، ومعاهدات السلم، والتحالف والاتحاد، والمعاهدات المتعلقة بحدود الدولة والمعاهدات المتعلقة بقانون الأشخاص، والمعاهدات التي تترتب عليها نفقات غير واردة في ميزانية الدولة، والاتفاقات الثنائية أو المتعددة الأطراف المتعلقة بمناطق التبادل الحر والشراكة وبالتكامل الاقتصادي ، بعد أن توافق عليها كل غرفة من البرلمان صراحة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
