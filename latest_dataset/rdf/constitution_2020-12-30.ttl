        <https://legal.dz/resource/constitution/2020-12-30/2020#art_162> ;
    dzdoc:heading "المتساوية الأعضاء أو ، إذا تعذر ذلك، بالنص الأخير الذي صوت عليه."@ar ;
    dzdoc:number "نهائيا. وفي هذه الحالة، يأخذ المجلس الشعبي الوطني بالنص الذي أعدته اللجنة" ;
    dzdoc:position 3 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_161> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_نهائيا_وفي_هذه_الحالة_يأخذ_المجلس_الشعبي_الوطني_بالنص_الذي_أعدته_اللجنة> ;
    dzdoc:eId "art_161" ;
    dzdoc:fullText "يمكن المجلس الشعبي الوطني لدى مناقشته بيان السياسة العامة أو على إثر استجواب، أن يصوت على ملتمس رقابة ينصب على مسؤولية الحكومة . لا يقبل هذا الملتمس إلا إذا وقعه سبع (7/1) عدد النواب، على الأقل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_161_permission_0_0a3210bb> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_161_right_0_32248af6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_161> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_161_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_161_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_161_20201230_OpEnact_9f464a71c4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 161" ;
    dzdoc:position 160 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_161_condition_0_705e510f> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:government .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_190> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_1> ;
    dzdoc:eId "art_190" ;
    dzdoc:fullText "بالإضافة إلى الاختصاصات التي خولتها إياها صراحة أحكام أخرى في الدستور، تفصل المحكمة الدستورية بقرار في دستورية المعاهدات والقوانين والتنظيمات. يمكن إخطار المحكمة الدستورية بشأن دستورية المعاهدات قبل التصديق عليها، والقوانين قبل إصدارها. يمكن إخطار المحكمة الدستورية بشأن دستورية التنظيمات خلال شهر من تاريخ نشرها. تفصل المحكمة الدستورية بقرار حول توافق القوانين والتنظيمات مع المعاهدات، ضمن الشروط المحددة، على التوالي، في الفقرتين 2 و 3 أعلاه . يخطر رئيس الجمهورية المحكمة الدستورية وجوبا ، حول مطابقة القوانين العضوية للدستور بعد أن يصادق عليها البرلمان. وتفصل المحكمة الدستورية بقرار بشأن النص كله. تفصل المحكمة الدستورية في مطابقة النظام الداخلي لكل من غرفتي البرلمان للدستور، حسب الإجراءات المذكورة في الفقرة السابقة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_190_permission_0_a59d426a>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_190_permission_1_57592548> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_190> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_190_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_190_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_190_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_190_para_3>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_190_para_4>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_190_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_190_20201230_OpEnact_482daf8a73> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_190_obligation_0_5d2756bb> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "190" ;
    dzdoc:position 189 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_190_condition_0_34aee5c9> ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_199> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:definesTerm dzterm:court_of_accounts ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_2> ;
    dzdoc:eId "art_199" ;
    dzdoc:fullText "مجلس المحاسبة مؤسسة عليا مستقلة للرقابة على الممتلكات والأموال العمومية. يكلف بالرقابة البعدية على أموال الدولة والجماعات المحلية والمرافق العمومية، وكذلك رؤوس الأموال التجارية التابعة للدولة . يساهم مجلس المحاسبة في ترقية الحكم الراشد والشفافية في تسيير الأموال العمومية وإيداع الحسابات . يعين رئيس الجمهورية رئيس مجلس المحاسبة لعهدة مدتها خمس (5) سنوات قابلة للتجديد مرة واحدة يعد مجلس المحاسبة تقريرا سنويا يرفعه إلى رئيس الجمهورية . ويتولى رئيس المجلس نشره . يحدد قانون عضوي تنظيم مجلس المحاسبة وعمله واختصاصاته والجزاءات المترتبة عن تحرياته، والقانون الأساسي لأعضائه . كما يحدد علاقاته بالهياكل الأخرى في الدولة المكلفة بالرقابة والتفتيش ومكافحة الفساد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_199> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-12-30/2020#art_199_defocc_80c13aec0935> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_199_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_199_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_199_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_199_para_3>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_199_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_199_20201230_OpEnact_ca9cc24503> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_199_obligation_0_d04ef1b1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_199_obligation_1_3e9c3bef>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_199_obligation_2_e69c3b2e>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_199_obligation_3_519b62a4>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_199_obligation_4_fb13993b>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_199_obligation_5_1f80a0fc>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_199_obligation_6_67d89c92> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "199" ;
    dzdoc:position 198 ;
    dzdoc:usesTerm dzterm:court_of_accounts,
        dzterm:organic_law,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_222> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_6> ;
    dzdoc:eId "art_222" ;
    dzdoc:fullText "يمكن ثلاثة أرباع (4/3) أعضاء غرفتي البرلمان المجتمعين معا، أن يبادروا باقتراح تعديل الدستور على رئيس الجمهورية الذي يمكنه عرضه على الاستفتاء الشعبي. ويصدره في حالة الموافقة عليه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_222_permission_0_275c9a83> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_222_right_0_29bac69f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_222> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_222_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_222_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_222_20201230_OpEnact_6941408eac> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 222" ;
    dzdoc:position 221 ;
    dzdoc:usesTerm dzterm:parliament,
        dzterm:president .

dzterm:parliament a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "البرلمان"@ar,
