    dzdoc:position 23 ;
    dzdoc:usesTerm dzterm:public_agent .

dzterm:constitutional_court a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المحكمة الدستورية"@ar,
        "المحكمة الدستورية مؤسسة مستقلة مكلفة بضمان احترام الدستور"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-12-30/2020#art_185_defocc_b20d87b514cb> .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_45" ;
    dzdoc:fullText "يخضع التوقيف للنظر في مجال التحريات الجزائية للرقابة القضائية ، و لا يمكن أن يتجاوز مدة ثمان وأربعين (48) ساعة . يملك الشخص الذي يوقف للنظر حق الاتصال فورا بأسرته . يجب إعلام الشخص الذي يوقف للنظر بحقه أيضا في الاتصال بمحاميه ، ويمكن القاضي أن يحد من ممارسة هذا الحق في إطار ظروف استثنائية ينص عليها القانون. لا يمكن تمديد مدة التوقيف للنظر، إلا استثناء، ووفقا للشروط المحددة بالقانون. عند انتهاء مدة التوقيف للنظر ، يجب أن يجرى فحص طبي على الشخص الموقوف، إن طلب ذلك ، على أن يعلم بهذه الإمكانية، في كل الحالات. يخضع القصر إجباريا لفحص طبي . يحدد القانون كيفيات تطبيق هذه المادة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_45_permission_0_998c2a8c>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_45_permission_1_d0da6f55> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_45_right_0_13ecfb8b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_45> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_45_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_45_para_1>,
