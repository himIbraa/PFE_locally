    dzdoc:position 1 ;
    dzdoc:text "ينتخب المجلس الشعبي الوطني مكتبه ويشكل لجانه."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_133_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_133> ;
    dzdoc:position 2 ;
    dzdoc:text "تطبق الأحكام السابقة الذكر على مجلس الأمة."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_134_condition_0_ead24160> a dznorm:Condition ;
