    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:versionText "يحمي القضاء المجتمع وحريات وحقوق المواطنين طبقا للدستور."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_165_20201230_OpEnact_3b8baf65a2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
