<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_209> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المجلس الوطني الاقتصادي والاجتماعي والبيئي ، إطار للحوار والتشاور والاقتراح والاستشراف والتحليل في المجالات الاقتصادية والاجتماعية والبيئية، يوضع لدى رئيس الجمهورية . وهو كذلك مستشار الحكومة"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_209_20201230_OpEnact_89a843f8f5> ;
