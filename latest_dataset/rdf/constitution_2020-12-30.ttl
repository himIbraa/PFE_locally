<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_141> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمارس رئيس الجمهورية السلطة التنظيمية في المسائل غير المخصصة للقانون. يندرج تطبيق القوانين في المجال التنظيمي الذي يعود لـ الوزير الأول أو لـ رئيس الحكومة ، حسب الحالة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
