<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_126> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل نائب أو عضو مجلس الأمة لا يستوفي شروط قابلية انتخابه أو يفقدها ، يتعرض لسقوط عهدته البرلمانية. يقرر المجلس الشعبي الوطني أو مجلس الأمة ، حسب الحالة، هذا السقوط بأغلبية أعضائه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_126_20201230_OpEnact_dac4472211> ;
    dzdoc:replacementText "كل نائب أو عضو مجلس الأمة لا يستوفي شروط قابلية انتخابه أو يفقدها ، يتعرض لسقوط عهدته البرلمانية. يقرر المجلس الشعبي الوطني أو مجلس الأمة ، حسب الحالة، هذا السقوط بأغلبية أعضائه."@ar ;
