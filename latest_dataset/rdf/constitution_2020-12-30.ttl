    dzdoc:usesTerm dzterm:observatory .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_52" ;
    dzdoc:fullText "حرية التعبير مضمونة . حرية الاجتماع وحرية التظاهر السلمي مضمونتان ، وتمارسان بمجرد التصريح بهما. يحدد القانون شروط وكيفيات ممارستها"@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_52_right_0_384f0c39>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_52_right_1_e5ff75b9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_52_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_52_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_52_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_52_20201230_OpEnact_23edbaea59> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "52" ;
    dzdoc:position 51 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "حق إنشاء الجمعيات مضمون ، ويمارس بمجرد التصريح به. تشجع الدولة الجمعيات ذات المنفعة العامة. يحدد قانون عضوي شروط وكيفيات إنشاء الجمعيات. لا تحل الجمعيات إلا بمقتضى قرار قضائي."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_53_right_0_e925bf61> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_53_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_53_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_53_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_53_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_53_20201230_OpEnact_b75a723cb8> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "53" ;
    dzdoc:position 52 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "تعمل الدولة على ترقية الحقوق السياسية للمرأة بتوسيع حظوظ تمثيلها في المجالس المنتخبة . يحدد قانون عضوي شروط تطبيق هذا الحكم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_59_right_0_731fdc6d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_59_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_59_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_59_20201230_OpEnact_14cd02a294> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_59_obligation_0_882f5011> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 59" ;
    dzdoc:position 58 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "الحق النقابي مضمون ، ويمارس بكل حرية في إطار القانون. يمكن لمتعاملي القطاع الاقتصادي أن ينتظموا ضمن منظمات أرباب العمل في إطار احترام القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_69_permission_0_5d4b4267> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_69_right_0_2c8680aa> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_69_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_69_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_69_20201230_OpEnact_b095e9976b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 69" ;
    dzdoc:position 68 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "تعمل الدولة على ضمان إدماج الفئات المحرومة ذات الاحتياجات الخاصة الحياة الاجتماعية . يحدد القانون شروط وكيفيات تطبيق هذا الحكم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_72_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_72_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_72_20201230_OpEnact_6220bb9abf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_72_obligation_0_b9c278e4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 72" ;
    dzdoc:position 71 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_72_condition_0_09cf607f> .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_75> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_75" ;
    dzdoc:fullText "الحريات الأكاديمية وحرية البحث العلمي مضمونة تعمل الدولة على ترقية البحث العلمي وتثمينه خدمة للتنمية المستدامة للأمة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_75_right_0_754d851f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_75> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_75_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_75_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_75_20201230_OpEnact_d268662969> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_75_obligation_0_f72dc2b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 75" ;
    dzdoc:position 74 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_الثان> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "يجب على كل مواطن أن يحمي ويصون استقلال البلاد وسيادتها وسلامة ترابها الوطني ووحدة شعبها وجميع رموز الدولة . يعاقب القانون بكل صرامة على الخيانة والتجسس والولاء للعدو، وعلى جميع الجرائم المرتكبة ضد أمن الدولة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_79_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_79_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_79_20201230_OpEnact_7835f88077> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_79_obligation_0_7ca07c71> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "79" ;
    dzdoc:position 78 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_2> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "السلطة التأسيسية ملك للشعب . يمارس الشعب سيادته بواسطة المؤسسات الدستورية التي يختارها. يمارس الشعب هذه السيادة أيضا عن طريق الاستفتاء وبواسطة ممثليه المنتخبين. لـ رئيس الجمهورية أن يلتجئ إلى إرادة الشعب مباشرة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_8_right_0_192c38e0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_8_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_8_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_8_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_8_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_8_20201230_OpEnact_7369f18663> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "8" ;
    dzdoc:position 7 ;
    dzdoc:usesTerm dzterm:constituent_power,
        dzterm:constitutional_institutions,
        dzterm:people,
        dzterm:president,
        dzterm:referendum .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_85> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_1> ;
    dzdoc:eId "art_85" ;
    dzdoc:fullText "ينتخب رئيس الجمهورية عن طريق الاقتراع العام المباشر والسري يتم الفوز في الانتخاب بالحصول على الأغلبية المطلقة من أصوات الناخبين المعبر عنها. يحدد قانون عضوي كيفيات تطبيق أحكام هذه المادة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_85> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_85_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_85_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_85_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_85_20201230_OpEnact_aae0257f20> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 85" ;
    dzdoc:position 84 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-12-30/2020#art_85> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_85> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_107> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_2> ;
    dzdoc:eId "art_107" ;
    dzdoc:fullText "يقدم الوزير الأول استقالة الحكومة لرئيس الجمهورية في حالة عدم موافقة المجلس الشعبي الوطني على مخطط عمل الحكومة . يعين رئيس الجمهورية من جديد وزيرا أول حسب الكيفيات نفسها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_107> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_107_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_107_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_107_20201230_OpEnact_75d5ad7382> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_107_obligation_0_d2ed97d5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "107" ;
    dzdoc:position 106 ;
    dzdoc:usesTerm dzterm:government,
        dzterm:national_peoples_assembly,
        dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_143> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_143" ;
    dzdoc:fullText "لكل من الوزير الأول أو رئيس الحكومة ، حسب الحالة، والنواب وأعضاء مجلس الأمة، حق المبادرة بالقوانين . تعرض مشاريع القوانين على مجلس الوزراء ، بعد رأي مجلس الدولة ، ثم يودعها الوزير الأول أو رئيس الحكومة، حسب الحالة، لدى مكتب المجلس الشعبي الوطني أو مكتب مجلس الأمة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_143_right_0_12ee3bf9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_143> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_143_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_143_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_143_20201230_OpEnact_625972b01e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_143_obligation_0_591a8a03>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_143_obligation_1_36609ac3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "143" ;
    dzdoc:position 142 ;
    dzdoc:usesTerm dzterm:council_of_state,
        dzterm:head_of_government,
        dzterm:prime_minister .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_144> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_144" ;
    dzdoc:fullText "تودع مشاريع القوانين المتعلقة بالتنظيم المحلي وتهيئة الإقليم والتقسيم الإقليمي لدى مكتب مجلس الأمة . باستثناء الحالات المبينة في الفقرة أعلاه، تودع كل مشاريع القوانين الأخرى لدى مكتب المجلس الشعبي الوطني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_144> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_144_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_144_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_144_20201230_OpEnact_37501d03e4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_144_obligation_0_b1fc8b27>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_144_obligation_1_f7e26836> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "144" ;
    dzdoc:position 143 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_165> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_4> ;
    dzdoc:eId "art_165" ;
    dzdoc:fullText "يقوم القضاء على أساس مبادئ الشرعية والمساواة. القضاء متاح للجميع . يضمن القانون التقاضي على درجتين ، ويحدد شروط وإجراءات تطبيقه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_165_right_0_11bee078> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_165> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_165_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_165_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_165_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_165_20201230_OpEnact_3b8baf65a2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_165_obligation_0_afd56090> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 165" ;
    dzdoc:position 164 ;
    dzdoc:usesTerm dzterm:judiciary .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:definesTerm dzterm:local_authorities,
        dzterm:municipality ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_3> ;
    dzdoc:eId "art_17" ;
    dzdoc:fullText "الجماعات المحلية للدولة هي البلدية والولاية البلدية هي الجماعة القاعدية . بغرض تحقيق توازن اقتصادي واجتماعي للبلديات محدودة التنمية، وتكفل أفضل باحتياجات سكانها ، يمكن أن يخص القانون بعض البلديات، الأقل تنمية، بتدابير خاصة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_17_permission_0_ccf2703f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_17> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-12-30/2020#art_17_defocc_0eeb524cb8ec>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_17_defocc_3796d3786d74> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_17_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_17_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_17_20201230_OpEnact_20c8a3d26f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 17" ;
    dzdoc:position 16 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_173> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_4> ;
    dzdoc:eId "art_173" ;
    dzdoc:fullText "يمتنع القاضي عن كل ما يخل بواجبات الاستقلالية والنزاهة . و يلتزم بواجب التحفظ . القاضي مسؤول أمام المجلس الأعلى للقضاء عن كيفية أدائه لمهمته، وفق الأشكال والإجراءات التي يحددها القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_173> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_173_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_173_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_173_20201230_OpEnact_b57ac88c5e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_173_obligation_0_e85e4819>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_173_obligation_1_7e0d557e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 173" ;
    dzdoc:position 172 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_183> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_4> ;
    dzdoc:eId "art_183" ;
    dzdoc:fullText "تختص المحكمة العليا للدولة بالنظر في الأفعال التي يمكن تكييفها خيانة عظمى، والتي يرتكبها رئيس الجمهورية أثناء ممارسة عهدته. تختص المحكمة العليا للدولة بالنظر في الجنايات والجنح التي يرتكبها الوزير الأول ورئيس الحكومة بمناسبة تأدية مهامهما. يحدد قانون عضوي تشكيلة المحكمة العليا للدولة وتنظيمها وسيرها وكذلك الإجراءات المطبقة أمامها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_183_permission_0_6fa732ea> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_183> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_183_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_183_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_183_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_183_20201230_OpEnact_84c789017d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 183" ;
    dzdoc:position 182 ;
    dzdoc:usesTerm dzterm:high_court_of_state,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_192> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_1> ;
    dzdoc:eId "art_192" ;
    dzdoc:fullText "يمكن إخطار المحكمة الدستورية من طرف الجهات المحددة في المادة 193 أدناه ، بشأن الخلافات التي قد تحدث بين السلطات الدستورية. يمكن لهذه الجهات إخطار المحكمة الدستورية حول تفسير حكم أو عدة أحكام دستورية، وتبدي المحكمة الدستورية رأيا بشأنها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_192_permission_0_8342cbb8>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_192_permission_1_3b3a8ddf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_192> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_192_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_192_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_192_20201230_OpEnact_3008a1bc73> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "192" ;
    dzdoc:position 191 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-12-30/2020#art_193> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_193> ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_223> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_6> ;
    dzdoc:eId "art_223" ;
    dzdoc:fullText "لا يمكن أي تعديل دستوري أن يمس : الطابع الجمهوري للدولة، النظام الديمقراطي القائم على التعددية الحزبية الطابع الاجتماعي للدولة، الإسلام باعتباره دين الدولة العربية باعتبارها اللغة الوطنية والرسمية تمازيغت كلغة وطنية ورسمية، الحريات الأساسية وحقوق الإنسان والمواطن سلامة التراب الوطني ووحدته، العلم الوطني والنشيد الوطني باعتبارهما من رموز ثورة نوفمبر 1954 المجيدة والجمهورية والأمة عدم جواز تولي أكثر من عهدتين رئاسيتين متتاليتين أو منفصلتين ومدة كل عهدة خمس (5) سنوات."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_223_permission_0_0d24b4a6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_223> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_223_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_223_20201230_OpEnact_9652006315> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_223_obligation_0_6dd1da71> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 223" ;
    dzdoc:position 222 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_3> ;
    dzdoc:eId "art_29" ;
    dzdoc:fullText "تعمل الدولة على حماية حقوق المواطنين في الخارج ومصالحهم ، في ظل احترام القانون الدولى والاتفاقيات المبرمة مع بلدان الاستقبال أو بلدان الإقامة. تسهر الدولة على الحفاظ على هوية وكرامة المواطنين المقيمين في الخارج وتعزيز روابطهم مع الأمة، وتعبئة مساهمتهم في تنمية بلدهم الأصلي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_29_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_29_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_29_20201230_OpEnact_3da095da19> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_29_obligation_0_3d99a6bc>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_29_obligation_1_07e6dfec> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 29" ;
    dzdoc:position 28 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_39" ;
    dzdoc:fullText "تضمن الدولة عدم انتهاك حرمة الإنسان . يحظر أي عنف بدني أو معنوي، أو أي مساس بالكرامة. يعاقب القانون على التعذيب، وعلى المعاملات القاسية واللاإنسانية أو المهينة، والاتجار بالبشر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_39> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_39_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_39_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_39_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_39_20201230_OpEnact_ed8b6fabe3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_39_obligation_0_6ae6c4df> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/2020-12-30/2020#art_39_prohibition_0_5d893f41> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "39" ;
    dzdoc:position 38 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "لا يتابع أحد، ولا يوقف أو يحتجز ، إلا ضمن الشروط المحددة بالقانون، وطبقا للأشكال التي نص عليها . يتعين إعلام كل شخص موقوف بأسباب توقيفه . الحبس المؤقت إجراء استثنائي، يحدد القانون أسبابه ومدته وشروط تمديده. يعاقب القانون على أعمال وأفعال الاعتقال التعسفي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_44_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_44_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_44_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_44_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_44_20201230_OpEnact_4d90bed75a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_44_obligation_0_e09e7b5c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "44" ;
    dzdoc:position 43 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_44_condition_0_2af76885> .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "تعمل الدولة على ترقية التناصف بين الرجال والنساء في سوق التشغيل . تشجع الدولة ترقية المرأة في مناصب المسؤولية في الهيئات والإدارات العمومية وعلى مستوى المؤسسات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_68_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_68_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_68_20201230_OpEnact_aebc9bcb61> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_68_obligation_0_9ba04d52>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_68_obligation_1_fafb1f49> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 68" ;
    dzdoc:position 67 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "لكل مواطن الحق في تقديم ملتمسات إلى الإدارة، بشكل فردي أو جماعي لطرح انشغالات تتعلق بالمصلحة العامة أو بتصرفات ماسة بحقوقه الأساسية . يتعين على الإدارة المعنية الرد على الملتمسات في أجل معقول ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_77_right_0_3cc539db> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_77_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_77_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_77_20201230_OpEnact_b98c83ace9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_77_obligation_0_dd31e671> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "77" ;
    dzdoc:position 76 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_99> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_1> ;
    dzdoc:eId "art_99" ;
    dzdoc:fullText "يقرر رئيس الجمهورية التعبئة العامة في مجلس الوزراء بعد الاستماع إلى المجلس الأعلى للأمن واستشارة رئيس مجلس الأمة ورئيس المجلس الشعبي الوطني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_99> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_99_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_99_20201230_OpEnact_c444762300> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "99" ;
    dzdoc:position 98 ;
    dzdoc:usesTerm dzterm:general_mobilization,
        dzterm:security_council .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_2> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "إذا أسفرت الانتخابات التشريعية عن أغلبية برلمانية غير الأغلبية الرئاسية ، يعين رئيس الجمهورية رئيس الحكومة من الأغلبية البرلمانية، ويكلفه بتشكيل حكومته وإعداد برنامج الأغلبية البرلمانية . إذا لم يصل رئيس الحكومة ، المعين إلى تشكيل حكومته في أجل ثلاثين (30) يوما ، يعين رئيس الجمهورية رئيس حكومة جديد ويكلفه بتشكيل الحكومة . يعرض رئيس الحكومة ، في كل الحالات، برنامج حكومته على مجلس الوزراء ، ثم يقدمه للبرلمان حسب الشروط المنصوص عليها في المواد 106 ( الفقرات الأولى و 3 و 4 ) و 107 و 108 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_110_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_110_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_110_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_110_20201230_OpEnact_d42a272fd6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_110_obligation_0_cad4b70f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "110" ;
    dzdoc:position 109 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-12-30/2020#art_106>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_107>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_108> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_106>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_107>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_108> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_110_condition_0_9d9b1029>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_110_condition_1_6d1aacdb> ;
    dzdoc:usesTerm dzterm:council_of_ministers,
        dzterm:government,
        dzterm:head_of_government,
        dzterm:parliament,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_118> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_118" ;
    dzdoc:fullText "يتفرغ النائب أو عضو مجلس الأمة كليا لممارسة عهدته . ينص النظام الداخلي لكل من المجلس الشعبي الوطني و مجلس الأمة على أحكام تتعلق بوجوب المشاركة الفعلية لأعضائهما في أشغال اللجان وفي الجلسات العامة ، تحت طائلة العقوبات المطبقة في حالة الغياب. تصوت كل غرفة من غرفتى البرلمان على القوانين واللوائح بحضور أغلبية أعضائها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_118> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_118_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_118_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_118_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_118_20201230_OpEnact_faa0a5ab79> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_118_obligation_0_480fbdb1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_118_obligation_1_6d424c8b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 118" ;
    dzdoc:position 117 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_118_condition_0_2d7d454d> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:senate .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_146> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_نهائيا_وفي_هذه_الحالة_يأخذ_المجلس_الشعبي_الوطني_بالنص_الذي_أعدته_اللجنة> ;
    dzdoc:eId "art_146" ;
    dzdoc:fullText "يصادق البرلمان على قانون المالية في مدة أقصاها خمسة وسبعون (75) يوما من تاريخ إيداعه. في حالة عدم المصادقة عليه في الأجل المحدد سابقا ، يصدر رئيس الجمهورية مشروع الحكومة بأمر . تحدد الإجراءات الأخرى بموجب القانون العضوي المذكور في المادة 135 من الدستور."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_146> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_146_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_146_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_146_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_146_20201230_OpEnact_77b048b513> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_146_obligation_0_6edcb988>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_146_obligation_1_e9fef7fa> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 146" ;
    dzdoc:position 145 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-12-30/2020#art_135> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_135> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_146_condition_0_eaf30b43> ;
    dzdoc:usesTerm dzterm:finance_law,
        dzterm:parliament,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_3> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "لا يجوز البتة التنازل أو التخلي عن أي جزء من التراب الوطني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_15_permission_0_a02260ac> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_15_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_15_20201230_OpEnact_f979753348> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_15_obligation_0_b18088ca> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/2020-12-30/2020#art_15_prohibition_0_a02260ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 15" ;
    dzdoc:position 14 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_179> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_4> ;
    dzdoc:eId "art_179" ;
    dzdoc:fullText "تمثل المحكمة العليا الهيئة المقومة لأعمال المجالس القضائية والمحاكم. يمثل مجلس الدولة الهيئة المقومة لأعمال المحاكم الإدارية للاستئناف والمحاكم الإدارية والجهات الأخرى الفاصلة في المواد الإدارية. تضمن المحكمة العليا و مجلس الدولة توحيد الاجتهاد القضائي في جميع أنحاء البلاد، ويسهران على احترام القانون. تفصل محكمة التنازع في حالات تنازع الاختصاص بين هيئات القضاء العادي وهيئات القضاء الإداري. يحدد قانون عضوي تنظيم المحكمة العليا و مجلس الدولة و محكمة التنازع ، وسيرها واختصاصاتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_179> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_179_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_179_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_179_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_179_para_3>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_179_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_179_20201230_OpEnact_278fe79848> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_179_obligation_0_d3b77d4f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 179" ;
    dzdoc:position 178 ;
    dzdoc:usesTerm dzterm:conflict_tribunal,
        dzterm:council_of_state,
        dzterm:supreme_court .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_185> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:definesTerm dzterm:constitutional_court ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_1> ;
    dzdoc:eId "art_185" ;
    dzdoc:fullText "المحكمة الدستورية مؤسسة مستقلة مكلفة بضمان احترام الدستور . تضبط المحكمة الدستورية سير المؤسسات ونشاط السلطات العمومية . تحدد المحكمة الدستورية قواعد عملها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_185> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-12-30/2020#art_185_defocc_b20d87b514cb> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_185_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_185_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_185_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_185_20201230_OpEnact_f8aec0f055> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_185_obligation_0_1fda3daf>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_185_obligation_1_f48a2ee2> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "185" ;
    dzdoc:position 184 ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "يتمتع كل أجنبي يتواجد فوق التراب الوطني بشكل قانوني بحماية القانون لشخصه وأملاكه . لا يمكن تسليم أحد إلا بمقتضى اتفاقية دولية مصادق عليها، أو بموجب قانون. لا يمكن، في أي حال، تسليم أو إبعاد أي لاجئ سياسي استفاد قانونا من حق اللجوء."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_50_permission_0_87af9f22>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_50_permission_1_c6c24fe1> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_50_right_0_625055e1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_50> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_50_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_50_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_50_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_50_20201230_OpEnact_7f12ccf0b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "50" ;
    dzdoc:position 49 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "لا مساس بحرمة حرية الرأي . حرية ممارسة العبادات مضمونة وتمارس في إطار احترام القانون. تضمن الدولة حماية أماكن العبادة من أي تأثير سياسي أو إيديولوجي ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_51_right_0_e2216362>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_51_right_1_18937fcd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_51_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_51_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_51_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_51_20201230_OpEnact_217aeeb0ce> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_51_obligation_0_c880f719> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "51" ;
    dzdoc:position 50 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "الحق في الثقافة مضمون . لكل شخص الحق في الثقافة بشكل متساو مع الآخرين . تحمي الدولة التراث الثقافي الوطني المادي وغير المادي، وتعمل على الحفاظ عليه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_76_right_0_7033fce4>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_76_right_1_dd64bcc9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_76_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_76_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_76_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_76_20201230_OpEnact_916a838e7e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_76_obligation_0_784c9b78> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 76" ;
    dzdoc:position 75 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_الثان> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "لا يعذر أحد بجهل القانون . لا يحتج بالقوانين والتنظيمات إلا بعد نشرها بالطرق الرسمية. يجب على كل شخص أن يحترم الدستور ، وأن يمتثل لقوانين الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_78> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_78_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_78_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_78_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_78_20201230_OpEnact_5ed43d9878> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_78_obligation_0_13faa7c9>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_78_obligation_1_f2be8659> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "78" ;
    dzdoc:position 77 ;
    dzdoc:usesTerm dzterm:constitution .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_82> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_الثان> ;
    dzdoc:eId "art_82" ;
    dzdoc:fullText "لا تحدث أية ضريبة إلا بمقتضى القانون . كل المكلفين بالضريبة متساوون أمام الضريبة، ويحدد القانون حالات وشروط الإعفاء الكلى أو الجزئي منها. الضريبة من واجبات المواطنة. لا تحدث بأثر رجعي، أية ضريبة، أو جباية، أو رسم أو أي حق كيفما كان نوعه. كل فعل يهدف إلى التحايل على مبدأ المساواة بين المكلفين بالضريبة، يعد مساسا بمصالح المجموعة الوطنية. يعاقب القانون على التهرب والغش الضريبي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_82> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_82_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_82_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_82_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_82_para_3>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_82_para_4>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_82_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_82_20201230_OpEnact_ce4fc0a329> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "82" ;
    dzdoc:position 81 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_82_condition_0_fccc4c08> .

