<https://legal.dz/resource/constitution/2020-12-30/2020#art_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_1> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "إذا وقع عدوان فعلي على البلاد أو يوشك أن يقع حسبما نصت عليه الترتيبات الملائمة لميثاق الأمم المتحدة يعلن رئيس الجمهورية الحرب ، بعد اجتماع مجلس الوزراء والاستماع إلى المجلس الأعلى للأمن واستشارة رئيس مجلس الأمة ورئيس المجلس الشعبي الوطني ورئيس المحكمة الدستورية. يجتمع البرلمان وجوبا . يوجه رئيس الجمهورية خطابا للأمة يعلمها بذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_100> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_100_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_100_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_100_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_100_20201230_OpEnact_c7e22d7a8a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_100_obligation_0_9bbfa18c>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_100_obligation_1_a2d29fb2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_100_obligation_2_74997510> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 100" ;
