    dzdoc:position 17 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_182> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
