        <https://legal.dz/resource/constitution/2020-12-30/2020#art_111_obligation_1_76b4ee42> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 111" ;
    dzdoc:position 110 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-12-30/2020#art_151>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_161>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_162> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_151>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_161>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_162> ;
