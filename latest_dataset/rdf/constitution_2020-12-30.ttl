<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_105> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أسفرت الانتخابات التشريعية عن أغلبية رئاسية ، يعين رئيس الجمهورية وزيرا أول ويكلفه باقتراح تشكيل الحكومة وإعداد مخطط عمل لتطبيق البرنامج الرئاسي الذي يعرضه على مجلس الوزراء ."@ar ;
    dzdoc:isAuthoritative true ;
