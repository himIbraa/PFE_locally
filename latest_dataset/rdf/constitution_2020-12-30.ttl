<https://legal.dz/resource/constitution/2020-12-30/2020#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_2> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "تسهر الدولة على تفعيل دور المجتمع المدني للمشاركة في تسيير الشؤون العمومية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_10_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_10_20201230_OpEnact_a3109dbd4c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_10_obligation_0_4a58e3b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "10" ;
    dzdoc:position 9 ;
    dzdoc:usesTerm dzterm:civil_society,
        dzterm:state .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_115> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_115" ;
    dzdoc:fullText "يراقب البرلمان عمل الحكومة وفقا للشروط المحددة فى المواد 106 و 111 و 158 و 160 من الدستور. يمارس المجلس الشعبي الوطني الرقابة المنصوص عليها في المادتين 161 و 162 من الدستور."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_115> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_115_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_115_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_115_20201230_OpEnact_c743489aee> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_115_obligation_0_210b9d09> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 115" ;
    dzdoc:position 114 ;
    dzdoc:referencesExternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_115_extref_21376865>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_115_extref_8aa06afb>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_115_extref_96ecaf41>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_115_extref_a0efdf62>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_115_extref_c97139bb>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_115_extref_ee246840> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:parliament .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_2> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "الشعب حر في اختيار ممثليه . لا حدود لتمثيل الشعب ، إلا ما نص عليه الدستور و قانون الانتخابات ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_12_right_0_96ba912e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_12_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_12_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_12_20201230_OpEnact_a7af345536> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "12" ;
    dzdoc:position 11 ;
    dzdoc:usesTerm dzterm:constitution,
        dzterm:electoral_law,
        dzterm:people .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_121> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_121" ;
    dzdoc:fullText "ينتخب أعضاء المجلس الشعبي الوطني عن طريق الاقتراع العام المباشر والسري. ينتخب ثلثا (2/3) أعضاء مجلس الأمة عن طريق الاقتراع غير المباشر والسري، بمقعدين عن كل ولاية، من بين أعضاء المجالس الشعبية البلدية وأعضاء المجالس الشعبية الولائية. يعين رئيس الجمهورية الثلث (1/3) الآخر من أعضاء مجلس الأمة من بين الشخصيات والكفاءات الوطنية في المجالات العلمية والمهنية والاقتصادية والاجتماعية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_121> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_121_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_121_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_121_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_121_20201230_OpEnact_89799cbfb3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 121" ;
    dzdoc:position 120 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:president,
        dzterm:senate .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_126> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_126" ;
    dzdoc:fullText "كل نائب أو عضو مجلس الأمة لا يستوفي شروط قابلية انتخابه أو يفقدها ، يتعرض لسقوط عهدته البرلمانية. يقرر المجلس الشعبي الوطني أو مجلس الأمة ، حسب الحالة، هذا السقوط بأغلبية أعضائه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_126> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_126_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_126_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_126_20201230_OpEnact_dac4472211> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 126" ;
    dzdoc:position 125 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_126_condition_0_14e00619> ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_127> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_127" ;
    dzdoc:fullText "النائب أو عضو مجلس الأمة مسؤول أمام زملائه الذين يمكنهم تجريده من عهدته إن اقترف فعلا يخل بشرفها . يحدد النظام الداخلي لكل واحدة من الغرفتين، الشروط التي يتعرض فيها أي نائب أو عضو مجلس الأمة للإقصاء، ويقرر هذا الإقصاء، حسب الحالة، المجلس الشعبي الوطني أو مجلس الأمة بأغلبية أعضائه، دون المساس بجميع المتابعات الأخرى الواردة في القانون"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_127> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_127_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_127_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_127_20201230_OpEnact_77053ac40f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 127" ;
    dzdoc:position 126 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_127_condition_0_b8403883> ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_129> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_129" ;
    dzdoc:fullText "يتمتع عضو البرلمان بالحصانة بالنسبة للأعمال المرتبطة بممارسة مهامه كما هي محددة في الدستور ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_129_right_0_e3903569> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_129> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_129_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_129_20201230_OpEnact_126fa18f2e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 129" ;
    dzdoc:position 128 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_3> ;
    dzdoc:eId "art_13" ;
    dzdoc:fullText "تستمد الدولة وجودها وشرعيتها من إرادة الشعب. شعار الدولة \"بالشعب وللشعب\". الدولة في خدمة الشعب وحده."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_13> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_13_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_13_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_13_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_13_20201230_OpEnact_d527dc6a68> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 13" ;
    dzdoc:position 12 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_134> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_134" ;
    dzdoc:fullText "ينتخب رئيس المجلس الشعبي الوطني للفترة التشريعية. ينتخب رئيس مجلس الأمة بعد كل تجديد جزئي لتشكيلة المجلس، و يتعين أن تتوفر فيه الشروط المنصوص عليها في المادة 87 من الدستور ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_134> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_134_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_134_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_134_20201230_OpEnact_21e6e58887> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 134" ;
    dzdoc:position 133 ;
    dzdoc:referencesExternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_134_extref_219f35ab> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_134_condition_0_ead24160> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_147> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_نهائيا_وفي_هذه_الحالة_يأخذ_المجلس_الشعبي_الوطني_بالنص_الذي_أعدته_اللجنة> ;
    dzdoc:eId "art_147" ;
    dzdoc:fullText "لا يقبل أي اقتراح قانون أو تعديل قانون يقدمه أعضاء البرلمان ، يكون مضمونه أو نتيجته تخفيض الموارد العمومية، أو زيادة النفقات العمومية، إلا إذا كان مرفوقا بتدابير تستهدف الزيادة في إيرادات الدولة، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي، على الأقل المبالغ المقترح إنفاقها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_147> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_147_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_147_20201230_OpEnact_b43643a3b1> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 147" ;
    dzdoc:position 146 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_147_condition_0_23498717> ;
    dzdoc:usesTerm dzterm:parliament .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_155> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_نهائيا_وفي_هذه_الحالة_يأخذ_المجلس_الشعبي_الوطني_بالنص_الذي_أعدته_اللجنة> ;
    dzdoc:eId "art_155" ;
    dzdoc:fullText "تقدم الحكومة المعلومات والوثائق الضرورية التي يطلبها البرلمان عند ممارسة مهامه الرقابية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_155> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_155_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_155_20201230_OpEnact_d57950e692> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_155_obligation_0_49ed7700> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 155" ;
    dzdoc:position 154 ;
    dzdoc:usesTerm dzterm:government,
        dzterm:parliament .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_156> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_نهائيا_وفي_هذه_الحالة_يأخذ_المجلس_الشعبي_الوطني_بالنص_الذي_أعدته_اللجنة> ;
    dzdoc:eId "art_156" ;
    dzdoc:fullText "تقدم الحكومة لكل غرفة من البرلمان عرضا عن استعمال الاعتمادات المالية التي أقرتها لكل سنة مالية . تختتم السنة المالية فيما يخص البرلمان ، بالتصويت على قانون يتضمن تسوية ميزانية السنة المالية المعنية من قبل كل غرفة من البرلمان ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_156> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_156_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_156_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_156_20201230_OpEnact_46f9b3afc5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_156_obligation_0_a8e0b597> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 156" ;
    dzdoc:position 155 ;
    dzdoc:usesTerm dzterm:government,
        dzterm:parliament .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_169> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_4> ;
    dzdoc:eId "art_169" ;
    dzdoc:fullText "تعلل الأحكام والأوامر القضائية . ينطق بالأحكام القضائية في جلسات علنية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_169> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_169_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_169_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_169_20201230_OpEnact_c7eb770b03> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_169_obligation_0_56c65eed> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 169" ;
    dzdoc:position 168 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_194> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_1> ;
    dzdoc:eId "art_194" ;
    dzdoc:fullText "تتداول المحكمة الدستورية فى جلسة مغلقة، وتصدر قرارها في ظرف ثلاثين (30) يوما من تاريخ إخطارها. وفي حال وجود طارئ، وبطلب من رئيس الجمهورية، يخفض هذا الأجل إلى عشرة (10) أيام."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_194> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_194_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_194_20201230_OpEnact_166db86e0e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "194" ;
    dzdoc:position 193 ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_203> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_الثال> ;
    dzdoc:eId "art_203" ;
    dzdoc:fullText "تقدم السلطات العمومية المعنية الدعم الضروري ل السلطة الوطنية المستقلة للانتخابات لممارسة مهامها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_203> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_203_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_203_20201230_OpEnact_9f16418b7b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_203_obligation_0_414dbedf> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 203" ;
    dzdoc:position 202 ;
    dzdoc:usesTerm dzterm:independent_national_authority_for_elections .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_208> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_5> ;
    dzdoc:eId "art_208" ;
    dzdoc:fullText "يرأس رئيس الجمهورية المجلس الأعلى للأمن . يقدم المجلس الأعلى للأمن لـ رئيس الجمهورية آراء في المسائل المتعلقة بالأمن الوطني. يحدد رئيس الجمهورية كيفيات تنظيم المجلس الأعلى للأمن وسيره"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_208> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_208_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_208_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_208_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_208_20201230_OpEnact_f00d0af93d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 208" ;
    dzdoc:position 207 ;
    dzdoc:usesTerm dzterm:high_security_council,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_209> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:definesTerm dzterm:cnese ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_5> ;
    dzdoc:eId "art_209" ;
    dzdoc:fullText "المجلس الوطني الاقتصادي والاجتماعي والبيئي ، إطار للحوار والتشاور والاقتراح والاستشراف والتحليل في المجالات الاقتصادية والاجتماعية والبيئية، يوضع لدى رئيس الجمهورية . وهو كذلك مستشار الحكومة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_209> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-12-30/2020#art_209_defocc_7cab29a1fdd9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_209_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_209_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_209_20201230_OpEnact_89a843f8f5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 209" ;
    dzdoc:position 208 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_211> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:definesTerm dzterm:cndh ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_5> ;
    dzdoc:eId "art_211" ;
    dzdoc:fullText "المجلس الوطني لحقوق الإنسان هيئة استشارية لدى رئيس الجمهورية . يتمتع المجلس بالاستقلالية الإدارية والمالية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_211> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-12-30/2020#art_211_defocc_e85b06451d00> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_211_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_211_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_211_20201230_OpEnact_35b52675e8> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 211" ;
    dzdoc:position 210 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_217> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_5> ;
    dzdoc:eId "art_217" ;
    dzdoc:fullText "يتولى المجلس ، على الخصوص، المهام الآتية : ترقية البحث الوطني في مجال الابتكار التكنولوجي والعلمي، اقتراح التدابير الكفيلة بتنمية القدرات الوطنية في مجال البحث والتطوير تقييم فعالية الأجهزة الوطنية المتخصصة في تثمين نتائج البحث لفائدة الاقتصاد الوطني في إطار التنمية المستدامة. يعين رئيس الجمهورية رئيس المجلس الوطني للبحث العلمي والتكنولوجيات . يحدد القانون تنظيم المجلس وتشكيله وسيره وكذا صلاحياته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_217> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_217_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_217_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_217_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_217_20201230_OpEnact_5e30a6d442> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 217" ;
    dzdoc:position 216 ;
    dzdoc:usesTerm dzterm:scientific_council .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_218> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:definesTerm dzterm:academy ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_5> ;
    dzdoc:eId "art_218" ;
    dzdoc:fullText "الأكاديمية الجزائرية للعلوم والتكنولوجيات هيئة مستقلة ذات طابع علمي وتكنولوجي. يحدد القانون تنظيم الأكاديمية وتشكيلتها وسيرها ومهامها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_218> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-12-30/2020#art_218_defocc_256452c4fb5a> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_218_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_218_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_218_20201230_OpEnact_639f367c5d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 218" ;
    dzdoc:position 217 ;
    dzdoc:usesTerm dzterm:academy .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_22> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_3> ;
    dzdoc:eId "art_22" ;
    dzdoc:fullText "يحدد القانون الأملاك الوطنية. تتكون الأملاك الوطنية من الأملاك العمومية والخاصة التي تملكها كل من الدولة والولاية والبلدية. تسير الأملاك الوطنية طبقا للقانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_22> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_22_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_22_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_22_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_22_20201230_OpEnact_f076785977> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 22" ;
    dzdoc:position 21 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_225> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_6> ;
    dzdoc:eId "art_225" ;
    dzdoc:fullText "يستمر سريان مفعول القوانين التي يستوجب تعديلها أو إلغاؤها وفق أحكام هذا الدستور إلى غاية إعداد قوانين جديدة أو تعديلها في أجل معقول ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_225> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_225_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_225_20201230_OpEnact_69c91c2eb9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_225_obligation_0_74cd70fb> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 225" ;
    dzdoc:position 224 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_3> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "تنظم الدولة التجارة الخارجية . يحدد القانون شروط ممارسة التجارة الخارجية ومراقبتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_23_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_23_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_23_20201230_OpEnact_50e327476c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_23_obligation_0_fcf47fe2> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 23" ;
    dzdoc:position 22 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:definesTerm dzterm:nationality ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "الجنسية الجزائرية معرفة بالقانون يحدد القانون شروط اكتساب الجنسية الجزائرية ، والاحتفاظ بها، أو فقدانها، أو التجريد منها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_36> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-12-30/2020#art_36_defocc_da7790574fd1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_36_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_36_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_36_20201230_OpEnact_c675d93453> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "36" ;
    dzdoc:position 35 ;
    dzdoc:usesTerm dzterm:nationality .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "للأشخاص المعوزين الحق في المساعدة القضائية . يحدد القانون شروط تطبيق هذا الحكم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_42_right_0_cb37e964> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_42> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_42_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_42_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_42_20201230_OpEnact_387abc06fb> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "42" ;
    dzdoc:position 41 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_46> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_46" ;
    dzdoc:fullText "لكل شخص كان محل توقيف أو حبس مؤقت تعسفيين أو خطأ قضائي، الحق في التعويض . يحدد القانون شروط وكيفيات تطبيق هذا الحكم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_46_right_0_9613cb6a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_46> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_46_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_46_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_46_20201230_OpEnact_fb490fcc8c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "46" ;
    dzdoc:position 45 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_56> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_56" ;
    dzdoc:fullText "لكل مواطن تتوفر فيه الشروط القانونية الحق في أن ينتخب وأن ينتخب"@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_56_right_0_3ddfddb2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_56> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_56_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_56_20201230_OpEnact_7e0f306e60> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "56" ;
    dzdoc:position 55 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_56_condition_0_32b2f7fa> .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_1> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "العلم الوطني والنشيد الوطني من مكاسب ثورة أول نوفمبر 1954 وهما غير قابلين للتغيير. هذان الرمزان من رموز الثورة، هما رمزان للجمهورية بالصفات الآتية : علم الجزائر أخضر وأبيض تتوسطه نجمة وهلال أحمرا اللون، النشيد الوطني هو \"قسما\" بجميع مقاطعه. يحدد القانون ختم الدولة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_6_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_6_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_6_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_6_20201230_OpEnact_c72342c156> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "6" ;
    dzdoc:position 5 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "تعمل السلطات العمومية على حماية المستهلكين بشكل يضمن لهم الأمن والسلامة والصحة وحقوقهم الاقتصادية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_62_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_62_20201230_OpEnact_5f9a2aed36> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_62_obligation_0_39c9771c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 62" ;
    dzdoc:position 61 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "للمواطن الحق في بيئة سليمة في إطار التنمية المستدامة . يحدد القانون واجبات الأشخاص الطبيعيين والمعنويين لحماية البيئة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_64_right_0_fc482ef1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_64_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_64_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_64_20201230_OpEnact_0fbee47c47> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 64" ;
    dzdoc:position 63 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_1> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "الشعب مصدر كل سلطة. السيادة الوطنية ملك للشعب وحده ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_7_right_0_056c3756> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_7_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_7_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_7_20201230_OpEnact_b723324503> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "7" ;
    dzdoc:position 6 .

