<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_53> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "حق إنشاء الجمعيات مضمون ، ويمارس بمجرد التصريح به. تشجع الدولة الجمعيات ذات المنفعة العامة. يحدد قانون عضوي شروط وكيفيات إنشاء الجمعيات. لا تحل الجمعيات إلا بمقتضى قرار قضائي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
