<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_121> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينتخب أعضاء المجلس الشعبي الوطني عن طريق الاقتراع العام المباشر والسري. ينتخب ثلثا (2/3) أعضاء مجلس الأمة عن طريق الاقتراع غير المباشر والسري، بمقعدين عن كل ولاية، من بين أعضاء المجالس الشعبية البلدية وأعضاء المجالس الشعبية الولائية. يعين رئيس الجمهورية الثلث (1/3) الآخر من أعضاء مجلس الأمة من بين الشخصيات والكفاءات الوطنية في المجالات العلمية والمهنية والاقتصادية والاجتماعية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_121_20201230_OpEnact_89799cbfb3> ;
    dzdoc:replacementText "ينتخب أعضاء المجلس الشعبي الوطني عن طريق الاقتراع العام المباشر والسري. ينتخب ثلثا (2/3) أعضاء مجلس الأمة عن طريق الاقتراع غير المباشر والسري، بمقعدين عن كل ولاية، من بين أعضاء المجالس الشعبية البلدية وأعضاء المجالس الشعبية الولائية. يعين رئيس الجمهورية الثلث (1/3) الآخر من أعضاء مجلس الأمة من بين الشخصيات والكفاءات الوطنية في المجالات العلمية والمهنية والاقتصادية والاجتماعية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_121> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/2020-12-30/2020> ;
