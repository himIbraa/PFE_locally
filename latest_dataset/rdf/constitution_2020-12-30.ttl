<https://legal.dz/resource/constitution/2020-12-30/2020#art_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_2> ;
    dzdoc:eId "art_109" ;
    dzdoc:fullText "ينفذ الوزير الأول وينسق مخطط العمل الذي صادق عليه المجلس الشعبي الوطني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_109> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_109_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_109_20201230_OpEnact_e7600394d0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_109_obligation_0_5d0b1011> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "109" ;
    dzdoc:position 108 ;
    dzdoc:usesTerm dzterm:national_peoples_assembly,
        dzterm:prime_minister .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_2> ;
    dzdoc:eId "art_11" ;
    dzdoc:fullText "تمتنع المؤسسات عن القيام بما يأتي : الممارسات الإقطاعية، والجهوية، والمحسوبية، إقامة علاقات الاستغلال والتبعية السلوك المخالف للأخلاق الإسلامية وقيم ثورة نوفمبر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_11> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_11_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_11_20201230_OpEnact_1e6dc268f7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_11_obligation_0_92c260b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "11" ;
    dzdoc:position 10 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_123> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_123" ;
    dzdoc:fullText "تحدد كيفيات انتخاب النواب وكيفيات انتخاب أعضاء مجلس الأمة أو تعيينهم، وشروط قابليتهم للانتخاب، ونظام عدم قابليتهم للانتخاب، وحالات التنافي ونظام التعويضات البرلمانية، بموجب قانون عضوي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_123> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_123_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_123_20201230_OpEnact_144c3afe44> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_123_obligation_0_8d3dd1a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 123" ;
    dzdoc:position 122 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_128> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_128" ;
    dzdoc:fullText "يحدد قانون عضوي الشروط التي يقبل فيها البرلمان استقالة أحد أعضائه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_128> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_128_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_128_20201230_OpEnact_3d68de6e13> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_128_obligation_0_c60c3ec1> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 128" ;
    dzdoc:position 127 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_132> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_132" ;
    dzdoc:fullText "يحدد قانون عضوي شروط استخلاف النائب أو عضو مجلس الأمة في حالة شغور مقعده ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_132> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_132_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_132_20201230_OpEnact_77fecfa9ea> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_132_obligation_0_029ae566> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 132" ;
    dzdoc:position 131 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_3> ;
    dzdoc:eId "art_14" ;
    dzdoc:fullText "تمارس سيادة الدولة على مجالها البري، ومجالها الجوي، وعلى مياهها. كما تمارس الدولة حقها السيد الذي يقره القانون الدولي على كل منطقة من مختلف مناطق المجال البحري التي ترجع إليها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_14_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_14_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_14_20201230_OpEnact_ddbc82d4b2> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 14" ;
    dzdoc:position 13 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_141> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_141" ;
    dzdoc:fullText "يمارس رئيس الجمهورية السلطة التنظيمية في المسائل غير المخصصة للقانون. يندرج تطبيق القوانين في المجال التنظيمي الذي يعود لـ الوزير الأول أو لـ رئيس الحكومة ، حسب الحالة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_141> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_141_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_141_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_141_20201230_OpEnact_f622d0dcc4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "141" ;
    dzdoc:position 140 ;
    dzdoc:usesTerm dzterm:head_of_government,
        dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_154> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_نهائيا_وفي_هذه_الحالة_يأخذ_المجلس_الشعبي_الوطني_بالنص_الذي_أعدته_اللجنة> ;
    dzdoc:eId "art_154" ;
    dzdoc:fullText "المعاهدات التي يصادق عليها رئيس الجمهورية ، حسب الشروط المنصوص عليها في الدستور ، تسمو على القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_154> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_154_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_154_20201230_OpEnact_0b0d65d458> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 154" ;
    dzdoc:position 153 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_154_condition_0_4d71ca69> ;
    dzdoc:usesTerm dzterm:president,
        dzterm:treaties .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_163> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_4> ;
    dzdoc:eId "art_163" ;
    dzdoc:fullText "القضاء سلطة مستقلة. القاضي مستقل، لا يخضع إلا للقانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_163> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_163_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_163_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_163_20201230_OpEnact_5a147c8ed8> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 163" ;
    dzdoc:position 162 ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:judiciary .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_174> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_4> ;
    dzdoc:eId "art_174" ;
    dzdoc:fullText "يحمي القانون المتقاضي من أي تعسف يصدر عن القاضي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_174> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_174_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_174_20201230_OpEnact_020d179237> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_174_obligation_0_17e66270> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 174" ;
    dzdoc:position 173 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_184> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4> ;
    dzdoc:eId "art_184" ;
    dzdoc:fullText "تكلف المؤسسات الدستورية و أجهزة الرقابة بالتحقيق في مطابقة العمل التشريعي والتنظيمي للدستور، وفي كيفيات استخدام الوسائل المادية والأموال العمومية وتسييرها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_184> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_184_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_184_20201230_OpEnact_93c612aa33> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_184_obligation_0_6ec79f70> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 184" ;
    dzdoc:position 183 ;
    dzdoc:usesTerm dzterm:constitutional_institutions,
        dzterm:oversight_bodies .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_196> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_1> ;
    dzdoc:eId "art_196" ;
    dzdoc:fullText "يحدد قانون عضوي إجراءات وكيفيات الإخطار والإحالة المتبعة أمام المحكمة الدستورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_196> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_196_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_196_20201230_OpEnact_5b979ccff2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_196_obligation_0_314ec797> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "196" ;
    dzdoc:position 195 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_197> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_1> ;
    dzdoc:eId "art_197" ;
    dzdoc:fullText "تتخذ قرارات المحكمة الدستورية بأغلبية أعضائها الحاضرين، وفي حالة تساوي عدد الأصوات يكون صوت الرئيس مرجحا. تتخذ القرارات المتعلقة برقابة القوانين العضوية بالأغلبية المطلقة للأعضاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_197> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_197_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_197_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_197_20201230_OpEnact_fa67f8fd50> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 197" ;
    dzdoc:position 196 ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_200> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:definesTerm dzterm:independent_national_authority_for_elections ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_الثال> ;
    dzdoc:eId "art_200" ;
    dzdoc:fullText "السلطة الوطنية المستقلة للانتخابات مؤسسة مستقلة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_200> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-12-30/2020#art_200_defocc_bad6f68825f9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_200_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_200_20201230_OpEnact_12afad454c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 200" ;
    dzdoc:position 199 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_204> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:definesTerm dzterm:high_authority_transparency ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_4> ;
    dzdoc:eId "art_204" ;
    dzdoc:fullText "السلطة العليا للشفافية والوقاية من الفساد ومكافحته مؤسسة مستقلة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_204> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-12-30/2020#art_204_defocc_72413def9fa4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_204_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_204_20201230_OpEnact_81e315991d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 204" ;
    dzdoc:position 203 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_206> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:definesTerm dzterm:high_islamic_council ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_5> ;
    dzdoc:eId "art_206" ;
    dzdoc:fullText "المجلس الإسلامي الأعلى هيئة استشارية لدى رئيس الجمهورية . يتولى على وجه الخصوص : الحث على الاجتهاد وترقيته إبداء الحكم الشرعي فيما يعرض عليه، رفع تقرير دوري عن نشاطه إلى رئيس الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_206> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-12-30/2020#art_206_defocc_48e1965ce145> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_206_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_206_20201230_OpEnact_8b4ef1429d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 206" ;
    dzdoc:position 205 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_3> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "تسهر الدولة على : حماية الأراضي الفلاحية، ضمان بيئة سليمة من أجل حماية الأشخاص وتحقيق رفاههم، ضمان توعية متواصلة بالمخاطر البيئية الاستعمال العقلاني للمياه والطاقات الأحفورية والموارد الطبيعية الأخرى، حماية البيئة بأبعادها البرية والبحرية والجوية، واتخاذ كل التدابير الملائمة لمعاقبة الملوثين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_21_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_21_20201230_OpEnact_94a16163e7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_21_obligation_0_1bc5d7cb> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 21" ;
    dzdoc:position 20 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_215> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_5> ;
    dzdoc:eId "art_215" ;
    dzdoc:fullText "يقدم المجلس الأعلى للشباب آراء وتوصيات حول المسائل المتعلقة بحاجات الشباب وازدهاره في المجالات الاقتصادية والاجتماعية والثقافية والرياضية يساهم المجلس الأعلى للشباب في ترقية القيم الوطنية والضمير الوطني والحس المدني والتضامن الاجتماعي في أوساط الشباب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_215> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_215_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_215_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_215_20201230_OpEnact_d6e8dc2bc4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 215" ;
    dzdoc:position 214 ;
    dzdoc:usesTerm dzterm:youth_council .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_216> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:definesTerm dzterm:scientific_council ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_5> ;
    dzdoc:eId "art_216" ;
    dzdoc:fullText "المجلس الوطني للبحث العلمي والتكنولوجيات هيئة استشارية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_216> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/2020-12-30/2020#art_216_defocc_8082962077d4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_216_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_216_20201230_OpEnact_56593f9473> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
