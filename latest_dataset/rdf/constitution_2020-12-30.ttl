<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_219> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ل رئيس الجمهورية حق المبادرة بالتعديل الدستوري . بعد أن يصوت المجلس الشعبي الوطني و مجلس الأمة على المبادرة بنفس الصيغة حسب الشروط نفسها التي تطبق على نص تشريعي ، يعرض التعديل على الشعب للاستفتاء عليه خلال الخمسين (50) يوما الموالية لإقراره. يصدر رئيس الجمهورية التعديل الدستوري الذي صادق عليه الشعب."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_219_20201230_OpEnact_eb2414e61d> ;
    dzdoc:replacementText "ل رئيس الجمهورية حق المبادرة بالتعديل الدستوري . بعد أن يصوت المجلس الشعبي الوطني و مجلس الأمة على المبادرة بنفس الصيغة حسب الشروط نفسها التي تطبق على نص تشريعي ، يعرض التعديل على الشعب للاستفتاء عليه خلال الخمسين (50) يوما الموالية لإقراره. يصدر رئيس الجمهورية التعديل الدستوري الذي صادق عليه الشعب."@ar ;
