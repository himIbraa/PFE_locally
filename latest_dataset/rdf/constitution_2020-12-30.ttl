<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_98> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقرر رئيس الجمهورية الحالة الاستثنائية إذا كانت البلاد مهددة بخطر داهم يوشك أن يصيب مؤسساتها الدستورية أو استقلالها أو سلامة ترابها لمدة أقصاها ستون (60) يوما. لا يتخذ مثل هذا الإجراء إلا بعد استشارة رئيس مجلس الأمة، ورئيس المجلس الشعبي الوطني، ورئيس المحكمة الدستورية ، والاستماع إلى المجلس الأعلى للأمن ومجلس الوزراء . وتخول الحالة الاستثنائية رئيس الجمهورية اتخاذ الإجراءات الاستثنائية التي تستوجبها المحافظة على استقلال الأمة والمؤسسات الدستورية في الجمهورية. يوجه رئيس الجمهورية في هذا الشأن خطا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_98_20201230_OpEnact_434839953e> ;
    dzdoc:replacementText "يقرر رئيس الجمهورية الحالة الاستثنائية إذا كانت البلاد مهددة بخطر داهم يوشك أن يصيب مؤسساتها الدستورية أو استقلالها أو سلامة ترابها لمدة أقصاها ستون (60) يوما. لا يتخذ مثل هذا الإجراء إلا بعد استشارة رئيس مجلس الأمة، ورئيس المجلس الشعبي الوطني، ورئيس المحكمة الدستورية ، والاستماع إلى المجلس الأعلى للأمن ومجلس الوزراء . وتخول الحالة الاستثنائية رئيس الجمهورية اتخاذ الإجراءات الاستثنائية التي تستوجبها المحافظة على استقلال الأمة والمؤسسات الدستورية في الجمهورية. يوجه رئيس الجمهورية في هذا الشأن خطابا للأمة. يجتمع البرلمان وجوبا. لا يمكن تمديد مدة الحالة الاستثنائية إلا بعد موافقة أغلبية أعضاء غرفتي البرلمان المجتمعتين معا . تنتهي الحالة الاستثنائية ، حسب الأشكال والإجراءات السالفة الذكر التي أوجبت إعلانها. يعرض رئيس الجمهورية، بعد انقضاء مدة الحالة الاستثنائية ، القرارات التي اتخذها أثناءها على المحكمة الدستورية لإبداء الرأي بشأنها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_98> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_98> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2020-12-30"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

