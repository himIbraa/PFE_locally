<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_82> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تحدث أية ضريبة إلا بمقتضى القانون . كل المكلفين بالضريبة متساوون أمام الضريبة، ويحدد القانون حالات وشروط الإعفاء الكلى أو الجزئي منها. الضريبة من واجبات المواطنة. لا تحدث بأثر رجعي، أية ضريبة، أو جباية، أو رسم أو أي حق كيفما كان نوعه. كل فعل يهدف إلى التحايل على مبدأ المساواة بين المكلفين بالضريبة، يعد مساسا بمصالح المجموعة الوطنية. يعاقب القانون على التهرب والغش الضريبي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_82_20201230_OpEnact_ce4fc0a329> ;
    dzdoc:replacementText "لا تحدث أية ضريبة إلا بمقتضى القانون . كل المكلفين بالضريبة متساوون أمام الضريبة، ويحدد القانون حالات وشروط الإعفاء الكلى أو الجزئي منها. الضريبة من واجبات المواطنة. لا تحدث بأثر رجعي، أية ضريبة، أو جباية، أو رسم أو أي حق كيفما كان نوعه. كل فعل يهدف إلى التحايل على مبدأ المساواة بين المكلفين بالضريبة، يعد مساسا بمصالح المجموعة الوطنية. يعاقب القانون على التهرب والغش الضريبي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
