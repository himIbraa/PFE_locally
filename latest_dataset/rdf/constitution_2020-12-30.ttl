<https://legal.dz/resource/constitution/2020-12-30/2020#art_145_obligation_1_40fdebea> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
