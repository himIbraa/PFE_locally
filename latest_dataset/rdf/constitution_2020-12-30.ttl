    dznorm:expressedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_136> .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_137_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_137> ;
    dzdoc:position 0 ;
    dzdoc:text "يشكل كل من المجلس الشعبي الوطني ومجلس الأمة لجانه الدائمة في إطار نظامه الداخلي."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_137_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_137> ;
    dzdoc:position 1 ;
    dzdoc:text "يمكن كل لجنة دائمة من لجان الغرفتين تشكيل بعثة استعلام مؤقتة حول موضوع محدد أو وضع معين."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_137_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_137> ;
    dzdoc:position 2 ;
    dzdoc:text "يحدد النظام الداخلي لكل غرفة من الغرفتين الأحكام التي تخضع لها البعثة الاستعلامية."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_137_permission_0_22c2e3fe> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
