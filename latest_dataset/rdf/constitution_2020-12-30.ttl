<https://legal.dz/resource/constitution/2020-12-30/2020#art_176> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_4> ;
    dzdoc:eId "art_176" ;
    dzdoc:fullText "يستفيد المحامي من الضمانات القانونية التي تكفل له الحماية من كل أشكال الضغوط، وتمكنه من ممارسة مهنته بكل حرية في إطار القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_176> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_176_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_176_20201230_OpEnact_e0457c9f20> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 176" ;
    dzdoc:position 175 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_3> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "تقوم العلاقات بين الدولة والجماعات المحلية على مبادئ اللامركزية وعدم التركيز."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_18> ;
