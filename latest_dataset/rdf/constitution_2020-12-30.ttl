        <https://legal.dz/resource/constitution/2020-12-30/2020#art_102>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_97>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_98>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_99> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_100>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_102>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_97>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_98>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_99> ;
