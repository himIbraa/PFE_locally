<https://legal.dz/resource/constitution/2020-12-30/2020#art_162> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_نهائيا_وفي_هذه_الحالة_يأخذ_المجلس_الشعبي_الوطني_بالنص_الذي_أعدته_اللجنة> ;
    dzdoc:eId "art_162" ;
    dzdoc:fullText "تتم الموافقة على ملتمس الرقابة بتصويت أغلبية ثلثي (3/2) النواب . لا يتم التصويت إلا بعد ثلاثة (3) أيام من تاريخ إيداع ملتمس الرقابة . إذا صادق المجلس الشعبي الوطني على ملتمس الرقابة ، يقدم الوزير الأول أو رئيس الحكومة ، حسب الحالة، استقالة الحكومة إلى رئيس الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_162> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_162_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_162_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_162_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_162_20201230_OpEnact_8d938ceca0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_162_obligation_0_cb02cf32> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
