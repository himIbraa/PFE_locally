<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_136> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "جلسات البرلمان علانية. تدون مداولات البرلمان في محاضر تنشر طبقا للشروط التي يحددها القانون العضوي . يمكن لكل من المجلس الشعبي الوطني و مجلس الأمة أن يعقد جلسات مغلقة بطلب من رئيسه، أو من أغلبية أعضائه الحاضرين، أو بطلب من الوزير الأول أو رئيس الحكومة ، حسب الحالة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_136_20201230_OpEnact_8a2f027fba> ;
