<https://legal.dz/resource/constitution/2020-12-30/2020#art_93_obligation_0_b5d4ee1d_ref_3f285270af55> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "الدستور"@ar ;
    dzdoc:frbrUri "/akn/dz/act/constitution/2020-12-30/1#"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/constitution/2020-12-30/1"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/constitution/2020-12-30/1#" ;
    dzdoc:referencesTarget <https://legal.dz/resource/constitution/2020-12-30/1> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceEId "art_93" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "لا يجوز، بأي حال من الأحوال أن يفوض رئيس الجمهورية سلطته في تعيين الوزير الأول أو رئيس الحكومة وأعضاء الحكومة وكذا رؤساء المؤسسات الدستورية وأعضائها الذين لم ينص الدستور على طريقة أخرى لتعيينهم."@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/constitution/2020-12-30/1"^^xsd:anyURI .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_93_obligation_1_ac3b5902_ref_3f285270af55> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "الدستور"@ar ;
    dzdoc:frbrUri "/akn/dz/act/constitution/2020-12-30/1#"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/constitution/2020-12-30/1"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/constitution/2020-12-30/1#" ;
    dzdoc:referencesTarget <https://legal.dz/resource/constitution/2020-12-30/1> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceEId "art_93" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "لا يجوز أن يفوض سلطته في اللجوء إلى الاستفتاء وحل المجلس الشعبي الوطني، وتقرير إجراء الانتخابات التشريعية قبل أوانها، وتطبيق الأحكام المنصوص عليها في المواد 91 و 92 ومن 97 إلى 100 و 102 و 142 و 148 و 149 و 150 من الدستور."@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/constitution/2020-12-30/1"^^xsd:anyURI .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_96_obligation_1_20aea0db> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
