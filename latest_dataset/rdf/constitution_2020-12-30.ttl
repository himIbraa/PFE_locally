<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_34> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تلزم الأحكام الدستورية ذات الصلة بالحقوق الأساسية والحريات العامة وضماناتها، جميع السلطات والهيئات العمومية . لا يمكن تقييد الحقوق والحريات والضمانات إلا بموجب قانون، ولأسباب مرتبطة بحفظ النظام العام والأمن، وحماية الثوابت الوطنية وكذا تلك الضرورية لحماية حقوق وحريات أخرى يكرسها الدستور . في كل الأحوال، لا يمكن أن تمس هذه القيود بجوهر الحقوق والحريات. تحقيقا للأمن القانوني تسهر الدولة، عند وضع التشريع المتعلق بالحقوق والحريات، على ضمان الوصول إليه ووضوحه واستقراره ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_34_20201230_OpEnact_ca5c4a8db1> ;
    dzdoc:replacementText "تلزم الأحكام الدستورية ذات الصلة بالحقوق الأساسية والحريات العامة وضماناتها، جميع السلطات والهيئات العمومية . لا يمكن تقييد الحقوق والحريات والضمانات إلا بموجب قانون، ولأسباب مرتبطة بحفظ النظام العام والأمن، وحماية الثوابت الوطنية وكذا تلك الضرورية لحماية حقوق وحريات أخرى يكرسها الدستور . في كل الأحوال، لا يمكن أن تمس هذه القيود بجوهر الحقوق والحريات. تحقيقا للأمن القانوني تسهر الدولة، عند وضع التشريع المتعلق بالحقوق والحريات، على ضمان الوصول إليه ووضوحه واستقراره ."@ar ;
