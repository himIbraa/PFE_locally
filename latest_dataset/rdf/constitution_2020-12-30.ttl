    dzdoc:text "يوقف العمل بالدستور مدة حالة الحرب، ويتولى رئيس الجمهورية جميع السلطات."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_101_para_1> a dzdoc:Paragraph ;
