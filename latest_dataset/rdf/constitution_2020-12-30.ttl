<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_17> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الجماعات المحلية للدولة هي البلدية والولاية البلدية هي الجماعة القاعدية . بغرض تحقيق توازن اقتصادي واجتماعي للبلديات محدودة التنمية، وتكفل أفضل باحتياجات سكانها ، يمكن أن يخص القانون بعض البلديات، الأقل تنمية، بتدابير خاصة."@ar ;
