dzterm:head_of_government a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "رئيس الحكومة"@ar,
        "رئيس حكومة"@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_104> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_2> ;
    dzdoc:eId "art_104" ;
    dzdoc:fullText "يعين رئيس الجمهورية أعضاء الحكومة بناء على اقتراح من الوزير الأول أو رئيس الحكومة ، حسب الحالة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_104> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_104_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_104_20201230_OpEnact_5044a2aaf0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_104_obligation_0_f305c3de> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "104" ;
    dzdoc:position 103 ;
    dzdoc:usesTerm dzterm:government,
        dzterm:head_of_government,
        dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_119> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_119" ;
    dzdoc:fullText "يمكن للحكومة أن تطلب من البرلمان المصادقة على مشاريع القوانين إجراء الاستعجال . يحدد قانون عضوي شروط وكيفيات تطبيق هذا الحكم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_119_permission_0_e0ce767d> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_119_right_0_56a06122> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_119> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_119_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_119_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_119_20201230_OpEnact_68e2842b2c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 119" ;
    dzdoc:position 118 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_120> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_120" ;
    dzdoc:fullText "يجرد المنتخب في المجلس الشعبي الوطني أو في مجلس الأمة المنتمى إلى حزب سياسي، الذي يغير طوعا الانتماء الذي انتخب على أساسه من عهدته الانتخابية بقوة القانون تعلن المحكمة الدستورية شغور المقعد بعد إخطارها وجوبا من رئيس الغرفة المعنية . ويحدد قانون عضوي كيفيات استخلافه. يحتفظ النائب الذي استقال من حزبه أو أبعد منه بعهدته بصفة نائب غير منتم ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_120_right_0_06498075> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_120> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_120_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_120_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_120_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_120_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_120_20201230_OpEnact_5310764ddd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_120_obligation_0_aa716a78>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_120_obligation_1_099b9d5c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 120" ;
    dzdoc:position 119 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_131> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_131" ;
    dzdoc:fullText "في حالة تلبس أحد النواب أو أحد أعضاء مجلس الأمة بجنحة أو جناية ، يمكن توقيفه، ويخطر بذلك مكتب المجلس الشعبي الوطني ، أو مكتب مجلس الأمة ، حسب الحالة، فورا. يمكن المكتب المخطر أن يطلب إيقاف المتابعة وإطلاق سراح النائب أو عضو مجلس الأمة ، على أن يعمل فيما بعد بأحكام المادة 130 أعلاه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_131_permission_0_2465574e>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_131_permission_1_1a226f47> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_131> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_131_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_131_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_131_20201230_OpEnact_e291f4051c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 131" ;
    dzdoc:position 130 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-12-30/2020#art_130> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_130> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_131_condition_0_69fbc225> ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_3> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "تقوم الدولة على مبادئ التمثيل الديمقراطي، والفصل بين السلطات، وضمان الحقوق والحريات والعدالة الاجتماعية . المجلس المنتخب هو الإطار الذي يعتبر فيه الشعب عن إرادته، ويراقب عمل السلطات العمومية. تشجع الدولة الديمقراطية التشاركية على مستوى الجماعات المحلية، لاسيما من خلال المجتمع المدني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_16_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_16_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_16_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_16_20201230_OpEnact_fe3aeb714d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_16_obligation_0_147931a4>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_16_obligation_1_d8eb53ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 16" ;
    dzdoc:position 15 ;
    dzdoc:usesTerm dzterm:elected_council,
        dzterm:state .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_160> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_نهائيا_وفي_هذه_الحالة_يأخذ_المجلس_الشعبي_الوطني_بالنص_الذي_أعدته_اللجنة> ;
    dzdoc:eId "art_160" ;
    dzdoc:fullText "يمكن أعضاء البرلمان استجواب الحكومة في أية مسألة ذات أهمية وطنية، وكذا عن حال تطبيق القوانين . ويكون الجواب خلال أجل أقصاه ثلاثون (30) يوما ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_160_permission_0_1a6b0bc6> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_160_right_0_aaf23c51> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_160> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_160_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_160_20201230_OpEnact_ef9e0c7633> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_160_obligation_0_a00bf2bf> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 160" ;
    dzdoc:position 159 ;
    dzdoc:usesTerm dzterm:government,
        dzterm:parliament .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_202> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_الثال> ;
    dzdoc:eId "art_202" ;
    dzdoc:fullText "تتولى السلطة الوطنية المستقلة للانتخابات مهمة تحضير وتنظيم وتسيير الانتخابات الرئاسية والتشريعية والمحلية وعمليات الاستفتاء والإشراف عليها . تمارس السلطة الوطنية المستقلة للانتخابات عمليات التسجيل في القوائم الانتخابية ومراجعتها، وعمليات تحضير العملية الانتخابية، وعمليات التصويت والفرز والبت في النزاعات الانتخابية حسب التشريع الساري المفعول . تمارس السلطة الوطنية المستقلة للانتخابات مهامها منذ تاريخ استدعاء الهيئة الانتخابية حتى إعلان النتائج المؤقتة للاقتراع . تمارس السلطة الوطنية المستقلة للانتخابات مهامها فى شفافية وحياد وعدم تحيز ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_202> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_202_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_202_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_202_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_202_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_202_20201230_OpEnact_0146cef655> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_202_obligation_0_f20a5e96>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_202_obligation_1_2e2991ed>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_202_obligation_2_7c976d95>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_202_obligation_3_92b5c482> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 202" ;
    dzdoc:position 201 ;
    dzdoc:usesTerm dzterm:independent_national_authority_for_elections .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_212> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_5> ;
    dzdoc:eId "art_212" ;
    dzdoc:fullText "يتولى المجلس مهمة الرقابة والإنذار المبكر و التقييم في مجال احترام حقوق الإنسان . يدرس المجلس، دون المساس بصلاحيات السلطة القضائية، كل حالات انتهاك حقوق الإنسان التي يعاينها أو تبلغ إلى علمه، ويقوم بكل إجراء مناسب في هذا الشأن. ويعرض نتائج تحقيقاته على السلطات الإدارية المعنية، وإذا اقتضى الأمر على الجهات القضائية المختصة. يبادر المجلس بأعمال التحسيس والإعلام والاتصال لترقية حقوق الإنسان. كما يبدي آراء واقتراحات وتوصيات تتعلق بترقية حقوق الإنسان وحمايتها. يعد المجلس تقريرا سنويا يرفعه إلى رئيس الجمهورية . ويتولى رئيس المجلس نشره. يحدد القانون تشكيلة المجلس وكيفيات تعيين أعضائه والقواعد المتعلقة بتنظيمه وسيره."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_212> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_212_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_212_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_212_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_212_para_3>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_212_para_4>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_212_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_212_20201230_OpEnact_05a72be0f2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_212_obligation_0_75223a8e>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_212_obligation_1_5140600e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 212" ;
    dzdoc:position 211 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_221> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_6> ;
    dzdoc:eId "art_221" ;
    dzdoc:fullText "إذا ارتأت المحكمة الدستورية أن مشروع أي تعديل دستوري لا يمس البتة المبادئ العامة التي تحكم المجتمع الجزائري، وحقوق الإنسان والمواطن وحرياتهما، ولا يمس بأي كيفية التوازنات الأساسية للسلطات والمؤسسات الدستورية، وعللت رأيها ، أمكن رئيس الجمهورية أن يصدر القانون الذي يتضمن التعديل الدستوري مباشرة دون أن يعرضه على الاستفتاء الشعبي، متى أحرز ثلاثة أرباع (4/3) أصوات أعضاء غرفتي البرلمان ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_221> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_221_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_221_20201230_OpEnact_956e193dd3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 221" ;
    dzdoc:position 220 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_221_condition_0_1f994962>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_221_condition_1_6b0ac28d> ;
    dzdoc:usesTerm dzterm:constitutional_court,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_26> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_3> ;
    dzdoc:eId "art_26" ;
    dzdoc:fullText "الإدارة في خدمة المواطن. يضمن القانون عدم تحيز الإدارة . تلزم الإدارة برد معلل في أجل معقول بشأن الطلبات التي تستوجب إصدار قرار إداري . تتعامل الإدارة بكل حياد مع الجمهور في إطار احترام الشرعية، وأداء الخدمة بدون تماطل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_26> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_26_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_26_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_26_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_26_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_26_20201230_OpEnact_f08d4600cd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_26_obligation_0_3f935d75>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_26_obligation_1_9f18784e>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_26_obligation_2_87e907f3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 26" ;
    dzdoc:position 25 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_1> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "اللغة العربية هي اللغة الوطنية والرسمية. تظل العربية اللغة الرسمية للدولة. يحدث لدى رئيس الجمهورية مجلس أعلى للغة العربية . يكلف المجلس الأعلى للغة العربية على الخصوص بالعمل على ازدهار اللغة العربية وتعميم استعمالها في الميادين العلمية والتكنولوجية والتشجيع على الترجمة إليها لهذه الغاية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_3_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_3_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_3_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_3_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_3_20201230_OpEnact_ccdfdf5f5c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_3_obligation_0_e4e38c0d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "3" ;
    dzdoc:position 2 ;
    dzdoc:usesTerm dzterm:arabic_language,
        dzterm:high_council_arabic,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_3> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "تمتنع الجزائر عن اللجوء إلى الحرب من أجل المساس بالسيادة المشروعة للشعوب الأخرى وحريتها . تبذل الجزائر جهدها لتسوية الخلافات الدولية بالوسائل السلمية . في إطار احترام مبادئ وأهداف الأمم المتحدة والاتحاد الإفريقي وجامعة الدول العربية ، يمكن للجزائر أن تشارك في حفظ السلم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_31_permission_0_a5e57032> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_31_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_31_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_31_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_31_20201230_OpEnact_17ab89d05d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_31_obligation_0_ed4a40d0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_31_obligation_1_ee91a7fd> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 31" ;
    dzdoc:position 30 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_31_condition_0_7c98273a> .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "لكل شخص الحق في حماية حياته الخاصة وشرفه . لكل شخص الحق في سرية مراسلاته واتصالاته الخاصة في أي شكل كانت . لا مساس بالحقوق المذكورة في الفقرتين الأولى والثانية إلا بأمر معلل من السلطة القضائية. حماية الأشخاص عند معالجة المعطيات ذات الطابع الشخصي حق أساسي . يعاقب القانون على كل انتهاك لهذه الحقوق."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_47_right_0_68beee07>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_47_right_1_5bea98d9>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_47_right_2_a68c5717> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_47_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_47_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_47_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_47_para_3>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_47_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_47_20201230_OpEnact_f84733f4cd> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "47" ;
    dzdoc:position 46 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "يحق لكل مواطن يتمتع بحقوقه المدنية والسياسية، أن يختار بحرية موطن إقامته، وأن يتنقل بحرية عبر التراب الوطني . لكل مواطن الحق في الدخول إلى التراب الوطني والخروج منه . لا يمكن تقييد هذه الحقوق إلا لمدة محددة، وبموجب قرار معلل من السلطة القضائية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_49_permission_0_70666074> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_49_right_0_8b3b2121>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_49_right_1_2f4ae287> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_49_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_49_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_49_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_49_20201230_OpEnact_09d3f6746f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "49" ;
    dzdoc:position 48 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "الملكية الخاصة مضمونة . لا تنزع الملكية إلا في إطار القانون، وبتعويض عادل ومنصف . حق الإرث مضمون الأملاك الوقفية و أملاك الجمعيات الخيرية معترف بها ، ويحمي القانون تخصيصها."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_60_right_0_6421b836>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_60_right_1_51711fef>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_60_right_2_85562f74> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_60_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_60_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_60_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_60_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_60_20201230_OpEnact_1b0f1a81ba> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_60_obligation_0_c941d9bd> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 60" ;
    dzdoc:position 59 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_63> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_63" ;
    dzdoc:fullText "تسهر الدولة على تمكين المواطن من : الحصول على ماء الشرب ، وتعمل على المحافظة عليه للأجيال القادمة الرعاية الصحية ، لاسيما للأشخاص المعوزين والوقاية من الأمراض المعدية والوبائية ومكافحتها الحصول على سكن ، لاسيما للفئات المحرومة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_63_right_0_66540009>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_63_right_1_4b92576c>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_63_right_2_cfdd7d34> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_63> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_63_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_63_20201230_OpEnact_7b1a44d4f5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_63_obligation_0_432ed4f8> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 63" ;
    dzdoc:position 62 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_1> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "مدة العهدة الرئاسية خمس (5) سنوات. لا يمكن لأحد ممارسة أكثر من عهدتين متتاليتين أو منفصلتين ، وفي حالة انقطاع العهدة الرئاسية بسبب استقالة رئيس الجمهورية الجارية عهدته أو لأي سبب كان، تعد عهدة كاملة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_88_permission_0_2372f2f8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_88_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_88_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_88_20201230_OpEnact_34cc50d833> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_88_obligation_0_8e7efd23> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 88" ;
    dzdoc:position 87 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_180> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_4> ;
    dzdoc:eId "art_180" ;
    dzdoc:fullText "يضمن المجلس الأعلى للقضاء استقلالية القضاء. يرأس رئيس الجمهورية المجلس الأعلى للقضاء . يمكن رئيس الجمهورية أن يكلف الرئيس الأول للمحكمة العليا برئاسة المجلس. يتشكل المجلس الأعلى للقضاء من : الرئيس الأول للمحكمة العليا، نائبا للرئيس، رئيس مجلس الدولة خمسة عشر (15) قاضيا ينتخبون من طرف زملائهم حسب التوزيع الآتي : ثلاثة (3) قضاة من المحكمة العليا من بينهم قاضيان اثنان (2) للحكم وقاض واحد (1) من النيابة العامة، ثلاثة (3) قضاة من مجلس الدولة، من بينهم قاضيان اثنان (2) للحكم و محافظ الدولة (1) ثلاثة (3) قضاة من المجالس القضائية، من بينهم قاضيان اثنان (2) للحكم وقاض واحد (1) من النيابة العامة، ثلاثة (3) قضاة من الجهات القضائية الإدارية غير قضاة مجلس الدولة، من بينهم قاضيان اثنان (2) للحكم ومحافظ الدولة (1) ثلاثة (3) قضاة من المحاكم الخاضعة للنظام القضائي العادي، من بينهم قاضيان اثنان (2) للحكم وقاض واحد (1) من النيابة العامة. ست (6) شخصيات يختارون بحكم كفاءاتهم خارج سلك القضاء، اثنان (2) منهم يختارهما رئيس الجمهورية، واثنان (2) يختارهما رئيس المجلس الشعبي الوطني من غير النواب، واثنان (2) يختارهما رئيس مجلس الأمة من غير أعضائه قاضيان اثنان (2) من التشكيل النقابي للقضاة، رئيس المجلس الوطني لحقوق الإنسان. يحدد قانون عضوي طرق انتخاب أعضاء المجلس الأعلى للقضاء وقواعد تنظيمه وعمله."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_180_permission_0_792841c4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_180> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_180_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_180_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_180_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_180_para_3>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_180_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_180_20201230_OpEnact_09f8b38813> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_180_obligation_0_6fe42ffd> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 180" ;
    dzdoc:position 179 ;
    dzdoc:usesTerm dzterm:president,
        dzterm:supreme_council_of_judiciary .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_1_sec_1> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "تمازيغت هي كذلك لغة وطنية ورسمية. تعمل الدولة لترقيتها وتطويرها بكل تنوعاتها اللسانية المستعملة عبر التراب الوطني . يحدث مجمع جزائري للغة تمازيغت يوضع لدى رئيس الجمهورية . يستند المجمع إلى أشغال الخبراء، ويكلف بتوفير الشروط اللازمة لترقية تمازيغت قصد تجسيد وضعها كلغة رسمية فيما بعد . تحدد كيفيات تطبيق هذه المادة بموجب قانون عضوي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_4_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_4_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_4_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_4_para_3>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_4_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_4_20201230_OpEnact_fd639439f7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_4_obligation_0_11c2d646>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_4_obligation_1_5f43e875> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "4" ;
    dzdoc:position 3 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-12-30/2020#art_4> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_4> ;
    dzdoc:usesTerm dzterm:academy_tamazight,
        dzterm:president,
        dzterm:tamazight .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_70" ;
    dzdoc:fullText "الحق في الإضراب معترف به ، ويمارس في إطار القانون. يمكن أن يمنع القانون ممارسة هذا الحق، أو يجعل حدودا لممارسته في ميادين الدفاع الوطني والأمن، أو في جميع الخدمات أو الأنشطة العمومية ذات المصلحة الحيوية للأمة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_70_permission_0_9656730d> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_70_right_0_ec8eef20> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_70_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_70_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_70_20201230_OpEnact_7607d49d44> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/2020-12-30/2020#art_70_prohibition_0_9656730d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 70" ;
    dzdoc:position 69 .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_84> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_1> ;
    dzdoc:eId "art_84" ;
    dzdoc:fullText "يجسد رئيس الجمهورية ، رئيس الدولة، وحدة الأمة، و يسهر في كل الظروف على وحدة التراب الوطني والسيادة الوطنية . يحمي الدستور ويسهر على احترامه . يجسد الدولة داخل البلاد وخارجها. له أن يخاطب الأمة مباشرة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_84_right_0_bdaf7158> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_84> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_84_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_84_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_84_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_84_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_84_20201230_OpEnact_7f9886b8a0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_84_obligation_0_e2aeb031>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_84_obligation_1_21894537> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 84" ;
    dzdoc:position 83 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_92> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_1> ;
    dzdoc:eId "art_92" ;
    dzdoc:fullText "يعين رئيس الجمهورية ، لاسيما في الوظائف والمهام الآتية : الوظائف والمهام المنصوص عليها في الدستور ، الوظائف المدنية والعسكرية في الدولة، التعيينات التي تتم في مجلس الوزراء باقتراح من الوزير الأول أو رئيس الحكومة، حسب الحالة، الرئيس الأول للمحكمة العليا، رئيس مجلس الدولة، الأمين العام للحكومة محافظ بنك الجزائر، القضاة، مسؤولى أجهزة الأمن الولاة، الأعضاء المسيرين لسلطات الضبط. ويعين رئيس الجمهورية سفراء الجمهورية والمبعوثين فوق العادة إلى الخارج، وينهى مهامهم. ويتسلم أوراق اعتماد الممثلين الدبلوماسيين الأجانب وأوراق إنهاء مهامهم. بالإضافة إلى الوظائف المنصوص عليها في الحالتين 4 و 5 أعلاه، يحدد قانون عضوي الوظائف القضائية الأخرى التي يعين فيها رئيس الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_92> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_92_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_92_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_92_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_92_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_92_20201230_OpEnact_f21f1223d6> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 92" ;
    dzdoc:position 91 ;
    dzdoc:referencesExternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_92_extref_3f285270> ;
    dzdoc:usesTerm dzterm:president .

