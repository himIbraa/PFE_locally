<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_118> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتفرغ النائب أو عضو مجلس الأمة كليا لممارسة عهدته . ينص النظام الداخلي لكل من المجلس الشعبي الوطني و مجلس الأمة على أحكام تتعلق بوجوب المشاركة الفعلية لأعضائهما في أشغال اللجان وفي الجلسات العامة ، تحت طائلة العقوبات المطبقة في حالة الغياب. تصوت كل غرفة من غرفتى البرلمان على القوانين واللوائح بحضور أغلبية أعضائها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_118_20201230_OpEnact_faa0a5ab79> ;
    dzdoc:replacementText "يتفرغ النائب أو عضو مجلس الأمة كليا لممارسة عهدته . ينص النظام الداخلي لكل من المجلس الشعبي الوطني و مجلس الأمة على أحكام تتعلق بوجوب المشاركة الفعلية لأعضائهما في أشغال اللجان وفي الجلسات العامة ، تحت طائلة العقوبات المطبقة في حالة الغياب. تصوت كل غرفة من غرفتى البرلمان على القوانين واللوائح بحضور أغلبية أعضائها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_118> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/2020-12-30/2020> ;
