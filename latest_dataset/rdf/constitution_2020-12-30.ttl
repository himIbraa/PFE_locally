dzterm:government a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الحكومة"@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_220> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_6> ;
    dzdoc:eId "art_220" ;
    dzdoc:fullText "يصبح القانون الذي يتضمن مشروع التعديل الدستوري لاغيا، إذا رفضه الشعب . ولا يمكن عرضه من جديد على الشعب خلال نفس الفترة التشريعية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_220_permission_0_4a61eea6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_220> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_220_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_220_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_220_20201230_OpEnact_83614656d1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_220_obligation_0_adce3b4e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 220" ;
    dzdoc:position 219 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_220_condition_0_8870ca08> .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_74> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_74" ;
    dzdoc:fullText "حرية الإبداع الفكري، بما في ذلك أبعاده العلمية والفنية، مضمونة . لا يمكن تقييد هذه الحرية إلا عند المساس بكرامة الأشخاص أو بالمصالح العليا للأمة أو القيم والثوابت الوطنية . القانون الحقوق المترتبة على الإبداع الفكري. في حالة نقل الحقوق الناجمة عن الإبداع الفكري، يمكن للدولة ممارسة حق الشفعة لحماية المصلحة العامة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_74_permission_0_a9f57c1a>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_74_permission_1_fa6ae486> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_74_right_0_8ef010f9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_74> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_74_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_74_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_74_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_74_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_74_20201230_OpEnact_bd7b994e63> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 74" ;
    dzdoc:position 73 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_74_condition_0_f13ca66c> .

dzterm:apn a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المجلس الشعبي الوطني"@ar .

dzterm:prime_minister a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوزير الأول"@ar,
        "وزير أول"@ar,
        "وزيرا أول"@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_122> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_122" ;
    dzdoc:fullText "ينتخب المجلس الشعبي الوطني لعهدة مدتها خمس (5) سنوات. تحدد عهدة مجلس الأمة بمدة ست (6) سنوات. تجدد تشكيلة مجلس الأمة بالنصف كل ثلاث (3) سنوات. لا يمكن تمديد عهدة البرلمان إلا فى ظروف خطيرة جدا لا تسمح بإجراء انتخابات عادية . ويثبت البرلمان المنعقد بغرفتيه المجتمعتين معا هذه الحالة بقرار ، بناء على اقتراح رئيس الجمهورية واستشارة المحكمة الدستورية لا يمكن لأحد ممارسة أكثر من عهدتين برلمانيتين منفصلتين أو متتاليتين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_122_permission_0_63d8643f>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_122_permission_1_fbe47e4b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_122> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_122_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_122_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_122_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_122_para_3>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_122_para_4>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_122_para_5> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_122_20201230_OpEnact_41b13530c9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 122" ;
    dzdoc:position 121 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_122_condition_0_3ec9701c> ;
    dzdoc:usesTerm dzterm:constitutional_court,
        dzterm:council_of_nation,
        dzterm:national_peoples_assembly,
        dzterm:parliament,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_138> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_3> ;
    dzdoc:eId "art_138" ;
    dzdoc:fullText "يجتمع البرلمان في دورة عادية واحدة كل سنة، مدتها عشرة (10) أشهر، وتبتدئ في ثاني يوم عمل من شهر سبتمبر، وتنتهي في آخر يوم عمل من شهر يونيو. يمكن الوزير الأول أو رئيس الحكومة ، حسب الحالة، طلب تمديد الدورة العادية لأيام معدودة لغرض الانتهاء من دراسة نقطة في جدول الأعمال. يمكن أن يجتمع البرلمان في دورة غير عادية بمبادرة من رئيس الجمهورية . يمكن البرلمان كذلك أن يجتمع بناء على استدعاء من رئيس الجمهورية بطلب من الوزير الأول أو رئيس الحكومة ، حسب الحالة، أو بطلب من ثلثي (3/2) أعضاء المجلس الشعبي الوطني . تختتم الدورة غير العادية بمجرد ما يستنفد البرلمان جدول الأعمال الذي استدعي من أجله."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_138_permission_0_9e4f8443>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_138_permission_1_055b0e92>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_138_permission_2_38866890> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_138> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_138_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_138_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_138_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_138_para_3>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_138_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_138_20201230_OpEnact_cdb7f07007> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 138" ;
    dzdoc:position 137 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:head_of_government,
        dzterm:parliament,
        dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_149> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_نهائيا_وفي_هذه_الحالة_يأخذ_المجلس_الشعبي_الوطني_بالنص_الذي_أعدته_اللجنة> ;
    dzdoc:eId "art_149" ;
    dzdoc:fullText "يمكن رئيس الجمهورية أن يطلب قراءة ثانية في قانون تم التصويت عليه في غضون الثلاثين (30) يوما الموالية لتاريخ المصادقة عليه . في هذه الحالة لا تتم المصادقة على القانون إلا بأغلبية ثلثي (3/2) أعضاء المجلس الشعبي الوطني وأعضاء مجلس الأمة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_149_permission_0_080584c6> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_149_right_0_51cea039> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_149> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_149_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_149_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_149_20201230_OpEnact_e19e7b4c0f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 149" ;
    dzdoc:position 148 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_149_condition_0_29c8430d> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_193> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_1> ;
    dzdoc:eId "art_193" ;
    dzdoc:fullText "تخطر المحكمة الدستورية من رئيس الجمهورية أو رئيس مجلس الأمة أو رئيس المجلس الشعبي الوطني أو من الوزير الأول أو رئيس الحكومة، حسب الحالة. يمكن إخطارها كذلك من أربعين (40) نائبا أو خمسة وعشرين (25) عضوا في مجلس الأمة. لا تمتد ممارسة الإخطار المبين في الفقرتين الأولى والثانية إلى الإخطار بالدفع بعدم الدستورية المبين في المادة 195 أدناه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_193_permission_0_6f184f0d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_193> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_193_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_193_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_193_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_193_20201230_OpEnact_a70c5a0c5d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "193" ;
    dzdoc:position 192 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-12-30/2020#art_195> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_195> ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_198> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_1> ;
    dzdoc:eId "art_198" ;
    dzdoc:fullText "إذا قررت المحكمة الدستورية عدم دستورية معاهدة أو اتفاق أو اتفاقية ، فلا يتم التصديق عليها . إذا قررت المحكمة الدستورية عدم دستورية قانون ، لا يتم إصداره . إذا قررت المحكمة الدستورية عدم دستورية أمر أو تنظيم ، فإن هذا النص يفقد أثره، ابتداء من يوم صدور قرار المحكمة الدستورية . إذا قررت المحكمة الدستورية أن نصا تشريعيا أو تنظيميا غير دستوري على أساس المادة 195 أعلاه ، يفقد أثره ابتداء من اليوم الذي يحدده قرار المحكمة الدستورية . تكون قرارات المحكمة الدستورية نهائية وملزمة لجميع السلطات العمومية والسلطات الإدارية والقضائية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_198> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_198_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_198_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_198_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_198_para_3>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_198_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_198_20201230_OpEnact_db0c7cd576> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_198_obligation_0_a7e41b08>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_198_obligation_1_cd56248a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 198" ;
    dzdoc:position 197 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-12-30/2020#art_195> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_195> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_198_condition_0_a8b79c63>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_198_condition_1_ca243377>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_198_condition_2_95d3f530>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_198_condition_3_43005188> ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_219> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_6> ;
    dzdoc:eId "art_219" ;
    dzdoc:fullText "ل رئيس الجمهورية حق المبادرة بالتعديل الدستوري . بعد أن يصوت المجلس الشعبي الوطني و مجلس الأمة على المبادرة بنفس الصيغة حسب الشروط نفسها التي تطبق على نص تشريعي ، يعرض التعديل على الشعب للاستفتاء عليه خلال الخمسين (50) يوما الموالية لإقراره. يصدر رئيس الجمهورية التعديل الدستوري الذي صادق عليه الشعب."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_219_right_0_d606ac4e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_219> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_219_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_219_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_219_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_219_20201230_OpEnact_eb2414e61d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 219" ;
    dzdoc:position 218 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_219_condition_0_c9179fe0> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_nation,
        dzterm:president .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_1> ;
    dzdoc:eId "art_87" ;
    dzdoc:fullText "يشترط في المترشح لرئاسة الجمهورية أن : يتمتع بالجنسية الجزائرية الأصلية فقط، ويثبت الجنسية الجزائرية الأصلية للأب والأم، لا يكون قد تجنس بجنسية أجنبية يدين بالإسلام يبلغ سن الأربعين (40) كاملة يوم إيداع طلب الترشح، يتمتع بكامل حقوقه المدنية والسياسية، يثبت أن زوجه يتمتع بالجنسية الجزائرية الأصلية فقط، يثبت إقامة دائمة بالجزائر دون سواها لمدة عشر (10) سنوات، على الأقل، قبل إيداع الترشح، يثبت مشاركته في ثورة أول نوفمبر 1954 إذا كان مولودا قبل يوليو 1942، يثبت تأديته الخدمة الوطنية أو المبرر القانوني لعدم تأديتها، يثبت عدم تورط أبويه في أعمال ضد ثورة أول نوفمبر 1954 إذا كان مولودا بعد يوليو 1942، يقدم التصريح العلني بممتلكاته العقارية والمنقولة داخل الوطن وخارجه. يحدد قانون عضوي كيفيات تطبيق أحكام هذه المادة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_87> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_87_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_87_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_87_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_87_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_87_20201230_OpEnact_8e6731ec4e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 87" ;
    dzdoc:position 86 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-12-30/2020#art_87> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_87> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_87_condition_0_fabd4be0> .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_106> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_3_sec_2> ;
    dzdoc:eId "art_106" ;
    dzdoc:fullText "يقدم الوزير الأول مخطط عمل الحكومة إلى المجلس الشعبي الوطني للموافقة عليه . ويجري المجلس الشعبي الوطني لهذا الغرض مناقشة عامة. يمكن الوزير الأول أن يكيف مخطط عمل الحكومة على ضوء مناقشة المجلس الشعبي الوطني بالتشاور مع رئيس الجمهورية . يقدم الوزير الأول عرضا حول مخطط عمل الحكومة لمجلس الأمة مثلما وافق عليه المجلس الشعبي الوطني . يمكن لمجلس الأمة ، في هذا الإطار، أن يصدر لائحة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_106_permission_0_05432d80>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_106_permission_1_2ea9f9c9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_106> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_106_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_106_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_106_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_106_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_106_20201230_OpEnact_5c5db9f64d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_106_obligation_0_f2d782e8>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_106_obligation_1_08a65c2a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "106" ;
    dzdoc:position 105 ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:government,
        dzterm:national_peoples_assembly,
        dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_189> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_1> ;
    dzdoc:eId "art_189" ;
    dzdoc:fullText "يتمتع أعضاء المحكمة الدستورية بالحصانة عن الأعمال المرتبطة بممارسة مهامهم . لا يمكن أن يكون عضو المحكمة الدستورية محل متابعة قضائية بسبب الأعمال غير المرتبطة بممارسة مهامه إلا بتنازل صريح منه عن الحصانة أو بإذن من المحكمة الدستورية . يحدد النظام الداخلي للمحكمة الدستورية إجراءات رفع الحصانة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_189_permission_0_13a6be2a> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_189_right_0_d5564935> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_189> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_189_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_189_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_189_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_189_20201230_OpEnact_5663693363> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "189" ;
    dzdoc:position 188 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_189_condition_0_9bcb5417>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_189_condition_1_42cb3070>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_189_condition_2_7043ab21> ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_195> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_4_sec_1> ;
    dzdoc:eId "art_195" ;
    dzdoc:fullText "يمكن إخطار المحكمة الدستورية بالدفع بعدم الدستورية بناء على إحالة من المحكمة العليا أو مجلس الدولة، عندما يدعي أحد الأطراف في المحاكمة أمام جهة قضائية أن الحكم التشريعي أو التنظيمي الذي يتوقف عليه مآل النزاع ينتهك حقوقه وحرياته التي يضمنها الدستور . عندما تخطر المحكمة الدستورية على أساس الفقرة أعلاه، فإن قرارها يصدر خلال الأشهر الأربعة (4) التي تلي تاريخ إخطارها. ويمكن تمديد هذا الأجل مرة واحدة لمدة أقصاها أربعة (4) أشهر، بناء على قرار مسبب من المحكمة ويبلغ إلى الجهة القضائية صاحبة الإخطار."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_195_permission_0_f3d233bf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_195> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_195_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_195_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_195_20201230_OpEnact_6cb5acc467> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "195" ;
    dzdoc:position 194 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_195_condition_0_6047e368> ;
    dzdoc:usesTerm dzterm:constitutional_court .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "تلزم الأحكام الدستورية ذات الصلة بالحقوق الأساسية والحريات العامة وضماناتها، جميع السلطات والهيئات العمومية . لا يمكن تقييد الحقوق والحريات والضمانات إلا بموجب قانون، ولأسباب مرتبطة بحفظ النظام العام والأمن، وحماية الثوابت الوطنية وكذا تلك الضرورية لحماية حقوق وحريات أخرى يكرسها الدستور . في كل الأحوال، لا يمكن أن تمس هذه القيود بجوهر الحقوق والحريات. تحقيقا للأمن القانوني تسهر الدولة، عند وضع التشريع المتعلق بالحقوق والحريات، على ضمان الوصول إليه ووضوحه واستقراره ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/2020-12-30/2020#art_34_permission_0_8e7e728f>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_34_permission_1_dedbfc06> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_34_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_34_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_34_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_34_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_34_20201230_OpEnact_ca5c4a8db1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_34_obligation_0_9a0309aa>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_34_obligation_1_d6398b4a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "34" ;
    dzdoc:position 33 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_34_condition_0_d6fc2f17> .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_58> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_58" ;
    dzdoc:fullText "تستفيد الأحزاب السياسية المعتمدة، ودون أي تمييز، في ظل احترام أحكام المادة 57 أعلاه، على الخصوص، من الحقوق الآتية : حريات الرأي والتعبير والاجتماع والتظاهر السلمي حيز زمني في وسائل الإعلام العمومية يتناسب مع تمثيلها على المستوى الوطني تمويل عمومي ، عند الاقتضاء، يحدده القانون حسب تمثيلها ، ممارسة السلطة على الصعيدين المحلي والوطني من خلال التداول الديمقراطي، وفي إطار أحكام هذا الدستور . يحدد القانون كيفيات تطبيق هذه المادة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_58_right_0_cea6ecfb>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_58_right_1_7571ea71>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_58_right_2_d463023c>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_58_right_3_209e79b5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_58> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_58_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_58_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_58_20201230_OpEnact_c7e501cb64> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_58_obligation_0_78695498> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 58" ;
    dzdoc:position 57 ;
    dzdoc:references <https://legal.dz/resource/constitution/2020-12-30/2020#art_57> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_57> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/2020-12-30/2020#art_58_condition_0_aed12f03> ;
    dzdoc:usesTerm dzterm:political_parties .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_71> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#chp_2_sec_1> ;
    dzdoc:eId "art_71" ;
    dzdoc:fullText "تحظى الأسرة بحماية الدولة . حقوق الطفل محمية من طرف الدولة والأسرة مع مراعاة المصلحة العليا للطفل. تحمي وتكفل الدولة الأطفال المتخلى عنهم أو مجهولي النسب . تحت طائلة المتابعات الجزائية، يلزم الأولياء بضمان تربية أبنائهم . تحت طائلة المتابعات الجزائية، يلزم الأبناء بواجب القيام بالإحسان إلى أوليائهم ومساعدتهم . يعاقب القانون كل أشكال العنف ضد الأطفال واستغلالهم والتخلي عنهم. تسعى الدولة إلى ضمان المساعدة والحماية للمسنين ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/2020-12-30/2020#art_71_right_0_eaf2ca54> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_71> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_71_para_0>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_71_para_1>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_71_para_2>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_71_para_3>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_71_para_4>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_71_para_5>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_71_para_6> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_71_20201230_OpEnact_6164801a70> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/2020-12-30/2020#art_71_obligation_0_515dc55b>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_71_obligation_1_86e4e736>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_71_obligation_2_4e753c7a>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_71_obligation_3_f66d8fb7>,
        <https://legal.dz/resource/constitution/2020-12-30/2020#art_71_obligation_4_8e0fc40d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:introducedOn "2020-12-30"^^xsd:date ;
    dzdoc:number "المادة 71" ;
    dzdoc:position 70 .

