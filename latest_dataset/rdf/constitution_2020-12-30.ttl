<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_188> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعين رئيس الجمهورية رئيس المحكمة الدستورية لعهدة واحدة مدتها ست (6) سنوات، على أن تتوفر فيه الشروط المنصوص عليها في المادة 87 من الدستور باستثناء شرط السن . يضطلع أعضاء المحكمة الدستورية بمهامهم مرة واحدة مدتها ست (6) سنوات، ويجدد نصف عدد أعضاء المحكمة الدستورية كل ثلاث (3) سنوات. يحدد النظام الداخلي للمحكمة الدستورية شروط وكيفيات التجديد الجزئي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_188_20201230_OpEnact_02c1032ab0> ;
    dzdoc:replacementText "يعين رئيس الجمهورية رئيس المحكمة الدستورية لعهدة واحدة مدتها ست (6) سنوات، على أن تتوفر فيه الشروط المنصوص عليها في المادة 87 من الدستور باستثناء شرط السن . يضطلع أعضاء المحكمة الدستورية بمهامهم مرة واحدة مدتها ست (6) سنوات، ويجدد نصف عدد أعضاء المحكمة الدستورية كل ثلاث (3) سنوات. يحدد النظام الداخلي للمحكمة الدستورية شروط وكيفيات التجديد الجزئي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_188> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/2020-12-30/2020#art_188> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2020-12-30"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_189> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتمتع أعضاء المحكمة الدستورية بالحصانة عن الأعمال المرتبطة بممارسة مهامهم . لا يمكن أن يكون عضو المحكمة الدستورية محل متابعة قضائية بسبب الأعمال غير المرتبطة بممارسة مهامه إلا بتنازل صريح منه عن الحصانة أو بإذن من المحكمة الدستورية . يحدد النظام الداخلي للمحكمة الدستورية إجراءات رفع الحصانة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
