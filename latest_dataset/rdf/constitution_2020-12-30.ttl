    dznorm:position 1 ;
    dznorm:provisionText "يستقيل الوزير الأول أو رئيس الحكومة، حسب الحالة، وجوبا إذا ترشح لرئاسة الجمهورية"@ar ;
    dznorm:sourceArticle "art_96" .

