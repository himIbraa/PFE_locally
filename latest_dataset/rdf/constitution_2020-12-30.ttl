<https://legal.dz/resource/constitution/2020-12-30/2020#art_93_obligation_0_b5d4ee1d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/constitution/2020-12-30/2020#art_93_obligation_0_b5d4ee1d_ref_3f285270af55> ;
    dzdoc:hasRole <https://legal.dz/resource/constitution/2020-12-30/2020#art_93_obligation_0_b5d4ee1d_role_8261374a44> ;
    dzdoc:referencesExternal <https://legal.dz/resource/constitution/2020-12-30/2020#art_93_obligation_0_b5d4ee1d_ref_3f285270af55> ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_93> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يجوز، بأي حال من الأحوال أن يفوض رئيس الجمهورية سلطته في تعيين الوزير الأول أو رئيس الحكومة وأعضاء الحكومة وكذا رؤساء المؤسسات الدستورية وأعضائها الذين لم ينص الدستور على طريقة أخرى لتعيينهم."@ar ;
    dznorm:sourceArticle "art_93" .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_93_obligation_0_b5d4ee1d_role_8261374a44> a dznorm:Role ;
    rdfs:label "طريقة أخرى لتعيينهم"@ar ;
