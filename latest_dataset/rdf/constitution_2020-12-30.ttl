<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_50> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتمتع كل أجنبي يتواجد فوق التراب الوطني بشكل قانوني بحماية القانون لشخصه وأملاكه . لا يمكن تسليم أحد إلا بمقتضى اتفاقية دولية مصادق عليها، أو بموجب قانون. لا يمكن، في أي حال، تسليم أو إبعاد أي لاجئ سياسي استفاد قانونا من حق اللجوء."@ar ;
