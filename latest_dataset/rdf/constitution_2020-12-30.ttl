<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_152> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن البرلمان أن يفتح مناقشة حول السياسة الخارجية بناء على طلب رئيس الجمهورية أو رئيس إحدى الغرفتين . يمكن أن تتوج هذه المناقشة، عند الاقتضاء، بإصدار البرلمان المنعقد بغرفتيه المجتمعتين معا، لائحة يبلغها إلى رئيس الجمهورية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
