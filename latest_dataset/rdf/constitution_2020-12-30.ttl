<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_16> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقوم الدولة على مبادئ التمثيل الديمقراطي، والفصل بين السلطات، وضمان الحقوق والحريات والعدالة الاجتماعية . المجلس المنتخب هو الإطار الذي يعتبر فيه الشعب عن إرادته، ويراقب عمل السلطات العمومية. تشجع الدولة الديمقراطية التشاركية على مستوى الجماعات المحلية، لاسيما من خلال المجتمع المدني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_16_20201230_OpEnact_fe3aeb714d> ;
    dzdoc:replacementText "تقوم الدولة على مبادئ التمثيل الديمقراطي، والفصل بين السلطات، وضمان الحقوق والحريات والعدالة الاجتماعية . المجلس المنتخب هو الإطار الذي يعتبر فيه الشعب عن إرادته، ويراقب عمل السلطات العمومية. تشجع الدولة الديمقراطية التشاركية على مستوى الجماعات المحلية، لاسيما من خلال المجتمع المدني ."@ar ;
