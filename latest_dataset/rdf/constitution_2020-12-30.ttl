    dznorm:expressedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_95> .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_95_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_95> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما ينال ترشيح للانتخابات الرئاسية موافقة المحكمة الدستورية، لا يمكن سحبه إلا في حالة حصول مانع خطير تثبته المحكمة الدستورية قانونا أو في حالة وفاة المترشح المعني."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_95_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_95> ;
    dzdoc:position 1 ;
    dzdoc:text "عند انسحاب أحد المترشحين من الدور الثاني، تستمر العملية الانتخابية دون أخذ هذا الانسحاب في الحسبان."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_95_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_95> ;
    dzdoc:position 2 ;
    dzdoc:text "في حالة وفاة أحد المترشحين للدور الثاني أو تعرضه لمانع قانوني، تعلن المحكمة الدستورية وجوب إجراء كل العمليات الانتخابية من جديد وتمدد في هذه الحالة أجال تنظيم انتخابات جديدة لمدة أقصاها ستون (60) يوما."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_95_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_95> ;
    dzdoc:position 3 ;
    dzdoc:text "عند تطبيق أحكام هذه المادة، يظل رئيس الجمهورية السارية عهدته أو من يتولى وظيفة رئيس الدولة، في منصبه حتى أداء رئيس الجمهورية اليمين."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_95_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_95> ;
    dzdoc:position 4 ;
    dzdoc:text "يحدد قانون عضوي شروط وكيفيات تطبيق أحكام هذه المادة."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_95_permission_0_39839585> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/constitution/2020-12-30/2020#art_95_permission_0_39839585_action_3a70f94605> ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_95> ;
    dznorm:position 0 ;
    dznorm:provisionText "عندما ينال ترشيح للانتخابات الرئاسية موافقة المحكمة الدستورية، لا يمكن سحبه إلا في حالة حصول مانع خطير تثبته المحكمة الدستورية قانونا أو في حالة وفاة المترشح المعني."@ar ;
    dznorm:sourceArticle "art_95" .

