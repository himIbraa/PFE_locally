<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_127> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "النائب أو عضو مجلس الأمة مسؤول أمام زملائه الذين يمكنهم تجريده من عهدته إن اقترف فعلا يخل بشرفها . يحدد النظام الداخلي لكل واحدة من الغرفتين، الشروط التي يتعرض فيها أي نائب أو عضو مجلس الأمة للإقصاء، ويقرر هذا الإقصاء، حسب الحالة، المجلس الشعبي الوطني أو مجلس الأمة بأغلبية أعضائه، دون المساس بجميع المتابعات الأخرى الواردة في القانون"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_127_20201230_OpEnact_77053ac40f> ;
