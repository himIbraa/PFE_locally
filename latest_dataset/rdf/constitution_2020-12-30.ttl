    dzdoc:text "يتمتع أعضاء المحكمة الدستورية بالحصانة عن الأعمال المرتبطة بممارسة مهامهم."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_189_para_1> a dzdoc:Paragraph ;
