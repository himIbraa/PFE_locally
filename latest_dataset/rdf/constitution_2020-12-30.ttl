<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_102> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوقع رئيس الجمهورية اتفاقيات الهدنة ومعاهدات السلم . يلتمس رئيس الجمهورية رأي المحكمة الدستورية بشأن الاتفاقيات المتعلقة بهما . يعرض رئيس الجمهورية تلك الاتفاقيات فورا على كل غرفة من البرلمان لتوافق عليها صراحة ."@ar ;
