<https://legal.dz/resource/constitution/2020-12-30/2020#art_219_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_219> ;
    dzdoc:position 0 ;
    dzdoc:text "لرئيس الجمهورية حق المبادرة بالتعديل الدستوري."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_219_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_219> ;
