    dzdoc:hasParagraph <https://legal.dz/resource/constitution/2020-12-30/2020#art_182_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_182_20201230_OpEnact_e9ba50a0c5> ;
