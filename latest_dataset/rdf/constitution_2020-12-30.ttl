<https://legal.dz/resource/constitution/2020-12-30/2020#art_142_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/2020-12-30/2020#art_142> ;
    dzdoc:position 0 ;
    dzdoc:text "لرئيس الجمهورية أن يشرع بأوامر في مسائل عاجلة في حالة شغور المجلس الشعبي الوطني أو خلال العطلة البرلمانية بعد رأي مجلس الدولة."@ar .

<https://legal.dz/resource/constitution/2020-12-30/2020#art_142_para_1> a dzdoc:Paragraph ;
