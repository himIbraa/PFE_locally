<https://legal.dz/resource/constitution/2020-12-30/2020#version_art_213> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/2020-12-30/2020> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المرصد الوطني للمجتمع المدني هيئة استشارية لدى رئيس الجمهورية. يقدم المرصد آراء وتوصيات متعلقة بانشغالات المجتمع المدني. يساهم المرصد في ترقية القيم الوطنية والممارسة الديمقراطية والمواطنة ويشارك مع المؤسسات الأخرى في تحقيق أهداف التنمية الوطنية. يحدد رئيس الجمهورية تشكيلة المرصد ومهامه الأخرى."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/2020-12-30/2020#version_art_213_20201230_OpEnact_196a9a30f8> ;
    dzdoc:replacementText "المرصد الوطني للمجتمع المدني هيئة استشارية لدى رئيس الجمهورية. يقدم المرصد آراء وتوصيات متعلقة بانشغالات المجتمع المدني. يساهم المرصد في ترقية القيم الوطنية والممارسة الديمقراطية والمواطنة ويشارك مع المؤسسات الأخرى في تحقيق أهداف التنمية الوطنية. يحدد رئيس الجمهورية تشكيلة المرصد ومهامه الأخرى."@ar ;
