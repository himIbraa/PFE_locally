    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "يعلن رئيس الجمهورية الحرب و يبرم السلم بموافقة المجلس الوطني ."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_45_19631208_OpEnact_64328b70e5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
