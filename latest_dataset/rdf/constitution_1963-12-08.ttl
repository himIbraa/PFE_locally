<https://legal.dz/resource/constitution/1963-12-08/1963#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "الجزائر جمهورية ديمقراطية شعبية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_1_19631208_OpEnact_7f5f5eaac2> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "الأولى" ;
    dzdoc:position 0 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_11" ;
    dzdoc:fullText "توافق الجمهورية على الاعلان العالمي لحقوق الانسان و تنضم الى كل منظمة دولية تستجيب لمطامح الشعب الجزائري و ذلك اقتناعا منها بضرورة التعاون الدولي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_11> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_11_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_11_19631208_OpEnact_3aed800848> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "11" ;
    dzdoc:position 10 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_2" ;
    dzdoc:fullText "و هي جزء لا يتجزأ من المغرب العربي و العالم العربي و افريقيا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_2_19631208_OpEnact_5a18417035> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "2" ;
    dzdoc:position 1 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "جبهة التحرير الوطني تحدد سياسة الأمة، و توحي بعمل الدولة و تراقب عمل المجلس الوطني و الحكومة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_24_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_24_19631208_OpEnact_41867143ed> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 24" ;
    dzdoc:position 23 ;
    dzdoc:usesTerm dzterm:fln,
        dzterm:national_assembly .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "جبهة التحرير الوطني تشخص المطامح العميقة للجماهير و تهذبها و تنظمها و هي رائدها في تحقيق مطامحها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_25> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_25_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_25_19631208_OpEnact_623e656886> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 25" ;
    dzdoc:position 24 ;
    dzdoc:usesTerm dzterm:fln .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_26> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_26" ;
    dzdoc:fullText "جبهة التحرير الوطني تنجز أهداف الثورة الديمقراطية الشعبية، و تشيد الاشتراكية في الجزائر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_26> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_26_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_26_19631208_OpEnact_21e71f5de4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 26" ;
    dzdoc:position 25 ;
    dzdoc:usesTerm dzterm:fln .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_27" ;
    dzdoc:fullText "السيادة الوطنية للشعب يمارسها بواسطة ممثلين له قي مجلس وطني ، ترشحهم جبهة التحرير الوطني ، و ينتخبون باقتراع عام مباشر و سرى لمدة خمسة سنين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_27_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_27_19631208_OpEnact_6fe6845a00> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 27" ;
    dzdoc:position 26 ;
    dzdoc:usesTerm dzterm:fln,
        dzterm:national_assembly .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "يعبر المجلس الوطني عن الارادة الشعبية، و يتولى التصويت على القوانين، و يراقب النشاط الحكومي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_28_19631208_OpEnact_2a176595ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 28" ;
    dzdoc:position 27 ;
    dzdoc:usesTerm dzterm:national_assembly .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "شعارها “الثورة من الشعب و للشعب”."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_3_19631208_OpEnact_68b18e6c41> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "3" ;
    dzdoc:position 2 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "رئيس المجلس الوطني هو الشخصية الثانية في الدولة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_34_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_34_19631208_OpEnact_0328fe8087> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 34" ;
    dzdoc:position 33 ;
    dzdoc:usesTerm dzterm:رئيس_المجلس_الوطني .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_43> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_43" ;
    dzdoc:fullText "و هو القائد الأعلى للقوات المسلحة للجمهورية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_43> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_43_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_43_19631208_OpEnact_63aa9c8047> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 43" ;
    dzdoc:position 42 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_45" ;
    dzdoc:fullText "يترأس رئيس الجمهورية المجلس الأعلى للدفاع و المجلس الأعلى للقضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_45> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_45_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_45_19631208_OpEnact_64328b70e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 45" ;
    dzdoc:position 44 ;
    dzdoc:usesTerm dzterm:president,
        dzterm:supreme_defense_council,
        dzterm:supreme_judicial_council .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "يتولى رئيس الجمهورية تحديد سياسة الحكومة و توجيهها، كما يقوم بتسيير و تنسيق السياسة الداخلية و الخارجية للبلاد طبقا لإرادة الشعب التي يجسمها الحزب، و يعبر عنها المجلس الوطني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_48_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_48_19631208_OpEnact_b146eb8d00> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 48" ;
    dzdoc:position 47 ;
    dzdoc:usesTerm dzterm:national_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_52" ;
    dzdoc:fullText "يتولى رئيس الجمهورية تنفيذ القوانين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_52_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_52_19631208_OpEnact_90b435da70> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 52" ;
    dzdoc:position 51 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "تمارس السلطة النظامية من رئيس الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_53_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_53_19631208_OpEnact_1ea59d4e5d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 53" ;
    dzdoc:position 52 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_54> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_54" ;
    dzdoc:fullText "يعين رئيس الجمهورية الموظفين في جميع المناصب المدنية و العسكرية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_54> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_54_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_54_19631208_OpEnact_96d125a6ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 54" ;
    dzdoc:position 53 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "علم الدولة أخضر و أبيض يتوسطه هلال و نجم أحمران."@ar ;
