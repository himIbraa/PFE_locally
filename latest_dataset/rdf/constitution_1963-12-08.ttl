<https://legal.dz/resource/constitution/1963-12-08/1963#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "يفصل المجلس الدستوري في دستورية القوانين و الأوامر التشريعية بطلب من رئيس الجمهورية أو رئيس المجلس الوطني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_64_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_64_19631208_OpEnact_af213dff9f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 64" ;
    dzdoc:position 63 ;
    dzdoc:usesTerm dzterm:constitutional_council .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_66> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_66" ;
    dzdoc:fullText "اختصاصات المجلس الأعلى للقضاء و قواعد سيره تحدد بقانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_66> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_66_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_66_19631208_OpEnact_52ee22fe4f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 66" ;
    dzdoc:position 65 ;
    dzdoc:usesTerm dzterm:supreme_council_judiciary .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "يستشار المجلس في جميع المسائل العسكرية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_68_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_68_19631208_OpEnact_a593a0a349> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 68" ;
    dzdoc:position 67 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "عاصمة البلاد الجزائرية هي مدينة الجزائر، مقر المجلس الوطني و الحكومة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_7_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_7_19631208_OpEnact_1235856711> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "7" ;
    dzdoc:position 6 ;
    dzdoc:usesTerm dzterm:government,
        dzterm:national_council .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_70" ;
    dzdoc:fullText "يستشار المجلس الأعلى الإقتصادي والإجتماعي في جميع مشروعات و مقترحات القانون ذات الطابع الإقتصادي و الإجتماعي، و يمكنه الإستماع الى أعضاء الحكومة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_70_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_70_19631208_OpEnact_ed49fc26a4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 70" ;
    dzdoc:position 69 ;
    dzdoc:usesTerm dzterm:economic_social_council .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_71> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_71" ;
    dzdoc:fullText "ترجع المبادرة بتعديل الدستور الى كل من رئيس الجمهورية و الأغلبية المطلقة لأعضاء المجلس الوطني معا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_71> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_71_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_71_19631208_OpEnact_4179f6dfd6> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 71" ;
    dzdoc:position 70 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "يتضمن إجراء تعديل الدستور، تلاوتين و تصويتين بالأغلبية المطلقة لأعضاء المجلس الوطني يفصل بينهما أجل شهرين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_72_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_72_19631208_OpEnact_9ef1de1bc1> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 72" ;
    dzdoc:position 71 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_73> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_73" ;
    dzdoc:fullText "يعرض مشروع قانون التعديل على مصادقة الشعب عن طريقة الإستفتاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_73> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_73_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_73_19631208_OpEnact_20a3a652ed> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 73" ;
    dzdoc:position 72 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_75> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_75" ;
    dzdoc:fullText "النشيد الوطني مؤقتا هو “قسما”، و سيتولى قانون غير دستوري تحديد النشيد الوطني في المستقبل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_75> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_75_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_75_19631208_OpEnact_790392b3cc> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 75" ;
    dzdoc:position 74 ;
    dzdoc:usesTerm dzterm:national_anthem .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "يصدر رئيس الجمهورية مشروع الدستور في ظرف ثمانية أيام بعد مصادقة الشعب عليه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_78> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_78_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_78_19631208_OpEnact_649e88e5ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 78" ;
    dzdoc:position 77 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_17" ;
    dzdoc:fullText "تحمي الدولة الأسرة باعتبارها الخلية الأساسية للمجتمع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_17> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_17_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_17_19631208_OpEnact_efdf4e09bc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_17_obligation_0_9fa5af61> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "17" ;
    dzdoc:position 16 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "تضمن الجمهورية الجزائرية حق الإلتجاء لكل من يكافح في سبيل الحرية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_21_right_0_a9676ca4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_21_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_21_19631208_OpEnact_389b489946> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 21" ;
    dzdoc:position 20 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:definesTerm dzterm:fln ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "جبهة التحرير الوطني هي حزب الطليعة الواحد في الجزائر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_23> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1963-12-08/1963#art_23_defocc_c639dd328858> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_23_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_23_19631208_OpEnact_5677a54a45> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 23" ;
    dzdoc:position 22 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_29" ;
    dzdoc:fullText "يحدد القانون طريقة انتخاب النواب في المجلس الوطني و عددهم، و شروط صلاحية انتخابهم، و نظام ما يتنافى و النيابة. و في حالة النزاع حول قانونية انتخاب النائب، تتولى “لجنة مراجعة السلط و تصحيح النيابة” المنصوص عليها في النظام الداخلي للمجلس، الفصل في الموضوع طبقا للشروط المحددة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_29_para_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_29_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_29_19631208_OpEnact_3986872ba6> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 29" ;
    dzdoc:position 28 ;
    dzdoc:usesTerm dzterm:national_assembly .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_35> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_35" ;
    dzdoc:fullText "يحدد المجلس الوطني في قانونه الداخلي قواعد تنظيمه و تسييره ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_35> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_35_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_35_19631208_OpEnact_acfa8880e2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_35_obligation_0_f9a951ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 35" ;
    dzdoc:position 34 ;
    dzdoc:usesTerm dzterm:المجلس_الوطني .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "لأعضاء الحكومة حق حضور جلسات المجلس الوطني و المشاركة في مناقشة اللجان ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_37_right_0_72754e91> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_37_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_37_19631208_OpEnact_c9d51e8323> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 37" ;
    dzdoc:position 36 ;
    dzdoc:usesTerm dzterm:المجلس_الوطني .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "يؤدي رئيس الجمهورية قبل مباشرته لمهام وظيفته القسم أمام المجلس الوطني بالعبارات التالية : (وفاء لمبادئ ثورتنا و لأرواح شهدائنا، أقسم بالله العظيم ان أحترم الدستور و أدافع عليه و أحافظ على سلامة الوطن و استقلال البلاد و وحدتها، و أن أبذل كل جهدي لرعاية مصالح الشعب و الجمهورية الديمقراطية الشعبية)."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_40_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_40_19631208_OpEnact_daed3f7b76> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_40_obligation_0_be3d94be> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 40" ;
    dzdoc:position 39 ;
    dzdoc:usesTerm dzterm:المجلس_الوطني,
        dzterm:رئيس_الجمهورية .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "يعلن رئيس الجمهورية الحرب و يبرم السلم بموافقة المجلس الوطني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_44_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_44_19631208_OpEnact_326f5dc0b3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_44_obligation_0_27a65368> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 44" ;
    dzdoc:position 43 ;
    dzdoc:usesTerm dzterm:المجلس_الوطني,
        dzterm:رئيس_الجمهورية .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_46> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_46" ;
    dzdoc:fullText "يمارس رئيس الجمهورية حق العفو بعد إستشارة المجلس الأعلى للقضاء ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_46_right_0_c6e1a56c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_46> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_46_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_46_19631208_OpEnact_9fc30b9e5e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 46" ;
    dzdoc:position 45 ;
    dzdoc:usesTerm dzterm:president,
        dzterm:supreme_judicial_council .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:definesTerm dzterm:arabic_language ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_5" ;
    dzdoc:fullText "اللغة العربية هي اللغة القومية و الرسمية للدولة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_5> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1963-12-08/1963#art_5_defocc_0e25bbb82176> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_5_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_5_19631208_OpEnact_8198813988> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "5" ;
    dzdoc:position 4 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "يقضى باسم الشعب الجزائري طبقا للشروط التي يحددها قانون التنظيم القضائي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_60_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_60_19631208_OpEnact_074f3e54e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 60" ;
    dzdoc:position 59 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1963-12-08/1963#art_60_condition_0_0474750f> .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_61> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_61" ;
    dzdoc:fullText "يعترف بحق الدفاع و يكون مضمونا في الجنايات ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_61_right_0_738eb197> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_61> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_61_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_61_19631208_OpEnact_a1fc7924a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 61" ;
    dzdoc:position 60 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_63> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_63" ;
    dzdoc:fullText "يتألف المجلس الدستوري من الرئيس الأول للمحكمة العليا، و رئيسي الحجرتين المدنية والإدارية في المحكمة العليا و ثلاثة نواب يعينهم المجلس الوطني و عضو يعينه رئيس الجمهورية. ينتخب أعضاء المجلس الدستوري رئيسهم الذي ليس له صوت مرجح."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_63> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_63_para_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_63_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_63_19631208_OpEnact_c6499da9e4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 63" ;
    dzdoc:position 62 ;
    dzdoc:usesTerm dzterm:constitutional_council .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_65> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:definesTerm dzterm:supreme_council_judiciary ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_65" ;
    dzdoc:fullText "المجلس الأعلى للقضاء : يتألف المجلس الأعلى للقضاء من رئيس الجمهورية و وزير العدل، و الرئيس الأول للمحكمة العليا، و وكيل الدولة العام لديها، و محام لدى المحكمة العليا، وإثنين من رجال القضاء أحدهما من قضاة الصلح، ينتخبان من طرف زملائهم على المستوى الوطني و ستة أعضاء تنتخبهم لجنة العدل الدائمة في المجلس الوطني من بين أعضائها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_65> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1963-12-08/1963#art_65_defocc_bb291425fbe8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_65_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_65_19631208_OpEnact_a46668f0f2> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 65" ;
    dzdoc:position 64 ;
    dzdoc:usesTerm dzterm:supreme_council_judiciary .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_67> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:definesTerm dzterm:supreme_council_defense ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_67" ;
    dzdoc:fullText "المجلس الأعلى للدفاع : يتألف المجلس الأعلى للدفاع من رئيس الجمهورية و وزير الدفاع الوطني، و وزير الداخلية، و وزير الشؤون الخارجية، و رئيس لجنة الدفاع الوطني في المجلس، و عضوين يعينهما رئيس الجمهورية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_67> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1963-12-08/1963#art_67_defocc_3235e06b841c> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_67_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_67_19631208_OpEnact_60c31386a5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 67" ;
    dzdoc:position 66 ;
    dzdoc:usesTerm dzterm:supreme_council_defense .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "يمدد أجل النيابة التشريعية لأعضاء المجلس الوطني التأسيسي المنتخب بتاريخ 20 سبتمبر 1962، حتى تاريخ 20 سبتمبر 1964. و تجرى قبل هذا التاريخ انتخابات المجلس الوطني طبقا للدستور، و لمدة أربع سنوات. و يواصل رئيس الحكومة أداء مهامه الراهنة حتى يتم انتخاب رئيس الجمهورية الذي يتعين أن يجرى خلال أجل أقصاه شهر بعد المصادقة على الدستور عن طريق الإستفتاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_77_para_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_77_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_77_19631208_OpEnact_8865609aca> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 77" ;
    dzdoc:position 76 ;
    dzdoc:usesTerm dzterm:head_of_government,
        dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "الجيش الوطني جيش شعبي، و هو في خدمة الشعب و تحت تصرف الحكومة بحكم وفائه لتقاليد الكفاح من أجل التحرير الوطني. و هو يتولى الدفاع عن أراضي الجمهورية و يسهم في مناحي النشاط السياسي و الاقتصادي و الاجتماعي للبلاد في نطاق الحزب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_8_para_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_8_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_8_19631208_OpEnact_71bb8a938d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "8" ;
    dzdoc:position 7 ;
    dzdoc:usesTerm dzterm:government,
        dzterm:national_army .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_9" ;
    dzdoc:fullText "تتكون الجمهورية من مجموعات ادارية يتولى القانون تحديد مداها و اختصاصها. تعتبر البلدية أساسا للمجموعة الترابية و الاقتصادية و الاجتماعية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_9_para_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_9_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_9_19631208_OpEnact_fe496e4e77> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "9" ;
    dzdoc:position 8 ;
    dzdoc:usesTerm dzterm:municipality .

dzterm:المجلس_الوطني a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المجلس الوطني"@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "تتمثل الأهداف الأساسية للجمهورية الجزائرية الديمقراطية الشعبية في : صيانة الاستقلال الوطني و سلامة الأراضي الوطنية و الوحدة الوطنية. ممارسة السلطة من طرف الشعب الذي يؤلف طليعته فلاحون و عمال و مثقفون ثوريون. تشييد ديمقراطية اشتراكية، و مقاومة استغلال الانسان في جميع اشكاله، وضمان حق العمل و مجانية التعليم ، و تصفية جميع بقايا الاستعمار. الدفاع عن الحرية و احترام كرامة الانسان. مقاومة كل نوع من التمييز و خاصة التمييز العنصري و الديني. السلام في العالم. استنكار التعذيب و كل مساس حسي أو معنوي بكيان الانسان."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_10_right_0_e28174ad>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_10_right_1_e31bf900> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_10_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_10_19631208_OpEnact_f725ed8f81> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "10" ;
    dzdoc:position 9 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "لكل المواطنين من الجنسين نفس الحقوق و نفس الواجبات ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_12_right_0_3e1a4cf2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_12_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_12_19631208_OpEnact_cba0c13e2d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_12_obligation_0_61f3e72b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "12" ;
    dzdoc:position 11 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_13" ;
    dzdoc:fullText "لكل مواطن استكمل 19 عاما من عمره حق التصويت ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_13_right_0_7d432cd4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_13> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_13_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_13_19631208_OpEnact_25a4fa7950> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "13" ;
    dzdoc:position 12 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1963-12-08/1963#art_13_condition_0_2b3e40dc> .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "تعترف الجمهورية بـ حق كل فرد في حياة لائقة و في توزيع عادل للدخل القومي ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_16_right_0_a0518e27>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_16_right_1_697a4bb3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_16_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_16_19631208_OpEnact_40dd32414e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "16" ;
    dzdoc:position 15 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "التعليم اجباري ، و الثقافة في متناول الجميع بدون تمييز الا ما كان ناشئا عن استعدادات كل فرد و حاجيات الجماعة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_18_right_0_0938e6ea> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_18_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_18_19631208_OpEnact_a24da4fe24> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_18_obligation_0_92a9edc9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 18" ;
    dzdoc:position 17 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "يتمتع النائب بالحصانة البرلمانية خلال مدة نيابته ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_31_right_0_d5058618> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_31_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_31_19631208_OpEnact_9c49a9e82a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 31" ;
    dzdoc:position 30 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "يمارس المجلس الوطني مراقبته للنشاط الحكومي بواسطة : الاستماع الى الوزراء داخل اللجان السؤال الكتابي. السؤال الشفوي مع المناقشة أو بدونها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_38_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_38_19631208_OpEnact_10ed183c44> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_38_obligation_0_a6214d0d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 38" ;
    dzdoc:position 37 ;
    dzdoc:usesTerm dzterm:المجلس_الوطني .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_41> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_41" ;
    dzdoc:fullText "يعتمد لدى رئيس الجمهورية السفراء الأجانب و المبعثون فوق العادة. و يعين السفراء و المبعثون فوق العادة باقتراح من طرف وزير الشؤون الخارجية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_41> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_41_para_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_41_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_41_19631208_OpEnact_25eb92bdf0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_41_obligation_0_31e60b13> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 41" ;
    dzdoc:position 40 ;
    dzdoc:usesTerm dzterm:رئيس_الجمهورية,
        dzterm:وزير_الشؤون_الخارجية .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "اذا لم يصدر رئيس الجمهورية القوانين في الآجال المنصوص عليها فإن رئيس المجلس الوطني يتول إصدارها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_51_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_51_19631208_OpEnact_8a58b0f683> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_51_obligation_0_472349d4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 51" ;
    dzdoc:position 50 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1963-12-08/1963#art_51_condition_0_0adedcee> ;
    dzdoc:usesTerm dzterm:national_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_55> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_55" ;
    dzdoc:fullText "يطعن المجلس الوطني في مسؤولية رئيس الجمهورية بإيداع لائحة سحب الثقة ، يتعين توقيعها من طرف ثلث النواب الذين يتكون منهم المجلس ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_55_right_0_8bc02078> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_55> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_55_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_55_19631208_OpEnact_c99eda942b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 55" ;
    dzdoc:position 54 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1963-12-08/1963#art_55_condition_0_4d6d802f> ;
    dzdoc:usesTerm dzterm:national_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_57> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_57" ;
    dzdoc:fullText "في حالة استقالة رئيس الجمهورية أو وفاته أو عجزه النهائي أو سحب الثقة من الحكومة ، يمارس المجلس الوطني مهام رئيس الجمهورية ، و يساعده فيها رؤساء اللجان في المجلس الوطني . و مهمته الأساسية تصريف الشؤون العادية، وإعداد الانتخابات في ظرف شهرين لتعيين رئيس الجمهورية و أعضاء المجلس الوطني في حالة حله."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_57> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_57_para_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_57_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_57_19631208_OpEnact_86d1ee9d2c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 57" ;
    dzdoc:position 56 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1963-12-08/1963#art_57_condition_0_0f892452> ;
    dzdoc:usesTerm dzterm:national_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "لا يخضع القضاة في ممارستهم لوظائفهم إلا للقانون و لمصالح الثورة الاشتراكية . إستقلالهم مضمون بالقانون و بوجود المجلس الأعلى للقضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_62_para_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_62_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_62_19631208_OpEnact_08dfa63be5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_62_obligation_0_940251a7> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 62" ;
    dzdoc:position 61 ;
    dzdoc:usesTerm dzterm:supreme_council_judiciary .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:definesTerm dzterm:economic_social_council ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "المجلس الأعلى الإقتصادي و الإجتماعي : يتألف المجلس الأعلى الإقتصادي و الإجتماعي من خمسة نواب يعينهم المجلس الوطني، و مدير التصميم، و حاكم البنك المركزي للجزائر و المسؤولون عن المنظمات القومية و ممثلين للنواحي الرئيسية من النشاط القومي الإقتصادي والإجتماعي يعينهم رئيس الجمهورية. ينتخب المجلس الأعلى الاقتصادي و الاجتماعي رئيسه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_69> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1963-12-08/1963#art_69_defocc_2398aefe26a9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_69_para_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_69_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_69_19631208_OpEnact_906853d2ad> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 69" ;
    dzdoc:position 68 ;
    dzdoc:usesTerm dzterm:economic_social_council .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_74> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_74" ;
    dzdoc:fullText "في حالة مصادقة الشعب على مشروع تعديل الدستور يتم إصداره من طرف رئيس الجمهورية باعتباره قانونا دستوريا خلال الأيام الثمانية الموالية لتاريخ الإستفتاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_74> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_74_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_74_19631208_OpEnact_ea00e3c260> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 74" ;
    dzdoc:position 73 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1963-12-08/1963#art_74_condition_0_37df1603> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_20" ;
    dzdoc:fullText "الحق النقابي ، و حق الاضراب ، و مشاركة العمال في تدبير المؤسسات معترف بها جميعا، و تمارس هذه الحقوق في نطاق القانون."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_20_right_0_1afd1b3c>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_20_right_1_0c5a5d57>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_20_right_2_544d61e5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_20> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_20_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_20_19631208_OpEnact_a209fc8547> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 20" ;
    dzdoc:position 19 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "يجتمع المجلس الوطني وجوبا قبل اليوم الخامس عشر الموالي لانتخاب أعضائه و يعمد الى تصحيح نيابتهم . و ينتخب فورا رئيسه و مكتبه و لجانه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_33_para_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_33_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_33_19631208_OpEnact_229e20197b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_33_obligation_0_abf78a21>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_33_obligation_1_83c8c79f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 33" ;
    dzdoc:position 32 ;
    dzdoc:usesTerm dzterm:المجلس_الوطني .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "يوقع رئيس الجمهورية بعد استشارة المجلس الوطني و يصادق على المعاهدات والإتفاقيات و المواثيق الدولية و يسهر على تنفيذها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_42> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_42_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_42_19631208_OpEnact_bc044c8c07> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_42_obligation_0_eecaeeb1> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 42" ;
    dzdoc:position 41 ;
    dzdoc:usesTerm dzterm:المجلس_الوطني,
        dzterm:رئيس_الجمهورية .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "رئيس الجمهورية هو المسؤول الوحيد أمام المجلس الوطني ، يعين الوزراء الذين يجب أن يختار الثلثي 3/2 منهم على الأقل من بين النواب و يقدمهم الى المجلس ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_47_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_47_19631208_OpEnact_9e33990d9d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_47_obligation_0_38da1914> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 47" ;
    dzdoc:position 46 ;
    dzdoc:usesTerm dzterm:national_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "لا يمكن ايقاف أي شخص و لا متابعته الا في الأحوال المنصوص عليها في القانون و أمام القضاة المعينين بمقتضاه و طبقا للإجراءات المقررة بموجبه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1963-12-08/1963#art_15_permission_0_25f68534> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_15_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_15_19631208_OpEnact_33ba865935> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_15_obligation_0_946ff8f7> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "15" ;
    dzdoc:position 14 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_30" ;
    dzdoc:fullText "لا يمكن للمجلس الوطني الاعلان عن اسقاط النائب الا بأغلبية ثلثي أعضائه و باقتراح من الهيئة العليا لجبهة التحرير الوطني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1963-12-08/1963#art_30_permission_0_5112d80c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_30> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_30_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_30_19631208_OpEnact_2ee16f47fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 30" ;
    dzdoc:position 29 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1963-12-08/1963#art_30_condition_0_5318c671> .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "الاسلام دين الدولة و تضمن الجمهورية لكل فرد احترام أرائه و معتقداته و حرية ممارسة الاديان ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_4_right_0_6c0c2d56> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_4_19631208_OpEnact_f53323fa2e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_4_obligation_0_027b8cb9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "4" ;
    dzdoc:position 3 ;
    dzdoc:usesTerm dzterm:islam .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "في حالة الخطر الوشيك الوقوع يمكن لـ رئيس الجمهورية اتخاذ تدابير استثنائية لحماية استقلال الأمة و مؤسسات الجمهورية. و يجتمع المجلس الوطني وجوبا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1963-12-08/1963#art_59_permission_0_0c1fb4ff> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_59_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_59_19631208_OpEnact_a2523ccf6f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_59_obligation_0_ba562a9e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 59" ;
    dzdoc:position 58 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1963-12-08/1963#art_59_condition_0_589ba1a7> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "ل رئيس الجمهورية و لل نواب حق المبادرة بتقديم القوانين . توضع مشاريع و اقتراحات و تصميمات القوانين على مكتب المجلس الذي يحيلها على اللجان البرلمانية المختصة لدراستها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_36_right_0_63d871ec> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_36_para_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_36_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_36_19631208_OpEnact_c742f0b34f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_36_obligation_0_83079796> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 36" ;
    dzdoc:position 35 ;
    dzdoc:usesTerm dzterm:رئيس_الجمهورية,
        dzterm:نواب .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "يجب تحقيق تعميم اللغة العربية في أقرب وقت ممكن في كامل أراضي الجمهورية . بيد أنه، خلافا لأحكام هذا القانون، سوف يجوز استعمال اللغة الفرنسية مؤقتا الى جانب اللغة العربية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1963-12-08/1963#art_76_permission_0_bdfb4bb7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_76_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_76_19631208_OpEnact_908760755c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_76_obligation_0_7e71d916> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 76" ;
    dzdoc:position 75 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_19" ;
    dzdoc:fullText "تضمن الجمهورية حرية الصحافة ، و حرية وسائل الاعلام الأخرى ، و حرية تأسيس الجمعيات ، و حرية التعبير ، و مخاطبة الجمهور و حرية الإجتماع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_19_right_0_a03aac9d>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_19_right_1_0814f830>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_19_right_2_b053d3b2>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_19_right_3_46051426>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_19_right_4_bf097dfc>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_19_right_5_a3fe6125> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_19_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_19_19631208_OpEnact_db8d225229> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 19" ;
    dzdoc:position 18 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_22> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_22" ;
    dzdoc:fullText "لا يجوز لأي كان أن يستعمل الحقوق و الحريات السالفة الذكر في المساس باستقلال الأمة و سلامة الأراضي الوطنية و الوحدة الوطنية و مؤسسات الجمهورية و مطامح الشعب الإشتراكية، ومبدأ وحدانية جبهة التحرير الوطني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1963-12-08/1963#art_22_permission_0_c3cb7d43> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_22> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_22_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_22_19631208_OpEnact_d7ae057d98> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_22_obligation_0_e2910780> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1963-12-08/1963#art_22_prohibition_0_c3cb7d43> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 22" ;
    dzdoc:position 21 .

dzterm:national_assembly a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المجلس الوطني"@ar,
        "مجلس وطني"@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "يجوز ل رئيس الجمهورية أن يطلب من المجلس الوطني برسالة مبينة الأسباب خلال الأجل المحدد لاصدار القوانين، للتداول في شأنها مرة ثانية ، و لا يمكن رفض طلبه هذا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1963-12-08/1963#art_50_permission_0_1feb876a> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_50_right_0_b4a12fa4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_50> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_50_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_50_19631208_OpEnact_1e6d16559c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 50" ;
    dzdoc:position 49 ;
    dzdoc:usesTerm dzterm:national_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_58> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_58" ;
    dzdoc:fullText "يجوز ل رئيس الجمهورية أن يطلب من المجلس الوطني التفويض له لمدة محدودة حق اتخاذ تدابير ذات صبغة تشريعية عن طريق أوامر تشريعية تتخذ في نطاق مجلس الوزراء أو تعرض على مصادقة المجلس في أجل ثلاثة أشهر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1963-12-08/1963#art_58_permission_0_da202711> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_58_right_0_f72a1473> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_58> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_58_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_58_19631208_OpEnact_5953a2b581> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 58" ;
    dzdoc:position 57 ;
    dzdoc:usesTerm dzterm:national_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_39" ;
    dzdoc:fullText "تسند السلطة التنفيذية الى رئيس الدولة الذي يحمل لقب رئيس الجمهورية . و هو ينتخب لمدة خمس سنوات عن طريق الإقتراع العام المباشر و السري بعد تعيينه من طرف الحزب. يمكن لكل مسلم جزائري الأصل بلغ عمره 35 سنة على الأقل و متمتع بحقوقه المدنية و السياسية أن ينتخب رئيسا للجمهورية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1963-12-08/1963#art_39_permission_0_fff8dc1b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_39> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_39_para_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_39_para_1>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_39_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_39_19631208_OpEnact_250eced1db> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_39_obligation_0_9a0f3f7f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 39" ;
    dzdoc:position 38 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1963-12-08/1963#art_39_condition_0_064b689a> ;
    dzdoc:usesTerm dzterm:رئيس_الجمهورية .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "يكلف رئيس الجمهورية باصدار القوانين و نشرها . يصدر القوانين خلال الأيام العشرة الموالية لإحالتها عليه من طرف المجلس الوطني ، و يوقع مرسومات التطبيق. و يمكن التخفيض من أجل الأيام العشرة عندما يطلب المجلس الوطني الاستعجال ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1963-12-08/1963#art_49_permission_0_f49156f8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_49_para_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_49_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_49_19631208_OpEnact_3723545d8e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_49_obligation_0_7f9e0638>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_49_obligation_1_a91e10b4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 49" ;
    dzdoc:position 48 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1963-12-08/1963#art_49_condition_0_631c4ea4> ;
    dzdoc:usesTerm dzterm:national_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_14" ;
    dzdoc:fullText "لا يجوز الإعتداء على حرمة السكن ، و يضمن حفظ سر المراسلة لجميع المواطنين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1963-12-08/1963#art_14_permission_0_5f55cfad> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_14_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_14_19631208_OpEnact_b507b8a309> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_14_obligation_0_46c9cf7e>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_14_obligation_1_9dcb147d> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1963-12-08/1963#art_14_prohibition_0_5f55cfad> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "14" ;
    dzdoc:position 13 .

dzterm:president a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "رئيس الجمهورية"@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_56> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_56" ;
    dzdoc:fullText "التصويت على لائحة سحب الثقة بالأغلبية المطلقة لنواب المجلس الوطني يوجب استقالة رئيس الجمهورية و الحل التلقائي للمجلس. و لا يجوز الإلتجاء الى هذا التصويت العلني إلا بعد مضي أجل خمسة أيام كاملة على إيداع اللائحة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1963-12-08/1963#art_56_permission_0_b7ad7123> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_56> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_56_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_56_19631208_OpEnact_11eff20a42> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1963-12-08/1963#art_56_prohibition_0_b7ad7123> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 56" ;
    dzdoc:position 55 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1963-12-08/1963#art_56_condition_0_405d7b81>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_56_condition_1_8dc049f6> ;
    dzdoc:usesTerm dzterm:national_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_32> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#body> ;
    dzdoc:eId "art_32" ;
    dzdoc:fullText "لا يجوز ايقاف أي نائب ، أو متابعته فيما يتعلق بالقضايا الجنائية دون اذن المجلس الوطني الا في حالة التلبس بالجريمة ، و يوقف حبس أو متابعة النائب بطلب من المجلس الوطني . و في حالة التلبس بالجريمة يقدم فورا اخطار المتابعة أو الإجراءات المتخذة ضد النائب الى مكتب المجلس الذي يمكنه ان يطالب بموجب سلطة القانون اتخاذ التدابير الضرورية لاحترام مبدأ الحصانة البرلمانية . و لا تجوز متابعة أي عضو من أعضاء المجلس الوطني ، أو ايقافه أو حبسه، أو محاكمته بسبب ما يدلي به من آراء أو تصويت خلال ممارسة نيابته ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1963-12-08/1963#art_32_permission_0_960d89f7> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1963-12-08/1963#art_32_right_0_b347de1a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_32> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_32_para_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_32_para_1>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_32_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_32_19631208_OpEnact_240ba080fd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1963-12-08/1963#art_32_obligation_0_e28ff2bd>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_32_obligation_1_26eb65f5>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_32_obligation_2_d5a16443> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1963-12-08/1963#art_32_prohibition_0_960d89f7> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:introducedOn "1963-12-08"^^xsd:date ;
    dzdoc:number "المادة 32" ;
    dzdoc:position 31 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1963-12-08/1963#art_32_condition_0_e634d12f>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#art_32_condition_1_49d0660d> ;
    dzdoc:usesTerm dzterm:المجلس_الوطني,
        dzterm:نائب .

<https://legal.dz/resource/constitution/1963-12-08/1963#preamble> a dzdoc:Preamble ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:hasCitation <https://legal.dz/resource/constitution/1963-12-08/1963#preamble_segment_0>,
        <https://legal.dz/resource/constitution/1963-12-08/1963#preamble_segment_1>,
