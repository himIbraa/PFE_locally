    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "الجزائر جمهورية ديمقراطية شعبية."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_20_19631208_OpEnact_a209fc8547> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_20> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_20> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_20> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "الحق النقابي ، و حق الاضراب ، و مشاركة العمال في تدبير المؤسسات معترف بها جميعا، و تمارس هذه الحقوق في نطاق القانون."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_21_19631208_OpEnact_389b489946> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_21> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_21> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_21> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "تضمن الجمهورية الجزائرية حق الإلتجاء لكل من يكافح في سبيل الحرية ."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_22_19631208_OpEnact_d7ae057d98> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_22> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_22> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_22> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "لا يجوز لأي كان أن يستعمل الحقوق و الحريات السالفة الذكر في المساس باستقلال الأمة و سلامة الأراضي الوطنية و الوحدة الوطنية و مؤسسات الجمهورية و مطامح الشعب الإشتراكية، ومبدأ وحدانية جبهة التحرير الوطني ."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_23_19631208_OpEnact_5677a54a45> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_23> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_23> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_23> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "جبهة التحرير الوطني هي حزب الطليعة الواحد في الجزائر ."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_24_19631208_OpEnact_41867143ed> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_24> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_24> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_24> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "جبهة التحرير الوطني تحدد سياسة الأمة، و توحي بعمل الدولة و تراقب عمل المجلس الوطني و الحكومة."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_25_19631208_OpEnact_623e656886> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_25> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_25> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_25> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "جبهة التحرير الوطني تشخص المطامح العميقة للجماهير و تهذبها و تنظمها و هي رائدها في تحقيق مطامحها."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_26_19631208_OpEnact_21e71f5de4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_26> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_26> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_26> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "جبهة التحرير الوطني تنجز أهداف الثورة الديمقراطية الشعبية، و تشيد الاشتراكية في الجزائر."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_27_19631208_OpEnact_6fe6845a00> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_27> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_27> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_27> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "السيادة الوطنية للشعب يمارسها بواسطة ممثلين له قي مجلس وطني ، ترشحهم جبهة التحرير الوطني ، و ينتخبون باقتراع عام مباشر و سرى لمدة خمسة سنين."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_28_19631208_OpEnact_2a176595ff> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
