<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_9> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتكون الجمهورية من مجموعات ادارية يتولى القانون تحديد مداها و اختصاصها. تعتبر البلدية أساسا للمجموعة الترابية و الاقتصادية و الاجتماعية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
