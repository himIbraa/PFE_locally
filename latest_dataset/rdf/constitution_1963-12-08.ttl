<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_57> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة استقالة رئيس الجمهورية أو وفاته أو عجزه النهائي أو سحب الثقة من الحكومة ، يمارس المجلس الوطني مهام رئيس الجمهورية ، و يساعده فيها رؤساء اللجان في المجلس الوطني . و مهمته الأساسية تصريف الشؤون العادية، وإعداد الانتخابات في ظرف شهرين لتعيين رئيس الجمهورية و أعضاء المجلس الوطني في حالة حله."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
