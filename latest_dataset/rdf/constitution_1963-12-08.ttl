    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_4> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "الاسلام دين الدولة و تضمن الجمهورية لكل فرد احترام أرائه و معتقداته و حرية ممارسة الاديان ."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_50_19631208_OpEnact_1e6d16559c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
