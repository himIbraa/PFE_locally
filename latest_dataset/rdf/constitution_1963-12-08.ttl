    dznorm:sourceArticle "art_62" .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_62_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_62> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يخضع القضاة في ممارستهم لوظائفهم إلا للقانون و لمصالح الثورة الاشتراكية."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_62_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_62> ;
    dzdoc:position 1 ;
    dzdoc:text "إستقلالهم مضمون بالقانون و بوجود المجلس الأعلى للقضاء."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_63_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_63> ;
    dzdoc:position 0 ;
    dzdoc:text "يتألف المجلس الدستوري من الرئيس الأول للمحكمة العليا، و رئيسي الحجرتين المدنية والإدارية في المحكمة العليا و ثلاثة نواب يعينهم المجلس الوطني و عضو يعينه رئيس الجمهورية."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_63_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_63> ;
    dzdoc:position 1 ;
    dzdoc:text "ينتخب أعضاء المجلس الدستوري رئيسهم الذي ليس له صوت مرجح."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_64_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_64> ;
    dzdoc:position 0 ;
    dzdoc:text "يفصل المجلس الدستوري في دستورية القوانين و الأوامر التشريعية بطلب من رئيس الجمهورية أو رئيس المجلس الوطني."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_66_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_66> ;
    dzdoc:position 0 ;
    dzdoc:text "اختصاصات المجلس الأعلى للقضاء و قواعد سيره تحدد بقانون."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_68_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_68> ;
    dzdoc:position 0 ;
    dzdoc:text "يستشار المجلس في جميع المسائل العسكرية."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_69_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_69> ;
    dzdoc:position 1 ;
    dzdoc:text "ينتخب المجلس الأعلى الاقتصادي و الاجتماعي رئيسه."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_6_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_6> ;
    dzdoc:position 0 ;
    dzdoc:text "علم الدولة أخضر و أبيض يتوسطه هلال و نجم أحمران."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_70_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_70> ;
    dzdoc:position 0 ;
    dzdoc:text "يستشار المجلس الأعلى الإقتصادي والإجتماعي في جميع مشروعات و مقترحات القانون ذات الطابع الإقتصادي و الإجتماعي، و يمكنه الإستماع الى أعضاء الحكومة."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_71_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_71> ;
    dzdoc:position 0 ;
    dzdoc:text "ترجع المبادرة بتعديل الدستور الى كل من رئيس الجمهورية و الأغلبية المطلقة لأعضاء المجلس الوطني معا."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_72_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_72> ;
    dzdoc:position 0 ;
    dzdoc:text "يتضمن إجراء تعديل الدستور، تلاوتين و تصويتين بالأغلبية المطلقة لأعضاء المجلس الوطني يفصل بينهما أجل شهرين."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_73_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_73> ;
    dzdoc:position 0 ;
    dzdoc:text "يعرض مشروع قانون التعديل على مصادقة الشعب عن طريقة الإستفتاء."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_74_condition_0_37df1603> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/constitution/1963-12-08/1963#art_74_condition_0_37df1603_role_d2c6b479a3> ;
    dznorm:conditionText "في حالة مصادقة الشعب على مشروع تعديل الدستور"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_74> ;
    dznorm:position 0 .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_74_condition_0_37df1603_role_d2c6b479a3> a dznorm:Role ;
    rdfs:label "مشروع تعديل الدستور"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "في حالة مصادقة الشعب على مشروع تعديل الدستور"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_74> .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_74_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_74> ;
    dzdoc:position 0 ;
    dzdoc:text "في حالة مصادقة الشعب على مشروع تعديل الدستور يتم إصداره من طرف رئيس الجمهورية باعتباره قانونا دستوريا خلال الأيام الثمانية الموالية لتاريخ الإستفتاء."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_75_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_75> ;
    dzdoc:position 0 ;
    dzdoc:text "النشيد الوطني مؤقتا هو “قسما”، و سيتولى قانون غير دستوري تحديد النشيد الوطني في المستقبل."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_76_obligation_0_7e71d916> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/constitution/1963-12-08/1963#art_76_obligation_0_7e71d916_action_bd7d9a71b5> ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_76> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب تحقيق تعميم اللغة العربية في أقرب وقت ممكن في كامل أراضي الجمهورية"@ar ;
    dznorm:sourceArticle "art_76" .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_76_obligation_0_7e71d916_action_bd7d9a71b5> a dznorm:Action ;
    rdfs:label "تحقيق تعميم اللغة العربية في"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب تحقيق تعميم اللغة العربية في أقرب وقت ممكن في كامل أراضي الجمهورية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_76> .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_76_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_76> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب تحقيق تعميم اللغة العربية في أقرب وقت ممكن في كامل أراضي الجمهورية. بيد أنه، خلافا لأحكام هذا القانون، سوف يجوز استعمال اللغة الفرنسية مؤقتا الى جانب اللغة العربية."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_76_permission_0_bdfb4bb7> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
