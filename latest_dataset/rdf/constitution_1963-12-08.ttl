    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_43> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "و هو القائد الأعلى للقوات المسلحة للجمهورية."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_44_19631208_OpEnact_326f5dc0b3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
