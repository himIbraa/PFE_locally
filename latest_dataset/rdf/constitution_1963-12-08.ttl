<https://legal.dz/resource/constitution/1963-12-08/1963#art_5_defocc_0e25bbb82176> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 47 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:arabic_language ;
