    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "يترأس رئيس الجمهورية المجلس الأعلى للدفاع و المجلس الأعلى للقضاء ."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_46_19631208_OpEnact_9fc30b9e5e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
