    dznorm:expressedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_76> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب تحقيق تعميم اللغة العربية في أقرب وقت ممكن في كامل أراضي الجمهورية. بيد أنه، خلافا لأحكام هذا القانون، سوف يجوز استعمال اللغة الفرنسية مؤقتا الى جانب اللغة العربية."@ar ;
    dznorm:sourceArticle "art_76" .

