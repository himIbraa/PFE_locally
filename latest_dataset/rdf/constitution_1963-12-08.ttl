<https://legal.dz/resource/constitution/1963-12-08/1963#art_23_defocc_c639dd328858> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 52 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
