<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_39> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسند السلطة التنفيذية الى رئيس الدولة الذي يحمل لقب رئيس الجمهورية . و هو ينتخب لمدة خمس سنوات عن طريق الإقتراع العام المباشر و السري بعد تعيينه من طرف الحزب. يمكن لكل مسلم جزائري الأصل بلغ عمره 35 سنة على الأقل و متمتع بحقوقه المدنية و السياسية أن ينتخب رئيسا للجمهورية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
