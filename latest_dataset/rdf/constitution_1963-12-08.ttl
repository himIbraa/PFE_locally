    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "اللغة العربية هي اللغة القومية و الرسمية للدولة."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_5_para_0> a dzdoc:Paragraph ;
