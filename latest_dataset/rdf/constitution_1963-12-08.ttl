    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_49_19631208_OpEnact_3723545d8e> ;
