<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_10> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتمثل الأهداف الأساسية للجمهورية الجزائرية الديمقراطية الشعبية في : صيانة الاستقلال الوطني و سلامة الأراضي الوطنية و الوحدة الوطنية. ممارسة السلطة من طرف الشعب الذي يؤلف طليعته فلاحون و عمال و مثقفون ثوريون. تشييد ديمقراطية اشتراكية، و مقاومة استغلال الانسان في جميع اشكاله، وضمان حق العمل و مجانية التعليم ، و تصفية جميع بقايا الاستعمار. الدفاع عن الحرية و احترام كرامة الانسان. مقاومة كل نوع من التمييز و خاصة التمييز العنصري و الديني. السلام في العالم. استنكار التعذيب و كل مساس حسي أو معنوي بكيان"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_10_19631208_OpEnact_f725ed8f81> ;
    dzdoc:replacementText "تتمثل الأهداف الأساسية للجمهورية الجزائرية الديمقراطية الشعبية في : صيانة الاستقلال الوطني و سلامة الأراضي الوطنية و الوحدة الوطنية. ممارسة السلطة من طرف الشعب الذي يؤلف طليعته فلاحون و عمال و مثقفون ثوريون. تشييد ديمقراطية اشتراكية، و مقاومة استغلال الانسان في جميع اشكاله، وضمان حق العمل و مجانية التعليم ، و تصفية جميع بقايا الاستعمار. الدفاع عن الحرية و احترام كرامة الانسان. مقاومة كل نوع من التمييز و خاصة التمييز العنصري و الديني. السلام في العالم. استنكار التعذيب و كل مساس حسي أو معنوي بكيان الانسان."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_10> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_10> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

