<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_32> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز ايقاف أي نائب ، أو متابعته فيما يتعلق بالقضايا الجنائية دون اذن المجلس الوطني الا في حالة التلبس بالجريمة ، و يوقف حبس أو متابعة النائب بطلب من المجلس الوطني . و في حالة التلبس بالجريمة يقدم فورا اخطار المتابعة أو الإجراءات المتخذة ضد النائب الى مكتب المجلس الذي يمكنه ان يطالب بموجب سلطة القانون اتخاذ التدابير الضرورية لاحترام مبدأ الحصانة البرلمانية . و لا تجوز متابعة أي عضو من أعضاء المجلس الوطني ، أو ايقافه أو حبسه، أو محاكمته بسبب ما يدلي به من آراء أو تصويت خلال ممارسة نيابته ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_32_19631208_OpEnact_240ba080fd> ;
    dzdoc:replacementText "لا يجوز ايقاف أي نائب ، أو متابعته فيما يتعلق بالقضايا الجنائية دون اذن المجلس الوطني الا في حالة التلبس بالجريمة ، و يوقف حبس أو متابعة النائب بطلب من المجلس الوطني . و في حالة التلبس بالجريمة يقدم فورا اخطار المتابعة أو الإجراءات المتخذة ضد النائب الى مكتب المجلس الذي يمكنه ان يطالب بموجب سلطة القانون اتخاذ التدابير الضرورية لاحترام مبدأ الحصانة البرلمانية . و لا تجوز متابعة أي عضو من أعضاء المجلس الوطني ، أو ايقافه أو حبسه، أو محاكمته بسبب ما يدلي به من آراء أو تصويت خلال ممارسة نيابته ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
