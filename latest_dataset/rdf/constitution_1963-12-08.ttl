    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_28> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "يعبر المجلس الوطني عن الارادة الشعبية، و يتولى التصويت على القوانين، و يراقب النشاط الحكومي."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_29_19631208_OpEnact_3986872ba6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
