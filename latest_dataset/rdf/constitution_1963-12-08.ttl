<https://legal.dz/resource/constitution/1963-12-08/1963#art_65_defocc_bb291425fbe8> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 20 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:supreme_council_judiciary ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_65> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_65_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "المجلس الأعلى للقضاء : يتألف المجلس الأعلى للقضاء من رئيس الجمهورية و وزير العدل، و الرئيس الأول للمحكمة العليا، و وكيل الدولة العام لديها، و محام لدى المحكمة العليا، وإثنين من رجال القضاء أحدهما من قضاة الصلح، ينتخبان من طرف زملائهم على المستوى الوطني و ستة أعضاء تنتخبهم لجنة العدل الدائمة في المجلس الوطني من بين أعضائها."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_65_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_65> ;
    dzdoc:position 0 ;
    dzdoc:text "المجلس الأعلى للقضاء : يتألف المجلس الأعلى للقضاء من رئيس الجمهورية و وزير العدل، و الرئيس الأول للمحكمة العليا، و وكيل الدولة العام لديها، و محام لدى المحكمة العليا، وإثنين من رجال القضاء أحدهما من قضاة الصلح، ينتخبان من طرف زملائهم على المستوى الوطني و ستة أعضاء تنتخبهم لجنة العدل الدائمة في المجلس الوطني من بين أعضائها."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_67_defocc_3235e06b841c> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 20 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:supreme_council_defense ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_67> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_67_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "المجلس الأعلى للدفاع : يتألف المجلس الأعلى للدفاع من رئيس الجمهورية و وزير الدفاع الوطني، و وزير الداخلية، و وزير الشؤون الخارجية، و رئيس لجنة الدفاع الوطني في المجلس، و عضوين يعينهما رئيس الجمهورية."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_67_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_67> ;
    dzdoc:position 0 ;
    dzdoc:text "المجلس الأعلى للدفاع : يتألف المجلس الأعلى للدفاع من رئيس الجمهورية و وزير الدفاع الوطني، و وزير الداخلية، و وزير الشؤون الخارجية، و رئيس لجنة الدفاع الوطني في المجلس، و عضوين يعينهما رئيس الجمهورية."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_69_defocc_2398aefe26a9> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 35 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:economic_social_council ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_69> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/constitution/1963-12-08/1963#art_69_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "المجلس الأعلى الإقتصادي و الإجتماعي : يتألف المجلس الأعلى الإقتصادي و الإجتماعي من خمسة نواب يعينهم المجلس الوطني، و مدير التصميم، و حاكم البنك المركزي للجزائر و المسؤولون عن المنظمات القومية و ممثلين للنواحي الرئيسية من النشاط القومي الإقتصادي والإجتماعي يعينهم رئيس الجمهورية."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#art_69_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#art_69> ;
    dzdoc:position 0 ;
    dzdoc:text "المجلس الأعلى الإقتصادي و الإجتماعي : يتألف المجلس الأعلى الإقتصادي و الإجتماعي من خمسة نواب يعينهم المجلس الوطني، و مدير التصميم، و حاكم البنك المركزي للجزائر و المسؤولون عن المنظمات القومية و ممثلين للنواحي الرئيسية من النشاط القومي الإقتصادي والإجتماعي يعينهم رئيس الجمهورية."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#preamble_segment_0> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#preamble> ;
    dzdoc:position 0 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "دستور موافق عليه في استفتاء شعبي بتاريخ 08 ديسمبر 1963"@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#preamble_segment_1> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#preamble> ;
    dzdoc:position 1 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وفاء للميثاق الذي أقره المجلس القومي للثورة الجزائرية في طرابلس"@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#preamble_segment_2> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1963-12-08/1963#preamble> ;
    dzdoc:position 2 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "طبقا للمبادئ الاشتراكية و الممارسة الفعلية للسلطة من طرف الشعب"@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_10_19631208_OpEnact_f725ed8f81> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_10> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_10> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_10> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "تتمثل الأهداف الأساسية للجمهورية الجزائرية الديمقراطية الشعبية في : صيانة الاستقلال الوطني و سلامة الأراضي الوطنية و الوحدة الوطنية. ممارسة السلطة من طرف الشعب الذي يؤلف طليعته فلاحون و عمال و مثقفون ثوريون. تشييد ديمقراطية اشتراكية، و مقاومة استغلال الانسان في جميع اشكاله، وضمان حق العمل و مجانية التعليم ، و تصفية جميع بقايا الاستعمار. الدفاع عن الحرية و احترام كرامة الانسان. مقاومة كل نوع من التمييز و خاصة التمييز العنصري و الديني. السلام في العالم. استنكار التعذيب و كل مساس حسي أو معنوي بكيان الانسان."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_11_19631208_OpEnact_3aed800848> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_11> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_11> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_11> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "توافق الجمهورية على الاعلان العالمي لحقوق الانسان و تنضم الى كل منظمة دولية تستجيب لمطامح الشعب الجزائري و ذلك اقتناعا منها بضرورة التعاون الدولي."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_12_19631208_OpEnact_cba0c13e2d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_12> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_12> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_12> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "لكل المواطنين من الجنسين نفس الحقوق و نفس الواجبات ."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_13_19631208_OpEnact_25a4fa7950> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_13> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_13> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_13> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "لكل مواطن استكمل 19 عاما من عمره حق التصويت ."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_14_19631208_OpEnact_b507b8a309> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_14> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_14> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_14> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "لا يجوز الإعتداء على حرمة السكن ، و يضمن حفظ سر المراسلة لجميع المواطنين ."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_15_19631208_OpEnact_33ba865935> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_15> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_15> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_15> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "لا يمكن ايقاف أي شخص و لا متابعته الا في الأحوال المنصوص عليها في القانون و أمام القضاة المعينين بمقتضاه و طبقا للإجراءات المقررة بموجبه ."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_16_19631208_OpEnact_40dd32414e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_16> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_16> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_16> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "تعترف الجمهورية بـ حق كل فرد في حياة لائقة و في توزيع عادل للدخل القومي ."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_17_19631208_OpEnact_efdf4e09bc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_17> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_17> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_17> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "تحمي الدولة الأسرة باعتبارها الخلية الأساسية للمجتمع ."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_18_19631208_OpEnact_a24da4fe24> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_18> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_18> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_18> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "التعليم اجباري ، و الثقافة في متناول الجميع بدون تمييز الا ما كان ناشئا عن استعدادات كل فرد و حاجيات الجماعة."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_19_19631208_OpEnact_db8d225229> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1963-12-08/1963#version_art_19> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1963-12-08/1963#art_19> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1963-12-08/1963#art_19> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1963-12-08/1963> ;
    dzdoc:versionText "تضمن الجمهورية حرية الصحافة ، و حرية وسائل الاعلام الأخرى ، و حرية تأسيس الجمعيات ، و حرية التعبير ، و مخاطبة الجمهور و حرية الإجتماع ."@ar .

<https://legal.dz/resource/constitution/1963-12-08/1963#version_art_1_19631208_OpEnact_7f5f5eaac2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1963-12-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
