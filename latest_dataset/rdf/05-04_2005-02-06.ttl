dzterm:collective_detention_system a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يطبق نظام الاحتباس الجماعي في المؤسسات العقابية، وهو نظام يعيش فيه المحبوسون جماعيا."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_45_defocc_9d70ffbf1a4c> .

dzterm:committee a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "لجنة تطبيق العقوبات"@ar .

dzterm:detainee a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يقصد بكلمة محبوس في مفهوم هذا القانون كل شخص تم إيداعه بمؤسسة عقابية، تنفيذا لأمر، أو حكم، أو قرار قضائي."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_7_defocc_0beb05e4627c> .

