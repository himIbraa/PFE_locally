<https://legal.dz/resource/law/2005-02-06/05-04#version_art_168> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من خمسة آلاف دينار (5.000 دج) إلى عشرين ألف دينار (20.000 دج)، كل من قام أو ساهم في نشر بيانات أو وثائق لها علاقة بتنفيذ عقوبة الإعدام، فيما عدا محضر التنفيذ، والبلاغ الصادر عن وزارة العدل . يتعرض لنفس العقوبة المنصوص عليها في الفقرة أعلاه، كل من نشر أو أفشى أو أذاع خبرا بأية وسيلة كانت عن قرار رئيس الجمهورية المتعلق بالعفو قبل تبليغ مرسوم العفو للمحكوم عليه بالإعدام وتعليق محضر التنفيذ وتسجيل العفو على النسخة الأصلية لحكم الإدانة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_168_20050206_OpEnact_6842e49f18> ;
    dzdoc:replacementText "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من خمسة آلاف دينار (5.000 دج) إلى عشرين ألف دينار (20.000 دج)، كل من قام أو ساهم في نشر بيانات أو وثائق لها علاقة بتنفيذ عقوبة الإعدام، فيما عدا محضر التنفيذ، والبلاغ الصادر عن وزارة العدل . يتعرض لنفس العقوبة المنصوص عليها في الفقرة أعلاه، كل من نشر أو أفشى أو أذاع خبرا بأية وسيلة كانت عن قرار رئيس الجمهورية المتعلق بالعفو قبل تبليغ مرسوم العفو للمحكوم عليه بالإعدام وتعليق محضر التنفيذ وتسجيل العفو على النسخة الأصلية لحكم الإدانة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_168> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
