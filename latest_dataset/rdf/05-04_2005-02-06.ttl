<https://legal.dz/resource/law/2005-02-06/05-04#art_93_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_93> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن إدارة المؤسسة العقابية إصدار نشرية داخلية يساهم المحبوسون في إعدادها بإنتاجاتهم الأدبية والثقافية."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_93_permission_0_6dfee005> a dznorm:Permission ;
