<https://legal.dz/resource/law/2005-02-06/05-04#version_art_161> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وصل إلى علم وزير العدل، حافظ الأختام ، أن مقرر قاضي تطبيق العقوبات المتخذ طبقا للمواد 129 و 130 و 141 من هذا القانون يؤثر على سلبا على الأمن أو النظام العام ، فله أن يعرض الأمر على لجنة تكييف العقوبات في أجل أقصاه ثلاثون (30) يوما. وفي حالة إلغاء المقرر ، يعاد المحكوم عليه المستفيد إلى نفس المؤسسة العقابية لقضاء باقي عقوبته."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_161_20050206_OpEnact_016c37ea28> ;
    dzdoc:replacementText "إذا وصل إلى علم وزير العدل، حافظ الأختام ، أن مقرر قاضي تطبيق العقوبات المتخذ طبقا للمواد 129 و 130 و 141 من هذا القانون يؤثر على سلبا على الأمن أو النظام العام ، فله أن يعرض الأمر على لجنة تكييف العقوبات في أجل أقصاه ثلاثون (30) يوما. وفي حالة إلغاء المقرر ، يعاد المحكوم عليه المستفيد إلى نفس المؤسسة العقابية لقضاء باقي عقوبته."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_161> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
