    dznorm:position 0 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_81_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_81> ;
    dzdoc:position 0 ;
    dzdoc:text "مع مراعاة الظروف الصحية للمحبوس ، وكفاءته ووضعيته الجزائية، يعين في كل مؤسسة عقابية محبوسون للقيام بالخدمة العامة من أجل المحافظة على نظافة أماكن الاحتباس وضمان الأعمال المختلفة اللازمة لحسن سير المصالح."@ar .

