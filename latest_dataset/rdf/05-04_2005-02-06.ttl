    dzdoc:text "تتخذ مؤسسات البيئة المفتوحة شكل مراكز ذات طابع فلاحي أو صناعي أو حرفي أو خدماتي، أو ذات منفعة عامة، وتتميز بتشغيل وإيواء المحبوسين بعين المكان."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_151_defocc_7aae7da6b6a2> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 58 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:death_row_inmate ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_151> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_151_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يقصد بالمحبوس المحكوم عليه بالإعدام في مفهوم هذا القانون :
          
          
          1- المحبوس المحكوم عليه نهائيا بعقوبة الإعدام،
          
          
          2- المحبوس المحكوم عليه بالإعدام ولم يصبح الحكم نهائيا في حقه."""@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_151_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_151> ;
    dzdoc:position 0 ;
    dzdoc:text "يقصد بالمحبوس المحكوم عليه بالإعدام في مفهوم هذا القانون : 1- المحبوس المحكوم عليه نهائيا بعقوبة الإعدام، 2- المحبوس المحكوم عليه بالإعدام ولم يصبح الحكم نهائيا في حقه."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_165_obligation_0_b01bcb75_ref_6091b5e08971> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "قانون العقوبات"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-156" ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/1966-06-08/66-156> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceEId "art_165" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يعاقب طبقا للأحكام المنصوص عليها في قانون العقوبات، كل موظف تابع لإدارة السجون، أو أي شخص يساهم في نشاطات إعادة التربية وإعادة إدماج المحبوسين، أفشى سرا مهنيا"@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-156"^^xsd:anyURI .

<https://legal.dz/resource/law/2005-02-06/05-04#art_166_obligation_2_60077641> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_166> ;
    dznorm:hasCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_166_obligation_2_60077641_condition_0> ;
    dznorm:position 2 ;
    dznorm:provisionText "وإذا كان الفاعل من مستخدمي المؤسسة العقابية أو شخصا مؤهلا للاقتراب من المحبوسين بسبب وظيفته أو مهنته يعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة مالية من عشرة آلاف دينار (10.000 دج) إلى خمسين ألف دينار (50.000 دج)"@ar ;
    dznorm:sourceArticle "art_166" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_169_defocc_2c42c6acc0c4> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 18 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:escape_state ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_169> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_169_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يعتبر في حالة هروب ويتعرض للعقوبات المنصوص عليها في قانون العقوبات، المحبوس الذي استفاد من أحد التدابير المنصوص عليها في المواد 56 و 100 و 104 و 110 و 129 و 130 من هذا القانون، ولم يرجع إلى المؤسسة العقابية بعد انتهاء المدة المحددة له."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_169_obligation_0_8fec1491_ref_6091b5e08971> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "قانون العقوبات"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-156" ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/1966-06-08/66-156> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceEId "art_169" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "ويتعرض للعقوبات المنصوص عليها في قانون العقوبات، المحبوس الذي استفاد من أحد التدابير المنصوص عليها في المواد 56 و 100 و 104 و 110 و 129 و 130 من هذا القانون، ولم يرجع إلى المؤسسة العقابية بعد انتهاء المدة المحددة له"@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-156"^^xsd:anyURI .

<https://legal.dz/resource/law/2005-02-06/05-04#art_169_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_169> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر في حالة هروب ويتعرض للعقوبات المنصوص عليها في قانون العقوبات، المحبوس الذي استفاد من أحد التدابير المنصوص عليها في المواد 56 و 100 و 104 و 110 و 129 و 130 من هذا القانون، ولم يرجع إلى المؤسسة العقابية بعد انتهاء المدة المحددة له."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_170_obligation_1_3ca5aee8> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_170> ;
    dznorm:hasCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_170_obligation_1_3ca5aee8_condition_0> ;
    dznorm:position 1 ;
    dznorm:provisionText "إذا كان الفاعل من مستخدمي المؤسسة العقابية، أو شخصا مؤهلا للاقتراب من المحبوسين بسبب وظيفته، يعاقب بالحبس من خمس (5) سنوات إلى سبع (7) سنوات، وبغرامة من خمسين ألف دينار (50.000 دج) إلى مائة ألف دينار (100.000 دج)"@ar ;
    dznorm:sourceArticle "art_170" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_20_defocc_9e92ec1bdd21> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 89 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:family ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_20> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_20_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يقصد بالعائلة في مفهوم هذا القانون الزوج والأولاد والأب والأم والإخوة والأخوات والمكفولون."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_20_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_20> ;
    dzdoc:position 0 ;
    dzdoc:text "يقصد بالعائلة في مفهوم هذا القانون الزوج والأولاد والأب والأم والإخوة والأخوات والمكفولون."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_25_defocc_d9679c4b8095> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 144 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:penal_institution ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_25> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_25_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "المؤسسة العقابية هي مكان للحبس تنفذ فيه وفقا للقانون العقوبات السالبة للحرية، والأوامر الصادرة عن الجهات القضائية، والإكراه البدني عند الاقتضاء."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_25_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_25> ;
    dzdoc:position 0 ;
    dzdoc:text "المؤسسة العقابية هي مكان للحبس تنفذ فيه وفقا للقانون العقوبات السالبة للحرية، والأوامر الصادرة عن الجهات القضائية، والإكراه البدني عند الاقتضاء."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_28_defocc_131c6a23b47d> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 92 ;
    dzdoc:charStart 73 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:women_specialized_centers ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_28> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_28_para_2> ;
    dzdoc:paragraphPosition 2 ;
    dzdoc:snippet """ثانيا- المراكز المتخصصة :
              
              
              1- مراكز متخصصة للنساء، مخصصة لاستقبال النساء المحبوسات مؤقتا، والمحكوم عليهن نهائيا بعقوبة سالبة للحرية مهما تكن مدتها، والمحبوسات لإكراه بدني.
              
              
              2 - مراكز متخصصة للأحداث، مخصصة لاستقبال الأحداث الذين تقل أعمارهم عن ثماني عشرة (18) سنة، المحبوسين مؤقتا، والمحكوم عليهم نهائيا بعقوبة سالبة للحرية مهما تكن مدتها."""@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_28_defocc_189c00c04390> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 174 ;
    dzdoc:charStart 163 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:prevention_establishment ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_28> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_28_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """تصنف مؤسسات البيئة المغلقة إلى مؤسسات ومراكز متخصصة :
              
              
              أولا - المؤسسات :
              
              
              1- مؤسسة وقاية بدائرة اختصاص كل محكمة، وهي مخصصة لاستقبال المحبوسين مؤقتا والمحكوم عليهم نهائيا بعقوبة سالبة للحرية لمدة تساوي أو تقل عن سنتين (2) ، ومن بقي منهم لانقضاء مدة عقوبتهم سنتان (2) أو أقل والمحبوسين لإكراه بدني.
              
              
              2- مؤسسة إعادة التربية بدائرة اختصاص كل مجلس قضائي، وهي مخصصة لاستقبال المحبوسين مؤقتا، والمحكوم عليهم نهائيا بعقوبة سالبة للحرية تساوي أو تقل عن خمس (5) سنوات، ومن بقي منهم لإنقضاء عقوبته خمس (5) سنوات أو أقل والمحبوسين لإكراه بدني.
              
              
              3- مؤسسة إعادة التأهيل وهي مخصصة لحبس المحكوم عليهم نهائيا بعقوبة الحبس لمدة تفوق خمس (5) سنوات وبعقوبة السجن، والمحكوم عليهم معتادي الإجرام والخطرين مهما تكن مدة العقوبة المحكوم بها عليهم والمحكوم عليهم بالإعدام."""@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_28_defocc_1ef3cd2e819b> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 449 ;
    dzdoc:charStart 430 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:reeducation_establishment ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_28> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_28_para_0> ;
    dzdoc:paragraphPosition 0 ;
