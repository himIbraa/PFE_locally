<https://legal.dz/resource/law/2005-02-06/05-04#art_109_defocc_fc8d9af55ec0> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 143 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
