<https://legal.dz/resource/law/2005-02-06/05-04#version_art_24> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنشأ لدى كل مؤسسة وقاية وكل مؤسسة إعادة التربية، وكل مؤسسة إعادة التأهيل، وفي المراكز المخصصة للنساء، لجنة تطبيق العقوبات يرأسها قاضي تطبيق العقوبات . تختص لجنة تطبيق العقوبات بما يأتي : ترتيب وتوزيع المحبوسين، حسب وضعيتهم الجزائية، وخطورة الجريمة المحبوسين من أجلها، وجنسهم وسنهم وشخصيتهم، ودرجة استعدادهم للإصلاح. متابعة تطبيق العقوبات السالبة للحرية والبديلة عند الاقتضاء. دراسة طلبات إجازات الخروج وطلبات التوقيف المؤقت لتطبيق العقوبة، وطلبات الإفراج المشروط، أو الإفراج المشروط لأسباب صحية. دراس"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_24_20050206_OpEnact_70ed606801> ;
    dzdoc:replacementText "تنشأ لدى كل مؤسسة وقاية وكل مؤسسة إعادة التربية، وكل مؤسسة إعادة التأهيل، وفي المراكز المخصصة للنساء، لجنة تطبيق العقوبات يرأسها قاضي تطبيق العقوبات . تختص لجنة تطبيق العقوبات بما يأتي : ترتيب وتوزيع المحبوسين، حسب وضعيتهم الجزائية، وخطورة الجريمة المحبوسين من أجلها، وجنسهم وسنهم وشخصيتهم، ودرجة استعدادهم للإصلاح. متابعة تطبيق العقوبات السالبة للحرية والبديلة عند الاقتضاء. دراسة طلبات إجازات الخروج وطلبات التوقيف المؤقت لتطبيق العقوبة، وطلبات الإفراج المشروط، أو الإفراج المشروط لأسباب صحية. دراسة طلبات الوضع في الوسط المفتوح، والحرية النصفية، والورشات الخارجية. متابعة تطبيق برامج إعادة التربية وتفعيل آلياتها. تحدد تشكيلة هذه اللجنة، وكيفيات سيرها عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_24> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_24> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-02-06"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2005-02-06/05-04#version_art_25> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المؤسسة العقابية هي مكان للحبس تنفذ فيه وفقا للقانون العقوبات السالبة للحرية، والأوامر الصادرة عن الجهات القضائية، والإكراه البدني عند الاقتضاء. وتأخذ المؤسسة العقابية شكل البيئة المغلقة أو شكل البيئة المفتوحة. يتميز نظام البيئة المغلقة بفرض الانضباط، وبإخضاع المحبوسين للحضور والمراقبة الدائمة. تقوم مؤسسة البيئة المفتوحة على أساس قبول المحبوس مبدأ الطاعة دون لجوء إدارة المؤسسة العقابية إلى استعمال أساليب الرقابة المعتادة، وعلى شعوره بالمسؤولية تجاه المجتمع الذي يعيش فيه. تحدد كيفيات تنظيم المؤسس"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_25_20050206_OpEnact_a482c92015> ;
    dzdoc:replacementText "المؤسسة العقابية هي مكان للحبس تنفذ فيه وفقا للقانون العقوبات السالبة للحرية، والأوامر الصادرة عن الجهات القضائية، والإكراه البدني عند الاقتضاء. وتأخذ المؤسسة العقابية شكل البيئة المغلقة أو شكل البيئة المفتوحة. يتميز نظام البيئة المغلقة بفرض الانضباط، وبإخضاع المحبوسين للحضور والمراقبة الدائمة. تقوم مؤسسة البيئة المفتوحة على أساس قبول المحبوس مبدأ الطاعة دون لجوء إدارة المؤسسة العقابية إلى استعمال أساليب الرقابة المعتادة، وعلى شعوره بالمسؤولية تجاه المجتمع الذي يعيش فيه. تحدد كيفيات تنظيم المؤسسة العقابية وسيرها عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_25> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_25> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-02-06"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2005-02-06/05-04#version_art_26> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعين لدى كل مؤسسة عقابية ، مدير يتولى شؤون إدارتها ويمارس الصلاحيات المخولة له بمقتضى هذا القانون، بالإضافة إلى ما يسند له من صلاحيات بموجب أحكام تنظيمية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_26_20050206_OpEnact_ecee91a97c> ;
