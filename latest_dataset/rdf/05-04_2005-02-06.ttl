<https://legal.dz/resource/law/2005-02-06/05-04#art_103> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_103" ;
    dzdoc:fullText "توجه طلبات تخصيص اليد العاملة العقابية إلى قاضي تطبيق العقوبات الذي يحيلها بدوره على لجنة تطبيق العقوبات لإبداء الرأي. وفي حالة الموافقة تبرم مع الهيئة الطالبة اتفاقية تحدد فيها الشروط العامة والخاصة لاستخدام اليد العاملة من المحبوسين . يوقع على الاتفاقية كل من مدير المؤسسة العقابية وممثل الهيئة الطالبة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_103> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_103_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_103_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_103_20050206_OpEnact_b60e9fcbca> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_103_obligation_0_c558e2ce> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 103" ;
    dzdoc:position 102 ;
    dzdoc:usesTerm dzterm:المحبوسين,
        dzterm:قاضي_تطبيق_العقوبات .

<https://legal.dz/resource/law/2005-02-06/05-04#art_108> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_108" ;
    dzdoc:fullText "يؤذن للمحبوس المستفيد من نظام الحرية النصفية بحيازة مبلغ مالي من مكسبه المودع بحسابه لدى كتابة ضبط المحاسبة لتغطية مصاريف النقل والتغذية عند الاقتضاء. يجب على المحبوس تبرير مصاريفه من المبلغ المالي المأذون له به، وإرجاع ما بقي منه إلى حسابه لدى كتابة ضبط المحاسبة بالمؤسسة العقابية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_108_right_0_182fbb69> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_108> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_108_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_108_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_108_20050206_OpEnact_2c17635595> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_108_obligation_0_9e34ca71> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "108" ;
    dzdoc:position 107 ;
    dzdoc:usesTerm dzterm:نظام_الحرية_النصفية .

<https://legal.dz/resource/law/2005-02-06/05-04#art_117> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_5_sec_1> ;
    dzdoc:eId "art_117" ;
    dzdoc:fullText "يطبق على الأحداث النظام الجماعي، غير أنه يمكن لأسباب صحية أو وقائية عزل الحدث في مكان ملائم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_117_permission_0_ee62dba6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_117> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_117_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_117_20050206_OpEnact_bcc945c0d5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "117" ;
    dzdoc:position 116 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_117_condition_0_9629fd52> ;
    dzdoc:usesTerm dzterm:juveniles .

<https://legal.dz/resource/law/2005-02-06/05-04#art_123> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_5_sec_2_subsec_1> ;
    dzdoc:eId "art_123" ;
    dzdoc:fullText "تسند إدارة مركز إعادة تربية وإدماج الأحداث إلى مدير يختار من بين الموظفين المؤهلين الذين يولون اهتماما خاصا لشؤون الأحداث الجانحين . يعمل تحت إشراف المدير موظفون يسهرون على تربية الأحداث وتكوينهم الدراسي والمهني، وعلى متابعة تطور سلوكهم، لإحياء شعورهم بالمسؤولية والواجب تجاه المجتمع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_123> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_123_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_123_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_123_20050206_OpEnact_e1affae23b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_123_obligation_0_e05968cf>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_123_obligation_1_201cafb5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 123" ;
    dzdoc:position 122 ;
    dzdoc:usesTerm dzterm:director,
        dzterm:juvenile_delinquents,
        dzterm:juveniles,
        dzterm:reeducation_center .

<https://legal.dz/resource/law/2005-02-06/05-04#art_148> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_6_sec_3> ;
    dzdoc:eId "art_148" ;
    dzdoc:fullText "دون مراعاة أحكام المادة 134 من هذا القانون، يمكن المحكوم عليه نهائيا الاستفادة من الإفراج المشروط بموجب مقرر من وزير العدل، حافظ الأختام ، لأسباب صحية إذا كان مصابا بمرض خطير أو إعاقة دائمة تتنافى مع بقائه في الحبس، ومن شأنها أن تؤثر سلبا وبصفة مستمرة ومتزايدة على حالته الصحية البدنية والنفسية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_148_permission_0_76eff582> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_148> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_148_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_148_20050206_OpEnact_60705b1edb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 148" ;
    dzdoc:position 147 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_134> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_134> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_148_condition_0_2fc8a89b> ;
    dzdoc:usesTerm dzterm:conditional_release,
        dzterm:minister_of_justice .

<https://legal.dz/resource/law/2005-02-06/05-04#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_3> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "مع مراعاة أحكام المادة 19 أدناه، يمكن التأجيل المؤقت لتنفيذ العقوبة السالبة للحرية الصادرة ضد الأشخاص الذين لم يكونوا محبوسين عندما أصبح الحكم، أو القرار الصادر عليهم نهائيا . غير أنه، لا يستفيد من أحكام الفقرة أعلاه، المحكوم عليهم معتادو الإجرام والمحكوم عليهم، لارتكاب جرائم المساس بأمن الدولة، أو أفعال إرهابية، أو تخريبية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_15_permission_0_4b44d3a6> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_15_right_0_9c8b7c1c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_15_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_15_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_15_20050206_OpEnact_0fcb3cf4e4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "15" ;
    dzdoc:position 14 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_19> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_19> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_159> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_8> ;
    dzdoc:eId "art_159" ;
    dzdoc:fullText "يمكن إعفاء المحبوس من بعض أو من كل الشروط الواجب توفرها للاستفادة من أحد أنظمة إعادة التربية والإدماج الاجتماعي ، المنصوص عليها في هذا القانون عندما يقدم للسلطات بيانات أو معلومات كما هو محدد في المادة 135 من هذا القانون ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_159_permission_0_3395b8cd> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_159_right_0_3dd2c075> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_159> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_159_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_159_20050206_OpEnact_5e9d9f960b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 159" ;
    dzdoc:position 158 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_135> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_135> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_159_condition_0_48027c2e> ;
    dzdoc:usesTerm dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_166> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_9> ;
    dzdoc:eId "art_166" ;
    dzdoc:fullText "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من عشرة آلاف دينار (10.000دج) إلى خمسين ألف دينار (50.000 دج) كل من قام أو حاول بنفسه أو عن طريق الغير تسليم محبوس في غير الحالات المقررة قانونا، مبلغا ماليا أو مراسلة أو دواء، أو أي شيء آخر غير مرخص به . يتعرض لنفس العقوبة المنصوص عليها في الفقرة أعلاه، كل من قام أو حاول القيام في نفس الظروف، بإخراج الأشياء السالف ذكرها . وإذا كان الفاعل من مستخدمي المؤسسة العقابية أو شخصا مؤهلا للاقتراب من المحبوسين بسبب وظيفته أو مهنته يعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة مالية من عشرة آلاف دينار (10.000 دج) إلى خمسين ألف دينار (50.000 دج) ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_166> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_166_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_166_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_166_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_166_20050206_OpEnact_c721b698b0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_166_obligation_0_a50f6ac9>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_166_obligation_1_6f5b73e7>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_166_obligation_2_60077641> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 166" ;
    dzdoc:position 165 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_3> ;
    dzdoc:eId "art_17" ;
    dzdoc:fullText "يؤجل تنفيذ العقوبة في الحالات المنصوص عليها في المادة 16 أعلاه، لمدة لا تزيد عن ستة (6) أشهر، فيما عدا الحالات الآتية : في حالة الحمل، وإلى ما بعد وضع الحامل حملها بشهرين كاملين حال وضعها له ميتا، وإلى أربعة (24) وعشرين شهرا، حال وضعها له حيا. في حالة المرض الخطير الذي ثبت تنافيه مع الحبس إلى حين زوال حالة التنافي. في الحالتين 8 و 9 من المادة 16 أعلاه، ينقضي الأجل بالفصل في طلب العفو. في الحالة 10 من المادة 16 أعلاه، ينقضي الأجل بانتهاء مدة الخدمة الوطنية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_17> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_17_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_17_20050206_OpEnact_44d39410c7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "17" ;
    dzdoc:position 16 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_16> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_16> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_3> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "يتخذ النائب العام لدى المجلس القضائي التابع له محل التنفيذ مقرر التأجيل، إذا كانت مدة العقوبة لا تزيد عن ستة (6) أشهر . لا يمكن منح التأجيل، إذا كانت العقوبة تفوق ستة (6) أشهر وتقل عن أربعة (24) وعشرين شهرا، وكذا في الحالات المنصوص عليها في المادة 17 أعلاه ، إلا من وزير العدل حافظ الأختام ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_18_permission_0_e30e52ae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_18_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_18_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_18_20050206_OpEnact_91fc233dfd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "18" ;
    dzdoc:position 17 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_17> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_17> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_18_condition_0_8e057a62>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_18_condition_1_a1126ff2> ;
    dzdoc:usesTerm dzterm:minister_of_justice,
        dzterm:prosecutor_general .

<https://legal.dz/resource/law/2005-02-06/05-04#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:definesTerm dzterm:penal_institution ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "المؤسسة العقابية هي مكان للحبس تنفذ فيه وفقا للقانون العقوبات السالبة للحرية، والأوامر الصادرة عن الجهات القضائية، والإكراه البدني عند الاقتضاء. وتأخذ المؤسسة العقابية شكل البيئة المغلقة أو شكل البيئة المفتوحة. يتميز نظام البيئة المغلقة بفرض الانضباط، وبإخضاع المحبوسين للحضور والمراقبة الدائمة. تقوم مؤسسة البيئة المفتوحة على أساس قبول المحبوس مبدأ الطاعة دون لجوء إدارة المؤسسة العقابية إلى استعمال أساليب الرقابة المعتادة، وعلى شعوره بالمسؤولية تجاه المجتمع الذي يعيش فيه. تحدد كيفيات تنظيم المؤسسة العقابية وسيرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_25> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_25_defocc_d9679c4b8095> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_25_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_25_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_25_para_2>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_25_para_3>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_25_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_25_20050206_OpEnact_a482c92015> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "25" ;
    dzdoc:position 24 ;
    dzdoc:usesTerm dzterm:penal_institution .

<https://legal.dz/resource/law/2005-02-06/05-04#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_1_subsec_4> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "يتولى موظفو المؤسسات العقابية تحت سلطة المدير ، مهمة حفظ النظام والأمن داخل المؤسسة العقابية . يجب على مدير المؤسسة العقابية عند عدم التحكم في الأمن وحفظ النظام داخل المؤسسة العقابية بواسطة الموظفين العاملين تحت سلطته أن يخطر فورا مصالح الأمن لاتخاذ كل التدابير الوقائية اللازمة، ويشعر فورا بذلك، وكيل الجمهورية و النائب العام ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_37_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_37_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_37_20050206_OpEnact_d7c417d643> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_37_obligation_0_9487a865>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_37_obligation_1_195bdcc9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 37" ;
    dzdoc:position 36 ;
    dzdoc:usesTerm dzterm:attorney_general,
        dzterm:director,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2005-02-06/05-04#art_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:definesTerm dzterm:collective_detention_system ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_45" ;
    dzdoc:fullText "يطبق نظام الاحتباس الجماعي في المؤسسات العقابية، وهو نظام يعيش فيه المحبوسون جماعيا. ويمكن اللجوء إلى نظام الاحتباس الانفرادي ليلا، عندما يسمح به توزيع الأماكن، ويكون ملائما لشخصية المحبوس، ومفيدا في عملية إعادة تربيته ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_45_permission_0_dff98af3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_45> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_45_defocc_9d70ffbf1a4c> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_45_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_45_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_45_20050206_OpEnact_9920673d33> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 45" ;
    dzdoc:position 44 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_45_condition_0_871d5a9f> ;
    dzdoc:usesTerm dzterm:solitary_confinement_system .

<https://legal.dz/resource/law/2005-02-06/05-04#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "تسهر إدارة المؤسسة العقابية بالتنسيق مع المصالح المختصة بالشؤون الاجتماعية، حال وضع المحبوسة حملها، على إيجاد جهة تتكفل بالمولود وتربيته . ويمكن المحبوسة حال تعذر إيجاد كفيل للمولود، أو أي جهة عمومية أو خاصة لتربية ورعايته، أن تبقيه معها إلى بلوغه ثلاث (3) سنوات ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_51_right_0_50ec2af6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_51_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_51_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_51_20050206_OpEnact_eb40b0806a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_51_obligation_0_3341bd5f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 51" ;
    dzdoc:position 50 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "يسهر طبيب المؤسسة العقابية على مراعاة قواعد الصحة والنظافة الفردية والجماعية داخل أماكن الاحتباس . وعلى طبيب المؤسسة العقابية أن يتفقد مجموع الأماكن بها، ويخطر المدير بكل معاينة للنقائص، أو كل الوضعيات التي من شأنها الإضرار بصحة المحبوسين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_60_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_60_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_60_20050206_OpEnact_583d976a43> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_60_obligation_0_8f9bfa09>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_60_obligation_1_4523f355> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "60" ;
    dzdoc:position 59 ;
    dzdoc:usesTerm dzterm:penitentiary_institution,
        dzterm:prisoners .

<https://legal.dz/resource/law/2005-02-06/05-04#art_75> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_75" ;
    dzdoc:fullText "يجوز للمحبوس الأجنبي مراسلة السلطات القنصلية لبلده ، مع مراعاة مبدأ المعاملة بالمثل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_75_permission_0_522dcd6c> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_75_right_0_5e90b3fc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_75> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_75_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_75_20050206_OpEnact_6096547cde> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 75" ;
    dzdoc:position 74 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_75_condition_0_8dba30b6> ;
    dzdoc:usesTerm dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "يحتفظ المحبوس بحق التصرف في أمواله في حدود أهليته القانونية، وبترخيص من القاضي المختص . لا يصح أي إجراء أو تصرف من المحبوس إلا بمعرفة موثق أو محضر قضائي أو موظف مؤهل قانونا ، و يتم وجوبا داخل المؤسسة العقابية بعد استصدار رخصة للزيارة ، طبقا لأحكام الفقرتين 1 و 2 من المادة 68 أعلاه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_78_right_0_584884a5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_78> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_78_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_78_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_78_20050206_OpEnact_fa6c14a81c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_78_obligation_0_99214450> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 78" ;
    dzdoc:position 77 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_68> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_68> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_78_condition_0_27bcbf94>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_78_condition_1_908f3c6c> ;
    dzdoc:usesTerm dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_2> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "تختص النيابة العامة ، دون سواها، بمتابعة تنفيذ الأحكام الجزائية . غير أنه، تقوم مصالح الضرائب أو إدارة الأملاك الوطنية ، بناء على طلب النائب العام أو وكيل الجمهورية ، بتحصيل الغرامات، ومصادرة الأموال، وملاحقة المحكوم عليهم بها . للنائب العام أو وكيل الجمهورية، تسخير القوة العمومية لتنفيذ الأحكام الجزائية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_10_right_0_1abc7639> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_10_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_10_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_10_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_10_20050206_OpEnact_d8082f81ae> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_10_obligation_0_f0a882e2>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_10_obligation_1_0e0a80bc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "10" ;
    dzdoc:position 9 ;
    dzdoc:usesTerm dzterm:attorney_general,
        dzterm:national_property_administration,
        dzterm:penal_judgments,
        dzterm:prosecutor_of_republic,
        dzterm:public_prosecution,
        dzterm:tax_services .

<https://legal.dz/resource/law/2005-02-06/05-04#art_104> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:definesTerm dzterm:نظام_الحرية_النصفية ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_104" ;
    dzdoc:fullText "يقصد بنظام الحرية النصفية، وضع المحبوس المحكوم عليه نهائيا خارج المؤسسة العقابية خلال النهار منفردا ودون حراسة أو رقابة الإدارة ليعود إليها مساء كل يوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_104> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_104_defocc_e16176ce38af> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_104_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_104_20050206_OpEnact_18fe95949d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "104" ;
    dzdoc:position 103 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_113> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_3> ;
    dzdoc:eId "art_113" ;
    dzdoc:fullText "تنشأ مصالح خارجية تابعة لإدارة السجون تكلف بالتعاون مع المصالح المختصة للدولة والجماعات المحلية بتطبيق برامج إعادة الإدماج الاجتماعي للمحبوسين . تقوم هذه المصالح بمتابعة الأشخاص الخاضعين للالتزامات والشروط الخاصة المترتبة على وضعهم في أحد الأنظمة المنصوص عليها في هذا القانون . كما يمكنها أن تقوم بتكليف من السلطات القضائية بإجراء التحقيقات الاجتماعية، ومتابعة الأشخاص الموضوعين تحت نظام الرقابة القضائية. تحدد كيفيات تنظيم المصالح الخارجية لإدارة السجون وسيرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_113> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_113_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_113_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_113_para_2>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_113_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_113_20050206_OpEnact_b9ae2ec0ee> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_113_obligation_0_9ad287f4>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_113_obligation_1_a61fd5d1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 113" ;
    dzdoc:position 112 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_121> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_5_sec_1> ;
    dzdoc:eId "art_121" ;
    dzdoc:fullText "يتعرض الحدث المحبوس الذي يخالف قواعد الانضباط والأمن والنظافة إلى أحد التدابير التأديبية الآتية : الإنذار، التوبيخ، الحرمان المؤقت من بعض النشاطات الترفيهية، المنع المؤقت من التصرف في مكسبه المالي. يقرر مدير المركز أو المؤسسة العقابية، حسب الحالة التدبيرين الأول والثاني، ولا يقرر التدبيرين الثالث والرابع، إلا بعد أخذ رأي لجنة التأديب المنصوص عليها في المادة 122 من هذا القانون. يجب على المدير، في جميع الحالات، إخطار لجنة إعادة التربية المنصوص عليها في المادة 126 من هذا القانون، بكل التدابير المتخذة ضد الحدث المحبوس ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_121> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_121_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_121_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_121_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_121_20050206_OpEnact_cabb7a1d36> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_121_obligation_0_1ff6e8a7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "121" ;
    dzdoc:position 120 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_122>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_126> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_122>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_126> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_121_condition_0_e5165011> ;
    dzdoc:usesTerm dzterm:juvenile .

<https://legal.dz/resource/law/2005-02-06/05-04#art_147> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_6_sec_3> ;
    dzdoc:eId "art_147" ;
    dzdoc:fullText "يجوز لـ قاضي تطبيق العقوبات أو لـ وزير العدل، حافظ الأختام ، حسب الحالة، إلغاء مقرر الإفراج المشروط إذا صدر حكم جديد بالإدانة أو لم تحترم الشروط المنصوص عليها في المادة 145 من هذا القانون . في حالة الإلغاء، يلتحق المحكوم عليه بالمؤسسة العقابية التي كان يقضي فيها عقوبته، بمجرد تبليغه بمقرر الإلغاء من طرف قاضي تطبيق العقوبات ، ويمكن للنيابة العامة أن تسخر القوة العمومية لتنفيذ هذا المقرر. يترتب على إلغاء مقرر الإفراج المشروط بالنسبة للمحكوم عليه قضاء ما تبقى من العقوبة المحكوم بها عليه، وتعد المدة التي قضاها في نظام الإفراج المشروط عقوبة مقضية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_147_permission_0_79129bf4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_147> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_147_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_147_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_147_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_147_20050206_OpEnact_340d118a7e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_147_obligation_0_de029354> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 147" ;
    dzdoc:position 146 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_145> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_145> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_147_condition_0_f6feb5ea> ;
    dzdoc:usesTerm dzterm:conditional_release,
        dzterm:judge_of_application_of_penalties,
        dzterm:minister_of_justice .

<https://legal.dz/resource/law/2005-02-06/05-04#art_153> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_7> ;
    dzdoc:eId "art_153" ;
    dzdoc:fullText "يخضع المحكوم عليه بالإعدام إلى نظام الحبس الانفرادي ليلا ونهارا . غير أنه بعد قضاء المحكوم عليه بالإعدام مدة خمس (5) سنوات في نظام الحبس الانفرادي ، يمكن أن يطبق علیه نظام الحبس الجماعي نهارا مع محبوسين من نفس الفئة، لا يقل عددهم عن ثلاثة (3) ولا يزيد على خمس(5)."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_153_permission_0_3735a840> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_153> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_153_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_153_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_153_20050206_OpEnact_bc51f30771> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_153_obligation_0_5e6449db> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "153" ;
    dzdoc:position 152 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_153_condition_0_8d7dc341> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_161> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_8> ;
    dzdoc:eId "art_161" ;
    dzdoc:fullText "إذا وصل إلى علم وزير العدل، حافظ الأختام ، أن مقرر قاضي تطبيق العقوبات المتخذ طبقا للمواد 129 و 130 و 141 من هذا القانون يؤثر على سلبا على الأمن أو النظام العام ، فله أن يعرض الأمر على لجنة تكييف العقوبات في أجل أقصاه ثلاثون (30) يوما. وفي حالة إلغاء المقرر ، يعاد المحكوم عليه المستفيد إلى نفس المؤسسة العقابية لقضاء باقي عقوبته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_161> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_161_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_161_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_161_20050206_OpEnact_016c37ea28> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
