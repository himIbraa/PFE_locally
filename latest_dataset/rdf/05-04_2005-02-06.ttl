<https://legal.dz/resource/law/2005-02-06/05-04#art_23_obligation_0_2326192d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2005-02-06/05-04#art_23_obligation_0_2326192d_role_aef11dbea9>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_23_obligation_0_2326192d_role_fd64cdeb39> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_23> ;
    dznorm:position 0 ;
    dznorm:provisionText "يسهر قاضي تطبيق العقوبات، فضلا عن الصلاحيات المخولة له بمقتضى أحكام هذا القانون، على مراقبة مشروعية تطبيق العقوبات السالبة للحرية، والعقوبات البديلة عند الاقتضاء، وعلى ضمان التطبيق السليم لتدابير تفريد العقوبة"@ar ;
    dznorm:sourceArticle "art_23" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_23_obligation_0_2326192d_role_aef11dbea9> a dznorm:Role ;
