    dznorm:position 0 ;
    dznorm:provisionText "تسهر إدارة السجون على حسن اختيار موظفي المؤسسات العقابية وتضمن ترقية دائمة لمستوى أدائهم المهني"@ar ;
    dznorm:sourceArticle "art_6" .

