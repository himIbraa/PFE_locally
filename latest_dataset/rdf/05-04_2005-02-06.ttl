dzterm:conditional_release a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الإفراج المشروط"@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:definesTerm dzterm:نظام_الورشات_الخارجية ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "يقصد بنظام الورشات الخارجية، قيام المحبوس المحكوم عليه نهائيا بعمل ضمن فرق خارج المؤسسة العقابية، تحت مراقبة إدارة السجون لحساب الهيئات والمؤسسات العمومية. يمكن تخصيص اليد العاملة من المحبوسين ضمن نفس الشروط، للعمل في المؤسسات الخاصة التي تساهم في إنجاز مشاريع ذات منفعة عامة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_100_permission_0_bb054086> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_100> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_100_defocc_b5feeb8a0b4c> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_100_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_100_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_100_20050206_OpEnact_71659e14d5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 100" ;
    dzdoc:position 99 ;
    dzdoc:usesTerm dzterm:المحبوس,
        dzterm:المحبوسين .

<https://legal.dz/resource/law/2005-02-06/05-04#art_119> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_5_sec_1> ;
    dzdoc:eId "art_119" ;
    dzdoc:fullText "يعامل الحدث خلال تواجده بالمركز، أو الجناح المخصص للأحداث بالمؤسسة العقابية، معاملة تراعي فيها مقتضيات سنه وشخصيته بما يصون كرامته، ويحقق له رعاية كاملة . ويستفيد الحدث المحبوس على وجه الخصوص من : وجبة غذائية متوازنة وكافية لنموه الجسدي والعقلي ، لباس مناسب ، رعاية صحية وفحوص طبية مستمرة ، فسحة في الهواء الطلق يوميا ، محادثة زائريه مباشرة من دون فاصل استعمال وسائل الاتصال عن بعد، تحت رقابة الإدارة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_119_right_0_9205e575>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_119_right_1_cf4df9a1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_119_right_2_d1531392>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_119_right_3_69f3b0e4>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_119_right_4_64e2c881>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_119_right_5_6c03e5a0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_119> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_119_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_119_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_119_20050206_OpEnact_28d187d846> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_119_obligation_0_4f21001f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "119" ;
    dzdoc:position 118 ;
    dzdoc:usesTerm dzterm:juvenile .

<https://legal.dz/resource/law/2005-02-06/05-04#art_145> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_6_sec_3> ;
    dzdoc:eId "art_145" ;
    dzdoc:fullText "يمكن قاضي تطبيق العقوبات أو وزير العدل، حافظ الأختام ، حسب حالة، أن يضمن مقرر الإفراج المشروط التزامات خاصة وتدابير مراقبة ومساعدة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_145_permission_0_b946105f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_145> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_145_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_145_20050206_OpEnact_1fcc85232b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 145" ;
    dzdoc:position 144 ;
    dzdoc:usesTerm dzterm:conditional_release,
        dzterm:judge_of_application_of_penalties,
        dzterm:minister_of_justice .

<https://legal.dz/resource/law/2005-02-06/05-04#art_155> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_7> ;
    dzdoc:eId "art_155" ;
    dzdoc:fullText "لا تنفذ عقوبة الإعدام إلا بعد رفض طلب العفو . كما لا تنفذ عقوبة الإعدام على الحامل أو المرضعة لطفل دون أربعة وعشرين (24) شهرا، ولا على المحكوم عليه المصاب بجنون أو بمرض خطير . لا تنفذ عقوبة الإعدام أيام الأعياد الوطنية والدينية، ولا يوم الجمعة، أو خلال شهر رمضان ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_155> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_155_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_155_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_155_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_155_20050206_OpEnact_7af43c7a86> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "155" ;
    dzdoc:position 154 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_155_condition_0_1521defd>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_155_condition_1_e2353fd4>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_155_condition_2_8c4bb696> .

dzterm:minister_of_justice a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "وزير العدل حافظ الأختام"@ar,
        "وزير العدل، حافظ الأختام"@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_106> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_106" ;
    dzdoc:fullText "يمكن أن يستفيد من نظام الحرية النصفية المحبوس : المحكوم عليه المبتدئ الذي بقي على انقضاء عقوبته أربعة وعشرين (24) شهرا. المحكوم عليه الذي سبق الحكم عليه بعقوبة سالبة للحرية، وقضى نصف (1/2) العقوبة، وبقي على انقضائها مدة لا تزيد عن أربعة وعشرين (24) شهرا. يوضع المحبوس في نظام الحرية النصفية بمقرر لـ قاضي تطبيق العقوبات ، بعد استشارة لجنة تطبيق العقوبات ، وتشعر بذلك المصالح المختصة بوزارة العدل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_106_permission_0_be1e4b18> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_106_right_0_40b97dc0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_106> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_106_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_106_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
