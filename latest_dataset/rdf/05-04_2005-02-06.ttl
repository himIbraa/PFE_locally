<https://legal.dz/resource/law/2005-02-06/05-04#version_art_7> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقصد بكلمة محبوس في مفهوم هذا القانون كل شخص تم إيداعه بمؤسسة عقابية، تنفيذا لأمر، أو حكم، أو قرار قضائي. ويصنف المحبوسون إلى: 1- محبوسين مؤقتا، وهم الأشخاص المتابعون جزائيا، والذين لم يصدر بشأنهم أمر ، أو حكم، أو قرار قضائي نهائي. 2- محبوسين محكوم عليهم، وهم الأشخاص الذين صدر في حقهم حكم أو قرار أصبح نهائيا. 3- محبوسين تنفيذا لإكراه بدني."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_7_20050206_OpEnact_f0e1a79ca8> ;
    dzdoc:replacementText "يقصد بكلمة محبوس في مفهوم هذا القانون كل شخص تم إيداعه بمؤسسة عقابية، تنفيذا لأمر، أو حكم، أو قرار قضائي. ويصنف المحبوسون إلى: 1- محبوسين مؤقتا، وهم الأشخاص المتابعون جزائيا، والذين لم يصدر بشأنهم أمر ، أو حكم، أو قرار قضائي نهائي. 2- محبوسين محكوم عليهم، وهم الأشخاص الذين صدر في حقهم حكم أو قرار أصبح نهائيا. 3- محبوسين تنفيذا لإكراه بدني."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_7> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_7> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-02-06"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2005-02-06/05-04#version_art_70> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للمحامي عند تقديمه رخصة الزيارة المسلمة له من السلطة القضائية المختصة، الحق في الاتصال بالمتهم بكل حرية من دون حضور عون الحراسة في غرفة المحادثة المعدة خصيصا لذلك . لا يقيد أو يبطل المنع من الاتصال، ولا التدابير التأديبية مهما تكن طبيعتها، حق المحبوس في الاتصال الحر بمحاميه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_70_20050206_OpEnact_b45d8f6d91> ;
    dzdoc:replacementText "للمحامي عند تقديمه رخصة الزيارة المسلمة له من السلطة القضائية المختصة، الحق في الاتصال بالمتهم بكل حرية من دون حضور عون الحراسة في غرفة المحادثة المعدة خصيصا لذلك . لا يقيد أو يبطل المنع من الاتصال، ولا التدابير التأديبية مهما تكن طبيعتها، حق المحبوس في الاتصال الحر بمحاميه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_70> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_70> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
