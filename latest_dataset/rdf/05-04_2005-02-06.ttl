<https://legal.dz/resource/law/2005-02-06/05-04#version_art_166> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من عشرة آلاف دينار (10.000دج) إلى خمسين ألف دينار (50.000 دج) كل من قام أو حاول بنفسه أو عن طريق الغير تسليم محبوس في غير الحالات المقررة قانونا، مبلغا ماليا أو مراسلة أو دواء، أو أي شيء آخر غير مرخص به . يتعرض لنفس العقوبة المنصوص عليها في الفقرة أعلاه، كل من قام أو حاول القيام في نفس الظروف، بإخراج الأشياء السالف ذكرها . وإذا كان الفاعل من مستخدمي المؤسسة العقابية أو شخصا مؤهلا للاقتراب من المحبوسين بسبب وظيفته أو مهنته يعاقب بالحبس من سن"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_166_20050206_OpEnact_c721b698b0> ;
    dzdoc:replacementText "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من عشرة آلاف دينار (10.000دج) إلى خمسين ألف دينار (50.000 دج) كل من قام أو حاول بنفسه أو عن طريق الغير تسليم محبوس في غير الحالات المقررة قانونا، مبلغا ماليا أو مراسلة أو دواء، أو أي شيء آخر غير مرخص به . يتعرض لنفس العقوبة المنصوص عليها في الفقرة أعلاه، كل من قام أو حاول القيام في نفس الظروف، بإخراج الأشياء السالف ذكرها . وإذا كان الفاعل من مستخدمي المؤسسة العقابية أو شخصا مؤهلا للاقتراب من المحبوسين بسبب وظيفته أو مهنته يعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة مالية من عشرة آلاف دينار (10.000 دج) إلى خمسين ألف دينار (50.000 دج) ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_166> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_166> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-02-06"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2005-02-06/05-04#version_art_167> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من عشرة آلاف دينار (10.000 دج) إلى خمسين ألف دينار (50.000 دج)، كل مستخدم تابع لإدارة السجون تسبب بتهاونه أو عدم حيطته أو عدم مراعاته الأنظمة في تعريض صحة المحبوسين أو نظام المؤسسة العقابية وأمنها، للخطر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_167_20050206_OpEnact_146b165611> ;
