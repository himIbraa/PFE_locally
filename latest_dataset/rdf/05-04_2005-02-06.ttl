<https://legal.dz/resource/law/2005-02-06/05-04#version_art_68> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسلم رخصة الزيارة للأشخاص المذكورين في المادة 66 أعلاه، لزيارة المحبوس المحكوم عليه نهائيا، من طرف مدير المؤسسة العقابية ، وهي صالحة لزيارة واحدة أو أكثر، بحسب ما حدد بها. تسلم رخصة زيارة للأشخاص المذكورين في المادة 67 أعلاه، لزيارة المحبوسين المحكوم عليهم من طرف قاضي تطبيق العقوبات . تسلم رخصة زيارة المحبوسين مؤقتا من طرف القاضي المختص، ومن طرف النيابة العامة بالنسبة للمحبوسين المستأنفين والطاعنين بالنقض ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_68_20050206_OpEnact_8b61824942> ;
    dzdoc:replacementText "تسلم رخصة الزيارة للأشخاص المذكورين في المادة 66 أعلاه، لزيارة المحبوس المحكوم عليه نهائيا، من طرف مدير المؤسسة العقابية ، وهي صالحة لزيارة واحدة أو أكثر، بحسب ما حدد بها. تسلم رخصة زيارة للأشخاص المذكورين في المادة 67 أعلاه، لزيارة المحبوسين المحكوم عليهم من طرف قاضي تطبيق العقوبات . تسلم رخصة زيارة المحبوسين مؤقتا من طرف القاضي المختص، ومن طرف النيابة العامة بالنسبة للمحبوسين المستأنفين والطاعنين بالنقض ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_68> ;
