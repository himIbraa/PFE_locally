<https://legal.dz/resource/law/2005-02-06/05-04#version_art_106> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن يستفيد من نظام الحرية النصفية المحبوس : المحكوم عليه المبتدئ الذي بقي على انقضاء عقوبته أربعة وعشرين (24) شهرا. المحكوم عليه الذي سبق الحكم عليه بعقوبة سالبة للحرية، وقضى نصف (1/2) العقوبة، وبقي على انقضائها مدة لا تزيد عن أربعة وعشرين (24) شهرا. يوضع المحبوس في نظام الحرية النصفية بمقرر لـ قاضي تطبيق العقوبات ، بعد استشارة لجنة تطبيق العقوبات ، وتشعر بذلك المصالح المختصة بوزارة العدل."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_106_20050206_OpEnact_8b713b7287> ;
    dzdoc:replacementText "يمكن أن يستفيد من نظام الحرية النصفية المحبوس : المحكوم عليه المبتدئ الذي بقي على انقضاء عقوبته أربعة وعشرين (24) شهرا. المحكوم عليه الذي سبق الحكم عليه بعقوبة سالبة للحرية، وقضى نصف (1/2) العقوبة، وبقي على انقضائها مدة لا تزيد عن أربعة وعشرين (24) شهرا. يوضع المحبوس في نظام الحرية النصفية بمقرر لـ قاضي تطبيق العقوبات ، بعد استشارة لجنة تطبيق العقوبات ، وتشعر بذلك المصالح المختصة بوزارة العدل."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_106> ;
