<https://legal.dz/resource/law/2005-02-06/05-04#version_art_128> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تختص لجنة إعادة التربية على الخصوص بما يأتي : إعداد برامج التعليم وفقا للبرامج الوطنية المعتمدة، إعداد برامج السنوية لمحو الأمية والتكوين المهني، دراسة واقتراح كل التدابير الرامية إلى تكييف وتفريد العقوبة المنصوص عليها في هذا القانون، تقييم تنفيذ تطبيق برامج إعادة التربية وإعادة الإدماج الاجتماعي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_128_20050206_OpEnact_1766f2fd24> ;
    dzdoc:replacementText "تختص لجنة إعادة التربية على الخصوص بما يأتي : إعداد برامج التعليم وفقا للبرامج الوطنية المعتمدة، إعداد برامج السنوية لمحو الأمية والتكوين المهني، دراسة واقتراح كل التدابير الرامية إلى تكييف وتفريد العقوبة المنصوص عليها في هذا القانون، تقييم تنفيذ تطبيق برامج إعادة التربية وإعادة الإدماج الاجتماعي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_128> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
