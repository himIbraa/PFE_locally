    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_167> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من عشرة آلاف دينار (10.000 دج) إلى خمسين ألف دينار (50.000 دج)، كل مستخدم تابع لإدارة السجون تسبب بتهاونه أو عدم حيطته أو عدم مراعاته الأنظمة في تعريض صحة المحبوسين أو نظام المؤسسة العقابية وأمنها، للخطر"@ar ;
    dznorm:sourceArticle "art_167" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_167_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_167> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من عشرة آلاف دينار (10.000 دج) إلى خمسين ألف دينار (50.000 دج)، كل مستخدم تابع لإدارة السجون تسبب بتهاونه أو عدم حيطته أو عدم مراعاته الأنظمة في تعريض صحة المحبوسين أو نظام المؤسسة العقابية وأمنها، للخطر."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_168_obligation_0_c8328b1b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_168> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من خمسة آلاف دينار (5.000 دج) إلى عشرين ألف دينار (20.000 دج)، كل من قام أو ساهم في نشر بيانات أو وثائق لها علاقة بتنفيذ عقوبة الإعدام، فيما عدا محضر التنفيذ، والبلاغ الصادر عن وزارة العدل"@ar ;
    dznorm:sourceArticle "art_168" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_168_obligation_1_6adc69e9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2005-02-06/05-04#art_168_obligation_1_6adc69e9_role_af3264f40f> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_168> ;
    dznorm:position 1 ;
    dznorm:provisionText "يتعرض لنفس العقوبة المنصوص عليها في الفقرة أعلاه، كل من نشر أو أفشى أو أذاع خبرا بأية وسيلة كانت عن قرار رئيس الجمهورية المتعلق بالعفو قبل تبليغ مرسوم العفو للمحكوم عليه بالإعدام وتعليق محضر التنفيذ وتسجيل العفو على النسخة الأصلية لحكم الإدانة"@ar ;
    dznorm:sourceArticle "art_168" .

