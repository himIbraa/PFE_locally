<https://legal.dz/resource/law/2005-02-06/05-04#art_43_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_43> ;
    dzdoc:position 0 ;
    dzdoc:text "تتوفر كل المؤسسة عقابية على نطاق أمني يتم تحديده بموجب قرار من وزير العدل حافظ الأختام، بعد أخذ رأي الوالي."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_44_obligation_0_060bc4d4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
