    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_71> ;
    dznorm:hasCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_71_obligation_1_9f09ae9a_condition_0> ;
    dznorm:position 1 ;
    dznorm:provisionText "تسلم له طبقا لأحكام المادة 68 الفقرة (3) أعلاه، إذا كان محبوسا مؤقتا"@ar ;
    dznorm:sourceArticle "art_71" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_7_defocc_0beb05e4627c> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 105 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:detainee ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_7> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_7_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يقصد بكلمة محبوس في مفهوم هذا القانون كل شخص تم إيداعه بمؤسسة عقابية، تنفيذا لأمر، أو حكم، أو قرار قضائي."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_7_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_7> ;
    dzdoc:position 0 ;
    dzdoc:text "يقصد بكلمة محبوس في مفهوم هذا القانون كل شخص تم إيداعه بمؤسسة عقابية، تنفيذا لأمر، أو حكم، أو قرار قضائي."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_98_defocc_9b20aa7b4854> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 93 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:financial_gain ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_98> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_98_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يتكون المكسب المالي للمحبوس من المبالغ التي يمتلكها والمنح التي يتحصل عليها مقابل عمله المؤدى."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_98_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_98> ;
    dzdoc:position 0 ;
    dzdoc:text "يتكون المكسب المالي للمحبوس من المبالغ التي يمتلكها والمنح التي يتحصل عليها مقابل عمله المؤدى."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#preamble_segment_0> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
