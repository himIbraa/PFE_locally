<https://legal.dz/resource/law/2005-02-06/05-04#version_art_51> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسهر إدارة المؤسسة العقابية بالتنسيق مع المصالح المختصة بالشؤون الاجتماعية، حال وضع المحبوسة حملها، على إيجاد جهة تتكفل بالمولود وتربيته . ويمكن المحبوسة حال تعذر إيجاد كفيل للمولود، أو أي جهة عمومية أو خاصة لتربية ورعايته، أن تبقيه معها إلى بلوغه ثلاث (3) سنوات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_51_20050206_OpEnact_eb40b0806a> ;
    dzdoc:replacementText "تسهر إدارة المؤسسة العقابية بالتنسيق مع المصالح المختصة بالشؤون الاجتماعية، حال وضع المحبوسة حملها، على إيجاد جهة تتكفل بالمولود وتربيته . ويمكن المحبوسة حال تعذر إيجاد كفيل للمولود، أو أي جهة عمومية أو خاصة لتربية ورعايته، أن تبقيه معها إلى بلوغه ثلاث (3) سنوات ."@ar ;
