<https://legal.dz/resource/law/2005-02-06/05-04#version_art_21> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحدث لجنة وزارية مشتركة لتنسيق نشاطات إعادة تربية المحبوسين، وإعادة إدماجهم الاجتماعي ، هدفها مكافحة الجنوح وتنظيم الدفاع الاجتماعي. يحدد تنظيم هذه اللجنة ومهامها وسيرها عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_21_20050206_OpEnact_99a54dd088> ;
