<https://legal.dz/resource/law/2005-02-06/05-04#art_121_obligation_0_1ff6e8a7_role_7bd3d3311d> a dznorm:Role ;
    rdfs:label "المدير"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يجب على المدير، في جميع الحالات، إخطار لجنة إعادة التربية المنصوص عليها في المادة 126 من هذا القانون، بكل التدابير المتخذة ضد الحدث المحبوس"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_121> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_121_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_121> ;
    dzdoc:position 0 ;
    dzdoc:text "يتعرض الحدث المحبوس الذي يخالف قواعد الانضباط والأمن والنظافة إلى أحد التدابير التأديبية الآتية : الإنذار، التوبيخ، الحرمان المؤقت من بعض النشاطات الترفيهية، المنع المؤقت من التصرف في مكسبه المالي."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_121_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_121> ;
    dzdoc:position 1 ;
    dzdoc:text "يقرر مدير المركز أو المؤسسة العقابية، حسب الحالة التدبيرين الأول والثاني، ولا يقرر التدبيرين الثالث والرابع، إلا بعد أخذ رأي لجنة التأديب المنصوص عليها في المادة 122 من هذا القانون."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_121_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_121> ;
    dzdoc:position 2 ;
    dzdoc:text "يجب على المدير، في جميع الحالات، إخطار لجنة إعادة التربية المنصوص عليها في المادة 126 من هذا القانون، بكل التدابير المتخذة ضد الحدث المحبوس."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_122_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_122> ;
    dzdoc:position 0 ;
    dzdoc:text "تحدث على مستوى كل مركز إعادة التربية وإدماج الأحداث، وفي كل جناح للأحداث بالمؤسسات العقابية، لجنة للتأديب يرأسها مدير مركز إعادة التربية وإدماج الأحداث، أو مدير المؤسسة العقابية، حسب وتتشكل من عضوية : رئيس مصلحة الاحتباس، مختص في علم النفس، مساعدة اجتماعية، الحالة، مرب."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_123_obligation_0_e05968cf> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_123> ;
    dznorm:position 0 ;
    dznorm:provisionText "تسند إدارة مركز إعادة تربية وإدماج الأحداث إلى مدير يختار من بين الموظفين المؤهلين الذين يولون اهتماما خاصا لشؤون الأحداث الجانحين"@ar ;
    dznorm:sourceArticle "art_123" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_123_obligation_1_201cafb5> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2005-02-06/05-04#art_123_obligation_1_201cafb5_role_3df1d94501>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_123_obligation_1_201cafb5_role_bb4f834a32> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_123> ;
    dznorm:position 1 ;
    dznorm:provisionText "يعمل تحت إشراف المدير موظفون يسهرون على تربية الأحداث وتكوينهم الدراسي والمهني، وعلى متابعة تطور سلوكهم، لإحياء شعورهم بالمسؤولية والواجب تجاه المجتمع"@ar ;
    dznorm:sourceArticle "art_123" .

