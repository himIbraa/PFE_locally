dzterm:penal_institution a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المؤسسة العقابية"@ar,
        "المؤسسة العقابية هي مكان للحبس تنفذ فيه وفقا للقانون العقوبات السالبة للحرية، والأوامر الصادرة عن الجهات القضائية، والإكراه البدني عند الاقتضاء."@ar,
        "مؤسسة عقابية"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_25_defocc_d9679c4b8095> .

dzterm:penitentiary_establishment a skos:Concept,
