<https://legal.dz/resource/law/2005-02-06/05-04#version_art_87> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يصبح المحبوس يشكل خطرا على حفظ النظام والأمن داخل المؤسسة العقابية، أو تصبح التدابير التأديبية المتخذة حياله غير مجدية ، يتم تحويله إلى مؤسسة من المؤسسات العقابية التي تتوفر على الأجنحة المدعمة أمنيا."@ar ;
