<https://legal.dz/resource/law/2005-02-06/05-04#version_art_42> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن إخضاع المحبوس للتدابير الوقائية، باستعمال وسائل التحكم أو الوسائل الطبية الملائمة في الحالات الآتية : 1- إذا أظهر المحبوس عدوانية، أو صدر عنه عنف جسدي خطير تجاه الغير، 2- إذا حاول المحبوس الانتحار، أو تشويه جسده، 3- إذا اختلت قواه العقلية، وفي الحالتين 2 و 3 أعلاه، يخطر الطبيب والأخصائي النفساني للمؤسسة العقابية فورا لاتخاذ التدابير اللازمة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_42_20050206_OpEnact_89713195ec> ;
    dzdoc:replacementText "يمكن إخضاع المحبوس للتدابير الوقائية، باستعمال وسائل التحكم أو الوسائل الطبية الملائمة في الحالات الآتية : 1- إذا أظهر المحبوس عدوانية، أو صدر عنه عنف جسدي خطير تجاه الغير، 2- إذا حاول المحبوس الانتحار، أو تشويه جسده، 3- إذا اختلت قواه العقلية، وفي الحالتين 2 و 3 أعلاه، يخطر الطبيب والأخصائي النفساني للمؤسسة العقابية فورا لاتخاذ التدابير اللازمة ."@ar ;
