<https://legal.dz/resource/law/2005-02-06/05-04#version_art_105> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تمنح الاستفادة من نظام الحرية النصفية للمحبوس وفق الشروط المحددة في هذا القسم ، لتمكينه من تأدية عمل، أو مزاولة دروس في التعليم العام أو التقني، أو متابعة دراسات عليا أو تكوين مهني."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
