    skos:prefLabel "المؤسسة العقابية"@ar,
        "للمؤسسة العقابية"@ar,
        "مؤسسة عقابية"@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_105> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_105" ;
    dzdoc:fullText "تمنح الاستفادة من نظام الحرية النصفية للمحبوس وفق الشروط المحددة في هذا القسم ، لتمكينه من تأدية عمل، أو مزاولة دروس في التعليم العام أو التقني، أو متابعة دراسات عليا أو تكوين مهني."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_105_right_0_b4360484> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_105> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_105_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_105_20050206_OpEnact_08a6ae4aee> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "105" ;
    dzdoc:position 104 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_105_condition_0_3b1badf8> ;
    dzdoc:usesTerm dzterm:نظام_الحرية_النصفية .

<https://legal.dz/resource/law/2005-02-06/05-04#art_111> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_2_subsec_3> ;
    dzdoc:eId "art_111" ;
    dzdoc:fullText "يتخذ قاضي تطبيق العقوبات مقرر الوضع في نظام البيئة المفتوحة بعد استشارة لجنة تطبيق العقوبات، وإشعار المصالح المختصة بوزارة العدل بذلك . يقرر الرجوع إلى نظام البيئة المغلقة بنفس الطريقة التي تم بها الوضع في نظام البيئة المفتوحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_111> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_111_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_111_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_111_20050206_OpEnact_08b1db6ad8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 111" ;
    dzdoc:position 110 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_111_condition_0_427500f9> ;
    dzdoc:usesTerm dzterm:judge_application_sentences,
        dzterm:open_environment_system .

<https://legal.dz/resource/law/2005-02-06/05-04#art_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_3> ;
    dzdoc:eId "art_114" ;
    dzdoc:fullText "تؤسس مساعدة اجتماعية ومالية تمنح للمحبوسين المعوزين عند الإفراج عنهم . تحدد شروط وكيفيات منح هذه المساعدة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_114> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_114_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_114_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_114_20050206_OpEnact_7b468b2f41> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_114_obligation_0_94265358> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 114" ;
    dzdoc:position 113 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_122> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_5_sec_1> ;
    dzdoc:eId "art_122" ;
    dzdoc:fullText "تحدث على مستوى كل مركز إعادة التربية وإدماج الأحداث، وفي كل جناح للأحداث بالمؤسسات العقابية، لجنة للتأديب يرأسها مدير مركز إعادة التربية وإدماج الأحداث، أو مدير المؤسسة العقابية، حسب وتتشكل من عضوية : رئيس مصلحة الاحتباس، مختص في علم النفس، مساعدة اجتماعية، الحالة، مرب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_122> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_122_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_122_20050206_OpEnact_23a53bf26a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "122" ;
    dzdoc:position 121 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_138> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_6_sec_3> ;
    dzdoc:eId "art_138" ;
    dzdoc:fullText "يحيل قاضي تطبيق العقوبات طلب الإفراج المشروط على لجنة تطبيق العقوبات للبت فيه ، وفقا لأحكام هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_138> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_138_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_138_20050206_OpEnact_6594fcd4e1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_138_obligation_0_b69c015b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 138" ;
    dzdoc:position 137 ;
    dzdoc:usesTerm dzterm:conditional_release,
        dzterm:judge_execution .

<https://legal.dz/resource/law/2005-02-06/05-04#art_139> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_6_sec_3> ;
    dzdoc:eId "art_139" ;
    dzdoc:fullText "يجب أن تتضمن تشكيلة لجنة تطبيق العقوبات عند بتها في طلب الإفراج المشروط لمحبوس حدث، عضوية قاضي الأحداث، بصفته رئيس لجنة إعادة التربية، وكذا مدير مركز إعادة التربية وإدماج الأحداث ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_139> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_139_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_139_20050206_OpEnact_008b29e461> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_139_obligation_0_4e1aa829> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 139" ;
    dzdoc:position 138 ;
    dzdoc:usesTerm dzterm:conditional_release .

<https://legal.dz/resource/law/2005-02-06/05-04#art_140> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_6_sec_3> ;
    dzdoc:eId "art_140" ;
    dzdoc:fullText "يجب أن يتضمن ملف الإفراج المشروط تقريرا مسببا لمدير المؤسسة العقابية، أو مدير مركز إعادة التربية وإدماج الأحداث حسب الحالة، حول سيرة وسلوك المحبوس ، والمعطيات الجدية لضمان استقامته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_140> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_140_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_140_20050206_OpEnact_b494e9f17f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_140_obligation_0_d7b8bf18> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 140" ;
    dzdoc:position 139 ;
    dzdoc:usesTerm dzterm:conditional_release,
        dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_150> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_6_sec_3> ;
    dzdoc:eId "art_150" ;
    dzdoc:fullText "يمكن أن يخضع المفرج عنه بشرط لأسباب صحية لنفس الشروط والتدابير المنصوص عليها في المادة 145 من هذا القانون، ما لم تتناف مع حالته الصحية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_150_permission_0_397a21e0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_150> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_150_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_150_20050206_OpEnact_4a6583d771> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 150" ;
    dzdoc:position 149 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_145> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_145> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_158> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_8> ;
    dzdoc:eId "art_158" ;
    dzdoc:fullText "تحدث مدارس متخصصة تضمن تكوين موظفي إدارة السجون وتحسين مستواهم المهني . ويحدد تنظيمها وسيرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_158> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_158_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_158_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_158_20050206_OpEnact_cf73964f97> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_158_obligation_0_2533de13> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 158" ;
    dzdoc:position 157 ;
    dzdoc:usesTerm dzterm:prison_staff .

<https://legal.dz/resource/law/2005-02-06/05-04#art_163> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_8> ;
    dzdoc:eId "art_163" ;
    dzdoc:fullText "تمنع الإشارة في الإجازات والشهادات التي تسلم للمحبوسين تطبيقا لأحكام هذا القانون، أنهم تحصلوا عليها خلال فترة حبسهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_163> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_163_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_163_20050206_OpEnact_4dd6a2e129> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_163_obligation_0_cdc61654> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 163" ;
    dzdoc:position 162 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_174> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_10> ;
    dzdoc:eId "art_174" ;
    dzdoc:fullText "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 27 ذي الحجة عام 1425 الموافق 6 فبراير سنة 2005. عبد العزيز بوتفليقة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_174> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_174_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_174_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_174_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_174_20050206_OpEnact_dd8da7b329> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 174" ;
    dzdoc:position 173 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_32> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_32" ;
    dzdoc:fullText "يقرر وزير العدل حافظ الأختام ، بناء على اقتراح من إدارة السجون، نظاما داخليا نموذجيا للمؤسسات العقابية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_32> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_32_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_32_20050206_OpEnact_358978d5f6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_32_obligation_0_7439a3dd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "32" ;
    dzdoc:position 31 ;
    dzdoc:usesTerm dzterm:minister_of_justice .

<https://legal.dz/resource/law/2005-02-06/05-04#art_57> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_57" ;
    dzdoc:fullText "الحق في الرعاية الصحية مضمون لجميع فئات المحبوسين . يستفيد المحبوس من الخدمات الطبية في مصحة المؤسسة العقابية ، وعند الضرورة في أي مؤسسة إستشفائية أخرى."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_57_right_0_dc76fb8c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_57> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_57_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_57_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_57_20050206_OpEnact_3d069df46e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "57" ;
    dzdoc:position 56 ;
    dzdoc:usesTerm dzterm:penitentiary_institution,
        dzterm:prisoner,
        dzterm:prisoners .

<https://legal.dz/resource/law/2005-02-06/05-04#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_1> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "تسهر إدارة السجون على حسن اختيار موظفي المؤسسات العقابية وتضمن ترقية دائمة لمستوى أدائهم المهني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_6_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_6_20050206_OpEnact_06c559c7a6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_6_obligation_0_c617eea0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "6" ;
    dzdoc:position 5 ;
    dzdoc:usesTerm dzterm:prison_administration .

<https://legal.dz/resource/law/2005-02-06/05-04#art_63> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_63" ;
    dzdoc:fullText "يجب أن تكون الوجبة الغذائية للمحبوسين متوازنة، وذات قيمة غذائية كافية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_63> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_63_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_63_20050206_OpEnact_d8c3ffa0f5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_63_obligation_0_8e60f94b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "63" ;
    dzdoc:position 62 ;
    dzdoc:usesTerm dzterm:prisoners .

<https://legal.dz/resource/law/2005-02-06/05-04#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:definesTerm dzterm:detainee ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_1> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "يقصد بكلمة محبوس في مفهوم هذا القانون كل شخص تم إيداعه بمؤسسة عقابية، تنفيذا لأمر، أو حكم، أو قرار قضائي. ويصنف المحبوسون إلى: 1- محبوسين مؤقتا، وهم الأشخاص المتابعون جزائيا، والذين لم يصدر بشأنهم أمر ، أو حكم، أو قرار قضائي نهائي. 2- محبوسين محكوم عليهم، وهم الأشخاص الذين صدر في حقهم حكم أو قرار أصبح نهائيا. 3- محبوسين تنفيذا لإكراه بدني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_7> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_7_defocc_0beb05e4627c> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_7_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_7_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_7_20050206_OpEnact_f0e1a79ca8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "7" ;
    dzdoc:position 6 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_70" ;
    dzdoc:fullText "للمحامي عند تقديمه رخصة الزيارة المسلمة له من السلطة القضائية المختصة، الحق في الاتصال بالمتهم بكل حرية من دون حضور عون الحراسة في غرفة المحادثة المعدة خصيصا لذلك . لا يقيد أو يبطل المنع من الاتصال، ولا التدابير التأديبية مهما تكن طبيعتها، حق المحبوس في الاتصال الحر بمحاميه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_70_right_0_e8c2f451>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_70_right_1_e2c18bd3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_70_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_70_20050206_OpEnact_b45d8f6d91> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 70" ;
    dzdoc:position 69 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "يمكن أن يرخص للمحبوس الاتصال عن بعد باستعمال الوسائل التي توفرها له المؤسسة العقابية. تحدد كيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_72_permission_0_f8208d6d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_72_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_72_20050206_OpEnact_847ca9d32b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 72" ;
    dzdoc:position 71 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "للمحبوس الحق في تلقي الحوالات البريدية أو المصرفية والطرود والأشياء التي ينتفع بها في حدود النظام الداخلي للمؤسسة العقابية، وتحت رقابة إدارتها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_76_right_0_7537443f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_76_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_76_20050206_OpEnact_29f219ea7a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 76" ;
    dzdoc:position 75 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_76_condition_0_4c63cf64> ;
    dzdoc:usesTerm dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_4> ;
    dzdoc:eId "art_87" ;
    dzdoc:fullText "عندما يصبح المحبوس يشكل خطرا على حفظ النظام والأمن داخل المؤسسة العقابية، أو تصبح التدابير التأديبية المتخذة حياله غير مجدية ، يتم تحويله إلى مؤسسة من المؤسسات العقابية التي تتوفر على الأجنحة المدعمة أمنيا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_87> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_87_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_87_20050206_OpEnact_d6a592765c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "87" ;
    dzdoc:position 86 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_87_condition_0_f3f6ddc3> ;
    dzdoc:usesTerm dzterm:prison_institution .

<https://legal.dz/resource/law/2005-02-06/05-04#art_93> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_1_subsec_1> ;
    dzdoc:eId "art_93" ;
    dzdoc:fullText "يمكن إدارة المؤسسة العقابية إصدار نشرية داخلية يساهم المحبوسون في إعدادها بإنتاجاتهم الأدبية والثقافية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_93_permission_0_6dfee005> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_93> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_93_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_93_20050206_OpEnact_adafa14b9b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 93" ;
    dzdoc:position 92 ;
    dzdoc:usesTerm dzterm:penitentiary_establishment .

<https://legal.dz/resource/law/2005-02-06/05-04#art_95> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_1_subsec_1> ;
    dzdoc:eId "art_95" ;
    dzdoc:fullText "يتم التكوين المهني داخل المؤسسة العقابية ، أو في معامل المؤسسات العقابية، أو في الورشات الخارجية، أو في مراكز التكوين المهني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_95> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_95_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_95_20050206_OpEnact_b592bc2845> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 95" ;
    dzdoc:position 94 ;
    dzdoc:usesTerm dzterm:penitentiary_establishment .

<https://legal.dz/resource/law/2005-02-06/05-04#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_1_subsec_2> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "في إطار عملية التكوين بغرض تأهيل المحبوس وإعادة إدماجه الاجتماعي، يتولى مدير المؤسسة العقابية ، بعد استطلاع رأي لجنة تطبيق العقوبات ، إسناد بعض الأعمال المفيدة للمحبوس ، مع واجب مراعاته في ذلك الحالة الصحية للمحبوس واستعداده البدني والنفسي، وقواعد حفظ النظام والأمن داخل المؤسسة العقابية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_96_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_96_20050206_OpEnact_97f6e554be> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_96_obligation_0_0ffbf5b1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_96_obligation_1_f56f19ec> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 96" ;
    dzdoc:position 95 ;
    dzdoc:usesTerm dzterm:prison,
        dzterm:prison_director,
        dzterm:prisoner,
        dzterm:sanctions_committee .

<https://legal.dz/resource/law/2005-02-06/05-04#art_99> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_1_subsec_2> ;
    dzdoc:eId "art_99" ;
    dzdoc:fullText "تسلم للمحبوس الذي اكتسب كفاءة مهنية من خلال عمله أثناء قضائه لعقوبته، شهادة عمل يوم الإفراج عنه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_99> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_99_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_99_20050206_OpEnact_bf76176ba7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_99_obligation_0_548369ae> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 99" ;
    dzdoc:position 98 ;
    dzdoc:usesTerm dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_1> a dzdoc:Section ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
