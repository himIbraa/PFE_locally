<https://legal.dz/resource/law/2005-02-06/05-04#version_art_34> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقوم هيئات الرقابة بالعمل تحت إشراف السلطة الوصية على ضمان المراقبة الإدارية ل المؤسسات العقابية ، ومتابعة نشاطها ودعم آليات إعادة تربية المحبوسين لإعادة إدماجهم الاجتماعي . يحدد تنظيم هيئات الرقابة ومهامها وسيرها عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_34_20050206_OpEnact_38dd3a5ad1> ;
    dzdoc:replacementText "تقوم هيئات الرقابة بالعمل تحت إشراف السلطة الوصية على ضمان المراقبة الإدارية ل المؤسسات العقابية ، ومتابعة نشاطها ودعم آليات إعادة تربية المحبوسين لإعادة إدماجهم الاجتماعي . يحدد تنظيم هيئات الرقابة ومهامها وسيرها عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_34> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
