<https://legal.dz/resource/law/2005-02-06/05-04#version_art_98> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتكون المكسب المالي للمحبوس من المبالغ التي يمتلكها والمنح التي يتحصل عليها مقابل عمله المؤدى . توزع إدارة المؤسسة العقابية المكسب المالي للمحبوس على ثلاث (3) حصص متساوية : 1- حصة ضمان لدفع الغرامات والمصاريف القضائية والاشتراكات القانونية، عند الاقتضاء. 2 - حصة قابلة للتصرف تخصص لاقتناء المحبوس حاجاته الشخصية والعائلية. 3- حصة احتياط تسلم للمحبوس عند الإفراج عنه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_98_20050206_OpEnact_9e8a0337e0> ;
    dzdoc:replacementText "يتكون المكسب المالي للمحبوس من المبالغ التي يمتلكها والمنح التي يتحصل عليها مقابل عمله المؤدى . توزع إدارة المؤسسة العقابية المكسب المالي للمحبوس على ثلاث (3) حصص متساوية : 1- حصة ضمان لدفع الغرامات والمصاريف القضائية والاشتراكات القانونية، عند الاقتضاء. 2 - حصة قابلة للتصرف تخصص لاقتناء المحبوس حاجاته الشخصية والعائلية. 3- حصة احتياط تسلم للمحبوس عند الإفراج عنه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_98> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_98> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-02-06"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

