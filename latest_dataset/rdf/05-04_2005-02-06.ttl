<https://legal.dz/resource/law/2005-02-06/05-04#art_132_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_132> ;
    dzdoc:position 0 ;
    dzdoc:text "يقدم طلب التوقيف المؤقت لتطبيق العقوبة السالبة للحرية من المحبوس أو ممثله القانوني، أو من أحد أفراد عائلته إلى قاضي تطبيق العقوبات."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_132_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_132> ;
    dzdoc:position 1 ;
    dzdoc:text "يجب أن يبت قاضي تطبيق العقوبات في الطلب خلال عشرة (10) أيام من تاريخ إخطاره."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_133_obligation_0_1820c90c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2005-02-06/05-04#art_133_obligation_0_1820c90c_period_4596fab0fd> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_133> ;
    dznorm:position 0 ;
    dznorm:provisionText "يخطر قاضي تطبيق العقوبات النيابة العامة والمحبوس بمقرر التوقيف المؤقت لتطبيق العقوبة، أو الرفض في أجل أقصاه ثلاثة (3) أيام من تاريخ البت في الطلب"@ar ;
    dznorm:sourceArticle "art_133" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_133_obligation_0_1820c90c_period_4596fab0fd> a dznorm:Period ;
