<https://legal.dz/resource/law/2005-02-06/05-04#art_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:definesTerm dzterm:open_environment_institutions ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_2_subsec_3> ;
    dzdoc:eId "art_109" ;
    dzdoc:fullText "تتخذ مؤسسات البيئة المفتوحة شكل مراكز ذات طابع فلاحي أو صناعي أو حرفي أو خدماتي، أو ذات منفعة عامة، وتتميز بتشغيل وإيواء المحبوسين بعين المكان."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_109> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_109_defocc_fc8d9af55ec0> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_109_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_109_20050206_OpEnact_dfc777159c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 109" ;
    dzdoc:position 108 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_116> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_5_sec_1> ;
    dzdoc:eId "art_116" ;
    dzdoc:fullText "يتم ترتيب وتوزيع الأحداث المحبوسين داخل مراكز إعادة تربية وإدماج الأحداث حسب جنسهم وسنهم ووضعيتهم الجزائية ، ويخضعون لفترة ملاحظة وتوجيه ومتابعة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_116> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_116_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_116_20050206_OpEnact_a44ccf7b1b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_116_obligation_0_3d5c5d9c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "116" ;
    dzdoc:position 115 ;
    dzdoc:usesTerm dzterm:juveniles .

<https://legal.dz/resource/law/2005-02-06/05-04#art_118> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_5_sec_1> ;
    dzdoc:eId "art_118" ;
    dzdoc:fullText "يستفيد الحدث في حدود ما هو ملائم له من التدابير الواردة في البابين الثالث والرابع من هذا القانون ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_118_right_0_ce509f8d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_118> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_118_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_118_20050206_OpEnact_f45eee61fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "118" ;
    dzdoc:position 117 ;
    dzdoc:usesTerm dzterm:juvenile .

<https://legal.dz/resource/law/2005-02-06/05-04#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_2> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "تنفذ العقوبة السالبة للحرية بمستخرج حكم أو قرار جزائي، يعده النائب العام أو وكيل الجمهورية ، يوضع بموجبه المحكوم عليه في المؤسسة العقابية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_12_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_12_20050206_OpEnact_f480c1edce> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_12_obligation_0_f9e9ee1a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "12" ;
    dzdoc:position 11 ;
    dzdoc:usesTerm dzterm:attorney_general,
        dzterm:custodial_sentence,
        dzterm:prosecutor_of_republic .

<https://legal.dz/resource/law/2005-02-06/05-04#art_142> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_6_sec_3> ;
    dzdoc:eId "art_142" ;
    dzdoc:fullText "يصدر وزير العدل، حافظ الأختام ، مقرر الإفراج المشروط عن المحبوس الباقي على انقضاء مدة عقوبته أكثر من أربعة وعشرين (24) شهرا، في الحالات المنصوص عليها في المادة 135 من هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_142> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_142_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_142_20050206_OpEnact_fe1f41804a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 142" ;
    dzdoc:position 141 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_135> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_135> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_142_condition_0_a38420ab> ;
    dzdoc:usesTerm dzterm:conditional_release,
        dzterm:minister_of_justice .

<https://legal.dz/resource/law/2005-02-06/05-04#art_149> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_6_sec_3> ;
    dzdoc:eId "art_149" ;
    dzdoc:fullText "يشكل ملف الإفراج المشروط لأسباب صحية، من طرف قاضي تطبيق العقوبات ، ويجب أن يتضمن فضلا عن تقرير مفصل من طبيب المؤسسة العقابية، تقرير خبرة طبية أو عقلية يعده ثلاثة (3) أطباء أخصائيين في المرض، يسخرون لهذا الغرض."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_149> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_149_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_149_20050206_OpEnact_4282d4964f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_149_obligation_0_72880e5c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 149" ;
    dzdoc:position 148 ;
    dzdoc:usesTerm dzterm:judge_of_application_of_penalties .

<https://legal.dz/resource/law/2005-02-06/05-04#art_151> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:definesTerm dzterm:death_row_inmate ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_7> ;
    dzdoc:eId "art_151" ;
    dzdoc:fullText "يقصد بالمحبوس المحكوم عليه بالإعدام في مفهوم هذا القانون : 1- المحبوس المحكوم عليه نهائيا بعقوبة الإعدام ، 2- المحبوس المحكوم عليه بالإعدام ولم يصبح الحكم نهائيا في حقه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_151> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_151_defocc_7aae7da6b6a2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_151_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_151_20050206_OpEnact_c8563312c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "151" ;
    dzdoc:position 150 ;
    dzdoc:usesTerm dzterm:death_row_inmate .

<https://legal.dz/resource/law/2005-02-06/05-04#art_152> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_7> ;
    dzdoc:eId "art_152" ;
    dzdoc:fullText "يحول كل محكوم عليه بالإعدام إلى إحدى المؤسسات العقابية المحددة بقرار من وزير العدل، حافظ الأختام ، ويودع بها في جناح مدعم أمنيا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_152> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_152_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_152_20050206_OpEnact_5ebf1e1334> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_152_obligation_0_62c3404e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "152" ;
    dzdoc:position 151 ;
    dzdoc:usesTerm dzterm:minister_of_justice .

<https://legal.dz/resource/law/2005-02-06/05-04#art_154> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_7> ;
    dzdoc:eId "art_154" ;
    dzdoc:fullText "يستفيد المحكوم عليه بالإعدام من فترة راحة وفسحة يقضيها منفردا أو مع محبوسين آخرين في جناح مخصص لذلك ، وفقا لنظام الداخلي للمؤسسة العقابية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_154_right_0_cae8000c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_154> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_154_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_154_20050206_OpEnact_ffbeb78f10> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "154" ;
    dzdoc:position 153 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_162> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_8> ;
    dzdoc:eId "art_162" ;
    dzdoc:fullText "يتلقى المحبوس مقابل كل عمل مؤدى، فيما عدا ما يقوم به من أعمال طبقا لأحكام المادة 81 من هذا القانون، منحة مالية تقدر وفق جدول يحدد بموجب قرار مشترك بين وزير العدل حافظ الأختام ، و الوزير المكلف بالعمل ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_162_right_0_9e3dec31> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_162> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_162_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_162_20050206_OpEnact_1d1c018244> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 162" ;
    dzdoc:position 161 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_81> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_81> ;
    dzdoc:usesTerm dzterm:minister_of_justice,
        dzterm:minister_of_labor,
        dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_164> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_8> ;
    dzdoc:eId "art_164" ;
    dzdoc:fullText "لإدارة السجون أن تبرم اتفاقيات مع هيئات عمومية أو خاصة بغرض تحسين تسيير المؤسسات العقابية، وتجسيد أهداف إعادة التربية والإدماج الاجتماعي للمحبوسين ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_164_right_0_69458373> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_164> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_164_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_164_20050206_OpEnact_edd3d3132c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 164" ;
    dzdoc:position 163 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_165> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_9> ;
    dzdoc:eId "art_165" ;
    dzdoc:fullText "يعاقب طبقا للأحكام المنصوص عليها في قانون العقوبات ، كل موظف تابع لإدارة السجون ، أو أي شخص يساهم في نشاطات إعادة التربية وإعادة إدماج المحبوسين، أفشى سرا مهنيا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_165> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_165_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_165_20050206_OpEnact_26fb7b3d95> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_165_obligation_0_b01bcb75> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 165" ;
    dzdoc:position 164 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2005-02-06/05-04#art_165_extref_6091b5e0> ;
    dzdoc:usesTerm dzterm:staff .

<https://legal.dz/resource/law/2005-02-06/05-04#art_167> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_9> ;
    dzdoc:eId "art_167" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من عشرة آلاف دينار (10.000 دج) إلى خمسين ألف دينار (50.000 دج)، كل مستخدم تابع لإدارة السجون تسبب بتهاونه أو عدم حيطته أو عدم مراعاته الأنظمة في تعريض صحة المحبوسين أو نظام المؤسسة العقابية وأمنها، للخطر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_167> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_167_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_167_20050206_OpEnact_146b165611> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_167_obligation_0_9f938be5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 167" ;
    dzdoc:position 166 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_1> ;
    dzdoc:eId "art_2" ;
    dzdoc:fullText "يعامل المحبوسون معاملة تصون كرامتهم الإنسانية ، وتعمل على الرفع من مستواهم الفكري والمعنوي بصفة دائمة، دون تمييز بسبب العرق أو الجنس أو اللغة أو الدين أو الرأي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_2_20050206_OpEnact_593a98db26> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_2_obligation_0_72ff7ed8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "2" ;
    dzdoc:position 1 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:definesTerm dzterm:family ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_3> ;
    dzdoc:eId "art_20" ;
    dzdoc:fullText "يقصد بالعائلة في مفهوم هذا القانون الزوج والأولاد والأب والأم والإخوة والأخوات والمكفولون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_20> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_20_defocc_9e92ec1bdd21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_20_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_20_20050206_OpEnact_5bf3bc9b92> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 20" ;
    dzdoc:position 19 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_29" ;
    dzdoc:fullText "تخصص بمؤسسات الوقاية ومؤسسات إعادة التربية عند اللزوم، أجنحة منفصلة ، لاستقبال المحبوسين مؤقتا من الأحداث والنساء، والمحكوم عليهم نهائيا، بعقوبة سالبة للحرية مهما تكن مدتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_29_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_29_20050206_OpEnact_42f8e0f54c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "29" ;
    dzdoc:position 28 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_29_condition_0_c3c48f70> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "يتم تحديد وتخصيص المؤسسات العقابية المنصوص عليها في هذا القسم بموجب قرار من وزير العدل حافظ الأختام ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_31_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_31_20050206_OpEnact_17864ca911> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_31_obligation_0_9f2e9e5f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "31" ;
    dzdoc:position 30 ;
    dzdoc:usesTerm dzterm:minister_of_justice .

<https://legal.dz/resource/law/2005-02-06/05-04#art_46> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:definesTerm dzterm:solitary_confinement_system ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_46" ;
    dzdoc:fullText "نظام الاحتباس الانفرادي هو نظام يخضع فيه المحبوس للعزلة عن باقي المحبوسين ليلا ونهارا ، ويطبق على الفئات الآتية : المحكوم عليه بالإعدام ، مع مراعاة أحكام المادة 155 من هذا القانون، المحكوم عليه بالسجن المؤبد، على ألا تتجاوز مدة العزلة ثلاث (3) سنوات، المحبوس الخطير، بناء على مقرر يصدره قاضي تطبيق العقوبات كتدبير وقائي بالوضع في العزلة لمدة محددة، المحبوس المريض أو المسن ويطبق عليه كتدبير صحي، بناء على رأي طبيب المؤسسة العقابية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_46> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_46_defocc_4e2ac31f5ead> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_46_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_46_20050206_OpEnact_b18991c3fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 46" ;
    dzdoc:position 45 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_155> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_155> ;
    dzdoc:usesTerm dzterm:judge_application_sentences,
        dzterm:penal_institution .

<https://legal.dz/resource/law/2005-02-06/05-04#art_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_1> ;
    dzdoc:eId "art_5" ;
    dzdoc:fullText "تتولى إدارة السجون ضمان تطبيق العقوبات السالبة للحرية والتدابير الأمنية، والعقوبات البديلة ، وفقا للقانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_5_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_5_20050206_OpEnact_f0b5a69ca3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_5_obligation_0_9b1c4ebb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "5" ;
    dzdoc:position 4 ;
    dzdoc:usesTerm dzterm:prison_administration .

<https://legal.dz/resource/law/2005-02-06/05-04#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "تستفيد المحبوسة الحامل بظروف احتباس ملائمة، لا سيما من حيث التغذية المتوازنة، والرعاية الطبية المستمرة، والحق في الزيارة والمحادثة مع زائريها من دون فاصل ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_50_right_0_4478218a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_50> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_50_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_50_20050206_OpEnact_e4832ac622> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 50" ;
    dzdoc:position 49 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_52" ;
    dzdoc:fullText "لا يؤشر في سجل الولادات بالحالة المدنية، ولا في شهادة ميلاد المولود بالمؤسسة العقابية، بأية بيانات تفيد بذلك، أو تظهر احتباس الأم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_52_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_52_20050206_OpEnact_21f41a6592> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_52_obligation_0_989526f8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 52" ;
    dzdoc:position 51 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_58> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_58" ;
    dzdoc:fullText "يتم فحص المحبوس وجوبا من طرف الطبيب والأخصائي النفساني عند دخوله إلى المؤسسة العقابية وعند الإفراج عنه، وكلما دعت الضرورة لذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_58> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_58_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_58_20050206_OpEnact_54f0c4358a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_58_obligation_0_2472e475> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "58" ;
    dzdoc:position 57 ;
    dzdoc:usesTerm dzterm:penitentiary_institution,
        dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "يتخذ مدير المؤسسة العقابية بالتنسيق مع الطبيب، وإذا اقتضى الأمر مع السلطات العمومية المؤهلة، كل التدابير الضرورية للوقاية من ظهور وانتشار الأوبئة، أو الأمراض المعدية بالمؤسسة العقابية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_62_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_62_20050206_OpEnact_0106f2b986> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_62_obligation_0_029ba209> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "62" ;
    dzdoc:position 61 ;
    dzdoc:usesTerm dzterm:penitentiary_institution .

<https://legal.dz/resource/law/2005-02-06/05-04#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "يسمح للمحبوس بالمحادثة مع زائريه دون فاصل، وفقا للنظام الداخلي للمؤسسة العقابية، وذلك من أجل توطيد أواصر العلاقات العائلية للمحبوس من جهة، وإعادة إدماجه اجتماعيا أو تربويا من جهة ثانية، أو لأي سبب آخر، لا سيما إذا تعلق بوضعه الصحي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_69_permission_0_8be5e740> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_69_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_69_20050206_OpEnact_e901692e58> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 69" ;
    dzdoc:position 68 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_2> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "تنفذ الأحكام الجزائية وفقا لأحكام هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_8_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_8_20050206_OpEnact_7a57de9fdd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_8_obligation_0_d941845a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "8" ;
    dzdoc:position 7 ;
    dzdoc:usesTerm dzterm:penal_judgments .

<https://legal.dz/resource/law/2005-02-06/05-04#art_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_2> ;
    dzdoc:eId "art_9" ;
    dzdoc:fullText "تنفذ العقوبة السالبة للحرية في مؤسسات البيئة المغلقة، ومؤسسات البيئة المفتوحة، وفق الكيفيات المحددة في القانون والتنظيم المعمول بهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_9_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_9_20050206_OpEnact_014c388dbe> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_9_obligation_0_031b0f99> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "9" ;
    dzdoc:position 8 ;
    dzdoc:usesTerm dzterm:custodial_sentence .

<https://legal.dz/resource/law/2005-02-06/05-04#art_97> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_1_subsec_2> ;
    dzdoc:eId "art_97" ;
    dzdoc:fullText "تقوم إدارة المؤسسة العقابية دون سواها، بتحصيل المقابل المالي لصالح المحبوس عن عمله المؤدى ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_97> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_97_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_97_20050206_OpEnact_aa0ad5a3e7> ;
