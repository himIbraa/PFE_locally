<https://legal.dz/resource/law/2005-02-06/05-04#version_art_74> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تخضع لرقابة مدير المؤسسة العقابية المراسلات الموجهة من المحبوس إلى محاميه أو التي يوجهها هذا الأخير إليه ، و لا يتم فتحها لأي عذر كان ، إلا إذا لم يظهر على الظرف ما يبين بأنها مرسلة إلى المحامي صادرة منه . يسري حكم الفقرة أعلاه على المراسلات الموجهة من المحبوس إلى السلطات القضائية والإدارية الوطنية. تخضع مراسلات المحبوس إلى المحامي بالخارج للسلطة التقديرية للنيابة العامة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_74_20050206_OpEnact_84db4c9218> ;
    dzdoc:replacementText "لا تخضع لرقابة مدير المؤسسة العقابية المراسلات الموجهة من المحبوس إلى محاميه أو التي يوجهها هذا الأخير إليه ، و لا يتم فتحها لأي عذر كان ، إلا إذا لم يظهر على الظرف ما يبين بأنها مرسلة إلى المحامي صادرة منه . يسري حكم الفقرة أعلاه على المراسلات الموجهة من المحبوس إلى السلطات القضائية والإدارية الوطنية. تخضع مراسلات المحبوس إلى المحامي بالخارج للسلطة التقديرية للنيابة العامة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_74> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_74> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-02-06"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

