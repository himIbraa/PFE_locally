<https://legal.dz/resource/law/2005-02-06/05-04#version_art_107> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يلتزم المحبوس المستفيد من نظام الحرية النصفية ، في تعهد مكتوب، باحترام الشروط التي يتضمنها مقرر الاستفادة. في حالة إخلال المحبوس بالتعهد، أو خرقه لأحد شروط الاستفادة ، يأمر مدير المؤسسة العقابية بإرجاع المحبوس، ويخبر قاضي تطبيق العقوبات ليقرر الإبقاء على الاستفادة من نظام الحرية النصفية ، أو وقفها، أو إلغائها، وذلك بعد استشارة لجنة تطبيق العقوبات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_107_20050206_OpEnact_2961a37e90> ;
    dzdoc:replacementText "يلتزم المحبوس المستفيد من نظام الحرية النصفية ، في تعهد مكتوب، باحترام الشروط التي يتضمنها مقرر الاستفادة. في حالة إخلال المحبوس بالتعهد، أو خرقه لأحد شروط الاستفادة ، يأمر مدير المؤسسة العقابية بإرجاع المحبوس، ويخبر قاضي تطبيق العقوبات ليقرر الإبقاء على الاستفادة من نظام الحرية النصفية ، أو وقفها، أو إلغائها، وذلك بعد استشارة لجنة تطبيق العقوبات ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_107> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
