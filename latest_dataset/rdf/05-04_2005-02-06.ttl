    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_139_20050206_OpEnact_008b29e461> ;
    dzdoc:replacementText "يجب أن تتضمن تشكيلة لجنة تطبيق العقوبات عند بتها في طلب الإفراج المشروط لمحبوس حدث، عضوية قاضي الأحداث، بصفته رئيس لجنة إعادة التربية، وكذا مدير مركز إعادة التربية وإدماج الأحداث ."@ar ;
