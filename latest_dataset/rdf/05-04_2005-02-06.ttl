<https://legal.dz/resource/law/2005-02-06/05-04#version_art_78> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحتفظ المحبوس بحق التصرف في أمواله في حدود أهليته القانونية، وبترخيص من القاضي المختص . لا يصح أي إجراء أو تصرف من المحبوس إلا بمعرفة موثق أو محضر قضائي أو موظف مؤهل قانونا ، و يتم وجوبا داخل المؤسسة العقابية بعد استصدار رخصة للزيارة ، طبقا لأحكام الفقرتين 1 و 2 من المادة 68 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_78_20050206_OpEnact_fa6c14a81c> ;
    dzdoc:replacementText "يحتفظ المحبوس بحق التصرف في أمواله في حدود أهليته القانونية، وبترخيص من القاضي المختص . لا يصح أي إجراء أو تصرف من المحبوس إلا بمعرفة موثق أو محضر قضائي أو موظف مؤهل قانونا ، و يتم وجوبا داخل المؤسسة العقابية بعد استصدار رخصة للزيارة ، طبقا لأحكام الفقرتين 1 و 2 من المادة 68 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_78> ;
