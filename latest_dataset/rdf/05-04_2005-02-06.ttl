<https://legal.dz/resource/law/2005-02-06/05-04#version_art_125> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لـ مدير مركز إعادة تربية وإدماج الأحداث ، أو مدير المؤسسة العقابية أن يمنح لـ الحدث المحبوس ، أثناء فصل الصيف، إجازة لمدة ثلاثين (30) يوما يقضيها عند عائلته، أو بإحدى المخيمات الصيفية أو مراكز الترفيه ، مع إخطار لجنة إعادة التربية المنصوص عليها في المادة 126 من هذا القانون . يمكن المدير أيضا، منح الحدث المحبوس حسن السيرة والسلوك عطلا استثنائية بمناسبة الأعياد الوطنية والدينية لقضائها مع عائلته ، غير أنه لا يمكن في جميع الأحوال، أن يتجاوز مجموع مدد العطل الاستثنائية عشرة (10) أيام في كل ثلاث"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_125_20050206_OpEnact_fd1e38c748> ;
    dzdoc:replacementText "يجوز لـ مدير مركز إعادة تربية وإدماج الأحداث ، أو مدير المؤسسة العقابية أن يمنح لـ الحدث المحبوس ، أثناء فصل الصيف، إجازة لمدة ثلاثين (30) يوما يقضيها عند عائلته، أو بإحدى المخيمات الصيفية أو مراكز الترفيه ، مع إخطار لجنة إعادة التربية المنصوص عليها في المادة 126 من هذا القانون . يمكن المدير أيضا، منح الحدث المحبوس حسن السيرة والسلوك عطلا استثنائية بمناسبة الأعياد الوطنية والدينية لقضائها مع عائلته ، غير أنه لا يمكن في جميع الأحوال، أن يتجاوز مجموع مدد العطل الاستثنائية عشرة (10) أيام في كل ثلاثة (3) أشهر ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_125> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_125> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-02-06"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2005-02-06/05-04#version_art_126> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحدث لدى كل مركز لإعادة التربية وإدماج الأحداث والمؤسسات العقابية المهيأة بجناح الاستقبال الأحداث، لجنة لإعادة التربية يرأسها قاضي الأحداث ، وتتشكل من عضوية : مدير مركز إعادة التربية وإدماج الأحداث، أو مدير المؤسسة العقابية، الطبيب، المختص في علم النفس، المربي، ممثل الوالي، رئيس المجلس الشعبي البلدي أو ممثله. يمكن لجنة إعادة التربية أن تستعين بأي شخص من شأنه أن يفيدها في أداء مهامها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_126_20050206_OpEnact_0adff42139> ;
    dzdoc:replacementText "تحدث لدى كل مركز لإعادة التربية وإدماج الأحداث والمؤسسات العقابية المهيأة بجناح الاستقبال الأحداث، لجنة لإعادة التربية يرأسها قاضي الأحداث ، وتتشكل من عضوية : مدير مركز إعادة التربية وإدماج الأحداث، أو مدير المؤسسة العقابية، الطبيب، المختص في علم النفس، المربي، ممثل الوالي، رئيس المجلس الشعبي البلدي أو ممثله. يمكن لجنة إعادة التربية أن تستعين بأي شخص من شأنه أن يفيدها في أداء مهامها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_126> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_126> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-02-06"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

