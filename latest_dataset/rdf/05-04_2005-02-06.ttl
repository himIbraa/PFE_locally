<https://legal.dz/resource/law/2005-02-06/05-04#version_art_17> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤجل تنفيذ العقوبة في الحالات المنصوص عليها في المادة 16 أعلاه، لمدة لا تزيد عن ستة (6) أشهر، فيما عدا الحالات الآتية : في حالة الحمل، وإلى ما بعد وضع الحامل حملها بشهرين كاملين حال وضعها له ميتا، وإلى أربعة (24) وعشرين شهرا، حال وضعها له حيا. في حالة المرض الخطير الذي ثبت تنافيه مع الحبس إلى حين زوال حالة التنافي. في الحالتين 8 و 9 من المادة 16 أعلاه، ينقضي الأجل بالفصل في طلب العفو. في الحالة 10 من المادة 16 أعلاه، ينقضي الأجل بانتهاء مدة الخدمة الوطنية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_17_20050206_OpEnact_44d39410c7> ;
    dzdoc:replacementText "يؤجل تنفيذ العقوبة في الحالات المنصوص عليها في المادة 16 أعلاه، لمدة لا تزيد عن ستة (6) أشهر، فيما عدا الحالات الآتية : في حالة الحمل، وإلى ما بعد وضع الحامل حملها بشهرين كاملين حال وضعها له ميتا، وإلى أربعة (24) وعشرين شهرا، حال وضعها له حيا. في حالة المرض الخطير الذي ثبت تنافيه مع الحبس إلى حين زوال حالة التنافي. في الحالتين 8 و 9 من المادة 16 أعلاه، ينقضي الأجل بالفصل في طلب العفو. في الحالة 10 من المادة 16 أعلاه، ينقضي الأجل بانتهاء مدة الخدمة الوطنية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_17> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_17> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-02-06"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2005-02-06/05-04#version_art_170> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "دون الإخلال بتطبيق عقوبات أشد منصوص عليها قانونا، يعاقب بالحبس من ثلاث (3) سنوات إلى خمس (5) سنوات، وبغرامة من عشرة آلاف دينار (10.000 دج إلى خمسين ألف دينار (50.000)، كل من أدخل أو حاول إدخال مواد مخدرة، أو مواد مؤثرة عقليا، أو أسلحة أو ذخيرة، إلى المؤسسة العقابية . إذا كان الفاعل من مستخدمي المؤسسة العقابية، أو شخصا مؤهلا للاقتراب من المحبوسين بسبب وظيفته ، يعاقب بالحبس من خمس (5) سنوات إلى سبع (7) سنوات، وبغرامة من خمسين ألف دينار (50.000 دج) إلى مائة ألف دينار (100.000 دج) ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_170_20050206_OpEnact_69a3ef9568> ;
    dzdoc:replacementText "دون الإخلال بتطبيق عقوبات أشد منصوص عليها قانونا، يعاقب بالحبس من ثلاث (3) سنوات إلى خمس (5) سنوات، وبغرامة من عشرة آلاف دينار (10.000 دج إلى خمسين ألف دينار (50.000)، كل من أدخل أو حاول إدخال مواد مخدرة، أو مواد مؤثرة عقليا، أو أسلحة أو ذخيرة، إلى المؤسسة العقابية . إذا كان الفاعل من مستخدمي المؤسسة العقابية، أو شخصا مؤهلا للاقتراب من المحبوسين بسبب وظيفته ، يعاقب بالحبس من خمس (5) سنوات إلى سبع (7) سنوات، وبغرامة من خمسين ألف دينار (50.000 دج) إلى مائة ألف دينار (100.000 دج) ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
