dzorg:الجريدة_الرسمية a dzdoc:Organization ;
    rdfs:label "الجريدة الرسمية"@ar ;
    dzdoc:frbrUri "/ontology/organization/dz/joradp"^^xsd:anyURI .

<https://legal.dz/resource/law/2005-02-06/05-04#art_100_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_100> ;
    dzdoc:position 1 ;
    dzdoc:text "يمكن تخصيص اليد العاملة من المحبوسين ضمن نفس الشروط، للعمل في المؤسسات الخاصة التي تساهم في إنجاز مشاريع ذات منفعة عامة."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_100_permission_0_bb054086> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2005-02-06/05-04#art_100_permission_0_bb054086_action_e38dc3077d> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_100> ;
    dznorm:position 1 ;
    dznorm:provisionText "يمكن تخصيص اليد العاملة من المحبوسين ضمن نفس الشروط، للعمل في المؤسسات الخاصة التي تساهم في إنجاز مشاريع ذات منفعة عامة."@ar ;
    dznorm:sourceArticle "art_100" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_100_permission_0_bb054086_action_e38dc3077d> a dznorm:Action ;
    rdfs:label "تخصيص اليد العاملة من المحبوسين"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يمكن تخصيص اليد العاملة من المحبوسين ضمن نفس الشروط، للعمل في المؤسسات الخاصة التي تساهم في إنجاز مشاريع ذات منفعة عامة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_100> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_101_condition_0_3757cce4> a dznorm:Condition ;
    dznorm:conditionText "قضى ثلث (1/3) العقوبة المحكوم بها عليه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_101> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_101_condition_1_42567870> a dznorm:Condition ;
    dznorm:conditionText "قضى نصف (1/2) العقوبة المحكوم بها عليه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_101> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_101_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_101> ;
    dzdoc:position 0 ;
    dzdoc:text "يوضع في الورشات الخارجية من المحبوسين : 1- المحبوس المبتدئ الذي قضى ثلث (1/3) العقوبة المحكوم بها عليه. 2- المحبوس الذي سبق الحكم عليه بعقوبة سالبة للحرية وقضى نصف (1/2) العقوبة المحكوم بها عليه."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_101_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_101> ;
    dzdoc:position 1 ;
    dzdoc:text "يتم الوضع في الورشات الخارجية وفقا للشروط المحددة في المادة 95 من هذا القانون بموجب مقرر يصدره قاضي تطبيق العقوبات، ويشعر به المصالح المختصة بوزارة العدل."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_102_obligation_0_93a30b54> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2005-02-06/05-04#art_102_obligation_0_93a30b54_period_b8462d9933> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_102> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتولى مهمة حراسة المحبوس الموضوع في نظام الورشة الخارجية أثناء النقل وفي ورشات العمل، وخلال أوقات الاستراحة، موظفو المؤسسة العقابية."@ar ;
    dznorm:sourceArticle "art_102" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_102_obligation_0_93a30b54_period_b8462d9933> a dznorm:Period ;
    rdfs:label "خلال أوقات الاستراحة"@ar ;
    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "يتولى مهمة حراسة المحبوس الموضوع في نظام الورشة الخارجية أثناء النقل وفي ورشات العمل، وخلال أوقات الاستراحة، موظفو المؤسسة العقابية."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_102> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_102_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_102> ;
    dzdoc:position 0 ;
    dzdoc:text "يغادر المحبوس الذي وضع في الورشة الخارجية المؤسسة العقابية، خلال أوقات المدة المحددة في الاتفاقية المبرمة، وفق أحكام المادة 103 من هذا القانون."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_102_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_102> ;
    dzdoc:position 1 ;
    dzdoc:text "يرجع المحبوس إلى المؤسسة العقابية عند انتهاء المدة المحددة في الاتفاقية أو فسخها بأمر من قاضي تطبيق العقوبات."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_102_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_102> ;
    dzdoc:position 2 ;
    dzdoc:text "يمكن إرجاع المحبوس إلى المؤسسة العقابية مساء كل يوم بعد انتهاء مدة دوام العمل."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_102_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_102> ;
    dzdoc:position 3 ;
    dzdoc:text "يتولى مهمة حراسة المحبوس الموضوع في نظام الورشة الخارجية أثناء النقل وفي ورشات العمل، وخلال أوقات الاستراحة، موظفو المؤسسة العقابية. ويجوز النص في الاتفاقية على إمكانية مساهمة الجهة المستخدمة في الحراسة جزئيا."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_102_permission_0_6399842e> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2005-02-06/05-04#art_102_permission_0_6399842e_action_a5437cbb63> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_102> ;
    dznorm:position 2 ;
    dznorm:provisionText "يمكن إرجاع المحبوس إلى المؤسسة العقابية مساء كل يوم بعد انتهاء مدة دوام العمل."@ar ;
    dznorm:sourceArticle "art_102" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_102_permission_0_6399842e_action_a5437cbb63> a dznorm:Action ;
    rdfs:label "إرجاع المحبوس إلى المؤسسة العقابية"@ar ;
