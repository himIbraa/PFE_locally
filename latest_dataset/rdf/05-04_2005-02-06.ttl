<https://legal.dz/resource/law/2005-02-06/05-04#version_art_172> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "دون الإخلال بأحكام قانون القضاء العسكري ، تلغى جميع الأحكام المخالفة لهذا القانون، ولا سيما الأمر رقم 72-02 المؤرخ في 25 ذي الحجة عام 1391 الموافق 10 فبراير سنة 1972 والمتضمن قانون تنظيم السجون وإعادة تربية المساجين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
