<https://legal.dz/resource/law/2005-02-06/05-04#art_37_obligation_1_195bdcc9_action_fad3dabd6d> a dznorm:Action ;
    rdfs:label "المؤسسة العقابية عند عدم التحكم"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب على مدير المؤسسة العقابية عند عدم التحكم في الأمن وحفظ النظام داخل المؤسسة العقابية بواسطة الموظفين العاملين تحت سلطته أن يخطر فورا مصالح الأمن لاتخاذ كل التدابير الوقائية اللازمة، ويشعر فورا بذلك، وكيل الجمهورية والنائب العام"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_37> .

