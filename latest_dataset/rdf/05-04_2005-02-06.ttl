    dznorm:sourceArticle "art_84" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_84_obligation_1_ac1f485c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2005-02-06/05-04#art_84_obligation_1_ac1f485c_period_3673dd9add> ;
