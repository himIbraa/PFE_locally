<https://legal.dz/resource/law/2005-02-06/05-04#version_art_37> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتولى موظفو المؤسسات العقابية تحت سلطة المدير ، مهمة حفظ النظام والأمن داخل المؤسسة العقابية . يجب على مدير المؤسسة العقابية عند عدم التحكم في الأمن وحفظ النظام داخل المؤسسة العقابية بواسطة الموظفين العاملين تحت سلطته أن يخطر فورا مصالح الأمن لاتخاذ كل التدابير الوقائية اللازمة، ويشعر فورا بذلك، وكيل الجمهورية و النائب العام ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_37_20050206_OpEnact_d7c417d643> ;
    dzdoc:replacementText "يتولى موظفو المؤسسات العقابية تحت سلطة المدير ، مهمة حفظ النظام والأمن داخل المؤسسة العقابية . يجب على مدير المؤسسة العقابية عند عدم التحكم في الأمن وحفظ النظام داخل المؤسسة العقابية بواسطة الموظفين العاملين تحت سلطته أن يخطر فورا مصالح الأمن لاتخاذ كل التدابير الوقائية اللازمة، ويشعر فورا بذلك، وكيل الجمهورية و النائب العام ."@ar ;
