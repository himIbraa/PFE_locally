    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_44> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب إخبار كل محبوس ، بمجرد دخوله إلى المؤسسة العقابية، بالنظم المقررة لمعاملة المحبوسين من فئته، والقواعد التأديبية المعمول بها في المؤسسة، والطرق المرخص بها للحصول على المعلومات، وتقديم الشكاوى وجميع المسائل الأخرى التي يتعين إلمامه بها"@ar ;
    dznorm:sourceArticle "art_44" .

