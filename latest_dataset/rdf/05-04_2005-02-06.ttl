<https://legal.dz/resource/law/2005-02-06/05-04#version_art_113> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنشأ مصالح خارجية تابعة لإدارة السجون تكلف بالتعاون مع المصالح المختصة للدولة والجماعات المحلية بتطبيق برامج إعادة الإدماج الاجتماعي للمحبوسين . تقوم هذه المصالح بمتابعة الأشخاص الخاضعين للالتزامات والشروط الخاصة المترتبة على وضعهم في أحد الأنظمة المنصوص عليها في هذا القانون . كما يمكنها أن تقوم بتكليف من السلطات القضائية بإجراء التحقيقات الاجتماعية، ومتابعة الأشخاص الموضوعين تحت نظام الرقابة القضائية. تحدد كيفيات تنظيم المصالح الخارجية لإدارة السجون وسيرها عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_113_20050206_OpEnact_b9ae2ec0ee> ;
    dzdoc:replacementText "تنشأ مصالح خارجية تابعة لإدارة السجون تكلف بالتعاون مع المصالح المختصة للدولة والجماعات المحلية بتطبيق برامج إعادة الإدماج الاجتماعي للمحبوسين . تقوم هذه المصالح بمتابعة الأشخاص الخاضعين للالتزامات والشروط الخاصة المترتبة على وضعهم في أحد الأنظمة المنصوص عليها في هذا القانون . كما يمكنها أن تقوم بتكليف من السلطات القضائية بإجراء التحقيقات الاجتماعية، ومتابعة الأشخاص الموضوعين تحت نظام الرقابة القضائية. تحدد كيفيات تنظيم المصالح الخارجية لإدارة السجون وسيرها عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_113> ;
