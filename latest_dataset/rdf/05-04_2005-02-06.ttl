<https://legal.dz/resource/law/2005-02-06/05-04#version_art_63> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن تكون الوجبة الغذائية للمحبوسين متوازنة، وذات قيمة غذائية كافية ."@ar ;
