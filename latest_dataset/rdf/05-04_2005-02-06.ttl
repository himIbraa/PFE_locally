        <https://legal.dz/resource/law/2005-02-06/05-04#art_106_condition_1_880325b0> ;
    dzdoc:usesTerm dzterm:قاضي_تطبيق_العقوبات,
        dzterm:لجنة_تطبيق_العقوبات,
        dzterm:نظام_الحرية_النصفية .

<https://legal.dz/resource/law/2005-02-06/05-04#art_133> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_6_sec_2> ;
    dzdoc:eId "art_133" ;
    dzdoc:fullText "يخطر قاضي تطبيق العقوبات النيابة العامة والمحبوس بمقرر التوقيف المؤقت لتطبيق العقوبة، أو الرفض في أجل أقصاه ثلاثة (3) أيام من تاريخ البت في الطلب . يجوز للمحبوس والنائب العام الطعن في مقرر التوقيف المؤقت لتطبيق العقوبة، أو مقرر الرفض أمام اللجنة المنصوص عليها في المادة 143 من هذا القانون خلال ثمانية (8) أيام من تاريخ تبليغ المقرر للطعن في مقرر التوقيف المؤقت لتطبيق العقوبة أمام اللجنة المنصوص عليها في المادة 143 من هذا القانون أثر موقف."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_133_permission_0_f6efa196> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_133_right_0_a20f87a3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_133> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_133_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_133_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_133_20050206_OpEnact_b6e59b2802> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_133_obligation_0_1820c90c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "133" ;
    dzdoc:position 132 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_143> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_143> ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:prosecution .

<https://legal.dz/resource/law/2005-02-06/05-04#art_143> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_6_sec_3> ;
    dzdoc:eId "art_143" ;
    dzdoc:fullText "تحدث لدى وزير العدل، حافظ الأختام ، لجنة لتكييف العقوبات، تتولى البت في الطعون المذكورة في المواد 133 و 141 و 161 من هذا القانون ودراسة طلبات الإفراج المشروط التي يعود اختصاص البت فيها لـ وزير العدل، حافظ الأختام ، وإبداء رأيها فيها قبل إصداره مقررات بشأنها. تحدد تشكيلة هذه اللجنة وتنظيمها وسيرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_143> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_143_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_143_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_143_20050206_OpEnact_465d3bf122> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 143" ;
    dzdoc:position 142 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_133>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_141>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_161> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_133>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_141>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_161> ;
    dzdoc:usesTerm dzterm:conditional_release,
        dzterm:minister_of_justice .

<https://legal.dz/resource/law/2005-02-06/05-04#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:definesTerm dzterm:juvenile_specialized_centers,
        dzterm:prevention_establishment,
        dzterm:reeducation_establishment,
        dzterm:rehabilitation_establishment,
        dzterm:women_specialized_centers ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "تصنف مؤسسات البيئة المغلقة إلى مؤسسات ومراكز متخصصة : أولا - المؤسسات : 1- مؤسسة وقاية بدائرة اختصاص كل محكمة، وهي مخصصة لاستقبال المحبوسين مؤقتا والمحكوم عليهم نهائيا بعقوبة سالبة للحرية لمدة تساوي أو تقل عن سنتين (2) ، ومن بقي منهم لانقضاء مدة عقوبتهم سنتان (2) أو أقل والمحبوسين لإكراه بدني. 2- مؤسسة إعادة التربية بدائرة اختصاص كل مجلس قضائي، وهي مخصصة لاستقبال المحبوسين مؤقتا، والمحكوم عليهم نهائيا بعقوبة سالبة للحرية تساوي أو تقل عن خمس (5) سنوات، ومن بقي منهم لإنقضاء عقوبته خمس (5) سنوات أو أقل والمحبوسين لإكراه بدني. 3- مؤسسة إعادة التأهيل وهي مخصصة لحبس المحكوم عليهم نهائيا بعقوبة الحبس لمدة تفوق خمس (5) سنوات وبعقوبة السجن، والمحكوم عليهم معتادي الإجرام والخطرين مهما تكن مدة العقوبة المحكوم بها عليهم والمحكوم عليهم بالإعدام. يمكن أن تخصص بالمؤسسات المصنفة في الفقرتين 2 و 3 من هذه المادة أجنحة مدعمة أمنيا ، لاستقبال المحبوسين الخطرين الذين لم تجد معهم طرق إعادة التربية المعتادة ووسائل الأمن العادية. ثانيا- المراكز المتخصصة : 1- مراكز متخصصة للنساء ، مخصصة لاستقبال النساء المحبوسات مؤقتا، والمحكوم عليهن نهائيا بعقوبة سالبة للحرية مهما تكن مدتها، والمحبوسات لإكراه بدني. 2 - مراكز متخصصة للأحداث ، مخصصة لاستقبال الأحداث الذين تقل أعمارهم عن ثماني عشرة (18) سنة، المحبوسين مؤقتا، والمحكوم عليهم نهائيا بعقوبة سالبة للحرية مهما تكن مدتها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_28_permission_0_987a50f8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_28> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_28_defocc_131c6a23b47d>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_28_defocc_189c00c04390>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_28_defocc_1ef3cd2e819b>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_28_defocc_6ced6666e799>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_28_defocc_7f05e6897279> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_28_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_28_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_28_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_28_20050206_OpEnact_ad27e6167a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "28" ;
    dzdoc:position 27 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_28_condition_0_4540ecd1> ;
    dzdoc:usesTerm dzterm:closed_environment_establishments .

<https://legal.dz/resource/law/2005-02-06/05-04#art_56> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_56" ;
    dzdoc:fullText "يجوز لـ القاضي المختص لأسباب مشروعة ، واستثنائية ، منح المحبوسين ترخيصا بالخروج تحت الحراسة لمدة محددة، حسب ظروف كل حالة، على أن يخطر النائب العام بذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_56_permission_0_4f071887> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_56> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_56_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_56_20050206_OpEnact_a408bf8c16> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_56_obligation_0_3321cbd8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "56" ;
    dzdoc:position 55 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_56_condition_0_e525e8b2> ;
    dzdoc:usesTerm dzterm:القاضي_المختص .

<https://legal.dz/resource/law/2005-02-06/05-04#art_65> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_65" ;
    dzdoc:fullText "في حالة وفاة محبوس، يبلغ مدير المؤسسة العقابية واقعة الوفاة إلى المصالح المختصة بوزارة العدل، والسلطات القضائية والإدارية المختصة محليا وعائلة المعني . تسلم جثة المحبوس المتوفى لعائلته . في حالة الوفاة المشبوهة ، لا تسلم الجثة للعائلة، إلا بعد إتمام عملية التشريح ، و تحفظ نسخة من تقرير تشريح الجثة بالملف الشخصي للمحبوس المتوفى على مستوى المؤسسة العقابية . إذا لم تتم المطالبة بالجثة، وأصبحت حالتها لا تسمح بالحفظ ، تتولى مصالح البلدية المختصة عملية الدفن وفقا للتشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_65> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_65_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_65_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_65_para_2>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_65_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_65_20050206_OpEnact_d04f1d3dea> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_65_obligation_0_c2a77daa>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_65_obligation_1_7a7eac58>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_65_obligation_2_675ec5b7>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_65_obligation_3_5daa089e>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_65_obligation_4_32b43211> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 65" ;
    dzdoc:position 64 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_65_condition_0_8775011d>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_65_condition_1_e0a71da7> ;
    dzdoc:usesTerm dzterm:prison_director .

<https://legal.dz/resource/law/2005-02-06/05-04#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "تسلم رخصة الزيارة للأشخاص المذكورين في المادة 66 أعلاه، لزيارة المحبوس المحكوم عليه نهائيا، من طرف مدير المؤسسة العقابية ، وهي صالحة لزيارة واحدة أو أكثر، بحسب ما حدد بها. تسلم رخصة زيارة للأشخاص المذكورين في المادة 67 أعلاه، لزيارة المحبوسين المحكوم عليهم من طرف قاضي تطبيق العقوبات . تسلم رخصة زيارة المحبوسين مؤقتا من طرف القاضي المختص، ومن طرف النيابة العامة بالنسبة للمحبوسين المستأنفين والطاعنين بالنقض ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_68_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_68_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_68_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_68_20050206_OpEnact_8b61824942> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_68_obligation_0_0f3ae84c>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_68_obligation_1_338ac389>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_68_obligation_2_dab24866> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 68" ;
    dzdoc:position 67 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_66>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_67> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_66>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_67> ;
    dzdoc:usesTerm dzterm:judge_execution,
        dzterm:prison_director .

