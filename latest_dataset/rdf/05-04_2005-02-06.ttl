dzterm:family a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يقصد بالعائلة في مفهوم هذا القانون الزوج والأولاد والأب والأم والإخوة والأخوات والمكفولون"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_20_defocc_9e92ec1bdd21> .

dzterm:financial_gain a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يتكون المكسب المالي للمحبوس من المبالغ التي يمتلكها والمنح التي يتحصل عليها مقابل عمله المؤدى"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_98_defocc_9b20aa7b4854> .

dzterm:investigating_judge a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "قاضي التحقيق"@ar .

dzterm:joint_ministerial_committee a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "اللجنة الوزارية المشتركة لتنسيق نشاطات إعادة التربية وإعادة الإدماج الاجتماعي للمحبوسين"@ar,
        "لجنة وزارية مشتركة"@ar .

dzterm:judge_enforcement_sentences a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "قاضي تطبيق العقوبات"@ar .

dzterm:juvenile_detainee a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الحدث المحبوس"@ar .

dzterm:juvenile_specialized_centers a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "مراكز متخصصة للأحداث"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_28_defocc_7f05e6897279> .

dzterm:open_environment_institutions a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تتخذ مؤسسات البيئة المفتوحة شكل مراكز ذات طابع فلاحي أو صناعي أو حرفي أو خدماتي، أو ذات منفعة عامة، وتتميز بتشغيل وإيواء المحبوسين بعين المكان."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_109_defocc_fc8d9af55ec0> .

dzterm:open_environment_system a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "نظام البيئة المفتوحة"@ar .

dzterm:prevention_establishment a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "مؤسسة وقاية"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_28_defocc_189c00c04390> .

dzterm:prison a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المؤسسة العقابية"@ar .

dzterm:prosecution a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "النيابة العامة"@ar .

dzterm:prosecutor a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "وكيل الجمهورية"@ar .

dzterm:prosecutor_general a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "النائب العام"@ar .

