<https://legal.dz/resource/law/2005-02-06/05-04#version_art_41> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز لموظفي المؤسسة العقابية استعمال السلاح الناري أو اللجوء إلى استخدام القوة تجاه المحبوسين، إلا في حالة الدفاع المشروع، أو التصدي لحالة تمرد أو عصيان، أو استعمال عنف أو محاولة هروب أو مقاومة جسمانية سلبية للأوامر، من أجل السيطرة عليهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_41_20050206_OpEnact_f3dbda5455> ;
    dzdoc:replacementText "لا يجوز لموظفي المؤسسة العقابية استعمال السلاح الناري أو اللجوء إلى استخدام القوة تجاه المحبوسين، إلا في حالة الدفاع المشروع، أو التصدي لحالة تمرد أو عصيان، أو استعمال عنف أو محاولة هروب أو مقاومة جسمانية سلبية للأوامر، من أجل السيطرة عليهم ."@ar ;
