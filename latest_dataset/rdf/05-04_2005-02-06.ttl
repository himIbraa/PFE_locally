    dzdoc:position 160 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_129>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_130>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_141> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_129>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_130>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_141> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_161_condition_0_e36977fe>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_161_condition_1_ed308233> ;
    dzdoc:usesTerm dzterm:judge_application_penalties,
        dzterm:minister_of_justice .

<https://legal.dz/resource/law/2005-02-06/05-04#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_1_subsec_4> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "لا يمكن القوة العمومية التدخل داخل المؤسسة العقابية إلا بموجب تسخيرة صادرة وفقا للقوانين والأنظمة المعمول بها عن الوالي بناء على طلب من النائب العام ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_38_permission_0_f3d811c4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_38_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_38_20050206_OpEnact_b3ca34b61c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 38" ;
    dzdoc:position 37 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_38_condition_0_fcb4fb6b> ;
    dzdoc:usesTerm dzterm:attorney_general,
        dzterm:wali .

<https://legal.dz/resource/law/2005-02-06/05-04#art_41> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_1_subsec_4> ;
    dzdoc:eId "art_41" ;
    dzdoc:fullText "لا يجوز لموظفي المؤسسة العقابية استعمال السلاح الناري أو اللجوء إلى استخدام القوة تجاه المحبوسين، إلا في حالة الدفاع المشروع، أو التصدي لحالة تمرد أو عصيان، أو استعمال عنف أو محاولة هروب أو مقاومة جسمانية سلبية للأوامر، من أجل السيطرة عليهم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_41_permission_0_5e22dd18> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_41> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_41_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_41_20050206_OpEnact_f3dbda5455> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_41_obligation_0_786416de> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2005-02-06/05-04#art_41_prohibition_0_5e22dd18> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 41" ;
    dzdoc:position 40 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "يتعين على كل محبوس يرغب في الإضراب عن الطعام، أو يلجأ إليه، أو يرفض العلاج، أن يقدم إلى مدير المؤسسة العقابية تصريحا مكتوبا يبين فيه أسباب اللجوء إلى الإضراب أو رفض العلاج . يوضع المحبوس المضرب عن الطعام في النظام الانفرادي كإجراء وقائي، وإذا تعدد المضربون، يعزلون عن غير المضربين ويوضعون تحت المتابعة الطبية. إذا أصبحت حياة المحبوس المضرب عن الطعام، أو الرافض للعلاج، معرضة للخطر ، وجب إخضاعه للعلاجات الضرورية تحت مراقبة طبية مستمرة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_64_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_64_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_64_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_64_20050206_OpEnact_b972d46670> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_64_obligation_0_d7d4218c>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_64_obligation_1_ec3edc68> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "64" ;
    dzdoc:position 63 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_64_condition_0_6d7f71a1> ;
    dzdoc:usesTerm dzterm:penitentiary_institution,
        dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_74> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_74" ;
    dzdoc:fullText "لا تخضع لرقابة مدير المؤسسة العقابية المراسلات الموجهة من المحبوس إلى محاميه أو التي يوجهها هذا الأخير إليه ، و لا يتم فتحها لأي عذر كان ، إلا إذا لم يظهر على الظرف ما يبين بأنها مرسلة إلى المحامي صادرة منه . يسري حكم الفقرة أعلاه على المراسلات الموجهة من المحبوس إلى السلطات القضائية والإدارية الوطنية. تخضع مراسلات المحبوس إلى المحامي بالخارج للسلطة التقديرية للنيابة العامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_74> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_74_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_74_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_74_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_74_20050206_OpEnact_84db4c9218> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_74_obligation_0_c0690951>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_74_obligation_1_3e591755> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 74" ;
    dzdoc:position 73 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_74_condition_0_621915ec> ;
    dzdoc:usesTerm dzterm:director,
        dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_81> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_3> ;
    dzdoc:eId "art_81" ;
    dzdoc:fullText "مع مراعاة الظروف الصحية للمحبوس ، وكفاءته ووضعيته الجزائية ، يعين في كل مؤسسة عقابية محبوسون للقيام بالخدمة العامة من أجل المحافظة على نظافة أماكن الاحتباس وضمان الأعمال المختلفة اللازمة لحسن سير المصالح."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_81> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_81_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_81_20050206_OpEnact_10112a0c41> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "81" ;
    dzdoc:position 80 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_81_condition_0_a6dc364e> ;
    dzdoc:usesTerm dzterm:penitentiary_establishment,
        dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_85> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_4> ;
    dzdoc:eId "art_85" ;
    dzdoc:fullText "فيما عدا حالات الاستعجال، إذا كان التدبير التأديبي هو الوضع في العزلة ، فلا يمكن تنفيذه إلا بعد استشارة الطبيب و/أو الأخصائي النفساني للمؤسسة العقابية . يظل المحبوس الموضوع في العزلة محل متابعة طبية مستمرة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_85_permission_0_115110aa> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_85> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_85_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_85_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_85_20050206_OpEnact_283847a37c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_85_obligation_0_c4ff993b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "85" ;
    dzdoc:position 84 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_85_condition_0_e336204a>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_85_condition_1_331b8895> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_102> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_102" ;
    dzdoc:fullText "يغادر المحبوس الذي وضع في الورشة الخارجية المؤسسة العقابية، خلال أوقات المدة المحددة في الاتفاقية المبرمة، وفق أحكام المادة 103 من هذا القانون. يرجع المحبوس إلى المؤسسة العقابية عند انتهاء المدة المحددة في الاتفاقية أو فسخها بأمر من قاضي تطبيق العقوبات . يمكن إرجاع المحبوس إلى المؤسسة العقابية مساء كل يوم بعد انتهاء مدة دوام العمل. يتولى مهمة حراسة المحبوس الموضوع في نظام الورشة الخارجية أثناء النقل وفي ورشات العمل، وخلال أوقات الاستراحة، موظفو المؤسسة العقابية. ويجوز النص في الاتفاقية على إمكانية مساهمة الجهة المستخدمة في الحراسة جزئيا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_102_permission_0_6399842e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_102> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_102_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_102_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_102_para_2>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_102_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_102_20050206_OpEnact_2487ee5941> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_102_obligation_0_93a30b54> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 102" ;
    dzdoc:position 101 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_103> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_103> ;
    dzdoc:usesTerm dzterm:المحبوس,
        dzterm:قاضي_تطبيق_العقوبات .

<https://legal.dz/resource/law/2005-02-06/05-04#art_160> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_8> ;
    dzdoc:eId "art_160" ;
    dzdoc:fullText "يستفيد المحبوس المعين للقيام بعمل أو بخدمة من أحكام تشريع العمل والحماية الاجتماعية ، ما لم يكن ذلك متعارضا مع وضعه كمحبوس ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_160_right_0_8166723f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_160> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_160_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_160_20050206_OpEnact_4f8ae6127f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 160" ;
    dzdoc:position 159 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_160_condition_0_573203ec> ;
    dzdoc:usesTerm dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_3> ;
    dzdoc:eId "art_19" ;
    dzdoc:fullText "يقدم طلب التأجيل، حسب الحالة، ل وزير العدل حافظ الأختام ، أو ل النائب العام لمكان تنفيذ العقوبة، مرفقا بالوثائق التي تثبت الوقائع والوضعية المحتج بها . يعد سكوت النائب العام رفضا منه لطلب التأجيل، بعد انقضاء خمسة عشر (15) يوما من تاريخ استلامه الطلب . في الحالة التي يرجع فيها الاختصاص ل وزير العدل حافظ الأختام ، يعد سكوته لأكثر من ثلاثين (30) يوما من تاريخ استلامه الطلب رفضا للتأجيل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_19_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_19_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_19_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_19_20050206_OpEnact_eeaf1754a6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_19_obligation_0_9310baa2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 19" ;
    dzdoc:position 18 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_19_condition_0_c6ca8ca9>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_19_condition_1_32c64e6d> ;
    dzdoc:usesTerm dzterm:minister_justice,
        dzterm:prosecutor_general .

<https://legal.dz/resource/law/2005-02-06/05-04#art_67> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_67" ;
    dzdoc:fullText "للمحبوس الحق في أن يتلقى زيارة الوصي عليه والمتصرف في أمواله ومحاميه أو أي موظف أو ضابط عمومي متى كانت أسباب الزيارة مشروعة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_67_right_0_2a03c1ad> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_67> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_67_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_67_20050206_OpEnact_b9b264cc51> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 67" ;
    dzdoc:position 66 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_67_condition_0_f126b999> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_107> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_107" ;
    dzdoc:fullText "يلتزم المحبوس المستفيد من نظام الحرية النصفية ، في تعهد مكتوب، باحترام الشروط التي يتضمنها مقرر الاستفادة. في حالة إخلال المحبوس بالتعهد، أو خرقه لأحد شروط الاستفادة ، يأمر مدير المؤسسة العقابية بإرجاع المحبوس، ويخبر قاضي تطبيق العقوبات ليقرر الإبقاء على الاستفادة من نظام الحرية النصفية ، أو وقفها، أو إلغائها، وذلك بعد استشارة لجنة تطبيق العقوبات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_107> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_107_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_107_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_107_20050206_OpEnact_2961a37e90> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_107_obligation_0_035addd9>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_107_obligation_1_e1bea347> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "107" ;
    dzdoc:position 106 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_107_condition_0_9449debb> ;
    dzdoc:usesTerm dzterm:قاضي_تطبيق_العقوبات,
        dzterm:لجنة_تطبيق_العقوبات,
        dzterm:نظام_الحرية_النصفية .

<https://legal.dz/resource/law/2005-02-06/05-04#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_2_subsec_3> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "يمكن أن يوضع في نظام البيئة المفتوحة ، المحبوس الذي يستوفي شروط الوضع في نظام الورشات الخارجية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_110_permission_0_c8e6f97f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_110_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_110_20050206_OpEnact_7805f45cc2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 110" ;
    dzdoc:position 109 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_110_condition_0_d0a03b9c> ;
    dzdoc:usesTerm dzterm:open_environment_system .

<https://legal.dz/resource/law/2005-02-06/05-04#art_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_2> ;
    dzdoc:eId "art_13" ;
    dzdoc:fullText "يبدأ حساب سريان مدة العقوبة السالبة للحرية ، بتسجيل مستند الإيداع الذي يذكر فيه، تاريخ وساعة وصول المحكوم عليه إلى المؤسسة العقابية. تحسب عقوبة يوم بأربع وعشرين (24) ساعة، وعقوبة عدة أيام بعددها مضروبا في أربع وعشرين (24) ساعة، وعقوبة شهر واحد بثلاثين (30) يوما، وعقوبة سنة واحدة باثني عشر (12) شهرا ميلاديا، وتحسب من يوم إلى مثله من السنة، وعقوبة عدة أشهر من اليوم إلى مثله من الشهر. تخصم مدة الحبس المؤقت بتمامها من مدة العقوبة المحكوم بها ، وتحسب هذه المدة من يوم حبس المحكوم عليه بسبب الجريمة التي أدت إلى الحكم عليه. في حالة تعدد المتابعات المتعاقبة في الزمن دون انقطاع للحبس ، يكون بدء حساب مدة العقوبة السالبة للحرية ، بتسجيل مستند الإيداع الأول حتى لو كان مآل المتابعات الأولى البراءة، أو وقف التنفيذ، أو عقوبة غير سالبة للحرية، أو أمرا، أو قرار، بألا وجه للمتابعة. عندما يصادف نهاية تنفيذ مدة العقوبة السالبة للحرية يوم عطلة ، يفرج عن المحبوس في اليوم السابق له ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_13> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_13_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_13_para_1>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_13_para_2>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_13_para_3>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_13_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_13_20050206_OpEnact_0213f486fa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_13_obligation_0_f184f233>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_13_obligation_1_26cd6ad0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "13" ;
    dzdoc:position 12 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_13_condition_0_7121d7ac>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_13_condition_1_6f614d23> ;
    dzdoc:usesTerm dzterm:custodial_sentence .

<https://legal.dz/resource/law/2005-02-06/05-04#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "يمنع على المحبوس الاحتفاظ بالنقود والمجوهرات والأشياء الثمينة . تمسك كتابة ضبط المحاسبة بالمؤسسة العقابية حسابا اسميا لتسجيل القيم المملوكة للمحبوسين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_77_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_77_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_77_20050206_OpEnact_39d20961ed> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_77_obligation_0_38e14474>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_77_obligation_1_4e192102> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2005-02-06/05-04#art_77_prohibition_0_6e85a2c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 77" ;
    dzdoc:position 76 ;
    dzdoc:usesTerm dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_92> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_1_subsec_1> ;
    dzdoc:eId "art_92" ;
    dzdoc:fullText "يجب على إدارة المؤسسة العقابية، وتحت إشرافها ورقابتها، تمكين المحبوسين من متابعة برامج الإذاعة والتلفزة، والاطلاع على الجرائد والمجلات، وتلقي المحاضرات في المجال التربوي والثقافي والديني. كما يمكن بث البرامج السمعية أو السمعية البصرية الهادفة إلى إعادة التربية بعد استشارة لجنة تطبيق العقوبات، أو لجنة إعادة تربية الأحداث، حسب كل حالة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_92_permission_0_57bba8eb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_92> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_92_para_0>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_92_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_92_20050206_OpEnact_1d1730f408> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2005-02-06/05-04#art_92_obligation_0_aff7280d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 92" ;
    dzdoc:position 91 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2005-02-06/05-04#art_92_condition_0_d64092c0> .

