<https://legal.dz/resource/law/2005-02-06/05-04#version_art_119> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعامل الحدث خلال تواجده بالمركز، أو الجناح المخصص للأحداث بالمؤسسة العقابية، معاملة تراعي فيها مقتضيات سنه وشخصيته بما يصون كرامته، ويحقق له رعاية كاملة . ويستفيد الحدث المحبوس على وجه الخصوص من : وجبة غذائية متوازنة وكافية لنموه الجسدي والعقلي ، لباس مناسب ، رعاية صحية وفحوص طبية مستمرة ، فسحة في الهواء الطلق يوميا ، محادثة زائريه مباشرة من دون فاصل استعمال وسائل الاتصال عن بعد، تحت رقابة الإدارة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_119_20050206_OpEnact_28d187d846> ;
    dzdoc:replacementText "يعامل الحدث خلال تواجده بالمركز، أو الجناح المخصص للأحداث بالمؤسسة العقابية، معاملة تراعي فيها مقتضيات سنه وشخصيته بما يصون كرامته، ويحقق له رعاية كاملة . ويستفيد الحدث المحبوس على وجه الخصوص من : وجبة غذائية متوازنة وكافية لنموه الجسدي والعقلي ، لباس مناسب ، رعاية صحية وفحوص طبية مستمرة ، فسحة في الهواء الطلق يوميا ، محادثة زائريه مباشرة من دون فاصل استعمال وسائل الاتصال عن بعد، تحت رقابة الإدارة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_119> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
