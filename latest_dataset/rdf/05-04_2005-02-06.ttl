<https://legal.dz/resource/law/2005-02-06/05-04#art_82_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_82> ;
    dzdoc:position 1 ;
    dzdoc:text "تحدد الكيفيات العملية لتفتيش الأماكن والأشخاص في النظام الداخلي للمؤسسة العقابية."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_83_obligation_0_36aba50a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_83> ;
    dznorm:position 0 ;
    dznorm:provisionText "كل محبوس يخالف القواعد المتعلقة بسير المؤسسة العقابية، ونظامها الداخلي، وأمنها وسلامتها، أو يخل بقواعد النظافة والانضباط داخلها ، يتعرض للتدابير التأديبية حسب الترتيب الآتي:"@ar ;
    dznorm:sourceArticle "art_83" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_83_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_83> ;
    dzdoc:position 0 ;
    dzdoc:text "كل محبوس يخالف القواعد المتعلقة بسير المؤسسة العقابية، ونظامها الداخلي، وأمنها وسلامتها، أو يخل بقواعد النظافة والانضباط داخلها ، يتعرض للتدابير التأديبية حسب الترتيب الآتي: تدابير من الدرجة الأولى : 1- الإنذار الكتابي، 2- التوبيخ. تدابير من الدرجة الثانية : 1- الحد من حق مراسلة العائلة لمدة لا تتجاوز شهرين (2) على الأكثر، 2- الحد من الاستفادة من المحادثة دون فاصل، ومن الاتصال عن بعد، لمدة لا تتجاوز شهرا (1) واحد، 3 - المنع من استعمال الحصة القابلة للتصرف من مكسبه المالي، فيما يلزم من حاجات شخصية لمدة لا تتجاوز شهرين (2). تدابير من الدرجة الثالثة 1- المنع من الزيارة لمدة لا تتجاوز شهرا (1) واحد، فيما عدا زيارة المحامي، 2- الوضع في العزلة لمدة لا تتجاوز ثلاثين (30) يوما."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_83_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_83> ;
    dzdoc:position 1 ;
    dzdoc:text "يحدد النظام الداخلي للمؤسسة العقابية الأخطاء ويصنفها حسب التدابير التي تقابل كلا منها."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_84_condition_0_8d032215> a dznorm:Condition ;
    dznorm:conditionText "بعد الاستماع إلى المعني"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_84> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_84_obligation_0_afc6f590> a dznorm:Obligation ;
