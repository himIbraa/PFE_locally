<https://legal.dz/resource/law/2005-02-06/05-04#version_art_23> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسهر قاضي تطبيق العقوبات ، فضلا عن الصلاحيات المخولة له بمقتضى أحكام هذا القانون، على مراقبة مشروعية تطبيق العقوبات السالبة للحرية، والعقوبات البديلة عند الاقتضاء، وعلى ضمان التطبيق السليم لتدابير تفريد العقوبة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_23_20050206_OpEnact_e3f91bf9d5> ;
    dzdoc:replacementText "يسهر قاضي تطبيق العقوبات ، فضلا عن الصلاحيات المخولة له بمقتضى أحكام هذا القانون، على مراقبة مشروعية تطبيق العقوبات السالبة للحرية، والعقوبات البديلة عند الاقتضاء، وعلى ضمان التطبيق السليم لتدابير تفريد العقوبة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_23> ;
