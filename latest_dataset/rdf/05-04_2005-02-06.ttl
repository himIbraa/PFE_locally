<https://legal.dz/resource/law/2005-02-06/05-04#art_19_obligation_0_9310baa2> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_19> ;
    dznorm:position 0 ;
    dznorm:provisionText "يقدم طلب التأجيل، حسب الحالة، لوزير العدل حافظ الأختام، أو لالنائب العام لمكان تنفيذ العقوبة، مرفقا بالوثائق التي تثبت الوقائع والوضعية المحتج بها"@ar ;
    dznorm:sourceArticle "art_19" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_19_para_0> a dzdoc:Paragraph ;
