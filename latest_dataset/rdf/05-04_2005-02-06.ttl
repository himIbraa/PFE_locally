<https://legal.dz/resource/law/2005-02-06/05-04#version_art_144> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لـ قاضي تطبيق العقوبات أو لـ وزير العدل، حافظ الأختام ، حسب الحالة، قبل إصدار مقرر الإفراج المشروط ، أن يطلب رأي والي الولاية التي يختار المحبوس الإقامة بها، على أن يخطر الوالي ومصالح الأمن المختصة بمقرر الإفراج المشروط ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
