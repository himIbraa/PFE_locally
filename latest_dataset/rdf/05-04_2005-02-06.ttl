dzterm:نظام_الحرية_النصفية a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "نظام الحرية النصفية"@ar,
        "يقصد بنظام الحرية النصفية، وضع المحبوس المحكوم عليه نهائيا خارج المؤسسة العقابية خلال النهار منفردا ودون حراسة أو رقابة الإدارة ليعود إليها مساء كل يوم."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_104_defocc_e16176ce38af> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_1> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "يهدف هذا القانون إلى تكريس مبادئ وقواعد لإرساء سياسة عقابية قائمة على فكرة الدفاع الاجتماعي التي تجعل من تطبيق العقوبة وسيلة لحماية المجتمع بواسطة إعادة التربية و الإدماج الاجتماعي للمحبوسين"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_1_20050206_OpEnact_a8c1e71b2a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "الأولى" ;
    dzdoc:position 0 ;
    dzdoc:usesTerm dzterm:punitive_policy,
        dzterm:re_education,
        dzterm:social_defense,
        dzterm:social_reintegration .

<https://legal.dz/resource/law/2005-02-06/05-04#art_112> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_3> ;
    dzdoc:eId "art_112" ;
    dzdoc:fullText "إعادة الإدماج الاجتماعي للمحبوسين هي مهمة تضطلع بها هيئات الدولة، ويساهم فيها المجتمع المدني، وفقا للبرامج التي تسطرها اللجنة الوزارية المشتركة لتنسيق نشاطات إعادة التربية وإعادة الإدماج الاجتماعي للمحبوسين المنصوص عليها في المادة 21 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_112> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_112_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_112_20050206_OpEnact_88ea40e3dd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 112" ;
    dzdoc:position 111 ;
    dzdoc:references <https://legal.dz/resource/law/2005-02-06/05-04#art_21> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2005-02-06/05-04#art_21> ;
    dzdoc:usesTerm dzterm:joint_ministerial_committee,
        dzterm:social_reintegration .

<https://legal.dz/resource/law/2005-02-06/05-04#art_128> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_5_sec_2_subsec_2> ;
    dzdoc:eId "art_128" ;
    dzdoc:fullText "تختص لجنة إعادة التربية على الخصوص بما يأتي : إعداد برامج التعليم وفقا للبرامج الوطنية المعتمدة، إعداد برامج السنوية لمحو الأمية والتكوين المهني، دراسة واقتراح كل التدابير الرامية إلى تكييف وتفريد العقوبة المنصوص عليها في هذا القانون، تقييم تنفيذ تطبيق برامج إعادة التربية وإعادة الإدماج الاجتماعي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_128> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_128_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_128_20050206_OpEnact_1766f2fd24> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "128" ;
    dzdoc:position 127 ;
    dzdoc:usesTerm dzterm:reeducation_committee .

<https://legal.dz/resource/law/2005-02-06/05-04#art_131> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_6_sec_2> ;
    dzdoc:eId "art_131" ;
    dzdoc:fullText "يترتب على مقرر التوقيف المؤقت لتطبيق العقوبة، رفع القيد عن المحبوس خلال فترة التوقيف، ولا تحسب هذه الفترة ضمن مدة الحبس التي قضاها المحبوس فعلا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_131> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_131_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_131_20050206_OpEnact_7d5fb1db82> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "131" ;
    dzdoc:position 130 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_137> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_6_sec_3> ;
    dzdoc:eId "art_137" ;
    dzdoc:fullText "يقدم طلب الإفراج المشروط من المحبوس شخصيا أو ممثله القانوني، أو في شكل اقتراح من قاضي تطبيق العقوبات ، أو مدير المؤسسة العقابية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_137> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_137_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_137_20050206_OpEnact_8439721ee9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 137" ;
    dzdoc:position 136 ;
    dzdoc:usesTerm dzterm:conditional_release,
        dzterm:judge_execution,
        dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_156> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_7> ;
    dzdoc:eId "art_156" ;
    dzdoc:fullText "لا يبلغ المحكوم عليه بالإعدام برفض العفو عنه إلا عند تنفيذ العقوبة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_156> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_156_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_156_20050206_OpEnact_23ab661320> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "156" ;
    dzdoc:position 155 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_7> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "تحدد كيفيات تطبيق أحكام هذا الباب عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_157_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_157_20050206_OpEnact_c6d4d88ff3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "157" ;
    dzdoc:position 156 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_171> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_10> ;
    dzdoc:eId "art_171" ;
    dzdoc:fullText "يمارس مديرو وضباط إدارة السجون صلاحيات ضباط الشرطة القضائية بالنسبة للجرائم التي ترتكب داخل المؤسسة العقابية أو خارجها بمناسبة تطبيق أحد الأنظمة العقابية المنصوص عليها في هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_171> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_171_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_171_20050206_OpEnact_5b8c357ab3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 171" ;
    dzdoc:position 170 ;
    dzdoc:usesTerm dzterm:judicial_police_officers,
        dzterm:prison_directors_officers .

<https://legal.dz/resource/law/2005-02-06/05-04#art_173> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_10> ;
    dzdoc:eId "art_173" ;
    dzdoc:fullText "بصفة انتقالية، وفي انتظار صدور النصوص التطبيقية لهذا القانون، تبقى النصوص التنظيمية المتخذة تطبيقا للأمر رقم 72-02 المؤرخ في 25 ذي الحجة عام 1391 الموافق 10 فبراير سنة 1972 سارية المفعول."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_173> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_173_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_173_20050206_OpEnact_741d61aa72> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 173" ;
    dzdoc:position 172 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2005-02-06/05-04#art_173_extref_2cbd4c5a> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_26> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_26" ;
    dzdoc:fullText "يعين لدى كل مؤسسة عقابية ، مدير يتولى شؤون إدارتها ويمارس الصلاحيات المخولة له بمقتضى هذا القانون، بالإضافة إلى ما يسند له من صلاحيات بموجب أحكام تنظيمية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_26> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_26_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_26_20050206_OpEnact_ecee91a97c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "26" ;
    dzdoc:position 25 ;
    dzdoc:usesTerm dzterm:penal_institution .

<https://legal.dz/resource/law/2005-02-06/05-04#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_1_sec_1> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "يرتكز تطبيق العقوبة السالبة للحرية على مبدأ تفريد العقوبة الذي يتمثل في معاملة المحبوس وفقا لوضعيته الجزائية، وحالته البدنية والعقلية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_3_20050206_OpEnact_c92e1a50c4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "3" ;
    dzdoc:position 2 ;
    dzdoc:usesTerm dzterm:individualization_of_punishment .

<https://legal.dz/resource/law/2005-02-06/05-04#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_1_subsec_4> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "تزود المؤسسات العقابية لحفظ النظام بها وضمان أمنها طبقا للتشريع والتنظيم المعمول بهما، بالأسلحة والذخيرة، وجميع الوسائل الأمنية ووسائل الدفاع، للتصدي للحالات الخطيرة الطارئة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_40_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_40_20050206_OpEnact_9d37270d04> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 40" ;
    dzdoc:position 39 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_43> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_1_subsec_4> ;
    dzdoc:eId "art_43" ;
    dzdoc:fullText "تتوفر كل المؤسسة عقابية على نطاق أمني يتم تحديده بموجب قرار من وزير العدل حافظ الأختام ، بعد أخذ رأي الوالي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_43> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_43_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_43_20050206_OpEnact_f84017624c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 43" ;
    dzdoc:position 42 ;
    dzdoc:usesTerm dzterm:minister_justice,
        dzterm:wali .

<https://legal.dz/resource/law/2005-02-06/05-04#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "يفصل المحبوس مؤقتا عن باقي فئات المحبوسين، ويمكن وضعه في نظام الاحتباس الانفرادي ، بناء على طلبه أو بأمر من قاضي التحقيق ، وفقا لأحكام قانون الإجراءات الجزائية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_47_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_47_20050206_OpEnact_9403815255> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 47" ;
    dzdoc:position 46 ;
    dzdoc:usesTerm dzterm:investigating_judge,
        dzterm:solitary_confinement_system,
        dzterm:temporary_prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "لا يلزم المحبوس مؤقتا بارتداء البذلة الجزائية، ولا بالعمل، باستثناء العمل الضروري للحفاظ على نظافة أماكن الاحتباس، بعد أخذ رأي طبيب المؤسسة العقابية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_48_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_48_20050206_OpEnact_36cbcd22ae> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 48" ;
    dzdoc:position 47 ;
    dzdoc:usesTerm dzterm:penal_institution,
        dzterm:temporary_prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "يفصل المحبوس المبتدئ عن باقي المحبوسين، ويتم إيواؤه وفق شروط ملائمة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_49_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_49_20050206_OpEnact_3308a26e73> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 49" ;
    dzdoc:position 48 ;
    dzdoc:usesTerm dzterm:first_time_offender .

<https://legal.dz/resource/law/2005-02-06/05-04#art_55> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_55" ;
    dzdoc:fullText "تحدد كيفيات استخراج المحبوسين وتحويلهم عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_55> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_55_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_55_20050206_OpEnact_5889689749> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "55" ;
    dzdoc:position 54 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "تقدم الإسعافات والعلاجات الضرورية للمحبوس وتجرى له الفحوصات الطبية والتلقيحات والتحاليل للوقاية من الأمراض المتنقلة والمعدية، تلقائيا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_59_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_59_20050206_OpEnact_6115773556> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "59" ;
    dzdoc:position 58 ;
    dzdoc:usesTerm dzterm:prisoner .

<https://legal.dz/resource/law/2005-02-06/05-04#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_1_subsec_1> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "تهدف عملية إعادة تربية المحبوس إلى تنمية قدراته ومؤهلاته الشخصية، والرفع المستمر من مستواه الفكري والأخلاقي وإحساسه بالمسؤولية، وبعث الرغبة فيه للعيش في المجتمع في ظل احترام القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_88_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_88_20050206_OpEnact_336557f633> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 88" ;
    dzdoc:position 87 ;
    dzdoc:usesTerm dzterm:reeducation .

<https://legal.dz/resource/law/2005-02-06/05-04#art_89> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_1_subsec_1> ;
    dzdoc:eId "art_89" ;
    dzdoc:fullText "يعين في كل مؤسسة عقابية مربون وأساتذة ومختصون في علم النفس، ومساعدات ومساعدون اجتماعيون يوضعون تحت سلطة المدير ويباشرون مهامهم تحت رقابة قاضي تطبيق العقوبات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_89> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_89_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_89_20050206_OpEnact_462673ab3c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 89" ;
    dzdoc:position 88 ;
    dzdoc:usesTerm dzterm:judge_application_sentences,
        dzterm:penitentiary_establishment .

<https://legal.dz/resource/law/2005-02-06/05-04#art_90> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_1_subsec_1> ;
    dzdoc:eId "art_90" ;
    dzdoc:fullText "تحدث في كل مؤسسة عقابية مصلحة متخصصة ، مهمتها ضمان المساعدة الاجتماعية للمحبوسين، والمساهمة في تهيئة وتيسير إعادة إدماجهم الاجتماعي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_90> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_90_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_90_20050206_OpEnact_abf33110fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 90" ;
    dzdoc:position 89 ;
    dzdoc:usesTerm dzterm:penitentiary_establishment .

<https://legal.dz/resource/law/2005-02-06/05-04#art_91> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_1_subsec_1> ;
    dzdoc:eId "art_91" ;
    dzdoc:fullText "يكلف المختصون في علم النفس والمربون العاملون في المؤسسة العقابية بالتعرف على شخصية المحبوس، ورفع مستوى تكوينه العام، ومساعدته على حل مشاكله الشخصية والعائلية، وتنظيم أنشطته الثقافية والتربوية والرياضية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_91> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_91_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_91_20050206_OpEnact_a0a1358827> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 91" ;
    dzdoc:position 90 ;
    dzdoc:usesTerm dzterm:penitentiary_establishment .

<https://legal.dz/resource/law/2005-02-06/05-04#art_94> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_4_sec_1_subsec_1> ;
    dzdoc:eId "art_94" ;
    dzdoc:fullText "تنظم لفائدة المحبوسين دروس في التعليم العام والتقني والتكوين المهني والتمهين والتربية البدنية، وفقا للبرامج المعتمدة رسميا، مع توفير الوسائل اللازمة لذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_94> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_94_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_94_20050206_OpEnact_288854def4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:introducedOn "2005-02-06"^^xsd:date ;
    dzdoc:number "المادة 94" ;
    dzdoc:position 93 .

