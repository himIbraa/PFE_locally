    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_93> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_94_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_94> ;
    dzdoc:position 0 ;
    dzdoc:text "تنظم لفائدة المحبوسين دروس في التعليم العام والتقني والتكوين المهني والتمهين والتربية البدنية، وفقا للبرامج المعتمدة رسميا، مع توفير الوسائل اللازمة لذلك."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_95_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_95> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم التكوين المهني داخل المؤسسة العقابية، أو في معامل المؤسسات العقابية، أو في الورشات الخارجية، أو في مراكز التكوين المهني."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_96_obligation_0_0ffbf5b1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_96> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتولى مدير المؤسسة العقابية، بعد استطلاع رأي لجنة تطبيق العقوبات، إسناد بعض الأعمال المفيدة للمحبوس"@ar ;
    dznorm:sourceArticle "art_96" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_96_obligation_1_f56f19ec> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_96> ;
    dznorm:position 1 ;
    dznorm:provisionText "واجب مراعاته في ذلك الحالة الصحية للمحبوس واستعداده البدني والنفسي، وقواعد حفظ النظام والأمن داخل المؤسسة العقابية"@ar ;
    dznorm:sourceArticle "art_96" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_96_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_96> ;
    dzdoc:position 0 ;
    dzdoc:text "في إطار عملية التكوين بغرض تأهيل المحبوس وإعادة إدماجه الاجتماعي، يتولى مدير المؤسسة العقابية، بعد استطلاع رأي لجنة تطبيق العقوبات، إسناد بعض الأعمال المفيدة للمحبوس ، مع واجب مراعاته في ذلك الحالة الصحية للمحبوس واستعداده البدني والنفسي، وقواعد حفظ النظام والأمن داخل المؤسسة العقابية."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_97_obligation_0_b7f225e4> a dznorm:Obligation ;
