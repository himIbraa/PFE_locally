<https://legal.dz/resource/law/2005-02-06/05-04#version_art_67> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للمحبوس الحق في أن يتلقى زيارة الوصي عليه والمتصرف في أمواله ومحاميه أو أي موظف أو ضابط عمومي متى كانت أسباب الزيارة مشروعة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_67_20050206_OpEnact_b9b264cc51> ;
    dzdoc:replacementText "للمحبوس الحق في أن يتلقى زيارة الوصي عليه والمتصرف في أمواله ومحاميه أو أي موظف أو ضابط عمومي متى كانت أسباب الزيارة مشروعة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
