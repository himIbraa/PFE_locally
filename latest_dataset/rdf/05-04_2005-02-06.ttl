<https://legal.dz/resource/law/2005-02-06/05-04#version_art_46> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "نظام الاحتباس الانفرادي هو نظام يخضع فيه المحبوس للعزلة عن باقي المحبوسين ليلا ونهارا ، ويطبق على الفئات الآتية : المحكوم عليه بالإعدام ، مع مراعاة أحكام المادة 155 من هذا القانون، المحكوم عليه بالسجن المؤبد، على ألا تتجاوز مدة العزلة ثلاث (3) سنوات، المحبوس الخطير، بناء على مقرر يصدره قاضي تطبيق العقوبات كتدبير وقائي بالوضع في العزلة لمدة محددة، المحبوس المريض أو المسن ويطبق عليه كتدبير صحي، بناء على رأي طبيب المؤسسة العقابية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_46_20050206_OpEnact_b18991c3fe> ;
    dzdoc:replacementText "نظام الاحتباس الانفرادي هو نظام يخضع فيه المحبوس للعزلة عن باقي المحبوسين ليلا ونهارا ، ويطبق على الفئات الآتية : المحكوم عليه بالإعدام ، مع مراعاة أحكام المادة 155 من هذا القانون، المحكوم عليه بالسجن المؤبد، على ألا تتجاوز مدة العزلة ثلاث (3) سنوات، المحبوس الخطير، بناء على مقرر يصدره قاضي تطبيق العقوبات كتدبير وقائي بالوضع في العزلة لمدة محددة، المحبوس المريض أو المسن ويطبق عليه كتدبير صحي، بناء على رأي طبيب المؤسسة العقابية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_46> ;
