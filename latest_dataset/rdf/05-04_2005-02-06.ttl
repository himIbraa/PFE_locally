<https://legal.dz/resource/law/2005-02-06/05-04#version_art_124> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة مرض الحدث المحبوس أو وضعه في المستشفى، أو هروبه أو وفاته ، يجب على مدير مركز إعادة تربية وإدماج الأحداث ، أو مدير المؤسسة العقابية أن يخطر فورا، قاضي الأحداث المختص، أو رئيس لجنة إعادة التربية ووالدي الحدث ، أو وليه عند الاقتضاء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_124_20050206_OpEnact_b4170fc152> ;
    dzdoc:replacementText "في حالة مرض الحدث المحبوس أو وضعه في المستشفى، أو هروبه أو وفاته ، يجب على مدير مركز إعادة تربية وإدماج الأحداث ، أو مدير المؤسسة العقابية أن يخطر فورا، قاضي الأحداث المختص، أو رئيس لجنة إعادة التربية ووالدي الحدث ، أو وليه عند الاقتضاء ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_124> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_124> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
