<https://legal.dz/resource/law/2005-02-06/05-04#version_art_165> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب طبقا للأحكام المنصوص عليها في قانون العقوبات ، كل موظف تابع لإدارة السجون ، أو أي شخص يساهم في نشاطات إعادة التربية وإعادة إدماج المحبوسين، أفشى سرا مهنيا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_165_20050206_OpEnact_26fb7b3d95> ;
    dzdoc:replacementText "يعاقب طبقا للأحكام المنصوص عليها في قانون العقوبات ، كل موظف تابع لإدارة السجون ، أو أي شخص يساهم في نشاطات إعادة التربية وإعادة إدماج المحبوسين، أفشى سرا مهنيا ."@ar ;
