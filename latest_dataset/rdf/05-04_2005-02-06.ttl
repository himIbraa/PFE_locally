    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "لا يجوز لموظفي المؤسسة العقابية استعمال السلاح الناري أو اللجوء إلى استخدام القوة تجاه المحبوسين، إلا في حالة الدفاع المشروع، أو التصدي لحالة تمرد أو عصيان، أو استعمال عنف أو محاولة هروب أو مقاومة جسمانية سلبية للأوامر، من أجل السيطرة عليهم."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_41> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_42_obligation_0_d88d3379> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_42> ;
    dznorm:position 0 ;
    dznorm:provisionText "يخطر الطبيب والأخصائي النفساني للمؤسسة العقابية فورا لاتخاذ التدابير اللازمة"@ar ;
    dznorm:sourceArticle "art_42" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_42_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_42> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن إخضاع المحبوس للتدابير الوقائية، باستعمال وسائل التحكم أو الوسائل الطبية الملائمة في الحالات الآتية : 1- إذا أظهر المحبوس عدوانية، أو صدر عنه عنف جسدي خطير تجاه الغير، 2- إذا حاول المحبوس الانتحار، أو تشويه جسده، 3- إذا اختلت قواه العقلية،"@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_42_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_42> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي الحالتين 2 و 3 أعلاه، يخطر الطبيب والأخصائي النفساني للمؤسسة العقابية فورا لاتخاذ التدابير اللازمة."@ar .

