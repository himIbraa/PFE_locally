<https://legal.dz/resource/law/2005-02-06/05-04#art_142_condition_0_a38420ab> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2005-02-06/05-04#art_142_condition_0_a38420ab_ref_a5392775a7c2> ;
