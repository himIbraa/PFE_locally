<https://legal.dz/resource/law/2005-02-06/05-04#version_art_22> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعين بموجب قرار من وزير العدل حافظ الأختام ، في دائرة اختصاص كل مجلس قضائي، قاض أو أكثر، تسند إليه مهام قاضي تطبيق العقوبات . يختار قاضي تطبيق العقوبات من بين القضاة المصنفين في رتب المجلس القضائي، على الأقل، ممن يولون عناية خاصة بمجال السجون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_22_20050206_OpEnact_25f66f4437> ;
    dzdoc:replacementText "يعين بموجب قرار من وزير العدل حافظ الأختام ، في دائرة اختصاص كل مجلس قضائي، قاض أو أكثر، تسند إليه مهام قاضي تطبيق العقوبات . يختار قاضي تطبيق العقوبات من بين القضاة المصنفين في رتب المجلس القضائي، على الأقل، ممن يولون عناية خاصة بمجال السجون ."@ar ;
