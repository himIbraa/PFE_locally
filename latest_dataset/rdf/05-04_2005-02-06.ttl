    dznorm:position 0 ;
    dznorm:provisionText "تحدث لجنة وزارية مشتركة لتنسيق نشاطات إعادة تربية المحبوسين، وإعادة إدماجهم الاجتماعي"@ar ;
    dznorm:sourceArticle "art_21" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_21_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_21> ;
    dzdoc:position 0 ;
    dzdoc:text "تحدث لجنة وزارية مشتركة لتنسيق نشاطات إعادة تربية المحبوسين، وإعادة إدماجهم الاجتماعي، هدفها مكافحة الجنوح وتنظيم الدفاع الاجتماعي."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_21_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_21> ;
    dzdoc:position 1 ;
    dzdoc:text "يحدد تنظيم هذه اللجنة ومهامها وسيرها عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_22_condition_0_ee851748> a dznorm:Condition ;
