        dzdoc:LegalTerm ;
    skos:prefLabel "مؤسسة إعادة التأهيل"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_28_defocc_6ced6666e799> .

dzterm:social_reintegration a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "إعادة الإدماج الاجتماعي للمحبوسين"@ar,
        "الإدماج الاجتماعي للمحبوسين"@ar .

dzterm:temporary_prisoner a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المحبوس مؤقتا"@ar .

dzterm:women_specialized_centers a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "مراكز متخصصة للنساء"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_28_defocc_131c6a23b47d> .

dzterm:استخراج_المحبوس a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "استخراج المحبوس هو عملية اقتياده تحت الحراسة خارج المؤسسة العقابية، كلما وجب مثوله أمام القضاء أو استدعت حالته الصحية نقله لتلقي العلاج، أو لإتمام أي إجراء يستحيل القيام به داخل المؤسسة العقابية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_53_defocc_029291713e44> .

dzterm:القاضي_المختص a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "القاضي المختص"@ar .

dzterm:تحويل_المحبوس a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تحويل المحبوس هو عملية اقتياده تحت الحراسة من مؤسسة عقابية إلى أخرى."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_54_defocc_7bcb9e0d2de2> .

dzterm:لجنة_تطبيق_العقوبات a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "لجنة تطبيق العقوبات"@ar .

dzterm:نظام_الورشات_الخارجية a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يقصد بنظام الورشات الخارجية، قيام المحبوس المحكوم عليه نهائيا بعمل ضمن فرق خارج المؤسسة العقابية، تحت مراقبة إدارة السجون لحساب الهيئات والمؤسسات العمومية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2005-02-06/05-04#art_100_defocc_b5feeb8a0b4c> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_28_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_28> ;
    dzdoc:position 2 ;
    dzdoc:text "ثانيا- المراكز المتخصصة : 1- مراكز متخصصة للنساء، مخصصة لاستقبال النساء المحبوسات مؤقتا، والمحكوم عليهن نهائيا بعقوبة سالبة للحرية مهما تكن مدتها، والمحبوسات لإكراه بدني. 2 - مراكز متخصصة للأحداث، مخصصة لاستقبال الأحداث الذين تقل أعمارهم عن ثماني عشرة (18) سنة، المحبوسين مؤقتا، والمحكوم عليهم نهائيا بعقوبة سالبة للحرية مهما تكن مدتها."@ar .

