<https://legal.dz/resource/law/2005-02-06/05-04#version_art_15> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مع مراعاة أحكام المادة 19 أدناه، يمكن التأجيل المؤقت لتنفيذ العقوبة السالبة للحرية الصادرة ضد الأشخاص الذين لم يكونوا محبوسين عندما أصبح الحكم، أو القرار الصادر عليهم نهائيا . غير أنه، لا يستفيد من أحكام الفقرة أعلاه، المحكوم عليهم معتادو الإجرام والمحكوم عليهم، لارتكاب جرائم المساس بأمن الدولة، أو أفعال إرهابية، أو تخريبية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_15_20050206_OpEnact_0fcb3cf4e4> ;
    dzdoc:replacementText "مع مراعاة أحكام المادة 19 أدناه، يمكن التأجيل المؤقت لتنفيذ العقوبة السالبة للحرية الصادرة ضد الأشخاص الذين لم يكونوا محبوسين عندما أصبح الحكم، أو القرار الصادر عليهم نهائيا . غير أنه، لا يستفيد من أحكام الفقرة أعلاه، المحكوم عليهم معتادو الإجرام والمحكوم عليهم، لارتكاب جرائم المساس بأمن الدولة، أو أفعال إرهابية، أو تخريبية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_15> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_15> ;
