<https://legal.dz/resource/law/2005-02-06/05-04#version_art_173> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "بصفة انتقالية، وفي انتظار صدور النصوص التطبيقية لهذا القانون، تبقى النصوص التنظيمية المتخذة تطبيقا للأمر رقم 72-02 المؤرخ في 25 ذي الحجة عام 1391 الموافق 10 فبراير سنة 1972 سارية المفعول."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_173_20050206_OpEnact_741d61aa72> ;
    dzdoc:replacementText "بصفة انتقالية، وفي انتظار صدور النصوص التطبيقية لهذا القانون، تبقى النصوص التنظيمية المتخذة تطبيقا للأمر رقم 72-02 المؤرخ في 25 ذي الحجة عام 1391 الموافق 10 فبراير سنة 1972 سارية المفعول."@ar ;
