<https://legal.dz/resource/law/2005-02-06/05-04#version_art_143> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحدث لدى وزير العدل، حافظ الأختام ، لجنة لتكييف العقوبات، تتولى البت في الطعون المذكورة في المواد 133 و 141 و 161 من هذا القانون ودراسة طلبات الإفراج المشروط التي يعود اختصاص البت فيها لـ وزير العدل، حافظ الأختام ، وإبداء رأيها فيها قبل إصداره مقررات بشأنها. تحدد تشكيلة هذه اللجنة وتنظيمها وسيرها عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_143_20050206_OpEnact_465d3bf122> ;
    dzdoc:replacementText "تحدث لدى وزير العدل، حافظ الأختام ، لجنة لتكييف العقوبات، تتولى البت في الطعون المذكورة في المواد 133 و 141 و 161 من هذا القانون ودراسة طلبات الإفراج المشروط التي يعود اختصاص البت فيها لـ وزير العدل، حافظ الأختام ، وإبداء رأيها فيها قبل إصداره مقررات بشأنها. تحدد تشكيلة هذه اللجنة وتنظيمها وسيرها عن طريق التنظيم."@ar ;
