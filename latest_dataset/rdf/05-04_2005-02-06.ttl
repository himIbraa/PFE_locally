<https://legal.dz/resource/law/2005-02-06/05-04#version_art_132> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقدم طلب التوقيف المؤقت لتطبيق العقوبة السالبة للحرية من المحبوس أو ممثله القانوني، أو من أحد أفراد عائلته إلى قاضي تطبيق العقوبات . يجب أن يبت قاضي تطبيق العقوبات في الطلب خلال عشرة (10) أيام من تاريخ إخطاره ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_132_20050206_OpEnact_c154b834ad> ;
    dzdoc:replacementText "يقدم طلب التوقيف المؤقت لتطبيق العقوبة السالبة للحرية من المحبوس أو ممثله القانوني، أو من أحد أفراد عائلته إلى قاضي تطبيق العقوبات . يجب أن يبت قاضي تطبيق العقوبات في الطلب خلال عشرة (10) أيام من تاريخ إخطاره ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_132> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_132> ;
