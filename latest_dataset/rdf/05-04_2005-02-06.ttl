<https://legal.dz/resource/law/2005-02-06/05-04#version_art_53> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "استخراج المحبوس هو عملية اقتياده تحت الحراسة خارج المؤسسة العقابية، كلما وجب مثوله أمام القضاء أو استدعت حالته الصحية نقله لتلقي العلاج، أو لإتمام أي إجراء يستحيل القيام به داخل المؤسسة العقابية. يأمر القاضي المختص باستخراج المحبوس لمثوله أمام الجهة القضائية المختصة، ويأمر به قاضي تطبيق العقوبات أو مدير المؤسسة العقابية في الحالات الأخرى، مع وجوب إخطار القاضي المكلف بالقضية في جميع الحالات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_53_20050206_OpEnact_3837b47e4f> ;
    dzdoc:replacementText "استخراج المحبوس هو عملية اقتياده تحت الحراسة خارج المؤسسة العقابية، كلما وجب مثوله أمام القضاء أو استدعت حالته الصحية نقله لتلقي العلاج، أو لإتمام أي إجراء يستحيل القيام به داخل المؤسسة العقابية. يأمر القاضي المختص باستخراج المحبوس لمثوله أمام الجهة القضائية المختصة، ويأمر به قاضي تطبيق العقوبات أو مدير المؤسسة العقابية في الحالات الأخرى، مع وجوب إخطار القاضي المكلف بالقضية في جميع الحالات ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_53> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
