    dznorm:sourceArticle "art_84" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_84_obligation_1_ac1f485c_period_3673dd9add> a dznorm:Period ;
    rdfs:label "في أجل أقصاه خمسة (5) أيام من تاريخ إ"@ar ;
    dzdoc:confidenceScore 0.68 ;
