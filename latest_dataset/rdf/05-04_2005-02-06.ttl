<https://legal.dz/resource/law/2005-02-06/05-04#art_86_condition_0_abe05651> a dznorm:Condition ;
    dznorm:conditionText "إذا حسن المحبوس سلوكه أو لمتابعة دروس أو تكوين أو لأسباب صحية أو حادث عائلي طارئ، أو بمناسبة الأعياد الدينية أو الوطنية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_86> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_86_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_86> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن وقف تنفيذ التدبير التأديبي ضد المحبوس، أو رفعه أو تأجيل تنفيذه، من طرف الجهة التي قررته، إذا حسن المحبوس سلوكه أو لمتابعة دروس أو تكوين أو لأسباب صحية أو حادث عائلي طارئ، أو بمناسبة الأعياد الدينية أو الوطنية."@ar .

