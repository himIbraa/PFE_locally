<https://legal.dz/resource/law/2005-02-06/05-04#version_art_36> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن بترخيص من وزير العدل حافظ الأختام ، أو النائب العام المختص إقليميا ، أن تستقبل المؤسسات العقابية ، زيارة الباحثين والجمعيات والمنظمات الحكومية أو غير الحكومية ذات الطابع الإنساني أو الخيري، المهتمة بعالم السجون."@ar ;
