    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_22> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_22_obligation_0_626e77b7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_22> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعين بموجب قرار من وزير العدل حافظ الأختام، في دائرة اختصاص كل مجلس قضائي، قاض أو أكثر، تسند إليه مهام قاضي تطبيق العقوبات"@ar ;
    dznorm:sourceArticle "art_22" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_22_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_22> ;
    dzdoc:position 0 ;
    dzdoc:text "يعين بموجب قرار من وزير العدل حافظ الأختام، في دائرة اختصاص كل مجلس قضائي، قاض أو أكثر، تسند إليه مهام قاضي تطبيق العقوبات."@ar .

