<https://legal.dz/resource/law/2005-02-06/05-04#version_art_92> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على إدارة المؤسسة العقابية، وتحت إشرافها ورقابتها، تمكين المحبوسين من متابعة برامج الإذاعة والتلفزة، والاطلاع على الجرائد والمجلات، وتلقي المحاضرات في المجال التربوي والثقافي والديني. كما يمكن بث البرامج السمعية أو السمعية البصرية الهادفة إلى إعادة التربية بعد استشارة لجنة تطبيق العقوبات، أو لجنة إعادة تربية الأحداث، حسب كل حالة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_92_20050206_OpEnact_1d1730f408> ;
    dzdoc:replacementText "يجب على إدارة المؤسسة العقابية، وتحت إشرافها ورقابتها، تمكين المحبوسين من متابعة برامج الإذاعة والتلفزة، والاطلاع على الجرائد والمجلات، وتلقي المحاضرات في المجال التربوي والثقافي والديني. كما يمكن بث البرامج السمعية أو السمعية البصرية الهادفة إلى إعادة التربية بعد استشارة لجنة تطبيق العقوبات، أو لجنة إعادة تربية الأحداث، حسب كل حالة ."@ar ;
