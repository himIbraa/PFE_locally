<https://legal.dz/resource/law/2005-02-06/05-04#art_39_condition_0_987538cb> a dznorm:Condition ;
    dznorm:conditionText "عندما تكون المؤسسة العقابية مهددة في أمنها و حفظ النظام بداخلها، بسبب تمرد أو عصيان أو هروب جماعي، أو أي ظرف خطير آخر، أو حالة قوة قاهرة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_39> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_39_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_39> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما تكون المؤسسة العقابية مهددة في أمنها و حفظ النظام بداخلها، بسبب تمرد أو عصيان أو هروب جماعي، أو أي ظرف خطير آخر، أو حالة قوة قاهرة، يجوز لوزير العدل، حافظ الأختام، أن يقرر وقف العمل مؤقتا بالقواعد العادية لمعاملة المحبوسين، كليا أو جزئيا، وأن يتخذ كل التدابير الملائمة لحفظ النظام والأمن داخل المؤسسة العقابية."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_39_permission_0_903d57c2> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2005-02-06/05-04#art_39_permission_0_903d57c2_action_e0553434e7> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_39> ;
    dznorm:position 0 ;
    dznorm:provisionText "عندما تكون المؤسسة العقابية مهددة في أمنها و حفظ النظام بداخلها، بسبب تمرد أو عصيان أو هروب جماعي، أو أي ظرف خطير آخر، أو حالة قوة قاهرة، يجوز لوزير العدل، حافظ الأختام، أن يقرر وقف العمل مؤقتا بالقواعد العادية لمعاملة المحبوسين، كليا أو جزئيا، وأن يتخذ كل التدابير الملائمة لحفظ النظام والأمن داخل المؤسسة العقابية."@ar ;
    dznorm:sourceArticle "art_39" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_39_permission_0_903d57c2_action_e0553434e7> a dznorm:Action ;
    rdfs:label "لوزير العدل"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "عندما تكون المؤسسة العقابية مهددة في أمنها و حفظ النظام بداخلها، بسبب تمرد أو عصيان أو هروب جماعي، أو أي ظرف خطير آخر، أو حالة قوة قاهرة، يجوز لوزير العدل، حافظ الأختام، أن يقرر وقف العمل مؤقتا بالقواعد العادية لمعاملة المحبوسين، كليا أو جزئيا، وأن يتخذ كل التدابير الملائمة لحفظ النظام والأمن داخل المؤسسة العقابية."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_39> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_3_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_3> ;
    dzdoc:position 0 ;
    dzdoc:text "يرتكز تطبيق العقوبة السالبة للحرية على مبدأ تفريد العقوبة الذي يتمثل في معاملة المحبوس وفقا لوضعيته الجزائية، وحالته البدنية والعقلية."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_40_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_40> ;
    dzdoc:position 0 ;
    dzdoc:text "تزود المؤسسات العقابية لحفظ النظام بها وضمان أمنها طبقا للتشريع والتنظيم المعمول بهما، بالأسلحة والذخيرة، وجميع الوسائل الأمنية ووسائل الدفاع، للتصدي للحالات الخطيرة الطارئة."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_41_obligation_0_786416de> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2005-02-06/05-04#art_41_obligation_0_786416de_action_e95d7090e4> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_41> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يجوز لموظفي المؤسسة العقابية استعمال السلاح الناري أو اللجوء إلى استخدام القوة تجاه المحبوسين، إلا في حالة الدفاع المشروع، أو التصدي لحالة تمرد أو عصيان، أو استعمال عنف أو محاولة هروب أو مقاومة جسمانية سلبية للأوامر، من أجل السيطرة عليهم"@ar ;
    dznorm:sourceArticle "art_41" .

