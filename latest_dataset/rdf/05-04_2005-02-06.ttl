<https://legal.dz/resource/law/2005-02-06/05-04#version_art_95> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم التكوين المهني داخل المؤسسة العقابية ، أو في معامل المؤسسات العقابية، أو في الورشات الخارجية، أو في مراكز التكوين المهني."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_95_20050206_OpEnact_b592bc2845> ;
    dzdoc:replacementText "يتم التكوين المهني داخل المؤسسة العقابية ، أو في معامل المؤسسات العقابية، أو في الورشات الخارجية، أو في مراكز التكوين المهني."@ar ;
