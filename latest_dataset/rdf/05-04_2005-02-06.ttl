    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_140> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_140_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_140> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب أن يتضمن ملف الإفراج المشروط تقريرا مسببا لمدير المؤسسة العقابية، أو مدير مركز إعادة التربية وإدماج الأحداث حسب الحالة، حول سيرة وسلوك المحبوس ، والمعطيات الجدية لضمان استقامته."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_141_condition_0_c7bb1515> a dznorm:Condition ;
    dznorm:conditionText "إذا كان باقي العقوبة يساوي أو يقل عن أربعة وعشرين (24) شهرا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_141> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_141_obligation_0_933448d6> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_141> ;
    dznorm:position 0 ;
    dznorm:provisionText "يصدر قاضي تطبيق العقوبات مقرر الإفراج المشروط"@ar ;
    dznorm:sourceArticle "art_141" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_141_obligation_1_f0b1bf79> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_141> ;
