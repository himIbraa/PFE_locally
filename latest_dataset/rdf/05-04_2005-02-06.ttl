<https://legal.dz/resource/law/2005-02-06/05-04#version_art_141> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يصدر قاضي تطبيق العقوبات مقرر الإفراج المشروط ، بعد أخذ رأي لجنة تطبيق العقوبات، إذا كان باقي العقوبة يساوي أو يقل عن أربعة وعشرين (24) شهرا . يبلغ مقرر الإفراج المشروط إلى النائب العام، عن طريق كتابة ضبط المؤسسة العقابية فور صدوره ، ولا ينتج أثره إلا بعد انقضاء أجل الطعن. يجوز للنائب العام أن يطعن في مقرر الإفراج المشروط أمام اللجنة المنصوص عليها في المادة 143 من هذا القانون في أجل ثمانية (8) أيام من تاريخ التبليغ. للطعن في مقرر الإفراج أمام هذه اللجنة أثر موقف. تبت لجنة تكييف العقوبات وجوبا في"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_141_20050206_OpEnact_e41ae614d2> ;
    dzdoc:replacementText "يصدر قاضي تطبيق العقوبات مقرر الإفراج المشروط ، بعد أخذ رأي لجنة تطبيق العقوبات، إذا كان باقي العقوبة يساوي أو يقل عن أربعة وعشرين (24) شهرا . يبلغ مقرر الإفراج المشروط إلى النائب العام، عن طريق كتابة ضبط المؤسسة العقابية فور صدوره ، ولا ينتج أثره إلا بعد انقضاء أجل الطعن. يجوز للنائب العام أن يطعن في مقرر الإفراج المشروط أمام اللجنة المنصوص عليها في المادة 143 من هذا القانون في أجل ثمانية (8) أيام من تاريخ التبليغ. للطعن في مقرر الإفراج أمام هذه اللجنة أثر موقف. تبت لجنة تكييف العقوبات وجوبا في الطعن المرفوع أمامها من النائب العام خلال مهلة خمسة وأربعين (45) يوما ابتداء من تاريخ الطعن ويعد عدم البت خلالها رفضا للطعن."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_141> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_141> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-02-06"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2005-02-06/05-04#version_art_142> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يصدر وزير العدل، حافظ الأختام ، مقرر الإفراج المشروط عن المحبوس الباقي على انقضاء مدة عقوبته أكثر من أربعة وعشرين (24) شهرا، في الحالات المنصوص عليها في المادة 135 من هذا القانون ."@ar ;
    dzdoc:isAuthoritative true ;
