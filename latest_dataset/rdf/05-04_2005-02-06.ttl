    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تستفيد المحبوسة الحامل بظروف احتباس ملائمة، لا سيما من حيث التغذية المتوازنة، والرعاية الطبية المستمرة، والحق في الزيارة والمحادثة مع زائريها من دون فاصل ."@ar ;
