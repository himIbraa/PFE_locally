<https://legal.dz/resource/law/2005-02-06/05-04#art_98_obligation_0_4a45cbb9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2005-02-06/05-04#art_98_obligation_0_4a45cbb9_role_4e91898b2e> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_98> ;
    dznorm:position 0 ;
    dznorm:provisionText "توزع إدارة المؤسسة العقابية المكسب المالي للمحبوس على ثلاث (3) حصص متساوية"@ar ;
    dznorm:sourceArticle "art_98" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_98_obligation_0_4a45cbb9_role_4e91898b2e> a dznorm:Role ;
    rdfs:label "ثلاث (3) حصص متساوية"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "توزع إدارة المؤسسة العقابية المكسب المالي للمحبوس على ثلاث (3) حصص متساوية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_98> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_98_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_98> ;
    dzdoc:position 1 ;
    dzdoc:text "توزع إدارة المؤسسة العقابية المكسب المالي للمحبوس على ثلاث (3) حصص متساوية : 1- حصة ضمان لدفع الغرامات والمصاريف القضائية والاشتراكات القانونية، عند الاقتضاء. 2 - حصة قابلة للتصرف تخصص لاقتناء المحبوس حاجاته الشخصية والعائلية. 3- حصة احتياط تسلم للمحبوس عند الإفراج عنه."@ar .

