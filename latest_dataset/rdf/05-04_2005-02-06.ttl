<https://legal.dz/resource/law/2005-02-06/05-04#version_art_27> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحدث لدى كل مؤسسة عقابية : كتابة ضبط قضائية تكلف بمتابعة الوضعية الجزائية للمحبوسين. كتابة ضبط محاسبة تكلف بمسك أموال وودائع المحبوسين وتسييرها. يمكن إحداث مصالح أخرى لضمان حسن سير المؤسسة العقابية . ويحدد عددها وتنظيمها ومهامها عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_27_20050206_OpEnact_04d26118c4> ;
    dzdoc:replacementText "تحدث لدى كل مؤسسة عقابية : كتابة ضبط قضائية تكلف بمتابعة الوضعية الجزائية للمحبوسين. كتابة ضبط محاسبة تكلف بمسك أموال وودائع المحبوسين وتسييرها. يمكن إحداث مصالح أخرى لضمان حسن سير المؤسسة العقابية . ويحدد عددها وتنظيمها ومهامها عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_27> ;
