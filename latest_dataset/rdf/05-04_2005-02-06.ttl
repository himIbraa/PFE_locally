    dzdoc:sourceTextSpan "يمكن إرجاع المحبوس إلى المؤسسة العقابية مساء كل يوم بعد انتهاء مدة دوام العمل."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_102> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_103_obligation_0_c558e2ce> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2005-02-06/05-04#art_103_obligation_0_c558e2ce_role_561d77cfb6> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_103> ;
    dznorm:position 0 ;
    dznorm:provisionText "يوقع على الاتفاقية كل من مدير المؤسسة العقابية وممثل الهيئة الطالبة."@ar ;
    dznorm:sourceArticle "art_103" .

<https://legal.dz/resource/law/2005-02-06/05-04#art_103_obligation_0_c558e2ce_role_561d77cfb6> a dznorm:Role ;
    rdfs:label "الاتفاقية كل من مدير"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يوقع على الاتفاقية كل من مدير المؤسسة العقابية وممثل الهيئة الطالبة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_103> .

<https://legal.dz/resource/law/2005-02-06/05-04#art_103_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_103> ;
    dzdoc:position 0 ;
    dzdoc:text "توجه طلبات تخصيص اليد العاملة العقابية إلى قاضي تطبيق العقوبات الذي يحيلها بدوره على لجنة تطبيق العقوبات لإبداء الرأي. وفي حالة الموافقة تبرم مع الهيئة الطالبة اتفاقية تحدد فيها الشروط العامة والخاصة لاستخدام اليد العاملة من المحبوسين."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_103_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_103> ;
    dzdoc:position 1 ;
    dzdoc:text "يوقع على الاتفاقية كل من مدير المؤسسة العقابية وممثل الهيئة الطالبة."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_105_condition_0_3b1badf8> a dznorm:Condition ;
    dznorm:conditionText "وفق الشروط المحددة في هذا القسم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_105> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2005-02-06/05-04#art_105_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_105> ;
    dzdoc:position 0 ;
    dzdoc:text "تمنح الاستفادة من نظام الحرية النصفية للمحبوس وفق الشروط المحددة في هذا القسم، لتمكينه من تأدية عمل، أو مزاولة دروس في التعليم العام أو التقني، أو متابعة دراسات عليا أو تكوين مهني."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_105_right_0_b4360484> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_105> ;
    dznorm:position 0 ;
    dznorm:provisionText "تمنح الاستفادة من نظام الحرية النصفية للمحبوس"@ar ;
    dznorm:sourceArticle "art_105" .

