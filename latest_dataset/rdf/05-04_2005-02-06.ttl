<https://legal.dz/resource/law/2005-02-06/05-04#art_100_defocc_b5feeb8a0b4c> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 155 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:نظام_الورشات_الخارجية ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_100> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_100_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يقصد بنظام الورشات الخارجية، قيام المحبوس المحكوم عليه نهائيا بعمل ضمن فرق خارج المؤسسة العقابية، تحت مراقبة إدارة السجون لحساب الهيئات والمؤسسات العمومية."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_100_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_100> ;
    dzdoc:position 0 ;
    dzdoc:text "يقصد بنظام الورشات الخارجية، قيام المحبوس المحكوم عليه نهائيا بعمل ضمن فرق خارج المؤسسة العقابية، تحت مراقبة إدارة السجون لحساب الهيئات والمؤسسات العمومية."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_104_defocc_e16176ce38af> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 152 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:نظام_الحرية_النصفية ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_104> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2005-02-06/05-04#art_104_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يقصد بنظام الحرية النصفية، وضع المحبوس المحكوم عليه نهائيا خارج المؤسسة العقابية خلال النهار منفردا ودون حراسة أو رقابة الإدارة ليعود إليها مساء كل يوم."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_104_para_0> a dzdoc:Paragraph ;
