<https://legal.dz/resource/law/2005-02-06/05-04#version_art_85> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "فيما عدا حالات الاستعجال، إذا كان التدبير التأديبي هو الوضع في العزلة ، فلا يمكن تنفيذه إلا بعد استشارة الطبيب و/أو الأخصائي النفساني للمؤسسة العقابية . يظل المحبوس الموضوع في العزلة محل متابعة طبية مستمرة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_85_20050206_OpEnact_283847a37c> ;
