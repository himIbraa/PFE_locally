<https://legal.dz/resource/law/2005-02-06/05-04#art_66> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_66" ;
    dzdoc:fullText "للمحبوس الحق في أن يتلقى زيارة أصوله وفروعه إلى غاية الدرجة الرابعة، وزوجه ومكفوله، وأقاربه بالمصاهرة إلى غاية الدرجة الثالثة . يمكن الترخيص، استثناء، بزيارة المحبوس من طرف أشخاص آخرين أو جمعيات إنسانية وخيرية، إذا تبين أن في زيارتهم له فائدة لإعادة إدماجه اجتماعيا . كما أن للمحبوس الحق في ممارسة واجباته الدينية، وفي أن يتلقى زيارة رجل دين من ديانته ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2005-02-06/05-04#art_66_permission_0_7b5c2618> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2005-02-06/05-04#art_66_right_0_731d0331>,
        <https://legal.dz/resource/law/2005-02-06/05-04#art_66_right_1_0f9dc1c2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2005-02-06/05-04#version_art_66> ;
