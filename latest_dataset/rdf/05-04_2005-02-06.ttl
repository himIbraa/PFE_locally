<https://legal.dz/resource/law/2005-02-06/05-04#version_art_120> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن يسند إلى الحدث المحبوس عمل ملائم بغرض رفع مستواه الدراسي أو المهني ما لم يتعارض ذلك مع مصلحة الحدث، وأحكام المادة 160 من هذا القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_120_20050206_OpEnact_4d3b96b08a> ;
    dzdoc:replacementText "يمكن أن يسند إلى الحدث المحبوس عمل ملائم بغرض رفع مستواه الدراسي أو المهني ما لم يتعارض ذلك مع مصلحة الحدث، وأحكام المادة 160 من هذا القانون ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_120> ;
