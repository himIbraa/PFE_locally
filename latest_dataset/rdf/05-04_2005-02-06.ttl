<https://legal.dz/resource/law/2005-02-06/05-04#version_art_40> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تزود المؤسسات العقابية لحفظ النظام بها وضمان أمنها طبقا للتشريع والتنظيم المعمول بهما، بالأسلحة والذخيرة، وجميع الوسائل الأمنية ووسائل الدفاع، للتصدي للحالات الخطيرة الطارئة."@ar ;
