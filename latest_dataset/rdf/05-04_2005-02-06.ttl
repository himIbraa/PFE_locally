<https://legal.dz/resource/law/2005-02-06/05-04#version_art_121> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتعرض الحدث المحبوس الذي يخالف قواعد الانضباط والأمن والنظافة إلى أحد التدابير التأديبية الآتية : الإنذار، التوبيخ، الحرمان المؤقت من بعض النشاطات الترفيهية، المنع المؤقت من التصرف في مكسبه المالي. يقرر مدير المركز أو المؤسسة العقابية، حسب الحالة التدبيرين الأول والثاني، ولا يقرر التدبيرين الثالث والرابع، إلا بعد أخذ رأي لجنة التأديب المنصوص عليها في المادة 122 من هذا القانون. يجب على المدير، في جميع الحالات، إخطار لجنة إعادة التربية المنصوص عليها في المادة 126 من هذا القانون، بكل التدابير المتخ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_121_20050206_OpEnact_cabb7a1d36> ;
    dzdoc:replacementText "يتعرض الحدث المحبوس الذي يخالف قواعد الانضباط والأمن والنظافة إلى أحد التدابير التأديبية الآتية : الإنذار، التوبيخ، الحرمان المؤقت من بعض النشاطات الترفيهية، المنع المؤقت من التصرف في مكسبه المالي. يقرر مدير المركز أو المؤسسة العقابية، حسب الحالة التدبيرين الأول والثاني، ولا يقرر التدبيرين الثالث والرابع، إلا بعد أخذ رأي لجنة التأديب المنصوص عليها في المادة 122 من هذا القانون. يجب على المدير، في جميع الحالات، إخطار لجنة إعادة التربية المنصوص عليها في المادة 126 من هذا القانون، بكل التدابير المتخذة ضد الحدث المحبوس ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_121> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_121> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-02-06"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2005-02-06/05-04#version_art_122> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحدث على مستوى كل مركز إعادة التربية وإدماج الأحداث، وفي كل جناح للأحداث بالمؤسسات العقابية، لجنة للتأديب يرأسها مدير مركز إعادة التربية وإدماج الأحداث، أو مدير المؤسسة العقابية، حسب وتتشكل من عضوية : رئيس مصلحة الاحتباس، مختص في علم النفس، مساعدة اجتماعية، الحالة، مرب."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_122_20050206_OpEnact_23a53bf26a> ;
    dzdoc:replacementText "تحدث على مستوى كل مركز إعادة التربية وإدماج الأحداث، وفي كل جناح للأحداث بالمؤسسات العقابية، لجنة للتأديب يرأسها مدير مركز إعادة التربية وإدماج الأحداث، أو مدير المؤسسة العقابية، حسب وتتشكل من عضوية : رئيس مصلحة الاحتباس، مختص في علم النفس، مساعدة اجتماعية، الحالة، مرب."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_122> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_122> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
