<https://legal.dz/resource/law/2005-02-06/05-04#version_art_60> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسهر طبيب المؤسسة العقابية على مراعاة قواعد الصحة والنظافة الفردية والجماعية داخل أماكن الاحتباس . وعلى طبيب المؤسسة العقابية أن يتفقد مجموع الأماكن بها، ويخطر المدير بكل معاينة للنقائص، أو كل الوضعيات التي من شأنها الإضرار بصحة المحبوسين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_60_20050206_OpEnact_583d976a43> ;
    dzdoc:replacementText "يسهر طبيب المؤسسة العقابية على مراعاة قواعد الصحة والنظافة الفردية والجماعية داخل أماكن الاحتباس . وعلى طبيب المؤسسة العقابية أن يتفقد مجموع الأماكن بها، ويخطر المدير بكل معاينة للنقائص، أو كل الوضعيات التي من شأنها الإضرار بصحة المحبوسين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2005-02-06/05-04#art_60> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2005-02-06/05-04> ;
