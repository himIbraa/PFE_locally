<https://legal.dz/resource/law/2005-02-06/05-04#version_art_71> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للمحبوس الأجنبي الحق في أن يتلقى زيارة الممثل القنصلي لبلده وذلك مع مراعاة مبدأ المعاملة بالمثل، وفي حدود النظام الداخلي للمؤسسة العقابية. تسلم رخصة زيارة المحبوس الأجنبي المحكوم عليه للمثل القنصلي لبلدة من المصالح المختصة بوزارة العدل ، و تسلم له طبقا لأحكام المادة 68 الفقرة (3) أعلاه، إذا كان محبوسا مؤقتا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_71_20050206_OpEnact_597ce1769a> ;
    dzdoc:replacementText "للمحبوس الأجنبي الحق في أن يتلقى زيارة الممثل القنصلي لبلده وذلك مع مراعاة مبدأ المعاملة بالمثل، وفي حدود النظام الداخلي للمؤسسة العقابية. تسلم رخصة زيارة المحبوس الأجنبي المحكوم عليه للمثل القنصلي لبلدة من المصالح المختصة بوزارة العدل ، و تسلم له طبقا لأحكام المادة 68 الفقرة (3) أعلاه، إذا كان محبوسا مؤقتا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
