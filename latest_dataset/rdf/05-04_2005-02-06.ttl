    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "تحويل المحبوس هو عملية اقتياده تحت الحراسة من مؤسسة عقابية إلى أخرى."@ar .

<https://legal.dz/resource/law/2005-02-06/05-04#art_54_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2005-02-06/05-04#art_54> ;
