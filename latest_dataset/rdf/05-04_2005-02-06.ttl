<https://legal.dz/resource/law/2005-02-06/05-04#version_art_45> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2005-02-06/05-04> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يطبق نظام الاحتباس الجماعي في المؤسسات العقابية، وهو نظام يعيش فيه المحبوسون جماعيا. ويمكن اللجوء إلى نظام الاحتباس الانفرادي ليلا، عندما يسمح به توزيع الأماكن، ويكون ملائما لشخصية المحبوس، ومفيدا في عملية إعادة تربيته ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2005-02-06/05-04#version_art_45_20050206_OpEnact_9920673d33> ;
