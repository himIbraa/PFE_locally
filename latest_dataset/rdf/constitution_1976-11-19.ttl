<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_129> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينتخب المجلس الشعبي الوطني لمدة خمس سنوات. لا يمكن تمديد فترة هذه النيابة إلا في ظروف خطيرة للغاية لا تسمح بإجراء انتخابات عادية . و تثبت هذه الحالة بمقتضى قرار من المجلس الشعبي الوطني، بناء على اقتراح من رئيس الجمهورية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
