<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_188> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن ل المجلس الشعبي الوطني ، في نطاق اختصاصاته، أن ينشئ، في أي وقت، لجنة تحقيق في أية قضية ذات مصلحة عامة . يعين المجلس الشعبي الوطني أعضاء لجنة التحقيق من النواب. يحدد القانون طرق تسيير هذه اللجنة."@ar ;
