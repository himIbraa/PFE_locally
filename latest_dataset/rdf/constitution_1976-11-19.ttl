<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_162> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن لأعضاء المجلس الشعبي الوطني أن يوجهوا كتابة فقط، أي سؤال إلى أي عضو من الحكومة ، و ينبغي لهذا العضو أن يجيب كتابة في ظرف خمسة عشر يوما (15) . يتم نشر نص الأسئلة و الأجوبة طبقا لنفس الشروط التي يخضع لها نشر محاضر مناقشات المجلس الشعبي الوطني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_162_19761119_OpEnact_d58ff177e6> ;
