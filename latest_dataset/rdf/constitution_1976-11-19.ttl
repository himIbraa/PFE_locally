    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_133> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "النيابة في المجلس الشعبي الوطني قابلة للتجديد."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_134_19761119_OpEnact_e022a198b9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_134> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_134> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_134> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "كل نائب لا يستوفي شروط النيابة أو أصبح غير مستوف لها ، يتعرض لإسقاط صفته النيابية. يقرر المجلس الشعبي الوطني هذا الإسقاط بأغلبية أعضائه."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_135_19761119_OpEnact_0d190d4b73> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_135> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_135> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_135> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "النائب مسئول أمام زملائه الذين يمكنهم عزله إذا خان ثقة الشعب فيه أو اقترف عملا مخلا بوظيفته . يحدد القانون الحالات التي يتعرض فيها النائب للعزل، و يقر المجلس الشعبي الوطني العزل بأغلبية أعضائه، بقطع النظر عما قد يحدث من متابعات أخرى حسب التشريع العادي."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_136_19761119_OpEnact_90dca8702a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_136> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_136> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_136> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يحدد القانون الظروف التي يمكن فيها للمجلس الشعبي الوطني قبول استقالة أحد أعضائه."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_137_19761119_OpEnact_52a62f06f7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_137> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_137> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_137> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "الحصانة النيابية معترف بها للنائب أثناء نيابته . لا يمكن متابعة أي نائب أو إلقاء القبض عليه، و بصفة عامة، لا يمكن رفع دعوى مدنية أو جزائية ضده بسبب ما أبداه من آراء أو ما تلفظ به من كلام أو بسبب تصويته أثناء ممارسته للنيابة ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_138_19761119_OpEnact_31ae44ec2c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_138> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_138> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_138> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لا تجوز متابعة أي نائب بسبب عمل جنائي إلا بإذن من المجلس الشعبي الوطني الذي يقرر رفع الحصانة بأغلبية أعضائه ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_139_19761119_OpEnact_a84a2efd53> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_139> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_139> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_139> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "في حالة تلبس النائب بجنحة أو جريمة ، يخطر مكتب المجلس الشعبي الوطني فورا. و يكتسب قوة القانون كل قرار يتخذه مكتب المجلس لضمان الإحترام لمبدأ الحصانة النيابية ، إن اقتضى الأمر."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_13_19761119_OpEnact_4dfd28d2d6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_13> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_13> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_13> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يشكل تحقيق اشتراكية وسائل الإنتاج قاعدة أساسية للإشتراكية ، و تمثل ملكية الدولة أعلى أشكال الملكية الإجتماعية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_140_19761119_OpEnact_620df64773> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_140> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_140> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_140> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يحدد القانون شروط استخلاف النائب في حالة شغور مقعده."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_141_19761119_OpEnact_b44c815b01> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_141> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_141> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_141> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تبتدئ الفترة التشريعية، وجوبا، في اليوم الثامن الموالي لتاريخ انتخاب المجلس الشعبي الوطني ، تحت رئاسة أكبر النواب سنا و بمساعده أصغر نائبين منهم . ينتخب المجلس مكتبه و يشكل لجانه."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_142_19761119_OpEnact_95973d0cdc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
