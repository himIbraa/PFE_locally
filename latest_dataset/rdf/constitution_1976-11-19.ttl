<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_182> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يبدي المجلس الأعلى للقضاء رأيا استشاريا قبل ممارسة رئيس الجمهورية حق العفو. يقر المجلس الأعلى للقضاء ، طبقا للأحكام التي يحددها القانون، تعيين القضاة و نقلهن و سير سلمهم الوظيفي، و يساهم في مراقبة انضباطهم."@ar ;
