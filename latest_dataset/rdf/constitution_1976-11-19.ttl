<https://legal.dz/resource/constitution/1976-11-19/1976#art_101> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الأول_الوظيفة_السياسية> ;
    dzdoc:eId "art_101" ;
    dzdoc:fullText "تعمل أجهزة الحزب و أجهزة الدولة في إطارين منفصلين و بوسائل مختلفة من أجل تحقيق أهداف واحدة. لا يمكن أن تتداخل اختصاصات كل منهما أو تختلط ببعضها . يقوم التنظيم السياسي للبلاد على التكامل في المهام بين أجهزة الحزب و أجهزة الدولة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1976-11-19/1976#art_101_permission_0_b2283a95> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_101> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_101_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_101_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_101_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_101_19761119_OpEnact_0ff2730de4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_101_obligation_0_dc50485b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 101" ;
    dzdoc:position 100 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_123> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_123" ;
    dzdoc:fullText "يوقف العمل بالدستور مدة حالة الحرب و يتولى رئيس الدولة جميع السلطات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_123> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_123_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_123_19761119_OpEnact_21d66ffd6e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_123_obligation_0_209a7efc> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "123" ;
    dzdoc:position 122 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_148> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_في_النزاع_الناشئ_عن_الإنتخابات_التشريعية_من_اختصاص_المجلس_الأعلى> ;
    dzdoc:eId "art_148" ;
    dzdoc:fullText "المبادرة بالقوانين حق ل رئيس الجمهورية ، كما أنها حق لأعضاء المجلس الشعبي الوطني . تكون اقتراحات القوانين قابلة للنقاش إذا قدمها عشرون نائبا . تقدم مشاريع القوانين من الحكومة إلى مكتب المجلس الشعبي الوطني ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_148_right_0_6f042afe>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_148_right_1_7465027d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_148> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_148_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_148_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_148_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_148_19761119_OpEnact_b54f60776c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_148_obligation_0_56fe825b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 148" ;
    dzdoc:position 147 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1976-11-19/1976#art_148_condition_0_05e6ad18> ;
    dzdoc:usesTerm dzterm:national_peoples_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_في_النزاع_الناشئ_عن_الإنتخابات_التشريعية_من_اختصاص_المجلس_الأعلى> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "يمكن لـ المجلس الشعبي الوطني ، بطلب من رئيس الجمهورية ، أو من رئيسه، أن يفتح مناقشة حول السياسة الخارجية . يمكن، عند اقتضاء، أن تفضي هذه المناقشة إلى إصدار لائحة من المجلس الشعبي الوطني تبلغ بواسطة رئيسه إلى رئيس الجمهورية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1976-11-19/1976#art_157_permission_0_b44be92d>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_157_permission_1_311bc94c> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_157_right_0_05d15cb2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_157_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_157_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_157_19761119_OpEnact_5c531bc51c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 157" ;
    dzdoc:position 156 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:president .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_188> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الخامس_وظيفة_المراقبة> ;
    dzdoc:eId "art_188" ;
    dzdoc:fullText "يمكن ل المجلس الشعبي الوطني ، في نطاق اختصاصاته، أن ينشئ، في أي وقت، لجنة تحقيق في أية قضية ذات مصلحة عامة . يعين المجلس الشعبي الوطني أعضاء لجنة التحقيق من النواب. يحدد القانون طرق تسيير هذه اللجنة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1976-11-19/1976#art_188_permission_0_67245657> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_188_right_0_e5bae3e9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_188> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_188_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_188_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_188_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_188_19761119_OpEnact_fa1a1e1955> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 188" ;
    dzdoc:position 187 ;
    dzdoc:usesTerm dzterm:apn .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_29" ;
    dzdoc:fullText "تعمل الدولة على تغيير علاقات الإنتاج، و تسيير الإقتصاد الوطني ، و تضمن تنمية على أساس تخطيط علمي المفهوم، ديمقراطي التصميم، حتمي التنفيذ . تنظم الدولة الإنتاج و تحدد توزيع الدخل القومي ، و هي العنصر الأساسي في تحويل الإقتصاد و مجموع العلاقات الإجتماعية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_29_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_29_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_29_19761119_OpEnact_8472e376ba> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_29_obligation_0_c698ce98>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_29_obligation_1_c8e9b0b2>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_29_obligation_2_43150b7a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 29" ;
    dzdoc:position 28 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "الدولة مسؤولة عن ظروف حياة كل مواطن . فهي تكفل استيفاء حاجياته المادية والمعنوية، وبخاصة متطلباته المتعلقة بالكرامة والأمن . وهي تستهدف تحرير المواطن من الإستغلال و البطالة و المرض و الجهل. تتكفل الدولة بحماية مواطنيها في الخارج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_33_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_33_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_33_para_2>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_33_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_33_19761119_OpEnact_d586c5df64> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_33_obligation_0_84e03d62>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_33_obligation_1_94ef9501>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_33_obligation_2_356d8d82> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 33" ;
    dzdoc:position 32 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_85> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_السادس_الجيش_الوطني_الشعبي> ;
    dzdoc:eId "art_85" ;
    dzdoc:fullText "يحظى المجاهدون و أولو الحق من ذويهم بحماية خاصة من طرف الدولة . ضمان الحقوق الخاصة بالمجاهدين و أولي الحق من ذويهم ، و الحفاظ على كرامتهم، فرض على الدولة و المجتمع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_85_right_0_ff7a11e4>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_85_right_1_db3ca3d8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_85> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_85_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_85_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_85_19761119_OpEnact_06fa57a62b> ;
