    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_98> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتجسد قيادة البلاد في وحدة القيادة السياسية للحزب و الدولة. و في إطار هذه الوحدة، فإن قيادة الحزب هي التي توجه السياسة العامة للبلاد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_98_19761119_OpEnact_8f588f280b> ;
    dzdoc:replacementText "تتجسد قيادة البلاد في وحدة القيادة السياسية للحزب و الدولة. و في إطار هذه الوحدة، فإن قيادة الحزب هي التي توجه السياسة العامة للبلاد."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_98> ;
