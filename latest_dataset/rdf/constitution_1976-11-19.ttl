<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_110> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤدي رئيس الجمهورية اليمين حسب النص الآتي : “وفاء للتضحيات الكبرى و لأرواح شهداء ثورتنا المقدسة أقسم بالله العلي العظيم أن أحترم الدين الإسلامي و أمجده ، و أن أحترم الميثاق الوطني و الدستور، و كل قوانين الجمهورية و أحميها ، و أن أحترم الإختيار الإشتراكي الذي لا رجعة فيه ، و أن أحافظ على سلامة التراب الوطني و حدة الشعب و الأمة ، و أن أحمي الحقوق و الحريات الأساسية للشعب و أعمل بدون هوادة على تطوره و سعادته، و أن أسعى بكل قواي من أجل تحقيق المثل العليا للعدالة و الحرية و السلم في العالم”."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_110_19761119_OpEnact_9a8ddc54ab> ;
    dzdoc:replacementText "يؤدي رئيس الجمهورية اليمين حسب النص الآتي : “وفاء للتضحيات الكبرى و لأرواح شهداء ثورتنا المقدسة أقسم بالله العلي العظيم أن أحترم الدين الإسلامي و أمجده ، و أن أحترم الميثاق الوطني و الدستور، و كل قوانين الجمهورية و أحميها ، و أن أحترم الإختيار الإشتراكي الذي لا رجعة فيه ، و أن أحافظ على سلامة التراب الوطني و حدة الشعب و الأمة ، و أن أحمي الحقوق و الحريات الأساسية للشعب و أعمل بدون هوادة على تطوره و سعادته، و أن أسعى بكل قواي من أجل تحقيق المثل العليا للعدالة و الحرية و السلم في العالم”."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_110> ;
