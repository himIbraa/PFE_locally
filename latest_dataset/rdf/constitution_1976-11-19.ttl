<https://legal.dz/resource/constitution/1976-11-19/1976#art_132_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_132> ;
    dzdoc:position 0 ;
