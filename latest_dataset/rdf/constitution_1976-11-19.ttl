<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_36> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المجموعات الإقليمية هي الولاية و البلدية . البلدية هي المجموعة الإقليمية السياسية و الإدارية و الاقتصادية و الاجتماعية و الثقافية في القاعدة. التنظيم الإقليمي و التقسيم الإداري للبلاد خاضعان للقانون."@ar ;
