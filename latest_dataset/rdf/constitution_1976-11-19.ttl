<https://legal.dz/resource/constitution/1976-11-19/1976#art_130_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_130> ;
    dzdoc:position 0 ;
    dzdoc:text "يحدد القانون طرق انتخاب النواب، و بخاصة عددهم، و شروط قابليتهم للانتخاب، و حالات التنافي مع شروط العضوية في المجلس."@ar .

