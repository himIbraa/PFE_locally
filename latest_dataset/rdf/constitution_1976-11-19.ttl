    dzdoc:position 1 ;
    dzdoc:text "يتم انتخاب المرشح بالأغلبية المطلقة من الناخبين المسجلين."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_105_para_2> a dzdoc:Paragraph ;
