<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_94> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم النظام التأسيسي الجزائري على مبدأ الحزب الواحد ."@ar ;
