<https://legal.dz/resource/constitution/1976-11-19/1976#art_95_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_95> ;
    dzdoc:position 1 ;
    dzdoc:text "جبهة التحرير الوطني هي الطليعة المؤلفة من المواطنين الأكثر وعيا، الذين تحدوهم المثل العليا للوطنية و الإشتراكية، و الذين يتحدون بكل حرية ضمنها، طبقا للشروط المنصوص عليها في القوانين الأساسية للحزب."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_95_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_95> ;
    dzdoc:position 2 ;
    dzdoc:text "مناضلو الحزب المختارون على الخصوص من بين العمال، و الفلاحين و الشباب، يصبون إلى تحقيق هدف واحد و إلى مواصلة عمل واحد غايته القصوى انتصار الإشتراكية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_96_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_96> ;
    dzdoc:position 0 ;
    dzdoc:text "مؤسسات الحزب و كيفية تسييرها محددة بالقوانين الأساسية لـ جبهة التحرير الوطني."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_97_obligation_0_a26221a4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/constitution/1976-11-19/1976#art_97_obligation_0_a26221a4_role_2c3fc592fb> ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_97> ;
    dznorm:position 0 ;
    dznorm:provisionText "تسهر جبهة التحرير الوطني على التعبئة الدائمة للشعب"@ar ;
    dznorm:sourceArticle "art_97" .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_97_obligation_0_a26221a4_role_2c3fc592fb> a dznorm:Role ;
    rdfs:label "التعبئة الدائمة للشعب"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "تسهر جبهة التحرير الوطني على التعبئة الدائمة للشعب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_97> .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_97_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_97> ;
    dzdoc:position 0 ;
    dzdoc:text "جبهة التحرير الوطني هي القوة الطلائعية لقيادة الشعب و تنظيمه من أجل تجسيم أهداف الثورة الاشتراكية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_97_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_97> ;
    dzdoc:position 1 ;
    dzdoc:text "تشكل جبهة التحرير الوطني دليل الثورة الإشتراكية و القوة المسيرة للمجتمع. و هي أداة الثورة الإشتراكية في مجالات القيادة و التخطيط و التنشيط."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_97_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_97> ;
    dzdoc:position 2 ;
    dzdoc:text "تسهر جبهة التحرير الوطني على التعبئة الدائمة للشعب، و ذلك بالتربية العقائدية للجماهير و تنظيمها و تأطيرها من أجل تشييد المجتمع الاشتراكي."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_98_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_98> ;
    dzdoc:position 0 ;
    dzdoc:text "تتجسد قيادة البلاد في وحدة القيادة السياسية للحزب و الدولة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_98_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_98> ;
    dzdoc:position 1 ;
    dzdoc:text "و في إطار هذه الوحدة، فإن قيادة الحزب هي التي توجه السياسة العامة للبلاد."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_99_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_99> ;
    dzdoc:position 0 ;
    dzdoc:text "ترتكز المؤسسات السياسية المنتخبة، في جميع المستويات، على مبدأ الجماعية في المداولة، و الأغلبية في القرار، و الوحدة في التنفيذ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_99_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_99> ;
    dzdoc:position 1 ;
    dzdoc:text "يتطلب تطبيق هذا المبدأ، على نطاق المؤسسات الحزبية، الوحدة في العقيدة و الإرادة، و الإنسجام في العمل."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_9_obligation_0_36cfc0e1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/constitution/1976-11-19/1976#art_9_obligation_0_36cfc0e1_action_c8157bd77d> ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_9> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب أن تتوفر في ممثلي الشعب مقاييس الكفاءة و النزاهة و الالتزام"@ar ;
    dznorm:sourceArticle "art_9" .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_9_obligation_0_36cfc0e1_action_c8157bd77d> a dznorm:Action ;
    rdfs:label "أن تتوفر في ممثلي الشعب"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب أن تتوفر في ممثلي الشعب مقاييس الكفاءة و النزاهة و الالتزام"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_9> .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_9_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_9> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب أن تتوفر في ممثلي الشعب مقاييس الكفاءة و النزاهة و الالتزام يتنافى تمثيل الشعب مع الثراء أو امتلاك مصالح مالية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#preamble_segment_2> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#preamble> ;
    dzdoc:position 2 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "لقد استعاد الشعب الجزائري استقلاله بعد كفاح طويل، و حرب تحريرية خاضها بقيادة جبهة التحرير الوطني و جيش التحرير الوطني، فكانت حربا ضارية سيخلدها التاريخ ملحمة من ملاحمه الكبرى التي ميزت انبعاث شعوب العالم الثالث. و منذ الاستقلال اندفع الشعب الجزائري بكل حزم، في بناء الدولة و تشييد مجتمع جديد، أساسه القضاء على استغلال الإنسان للإنسان، و غايته ازدهار شخصية الفرد و ترقية الجماهير الشعبية، في إطار الإختيار الإشتراكي."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#preamble_segment_3> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#preamble> ;
    dzdoc:position 3 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "إن المصادقة الشعبية على الميثاق الوطني في استفتاء 27 يونيو 1976، قد أتاحت من جديد، فرصة أخرى، للثورة الجزائرية كي تحدد مذهبها و ترسم استراتيجيتها على ضوء الإختيار الإشتراكي الذي لا رجعة فيه. و من هنا ينطلق الشعب الجزائري في مسيرته نحو الرقي، و هو يتصور بوضوح المجتمع الذي يعتزم تشييده."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#preamble_segment_4> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#preamble> ;
    dzdoc:position 4 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "و يمثل الدستور أحد الأهداف الكبرى المسطرة في الميثاق الوطني. فإعداده و تطبيقه استمرار و تتمة لذلك العمل الذي تواصل، دون كلل، منذ التصحيح التاريخي في 19 يونيو 1965، من أجل أن تقيم الأمة دولة منظمة على أساس عصري ديمقراطي، و في سبيل ترجمة الأفكار التقدمية إلى إنجازات ملموسة نطبع الحياة اليومية، و تدفع محتوى الثورة الشعبية، بما تخلقه من حركية في الفكر و العمل، نحو الإرتباط النهائي بالاشتراكية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#preamble_segment_5> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#preamble> ;
    dzdoc:position 5 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "و تقوم دعائم الدولة الجزائرية التي استعادت كامل سيادتها، على مشاركة الجماهير الشعبية في تسيير الشؤون العمومية و خوضها النضال من أجل التنمية التي تستهدف خلق القاعدة المادية للإشتراكية، بعد أن تم تحرير الإقتصاد الوطني من كل تسلط إمبريالي. و بهذا يعمل الشعب الجزائري في جميع الميادين، كل يوم أكثر، لتوسيع جبهة نضاله، و تعزيز مسيرته نحو الرقي الإقتصادي و الإجتماعي و الثقافي."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#preamble_segment_6> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#preamble> ;
    dzdoc:position 6 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "إن الجزائر تحتل اليوم مكانة بارزة على المستوى الدولي، بفضل الإشعاع العالمي لثورة فاتح نوفمبر 1954. و بفضل الإحترام الذي استطاعت بلادنا أن تكتسبه بوقوفها إلى جانب القضايا العادلة في العالم. كما أنها قد فرضت نفسها، بما بذلته، على المستوى الداخلي، من جهد جاد يتمثل في التنظيم و التنمية، ذلك الجهد الذي يتميز بتوخي العدالة في توزيع الدخل القومي و استخدامه، وبالسعي لترقية الجماهير التي عانت الاستغلال الإستعماري، و مظالم النظام الموروث عن الماضي، أكثر من غيرها."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#preamble_segment_7> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#preamble> ;
    dzdoc:position 7 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "إن تنظيم مؤتمر جبهة التحرير الوطني الذي سيحدد للحزب قوانينه الأساسية و يعطيه هيئاته القيادية، لتتويج لهذا الجهد المبذول من أجل إقامة مؤسسات للأمة “تخلد بعد الأحداث و زوال الرجال” كما جاء في بيان 19 يونيو 1965."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#preamble_segment_8> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#preamble> ;
    dzdoc:position 8 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "و هكذا يتم الوفاء، على أكمل وجه، بالعهد المشهود الذي أخذ أمام الشعب يوم 19 يونيو 1965، في ظل استمرار و توطيد المثل النبيلة التي كانت منذ البداية، محركا لثورة الأول من نوفمبر 1954 العظيمة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#preamble_segment_9> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#preamble> ;
    dzdoc:position 9 ;
    dzdoc:segmentType "formula" ;
    dzdoc:text "يمضي الدستور الآتي نصه"@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#preface> a dzdoc:Preface ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976> .

