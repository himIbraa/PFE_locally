<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_151> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يشرع المجلس الشعبي الوطني في المجالات التي خولها له الدستور. تدخل كذلك في مجال القانون : 1. الحقوق و الواجبات الأساسية للأفراد ، و بخاصة نظام الحريات العمومية و حماية الحريات الفردية و واجبات المواطنين في إطار متطلبات الدفاع الوطني . 2. القواعد العامة المتعلقة بقانون الأحوال الشخصية و قانون الأسرة، و بخاصة الزواج و الطلاق و البنوة و الأهلية و المواريث. 3. ظروف الإستقرار المتعلقة بالأفراد. 4. التشريع الأساسي الخاص بالجنسية. 1. القواعد العامة المتعلقة بمركز الأجانب. 5. القواعد العامة المتعلقة بالت"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_151_19761119_OpEnact_1c48ef2001> ;
    dzdoc:replacementText "يشرع المجلس الشعبي الوطني في المجالات التي خولها له الدستور. تدخل كذلك في مجال القانون : 1. الحقوق و الواجبات الأساسية للأفراد ، و بخاصة نظام الحريات العمومية و حماية الحريات الفردية و واجبات المواطنين في إطار متطلبات الدفاع الوطني . 2. القواعد العامة المتعلقة بقانون الأحوال الشخصية و قانون الأسرة، و بخاصة الزواج و الطلاق و البنوة و الأهلية و المواريث. 3. ظروف الإستقرار المتعلقة بالأفراد. 4. التشريع الأساسي الخاص بالجنسية. 1. القواعد العامة المتعلقة بمركز الأجانب. 5. القواعد العامة المتعلقة بالتنظيم القضائي. 6. القواعد العامة للقانون الجزائي و الإجراءات الجزائية و بخاصة تحديد الجنايات و الجنح، و العقوبات المناسبة لها، و العفو الشامل، و تسليم المجرمين. 7. القواعد العامة لقانون الإجراءات المدنية و طرق التنفيذ. 8. النظام العام للإلتزامات المدنية و التجارية. 9. القواعد العامة المتعلقة بنظام الإنتخابات. 10. التنظيم الإقليمي و التقسيم الإداري للبلاد. 11. المبادئ الأساسية للسياسة الإقتصادية و الإجتماعية. 12. تحديد سياسة التربية، و سياسة الشباب. 13. الخطوط الأساسية للسياسة الثقافية. 14. إقرار المخطط الوطني. 15. التصويت على ميزانية الدولة. 16. إحداث الضرائب و الجبايات و الرسوم و الحقوق بجميع أنواعها و تحديد وعائها و نسبها. 17. القواعد العامة للنظام الجمركي. 18. القواعد العامة المتعلقة بنظام البنوك و القرض و التأمين. 19. القواعد العامة المتعلقة بالصحة العمومية، و السكان، و قانون العمل و الضمان الإجتماعي. 20. القواعد العامة المتعلقة بحماية المجاهدين و أولي الحق من ذويهم. 21. الخطوط العريضة لسياسة الإعمار الإقليمي، و البيئة، و نوعية الحياة، و حماية الحيوانات و النباتات. 22. حماية التراث الثقافي و التاريخي و المحافظة عليه. 23. النظام العام للغابات. 24. النظام العام للمياه. 25. إنشاء أوسمة الدولة و نياشينها و وضع ألقابها الشرفية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_151> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_151> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

