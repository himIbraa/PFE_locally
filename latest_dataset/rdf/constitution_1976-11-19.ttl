<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_147> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن استدعاء المجلس الشعبي الوطني للاجتماع في دورة استثنائية بمبادرة من رئيس الجمهورية أو بطلب من ثلثي أعضاء المجلس . تختتم الدورة الإستثنائية بمجرد ما يستفيد المجلس الشعبي الوطني جدول الأعمال الذي استدعي من أجله."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
