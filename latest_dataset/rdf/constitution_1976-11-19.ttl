    dznorm:expressedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_101> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يمكن أن تتداخل اختصاصات كل منهما أو تختلط ببعضها"@ar ;
    dznorm:sourceArticle "art_101" .

