<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_27> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الدولة ديمقراطية في أهدافها و في تسييرها. إن المساهمة النشيطة للشعب في التشييد الاقتصادي و الاجتماعي و الثقافي، و في تسيير الإدارة و مراقبة الدولة، هي ضرورة تفرضها الثورة."@ar ;
