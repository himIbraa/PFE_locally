<https://legal.dz/resource/constitution/1976-11-19/1976#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "ليست وظائف الدولة امتيازا بل هي تكليف. على أعوان الدولة أن يأخذوا بعين الإعتبار مصالح الشعب و المنفعة العامة ليس غير ، و لا يمكن بحال من الأحوال، أن تصبح ممارسة الوظائف العمومية مصدرا للثراء، و لا وسيلة لخدمة المصالح الخاصة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1976-11-19/1976#art_37_permission_0_067eec93> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_37_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_37_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_37_19761119_OpEnact_6c9d35d28a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_37_obligation_0_5b0f87b8>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_37_obligation_1_46c7d816> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "37" ;
    dzdoc:position 36 .

