<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_150> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمجالس الشعبية البلدية و للمجالس الشعبية للولايات، أن ترفع إلتماسا إلى الحكومة التي يعود إليها النظر لصياغته في مشروع قانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_150_19761119_OpEnact_d1df1f2997> ;
