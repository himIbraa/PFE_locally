<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_122> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة وقوع عدوان فعلي أو وشيك الحصول، حسبما نصت عليه الترتيبات الملائمة لميثاق الأمم المتحدة ، يعلن رئيس الجمهورية الحرب، بعد استشارة هيأة الحزب القيادية و اجتماع الحكومة و الإستماع إلى المجلس الأعلى للأمن . يجتمع المجلس الشعبي الوطني ، بحكم القانون . يوجه رئيس الجمهورية خطابا للأمة يعلمها بذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_122_19761119_OpEnact_1c43a1e600> ;
