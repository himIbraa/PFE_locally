    dznorm:expressedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_29> .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_29_obligation_2_43150b7a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_29> ;
    dznorm:position 2 ;
    dznorm:provisionText "تنظم الدولة الإنتاج و تحدد توزيع الدخل القومي"@ar ;
    dznorm:sourceArticle "art_29" .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_29_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_29> ;
    dzdoc:position 0 ;
    dzdoc:text "تعمل الدولة على تغيير علاقات الإنتاج، و تسيير الإقتصاد الوطني، و تضمن تنمية على أساس تخطيط علمي المفهوم، ديمقراطي التصميم، حتمي التنفيذ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_29_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_29> ;
    dzdoc:position 1 ;
    dzdoc:text "تنظم الدولة الإنتاج و تحدد توزيع الدخل القومي، و هي العنصر الأساسي في تحويل الإقتصاد و مجموع العلاقات الإجتماعية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_2_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_2> ;
    dzdoc:position 0 ;
    dzdoc:text "الإسلام دين الدولة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_30_obligation_0_96188759> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
