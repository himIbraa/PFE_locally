<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_137> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الحصانة النيابية معترف بها للنائب أثناء نيابته . لا يمكن متابعة أي نائب أو إلقاء القبض عليه، و بصفة عامة، لا يمكن رفع دعوى مدنية أو جزائية ضده بسبب ما أبداه من آراء أو ما تلفظ به من كلام أو بسبب تصويته أثناء ممارسته للنيابة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_137_19761119_OpEnact_52a62f06f7> ;
    dzdoc:replacementText "الحصانة النيابية معترف بها للنائب أثناء نيابته . لا يمكن متابعة أي نائب أو إلقاء القبض عليه، و بصفة عامة، لا يمكن رفع دعوى مدنية أو جزائية ضده بسبب ما أبداه من آراء أو ما تلفظ به من كلام أو بسبب تصويته أثناء ممارسته للنيابة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
