<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_97> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "جبهة التحرير الوطني هي القوة الطلائعية لقيادة الشعب و تنظيمه من أجل تجسيم أهداف الثورة الاشتراكية. تشكل جبهة التحرير الوطني دليل الثورة الإشتراكية و القوة المسيرة للمجتمع. و هي أداة الثورة الإشتراكية في مجالات القيادة و التخطيط و التنشيط. تسهر جبهة التحرير الوطني على التعبئة الدائمة للشعب ، و ذلك بالتربية العقائدية للجماهير و تنظيمها و تأطيرها من أجل تشييد المجتمع الاشتراكي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_97_19761119_OpEnact_daefeb7dda> ;
    dzdoc:replacementText "جبهة التحرير الوطني هي القوة الطلائعية لقيادة الشعب و تنظيمه من أجل تجسيم أهداف الثورة الاشتراكية. تشكل جبهة التحرير الوطني دليل الثورة الإشتراكية و القوة المسيرة للمجتمع. و هي أداة الثورة الإشتراكية في مجالات القيادة و التخطيط و التنشيط. تسهر جبهة التحرير الوطني على التعبئة الدائمة للشعب ، و ذلك بالتربية العقائدية للجماهير و تنظيمها و تأطيرها من أجل تشييد المجتمع الاشتراكي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_97> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_97> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetScope "whole_article" ;
