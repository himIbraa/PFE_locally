    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_167> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يصدر القضاء أحكامه باسم الشعب."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_168_19761119_OpEnact_e1a2eee235> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_168> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_168> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_168> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "سلطة إصدار الأحكام من اختصاص القضاة ، و يمكن أن يعينهم في ذلك مساعدون شعبيون طبقا لأحكام القانون."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_169_19761119_OpEnact_b8ee182e17> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_169> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_169> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_169> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تخضع العقوبات الجزائية إلى مبدأي الشرعية و الشخصية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_16_19761119_OpEnact_634d7a6655> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_16> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_16> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_16> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "الملكية الفردية ذات الإستعمال الشخصي أو العائلي مضمونة . الملكية الخاصة غير الإستغلالية، كما يعرفها القانون، جزء لا يتجزأ من التنظيم الإجتماعي الجديد. الملكية الخاصة ، لا سيما في الميدان الإقتصادي، يجب أن تساهم في تنمية البلاد و أن تكون ذات منفعة اجتماعية . و هي مضمونة في إطار القانون. حق الإرث مضمون ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_170_19761119_OpEnact_d5311d3aa8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_170> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_170> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_170> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تعلل الأحكام القضائية و ينطق بها في الجلسات العلانية ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_171_19761119_OpEnact_fbd6eb59e0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_171> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_171> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_171> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "على كل أجهزة الدولة المختصة أن تقوم، في كل وقت و في كل مكان و في كل الظروف، بتنفيذ أحكام القضاء ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_172_19761119_OpEnact_99550249c3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_172> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_172> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_172> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لا يخضع القاضي إلا للقانون."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_173_19761119_OpEnact_4bde4ee55a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_173> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_173> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_173> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يساهم القاضي في الدفاع عن الثورة الاشتراكية و حمايتها. القاضي محمي من كل أشكال الضغوط و التدخلات و المناورات التي قد تضر بأداء مهمته أو تمس احترام نزاهته."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_174_19761119_OpEnact_2a606095ad> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_174> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_174> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_174> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "القاضي مسؤول أمام المجلس الأعلى للقضاء عن كيفية قيامه بمهمته، و ذلك حسب الأشكال المنصوص عليها في القانون."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_175_19761119_OpEnact_8b2b8b4272> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_175> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_175> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_175> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "القانون يحمي المتقاضي من أي تعسف أو أي انحراف قد يصدر عن القاضي ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_176_19761119_OpEnact_90a03778e0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_176> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_176> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_176> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "حق الدفاع معترف به . حق الدفاع مضمون في القضايا الجزائية ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_177_19761119_OpEnact_0469103b9c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_177> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_177> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_177> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يشكل المجلس الأعلى ، في جميع مجالات القانون الهيئة المقومة لأعمال المجالس القضائية و المحاكم. يضمن المجلس الأعلى توحيد الإجتهاد في العمل القضائي في جميع أنحاء البلاد و يسهر على احترام القانون."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_178_19761119_OpEnact_f028da3ad8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_178> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_178> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_178> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "ينظر المجلس الأعلى في قضايا الطعن في النصوص التنظيمية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_179_19761119_OpEnact_ca23326068> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_179> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_179> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_179> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يحدد القانون كيفية تنظيم المجلس الأعلى و طرق تسييره و مجالات صلاحياته."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_17_19761119_OpEnact_e08017da1e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_17> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_17> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_17> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لا يتم نزع الملكية إلا في إطار القانون . و يترتب عنه أداء تعويض عادل و منصف . لا تجوز معارضة إجراء نزع الملكية للصالح العام بحجة أية اتفاقية دولية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_180_19761119_OpEnact_dd7c6ffc22> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_180> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_180> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_180> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "مهمة المجلس الأعلى للقضاء تقديم الآراء إلى رئيس الجمهورية طبقا للأحكام و الحالات الواردة في المادة 182 من الدستور."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_181_19761119_OpEnact_57a2f6c75c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_181> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_181> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_181> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يرأس رئيس الجمهورية المجلس الأعلى للقضاء . يتولى وزير العدل نيابة رئاسة المجلس. يحدد القانون تأليف المجلس الأعلى للقضاء و طرق تسييره و صلاحياته الأخرى."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_182_19761119_OpEnact_230fea89bb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_182> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_182> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_182> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يبدي المجلس الأعلى للقضاء رأيا استشاريا قبل ممارسة رئيس الجمهورية حق العفو. يقر المجلس الأعلى للقضاء ، طبقا للأحكام التي يحددها القانون، تعيين القضاة و نقلهن و سير سلمهم الوظيفي، و يساهم في مراقبة انضباطهم."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_183_19761119_OpEnact_c4a4d6e1d2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_183> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_183> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_183> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "وظيفة المراقبة عامل رئيسي في مسيرة الثورة. و هي تندرج في التنظيم المنسجم الذي تتميز به الدولة الإشتراكية . و تمارس المراقبة في إطار منظم، و يترتب عنها الجزاء."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_184_19761119_OpEnact_c214e889fe> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_184> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_184> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_184> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تستهدف المراقبة ضمان تسيير حسن لأجهزة الدولة في نطاق احترام الميثاق الوطني و الدستور و قوانين البلاد. مهمة المراقبة هي التحري في الظروف التي يتم فيها استخدام و تسيير الوسائل البشرية و المادية من طرف الأجهزة الإدارية و الإقتصادية للدولة، و كذا تدارك النقص و التقصير و الإنحراف، و التمكين من قمع الإختلاس و كل الأعمال الإجرامية ضد الثورة الوطنية، و بالتالي ضمان تسيير البلاد في إطار النظام و الوضوح و المنطق. تستهدف المراقبة أخيرا، التحقق من التطابق بين أعمال الإدارة و التشريع و أوامر الدولة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_185_19761119_OpEnact_99f92e0c5e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_185> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_185> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_185> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تمارس المراقبة بواسطة مؤسسات وطنية ملائمة و بأجهزة دائمة للدولة. تتحقق المراقبة، في مدلولها الشعبي، و استجابة لمتطلبات الديمقراطية الإشتراكية ، من خلال المؤسسات المنتخبة على جميع المستويات : المجلس الشعبي الوطني ، المجالس الشعبية للولايات ، المجالس الشعبية للبلديات و مجالس العمال ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_186_19761119_OpEnact_5abf7cb54e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_186> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_186> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_186> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تمارس الأجهزة القيادية في الحزب و الدولة، المراقبة السياسية المنوطة بها ، و ذلك طبقا ل الميثاق الوطني و لأحكام الدستور . تمارس الأشكال الأخرى للمراقبة، على جميع المستويات و القطاعات في إطار الأحكام الخاصة بهذا الشأن و الواردة في الدستور و التشريع."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_187_19761119_OpEnact_08c9f1160e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_187> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_187> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_187> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تقدم الحكومة في نهاية كل سنة مالية، إلى المجلس الشعبي الوطني عرضا حول استعمال الاعتمادات المالية التي أقرها بالنسبة للسنة المالية المعنية . تختتم السنة المالية، على مستوى المجلس الشعبي الوطني بالتصويت على قانون يتحدد بمقتضاه ضبط ميزانية السنة المالية المنصرمة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_188_19761119_OpEnact_fa1a1e1955> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_188> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_188> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_188> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يمكن ل المجلس الشعبي الوطني ، في نطاق اختصاصاته، أن ينشئ، في أي وقت، لجنة تحقيق في أية قضية ذات مصلحة عامة . يعين المجلس الشعبي الوطني أعضاء لجنة التحقيق من النواب. يحدد القانون طرق تسيير هذه اللجنة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_189_19761119_OpEnact_bc5697c21c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_189> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_189> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_189> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يمكن ل المجلس الشعبي الوطني أن يراقب المؤسسات الاشتراكية بجميع أنواعها . يحدد القانون طرق ممارسة المراقبة و كذا الإجراءات التي قد تترتب عن نتائجها."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_18_19761119_OpEnact_47d561c04d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_18> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_18> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_18> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تشكل الثورة الثقافية و الثورة الزراعية و الثورة الصناعية ، و التوازن الجهوي ، و الأساليب الإشتراكية للتسيير ، المحاور الأساسية لبناء الإشتراكية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_190_19761119_OpEnact_7a6391c570> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_190> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_190> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_190> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يؤسس مجلس محاسبة مكلف بالمراقبة اللاحقة لجميع النفقات العمومية للدولة و الحزب و المجموعات المحلية و الجهوية و المؤسسات الاشتراكية بجميع أنواعها. يرفع مجلس المحاسبة تقريرا سنويا إلى رئيس الجمهورية . يحدد القانون قواعد تنظيم هذا المجلس و طرق تسييره و جزاء تحقيقاته."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_191_19761119_OpEnact_8411aeffa4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_191> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_191> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_191> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "ل رئيس الجمهورية حق المبادرة باقتراح تعديل الدستور في نطاق الأحكام الواردة في هذا الفصل."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_192_19761119_OpEnact_a8acbe82d4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_192> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_192> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_192> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يقر المجلس الشعبي الوطني مشروع قانون التعديل الدستوري بأغلبية ثلثي أعضائه ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_193_19761119_OpEnact_a10df8c24c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_193> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_193> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_193> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "إذا تعلق مشروع قانون التعديل بالأحكام الخاصة بتعديل الدستور ، فمن الضروري أن يتم الإقرار بأغلبية ثلاثة أرباع المجلس الشعبي الوطني . لا تسرى هذه الأحكام على المادة 195 من الدستور، التي لا تقبل أي تعديل."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_194_19761119_OpEnact_04013fb86a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_194> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_194> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_194> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لا يمكن الشروع في إجراء أي تعديل أو مواصلته، إذا ما كان هناك مساس بسلامة التراب الوطني ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_195_19761119_OpEnact_6bb4eea66a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_195> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_195> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_195> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لا يمكن لأي مشروع لتعديل الدستور أن يمس : بالصفة الجمهورية للحكم. بدين الدولة. بالإختيار الإشتراكي. بالحريات الأساسية للإنسان و المواطن. بمبدأ التصويت عن طريق الإقتراع العام المباشر و السري. بسلامة التراب الوطني."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_196_19761119_OpEnact_49a8f00f62> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_196> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_196> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_196> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يصدر رئيس الجمهورية القانون المتعلق بالتعديل الدستوري ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_197_19761119_OpEnact_839b594e22> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_197> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_197> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_197> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تتخذ الإجراءات التشريعية الضرورية تنصيب الهيئات المنصوص عليها في الدستور، بأوامر صادرة عن رئيس مجلس الثورة و رئيس مجلس الوزراء أثناء اجتماع ل مجلس الثورة و مجلس الوزراء ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_198_19761119_OpEnact_96933589c3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_198> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_198> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_198> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لا يمس سريان مفعول الدستور بسلطات الهيئات القائمة ما دامت المؤسسات المماثلة لها و المنصوص عليها في الدستور لم تنصب بعد ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_19_19761119_OpEnact_2cedc0182b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_19> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_19> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_19> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تستهدف الثورة الثقافية على الخصوص : أ) التأكيد على الشخصية الوطنية و تحقيق التطور الثقافي. ب) رفع مستوى التعليم و مستوى الكفاءة التقنية للأمة. ج) اعتماد أسلوب حياتي ينسجم مع الأخلاق الإسلامية و مبادئ الثورة الإشتراكية مثلما يحددها الميثاق الوطني. د) حفز الجماهير لتعبئها و تنظيمها للكفاح من أجل التطوير الاجتماعي و الاقتصادي للبلاد و الدفاع عن مكاسب الثورة الإشتراكية. ه) ضمان اكتساب وعي اجتماعي و القيام بعمل ملائم كفيل بتغييرالبنايات البالية و المجحفة في المجتمع. و) مكافحة الآفات الإجتماعية و مساوئ البيروقراطية. ز) القضاء على السلوك الإقطاعي، و الجهوية، و محاباة الأقارب، و كل الإنحرافات المضادة للثورة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_1_19761119_OpEnact_d33888bb26> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_1> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "الجزائر جمهورية ديمقراطية شعبية، و هي وحدة لا تتجزأ. الدولة الجزائرية دولة اشتراكية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_20_19761119_OpEnact_1fa9534ebb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_20> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_20> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_20> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تخلق الثورة الزراعية نموذجا جديدا لمجتمع ينبئ بجزائر تتطور كل جهاتها من مدن و أرياف، بكيفية منسجمة. تستهدف الثورة الزراعية : أ) تقويض الأركان المادية و المفاهيم المعادية للمجتمع، المتمثلة في استغلال الإنسان للإنسان. ب) تحطيم قيود النظام الإقتصادي البائد القائم على التعبئة و الإستغلال. ج) بناء العلاقات الإجتماعية في الوسط الريفي على قواعد جديدة. د) محو الفوارق بين المدن و الأرياف و خاصة ببناء القرى الإشتراكية. ه) جعل العمل المنتج قاعدة أساسية للنظام الإقتصادي و الإجتماعي في الأرياف."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_21_19761119_OpEnact_be486fb4d5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_21> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_21> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_21> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تستهدف الثورة الصناعية ، بالإضافة إلى الإنماء الإقتصادي، تغيير الإنسان و رفع مستواه التقني و العلمي و إعادة تشكيل بنية المجتمع و هي تعمل في نفس الوقت على تحويل وجه البلاد. تندرج الثورة الصناعية ضمن منظور اشتراكي يعطيها مدلولها العميق و أبعادها السياسية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_22_19761119_OpEnact_4ccebf181e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_22> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_22> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_22> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "سياسة التوازن الجهوي اختيار أساسي. و هي ترمي إلىمحو الفوارق الجهوية، و بالدرجة الأولى، إلى ترقية البلديات الأكثر حرمانا من أجل تأمين تنمية وطنية منسجمة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_23_19761119_OpEnact_3a4d0c2912> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_23> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_23> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_23> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تشكل الأساليب الاشتراكية لتسيير المؤسسات عاملا لترقية العمال. و هم يتحملون، بمساهمتهم في التسيير، مسئوليات حقيقية بوصفهم منتجين واعين حقوقهم و واجباتهم."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_24_19761119_OpEnact_10fac1ce99> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_24> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_24> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_24> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يرتكز المجتمع على العمل ، و ينبذ التطفل نبذا جذريا ، و يحكمه المبدأ الاشتراكي القائل : ” من كل حسب مقدرته و لكل حسب عمله”. العمل شرط أساسي لتنمية البلاد، و هو المصدر الذي يضمن به المواطن وسائل عيشه . يتم توظيف العمل حسب متطلبات الإقتصاد و المجتمع، و طبقا لاختيار العامل ، و بناء على قدراته و مؤهلاته."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_25_19761119_OpEnact_c939a6eaca> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_25> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_25> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_25> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تمارس سيادة الدولة الجزائرية على مجموع ترابها الوطني، و على مجالها الجوي، و على مياهها الإقليمية. كما تمارس سيادة الدولة على كل الوارد المختلفة الموجودة على كل سطح جرفها القاري أو في باطنه، و في منطقتها الإقتصادية الخاصة بها."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_26_19761119_OpEnact_499d0c4333> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_26> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_26> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_26> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تستمد الدولة سلطتها من الإرادة الشعبية. و هي في خدمة الشعب وحده. و تستمد علة وجودها، و فاعليتها من تقبل الشعب لها."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_27_19761119_OpEnact_73e2554565> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_27> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_27> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_27> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "الدولة ديمقراطية في أهدافها و في تسييرها. إن المساهمة النشيطة للشعب في التشييد الاقتصادي و الاجتماعي و الثقافي، و في تسيير الإدارة و مراقبة الدولة، هي ضرورة تفرضها الثورة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_28_19761119_OpEnact_76592764ab> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_28> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_28> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_28> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "هدف الدولة الإشتراكية الجزائرية هو التغيير الجذري للمجتمع، على أساس مبادئ التنظيم الإشتراكي."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_29_19761119_OpEnact_8472e376ba> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_29> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_29> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_29> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تعمل الدولة على تغيير علاقات الإنتاج، و تسيير الإقتصاد الوطني ، و تضمن تنمية على أساس تخطيط علمي المفهوم، ديمقراطي التصميم، حتمي التنفيذ . تنظم الدولة الإنتاج و تحدد توزيع الدخل القومي ، و هي العنصر الأساسي في تحويل الإقتصاد و مجموع العلاقات الإجتماعية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_2_19761119_OpEnact_ca82203a09> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_2> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "الإسلام دين الدولة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_30_19761119_OpEnact_33d9b4956b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_30> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_30> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_30> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يجب أن يضمن المخطط الوطني التنمية المتكاملة و المنسجمة لكل جهات البلاد و في كل قطاعات النشاط ، و يحقق استخداما فعالا لكل القوى المنتجة، و مزيدا للدخل القومي، و توزيعه توزيعا عادلا، و كذلك رفع مستوى حياة الشعب الجزائري."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_31_19761119_OpEnact_3fc2e184c8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_31> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_31> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_31> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يتم إعداد المخطط الوطني بكيفية ديمقراطية. يساهم الشعب في ذلك بواسطة مجالسه المنتخبة على المستوى البلدي و الولائي، و الوطني، و بواسطة مجالس العمال و المنظمات الجماهيرية. يخضع تطبيق المخطط الوطني لمبدأ اللامركزية مع مراعاة التنسيق المركزي على مستوى الهيئات العليا للحزب و الدولة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_32_19761119_OpEnact_6a94dafa82> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_32> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_32> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_32> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تنشئ الدولة، لتسيير ممتلكات المجموعة الوطنية، مؤسسات يتلاءم تطور نشاطها مع مصالح الشعب و أهداف المخطط الوطني. تحقق المؤسسات، طبقا لاتجاهات المخطط الوطني، تراكما ماليا لصالح الممتلكات الموضوعة تحت تصرفها، و لصالح المجموعة الوطنية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_33_19761119_OpEnact_d586c5df64> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_33> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_33> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_33> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "الدولة مسؤولة عن ظروف حياة كل مواطن . فهي تكفل استيفاء حاجياته المادية والمعنوية، وبخاصة متطلباته المتعلقة بالكرامة والأمن . وهي تستهدف تحرير المواطن من الإستغلال و البطالة و المرض و الجهل. تتكفل الدولة بحماية مواطنيها في الخارج ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_34_19761119_OpEnact_574edc2c48> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_34> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_34> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_34> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يستند تنظيم الدولة إلى مبدأ اللامركزية القائم على ديمقراطية المؤسسات و المشاركة الفعلية للجماهير الشعبية في تسيير الشؤون العمومية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_35_19761119_OpEnact_3ed154d0b6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_35> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_35> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_35> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تعتمد سياسة اللامركزية على توزيع حكيم للصلاحيات و المهام حسب تقسيم منطقي للمسئولية داخل إطار وحدة الدولة. تستهدف سياسة اللامركزية منح المجموعات الإقليمية الوسائل البشرية و المادية، و المسئولية التي تؤهلها للقيام بنفسها بمهام تنمية المنطقة التابعة لها كمجهود مكمل لما تقوم به الأمة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_36_19761119_OpEnact_5587f94d85> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_36> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_36> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_36> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "المجموعات الإقليمية هي الولاية و البلدية . البلدية هي المجموعة الإقليمية السياسية و الإدارية و الاقتصادية و الاجتماعية و الثقافية في القاعدة. التنظيم الإقليمي و التقسيم الإداري للبلاد خاضعان للقانون."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_37_19761119_OpEnact_6c9d35d28a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_37> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_37> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_37> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "ليست وظائف الدولة امتيازا بل هي تكليف. على أعوان الدولة أن يأخذوا بعين الإعتبار مصالح الشعب و المنفعة العامة ليس غير ، و لا يمكن بحال من الأحوال، أن تصبح ممارسة الوظائف العمومية مصدرا للثراء، و لا وسيلة لخدمة المصالح الخاصة ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_38_19761119_OpEnact_a34b1e95b8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_38> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_38> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_38> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تتاح المسئوليات في الدولة للمواطنين الذين تتوفر فيهم مقاييس الكفاءة و النزاهة و الإلتزام ، و يعيشون من أجرتهم ليس غير ، و لا يتعاطون، بصفة مباشرة أو عن طريق وسطاء، أي نشاط آخر يدر عليهم مالا ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_39_19761119_OpEnact_b48284c05a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_39> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_39> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_39> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تضمن الحريات الأساسية و حقوق الإنسان و المواطنين . كل المواطنين متساوون في الحقوق و الواجبات. يلغى كل تمييز قائم على أحكام مسبقة تتعلق بالجنس أو العرق أو الحرفة ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_3_19761119_OpEnact_090ef46bfd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_3> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_3> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_3> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "اللغة العربية هي اللغة الوطنية و الرسمية. تعمل الدولة على تعميم استعمال اللغة الوطنية في المجال الرسمي ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_40_19761119_OpEnact_c099ddc42a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_40> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_40> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_40> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "القانون واحد بالنسبة للجميع، أن يحمي أو يكره أو يعاقب."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_41_19761119_OpEnact_4019e8f257> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_41> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_41> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_41> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تكفل الدولة المساواة لكل المواطنين ، وذلك بإزالة العقبات ذات الطابع الإقتصادي و الإجتماعي و الثقافي التي تحد في الواقع من المساواة بين المواطني و تعق إزدهار الإنسان، و تحول دون المشاركة الفعلية لكل المواطنين في التنظيم السياسي، و الإقتصادي، و الإجتماعي، و الثقافي."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_42_19761119_OpEnact_94236eaac6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_42> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_42> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_42> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يضمن الدستور كل الحقوق السياسية و الإقتصادية والإجتماعية و الثقافية للمرأة الجزائرية ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_43_19761119_OpEnact_7a080ea3b0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_43> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_43> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_43> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "الجنسية الجزائرية معرفة بالقانون . شروط إكتساب هذه الجنسية والإحتفاظ بها أو فقدها أو إسقاطها، محددة بالقانون."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_44_19761119_OpEnact_f36713b018> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_44> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_44> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_44> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "وظائف الدولة و المؤسسات التابعة لها متاحة لكل المواطنين ، و هي في متناولهم بالتساوي و بدون أي شرط ماعدا الشروط المتعلقة بالإستحقاق و الأهلية ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_45_19761119_OpEnact_86f8a83494> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_45> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_45> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_45> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لا تجريم إلا بقانون صادر قبل ارتكاب العمل الإجرامي."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_46_19761119_OpEnact_c58497252b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_46> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_46> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_46> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "كل فرد يعتبر بريئا، في نظر القانون، حتى يثبت القضاء إدانته طبقا للضمانات التي يفرضها القانون."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_47_19761119_OpEnact_c0dc500e05> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_47> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_47> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_47> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يترتب عن الخطأ القضائي تعويض من الدولة . يحدد القانون ظروف التعويض و كيفيته."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_48_19761119_OpEnact_f52eebd7eb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_48> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_48> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_48> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تضمن الدولة حصانة الفرد ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_49_19761119_OpEnact_24974c0a54> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_49> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_49> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_49> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لا يجوز انتهاك حرمة حياة المواطن الخاصة و لا شرفه ، و القانون يصونهما. سرية المراسلات و المواصلات الخاصة بكل إشكالها مضمونة ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_4_19761119_OpEnact_168da39aa5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_4> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_4> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_4> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "عاصمة الجمهورية مدينة الجزائر. النشيد الوطني و خاصيات العلم و خاتم الدولة، يحددها القانون."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_50_19761119_OpEnact_9e846e6801> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_50> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_50> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_50> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تضمن الدولة حرمة السكن . لا تفتيش إلا بمقتضى القانون و في حدوده . لا تفتيش إلا بأمر مكتوب صادر عن السلطة القضائية المختصة ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_51_19761119_OpEnact_7e728c1136> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_51> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_51> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_51> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لا يتابع أحد و لا يلقى عليه القبض أو يحبس إلا في الحالات المحددة بالقانون و طبقا للإشكال التي نص عليها ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_52_19761119_OpEnact_9ca6763a03> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_52> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_52> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_52> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "في مادة التحريات الجزائية، لا يمكن أن تتجاوز مدة التوقيف للنظر 48 ساعة . لا يمكن تمديد مدة التوقيف للنظر إلا بصفة استثنائية و وفقا للشروط المحددة بالقانون . عند انتهاء مدة التوقيف للنظر يلزم إجراء فحص طبي على الشخص الموقوف إن طلب ذلك ، على أن يعلم بإمكانية هذا الإجراء."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_53_19761119_OpEnact_9b3b4e07b8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_53> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_53> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_53> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لا مساس بحرية المعتقد و لا بحرية الرأي ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_54_19761119_OpEnact_7dec0e87d3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_54> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_54> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_54> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "حرية الإبتكار الفكري و الفني و العلمي للمواطن مضمونة في إطار القانون. حرية التأليف محمية بالقانون ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_55_19761119_OpEnact_c123beed0a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_55> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_55> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_55> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "حرية التعبير والإجتماع مضمونة ، و لا يمكن التذرع بها لضرب أسس الثورة الإشتراكية. تمارس هذه الحرية مع مراعاة أحكام المادة 73 من الدستور."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_56_19761119_OpEnact_0638def444> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_56> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_56> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_56> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "حرية إنشاء الجمعيات معترف بها ، و تمارس في إطار القانون."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_57_19761119_OpEnact_a16b9eecbd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_57> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_57> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_57> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لكل مواطن يتمتع بكامل حقوقه المدنية و السياسية ، حق التنقل بكل حرية في أي ناحية من التراب الوطني . حق الخروج من التراب الوطني مضمون في نطاق القانون."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_58_19761119_OpEnact_2361b2340e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_58> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_58> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_58> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يعد كل مواطن تتوفر في الشروط القانونية ، ناخبا و قابلا للإتخاب عليه ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_59_19761119_OpEnact_325354ae0d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_59> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_59> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_59> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "حق العمل مضمون طبقا لـ المادة 24 من الدستور. يمارس العامل وظيفته الإنتاجية باعتبارها واجبا و شرفا . الحق في أخذ حصة من الدخل القومي مرهون بإلزامية العمل . تخضع الأجور للمبدأ القائل : ” التساوي في العمل يستلزم التساوي في الأجر” ، و تحدد طبقا لنوعية العمل المنجز فعلا و لحجمه. السعي وراء تحسين الإنتاجية هدف دائم للمجتمع الإشتراكي. يمكن أن يتم التشجيع على العمل و الإنتاجية بواسطة حوافز معنوية، و بنظام ملائم قائم على الترغيب المادي، سواء على المستوى الجماعي أو الفردي."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_5_19761119_OpEnact_63385871b3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_5> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_5> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_5> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "السيادة الوطنية ملك للشعب، يمارسها عن طريق الإستفتاء أو بواسطة ممثليه المنتخبين."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_60_19761119_OpEnact_7495e3409c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_60> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_60> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_60> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "حق الإنخراط في النقابة معترف به لجميع العمال ، و يمارس في إطار القانون."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_61_19761119_OpEnact_4e07be2c00> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_61> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_61> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_61> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تخضع علاقات العمل في القطاع الإشتراكي لأحكام القوانين و التنظيمات المتعلقة بالأساليب الاشتراكية للتسيير . في القطاع الخاص، حق الإضراب معترف به ، و ينظم القانون ممارسته."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_62_19761119_OpEnact_31e2f236c4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_62> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_62> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_62> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تضمن الدولة أثناء العمل الحق في الحماية، و الأمن و الوقاية الصحية ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_63_19761119_OpEnact_83e033a2fe> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_63> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_63> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_63> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "الحق في الراحة مضمون . يحدد القانون كيفية ممارسته."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_64_19761119_OpEnact_0af5939bd1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_64> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_64> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_64> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تكفل الدولة، في نطاق القانون، ظروف معيشة المواطنين الذين لم يبلغوا بعد سن العمل و الذين لا يستطيعون القيام به، و الذين عجزوا عنه نهائيا ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_65_19761119_OpEnact_e513ad7ddd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_65> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_65> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_65> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "الأسرة هي الخلية الأساسية للمجتمع، و تحظى بحماية الدولة و المجتمع. تحمي الدولة الأمومة، و الطفولة، و الشبيبة، و الشيخوخة، بواسطة سياسة و مؤسسات ملائمة ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_66_19761119_OpEnact_267f9f4d64> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_66> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_66> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_66> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لكل مواطن الحق في التعلم . التعليم مجاني و هو إجباري بالنسبة لمدة المدرسة الأساسية في إطار الشروط المحددة بالقانون. تضمن الدولة التطبيق المتساوي لحق التعليم . تنظم الدولة التعليم . تسهر الدولة على أن تكون أبواب التعليم و التكوين المهني و الثقافة مفتوحة بالتساوي أمام الجميع ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_67_19761119_OpEnact_a8f5a8ebb8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_67> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_67> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_67> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لكل المواطنين الحق في الرعاية الصحية . و هذا الحق مضمون عن طريق توفير خدمات صحية عامة و مجانية، و بتوسيع مجال الطب الوقائي، و التحسين الدائم لظروف العيش و العمل، و كذلك عن طريق ترقية التربية البدنية و الرياضية و وسائل الترفيه."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_68_19761119_OpEnact_365bbba165> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_68> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_68> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_68> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يحظى كل أجنبي يقيم بصفة قانونية على التراب الوطني، بالحماية المخولة للأفراد و الأموال ، طبقا للقانون و مراعاة لتقاليد الشعب الجزائري في الضيافة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_69_19761119_OpEnact_8eaeb1aab3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_69> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_69> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_69> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لا يسلم أحد خارج التراب الوطني إلا بناء على قانون تسليم المجرمين وتطبيقا لأحكامه ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_6_19761119_OpEnact_dabda9be63> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
