<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_124> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوافق رئيس الجمهورية على الهدنة و السلم. تقدم اتفاقيات الهدنة و معاهدات السلم، فورا، إلى الموافقة الصريحة للهيئة القيادية للحزب طبقا لقانونه الأساسي . كما تعرض على المجلس الشعبي الوطني ، طبقا لأحكام المادة 158 من الدستور ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_124_19761119_OpEnact_dabf8c86d0> ;
