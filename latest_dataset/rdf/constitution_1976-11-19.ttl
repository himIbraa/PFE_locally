<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_12> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ترمي الإشتراكية إلى تحقيق أهداف ثلاثة : دعم الاستقلال الوطني . إقامة مجتمع متحرر من استغلال الإنسان للإنسان. ترقية الإنسان و توفير أسباب تفتح شخصيته و ازدهارها. و تعود إلى مؤسسات الحزب و الدولة مهمة تحقيق هذه الأهداف المتكاملة المتلازمة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_12_19761119_OpEnact_8bc06bb952> ;
    dzdoc:replacementText "ترمي الإشتراكية إلى تحقيق أهداف ثلاثة : دعم الاستقلال الوطني . إقامة مجتمع متحرر من استغلال الإنسان للإنسان. ترقية الإنسان و توفير أسباب تفتح شخصيته و ازدهارها. و تعود إلى مؤسسات الحزب و الدولة مهمة تحقيق هذه الأهداف المتكاملة المتلازمة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_12> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
