<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_78> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل المواطنين متساوون في أداء الضريبة. و على كل واحد أن يساهم، حسب إمكانياته، و في إطار القانون، في النفقات العمومية، لسد الحاجيات الإجتماعية للشعب و لتنمية البلاد و الحفاظ على أمنها . لا يجوز إحداث أية ضريبة، أو جباية، أو رسم أو أي حق، بأثر رجعي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
