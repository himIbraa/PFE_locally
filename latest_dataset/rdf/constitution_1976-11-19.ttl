dzterm:apn a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المجلس الشعبي الوطني"@ar,
        "للمجلس الشعبي الوطني"@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_118> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_118" ;
    dzdoc:fullText "لا يمكن حل أو تعديل الحكومة القائمة إبان وفاة أو استقالة رئيس الجمهورية إلى أن يتسلم رئيس الجمهورية الجديد مهامه . لا يمكن أثناء فترة الخمسة و الأربعين يوما ( 45 ) المشار إليها في الفقرة الثانية من المادة 117 من الدستور، تطبيق أحكام المادتين 112 و 113 و لا أحكام الفقرات 7 و 13 و 14 من المادة 111 و لا أحكام المادتين 123 و 163 من الدستور . لا يمكن أثناء نفس الفترة، إنهاء مهام نائب رئيس الجمهورية و الوزير الأول . كما لا يمكن تطبيق أحكام المواد 120 و 121 و 122 و 124 من الدستور إلا بموافقة المجلس الشعبي الوطني مع الاستشارة المسبقة لقيادة الحزب ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1976-11-19/1976#art_118_permission_0_b698ca44>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_118_permission_1_c540d920>,
