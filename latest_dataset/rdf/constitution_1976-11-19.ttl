<https://legal.dz/resource/constitution/1976-11-19/1976#art_124_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_124> ;
    dzdoc:position 0 ;
    dzdoc:text "يوافق رئيس الجمهورية على الهدنة و السلم."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_124_para_1> a dzdoc:Paragraph ;
