    dznorm:sourceArticle "art_156" .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_156_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_156> ;
    dzdoc:position 0 ;
    dzdoc:text "يوجه رئيس الجمهورية، مرة في السنة، خطابا إلى المجلس الشعبي الوطني، حول وضع الأمة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_157_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_157> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن لـ المجلس الشعبي الوطني، بطلب من رئيس الجمهورية، أو من رئيسه، أن يفتح مناقشة حول السياسة الخارجية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_157_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_157> ;
    dzdoc:position 1 ;
