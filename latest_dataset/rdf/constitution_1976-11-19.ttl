<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_99> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ترتكز المؤسسات السياسية المنتخبة، في جميع المستويات، على مبدأ الجماعية في المداولة، و الأغلبية في القرار، و الوحدة في التنفيذ. يتطلب تطبيق هذا المبدأ، على نطاق المؤسسات الحزبية، الوحدة في العقيدة و الإرادة، و الإنسجام في العمل."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_99_19761119_OpEnact_8fc2c1f2f1> ;
    dzdoc:replacementText "ترتكز المؤسسات السياسية المنتخبة، في جميع المستويات، على مبدأ الجماعية في المداولة، و الأغلبية في القرار، و الوحدة في التنفيذ. يتطلب تطبيق هذا المبدأ، على نطاق المؤسسات الحزبية، الوحدة في العقيدة و الإرادة، و الإنسجام في العمل."@ar ;
