dzorg:الجريدة_الرسمية a dzdoc:Organization ;
    rdfs:label "الجريدة الرسمية"@ar ;
    dzdoc:frbrUri "/ontology/organization/dz/joradp"^^xsd:anyURI .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_100_obligation_0_ac2d9f87> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_100> ;
    dznorm:position 0 ;
    dznorm:provisionText "مكلفة بتعبئة أوسع فئات الشعب لتحقيق كبريات المهام السياسية و الإقتصادية و الإجتماعية و الثقافية"@ar ;
    dznorm:sourceArticle "art_100" .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_100_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_100> ;
    dzdoc:position 0 ;
    dzdoc:text "المنظمات الجماهيرية، بإشراف الحزب و مراقبته، مكلفة بتعبئة أوسع فئات الشعب لتحقيق كبريات المهام السياسية و الإقتصادية و الإجتماعية و الثقافية التي تتوقف عليها تنمية البلاد و النجاح في بناء الإشتراكية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_100_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_100> ;
    dzdoc:position 1 ;
    dzdoc:text "المنظمات الجماهيرية مكلفة، دون غيرها، بمهمة تنظيم العمال و الفلاحين و الشباب و النساء، و العمل على تعميق وعيهم لمسئولياتهم و للدور المتعاظم الذي يجب أن يضطلعوا به في بناء الوطن."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_101_obligation_0_dc50485b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
