<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_87> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تندرج وحدة الشعوب العربية في وحدة مصير هذه الشعوب. تلتزم الجزائر، كلما تهيأت الظروف الملائمة لقيام وحدة مبنية على تحرير الجماهير الشعبية ، باعتماد صيغ للوحدة أو للإتحاد أو للإندماج، كفيلة بالتلبية الكاملة للمطامح المشروعة و العميقة للشعوب العربية . وحدة الشعوب المغربية المستهدفة صالح الجماهير الشعبية، تتجسد كاختيار أساسي للثورة الجزائرية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_87_19761119_OpEnact_92565a3582> ;
    dzdoc:replacementText "تندرج وحدة الشعوب العربية في وحدة مصير هذه الشعوب. تلتزم الجزائر، كلما تهيأت الظروف الملائمة لقيام وحدة مبنية على تحرير الجماهير الشعبية ، باعتماد صيغ للوحدة أو للإتحاد أو للإندماج، كفيلة بالتلبية الكاملة للمطامح المشروعة و العميقة للشعوب العربية . وحدة الشعوب المغربية المستهدفة صالح الجماهير الشعبية، تتجسد كاختيار أساسي للثورة الجزائرية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_87> ;
