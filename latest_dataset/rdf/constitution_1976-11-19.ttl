        dzterm:national_charter .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_190> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الخامس_وظيفة_المراقبة> ;
    dzdoc:eId "art_190" ;
    dzdoc:fullText "يؤسس مجلس محاسبة مكلف بالمراقبة اللاحقة لجميع النفقات العمومية للدولة و الحزب و المجموعات المحلية و الجهوية و المؤسسات الاشتراكية بجميع أنواعها. يرفع مجلس المحاسبة تقريرا سنويا إلى رئيس الجمهورية . يحدد القانون قواعد تنظيم هذا المجلس و طرق تسييره و جزاء تحقيقاته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_190> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_190_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_190_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_190_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_190_19761119_OpEnact_7a6391c570> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_190_obligation_0_29ae6b76> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 190" ;
    dzdoc:position 189 ;
    dzdoc:usesTerm dzterm:court_of_audits .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_194> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_السادس_الوظيفة_التأسيسية> ;
    dzdoc:eId "art_194" ;
    dzdoc:fullText "لا يمكن الشروع في إجراء أي تعديل أو مواصلته، إذا ما كان هناك مساس بسلامة التراب الوطني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1976-11-19/1976#art_194_permission_0_0ef7d6ca> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_194> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_194_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_194_19761119_OpEnact_04013fb86a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 194" ;
    dzdoc:position 193 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1976-11-19/1976#art_194_condition_0_9bb2b50a> .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الأول_الجمهورية> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "اللغة العربية هي اللغة الوطنية و الرسمية. تعمل الدولة على تعميم استعمال اللغة الوطنية في المجال الرسمي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_3_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_3_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_3_19761119_OpEnact_090ef46bfd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_3_obligation_0_4dc24266> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "3" ;
    dzdoc:position 2 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_54> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_54" ;
    dzdoc:fullText "حرية الإبتكار الفكري و الفني و العلمي للمواطن مضمونة في إطار القانون. حرية التأليف محمية بالقانون ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_54_right_0_822afd9a>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_54_right_1_5b6fe4e3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_54> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_54_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_54_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_54_19761119_OpEnact_7dec0e87d3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 54" ;
    dzdoc:position 53 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_61> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_61" ;
    dzdoc:fullText "تخضع علاقات العمل في القطاع الإشتراكي لأحكام القوانين و التنظيمات المتعلقة بالأساليب الاشتراكية للتسيير . في القطاع الخاص، حق الإضراب معترف به ، و ينظم القانون ممارسته."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_61_right_0_b6526cd1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_61> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_61_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_61_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_61_19761119_OpEnact_4e07be2c00> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_61_obligation_0_04f08b8c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 61" ;
    dzdoc:position 60 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_71> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_71" ;
    dzdoc:fullText "يعاقب القانون على المخالفات المرتكبة ضد الحقوق و الحريات و على كل مساس بالسلامة البدنية أو المعنوية للإنسان ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_71> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_71_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_71_19761119_OpEnact_2f60b59d04> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_71_obligation_0_b77dc437> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 71" ;
    dzdoc:position 70 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_73> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_73" ;
    dzdoc:fullText "يحدد القانون شروط إسقاط الحقوق و الحريات الأساسية لكل من يستعملها قصد المساس بالدستور أو بالمصالح الرئيسية للمجموعة الوطنية، أو بوحدة الشعب و التراب الوطني، أو بالأمن الداخلي و الخارجي للدولة، أو بالثورة الإشتراكية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_73> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_73_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_73_19761119_OpEnact_57cae7eca4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 73" ;
    dzdoc:position 72 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1976-11-19/1976#art_73_condition_0_a506aa33> .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_74> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الخامس_واجبات_المواطن> ;
    dzdoc:eId "art_74" ;
    dzdoc:fullText "على كل شخص احترام الدستور، والإمتثال لقوانين الجمهورية و تنظيماتها . لا يعذر أحد بجهل القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_74> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_74_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_74_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_74_19761119_OpEnact_dc60d94c09> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_74_obligation_0_ec498c21> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 74" ;
    dzdoc:position 73 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_75> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الخامس_واجبات_المواطن> ;
    dzdoc:eId "art_75" ;
    dzdoc:fullText "يجب على كل مواطن أن يحمي، بعمله و سلوكه، الملكية العمومية و مصالح المجموعة الوطنية، و يحترم مكتسبات الثورة الإشتراكية، و يعمل حسب مقدرته لرفع مستوى معيشة الشعب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_75> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_75_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_75_19761119_OpEnact_51ab704388> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_75_obligation_0_940ebdf9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 75" ;
    dzdoc:position 74 ;
    dzdoc:usesTerm dzterm:public_property .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الخامس_واجبات_المواطن> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "على كل مواطن حماية و صيانة إستقلال الوطن و سيادته و سلامة ترابه . يعاقب القانون بكل صرامة، على الخيانة و التجسس و الإلتحاق بالعدو، و على كل الجرائم المرتكبة ضد أمن الدولة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_77_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_77_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_77_19761119_OpEnact_99862b22fb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_77_obligation_0_8f692a68> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 77" ;
    dzdoc:position 76 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_82> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_السادس_الجيش_الوطني_الشعبي> ;
    dzdoc:eId "art_82" ;
    dzdoc:fullText "تتمثل المهمة الدائمة للجيش الوطني الشعبي ، سليل جيش التحرير الوطني و درع الثورة، في المحافظة على استقلال الوطن و سيادته، و القيام بتأمين الدفاع عن الوحدة الترابية للبلاد و سلامتها، و حماية مجالها الجوي و مساحتها الترابية و مياهها الإقليمية و جرفها القاري و منطقتها الإقتصادية الخاصة بها . يساهم الجيش الوطني الشعبي ، باعتباره أداة الثورة في تنمية البلاد و تشييد الإشتراكية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_82> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_82_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_82_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_82_19761119_OpEnact_ce199d633c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_82_obligation_0_08eb2474> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 82" ;
    dzdoc:position 81 ;
    dzdoc:usesTerm dzterm:anp .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_89> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_السابع_مبادئ_السياسة_الخارجية> ;
    dzdoc:eId "art_89" ;
    dzdoc:fullText "تمتنع الجمهورية الجزائرية ، طبقا لمواثيق الأمم المتحدة و منظمة الوحدة الإفريقية و الجامعة العربية، عن الإلتجاء إلى الحرب قصد المساس بالسيادة المشروعة للشعوب الأخرى و حريتها . و تبذل جهدها لحل النزاعات الدولية بالطرق السلمية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_89> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_89_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_89_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_89_19761119_OpEnact_9f44d432df> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_89_obligation_0_9149a307>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_89_obligation_1_10c49b6c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 89" ;
    dzdoc:position 88 ;
    dzdoc:usesTerm dzterm:republic .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_95> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الأول_الوظيفة_السياسية> ;
    dzdoc:eId "art_95" ;
    dzdoc:fullText "جبهة التحرير الوطني هي الحزب الواحد في البلاد. جبهة التحرير الوطني هي الطليعة المؤلفة من المواطنين الأكثر وعيا، الذين تحدوهم المثل العليا للوطنية و الإشتراكية، و الذين يتحدون بكل حرية ضمنها، طبقا للشروط المنصوص عليها في القوانين الأساسية للحزب . مناضلو الحزب المختارون على الخصوص من بين العمال، و الفلاحين و الشباب، يصبون إلى تحقيق هدف واحد و إلى مواصلة عمل واحد غايته القصوى انتصار الإشتراكية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_95> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_95_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_95_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_95_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
