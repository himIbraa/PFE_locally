        dzterm:president .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "لا يجوز انتهاك حرمة حياة المواطن الخاصة و لا شرفه ، و القانون يصونهما. سرية المراسلات و المواصلات الخاصة بكل إشكالها مضمونة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1976-11-19/1976#art_49_permission_0_e2338461> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_49_right_0_9c4fcf62> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_49_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_49_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_49_19761119_OpEnact_24974c0a54> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_49_obligation_0_850d2139> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1976-11-19/1976#art_49_prohibition_0_e2338461> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 49" ;
    dzdoc:position 48 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الخامس_واجبات_المواطن> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "كل المواطنين متساوون في أداء الضريبة. و على كل واحد أن يساهم، حسب إمكانياته، و في إطار القانون، في النفقات العمومية، لسد الحاجيات الإجتماعية للشعب و لتنمية البلاد و الحفاظ على أمنها . لا يجوز إحداث أية ضريبة، أو جباية، أو رسم أو أي حق، بأثر رجعي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1976-11-19/1976#art_78_permission_0_31a8c877> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_78> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_78_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_78_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_78_19761119_OpEnact_386a6f74a5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_78_obligation_0_fe587652> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1976-11-19/1976#art_78_prohibition_0_31a8c877> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 78" ;
    dzdoc:position 77 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:definesTerm dzterm:worker ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الأول_الجمهورية> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "تمثل المجالس الشعبية المنتخبة، بحكم محتواها البشري، القوى الاجتماعية للثورة. تتكون الأغلبية، ضمن المجالس الشعبية المنتخبة، من العمال و الفلاحين يعتبر عاملا كل شخص يعيش من حاصل عمله اليدوي أو الفكري و لا يستخدم لمصلحته الخاصة غيره من العمال أثناء ممارسة نشاطه المهني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_8> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1976-11-19/1976#art_8_defocc_52f1afb8602d> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_8_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_8_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_8_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_8_19761119_OpEnact_ade67584b6> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "8" ;
    dzdoc:position 7 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "يؤدي رئيس الجمهورية اليمين حسب النص الآتي : “وفاء للتضحيات الكبرى و لأرواح شهداء ثورتنا المقدسة أقسم بالله العلي العظيم أن أحترم الدين الإسلامي و أمجده ، و أن أحترم الميثاق الوطني و الدستور، و كل قوانين الجمهورية و أحميها ، و أن أحترم الإختيار الإشتراكي الذي لا رجعة فيه ، و أن أحافظ على سلامة التراب الوطني و حدة الشعب و الأمة ، و أن أحمي الحقوق و الحريات الأساسية للشعب و أعمل بدون هوادة على تطوره و سعادته، و أن أسعى بكل قواي من أجل تحقيق المثل العليا للعدالة و الحرية و السلم في العالم”."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_110_right_0_f30f9b9e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_110_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_110_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_110_19761119_OpEnact_9a8ddc54ab> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_110_obligation_0_de868340>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_110_obligation_1_a277d5ce>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_110_obligation_2_d49fae5c>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_110_obligation_3_083a6f0f>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_110_obligation_4_872c3b10>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_110_obligation_5_bc7ca90f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 110" ;
    dzdoc:position 109 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_122> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_122" ;
    dzdoc:fullText "في حالة وقوع عدوان فعلي أو وشيك الحصول، حسبما نصت عليه الترتيبات الملائمة لميثاق الأمم المتحدة ، يعلن رئيس الجمهورية الحرب، بعد استشارة هيأة الحزب القيادية و اجتماع الحكومة و الإستماع إلى المجلس الأعلى للأمن . يجتمع المجلس الشعبي الوطني ، بحكم القانون . يوجه رئيس الجمهورية خطابا للأمة يعلمها بذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_122> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_122_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_122_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_122_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_122_19761119_OpEnact_1c43a1e600> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_122_obligation_0_de4a1323> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "122" ;
    dzdoc:position 121 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1976-11-19/1976#art_122_condition_0_ad749e22> ;
    dzdoc:usesTerm dzterm:government,
        dzterm:national_assembly,
        dzterm:president,
        dzterm:security_council .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_161> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_في_النزاع_الناشئ_عن_الإنتخابات_التشريعية_من_اختصاص_المجلس_الأعلى> ;
    dzdoc:eId "art_161" ;
    dzdoc:fullText "يمكن لأعضاء المجلس الشعبي الوطني استجواب الحكومة حول قضايا الساعة . يمكن للجان المجلس الشعبي الوطني أن تستمع إلى أعضاء الحكومة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1976-11-19/1976#art_161_permission_0_5844f5e7>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_161_permission_1_58d0ef86> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_161_right_0_47eb93b4>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_161_right_1_8913073f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_161> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_161_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_161_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_161_19761119_OpEnact_c597aa2ce3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 161" ;
    dzdoc:position 160 ;
    dzdoc:usesTerm dzterm:apn .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الثاني_الإشتراكية> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "يرتكز المجتمع على العمل ، و ينبذ التطفل نبذا جذريا ، و يحكمه المبدأ الاشتراكي القائل : ” من كل حسب مقدرته و لكل حسب عمله”. العمل شرط أساسي لتنمية البلاد، و هو المصدر الذي يضمن به المواطن وسائل عيشه . يتم توظيف العمل حسب متطلبات الإقتصاد و المجتمع، و طبقا لاختيار العامل ، و بناء على قدراته و مؤهلاته."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_24_right_0_26736212>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_24_right_1_a6772c9f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_24_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_24_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_24_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_24_19761119_OpEnact_10fac1ce99> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_24_obligation_0_a55f459c>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_24_obligation_1_7836cf3e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 24" ;
    dzdoc:position 23 ;
    dzdoc:usesTerm dzterm:work .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_66> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_66" ;
    dzdoc:fullText "لكل مواطن الحق في التعلم . التعليم مجاني و هو إجباري بالنسبة لمدة المدرسة الأساسية في إطار الشروط المحددة بالقانون. تضمن الدولة التطبيق المتساوي لحق التعليم . تنظم الدولة التعليم . تسهر الدولة على أن تكون أبواب التعليم و التكوين المهني و الثقافة مفتوحة بالتساوي أمام الجميع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_66_right_0_c6e19509>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_66_right_1_76460077> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_66> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_66_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_66_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_66_19761119_OpEnact_267f9f4d64> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_66_obligation_0_d8c1c3f6>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_66_obligation_1_1cfb7b0d>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_66_obligation_2_b2017c88>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_66_obligation_3_9ec5fad0> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 66" ;
    dzdoc:position 65 .

