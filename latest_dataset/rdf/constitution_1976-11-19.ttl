<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_157> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن لـ المجلس الشعبي الوطني ، بطلب من رئيس الجمهورية ، أو من رئيسه، أن يفتح مناقشة حول السياسة الخارجية . يمكن، عند اقتضاء، أن تفضي هذه المناقشة إلى إصدار لائحة من المجلس الشعبي الوطني تبلغ بواسطة رئيسه إلى رئيس الجمهورية ."@ar ;
