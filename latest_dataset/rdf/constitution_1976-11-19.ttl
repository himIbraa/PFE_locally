<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_95> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "جبهة التحرير الوطني هي الحزب الواحد في البلاد. جبهة التحرير الوطني هي الطليعة المؤلفة من المواطنين الأكثر وعيا، الذين تحدوهم المثل العليا للوطنية و الإشتراكية، و الذين يتحدون بكل حرية ضمنها، طبقا للشروط المنصوص عليها في القوانين الأساسية للحزب . مناضلو الحزب المختارون على الخصوص من بين العمال، و الفلاحين و الشباب، يصبون إلى تحقيق هدف واحد و إلى مواصلة عمل واحد غايته القصوى انتصار الإشتراكية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_95_19761119_OpEnact_4ddea2964d> ;
    dzdoc:replacementText "جبهة التحرير الوطني هي الحزب الواحد في البلاد. جبهة التحرير الوطني هي الطليعة المؤلفة من المواطنين الأكثر وعيا، الذين تحدوهم المثل العليا للوطنية و الإشتراكية، و الذين يتحدون بكل حرية ضمنها، طبقا للشروط المنصوص عليها في القوانين الأساسية للحزب . مناضلو الحزب المختارون على الخصوص من بين العمال، و الفلاحين و الشباب، يصبون إلى تحقيق هدف واحد و إلى مواصلة عمل واحد غايته القصوى انتصار الإشتراكية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_95> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_95> ;
