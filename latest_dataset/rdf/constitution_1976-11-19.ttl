<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_29> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعمل الدولة على تغيير علاقات الإنتاج، و تسيير الإقتصاد الوطني ، و تضمن تنمية على أساس تخطيط علمي المفهوم، ديمقراطي التصميم، حتمي التنفيذ . تنظم الدولة الإنتاج و تحدد توزيع الدخل القومي ، و هي العنصر الأساسي في تحويل الإقتصاد و مجموع العلاقات الإجتماعية."@ar ;
