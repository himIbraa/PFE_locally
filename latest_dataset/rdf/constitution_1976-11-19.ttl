<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_120> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كانت البلاد مهددة بخطر وشيك الوقوع على مؤسساتها، أو على استقلالها، أو سلامة ترابها ، يقرر رئيس الجمهورية الحالة الإستثنائية . يتدخل مثل هذا الإجراء أثناء اجتماع الهيئات العليا للحزب و الحكومة . تخول الحالة الاستثنائية لرئيس الجمهورية أن يتخذ الإجراءات الخاصة التي تتطلبها المحافظة على استقلال الأمة و مؤسسات الجمهورية. يجتمع المجلس الشعبي الوطني ، وجوبا، باستدعاء من رئيسه . تنتهي الحالة الإستثنائية حسب نفس الأشكال، و بناء على نفس الإجراءات المذكورة أعلاه التي أدت إلى تقريرها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_120_19761119_OpEnact_cdaf3a041f> ;
    dzdoc:replacementText "إذا كانت البلاد مهددة بخطر وشيك الوقوع على مؤسساتها، أو على استقلالها، أو سلامة ترابها ، يقرر رئيس الجمهورية الحالة الإستثنائية . يتدخل مثل هذا الإجراء أثناء اجتماع الهيئات العليا للحزب و الحكومة . تخول الحالة الاستثنائية لرئيس الجمهورية أن يتخذ الإجراءات الخاصة التي تتطلبها المحافظة على استقلال الأمة و مؤسسات الجمهورية. يجتمع المجلس الشعبي الوطني ، وجوبا، باستدعاء من رئيسه . تنتهي الحالة الإستثنائية حسب نفس الأشكال، و بناء على نفس الإجراءات المذكورة أعلاه التي أدت إلى تقريرها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_120> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_120> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

