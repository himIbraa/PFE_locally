<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_37> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ليست وظائف الدولة امتيازا بل هي تكليف. على أعوان الدولة أن يأخذوا بعين الإعتبار مصالح الشعب و المنفعة العامة ليس غير ، و لا يمكن بحال من الأحوال، أن تصبح ممارسة الوظائف العمومية مصدرا للثراء، و لا وسيلة لخدمة المصالح الخاصة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_37_19761119_OpEnact_6c9d35d28a> ;
