<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_135> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "النائب مسئول أمام زملائه الذين يمكنهم عزله إذا خان ثقة الشعب فيه أو اقترف عملا مخلا بوظيفته . يحدد القانون الحالات التي يتعرض فيها النائب للعزل، و يقر المجلس الشعبي الوطني العزل بأغلبية أعضائه، بقطع النظر عما قد يحدث من متابعات أخرى حسب التشريع العادي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
