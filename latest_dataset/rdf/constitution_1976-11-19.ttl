<https://legal.dz/resource/constitution/1976-11-19/1976#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الخامس_واجبات_المواطن> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "إلتزام المواطن إزاء الوطن و مساهمته في الدفاع عنه من واجباته الدائمة . على كل مواطن أن يؤدي بإخلاص واجباته تجاه المجموعة الوطنية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_76_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_76_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_76_19761119_OpEnact_3cb1ffce0a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_76_obligation_0_8fa3e01e>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_76_obligation_1_e80ec231> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 76" ;
    dzdoc:position 75 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_السابع_مبادئ_السياسة_الخارجية> ;
    dzdoc:eId "art_87" ;
    dzdoc:fullText "تندرج وحدة الشعوب العربية في وحدة مصير هذه الشعوب. تلتزم الجزائر، كلما تهيأت الظروف الملائمة لقيام وحدة مبنية على تحرير الجماهير الشعبية ، باعتماد صيغ للوحدة أو للإتحاد أو للإندماج، كفيلة بالتلبية الكاملة للمطامح المشروعة و العميقة للشعوب العربية . وحدة الشعوب المغربية المستهدفة صالح الجماهير الشعبية، تتجسد كاختيار أساسي للثورة الجزائرية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_87> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_87_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_87_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_87_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_87_19761119_OpEnact_92565a3582> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_87_obligation_0_8a25a862> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 87" ;
    dzdoc:position 86 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_97> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الأول_الوظيفة_السياسية> ;
    dzdoc:eId "art_97" ;
    dzdoc:fullText "جبهة التحرير الوطني هي القوة الطلائعية لقيادة الشعب و تنظيمه من أجل تجسيم أهداف الثورة الاشتراكية. تشكل جبهة التحرير الوطني دليل الثورة الإشتراكية و القوة المسيرة للمجتمع. و هي أداة الثورة الإشتراكية في مجالات القيادة و التخطيط و التنشيط. تسهر جبهة التحرير الوطني على التعبئة الدائمة للشعب ، و ذلك بالتربية العقائدية للجماهير و تنظيمها و تأطيرها من أجل تشييد المجتمع الاشتراكي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_97> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_97_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_97_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_97_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_97_19761119_OpEnact_daefeb7dda> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_97_obligation_0_a26221a4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 97" ;
    dzdoc:position 96 ;
    dzdoc:usesTerm dzterm:fln .

