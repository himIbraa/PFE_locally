    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 91" ;
    dzdoc:position 90 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_112> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_112" ;
    dzdoc:fullText "يمكن لـ رئيس الجمهورية أن يعين نائبا لرئيس الجمهورية يساعده و يعينه في مهامه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1976-11-19/1976#art_112_permission_0_e7d534f6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_112> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_112_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
