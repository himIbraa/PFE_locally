dzterm:national_peoples_assembly a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المجلس الشعبي الوطني"@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_119> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_119" ;
    dzdoc:fullText "في حالة الضرورة الملحة ، يقرر رئيس الجمهورية ، في اجتماع لهيئات الحزب العليا و الحكومة ، حالة الطوارئ أو الحصار ، و يتخذ كل الإجراءات اللازمة لاستتباب الوضع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_119> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_119_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_119_19761119_OpEnact_751803705f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "119" ;
    dzdoc:position 118 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1976-11-19/1976#art_119_condition_0_20cafde3> ;
    dzdoc:usesTerm dzterm:emergency_state,
        dzterm:government,
        dzterm:president,
        dzterm:siege_state .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_130> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الثالث_الوظيفة_التشريعية> ;
    dzdoc:eId "art_130" ;
    dzdoc:fullText "يحدد القانون طرق انتخاب النواب، و بخاصة عددهم، و شروط قابليتهم للانتخاب، و حالات التنافي مع شروط العضوية في المجلس. يجب أن يكون تأليف المجلس الشعبي الوطني مطابقا لأحكام المادتين 8 و 9 من الدستور ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_130> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_130_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_130_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_130_19761119_OpEnact_443bce9bd9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_130_obligation_0_ea1f1762> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 130" ;
    dzdoc:position 129 ;
    dzdoc:references <https://legal.dz/resource/constitution/1976-11-19/1976#art_8>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_9> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/1976-11-19/1976#art_8>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_9> .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_144> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_في_النزاع_الناشئ_عن_الإنتخابات_التشريعية_من_اختصاص_المجلس_الأعلى> ;
    dzdoc:eId "art_144" ;
    dzdoc:fullText "جلسات المجلس الشعبي الوطني علانية. وتدون المداولات في محاضر تنشر طبقا لما يقرره القانون، و يجوز للمجلس الشعبي الوطني أن يعقد جلسات مغلقة بطلب من رئيسه أو من أغلبية أعضائه الحاضرين أو بطلب من الحكومة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1976-11-19/1976#art_144_permission_0_0d67a100> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_144> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_144_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_144_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_144_19761119_OpEnact_8da2768e5b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 144" ;
    dzdoc:position 143 ;
    dzdoc:usesTerm dzterm:apn .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_151> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_في_النزاع_الناشئ_عن_الإنتخابات_التشريعية_من_اختصاص_المجلس_الأعلى> ;
    dzdoc:eId "art_151" ;
    dzdoc:fullText "يشرع المجلس الشعبي الوطني في المجالات التي خولها له الدستور. تدخل كذلك في مجال القانون : 1. الحقوق و الواجبات الأساسية للأفراد ، و بخاصة نظام الحريات العمومية و حماية الحريات الفردية و واجبات المواطنين في إطار متطلبات الدفاع الوطني . 2. القواعد العامة المتعلقة بقانون الأحوال الشخصية و قانون الأسرة، و بخاصة الزواج و الطلاق و البنوة و الأهلية و المواريث. 3. ظروف الإستقرار المتعلقة بالأفراد. 4. التشريع الأساسي الخاص بالجنسية. 1. القواعد العامة المتعلقة بمركز الأجانب. 5. القواعد العامة المتعلقة بالتنظيم القضائي. 6. القواعد العامة للقانون الجزائي و الإجراءات الجزائية و بخاصة تحديد الجنايات و الجنح، و العقوبات المناسبة لها، و العفو الشامل، و تسليم المجرمين. 7. القواعد العامة لقانون الإجراءات المدنية و طرق التنفيذ. 8. النظام العام للإلتزامات المدنية و التجارية. 9. القواعد العامة المتعلقة بنظام الإنتخابات. 10. التنظيم الإقليمي و التقسيم الإداري للبلاد. 11. المبادئ الأساسية للسياسة الإقتصادية و الإجتماعية. 12. تحديد سياسة التربية، و سياسة الشباب. 13. الخطوط الأساسية للسياسة الثقافية. 14. إقرار المخطط الوطني. 15. التصويت على ميزانية الدولة. 16. إحداث الضرائب و الجبايات و الرسوم و الحقوق بجميع أنواعها و تحديد وعائها و نسبها. 17. القواعد العامة للنظام الجمركي. 18. القواعد العامة المتعلقة بنظام البنوك و القرض و التأمين. 19. القواعد العامة المتعلقة بالصحة العمومية، و السكان، و قانون العمل و الضمان الإجتماعي. 20. القواعد العامة المتعلقة بحماية المجاهدين و أولي الحق من ذويهم. 21. الخطوط العريضة لسياسة الإعمار الإقليمي، و البيئة، و نوعية الحياة، و حماية الحيوانات و النباتات. 22. حماية التراث الثقافي و التاريخي و المحافظة عليه. 23. النظام العام للغابات. 24. النظام العام للمياه. 25. إنشاء أوسمة الدولة و نياشينها و وضع ألقابها الشرفية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_151_right_0_073ffaee> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_151> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_151_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_151_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_151_19761119_OpEnact_1c48ef2001> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_151_obligation_0_6aacbe4f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 151" ;
    dzdoc:position 150 ;
    dzdoc:usesTerm dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_153> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_في_النزاع_الناشئ_عن_الإنتخابات_التشريعية_من_اختصاص_المجلس_الأعلى> ;
    dzdoc:eId "art_153" ;
    dzdoc:fullText "لـ رئيس الجمهورية أن يشرع، فيما بين دورة و أخرى لـ المجلس الشعبي الوطني ، عن طريق إصدار أوامر تعرض على موافقة المجلس الشعبي الوطني في أول دورة مقبلة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_153_right_0_afff2403> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_153> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_153_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_153_19761119_OpEnact_ea619a71e4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_153_obligation_0_390d97e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 153" ;
    dzdoc:position 152 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:president .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_155> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_في_النزاع_الناشئ_عن_الإنتخابات_التشريعية_من_اختصاص_المجلس_الأعلى> ;
    dzdoc:eId "art_155" ;
    dzdoc:fullText "لـ رئيس الجمهورية سلطة طلب إجراء مداولة ثانية حول قانون تم التصويت عليه ، و ذلك في ظرف ثلاثين (30) من تاريخ إقراره. و في هذه الحالة لا يتم إقرار القانون إلا بأغلبية ثلثي أعضاء المجلس الشعبي الوطني ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_155_right_0_79e6ca1a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_155> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_155_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_155_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_155_19761119_OpEnact_45389279cf> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 155" ;
    dzdoc:position 154 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1976-11-19/1976#art_155_condition_0_c311e30c> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:president .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_176> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الرابع_الوظيفة_القضائية> ;
    dzdoc:eId "art_176" ;
    dzdoc:fullText "حق الدفاع معترف به . حق الدفاع مضمون في القضايا الجزائية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_176_right_0_64641a58>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_176_right_1_13bc4e88> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_176> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_176_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_176_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_176_19761119_OpEnact_90a03778e0> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 176" ;
    dzdoc:position 175 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_182> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الرابع_الوظيفة_القضائية> ;
    dzdoc:eId "art_182" ;
    dzdoc:fullText "يبدي المجلس الأعلى للقضاء رأيا استشاريا قبل ممارسة رئيس الجمهورية حق العفو. يقر المجلس الأعلى للقضاء ، طبقا للأحكام التي يحددها القانون، تعيين القضاة و نقلهن و سير سلمهم الوظيفي، و يساهم في مراقبة انضباطهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_182> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_182_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_182_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_182_19761119_OpEnact_230fea89bb> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 182" ;
    dzdoc:position 181 ;
    dzdoc:usesTerm dzterm:judges,
        dzterm:supreme_council_judiciary .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_184> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:definesTerm dzterm:oversight_mission ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الخامس_وظيفة_المراقبة> ;
    dzdoc:eId "art_184" ;
    dzdoc:fullText "تستهدف المراقبة ضمان تسيير حسن لأجهزة الدولة في نطاق احترام الميثاق الوطني و الدستور و قوانين البلاد. مهمة المراقبة هي التحري في الظروف التي يتم فيها استخدام و تسيير الوسائل البشرية و المادية من طرف الأجهزة الإدارية و الإقتصادية للدولة، و كذا تدارك النقص و التقصير و الإنحراف، و التمكين من قمع الإختلاس و كل الأعمال الإجرامية ضد الثورة الوطنية، و بالتالي ضمان تسيير البلاد في إطار النظام و الوضوح و المنطق. تستهدف المراقبة أخيرا، التحقق من التطابق بين أعمال الإدارة و التشريع و أوامر الدولة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_184> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1976-11-19/1976#art_184_defocc_94ffb7e4dc9e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_184_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_184_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_184_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
