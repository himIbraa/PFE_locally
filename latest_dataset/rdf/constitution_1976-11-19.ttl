<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_149> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يقبل اقتراح أي قانون مضمونه أو نتيجته تخفيض الموارد العمومية أو زيادة النفقات العمومية إلا إذا كان مرفوقا بتدابير تستهدف رفع مداخيل الدولة أو توفير مبالغ مالية في فصل آخر من النفقات العمومية، تكون مساوية، على الأقل، للمبالغ المقترح تغييرها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_149_19761119_OpEnact_2c8644de07> ;
