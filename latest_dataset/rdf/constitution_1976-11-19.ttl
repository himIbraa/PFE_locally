    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_16> ;
    dzdoc:position 1 ;
    dzdoc:text "الملكية الخاصة غير الإستغلالية، كما يعرفها القانون، جزء لا يتجزأ من التنظيم الإجتماعي الجديد."@ar .

