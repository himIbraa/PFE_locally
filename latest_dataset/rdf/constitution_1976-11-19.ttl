<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_125> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤسس مجلس أعلى للأمن برئاسة رئيس الجمهورية ، مهمته تقديم الآراء حول كل القضايا المتعلقة بالأمن الوطني، إلى رئيس الجمهورية . يحدد رئيس الجمهورية طرق تنظيم المجلس الأعلى للأمن و تسييره."@ar ;
    dzdoc:isAuthoritative true ;
