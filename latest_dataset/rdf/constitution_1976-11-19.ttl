    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الدولة مسؤولة عن ظروف حياة كل مواطن . فهي تكفل استيفاء حاجياته المادية والمعنوية، وبخاصة متطلباته المتعلقة بالكرامة والأمن . وهي تستهدف تحرير المواطن من الإستغلال و البطالة و المرض و الجهل. تتكفل الدولة بحماية مواطنيها في الخارج ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
