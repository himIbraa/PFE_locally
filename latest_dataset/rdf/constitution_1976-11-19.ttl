<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_148> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المبادرة بالقوانين حق ل رئيس الجمهورية ، كما أنها حق لأعضاء المجلس الشعبي الوطني . تكون اقتراحات القوانين قابلة للنقاش إذا قدمها عشرون نائبا . تقدم مشاريع القوانين من الحكومة إلى مكتب المجلس الشعبي الوطني ."@ar ;
