<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_107> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يؤهل أن ينتخب لرئاسة الجمهورية إلا من كانت له الجنسية الجزائرية أصلا، و يدين بالإسلام، و قد بلغ من العمر أربعين سنة (40) كاملة يوم الإنتخاب، و يتمتع بكامل حقوقه المدنية و السياسية ."@ar ;
