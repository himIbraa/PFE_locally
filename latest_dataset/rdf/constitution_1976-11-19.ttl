<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_187> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقدم الحكومة في نهاية كل سنة مالية، إلى المجلس الشعبي الوطني عرضا حول استعمال الاعتمادات المالية التي أقرها بالنسبة للسنة المالية المعنية . تختتم السنة المالية، على مستوى المجلس الشعبي الوطني بالتصويت على قانون يتحدد بمقتضاه ضبط ميزانية السنة المالية المنصرمة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
