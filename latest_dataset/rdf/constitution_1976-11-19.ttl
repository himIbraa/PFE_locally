<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تمثل المجالس الشعبية المنتخبة، بحكم محتواها البشري، القوى الاجتماعية للثورة. تتكون الأغلبية، ضمن المجالس الشعبية المنتخبة، من العمال و الفلاحين يعتبر عاملا كل شخص يعيش من حاصل عمله اليدوي أو الفكري و لا يستخدم لمصلحته الخاصة غيره من العمال أثناء ممارسة نشاطه المهني ."@ar ;
