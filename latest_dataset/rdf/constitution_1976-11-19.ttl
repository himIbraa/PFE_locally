    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 53" ;
    dzdoc:position 52 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_56> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_56" ;
    dzdoc:fullText "حرية إنشاء الجمعيات معترف بها ، و تمارس في إطار القانون."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_56_right_0_4f517a66> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_56> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_56_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_56_19761119_OpEnact_0638def444> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 56" ;
    dzdoc:position 55 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "حق الإنخراط في النقابة معترف به لجميع العمال ، و يمارس في إطار القانون."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_60_right_0_ff083ecd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_60_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_60_19761119_OpEnact_7495e3409c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 60" ;
    dzdoc:position 59 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "تضمن الدولة أثناء العمل الحق في الحماية، و الأمن و الوقاية الصحية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_62_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_62_19761119_OpEnact_31e2f236c4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_62_obligation_0_f04d5362> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 62" ;
    dzdoc:position 61 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "تكفل الدولة، في نطاق القانون، ظروف معيشة المواطنين الذين لم يبلغوا بعد سن العمل و الذين لا يستطيعون القيام به، و الذين عجزوا عنه نهائيا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_64_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_64_19761119_OpEnact_0af5939bd1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_64_obligation_0_2d362bcd> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 64" ;
    dzdoc:position 63 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "يحظى كل أجنبي يقيم بصفة قانونية على التراب الوطني، بالحماية المخولة للأفراد و الأموال ، طبقا للقانون و مراعاة لتقاليد الشعب الجزائري في الضيافة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_68_right_0_54d420b2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_68_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_68_19761119_OpEnact_365bbba165> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 68" ;
    dzdoc:position 67 ;
    dzdoc:usesTerm dzterm:foreigner .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الأول_الجمهورية> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "المجلس الشعبي هو المؤسسة القاعدية للدولة، و الإطار الذي يتم فيه التعبير عن الإرادة الشعبية و تتحقق فيه الديمقراطية. كما أنه القاعدة الأساسية للامركزية و لمساهمة الجماهير الشعبية في تسيير الشؤون العمومية على جميع المستويات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_7_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_7_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_7_19761119_OpEnact_44b83df835> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "7" ;
    dzdoc:position 6 ;
    dzdoc:usesTerm dzterm:popular_council .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_83> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_السادس_الجيش_الوطني_الشعبي> ;
    dzdoc:eId "art_83" ;
    dzdoc:fullText "العنصر الشعبي عامل حاسم في الدفاع الوطني. الجيش الوطني الشعبي هو الجهاز الدائم للدفاع، الذي يتمحور حوله تنظيم الدفاع الوطني و دعمه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_83> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_83_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_83_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_83_19761119_OpEnact_421814f2ad> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 83" ;
    dzdoc:position 82 ;
    dzdoc:usesTerm dzterm:anp .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_السابع_مبادئ_السياسة_الخارجية> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "تتبنى الجمهورية الجزائرية المبادئ و الأهداف التي تتضمنها مواثيق الأمم المتحدة و منظمة الوحدة الإفريقية و الجامعة العربية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_86_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_86_19761119_OpEnact_2b143a92ef> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_86_obligation_0_1edf8476> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 86" ;
    dzdoc:position 85 ;
    dzdoc:usesTerm dzterm:republic .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_98> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الأول_الوظيفة_السياسية> ;
    dzdoc:eId "art_98" ;
    dzdoc:fullText "تتجسد قيادة البلاد في وحدة القيادة السياسية للحزب و الدولة. و في إطار هذه الوحدة، فإن قيادة الحزب هي التي توجه السياسة العامة للبلاد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_98> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_98_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_98_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_98_19761119_OpEnact_8f588f280b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 98" ;
    dzdoc:position 97 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_99> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الأول_الوظيفة_السياسية> ;
    dzdoc:eId "art_99" ;
    dzdoc:fullText "ترتكز المؤسسات السياسية المنتخبة، في جميع المستويات، على مبدأ الجماعية في المداولة، و الأغلبية في القرار، و الوحدة في التنفيذ. يتطلب تطبيق هذا المبدأ، على نطاق المؤسسات الحزبية، الوحدة في العقيدة و الإرادة، و الإنسجام في العمل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_99> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_99_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_99_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_99_19761119_OpEnact_8fc2c1f2f1> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 99" ;
    dzdoc:position 98 .

<https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الثالث_الوظيفة_التشريعية> a dzdoc:Section ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
