    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_110> ;
    dzdoc:position 1 ;
    dzdoc:text "“وفاء للتضحيات الكبرى و لأرواح شهداء ثورتنا المقدسة أقسم بالله العلي العظيم أن أحترم الدين الإسلامي و أمجده، و أن أحترم الميثاق الوطني و الدستور، و كل قوانين الجمهورية و أحميها، و أن أحترم الإختيار الإشتراكي الذي لا رجعة فيه، و أن أحافظ على سلامة التراب الوطني و حدة الشعب و الأمة، و أن أحمي الحقوق و الحريات الأساسية للشعب و أعمل بدون هوادة على تطوره و سعادته، و أن أسعى بكل قواي من أجل تحقيق المثل العليا للعدالة و الحرية و السلم في العالم”."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_110_right_0_f30f9b9e> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_110> ;
    dznorm:position 0 ;
    dznorm:provisionText "الحقوق و الحريات الأساسية للشعب"@ar ;
    dznorm:sourceArticle "art_110" .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_111_obligation_0_378d312f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_111> ;
    dznorm:position 0 ;
    dznorm:provisionText "يضطلع رئيس الجمهورية، بالإضافة إلى السلطات المخولة له بنص هذا الدستور، بالسلطات و الصلاحيات الآتية :"@ar ;
    dznorm:sourceArticle "art_111" .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_111_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_111> ;
    dzdoc:position 0 ;
    dzdoc:text "يضطلع رئيس الجمهورية، بالإضافة إلى السلطات المخولة له بنص هذا الدستور، بالسلطات و الصلاحيات الآتية : يمثل الدولة داخل البلاد و خارجها. يجسد وحدة القيادة السياسية للحزب و الدولة. يحمي الدستور. يتولى القيادة العليا لجميع القوات المسلحة للجمهورية. يتولى مسئولية الدفاع الوطني. يقرر طبقا للميثاق الوطني و لأحكام الدستور، السياسة العامة للأمة في المجالين الداخلي و الخارجي، و يقوم بقيادتها و تنفيذها. يحدد صلاحيات أعضاء الحكومة طبقا لأحكام الدستور. يترأس مجلس الوزراء. يترأس الإجتماعات المشتركة لأجهزة الحزب و الدولة. يضطلع بالسلطة التنظيمية. يسهر على تنفيذ القوانين و التنظيمات. يعين الموظفين المدنيين و العسكريين، طبقا للقانون. له حق إصدار العفو و حق إلغاء العقوبات أو تخفيضها و كذلك حق إزالة كل النتائج القانونية، أيا كانت طبيعتها، و المترتبة على الأحكام التي تصدرها المحاكم. يمكن له أن يعمد لاستفتاء الشعب في كل القضايا ذات الأهمية الوطنية. يمكن له أن يفوض جزءا من صلاحياته لنائب رئيس الجمهورية و للوزير الأول مع مراعاة أحكام المادة 116 من الدستور. يعين سفراء الجمهورية و المفوضين فوق العادة للخارج و ينهي مهامهم، و يتسلم أوراق اعتماد الممثلين الدبلوماسيين الأجانب، و أوراق إنهاء مهامهم. يبرم المعاهدات الدولية و يصادق عليها وفقا لأحكام الدستور. يقلد أوسمة الدولة و نياشينها و ألقابها الشرفية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_111_permission_0_38ad8168> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
