<https://legal.dz/resource/constitution/1976-11-19/1976#art_6_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_6> ;
    dzdoc:position 0 ;
    dzdoc:text "الميثاق الوطني هو المصدر الأساسي لسياسة الأمة و قوانين الدولة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_6_para_1> a dzdoc:Paragraph ;
