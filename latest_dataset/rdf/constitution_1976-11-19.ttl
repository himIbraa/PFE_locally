<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_193> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تعلق مشروع قانون التعديل بالأحكام الخاصة بتعديل الدستور ، فمن الضروري أن يتم الإقرار بأغلبية ثلاثة أرباع المجلس الشعبي الوطني . لا تسرى هذه الأحكام على المادة 195 من الدستور، التي لا تقبل أي تعديل."@ar ;
