    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_137> ;
    dzdoc:position 0 ;
    dzdoc:text "الحصانة النيابية معترف بها للنائب أثناء نيابته."@ar .

