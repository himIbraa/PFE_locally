<https://legal.dz/resource/constitution/1976-11-19/1976#art_87_obligation_0_8a25a862> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/constitution/1976-11-19/1976#art_87_obligation_0_8a25a862_role_b55b982b37> ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_87> ;
    dznorm:hasCondition <https://legal.dz/resource/constitution/1976-11-19/1976#art_87_obligation_0_8a25a862_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "تلتزم الجزائر، كلما تهيأت الظروف الملائمة لقيام وحدة مبنية على تحرير الجماهير الشعبية، باعتماد صيغ للوحدة أو للإتحاد أو للإندماج، كفيلة بالتلبية الكاملة للمطامح المشروعة و العميقة للشعوب العربية"@ar ;
    dznorm:sourceArticle "art_87" .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_8_defocc_52f1afb8602d> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 121 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:worker ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_8> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_8_para_2> ;
    dzdoc:paragraphPosition 2 ;
    dzdoc:snippet "يعتبر عاملا كل شخص يعيش من حاصل عمله اليدوي أو الفكري و لا يستخدم لمصلحته الخاصة غيره من العمال أثناء ممارسة نشاطه المهني."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_8_para_2> a dzdoc:Paragraph ;
