<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_66> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لكل مواطن الحق في التعلم . التعليم مجاني و هو إجباري بالنسبة لمدة المدرسة الأساسية في إطار الشروط المحددة بالقانون. تضمن الدولة التطبيق المتساوي لحق التعليم . تنظم الدولة التعليم . تسهر الدولة على أن تكون أبواب التعليم و التكوين المهني و الثقافة مفتوحة بالتساوي أمام الجميع ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_66_19761119_OpEnact_267f9f4d64> ;
    dzdoc:replacementText "لكل مواطن الحق في التعلم . التعليم مجاني و هو إجباري بالنسبة لمدة المدرسة الأساسية في إطار الشروط المحددة بالقانون. تضمن الدولة التطبيق المتساوي لحق التعليم . تنظم الدولة التعليم . تسهر الدولة على أن تكون أبواب التعليم و التكوين المهني و الثقافة مفتوحة بالتساوي أمام الجميع ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
