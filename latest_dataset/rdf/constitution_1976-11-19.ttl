    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "العنصر الشعبي عامل حاسم في الدفاع الوطني. الجيش الوطني الشعبي هو الجهاز الدائم للدفاع، الذي يتمحور حوله تنظيم الدفاع الوطني و دعمه."@ar ;
