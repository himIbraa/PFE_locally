    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1976-11-19/1976#art_8_defocc_52f1afb8602d> .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الجزائر جمهورية ديمقراطية شعبية، و هي وحدة لا تتجزأ. الدولة الجزائرية دولة اشتراكية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_1_19761119_OpEnact_d33888bb26> ;
    dzdoc:replacementText "الجزائر جمهورية ديمقراطية شعبية، و هي وحدة لا تتجزأ. الدولة الجزائرية دولة اشتراكية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_1> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_1> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_10> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الاشتراكية اختيار الشعب الذي لا رجعة فيه، كما عبر عن ذلك بكامل السيادة في الميثاق الوطني. و هي السبيل الوحيد الكفيل باستكمال الإستقلال الوطني. مفهوم الإشتراكية ، طبقا لما ورد في الميثاق الوطني نصا و روحا، هو تعميق لثورة فاتح نوفمبر 1954 و نتيجة منطقية لها. الثورة الجزائرية ثورة اشتراكية تستهدف إزالة استغلال الإنسان للإنسان، شعارها : “من الشعب و إلى الشعب”."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_10_19761119_OpEnact_4fecb4e0a3> ;
    dzdoc:replacementText "الاشتراكية اختيار الشعب الذي لا رجعة فيه، كما عبر عن ذلك بكامل السيادة في الميثاق الوطني. و هي السبيل الوحيد الكفيل باستكمال الإستقلال الوطني. مفهوم الإشتراكية ، طبقا لما ورد في الميثاق الوطني نصا و روحا، هو تعميق لثورة فاتح نوفمبر 1954 و نتيجة منطقية لها. الثورة الجزائرية ثورة اشتراكية تستهدف إزالة استغلال الإنسان للإنسان، شعارها : “من الشعب و إلى الشعب”."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_10> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_10> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_100> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المنظمات الجماهيرية ، بإشراف الحزب و مراقبته، مكلفة بتعبئة أوسع فئات الشعب لتحقيق كبريات المهام السياسية و الإقتصادية و الإجتماعية و الثقافية التي تتوقف عليها تنمية البلاد و النجاح في بناء الإشتراكية. المنظمات الجماهيرية مكلفة، دون غيرها، بمهمة تنظيم العمال و الفلاحين و الشباب و النساء، و العمل على تعميق وعيهم لمسئولياتهم و للدور المتعاظم الذي يجب أن يضطلعوا به في بناء الوطن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_100_19761119_OpEnact_ea5421894f> ;
    dzdoc:replacementText "المنظمات الجماهيرية ، بإشراف الحزب و مراقبته، مكلفة بتعبئة أوسع فئات الشعب لتحقيق كبريات المهام السياسية و الإقتصادية و الإجتماعية و الثقافية التي تتوقف عليها تنمية البلاد و النجاح في بناء الإشتراكية. المنظمات الجماهيرية مكلفة، دون غيرها، بمهمة تنظيم العمال و الفلاحين و الشباب و النساء، و العمل على تعميق وعيهم لمسئولياتهم و للدور المتعاظم الذي يجب أن يضطلعوا به في بناء الوطن."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_100> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_100> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_101> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
