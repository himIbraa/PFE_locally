<https://legal.dz/resource/constitution/1976-11-19/1976#art_126> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_الثالث_الوظيفة_التشريعية> ;
    dzdoc:eId "art_126" ;
    dzdoc:fullText "يمارس الوظيفة التشريعية مجلس واحد يسمى المجلس الشعبي الوطني . للمجلس الشعبي الوطني، في نطاق اختصاصاته، سلطة التشريع بكامل السيادة . يعد المجلس الشعبي الوطني القوانين و يصوت عليها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_126_right_0_969818d1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_126> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_126_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_126_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_126_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_126_19761119_OpEnact_5230482c3b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_126_obligation_0_dade6a06> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 126" ;
    dzdoc:position 125 ;
    dzdoc:usesTerm dzterm:legislative_function,
        dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الثاني_الإشتراكية> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "على المؤسسات الإشتراكية التي تكلفها الدولة باستثمار أو استغلال أو تنمية جزء من ممتلكاتها أن تذكر في موازنتها وفقا لأحكام القانون، قيمة الأصول المعادلة لقيمة الممتلكات الموضوعة تحت تصرفها. يتم استخلاف قيمة هذه الأصول، و عند الاقتضاء إعادة تقييمها، حسب القواعد و الطرق المحددة في التشريع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_15_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_15_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_15_19761119_OpEnact_b04b7b5a27> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_15_obligation_0_52b89744> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "15" ;
    dzdoc:position 14 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1976-11-19/1976#art_15_condition_0_1b1645cd> .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_150> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_في_النزاع_الناشئ_عن_الإنتخابات_التشريعية_من_اختصاص_المجلس_الأعلى> ;
    dzdoc:eId "art_150" ;
    dzdoc:fullText "يجوز للمجالس الشعبية البلدية و للمجالس الشعبية للولايات، أن ترفع إلتماسا إلى الحكومة التي يعود إليها النظر لصياغته في مشروع قانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1976-11-19/1976#art_150_permission_0_71356501> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_150_right_0_99a84117> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_150> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_150_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_150_19761119_OpEnact_d1df1f2997> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 150" ;
    dzdoc:position 149 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الثاني_الإشتراكية> ;
    dzdoc:eId "art_17" ;
    dzdoc:fullText "لا يتم نزع الملكية إلا في إطار القانون . و يترتب عنه أداء تعويض عادل و منصف . لا تجوز معارضة إجراء نزع الملكية للصالح العام بحجة أية اتفاقية دولية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_17> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_17_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_17_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_17_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_17_19761119_OpEnact_e08017da1e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1976-11-19/1976#art_17_obligation_0_05e2d0b7> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 17" ;
    dzdoc:position 16 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1976-11-19/1976#art_17_condition_0_40ffbb0b> .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_195> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الثاني_السلطة_و_تنظيمها_sec_السادس_الوظيفة_التأسيسية> ;
    dzdoc:eId "art_195" ;
    dzdoc:fullText "لا يمكن لأي مشروع لتعديل الدستور أن يمس : بالصفة الجمهورية للحكم. بدين الدولة. بالإختيار الإشتراكي. بالحريات الأساسية للإنسان و المواطن. بمبدأ التصويت عن طريق الإقتراع العام المباشر و السري. بسلامة التراب الوطني."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1976-11-19/1976#art_195_permission_0_52efea20> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_195> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_195_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_195_19761119_OpEnact_6bb4eea66a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 195" ;
    dzdoc:position 194 .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:definesTerm dzterm:commune,
        dzterm:territorial_collectivities ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "المجموعات الإقليمية هي الولاية و البلدية . البلدية هي المجموعة الإقليمية السياسية و الإدارية و الاقتصادية و الاجتماعية و الثقافية في القاعدة. التنظيم الإقليمي و التقسيم الإداري للبلاد خاضعان للقانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_36> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1976-11-19/1976#art_36_defocc_66d5c07d36bf>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_36_defocc_dc0c96da67bf> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_36_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_36_para_1>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_36_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_36_19761119_OpEnact_5587f94d85> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "36" ;
    dzdoc:position 35 ;
    dzdoc:usesTerm dzterm:commune,
        dzterm:wilaya .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_55> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_55" ;
    dzdoc:fullText "حرية التعبير والإجتماع مضمونة ، و لا يمكن التذرع بها لضرب أسس الثورة الإشتراكية. تمارس هذه الحرية مع مراعاة أحكام المادة 73 من الدستور."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1976-11-19/1976#art_55_permission_0_6d69ef8a> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_55_right_0_3abfec89> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_55> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_55_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_55_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_55_19761119_OpEnact_c123beed0a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 55" ;
    dzdoc:position 54 ;
    dzdoc:references <https://legal.dz/resource/constitution/1976-11-19/1976#art_73> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/1976-11-19/1976#art_73> .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_57> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_57" ;
    dzdoc:fullText "لكل مواطن يتمتع بكامل حقوقه المدنية و السياسية ، حق التنقل بكل حرية في أي ناحية من التراب الوطني . حق الخروج من التراب الوطني مضمون في نطاق القانون."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_57_right_0_35d378b3>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_57_right_1_c8b5a576> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_57> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_57_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_57_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_57_19761119_OpEnact_a16b9eecbd> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 57" ;
    dzdoc:position 56 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1976-11-19/1976#art_57_condition_0_cde3d51f> .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "يعاقب القانون على التعسف في استعمال السلطة . تضمن الدولة مساعدة المواطن من أجل الدفاع عن حريته و حصانة ذاته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_72_para_0>,
        <https://legal.dz/resource/constitution/1976-11-19/1976#art_72_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_72_19761119_OpEnact_29f0fc1e27> ;
