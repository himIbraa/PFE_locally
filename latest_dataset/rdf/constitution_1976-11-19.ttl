<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_100_19761119_OpEnact_ea5421894f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_100> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_100> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_100> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "المنظمات الجماهيرية ، بإشراف الحزب و مراقبته، مكلفة بتعبئة أوسع فئات الشعب لتحقيق كبريات المهام السياسية و الإقتصادية و الإجتماعية و الثقافية التي تتوقف عليها تنمية البلاد و النجاح في بناء الإشتراكية. المنظمات الجماهيرية مكلفة، دون غيرها، بمهمة تنظيم العمال و الفلاحين و الشباب و النساء، و العمل على تعميق وعيهم لمسئولياتهم و للدور المتعاظم الذي يجب أن يضطلعوا به في بناء الوطن."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_101_19761119_OpEnact_0ff2730de4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_101> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_101> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_101> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تعمل أجهزة الحزب و أجهزة الدولة في إطارين منفصلين و بوسائل مختلفة من أجل تحقيق أهداف واحدة. لا يمكن أن تتداخل اختصاصات كل منهما أو تختلط ببعضها . يقوم التنظيم السياسي للبلاد على التكامل في المهام بين أجهزة الحزب و أجهزة الدولة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_102_19761119_OpEnact_7a5df72a52> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_102> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_102> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_102> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "الوظائف الحاسمة في الدولة تسند إلى أعضاء من قيادة الحزب."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_103_19761119_OpEnact_f0f21a1d71> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_103> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_103> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_103> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "العلاقات بيت أجهزة الحزب و أجهزة الدولة خاضعة لأحكام الدستور ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_104_19761119_OpEnact_fbaae5b9ff> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_104> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_104> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_104> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يضطلع بقيادة الوظيفة التنفيذية رئيس الجمهورية ، و هو رئيس الدولة ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_105_19761119_OpEnact_a8e92de012> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_105> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_105> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_105> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "ينتخب رئيس الجمهورية عن طريق الإقتراع العام المباشر و السري . يتم انتخاب المرشح بالأغلبية المطلقة من الناخبين المسجلين . يقترح المرشح من طرف جبهة التحرير الوطني، و يمارس مؤتمرها مباشرة هذه الصلاحية ابتداء من انعقاد أول مؤتمر لها اثر دخول هذا الدستور حيز التنفيذ. يحدد القانون الإجراءات الأخرى للإنتخابات الرئاسية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_106_19761119_OpEnact_003e57fb5e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_106> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_106> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_106> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يمارس رئيس الجمهورية السلطة السامية في النطاق المبين في الدستور ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_107_19761119_OpEnact_808b301ca4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_107> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_107> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_107> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لا يؤهل أن ينتخب لرئاسة الجمهورية إلا من كانت له الجنسية الجزائرية أصلا، و يدين بالإسلام، و قد بلغ من العمر أربعين سنة (40) كاملة يوم الإنتخاب، و يتمتع بكامل حقوقه المدنية و السياسية ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_108_19761119_OpEnact_98d31d7ce2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_108> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_108> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_108> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "المدة الرئاسية ست سنوات . يمكن إعادة انتخاب رئيس الجمهورية ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_109_19761119_OpEnact_9555a3f903> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_109> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_109> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_109> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يتقلد رئيس الجمهورية مهامه في الأسبوع الموالي لانتخابه، و يؤدي اليمين أمام الشعب و بمحضر كل الهيئات العليا في الحزب و الدولة ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_10_19761119_OpEnact_4fecb4e0a3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_10> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_10> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_10> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "الاشتراكية اختيار الشعب الذي لا رجعة فيه، كما عبر عن ذلك بكامل السيادة في الميثاق الوطني. و هي السبيل الوحيد الكفيل باستكمال الإستقلال الوطني. مفهوم الإشتراكية ، طبقا لما ورد في الميثاق الوطني نصا و روحا، هو تعميق لثورة فاتح نوفمبر 1954 و نتيجة منطقية لها. الثورة الجزائرية ثورة اشتراكية تستهدف إزالة استغلال الإنسان للإنسان، شعارها : “من الشعب و إلى الشعب”."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_110_19761119_OpEnact_9a8ddc54ab> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_110> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_110> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_110> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يؤدي رئيس الجمهورية اليمين حسب النص الآتي : “وفاء للتضحيات الكبرى و لأرواح شهداء ثورتنا المقدسة أقسم بالله العلي العظيم أن أحترم الدين الإسلامي و أمجده ، و أن أحترم الميثاق الوطني و الدستور، و كل قوانين الجمهورية و أحميها ، و أن أحترم الإختيار الإشتراكي الذي لا رجعة فيه ، و أن أحافظ على سلامة التراب الوطني و حدة الشعب و الأمة ، و أن أحمي الحقوق و الحريات الأساسية للشعب و أعمل بدون هوادة على تطوره و سعادته، و أن أسعى بكل قواي من أجل تحقيق المثل العليا للعدالة و الحرية و السلم في العالم”."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_111_19761119_OpEnact_d213a9cfbe> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_111> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_111> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_111> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يضطلع رئيس الجمهورية ، بالإضافة إلى السلطات المخولة له بنص هذا الدستور، بالسلطات و الصلاحيات الآتية : يمثل الدولة داخل البلاد و خارجها. يجسد وحدة القيادة السياسية للحزب و الدولة. يحمي الدستور. يتولى القيادة العليا لجميع القوات المسلحة للجمهورية. يتولى مسئولية الدفاع الوطني. يقرر طبقا للميثاق الوطني و لأحكام الدستور، السياسة العامة للأمة في المجالين الداخلي و الخارجي، و يقوم بقيادتها و تنفيذها. يحدد صلاحيات أعضاء الحكومة طبقا لأحكام الدستور. يترأس مجلس الوزراء. يترأس الإجتماعات المشتركة لأجهزة الحزب و الدولة. يضطلع بالسلطة التنظيمية. يسهر على تنفيذ القوانين و التنظيمات. يعين الموظفين المدنيين و العسكريين، طبقا للقانون. له حق إصدار العفو و حق إلغاء العقوبات أو تخفيضها و كذلك حق إزالة كل النتائج القانونية، أيا كانت طبيعتها، و المترتبة على الأحكام التي تصدرها المحاكم. يمكن له أن يعمد لاستفتاء الشعب في كل القضايا ذات الأهمية الوطنية. يمكن له أن يفوض جزءا من صلاحياته لنائب رئيس الجمهورية و للوزير الأول مع مراعاة أحكام المادة 116 من الدستور. يعين سفراء الجمهورية و المفوضين فوق العادة للخارج و ينهي مهامهم، و يتسلم أوراق اعتماد الممثلين الدبلوماسيين الأجانب، و أوراق إنهاء مهامهم. يبرم المعاهدات الدولية و يصادق عليها وفقا لأحكام الدستور. يقلد أوسمة الدولة و نياشينها و ألقابها الشرفية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_112_19761119_OpEnact_d9cd26b4a7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_112> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_112> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_112> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يمكن لـ رئيس الجمهورية أن يعين نائبا لرئيس الجمهورية يساعده و يعينه في مهامه."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_113_19761119_OpEnact_c7bdb9aef2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_113> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_113> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_113> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يعين رئيس الجمهورية أعضاء الحكومة. يمكن لـ رئيس الجمهورية أن يعين وزيرا أول."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_114_19761119_OpEnact_0d47da32a9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_114> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_114> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_114> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تمارس الحكومة الوظيفة التنفيذية بقيادة رئيس الجمهورية ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_115_19761119_OpEnact_d7c59820d3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_115> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_115> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_115> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "نائب رئيس الجمهورية و الوزير الأول و أعضاء الحكومة مسئولون أثناء ممارسة كل منهم لمهامه، أمام رئيس الجمهورية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_116_19761119_OpEnact_27cefffe1c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_116> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_116> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_116> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لا يجوز بأي حال من الأحوال أن يفرض رئيس الجمهورية سلطته في تعيين نائب رئيس الجمهورية و الوزير الأول و أعضاء الحكومة، أو إعفائهم من مهامهم، و لا في إجراء استفتاء، أو في حل المجلس الشعبي الوطني، أو تنظيم انتخابات تشريعية مسبقة، و لا في تطبيق الأحكام المنصوص عليها في المواد 119 إلى 124 من الدستور، و كذلك السلطات الواردة في الفقرات من 4 إلى 9 و الفقرة 13 من المادة 111 من الدستور."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_117_19761119_OpEnact_8d86410625> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_117> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_117> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_117> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "في حالة وفاة رئيس الجمهورية أو استقالته ، يجتمع المجلس الشعبي الوطني، وجوبا، و يثبت حالة الشغور النهائي لرئاسة الجمهورية. يتولى رئيس المجلس الشعبي الوطني مهام رئيس الدولة لمدة أقصاها خمسة و أربعون يوما ( 45 ) تنظم خلالها انتخابات رئاسية. ولا يحق لرئيس المجلس الشعبي الوطني أن يكون مرشحا لرئاسة الجمهورية. يستدعى مؤتمر استثنائي للحزب قصد تعيين المرشح لرئاسة الجمهورية. يمارس رئيس الجمهورية المنتخب مهامه طبقا لأحكام المادة 108 من الدستور."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_118_19761119_OpEnact_a2713cdac1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_118> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_118> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_118> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "لا يمكن حل أو تعديل الحكومة القائمة إبان وفاة أو استقالة رئيس الجمهورية إلى أن يتسلم رئيس الجمهورية الجديد مهامه . لا يمكن أثناء فترة الخمسة و الأربعين يوما ( 45 ) المشار إليها في الفقرة الثانية من المادة 117 من الدستور، تطبيق أحكام المادتين 112 و 113 و لا أحكام الفقرات 7 و 13 و 14 من المادة 111 و لا أحكام المادتين 123 و 163 من الدستور . لا يمكن أثناء نفس الفترة، إنهاء مهام نائب رئيس الجمهورية و الوزير الأول . كما لا يمكن تطبيق أحكام المواد 120 و 121 و 122 و 124 من الدستور إلا بموافقة المجلس الشعبي الوطني مع الاستشارة المسبقة لقيادة الحزب ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_119_19761119_OpEnact_751803705f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_119> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_119> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_119> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "في حالة الضرورة الملحة ، يقرر رئيس الجمهورية ، في اجتماع لهيئات الحزب العليا و الحكومة ، حالة الطوارئ أو الحصار ، و يتخذ كل الإجراءات اللازمة لاستتباب الوضع."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_11_19761119_OpEnact_b7a8b107a9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_11> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_11> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_11> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تتوخى الإشتراكية تحقيق تطور البلاد، و تحويل العمال و الفلاحين إلى منتخبين واعين و مسئولين، و نشر العدالة الإجتماعية، و توفير أسباب تفتح شخصية المواطن. تحدد الثورة الإشتراكية خطوط عملها الأساسية للتعجيل بترقية الإنسان إلى مستوى من العيش يتلاءم و ظروف الحياة العصرية، و تمكين الجزائر من إرساء قاعدة اجتماعية اقتصادية متحررة من الإستغلال و التخلف. سيحظى النظام الاجتماعي والإقتصادي الذي ترتكز عليه الإشتراكية بالتطوير المستمر، بحيث يستفيد من مزايا الرقى العلمي و التقني."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_120_19761119_OpEnact_cdaf3a041f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_120> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_120> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_120> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "إذا كانت البلاد مهددة بخطر وشيك الوقوع على مؤسساتها، أو على استقلالها، أو سلامة ترابها ، يقرر رئيس الجمهورية الحالة الإستثنائية . يتدخل مثل هذا الإجراء أثناء اجتماع الهيئات العليا للحزب و الحكومة . تخول الحالة الاستثنائية لرئيس الجمهورية أن يتخذ الإجراءات الخاصة التي تتطلبها المحافظة على استقلال الأمة و مؤسسات الجمهورية. يجتمع المجلس الشعبي الوطني ، وجوبا، باستدعاء من رئيسه . تنتهي الحالة الإستثنائية حسب نفس الأشكال، و بناء على نفس الإجراءات المذكورة أعلاه التي أدت إلى تقريرها."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_121_19761119_OpEnact_c7d6a2adaa> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_121> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_121> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_121> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يقرر رئيس الجمهورية التعبئة العامة ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_122_19761119_OpEnact_1c43a1e600> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_122> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_122> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_122> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "في حالة وقوع عدوان فعلي أو وشيك الحصول، حسبما نصت عليه الترتيبات الملائمة لميثاق الأمم المتحدة ، يعلن رئيس الجمهورية الحرب، بعد استشارة هيأة الحزب القيادية و اجتماع الحكومة و الإستماع إلى المجلس الأعلى للأمن . يجتمع المجلس الشعبي الوطني ، بحكم القانون . يوجه رئيس الجمهورية خطابا للأمة يعلمها بذلك."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_123_19761119_OpEnact_21d66ffd6e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_123> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_123> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_123> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يوقف العمل بالدستور مدة حالة الحرب و يتولى رئيس الدولة جميع السلطات ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_124_19761119_OpEnact_dabf8c86d0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_124> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_124> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_124> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يوافق رئيس الجمهورية على الهدنة و السلم. تقدم اتفاقيات الهدنة و معاهدات السلم، فورا، إلى الموافقة الصريحة للهيئة القيادية للحزب طبقا لقانونه الأساسي . كما تعرض على المجلس الشعبي الوطني ، طبقا لأحكام المادة 158 من الدستور ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_125_19761119_OpEnact_a0a9c3fa9d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_125> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_125> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_125> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يؤسس مجلس أعلى للأمن برئاسة رئيس الجمهورية ، مهمته تقديم الآراء حول كل القضايا المتعلقة بالأمن الوطني، إلى رئيس الجمهورية . يحدد رئيس الجمهورية طرق تنظيم المجلس الأعلى للأمن و تسييره."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_126_19761119_OpEnact_5230482c3b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_126> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_126> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_126> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يمارس الوظيفة التشريعية مجلس واحد يسمى المجلس الشعبي الوطني . للمجلس الشعبي الوطني، في نطاق اختصاصاته، سلطة التشريع بكامل السيادة . يعد المجلس الشعبي الوطني القوانين و يصوت عليها ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_127_19761119_OpEnact_6c34838be7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_127> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_127> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_127> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "تتمثل المهمة الأساسية للمجلس الشعبي الوطني، ضمن اختصاصاته، في العمل للدفاع عن الثورة الإشتراكية و تعزيزها. يستلهم المجلس الشعبي الوطني، في نشاطه التشريعي، مبادئ الميثاق الوطني و يطبقها ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_128_19761119_OpEnact_b7e25d9de4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_128> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_128> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_128> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "ينتخب أعضاء المجلس الشعبي الوطني ، بناء على ترشيح من قيادة الحزب، عن طريق الإقتراع العام المباشر و السري."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_129_19761119_OpEnact_8396142e81> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_129> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_129> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_129> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "ينتخب المجلس الشعبي الوطني لمدة خمس سنوات. لا يمكن تمديد فترة هذه النيابة إلا في ظروف خطيرة للغاية لا تسمح بإجراء انتخابات عادية . و تثبت هذه الحالة بمقتضى قرار من المجلس الشعبي الوطني، بناء على اقتراح من رئيس الجمهورية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_12_19761119_OpEnact_8bc06bb952> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_12> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_12> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_12> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "ترمي الإشتراكية إلى تحقيق أهداف ثلاثة : دعم الاستقلال الوطني . إقامة مجتمع متحرر من استغلال الإنسان للإنسان. ترقية الإنسان و توفير أسباب تفتح شخصيته و ازدهارها. و تعود إلى مؤسسات الحزب و الدولة مهمة تحقيق هذه الأهداف المتكاملة المتلازمة."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_130_19761119_OpEnact_443bce9bd9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_130> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_130> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_130> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "يحدد القانون طرق انتخاب النواب، و بخاصة عددهم، و شروط قابليتهم للانتخاب، و حالات التنافي مع شروط العضوية في المجلس. يجب أن يكون تأليف المجلس الشعبي الوطني مطابقا لأحكام المادتين 8 و 9 من الدستور ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_131_19761119_OpEnact_e5fa2cb1c7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_131> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_131> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_131> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "إثبات صحة الانتخابات التشريعية من اختصاص المجلس الشعبي الوطني ."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_132_19761119_OpEnact_084304e7c7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_132> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1976-11-19/1976#art_132> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_132> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:versionText "النيابة في المجلس الشعبي الوطني ذات طابع وطني."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_133_19761119_OpEnact_3f6dbbad59> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
