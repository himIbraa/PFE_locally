<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_141> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبتدئ الفترة التشريعية، وجوبا، في اليوم الثامن الموالي لتاريخ انتخاب المجلس الشعبي الوطني ، تحت رئاسة أكبر النواب سنا و بمساعده أصغر نائبين منهم . ينتخب المجلس مكتبه و يشكل لجانه."@ar ;
