<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_92> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يشكل الكفاح ضد الإستعمار، و الإستعمار الجديد، و الإمبريالية، و التمييز العنصري، محورا أساسيا للثورة. يشكل تضامن الجزائر مع كل الشعوب في إفريقيا وآسيا وأمريكا اللاتينية، في كفاحها من أجل تحررها السياسي والاقتصادي، من أجل حقها في تقرير المصير والاستقلال ، بعدا أساسيا للسياسة الوطنية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_92_19761119_OpEnact_74524d59cd> ;
    dzdoc:replacementText "يشكل الكفاح ضد الإستعمار، و الإستعمار الجديد، و الإمبريالية، و التمييز العنصري، محورا أساسيا للثورة. يشكل تضامن الجزائر مع كل الشعوب في إفريقيا وآسيا وأمريكا اللاتينية، في كفاحها من أجل تحررها السياسي والاقتصادي، من أجل حقها في تقرير المصير والاستقلال ، بعدا أساسيا للسياسة الوطنية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_92> ;
