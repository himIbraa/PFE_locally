    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 48" ;
    dzdoc:position 47 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "لا يتابع أحد و لا يلقى عليه القبض أو يحبس إلا في الحالات المحددة بالقانون و طبقا للإشكال التي نص عليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_51_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_51_19761119_OpEnact_7e728c1136> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:introducedOn "1976-11-19"^^xsd:date ;
    dzdoc:number "المادة 51" ;
    dzdoc:position 50 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1976-11-19/1976#art_51_condition_0_84adaf82> .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#chp_الأول_المبادئ_الأساسية_لتنظيم_المجتمع_الجزائري_sec_الرابع_الحريات_الأساسية_و_حقوق_الإنسان_و_المواطن> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "لا مساس بحرية المعتقد و لا بحرية الرأي ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1976-11-19/1976#art_53_right_0_bd43c62a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1976-11-19/1976#art_53_para_0> ;
