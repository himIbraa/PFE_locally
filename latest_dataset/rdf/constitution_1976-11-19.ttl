<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_126> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمارس الوظيفة التشريعية مجلس واحد يسمى المجلس الشعبي الوطني . للمجلس الشعبي الوطني، في نطاق اختصاصاته، سلطة التشريع بكامل السيادة . يعد المجلس الشعبي الوطني القوانين و يصوت عليها ."@ar ;
