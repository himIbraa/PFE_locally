<https://legal.dz/resource/constitution/1976-11-19/1976#art_87_obligation_0_8a25a862_role_b55b982b37> a dznorm:Role ;
    rdfs:label "تحرير الجماهير الشعبية"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "تلتزم الجزائر، كلما تهيأت الظروف الملائمة لقيام وحدة مبنية على تحرير الجماهير الشعبية، باعتماد صيغ للوحدة أو للإتحاد أو للإندماج، كفيلة بالتلبية الكاملة للمطامح المشروعة و العميقة للشعوب العربية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_87> .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_87_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_87> ;
    dzdoc:position 0 ;
    dzdoc:text "تندرج وحدة الشعوب العربية في وحدة مصير هذه الشعوب."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_87_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_87> ;
    dzdoc:position 1 ;
    dzdoc:text "تلتزم الجزائر، كلما تهيأت الظروف الملائمة لقيام وحدة مبنية على تحرير الجماهير الشعبية، باعتماد صيغ للوحدة أو للإتحاد أو للإندماج، كفيلة بالتلبية الكاملة للمطامح المشروعة و العميقة للشعوب العربية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_87_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_87> ;
    dzdoc:position 2 ;
    dzdoc:text "وحدة الشعوب المغربية المستهدفة صالح الجماهير الشعبية، تتجسد كاختيار أساسي للثورة الجزائرية."@ar .

<https://legal.dz/resource/constitution/1976-11-19/1976#art_88_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1976-11-19/1976#art_88> ;
    dzdoc:position 0 ;
    dzdoc:text "تحقيق أهداف منظمة الوحدة الإفريقية و تشجيع الوحدة بين شعوب القارة يشكلان مطلبا تاريخيا و يندرجان كخط دائم في سياسة الثورة الجزائرية."@ar .

