<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_134> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل نائب لا يستوفي شروط النيابة أو أصبح غير مستوف لها ، يتعرض لإسقاط صفته النيابية. يقرر المجلس الشعبي الوطني هذا الإسقاط بأغلبية أعضائه."@ar ;
