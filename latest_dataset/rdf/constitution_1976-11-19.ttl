<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_67> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لكل المواطنين الحق في الرعاية الصحية . و هذا الحق مضمون عن طريق توفير خدمات صحية عامة و مجانية، و بتوسيع مجال الطب الوقائي، و التحسين الدائم لظروف العيش و العمل، و كذلك عن طريق ترقية التربية البدنية و الرياضية و وسائل الترفيه."@ar ;
