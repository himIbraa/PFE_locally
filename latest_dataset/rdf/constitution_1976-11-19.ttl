<https://legal.dz/resource/constitution/1976-11-19/1976#version_art_111> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يضطلع رئيس الجمهورية ، بالإضافة إلى السلطات المخولة له بنص هذا الدستور، بالسلطات و الصلاحيات الآتية : يمثل الدولة داخل البلاد و خارجها. يجسد وحدة القيادة السياسية للحزب و الدولة. يحمي الدستور. يتولى القيادة العليا لجميع القوات المسلحة للجمهورية. يتولى مسئولية الدفاع الوطني. يقرر طبقا للميثاق الوطني و لأحكام الدستور، السياسة العامة للأمة في المجالين الداخلي و الخارجي، و يقوم بقيادتها و تنفيذها. يحدد صلاحيات أعضاء الحكومة طبقا لأحكام الدستور. يترأس مجلس الوزراء. يترأس الإجتماعات المشتركة لأجهزة ال"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1976-11-19/1976#version_art_111_19761119_OpEnact_d213a9cfbe> ;
    dzdoc:replacementText "يضطلع رئيس الجمهورية ، بالإضافة إلى السلطات المخولة له بنص هذا الدستور، بالسلطات و الصلاحيات الآتية : يمثل الدولة داخل البلاد و خارجها. يجسد وحدة القيادة السياسية للحزب و الدولة. يحمي الدستور. يتولى القيادة العليا لجميع القوات المسلحة للجمهورية. يتولى مسئولية الدفاع الوطني. يقرر طبقا للميثاق الوطني و لأحكام الدستور، السياسة العامة للأمة في المجالين الداخلي و الخارجي، و يقوم بقيادتها و تنفيذها. يحدد صلاحيات أعضاء الحكومة طبقا لأحكام الدستور. يترأس مجلس الوزراء. يترأس الإجتماعات المشتركة لأجهزة الحزب و الدولة. يضطلع بالسلطة التنظيمية. يسهر على تنفيذ القوانين و التنظيمات. يعين الموظفين المدنيين و العسكريين، طبقا للقانون. له حق إصدار العفو و حق إلغاء العقوبات أو تخفيضها و كذلك حق إزالة كل النتائج القانونية، أيا كانت طبيعتها، و المترتبة على الأحكام التي تصدرها المحاكم. يمكن له أن يعمد لاستفتاء الشعب في كل القضايا ذات الأهمية الوطنية. يمكن له أن يفوض جزءا من صلاحياته لنائب رئيس الجمهورية و للوزير الأول مع مراعاة أحكام المادة 116 من الدستور. يعين سفراء الجمهورية و المفوضين فوق العادة للخارج و ينهي مهامهم، و يتسلم أوراق اعتماد الممثلين الدبلوماسيين الأجانب، و أوراق إنهاء مهامهم. يبرم المعاهدات الدولية و يصادق عليها وفقا لأحكام الدستور. يقلد أوسمة الدولة و نياشينها و ألقابها الشرفية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_111> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1976-11-19/1976#art_111> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1976-11-19/1976> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1976-11-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

