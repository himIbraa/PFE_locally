<https://legal.dz/resource/organic-law/2005-07-17/05-11#version_art_16> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2005-07-17/05-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد رئيس المحكمة بموجب أمر ، وبعد استطلاع رأي وكيل الجمهورية ، توزيع قضاة الحكم في بداية كل سنة قضائية على الأقسام أو الفروع عند الاقتضاء. ويجوز له أن يرأس أي قسم. يمكن تعيين نفس القاضي في أكثر من قسم أو فرع. في حالة حدوث مانع لأحد القضاة يستخلف بقاض آخر بأمر من رئيس المحكمة ، بعد استطلاع رأي وكيل الجمهورية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2005-07-17/05-11#version_art_16_20050717_OpEnact_36503ed90e> ;
    dzdoc:replacementText "يحدد رئيس المحكمة بموجب أمر ، وبعد استطلاع رأي وكيل الجمهورية ، توزيع قضاة الحكم في بداية كل سنة قضائية على الأقسام أو الفروع عند الاقتضاء. ويجوز له أن يرأس أي قسم. يمكن تعيين نفس القاضي في أكثر من قسم أو فرع. في حالة حدوث مانع لأحد القضاة يستخلف بقاض آخر بأمر من رئيس المحكمة ، بعد استطلاع رأي وكيل الجمهورية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2005-07-17/05-11#art_16> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2005-07-17/05-11> ;
