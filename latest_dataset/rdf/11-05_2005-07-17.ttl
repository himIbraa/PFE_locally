<https://legal.dz/resource/organic-law/2005-07-17/05-11#art_14_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2005-07-17/05-11#art_14> ;
    dzdoc:position 0 ;
    dzdoc:text "يرأس أقسام المحكمة قضاة حسب تخصصاتهم."@ar .

<https://legal.dz/resource/organic-law/2005-07-17/05-11#art_15_para_0> a dzdoc:Paragraph ;
