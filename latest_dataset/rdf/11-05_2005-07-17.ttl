    dzdoc:versionSourceDocument <https://legal.dz/resource/organic-law/2005-07-17/05-11> ;
    dzdoc:versionText "تلغى جميع الأحكام المخالفة لهذا القانون العضوي، لا سيما أحكام الأمر رقم 65-278 المؤرخ في 22 رجب عام 1385 الموافق 16 نوفمبر سنة 1965 والمذكور أعلاه."@ar .

<https://legal.dz/resource/organic-law/2005-07-17/05-11#version_art_21_20050717_OpEnact_3f6474ab41> a dzdoc:ArticleVersion ;
