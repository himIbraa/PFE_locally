<https://legal.dz/resource/organic-law/2005-07-17/05-11#version_art_9> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2005-07-17/05-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد رئيس المجلس القضائي بموجب أمر ، توزيع القضاة على الغرف، وعند الاقتضاء على الأقسام، في بداية كل سنة قضائية، بعد استطلاع رأي النائب العام . ويجوز له أن يرأس أية غرفة . يمكن تعيين نفس القاضي في أكثر من غرفة أو قسم. في حالة حدوث مانع لرئيس المجلس القضائي يستخلفه نائبه، وإذا تعذر ذلك ينوبه أقدم رئيس غرفة. في حالة حدوث مانع لأحد القضاة يستخلف بقاض آخر بموجب أمر من رئيس المجلس القضائي ، بعد استطلاع رأي النائب العام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2005-07-17/05-11#version_art_9_20050717_OpEnact_faa86b1c71> ;
    dzdoc:replacementText "يحدد رئيس المجلس القضائي بموجب أمر ، توزيع القضاة على الغرف، وعند الاقتضاء على الأقسام، في بداية كل سنة قضائية، بعد استطلاع رأي النائب العام . ويجوز له أن يرأس أية غرفة . يمكن تعيين نفس القاضي في أكثر من غرفة أو قسم. في حالة حدوث مانع لرئيس المجلس القضائي يستخلفه نائبه، وإذا تعذر ذلك ينوبه أقدم رئيس غرفة. في حالة حدوث مانع لأحد القضاة يستخلف بقاض آخر بموجب أمر من رئيس المجلس القضائي ، بعد استطلاع رأي النائب العام."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2005-07-17/05-11#art_9> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2005-07-17/05-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/organic-law/2005-07-17/05-11#art_9> ;
    dzdoc:targetDocument <https://legal.dz/resource/organic-law/2005-07-17/05-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2005-07-17"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

