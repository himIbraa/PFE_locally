<https://legal.dz/resource/organic-law/2005-07-17/05-11#art_6_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2005-07-17/05-11#art_6> ;
    dzdoc:position 0 ;
    dzdoc:text "يشمل المجلس القضائي الغرف الآتية : الغرفة المدنية، الغرفة الجزائية، غرفة الاتهام، الغرفة الاستعجالية، غرفة شؤون الأسرة، غرفة الأحداث، الغرفة الاجتماعية، الغرفة العقارية، الغرفة البحرية، الغرفة التجارية."@ar .

