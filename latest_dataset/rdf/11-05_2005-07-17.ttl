<https://legal.dz/resource/organic-law/2005-07-17/05-11#version_art_13> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2005-07-17/05-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقسم المحكمة إلى الأقسام الآتية : القسم المدني، قسم الجنح، قسم المخالفات، القسم الاستعجالي، قسم شؤون الأسرة، قسم الأحداث، القسم الاجتماعي، القسم العقاري، القسم البحري، القسم التجاري. غير أنه يمكن رئيس المحكمة ، بعد استطلاع رأي وكيل الجمهورية ، تقليص عدد الأقسام أو تقسيمها إلى فروع حسب أهمية وحجم النشاط القضائي. بفصل كل قسم في القضايا المعروضة عليه، ما لم ينص القانون على خلاف ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2005-07-17/05-11#version_art_13_20050717_OpEnact_684a2ccd05> ;
    dzdoc:replacementText "تقسم المحكمة إلى الأقسام الآتية : القسم المدني، قسم الجنح، قسم المخالفات، القسم الاستعجالي، قسم شؤون الأسرة، قسم الأحداث، القسم الاجتماعي، القسم العقاري، القسم البحري، القسم التجاري. غير أنه يمكن رئيس المحكمة ، بعد استطلاع رأي وكيل الجمهورية ، تقليص عدد الأقسام أو تقسيمها إلى فروع حسب أهمية وحجم النشاط القضائي. بفصل كل قسم في القضايا المعروضة عليه، ما لم ينص القانون على خلاف ذلك."@ar ;
