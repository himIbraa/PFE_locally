<https://legal.dz/resource/organic-law/2005-07-17/05-11#version_art_6> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2005-07-17/05-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يشمل المجلس القضائي الغرف الآتية : الغرفة المدنية، الغرفة الجزائية، غرفة الاتهام، الغرفة الاستعجالية، غرفة شؤون الأسرة، غرفة الأحداث، الغرفة الاجتماعية، الغرفة العقارية، الغرفة البحرية، الغرفة التجارية. غير أنه يمكن رئيس المجلس القضائي ، بعد استطلاع رأي النائب العام ، تقليص عدد الغرف أو تقسيمها إلى أقسام حسب أهمية وحجم النشاط القضائي. تفصل كل غرفة في القضايا المعروضة عليها، ما لم ينص القانون على خلاف ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2005-07-17/05-11#version_art_6_20050717_OpEnact_dd405fd5e0> ;
    dzdoc:replacementText "يشمل المجلس القضائي الغرف الآتية : الغرفة المدنية، الغرفة الجزائية، غرفة الاتهام، الغرفة الاستعجالية، غرفة شؤون الأسرة، غرفة الأحداث، الغرفة الاجتماعية، الغرفة العقارية، الغرفة البحرية، الغرفة التجارية. غير أنه يمكن رئيس المجلس القضائي ، بعد استطلاع رأي النائب العام ، تقليص عدد الغرف أو تقسيمها إلى أقسام حسب أهمية وحجم النشاط القضائي. تفصل كل غرفة في القضايا المعروضة عليها، ما لم ينص القانون على خلاف ذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2005-07-17/05-11#art_6> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2005-07-17/05-11> ;
