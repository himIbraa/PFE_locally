<https://legal.dz/resource/organic-law/2005-07-17/05-11#art_16_obligation_0_58aaf9d2> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/organic-law/2005-07-17/05-11#art_16_obligation_0_58aaf9d2_role_5499680618> ;
