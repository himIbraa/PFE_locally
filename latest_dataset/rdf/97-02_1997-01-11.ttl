<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_3_extref_8a588d34> a dzdoc:ExternalReference ;
    rdfs:label "المادة 52 مكرر 2"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1990-04-21/90-11#art_52bis2"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1990-04-21/90-11#art_52bis2"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1990-04-21/90-11#art_52bis2" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1990-04-21/90-11"^^xsd:anyURI ;
    dzdoc:targetEId "art_52bis2" .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_3_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_3> ;
    dzdoc:position 0 ;
    dzdoc:text "تدرج ضمن القانون رقم 90 - 11 المؤرخ في 26 رمضان عام 1410 الموافق 21 أبريل سنة 1990 المادة 52 مكرر 2، وتحرر كما يأتي:"@ar .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_3_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_3> ;
    dzdoc:position 1 ;
    dzdoc:text "\" المادة 52 مكرر 2 : تغطى النفقات المتعلقة بتسديد تعويض العطلة المذكورة في المادة 52 مكرر أعلاه، وكذا مصاريف التسيير، بواسطة اشتراك على عاتق الهيئات المستخدمة دون سواها."@ar .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_3_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_3> ;
    dzdoc:position 2 ;
    dzdoc:text "تحدد نسبة هذا الاشتراك وكيفيات تحصيله عن طريق التنظيم\"."@ar .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_4_extref_7dfc639f> a dzdoc:ExternalReference ;
    rdfs:label "القانون رقم 90 - 11 المؤرخ في 26 رمضان عام 1410 الموافق 21 أبريل سنة 1990"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1990-04-21/90-11"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1990-04-21/90-11"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1990-04-21/90-11" ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/1990-04-21/90-11> ;
    dzdoc:resolutionReason "canonical_akn_path_alias" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1990-04-21/90-11"^^xsd:anyURI .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_4_extref_b94f2875> a dzdoc:ExternalReference ;
    rdfs:label "المادة 52 مكرر 3"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1990-04-21/90-11#art_52bis3"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1990-04-21/90-11#art_52bis3"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1990-04-21/90-11#art_52bis3" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1990-04-21/90-11"^^xsd:anyURI ;
    dzdoc:targetEId "art_52bis3" .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_4_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_4> ;
    dzdoc:position 0 ;
    dzdoc:text "تدرج ضمن القانون رقم 90 - 11 المؤرخ في 26 رمضان عام 1410 الموافق 21 أبريل سنة 1990 المادة 52 مكرر 3، وتحرر كما يأتي :"@ar .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_4_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_4> ;
    dzdoc:position 1 ;
    dzdoc:text "\" المادة 52 مكرر 3: يحدد عن طريق التنظيم إنشاء الصندوق الخاص المنصوص عليه في هذا الأمر وكذا شروط سيره وكيفياته\"."@ar .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_5_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_5> ;
    dzdoc:position 0 ;
    dzdoc:text "ينشر هذا الأمر في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية."@ar .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_5_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_5> ;
    dzdoc:position 1 ;
    dzdoc:text "حرر بالجزائر في 2 رمضان عام 1417 الموافق 11 يناير سنة 1997."@ar .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_5_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_5> ;
    dzdoc:position 2 ;
    dzdoc:text "اليمين زروال"@ar .

