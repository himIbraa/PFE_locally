<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2_obligation_0_7309d7a5> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasActivity <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2_obligation_0_7309d7a5_activity_a0f8dcfbd4> ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2_obligation_0_7309d7a5_period_3d767a197d>,
        <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2_obligation_0_7309d7a5_period_b138cac37d> ;
    dznorm:expressedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2> ;
    dznorm:position 0 ;
    dznorm:provisionText "يسدد صندوق خاص تعويض العطلة السنوية المستحقة لعمال المهن والفروع وقطاعات النشاط الذين لا يشتغلون عادة بصفة مستمرة عند نفس الهيئة المستخدمة خلال المدة المعتمدة لتقدير الحق في العطلة"@ar ;
    dznorm:sourceArticle "art_2" .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2_obligation_0_7309d7a5_activity_a0f8dcfbd4> a dznorm:Activity ;
    rdfs:label "نشاط الذين لا يشتغلون عادة بصفة مستمرة عند نف"@ar ;
    dzdoc:confidenceScore 0.6 ;
    dzdoc:extractionMethod "lexical_activity_pattern" ;
    dzdoc:sourceTextSpan "يسدد صندوق خاص تعويض العطلة السنوية المستحقة لعمال المهن والفروع وقطاعات النشاط الذين لا يشتغلون عادة بصفة مستمرة عند نفس الهيئة المستخدمة خلال المدة المعتمدة لتقدير الحق في العطلة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2> .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2_obligation_0_7309d7a5_period_3d767a197d> a dznorm:Period ;
    rdfs:label "خلال المدة المعتمدة لتقدير الحق في"@ar ;
    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "يسدد صندوق خاص تعويض العطلة السنوية المستحقة لعمال المهن والفروع وقطاعات النشاط الذين لا يشتغلون عادة بصفة مستمرة عند نفس الهيئة المستخدمة خلال المدة المعتمدة لتقدير الحق في العطلة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2> .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2_obligation_0_7309d7a5_period_b138cac37d> a dznorm:Period ;
    rdfs:label "لمدة المعتمدة لتقدير الحق في العطلة"@ar ;
    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "يسدد صندوق خاص تعويض العطلة السنوية المستحقة لعمال المهن والفروع وقطاعات النشاط الذين لا يشتغلون عادة بصفة مستمرة عند نفس الهيئة المستخدمة خلال المدة المعتمدة لتقدير الحق في العطلة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2> .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2_obligation_1_cc717836> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2> ;
    dznorm:position 1 ;
    dznorm:provisionText "تنخرط الهيئات المستخدمة المذكورة أعلاه وجوبا في هذا الصندوق"@ar ;
    dznorm:sourceArticle "art_2" .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2> ;
    dzdoc:position 0 ;
    dzdoc:text "تدرج ضمن القانون رقم 90 - 11 المؤرخ في 26 رمضان عام 1410 الموافق 21 أبريل سنة 1990 المادة 52 مكرر، وتحرر كما يأتي :"@ar .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2> ;
    dzdoc:position 1 ;
    dzdoc:text "\" المادة 52 مكرر : يسدد صندوق خاص تعويض العطلة السنوية المستحقة لعمال المهن والفروع وقطاعات النشاط الذين لا يشتغلون عادة بصفة مستمرة عند نفس الهيئة المستخدمة خلال المدة المعتمدة لتقدير الحق في العطلة."@ar .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2> ;
    dzdoc:position 2 ;
    dzdoc:text "تنخرط الهيئات المستخدمة المذكورة أعلاه وجوبا في هذا الصندوق."@ar .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_2> ;
    dzdoc:position 3 ;
    dzdoc:text "تحدد المهن والفروع وقطاعات النشاط المذكورة أعلاه عن طريق التنظيم\"."@ar .

<https://legal.dz/resource/law/1997-01-11/97-02_1997-01-11#art_3_extref_7dfc639f> a dzdoc:ExternalReference ;
    rdfs:label "القانون رقم 90 - 11 المؤرخ في 26 رمضان عام 1410 الموافق 21 أبريل سنة 1990"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1990-04-21/90-11"^^xsd:anyURI ;
