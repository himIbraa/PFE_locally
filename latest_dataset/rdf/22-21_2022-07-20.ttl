<https://legal.dz/resource/law/2022-07-20/22-21#version_art_56_bis_20220720_OpEnact_355243635f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2022-07-20"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2022-07-20/22-21#version_art_56_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2022-07-20/22-21> ;
    dzdoc:versionText "يحق للعامل الاستفادة، مرة واحدة (1) خلال مساره المهني من عطلة غير مدفوعة الأجر لإنشاء مؤسسة . كما يحق للعامل اللجوء إلى العمل بالتوقيت الجزئي لإنشاء مؤسسة طبقا لأحكام التشريع والتنظيم المعمول بهما\"."@ar .

<https://legal.dz/resource/law/2022-07-20/22-21#version_art_56_bis_4_20220720_OpEnact_efaf8d60b3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2022-07-20"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2022-07-20/22-21#version_art_56_bis_4> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis_4> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis_4> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2022-07-20/22-21> ;
    dzdoc:versionText "يمكن العامل، في حالة عدم إنجاز مشروعه في الآجال المحددة، أن يطلب إعادة إدماجه في منصب عمله أو إعادة تشغيله بالتوقيت الكامل ، في أجل شهر واحد (1) على الأقل، قبل انتهاء فترة العطلة أو فترة العمل بالتوقيت الجزئي لإنشاء مؤسسة\"."@ar .

