    dzdoc:versionText "تتمم أحكام القانون رقم 90-11 المؤرخ في 26 رمضان عام 1410 الموافق 21 أبريل سنة 1990 والمذكور أعلاه، بمواد 56 مكرر و 56 مكرر 1 و 56 مكرر 2 و 56 مكرر 3 و 56 مكرر 4 و 56 مكرر 5 و 56 مكرر 6 ، وتحرر كما يأتي :"@ar .

<https://legal.dz/resource/law/2022-07-20/22-21#version_art_3_20220720_OpEnact_ca312c77c0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2022-07-20"^^xsd:date ;
