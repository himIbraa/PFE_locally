    dznorm:conditionText "إذا لم يقدم طلب إعادة إدماجه في الآجال المحددة بموجب أحكام المادة 56 مكرر 4 أعلاه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis_5> ;
