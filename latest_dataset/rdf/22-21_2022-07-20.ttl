<https://legal.dz/resource/law/2022-07-20/22-21#version_art_1_20220720_OpEnact_36eb5ea799> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2022-07-20"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
