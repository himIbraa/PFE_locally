<https://legal.dz/resource/law/2022-07-20/22-21#art_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-20/22-21#art_1> ;
    dzdoc:position 0 ;
    dzdoc:text "يهدف هذا القانون إلى تتميم أحكام القانون رقم 90-11 المؤرخ في 26 رمضان عام 1410 الموافق 21 أبريل سنة 1990 والمتعلق بعلاقات العمل المعدل والمتمم"@ar .

<https://legal.dz/resource/law/2022-07-20/22-21#art_2_extref_7dfc639f> a dzdoc:ExternalReference ;
