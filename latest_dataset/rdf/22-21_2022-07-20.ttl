    dzdoc:sourceTextSpan "إذا لم يقدم طلب إعادة إدماجه في الآجال المحددة بموجب أحكام المادة 56 مكرر 4 أعلاه"@ar ;
    dzdoc:targetEId "art_56_bis_4" .

<https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis_5_obligation_0_e03ee3b3> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis_5> ;
    dznorm:position 0 ;
    dznorm:provisionText "تنتهي علاقة العمل إذا أنجز العامل مؤسسته"@ar ;
    dznorm:sourceArticle "art_56_bis_5" .

<https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis_5_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis_5> ;
    dzdoc:position 0 ;
    dzdoc:text "دون الإخلال بالأحكام التشريعية والتنظيمية المعمول بها تنتهي علاقة العمل إذا أنجز العامل مؤسسته، وعند الاقتضاء، إذا لم يقدم طلب إعادة إدماجه في الآجال المحددة بموجب أحكام المادة 56 مكرر 4 أعلاه\"."@ar .

<https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "يحق للعامل الاستفادة، مرة واحدة (1) خلال مساره المهني من عطلة غير مدفوعة الأجر لإنشاء مؤسسة."@ar .

<https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis> ;
    dzdoc:position 1 ;
    dzdoc:text "كما يحق للعامل اللجوء إلى العمل بالتوقيت الجزئي لإنشاء مؤسسة طبقا لأحكام التشريع والتنظيم المعمول بهما\"."@ar .

