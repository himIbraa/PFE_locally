<https://legal.dz/resource/law/2022-07-20/22-21#art_2_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-20/22-21#art_2> ;
    dzdoc:position 0 ;
    dzdoc:text "تتمم أحكام القانون رقم 90-11 المؤرخ في 26 رمضان عام 1410 الموافق 21 أبريل سنة 1990 والمذكور أعلاه، بمواد 56 مكرر و 56 مكرر 1 و 56 مكرر 2 و 56 مكرر 3 و 56 مكرر 4 و 56 مكرر 5 و 56 مكرر 6، وتحرر كما يأتي :"@ar .

<https://legal.dz/resource/law/2022-07-20/22-21#art_3_extref_0453db64> a dzdoc:ExternalReference ;
    rdfs:label "المادة 64 من القانون رقم 90-11 المؤرخ في 26 رمضان عام 1410 الموافق 21 أبريل سنة 1990"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1990-04-21/90-11#art_64"^^xsd:anyURI ;
