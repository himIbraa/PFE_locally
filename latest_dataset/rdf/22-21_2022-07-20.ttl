<https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis_5_condition_0_0d83e327> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2022-07-20/22-21#art_56_bis_5_condition_0_0d83e327_ref_fa7982921e80> ;
