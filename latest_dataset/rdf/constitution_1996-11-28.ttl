<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_17> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الملكية العامة هي ملك المجموعة الوطنية . وتشمل باطن الأرض، والمناجم، والمقالع، والموارد الطبيعية للطاقة، والثروات المعدنية الطبيعية والحية، في مختلف مناطق الأملاك الوطنية البحرية، والمياه، والغابات. كما تشمل النقل بالسكك الحديدية، والنقل البحري والجوي، والبريد والمواصلات السلكية واللاسلكية، وأملاكا أخرى محددة في القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_17_19961128_OpEnact_145ff6b28d> ;
    dzdoc:replacementText "الملكية العامة هي ملك المجموعة الوطنية . وتشمل باطن الأرض، والمناجم، والمقالع، والموارد الطبيعية للطاقة، والثروات المعدنية الطبيعية والحية، في مختلف مناطق الأملاك الوطنية البحرية، والمياه، والغابات. كما تشمل النقل بالسكك الحديدية، والنقل البحري والجوي، والبريد والمواصلات السلكية واللاسلكية، وأملاكا أخرى محددة في القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_17> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_17> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1996-11-28"^^xsd:date ;
