<https://legal.dz/resource/constitution/1996-11-28/1996#art_91_condition_0_ef2cac40> a dznorm:Condition ;
    dznorm:conditionText "إذا دعت الضرورة الملحة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_91> ;
    dznorm:position 0 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_91_condition_1_5b518f3e> a dznorm:Condition ;
