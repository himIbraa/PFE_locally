    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_142> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تخضع العقوبات الجزائية إلى مبدئي الشرعية والشخصية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_143_19961128_OpEnact_7903509018> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
