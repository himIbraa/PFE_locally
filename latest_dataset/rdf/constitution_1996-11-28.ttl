    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 36" ;
    dzdoc:position 34 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "حرية التجارة والصناعة مضمونة ، وتمارس في إطار القانون."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_37_right_0_02a62d02> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_37_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_37_19961128_OpEnact_9cdcdc6aeb> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 37" ;
    dzdoc:position 35 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_41> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_41" ;
    dzdoc:fullText "حريات التعبير، وإنشاء الجمعيات، والاجتماع، مضمونة للمواطن ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_41_right_0_d14e333e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_41> ;
