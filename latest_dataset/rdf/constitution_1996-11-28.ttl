<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_64> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل المواطنين متساوون في أداء الضريبة . ويجب على كل واحد أن يشارك في تمويل التكاليف العمومية، حسب قدرته الضريبية . لا يجوز أن تحدث أية ضريبة إلا بمقتضى القانون . ولا يجوز أن تحدث بأثر رجعي، أية ضريبة، أو جباية، أو رسم، أو أي حق كيفما كان نوعه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
