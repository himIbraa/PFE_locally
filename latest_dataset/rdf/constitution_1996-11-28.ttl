    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 41" ;
    dzdoc:position 39 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_45" ;
    dzdoc:fullText "كل شخص يعتبر بريئا حتى تثبت جهة قضائية نظامية إدانته ، مع كل الضمانات التي يتطلبها القانون."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_45_right_0_db75db36> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_45> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_45_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_45_19961128_OpEnact_9280213a72> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 45" ;
    dzdoc:position 43 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "يترتب على الخطأ القضائي تعويض من الدولة. ويحدد القانون شروط التعويض وكيفياته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_49_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_49_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_49_19961128_OpEnact_c9c75972a1> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 49" ;
    dzdoc:position 47 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "لكل مواطن تتوفر فيه الشروط القانونية أن ينتخب وينتخب ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_50_right_0_52a45c21> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_50> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_50_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_50_19961128_OpEnact_da4ef620e3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 50" ;
    dzdoc:position 48 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "يتساوى جميع المواطنين في تقلد المهام والوظائف في الدولة دون أية شروط أخرى غير الشروط التي يحددها القانون."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_51_right_0_9b39a61d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_51_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_51_19961128_OpEnact_10596de128> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 51" ;
    dzdoc:position 49 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_56> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_56" ;
    dzdoc:fullText "الحق النقابي معترف به لجميع المواطنين ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_56_right_0_57aa4771> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_56> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_56_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
