    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_144> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تعلل الأحكام القضائية، وينطق بها في جلسات علانية ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_145_19961128_OpEnact_8c20a65e3a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_145> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_145> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_145> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "على كل أجهزة الدولة المختصة أن تقوم، في كل وقت وفي كل مكان، وفي جميع الظروف، بتنفيذ أحكام القضاء ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_146_19961128_OpEnact_5e71a4239f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_146> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_146> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_146> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يختص القضاء بإصدار الأحكام. ويمكن أن يعينهم في ذلك مساعدون شعبيون حسب الشروط التي يحددها القانون ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_147_19961128_OpEnact_ac052be125> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_147> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_147> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_147> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا يخضع القاضي إلا للقانون."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_149_19961128_OpEnact_a6429962a0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_149> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_149> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_149> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "القاضي مسؤول أمام المجلس الأعلى للقضاء عن كيفية قيامه بمهمته، حسب الأشكال المنصوص عليها في القانون ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_14_19961128_OpEnact_b0e924da94> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_14> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_14> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_14> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تقوم الدولة على مبادئ التنظيم الديمقراطي والعدالة الاجتماعية. المجلس المنتخب هو الإطار الذي يعبر فيه الشعب عن إرادته، ويراقب عمل السلطات العمومية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_150_19961128_OpEnact_5a32966b0a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_150> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_150> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_150> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يحمي القانون المتقاضي من أي تعسف أو أي انحراف يصدر من القاضي ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_151_19961128_OpEnact_40bad04255> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_151> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_151> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_151> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الحق في الدفاع معترف به . الحق في الدفاع مضمون في القضايا الجزائية ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_152_19961128_OpEnact_62d6bc1349> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_152> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_152> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_152> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تمثل المحكمة العليا الهيئة المقومة لأعمال المجالس القضائية والمحاكم. يؤَسس مجلس دولة كهيئة مقومة لأعمال الجهات القضائية الإدارية. تضمن المحكمة العليا و مجلس الدولة توحيد الاجتهاد القضائي في جميع أنحاء البلاد ويسهران على احترام القانون . تؤَسس محكمة تنازع تتولى الفصل في حالات تنازع الاختصاص بين المحكمة العليا و مجلس الدولة ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_153_19961128_OpEnact_a028a80520> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_153> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_153> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_153> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يحدد قانون عضوي تنظيم المحكمة العليا ، و مجلس الدولة ، و محكمة التنازع ، وعملهم، واختصاصاتهم الأخرى."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_154_19961128_OpEnact_a0ee0cbe9c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_154> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_154> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_154> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يرأس رئيس الجمهورية ، المجلس الأعلى للقضاء ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_155_19961128_OpEnact_f70c2e17a3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_155> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_155> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_155> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يقرر المجلس الأعلى للقضاء ، طبقا للشروط التي يحددها القانون ، تعيين القضاة، ونقلهم، وسير سلمهم الوظيفي. ويسهر على احترام أحكام القانون الأساسي للقضاء، وعلى رقابة انضباط القضاة تحت رئاسة الرئيس الأول للمحكمة العليا."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_156_19961128_OpEnact_a93470985f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_156> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_156> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_156> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يبدي المجلس الأعلى للقضاء رأيا استشاريا قبليا في ممارسة رئيس الجمهورية حق العفو."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_157_19961128_OpEnact_e06bc6bac3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_157> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_157> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_157> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يحدد قانون عضوي تشكيل المجلس الأعلى للقضاء ، وعمله، وصلاحياته الأخرى."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_158_19961128_OpEnact_f701986c96> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_158> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_158> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_158> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تؤسس محكمة عليا للدولة ، تختص بمحاكمة رئيس الجمهورية عن الأفعال التي يمكن وصفها بالخيانة العظمى، و رئيس الحكومة عن الجنايات والجنح، التي يرتكبانها بمناسبة تأديتهما مهامهما . يحدد قانون عضوي تشكيلة المحكمة العليا للدولة وتنظيمها وسيرها وكذا الإجراءات المطبقة"@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_159_19961128_OpEnact_7129b1dc98> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_159> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_159> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_159> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تضطلع المجالس المنتخبة بوظيفة الرقابة في مدلولها الشعبي ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_15_19961128_OpEnact_eeaab0866f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_15> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_15> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_15> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الجماعات الإقليمية للدولة هي البلدية والولاية . البلدية هي الجماعة القاعدية ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_160_19961128_OpEnact_9b3d69a073> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_160> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_160> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_160> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تقدم الحكومة لكل غرفة من البرلمان عرضا عن استعمال الاعتمادات المالية التي أقرتها لكل سنة مالية . تختتم السنة المالية فيما يخص البرلمان ، بالتصويت على قانون يتضمن تسوية ميزانية السنة المالية المعنية من قبل كل غرفة من البرلمان ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_161_19961128_OpEnact_c3b5099516> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_161> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_161> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_161> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يمكن كل غرفة من البرلمان ، في إطار اختصاصاتها، أن تنشئ في أي وقت لجان تحقيق في قضايا ذات مصلحة عامة ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_162_19961128_OpEnact_74336a903d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_162> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_162> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_162> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "المؤسسات الدستورية و أجهزة الرقابة مكلفة بالتحقيق في تطابق العمل التشريعي والتنفيذي مع الدستور ، وفي ظروف استخدام الوسائل المادية والأموال العمومية وتسييرها ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_163_19961128_OpEnact_65697216e7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_163> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_163> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_163> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يؤسس مجلس دستوري يكلف بالسهر على احترام الدستور . كما يسهر المجلس الدستوري على صحة عمليات الاستفتاء، وانتخاب رئيس الجمهورية ، والانتخابات التشريعية، ويعلن نتائج هذه العمليات ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_164_19961128_OpEnact_70fd0d0dc0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_164> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_164> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_164> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يتكون المجلس الدستوري من تسعة (9) أعضاء : ثلاثة (3) أعضاء من بينهم رئيس المجلس يعينهم رئيس الجمهورية ، واثنان (2) ينتخبهما المجلس الشعبي الوطني ، واثنان (2) ينتخبهما مجلس الأمة ، وعضو واحد (1) تنتخبه المحكمة العليا ، وعضو واحد (1) ينتخبه مجلس الدولة . بمجرد انتخاب أعضاء المجلس الدستوري أو تعيينهم ، يتوقفون عن ممارسة أي عضوية أو أي وظيفة أو تكليف أو مهمة أخرى . يعين رئيس الجمهورية رئيس المجلس الدستوري لفترة واحدة مدتها ست (6) سنوات . يضطلع أعضاء المجلس الدستوري بمهامهم مرة واحدة مدتها ست (6) سنوات، ويجدد نصف عدد أعضاء المجلس الدستوري كل ثلاث (3) سنوات."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_165_19961128_OpEnact_0bb39711ec> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_165> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_165> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_165> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يفصل المجلس الدستوري ، بالإضافة إلى الاختصاصات التي خولتها إياه صراحة أحكام أخرى في الدستور ، في دستورية المعاهدات والقوانين، والتنظيمات، إما برأي قبل أن تصبح واجبة التنفيذ، أو بقرار في الحالة العكسية . يبدي المجلس الدستوري ، بعد أن يخطره رئيس الجمهورية ، رأيه وجوبا في دستورية القوانين العضوية بعد أن يصادق عليها البرلمان . كما يفصل المجلس الدستوري في مطابقة النظام الداخلي لكل من غرفتي البرلمان للدستور، حسب الإجراءات المذكورة في الفقرة السابقة ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_166_19961128_OpEnact_9aeb340c39> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_166> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_166> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_166> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يخطر رئيس الجمهورية أو رئيس المجلس الشعبي الوطني أو رئيس مجلس الأمة ، المجلس الدستوري ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_167_19961128_OpEnact_8a93bbe142> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_167> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_167> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_167> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يتداول المجلس الدستوري في جلسة مغلقة، ويعطي رأيه أو يصدر قراره في ظرف العشرين (20) يوما الموالية لتاريخ الإخطار . يحدد المجلس الدستوري قواعد عمله ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_168_19961128_OpEnact_c1e320c0f0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_168> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_168> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_168> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "إذا ارتأى المجلس الدستوري عدم دستورية معاهدة أو اتفاق، أو اتفاقية ، فلا يتم التصديق عليها ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_169_19961128_OpEnact_ee25ff2100> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_169> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_169> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_169> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "إذا ارتأى المجلس الدستوري أن نصا تشريعيا أو تنظيميا غير دستوري ، يفقد هذا النص أثره، ابتداء من يوم قرار المجلس."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_16_19961128_OpEnact_9a2fef67fe> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_16> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_16> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_16> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يمثل المجلس المنتخب قاعدة اللامركزية، ومكان مشاركة المواطنين في تسيير الشؤون العمومية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_171_19961128_OpEnact_6439edf6b5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_171> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_171> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_171> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يؤسس لدى رئيس الجمهورية مجلس إسلامي أعلى ، يتولى على الخصوص ما يأتي : الحث على الاجتهاد وترقيته، إبداء الحكم الشرعي فيما يعرض عليه، رفع تقرير دوري عن نشاطه إلى رئيس الجمهورية ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_172_19961128_OpEnact_d9210de85b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_172> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_172> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_172> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يتكون المجلس الإسلامي الأعلى من خمسة عشر (15) عضوا منهم الرئيس، يعينهم رئيس الجمهورية من بين الكفاءات الوطنية العليا في مختلف العلوم."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_173_19961128_OpEnact_03b8b1c0eb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_173> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_173> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_173> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يؤسس مجلس أعلى للأمن يرأسه رئيس الجمهورية ، مهمته تقديم الآراء إلى رئيس الجمهورية في كل القضايا المتعلقة بالأمن الوطني. يحدد رئيس الجمهورية كيفيات تنظيم المجلس الأعلى للأمن وعمله."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_174_19961128_OpEnact_50e0bfeee8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_174> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_174> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_174> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لرئيس الجمهورية حق المبادرة بالتعديل الدستوري ، و بعد أن يصوت عليه المجلس الشعبي الوطني و مجلس الأمة بنفس الصيغة حسب الشروط نفسها التي تطبق على نص تشريعي ، يعرض التعديل على استفتاء الشعب خلال الخمسين (50) يوما الموالية لإقراره. يصدر رئيس الجمهورية التعديل الدستوري الذي صادق عليه الشعب."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_175_19961128_OpEnact_41a0bcfef5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_175> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_175> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_175> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يصبح القانون الذي يتضمن مشروع التعديل الدستوري لاغيا، إذا رفضه الشعب . ولا يمكن عرضه من جديد على الشعب خلال الفترة التشريعية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_176_19961128_OpEnact_59d2b92432> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_176> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_176> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_176> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "إذا ارتأى المجلس الدستوري أن مشروع أي تعديل دستوري لا يمس البتة المبادئ العامة التي تحكم المجتمع الجزائري، وحقوق الإنسان والمواطن وحرياتهما، ولا يمس بأي كيفية التوازنات الأساسية للسلطات والمؤسسات الدستورية، وعلل رأيه ، أمكن رئيس الجمهورية أن يصدر القانون الذي يتضمن التعديل الدستوري مباشرة دون أن يعرضه على الاستفتاء الشعبي، متى أحرز ثلاثة أرباع (3/4) أصوات أعضاء غرفتي البرلمان ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_177_19961128_OpEnact_380ceaf0d5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_177> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_177> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_177> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يمكن ثلاثة أرباع (3/4) أعضاء غرفتي البرلمان المجتمعتين معا، أن يبادروا باقتراح تعديل الدستور على رئيس الجمهورية الذي يمكنه عرضه على الاستفتاء الشعبي. ويصدره في حالة الموافقة عليه."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_178_19961128_OpEnact_248285819e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_178> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_178> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_178> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا يمكن أي تعديل دستوري أن يمس : 1 – الطابع الجمهوري للدولة، 2 – النظام الديمقراطي القائم على التعددية الحزبية، 3 – الإسلام باعتباره دين الدولة، 4 – العربية باعتبارها اللغة الوطنية والرسمية، 5 – الحريات الأساسية وحقوق الإنسان والمواطن، 6 – سلامة التراب الوطني ووحدته."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_179_19961128_OpEnact_a3480f19f0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_179> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_179> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_179> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تتولى الهيئة التشريعية القائمة عند إصدار هذا الدستور وإلى غاية انتهاء مهمتها وكذا رئيس الجمهورية بعد انتهاء هذه المهمة وإلى غاية انتخاب المجلس الشعبي الوطني ، مهمة التشريع بأوامر بما في ذلك في المسائل التي أصبحت تدخل ضمن القوانين العضوية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_17_19961128_OpEnact_145ff6b28d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_17> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_17> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_17> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الملكية العامة هي ملك المجموعة الوطنية . وتشمل باطن الأرض، والمناجم، والمقالع، والموارد الطبيعية للطاقة، والثروات المعدنية الطبيعية والحية، في مختلف مناطق الأملاك الوطنية البحرية، والمياه، والغابات. كما تشمل النقل بالسكك الحديدية، والنقل البحري والجوي، والبريد والمواصلات السلكية واللاسلكية، وأملاكا أخرى محددة في القانون."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_180_19961128_OpEnact_4bcc330969> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_180> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_180> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_180> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "ريثما يتم تنصيب المؤسسات المنصوص عليها في هذا الدستور : يستمر سريان مفعول القوانين التي تتعلق بالمواضيع التي تخضع لمجال القوانين العضوية، إلى أن تعدل أو تستبدل وفق الإجراءات المنصوص عليها في الدستور، يمارس المجلس الدستوري بتمثيله الحالي الاختصاصات المسندة إليه بموجب هذا الدستور، حتى تاريخ تنصيب المؤسسات الممثلة فيه. وكل تغيير أو إضافة يجب أن يتم مع مراعاة الفقرة 3 من المادة 164 من هذا الدستور، مع استعمال القرعة عند الحاجة، يمارس المجلس الشعبي الوطني المنتخب السلطة التشريعية كاملة حتى تنصيب مجلس الأمة . ويمكن رئيس الجمهورية وقف إصدار القوانين المتخذة بمبادرة من النواب إلى غاية المصادقة عليها من قبل مجلس الأمة ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_182_19961128_OpEnact_ec0a7a3974> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_182> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_182> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_182> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يصدر رئيس الجمهورية نص التعديل الدستوري الذي أقره الشعب ، و ينفذ كقانون أساسي للجمهورية ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_18_19961128_OpEnact_d63944f7f1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_18> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_18> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_18> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الأملاك الوطنية يحددها القانون. وتتكون من الأملاك العمومية والخاصة التي تملكها كل من الدولة ، والولاية، والبلدية. يتم تسيير الأملاك الوطنية طبقا للقانون ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_19_19961128_OpEnact_07e5a9cdaa> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_19> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_19> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_19> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تنظيم التجارة الخارجية من اختصاص الدولة . يحدد القانون شروط ممارسة التجارة الخارجية ومراقبتها."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_1_19961128_OpEnact_791115d5a1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_1> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الجزائر جمهورية ديمقراطية شعبية. وهي وحدة لا تتجزأ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_20_19961128_OpEnact_6a476d33be> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_20> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_20> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_20> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا يتم نزع الملكية إلا في إطار القانون . ويترتب عليه تعويض قبلي عادل، ومنصف ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_21_19961128_OpEnact_9613592828> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_21> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_21> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_21> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا يمكن أن تكون الوظائف في مؤسسات الدولة مصدرا للثراء، ولا وسيلة لخدمة المصالح الخاصة ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_22_19961128_OpEnact_5d77206415> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_22> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_22> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_22> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يعاقب القانون على التعسف في استعمال السلطة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_23_19961128_OpEnact_decb5cf9fe> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_23> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_23> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_23> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "عدم تحيز الإدارة يضمنه القانون."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_24_19961128_OpEnact_1a5b78fad3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_24> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_24> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_24> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الدولة مسؤولة عن أمن الأشخاص والممتلكات، وتتكفل بحماية كل مواطن في الخارج ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_25_19961128_OpEnact_31361eb606> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_25> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_25> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_25> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تنتظم الطاقة الدفاعية للأمة، ودعمها، وتطويرها، حول الجيش الوطني الشعبي . تتمثل المهمة الدائمة للجيش الوطني الشعبي في المحافظة على الاستقلال الوطني، والدفاع عن السيادة الوطنية. كما يضطلع بالدفاع عن وحدة البلاد، وسلامتها الترابية، وحماية مجالها البري والجوي، ومختلف مناطق أملاكها البحرية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_26_19961128_OpEnact_a0dd4ce9d2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_26> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_26> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_26> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تمتنع الجزائر عن اللجوء إلى الحرب من أجل المساس بالسيادة المشروعة للشعوب الأخرى وحريتها . وتبذل جهدها لتسوية الخلافات الدولية بالوسائل السلمية ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_27_19961128_OpEnact_f7602bb4ab> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_27> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_27> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_27> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الجزائر متضامنة مع جميع الشعوب التي تكافح من أجل التحرر السياسي والاقتصادي ، و الحق في تقرير المصير ، وضد كل تمييز عنصري."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_28_19961128_OpEnact_1c9f0912fc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_28> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_28> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_28> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تعمل الجزائر من أجل دعم التعاون الدولي، وتنمية العلاقات الودية بين الدول، على أساس المساواة، والمصلحة المتبادلة، وعدم التدخل في الشؤون الداخلية . و تتبنى مبادئ ميثاق الأمم المتحدة وأهدافه"@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_29_19961128_OpEnact_08430c7c0f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_29> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_29> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_29> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "كل المواطنين سواسية أمام القانون . ولا يمكن أن يتذرع بأي تمييز يعود سببه إلى المولد، أو العرق، أو الجنس، أو الرأي، أو أي شرط أو ظرف آخر، شخصي أو اجتماعي."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_2_19961128_OpEnact_38adcc75fe> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_2> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الإسلام دين الدولة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_30_19961128_OpEnact_5d33085ca9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_30> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_30> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_30> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الجنسية الجزائرية ، معرفة بالقانون. شروط اكتساب الجنسية الجزائرية ، والاحتفاظ بها، أو فقدانها، أو إسقاطها، محددة بالقانون."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_31_19961128_OpEnact_b3e25806bf> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_31> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_31> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_31> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تستهدف المؤسسات ضمان مساواة كل المواطنين والمواطنات في الحقوق والواجبات بإزالة العقبات التي تعوق تفتح شخصية الإنسان، وتحول دون مشاركة الجميع الفعلية في الحياة السياسية، والاقتصادية، والاجتماعية، والثقافية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_32_19961128_OpEnact_fd5ea7574a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_32> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_32> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_32> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الحريات الأساسية وحقوق الإنسان والمواطن مضمونة . وتكون تراثا مشتركا بين جميع الجزائريين والجزائريات، واجبهم أن ينقلوه من جيل إلى جيل كي يحافظوا على سلامته، وعدم انتهاك حرمته ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_33_19961128_OpEnact_2814e137b9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_33> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_33> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_33> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الدفاع الفردي أو عن طريق الجمعية عن الحقوق الأساسية للإنسان وعن الحريات الفردية والجماعية، مضمون ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_34_19961128_OpEnact_58e1360500> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_34> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_34> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_34> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تضمن الدولة عدم انتهاك حرمة الإنسان . ويحظر أي عنف بدني أو معنوي أو أي مساس بالكرامة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_36_19961128_OpEnact_bae17cbf7c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_36> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_36> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_36> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا مساس بحرمة حرية المعتقد، وحرمة حرية الرأي ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_37_19961128_OpEnact_9cdcdc6aeb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_37> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_37> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_37> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "حرية التجارة والصناعة مضمونة ، وتمارس في إطار القانون."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_38_19961128_OpEnact_ddf9ea3c70> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_38> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_38> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_38> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "حرية الابتكار الفكري والفني والعلمي مضمونة للمواطن . حقوق المؤلف يحميها القانون . لا يجوز حجز أي مطبوع أو تسجيل أو أية وسيلة أخرى من وسائل التبليغ والإعلام إلا بمقتضى أمر قضائي ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_39_19961128_OpEnact_3581d8ae8d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_39> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_39> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_39> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا يجوز انتهاك حرمة حياة المواطن الخاصة، وحرمة شرفه، ويحميهما القانون . سرية المراسلات والاتصالات الخاصة بكل أشكالها مضمونة ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_3_19961128_OpEnact_7f478ced01> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_3> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_3> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_3> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "اللغة العربية هي اللغة الوطنية والرسمية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_40_19961128_OpEnact_99c753fc5c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_40> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_40> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_40> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تضمن الدولة عدم انتهاك حرمة المسكن . فلا تفتيش إلا بمقتضى القانون، وفي إطار احترامه . ولا تفتيش إلا بأمر مكتوب صادر عن السلطة القضائية المختصة ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_41_19961128_OpEnact_f7c8738fbe> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_41> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_41> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_41> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "حريات التعبير، وإنشاء الجمعيات، والاجتماع، مضمونة للمواطن ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_42_19961128_OpEnact_62ebfc001e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_42> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_42> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_42> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "حق إنشاء الأحزاب السياسية معترف به ومضمون . ولا يمكن التذرع بهذا الحق لضرب الحريات الأساسية، والقيم والمكونات الأساسية للهوية الوطنية، والوحدة الوطنية، وأمن التراب الوطني وسلامته، واستقلال البلاد، وسيادة الشعب، وكذا الطابع الديمقراطي والجمهوري للدولة. وفي ظل احترام أحكام هذا الدستور، لا يجوز تأسيس الأحزاب السياسية على أساس ديني أو لغوي أو عرقي أو جنسي أو مهني أو جهوي . ولا يجوز للأحزاب السياسية اللجوء إلى الدعاية الحزبية التي تقوم على العناصر المبينة في الفقرة السابقة . يحظر على الأحزاب السياسية كل شكل من أشكال التبعية للمصالح أو الجهات الأجنبية . لا يجوز أن يلجأ أي حزب سياسي إلى استعمال العنف أو الإكراه مهما كانت طبيعتهما أو شكلهما . تحدد التزامات وواجبات أخرى بموجب قانون."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_43_19961128_OpEnact_83d927790f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_43> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_43> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_43> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "حق إنشاء الجمعيات مضمون . تشجع الدولة ازدهار الحركة الجمعوية . يحدد القانون شروط وكيفيات إنشاء الجمعيات."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_44_19961128_OpEnact_9ead43104b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_44> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_44> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_44> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يحق لكل مواطن يتمتع بحقوقه المدنية والسياسية، أن يختار بحرية موطن إقامته، وأن يتنقل عبر التراب الوطني . حق الدخول إلى التراب الوطني والخروج منه مضمون له ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_45_19961128_OpEnact_9280213a72> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_45> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_45> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_45> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "كل شخص يعتبر بريئا حتى تثبت جهة قضائية نظامية إدانته ، مع كل الضمانات التي يتطلبها القانون."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_46_19961128_OpEnact_05aec77bd1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_46> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_46> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_46> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا إدانة إلا بمقتضى قانون صادر قبل ارتكاب الفعل المجرم."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_47_19961128_OpEnact_dfca2fbf8b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_47> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_47> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_47> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا يتابع أحد، ولا يوقف أو يحتجز إلا في الحالات المحددة بالقانون، وطبقا للأشكال التي نص عليها."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_48_19961128_OpEnact_c20b6bfd92> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_48> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_48> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_48> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يخضع التوقيف للنظر في مجال التحريات الجزائية للرقابة القضائية، ولا يمكن أن يتجاوز مدة ثمان وأربعين (48) ساعة. يملك الشخص الذي يوقف للنظر حق الاتصال فورا بأسرته . ولا يمكن تمديد مدة التوقيف للنظر، إلا استثناء، ووفقا للشروط المحددة بالقانون. ولدى انتهاء مدة التوقيف للنظر، يجب أن يجرى فحص طبي على الشخص الموقوف، إن طلب ذلك ، على أن يعلم بهذه الإمكانية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_49_19961128_OpEnact_c9c75972a1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_49> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_49> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_49> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يترتب على الخطأ القضائي تعويض من الدولة. ويحدد القانون شروط التعويض وكيفياته."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_4_19961128_OpEnact_5c21b5bac4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_4> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_4> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_4> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "عاصمة الجمهورية مدينة الجزائر ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_50_19961128_OpEnact_da4ef620e3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_50> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_50> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_50> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لكل مواطن تتوفر فيه الشروط القانونية أن ينتخب وينتخب ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_51_19961128_OpEnact_10596de128> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_51> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_51> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_51> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يتساوى جميع المواطنين في تقلد المهام والوظائف في الدولة دون أية شروط أخرى غير الشروط التي يحددها القانون."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_52_19961128_OpEnact_d082c6db2f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_52> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_52> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_52> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الملكية الخاصة مضمونة . حق الإرث مضمون . الأملاك الوقفية وأملاك الجمعيات الخيرية معترف بها، ويحمي القانون تخصيصها."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_53_19961128_OpEnact_ca38e93137> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_53> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_53> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_53> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الحق في التعليم مضمون . التعليم مجاني حسب الشروط التي يحددها القانون. التعليم الأساسي إجباري . تنظم الدولة المنظومة التعليمية. تسهر الدولة على التساوي في الالتحاق بالتعليم، والتكوين المهني ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_54_19961128_OpEnact_43161ed2ab> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_54> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_54> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_54> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الرعاية الصحية حق للمواطنين . تتكفل الدولة بالوقاية من الأمراض الوبائية والمعدية وبمكافحتها ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_55_19961128_OpEnact_4b61695830> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_55> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_55> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_55> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لكل المواطنين الحق في العمل . يضمن القانون في أثناء العمل الحق في الحماية، والأمن، والنظافة . الحق في الراحة مضمون ، ويحدد القانون كيفيات ممارسته."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_56_19961128_OpEnact_71be670404> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_56> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_56> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_56> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الحق النقابي معترف به لجميع المواطنين ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_57_19961128_OpEnact_eb814994ed> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_57> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_57> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_57> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الحق في الإضراب معترف به ، ويمارس في إطار القانون . يمكن أن يمنع القانون ممارسة هذا الحق، أو يجعل حدودا لممارسته في ميادين الدفاع الوطني والأمن، أو في جميع الخدمات أو الأعمال العمومية ذات المنفعة الحيوية للمجتمع ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_58_19961128_OpEnact_369de7bb51> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_58> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_58> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_58> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تحظى الأسرة بحماية الدولة والمجتمع ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_59_19961128_OpEnact_7f2f3e2c89> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_59> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_59> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_59> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "ظروف معيشة المواطنين الذين لم يبلغوا سن العمل، والذين لا يستطيعون القيام به، والذين عجزوا عنه نهائيا، مضمونة"@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_5_19961128_OpEnact_6078f6864a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_5> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_5> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_5> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "العلم الوطني، وخاتم الدولة، والنشيد الوطني، يحددها القانون"@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_60_19961128_OpEnact_cc35af5376> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_60> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_60> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_60> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا يعذر بجهل القانون . يجب على كل شخص أن يحترم الدستور وقوانين الجمهورية ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_61_19961128_OpEnact_97484fd994> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_61> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_61> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_61> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يجب على كل مواطن أن يحمي ويصون استقلال البلاد وسيادتها وسلامة ترابها الوطني وجميع رموز الدولة . يعاقب القانون بكل صرامة على الخيانة والتجسس والولاء للعدو، وعلى جميع الجرائم المرتكبة ضد أمن الدولة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_62_19961128_OpEnact_7a44acd976> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_62> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_62> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_62> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "على كل مواطن أن يؤدي بإخلاص واجباته تجاه المجموعة الوطنية . التزام المواطن إزاء الوطن وإجبارية المشاركة في الدفاع عنه، واجبان مقدسان دائمان . تضمن الدولة احترام رموز الثورة، وأرواح الشهداء، وكرامة ذويهم، والمجاهدين ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_63_19961128_OpEnact_8737f0f896> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_63> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_63> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_63> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يمارس كل واحد جميع حرياته ، في إطار احترام الحقوق المعترف بها للغير في الدستور ، لا سيما احترام الحق في الشرف، وستر الحياة الخاصة، وحماية الأسرة والشبيبة والطفولة ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_64_19961128_OpEnact_566f71a3e9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_64> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_64> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_64> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "كل المواطنين متساوون في أداء الضريبة . ويجب على كل واحد أن يشارك في تمويل التكاليف العمومية، حسب قدرته الضريبية . لا يجوز أن تحدث أية ضريبة إلا بمقتضى القانون . ولا يجوز أن تحدث بأثر رجعي، أية ضريبة، أو جباية، أو رسم، أو أي حق كيفما كان نوعه."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_65_19961128_OpEnact_1bb467ab75> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_65> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_65> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_65> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يجازي القانون الآباء على القيام بـ واجب تربية أبنائهم ورعايتهم ، كما يجازي الأبناء على القيام بـ واجب الإحسان إلى آبائهم ومساعدتهم ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_66_19961128_OpEnact_0736bc137c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_66> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_66> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_66> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يجب على كل مواطن أن يحمي الملكية العامة، ومصالح المجموعة الوطنية، ويحترم ملكية الغير ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_67_19961128_OpEnact_56ca020add> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_67> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_67> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_67> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يتمتع كل أجنبي، يكون وجوده فوق التراب الوطني قانونيا، بحماية شخصه وأملاكه طبقا للقانون ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_68_19961128_OpEnact_915e4a4a51> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_68> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_68> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_68> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا يسلم أحد خارج التراب الوطني إلا بناء على قانون تسليم المجرمين وتطبيقا له."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_69_19961128_OpEnact_d0d2ce4af0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_69> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_69> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_69> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا يمكن بأي حال من الأحوال أن يسلم أو يطرد لاجئ سياسي يتمتع قانونا بحق اللجوء ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_6_19961128_OpEnact_9045add1a0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_6> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_6> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_6> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "الشعب مصدر كل سلطة. السيادة الوطنية ملك للشعب وحده."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_70_19961128_OpEnact_f71fdba96f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_70> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_70> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_70> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يجسد رئيس الجمهورية ، رئيس الدولة، وحدة الأمة. وهو حامي الدستور . ويجسد الدولة داخل البلاد وخارجها. له أن يخاطب الأمة مباشرة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_71_19961128_OpEnact_a9b1fd3eec> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_71> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_71> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_71> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "ينتخب رئيس الجمهورية ، عن طريق الاقتراع العام المباشر والسري. يتم الفوز في الانتخاب بالحصول على الأغلبية المطلقة من أصوات الناخبين المعبر عنها. ويحدد القانون الكيفيات الأخرى للانتخابات الرئاسية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_72_19961128_OpEnact_5d966fb61c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_72> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_72> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_72> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يمارس رئيس الجمهورية ، السلطة السامية في الحدود المثبتة في الدستور ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_73_19961128_OpEnact_67dbafb634> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_73> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_73> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_73> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا يحق أن ينتخب لرئاسة الجمهورية إلا المترشح الذي : يتمتع، فقط، بالجنسية الجزائرية الأصلية ، يدين بالإسلام ، يكون عمره أربعين (40) سنة كاملة يوم الانتخاب ، يتمتع بكامل حقوقه المدنية والسياسية ، يثبت الجنسية الجزائرية لزوجه ، يثبت مشاركته في ثورة أول نوفمبر 1954 إذا كان مولودا قبل يوليو 1942 ، يثبت عدم تورط أبويه في أعمال ضد ثورة أول نوفمبر 1954 إذا كان مولودا بعد يوليو 1942 ، يقدم التصريح العلني بممتلكاته العقارية والمنقولة داخل الوطن وخارجه ، تحدد شروط أخرى بموجب القانون."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_74_19961128_OpEnact_42262e3418> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_74> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_74> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_74> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "مدة المهمة الرئاسية خمس (5) سنوات. يمكن تجديد انتخاب رئيس الجمهورية مرة واحدة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_75_19961128_OpEnact_6563848a5e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_75> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_75> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_75> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يؤدي رئيس الجمهورية اليمين أمام الشعب بحضور جميع الهيئات العليا في الأمة، خلال الأسبوع الموالي لانتخابه . ويباشر مهمته فور أدائه اليمين."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_76_19961128_OpEnact_985cb35866> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_76> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_76> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_76> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يؤدي رئيس الجمهورية اليمين حسب النص الآتي : ” بسم الله الرحمن الرحيم ، وفاء للتضحيات الكبرى، ولأرواح شهدائنا الأبرار، وقيم ثورة نوفمبر الخالدة، أقسم بالله العلي العظيم، أن أحترم الدين الإسلامي وأمجده، وأدافع عن الدستور ، وأسهر على استمرارية الدولة، وأعمل على توفير الشروط اللازمة للسير العادي للمؤسسات والنظام الدستوري، وأسعى من أجل تدعيم المسار الديمقراطي، وأحترم حرية اختيار الشعب، ومؤسسات الجمهورية وقوانينها، وأحافظ على سلامة التراب الوطني، ووحدة الشعب والأمة، وأحمي الحريات والحقوق الأساسية للإنسان والمواطن، وأعمل بدون هوادة من أجل تطور الشعب وازدهاره، وأسعى بكل قواي في سبيل تحقيق المثل العليا للعدالة والحرية والسلم في العالم. والله على ما أقول شهيد “."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_77_19961128_OpEnact_281aa616d3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_77> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_77> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_77> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يضطلع رئيس الجمهورية ، بالإضافة إلى السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور ، بالسلطات والصلاحيات الآتية : 1 – هو القائد الأعلى للقوات المسلحة للجمهورية، 2 – يتولى مسؤولية الدفاع الوطني، 3 – يقرر السياسة الخارجية للأمة ويوجهها، 4 – يرأس مجلس الوزراء، 5 – يعين رئيس الحكومة وينهي مهامه، 6 – يوقع المراسيم الرئاسية، 7 – له حق إصدار العفو وحق تخفيض العقوبات أو استبدالها ، 8 – يمكنه أن يستشير الشعب في كل قضية ذات أهمية وطنية عن طريق الاستفتاء، 9 – يبرم المعاهدات الدولية ويصادق عليها، 10 – يسلم أوسمة الدولة ونياشينها وشهاداتها التشريفية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_78_19961128_OpEnact_edb929ab33> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_78> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_78> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_78> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يعين رئيس الجمهورية في الوظائف والمهام الآتية : 1 – الوظائف والمهام المنصوص عليها في الدستور، 2 – الوظائف المدنية والعسكرية في الدولة، 3 – التعيينات التي تتم في مجلس الوزراء، 4 – رئيس مجلس الدولة، 5 – الأمين العام للحكومة، 6 – محافظ بنك الجزائر، 7 – القضاة، 8 – مسؤولو أجهزة الأمن، 9 – الولاة. ويعين رئيس الجمهورية سفراء الجمهورية والمبعوثين فوق العادة إلى الخارج، وينهي مهامهم، ويتسلم أوراق اعتماد الممثلين الدبلوماسيين الأجانب وأوراق إنهاء مهامهم."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_79_19961128_OpEnact_2e6b05b021> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_79> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_79> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_79> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يقدم رئيس الحكومة أعضاء حكومته الذين اختارهم ل رئيس الجمهورية الذي يعينهم. يضبط رئيس الحكومة برنامج حكومته ويعرضه في مجلس الوزراء."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_7_19961128_OpEnact_176f6c43e0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_7> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_7> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_7> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "السلطة التأسيسية ملك للشعب . يمارس الشعب سيادته بواسطة المؤسسات الدستورية التي يختارها. يمارس الشعب هذه السيادة عن طريق الاستفتاء وبواسطة ممثليه المنتخبين. لـ رئيس الجمهورية أن يلتجئ إلي إرادة الشعب مباشرة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_80_19961128_OpEnact_efa3d3d9f2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_80> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_80> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_80> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يقدم رئيس الحكومة برنامجه إلى المجلس الشعبي الوطني للموافقة عليه. ويجري المجلس الشعبي الوطني لهذا الغرض مناقشة عامة. ويمكن رئيس الحكومة أن يكيف برنامجه على ضوء هذه المناقشة. يقدم رئيس الحكومة عرضا حول برنامجه لمجلس الأمة. يمكن مجلس الأمة أن يصدر لائحة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_81_19961128_OpEnact_96bdd4e091> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_81> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_81> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_81> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يقدم رئيس الحكومة استقالة حكومته ل رئيس الجمهورية في حالة عدم موافقة المجلس الشعبي الوطني على البرنامج المعروض عليه. يعين رئيس الجمهورية من جديد رئيس حكومة حسب الكيفيات نفسها."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_82_19961128_OpEnact_4a38e1312b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_82> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_82> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_82> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "إذا لم تحصل من جديد موافقة المجلس الشعبي الوطني ينحل وجوبا. تستمر الحكومة القائمة في تسيير الشؤون العادية إلى غاية انتخاب المجلس الشعبي الوطني وذلك في أجل أقصاه ثلاثة (3) أشهر."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_83_19961128_OpEnact_03e8d2fb28> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_83> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_83> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_83> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "ينفذ رئيس الحكومة وينسق البرنامج الذي يصادق عليه المجلس الشعبي الوطني."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_84_19961128_OpEnact_b6b65b298e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_84> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_84> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_84> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "تقدم الحكومة سنويا إلى المجلس الشعبي الوطني بيانا عن السياسة العامة. تعقب بيان السياسة العامة مناقشة عمل الحكومة. يمكن أن تختتم هذه المناقشة بلائحة. كما يمكن أن يترتب على هذه المناقشة إيداع ملتمس رقابة يقوم به المجلس الشعبي الوطني طبقا لأحكام المواد 135 و 136 و 137 أدناه. ل رئيس الحكومة أن يطلب من المجلس الشعبي الوطني تصويتا بالثقة. وفي حالة عدم الموافقة على لائحة الثقة يقدم رئيس الحكومة استقالة حكومته. في هذه الحالة، يمكن ل رئيس الجمهورية أن يلجأ، قبل قبول الاستقالة، إلى أحكام المادة 129 أدناه. يمكن الحكومة أن تقدم إلى مجلس الأمة بيانا عن السياسة العامة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_85_19961128_OpEnact_699c78b72e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_85> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_85> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_85> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يمارس رئيس الحكومة ، زيادة على السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور، الصلاحيات الآتية : 1 – يوزع الصلاحيات بين أعضاء الحكومة مع احترام الأحكام الدستورية، 2 – يرأس مجلس الحكومة، 3 – يسهر على تنفيذ القوانين والتنظيمات، 4 – يوقع المراسيم التنفيذية، 5 – يعين في وظائف الدولة دون المساس بأحكام المادتين 77 و 78 السابقتي الذكر. 6 – يسهر على حسن سير الإدارة العمومية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_86_19961128_OpEnact_397985782e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_86> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_86> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_86> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يمكن رئيس الحكومة أن يقدم استقالة حكومته ل رئيس الجمهورية ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_87_19961128_OpEnact_01b22af15b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_87> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_87> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_87> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا يجوز بأي حال من الأحوال أن يفوض رئيس الجمهورية سلطته في تعيين رئيس الحكومة وأعضائها وكذا رؤساء المؤسسات الدستورية وأعضائها الذين لم ينص الدستور على طريقة أخرى لتعيينهم. كما لا يجوز أن يفوض سلطته في اللجوء إلى الاستفتاء، وحل المجلس الشعبي الوطني، وتقرير إجراء الانتخابات التشريعية قبل أوانها، وتطبيق الأحكام المنصوص عليها في المواد 77 و 78 و 91 و من 93 إلى 95 و 97 و 124 و 126 و 127 و 128 من الدستور."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_88_19961128_OpEnact_d3c8a0da7b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_88> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_88> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_88> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "إذا استحال على رئيس الجمهورية أن يمارس مهامه بسبب مرض خطير ومزمن ، يجتمع المجلس الدستوري وجوبا ، وبعد أن يتثبت من حقيقة هذا المانع بكل الوسائل الملائمة، يقترح بالإجماع على البرلمان التصريح بثبوت المانع. يعلن البرلمان، المنعقد بغرفتيه المجتمعتين معا، ثبوت المانع ل رئيس الجمهورية بأغلبية ثلثي (2/3) أعضائه ، ويكلف بتولي رئاسة الدولة بالنيابة مدة أقصاها خمسة وأربعون (45) يوما، رئيس مجلس الأمة الذي يمارس صلاحياته مع مراعاة أحكام المادة 90 من الدستور. وفي حالة استمرار المانع بعد انقضاء خمسة وأربعون (45) يوما ، يعلن الشغور بالاستقالة وجوبا حسب الإجراء المنصوص عليه في الفقرتين السابقتين وطبقا لأحكام الفقرات الآتية من هذه المادة . في حالة استقالة رئيس الجمهورية أو وفاته ، يجتمع المجلس الدستوري وجوبا ويثبت الشغور النهائي لرئاسة الجمهورية . وتبلغ فورا شهادة التصريح بالشغور النهائي إلى البرلمان الذي يجتمع وجوبا. يتولى رئيس مجلس الأمة مهام رئيس الدولة مدة أقصاها ستون (60) يوما، تنظم خلالها انتخابات رئاسية. ولا يحق لرئيس الدولة المعين بهذه الطريقة أن يترشح لرئاسة الجمهورية . وإذا اقترنت استقالة رئيس الجمهورية أو وفاته بشغور رئاسة مجلس الأمة لأي سبب كان ، يجتمع المجلس الدستوري وجوبا، ويثبت بالإجماع الشغور النهائي لرئاسة الجمهورية وحصول المانع ل رئيس مجلس الأمة . وفي هذه الحالة، يتولى رئيس المجلس الدستوري مهام رئيس الدولة. يضطلع رئيس الدولة المعين حسب الشروط المبينة أعلاه بمهمة رئيس الدولة طبقا للشروط المحددة في الفقرات السابقة وفي المادة 90 من الدستور. ولا يمكنه أن يترشح لرئاسة الجمهورية ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_89_19961128_OpEnact_23b8f9a3d6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_89> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_89> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_89> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "في حالة وفاة أحد المترشحين للانتخابات الرئاسية في الدور الثاني أو انسحابه أو حدوث أي مانع آخر له ، يستمر رئيس الجمهورية القائم أو من يمارس مهام رئاسة الدولة في ممارسة مهامه إلى غاية الإعلان عن انتخاب رئيس الجمهورية. في هذه الحالة، يمدد المجلس الدستوري مهلة إجراء هذه الانتخابات لمدة أقصاها ستون (60) يوما. يحدد قانون عضوي كيفيات وشروط تطبيق هذه الأحكام."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_8_19961128_OpEnact_aeeda8fc28> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_8> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_8> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_8> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يختار الشعب لنفسه مؤسسات، غايتها ما يأتي : المحافظة على الاستقلال الوطني، ودعمه، المحافظة على الهوية، والوحدة الوطنية، ودعمهما، حماية الحريات الأساسية للمواطن، والازدهار الاجتماعي والثقافي للأمة، القضاء على استغلال الإنسان للإنسان، حماية الاقتصاد الوطني من أي شكل من أشكال التلاعب، أو الاختلاس، أو الاستحواذ، أو المصادرة غير المشروعة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_90_19961128_OpEnact_a4ed94e57e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_90> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_90> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_90> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا يمكن أن تقال أو تعدل الحكومة القائمة إبان حصول المانع لرئيس الجمهورية، أو وفاته، أو استقالته، حتى يشرع رئيس الجمهورية الجديد في ممارسة مهامه . يستقيل رئيس الحكومة القائمة وجوبا، إذا ترشح لرئاسة الجمهورية ، ويمارس وظيفة رئيس الحكومة حينئذ أحد أعضائها الذي يعينه رئيس الدولة. لا يمكن، في فترتي الخمسة والأربعين (45) يوما والستين (60) يوما المنصوص عليهما في المادتين 88 و 89 ، تطبيق الأحكام المنصوص عليها في الفقرتين 7 و 8 من المادة 77 ، و المواد 79 و 124 و 129 و 136 و 137 و 174 و 176 و 177 من الدستور. لا يمكن، خلال هاتين الفترتين، تطبيق أحكام المواد 91 و 93 و 94 و 95 و 97 من الدستور، إلا بموافقة البرلمان المنعقد بغرفتيه المجتمعتين معا، بعد استشارة المجلس الدستوري والمجلس الأعلى للأمن."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_91_19961128_OpEnact_2b0bfee3c8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_91> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_91> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_91> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يقرر رئيس الجمهورية، إذا دعت الضرورة الملحة ، حالة الطوارئ أو الحصار ، لمدة معينة بعد اجتماع المجلس الأعلى للأمن، واستشارة رئيس المجلس الشعبي الوطني، ورئيس مجلس الأمة، ورئيس الحكومة، ورئيس المجلس الدستوري، ويتخذ كل التدابير اللازمة لاستتباب الوضع. ولا يمكن تمديد حالة الطوارئ أو الحصار، إلا بعد موافقة البرلمان، المنعقد بغرفتيه المجتمعتين معا ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_92_19961128_OpEnact_895e2884ca> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_92> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_92> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_92> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يحدد تنظيم حالة الطوارئ و حالة الحصار بموجب قانون عضوي."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_93_19961128_OpEnact_594015e26f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_93> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_93> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_93> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يقرر رئيس الجمهورية الحالة الاستثنائية إذا كانت البلاد مهددة بخطر داهم يوشك أن يصيب مؤسساتها الدستورية أو استقلالها أو سلامة ترابها . ولا يتخذ مثل هذا الإجراء إلا بعد استشارة رئيس المجلس الشعبي الوطني ورئيس مجلس الأمة والمجلس الدستوري، والاستماع إلى المجلس الأعلى للأمن ومجلس الوزراء. تخول الحالة الاستثنائية رئيس الجمهورية أن يتخذ الإجراءات الاستثنائية التي تستوجبها المحافظة على استقلال الأمة والمؤسسات الدستورية في الجمهورية. ويجتمع البرلمان وجوبا . تنتهي الحالة الاستثنائية ، حسب الأشكال والإجراءات السالفة الذكر التي أوجبت إعلانها."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_94_19961128_OpEnact_f414eac80d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_94> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_94> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_94> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يقرر رئيس الجمهورية التعبئة العامة في مجلس الوزراء بعد الاستماع إلى المجلس الأعلى للأمن واستشارة رئيس المجلس الشعبي الوطني ورئيس مجلس الأمة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_95_19961128_OpEnact_6f740d620f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_95> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_95> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_95> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "إذا وقع عدوان فعلي على البلاد أو يوشك أن يقع حسبما نصت عليه الترتيبات الملائمة لميثاق الأمم المتحدة ، يعلن رئيس الجمهورية الحرب، بعد اجتماع مجلس الوزراء والاستماع إلى المجلس الأعلى للأمن واستشارة رئيس المجلس الشعبي الوطني ورئيس مجلس الأمة. ويجتمع البرلمان وجوبا . ويوجه رئيس الجمهورية خطابا للأمة يعلمها بذلك."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_96_19961128_OpEnact_a5b3f8a3d7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_96> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_96> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_96> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يوقف العمل بالدستور مدة حالة الحرب و يتولى رئيس الجمهورية جميع السلطات . وإذا انتهت المدة الرئاسية لرئيس الجمهورية تمدد وجوبا إلى غاية نهاية الحرب . في حالة استقالة رئيس الجمهورية أو وفاته أو حدوث أي مانع آخر له ، يخول رئيس مجلس الأمة باعتباره رئيسا للدولة، كل الصلاحيات التي تستوجبها حالة الحرب ، حسب الشروط نفسها التي تسري على رئيس الجمهورية . في حالة اقتران شغور رئاسة الجمهورية ورئاسة مجلس الأمة ، يتولى رئيس المجلس الدستوري وظائف رئيس الدولة حسب الشروط المبينة سابقا ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_97_19961128_OpEnact_c7c31cdd79> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_97> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_97> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_97> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يوقع رئيس الجمهورية اتفاقيات الهدنة ومعاهدات السلم . ويتلقى رأي المجلس الدستوري في الاتفاقيات المتعلقة بهما . ويعرضها فورا على كل غرفة من البرلمان لتوافق عليها صراحة ."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_99_19961128_OpEnact_b43d282289> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_99> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_99> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_99> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يراقب البرلمان عمل الحكومة وفقا لـ الشروط المحددة في المواد 80 و 84 و 133 و 134 من الدستور . يمارس المجلس الشعبي الوطني الرقابة المنصوص عليها في المواد من 135 إلى 137 من الدستور."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_9_19961128_OpEnact_87e55755b2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_9> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art_9> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_9> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "لا يجوز للمؤسسات أن تقوم بما يأتي : الممارسات الإقطاعية، والجهوية، والمحسوبية، إقامة علاقات الاستغلال والتبعية، السلوك المخالف للخلق الإسلامي وقيم ثورة نوفمبر."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art__181_19961128_OpEnact_1af44c5c95> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art__181> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1996-11-28/1996#art__181> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art__181> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "يجدد نصف (1/2) عدد أعضاء مجلس الأمة أثناء مدة العضوية الأولى عقب السنة الثالثة عن طريق القرعة . و يستخلف أعضاء مجلس الأمة الذين وقعت عليهم القرعة وفق الشروط نفسها وحسب الإجراء نفسه المعمول به في انتخابهم أو تعيينهم . لا تشمل القرعة رئيس مجلس الأمة الذي يمارس العهدة الأولى مدة ست (6) سنوات"@ar .

