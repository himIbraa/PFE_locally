<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_173> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤسس مجلس أعلى للأمن يرأسه رئيس الجمهورية ، مهمته تقديم الآراء إلى رئيس الجمهورية في كل القضايا المتعلقة بالأمن الوطني. يحدد رئيس الجمهورية كيفيات تنظيم المجلس الأعلى للأمن وعمله."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_173_19961128_OpEnact_03b8b1c0eb> ;
