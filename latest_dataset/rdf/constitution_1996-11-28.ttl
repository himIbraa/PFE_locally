<https://legal.dz/resource/constitution/1996-11-28/1996#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "على كل مواطن أن يؤدي بإخلاص واجباته تجاه المجموعة الوطنية . التزام المواطن إزاء الوطن وإجبارية المشاركة في الدفاع عنه، واجبان مقدسان دائمان . تضمن الدولة احترام رموز الثورة، وأرواح الشهداء، وكرامة ذويهم، والمجاهدين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_62_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_62_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_62_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_62_19961128_OpEnact_7a44acd976> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_62_obligation_0_e80ec231>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_62_obligation_1_bbf58b55>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_62_obligation_2_1d2b8d3d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 62" ;
    dzdoc:position 60 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثاني_الشعب> ;
    dzdoc:eId "art_9" ;
    dzdoc:fullText "لا يجوز للمؤسسات أن تقوم بما يأتي : الممارسات الإقطاعية، والجهوية، والمحسوبية، إقامة علاقات الاستغلال والتبعية، السلوك المخالف للخلق الإسلامي وقيم ثورة نوفمبر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_9_permission_0_545c1ac3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_9_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_9_19961128_OpEnact_87e55755b2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_9_obligation_0_362e3c68> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1996-11-28/1996#art_9_prohibition_0_545c1ac3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "9" ;
    dzdoc:position 8 .

