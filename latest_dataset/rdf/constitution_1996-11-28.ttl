<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_174> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لرئيس الجمهورية حق المبادرة بالتعديل الدستوري ، و بعد أن يصوت عليه المجلس الشعبي الوطني و مجلس الأمة بنفس الصيغة حسب الشروط نفسها التي تطبق على نص تشريعي ، يعرض التعديل على استفتاء الشعب خلال الخمسين (50) يوما الموالية لإقراره. يصدر رئيس الجمهورية التعديل الدستوري الذي صادق عليه الشعب."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_174_19961128_OpEnact_50e0bfeee8> ;
    dzdoc:replacementText "لرئيس الجمهورية حق المبادرة بالتعديل الدستوري ، و بعد أن يصوت عليه المجلس الشعبي الوطني و مجلس الأمة بنفس الصيغة حسب الشروط نفسها التي تطبق على نص تشريعي ، يعرض التعديل على استفتاء الشعب خلال الخمسين (50) يوما الموالية لإقراره. يصدر رئيس الجمهورية التعديل الدستوري الذي صادق عليه الشعب."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_174> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
