    dzdoc:position 1 ;
    dzdoc:text "يؤَسس مجلس دولة كهيئة مقومة لأعمال الجهات القضائية الإدارية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_152_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_152> ;
    dzdoc:position 2 ;
