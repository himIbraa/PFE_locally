    dznorm:provisionText "يجتمع المجلس الدستوري وجوبا ويثبت الشغور النهائي لرئاسة الجمهورية"@ar ;
    dznorm:sourceArticle "art_88" .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_88_obligation_4_40d58946> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
