    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_75_19961128_OpEnact_6563848a5e> ;
    dzdoc:replacementText "يؤدي رئيس الجمهورية اليمين أمام الشعب بحضور جميع الهيئات العليا في الأمة، خلال الأسبوع الموالي لانتخابه . ويباشر مهمته فور أدائه اليمين."@ar ;
