<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_81> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقدم رئيس الحكومة استقالة حكومته ل رئيس الجمهورية في حالة عدم موافقة المجلس الشعبي الوطني على البرنامج المعروض عليه. يعين رئيس الجمهورية من جديد رئيس حكومة حسب الكيفيات نفسها."@ar ;
    dzdoc:isAuthoritative true ;
