<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_90> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن أن تقال أو تعدل الحكومة القائمة إبان حصول المانع لرئيس الجمهورية، أو وفاته، أو استقالته، حتى يشرع رئيس الجمهورية الجديد في ممارسة مهامه . يستقيل رئيس الحكومة القائمة وجوبا، إذا ترشح لرئاسة الجمهورية ، ويمارس وظيفة رئيس الحكومة حينئذ أحد أعضائها الذي يعينه رئيس الدولة. لا يمكن، في فترتي الخمسة والأربعين (45) يوما والستين (60) يوما المنصوص عليهما في المادتين 88 و 89 ، تطبيق الأحكام المنصوص عليها في الفقرتين 7 و 8 من المادة 77 ، و المواد 79 و 124 و 129 و 136 و 137 و 174 و 176 و 177 من الدست"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_90_19961128_OpEnact_a4ed94e57e> ;
    dzdoc:replacementText "لا يمكن أن تقال أو تعدل الحكومة القائمة إبان حصول المانع لرئيس الجمهورية، أو وفاته، أو استقالته، حتى يشرع رئيس الجمهورية الجديد في ممارسة مهامه . يستقيل رئيس الحكومة القائمة وجوبا، إذا ترشح لرئاسة الجمهورية ، ويمارس وظيفة رئيس الحكومة حينئذ أحد أعضائها الذي يعينه رئيس الدولة. لا يمكن، في فترتي الخمسة والأربعين (45) يوما والستين (60) يوما المنصوص عليهما في المادتين 88 و 89 ، تطبيق الأحكام المنصوص عليها في الفقرتين 7 و 8 من المادة 77 ، و المواد 79 و 124 و 129 و 136 و 137 و 174 و 176 و 177 من الدستور. لا يمكن، خلال هاتين الفترتين، تطبيق أحكام المواد 91 و 93 و 94 و 95 و 97 من الدستور، إلا بموافقة البرلمان المنعقد بغرفتيه المجتمعتين معا، بعد استشارة المجلس الدستوري والمجلس الأعلى للأمن."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_90> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_90> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_91> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقرر رئيس الجمهورية، إذا دعت الضرورة الملحة ، حالة الطوارئ أو الحصار ، لمدة معينة بعد اجتماع المجلس الأعلى للأمن، واستشارة رئيس المجلس الشعبي الوطني، ورئيس مجلس الأمة، ورئيس الحكومة، ورئيس المجلس الدستوري، ويتخذ كل التدابير اللازمة لاستتباب الوضع. ولا يمكن تمديد حالة الطوارئ أو الحصار، إلا بعد موافقة البرلمان، المنعقد بغرفتيه المجتمعتين معا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_91_19961128_OpEnact_2b0bfee3c8> ;
    dzdoc:replacementText "يقرر رئيس الجمهورية، إذا دعت الضرورة الملحة ، حالة الطوارئ أو الحصار ، لمدة معينة بعد اجتماع المجلس الأعلى للأمن، واستشارة رئيس المجلس الشعبي الوطني، ورئيس مجلس الأمة، ورئيس الحكومة، ورئيس المجلس الدستوري، ويتخذ كل التدابير اللازمة لاستتباب الوضع. ولا يمكن تمديد حالة الطوارئ أو الحصار، إلا بعد موافقة البرلمان، المنعقد بغرفتيه المجتمعتين معا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
