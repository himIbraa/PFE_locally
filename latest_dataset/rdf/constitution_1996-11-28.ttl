<https://legal.dz/resource/constitution/1996-11-28/1996#art_73_condition_6_6f909d1e> a dznorm:Condition ;
    dznorm:conditionText "يثبت عدم تورط أبويه في أعمال ضد ثورة أول نوفمبر 1954 إذا كان مولودا بعد يوليو 1942"@ar ;
