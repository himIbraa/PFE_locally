    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "لا يمكن تمديد مهمة البرلمان إلا في ظروف خطيرة جدا لا تسمح بإجراء انتخابات عادية."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_102> .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_103_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_103> ;
    dzdoc:position 0 ;
    dzdoc:text "تحدد كيفيات انتخاب النواب وكيفيات انتخاب أعضاء مجلس الأمة أو تعيينهم، وشروط قابليتهم للانتخاب، ونظام عدم قابليتهم للانتخاب، وحالات التنافي، بموجب قانون عضوي."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_104_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_104> ;
    dzdoc:position 0 ;
    dzdoc:text "إثبات عضوية النواب وأعضاء مجلس الأمة من اختصاص كل من الغرفتين على حدة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_105_obligation_0_6602c416> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/constitution/1996-11-28/1996#art_105_obligation_0_6602c416_action_a535a69c9b> ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_105> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يمكن الجمع بينهما وبين مهام أو وظائف أخرى"@ar ;
    dznorm:sourceArticle "art_105" .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_105_obligation_0_6602c416_action_a535a69c9b> a dznorm:Action ;
    rdfs:label "الجمع بينهما وبين مهام أو"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "لا يمكن الجمع بينهما وبين مهام أو وظائف أخرى"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_105> .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_105_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_105> ;
    dzdoc:position 0 ;
    dzdoc:text "مهمة النائب وعضو مجلس الأمة وطنية، قابلة للتجديد، ولا يمكن الجمع بينهما وبين مهام أو وظائف أخرى."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_105_permission_0_961e2bca> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/constitution/1996-11-28/1996#art_105_permission_0_961e2bca_action_1352533392> ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_105> ;
    dznorm:position 0 ;
    dznorm:provisionText "مهمة النائب وعضو مجلس الأمة وطنية، قابلة للتجديد، ولا يمكن الجمع بينهما وبين مهام أو وظائف أخرى."@ar ;
    dznorm:sourceArticle "art_105" .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_105_permission_0_961e2bca_action_1352533392> a dznorm:Action ;
    rdfs:label "الجمع بينهما وبين مهام أو"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "مهمة النائب وعضو مجلس الأمة وطنية، قابلة للتجديد، ولا يمكن الجمع بينهما وبين مهام أو وظائف أخرى."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_105> .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_106_condition_0_dc471d50> a dznorm:Condition ;
    dznorm:conditionText "كل نائب أو عضو مجلس الأمة لا يستوفي شروط قابلية انتخابه أو يفقدها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_106> ;
    dznorm:position 0 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_106_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_106> ;
    dzdoc:position 0 ;
    dzdoc:text "كل نائب أو عضو مجلس الأمة لا يستوفي شروط قابلية انتخابه أو يفقدها، يتعرض لسقوط مهمته البرلمانية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_106_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_106> ;
    dzdoc:position 1 ;
    dzdoc:text "ويقرر المجلس الشعبي الوطني أو مجلس الأمة، حسب الحالة، هذا السقوط بأغلبية أعضائهما."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_107_condition_0_5bb515dc> a dznorm:Condition ;
    dznorm:conditionText "إن اقترف فعلا يخل بشرف مهمته"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_107> ;
    dznorm:position 0 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_107_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_107> ;
    dzdoc:position 0 ;
    dzdoc:text "النائب أو عضو مجلس الأمة مسؤول أمام زملائه الذين يمكنهم تجريده من مهمته النيابية إن اقترف فعلا يخل بشرف مهمته."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_107_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_107> ;
    dzdoc:position 1 ;
    dzdoc:text "يحدد النظام الداخلي لكل واحدة من الغرفتين، الشروط التي يتعرض فيها أي نائب أو عضو مجلس الأمة للإقصاء. ويقرر هذا الإقصاء، حسب الحالة، المجلس الشعبي الوطني أو مجلس الأمة بأغلبية أعضائهما، دون المساس بجميع المتابعات الأخرى الواردة في القانون."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_108_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_108> ;
    dzdoc:position 0 ;
    dzdoc:text "يحدد قانون عضوي الحالات التي يقبل فيها البرلمان استقالة أحد أعضائه."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_109_obligation_0_77a785d3> a dznorm:Obligation ;
