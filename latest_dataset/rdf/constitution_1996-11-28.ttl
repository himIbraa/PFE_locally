dzorg:الجريدة_الرسمية a dzdoc:Organization ;
    rdfs:label "الجريدة الرسمية"@ar ;
    dzdoc:frbrUri "/ontology/organization/dz/joradp"^^xsd:anyURI .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_100_obligation_0_683e0004> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_100> ;
    dznorm:position 0 ;
    dznorm:provisionText "واجب البرلمان، في إطار اختصاصاته الدستورية، أن يبقى وفيا لثقة الشعب، ويظل يتحسس تطلعاته"@ar ;
    dznorm:sourceArticle "art_100" .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_100_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_100> ;
    dzdoc:position 0 ;
    dzdoc:text "واجب البرلمان، في إطار اختصاصاته الدستورية، أن يبقى وفيا لثقة الشعب، ويظل يتحسس تطلعاته."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_101_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_101> ;
    dzdoc:position 0 ;
    dzdoc:text "ينتخب أعضاء المجلس الشعبي الوطني عن طريق الاقتراع العام المباشر والسري."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_101_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_101> ;
    dzdoc:position 1 ;
    dzdoc:text "ينتخب ثلثا (2/3) أعضاء مجلس الأمة عن طريق الاقتراع غير المباشر والسري من بين ومن طرف أعضاء المجالس الشعبية البلدية والمجلس الشعبي الولائي. ويعين رئيس الجمهورية الثلث الآخر من أعضاء مجلس الأمة من بين الشخصيات والكفاءات الوطنية في المجالات العلمية والثقافية والمهنية والاقتصادية والاجتماعية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_101_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_101> ;
    dzdoc:position 2 ;
    dzdoc:text "عدد أعضاء مجلس الأمة يساوي، على الأكثر، نصف عدد أعضاء المجلس الشعبي الوطني."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_101_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_101> ;
    dzdoc:position 3 ;
    dzdoc:text "يحدد القانون كيفيات تطبيق الفقرة الثانية السابقة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_102_condition_0_4923baa0> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/constitution/1996-11-28/1996#art_102_condition_0_4923baa0_action_9044331e01> ;
    dznorm:conditionText "لا يمكن تمديد مهمة البرلمان إلا في ظروف خطيرة جدا لا تسمح بإجراء انتخابات عادية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_102> ;
    dznorm:position 0 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_102_condition_0_4923baa0_action_9044331e01> a dznorm:Action ;
    rdfs:label "تمديد مهمة البرلمان إلا في"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "لا يمكن تمديد مهمة البرلمان إلا في ظروف خطيرة جدا لا تسمح بإجراء انتخابات عادية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_102> .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_102_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_102> ;
    dzdoc:position 0 ;
    dzdoc:text "ينتخب المجلس الشعبي الوطني لمدة خمس (05) سنوات."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_102_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_102> ;
    dzdoc:position 1 ;
    dzdoc:text "تحدد مهمة مجلس الأمة بمدة ست (06) سنوات."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_102_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_102> ;
    dzdoc:position 2 ;
    dzdoc:text "تجدد تشكيلة مجلس الأمة بالنصف كل ثلاث (03) سنوات."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_102_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_102> ;
    dzdoc:position 3 ;
    dzdoc:text "لا يمكن تمديد مهمة البرلمان إلا في ظروف خطيرة جدا لا تسمح بإجراء انتخابات عادية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_102_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_102> ;
    dzdoc:position 4 ;
    dzdoc:text "ويثبت البرلمان المنعقد بغرفتيه المجتمعتين معا هذه الحالة بقرار، بناء على اقتراح رئيس الجمهورية واستشارة المجلس الدستوري."@ar .

