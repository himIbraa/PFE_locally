    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:versionText "ينظر القضاء في الطعن في قرارات السلطات الإدارية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_144_19961128_OpEnact_45483883ad> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1996-11-28"^^xsd:date ;
