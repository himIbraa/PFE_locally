    dzdoc:position 1 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "واجب البرلمان ، في إطار اختصاصاته الدستورية، أن يبقى وفيا لثقة الشعب، ويظل يتحسس تطلعاته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_100> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_100_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_100_19961128_OpEnact_500afb1833> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_100_obligation_0_683e0004> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 100" ;
    dzdoc:position 97 ;
    dzdoc:usesTerm dzterm:parliament .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_112> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_112" ;
    dzdoc:fullText "يحدد قانون عضوي شروط استخلاف النائب أو عضو مجلس الأمة في حالة شغور مقعده ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_112> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_112_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_112_19961128_OpEnact_11caf0d844> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_112_obligation_0_029ae566> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 112" ;
    dzdoc:position 109 ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:organic_law .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_117> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_117" ;
    dzdoc:fullText "يشكل المجلس الشعبي الوطني و مجلس الأمة لجانهما الدائمة في إطار نظامهما الداخلي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_117> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_117_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_117_19961128_OpEnact_b496f38c8e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_117_obligation_0_0e2c23d6> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 117" ;
    dzdoc:position 114 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_14" ;
    dzdoc:fullText "تقوم الدولة على مبادئ التنظيم الديمقراطي والعدالة الاجتماعية. المجلس المنتخب هو الإطار الذي يعبر فيه الشعب عن إرادته، ويراقب عمل السلطات العمومية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_14_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_14_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_14_19961128_OpEnact_b0e924da94> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 14" ;
    dzdoc:position 13 ;
    dzdoc:usesTerm dzterm:elected_council,
        dzterm:state .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_140> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_140" ;
    dzdoc:fullText "أساس القضاء مبادئ الشرعية والمساواة. الكل سواسية أمام القضاء، وهو في متناول الجميع ويجسده احترام القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_140> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_140_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_140_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_140_19961128_OpEnact_1cf61e6b5e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 140" ;
    dzdoc:position 137 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_144> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_144" ;
    dzdoc:fullText "تعلل الأحكام القضائية، وينطق بها في جلسات علانية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_144> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_144_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_144_19961128_OpEnact_45483883ad> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_144_obligation_0_15a4cf65> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 144" ;
    dzdoc:position 141 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_149> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_149" ;
    dzdoc:fullText "القاضي مسؤول أمام المجلس الأعلى للقضاء عن كيفية قيامه بمهمته، حسب الأشكال المنصوص عليها في القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_149> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_149_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_149_19961128_OpEnact_a6429962a0> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 149" ;
    dzdoc:position 145 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_149_condition_0_33df019d> ;
    dzdoc:usesTerm dzterm:supreme_council_judiciary .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_150> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_150" ;
    dzdoc:fullText "يحمي القانون المتقاضي من أي تعسف أو أي انحراف يصدر من القاضي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_150> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_150_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_150_19961128_OpEnact_5a32966b0a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_150_obligation_0_bd4fba52> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 150" ;
    dzdoc:position 146 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_159> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_159" ;
    dzdoc:fullText "تضطلع المجالس المنتخبة بوظيفة الرقابة في مدلولها الشعبي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_159> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_159_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_159_19961128_OpEnact_7129b1dc98> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_159_obligation_0_2ff29c38> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 159" ;
    dzdoc:position 155 ;
    dzdoc:usesTerm dzterm:elected_councils .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_162> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_162" ;
    dzdoc:fullText "المؤسسات الدستورية و أجهزة الرقابة مكلفة بالتحقيق في تطابق العمل التشريعي والتنفيذي مع الدستور ، وفي ظروف استخدام الوسائل المادية والأموال العمومية وتسييرها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_162> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_162_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_162_19961128_OpEnact_74336a903d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_162_obligation_0_d9d73e4b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 162" ;
    dzdoc:position 158 ;
    dzdoc:usesTerm dzterm:constitution,
        dzterm:constitutional_institutions,
        dzterm:oversight_bodies .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_169> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_169" ;
    dzdoc:fullText "إذا ارتأى المجلس الدستوري أن نصا تشريعيا أو تنظيميا غير دستوري ، يفقد هذا النص أثره، ابتداء من يوم قرار المجلس."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_169> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_169_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_169_19961128_OpEnact_ee25ff2100> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 169" ;
    dzdoc:position 165 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_169_condition_0_2e597329> ;
    dzdoc:usesTerm dzterm:constitutional_council .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_173> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الثاني_المؤسسات_الاستشارية> ;
    dzdoc:eId "art_173" ;
    dzdoc:fullText "يؤسس مجلس أعلى للأمن يرأسه رئيس الجمهورية ، مهمته تقديم الآراء إلى رئيس الجمهورية في كل القضايا المتعلقة بالأمن الوطني. يحدد رئيس الجمهورية كيفيات تنظيم المجلس الأعلى للأمن وعمله."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_173> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_173_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_173_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_173_19961128_OpEnact_03b8b1c0eb> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 173" ;
    dzdoc:position 168 ;
    dzdoc:usesTerm dzterm:high_security_council,
        dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_19" ;
    dzdoc:fullText "تنظيم التجارة الخارجية من اختصاص الدولة . يحدد القانون شروط ممارسة التجارة الخارجية ومراقبتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_19_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_19_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_19_19961128_OpEnact_07e5a9cdaa> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 19" ;
    dzdoc:position 18 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "الدولة مسؤولة عن أمن الأشخاص والممتلكات، وتتكفل بحماية كل مواطن في الخارج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_24_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_24_19961128_OpEnact_1a5b78fad3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_24_obligation_0_3566c90b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 24" ;
    dzdoc:position 23 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_30" ;
    dzdoc:fullText "الجنسية الجزائرية ، معرفة بالقانون. شروط اكتساب الجنسية الجزائرية ، والاحتفاظ بها، أو فقدانها، أو إسقاطها، محددة بالقانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_30> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_30_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_30_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_30_19961128_OpEnact_5d33085ca9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 30" ;
    dzdoc:position 29 ;
    dzdoc:usesTerm dzterm:nationality .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "تستهدف المؤسسات ضمان مساواة كل المواطنين والمواطنات في الحقوق والواجبات بإزالة العقبات التي تعوق تفتح شخصية الإنسان، وتحول دون مشاركة الجميع الفعلية في الحياة السياسية، والاقتصادية، والاجتماعية، والثقافية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_31_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_31_19961128_OpEnact_b3e25806bf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_31_obligation_0_3a23e927> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 31" ;
    dzdoc:position 30 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "الدفاع الفردي أو عن طريق الجمعية عن الحقوق الأساسية للإنسان وعن الحريات الفردية والجماعية، مضمون ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_33_right_0_e6b93c58> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_33_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_33_19961128_OpEnact_2814e137b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 33" ;
    dzdoc:position 32 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "لا مساس بحرمة حرية المعتقد، وحرمة حرية الرأي ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_36_right_0_b740d761> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_36_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_36_19961128_OpEnact_bae17cbf7c> ;
