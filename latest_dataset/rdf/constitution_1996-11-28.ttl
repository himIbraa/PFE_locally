<https://legal.dz/resource/constitution/1996-11-28/1996#art__181_obligation_0_d0103991> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art__181> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجدد نصف (1/2) عدد أعضاء مجلس الأمة أثناء مدة العضوية الأولى عقب السنة الثالثة عن طريق القرعة"@ar ;
    dznorm:sourceArticle "art__181" .

<https://legal.dz/resource/constitution/1996-11-28/1996#art__181_obligation_1_ae254cf4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art__181> ;
    dznorm:position 1 ;
    dznorm:provisionText "يستخلف أعضاء مجلس الأمة الذين وقعت عليهم القرعة وفق الشروط نفسها وحسب الإجراء نفسه المعمول به في انتخابهم أو تعيينهم"@ar ;
    dznorm:sourceArticle "art__181" .

<https://legal.dz/resource/constitution/1996-11-28/1996#art__181_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art__181> ;
    dzdoc:position 0 ;
    dzdoc:text "يجدد نصف (1/2) عدد أعضاء مجلس الأمة أثناء مدة العضوية الأولى عقب السنة الثالثة عن طريق القرعة. ويستخلف أعضاء مجلس الأمة الذين وقعت عليهم القرعة وفق الشروط نفسها وحسب الإجراء نفسه المعمول به في انتخابهم أو تعيينهم."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art__181_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art__181> ;
    dzdoc:position 1 ;
    dzdoc:text "لا تشمل القرعة رئيس مجلس الأمة الذي يمارس العهدة الأولى مدة ست (6) سنوات"@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preamble_segment_1> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#preamble> ;
    dzdoc:position 1 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "الشعب الجزائري شعب حر، ومصمم على البقاء حرا."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preamble_segment_10> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#preamble> ;
    dzdoc:position 10 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "إن الدستور فوق الجميع، وهو القانون الأساسي الذي يضمن الحقوق والحريات الفردية والجماعية، ويحمي مبدأ حرية اختيار الشعب، ويضفي الشرعية على ممارسة السلطات، ويكفل الحماية القانونية، ورقابة عمل السلطات العمومية في مجتمع تسوده الشرعية، ويتحقق فيه تفتح الإنسان بكل أبعاده."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preamble_segment_11> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#preamble> ;
    dzdoc:position 11 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "فالشعب المتحصن بقيمه الروحية الراسخة، والمحافظ على تقاليده في التضامن والعدل، واثق في قدرته على المساهمة الفعالة في التقدم الثقافي، والاجتماعي، والاقتصادي، في عالم اليوم والغد."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preamble_segment_12> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#preamble> ;
    dzdoc:position 12 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "إن الجزائر، أرض الإسلام، وجزء لا يتجزأ من المغرب العربي الكبير، وأرض عربية، وبلاد متوسطية وإفريقية تعتز بإشعاع ثورتها، ثورة أول نوفمبر، ويشرفها الاحترام الذي أحرزته، وعرفت كيف تحافظ عليه بالتزامها إزاء كل القضايا العادلة في العالم."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preamble_segment_13> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#preamble> ;
    dzdoc:position 13 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "وفخر الشعب، وتضحياته، وإحساسه بالمسؤوليات، وتمسكه العريق بالحرية، والعدالة الاجتماعية، تمثل كلها أحسن ضمان لاحترام مبادئ هذا الدستور الذي يصادق عليه وينقله إلى الأجيال القادمة ورثة رواد الحرية، وبناة المجتمع الحر"@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preamble_segment_14> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#preamble> ;
    dzdoc:position 14 ;
    dzdoc:segmentType "formula" ;
    dzdoc:text "[يمضي الدستور الآتي نصه]"@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preamble_segment_2> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#preamble> ;
    dzdoc:position 2 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "فتاريخه الطويل سلسلة متصلة الحلقات من الكفاح والجهاد، جعلت الجزائر دائما منبت الحرية، وأرض العزة والكرامة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preamble_segment_3> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#preamble> ;
    dzdoc:position 3 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "لقد عرفت الجزائر في أعز اللحظات الحاسمة التي عاشها البحر الأبيض المتوسط، كيف تجد في أبنائها، منذ العهد النوميدي، والفتح الإسلامي، حتى الحروب التحريرية من الاستعمار، روادا للحرية، والوحدة والرقي، وبناة دول ديمقراطية مزدهرة، طوال فترات المجد والسلام."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preamble_segment_4> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#preamble> ;
    dzdoc:position 4 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "وكان أول نوفمبر 1954 نقطة تحول فاصلة في تقرير مصيرها وتتويجا عظيما لمقاومة ضروس، واجهت بها مختلف الاعتداءات على ثقافتها، وقيمها، والمكونات الأساسية لهويتها، وهي الإسلام والعروبة والأمازيغية. وتمتد جذور نضالها اليوم في شتى الميادين في ماضي أمتها المجيد."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preamble_segment_5> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#preamble> ;
    dzdoc:position 5 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "لقد تجمع الشعب الجزائري في ظل الحركة الوطنية، ثم انضوى تحت لواء جبهة التحرير الوطني، وقدم تضحيات جساما من أجل أن يتكفل بمصيره الجماعي في كنف الحرية والهوية الثقافية الوطنية المستعادتين، ويشيد مؤسساته الدستورية الشعبية الأصيلة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preamble_segment_6> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#preamble> ;
    dzdoc:position 6 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "وقد توجت جبهة التحرير الوطني ما بذله خيرة أبناء الجزائر من تضحيات في الحرب التحريرية الشعبية بالاستقلال، وشيدت دولة عصرية كاملة السيادة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preamble_segment_7> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#preamble> ;
    dzdoc:position 7 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "إن إيمان الشعب بالاختيارات الجماعية مكنه من تحقيق انتصارات كبرى، طبعتها استعادة الثروات الوطنية بطابعها، وجعلتها دولة في خدمة الشعب وحده، تمارس سلطاتها بكل استقلالية، بعيدة عن أي ضغط خارجي."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preamble_segment_8> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#preamble> ;
    dzdoc:position 8 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "إن الشعب الجزائري ناضل ويناضل دوما في سبيل الحرية والديمقراطية، ويعتزم أن يبني بهذا الدستور مؤسسات دستورية، أساسها مشاركة كل جزائري وجزائرية في تسيير الشؤون العمومية، والقدرة على تحقيق العدالة الاجتماعية، والمساواة، وضمان الحرية لكل فرد."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preamble_segment_9> a dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#preamble> ;
    dzdoc:position 9 ;
    dzdoc:segmentType "paragraph" ;
    dzdoc:text "فالدستور يجسم عبقرية الشعب الخاصة، ومرآته الصافية التي تعكس تطلعاته، وثمرة إصراره، ونتاج التحولات الاجتماعية العميقة التي أحدثها، وبموافقته عليه يؤكد بكل عزم وتقدير أكثر من أي وقت مضى سمو القانون."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#preface> a dzdoc:Preface ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996> .

