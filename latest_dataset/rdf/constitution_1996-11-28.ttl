<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_11> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تستمد الدولة مشروعيتها وسبب وجودها من إرادة الشعب. شعارها : ” بالشعب وللشعب “. وهي في خدمته وحده."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
