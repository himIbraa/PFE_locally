    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقوم الدولة على مبادئ التنظيم الديمقراطي والعدالة الاجتماعية. المجلس المنتخب هو الإطار الذي يعبر فيه الشعب عن إرادته، ويراقب عمل السلطات العمومية."@ar ;
    dzdoc:isAuthoritative true ;
