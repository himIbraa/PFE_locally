    dznorm:conditionText "يكون عمره أربعين (40) سنة كاملة يوم الانتخاب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_73> ;
    dznorm:position 2 .

