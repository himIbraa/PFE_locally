<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_115> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد قانون عضوي تنظيم المجلس الشعبي الوطني و مجلس الأمة ، وعملهما، وكذا العلاقات الوظيفية بينهما وبين الحكومة . يحدد القانون ميزانية الغرفتين والتعويضات التي تدفع للنواب وأعضاء مجلس الأمة . يعد المجلس الشعبي الوطني و مجلس الأمة نظامهما الداخلي ويصادقان عليهما ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_115_19961128_OpEnact_76133bcbea> ;
    dzdoc:replacementText "يحدد قانون عضوي تنظيم المجلس الشعبي الوطني و مجلس الأمة ، وعملهما، وكذا العلاقات الوظيفية بينهما وبين الحكومة . يحدد القانون ميزانية الغرفتين والتعويضات التي تدفع للنواب وأعضاء مجلس الأمة . يعد المجلس الشعبي الوطني و مجلس الأمة نظامهما الداخلي ويصادقان عليهما ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
