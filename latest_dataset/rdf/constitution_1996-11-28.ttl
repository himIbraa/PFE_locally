<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_175> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يصبح القانون الذي يتضمن مشروع التعديل الدستوري لاغيا، إذا رفضه الشعب . ولا يمكن عرضه من جديد على الشعب خلال الفترة التشريعية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_175_19961128_OpEnact_41a0bcfef5> ;
    dzdoc:replacementText "يصبح القانون الذي يتضمن مشروع التعديل الدستوري لاغيا، إذا رفضه الشعب . ولا يمكن عرضه من جديد على الشعب خلال الفترة التشريعية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_175> ;
