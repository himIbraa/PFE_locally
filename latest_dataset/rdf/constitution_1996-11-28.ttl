<https://legal.dz/resource/constitution/1996-11-28/1996#art_165_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_165> ;
    dzdoc:position 2 ;
    dzdoc:text "كما يفصل المجلس الدستوري في مطابقة النظام الداخلي لكل من غرفتي البرلمان للدستور، حسب الإجراءات المذكورة في الفقرة السابقة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الأول_الجزائر> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "الجزائر جمهورية ديمقراطية شعبية. وهي وحدة لا تتجزأ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_1_19961128_OpEnact_791115d5a1> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "الأولى" ;
    dzdoc:position 0 ;
    dzdoc:usesTerm dzterm:algeria .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_103> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_103" ;
    dzdoc:fullText "تحدد كيفيات انتخاب النواب وكيفيات انتخاب أعضاء مجلس الأمة أو تعيينهم، وشروط قابليتهم للانتخاب، ونظام عدم قابليتهم للانتخاب، وحالات التنافي، بموجب قانون عضوي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_103> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_103_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_103_19961128_OpEnact_ba27b4a0ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 103" ;
    dzdoc:position 100 ;
    dzdoc:usesTerm dzterm:council_nation .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_104> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_104" ;
    dzdoc:fullText "إثبات عضوية النواب وأعضاء مجلس الأمة من اختصاص كل من الغرفتين على حدة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_104> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_104_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_104_19961128_OpEnact_89bd05206e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 104" ;
    dzdoc:position 101 ;
    dzdoc:usesTerm dzterm:council_nation .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_108> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_108" ;
    dzdoc:fullText "يحدد قانون عضوي الحالات التي يقبل فيها البرلمان استقالة أحد أعضائه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_108> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_108_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_108_19961128_OpEnact_5ddfd49169> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 108" ;
    dzdoc:position 105 ;
    dzdoc:usesTerm dzterm:parliament .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_132> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_132" ;
    dzdoc:fullText "المعاهدات التي يصادق عليها رئيس الجمهورية ، حسب الشروط المنصوص عليها في الدستور، تسمو على القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_132> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_132_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_132_19961128_OpEnact_53484a742a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 132" ;
    dzdoc:position 129 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_138> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_138" ;
    dzdoc:fullText "السلطة القضائية مستقلة، وتمارس في إطار القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_138> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_138_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_138_19961128_OpEnact_d433ad2dc7> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 138" ;
    dzdoc:position 135 ;
    dzdoc:usesTerm dzterm:judicial_authority .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_141> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_141" ;
    dzdoc:fullText "يصدر القضاء أحكامه باسم الشعب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_141> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_141_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_141_19961128_OpEnact_860ed68402> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 141" ;
    dzdoc:position 138 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_142> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_142" ;
    dzdoc:fullText "تخضع العقوبات الجزائية إلى مبدئي الشرعية والشخصية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_142> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_142_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_142_19961128_OpEnact_c2b2dd749c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 142" ;
    dzdoc:position 139 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_143> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_143" ;
    dzdoc:fullText "ينظر القضاء في الطعن في قرارات السلطات الإدارية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_143> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_143_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_143_19961128_OpEnact_7903509018> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 143" ;
    dzdoc:position 140 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_147> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_147" ;
    dzdoc:fullText "لا يخضع القاضي إلا للقانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_147> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_147_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_147_19961128_OpEnact_ac052be125> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 147" ;
    dzdoc:position 144 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_153> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_153" ;
    dzdoc:fullText "يحدد قانون عضوي تنظيم المحكمة العليا ، و مجلس الدولة ، و محكمة التنازع ، وعملهم، واختصاصاتهم الأخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_153> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_153_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_153_19961128_OpEnact_a028a80520> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 153" ;
    dzdoc:position 149 ;
    dzdoc:usesTerm dzterm:conflict_court,
        dzterm:state_council,
        dzterm:supreme_court .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_154> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_154" ;
    dzdoc:fullText "يرأس رئيس الجمهورية ، المجلس الأعلى للقضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_154> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_154_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_154_19961128_OpEnact_a0ee0cbe9c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 154" ;
    dzdoc:position 150 ;
    dzdoc:usesTerm dzterm:president,
        dzterm:supreme_council_judiciary .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_156> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_156" ;
    dzdoc:fullText "يبدي المجلس الأعلى للقضاء رأيا استشاريا قبليا في ممارسة رئيس الجمهورية حق العفو."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_156> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_156_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_156_19961128_OpEnact_a93470985f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 156" ;
    dzdoc:position 152 ;
    dzdoc:usesTerm dzterm:president,
        dzterm:supreme_council_judiciary .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "يحدد قانون عضوي تشكيل المجلس الأعلى للقضاء ، وعمله، وصلاحياته الأخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_157_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_157_19961128_OpEnact_e06bc6bac3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 157" ;
    dzdoc:position 153 ;
    dzdoc:usesTerm dzterm:supreme_council_judiciary .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "يمثل المجلس المنتخب قاعدة اللامركزية، ومكان مشاركة المواطنين في تسيير الشؤون العمومية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_16_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_16_19961128_OpEnact_9a2fef67fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 16" ;
    dzdoc:position 15 ;
    dzdoc:usesTerm dzterm:elected_council .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_171> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الثاني_المؤسسات_الاستشارية> ;
    dzdoc:eId "art_171" ;
    dzdoc:fullText "يؤسس لدى رئيس الجمهورية مجلس إسلامي أعلى ، يتولى على الخصوص ما يأتي : الحث على الاجتهاد وترقيته، إبداء الحكم الشرعي فيما يعرض عليه، رفع تقرير دوري عن نشاطه إلى رئيس الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_171> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_171_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_171_19961128_OpEnact_6439edf6b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 171" ;
    dzdoc:position 166 ;
    dzdoc:usesTerm dzterm:high_islamic_council,
        dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_172> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الثاني_المؤسسات_الاستشارية> ;
    dzdoc:eId "art_172" ;
    dzdoc:fullText "يتكون المجلس الإسلامي الأعلى من خمسة عشر (15) عضوا منهم الرئيس، يعينهم رئيس الجمهورية من بين الكفاءات الوطنية العليا في مختلف العلوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_172> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_172_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_172_19961128_OpEnact_d9210de85b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 172" ;
    dzdoc:position 167 ;
    dzdoc:usesTerm dzterm:high_islamic_council,
        dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_179> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الرابع_التعديل_الدستوري> ;
    dzdoc:eId "art_179" ;
    dzdoc:fullText "تتولى الهيئة التشريعية القائمة عند إصدار هذا الدستور وإلى غاية انتهاء مهمتها وكذا رئيس الجمهورية بعد انتهاء هذه المهمة وإلى غاية انتخاب المجلس الشعبي الوطني ، مهمة التشريع بأوامر بما في ذلك في المسائل التي أصبحت تدخل ضمن القوانين العضوية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_179> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_179_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_179_19961128_OpEnact_a3480f19f0> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 179" ;
    dzdoc:position 174 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_180> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الرابع_التعديل_الدستوري> ;
    dzdoc:eId "art_180" ;
    dzdoc:fullText "ريثما يتم تنصيب المؤسسات المنصوص عليها في هذا الدستور : يستمر سريان مفعول القوانين التي تتعلق بالمواضيع التي تخضع لمجال القوانين العضوية، إلى أن تعدل أو تستبدل وفق الإجراءات المنصوص عليها في الدستور، يمارس المجلس الدستوري بتمثيله الحالي الاختصاصات المسندة إليه بموجب هذا الدستور، حتى تاريخ تنصيب المؤسسات الممثلة فيه. وكل تغيير أو إضافة يجب أن يتم مع مراعاة الفقرة 3 من المادة 164 من هذا الدستور، مع استعمال القرعة عند الحاجة، يمارس المجلس الشعبي الوطني المنتخب السلطة التشريعية كاملة حتى تنصيب مجلس الأمة . ويمكن رئيس الجمهورية وقف إصدار القوانين المتخذة بمبادرة من النواب إلى غاية المصادقة عليها من قبل مجلس الأمة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_180> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_180_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_180_19961128_OpEnact_4bcc330969> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 180" ;
    dzdoc:position 175 ;
    dzdoc:references <https://legal.dz/resource/constitution/1996-11-28/1996#art_164> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/1996-11-28/1996#art_164> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:constitutional_council,
        dzterm:council_nation,
        dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_2> a dzdoc:Article ;
