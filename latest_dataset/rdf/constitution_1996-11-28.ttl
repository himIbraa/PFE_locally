    dzdoc:fullText "الإسلام دين الدولة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_2_para_0> ;
