<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_158> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تؤسس محكمة عليا للدولة ، تختص بمحاكمة رئيس الجمهورية عن الأفعال التي يمكن وصفها بالخيانة العظمى، و رئيس الحكومة عن الجنايات والجنح، التي يرتكبانها بمناسبة تأديتهما مهامهما . يحدد قانون عضوي تشكيلة المحكمة العليا للدولة وتنظيمها وسيرها وكذا الإجراءات المطبقة"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
