    dzdoc:position 131 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_134_condition_0_88850564> ;
    dzdoc:usesTerm dzterm:government,
        dzterm:internal_rules,
        dzterm:parliament_members .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_95> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_95" ;
    dzdoc:fullText "إذا وقع عدوان فعلي على البلاد أو يوشك أن يقع حسبما نصت عليه الترتيبات الملائمة لميثاق الأمم المتحدة ، يعلن رئيس الجمهورية الحرب، بعد اجتماع مجلس الوزراء والاستماع إلى المجلس الأعلى للأمن واستشارة رئيس المجلس الشعبي الوطني ورئيس مجلس الأمة. ويجتمع البرلمان وجوبا . ويوجه رئيس الجمهورية خطابا للأمة يعلمها بذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_95> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_95_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_95_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_95_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_95_19961128_OpEnact_6f740d620f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_95_obligation_0_5a7e9308> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 95" ;
    dzdoc:position 93 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_95_condition_0_6e2e0802> .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "يوقف العمل بالدستور مدة حالة الحرب و يتولى رئيس الجمهورية جميع السلطات . وإذا انتهت المدة الرئاسية لرئيس الجمهورية تمدد وجوبا إلى غاية نهاية الحرب . في حالة استقالة رئيس الجمهورية أو وفاته أو حدوث أي مانع آخر له ، يخول رئيس مجلس الأمة باعتباره رئيسا للدولة، كل الصلاحيات التي تستوجبها حالة الحرب ، حسب الشروط نفسها التي تسري على رئيس الجمهورية . في حالة اقتران شغور رئاسة الجمهورية ورئاسة مجلس الأمة ، يتولى رئيس المجلس الدستوري وظائف رئيس الدولة حسب الشروط المبينة سابقا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_96_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_96_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_96_para_2>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_96_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_96_19961128_OpEnact_a5b3f8a3d7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_96_obligation_0_32b36d82>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_96_obligation_1_88249845>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_96_obligation_2_087e015c>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_96_obligation_3_6687efab>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_96_obligation_4_cd51199d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 96" ;
    dzdoc:position 94 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_96_condition_0_e40cb7e4>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_96_condition_1_1120c8c3>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_96_condition_2_261b0bf1> ;
    dzdoc:usesTerm dzterm:president,
        dzterm:president_of_constitutional_council,
        dzterm:president_of_council_of_nation .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_91> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_91" ;
    dzdoc:fullText "يقرر رئيس الجمهورية، إذا دعت الضرورة الملحة ، حالة الطوارئ أو الحصار ، لمدة معينة بعد اجتماع المجلس الأعلى للأمن، واستشارة رئيس المجلس الشعبي الوطني، ورئيس مجلس الأمة، ورئيس الحكومة، ورئيس المجلس الدستوري، ويتخذ كل التدابير اللازمة لاستتباب الوضع. ولا يمكن تمديد حالة الطوارئ أو الحصار، إلا بعد موافقة البرلمان، المنعقد بغرفتيه المجتمعتين معا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_91_permission_0_90080bb2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_91> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_91_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_91_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_91_19961128_OpEnact_2b0bfee3c8> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 91" ;
    dzdoc:position 89 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_91_condition_0_ef2cac40>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_91_condition_1_5b518f3e> ;
    dzdoc:usesTerm dzterm:emergency_state,
        dzterm:siege_state .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_97> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_97" ;
    dzdoc:fullText "يوقع رئيس الجمهورية اتفاقيات الهدنة ومعاهدات السلم . ويتلقى رأي المجلس الدستوري في الاتفاقيات المتعلقة بهما . ويعرضها فورا على كل غرفة من البرلمان لتوافق عليها صراحة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_97_right_0_465d5165> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_97> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_97_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_97_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_97_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_97_19961128_OpEnact_c7c31cdd79> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_97_obligation_0_0527abc1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_97_obligation_1_c8a6bef5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 97" ;
    dzdoc:position 95 ;
    dzdoc:usesTerm dzterm:constitutional_council,
        dzterm:parliament,
        dzterm:president .

