    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يكون كل مشروع أو اقتراح قانون موضوع مناقشة من طرف المجلس الشعبي الوطني و مجلس الأمة على التوالي حتى تتم المصادقة عليه . تنصب مناقشة مشاريع أو اقتراحات القوانين من طرف المجلس الشعبي الوطني على النص المعروض عليه. يناقش مجلس الأمة النص الذي صوت عليه المجلس الشعبي الوطني ويصادق عليه بأغلبية ثلاثة أرباع (4/3) أعضائه. وفي حالة حدوث خلاف بين الغرفتين ، تجتمع، بطلب من رئيس الحكومة ، لجنة متساوية الأعضاء تتكون من أعضاء كلتا الغرفتين من أجل اقتراح نص يتعلق بالأحكام محل الخلاف. تعرض الحكومة هذا النص"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_120_19961128_OpEnact_c5ccad65fe> ;
    dzdoc:replacementText "يجب أن يكون كل مشروع أو اقتراح قانون موضوع مناقشة من طرف المجلس الشعبي الوطني و مجلس الأمة على التوالي حتى تتم المصادقة عليه . تنصب مناقشة مشاريع أو اقتراحات القوانين من طرف المجلس الشعبي الوطني على النص المعروض عليه. يناقش مجلس الأمة النص الذي صوت عليه المجلس الشعبي الوطني ويصادق عليه بأغلبية ثلاثة أرباع (4/3) أعضائه. وفي حالة حدوث خلاف بين الغرفتين ، تجتمع، بطلب من رئيس الحكومة ، لجنة متساوية الأعضاء تتكون من أعضاء كلتا الغرفتين من أجل اقتراح نص يتعلق بالأحكام محل الخلاف. تعرض الحكومة هذا النص على الغرفتين للمصادقة عليه، و لا يمكن إدخال أي تعديل عليه إلا بموافقة الحكومة . وفي حالة استمرار الخلاف يسحب النص. يصادق البرلمان على قانون المالية في مدة أقصاها خمسة وسبعون (75) يوما من تاريخ إيداعه، طبقا للفقرات السابقة. وفي حالة عدم المصادقة عليه في الأجل المحدد سابقا ، يصدر رئيس الجمهورية مشروع الحكومة بأمر . تحدد الإجراءات الأخرى بموجب القانون العضوي المذكور في المادة 115 من الدستور."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_120> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_120> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_121> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يقبل اقتراح أي قانون، مضمونه أو نتيجته تخفيض الموارد العمومية، أو زيادة النفقات العمومية، إلا إذا كان مرفوقا بتدابير تستهدف الزيادة في إيرادات الدولة، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي على الأقل المبالغ المقترح إنفاقها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_121_19961128_OpEnact_ccef435f2f> ;
    dzdoc:replacementText "لا يقبل اقتراح أي قانون، مضمونه أو نتيجته تخفيض الموارد العمومية، أو زيادة النفقات العمومية، إلا إذا كان مرفوقا بتدابير تستهدف الزيادة في إيرادات الدولة، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي على الأقل المبالغ المقترح إنفاقها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_121> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
