<https://legal.dz/resource/constitution/1996-11-28/1996#version_art__181> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجدد نصف (1/2) عدد أعضاء مجلس الأمة أثناء مدة العضوية الأولى عقب السنة الثالثة عن طريق القرعة . و يستخلف أعضاء مجلس الأمة الذين وقعت عليهم القرعة وفق الشروط نفسها وحسب الإجراء نفسه المعمول به في انتخابهم أو تعيينهم . لا تشمل القرعة رئيس مجلس الأمة الذي يمارس العهدة الأولى مدة ست (6) سنوات"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
