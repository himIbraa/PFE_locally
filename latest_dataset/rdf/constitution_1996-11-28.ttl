<https://legal.dz/resource/constitution/1996-11-28/1996#art_176_condition_0_aacf4f4f> a dznorm:Condition ;
    dznorm:conditionText "إذا ارتأى المجلس الدستوري أن مشروع أي تعديل دستوري لا يمس البتة المبادئ العامة التي تحكم المجتمع الجزائري، وحقوق الإنسان والمواطن وحرياتهما، ولا يمس بأي كيفية التوازنات الأساسية للسلطات والمؤسسات الدستورية، وعلل رأيه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_176> ;
    dznorm:position 0 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_176_condition_1_76eca6c2> a dznorm:Condition ;
    dznorm:conditionText "متى أحرز ثلاثة أرباع (3/4) أصوات أعضاء غرفتي البرلمان"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_176> ;
    dznorm:position 1 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_176_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_176> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا ارتأى المجلس الدستوري أن مشروع أي تعديل دستوري لا يمس البتة المبادئ العامة التي تحكم المجتمع الجزائري، وحقوق الإنسان والمواطن وحرياتهما، ولا يمس بأي كيفية التوازنات الأساسية للسلطات والمؤسسات الدستورية، وعلل رأيه، أمكن رئيس الجمهورية أن يصدر القانون الذي يتضمن التعديل الدستوري مباشرة دون أن يعرضه على الاستفتاء الشعبي، متى أحرز ثلاثة أرباع (3/4) أصوات أعضاء غرفتي البرلمان."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_177_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_177> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن ثلاثة أرباع (3/4) أعضاء غرفتي البرلمان المجتمعتين معا، أن يبادروا باقتراح تعديل الدستور على رئيس الجمهورية الذي يمكنه عرضه على الاستفتاء الشعبي."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_177_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_177> ;
    dzdoc:position 1 ;
    dzdoc:text "ويصدره في حالة الموافقة عليه."@ar .

