<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_160> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقدم الحكومة لكل غرفة من البرلمان عرضا عن استعمال الاعتمادات المالية التي أقرتها لكل سنة مالية . تختتم السنة المالية فيما يخص البرلمان ، بالتصويت على قانون يتضمن تسوية ميزانية السنة المالية المعنية من قبل كل غرفة من البرلمان ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
