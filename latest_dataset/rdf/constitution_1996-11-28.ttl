<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_111> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة تلبس أحد النواب أو أحد أعضاء مجلس الأمة بجنحة أو جناية ، يمكن توقيفه . ويخطر بذلك مكتب المجلس الشعبي الوطني ، أو مكتب مجلس الأمة ، حسب الحالة، فورا . يمكن المكتب المخطر أن يطلب إيقاف المتابعة وإطلاق سراح النائب أو عضو مجلس الأمة ، على أن يعمل فيما بعد بأحكام المادة 110 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_111_19961128_OpEnact_7e78acf419> ;
    dzdoc:replacementText "في حالة تلبس أحد النواب أو أحد أعضاء مجلس الأمة بجنحة أو جناية ، يمكن توقيفه . ويخطر بذلك مكتب المجلس الشعبي الوطني ، أو مكتب مجلس الأمة ، حسب الحالة، فورا . يمكن المكتب المخطر أن يطلب إيقاف المتابعة وإطلاق سراح النائب أو عضو مجلس الأمة ، على أن يعمل فيما بعد بأحكام المادة 110 أعلاه."@ar ;
