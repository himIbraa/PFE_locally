<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_129> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن رئيس الجمهورية أن يقرر حل المجلس الشعبي الوطني، أو إجراء انتخابات تشريعية قبل أوانها ، بعد استشارة رئيس المجلس الشعبي الوطني، ورئيس مجلس الأمة، ورئيس الحكومة . وتجري هذه الانتخابات في كلتا الحالتين في أجل أقصاه ثلاثة (03) أشهر ."@ar ;
