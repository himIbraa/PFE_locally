    dzdoc:position 56 ;
    dzdoc:usesTerm dzterm:family,
        dzterm:state .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "ظروف معيشة المواطنين الذين لم يبلغوا سن العمل، والذين لا يستطيعون القيام به، والذين عجزوا عنه نهائيا، مضمونة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_59_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_59_19961128_OpEnact_7f2f3e2c89> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_59_obligation_0_8d0b6832> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 59" ;
    dzdoc:position 57 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثاني_الشعب> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "الشعب مصدر كل سلطة. السيادة الوطنية ملك للشعب وحده."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_6_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_6_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_6_19961128_OpEnact_9045add1a0> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "6" ;
    dzdoc:position 5 ;
    dzdoc:usesTerm dzterm:السيادة_الوطنية,
        dzterm:الشعب .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_67> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_67" ;
    dzdoc:fullText "يتمتع كل أجنبي، يكون وجوده فوق التراب الوطني قانونيا، بحماية شخصه وأملاكه طبقا للقانون ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_67_right_0_e1b942a7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_67> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_67_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_67_19961128_OpEnact_56ca020add> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 67" ;
    dzdoc:position 65 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "يؤدي رئيس الجمهورية اليمين حسب النص الآتي : ” بسم الله الرحمن الرحيم ، وفاء للتضحيات الكبرى، ولأرواح شهدائنا الأبرار، وقيم ثورة نوفمبر الخالدة، أقسم بالله العلي العظيم، أن أحترم الدين الإسلامي وأمجده، وأدافع عن الدستور ، وأسهر على استمرارية الدولة، وأعمل على توفير الشروط اللازمة للسير العادي للمؤسسات والنظام الدستوري، وأسعى من أجل تدعيم المسار الديمقراطي، وأحترم حرية اختيار الشعب، ومؤسسات الجمهورية وقوانينها، وأحافظ على سلامة التراب الوطني، ووحدة الشعب والأمة، وأحمي الحريات والحقوق الأساسية للإنسان والمواطن، وأعمل بدون هوادة من أجل تطور الشعب وازدهاره، وأسعى بكل قواي في سبيل تحقيق المثل العليا للعدالة والحرية والسلم في العالم. والله على ما أقول شهيد “."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_76_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_76_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_76_19961128_OpEnact_985cb35866> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 76" ;
    dzdoc:position 74 ;
    dzdoc:references <https://legal.dz/resource/constitution/1996-11-28/1996#constitution> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/1996-11-28/1996#constitution> ;
    dzdoc:usesTerm dzterm:president .

dzterm:state a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الدولة"@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_106> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_106" ;
    dzdoc:fullText "كل نائب أو عضو مجلس الأمة لا يستوفي شروط قابلية انتخابه أو يفقدها ، يتعرض لسقوط مهمته البرلمانية. ويقرر المجلس الشعبي الوطني أو مجلس الأمة ، حسب الحالة، هذا السقوط بأغلبية أعضائهما."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_106> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_106_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_106_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_106_19961128_OpEnact_6dc13b6687> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 106" ;
    dzdoc:position 103 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_106_condition_0_dc471d50> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_nation .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_107> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_107" ;
    dzdoc:fullText "النائب أو عضو مجلس الأمة مسؤول أمام زملائه الذين يمكنهم تجريده من مهمته النيابية إن اقترف فعلا يخل بشرف مهمته . يحدد النظام الداخلي لكل واحدة من الغرفتين، الشروط التي يتعرض فيها أي نائب أو عضو مجلس الأمة للإقصاء. ويقرر هذا الإقصاء، حسب الحالة، المجلس الشعبي الوطني أو مجلس الأمة بأغلبية أعضائهما، دون المساس بجميع المتابعات الأخرى الواردة في القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_107> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_107_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_107_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_107_19961128_OpEnact_826d96814f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 107" ;
    dzdoc:position 104 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_107_condition_0_5bb515dc> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_nation .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_11" ;
    dzdoc:fullText "تستمد الدولة مشروعيتها وسبب وجودها من إرادة الشعب. شعارها : ” بالشعب وللشعب “. وهي في خدمته وحده."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_11> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_11_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_11_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_11_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_11_19961128_OpEnact_5f6375fdaa> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 11" ;
    dzdoc:position 10 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_121> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_121" ;
    dzdoc:fullText "لا يقبل اقتراح أي قانون، مضمونه أو نتيجته تخفيض الموارد العمومية، أو زيادة النفقات العمومية، إلا إذا كان مرفوقا بتدابير تستهدف الزيادة في إيرادات الدولة، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي على الأقل المبالغ المقترح إنفاقها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_121> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_121_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_121_19961128_OpEnact_ccef435f2f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "121" ;
    dzdoc:position 118 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_121_condition_0_2893db1a> .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_125> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_125" ;
    dzdoc:fullText "يمارس رئيس الجمهورية السلطة التنظيمية في المسائل غير المخصصة للقانون . يندرج تطبيق القوانين في المجال التنظيمي الذي يعود ل رئيس الحكومة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_125> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_125_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_125_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_125_19961128_OpEnact_b41dfd6e25> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_125_obligation_0_6e354ce9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 125" ;
    dzdoc:position 122 ;
    dzdoc:usesTerm dzterm:head_of_government,
        dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_139> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_139" ;
    dzdoc:fullText "تحمي السلطة القضائية المجتمع والحريات، وتضمن للجميع ولكل واحد المحافظة على حقوقهم الأساسية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_139> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_139_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_139_19961128_OpEnact_6f16e533ee> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_139_obligation_0_c8564567> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 139" ;
    dzdoc:position 136 ;
    dzdoc:usesTerm dzterm:judicial_authority .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_145> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_145" ;
    dzdoc:fullText "على كل أجهزة الدولة المختصة أن تقوم، في كل وقت وفي كل مكان، وفي جميع الظروف، بتنفيذ أحكام القضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_145> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_145_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_145_19961128_OpEnact_8c20a65e3a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_145_obligation_0_603cf404> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 145" ;
    dzdoc:position 142 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_146> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_146" ;
    dzdoc:fullText "يختص القضاء بإصدار الأحكام. ويمكن أن يعينهم في ذلك مساعدون شعبيون حسب الشروط التي يحددها القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_146> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_146_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_146_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_146_19961128_OpEnact_5e71a4239f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 146" ;
    dzdoc:position 143 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_146_condition_0_732c65d3> .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_155> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_155" ;
    dzdoc:fullText "يقرر المجلس الأعلى للقضاء ، طبقا للشروط التي يحددها القانون ، تعيين القضاة، ونقلهم، وسير سلمهم الوظيفي. ويسهر على احترام أحكام القانون الأساسي للقضاء، وعلى رقابة انضباط القضاة تحت رئاسة الرئيس الأول للمحكمة العليا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_155> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_155_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_155_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_155_19961128_OpEnact_f70c2e17a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 155" ;
    dzdoc:position 151 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_155_condition_0_86d14ec6> ;
    dzdoc:usesTerm dzterm:supreme_council_judiciary .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_168> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_168" ;
    dzdoc:fullText "إذا ارتأى المجلس الدستوري عدم دستورية معاهدة أو اتفاق، أو اتفاقية ، فلا يتم التصديق عليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_168> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_168_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_168_19961128_OpEnact_c1e320c0f0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_168_obligation_0_a7e41b08> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 168" ;
    dzdoc:position 164 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_168_condition_0_d1ff0c88> .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_182> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الرابع_التعديل_الدستوري> ;
    dzdoc:eId "art_182" ;
    dzdoc:fullText "يصدر رئيس الجمهورية نص التعديل الدستوري الذي أقره الشعب ، و ينفذ كقانون أساسي للجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_182> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_182_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_182_19961128_OpEnact_ec0a7a3974> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_182_obligation_0_7748720b>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_182_obligation_1_ba9aadbc> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "182" ;
    dzdoc:position 177 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_20" ;
    dzdoc:fullText "لا يتم نزع الملكية إلا في إطار القانون . ويترتب عليه تعويض قبلي عادل، ومنصف ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_20_right_0_d79b6e70> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_20> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_20_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_20_19961128_OpEnact_6a476d33be> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 20" ;
    dzdoc:position 19 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_20_condition_0_40ffbb0b> .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "تنتظم الطاقة الدفاعية للأمة، ودعمها، وتطويرها، حول الجيش الوطني الشعبي . تتمثل المهمة الدائمة للجيش الوطني الشعبي في المحافظة على الاستقلال الوطني، والدفاع عن السيادة الوطنية. كما يضطلع بالدفاع عن وحدة البلاد، وسلامتها الترابية، وحماية مجالها البري والجوي، ومختلف مناطق أملاكها البحرية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_25> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_25_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_25_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_25_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_25_19961128_OpEnact_31361eb606> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 25" ;
    dzdoc:position 24 ;
    dzdoc:usesTerm dzterm:anp .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_27" ;
    dzdoc:fullText "الجزائر متضامنة مع جميع الشعوب التي تكافح من أجل التحرر السياسي والاقتصادي ، و الحق في تقرير المصير ، وضد كل تمييز عنصري."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_27_right_0_804d9170> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_27_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_27_19961128_OpEnact_f7602bb4ab> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_27_obligation_0_409116c0> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 27" ;
    dzdoc:position 26 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "تضمن الدولة عدم انتهاك حرمة الإنسان . ويحظر أي عنف بدني أو معنوي أو أي مساس بالكرامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_34_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_34_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_34_19961128_OpEnact_58e1360500> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_34_obligation_0_6ae6c4df> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 34" ;
    dzdoc:position 33 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_65> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_65" ;
    dzdoc:fullText "يجازي القانون الآباء على القيام بـ واجب تربية أبنائهم ورعايتهم ، كما يجازي الأبناء على القيام بـ واجب الإحسان إلى آبائهم ومساعدتهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_65> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_65_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_65_19961128_OpEnact_1bb467ab75> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_65_obligation_0_bede1239>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_65_obligation_1_6092d0d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 65" ;
    dzdoc:position 63 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_71> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_71" ;
    dzdoc:fullText "ينتخب رئيس الجمهورية ، عن طريق الاقتراع العام المباشر والسري. يتم الفوز في الانتخاب بالحصول على الأغلبية المطلقة من أصوات الناخبين المعبر عنها. ويحدد القانون الكيفيات الأخرى للانتخابات الرئاسية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_71> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_71_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_71_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_71_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_71_19961128_OpEnact_a9b1fd3eec> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 71" ;
    dzdoc:position 69 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_82> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_82" ;
    dzdoc:fullText "إذا لم تحصل من جديد موافقة المجلس الشعبي الوطني ينحل وجوبا. تستمر الحكومة القائمة في تسيير الشؤون العادية إلى غاية انتخاب المجلس الشعبي الوطني وذلك في أجل أقصاه ثلاثة (3) أشهر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_82> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_82_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_82_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_82_19961128_OpEnact_4a38e1312b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "82" ;
    dzdoc:position 80 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_82_condition_0_f8dffce7> .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "يمكن رئيس الحكومة أن يقدم استقالة حكومته ل رئيس الجمهورية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_86_permission_0_53d1a888> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_86_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_86_19961128_OpEnact_397985782e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "86" ;
    dzdoc:position 84 ;
    dzdoc:usesTerm dzterm:head_of_government,
        dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_94> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_94" ;
    dzdoc:fullText "يقرر رئيس الجمهورية التعبئة العامة في مجلس الوزراء بعد الاستماع إلى المجلس الأعلى للأمن واستشارة رئيس المجلس الشعبي الوطني ورئيس مجلس الأمة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_94> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_94_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_94_19961128_OpEnact_f414eac80d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 94" ;
    dzdoc:position 92 ;
    dzdoc:usesTerm dzterm:general_mobilization .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_99> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_99" ;
    dzdoc:fullText "يراقب البرلمان عمل الحكومة وفقا لـ الشروط المحددة في المواد 80 و 84 و 133 و 134 من الدستور . يمارس المجلس الشعبي الوطني الرقابة المنصوص عليها في المواد من 135 إلى 137 من الدستور."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_99> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_99_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_99_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_99_19961128_OpEnact_b43d282289> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 99" ;
    dzdoc:position 96 ;
    dzdoc:referencesExternal <https://legal.dz/resource/constitution/1996-11-28/1996#art_99_extref_127e31a4>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_99_extref_3a58b083>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_99_extref_57d590b6>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_99_extref_c9ad5cbf>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_99_extref_e277f49c> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_99_condition_0_5651787e> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:government,
        dzterm:parliament .

dzterm:council_nation a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "مجلس الأمة"@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثاني_الشعب> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "الشعب حر في اختيار ممثليه. لا حدود لتمثيل الشعب ، إلا ما نص عليه الدستور وقانون الانتخابات"@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_10_right_0_37f1fcac> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_10_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_10_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_10_19961128_OpEnact_173e16cc80> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "10" ;
    dzdoc:position 9 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_10_condition_0_282cb94d> ;
    dzdoc:usesTerm dzterm:الدستور,
        dzterm:الشعب .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_101> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_101" ;
    dzdoc:fullText "ينتخب أعضاء المجلس الشعبي الوطني عن طريق الاقتراع العام المباشر والسري. ينتخب ثلثا (2/3) أعضاء مجلس الأمة عن طريق الاقتراع غير المباشر والسري من بين ومن طرف أعضاء المجالس الشعبية البلدية والمجلس الشعبي الولائي. ويعين رئيس الجمهورية الثلث الآخر من أعضاء مجلس الأمة من بين الشخصيات والكفاءات الوطنية في المجالات العلمية والثقافية والمهنية والاقتصادية والاجتماعية. عدد أعضاء مجلس الأمة يساوي، على الأكثر، نصف عدد أعضاء المجلس الشعبي الوطني . يحدد القانون كيفيات تطبيق الفقرة الثانية السابقة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_101> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_101_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_101_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_101_para_2>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_101_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_101_19961128_OpEnact_824afc86d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 101" ;
    dzdoc:position 98 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_nation,
        dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_114" ;
    dzdoc:fullText "ينتخب رئيس المجلس الشعبي الوطني للفترة التشريعية . ينتخب رئيس مجلس الأمة بعد كل تجديد جزئي لتشكيلة المجلس ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_114> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_114_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_114_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_114_19961128_OpEnact_aaa1e89ca7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_114_obligation_0_48560312>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_114_obligation_1_7fe04366> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 114" ;
    dzdoc:position 111 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "تمارس سيادة الدولة على مجالها البري، ومجالها الجوي، وعلى مياهها. كما تمارس الدولة حقها السيد الذي يقره القانون الدولي على كل منطقة من مختلف مناطق المجال البحري التي ترجع إليها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_12_right_0_dd5059e9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_12_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_12_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_12_19961128_OpEnact_5c414a96fb> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 12" ;
    dzdoc:position 11 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_131> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_131" ;
    dzdoc:fullText "يصادق رئيس الجمهورية على اتفاقيات الهدنة، ومعاهدات السلم والتحالف والاتحاد، والمعاهدات المتعلقة بحدود الدولة، والمعاهدات المتعلقة بقانون الأشخاص، والمعاهدات التي تترتب عليها نفقات غير واردة في ميزانية الدولة ، بعد أن توافق عليها كل غرفة من البرلمان صراحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_131> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_131_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_131_19961128_OpEnact_b5fd4152c3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_131_obligation_0_7cd46af7> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 131" ;
    dzdoc:position 128 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_131_condition_0_353c43e0> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:definesTerm dzterm:municipality,
        dzterm:territorial_collectivities ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "الجماعات الإقليمية للدولة هي البلدية والولاية . البلدية هي الجماعة القاعدية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_15> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1996-11-28/1996#art_15_defocc_424c539940f0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_15_defocc_7506255ae13f> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_15_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_15_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_15_19961128_OpEnact_eeaab0866f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 15" ;
    dzdoc:position 14 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_151> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_151" ;
    dzdoc:fullText "الحق في الدفاع معترف به . الحق في الدفاع مضمون في القضايا الجزائية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_151_right_0_1fb9a7f8>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_151_right_1_8ef87a6f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_151> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_151_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_151_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_151_19961128_OpEnact_40bad04255> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 151" ;
    dzdoc:position 147 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:definesTerm dzterm:public_property ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_17" ;
    dzdoc:fullText "الملكية العامة هي ملك المجموعة الوطنية . وتشمل باطن الأرض، والمناجم، والمقالع، والموارد الطبيعية للطاقة، والثروات المعدنية الطبيعية والحية، في مختلف مناطق الأملاك الوطنية البحرية، والمياه، والغابات. كما تشمل النقل بالسكك الحديدية، والنقل البحري والجوي، والبريد والمواصلات السلكية واللاسلكية، وأملاكا أخرى محددة في القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_17> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1996-11-28/1996#art_17_defocc_e9ff41056991> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_17_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_17_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_17_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_17_19961128_OpEnact_145ff6b28d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 17" ;
    dzdoc:position 16 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "الأملاك الوطنية يحددها القانون. وتتكون من الأملاك العمومية والخاصة التي تملكها كل من الدولة ، والولاية، والبلدية. يتم تسيير الأملاك الوطنية طبقا للقانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_18_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_18_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_18_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_18_19961128_OpEnact_d63944f7f1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_18_obligation_0_a70ce4cd> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 18" ;
    dzdoc:position 17 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_26> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_26" ;
    dzdoc:fullText "تمتنع الجزائر عن اللجوء إلى الحرب من أجل المساس بالسيادة المشروعة للشعوب الأخرى وحريتها . وتبذل جهدها لتسوية الخلافات الدولية بالوسائل السلمية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_26> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_26_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_26_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_26_19961128_OpEnact_a0dd4ce9d2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_26_obligation_0_ed4a40d0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_26_obligation_1_f5fb3326> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 26" ;
    dzdoc:position 25 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "تعمل الجزائر من أجل دعم التعاون الدولي، وتنمية العلاقات الودية بين الدول، على أساس المساواة، والمصلحة المتبادلة، وعدم التدخل في الشؤون الداخلية . و تتبنى مبادئ ميثاق الأمم المتحدة وأهدافه"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_28_19961128_OpEnact_1c9f0912fc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_28_obligation_0_56734ac1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_28_obligation_1_59d1eace> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 28" ;
    dzdoc:position 27 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_29" ;
    dzdoc:fullText "كل المواطنين سواسية أمام القانون . ولا يمكن أن يتذرع بأي تمييز يعود سببه إلى المولد، أو العرق، أو الجنس، أو الرأي، أو أي شرط أو ظرف آخر، شخصي أو اجتماعي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_29_permission_0_46111fec> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_29_right_0_9952cfc0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_29_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_29_19961128_OpEnact_08430c7c0f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 29" ;
    dzdoc:position 28 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "يحق لكل مواطن يتمتع بحقوقه المدنية والسياسية، أن يختار بحرية موطن إقامته، وأن يتنقل عبر التراب الوطني . حق الدخول إلى التراب الوطني والخروج منه مضمون له ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_44_right_0_d2b672d1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_44_right_1_d6a64e0b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_44_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_44_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_44_19961128_OpEnact_9ead43104b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 44" ;
    dzdoc:position 42 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_54> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_54" ;
    dzdoc:fullText "الرعاية الصحية حق للمواطنين . تتكفل الدولة بالوقاية من الأمراض الوبائية والمعدية وبمكافحتها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_54_right_0_c6d02896> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_54> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_54_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_54_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_54_19961128_OpEnact_43161ed2ab> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_54_obligation_0_ed46cf4d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 54" ;
    dzdoc:position 52 ;
    dzdoc:usesTerm dzterm:healthcare,
        dzterm:state .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_63> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_63" ;
    dzdoc:fullText "يمارس كل واحد جميع حرياته ، في إطار احترام الحقوق المعترف بها للغير في الدستور ، لا سيما احترام الحق في الشرف، وستر الحياة الخاصة، وحماية الأسرة والشبيبة والطفولة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_63_right_0_b6436772> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_63> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_63_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_63_19961128_OpEnact_8737f0f896> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_63_obligation_0_7f772293>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_63_obligation_1_ff3e9daf> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 63" ;
    dzdoc:position 61 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_66> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_66" ;
    dzdoc:fullText "يجب على كل مواطن أن يحمي الملكية العامة، ومصالح المجموعة الوطنية، ويحترم ملكية الغير ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_66> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_66_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_66_19961128_OpEnact_0736bc137c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_66_obligation_0_382414ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 66" ;
    dzdoc:position 64 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "لا يمكن بأي حال من الأحوال أن يسلم أو يطرد لاجئ سياسي يتمتع قانونا بحق اللجوء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_69_permission_0_64b66745> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_69_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_69_19961128_OpEnact_d0d2ce4af0> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 69" ;
    dzdoc:position 67 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_69_condition_0_d333510c> ;
    dzdoc:usesTerm dzterm:refugee .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثاني_الشعب> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "السلطة التأسيسية ملك للشعب . يمارس الشعب سيادته بواسطة المؤسسات الدستورية التي يختارها. يمارس الشعب هذه السيادة عن طريق الاستفتاء وبواسطة ممثليه المنتخبين. لـ رئيس الجمهورية أن يلتجئ إلي إرادة الشعب مباشرة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_7_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_7_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_7_para_2>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_7_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_7_19961128_OpEnact_176f6c43e0> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "7" ;
    dzdoc:position 6 ;
    dzdoc:usesTerm dzterm:السلطة_التأسيسية,
        dzterm:الشعب,
        dzterm:رئيس_الجمهورية .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_70" ;
    dzdoc:fullText "يجسد رئيس الجمهورية ، رئيس الدولة، وحدة الأمة. وهو حامي الدستور . ويجسد الدولة داخل البلاد وخارجها. له أن يخاطب الأمة مباشرة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_70_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_70_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_70_para_2>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_70_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_70_19961128_OpEnact_f71fdba96f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 70" ;
    dzdoc:position 68 ;
    dzdoc:references <https://legal.dz/resource/constitution/1996-11-28/1996#constitution> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/1996-11-28/1996#constitution> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_74> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_74" ;
    dzdoc:fullText "مدة المهمة الرئاسية خمس (5) سنوات. يمكن تجديد انتخاب رئيس الجمهورية مرة واحدة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_74_permission_0_476d8ddc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_74> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_74_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_74_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_74_19961128_OpEnact_42262e3418> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 74" ;
    dzdoc:position 72 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_75> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_75" ;
    dzdoc:fullText "يؤدي رئيس الجمهورية اليمين أمام الشعب بحضور جميع الهيئات العليا في الأمة، خلال الأسبوع الموالي لانتخابه . ويباشر مهمته فور أدائه اليمين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_75> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_75_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_75_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_75_19961128_OpEnact_6563848a5e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_75_obligation_0_8c54f6d2> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 75" ;
    dzdoc:position 73 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "يقدم رئيس الحكومة أعضاء حكومته الذين اختارهم ل رئيس الجمهورية الذي يعينهم. يضبط رئيس الحكومة برنامج حكومته ويعرضه في مجلس الوزراء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_79_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_79_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_79_19961128_OpEnact_2e6b05b021> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "79" ;
    dzdoc:position 77 ;
    dzdoc:usesTerm dzterm:head_of_government,
        dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_81> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_81" ;
    dzdoc:fullText "يقدم رئيس الحكومة استقالة حكومته ل رئيس الجمهورية في حالة عدم موافقة المجلس الشعبي الوطني على البرنامج المعروض عليه. يعين رئيس الجمهورية من جديد رئيس حكومة حسب الكيفيات نفسها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_81> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_81_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_81_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_81_19961128_OpEnact_96bdd4e091> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_81_obligation_0_6815b228> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "81" ;
    dzdoc:position 79 ;
    dzdoc:usesTerm dzterm:head_of_government,
        dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_105> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_105" ;
    dzdoc:fullText "مهمة النائب وعضو مجلس الأمة وطنية، قابلة للتجديد، و لا يمكن الجمع بينهما وبين مهام أو وظائف أخرى ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_105_permission_0_961e2bca> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_105> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_105_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_105_19961128_OpEnact_2916849082> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_105_obligation_0_6602c416> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 105" ;
    dzdoc:position 102 ;
    dzdoc:usesTerm dzterm:council_nation .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_113> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_113" ;
    dzdoc:fullText "تبتدئ الفترة التشريعية، وجوبا، في اليوم العاشر الموالي لتاريخ انتخاب المجلس الشعبي الوطني ، تحت رئاسة أكبر النواب سنا، وبمساعدة أصغر نائبين منهم . ينتخب المجلس الشعبي الوطني مكتبه ويشكل لجانه . تطبق الأحكام السابقة الذكر على مجلس الأمة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_113> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_113_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_113_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_113_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_113_19961128_OpEnact_64a5555d84> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_113_obligation_0_07fa3c35>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_113_obligation_1_e8b1cb7c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 113" ;
    dzdoc:position 110 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_160> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_160" ;
    dzdoc:fullText "تقدم الحكومة لكل غرفة من البرلمان عرضا عن استعمال الاعتمادات المالية التي أقرتها لكل سنة مالية . تختتم السنة المالية فيما يخص البرلمان ، بالتصويت على قانون يتضمن تسوية ميزانية السنة المالية المعنية من قبل كل غرفة من البرلمان ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_160> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_160_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_160_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_160_19961128_OpEnact_9b3d69a073> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_160_obligation_0_a8e0b597>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_160_obligation_1_b3b034d6> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 160" ;
    dzdoc:position 156 ;
    dzdoc:usesTerm dzterm:government,
        dzterm:parliament .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_161> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_161" ;
    dzdoc:fullText "يمكن كل غرفة من البرلمان ، في إطار اختصاصاتها، أن تنشئ في أي وقت لجان تحقيق في قضايا ذات مصلحة عامة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_161_permission_0_140ddfcc> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_161_right_0_6e78ff99> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_161> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_161_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_161_19961128_OpEnact_c3b5099516> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 161" ;
    dzdoc:position 157 ;
    dzdoc:usesTerm dzterm:parliament .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_176> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الرابع_التعديل_الدستوري> ;
    dzdoc:eId "art_176" ;
    dzdoc:fullText "إذا ارتأى المجلس الدستوري أن مشروع أي تعديل دستوري لا يمس البتة المبادئ العامة التي تحكم المجتمع الجزائري، وحقوق الإنسان والمواطن وحرياتهما، ولا يمس بأي كيفية التوازنات الأساسية للسلطات والمؤسسات الدستورية، وعلل رأيه ، أمكن رئيس الجمهورية أن يصدر القانون الذي يتضمن التعديل الدستوري مباشرة دون أن يعرضه على الاستفتاء الشعبي، متى أحرز ثلاثة أرباع (3/4) أصوات أعضاء غرفتي البرلمان ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_176> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_176_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_176_19961128_OpEnact_59d2b92432> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 176" ;
    dzdoc:position 171 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_176_condition_0_aacf4f4f>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_176_condition_1_76eca6c2> ;
    dzdoc:usesTerm dzterm:constitutional_council,
        dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "لا يمكن أن تكون الوظائف في مؤسسات الدولة مصدرا للثراء، ولا وسيلة لخدمة المصالح الخاصة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_21_permission_0_c0df376a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_21_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_21_19961128_OpEnact_9613592828> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_21_obligation_0_a8a21ac1> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 21" ;
    dzdoc:position 20 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_32> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_32" ;
    dzdoc:fullText "الحريات الأساسية وحقوق الإنسان والمواطن مضمونة . وتكون تراثا مشتركا بين جميع الجزائريين والجزائريات، واجبهم أن ينقلوه من جيل إلى جيل كي يحافظوا على سلامته، وعدم انتهاك حرمته ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_32_right_0_d0e243e4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_32> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_32_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_32_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_32_19961128_OpEnact_fd5ea7574a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_32_obligation_0_55609b7d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 32" ;
    dzdoc:position 31 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_43> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_43" ;
    dzdoc:fullText "حق إنشاء الجمعيات مضمون . تشجع الدولة ازدهار الحركة الجمعوية . يحدد القانون شروط وكيفيات إنشاء الجمعيات."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_43_right_0_e925bf61> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_43> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_43_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_43_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_43_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_43_19961128_OpEnact_83d927790f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_43_obligation_0_94cd5930> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 43" ;
    dzdoc:position 41 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_52" ;
    dzdoc:fullText "الملكية الخاصة مضمونة . حق الإرث مضمون . الأملاك الوقفية وأملاك الجمعيات الخيرية معترف بها، ويحمي القانون تخصيصها."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_52_right_0_6421b836>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_52_right_1_51711fef> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_52_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_52_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_52_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_52_19961128_OpEnact_d082c6db2f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 52" ;
    dzdoc:position 50 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_61> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_61" ;
    dzdoc:fullText "يجب على كل مواطن أن يحمي ويصون استقلال البلاد وسيادتها وسلامة ترابها الوطني وجميع رموز الدولة . يعاقب القانون بكل صرامة على الخيانة والتجسس والولاء للعدو، وعلى جميع الجرائم المرتكبة ضد أمن الدولة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_61> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_61_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_61_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_61_19961128_OpEnact_97484fd994> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_61_obligation_0_7e272b0c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 61" ;
    dzdoc:position 59 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art__181> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الرابع_التعديل_الدستوري> ;
    dzdoc:eId "art__181" ;
    dzdoc:fullText "يجدد نصف (1/2) عدد أعضاء مجلس الأمة أثناء مدة العضوية الأولى عقب السنة الثالثة عن طريق القرعة . و يستخلف أعضاء مجلس الأمة الذين وقعت عليهم القرعة وفق الشروط نفسها وحسب الإجراء نفسه المعمول به في انتخابهم أو تعيينهم . لا تشمل القرعة رئيس مجلس الأمة الذي يمارس العهدة الأولى مدة ست (6) سنوات"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art__181> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art__181_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art__181_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art__181_19961128_OpEnact_1af44c5c95> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art__181_obligation_0_d0103991>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art__181_obligation_1_ae254cf4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number ": 181" ;
    dzdoc:position 176 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art__181_condition_0_5241c415> ;
    dzdoc:usesTerm dzterm:council_of_nation .

