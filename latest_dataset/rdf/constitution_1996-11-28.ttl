<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_133> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أعضاء البرلمان استجواب الحكومة في إحدى قضايا الساعة . يمكن لجان البرلمان أن تستمع إلى أعضاء الحكومة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
