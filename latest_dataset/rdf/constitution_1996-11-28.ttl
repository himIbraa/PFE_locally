<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_176> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا ارتأى المجلس الدستوري أن مشروع أي تعديل دستوري لا يمس البتة المبادئ العامة التي تحكم المجتمع الجزائري، وحقوق الإنسان والمواطن وحرياتهما، ولا يمس بأي كيفية التوازنات الأساسية للسلطات والمؤسسات الدستورية، وعلل رأيه ، أمكن رئيس الجمهورية أن يصدر القانون الذي يتضمن التعديل الدستوري مباشرة دون أن يعرضه على الاستفتاء الشعبي، متى أحرز ثلاثة أرباع (3/4) أصوات أعضاء غرفتي البرلمان ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_176_19961128_OpEnact_59d2b92432> ;
    dzdoc:replacementText "إذا ارتأى المجلس الدستوري أن مشروع أي تعديل دستوري لا يمس البتة المبادئ العامة التي تحكم المجتمع الجزائري، وحقوق الإنسان والمواطن وحرياتهما، ولا يمس بأي كيفية التوازنات الأساسية للسلطات والمؤسسات الدستورية، وعلل رأيه ، أمكن رئيس الجمهورية أن يصدر القانون الذي يتضمن التعديل الدستوري مباشرة دون أن يعرضه على الاستفتاء الشعبي، متى أحرز ثلاثة أرباع (3/4) أصوات أعضاء غرفتي البرلمان ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_176> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_176> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_177> a dzdoc:AmendmentEvent,
