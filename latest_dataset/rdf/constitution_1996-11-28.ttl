<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_71> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينتخب رئيس الجمهورية ، عن طريق الاقتراع العام المباشر والسري. يتم الفوز في الانتخاب بالحصول على الأغلبية المطلقة من أصوات الناخبين المعبر عنها. ويحدد القانون الكيفيات الأخرى للانتخابات الرئاسية."@ar ;
