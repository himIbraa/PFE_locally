<https://legal.dz/resource/constitution/1996-11-28/1996#art_152_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_152> ;
    dzdoc:position 0 ;
    dzdoc:text "تمثل المحكمة العليا الهيئة المقومة لأعمال المجالس القضائية والمحاكم."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_152_para_1> a dzdoc:Paragraph ;
