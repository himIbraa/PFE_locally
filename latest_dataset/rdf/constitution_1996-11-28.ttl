<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_171> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤسس لدى رئيس الجمهورية مجلس إسلامي أعلى ، يتولى على الخصوص ما يأتي : الحث على الاجتهاد وترقيته، إبداء الحكم الشرعي فيما يعرض عليه، رفع تقرير دوري عن نشاطه إلى رئيس الجمهورية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_171_19961128_OpEnact_6439edf6b5> ;
    dzdoc:replacementText "يؤسس لدى رئيس الجمهورية مجلس إسلامي أعلى ، يتولى على الخصوص ما يأتي : الحث على الاجتهاد وترقيته، إبداء الحكم الشرعي فيما يعرض عليه، رفع تقرير دوري عن نشاطه إلى رئيس الجمهورية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_171> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
