<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_110> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز الشروع في متابعة أي نائب أو عضو مجلس الأمة بسبب جناية أو جنحة إلا بتنازل صريح منه، أو بإذن، حسب الحالة، من المجلس الشعبي الوطني أو مجلس الأمة الذي يقرر رفع الحصانة عنه بأغلبية أعضائه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_110_19961128_OpEnact_1a4e719de6> ;
