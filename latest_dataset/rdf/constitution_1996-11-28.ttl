    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_133_19961128_OpEnact_aa73794e2d> ;
    dzdoc:replacementText "يمكن أعضاء البرلمان استجواب الحكومة في إحدى قضايا الساعة . يمكن لجان البرلمان أن تستمع إلى أعضاء الحكومة ."@ar ;
