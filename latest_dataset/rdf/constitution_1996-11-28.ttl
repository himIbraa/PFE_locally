<https://legal.dz/resource/constitution/1996-11-28/1996#art_70_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_70> ;
    dzdoc:position 0 ;
    dzdoc:text "يجسد رئيس الجمهورية، رئيس الدولة، وحدة الأمة."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_70_para_1> a dzdoc:Paragraph ;
