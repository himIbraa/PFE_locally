<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_116> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "جلسات البرلمان علانية. وتدون مداولاته في محاضر تنشر طبقا للشروط التي يحددها القانون العضوي . يجوز للمجلس الشعبي الوطني و مجلس الأمة أن يعقدا جلسات مغلقة بطلب من رئيسيهما، أو من أغلبية أعضائهما الحاضرين، أو بطلب من رئيس الحكومة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_116_19961128_OpEnact_4cfb7981a9> ;
