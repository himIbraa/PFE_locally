<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_18> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الأملاك الوطنية يحددها القانون. وتتكون من الأملاك العمومية والخاصة التي تملكها كل من الدولة ، والولاية، والبلدية. يتم تسيير الأملاك الوطنية طبقا للقانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
