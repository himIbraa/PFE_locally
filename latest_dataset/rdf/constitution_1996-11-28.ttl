<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_97> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوقع رئيس الجمهورية اتفاقيات الهدنة ومعاهدات السلم . ويتلقى رأي المجلس الدستوري في الاتفاقيات المتعلقة بهما . ويعرضها فورا على كل غرفة من البرلمان لتوافق عليها صراحة ."@ar ;
