<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_78> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعين رئيس الجمهورية في الوظائف والمهام الآتية : 1 – الوظائف والمهام المنصوص عليها في الدستور، 2 – الوظائف المدنية والعسكرية في الدولة، 3 – التعيينات التي تتم في مجلس الوزراء، 4 – رئيس مجلس الدولة، 5 – الأمين العام للحكومة، 6 – محافظ بنك الجزائر، 7 – القضاة، 8 – مسؤولو أجهزة الأمن، 9 – الولاة. ويعين رئيس الجمهورية سفراء الجمهورية والمبعوثين فوق العادة إلى الخارج، وينهي مهامهم، ويتسلم أوراق اعتماد الممثلين الدبلوماسيين الأجانب وأوراق إنهاء مهامهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_78_19961128_OpEnact_edb929ab33> ;
    dzdoc:replacementText "يعين رئيس الجمهورية في الوظائف والمهام الآتية : 1 – الوظائف والمهام المنصوص عليها في الدستور، 2 – الوظائف المدنية والعسكرية في الدولة، 3 – التعيينات التي تتم في مجلس الوزراء، 4 – رئيس مجلس الدولة، 5 – الأمين العام للحكومة، 6 – محافظ بنك الجزائر، 7 – القضاة، 8 – مسؤولو أجهزة الأمن، 9 – الولاة. ويعين رئيس الجمهورية سفراء الجمهورية والمبعوثين فوق العادة إلى الخارج، وينهي مهامهم، ويتسلم أوراق اعتماد الممثلين الدبلوماسيين الأجانب وأوراق إنهاء مهامهم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_78> ;
