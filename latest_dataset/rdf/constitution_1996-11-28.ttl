    dznorm:position 0 ;
    dznorm:provisionText "يشرع البرلمان في الميادين التي يخصصها له الدستور، وكذلك في المجالات الآتية :"@ar ;
    dznorm:sourceArticle "art_122" .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_122_obligation_1_fbf037f4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_122> ;
