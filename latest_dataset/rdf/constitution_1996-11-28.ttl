    dzdoc:position 2 ;
    dzdoc:text "ويحدد القانون الكيفيات الأخرى للانتخابات الرئاسية."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_72_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_72> ;
    dzdoc:position 0 ;
    dzdoc:text "يمارس رئيس الجمهورية، السلطة السامية في الحدود المثبتة في الدستور."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_73_condition_0_046120d3> a dznorm:Condition ;
    dznorm:conditionText "يتمتع، فقط، بالجنسية الجزائرية الأصلية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_73> ;
