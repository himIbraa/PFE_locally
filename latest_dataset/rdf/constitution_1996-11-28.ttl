<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_101> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينتخب أعضاء المجلس الشعبي الوطني عن طريق الاقتراع العام المباشر والسري. ينتخب ثلثا (2/3) أعضاء مجلس الأمة عن طريق الاقتراع غير المباشر والسري من بين ومن طرف أعضاء المجالس الشعبية البلدية والمجلس الشعبي الولائي. ويعين رئيس الجمهورية الثلث الآخر من أعضاء مجلس الأمة من بين الشخصيات والكفاءات الوطنية في المجالات العلمية والثقافية والمهنية والاقتصادية والاجتماعية. عدد أعضاء مجلس الأمة يساوي، على الأكثر، نصف عدد أعضاء المجلس الشعبي الوطني . يحدد القانون كيفيات تطبيق الفقرة الثانية السابقة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_101_19961128_OpEnact_824afc86d7> ;
    dzdoc:replacementText "ينتخب أعضاء المجلس الشعبي الوطني عن طريق الاقتراع العام المباشر والسري. ينتخب ثلثا (2/3) أعضاء مجلس الأمة عن طريق الاقتراع غير المباشر والسري من بين ومن طرف أعضاء المجالس الشعبية البلدية والمجلس الشعبي الولائي. ويعين رئيس الجمهورية الثلث الآخر من أعضاء مجلس الأمة من بين الشخصيات والكفاءات الوطنية في المجالات العلمية والثقافية والمهنية والاقتصادية والاجتماعية. عدد أعضاء مجلس الأمة يساوي، على الأكثر، نصف عدد أعضاء المجلس الشعبي الوطني . يحدد القانون كيفيات تطبيق الفقرة الثانية السابقة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_101> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_101> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_102> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينتخب المجلس الشعبي الوطني لمدة خمس (05) سنوات. تحدد مهمة مجلس الأمة بمدة ست (06) سنوات. تجدد تشكيلة مجلس الأمة بالنصف كل ثلاث (03) سنوات. لا يمكن تمديد مهمة البرلمان إلا في ظروف خطيرة جدا لا تسمح بإجراء انتخابات عادية . ويثبت البرلمان المنعقد بغرفتيه المجتمعتين معا هذه الحالة بقرار، بناء على اقتراح رئيس الجمهورية واستشارة المجلس الدستوري ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_102_19961128_OpEnact_1e3a0ef1ec> ;
    dzdoc:replacementText "ينتخب المجلس الشعبي الوطني لمدة خمس (05) سنوات. تحدد مهمة مجلس الأمة بمدة ست (06) سنوات. تجدد تشكيلة مجلس الأمة بالنصف كل ثلاث (03) سنوات. لا يمكن تمديد مهمة البرلمان إلا في ظروف خطيرة جدا لا تسمح بإجراء انتخابات عادية . ويثبت البرلمان المنعقد بغرفتيه المجتمعتين معا هذه الحالة بقرار، بناء على اقتراح رئيس الجمهورية واستشارة المجلس الدستوري ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_102> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_102> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:targetScope "whole_article" ;
