<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_130> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن البرلمان أن يفتح مناقشة حول السياسة الخارجية بناء على طلب رئيس الجمهورية أو رئيس إحدى الغرفتين . يمكن أن تتوج هذه المناقشة، عند الاقتضاء، بإصدار البرلمان، المنعقد بغرفتيه المجتمعتين معا، لائحة يبلغها إلى رئيس الجمهورية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_130_19961128_OpEnact_ae9ff3511e> ;
    dzdoc:replacementText "يمكن البرلمان أن يفتح مناقشة حول السياسة الخارجية بناء على طلب رئيس الجمهورية أو رئيس إحدى الغرفتين . يمكن أن تتوج هذه المناقشة، عند الاقتضاء، بإصدار البرلمان، المنعقد بغرفتيه المجتمعتين معا، لائحة يبلغها إلى رئيس الجمهورية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_130> ;
