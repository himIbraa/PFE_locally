        dzdoc:LegalTerm ;
    skos:prefLabel "مجلس الأمة"@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_115> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_115" ;
    dzdoc:fullText "يحدد قانون عضوي تنظيم المجلس الشعبي الوطني و مجلس الأمة ، وعملهما، وكذا العلاقات الوظيفية بينهما وبين الحكومة . يحدد القانون ميزانية الغرفتين والتعويضات التي تدفع للنواب وأعضاء مجلس الأمة . يعد المجلس الشعبي الوطني و مجلس الأمة نظامهما الداخلي ويصادقان عليهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_115> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_115_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_115_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_115_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_115_19961128_OpEnact_76133bcbea> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_115_obligation_0_0788c150>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_115_obligation_1_7dd30c14>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_115_obligation_2_ef0f8bc6> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 115" ;
    dzdoc:position 112 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation,
        dzterm:organic_law .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_137> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_137" ;
    dzdoc:fullText "إذا صادق المجلس الشعبي الوطني على ملتمس الرقابة ، يقدم رئيس الحكومة استقالة حكومته إلى رئيس الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_137> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_137_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_137_19961128_OpEnact_3276b45de7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_137_obligation_0_5fae6b59> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 137" ;
    dzdoc:position 134 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_137_condition_0_3bc3553a> ;
    dzdoc:usesTerm dzterm:head_of_government,
        dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_102> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_102" ;
    dzdoc:fullText "ينتخب المجلس الشعبي الوطني لمدة خمس (05) سنوات. تحدد مهمة مجلس الأمة بمدة ست (06) سنوات. تجدد تشكيلة مجلس الأمة بالنصف كل ثلاث (03) سنوات. لا يمكن تمديد مهمة البرلمان إلا في ظروف خطيرة جدا لا تسمح بإجراء انتخابات عادية . ويثبت البرلمان المنعقد بغرفتيه المجتمعتين معا هذه الحالة بقرار، بناء على اقتراح رئيس الجمهورية واستشارة المجلس الدستوري ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_102_permission_0_a62bb0cb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_102> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_102_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_102_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_102_para_2>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_102_para_3>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_102_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_102_19961128_OpEnact_1e3a0ef1ec> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 102" ;
    dzdoc:position 99 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_102_condition_0_4923baa0> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:constitutional_council,
        dzterm:council_nation,
        dzterm:parliament,
        dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_116> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_116" ;
    dzdoc:fullText "جلسات البرلمان علانية. وتدون مداولاته في محاضر تنشر طبقا للشروط التي يحددها القانون العضوي . يجوز للمجلس الشعبي الوطني و مجلس الأمة أن يعقدا جلسات مغلقة بطلب من رئيسيهما، أو من أغلبية أعضائهما الحاضرين، أو بطلب من رئيس الحكومة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_116_permission_0_4ec1656b> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_116_right_0_2ceb7998> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_116> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_116_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_116_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_116_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_116_19961128_OpEnact_4cfb7981a9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_116_obligation_0_427685d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 116" ;
    dzdoc:position 113 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_116_condition_0_d0697dd9> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation,
        dzterm:head_of_government,
        dzterm:organic_law .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_136> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_136" ;
    dzdoc:fullText "تتم الموافقة على ملتمس الرقابة بتصويت أغلبية ثلثي (2/3) النواب . ولا يتم التصويت إلا بعد ثلاثة (03) أيام من تاريخ إيداع ملتمس الرقابة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_136> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_136_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_136_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_136_19961128_OpEnact_53ec935948> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 136" ;
    dzdoc:position 133 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_136_condition_0_5862097d>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_136_condition_1_d721b9f0> .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_167> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_167" ;
    dzdoc:fullText "يتداول المجلس الدستوري في جلسة مغلقة، ويعطي رأيه أو يصدر قراره في ظرف العشرين (20) يوما الموالية لتاريخ الإخطار . يحدد المجلس الدستوري قواعد عمله ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_167> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_167_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_167_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_167_19961128_OpEnact_8a93bbe142> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_167_obligation_0_27c7da02>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_167_obligation_1_f8c28fc3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 167" ;
    dzdoc:position 163 ;
    dzdoc:usesTerm dzterm:constitutional_council .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_39" ;
    dzdoc:fullText "لا يجوز انتهاك حرمة حياة المواطن الخاصة، وحرمة شرفه، ويحميهما القانون . سرية المراسلات والاتصالات الخاصة بكل أشكالها مضمونة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_39_permission_0_1d202042> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_39_right_0_d7d92b14>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_39_right_1_e3b0822f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_39> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_39_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_39_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_39_19961128_OpEnact_3581d8ae8d> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1996-11-28/1996#art_39_prohibition_0_1d202042> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 39" ;
    dzdoc:position 37 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "الحق في التعليم مضمون . التعليم مجاني حسب الشروط التي يحددها القانون. التعليم الأساسي إجباري . تنظم الدولة المنظومة التعليمية. تسهر الدولة على التساوي في الالتحاق بالتعليم، والتكوين المهني ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_53_right_0_777dfa7e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_53_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_53_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_53_para_2>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_53_para_3>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_53_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_53_19961128_OpEnact_ca38e93137> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_53_obligation_0_ba684010>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_53_obligation_1_dd36b1ae> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 53" ;
    dzdoc:position 51 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "يعين رئيس الجمهورية في الوظائف والمهام الآتية : 1 – الوظائف والمهام المنصوص عليها في الدستور، 2 – الوظائف المدنية والعسكرية في الدولة، 3 – التعيينات التي تتم في مجلس الوزراء، 4 – رئيس مجلس الدولة، 5 – الأمين العام للحكومة، 6 – محافظ بنك الجزائر، 7 – القضاة، 8 – مسؤولو أجهزة الأمن، 9 – الولاة. ويعين رئيس الجمهورية سفراء الجمهورية والمبعوثين فوق العادة إلى الخارج، وينهي مهامهم، ويتسلم أوراق اعتماد الممثلين الدبلوماسيين الأجانب وأوراق إنهاء مهامهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_78> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_78_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_78_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_78_19961128_OpEnact_edb929ab33> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "78" ;
    dzdoc:position 76 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "لا يجوز الشروع في متابعة أي نائب أو عضو مجلس الأمة بسبب جناية أو جنحة إلا بتنازل صريح منه، أو بإذن، حسب الحالة، من المجلس الشعبي الوطني أو مجلس الأمة الذي يقرر رفع الحصانة عنه بأغلبية أعضائه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_110_permission_0_719df5d8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_110_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_110_19961128_OpEnact_1a4e719de6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_110_obligation_0_3cf49cd6> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1996-11-28/1996#art_110_prohibition_0_719df5d8> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 110" ;
    dzdoc:position 107 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_110_condition_0_bb4b1f43> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_128> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_128" ;
    dzdoc:fullText "يمكن رئيس الجمهورية أن يوجه خطابا إلى البرلمان ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_128_permission_0_240fa2f6> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_128_right_0_e9f99f58> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_128> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_128_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_128_19961128_OpEnact_238326ffa3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 128" ;
    dzdoc:position 125 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_130> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_130" ;
    dzdoc:fullText "يمكن البرلمان أن يفتح مناقشة حول السياسة الخارجية بناء على طلب رئيس الجمهورية أو رئيس إحدى الغرفتين . يمكن أن تتوج هذه المناقشة، عند الاقتضاء، بإصدار البرلمان، المنعقد بغرفتيه المجتمعتين معا، لائحة يبلغها إلى رئيس الجمهورية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_130_permission_0_9fdb4e89>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_130_permission_1_ba849150> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_130_right_0_11bfd62a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_130> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_130_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_130_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_130_19961128_OpEnact_ae9ff3511e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 130" ;
    dzdoc:position 127 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_133> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_133" ;
    dzdoc:fullText "يمكن أعضاء البرلمان استجواب الحكومة في إحدى قضايا الساعة . يمكن لجان البرلمان أن تستمع إلى أعضاء الحكومة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_133_permission_0_af7715b5>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_133_permission_1_7e61c141> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_133_right_0_918ab644>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_133_right_1_eb45572c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_133> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_133_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_133_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_133_19961128_OpEnact_aa73794e2d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 133" ;
    dzdoc:position 130 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_164> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_164" ;
    dzdoc:fullText "يتكون المجلس الدستوري من تسعة (9) أعضاء : ثلاثة (3) أعضاء من بينهم رئيس المجلس يعينهم رئيس الجمهورية ، واثنان (2) ينتخبهما المجلس الشعبي الوطني ، واثنان (2) ينتخبهما مجلس الأمة ، وعضو واحد (1) تنتخبه المحكمة العليا ، وعضو واحد (1) ينتخبه مجلس الدولة . بمجرد انتخاب أعضاء المجلس الدستوري أو تعيينهم ، يتوقفون عن ممارسة أي عضوية أو أي وظيفة أو تكليف أو مهمة أخرى . يعين رئيس الجمهورية رئيس المجلس الدستوري لفترة واحدة مدتها ست (6) سنوات . يضطلع أعضاء المجلس الدستوري بمهامهم مرة واحدة مدتها ست (6) سنوات، ويجدد نصف عدد أعضاء المجلس الدستوري كل ثلاث (3) سنوات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_164> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_164_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_164_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_164_para_2>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_164_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_164_19961128_OpEnact_70fd0d0dc0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_164_obligation_0_6c45ffd0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_164_obligation_1_32fe51e7> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 164" ;
    dzdoc:position 160 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_164_condition_0_183707cd> ;
    dzdoc:usesTerm dzterm:constitutional_council,
        dzterm:council_of_nation,
        dzterm:national_peoples_assembly,
        dzterm:president,
        dzterm:state_council,
        dzterm:supreme_court .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "حرية الابتكار الفكري والفني والعلمي مضمونة للمواطن . حقوق المؤلف يحميها القانون . لا يجوز حجز أي مطبوع أو تسجيل أو أية وسيلة أخرى من وسائل التبليغ والإعلام إلا بمقتضى أمر قضائي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_38_permission_0_e572d87b> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_38_right_0_aa355506>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_38_right_1_b4af3016> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_38_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_38_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_38_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_38_19961128_OpEnact_ddf9ea3c70> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1996-11-28/1996#art_38_prohibition_0_e572d87b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 38" ;
    dzdoc:position 36 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_38_condition_0_9d307c43> .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_73> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_73" ;
    dzdoc:fullText "لا يحق أن ينتخب لرئاسة الجمهورية إلا المترشح الذي : يتمتع، فقط، بالجنسية الجزائرية الأصلية ، يدين بالإسلام ، يكون عمره أربعين (40) سنة كاملة يوم الانتخاب ، يتمتع بكامل حقوقه المدنية والسياسية ، يثبت الجنسية الجزائرية لزوجه ، يثبت مشاركته في ثورة أول نوفمبر 1954 إذا كان مولودا قبل يوليو 1942 ، يثبت عدم تورط أبويه في أعمال ضد ثورة أول نوفمبر 1954 إذا كان مولودا بعد يوليو 1942 ، يقدم التصريح العلني بممتلكاته العقارية والمنقولة داخل الوطن وخارجه ، تحدد شروط أخرى بموجب القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_73> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_73_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_73_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_73_19961128_OpEnact_67dbafb634> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 73" ;
    dzdoc:position 71 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_73_condition_0_046120d3>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_73_condition_1_dbe7c34f>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_73_condition_2_cb09e588>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_73_condition_3_2814a3e7>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_73_condition_4_295678df>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_73_condition_5_eb010bb2>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_73_condition_6_6f909d1e>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_73_condition_7_5a4f478a> .

