<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_163> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤسس مجلس دستوري يكلف بالسهر على احترام الدستور . كما يسهر المجلس الدستوري على صحة عمليات الاستفتاء، وانتخاب رئيس الجمهورية ، والانتخابات التشريعية، ويعلن نتائج هذه العمليات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_163_19961128_OpEnact_65697216e7> ;
    dzdoc:replacementText "يؤسس مجلس دستوري يكلف بالسهر على احترام الدستور . كما يسهر المجلس الدستوري على صحة عمليات الاستفتاء، وانتخاب رئيس الجمهورية ، والانتخابات التشريعية، ويعلن نتائج هذه العمليات ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_163> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
