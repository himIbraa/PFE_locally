<https://legal.dz/resource/constitution/1996-11-28/1996#art_109_obligation_1_7d950591> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/constitution/1996-11-28/1996#art_109_obligation_1_7d950591_action_d31a40e01d> ;
