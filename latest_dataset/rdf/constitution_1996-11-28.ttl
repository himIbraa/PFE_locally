<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_80> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقدم رئيس الحكومة برنامجه إلى المجلس الشعبي الوطني للموافقة عليه. ويجري المجلس الشعبي الوطني لهذا الغرض مناقشة عامة. ويمكن رئيس الحكومة أن يكيف برنامجه على ضوء هذه المناقشة. يقدم رئيس الحكومة عرضا حول برنامجه لمجلس الأمة. يمكن مجلس الأمة أن يصدر لائحة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_80_19961128_OpEnact_efa3d3d9f2> ;
    dzdoc:replacementText "يقدم رئيس الحكومة برنامجه إلى المجلس الشعبي الوطني للموافقة عليه. ويجري المجلس الشعبي الوطني لهذا الغرض مناقشة عامة. ويمكن رئيس الحكومة أن يكيف برنامجه على ضوء هذه المناقشة. يقدم رئيس الحكومة عرضا حول برنامجه لمجلس الأمة. يمكن مجلس الأمة أن يصدر لائحة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_80> ;
