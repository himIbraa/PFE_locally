<https://legal.dz/resource/constitution/1996-11-28/1996#art_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_109" ;
    dzdoc:fullText "الحصانة البرلمانية معترف بها للنواب ولأعضاء مجلس الأمة مدة نيابتهم ومهمتهم البرلمانية . ولا يمكن أن يتابعوا أو يوقفوا . وعلى العموم لا يمكن أن ترفع عليهم أية دعوى مدنية أو جزائية أو يسلط عليهم أي ضغط بسبب ما عبروا عنه من آراء أو ما تلفظوا به من كلام، أو بسبب تصويتهم خلال ممارسة مهامهم البرلمانية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_109_permission_0_82c49e6b> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1996-11-28/1996#art_109_right_0_4ee0ccde> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_109> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_109_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_109_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_109_19961128_OpEnact_9d338bc75a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_109_obligation_0_77a785d3>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_109_obligation_1_7d950591> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 109" ;
    dzdoc:position 106 ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:parliamentary_immunity .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "كل المواطنين متساوون في أداء الضريبة . ويجب على كل واحد أن يشارك في تمويل التكاليف العمومية، حسب قدرته الضريبية . لا يجوز أن تحدث أية ضريبة إلا بمقتضى القانون . ولا يجوز أن تحدث بأثر رجعي، أية ضريبة، أو جباية، أو رسم، أو أي حق كيفما كان نوعه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1996-11-28/1996#art_64_permission_0_25cf019f>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_64_permission_1_0c1ffb95> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1996-11-28/1996#art_64_para_0>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_64_para_1>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_64_para_2>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_64_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_64_19961128_OpEnact_566f71a3e9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1996-11-28/1996#art_64_obligation_0_d96797c5>,
        <https://legal.dz/resource/constitution/1996-11-28/1996#art_64_obligation_1_8a813084> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1996-11-28/1996#art_64_prohibition_0_25cf019f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:introducedOn "1996-11-28"^^xsd:date ;
    dzdoc:number "المادة 64" ;
    dzdoc:position 62 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1996-11-28/1996#art_64_condition_0_b6769299> .

