<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_76> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤدي رئيس الجمهورية اليمين حسب النص الآتي : ” بسم الله الرحمن الرحيم ، وفاء للتضحيات الكبرى، ولأرواح شهدائنا الأبرار، وقيم ثورة نوفمبر الخالدة، أقسم بالله العلي العظيم، أن أحترم الدين الإسلامي وأمجده، وأدافع عن الدستور ، وأسهر على استمرارية الدولة، وأعمل على توفير الشروط اللازمة للسير العادي للمؤسسات والنظام الدستوري، وأسعى من أجل تدعيم المسار الديمقراطي، وأحترم حرية اختيار الشعب، ومؤسسات الجمهورية وقوانينها، وأحافظ على سلامة التراب الوطني، ووحدة الشعب والأمة، وأحمي الحريات والحقوق الأساسية للإن"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_76_19961128_OpEnact_985cb35866> ;
    dzdoc:replacementText "يؤدي رئيس الجمهورية اليمين حسب النص الآتي : ” بسم الله الرحمن الرحيم ، وفاء للتضحيات الكبرى، ولأرواح شهدائنا الأبرار، وقيم ثورة نوفمبر الخالدة، أقسم بالله العلي العظيم، أن أحترم الدين الإسلامي وأمجده، وأدافع عن الدستور ، وأسهر على استمرارية الدولة، وأعمل على توفير الشروط اللازمة للسير العادي للمؤسسات والنظام الدستوري، وأسعى من أجل تدعيم المسار الديمقراطي، وأحترم حرية اختيار الشعب، ومؤسسات الجمهورية وقوانينها، وأحافظ على سلامة التراب الوطني، ووحدة الشعب والأمة، وأحمي الحريات والحقوق الأساسية للإنسان والمواطن، وأعمل بدون هوادة من أجل تطور الشعب وازدهاره، وأسعى بكل قواي في سبيل تحقيق المثل العليا للعدالة والحرية والسلم في العالم. والله على ما أقول شهيد “."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_76> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_76> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1996-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_77> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يضطلع رئيس الجمهورية ، بالإضافة إلى السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور ، بالسلطات والصلاحيات الآتية : 1 – هو القائد الأعلى للقوات المسلحة للجمهورية، 2 – يتولى مسؤولية الدفاع الوطني، 3 – يقرر السياسة الخارجية للأمة ويوجهها، 4 – يرأس مجلس الوزراء، 5 – يعين رئيس الحكومة وينهي مهامه، 6 – يوقع المراسيم الرئاسية، 7 – له حق إصدار العفو وحق تخفيض العقوبات أو استبدالها ، 8 – يمكنه أن يستشير الشعب في كل قضية ذات أهمية وطنية عن طريق الاستفتاء، 9 – يبرم المعاهدات الدولية ويصادق عليها، 10 –"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_77_19961128_OpEnact_281aa616d3> ;
    dzdoc:replacementText "يضطلع رئيس الجمهورية ، بالإضافة إلى السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور ، بالسلطات والصلاحيات الآتية : 1 – هو القائد الأعلى للقوات المسلحة للجمهورية، 2 – يتولى مسؤولية الدفاع الوطني، 3 – يقرر السياسة الخارجية للأمة ويوجهها، 4 – يرأس مجلس الوزراء، 5 – يعين رئيس الحكومة وينهي مهامه، 6 – يوقع المراسيم الرئاسية، 7 – له حق إصدار العفو وحق تخفيض العقوبات أو استبدالها ، 8 – يمكنه أن يستشير الشعب في كل قضية ذات أهمية وطنية عن طريق الاستفتاء، 9 – يبرم المعاهدات الدولية ويصادق عليها، 10 – يسلم أوسمة الدولة ونياشينها وشهاداتها التشريفية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1996-11-28/1996#art_77> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1996-11-28/1996> ;
