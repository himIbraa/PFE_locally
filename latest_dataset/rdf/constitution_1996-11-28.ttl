<https://legal.dz/resource/constitution/1996-11-28/1996#art_121_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_121> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يقبل اقتراح أي قانون، مضمونه أو نتيجته تخفيض الموارد العمومية، أو زيادة النفقات العمومية، إلا إذا كان مرفوقا بتدابير تستهدف الزيادة في إيرادات الدولة، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي على الأقل المبالغ المقترح إنفاقها."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_122_obligation_0_44f316d9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
