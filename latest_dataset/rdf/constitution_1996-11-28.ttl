<https://legal.dz/resource/constitution/1996-11-28/1996#version_art_131> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1996-11-28/1996> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يصادق رئيس الجمهورية على اتفاقيات الهدنة، ومعاهدات السلم والتحالف والاتحاد، والمعاهدات المتعلقة بحدود الدولة، والمعاهدات المتعلقة بقانون الأشخاص، والمعاهدات التي تترتب عليها نفقات غير واردة في ميزانية الدولة ، بعد أن توافق عليها كل غرفة من البرلمان صراحة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1996-11-28/1996#version_art_131_19961128_OpEnact_b5fd4152c3> ;
