    dznorm:position 6 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_73_condition_7_5a4f478a> a dznorm:Condition ;
    dznorm:conditionText "يقدم التصريح العلني بممتلكاته العقارية والمنقولة داخل الوطن وخارجه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_73> ;
    dznorm:position 7 .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_73_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_73> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يحق أن ينتخب لرئاسة الجمهورية إلا المترشح الذي : يتمتع، فقط، بالجنسية الجزائرية الأصلية، يدين بالإسلام، يكون عمره أربعين (40) سنة كاملة يوم الانتخاب، يتمتع بكامل حقوقه المدنية والسياسية، يثبت الجنسية الجزائرية لزوجه، يثبت مشاركته في ثورة أول نوفمبر 1954 إذا كان مولودا قبل يوليو 1942، يثبت عدم تورط أبويه في أعمال ضد ثورة أول نوفمبر 1954 إذا كان مولودا بعد يوليو 1942، يقدم التصريح العلني بممتلكاته العقارية والمنقولة داخل الوطن وخارجه،"@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_73_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_73> ;
    dzdoc:position 1 ;
    dzdoc:text "تحدد شروط أخرى بموجب القانون."@ar .

<https://legal.dz/resource/constitution/1996-11-28/1996#art_74_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1996-11-28/1996#art_74> ;
    dzdoc:position 0 ;
    dzdoc:text "مدة المهمة الرئاسية خمس (5) سنوات."@ar .

