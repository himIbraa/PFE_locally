dzterm:armed_gathering a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التجمهر المسلح"@ar,
        "ويعتبر التجمهر مسلحا إذا كان أحد الأفراد الذين يكونونه يحمل سلاحا ظاهرا أو إذا كان عدد منهم يحمل أسلحة مخبأة أو أية أشياء ظاهرة أو مخبأة استعملت واستحضرت لاستعمالها كأسلحة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_97_defocc_d6345fedf50b> .

dzterm:confiscation a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المصادرة"@ar,
        "المصادرة هي الأيلولة النهائية إلى الدولة لمال أو مجموعة أموال معينة، أو ما يعادل قيمتها عند الاقتضاء."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_15_defocc_4f049e4c5d01> .

dzterm:discrimination a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التمييز"@ar,
        "يشكل تمييزا كل تفرقة أو استثناء أو تقييد أو تفضيل يقوم على أساس الجنس أو العرق أو اللون أو النسب أو الأصل القومي أو الإثني أو الإعاقة ويستهدف أو يستتبع تعطيل أو عرقلة الاعتراف بحقوق الإنسان والحريات الأساسية أو التمتع بها أو ممارستها على قدم المساواة، في الميدان السياسي والاقتصادي والاجتماعي والثقافي أو في أي ميدان آخر من ميادين الحياة العامة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_1_defocc_bd0ec40f19e5> .

dzterm:false_keys a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "توصف بأنها مفاتيح مصطنعة"@ar,
        "مفتاحا مصطنعا"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_358_defocc_d5cc06e98ea9> .

dzterm:indecent_act a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "فعلا علانيا مخلا بالحياء"@ar,
        "فعلا مخلا بالحياء"@ar .

dzterm:infractions a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المخالفات"@ar .

dzterm:insurrection_movement a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "حركة التمرد"@ar,
        "حركة تمرد"@ar .

dzterm:judicial_confinement a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الحجز القضائي"@ar,
        "الحجز القضائي في مؤسسة إستشفائية للأمراض العقلية"@ar,
        "الحجز القضائي في مؤسسة إستشفائية للأمراض العقلية هو وضع الشخص بناء على أمر أو حكم أو قرار قضائي في مؤسسة مهيأة لهذا الغرض بسبب خلل في قواه العقلية قائم وقت ارتكابه الجريمة أو اعتراه بعد ارتكابها."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_21_defocc_c931cfffae0e> .

dzterm:judicial_placement a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوضع القضائي في مؤسسة علاجية"@ar,
        "الوضع القضائي في مؤسسة علاجية هو وضع شخص مصاب بإدمان اعتيادي ناتج عن تعاطي مواد كحولية أو مخدرات أو مؤثرات عقلية، تحت الملاحظة في مؤسسة مهيأة لهذا الغرض، وذلك بناء على أمر أو حكم أو قرار قضائي صادر من الجهة المحال إليها الشخص إذا بدا أن السلوك الإجرامي للمعني مرتبط بهذا الإدمان."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_22_defocc_71173a94632e> .

dzterm:judicial_police_officer a skos:Concept,
