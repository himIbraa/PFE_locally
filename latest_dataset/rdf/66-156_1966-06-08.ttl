<https://legal.dz/resource/order/1966-06-08/66-156#art_295_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_295> ;
    dzdoc:position 0 ;
    dzdoc:text "كل من يدخل فجأة أو خدعة أو يقتحم منزل مواطن يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 1.000 إلى 10.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_295_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_295> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا ارتكبت الجنحة بالتهديد أو بالعنف تكون العقوبة بالحبس من خمس سنوات على الأقل إلى عشر سنوات على الأكثر وبغرامة من 5.000 إلى 20.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_298_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_298_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب على السب الموجه إلى شخص أو أكثر بسبب انتمائهم إلى مجموعة عرقية أو مذهبية أو إلى دين معين بالحبس من خمسة (5) أيام إلى ستة (6) أشهر وبغرامة من 5.000 إلى 50.000 دج أو بإحدى هاتين العقوبتين فقط."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_298_condition_0_86da7bd5> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1966-06-08/66-156#art_298_condition_0_86da7bd5_role_22cac6803f> ;
    dznorm:conditionText "إذا كان الغرض هو التحريض على الكراهية بين المواطنين أو السكان"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_298> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_298_condition_0_86da7bd5_role_22cac6803f> a dznorm:Role ;
    rdfs:label "الكراهية بين المواطنين أو"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "إذا كان الغرض هو التحريض على الكراهية بين المواطنين أو السكان"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_298> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_298_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_298> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب على القذف الموجه إلى الأفراد بالحبس من شهرين (2) إلى ستة (6) أشهر وبغرامة من 25.000 دج إلى 50.000 دج أو بإحدى هاتين العقوبتين."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_298_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_298> ;
    dzdoc:position 1 ;
    dzdoc:text "ويضع صفح الضحية حدا للمتابعة الجزائية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_298_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_298> ;
    dzdoc:position 2 ;
    dzdoc:text "ويعاقب على القذف الموجه إلى شخص أو أكثر بسبب انتمائهم إلى مجموعة عرقية أو مذهبية أو إلى دين معين بالحبس من شهر (1) إلى سنة (1) وبغرامة من 10.000 دج إلى 100.000 دج أو بإحدى هاتين العقوبتين فقط إذا كان الغرض هو التحريض على الكراهية بين المواطنين أو السكان."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_299_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_299> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب على السب الموجه إلى فرد أو عدة أفراد بالحبس من شهر (1) إلى ثلاثة (3) أشهر وبغرامة من 10.000 دج إلى 25.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_299_para_1> a dzdoc:Paragraph ;
