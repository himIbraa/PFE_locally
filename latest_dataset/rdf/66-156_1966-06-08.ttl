<https://legal.dz/resource/order/1966-06-08/66-156#version_art_161> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل شخص مكلف يتخلى إما شخصيا أو كعضو في شركة توريد أو مقاولات أو وكالات تعمل لحساب الجيش الوطني الشعبي ، عن القيام بالخدمات التي عهدت إليه ما لم تكرهه على ذلك قوة قاهرة ، يعاقب بالسجن من خمس سنوات إلى عشر سنوات وبغرامة لا يتجاوز مقدارها ربع التعويضات المدنية، ولا تقل عن مبلغ 2.000 دج، كل ذلك دون الإخلال بتطبيق العقوبات الأشد في حالة المخابرة مع العدو. ويحكم على متعهدي التموين أو عملائهم أيضا بهذه العقوبات عند مشاركتهم في الجريمة. ويعاقب الموظفون أو الوكلاء والمندوبون أو المأجورون من الدولة الذين "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_161_19660608_OpEnact_9e77f7cbeb> ;
    dzdoc:replacementText "كل شخص مكلف يتخلى إما شخصيا أو كعضو في شركة توريد أو مقاولات أو وكالات تعمل لحساب الجيش الوطني الشعبي ، عن القيام بالخدمات التي عهدت إليه ما لم تكرهه على ذلك قوة قاهرة ، يعاقب بالسجن من خمس سنوات إلى عشر سنوات وبغرامة لا يتجاوز مقدارها ربع التعويضات المدنية، ولا تقل عن مبلغ 2.000 دج، كل ذلك دون الإخلال بتطبيق العقوبات الأشد في حالة المخابرة مع العدو. ويحكم على متعهدي التموين أو عملائهم أيضا بهذه العقوبات عند مشاركتهم في الجريمة. ويعاقب الموظفون أو الوكلاء والمندوبون أو المأجورون من الدولة الذين حضروا أو ساعدوا الجناة على التخلف عن القيام بخدماتهم، بالسجن من عشر سنوات إلى عشرين سنة، دون الإخلال بتطبيق العقوبات الأشد في حالة المخابرة مع العدو."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_161> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_161> ;
