<https://legal.dz/resource/order/1966-06-08/66-156#version_art_357> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوصف بالتسلق الدخول إلى المنازل أو المباني أو الأحواش أو حظائر الدواجن أو أية أبنية أو بساتين أو حدائق أو أماكن مسورة وذلك بطريق تسور الحيطان أو الأبواب أو السقوف أو أية أسوار أخرى. والدخول عن طريق مداخل تحت الأرض غير تلك التي أعدت لاستعمالها للدخول يعد ظرفا مشددا كالتسلق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_357_19660608_OpEnact_ce338ea1d9> ;
