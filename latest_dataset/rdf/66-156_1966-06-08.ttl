<https://legal.dz/resource/order/1966-06-08/66-156#version_art_190> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "القواد الرؤساء أو المأمورون سواء من رجال الدرك الوطني أو من الجيش الوطني الشعبي أو من الشرطة الذين يقومون بالحراسة أو يشغلون مراكزها و موظفو إدارة السجون وغيرهم من المكلفين بحراسة أو اقتياد المسجونين الذين يترتب على إهمالهم هروب المسجونين أو تسهيل هروبهم يعاقبون بالحبس من شهر إلى سنتين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_190_19660608_OpEnact_dde9f69371> ;
    dzdoc:replacementText "القواد الرؤساء أو المأمورون سواء من رجال الدرك الوطني أو من الجيش الوطني الشعبي أو من الشرطة الذين يقومون بالحراسة أو يشغلون مراكزها و موظفو إدارة السجون وغيرهم من المكلفين بحراسة أو اقتياد المسجونين الذين يترتب على إهمالهم هروب المسجونين أو تسهيل هروبهم يعاقبون بالحبس من شهر إلى سنتين."@ar ;
