<https://legal.dz/resource/order/1966-06-08/66-156#version_art_158> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن من خمس إلى عشر سنوات كل من يتلف أو يشوه أو يبدد أو ينتزع عمدا أوراقا أو سجلات أو عقودا أو سندات محفوظة في المحفوظات أو أقلام الكتاب أو المستودعات العمومية أو مسلمة إلى أمين عمومي بهذه الصفة . وإذا وقع الإتلاف أو التشويه أو التبديد أو الانتزاع من الأمين العمومي أو بطريق العنف ضد الأشخاص فيكون السجن من عشر سنوات إلى عشرين سنة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_158_19660608_OpEnact_af9c94ff02> ;
