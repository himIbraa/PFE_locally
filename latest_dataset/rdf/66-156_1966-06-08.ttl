    dznorm:provisionText "يتعين الحكم بهما في حالة النص عليهما معا"@ar ;
    dznorm:sourceArticle "art_53_bis_4" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_4_obligation_2_1b99b7c2> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_4_obligation_2_1b99b7c2_action_35c2f01d66> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_4> ;
    dznorm:position 2 ;
    dznorm:provisionText "لا يجوز في أي حال استبدال الحبس بالغرامة"@ar ;
    dznorm:sourceArticle "art_53_bis_4" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_4_obligation_2_1b99b7c2_action_35c2f01d66> a dznorm:Action ;
    rdfs:label "في أي حال استبدال الحبس"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "لا يجوز في أي حال استبدال الحبس بالغرامة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_4> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_4_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_4> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كانت العقوبة المقررة قانونا في مادة الجنح هي الحبس و/أو الغرامة، وتقرر إفادة الشخص الطبيعي غير المسبوق قضائيا بالظروف المخففة، يجوز تخفيض عقوبة الحبس إلى شهرين (2) والغرامة إلى 20.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_4_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_4> ;
    dzdoc:position 1 ;
    dzdoc:text "كما يمكن الحكم بإحدى هاتين العقوبتين فقط، على أن لا تقل عن الحد الأدنى المقرر قانونا للجريمة المرتكبة، وإذا كانت عقوبة الحبس هي وحدها المقررة يجوز استبدالها بغرامة، على أن لا تقل عن 20.000 دج وأن لا تتجاوز 500.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_4_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_4> ;
    dzdoc:position 2 ;
    dzdoc:text "إذا كان المتهم مسبوقا قضائيا، بمفهوم المادة 53 مكرر 5 أدناه ، فإنه لا يجوز تخفيض عقوبات الحبس والغرامة عن الحد الأدنى المقرر قانونا للجنحة المرتكبة عمدا ، ويتعين الحكم بهما في حالة النص عليهما معا. ولا يجوز في أي حال استبدال الحبس بالغرامة."@ar .

