    skos:prefLabel "قانون العقوبات"@ar .

dzterm:premeditation a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "بسبق الإصرار"@ar,
        "سبق الإصرار هو عقد العزم قبل ارتكاب الفعل على الاعتداء على شخص معين أو حتى على شخص يتصادف وجوده أو مقابلته وحتى لو كانت هذه النية متوقفة على أي ظرف أو شرط كان."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_256_defocc_364e08e1d613> .

dzterm:prison_sentence a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الحد الأقصى للسجن المؤقت من عشر سنوات إلى عشرين سنة"@ar,
        "السجن المؤقت من عشر سنوات إلى عشرين سنة"@ar,
        "بالسجن المؤقت من خمس إلى عشر سنوات"@ar .

