<https://legal.dz/resource/order/1966-06-08/66-156#art_456_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_456> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بغرامة من 100 إلى 500 دج ويجوز أن يعاقب أيضا بالحبس لمدة خمسة أيام على الأكثر كل من اتخذ مهنة العرافة أو التنبؤ بالغيب أو تفسير الأحلام وتضبط وتصادر طبقا لأحكام المادتين 15 و16 الأجهزة والأدوات والملابس التي استعملت لممارسة مهنة العرافة والتنبؤ بالغيب أو تفسير الأحلام أو أعدت لذلك."@ar .

