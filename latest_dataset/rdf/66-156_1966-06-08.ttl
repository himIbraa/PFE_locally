<https://legal.dz/resource/order/1966-06-08/66-156#version_art_96_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن قيام المسؤولية الجزائية للشخص المعنوي عن الجرائم المحددة في هذا الفصل، وذلك حسب الشروط المنصوص عليها في المادة 51 مكرر من هذا القانون . وتطبق على الشخص المعنوي عقوبة الغرامة، حسب الكيفيات المنصوص عليها في المادة 18 مكرر ، وفي المادة 18 مكرر 2 من هذا القانون عند الاقتضاء. ويتعرض أيضا لواحدة أو أكثر من العقوبات التكميلية المنصوص عليها في المادة 18 مكرر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_96_bis_19660608_OpEnact_ad1e265c47> ;
    dzdoc:replacementText "يمكن قيام المسؤولية الجزائية للشخص المعنوي عن الجرائم المحددة في هذا الفصل، وذلك حسب الشروط المنصوص عليها في المادة 51 مكرر من هذا القانون . وتطبق على الشخص المعنوي عقوبة الغرامة، حسب الكيفيات المنصوص عليها في المادة 18 مكرر ، وفي المادة 18 مكرر 2 من هذا القانون عند الاقتضاء. ويتعرض أيضا لواحدة أو أكثر من العقوبات التكميلية المنصوص عليها في المادة 18 مكرر ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_96_bis> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
