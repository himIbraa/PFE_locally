<https://legal.dz/resource/order/1966-06-08/66-156#art_113_condition_0_cec57a4e> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1966-06-08/66-156#art_113_condition_0_cec57a4e_ref_72998a6c6fb2> ;
