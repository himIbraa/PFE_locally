<https://legal.dz/resource/order/1966-06-08/66-156#version_art_83> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل شخص يطلب من القوة العمومية التي يمكن أن تكون تحت تصرفه أو يأمرها بأن تقوم بمنع تنفيذ القوانين الخاصة بالتجنيد أو بالتعبئة أو يستخدمها في هذا الغرض أو يعمل على أن يطلب ذلك أو يؤمر به يعاقب بالسجن المؤقت من عشر سنوات إلى عشرين سنة . ويعاقب الفاعل بالسجن المؤبد إذا أدى هذا الطلب أو ذلك الأمر إلى النتيجة المقصودة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_83_19660608_OpEnact_9eb8b6ca26> ;
    dzdoc:replacementText "كل شخص يطلب من القوة العمومية التي يمكن أن تكون تحت تصرفه أو يأمرها بأن تقوم بمنع تنفيذ القوانين الخاصة بالتجنيد أو بالتعبئة أو يستخدمها في هذا الغرض أو يعمل على أن يطلب ذلك أو يؤمر به يعاقب بالسجن المؤقت من عشر سنوات إلى عشرين سنة . ويعاقب الفاعل بالسجن المؤبد إذا أدى هذا الطلب أو ذلك الأمر إلى النتيجة المقصودة ."@ar ;
