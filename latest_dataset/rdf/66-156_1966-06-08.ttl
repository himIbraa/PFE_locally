<https://legal.dz/resource/order/1966-06-08/66-156#version_art_211> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين إلى سنة وبغرامة من 500 إلى 1.000 دينار كل من : 1 ) استعمل طوابع بريد أو طوابع منفصلة أو أوراق أو نماذج مدموغة سبق استعمالها أو زيف الطوابع بأية وسيلة كانت بغرض أن يتفادى ختمها لإبطالها وأن يسمح بهذه الطريقة باستعمالها بعد ذلك. 2 ) زاد من قيمة طوابع البريد أو غيرها من الأوراق البريدية ذات القيمة المالية سواء كانت قد أبطلت أم لا وذلك بالطباعة أو التخريم أو بأية وسيلة أخرى أو باع أو روج أو عرض أو وزع أو صدر هذه الطوابع التي زيدت قيمتها. 3 ) قلد أو أصدر أو زيف قسائم سداد الضريب"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_211_19660608_OpEnact_f51b5230d0> ;
    dzdoc:replacementText "يعاقب بالحبس من شهرين إلى سنة وبغرامة من 500 إلى 1.000 دينار كل من : 1 ) استعمل طوابع بريد أو طوابع منفصلة أو أوراق أو نماذج مدموغة سبق استعمالها أو زيف الطوابع بأية وسيلة كانت بغرض أن يتفادى ختمها لإبطالها وأن يسمح بهذه الطريقة باستعمالها بعد ذلك. 2 ) زاد من قيمة طوابع البريد أو غيرها من الأوراق البريدية ذات القيمة المالية سواء كانت قد أبطلت أم لا وذلك بالطباعة أو التخريم أو بأية وسيلة أخرى أو باع أو روج أو عرض أو وزع أو صدر هذه الطوابع التي زيدت قيمتها. 3 ) قلد أو أصدر أو زيف قسائم سداد الضريبة أو الطوابع أو بصمات التخليص أو قسائم الرد التي تصدرها إدارة البريد في بلد أجنبي أو باع أو روج أو وزع قسائم سداد الضريبة أو الطوابع أو بصمات التخليص أو قسائم الرد المذكورة أو استعملها مع علمه بذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_211> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_211> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
