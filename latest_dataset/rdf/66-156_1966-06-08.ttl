<https://legal.dz/resource/order/1966-06-08/66-156#version_art_217> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 1.000 دينار كل شخص ليس طرفا في المحرر أدلى أمام الموظف العمومي بتقرير يعلم أنه غير مطابق للحقيقة . ذلك فإنه يستفيد من العذر المعفي بالشروط المنصوص عليها في المادة 52 كل من أدلى بوصفه شاهدا أمام بإقرار غير مطابق للحقيقة ثم عدل عنه قبل أن يترتب على استعمال المحرر أي ضرر للغير ومع الموظف العمومي وقبل أن يكون هو نفسه موضوعا للتحقيق ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_217_19660608_OpEnact_061ae541a7> ;
    dzdoc:replacementText "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 1.000 دينار كل شخص ليس طرفا في المحرر أدلى أمام الموظف العمومي بتقرير يعلم أنه غير مطابق للحقيقة . ذلك فإنه يستفيد من العذر المعفي بالشروط المنصوص عليها في المادة 52 كل من أدلى بوصفه شاهدا أمام بإقرار غير مطابق للحقيقة ثم عدل عنه قبل أن يترتب على استعمال المحرر أي ضرر للغير ومع الموظف العمومي وقبل أن يكون هو نفسه موضوعا للتحقيق ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_217> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
