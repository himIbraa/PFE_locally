<https://legal.dz/resource/order/1966-06-08/66-156#version_art_117> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن المؤقت من خمس إلى عشر سنوات، الولاة و رؤساء الدوائر و رؤساء المجالس الشعبية البلدية وغيرهم من رجال الإدارة الذين يتدخلون في أعمال الوظيفة التشريعية وفقا لما هو مقرر في الفقرة الأولى من المادة 116 أو الذين يتخذون قرارات عامة أو تدابير ترمي إلى إصدار أية أوامر أو نواه إلى المحاكم أو إلى المجالس ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_117_19660608_OpEnact_901816c00f> ;
    dzdoc:replacementText "يعاقب بالسجن المؤقت من خمس إلى عشر سنوات، الولاة و رؤساء الدوائر و رؤساء المجالس الشعبية البلدية وغيرهم من رجال الإدارة الذين يتدخلون في أعمال الوظيفة التشريعية وفقا لما هو مقرر في الفقرة الأولى من المادة 116 أو الذين يتخذون قرارات عامة أو تدابير ترمي إلى إصدار أية أوامر أو نواه إلى المحاكم أو إلى المجالس ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_117> ;
