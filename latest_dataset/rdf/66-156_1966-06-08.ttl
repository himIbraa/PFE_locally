    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:versionText "سبق الإصرار هو عقد العزم قبل ارتكاب الفعل على الاعتداء على شخص معين أو حتى على شخص يتصادف وجوده أو مقابلته وحتى لو كانت هذه النية متوقفة على أي ظرف أو شرط كان."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_257_19660608_OpEnact_ebdc158e02> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_257> ;
