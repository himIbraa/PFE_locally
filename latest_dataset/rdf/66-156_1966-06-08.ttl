<https://legal.dz/resource/order/1966-06-08/66-156#version_art_102> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا منع مواطن أو أكثر من ممارسة حق الانتخاب بوسائل التجمهر أو التعدي أو التهديد ، فيعاقب كل واحد من الجناة بالحبس من ستة أشهر على الأقل إلى سنتين على الأكثر وبحرمانه من حق الانتخاب والترشيح لمدة سنة على الأقل وخمس سنوات على الأكثر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
