<https://legal.dz/resource/order/1966-06-08/66-156#art_277> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_277" ;
    dzdoc:fullText "يستفيد مرتكب جرائم القتل والجرح والضرب من الاعذار إذا دفعه إلى ارتكابها وقوع ضرب شديد من أحد الأشخاص ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_277_right_0_d1721551> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_277> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_277_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_277_19660608_OpEnact_3e0a8126ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 277" ;
    dzdoc:position 366 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_277_condition_0_ee951493> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_1_sec_1> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "لا يتغير نوع الجريمة إذا أصدر القاضي فيها حكما يطبق أصلا على نوع آخر منها نتيجة لظرف مخفف للعقوبة أو نتيجة لحالة العود التي يكون عليها المحكوم عليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_28_19660608_OpEnact_c3e77eb4bb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 28" ;
    dzdoc:position 50 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_28_condition_0_99a41c08> ;
    dzdoc:usesTerm dzterm:offense .

<https://legal.dz/resource/order/1966-06-08/66-156#art_280> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_280" ;
    dzdoc:fullText "يستفيد مرتكب جناية الخصاء من الاعذار إذا دفعه فورا إلى ارتكابها وقوع هتك عرض بالعنف ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_280_right_0_8de13637> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_280> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_280_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_280_19660608_OpEnact_298ac55cc1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 280" ;
    dzdoc:position 369 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_280_condition_0_89385a63> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_281> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_281" ;
    dzdoc:fullText "يستفيد مرتكب الجرح والضرب من الاعذار المعفية إذا ارتكبها ضد شخص بالغ يفاجأ في حالة تلبس بهتك عرض قاصر لم يكمل السادسة عشرة سواء بالعنف أو بغير عنف ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_281_right_0_77eb887c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_281> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_281_para_0> ;
