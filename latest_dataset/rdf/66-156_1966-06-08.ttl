<https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_condition_0_ed3de091> a dznorm:Condition ;
    dznorm:conditionText "إذا ثبت للجهة القضائية أن للجريمة التي ارتكبها صلة مباشرة بمزاولتهما ، وأن ثمة خطر في استمرار ممارسته لأي منهما"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز الحكم على الشخص المدان لارتكابه جناية أو جنحة بـالمنع من ممارسة مهنة أو نشاط، إذا ثبت للجهة القضائية أن للجريمة التي ارتكبها صلة مباشرة بمزاولتهما ، وأن ثمة خطر في استمرار ممارسته لأي منهما."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis> ;
    dzdoc:position 1 ;
    dzdoc:text "ويصدر الحكم بالمنع لمدة لا تتجاوز عشر (10) سنوات في حالة الإدانة لارتكاب جناية وخمس (5) سنوات في حالة الإدانة لارتكاب جنحة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis> ;
    dzdoc:position 2 ;
    dzdoc:text "ويجوز أن يؤمر بالنفاذ المعجل بالنسبة لهذا الإجراء."@ar .

