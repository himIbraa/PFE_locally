<https://legal.dz/resource/order/1966-06-08/66-156#art_269> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_269" ;
    dzdoc:fullText "كل من جرح أو ضرب عمدا قاصرا لا تتجاوز سنه السادسة عشرة أو منع عنه عمدا الطعام أو العناية إلى الحد الذي يعرض صحته للضرر، أو ارتكب ضده عمدا أي عمل آخر من أعمال العنف أو التعدي فيما عدا الإيذاء الخفيف، يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 5.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_269> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_269_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_269_19660608_OpEnact_98370f2f6c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 269" ;
    dzdoc:position 357 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_335> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_6> ;
    dzdoc:eId "art_335" ;
    dzdoc:fullText "يعاقب بالسجن المؤقت من خمس إلى عشر سنوات كل من ارتكب فعلا مخلا بالحياء ضد إنسان ذكرا كان أو أنثى بغير عنف أو شرع في ذلك. وإذا وقعت الجريمة على قاصر لم يكمل السادسة عشرة يعاقب الجاني بالسجن المؤقت من عشر سنوات إلى عشرين سنة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_335> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_335_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_335_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_335_19660608_OpEnact_03915a726e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_335_obligation_0_92f3907b>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_335_obligation_1_6d77725c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "335" ;
    dzdoc:position 478 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_335_condition_0_2260aaf4> ;
    dzdoc:usesTerm dzterm:indecent_act .

<https://legal.dz/resource/order/1966-06-08/66-156#art_336> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_6> ;
    dzdoc:eId "art_336" ;
    dzdoc:fullText "كل من ارتكب جناية الاغتصاب يعاقب بالسجن من خمس (5) سنوات إلى عشر (10) سنوات . إذا وقع الاغتصاب على قاصر لم يكمل الثامنة عشرة (18) سنة ، فتكون العقوبة السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_336> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_336_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_336_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_336_19660608_OpEnact_fba1b4c61c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_336_obligation_0_e5bb3be6>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_336_obligation_1_8b056301> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "336" ;
    dzdoc:position 479 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_336_condition_0_2ac18ba8> ;
    dzdoc:usesTerm dzterm:rape .

<https://legal.dz/resource/order/1966-06-08/66-156#art_342> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_7> ;
    dzdoc:eId "art_342" ;
    dzdoc:fullText "كل من حرض قاصرا لم يكمل الثامنة عشرة (18) سنة على الفسق أو فساد الأخلاق أو تشجيعه عليه أو تسهيله له ولو بصفة عرضية، يعاقب بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 20.000 دج إلى 100.000 دج. ويعاقب على الشروع في ارتكاب الجنحة المنصوص عليها في هذه المادة بالعقوبات المقررة للجريمة التامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_342> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_342_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_342_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_342_19660608_OpEnact_c77687f4a9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_342_obligation_0_9dd5b9ec> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "342" ;
    dzdoc:position 488 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_342> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_342> ;
    dzdoc:usesTerm dzterm:corruption_of_morals,
        dzterm:debauchery,
        dzterm:minor .

<https://legal.dz/resource/order/1966-06-08/66-156#art_35> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_35" ;
    dzdoc:fullText "إذا صدرت عدة أحكام سالبة للحرية بسبب تعدد المحاكمات فإن العقوبة الأشد وحدها هي التي تنفذ. ومع ذلك إذا كانت العقوبات المحكوم بها من طبيعة واحدة فإنه يجوز للقاضي بقرار مسبب أن يأمر بضمها كلها أو بعضها في نطاق الحد الأقصى المقرر قانونا للجريمة الأشد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_35_permission_0_3f9a0345> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_35_right_0_6f606f3b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_35> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_35_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_35_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_35_19660608_OpEnact_1093adf53a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 35" ;
    dzdoc:position 57 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_35_condition_0_83a277be>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_35_condition_1_c3e7da03> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_381> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_381" ;
    dzdoc:fullText "كل من أؤتمن على ورقة موقعة على بياض وخان أمانتها بأن حرر عليها زورا التزاما أو إبراء منه، أو أي تصرف آخر يمكن أن يعرض شخص الموقع أو ذمته المالية للضرر يعاقب بالحبس من سنة على الأقل إلى خمس سنوات على الأكثر وبغرامة من 1.000 إلى 50.000 دج. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة من سنة على الأقل إلى خمس سنوات على الأكثر. وفي الحالة التي لا تكون الورقة الموقعة على بياض قد عهد بها إليه فتتخذ ضده الإجراءات الجزائية بوصفه مزورا ويعاقب بهذا الوصف."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_381_permission_0_7e003059> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_381> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_381_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_381_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_381_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_381_19660608_OpEnact_c13e0b2ee2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "381" ;
    dzdoc:position 534 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_381_condition_0_b55d41e0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_381_condition_1_99122b78> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_400> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_400" ;
    dzdoc:fullText "تطبق العقوبات المقررة في المواد من 395 إلى 399 حسب التقسيم المنصوص عليه فيها على كل من يخرب عمدا مبان أو مساكن أو غرفا أو خيما أو أكشاكا أو بواخر أو سفنا أو مركبات من أي نوع كانت أو عربات سكة حديد أو طائرات أو مخازن أو أماكن أشغال أو توابعها وعلى العموم أية أشياء منقولة أو ثابتة من أي نوع كان كليا أو جزئيا أو يشرع في ذلك بواسطة لغم أو أية مادة متفجرة أخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_400> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_400_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_400_19660608_OpEnact_8b35991339> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_400_obligation_0_852d9c9a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "400" ;
    dzdoc:position 572 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_395>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_399> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_395>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_399> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:شريك ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "يعتبر شريكا في الجريمة من لم يشترك اشتراكا مباشرا ، ولكنه ساعد بكل الطرق أو عاون الفاعل أو الفاعلين على ارتكاب الأفعال التحضيرية أو المسهلة أو المنفذة لها مع علمه بذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_42> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_42_defocc_f6797741d507> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_42_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_42_19660608_OpEnact_3c18021681> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "42" ;
    dzdoc:position 64 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_53_bis_1" ;
    dzdoc:fullText "إذا كانت العقوبة المقررة للجناية هي الإعدام أو السجن المؤبد، وطبقت العقوبة السالبة للحرية المخففة، وكان المتهم مسبوقا قضائيا، بمفهوم المادة 53 مكرر 5 أدناه ، فإنه يجوز الحكم عليه أيضا بغرامة حدها الأدنى 1.000.000 دج وحدها الأقصى 2.000.000 دج في الحالة الأولى، ومن 500.000 دج إلى 1.000.000 دج في الحالة الثانية. إذا كانت العقوبة المقررة للجناية هي السجن المؤقت وطبقت العقوبة السالبة للحرية المخففة ، فإنه يجوز الحكم أيضا على المتهم المسبوق قضائيا بغرامة من 100.000 دج إلى 1.000.000 دج. وإذا كانت الغرامة منصوصا عليها مع عقوبة السجن ، فإنه يجب النطق بها كذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_1_permission_0_35be79f9>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_1_permission_1_13ffe7f7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_1_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_1_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_1_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_bis_1_19660608_OpEnact_bf47017013> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_1_obligation_0_ac19e8ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "53 مكرر 1" ;
    dzdoc:position 78 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_5> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_5> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_1_condition_0_3fbccb54>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_1_condition_1_35586516>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_1_condition_2_723b83ee> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "يعاقب بالإعدام الاعتداء الذي يكون الغرض منه إما القضاء على نظام الحكم أو تغييره، وإما تحريض المواطنين أو السكان على حمل السلاح ضد سلطة الدولة أو ضد بعضهم بعضا، وإما المساس بوحدة التراب الوطني. ويعتبر في حكم الاعتداء تنفيذ الاعتداء أو محاولة تنفيذه. تطبق أحكام المادة 60 مكرر على الجناية المنصوص عليها في هذه المادة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_77_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_77_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_77_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_77_19660608_OpEnact_b001b2d2f2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_77_obligation_0_f4930fed> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "77" ;
    dzdoc:position 122 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis> ;
    dzdoc:usesTerm dzterm:assault .

<https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_3> a dzdoc:Subsection ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3> ;
