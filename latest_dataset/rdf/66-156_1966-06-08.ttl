<https://legal.dz/resource/order/1966-06-08/66-156#art_276_condition_0_5e7a9898> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1966-06-08/66-156#art_276_condition_0_5e7a9898_ref_6411c2fbfbd4> ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_275> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_275> ;
    dznorm:conditionText "إذا ارتكب الجنح والجنايات المعينة في المادة السابقة أحد الأصول أو الفروع أو أحد الزوجين أو من يرث المجني عليه أو أحد الأشخاص الذين لهم سلطة عليه أو ممن يتولون رعايته"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_276> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_276_condition_0_5e7a9898_ref_6411c2fbfbd4> a dzdoc:Reference ;
    rdfs:label "المادة السابقة"@ar ;
    dzdoc:frbrUri "#art_275"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1966-06-08/66-156#art_275> ;
    dzdoc:sourceEId "art_276" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "إذا ارتكب الجنح والجنايات المعينة في المادة السابقة أحد الأصول أو الفروع أو أحد الزوجين أو من يرث المجني عليه أو أحد الأشخاص الذين لهم سلطة عليه أو ممن يتولون رعايته"@ar ;
    dzdoc:targetEId "art_275" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_276_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_276> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا ارتكب الجنح والجنايات المعينة في المادة السابقة أحد الأصول أو الفروع أو أحد الزوجين أو من يرث المجني عليه أو أحد الأشخاص الذين لهم سلطة عليه أو ممن يتولون رعايته فتكون العقوبة : 1) الحبس من سنتين إلى خمس سنوات وذلك في الحالة المنصوص عليها في الفقرة الأولى من المادة 275. 2) السجن المؤقت من خمس إلى عشر سنوات وذلك في الحالة المنصوص عليها في الفقرة الثانية من المادة 275. 3) السجن المؤقت من عشر سنوات إلى عشرين سنة وذلك في الحالة المنصوص عليها في الفقرة الرابعة من المادة 275. 4) السجن المؤبد وذلك في الحالة المنصوص عليها في الفقرة الخامسة من المادة 275."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_277_condition_0_ee951493> a dznorm:Condition ;
    dznorm:conditionText "إذا دفعه إلى ارتكابها وقوع ضرب شديد من أحد الأشخاص"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_277> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_277_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_277> ;
    dzdoc:position 0 ;
    dzdoc:text "يستفيد مرتكب جرائم القتل والجرح والضرب من الاعذار إذا دفعه إلى ارتكابها وقوع ضرب شديد من أحد الأشخاص."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_277_right_0_d1721551> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
