<https://legal.dz/resource/order/1966-06-08/66-156#version_art_118> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يتجاوز رجال الإدارة الوظائف القضائية بتقريرهم الاختصاص بالحقوق والمصالح التي تدخل في اختصاص المحاكم ثم بقيامهم بعد اعتراض الأطراف أو واحد منهم، ورغم هذا الاعتراض بالفصل في الدعوى قبل أن تصدر السلطة العليا قرارها فيها بالفصل يعاقبون بغرامة لا تقل عن 500 دج ولا تتجاوز 3.000 دج ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_118_19660608_OpEnact_4e0d93e88d> ;
    dzdoc:replacementText "عندما يتجاوز رجال الإدارة الوظائف القضائية بتقريرهم الاختصاص بالحقوق والمصالح التي تدخل في اختصاص المحاكم ثم بقيامهم بعد اعتراض الأطراف أو واحد منهم، ورغم هذا الاعتراض بالفصل في الدعوى قبل أن تصدر السلطة العليا قرارها فيها بالفصل يعاقبون بغرامة لا تقل عن 500 دج ولا تتجاوز 3.000 دج ."@ar ;
