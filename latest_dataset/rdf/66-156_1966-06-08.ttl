<https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_bis_7> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تجوز إفادة الشخص المعنوي بالظروف المخففة، حتى ولو كان مسؤولا جزائيا إذا تقرر إفادة الشخص المعنوي بالظروف المخففة ، فإنه يجوز تخفيض عقوبة الغرامة المطبقة عليه إلى الحد الأدنى للغرامة المقررة في القانون الذي يعاقب على الجريمة بالنسبة للشخص الطبيعي. غير أنه إذا كان الشخص المعنوي مسبوقا قضائيا، بمفهوم المادة 53 مكرر 8 أدناه ، فلا يجوز تخفيض الغرامة عن الحد الأقصى للغرامة المقررة قانونا للجريمة بالنسبة للشخص الطبيعي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_bis_7_19660608_OpEnact_f622bcc597> ;
    dzdoc:replacementText "تجوز إفادة الشخص المعنوي بالظروف المخففة، حتى ولو كان مسؤولا جزائيا إذا تقرر إفادة الشخص المعنوي بالظروف المخففة ، فإنه يجوز تخفيض عقوبة الغرامة المطبقة عليه إلى الحد الأدنى للغرامة المقررة في القانون الذي يعاقب على الجريمة بالنسبة للشخص الطبيعي. غير أنه إذا كان الشخص المعنوي مسبوقا قضائيا، بمفهوم المادة 53 مكرر 8 أدناه ، فلا يجوز تخفيض الغرامة عن الحد الأقصى للغرامة المقررة قانونا للجريمة بالنسبة للشخص الطبيعي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_7> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
