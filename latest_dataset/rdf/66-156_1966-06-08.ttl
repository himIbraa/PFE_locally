<https://legal.dz/resource/order/1966-06-08/66-156#version_art_147> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الأفعال الآتية تعرض مرتكبيها للعقوبات المقررة في الفقرتين 1 و 3 من المادة 144 . الأفعال والأقوال والكتابات العلنية التي يكون الغرض منها التأثير على أحكام القضاة طالما أن الدعوى لم يفصل فيها نهائيا. الأفعال والأقوال والكتابات العلنية التي يكون الغرض منها التقليل من شأن الأحكام القضائية والتي يكون من طبيعتها المساس بسلطة القضاء أو استقلاله."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_147_19660608_OpEnact_d4dd925e1c> ;
    dzdoc:replacementText "الأفعال الآتية تعرض مرتكبيها للعقوبات المقررة في الفقرتين 1 و 3 من المادة 144 . الأفعال والأقوال والكتابات العلنية التي يكون الغرض منها التأثير على أحكام القضاة طالما أن الدعوى لم يفصل فيها نهائيا. الأفعال والأقوال والكتابات العلنية التي يكون الغرض منها التقليل من شأن الأحكام القضائية والتي يكون من طبيعتها المساس بسلطة القضاء أو استقلاله."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_147> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
