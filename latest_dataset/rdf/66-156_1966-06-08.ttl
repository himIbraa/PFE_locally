        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_40>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_41> ;
    dzdoc:heading "تهريب المهاجرين"@ar ;
    dzdoc:number "الخامس مكرر 2" ;
    dzdoc:position 7 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_112> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_3_subsec_3> ;
    dzdoc:eId "art_112" ;
    dzdoc:fullText "إذا اتخذت إجراءات مخالفة للقوانين وكان تدبيرها عن طريق اجتماع أفراد أو هيئات تتولى أي قدر من السلطة العمومية أو عن طريق رسل أو مراسلات فيعاقب الجناة بالحبس من شهر إلى ستة أشهر. ويجوز علاوة على ذلك أن يقضى بحرمانهم من حق أو أكثر من الحقوق المبينة في المادة 14 ومن تولي أية وظيفة أو خدمة عمومية لمدة عشر سنوات على الأكثر."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_112_right_0_3138afff> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_112> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_112_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_112_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_112_19660608_OpEnact_231c2626bf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 112" ;
    dzdoc:position 170 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_112_condition_0_57ed11ab> ;
    dzdoc:usesTerm dzterm:public_office .

<https://legal.dz/resource/order/1966-06-08/66-156#art_136> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_136" ;
    dzdoc:fullText "يجوز محاكمة كل قاض أو موظف إداري يمتنع بأية حجة كانت عن الفصل فيما يجب عليه أن يقضي فيه بين الأطراف بعد أن يكون قد طلب إليه ذلك ويصر على امتناعه بعد التنبيه عليه أو أمر بذلك من رؤسائه ويعاقب بغرامة من 750 إلى 3.000 دج وبالحرمان من ممارسة الوظائف العمومية من خمس سنوات إلى عشرين سنة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_136_permission_0_ac40062f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_136> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_136_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_136_19660608_OpEnact_d46ac1e0da> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_136_obligation_0_8c7bddad> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "136" ;
    dzdoc:position 199 ;
    dzdoc:usesTerm dzterm:administrative_official,
        dzterm:judge .

<https://legal.dz/resource/order/1966-06-08/66-156#art_144> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_144" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من 1.000 دج إلى 500.000دج أو بإحدى هاتين العقوبتين فقط كل من أهان قاضيا أو موظفا أو ضابطا عموميا أو قائدا أو أحد رجال القوة العمومية بالقول أو الإشارة أو التهديد أو بإرسال أو تسليم أي شيء إليهم أو بالكتابة أو الرسم غير العلنيين أثناء تأدية وظائفهم أو بمناسبة تأديتها وذلك بقصد المساس بشرفهم أو باعتبارهم أو بالاحترام الواجب لسلطتهم. وتكون العقوبة الحبس من سنة إلى سنتين إذا كانت الإهانة الموجهة إلى قاض أو عضو محلف أو أكثر قد وقعت في جلسة محكمة أو مجلس قضائي . ويجوز للقضاء في جميع الحالات أن يأمر بأن ينشر الحكم ويعلق بالشروط التي حددت فيه على نفقة المحكوم عليه دون أن تتجاوز هذه المصاريف الحد الأقصى للغرامة المبينة أعلاه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_144> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_144_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_144_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_144_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_144_19660608_OpEnact_996f8aa616> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_144_obligation_0_22a8eeb5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "144" ;
    dzdoc:position 209 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_144> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_144> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_144_condition_0_f3bda1ab> ;
    dzdoc:usesTerm dzterm:civil_servant,
        dzterm:commander,
        dzterm:judge,
        dzterm:public_force,
        dzterm:public_officer .

<https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_4> ;
    dzdoc:eId "art_160_bis_5" ;
    dzdoc:fullText "يعاقب بالحبس من سنة إلى 10 سنوات وبغرامة من 5.000 إلى 20.000 دج كل من قام عمدا بتدنيس، أو تخريب أو تشويه أو إتلاف نصب وألواح تذكارية ومغارات وملاجئ استعملت أثناء الثورة التحريرية، ومراكز الاعتقال والتعذيب وجميع الأماكن الأخرى المصنفة كرموز للثورة. ويعاقب بنفس العقوبة كل من قام عمدا بتخريب أو بتر أو إتلاف وثائق تاريخية أو أشياء متعلقة بالثورة، محفوظة في المتاحف أو في أية مؤسسة مفتوحة للجمهور."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_160_bis_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_5_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_5_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_160_bis_5_19660608_OpEnact_c6cbf6da5a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_5_obligation_0_8ea305ef>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_5_obligation_1_d4e69409> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 160 مكرر 5" ;
    dzdoc:position 232 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_188> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_3> ;
    dzdoc:eId "art_188" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى ثلاث سنوات كل من كان مقبوضا عليه أو معتقلا قانونا بمقتضى أمر أو حكم قضائي ويهرب أو يحاول الهروب من الأماكن التي خصصتها السلطة المختصة لحبسه أو من مكان العمل أو أثناء نقله. ويعاقب الجاني بالحبس من سنتين إلى خمس سنوات إذا وقع الهروب أو الشروع فيه بالعنف أو بالتهديد ضد الأشخاص أو بواسطة الكسر أو تحطيم باب السجن ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_188> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_188_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_188_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_188_19660608_OpEnact_82095c443e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_188_obligation_0_5ca2fe6b>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_188_obligation_1_abceb3d8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "188" ;
    dzdoc:position 269 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_246> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_8> ;
    dzdoc:eId "art_246" ;
    dzdoc:fullText "كل من ارتدى علنا لباسا يشبه الزي الذي يرتديه الجيش الوطني الشعبي، أو الدرك، أو الأمن الوطني، أو إدارة الجمارك، أو الموظفون القائمون بأعمال الضبط القضائي أو قوات الشرطة المساعدة ويكون من شأنه إحداث التباس للجمهور، يعاقب بالحبس من شهر إلى ستة أشهر وبغرامة من 500 إلى 2.500 دج أو بإحدى هاتين العقوبتين فقط ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_246> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_246_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_246_19660608_OpEnact_e2bc1c1bd8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_246_obligation_0_6e5f5618> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 246" ;
    dzdoc:position 330 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_289> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_3> ;
    dzdoc:eId "art_289" ;
    dzdoc:fullText "إذا نتج عن الرعونة أو عن عدم الاحتياط إصابة أو جرح أو مرض أدى إلى العجز الكلي عن العمل لمدة تجاوز ثلاثة أشهر فيعاقب الجاني بالحبس من شهرين إلى سنتين وبغرامة من 500 إلى 15.000 دينار أو بإحدى هاتين العقوبتين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_289> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_289_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_289_19660608_OpEnact_1e0df5117d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_289_obligation_0_049cbf56> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 289" ;
    dzdoc:position 378 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_289_condition_0_2729a023> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_317> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_317" ;
    dzdoc:fullText "إذا كان مرتكب الحادث من أصول الطفل أو العاجز أو ممن يتولون رعايته فتكون العقوبة كما يأتي : الحبس من ستة أشهر إلى سنتين في الحالة المنصوص عليها في الفقرة 1 من المادة 316 ، الحبس من سنتين إلى خمس سنوات في الحالة المنصوص عليها في الفقرة 2 من المادة المذكورة، السجن من خمس سنوات إلى عشر سنوات في الحالة المنصوص عليها في الفقرة 3 من المادة المذكورة، السجن من عشر سنوات إلى عشرين سنة في الحالة المنصوص عليها في الفقرة 4 من المادة المذكورة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_317> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_317_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_317_19660608_OpEnact_d317026fd7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 317" ;
    dzdoc:position 455 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_316> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_316> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_317_condition_0_e4450247> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_339> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_6> ;
    dzdoc:eId "art_339" ;
    dzdoc:fullText "يقضى بالحبس من سنة إلى سنتين على كل امرأة متزوجة ثبت ارتكابها جريمة الزنا . وتطبق العقوبة ذاتها على كل من ارتكب جريمة الزنا مع امرأة يعلم أنها متزوجة. ويعاقب الزوج الذي يرتكب جريمة الزنا بالحبس من سنة إلى سنتين وتطبق العقوبة ذاتها على شريكته. ولا تتخذ الإجراءات إلا بناء على شكوى الزوج المضرور ، وإن صفح هذا الأخير يضع حدا لكل متابعة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_339> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_339_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_339_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_339_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_339_para_3> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_339_19660608_OpEnact_0f0d9db101> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "339" ;
    dzdoc:position 483 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_339_condition_0_b9713bd9>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_339_condition_1_94240c6a> ;
    dzdoc:usesTerm dzterm:adultery .

<https://legal.dz/resource/order/1966-06-08/66-156#art_376> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_376" ;
    dzdoc:fullText "كل من اختلس أو بدد بسوء نية أوراقا تجارية أو نقودا أو بضائع أو أوراقا مالية أو مخالصات أو أية محررات أخرى تتضمن أو تثبت التزاما أو إبراء لم تكن قد سلمت إليه إلا على سبيل الإجازة أو الوديعة أو الوكالة أو الرهن أو عارية الاستعمال أو لأداء عمل بأجر أو بغير أجر بشرط ردها أو تقديمها أو لاستعمالها أو لاستخدامها في عمل معين وذلك إضرارا بمالكيها أو واضعي اليد عليها أو حائزيها يعد مرتكبا لجريمة خيانة الأمانة ويعاقب بالحبس من ثلاثة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 20.000 دج. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة وذلك لمدة سنة على الأقل وخمس سنوات على الأكثر. وكل ذلك دون الإخلال بما نصت عليه المادتين 158 و 159 المتعلقتان بسرقة النقود والأوراق التجارية والمستندات والاستيلاء عليها من المستودعات العمومية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_376> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_376_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_376_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_376_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_376_19660608_OpEnact_f338077d05> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_376_obligation_0_2a829104> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "376" ;
    dzdoc:position 529 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_158>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_159> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_158>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_159> ;
    dzdoc:usesTerm dzterm:breach_of_trust .

<https://legal.dz/resource/order/1966-06-08/66-156#art_380> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_380" ;
    dzdoc:fullText "كل من استغل حاجة لقاصر لم يكمل التاسعة عشرة أو ميلا أو هوى أو عدم خبرة فيه ليختلس منه التزامات أو إبراء منها أو أية تصرفات أخرى تشغل ذمته المالية وذلك إضرارا به يعاقب بالحبس من ثلاثة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 10.000 دج. وتكون العقوبة الحبس من سنة إلى خمس سنوات والغرامة من 1.000 إلى 15.000 دج إذا كان المجني عليه موضوعا تحت رعاية الجاني أو رقابته أو سلطته وفي جميع الحالات المنصوص عليها في هذه المادة يجوز أن يحكم أيضا على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة وذلك لمدة سنة على الأقل وخمس سنوات على الأكثر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_380_permission_0_7576b9ec> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_380> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_380_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_380_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_380_19660608_OpEnact_f18c6820a7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_380_obligation_0_06df4a79> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "380" ;
    dzdoc:position 533 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_380_condition_0_b62b6bd0> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_432> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_4> ;
    dzdoc:eId "art_432" ;
    dzdoc:fullText "إذا ألحقت المادة الغذائية أو الطبية المغشوشة أو الفاسدة بالشخص الذي تناولها، أو الذي قدمت له مرضا أو عجزا عن العمل ، يعاقب مرتكب الغش وكذا الذي عرض أو وضع للبيع أو باع تلك المادة وهو يعلم أنها مغشوشة أو فاسدة أو سامة، بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج . ويعاقب الجناة بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج على 2.000.000 دج ، إذا تسببت تلك المادة في مرض غير قابل للشفاء، أو في فقد استعمال عضو أو في عاهة مستديمة . ويعاقب الجناة بالسجن المؤبد ، إذا تسببت تلك المادة في موت إنسان ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_432> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_432_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_432_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_432_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_432_19660608_OpEnact_8a7ba0259b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_432_obligation_0_ee5ae369>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_432_obligation_1_1c0a7a99>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_432_obligation_2_0e979f6f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "432" ;
    dzdoc:position 616 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_432_condition_0_97c01b52>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_432_condition_1_702e57f6>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_432_condition_2_86409cdc> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_458> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_2_sec_2_subsec_6> ;
    dzdoc:eId "art_458" ;
    dzdoc:fullText "يعاقب بغرامة من 20 إلى 50 دج ويجوز أن يعاقب أيضا بالحبس لمدة خمسة أيام على الأكثر : 1 - كل من لم يبلغ السلطة المحلية خلال ثلاثة أيام على المواشي أو دواب الجر أو الحمل أو الركوب الهائمة أو المتروكة التي يكون قد عثر عليها . 2 - كل من دخل أرضا لم يكن مالكا أو مستأجرا أو منتفعا أو مزارعا لها أو لم يكن له حق فيها أو في المرور بداخلها أو لم يكن مندوبا أو نائبا عن أحد هؤلاء فمر في هذه الأرض أو في جزء منها سواء كانت مهيأة للزراعة أو مبذورة أو كانت بها حبوب أو ثمار ناضجة أو على وشك النضج. 3 - كل من ألقى أحجارا أو أجساما صلبة أخرى أو أقذارا على منازل أو مباني أو أسوار الغير أو في الحدائق أو الأراضي المسورة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_458> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_458_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_458_19660608_OpEnact_09a2632ea0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_458_obligation_0_a8eee6ec>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_458_obligation_1_81140fb3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 458" ;
    dzdoc:position 647 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_458_condition_0_4a61c486> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_462> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_462" ;
    dzdoc:fullText "يعاقب بغرامة من 30 إلى 100 دج ويجوز أن يعاقب أيضا بالحبس لمدة ثلاثة أيام على الأكثر : كل من كان ملزما بإنارة جزء من طريق عام وأهمل إنارته . كل من أهمل إنارة المواد التي يضعها أو الحفر التي يحدثها في الشوارع أو في الساحات مخالفا بذلك القوانين واللوائح التنظيمية. كل من أهمل تنفيذ اللوائح التنظيمية أو القرارات المتعلقة بالطرق العمومية أو اطاعة الإنذار الصادر من السلطة الإدارية بإصلاح أو هدم المباني الآيلة للسقوط أو رفض ذلك . كل من أهمل تنظيف الشوارع أو الممرات في المناطق التي يترك فيها أمر هذه العناية للسكان . كل من ألقى أو وضع في الطريق العمومي أقذار أو كناسات أو مياها قذرة أو أية مواد أخرى يؤدي سقوطها إلى إحداث ضرر أو تتصاعد منها روائح ضارة بالصحة أو كريهة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_462> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_462_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_462_19660608_OpEnact_e68074a453> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_462_obligation_0_e96c7ba2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_462_obligation_1_bbe9de38>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_462_obligation_2_96c11c59>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_462_obligation_3_1f04d3a9>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_462_obligation_4_1e844d03> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 462" ;
    dzdoc:position 651 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_53_bis_7" ;
    dzdoc:fullText "تجوز إفادة الشخص المعنوي بالظروف المخففة، حتى ولو كان مسؤولا جزائيا إذا تقرر إفادة الشخص المعنوي بالظروف المخففة ، فإنه يجوز تخفيض عقوبة الغرامة المطبقة عليه إلى الحد الأدنى للغرامة المقررة في القانون الذي يعاقب على الجريمة بالنسبة للشخص الطبيعي. غير أنه إذا كان الشخص المعنوي مسبوقا قضائيا، بمفهوم المادة 53 مكرر 8 أدناه ، فلا يجوز تخفيض الغرامة عن الحد الأقصى للغرامة المقررة قانونا للجريمة بالنسبة للشخص الطبيعي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_7_permission_0_ede1e90c>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_7_permission_1_35a6ef9a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_bis_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_7_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_7_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_bis_7_19660608_OpEnact_f622bcc597> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "53 مكرر 7" ;
    dzdoc:position 84 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_8> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_8> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_7_condition_0_f91d8846>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_7_condition_1_587a280c> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_54_bis" ;
    dzdoc:fullText "إذا سبق الحكم نهائيا على شخص طبيعي من أجل جناية أو جنحة معاقب عليها قانونا بعقوبة حدها الأقصى يزيد عن خمس (5) سنوات حبسا، وارتكب جناية ، فإن الحد الأقصى للعقوبة الجنائية المقررة يصبح السجن المؤبد إذا كان الحد الأقصى للعقوبة المقررة قانونا لهذه الجناية عشرين (20) سنة سجنا . و تكون العقوبة المقررة هي الإعدام إذا أدت الجناية إلى إزهاق روح إنسان . ويرفع الحد الأقصى للعقوبة السالبة للحرية إلى الضعف، إذا كان الحد الأقصى للعقوبة المقررة قانونا لهذه الجناية، يساوي أو يقل عن عشر (10) سنوات سجنا . ويرفع الحد الأقصى للغرامة المقررة إلى الضعف ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis_19660608_OpEnact_aa0bda46dd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_obligation_0_3c59019b>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_obligation_1_cc12e5f4>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_obligation_2_cbcbd1b4>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_obligation_3_031f781f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "54 مكرر" ;
    dzdoc:position 87 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_condition_0_584f7614> ;
    dzdoc:usesTerm dzterm:person .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_4_bis> ;
    dzdoc:eId "art_87_bis_9" ;
    dzdoc:fullText "يجب النطق بالعقوبات التبعية المنصوص عليها في المادة 6 من قانون العقوبات لمدة سنتين (2) إلى عشر (10) سنوات في حالة الحكم بعقوبة جنائية تطبيقا لأحكام هذا الأمر. فضلا عن ذلك، يمكن مصادرة ممتلكات المحكوم عليه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_9_permission_0_651de8c4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_9_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_9_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_9_19660608_OpEnact_a5798f4091> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_9_obligation_0_388b0fe8>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_9_obligation_1_651de8c4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "87 مكرر 9" ;
    dzdoc:position 142 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_9_extref_bd7f73d2> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_91> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_6> ;
    dzdoc:eId "art_91" ;
    dzdoc:fullText "مع عدم الإخلال بالواجبات التي يفرضها سر المهنة ، يعاقب بالسجن المؤقت لمدة لا تقل عن عشر سنوات ولا تجاوز عشرين سنة في وقت الحرب وبالحبس من سنة إلى خمس سنوات وبغرامة من 3.000 إلى 30.000 دينار في وقت السلم ، كل شخص علم بوجود خطط أو أفعال لارتكاب جرائم الخيانة أو التجسس أو غيرها من النشاطات التي يكون من طبيعتها الإضرار بالدفاع الوطني ولم يبلغ عنها السلطات العسكرية أو الإدارية أو القضائية فور علمه بها . علاوة على الأشخاص المبينين في المادة 42 يعاقب باعتباره شريكا من يرتكب دون أن يكون فاعلا أو شريكا أحد الأفعال الآتية : تزويد مرتكبي الجنايات والجنح ضد أمن الدولة بالمؤن أو وسائل المعيشة وتهيئة مساكن لهم أو أماكن لاختفائهم أو لتجمعهم وذلك دون أن يكون قد وقع عليه إكراه ومع علمه بنواياهم. حمل مراسلات مرتكبي هذه الجنايات وتلك الجنح وتسهيل الوصول إلى موضوع الجناية أو الجنحة أو إخفائه أو نقله أو توصيله وذلك بأي طريقة كانت . مع علمه بذلك. وعلاوة على الأشخاص المعنيين في المادة 387 يعاقب باعتباره مخفيا من يرتكب من غير الفاعلين أو الشركاء الأفعال الآتية : إخفاء الأشياء أو الأدوات التي استعملت أو كانت ستستعمل في ارتكاب الجناية أو الجنحة والأشياء أو المواد أو الوثائق المتحصلة من الجنايات أو الجنح مع علمه بذلك. إتلاف أو اختلاس أو إخفاء أو تزييف وثيقة عمومية أو خصوصية من شأنها تسهيل البحث عن الجناية أو الجنحة أو اكتشاف الدليل عليها أو عقاب مرتكبيها مع علمه بذلك. ويجوز للمحكمة في الحالات المنصوص عليها في هذه المادة أن تعفي أقارب أو أصهار الفاعل لغاية الدرجة الثالثة من العقوبة المقررة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_91> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_91_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_91_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_91_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_91_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_91_19660608_OpEnact_d3401137f7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_91_obligation_0_74c28839> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "91" ;
    dzdoc:position 147 ;
