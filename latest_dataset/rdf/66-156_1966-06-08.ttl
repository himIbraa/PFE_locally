<https://legal.dz/resource/order/1966-06-08/66-156#version_art_136> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز محاكمة كل قاض أو موظف إداري يمتنع بأية حجة كانت عن الفصل فيما يجب عليه أن يقضي فيه بين الأطراف بعد أن يكون قد طلب إليه ذلك ويصر على امتناعه بعد التنبيه عليه أو أمر بذلك من رؤسائه ويعاقب بغرامة من 750 إلى 3.000 دج وبالحرمان من ممارسة الوظائف العمومية من خمس سنوات إلى عشرين سنة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_136_19660608_OpEnact_d46ac1e0da> ;
    dzdoc:replacementText "يجوز محاكمة كل قاض أو موظف إداري يمتنع بأية حجة كانت عن الفصل فيما يجب عليه أن يقضي فيه بين الأطراف بعد أن يكون قد طلب إليه ذلك ويصر على امتناعه بعد التنبيه عليه أو أمر بذلك من رؤسائه ويعاقب بغرامة من 750 إلى 3.000 دج وبالحرمان من ممارسة الوظائف العمومية من خمس سنوات إلى عشرين سنة."@ar ;
