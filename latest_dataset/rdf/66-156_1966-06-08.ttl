<https://legal.dz/resource/order/1966-06-08/66-156#version_art_95> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من يتلقى أموالا للدعاية من مصدر خارجي سواء بطريق مباشر أو غير مباشر وعلى أية صورة كانت ولأي سبب كان ويقوم بالدعاية السياسية يعاقب بالحبس من ستة أشهر إلى خمس سنوات وبغرامة من 3.600 إلى 36.000 دج. وتضبط جميع الوسائل التي استخدمت في ارتكاب الجريمة ويقضي الحكم إما بمصادرتها أو بإبادتها أو بإتلافها على حسب الأحوال . ويجوز للمحكمة علاوة على ذلك أن تقضي بالحرمان من الحقوق المبينة في المادة 14 من هذا القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_95_19660608_OpEnact_e09a41d289> ;
    dzdoc:replacementText "كل من يتلقى أموالا للدعاية من مصدر خارجي سواء بطريق مباشر أو غير مباشر وعلى أية صورة كانت ولأي سبب كان ويقوم بالدعاية السياسية يعاقب بالحبس من ستة أشهر إلى خمس سنوات وبغرامة من 3.600 إلى 36.000 دج. وتضبط جميع الوسائل التي استخدمت في ارتكاب الجريمة ويقضي الحكم إما بمصادرتها أو بإبادتها أو بإتلافها على حسب الأحوال . ويجوز للمحكمة علاوة على ذلك أن تقضي بالحرمان من الحقوق المبينة في المادة 14 من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_95> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_95> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_96> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من ستة أشهر إلى 3 سنوات وبغرامة من 3.600 إلى 36.000 دج كل من يوزع أو يضع للبيع أو يعرض لأنظار الجمهور أو يحوز بقصد التوزيع أو البيع أو العرض بغرض الدعاية، منشورات أو نشرات أو أوراقا من شأنها الإضرار بالمصلحة الوطنية . وإذا كانت المنشورات أو النشرات أو الأوراق من مصدر أو وحي أجنبي فإن عقوبة الحبس ترفع إلى خمس سنوات. ويجوز للمحكمة علاوة على ذلك أن تقضي في الحالتين السابقتين بعقوبة الحرمان من الحقوق المبينة في المادة 14 من هذا القانون وبالمنع من الإقامة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_96_19660608_OpEnact_8a13a6fc17> ;
    dzdoc:replacementText "يعاقب بالحبس من ستة أشهر إلى 3 سنوات وبغرامة من 3.600 إلى 36.000 دج كل من يوزع أو يضع للبيع أو يعرض لأنظار الجمهور أو يحوز بقصد التوزيع أو البيع أو العرض بغرض الدعاية، منشورات أو نشرات أو أوراقا من شأنها الإضرار بالمصلحة الوطنية . وإذا كانت المنشورات أو النشرات أو الأوراق من مصدر أو وحي أجنبي فإن عقوبة الحبس ترفع إلى خمس سنوات. ويجوز للمحكمة علاوة على ذلك أن تقضي في الحالتين السابقتين بعقوبة الحرمان من الحقوق المبينة في المادة 14 من هذا القانون وبالمنع من الإقامة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_96> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
