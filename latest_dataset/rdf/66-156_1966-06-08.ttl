        <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_2_sec_2_subsec_5>,
        <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_2_sec_2_subsec_6> ;
    dzdoc:heading "الدرجة الثانية للمخالفات من الفئة الثانية"@ar ;
    dzdoc:number "الثاني" ;
    dzdoc:position 1 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_101> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_2> ;
    dzdoc:eId "art_101" ;
    dzdoc:fullText "لا تحول المحاكمة عن جنح التجمهر دون المحاكمة عن الجنايات و الجنح التي ترتكب في أثنائه. ويجوز إلزام الشخص الذي يستمر في الاشتراك في التجمهر بعد التنبيه الثاني الذي يوجهه ممثل السلطة العمومية بالتعويض المالي عن الأضرار الناجمة عن هذا التجمهر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_101> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_101_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_101_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_101_19660608_OpEnact_4487585cbb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_101_obligation_0_dedf82d5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "101" ;
    dzdoc:position 158 ;
    dzdoc:usesTerm dzterm:felonies,
        dzterm:misdemeanor_unlawful_assembly,
        dzterm:misdemeanors,
        dzterm:public_authority_representative,
        dzterm:unlawful_assembly .

<https://legal.dz/resource/order/1966-06-08/66-156#art_103> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_103" ;
    dzdoc:fullText "إذا وقعت الجريمة نتيجة لحظة مدبرة للتنفيذ إما في أراضي الجمهورية وإما في ولاية أو أكثر أو دائرة أو أكثر أو دائرة بلدية أو أكثر فتكون العقوبة هي السجن المؤقت من خمس إلى عشر سنوات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_103> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_103_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_103_19660608_OpEnact_32a1b1caab> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_103_obligation_0_f5108405> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "103" ;
    dzdoc:position 160 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_103_condition_0_8a95533b> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_108> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_108" ;
    dzdoc:fullText "مرتكب الجنايات المنصوص عليها في المادة 107 مسؤول شخصيا مسؤولية مدنية وكذلك الدولة على أن يكون لها حق الرجوع على الفاعل ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_108_right_0_3031beef> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_108> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_108_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_108_19660608_OpEnact_63d9bb825b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "108" ;
    dzdoc:position 165 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_107> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_107> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_109" ;
    dzdoc:fullText "الموظفون العموميون و رجال القوة العمومية و مندوبو السلطة العمومية والمكلفون بـ الشرطة الإدارية أو الضبط القضائي الذين يرفضون أو يهملون الاستجابة إلى طلب يرمي إلى ضبط واقعة حجز غير قانوني وتحكمي إما في المؤسسات أو في الأماكن المخصصة لحجز المقبوض عليهم أو في أي مكان آخر ولا يثبتون أنهم أطلعوا السلطة الرئاسية عن ذلك يعاقبون بالسجن المؤقت من خمس إلى عشر سنوات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_109> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_109_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_109_19660608_OpEnact_444e84ae48> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_109_obligation_0_85cc0e48> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "109" ;
    dzdoc:position 166 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_109_condition_0_d6d4551e> ;
    dzdoc:usesTerm dzterm:administrative_police,
        dzterm:authority_delegates,
        dzterm:judicial_police,
        dzterm:public_force,
        dzterm:public_officials .

<https://legal.dz/resource/order/1966-06-08/66-156#art_118> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_118" ;
    dzdoc:fullText "عندما يتجاوز رجال الإدارة الوظائف القضائية بتقريرهم الاختصاص بالحقوق والمصالح التي تدخل في اختصاص المحاكم ثم بقيامهم بعد اعتراض الأطراف أو واحد منهم، ورغم هذا الاعتراض بالفصل في الدعوى قبل أن تصدر السلطة العليا قرارها فيها بالفصل يعاقبون بغرامة لا تقل عن 500 دج ولا تتجاوز 3.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_118> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_118_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_118_19660608_OpEnact_4e0d93e88d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_118_obligation_0_88c2995f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "118" ;
    dzdoc:position 176 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_118_condition_0_f59d9f81> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_119_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_119_bis" ;
    dzdoc:fullText "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 200.000 دج ، كل موظف عمومي في مفهوم المادة 2 من القانون رقم 06-01 المؤرخ في 20 فبراير سنة 2006 والمتعلق بالوقاية من الفساد ومكافحته، تسبب بإهماله الواضح في سرقة قة أو اختلاس أو تلف أو ضياع أموال عمومية أو خاصة أو أشياء تقوم مقامها أو وثائق أو سندات أو عقود أو أموال منقولة وضعت تحت يده سواء بحكم وظيفته أو بسببها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_119_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_119_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_119_bis_19660608_OpEnact_eeec5cf371> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_119_bis_obligation_0_35b1d1d6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 119 مكرر" ;
    dzdoc:position 178 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1966-06-08/66-156#art_119_bis_extref_a948e29f> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_119_bis_condition_0_307b4764> ;
    dzdoc:usesTerm dzterm:public_official .

<https://legal.dz/resource/order/1966-06-08/66-156#art_120> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_120" ;
    dzdoc:fullText "يعاقب بالحبس من سنتين إلى عشر سنوات وبغرامة من 500 إلى 5.000 دج القاضي أو الموظف أو الضابط العمومي الذي يتلف أو يزيل بطريق الغش وبنية الإضرار وثائق أو سندات أو عقود أو أموالا منقولة كانت في عهدته بهذه الصفة أو سلمت له بسبب وظيفته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_120> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_120_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_120_19660608_OpEnact_dbe040aeca> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_120_obligation_0_97ed3dc5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 120" ;
    dzdoc:position 180 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_120_condition_0_29148747> ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:public_officer,
        dzterm:public_official .

<https://legal.dz/resource/order/1966-06-08/66-156#art_138> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_138" ;
    dzdoc:fullText "كل قاض أو موظف عمومي يطلب تدخل القوة العمومية أو استعمالها ضد تنفيذ قانون أو تحصيل ضرائب مقررة قانونا أو ضد تنفيذ أمر أو قرار قضائي أو أي أمر آخر صادر من السلطة الشرعية أو يأمر بتدخلها أو باستعمالها أو يعمل على حصول هذا الطلب أو ذلك الأمر يعاقب بالحبس من سنة إلى خمس سنوات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_138> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_138_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_138_19660608_OpEnact_6fa004261f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_138_obligation_0_cd56e652> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "138" ;
    dzdoc:position 202 ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:public_official .

<https://legal.dz/resource/order/1966-06-08/66-156#art_146> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_146" ;
    dzdoc:fullText "تطبق على الإهانة أو السب أو القذف الموجه بواسطة الوسائل التي حددتها المادة 144 مكرر ضد البرلمان أو إحدى غرفتيه أو ضد الجهات القضائية أو ضد الجيش الوطني الشعبي أو أية هيئة نظامية أو عمومية أخرى، العقوبات المنصوص عليها في المادة المذكورة أعلاه . وفي حالة العود ، تضاعف الغرامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_146> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_146_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_146_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_146_19660608_OpEnact_abdae40976> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "146" ;
    dzdoc:position 214 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_144_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_144_bis> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_146_condition_0_f24439c6> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_154> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_2> ;
    dzdoc:eId "art_154" ;
    dzdoc:fullText "كل من خبأ أو أخفى جثة يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة بين 500 إلى 1.000 دينار. وإذا كان المخفي يعلم أن الجثة لشخص مقتول أو متوفى نتيجة ضرب أو جرح فإن العقوبة تكون الحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 5.000 دينار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_154> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_154_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_154_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_154_19660608_OpEnact_da3e96e056> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 154" ;
    dzdoc:position 222 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_154_condition_0_a85900e1> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_163> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_5> ;
    dzdoc:eId "art_163" ;
    dzdoc:fullText "إذا وقع غش في نوع وصفة أو كمية الأعمال أو اليد العاملة أو الأشياء الموردة فيعاقب الجناة بالسجن من خمس إلى عشر سنوات وبغرامة لا تجاوز ربع التعويضات ولا تقل عن 2.000 دينار. ويقضى دائما بالحد الأقصى لعقوبة السجن المقررة في الفقرة السابقة على الموظفين العموميين الذين ساهموا في الغش ويجوز علاوة على ذلك الحكم على هؤلاء الموظفين بالحرمان من ممارسة جميع الوظائف أو الخدمات العمومية لمدة سنة على الأقل وخمس سنوات على الأكثر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_163> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_163_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_163_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_163_19660608_OpEnact_95f1216ffb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "163" ;
    dzdoc:position 238 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_163_condition_0_92dba8c4> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_169> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_6> ;
    dzdoc:eId "art_169" ;
    dzdoc:fullText "كل من أنشأ أو أدار بيتا للتسليف على رهون أو رهون حيازية بغير ترخيص من السلطة العمومية يعاقب بالحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 20.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_169> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_169_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
