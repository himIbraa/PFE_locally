    dzdoc:position 0 ;
    dzdoc:text "يعفى من العقوبة المقررة كل من يبلغ السلطات الإدارية أو القضائية عن جريمة الاتجار بالأشخاص قبل البدء في تنفيذها أو الشروع فيها."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_9_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_9> ;
    dzdoc:position 1 ;
