<https://legal.dz/resource/order/1966-06-08/66-156#version_art_428_19660608_OpEnact_02b5ba7c11> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
