<https://legal.dz/resource/order/1966-06-08/66-156#version_art_261> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالإعدام كل من ارتكب جريمة القتل أو قتل الأصول أو التسميم. ومع ذلك تعاقب الأم، سواء كانت فاعلة أصلية أو شريكة في قتل ابنها حديث العهد بالولادة بالسجن المؤقت من عشر سنوات إلى عشرين سنة على أن لا يطبق هذا النص على من ساهموا أو اشتركوا معها في ارتكاب الجريمة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_261_19660608_OpEnact_10e10b78a8> ;
    dzdoc:replacementText "يعاقب بالإعدام كل من ارتكب جريمة القتل أو قتل الأصول أو التسميم. ومع ذلك تعاقب الأم، سواء كانت فاعلة أصلية أو شريكة في قتل ابنها حديث العهد بالولادة بالسجن المؤقت من عشر سنوات إلى عشرين سنة على أن لا يطبق هذا النص على من ساهموا أو اشتركوا معها في ارتكاب الجريمة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_261> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_261> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_262> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
