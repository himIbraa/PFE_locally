<https://legal.dz/resource/order/1966-06-08/66-156#version_art_329> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من تعمد إخفاء قاصر كان قد خطف أو أبعد أو هربه من البحث عنه وكل من أخفاه عن السلطة التي يخضع لها قانونا يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 2.500 دينار أو بإحدى هاتين العقوبتين، وذلك فيما عدا الحالة التي يكون فيها الفعل جريمة اشتراك معاقب عليها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
