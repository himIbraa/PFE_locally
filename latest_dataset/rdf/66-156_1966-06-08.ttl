    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_403> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_403_condition_0_7d999baa_ref_d3f207c48b9f> a dzdoc:Reference ;
