<https://legal.dz/resource/order/1966-06-08/66-156#version_art_417> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من ردم حفرة أو هدم سورا مهما كانت المواد التي صنع بها أو قطع أو اقتلع سياجا أخضر أو أخشابا جافة منه أو نقل أو ألغى أنصاب الحدود أو أية علامات أخرى غرست لفصل الحدود بين مختلف الأملاك أو تعورف عليها كفاصل بينها يعاقب بالحبس من شهرين إلى سنة وبغرامة من 500 إلى 1.000 دينار ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_417_19660608_OpEnact_4fce5c1747> ;
