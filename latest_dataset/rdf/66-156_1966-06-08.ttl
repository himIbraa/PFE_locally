<https://legal.dz/resource/order/1966-06-08/66-156#art_467> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_3> ;
    dzdoc:eId "art_467" ;
    dzdoc:fullText "تستمر المحاكم ومجالس القضاء في إتباع القوانين واللوائح التنظيمية الخاصة بالمواد التي لم ينص عليها هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_467> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_467_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_467_19660608_OpEnact_ff7f01f091> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_467_obligation_0_20e417d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 467" ;
    dzdoc:position 656 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "لا عقوبة على من كان في حالة جنون وقت ارتكاب الجريمة وذلك دون الإخلال بأحكام الفقرة 2 من المادة 21 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_47_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_47_19660608_OpEnact_8e36ead087> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 47" ;
    dzdoc:position 69 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_21_para_2> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_21_para_2> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_47_condition_0_1975e3dd> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "لا عقوبة لمن اضطرته إلى ارتكاب الجريمة قوة لا قبل له بدفعها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_48_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_48_19660608_OpEnact_9678ee0854> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 48" ;
    dzdoc:position 70 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_48_condition_0_7343d36f> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "في مواد المخالفات يقضي على القاصر الذي يبلغ سنه من 13 إلى 18 إما بالتوبيخ وإما بعقوبة الغرامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_51_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_51_19660608_OpEnact_daeb74ebf8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 51" ;
    dzdoc:position 73 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_51_condition_0_cc065d80> ;
    dzdoc:usesTerm dzterm:minor .

<https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_53_bis_3" ;
    dzdoc:fullText "لا يحول الحكم بالحبس كعقوبة مخففة من أجل جناية دون الحكم بحرمان الشخص المدان من مباشرة حق أو أكثر من الحقوق المنصوص عليها في المادة 9 مكرر 1 من هذا القانون. ويجوز الحكم كذلك بالمنع من الإقامة طبقا للشروط المنصوص عليها في المادتين 12 و 13 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_3_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_3_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_bis_3_19660608_OpEnact_a891801aa2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "53 مكرر 3" ;
    dzdoc:position 80 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_12>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_13>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_12>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_13>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_53_مكررة> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:recidivist_natural_person ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_53_مكررة" ;
    dzdoc:fullText "يعد مسبوقا قضائيا كل شخص طبيعي محكوم عليه بحكم نهائي بعقوبة سالبة للحرية، مشمولة أو غير مشمولة بوقف التنفيذ، من أجل جناية أو جنحة من القانون العام دون المساس بالقواعد المقررة لحالة العود."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_مكررة> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_53_مكررة_defocc_0e50314beb36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_53_مكررة_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_19660608_OpEnact_56783f53f5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "53 مكررة" ;
    dzdoc:position 82 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "كل من سبق الحكم عليه من محكمة عسكرية لا يعاقب بعقوبة العود إذا ارتكب بعد ذلك جناية أو جنحة إلا حسبما يكون الحكم الأول قد صدر في جناية أو جنحة معاقب عليها طبقا للقوانين الجزائية العادية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_59_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_59_19660608_OpEnact_13f6de3bfa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "59" ;
    dzdoc:position 102 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_59_condition_0_64e3f575> ;
    dzdoc:usesTerm dzterm:recidivism .

<https://legal.dz/resource/order/1966-06-08/66-156#art_5_bis_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_1_sec_1_bis> ;
    dzdoc:eId "art_5_bis_6" ;
    dzdoc:fullText "لا تنفذ عقوبة العمل للنفع العام إلا بعد صيرورة الحكم نهائيا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_5_bis_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_5_bis_6_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_5_bis_6_19660608_OpEnact_f6f05ba722> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "5 مكرر 6" ;
    dzdoc:position 11 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_5_bis_6_condition_0_a9ed16c3> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_65> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_65" ;
    dzdoc:fullText "يعاقب بالسجن المؤبد كل من يجمع معلومات أو أشياء أو وثائق أو تصميمات بغرض تسليمها إلى دولة أجنبية والذي يؤدي جمعها واستغلالها إلى الإضرار بمصالح الدفاع الوطني أو الاقتصاد الوطني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_65> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_65_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_65_19660608_OpEnact_2aa7b4ba5b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_65_obligation_0_00efc513> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "65" ;
    dzdoc:position 110 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "يعاقب بالسجن المؤقت من عشر سنوات إلى عشرين سنة كل من يسلم بغير إذن سابق من السلطة المختصة إلى شخص يعمل لحساب دولة أو مؤسسة أجنبية اختراعا يهم الدفاع الوطني أو معلومات أو دراسات أو طريقة صنع تتصل باختراع من هذا النوع أو بتطبيقات صناعية تهم الدفاع الوطني أو يفشي إليه شيئا من ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_68_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_68_19660608_OpEnact_3345395bda> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_68_obligation_0_3e191645> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "68" ;
    dzdoc:position 113 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "يعاقب بالحبس من سنة إلى خمس سنوات كل من يقدم معلومات عسكرية لم تجعلها السلطة المختصة علنية وكان من شأن ذيوعها أن يؤدي بجلاء إلى الإضرار بالدفاع الوطني، إلى علم شخص لا صفة له في الإطلاع عليها أو إلى علم الجمهور دون أن تكون لديه نية الخيانة أو التجسس ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_69_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_69_19660608_OpEnact_016ba29b66> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_69_obligation_0_4ac104f5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "69" ;
    dzdoc:position 114 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_71> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_71" ;
    dzdoc:fullText "يعاقب بالسجن المؤقت من عشر سنوات إلى عشرين سنة كل من : يعرض الجزائر لإعلان الحرب بإتيانه أعمالا عدوانية لا تقرها الحكومة. يعرض الجزائر إلى أعمال انتقامية بإتيانه أعمالا عدوانية لا تقرها الحكومة. يجري مع عملاء دولة أجنبية مخابرات من شأنها الإضرار بالمركز العسكري أو الدبلوماسي للجزائر أو بمصالحها الاقتصادية الجوهرية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_71> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_71_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_71_19660608_OpEnact_b113a52fc2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_71_obligation_0_10624839> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "71" ;
    dzdoc:position 116 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_81> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_81" ;
    dzdoc:fullText "يعاقب بالإعدام : كل من تولى قيادة عسكرية أيا كانت بدون وجه حق أو بدون سبب مشروع، وكل من احتفظ بمثل هذه القيادة ضد أمر الحكومة، والقواد الذين يبقون جيوشهم وقواتهم مجتمعة بعد أن صدر لهم الأمر بتسريحها أو تفريقها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_81> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_81_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_81_19660608_OpEnact_3036ab19be> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_81_obligation_0_f4930fed> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "81" ;
    dzdoc:position 126 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_87" ;
    dzdoc:fullText "يعاقب أفراد العصابات الذين لا يتولون فيها أية قيادة أو مهمة بالسجن المؤقت من عشر سنوات إلى عشرين سنة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_87_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_19660608_OpEnact_9e3aaa6edd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_87_obligation_0_041e439e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "87" ;
    dzdoc:position 132 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_4_bis> ;
    dzdoc:eId "art_87_bis_1" ;
    dzdoc:fullText "تكون العقوبات التي يتعرض لها مرتكب الأفعال المذكورة في المادة 87 مكرر أعلاه، كما يأتي : الإعدام عندما تكون العقوبة المنصوص عليها في القانون السجن المؤبد، السجن المؤبد عندما تكون العقوبة المنصوص عليها في القانون السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة، السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة، عندما تكون العقوبة المنصوص عليها في القانون، السجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات، تكون العقوبة مضاعفة بالنسبة للعقوبات الأخرى. وتطبق أحكام المادة 60 مكرر على الجرائم المنصوص عليها في هذه المادة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_1_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_1_19660608_OpEnact_65c24edb7f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "87 مكرر 1" ;
    dzdoc:position 134 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_4_bis> ;
    dzdoc:eId "art_87_bis_2" ;
    dzdoc:fullText "تكون العقوبة ضعف العقوبة المنصوص عليها في قانون العقوبات أو في النصوص الخاصة الأخرى غير المدرجة في هذا النص، بالنسبة لكل الأفعال غير التابعة للأصناف المشار إليها في المادة 87 مكرر أعلاه، عندما تكون نفس هذه الأفعال مرتبطة بالإرهاب أو التخريب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_2_19660608_OpEnact_900ea63879> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "87 مكرر 2" ;
    dzdoc:position 135 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_2_condition_0_bf76c2a3> ;
    dzdoc:usesTerm dzterm:penal_code .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_4_bis> ;
    dzdoc:eId "art_87_bis_4" ;
    dzdoc:fullText "يعاقب بالسجن المؤقت من خمسة (5) سنوات إلى عشر (10) سنوات وبغرامة مالية من 100.000 دج إلى 500.000 دج، كل من يشيد بالأفعال المذكورة في المادة 87 مكرر أعلاه أو يشجعها أو يمولها بأية وسيلة كانت."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_4_19660608_OpEnact_94a25eae27> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_4_obligation_0_4f8462b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "87 مكرر 4" ;
    dzdoc:position 137 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_4_bis> ;
    dzdoc:eId "art_87_bis_5" ;
    dzdoc:fullText "يعاقب بالسجن المؤقت من خمس إلى عشر (10) سنوات وبغرامة مالية من 100.000دج إلى 500.000 دج، كل من يعيد عمدا طبع أو نشر الوثائق أو المطبوعات أو التسجيلات التي تشيد بالأفعال المذكورة في هذا القسم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_5_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
