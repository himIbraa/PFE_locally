<https://legal.dz/resource/order/1966-06-08/66-156#version_art_9_bis_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتمثل الحرمان من ممارسة الحقوق الوطنية والمدنية والعائلية في : العزل أو الإقصاء من جميع الوظائف والمناصب العمومية التي لها علاقة بالجريمة، الحرمان من حق الانتخاب أو الترشح ومن حمل أي وسام، عدم الأهلية لأن يكون مساعدا ،محلفا، أو خبيرا، أو شاهدا على أي عقد، أو شاهدا أمام القضاء إلا على سبيل الاستدلال، الحرمان من الحق في حمل الأسلحة، وفي التدريس، وفي إدارة مدرسة أو الخدمة في مؤسسة للتعليم بوصفه أستاذا أو مدرسا أو مراقبا، عدم الأهلية لأن يكون وصيا أو قيما، سقوط حقوق الولاية كلها أو بعضها. في حالة ال"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_9_bis_1_19660608_OpEnact_41f1941197> ;
    dzdoc:replacementText "يتمثل الحرمان من ممارسة الحقوق الوطنية والمدنية والعائلية في : العزل أو الإقصاء من جميع الوظائف والمناصب العمومية التي لها علاقة بالجريمة، الحرمان من حق الانتخاب أو الترشح ومن حمل أي وسام، عدم الأهلية لأن يكون مساعدا ،محلفا، أو خبيرا، أو شاهدا على أي عقد، أو شاهدا أمام القضاء إلا على سبيل الاستدلال، الحرمان من الحق في حمل الأسلحة، وفي التدريس، وفي إدارة مدرسة أو الخدمة في مؤسسة للتعليم بوصفه أستاذا أو مدرسا أو مراقبا، عدم الأهلية لأن يكون وصيا أو قيما، سقوط حقوق الولاية كلها أو بعضها. في حالة الحكم بعقوبة جنائية ، يجب على القاضي أن يأمر بالحرمان من حق أو أكثر من الحقوق المنصوص عليها أعلاه لمدة أقصاها عشر (10) سنوات، تسري من يوم انقضاء العقوبة الأصلية أو الإفراج عن المحكوم عليه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 300.000 دج ، كل من تعمد المساس بحرمة الحياة الخاصة للأشخاص، بأية تقنية كانت وذلك: بالتقاط أو تسجيل أو نقل مكالمات أو أحاديث خاصة أو سرية، بغير إذن صاحبها أو رضاه. بالتقاط أو تسجيل أو نقل صورة لشخص في مكان خاص، بغير إذن صاحبها أو رضاه. يعاقب على الشروع في ارتكاب الجنحة المنصوص عليها في هذه المادة بالعقوبات ذاتها المقررة للجريمة التامة. ويضع صفح الضحية حدا للمتابعة الجزائية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis_19660608_OpEnact_998fa2e6e5> ;
    dzdoc:replacementText "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 300.000 دج ، كل من تعمد المساس بحرمة الحياة الخاصة للأشخاص، بأية تقنية كانت وذلك: بالتقاط أو تسجيل أو نقل مكالمات أو أحاديث خاصة أو سرية، بغير إذن صاحبها أو رضاه. بالتقاط أو تسجيل أو نقل صورة لشخص في مكان خاص، بغير إذن صاحبها أو رضاه. يعاقب على الشروع في ارتكاب الجنحة المنصوص عليها في هذه المادة بالعقوبات ذاتها المقررة للجريمة التامة. ويضع صفح الضحية حدا للمتابعة الجزائية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
