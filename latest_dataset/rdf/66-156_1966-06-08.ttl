<https://legal.dz/resource/order/1966-06-08/66-156#version_art_44> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب الشريك في جناية أو جنحة بالعقوبة المقررة للجناية أو الجنحة. ولا تؤثر الظروف الشخصية التي ينتج عنها تشديد أو تخفيف العقوبة أو الإعفاء منها إلا بالنسبة للفاعل أو الشريك الذي تتصل به هذه الظروف. والظروف الموضوعية اللصيقة بالجريمة التي تؤدي إلى تشديد أو تخفيف العقوبة التي توقع على من ساهم فيها يترتب عليها تشديدها أو تخفيفها، بحسب ما إذا كان يعلم أو لا يعلم بهذه الظروف. ولا يعاقب على الاشتراك في المخالفة على الإطلاق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_44_19660608_OpEnact_1f38ab1f2b> ;
    dzdoc:replacementText "يعاقب الشريك في جناية أو جنحة بالعقوبة المقررة للجناية أو الجنحة. ولا تؤثر الظروف الشخصية التي ينتج عنها تشديد أو تخفيف العقوبة أو الإعفاء منها إلا بالنسبة للفاعل أو الشريك الذي تتصل به هذه الظروف. والظروف الموضوعية اللصيقة بالجريمة التي تؤدي إلى تشديد أو تخفيف العقوبة التي توقع على من ساهم فيها يترتب عليها تشديدها أو تخفيفها، بحسب ما إذا كان يعلم أو لا يعلم بهذه الظروف. ولا يعاقب على الاشتراك في المخالفة على الإطلاق."@ar ;
