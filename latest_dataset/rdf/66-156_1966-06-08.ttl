<https://legal.dz/resource/order/1966-06-08/66-156#version_art_338> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من ارتكب فعلا من أفعال الشذوذ الجنسي على شخص من نفس جنسه يعاقب بالحبس من شهرين إلى سنتين وبغرامة من 500 إلى 2.000 دينار. وإذا كان أحد الجناة قاصرا لم يكمل الثامنة عشرة فيجوز أن تزاد عقوبة البالغ إلى الحبس لمدة ثلاث سنوات وإلى غرامة 10.000 دينار."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_338_19660608_OpEnact_02e5267be0> ;
    dzdoc:replacementText "كل من ارتكب فعلا من أفعال الشذوذ الجنسي على شخص من نفس جنسه يعاقب بالحبس من شهرين إلى سنتين وبغرامة من 500 إلى 2.000 دينار. وإذا كان أحد الجناة قاصرا لم يكمل الثامنة عشرة فيجوز أن تزاد عقوبة البالغ إلى الحبس لمدة ثلاث سنوات وإلى غرامة 10.000 دينار."@ar ;
    dzdoc:resolutionStatus "resolved" ;
