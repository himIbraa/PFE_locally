<https://legal.dz/resource/order/1966-06-08/66-156#version_art_360> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعتبر طرقا عمومية الطرق والمسالك والدروب وكافة الأماكن الأخرى المخصصة لاستعمال الجمهور والواقعة خارج مجموعات المساكن والتي يجوز لأي فرد أن يمر بها بحرية في أية ساعة من ساعات النهار أو الليل دون اعتراض قانوني من أي كان."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_360_19660608_OpEnact_74935964a1> ;
