<https://legal.dz/resource/order/1966-06-08/66-156#version_art_455> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بغرامة من 100 إلى 500 دج ويجوز أن يعاقب أيضا بالحبس لمدة خمسة أيام على الأكثر : 1 - كل من أتلف أو خرب الطرق العمومية أو اغتصب جزءا منها وذلك بأية طريقة كانت. 2 - كل من أخذ حشائش أو أتربة أو أحجارا من الطرق العمومية دون أن يرخص له بذلك وكل من أخذ تربة أو مواد من الأماكن المملوكة للجماعات ما لم تكن هناك عادات تجيز ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_455_19660608_OpEnact_59b4cd16ff> ;
    dzdoc:replacementText "يعاقب بغرامة من 100 إلى 500 دج ويجوز أن يعاقب أيضا بالحبس لمدة خمسة أيام على الأكثر : 1 - كل من أتلف أو خرب الطرق العمومية أو اغتصب جزءا منها وذلك بأية طريقة كانت. 2 - كل من أخذ حشائش أو أتربة أو أحجارا من الطرق العمومية دون أن يرخص له بذلك وكل من أخذ تربة أو مواد من الأماكن المملوكة للجماعات ما لم تكن هناك عادات تجيز ذلك ."@ar ;
