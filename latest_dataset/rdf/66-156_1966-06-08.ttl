    dznorm:conditionText "دون أن يكون معينا أو معتمدا من طرف السلطة العمومية المؤهلة أو مرخصا له من طرفها للقيام بذلك"@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10_obligation_1_b0b37d92> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10_obligation_1_b0b37d92_role_fe42af098e> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10> ;
    dznorm:position 1 ;
    dznorm:provisionText "ويعاقب بالحبس من ثلاث (3) سنوات إلى خمس (5) سنوات وبغرامة من 50.000 دج إلى 200.000 دج كل من أقدم، بواسطة الخطب أو بأي فعل على أعمال مخالفة للمهمة النبيلة للمسجد أو يكون من شأنها المساس بتماسك المجتمع أو الإشادة بالأفعال المشار إليها في هذا القسم."@ar ;
    dznorm:sourceArticle "art_87_bis_10" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10_obligation_1_b0b37d92_role_fe42af098e> a dznorm:Role ;
    rdfs:label "أعمال مخالفة للمهمة النبيلة"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "ويعاقب بالحبس من ثلاث (3) سنوات إلى خمس (5) سنوات وبغرامة من 50.000 دج إلى 200.000 دج كل من أقدم، بواسطة الخطب أو بأي فعل على أعمال مخالفة للمهمة النبيلة للمسجد أو يكون من شأنها المساس بتماسك المجتمع أو الإشادة بالأفعال المشار إليها في هذا القسم."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من سنة (1) إلى ثلاث (3) سنوات وبغرامة من 10.000 دج إلى 100.000 دج كل من أدى خطبة أو حاول تأديتها داخل مسجد أو في أي مكان عمومي تقام فيه الصلاة دون أن يكون معينا أو معتمدا من طرف السلطة العمومية المؤهلة أو مرخصا له من طرفها للقيام بذلك."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10> ;
    dzdoc:position 1 ;
    dzdoc:text "ويعاقب بالحبس من ثلاث (3) سنوات إلى خمس (5) سنوات وبغرامة من 50.000 دج إلى 200.000 دج كل من أقدم، بواسطة الخطب أو بأي فعل على أعمال مخالفة للمهمة النبيلة للمسجد أو يكون من شأنها المساس بتماسك المجتمع أو الإشادة بالأفعال المشار إليها في هذا القسم."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_1> ;
    dzdoc:position 0 ;
    dzdoc:text """تكون العقوبات التي يتعرض لها مرتكب الأفعال المذكورة في المادة 87 مكرر أعلاه، كما يأتي :
                
                الإعدام عندما تكون العقوبة المنصوص عليها في القانون السجن المؤبد،
                السجن المؤبد عندما تكون العقوبة المنصوص عليها في القانون السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة،
                السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة، عندما تكون العقوبة المنصوص عليها في القانون، السجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات،
                تكون العقوبة مضاعفة بالنسبة للعقوبات الأخرى. الإعدام عندما تكون العقوبة المنصوص عليها في القانون السجن المؤبد، السجن المؤبد عندما تكون العقوبة المنصوص عليها في القانون السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة، السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة، عندما تكون العقوبة المنصوص عليها في القانون، السجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات، تكون العقوبة مضاعفة بالنسبة للعقوبات الأخرى."""@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_1_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_1> ;
    dzdoc:position 1 ;
    dzdoc:text "وتطبق أحكام المادة 60 مكرر على الجرائم المنصوص عليها في هذه المادة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_2_condition_0_bf76c2a3> a dznorm:Condition ;
    dznorm:conditionText "عندما تكون نفس هذه الأفعال مرتبطة بالإرهاب أو التخريب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_2> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_2_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_2> ;
    dzdoc:position 0 ;
    dzdoc:text "تكون العقوبة ضعف العقوبة المنصوص عليها في قانون العقوبات أو في النصوص الخاصة الأخرى غير المدرجة في هذا النص، بالنسبة لكل الأفعال غير التابعة للأصناف المشار إليها في المادة 87 مكرر أعلاه، عندما تكون نفس هذه الأفعال مرتبطة بالإرهاب أو التخريب."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_3_obligation_0_1cae013c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_3_obligation_0_1cae013c_ref_b67e2a6515f1> ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_3> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالسجن المؤبد كل من ينشئ أو يؤسس أو ينظم أو يسير أية جمعية أو تنظيم أو جماعة أو منظمة يكون غرضها أو تقع أنشطتها تحت طائلة أحكام المادة 87 مكرر من هذا الأمر"@ar ;
    dznorm:sourceArticle "art_87_bis_3" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_3_obligation_0_1cae013c_ref_b67e2a6515f1> a dzdoc:Reference ;
