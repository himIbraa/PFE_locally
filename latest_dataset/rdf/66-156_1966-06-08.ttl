<https://legal.dz/resource/order/1966-06-08/66-156#version_art_351> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب مرتكبو السرقة بالسجن المؤبد إذا كانوا يحملون أو يحمل أحد منهم أسلحة ظاهرة أو مخبأة حتى ولو وقعت السرقة من شخص واحد ولم يتوافر أي ظرف مشدد آخر . وتطبق العقوبة ذاتها إذا كان الجناة يضعون السلاح أو يضعه أحدهم في المركبة التي استقلوها إلى مكان الجريمة أو استعملوها في تأمين فرارهم ."@ar ;
