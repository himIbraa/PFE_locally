    dznorm:sourceArticle "art_462" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_462_obligation_3_1f04d3a9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_462> ;
    dznorm:position 3 ;
    dznorm:provisionText "أهمل تنفيذ اللوائح التنظيمية أو القرارات المتعلقة بالطرق العمومية أو اطاعة الإنذار الصادر من السلطة الإدارية بإصلاح أو هدم المباني الآيلة للسقوط أو رفض ذلك"@ar ;
    dznorm:sourceArticle "art_462" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_462_obligation_4_1e844d03> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
