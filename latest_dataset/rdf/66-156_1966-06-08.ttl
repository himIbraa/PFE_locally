    dzdoc:fullText "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 300.000 دج ، كل من تعمد المساس بحرمة الحياة الخاصة للأشخاص، بأية تقنية كانت وذلك: بالتقاط أو تسجيل أو نقل مكالمات أو أحاديث خاصة أو سرية، بغير إذن صاحبها أو رضاه. بالتقاط أو تسجيل أو نقل صورة لشخص في مكان خاص، بغير إذن صاحبها أو رضاه. يعاقب على الشروع في ارتكاب الجنحة المنصوص عليها في هذه المادة بالعقوبات ذاتها المقررة للجريمة التامة. ويضع صفح الضحية حدا للمتابعة الجزائية."@ar ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis_dup_1_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis_dup_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:number "303 مكرر" ;
    dzdoc:originalEId "book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis" ;
    dzdoc:position 401 .

