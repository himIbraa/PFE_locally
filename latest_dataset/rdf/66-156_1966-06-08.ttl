    skos:prefLabel "ضابط آخر من الضبط القضائي"@ar,
        "ضابط بالشرطة القضائية"@ar .

dzterm:life_imprisonment a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "السجن المؤبد"@ar,
        "بالسجن المؤبد"@ar .

dzterm:lying_in_wait a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الترصد"@ar,
        "الترصد هو انتظار شخص لفترة طالت أو قصرت في مكان أو أكثر وذلك إما لإزهاق روحه أو للاعتداء عليه."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_257_defocc_664bb889f20c> .

