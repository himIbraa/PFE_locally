<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_31_condition_3_fec00a0c> a dznorm:Condition ;
    dznorm:conditionText "معاملة المهجرين المهربين معاملة لا إنسانية أو مهينة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_31> ;
    dznorm:position 3 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_31_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_31> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج على تهريب المهاجرين المنصوص عليه في المادة 303 مكرر 30 أعلاه متى ارتكب مع توافر أحد الظروف الآتية : إذا كان من بين الأشخاص المهربين قاصر، تعريض حياة أو سلامة المهاجرين المهربين للخطر أو ترجيح تعرضهم له، معاملة المهجرين المهربين معاملة لا إنسانية أو مهينة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32_condition_0_3a943368> a dznorm:Condition ;
    dznorm:conditionText "إذا ارتكب مع توافر أحد الظروف الآتية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32_condition_1_64b034b4> a dznorm:Condition ;
    dznorm:conditionText "إذا سهلت وظيفة الفاعل ارتكاب الجريمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32_condition_2_5994863c> a dznorm:Condition ;
    dznorm:conditionText "إذا ارتكبت الجريمة من طرف أكثر من شخص"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32> ;
    dznorm:position 2 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32_condition_3_3e157914> a dznorm:Condition ;
    dznorm:conditionText "إذا ارتكبت الجريمة بحمل السلاح أو التهديد باستعماله"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32> ;
    dznorm:position 3 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32_condition_4_a7f674be> a dznorm:Condition ;
    dznorm:conditionText "إذا ارتكبت الجريمة من طرف جماعة إجرامية منظمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32> ;
    dznorm:position 4 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب على تهريب المهاجرين بالسجن من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج إذا ارتكب مع توافر أحد الظروف الآتية : إذا سهلت وظيفة الفاعل ارتكاب الجريمة، إذا ارتكبت الجريمة من طرف أكثر من شخص، إذا ارتكبت الجريمة بحمل السلاح أو التهديد باستعماله، إذا ارتكبت الجريمة من طرف جماعة إجرامية منظمة."@ar .

