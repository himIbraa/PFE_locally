    dznorm:position 0 ;
    dznorm:provisionText "لا يجوز تخفيض عقوبات الحبس والغرامة عن الحد الأدنى المقرر قانونا للجنحة المرتكبة عمدا"@ar ;
    dznorm:sourceArticle "art_53_bis_4" .

