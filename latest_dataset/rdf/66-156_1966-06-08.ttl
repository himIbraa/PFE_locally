<https://legal.dz/resource/order/1966-06-08/66-156#version_art_467_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ترفع قيمة الغرامات المقررة في مادة الجنح كما يأتي : يرفع الحد الأدنى للغرامات إلى 20.001 دج، إذا كان هذا الحد أقل من 20.000 دج ، يرفع الحد الأقصى للغرامات إلى 100.000 دج، إذا كان هذا الحد أقل من 100.000 دج ، يضاعف الحد الأقصى لغرامات الجنح الأخرى إذا كان هذا الحد يساوي أو يفوق 100.000 دج ، ما عدا الحالات التي ينص القانون فيها على حدود أخرى."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_467_bis_19660608_OpEnact_1cd2f3eec4> ;
