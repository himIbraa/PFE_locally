<https://legal.dz/resource/order/1966-06-08/66-156#version_art_194> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من حكم عليه بالحبس لمدة تجاوز ستة أشهر لجريمة التمكين من الهروب أو الشروع في الهروب يجوز أن يقضى عليه علاوة على ذلك بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة لمدة سنة على الأقل وخمس سنوات على الأكثر."@ar ;
