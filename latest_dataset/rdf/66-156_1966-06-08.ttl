<https://legal.dz/resource/order/1966-06-08/66-156#version_art_433> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين إلى ثلاث سنوات وبغرامة من 2.000 إلى 20.000 دج كل من يحوز دون سبب شرعي : سواء مواد صالحة لتغذية الإنسان أو الحيوانات أو مشروبات أو منتوجات فلاحية أو طبيعية يعلم أنها مغشوشة أو فاسدة أو مسمومة، سواء مواد طبية مغشوشة، سواء مواد خاصة تستعمل في غش مواد صالحة لتغذية الإنسان أو الحيوانات أو مشروبات أو منتوجات فلاحية أو طبية، سواء موازين أو مكاييل خاطئة أو آلات أخرى غير مطابقة تستعمل في وزن أو كيل السلع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_433_19660608_OpEnact_856c9702b8> ;
    dzdoc:replacementText "يعاقب بالحبس من شهرين إلى ثلاث سنوات وبغرامة من 2.000 إلى 20.000 دج كل من يحوز دون سبب شرعي : سواء مواد صالحة لتغذية الإنسان أو الحيوانات أو مشروبات أو منتوجات فلاحية أو طبيعية يعلم أنها مغشوشة أو فاسدة أو مسمومة، سواء مواد طبية مغشوشة، سواء مواد خاصة تستعمل في غش مواد صالحة لتغذية الإنسان أو الحيوانات أو مشروبات أو منتوجات فلاحية أو طبية، سواء موازين أو مكاييل خاطئة أو آلات أخرى غير مطابقة تستعمل في وزن أو كيل السلع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
