<https://legal.dz/resource/order/1966-06-08/66-156#version_art_191> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرتكب جريمة التواطؤ على الهروب ويعاقب بالحبس من سنتين إلى خمس سنوات كل شخص من المعينين في المادة 190 هيأ أو سهل هروب مسجون أو شرع في ذلك ولو على غير علم من هذا الأخير وحتى إذا لم يتم الهروب أو يشرع فيه وتوقع العقوبة حتى ولو اقتصرت المساعدة على الهروب على امتناع اختياري. ويجوز أن تضاعف العقوبة إذا تضمنت المساعدة تقديم السلاح . وفي جميع الحالات يجب علاوة على ذلك أن يقضى بحرمان الجاني من ممارسة أية وظيفة أو خدمة عمومية لمدة سنة على الأقل. وخمس سنوات على الأكثر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_191_19660608_OpEnact_5ce7f2ef65> ;
    dzdoc:replacementText "يرتكب جريمة التواطؤ على الهروب ويعاقب بالحبس من سنتين إلى خمس سنوات كل شخص من المعينين في المادة 190 هيأ أو سهل هروب مسجون أو شرع في ذلك ولو على غير علم من هذا الأخير وحتى إذا لم يتم الهروب أو يشرع فيه وتوقع العقوبة حتى ولو اقتصرت المساعدة على الهروب على امتناع اختياري. ويجوز أن تضاعف العقوبة إذا تضمنت المساعدة تقديم السلاح . وفي جميع الحالات يجب علاوة على ذلك أن يقضى بحرمان الجاني من ممارسة أية وظيفة أو خدمة عمومية لمدة سنة على الأقل. وخمس سنوات على الأكثر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
