<https://legal.dz/resource/order/1966-06-08/66-156#version_art_84> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من يرتكب اعتداء يكون الغرض منه نشر التقتيل أو التخريب في منطقة أو أكثر يعاقب بالإعدام. وتنفيذ الاعتداء أو محاولة تنفيذه يعتبر في حكم الاعتداء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
