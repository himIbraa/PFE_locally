<https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2_condition_0_533ae1a2> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2_condition_0_533ae1a2_ref_5a569abca85d> ;
