    dznorm:conditionText "إذا كانوا يشغلونه فعلا عند معاينة الجريمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_15> ;
    dznorm:position 0 .

