<https://legal.dz/resource/order/1966-06-08/66-156#version_art_334> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من خمس إلى عشر سنوات كل من ارتكب فعلا مخلا بالحياء ضد قاصر لم يكمل السادسة عشرة ذكرا كان أو أنثى بغير عنف أو شرع في ذلك. ويعاقب بالسجن المؤقت من خمس إلى عشر سنوات أحد الأصول الذي يرتكب فعلا مخلا بالحياء ضد قاصر ولو تجاوز السادسة عشرة من عمره ولم يصبح بعد راشدا بالزواج."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_334_19660608_OpEnact_e4663715fb> ;
    dzdoc:replacementText "يعاقب بالحبس من خمس إلى عشر سنوات كل من ارتكب فعلا مخلا بالحياء ضد قاصر لم يكمل السادسة عشرة ذكرا كان أو أنثى بغير عنف أو شرع في ذلك. ويعاقب بالسجن المؤقت من خمس إلى عشر سنوات أحد الأصول الذي يرتكب فعلا مخلا بالحياء ضد قاصر ولو تجاوز السادسة عشرة من عمره ولم يصبح بعد راشدا بالزواج."@ar ;
    dzdoc:resolutionStatus "resolved" ;
