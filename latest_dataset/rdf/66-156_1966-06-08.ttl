<https://legal.dz/resource/order/1966-06-08/66-156#version_art_352> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج، كل من ارتكب السرقة في الطرق العمومية أو في المركبات المستعملة لنقل المسافرين أو المراسلات أو الأمتعة أو في داخل نطاق السكك الحديدية والمحطات والموانئ والمطارات وأرصفة الشحن أو التفريغ. ويجوز أيضا أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 9 مكرر 1 وبالمنع من الإقامة طبقا للشروط المنصوص عليها في المادتين 12 و 13 من هذا القانون. يعاقب على الشروع في ارتكاب الجنحة المنصوص عليها في الفق"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_352_19660608_OpEnact_07871711da> ;
    dzdoc:replacementText "يعاقب بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج، كل من ارتكب السرقة في الطرق العمومية أو في المركبات المستعملة لنقل المسافرين أو المراسلات أو الأمتعة أو في داخل نطاق السكك الحديدية والمحطات والموانئ والمطارات وأرصفة الشحن أو التفريغ. ويجوز أيضا أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 9 مكرر 1 وبالمنع من الإقامة طبقا للشروط المنصوص عليها في المادتين 12 و 13 من هذا القانون. يعاقب على الشروع في ارتكاب الجنحة المنصوص عليها في الفقرة السابقة بالعقوبات ذاتها المقررة للجريمة التامة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
