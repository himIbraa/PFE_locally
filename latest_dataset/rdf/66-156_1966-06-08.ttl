<https://legal.dz/resource/order/1966-06-08/66-156#version_art_160_bis_5> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من سنة إلى 10 سنوات وبغرامة من 5.000 إلى 20.000 دج كل من قام عمدا بتدنيس، أو تخريب أو تشويه أو إتلاف نصب وألواح تذكارية ومغارات وملاجئ استعملت أثناء الثورة التحريرية، ومراكز الاعتقال والتعذيب وجميع الأماكن الأخرى المصنفة كرموز للثورة. ويعاقب بنفس العقوبة كل من قام عمدا بتخريب أو بتر أو إتلاف وثائق تاريخية أو أشياء متعلقة بالثورة، محفوظة في المتاحف أو في أية مؤسسة مفتوحة للجمهور."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_160_bis_5_19660608_OpEnact_c6cbf6da5a> ;
    dzdoc:replacementText "يعاقب بالحبس من سنة إلى 10 سنوات وبغرامة من 5.000 إلى 20.000 دج كل من قام عمدا بتدنيس، أو تخريب أو تشويه أو إتلاف نصب وألواح تذكارية ومغارات وملاجئ استعملت أثناء الثورة التحريرية، ومراكز الاعتقال والتعذيب وجميع الأماكن الأخرى المصنفة كرموز للثورة. ويعاقب بنفس العقوبة كل من قام عمدا بتخريب أو بتر أو إتلاف وثائق تاريخية أو أشياء متعلقة بالثورة، محفوظة في المتاحف أو في أية مؤسسة مفتوحة للجمهور."@ar ;
