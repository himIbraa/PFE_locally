dzterm:recidivist_legal_entity a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يعتبر مسبوقا قضائيا كل شخص معنوي محكوم عليه نهائيا بغرامة، مشمولة أو غير مشمولة بوقف التنفيذ، من أجل جريمة من القانون العام"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_8_defocc_9de08fd70db5> .

dzterm:recidivist_natural_person a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يعد مسبوقا قضائيا كل شخص طبيعي محكوم عليه بحكم نهائي بعقوبة سالبة للحرية، مشمولة أو غير مشمولة بوقف التنفيذ، من أجل جناية أو جنحة من القانون العام"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_53_مكررة_defocc_0e50314beb36> .

dzterm:residence_ban a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المنع من الإقامة هو حظر تواجد المحكوم عليه في بعض الأماكن"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_12_defocc_d05afb1b9b01> .

dzterm:residence_restriction a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تحديد الإقامة هو إلزام المحكوم عليه بأن يقيم في نطاق إقليمي يعينه الحكم لمدة لا تتجاوز خمس (5) سنوات"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_11_defocc_20a6705e9050> .

dzterm:sexual_harassment a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يعد مرتكبا لجريمة التحرش الجنسي"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_341_bis_defocc_0edfb0d21b54> .

dzterm:simple_bankruptcy a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التفليس بالتقصير"@ar .

dzterm:supplementary_punishments a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "العقوبات التكميلية هي تلك التي لا يجوز الحكم بها مستقلة عن عقوبة أصلية، فيما عدا الحالات التي ينص عليها القانون صراحة، وهي إما إجبارية أو اختيارية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_4_defocc_0c0c0156b26c> .

dzterm:terrorism_act a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يعتبر فعلا إرهابيا أو تخريبيا، في مفهوم هذا الأمر، كل فعل يستهدف أمن الدولة والوحدة الوطنية والسلامة الترابية واستقرار المؤسسات وسيرها العادي عن طريق أي عمل غرضه ما يأتي:"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_defocc_efe35216fcc6> .

dzterm:thief a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "كل من اختلس شيئا غير مملوك له يعد سارقا"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_350_defocc_8d98ebf003e8> .

dzterm:torture a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يقصد بالتعذيب كل عمل ينتج عنه عذاب أو ألم شديد جسديا كان أو عقليا يلحق عمدا بشخص ما، مهما كان سببه."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_263_bis_defocc_d011daced92f> .

dzterm:weapons a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "وتدخل في مفهوم كلمة أسلحة كافة الآلات والأدوات والأجهزة القاطعة والنافذة والراضة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_93_defocc_438eb6bad327> .

dzterm:العصيان a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "العصيان"@ar .

dzterm:تعدد_الجرائم a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يعتبر تعددا في الجرائم أن ترتكب في وقت واحد أو في أوقات متعددة عدة جرائم لا يفصل بينها حكم نهائي"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_33_defocc_bbb2af240392> .

dzterm:شريك a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يعتبر شريكا في الجريمة من لم يشترك اشتراكا مباشرا ، ولكنه ساعد بكل الطرق أو عاون الفاعل أو الفاعلين على ارتكاب الأفعال التحضيرية أو المسهلة أو المنفذة لها مع علمه بذلك."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_42_defocc_f6797741d507> .

dzterm:فاعل a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يعتبر فاعلا كل من ساهم مساهمة مباشرة في تنفيذ الجريمة أو حرض على ارتكاب الفعل بالهبة أو الوعد أو تهديد أو إساءة استعمال السلطة أو الولاية أو التحايل أو التدليس الإجرامي."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_41_defocc_4535c238a234> .

dzterm:متشرد a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يعد متشردا"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_196_defocc_b7fa5e18a3dd> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_21_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_21> ;
