<https://legal.dz/resource/order/1966-06-08/66-156#art_237> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_7> ;
    dzdoc:eId "art_237" ;
    dzdoc:fullText "المترجم الذي يحرف عمدا جوهر الأقوال أو الوثائق التي يترجمها شفويا وذلك في المواد الجزائية أو المدنية أو الإدارية تطبق عليه العقوبات المقررة لشهادة الزور وفقا للتقسيم المنصوص عليه في المواد من 232 إلى 235 وإذا وقع التحريف في الترجمة المكتوبة لوثيقة معدة أو صالحة لإقامة الدليل على حق أو على واقعة ذات آثار قانونية يعاقب المترجم بالعقوبات المقررة للتزوير وفقا للتقسيم المنصوص عليه في من المواد 214 إلى 221 وتبعا لطبيعة المستند المحرف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_237> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_237_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_237_19660608_OpEnact_7d7399a327> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_237_obligation_0_78360248>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_237_obligation_1_931ba7bd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "237" ;
    dzdoc:position 321 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_214>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_221>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_232>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_235> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_214>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_221>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_232>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_235> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_237_condition_0_49ea53ce> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_249> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_8> ;
    dzdoc:eId "art_249" ;
    dzdoc:fullText "كل من انتحل اسم الغير، في ظروف أدت إلى قيد حكم في صحيفة السوابق القضائية لهذا الغير أو كان من الجائز أن تؤدي إلى ذلك، يعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج، دون الإخلال باتخاذ إجراءات المتابعة ضده بشأن جناية التزوير إذا اقتضى الحال ذلك . ويعاقب بالعقوبة ذاتها كل من تسبب عمدا في قيد حكم في صفيحة السوابق القضائية لغير المتهم وذلك بالإدلاء بأقوال كاذبة متعلقة بالحالة المدنية لهذا المتهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_249> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_249_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_249_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_249_19660608_OpEnact_d638ffaf67> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_249_obligation_0_ae73a592>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_249_obligation_1_cf75ded0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 249" ;
    dzdoc:position 333 ;
    dzdoc:usesTerm dzterm:criminal_record .

<https://legal.dz/resource/order/1966-06-08/66-156#art_260> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:poisoning ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_260" ;
    dzdoc:fullText "التسميم هو الاعتداء على حياة إنسان بتأثير مواد يمكن أن تؤدي إلى الوفاة عاجلا أو آجلا أيا كان استعمال أو إعطاء هذه المواد ومهما كانت النتائج التي تؤدي إليها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_260_permission_0_0585427c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_260> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_260_defocc_a335ef9876b2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_260_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_260_19660608_OpEnact_49ce8cf8bc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "260" ;
    dzdoc:position 345 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_278> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_278" ;
    dzdoc:fullText "يستفيد مرتكب جرائم القتل والجرح والضرب من الاعذار إذا ارتكبها لدفع تسلق أو ثقب أسوار أو حيطان أو تحطيم مداخل المنازل أو الأماكن المسكونة أو ملحقاتها إذا حدث ذلك أثناء النهار . وإذا حدث ذلك أثناء الليل فتطبق أحكام الفقرة الأولى من المادة 40 ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_278_right_0_d1721551> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_278> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_278_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_278_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_278_19660608_OpEnact_05da2abb91> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 278" ;
    dzdoc:position 367 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_40> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_40> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_278_condition_0_7ba1dbad>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_278_condition_1_20076fad> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_285> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_2> ;
    dzdoc:eId "art_285" ;
    dzdoc:fullText "إذا لم يكن التهديد مصحوبا بأي أمر أو شرط فيعاقب الجاني بالحبس من سنة إلى ثلاث سنوات وبغرامة من 500 إلى 2.500 دينار. ويجوز الحكم عليه بالمنع من الإقامة من سنة على الأقل إلى خمس سنوات على الأكثر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_285> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_285_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_285_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_285_19660608_OpEnact_fee8e9d281> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_285_obligation_0_ea09cdb0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "285" ;
    dzdoc:position 374 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_4> ;
    dzdoc:eId "art_293_bis_1" ;
    dzdoc:fullText "يعاقب بالسجن المؤبد كل من يخطف أو يحاول خطف قاصر لم يكمل ثماني عشرة (18) سنة، عن طريق العنف أو التهديد أو الاستدراج أو غيرها من الوسائل. وتطبق على الفاعل العقوبة المنصوص عليها في الفقرة الأولى من المادة 263 من هذا القانون، إذا تعرض القاصر المخطوف إلى تعذيب أو عنف جنسي أو إذا كان الدافع إلى الخطف هو تسديد فدية أو إذا ترتبت عليه وفاة الضحية . لا يستفيد الجاني من ظروف التخفيف المنصوص عليها في هذا القانون مع مراعاة أحكام المادة 294 أدناه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_293_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_293_bis_1_19660608_OpEnact_8d045e5707> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1_obligation_0_94a1b77a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "293 مكرر 1" ;
    dzdoc:position 384 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_263>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_294> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_263>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_294> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1_condition_0_a199b67e> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_298> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5> ;
    dzdoc:eId "art_298" ;
    dzdoc:fullText "يعاقب على القذف الموجه إلى الأفراد بالحبس من شهرين (2) إلى ستة (6) أشهر وبغرامة من 25.000 دج إلى 50.000 دج أو بإحدى هاتين العقوبتين. ويضع صفح الضحية حدا للمتابعة الجزائية. ويعاقب على القذف الموجه إلى شخص أو أكثر بسبب انتمائهم إلى مجموعة عرقية أو مذهبية أو إلى دين معين بالحبس من شهر (1) إلى سنة (1) وبغرامة من 10.000 دج إلى 100.000 دج أو بإحدى هاتين العقوبتين فقط إذا كان الغرض هو التحريض على الكراهية بين المواطنين أو السكان ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_298> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_298_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_298_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_298_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_298_19660608_OpEnact_e77ddbf087> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "298" ;
    dzdoc:position 393 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_298_condition_0_86da7bd5> ;
    dzdoc:usesTerm dzterm:قذف .

<https://legal.dz/resource/order/1966-06-08/66-156#art_301> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5> ;
    dzdoc:eId "art_301" ;
    dzdoc:fullText "يعاقب بالحبس من شهر إلى ستة أشهر وبغرامة من 500 إلى 5.000 دج الأطباء والجراحون والصيادلة والقابلات وجميع الأشخاص المؤتمنين بحكم الواقع أو المهنة أو الوظيفة الدائمة أو المؤقتة ومع على أسرار أدلى بها إليهم وأفشوها في غير الحالات التي يوجب عليهم فيها القانون إفشاءها ويصرح لهم بذلك . ومع ذلك فلا يعاقب الأشخاص المبينون أعلاه، رغم عدم التزامهم بالإبلاغ عن حالات الإجهاض التي تصل إلى علمهم بمناسبة ممارسة مهنتهم بالعقوبات المنصوص عليها في الفقرة السابقة إذا هم أبلغوا بها. فإذا دعوا للمثول أمام القضاء في قضية إجهاض يجب عليهم الإدلاء بشهادتهم دون التقيد بالسر المهني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_301> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_301_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_301_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_301_19660608_OpEnact_f6280652dd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_301_obligation_0_5008b180>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_301_obligation_1_4a42e6d2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "301" ;
    dzdoc:position 397 ;
    dzdoc:usesTerm dzterm:practitioners .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis_2> ;
    dzdoc:eId "art_303_bis_31" ;
    dzdoc:fullText "يعاقب بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج على تهريب المهاجرين المنصوص عليه في المادة 303 مكرر 30 أعلاه متى ارتكب مع توافر أحد الظروف الآتية : إذا كان من بين الأشخاص المهربين قاصر ، تعريض حياة أو سلامة المهاجرين المهربين للخطر أو ترجيح تعرضهم له ، معاملة المهجرين المهربين معاملة لا إنسانية أو مهينة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_31_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_31_19660608_OpEnact_5f997cb6bc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 31" ;
    dzdoc:position 431 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_30> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_30> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_31_condition_0_92a8adcd>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_31_condition_1_3a82f2d4>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_31_condition_2_9012025a>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_31_condition_3_fec00a0c> ;
    dzdoc:usesTerm dzterm:human_smuggling .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis_2> ;
    dzdoc:eId "art_303_bis_38" ;
    dzdoc:fullText "يكون الشخص المعنوي مسؤولا جزائيا عن الجرائم المنصوص عليها في هذا القسم، حسب الشروط المنصوص عليها في المادة 51 مكرر من هذا القانون . وتطبق على الشخص المعنوي العقوبات المنصوص عليها في المادة 18 مكرر من هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_38_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_38_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_38_19660608_OpEnact_9bac21607b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_38_obligation_0_5414e6da>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_38_obligation_1_6ab634e0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 38" ;
    dzdoc:position 438 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:usesTerm dzterm:legal_person .

<https://legal.dz/resource/order/1966-06-08/66-156#art_307> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_307" ;
    dzdoc:fullText "كل من يخالف الحكم القاضي بحرمانه من ممارسة مهنته بمقتضى الفقرة الأخيرة من المادة 306 يعاقب بالحبس من ستة أشهر على الأقل إلى سنتين على الأكثر وبغرامة من 1.000 إلى 10.000 دج. ويجوز علاوة على ذلك الحكم عليه بالمنع من الإقامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_307> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_307_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_307_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_307_19660608_OpEnact_77b199a9a9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_307_obligation_0_75ecb0b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 307" ;
    dzdoc:position 445 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_306> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_306> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_1_sec_2> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "المحاولة في الجنحة لا يعاقب عليها إلا بناء على نص صريح في القانون . والمحاولة في المخالفة لا يعاقب عليها إطلاقا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_31_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_31_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_31_19660608_OpEnact_00cd76d309> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 31" ;
    dzdoc:position 53 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_31_condition_0_963094ab>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_31_condition_1_4e69c79e> ;
    dzdoc:usesTerm dzterm:contravention,
        dzterm:misdemeanor .

<https://legal.dz/resource/order/1966-06-08/66-156#art_329_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_329_bis" ;
    dzdoc:fullText "لا يمكن مباشرة الدعوى العمومية الرامية إلى تطبيق المادة 328 إلا بناء على شكوى الضحية. ويضع صفح الضحية حد للمتابعة الجزائية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_329_bis_permission_0_fc358939> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_329_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_329_bis_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_329_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_329_bis_19660608_OpEnact_131f4d2155> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "329 مكرر" ;
    dzdoc:position 470 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_328> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_328> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_333> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_6> ;
    dzdoc:eId "art_333" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى سنتين وبغرامة من 500 إلى 2.000 دج كل من ارتكب فعلا علانيا مخلا بالحياء . وإذا كان الفعل العلني المخل بالحياء من أفعال الشذوذ الجنسي ارتكب ضد شخص من نفس الجنس تكون العقوبة بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة من 1.000 إلى 10.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_333> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_333_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_333_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_333_19660608_OpEnact_f9f3930dd7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_333_obligation_0_6aa865f6>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_333_obligation_1_69d60ec2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "333" ;
    dzdoc:position 474 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_333_condition_0_70346f57> ;
    dzdoc:usesTerm dzterm:indecent_act .

<https://legal.dz/resource/order/1966-06-08/66-156#art_333_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_6> ;
    dzdoc:eId "art_333_bis_1" ;
    dzdoc:fullText "يعاقب بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج ، كل من صور قاصرا لم يكمل 18 سنة بأي وسيلة كانت وهو يمارس أنشطة جنسية بصفة مبينة، حقيقية أو غير حقيقية، أو صور الأعضاء الجنسية للقاصر لأغراض جنسية أساسا، أو قام بإنتاج أو توزيع أو نشر أو ترويج أو استيراد أو تصدير أو عرض أو بيع أو حيازة مواد إباحية متعلقة بالقصر . في حالة الإدانة تأمر الجهة القضائية بمصادرة الوسائل المستعملة لارتكاب الجريمة والأموال المتحصل عليها بصفة غير مشروعة مع مراعاة حقوق الغير حسن النية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_333_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_333_bis_1_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_333_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_333_bis_1_19660608_OpEnact_cb90bc2285> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_333_bis_1_obligation_0_84f86e09>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_333_bis_1_obligation_1_2c0032a0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "333 مكرر 1" ;
    dzdoc:position 476 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_333_bis_1_condition_0_78fe66ea> ;
    dzdoc:usesTerm dzterm:child_pornography .

<https://legal.dz/resource/order/1966-06-08/66-156#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "يجوز أن تضم العقوبات التبعية وتدابير الأمن في حال تعدد الجنايات أو الجنح ويكون تنفيذ تدابير الأمن التي لا تسمح طبيعتها بتنفيذها في آن واحد بالترتيب المنصوص عليه في قانون تنظيم السجون وإعادة تربية المساجين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_37_permission_0_8a1f65b2> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_37_right_0_08c3b0fb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_37_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_37_19660608_OpEnact_c7d6840bee> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 37" ;
    dzdoc:position 59 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_371> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_371" ;
    dzdoc:fullText "(معدلة كل من تحصل بطريق التهديد كتابة أو شفاهة أو بإفشاء أو نسبة أمور شائنة على أموال أو أوراق مالية أو على توقيع أو على المحررات المبينة في المادة 370 أو شرع في ذلك يكون قد ارتكب جريمة التهديد بالتشهير ويعاقب بالحبس من سنتين إلى خمس سنوات وبغرامة من 2.000 إلى 30.000 دج. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من كافة الحقوق الواردة في المادة 14 أو من بعضها لمدة سنة على الأقل وخمس سنوات على الأكثر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_371> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_371_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_371_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_371_19660608_OpEnact_035ca829e1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "371" ;
    dzdoc:position 522 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_370> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_370> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_371_condition_0_d8307956> ;
    dzdoc:usesTerm dzterm:blackmail .

<https://legal.dz/resource/order/1966-06-08/66-156#art_374> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_374" ;
    dzdoc:fullText "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة لا تقل عن قيمة الشيك أو عن قيمة النقص في الرصيد: (1) كل من أصدر بسوء نية شيكا لا يقابله رصيد قائم وقابل للصرف أو كان الرصيد أقل من قيمة الشيك أو قام بسحب الرصيد كله أو بعضه بعد إصدار الشيك أو منع المسحوب عليه من صرفه. (2) كل من قبل أو ظهر شيكا صادرا في الظروف المشار إليها في الفقرة السابقة مع علمه بذلك. (3) كل من أصدر أو قبل أو ظهر شيكا واشترط عدم صرفه فورا بل جعله كضمان."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_374> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_374_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_374_19660608_OpEnact_4ad7d55914> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "374" ;
    dzdoc:position 526 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_382_bis_1" ;
    dzdoc:fullText "يمكن أن يكون الشخص المعنوي مسؤولا جزائيا عن الجرائم المحددة في الأقسام 1 و 2 و 3 من هذا الفصل ، وذلك طبقا للشروط المنصوص عليها في المادة 51 مكرر . تطبق على الشخص المعنوي عقوبة الغرامة، حسب الكيفيات المنصوص عليها في المادة 18 مكرر ، وفي المادة 18 مكرر 2 عند الاقتضاء. يتعرض أيضا لواحدة أو أكثر من العقوبات التكميلية المنصوص عليها في المادة 18 مكرر ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis_1_permission_0_7a100719> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_382_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis_1_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis_1_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis_1_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_382_bis_1_19660608_OpEnact_695a01a0c2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "382 مكرر 1" ;
    dzdoc:position 537 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:usesTerm dzterm:legal_person .

<https://legal.dz/resource/order/1966-06-08/66-156#art_383> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_4> ;
    dzdoc:eId "art_383" ;
    dzdoc:fullText "كل من ثبتت مسؤوليته لارتكابه جريمة التفليس في الحالات المنصوص عليها في القانون التجاري يعاقب : عن التفليس بالتقصير بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من 25.000 دج إلى 200.000 دج. عن التفليس بالتدليس بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج. ويجوز علاوة على ذلك أن يقضى على المفلس بالتدليس بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 9 مكرر 1 من هذا القانون لمدة سنة (1) على الأقل وخمس (5) سنوات على الأكثر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_383> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_383_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_383_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_383_19660608_OpEnact_fb09c0ee84> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 383" ;
    dzdoc:position 538 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1966-06-08/66-156#art_383_extref_5447306b> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_383_condition_0_1ae61f21> ;
    dzdoc:usesTerm dzterm:bankrupt,
        dzterm:bankruptcy,
        dzterm:fraudulent_bankruptcy,
        dzterm:simple_bankruptcy .

<https://legal.dz/resource/order/1966-06-08/66-156#art_394_مكرر2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_7_bis> ;
    dzdoc:eId "art_394_مكرر2" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين (2) إلى ثلاث (3) سنوات وبغرامة من 1.000.000 دج إلى 5.000.000 دج ، كل من يقوم عمدا وعن طريق الغش بما يأتي : تصميم أو بحث أو تجميع أو توفير أو نشر أو الاتجار في معطيات مخزنة أو معالجة أو مرسلة عن طريق منظومة معلوماتية يمكن أن ترتكب بها الجرائم المنصوص عليها في هذا القسم. حيازة أو إفشاء أو نشر أو استعمال لأي غرض كان المعطيات المتحصل عليها من إحدى الجرائم المنصوص عليها في هذا القسم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_394_مكرر2_permission_0_a2269a79> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_394_مكرر2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_394_مكرر2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_394__2_19660608_OpEnact_394cbc1c73> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_394_مكرر2_obligation_0_15a85bd7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 394 مكرر2" ;
    dzdoc:position 560 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_394_مكرر2_condition_0_6300f4ba> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_430> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_4> ;
    dzdoc:eId "art_430" ;
    dzdoc:fullText "ترفع مدة الحبس إلى خمس (5) سنوات والغرامة إلى 500.000 دج إذا كانت الجريمة أو الشروع فيها المنصوص عليهما أعلاه قد ارتكبا : سواء بواسطة الوزن أو الكيل أو بأدوات أخرى خاطئة أو غير مطابقة، سواء بواسطة طرق احتيالية أو وسائل ترمي إلى تغليط عمليات التحليل أو المقدار أو الوزن أو الكيل أو التغيير عن طريق الغش تركيب أو وزن أو حجم السلع، أو المنتجات، ولو قبل البدء في هذه العمليات، سواء بو اسطة بيانات كاذبة ترمي إلى الاعتقاد بوجود عملية سابقة وصحيحة، أو إلى مراقبة رسمية لم توجد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_430> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_430_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_430_19660608_OpEnact_47fce53054> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_430_obligation_0_65993b56> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "430" ;
    dzdoc:position 615 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_429> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_429> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_430_condition_0_4d70c0cf> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_443> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_443" ;
    dzdoc:fullText "يعاقب بالحبس من عشرة أيام على الأقل إلى شهرين على الأكثر وبغرامة من 100 إلى 1.000 دج أو بإحدى العقوبتين : كل من قتل دون مقتضى، وفي أي مكان دوابا للجر أو الركوب أو الحمل أو مواش ذات قرون أو خرافا أو ماعزا أو أية دابة أخرى أو كلابا للحراسة أو أسماك موجودة في البرك أو الأحواض أو الخزانات ، كل من قتل دون مقتضى حيوانا مستأنسا في مكان يملكه أو يستأجره أو يزرعه مالك الحيوان المقتول ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_443> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_443_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_443_19660608_OpEnact_0f18a82804> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_443_obligation_0_723c2f48> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 443" ;
    dzdoc:position 631 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_443_condition_0_71155bc5>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_443_condition_1_7f3f5db2> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_456> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_456" ;
    dzdoc:fullText "يعاقب بغرامة من 100 إلى 500 دج ويجوز أن يعاقب أيضا بالحبس لمدة خمسة أيام على الأكثر كل من اتخذ مهنة العرافة أو التنبؤ بالغيب أو تفسير الأحلام وتضبط وتصادر طبقا لأحكام المادتين 15 و 16 الأجهزة والأدوات والملابس التي استعملت لممارسة مهنة العرافة و التنبؤ بالغيب أو تفسير الأحلام أو أعدت لذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_456> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_456_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_456_19660608_OpEnact_80b45d5ff1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_456_obligation_0_98a55ec7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 456" ;
    dzdoc:position 645 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_15>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_16> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_15>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_16> ;
    dzdoc:usesTerm dzterm:divination,
        dzterm:dream_interpretation,
        dzterm:fortune_telling .

<https://legal.dz/resource/order/1966-06-08/66-156#art_457> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_2_sec_2_subsec_5> ;
    dzdoc:eId "art_457" ;
    dzdoc:fullText "يعاقب بغرامة من 50 إلى 500 دج ويجوز أن يعاقب أيضا بالحبس لمدة خمسة أيام على الأكثر : 1 - كل من تسبب في موت أو جرح حيوانات أو مواشي مملوكة للغير وذلك نتيجة لإطلاق حيوانات مؤذية أو مفترسة أو بسبب سرعة أو سوء قيادة أو زيادة حمولة العربات أو الخيول أو دواب الجر أو الحمل أو الركوب. 2 - كل من تسبب في نفس الأضرار نتيجة استخدام أو استعمال أسلحة دون احتياط أو برعونة أو نتيجة إلقاء حجارة أو أية أجسام صلبة أخرى. 3 - كل من تسبب لنفس الحوادث نتيجة قدم أو تلف أو عدم إصلاح أو صيانة المنازل أو المباني أو وضع أكوام أو إحداث حفر أو أية أعمال أخرى مماثلة في الشوارع أو الطرق أو الساحات أو الطرق العمومية أو بالقرب منها دون اتخاذ الاحتياط أو وضع العلامات المقررة أو المعتادة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_457> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_457_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_457_19660608_OpEnact_27d3a9d428> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_457_obligation_0_8ca24bbf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "457" ;
    dzdoc:position 646 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_463> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_2_sec_3_subsec_4> ;
    dzdoc:eId "art_463" ;
    dzdoc:fullText "يعاقب بغرامة من 30 إلى 100 دج ويجوز أن يعاقب أيضا بالحبس لمدة ثلاثة أيام على الأكثر : 1 - كل من ألقى بغير احتياط أقذارا على أحد الأشخاص. 2 - كل من ابتدر أحد الأشخاص بألفاظ سباب غير علنية دون أن يكون قد استفزه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_463> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_463_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_463_19660608_OpEnact_1926816bdf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_463_obligation_0_e96c7ba2> ;
