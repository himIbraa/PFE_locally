<https://legal.dz/resource/order/1966-06-08/66-156#art_52_defocc_f9252068cc63> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 164 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:excuses ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_52> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_52_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "الأعذار هي حالات محددة في القانون على سبيل الحصر يترتب عليها مع قيام الجريمة والمسؤولية إما عدم عقاب المتهم إذا كانت أعذارا معفية وإما تخفيف العقوبة إذا كانت مخففة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_52_para_0> a dzdoc:Paragraph ;
