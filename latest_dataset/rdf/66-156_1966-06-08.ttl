<https://legal.dz/resource/order/1966-06-08/66-156#version_art_103> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وقعت الجريمة نتيجة لحظة مدبرة للتنفيذ إما في أراضي الجمهورية وإما في ولاية أو أكثر أو دائرة أو أكثر أو دائرة بلدية أو أكثر فتكون العقوبة هي السجن المؤقت من خمس إلى عشر سنوات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_103_19660608_OpEnact_32a1b1caab> ;
