<https://legal.dz/resource/order/1966-06-08/66-156#version_art_226> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل طبيب أو جراح أو طبيب أسنان أو ملاحظ صحي أو قابلة قرر كذبا بوجود أو بإخفاء وجود مرض أو عاهة أو حمل أو أعطى بيانات كاذبة عن مصدر مرض أو عاهة أو عن سبب الوفاة وذلك أثناء تأدية أعمال وظيفته وبغرض محاباة أحد الأشخاص يعاقب بالحبس لمدة من سنة إلى ثلاث سنوات ما لم يكون الفعل إحدى الجرائم الأشد المنصوص عليها في المواد 126 إلى 134 . ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 من سنة على الأقل إلى خمس سنوات على الأكثر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_226_19660608_OpEnact_ae7c8d7a3f> ;
    dzdoc:replacementText "كل طبيب أو جراح أو طبيب أسنان أو ملاحظ صحي أو قابلة قرر كذبا بوجود أو بإخفاء وجود مرض أو عاهة أو حمل أو أعطى بيانات كاذبة عن مصدر مرض أو عاهة أو عن سبب الوفاة وذلك أثناء تأدية أعمال وظيفته وبغرض محاباة أحد الأشخاص يعاقب بالحبس لمدة من سنة إلى ثلاث سنوات ما لم يكون الفعل إحدى الجرائم الأشد المنصوص عليها في المواد 126 إلى 134 . ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 من سنة على الأقل إلى خمس سنوات على الأكثر."@ar ;
