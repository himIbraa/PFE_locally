<https://legal.dz/resource/order/1966-06-08/66-156#version_art_350_bis_2> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.500.000 دج على الجرائم المنصوص عليها في المادة 350 مكرر 1 أعلاه متى توافرت أحد الظروف الآتية : إذا سهلت وظيفة الفاعل ارتكاب الجريمة، إذا ارتكبت الجريمة من طرف أكثر من شخص، إذا ارتكبت الجريمة مع حمل السلاح أو التهديد باستعماله، إذا ارتكبت الجريمة من طرف جماعة إجرامية منظمة أو كانت ذات طابع عابر للحدود الوطنية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_350_bis_2_19660608_OpEnact_6b2afbef87> ;
    dzdoc:replacementText "يعاقب بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.500.000 دج على الجرائم المنصوص عليها في المادة 350 مكرر 1 أعلاه متى توافرت أحد الظروف الآتية : إذا سهلت وظيفة الفاعل ارتكاب الجريمة، إذا ارتكبت الجريمة من طرف أكثر من شخص، إذا ارتكبت الجريمة مع حمل السلاح أو التهديد باستعماله، إذا ارتكبت الجريمة من طرف جماعة إجرامية منظمة أو كانت ذات طابع عابر للحدود الوطنية."@ar ;
