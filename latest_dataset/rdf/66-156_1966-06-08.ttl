    dzdoc:text "ويجوز أيضا أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 9 مكرر 1 وبالمنع من الإقامة طبقا للشروط المنصوص عليها في المادتين 12 و 13 من هذا القانون."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_352_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_352> ;
    dzdoc:position 2 ;
    dzdoc:text "يعاقب على الشروع في ارتكاب الجنحة المنصوص عليها في الفقرة السابقة بالعقوبات ذاتها المقررة للجريمة التامة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_353_condition_0_0753683a> a dznorm:Condition ;
    dznorm:conditionText "(1) إذا ارتكبت السرقة مع استعمال العنف أو التهديد به."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_353> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_353_condition_1_d988ebfb> a dznorm:Condition ;
    dznorm:conditionText "(2) إذا ارتكبت السرقة ليلا."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_353> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_353_condition_2_7db04607> a dznorm:Condition ;
    dznorm:conditionText "(3) إذا ارتكبت السرقة بواسطة شخصين أو أكثر."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_353> ;
    dznorm:position 2 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_353_condition_3_df37fa0e> a dznorm:Condition ;
    dznorm:conditionText "(4) إذا ارتكبت السرقة بواسطة التسلق أو الكسر من الخارج أو من الداخل أو عن طريق مداخل تحت الأرض أو باستعمال مفاتيح مصطنعة أو بكسر الأختام أو في المنازل أو المساكن أو الغرف أو الدور سواء كانت مسكونة أو مستعملة للسكنى أو في توابعها."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_353> ;
    dznorm:position 3 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_353_condition_4_b282672e> a dznorm:Condition ;
    dznorm:conditionText "(5) إذا استحضر مرتكبو السرقة مركبة ذات محرك بغرض تسهيل فعلهم أو تيسير هروبهم."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_353> ;
    dznorm:position 4 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_353_condition_5_fce294a4> a dznorm:Condition ;
    dznorm:conditionText "(6) إذا كان الفاعل خادما أو مستخدما بأجر حتى ولو وقعت السرقة ضد من لا يستخدمونه لكنها وقعت سواء في منزل مخدومه أو في المنزل الذي كان يصحبه فيه."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_353> ;
    dznorm:position 5 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_353_condition_6_ad8ea391> a dznorm:Condition ;
    dznorm:conditionText "(7) إذا كان السارق عاملا أو عاملا تحت التدريب في منزل مخدومه أو مصنعه أو مخزنه أو إذا كان يعمل عادة في المسكن الذي ارتكبت فيه السرقة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_353> ;
    dznorm:position 6 .

