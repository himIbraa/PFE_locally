<https://legal.dz/resource/order/1966-06-08/66-156#version_art_413_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من ستة أشهر إلى سنتين وبغرامة من 500 إلى 1.000 دج : 1 - كل من أطلق مواشي من أي نوع كانت في أرض مملوكة للغير وعلى الأخص في المشاتل أو في الكروم أو مزارع الصفصاف أو الكبار أو الزيتون أو التوت أو الرمان أو البرتقال أو غيرها من الأشجار المماثلة أو في مزارع أو مشاتل الأشجار ذات الثمار أو غيرها المهيأة بعمل الإنسان. 2 - كل من جعل مواشي أو دواب الجر أو الحمل أو الركوب تمر في أرض الغير المبذورة أو التي بها محاصل في أي فصل كان أو تركها تمر فيها. 3 - كل من جعل مواشيه أو دوابه المعدة للجر أو ا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_413_bis_19660608_OpEnact_84cfc7dc87> ;
    dzdoc:replacementText "يعاقب بالحبس من ستة أشهر إلى سنتين وبغرامة من 500 إلى 1.000 دج : 1 - كل من أطلق مواشي من أي نوع كانت في أرض مملوكة للغير وعلى الأخص في المشاتل أو في الكروم أو مزارع الصفصاف أو الكبار أو الزيتون أو التوت أو الرمان أو البرتقال أو غيرها من الأشجار المماثلة أو في مزارع أو مشاتل الأشجار ذات الثمار أو غيرها المهيأة بعمل الإنسان. 2 - كل من جعل مواشي أو دواب الجر أو الحمل أو الركوب تمر في أرض الغير المبذورة أو التي بها محاصل في أي فصل كان أو تركها تمر فيها. 3 - كل من جعل مواشيه أو دوابه المعدة للجر أو الحمل أو الركوب تمر في أرض الغير قبل جني المحصول."@ar ;
    dzdoc:resolutionStatus "resolved" ;
