<https://legal.dz/resource/order/1966-06-08/66-156#art_35_condition_1_c3e7da03> a dznorm:Condition ;
    dznorm:conditionText "إذا كانت العقوبات المحكوم بها من طبيعة واحدة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_35> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_35_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_35> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا صدرت عدة أحكام سالبة للحرية بسبب تعدد المحاكمات فإن العقوبة الأشد وحدها هي التي تنفذ."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_35_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_35> ;
