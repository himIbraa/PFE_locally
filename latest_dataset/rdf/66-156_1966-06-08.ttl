<https://legal.dz/resource/order/1966-06-08/66-156#version_art_269> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من جرح أو ضرب عمدا قاصرا لا تتجاوز سنه السادسة عشرة أو منع عنه عمدا الطعام أو العناية إلى الحد الذي يعرض صحته للضرر، أو ارتكب ضده عمدا أي عمل آخر من أعمال العنف أو التعدي فيما عدا الإيذاء الخفيف، يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 5.000 دج."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_269_19660608_OpEnact_98370f2f6c> ;
