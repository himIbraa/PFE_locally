<https://legal.dz/resource/order/1966-06-08/66-156#art_263> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_263" ;
    dzdoc:fullText "يعاقب على القتل بالإعدام إذا سبق أو صاحب أو تلى جناية أخرى كما يعاقب على القتل بالإعدام إذا كان الغرض منه إما إعداد أو تسهيل أو تنفيذ جنحة أو تسهيل فرار مرتكبي هذه الجنحة أو الشركاء فيها أو ضمان تخلصهم من عقوبتها . ويعاقب القاتل في غير ذلك من الحالات بالسجن المؤبد . وفي جميع الحالات المنصوص عليها في هذه الفقرة يجب القضاء بمصادرة الأسلحة والأشياء والآلات التي استعملت في ارتكاب الجناية . مع حفظ حقوق الغير حسن النية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_263> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_263_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_263_19660608_OpEnact_92b53d3ca8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_263_obligation_0_eb652e5a>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263_obligation_1_d135a259>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263_obligation_2_a710b6e3>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263_obligation_3_3e9d3423> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "263" ;
    dzdoc:position 348 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_263> ;
