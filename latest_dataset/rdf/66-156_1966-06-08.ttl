<https://legal.dz/resource/order/1966-06-08/66-156#art_402_condition_0_ceea9975> a dznorm:Condition ;
    dznorm:conditionText "إذا وضعت الآلة بقصد القتل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_402> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_402_obligation_0_e2c07706> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_402> ;
    dznorm:position 0 ;
    dznorm:provisionText "كل من وضع عمدا آلة متفجرة في طريق عام أو خاص، يعاقب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج."@ar ;
    dznorm:sourceArticle "art_402" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_402_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_402> ;
    dzdoc:position 0 ;
    dzdoc:text "كل من وضع عمدا آلة متفجرة في طريق عام أو خاص، يعاقب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_402_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_402> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أنه إذا وضعت الآلة بقصد القتل، فيعتبر إيداعها شروعا في القتل، ويعاقب عليه بهذه الصفة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_403_condition_0_7d999baa> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1966-06-08/66-156#art_403_condition_0_7d999baa_ref_d3f207c48b9f> ;
