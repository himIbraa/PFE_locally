<https://legal.dz/resource/order/1966-06-08/66-156#version_art_359> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من قلد أو زيف مفاتيح يعاقب بالحبس من ثلاثة أشهر إلى سنتين وبغرامة من 500 إلى 1.500 دج. و إذا كانت مهنة الجاني صناعة المفاتيح فتكون العقوبة الحبس من سنتين إلى خمس سنوات والغرامة من 1.000 إلى 10.000 دج ما لم يكن الفعل عملا من أعمال الاشتراك في جريمة أشد. ويجوز علاوة على ذلك أن يحكم عليها بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 والمنع من الإقامة من سنة على الأقل إلى خمس سنوات على الأكثر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_359_19660608_OpEnact_4f6997c617> ;
    dzdoc:replacementText "كل من قلد أو زيف مفاتيح يعاقب بالحبس من ثلاثة أشهر إلى سنتين وبغرامة من 500 إلى 1.500 دج. و إذا كانت مهنة الجاني صناعة المفاتيح فتكون العقوبة الحبس من سنتين إلى خمس سنوات والغرامة من 1.000 إلى 10.000 دج ما لم يكن الفعل عملا من أعمال الاشتراك في جريمة أشد. ويجوز علاوة على ذلك أن يحكم عليها بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 والمنع من الإقامة من سنة على الأقل إلى خمس سنوات على الأكثر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_359> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
