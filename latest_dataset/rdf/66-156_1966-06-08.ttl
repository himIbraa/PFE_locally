<https://legal.dz/resource/order/1966-06-08/66-156#version_art_31> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المحاولة في الجنحة لا يعاقب عليها إلا بناء على نص صريح في القانون . والمحاولة في المخالفة لا يعاقب عليها إطلاقا."@ar ;
