    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_277> ;
    dznorm:position 0 ;
    dznorm:provisionText "يستفيد مرتكب جرائم القتل والجرح والضرب من الاعذار"@ar ;
    dznorm:sourceArticle "art_277" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_278_condition_0_7ba1dbad> a dznorm:Condition ;
    dznorm:conditionText "إذا ارتكبها لدفع تسلق أو ثقب أسوار أو حيطان أو تحطيم مداخل المنازل أو الأماكن المسكونة أو ملحقاتها إذا حدث ذلك أثناء النهار"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_278> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_278_condition_1_20076fad> a dznorm:Condition ;
    dznorm:conditionText "وإذا حدث ذلك أثناء الليل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_278> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_278_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_278> ;
    dzdoc:position 0 ;
    dzdoc:text "يستفيد مرتكب جرائم القتل والجرح والضرب من الاعذار إذا ارتكبها لدفع تسلق أو ثقب أسوار أو حيطان أو تحطيم مداخل المنازل أو الأماكن المسكونة أو ملحقاتها إذا حدث ذلك أثناء النهار."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_278_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_278> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا حدث ذلك أثناء الليل فتطبق أحكام الفقرة الأولى من المادة 40."@ar .

