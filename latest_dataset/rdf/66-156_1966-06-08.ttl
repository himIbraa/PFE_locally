<https://legal.dz/resource/order/1966-06-08/66-156#art_202> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_1> ;
    dzdoc:eId "art_202" ;
    dzdoc:fullText "صنع أو إصدار أو توزيع أو بيع علامات نقدية بقصد إحلالها محل النقود ذات السعر القانوني أو القيام مقامها معاقب عليه بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 20.000 دينار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_202> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_202_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_202_19660608_OpEnact_5bf5dec769> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_202_obligation_0_b3fcb1e2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "202" ;
    dzdoc:position 285 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_205> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_2> ;
    dzdoc:eId "art_205" ;
    dzdoc:fullText "يعاقب بالسجن المؤبد كل من قلد خاتم الدولة أو استعمل الخاتم المقلد وتطبق الأعذار المعفية المنصوص عليها في المادة 199 على مرتكب الجناية المشار إليها في الفقرة السابقة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_205> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_205_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_205_19660608_OpEnact_af50ffcb19> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_205_obligation_0_0dbca6e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 205" ;
    dzdoc:position 288 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_199> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_199> ;
    dzdoc:usesTerm dzterm:exempting_excuses,
        dzterm:state_seal .

<https://legal.dz/resource/order/1966-06-08/66-156#art_208> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_2> ;
    dzdoc:eId "art_208" ;
    dzdoc:fullText "يعاقب بالحبس من شهر إلى ستة أشهر وبغرامة من 500 إلى 1.000 دينار أو بإحدى هاتين العقوبتين ما لم يكون الفعل جريمة أشد كل من : صنع خاتما أو طابعا أو ختما أو علامة للدولة أو لأية سلطة كانت بغير إذن كتابي من ممثليها المخولين من الدولة أو من تلك السلطة. صنع أو احتفظ أو وزع أو اشترى أو باع طابعا أو خاتما أو علامة أو ختما من المحتمل أن يخلط بينها وبين مثيلاتها الخاصة بالدولة أو بأية سلطة كانت حتى ولو كانت أجنبية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_208> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_208_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_208_19660608_OpEnact_ed37a1a6ac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_208_obligation_0_61e86569> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 208" ;
    dzdoc:position 291 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_212> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_2> ;
    dzdoc:eId "art_212" ;
    dzdoc:fullText "يعاقب بالحبس من شهر إلى ستة أشهر وبغرامة من 500 إلى 2.000 دينار أو بإحدى هاتين العقوبتين كل من : 1 ) صنع أو باع أو روج أو وزع كافة الأشياء أو المطبوعات أو النماذج المتحصل عليها بأية وسيلة كانت والتي تتشابه في شكلها الخارجي مع النقود المعدنية أو الأوراق النقدية ذات السعر القانوني في الجزائر أو في الخارج أو مع سندات القرض الحكومية أو قسائم سداد الضريبة أو طوابع مصلحة البريد أو البرق أو التليفون أو مؤسسات الدولة أو الأوراق أو النماذج المدموغة أو الأسهم أو السندات أو حصص الفوائد أو قسائم الأرباح أو الفوائد المتعلقة بها وعلى العموم جميع الأوراق ذات القيمة المالية التي تصدرها الدولة أو المجموعات أو المؤسسات العمومية وكذلك تلك التي تصدرها الشركات والجمعيات أو المشروعات الخاصة وكان من شأن هذا التشابه تسهيل قبول الأشياء والمطبوعات والنماذج المذكورة بدلا عن الأوراق المتشابهة معها. 2 ) صنع أو باع أو روج أو استعمل مطبوعات تتشابه في حجمها أو لونها أو عباراتها أو شكل طباعتها أو في أية صفة أخرى مع الأوراق المعنونة أو المطبوعات الرسمية المستعملة في الأجهزة الرئيسية للدولة أو في الإدارات العمومية أو في مختلف جهات القضاء وكان من شأن هذا التشابه أن يولد لبسا في نظر الجمهور."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_212> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_212_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_212_19660608_OpEnact_20de0e5888> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_212_obligation_0_bfddeb53> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 212" ;
    dzdoc:position 295 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_218> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_3> ;
    dzdoc:eId "art_218" ;
    dzdoc:fullText "في الحالات المشار إليها في هذا القسم يعاقب بالسجن من خمس إلى عشر سنوات كل من استعمل الورقة التي يعلم أنها مزورة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_218> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_218_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_218_19660608_OpEnact_0eea0ab596> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_218_obligation_0_5ea4cf78> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "218" ;
    dzdoc:position 301 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_226> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_5> ;
    dzdoc:eId "art_226" ;
    dzdoc:fullText "كل طبيب أو جراح أو طبيب أسنان أو ملاحظ صحي أو قابلة قرر كذبا بوجود أو بإخفاء وجود مرض أو عاهة أو حمل أو أعطى بيانات كاذبة عن مصدر مرض أو عاهة أو عن سبب الوفاة وذلك أثناء تأدية أعمال وظيفته وبغرض محاباة أحد الأشخاص يعاقب بالحبس لمدة من سنة إلى ثلاث سنوات ما لم يكون الفعل إحدى الجرائم الأشد المنصوص عليها في المواد 126 إلى 134 . ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 من سنة على الأقل إلى خمس سنوات على الأكثر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_226> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_226_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_226_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_226_19660608_OpEnact_ae7c8d7a3f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 226" ;
    dzdoc:position 309 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_126>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_134>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_126>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_134>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_14> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_228> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_5> ;
    dzdoc:eId "art_228" ;
    dzdoc:fullText "يعاقب بالحبس من ستة أشهر إلى سنتين وبغرامة من 600 إلى 6.000 دينار أو بإحدى هاتين العقوبتين، ما لم يكون الفعل جريمة أشد، كل من: حرر عمدا إقرارا أو شهادة تثبت وقائع غير صحيحة ماديا، زور أو غير بأية طريقة كانت إقرارا أو شهادة صحيحة أصلا، استعمل عمدا إقرارا أو شهادة غير صحيحة أو مزورة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_228> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_228_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_228_19660608_OpEnact_4df32d8037> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_228_obligation_0_bc9de96c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "228" ;
    dzdoc:position 311 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_228_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_5> ;
    dzdoc:eId "art_228_bis" ;
    dzdoc:fullText "يعاقب بالحبس من سنتين (2) إلى عشر (10) سنوات وبغرامة من 10.000 دج إلى 100.000 دج كل من يرتكب بغرض الغش، انحرافات في تنفيذ حسابات وميزانيات الدولة أو إحدى الهيئات المشار إليها في المادة 119 من هذا القانون والتي أسندت إليه إدارتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_228_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_228_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_228_bis_19660608_OpEnact_c858775cd4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_228_bis_obligation_0_df4e7839> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "228 مكرر" ;
    dzdoc:position 312 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_119> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_119> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_229> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_5> ;
    dzdoc:eId "art_229" ;
    dzdoc:fullText "إذا ارتكبت جرائم التزوير المعاقب عليها في هذا القسم إضرارا بالخزينة العمومية أو بالغير فإنه يعاقب عليها وفقا لطبيعتها إما باعتبارها تزويرا في محررات عمومية أو رسمية أو باعتبارها تزويرا في محررات عرفية أو تجارية أو مصرفية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_229> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_229_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_229_19660608_OpEnact_ddef6ce160> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "229" ;
    dzdoc:position 313 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_229_condition_0_5a92fb0d> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_230> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_6> ;
    dzdoc:eId "art_230" ;
    dzdoc:fullText "يوقف تطبيق العقوبات المقررة ضد من يستعمل النقود أو الأوراق أو الأختام أو الطوابع أو المطارق أو الدمغات أو العلامات أو المحررات المزورة أو المقلدة أو المصطنعة أو المزيفة كلما كان التزوير مجهولا من الشخص الذي استعمل الشيء المزور ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_230> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_230_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_230_19660608_OpEnact_c987725d02> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 230" ;
    dzdoc:position 314 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_230_condition_0_61157aba> ;
    dzdoc:usesTerm dzterm:documents,
        dzterm:hallmarks,
        dzterm:hammers,
        dzterm:marks,
        dzterm:money,
        dzterm:papers,
        dzterm:seals,
        dzterm:stamps .

<https://legal.dz/resource/order/1966-06-08/66-156#art_238> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_7> ;
    dzdoc:eId "art_238" ;
    dzdoc:fullText "الخبير المعين من السلطة القضائية الذي يبدي شفاها أو كتابة رأيا كاذبا أو يؤيد وقائع يعلم أنها غير مطابقة للحقيقة وذلك في أية حالة كانت عليها الإجراءات تطبق عليه العقوبات المقررة لشهادة الزور وفقا للتقسيم المنصوص عليه في المواد من 232 إلى 235 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_238> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_238_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_238_19660608_OpEnact_3128f83759> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_238_obligation_0_6f5bace3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "238" ;
    dzdoc:position 322 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_232>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_235> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_232>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_235> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_242> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_8> ;
    dzdoc:eId "art_242" ;
    dzdoc:fullText "كل من تدخل بغير صفة، في الوظائف العمومية ، المدنية أو العسكرية أو قام بعمل من أعمال هذه الوظائف، يعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج، ما لم يكون الفعل جريمة أشد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_242> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_242_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_242_19660608_OpEnact_03985efe60> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_242_obligation_0_141279ce> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 242" ;
    dzdoc:position 326 ;
    dzdoc:usesTerm dzterm:public_functions .

<https://legal.dz/resource/order/1966-06-08/66-156#art_243> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_8> ;
    dzdoc:eId "art_243" ;
    dzdoc:fullText "كل من استعمل لقبا متصلا بمهنة منظمة قانونا أو شهادة رسمية أو صفة حددت السلطة العمومية شروط منحها أو ادعى لنفسه شيئا من ذلك بغير أن يستوفي الشروط المفروضة لحملها يعاقب بالحبس من ثلاثة أشهر إلى سنتين وبغرامة من 500 إلى 5.000 دينار أو بإحدى هاتين العقوبتين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_243> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_243_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_243_19660608_OpEnact_834f495975> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_243_obligation_0_1f999dbf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 243" ;
    dzdoc:position 327 ;
    dzdoc:usesTerm dzterm:public_authority .

<https://legal.dz/resource/order/1966-06-08/66-156#art_244> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_8> ;
    dzdoc:eId "art_244" ;
    dzdoc:fullText "كل من ارتدى بغير حق بزة نظامية أو لباسا مميزا لوظيفة أو صفة أو شارة رسمية أو وساما وطنيا أو أجنبيا يعاقب بالحبس من ثلاثة أشهر إلى سنة وبغرامة من 120 إلى 1.000 دينار أو بإحدى هاتين العقوبتين ما لم يكن الفعل ظرفا مشددا لجريمة أشد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_244> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_244_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_244_19660608_OpEnact_39aaf69059> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_244_obligation_0_d81192b7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 244" ;
    dzdoc:position 328 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_245> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_8> ;
    dzdoc:eId "art_245" ;
    dzdoc:fullText "كل من انتحل لنفسه بصورة عادية أو في عمل رسمي لقبا أو رتبة شرفية يعاقب بالحبس من شهر إلى شهرين وبغرامة من 500 إلى 1.000 دينار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_245> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_245_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_245_19660608_OpEnact_c9255fe8a3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_245_obligation_0_1ae3d627> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 245" ;
    dzdoc:position 329 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_247> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_8> ;
    dzdoc:eId "art_247" ;
    dzdoc:fullText "كل من انتحل لنفسه في محرر عمومي أو رسمي أو في وثيقة إدارية معدة لتقديمها للسلطة العمومية اسم عائلة خلاف اسمه وذلك بغير حق يعاقب بغرامة من 500 إلى 5.000 دينار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_247> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_247_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_247_19660608_OpEnact_ee8727cc6e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_247_obligation_0_9abbdf45> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 247" ;
    dzdoc:position 331 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_254> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:murder ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_254" ;
    dzdoc:fullText "القتل هو إزهاق روح إنسان عمدا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_254> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_254_defocc_043da62348fe> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_254_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_254_19660608_OpEnact_2b78552e1a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "254" ;
    dzdoc:position 339 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_256> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:premeditation ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_256" ;
    dzdoc:fullText "سبق الإصرار هو عقد العزم قبل ارتكاب الفعل على الاعتداء على شخص معين أو حتى على شخص يتصادف وجوده أو مقابلته وحتى لو كانت هذه النية متوقفة على أي ظرف أو شرط كان."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_256> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_256_defocc_364e08e1d613> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_256_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_256_19660608_OpEnact_a46304be23> ;
