<https://legal.dz/resource/order/1966-06-08/66-156#art_459> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_459" ;
    dzdoc:fullText "يعاقب بغرامة من 30 إلى 100 دج ويجوز أن يعاقب أيضا بالحبس لمدة ثلاثة أيام على الأكثر كل من خالف المراسيم أو القرارات المتخذة قانونا من طرف السلطة الإدارية إذا لم تكن الجرائم الواردة بها معاقبا عليها بنصوص خاصة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_459> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_459_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_459_19660608_OpEnact_5a9d331c22> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_459_obligation_0_92d5cabb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 459" ;
    dzdoc:position 648 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_459_condition_0_31a9a841> ;
    dzdoc:usesTerm dzterm:administrative_authority,
