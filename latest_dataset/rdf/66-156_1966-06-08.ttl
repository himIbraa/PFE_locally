<https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_3> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يترتب على عقوبة الحظر من إصدار الشيكات و / أو استعمال بطاقات الدفع إلزام المحكوم عليه بإرجاع الدفاتر والبطاقات التي بحوزته أو التي عند وكلائه إلى المؤسسة المصرفية المصدرة لها . غير أنه لا يطبق هذا الحظر على الشيكات التي تسمح بسحب الأموال من طرف الساحب لدى المسحوب عليه أو تلك المضمنة . لا تتجاوز مدة الحظر عشر (10) سنوات في حالة الإدانة لارتكاب جناية، وخمس (5) سنوات في حالة الإدانة لارتكاب جنحة. ويجوز أن يؤمر بالنفاذ المعجل بالنسبة لهذا الإجراء. يعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_3_19660608_OpEnact_1388d243d2> ;
    dzdoc:replacementText "يترتب على عقوبة الحظر من إصدار الشيكات و / أو استعمال بطاقات الدفع إلزام المحكوم عليه بإرجاع الدفاتر والبطاقات التي بحوزته أو التي عند وكلائه إلى المؤسسة المصرفية المصدرة لها . غير أنه لا يطبق هذا الحظر على الشيكات التي تسمح بسحب الأموال من طرف الساحب لدى المسحوب عليه أو تلك المضمنة . لا تتجاوز مدة الحظر عشر (10) سنوات في حالة الإدانة لارتكاب جناية، وخمس (5) سنوات في حالة الإدانة لارتكاب جنحة. ويجوز أن يؤمر بالنفاذ المعجل بالنسبة لهذا الإجراء. يعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج كل من أصدر شيكا أو أكثر و / أو استعمل بطاقة الدفع رغم منعه من ذلك، دون الإخلال بتطبيق العقوبات المنصوص عليها في المادة 374 من هذا القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_3> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_3> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_4> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "دون الإخلال بالتدابير المنصوص عليها في قانون المرور، يجوز للجهة القضائية الحكم بتعليق أو سحب رخصة السياقة أو إلغائها مع المنع من استصدار رخصة جديدة. لا تزيد مدة التعليق أو السحب عن خمس (5) سنوات من تاريخ صدور حكم الإدانة. يجوز أن يؤمر بالنفاذ المعجل بالنسبة لهذا الإجراء. ويبلغ الحكم إلى السلطة الإدارية المختصة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_4_19660608_OpEnact_8430df484f> ;
    dzdoc:replacementText "دون الإخلال بالتدابير المنصوص عليها في قانون المرور، يجوز للجهة القضائية الحكم بتعليق أو سحب رخصة السياقة أو إلغائها مع المنع من استصدار رخصة جديدة. لا تزيد مدة التعليق أو السحب عن خمس (5) سنوات من تاريخ صدور حكم الإدانة. يجوز أن يؤمر بالنفاذ المعجل بالنسبة لهذا الإجراء. ويبلغ الحكم إلى السلطة الإدارية المختصة ."@ar ;
