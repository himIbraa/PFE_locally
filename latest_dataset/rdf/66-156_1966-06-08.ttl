    dzdoc:referencesTarget <https://legal.dz/resource/order/1966-06-08/66-156#art_300> ;
    dzdoc:sourceEId "art_300" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "ويجب على جهة القضاء المختصة بموجب هذه المادة أن توقف الفصل في الدعوى إذا كانت المتابعة الجزائية المتعلقة بالواقعة موضوع البلاغ مازالت منظورة"@ar ;
    dzdoc:targetEId "art_300" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_300_obligation_0_9e39fce3_role_59328221df> a dznorm:Role ;
    rdfs:label "جهة القضاء المختصة بموجب"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "ويجب على جهة القضاء المختصة بموجب هذه المادة أن توقف الفصل في الدعوى إذا كانت المتابعة الجزائية المتعلقة بالواقعة موضوع البلاغ مازالت منظورة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_300> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_300_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_300> ;
    dzdoc:position 0 ;
    dzdoc:text "كل من أبلغ بأية طريقة كانت رجال الضبط القضائي أو الشرطة الإدارية أو القضائية بوشاية كاذبة ضد فرد أو أكثر أو أبلغها إلى سلطات مخول لها أن تتابعها أو أن تقدمها إلى السلطة المختصة أو إلى رؤساء الموشى به أو إلى مخدوميه طبقا للتدرج الوظيفي أو إلى مستخدميه يعاقب بالحبس من ستة أشهر إلى خمس سنوات وبغرامة من 500 إلى 15.000 دينار ويجوز للقضاء علاوة على ذلك أن يأمر بنشر الحكم أو ملخص منه في جريدة أو أكثر على نفقة المحكوم عليه."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_300_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_300> ;
    dzdoc:position 1 ;
    dzdoc:text "إذا كانت الواقعة المبلغ عنها معاقبا عليها بعقوبة جزائية أو تأديبية فيجوز اتخاذ إجراءات المتابعة الجزائية بمقتضى هذه المادة عن جريمة الوشاية الكاذبة سواء بعد صدور الحكم بالبراءة أو بالإفراج أو بعد الأمر أو القرار بأن لا وجه للمتابعة أو بعد حفظ البلاغ من القاضي أو الموظف أو السلطة الأعلى أو المخدوم المختص بالتصرف في الإجراءات التي كان يحتمل أن تتخذ بشأن هذا البلاغ."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_300_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_300> ;
    dzdoc:position 2 ;
    dzdoc:text "ويجب على جهة القضاء المختصة بموجب هذه المادة أن توقف الفصل في الدعوى إذا كانت المتابعة الجزائية المتعلقة بالواقعة موضوع البلاغ مازالت منظورة ."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_301_obligation_0_5008b180> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_301> ;
    dznorm:position 0 ;
    dznorm:provisionText "يوجب عليهم فيها القانون إفشاءها ويصرح لهم بذلك"@ar ;
    dznorm:sourceArticle "art_301" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_301_obligation_1_4a42e6d2> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
