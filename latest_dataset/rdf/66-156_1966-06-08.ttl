<https://legal.dz/resource/order/1966-06-08/66-156#version_art_234> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من شهد زورا في مواد المخالفات سواء ضد المتهم أو لصالحه يعاقب بالحبس من سنة على الأقل إلى ثلاث سنوات على الأكثر وبغرامة من 500 إلى 1.800 دينار. وإذا قبض شاهد الزور نقودا أو أية مكافأة كانت أو تلقى وعودا فتكون العقوبة هي الحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 7.500 دينار."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_234_19660608_OpEnact_7858d27a2e> ;
    dzdoc:replacementText "كل من شهد زورا في مواد المخالفات سواء ضد المتهم أو لصالحه يعاقب بالحبس من سنة على الأقل إلى ثلاث سنوات على الأكثر وبغرامة من 500 إلى 1.800 دينار. وإذا قبض شاهد الزور نقودا أو أية مكافأة كانت أو تلقى وعودا فتكون العقوبة هي الحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 7.500 دينار."@ar ;
