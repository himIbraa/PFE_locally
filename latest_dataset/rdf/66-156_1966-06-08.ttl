<https://legal.dz/resource/order/1966-06-08/66-156#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#body> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "لا جريمة ولا عقوبة أو تدابير أمن بغير قانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_1_19660608_OpEnact_61ed16a99c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_1_obligation_0_e23cd9a5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة الأولى" ;
    dzdoc:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_115> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_3_subsec_3> ;
    dzdoc:eId "art_115" ;
    dzdoc:fullText "القضاة و الموظفون العموميون الذين يقررون بعد التشاور فيما بينهم تقديم استقالتهم بغرض منع أو وقف قيام القضاء بمهمته أو سير مصلحة عمومية يعاقبون بالحبس من ستة أشهر إلى ثلاث سنوات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_115> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_115_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_115_19660608_OpEnact_95a313af79> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 115" ;
    dzdoc:position 173 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_115_condition_0_0c83d985> ;
    dzdoc:usesTerm dzterm:judges,
        dzterm:public_officials .

<https://legal.dz/resource/order/1966-06-08/66-156#art_117> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_3_subsec_4> ;
    dzdoc:eId "art_117" ;
    dzdoc:fullText "يعاقب بالسجن المؤقت من خمس إلى عشر سنوات، الولاة و رؤساء الدوائر و رؤساء المجالس الشعبية البلدية وغيرهم من رجال الإدارة الذين يتدخلون في أعمال الوظيفة التشريعية وفقا لما هو مقرر في الفقرة الأولى من المادة 116 أو الذين يتخذون قرارات عامة أو تدابير ترمي إلى إصدار أية أوامر أو نواه إلى المحاكم أو إلى المجالس ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_117> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_117_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_117_19660608_OpEnact_901816c00f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_117_obligation_0_877e17aa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "117" ;
    dzdoc:position 175 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_116> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_116> ;
    dzdoc:usesTerm dzterm:apc_presidents,
        dzterm:district_heads,
        dzterm:walis .

<https://legal.dz/resource/order/1966-06-08/66-156#art_132> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_132" ;
    dzdoc:fullText "القاضي أو رجل الإدارة الذي يتحيز لصالح أحد الأطراف أو ضده يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 1.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_132> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_132_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_132_19660608_OpEnact_6b7c5fc223> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "132" ;
    dzdoc:position 195 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_132_condition_0_38a09648> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_135> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_135" ;
    dzdoc:fullText "كل موظف في السلك الإداري أو القضائي وكل ضابط شرطة وكل قائد أو أحد رجال القوة العمومية دخل بصفته المذكورة منزل أحد المواطنين بغير رضاه، وفي غير الحالات المقررة في القانون وبغير الإجراءات المنصوص عليها فيه يعاقب بالحبس من شهرين إلى سنة وبغرامة من 500 إلى 3.000 دج دون الإخلال بتطبيق المادة 107 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_135> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_135_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_135_19660608_OpEnact_c539f4b928> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_135_obligation_0_806f603b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "135" ;
    dzdoc:position 198 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_107> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_107> ;
    dzdoc:usesTerm dzterm:commander,
        dzterm:official,
        dzterm:police_officer,
        dzterm:public_force .

<https://legal.dz/resource/order/1966-06-08/66-156#art_138_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_138_bis" ;
    dzdoc:fullText "كل موظف عمومي استعمل سلطة وظيفته لوقف تنفيذ حكم قضائي أو امتنع أو اعترض أو عرقل عمدا تنفيذه يعاقب بالحبس من ستة أشهر (6) إلى ثلاث (3) سنوات وبغرامة من 5.000 دج إلى 50.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_138_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_138_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_138_bis_19660608_OpEnact_e864e89742> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_138_bis_obligation_0_32a06e59> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "138 مكرر" ;
    dzdoc:position 203 ;
    dzdoc:usesTerm dzterm:public_official .

<https://legal.dz/resource/order/1966-06-08/66-156#art_140> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_140" ;
    dzdoc:fullText "إذا كانت الأوامر أو الطلبات هي السبب المباشر لوقوع فعل يصفه القانون بأنه جناية فإن العقوبة المقررة لهذه الجناية تطبق على مرتكب جريمة استغلال النفوذ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_140> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_140_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_140_19660608_OpEnact_8673a58058> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "140" ;
    dzdoc:position 205 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_140_condition_0_cada62b5> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_145> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:insult ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_145" ;
    dzdoc:fullText "تعتبر إهانة ويعاقب عليها على هذا الاعتبار قيام أحد الأشخاص بتبليغ السلطات العمومية بجريمة يعلم بعدم وقوعها أو تقديمه دليلا كاذبا متعلقا بجريمة وهمية أو تقريره أمام السلطة القضائية بأنه مرتكب جريمة لم يرتكبها أو لم يشترك في ارتكابها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_145> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_145_defocc_4970fea15314> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_145_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_145_19660608_OpEnact_9553791291> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "145" ;
    dzdoc:position 213 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_3> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "يعاقب الحارس بالحبس لمدة من شهر إلى ستة شهور إذا وقع الكسر نتيجة إهماله ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_157_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_157_19660608_OpEnact_a96df84297> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 157" ;
    dzdoc:position 225 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_157_condition_0_5d36c6e8> ;
    dzdoc:usesTerm dzterm:guardian .

<https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:good_faith_third_party ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_1_sec_3> ;
    dzdoc:eId "art_15_bis_2" ;
    dzdoc:fullText "يعتبر من الغير حسن النية، الأشخاص الذين لم يكونوا شخصيا محل متابعة أو إدانة من أجل الوقائع التي أدت إلى المصادرة، ولديهم سند ملكية أو حيازة صحيح ومشروع على الأشياء القابلة للمصادرة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_15_bis_2> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_2_defocc_c4a3256baefb> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_15_bis_2_19660608_OpEnact_c5d68152bb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "15 مكرر 2" ;
    dzdoc:position 26 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_160> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_4> ;
    dzdoc:eId "art_160" ;
    dzdoc:fullText "يعاقب بالحبس من خمس سنوات إلى عشر سنوات كل من قام عمدا وعلانية بتخريب، أو تشويه، أو إتلاف، أو تدنيس المصحف الشريف ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_160> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_160_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_160_19660608_OpEnact_53b47fd734> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_160_obligation_0_229e4625> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 160" ;
    dzdoc:position 228 ;
    dzdoc:usesTerm dzterm:mushaf .

<https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_4> ;
    dzdoc:eId "art_160_bis" ;
    dzdoc:fullText "يعاقب بالسجن من خمس إلى عشر سنوات ، كل من قام عمدا وعلانية بتمزيق، أو تشويه، أو تدنيس العلم الوطني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_160_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_160_bis_19660608_OpEnact_14463aed5a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_obligation_0_9ae871fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 160 مكرر" ;
    dzdoc:position 229 ;
    dzdoc:usesTerm dzterm:national_flag .

<https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_4> ;
    dzdoc:eId "art_160_bis_3" ;
    dzdoc:fullText "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 1.000 إلى 10.000 دج كل من قام عمدا بتخريب أو هدم أو تدنيس الأماكن المعدة للعبادة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_160_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_160_bis_3_19660608_OpEnact_e9685e0495> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_3_obligation_0_499ca9ba> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 160 مكرر 3" ;
    dzdoc:position 230 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_4> ;
    dzdoc:eId "art_160_bis_4" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى خمس سنوات وبغرامة من 500 إلى 2.000 دج كل من قام عمدا بإتلاف أو هدم أو تشويه أو تخريب : نصب أو تماثيل أو لوحات أو أشياء أخرى مخصصة للمنفعة العمومية أو تزيين الأماكن العمومية ومقامة أو منصوبة من طرف السلطة العمومية أو بواسطة ترخيص منها. نصب أو تماثيل أو لوحات أو أية أشياء فنية موضوعة في المتاحف أو في المباني المفتوحة للجمهور."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_160_bis_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_160_bis_4_19660608_OpEnact_cabc1e0968> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_4_obligation_0_5f6a954f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 160 مكرر 4" ;
    dzdoc:position 231 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_162> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_5> ;
    dzdoc:eId "art_162" ;
    dzdoc:fullText "إذا وقع تأخير في التسليم أو في الأعمال بسبب الإهمال دون التخلف عن القيام بالخدمات فيعاقب الفاعلون بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة لا تجاوز ربع التعويضات المدنية ولا تقل عن 500 دينار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_162> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_162_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_162_19660608_OpEnact_c5288c6b6c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "162" ;
    dzdoc:position 237 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_162_condition_0_ef175f5f> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_167> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:lottery_acts ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_6> ;
    dzdoc:eId "art_167" ;
    dzdoc:fullText "تعتبر من أعمال النصيب العمليات المعروضة على الجمهور تحت أية تسمية مهما كانت والمعدة لإيجاد الأمل في الربح عن طريق الحظ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_167> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_167_defocc_44af9b6a06a9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_167_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_167_19660608_OpEnact_47a707cc0b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "167" ;
    dzdoc:position 242 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_1_sec_3> ;
    dzdoc:eId "art_16_bis_6" ;
    dzdoc:fullText "يعاقب بالحبس من ثلاثة (3) أشهر إلى ثلاث (3) سنوات وبغرامة من 25.000 دج إلى 300.000 دج كل محكوم عليه خرق الالتزامات المفروضة عليه بموجب العقوبات التكميلية المنصوص عليها في المواد 9 مكرر 1 و 16 مكرر و 16 مكرر 1 و 16 مكرر 2 و 16 مكرر 4 و 16 مكرر 5 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_6_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_6_19660608_OpEnact_48fb237357> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_6_obligation_0_6f22ffde> ;
