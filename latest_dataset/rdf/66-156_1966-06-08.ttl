    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجوز أن تصل مدة الحبس إلى عشر سنوات والغرامة إلى 200.000 دينار إذا وقعت خيانة الأمانة: من شخص لجأ إلى الجمهور للحصول لحسابه الخاص أو بوصفه مديرا أو مسيرا أو مندوبا عن شركة أو مشروع تجاري أو صناعي على أموال أو أوراق مالية على سبيل الوديعة أو الوكالة أو الرهن. من سمسار أو وسيط أو مستشار مهني أو محرر عقود وتعلق الأمر بثمن بيع عقار أو أموال تجارية أو بقيمة الاكتتاب في أسهم أو حصص لشركات عقارية أو بثمن شرائها أو بيعها أو بثمن حوالة إيجار إذا كانت مثل هذه الحوالة مصرحا بها قانونا."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_378> .

