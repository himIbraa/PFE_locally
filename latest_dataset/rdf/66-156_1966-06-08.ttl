<https://legal.dz/resource/order/1966-06-08/66-156#version_art_387> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من أخفى عمدا أشياء مختلسة أو مبددة أو متحصلة من جناية أو جنحة في مجموعها أو في جزء منها يعاقب بالحبس من سنة على الأقل إلى خمس سنوات على الأكثر وبغرامة من 500 إلى 20.000 دينار. ويجوز أو تجاوز الغرامة 20.000 دينار حتى تصل إلى ضعف قيمة الأشياء المخفاة. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 من هذا القانون لمدة سنة على الأقل وخمس سنوات على الأكثر. وكل ذلك مع عدم الإخلال بأية عقوبات أشد إذا اقتضى الأمر في حالة الاشتراك في الجناية طبقا للمواد 42"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_387_19660608_OpEnact_3d47d290ff> ;
    dzdoc:replacementText "كل من أخفى عمدا أشياء مختلسة أو مبددة أو متحصلة من جناية أو جنحة في مجموعها أو في جزء منها يعاقب بالحبس من سنة على الأقل إلى خمس سنوات على الأكثر وبغرامة من 500 إلى 20.000 دينار. ويجوز أو تجاوز الغرامة 20.000 دينار حتى تصل إلى ضعف قيمة الأشياء المخفاة. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 من هذا القانون لمدة سنة على الأقل وخمس سنوات على الأكثر. وكل ذلك مع عدم الإخلال بأية عقوبات أشد إذا اقتضى الأمر في حالة الاشتراك في الجناية طبقا للمواد 42 و 43 و 44 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_387> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_387> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_388> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة ما إذا كانت العقوبة المطبقة على الفعل الذي تحصلت عنه الأشياء المخفاة هي عقوبة جناية يعاقب المخفي بالعقوبة التي يقررها القانون للجناية وللظروف التي كان يعلم بها وقت الإخفاء . ومع ذلك فإن عقوبة الإعدام تستبدل بالنسبة للمخفي بعقوبة السجن المؤبد. ويجوز دائما الحكم بالغرامة المنصوص عليها في المادة 387 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
