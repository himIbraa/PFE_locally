<https://legal.dz/resource/order/1966-06-08/66-156#art_380_condition_0_b62b6bd0> a dznorm:Condition ;
    dznorm:conditionText "إذا كان المجني عليه موضوعا تحت رعاية الجاني أو رقابته أو سلطته"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_380> ;
