<https://legal.dz/resource/order/1966-06-08/66-156#version_art_197> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن المؤبد كل من قلد أو زور أو زيف : 1 - نقودا معدنية أو أوراقا نقدية ذات سعر قانوني في الإقليم الوطني أو في الخارج، 2- سندات أو أذونات أو أسهم تصدرها الخزينة العمومية وتحمل طابعها أو علامتها أو قسائم الأرباح العائدة من هذه السندات أو الأذونات أو الأسهم. وإذا كانت قيمة هذه النقود أو السندات أو الأذونات أو الأسهم المتداولة تقل عن 500.000 دج ، تكون العقوبة السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة والغرامة من 1.000.000 دج إلى 2.000.000 دج . تطبق أحكام المادة 60 مكرر على الجناية ال"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_197_19660608_OpEnact_a0d8b6ac3f> ;
    dzdoc:replacementText "يعاقب بالسجن المؤبد كل من قلد أو زور أو زيف : 1 - نقودا معدنية أو أوراقا نقدية ذات سعر قانوني في الإقليم الوطني أو في الخارج، 2- سندات أو أذونات أو أسهم تصدرها الخزينة العمومية وتحمل طابعها أو علامتها أو قسائم الأرباح العائدة من هذه السندات أو الأذونات أو الأسهم. وإذا كانت قيمة هذه النقود أو السندات أو الأذونات أو الأسهم المتداولة تقل عن 500.000 دج ، تكون العقوبة السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة والغرامة من 1.000.000 دج إلى 2.000.000 دج . تطبق أحكام المادة 60 مكرر على الجناية المنصوص عليها في هذه المادة."@ar ;
