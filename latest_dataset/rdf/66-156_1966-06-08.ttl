<https://legal.dz/resource/order/1966-06-08/66-156#version_art_365> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في جميع الحالات المنصوص عليها في المادة 364 يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 1.000 إلى 10.000 دج كل من أخفى عمدا الأشياء المبددة . وتطبق العقوبة ذاتها على زوج أو أصول أو فروع المحجوز عليه أو المدين أو المقترض أو الراهن الذين ساعدوه على الإتلاف أو التبديد أو على الشروع في إتلاف أو تبديد هذه الأشياء. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من كافة الحقوق الواردة في المادة 14 أو من بعضها وبالمنع من الإقامة لمدة سنة على الأقل وخمس سنوات على الأكثر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_365_19660608_OpEnact_65c6277e39> ;
    dzdoc:replacementText "في جميع الحالات المنصوص عليها في المادة 364 يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 1.000 إلى 10.000 دج كل من أخفى عمدا الأشياء المبددة . وتطبق العقوبة ذاتها على زوج أو أصول أو فروع المحجوز عليه أو المدين أو المقترض أو الراهن الذين ساعدوه على الإتلاف أو التبديد أو على الشروع في إتلاف أو تبديد هذه الأشياء. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من كافة الحقوق الواردة في المادة 14 أو من بعضها وبالمنع من الإقامة لمدة سنة على الأقل وخمس سنوات على الأكثر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_365> ;
