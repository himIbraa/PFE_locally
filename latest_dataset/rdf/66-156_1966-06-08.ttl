    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_344> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_344_condition_8_33adde75> a dznorm:Condition ;
    dznorm:conditionText "إذا ارتكبت الجنحة من عدة فاعلين أو شركاء."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_344> ;
    dznorm:position 8 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_344_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_344> ;
    dzdoc:position 0 ;
    dzdoc:text "ترفع العقوبات المقررة في المادة 343 إلى الحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 20.000 دج إلى 200.000 دج في الحالات الآتية : إذا ارتكبت الجنحة ضد قاصر لم يكمل الثامنة عشرة (18) سنة. إذا صحب الجنحة تهديد أو إكراه أو عنف أو اعتداء أو إساءة استعمال السلطة أو الغش. إذا كان مرتكب الجنحة يحمل سلاحا ظاهرا أو مخبأ. إذا كان مرتكب الجنحة زوجا أو أبا أو أما أو وصيا على المجني عليه أو يدخل في إحدى الفئات التي عددتها المادة 337. إذا كان مرتكب الجنحة ممن يساهمون بحكم وظيفتهم في مكافحة الدعارة أو في حماية الصحة أو الشبيبة أو صيانة النظام العمومي. إذا ارتكبت الجنحة ضد عدة أشخاص. إذا كان المجني عليهم في الجنحة قد حملوا أو حرضوا على احتراف الدعارة خارج الأرض الجزائرية. إذا كان المجني عليهم بالجنحة قد حملوا أو حرضوا على احتراف الدعارة عقب وصولهم إلى الأرض الجزائرية أو بعد وصولهم إليها بفترة قريبة. إذا ارتكبت الجنحة من عدة فاعلين أو شركاء."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_344_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_344> ;
    dzdoc:position 1 ;
    dzdoc:text "ويعاقب على الشروع في ارتكاب الجنح المشار إليها في هذه المادة بالعقوبات ذاتها المنصوص عليها بالنسبة لتلك الجنح."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_345_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_345> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق العقوبات المنصوص عليها في المواد من 342 إلى 344 حتى ولو كانت بعض الأفعال المكونة لعناصر الجريمة قد وقعت خارج أراضي الجمهورية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_346_obligation_0_2a388cc6> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
