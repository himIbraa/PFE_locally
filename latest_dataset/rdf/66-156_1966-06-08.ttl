<https://legal.dz/resource/order/1966-06-08/66-156#version_art_266> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وقع الجرح أو الضرب أو غير ذلك من أعمال العنف أو الاعتداءات الأخرى مع سبق الإصرار أو الترصد أو مع حمل أسلحة ولم يؤد إلى مرض أو عجز كلي عن العمل لمدة تتجاوز خمسة عشر (15) يوما ، فيعاقب الجاني بالحبس من سنتين (2) إلى عشر (10) سنوات وبغرامة من 200.000 دج إلى 1.000.000دج . ويمكن مصادرة الأشياء التي استعملت أو قد تستعمل لتنفيذ الجريمة مع مراعاة حقوق الغير حسن النية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_266_19660608_OpEnact_c3555672a2> ;
    dzdoc:replacementText "إذا وقع الجرح أو الضرب أو غير ذلك من أعمال العنف أو الاعتداءات الأخرى مع سبق الإصرار أو الترصد أو مع حمل أسلحة ولم يؤد إلى مرض أو عجز كلي عن العمل لمدة تتجاوز خمسة عشر (15) يوما ، فيعاقب الجاني بالحبس من سنتين (2) إلى عشر (10) سنوات وبغرامة من 200.000 دج إلى 1.000.000دج . ويمكن مصادرة الأشياء التي استعملت أو قد تستعمل لتنفيذ الجريمة مع مراعاة حقوق الغير حسن النية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
