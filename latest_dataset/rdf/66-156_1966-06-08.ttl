<https://legal.dz/resource/order/1966-06-08/66-156#version_art_165> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من فتح بغير ترخيص محلا لألعاب الحظ وسمح بحرية دخول الجمهور فيه أو بدخولهم بناء على تقديم الأعضاء المشتركين فيه أو الداعين إلى دخوله أو الأشخاص الذين لهم مصالح في استغلاله يعاقب بالحبس من ثلاثة أشهر إلى سنة وبغرامة من 500 إلى 20.000 دينار. والحال كذلك بالنسبة لصيارفة ومديري ومندوبي ومستخدمي هذا المحل. ويجوز علاوة على ذلك معاقبة الجناة بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة من سنة إلى خمس سنوات. ويجب أن يقضى بمصادرة الأموال والأشياء المعروضة للمقامرة عليها وتلك"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_165_19660608_OpEnact_07e7f56706> ;
    dzdoc:replacementText "كل من فتح بغير ترخيص محلا لألعاب الحظ وسمح بحرية دخول الجمهور فيه أو بدخولهم بناء على تقديم الأعضاء المشتركين فيه أو الداعين إلى دخوله أو الأشخاص الذين لهم مصالح في استغلاله يعاقب بالحبس من ثلاثة أشهر إلى سنة وبغرامة من 500 إلى 20.000 دينار. والحال كذلك بالنسبة لصيارفة ومديري ومندوبي ومستخدمي هذا المحل. ويجوز علاوة على ذلك معاقبة الجناة بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة من سنة إلى خمس سنوات. ويجب أن يقضى بمصادرة الأموال والأشياء المعروضة للمقامرة عليها وتلك التي تضبط في خزينة المحل أو التي توجد مع القائمين على إدارته ومستخدميهم وكذلك الأثاث والأشياء المفروشة بها هذه الأماكن أو التي تزينها والأدوات المعدة أو المستعملة في اللعب."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_165> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_165> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_166> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تطبق العقوبات وتدابير الأمن المقررة في المادة 165 على الفاعلين والمنظمين والمديرين والمندوبين والمستخدمين الذين يقومون بأعمال النصيب غير المصرح بها. وتستبدل مصادرة العقار موضوع النصيب بالغرامة التي يجوز أن تصل إلى القيمة التقديرية لهذا العقار."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_166_19660608_OpEnact_d11c90d6f3> ;
