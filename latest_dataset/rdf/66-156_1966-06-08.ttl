<https://legal.dz/resource/order/1966-06-08/66-156#version_art_443> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من عشرة أيام على الأقل إلى شهرين على الأكثر وبغرامة من 100 إلى 1.000 دج أو بإحدى العقوبتين : كل من قتل دون مقتضى، وفي أي مكان دوابا للجر أو الركوب أو الحمل أو مواش ذات قرون أو خرافا أو ماعزا أو أية دابة أخرى أو كلابا للحراسة أو أسماك موجودة في البرك أو الأحواض أو الخزانات ، كل من قتل دون مقتضى حيوانا مستأنسا في مكان يملكه أو يستأجره أو يزرعه مالك الحيوان المقتول ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
