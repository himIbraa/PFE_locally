    dzdoc:sourceEId "art_18_bis_2" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "عندما لا ينص القانون على عقوبة الغرامة بالنسبة للأشخاص الطبيعيين سواء في الجنايات أو الجنح، وقامت المسؤولية الجزائية للشخص المعنوي طبقا لأحكام المادة 51 مكرر"@ar ;
    dzdoc:targetEId "art_51_bis" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2_condition_0_533ae1a2_role_7c26ef90f9> a dznorm:Role ;
    rdfs:label "عقوبة الغرامة بالنسبة للأشخاص"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "عندما لا ينص القانون على عقوبة الغرامة بالنسبة للأشخاص الطبيعيين سواء في الجنايات أو الجنح، وقامت المسؤولية الجزائية للشخص المعنوي طبقا لأحكام المادة 51 مكرر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما لا ينص القانون على عقوبة الغرامة بالنسبة للأشخاص الطبيعيين سواء في الجنايات أو الجنح، وقامت المسؤولية الجزائية للشخص المعنوي طبقا لأحكام المادة 51 مكرر، فإن الحد الأقصى للغرامة المحتسب لتطبيق النسبة القانونية المقررة للعقوبة فيما يخص الشخص المعنوي يكون كالآتي : 2.000.000 دج عندما تكون الجناية معاقبا عليها بالإعدام أو بالسجن المؤبد، 1.000.000 دج عندما تكون الجناية معاقبا عليها بالسجن المؤقت، 500.000 دج بالنسبة للجنحة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_3_condition_0_8c070d5d> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_3_condition_0_8c070d5d_ref_8cab0b28a2a3> ;
