<https://legal.dz/resource/order/1966-06-08/66-156#art_308> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_308" ;
    dzdoc:fullText "لا عقوبة على الإجهاض إذا استوجبته ضرورة إنقاذ حياة الأم من الخطر متى أجراه طبيب أو جراح في غير خفاء وبعد إبلاغه السلطة الإدارية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_308> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_308_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_308_19660608_OpEnact_52c2c30b29> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 308" ;
    dzdoc:position 446 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_308_condition_0_0d7cfe90> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_309> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_309" ;
    dzdoc:fullText "تعاقب بالحبس من ستة أشهر إلى سنتين وبغرامة من 250 إلى 1.000 دينار المرأة التي أجهضت نفسها عمدا أو حاولت ذلك أو وافقت على استعمال الطرق التي أرشدت إليها أو أعطيت لها لهذا الغرض."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_309> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_309_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_309_19660608_OpEnact_ba9f307237> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_309_obligation_0_35988338> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 309" ;
    dzdoc:position 447 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_310> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_310" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى ثلاثة سنوات وبغرامة من 500 إلى 10.000 دج أو بإحدى هاتين العقوبتين كل من حرض على الإجهاض ولو لم يؤدي تحريضه إلى نتيجة ما وذلك بأن : ألقى خطبا في أماكن أو اجتماعات عمومية، أو باع أو طرح للبيع أو قدم ولو في غير علانية أو عرض أو ألصق أو وزع في الطريق العمومي أو في الأماكن العمومية أو وزع في المنازل كتبا أو كتابات أو مطبوعات أو إعلانات أو ملصقات أو رسوما أو صورا رمزية أو سلم شيئا من ذلك مغلفا بشرائط موضوعا في ظروف مغلقة أو مفتوحة إلى البريد أو إلى أي عامل توزيع أو نقل، أو قام بالدعاية في العيادات الطبية الحقيقية أو المزعومة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_310> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_310_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_310_19660608_OpEnact_01b4258155> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_310_obligation_0_5a65bf6d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 310" ;
    dzdoc:position 448 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_32> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_32" ;
    dzdoc:fullText "يجب أن يوصف الفعل الواحد الذي يحتمل عدة أوصاف بالوصف الأشد من بينها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_32> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_32_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_32_19660608_OpEnact_f8ba2236b1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_32_obligation_0_a65e4c34> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 32" ;
    dzdoc:position 54 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_338> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_6> ;
    dzdoc:eId "art_338" ;
    dzdoc:fullText "كل من ارتكب فعلا من أفعال الشذوذ الجنسي على شخص من نفس جنسه يعاقب بالحبس من شهرين إلى سنتين وبغرامة من 500 إلى 2.000 دينار. وإذا كان أحد الجناة قاصرا لم يكمل الثامنة عشرة فيجوز أن تزاد عقوبة البالغ إلى الحبس لمدة ثلاث سنوات وإلى غرامة 10.000 دينار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_338> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_338_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_338_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_338_19660608_OpEnact_02e5267be0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "338" ;
    dzdoc:position 482 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_338_condition_0_739a80ee> ;
    dzdoc:usesTerm dzterm:homosexuality .

