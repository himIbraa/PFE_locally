    dznorm:sourceArticle "art_388" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_388_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_388> ;
    dzdoc:position 0 ;
    dzdoc:text "في حالة ما إذا كانت العقوبة المطبقة على الفعل الذي تحصلت عنه الأشياء المخفاة هي عقوبة جناية يعاقب المخفي بالعقوبة التي يقررها القانون للجناية وللظروف التي كان يعلم بها وقت الإخفاء. ومع ذلك فإن عقوبة الإعدام تستبدل بالنسبة للمخفي بعقوبة السجن المؤبد."@ar .

