    dzdoc:position 0 ;
    dzdoc:text "تطبق أحكام المادة 60 مكرر المتعلقة بالفترة الأمنية على الجرائم المنصوص عليها في هذا القسم."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_2_obligation_0_c5dcad83> a dznorm:Obligation ;
