<https://legal.dz/resource/order/1966-06-08/66-156#art_434_obligation_0_bca96c1c_ref_dd0833f0f791> a dzdoc:Reference ;
    rdfs:label "المواد السابقة"@ar ;
    dzdoc:frbrUri "#art_429"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1966-06-08/66-156#art_429> ;
    dzdoc:sourceEId "art_434" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يعاقب بأقصى العقوبات المنصوص عليها في المواد السابقة"@ar ;
    dzdoc:targetEId "art_429" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_434_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_434> ;
    dzdoc:position 0 ;
    dzdoc:text """يعاقب بأقصى العقوبات المنصوص عليها في المواد السابقة :
            
            
            1 - كل متصرف أو محاسب يكون قد قام بالغش أو عمل على غش مواد أو أشياء أو مواد غذائية أو سوائل عهدت إليه قصد حراستها أو موضوعة تحت مراقبته أو يكون قد وزع عمدا أو عمل على توزيع المواد المذكورة أو الأشياء أو المواد الغذائية أو السوائل المغشوشة،
            
            
            2 - كل متصرف أو محاسب يكون قد وزع عمدا أو عمل على توزيع لحوم حيوانات مصابة بأمراض معدية أو أشياء أو مواد غذائية أو سوائل فاسدة أو متلفة. 1 - كل متصرف أو محاسب يكون قد قام بالغش أو عمل على غش مواد أو أشياء أو مواد غذائية أو سوائل عهدت إليه قصد حراستها أو موضوعة تحت مراقبته أو يكون قد وزع عمدا أو عمل على توزيع المواد المذكورة أو الأشياء أو المواد الغذائية أو السوائل المغشوشة، 2 - كل متصرف أو محاسب يكون قد وزع عمدا أو عمل على توزيع لحوم حيوانات مصابة بأمراض معدية أو أشياء أو مواد غذائية أو سوائل فاسدة أو متلفة."""@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_435_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_435_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "يكون الشخص المعنوي مسؤولا جزائيا عن الجرائم المعرفة في هذا الباب، وذلك طبقا للشروط المنصوص عليها في المادة 51 مكرر من هذا القانون."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_435_bis_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_435_bis> ;
    dzdoc:position 1 ;
    dzdoc:text "تطبق على الشخص المعنوي عقوبة الغرامة، حسب الكيفيات المنصوص عليها في المادة 18 مكرر، وفي المادة 18 مكرر 2 عند الاقتضاء."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_435_bis_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_435_bis> ;
    dzdoc:position 2 ;
    dzdoc:text "ويتعرض أيضا إلى واحدة أو أكثر من العقوبات التكميلية المنصوص عليها في المادة 18 مكرر."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_435_obligation_0_0513be7a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_435> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من شهرين إلى سنتين وبغرامة من 2.000 إلى 20.000 دج"@ar ;
