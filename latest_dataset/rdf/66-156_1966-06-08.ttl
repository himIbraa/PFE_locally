<https://legal.dz/resource/order/1966-06-08/66-156#art_464> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_2_sec_3_subsec_5> ;
    dzdoc:eId "art_464" ;
    dzdoc:fullText "يعاقب بغرامة من 30 إلى 100 دج ويجوز أن يعاقب أيضا بالحبس لمدة ثلاثة أيام على الأكثر : 1 - كل من قطف وأكل ثمارا مملوكة للغير في مكان وجودها ذاته. 2 - كل من جمع بقايا المحاصيل سواء بيده أو بآلة زراعية من حقل لم تحصد محاصله أو لم ترفع منه بكاملها أو قام بجني بقايا الكروم منه. 3 - كل من وضع أو ترك مواد أو أية أشياء أخرى في مجاري أو عيون مياه من شأنها أن تعوقها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_464> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_464_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_464_19660608_OpEnact_664a1017d5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_464_obligation_0_e96c7ba2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 464" ;
    dzdoc:position 653 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_54_bis_3" ;
    dzdoc:fullText "إذا سبق الحكم نهائيا على شخص طبيعي من أجل جنحة، وارتكب خلال الخمس (5) سنوات التالية لقضاء العقوبة السابقة نفس الجنحة أو جنحة مماثلة بمفهوم قواعد العود ، فإن الحد الأقصى لعقوبة الحبس والغرامة المقررة لهذه الجنحة يرفع وجوبا إلى الضعف ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis_3_19660608_OpEnact_a08049bc02> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_3_obligation_0_10269bdb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "54 مكرر 3" ;
    dzdoc:position 90 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_3_condition_0_9f841417> ;
    dzdoc:usesTerm dzterm:person,
        dzterm:recidivism_rules .

<https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_54_bis_4" ;
    dzdoc:fullText "إذا سبق الحكم نهائيا على شخص طبيعي من أجل مخالفة، وارتكب خلال السنة التالية لقضاء العقوبة السابقة نفس المخالفة ، تطبق عليه العقوبات المشددة لحالة العود المنصوص عليها في المادتين 445 و 465 من هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis_4_19660608_OpEnact_57cc69b89b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_4_obligation_0_00dd6911> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "54 مكرر 4" ;
    dzdoc:position 91 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_445>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_465> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_445>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_465> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_4_condition_0_dc554994> ;
    dzdoc:usesTerm dzterm:person .

<https://legal.dz/resource/order/1966-06-08/66-156#art_5_bis_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_1_sec_1_bis> ;
    dzdoc:eId "art_5_bis_4" ;
    dzdoc:fullText "في حالة إخلال المحكوم عليه بالالتزامات المترتبة على عقوبة العمل للنفع العام، دون عذر جدي ، يخطر قاضي تطبيق العقوبات النيابة العامة لاتخاذ الإجراءات اللازمة لتنفيذ عقوبة الحبس المحكوم بها عليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_5_bis_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_5_bis_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_5_bis_4_19660608_OpEnact_de53d2d806> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_5_bis_4_obligation_0_e7b99f4c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "5 مكرر 4" ;
    dzdoc:position 9 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_5_bis_4_condition_0_63f80381> ;
    dzdoc:usesTerm dzterm:judge_execution_penalties .

<https://legal.dz/resource/order/1966-06-08/66-156#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:espionage ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "يرتكب جريمة التجسس ويعاقب بالإعدام كل أجنبي يقوم بأحد الأفعال المنصوص عليها في الفقرات 2 و 3 و 4 من المادة 61 وفي المادتين 62 و 63 . ويعاقب من يحرض على ارتكاب إحدى الجنايات المنصوص عليها في هذه المادة و المواد 61 و 62 و 63 أو يعرض ارتكابها بالعقوبة المقرر للجنايات ذاتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_64> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_64_defocc_927b58e13569> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_64_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_64_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_64_19660608_OpEnact_f60fb07f9c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_64_obligation_0_c5bb814e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "64" ;
    dzdoc:position 109 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_61>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_62>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_63> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_61>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_62>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_63> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_4_bis> ;
    dzdoc:eId "art_87_bis_10" ;
    dzdoc:fullText "يعاقب بالحبس من سنة (1) إلى ثلاث (3) سنوات وبغرامة من 10.000 دج إلى 100.000 دج كل من أدى خطبة أو حاول تأديتها داخل مسجد أو في أي مكان عمومي تقام فيه الصلاة دون أن يكون معينا أو معتمدا من طرف السلطة العمومية المؤهلة أو مرخصا له من طرفها للقيام بذلك . ويعاقب بالحبس من ثلاث (3) سنوات إلى خمس (5) سنوات وبغرامة من 50.000 دج إلى 200.000 دج كل من أقدم، بواسطة الخطب أو بأي فعل على أعمال مخالفة للمهمة النبيلة للمسجد أو يكون من شأنها المساس بتماسك المجتمع أو الإشادة بالأفعال المشار إليها في هذا القسم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_10_19660608_OpEnact_cc90b17455> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10_obligation_0_fb078550>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10_obligation_1_b0b37d92> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "87 مكرر 10" ;
    dzdoc:position 143 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "يعاقب بالسجن المؤبد كل من يقوم أثناء حركة التمرد بالأفعال الآتية : إقامة متاريس أو عوائق أو غيرها من الأعمال التي يكون الغرض منها عرقلة القوة العمومية أو الحيلولة دون مباشرة أعمالها أو المساعدة على إقامتها. منع استدعاء القوة العمومية أو جمعها وذلك بالعنف أو التهديد أو تحريض أو تسهيل تجمع المتمردين سواء بتوزيع الأوامر أو النشرات أو بحمل الأعلام أو غيرها من شارات التجمع أو بأي وسيلة من وسائل الدعوة. اغتصاب أو احتلال المباني أو المراكز أو غيرها من المنشآت العمومية أو المنازل المسكونة أو غير المسكونة وذلك بقصد مهاجمة أو مقاومة القوة العمومية . ويعاقب بنفس العقوبة المالك أو المستأجر الذي يسمح للمتمردين بدخول المنازل المذكورة بغير عنف مع علمه بأغراضهم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_88_permission_0_1d41237a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_88_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_88_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_88_19660608_OpEnact_b95d100902> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_88_obligation_0_b55b605d>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_88_obligation_1_1d41237a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "88" ;
    dzdoc:position 144 ;
    dzdoc:usesTerm dzterm:insurrection_movement,
        dzterm:public_force .

<https://legal.dz/resource/order/1966-06-08/66-156#art_94> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_6> ;
    dzdoc:eId "art_94" ;
    dzdoc:fullText "يجوز للحكومة بمرسوم تصدره أن تخضع الأفعال التي ترتكب ضد أمن الدول الحليفة أو الصديقة للجزائر لكل أو بعض الأحكام الخاصة بالجنايات أو الجنح ضد أمن الدولة سواء في وقت الحرب أو السلم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_94_permission_0_2183a2db> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_94> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_94_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_94_19660608_OpEnact_2811ecfd69> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "94" ;
    dzdoc:position 150 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_94_condition_0_45ce95ab> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_6> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "يعاقب بالحبس من ستة أشهر إلى 3 سنوات وبغرامة من 3.600 إلى 36.000 دج كل من يوزع أو يضع للبيع أو يعرض لأنظار الجمهور أو يحوز بقصد التوزيع أو البيع أو العرض بغرض الدعاية، منشورات أو نشرات أو أوراقا من شأنها الإضرار بالمصلحة الوطنية . وإذا كانت المنشورات أو النشرات أو الأوراق من مصدر أو وحي أجنبي فإن عقوبة الحبس ترفع إلى خمس سنوات. ويجوز للمحكمة علاوة على ذلك أن تقضي في الحالتين السابقتين بعقوبة الحرمان من الحقوق المبينة في المادة 14 من هذا القانون وبالمنع من الإقامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_96_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_96_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_96_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_96_19660608_OpEnact_8a13a6fc17> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "96" ;
    dzdoc:position 152 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_96_condition_0_a0aee038>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_96_condition_1_9b795a33> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:legal_interdiction ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_1_sec_3> ;
    dzdoc:eId "art_9_bis" ;
    dzdoc:fullText "في حالة الحكم بعقوبة جنائية ، تأمر المحكمة وجوبا بالحجر القانوني الذي يتمثل في حرمان المحكوم عليه من ممارسة حقوقه المالية أثناء تنفيذ العقوبة الأصلية . تتم إدارة أمواله طبقا للإجراءات المقررة في حالة الحجر القضائي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_9_bis> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_defocc_98d4b75f9c00> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_9_bis_19660608_OpEnact_c6c85d8702> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_obligation_0_38898419> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "9 مكرر" ;
    dzdoc:position 16 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_condition_0_86af579e> .

