<https://legal.dz/resource/order/1966-06-08/66-156#version_art_4> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المادة 4 : يكون جزاء الجرائم بتطبيق العقوبات وتكون الوقاية منها باتخاذ تدابير أمن . العقوبات الأصلية هي تلك التي يجوز الحكم بها دون أن تقترن بها أية عقوبة أخرى. العقوبات التكميلية هي تلك التي لا يجوز الحكم بها مستقلة عن عقوبة أصلية، فيما عدا الحالات التي ينص عليها القانون صراحة، وهي إما إجبارية أو اختيارية. إن ل تدابير الأمن هدف وقائي. يعتبر الأشخاص المحكوم عليهم بسبب نفس الجريمة متضامنين في رد الأشياء والتعويضات المدنية والمصاريف القضائية ، مع مراعاة ما نصت عليه المادتان 310 الفقرة 4 و 370 من ق"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_4_19660608_OpEnact_3fb3c4dba0> ;
    dzdoc:replacementText "المادة 4 : يكون جزاء الجرائم بتطبيق العقوبات وتكون الوقاية منها باتخاذ تدابير أمن . العقوبات الأصلية هي تلك التي يجوز الحكم بها دون أن تقترن بها أية عقوبة أخرى. العقوبات التكميلية هي تلك التي لا يجوز الحكم بها مستقلة عن عقوبة أصلية، فيما عدا الحالات التي ينص عليها القانون صراحة، وهي إما إجبارية أو اختيارية. إن ل تدابير الأمن هدف وقائي. يعتبر الأشخاص المحكوم عليهم بسبب نفس الجريمة متضامنين في رد الأشياء والتعويضات المدنية والمصاريف القضائية ، مع مراعاة ما نصت عليه المادتان 310 الفقرة 4 و 370 من قانون الإجراءات الجزائية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_4> ;
