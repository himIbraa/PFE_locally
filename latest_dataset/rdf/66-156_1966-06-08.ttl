<https://legal.dz/resource/order/1966-06-08/66-156#art_88_obligation_1_1d41237a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_88> ;
    dznorm:position 1 ;
    dznorm:provisionText "ويعاقب بنفس العقوبة المالك أو المستأجر الذي يسمح للمتمردين بدخول المنازل المذكورة بغير عنف مع علمه بأغراضهم."@ar ;
    dznorm:sourceArticle "art_88" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_88_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_88> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالسجن المؤبد كل من يقوم أثناء حركة التمرد بالأفعال الآتية : إقامة متاريس أو عوائق أو غيرها من الأعمال التي يكون الغرض منها عرقلة القوة العمومية أو الحيلولة دون مباشرة أعمالها أو المساعدة على إقامتها. منع استدعاء القوة العمومية أو جمعها وذلك بالعنف أو التهديد أو تحريض أو تسهيل تجمع المتمردين سواء بتوزيع الأوامر أو النشرات أو بحمل الأعلام أو غيرها من شارات التجمع أو بأي وسيلة من وسائل الدعوة. اغتصاب أو احتلال المباني أو المراكز أو غيرها من المنشآت العمومية أو المنازل المسكونة أو غير المسكونة وذلك بقصد مهاجمة أو مقاومة القوة العمومية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_88_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_88> ;
    dzdoc:position 1 ;
    dzdoc:text "ويعاقب بنفس العقوبة المالك أو المستأجر الذي يسمح للمتمردين بدخول المنازل المذكورة بغير عنف مع علمه بأغراضهم."@ar .

