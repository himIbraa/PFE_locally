<https://legal.dz/resource/order/1966-06-08/66-156#version_art_214> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن المؤبد كل قاض أو موظف أو قائم بوظيفة عمومية ارتكب تزويرا في المحررات العمومية أو الرسمية أثناء تأدية وظيفته : 1) إما بوضع توقيعات مزورة، 2 ) وإما بإحداث تغيير في المحررات أو الخطوط أو التوقيعات، 3 ) وإما بانتحال شخصية الغير أو الحلول محلها، 4 ) وإما بالكتابة في السجلات أو غيرها من المحررات العمومية أو بالتغيير فيها بعد إتمامها أو قفلها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_214_19660608_OpEnact_d937fb9bdf> ;
    dzdoc:replacementText "يعاقب بالسجن المؤبد كل قاض أو موظف أو قائم بوظيفة عمومية ارتكب تزويرا في المحررات العمومية أو الرسمية أثناء تأدية وظيفته : 1) إما بوضع توقيعات مزورة، 2 ) وإما بإحداث تغيير في المحررات أو الخطوط أو التوقيعات، 3 ) وإما بانتحال شخصية الغير أو الحلول محلها، 4 ) وإما بالكتابة في السجلات أو غيرها من المحررات العمومية أو بالتغيير فيها بعد إتمامها أو قفلها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_214> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_214> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_215> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن المؤبد كل قاض أو موظف عمومي أو قائم بوظيفة عمومية قام أثناء تحريره محررات من أعمال وظيفته بتزييف جوهرها أو ظروفها بطريق الغش وذلك إما بكتابة اتفاقات خلاف التي دونت أو أمليت من الأطراف أو بتقريره وقائع يعلم أنها كاذبة في صورة وقائع صحيحة أو بالشهادة كذبا بأن وقائع قد أعترف بها أو وقعت في حضوره أو بإسقاطه أو بتغييره عمدا الإقرارات التي تلقاها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
