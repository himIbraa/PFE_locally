<https://legal.dz/resource/order/1966-06-08/66-156#version_art_174> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في جميع الحالات المنصوص عليها في المادتين 172 و 173 يعاقب الجاني بالمنع من الإقامة من سنتين إلى خمس سنوات وبالمنع من ممارسة حق أو أكثر من الحقوق المذكورة في المادة 14 وذلك بصرف النظر عن تطبيق المادة 23 . ويجب على القاضي حتى ولو طبق الظروف المخففة أن يأمر بنشر حكمه وتعليقه طبقا لأحكام المادة 18 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_174_19660608_OpEnact_d57c440c09> ;
    dzdoc:replacementText "في جميع الحالات المنصوص عليها في المادتين 172 و 173 يعاقب الجاني بالمنع من الإقامة من سنتين إلى خمس سنوات وبالمنع من ممارسة حق أو أكثر من الحقوق المذكورة في المادة 14 وذلك بصرف النظر عن تطبيق المادة 23 . ويجب على القاضي حتى ولو طبق الظروف المخففة أن يأمر بنشر حكمه وتعليقه طبقا لأحكام المادة 18 ."@ar ;
