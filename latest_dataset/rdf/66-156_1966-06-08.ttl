<https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_3_19660608_OpEnact_7a9fe01a56> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_3> ;
