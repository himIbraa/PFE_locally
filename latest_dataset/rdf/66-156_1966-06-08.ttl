<https://legal.dz/resource/order/1966-06-08/66-156#version_art_59> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من سبق الحكم عليه من محكمة عسكرية لا يعاقب بعقوبة العود إذا ارتكب بعد ذلك جناية أو جنحة إلا حسبما يكون الحكم الأول قد صدر في جناية أو جنحة معاقب عليها طبقا للقوانين الجزائية العادية ."@ar ;
    dzdoc:isAuthoritative true ;
