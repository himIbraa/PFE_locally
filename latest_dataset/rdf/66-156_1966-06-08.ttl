    dzdoc:evidenceText "في حالة الحكم بعقوبة جنائية ، تأمر المحكمة وجوبا بالحجر القانوني الذي يتمثل في حرمان المحكوم عليه من ممارسة حقوقه المالية أثناء تنفيذ العقوبة الأصلية . تتم إدارة أمواله طبقا للإجراءات المقررة في حالة الحجر القضائي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
