    dznorm:sourceArticle "art_205" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_205_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_205> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالسجن المؤبد كل من قلد خاتم الدولة أو استعمل الخاتم المقلد وتطبق الأعذار المعفية المنصوص عليها في المادة 199 على مرتكب الجناية المشار إليها في الفقرة السابقة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_206_obligation_0_39de519b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_206> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالسجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج، كل من قلد أو زور، إما طابعا وطنيا أو أكثر، وإما مطرقة أو أكثر مستخدمة في علامات الغابات، وإما دمغة أو أكثر مستخدمة في دمغ المواد الذهبية أو الفضية، أو استعمل طوابع، أو أوراق، أو مطارق، أو دمغات مزورة أو مقلدة"@ar ;
    dznorm:sourceArticle "art_206" .

