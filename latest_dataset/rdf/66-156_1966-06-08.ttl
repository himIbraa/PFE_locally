<https://legal.dz/resource/order/1966-06-08/66-156#art_101_obligation_0_dedf82d5> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_101> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_101_obligation_0_dedf82d5_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "إلزام الشخص الذي يستمر في الاشتراك في التجمهر بعد التنبيه الثاني الذي يوجهه ممثل السلطة العمومية بالتعويض المالي عن الأضرار الناجمة عن هذا التجمهر"@ar ;
    dznorm:sourceArticle "art_101" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_110_bis_condition_0_680d4c87_ref_7793ee5a33f3> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "المادة 52 الفقرة 3 من قانون الإجراءات الجزائية"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/criminal_procedure#art_52_par_3"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/code/criminal_procedure#art_52_par_3"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/criminal_procedure#art_52_par_3" ;
    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" ;
    dzdoc:sourceEId "art_110_bis" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "الذي يمتنع عن تقديم السجل الخاص المنصوص عليه في المادة 52 الفقرة 3 من قانون الإجراءات الجزائية إلى الأشخاص المختصين بإجراء الرقابة وهو مسجل، يجب أن يتضمن أسماء الأشخاص الذين هم تحت الحراسة القضائية"@ar ;
    dzdoc:targetEId "art_52_par_3" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_110_bis_condition_1_339b0b96_ref_1bb71173f56d> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "المادة 51 من قانون الإجراءات الجزائية"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/criminal_procedure#art_51"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/code/criminal_procedure#art_51"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/criminal_procedure#art_51" ;
    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" ;
    dzdoc:sourceEId "art_110_bis" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "الذي يتعرض رغم الأوامر الصادرة طبقا لـ المادة 51 من قانون الإجراءات الجزائية من وكيل الجمهورية لإجراء الفحص الطبي لشخص هو تحت الحراسة القضائية الواقعة تحت سلطته"@ar ;
    dzdoc:targetEId "art_51" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_11_defocc_20a6705e9050> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 100 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:residence_restriction ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_11> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_11_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "تحديد الإقامة هو إلزام المحكوم عليه بأن يقيم في نطاق إقليمي يعينه الحكم لمدة لا تتجاوز خمس (5) سنوات."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_11_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_11> ;
    dzdoc:position 0 ;
    dzdoc:text "تحديد الإقامة هو إلزام المحكوم عليه بأن يقيم في نطاق إقليمي يعينه الحكم لمدة لا تتجاوز خمس (5) سنوات."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_12_defocc_d05afb1b9b01> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 57 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:residence_ban ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_12> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_12_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "المنع من الإقامة هو حظر تواجد المحكوم عليه في بعض الأماكن. ولا يجوز أن تفوق مدته خمس (5) سنوات في مواد الجنح وعشر (10) سنوات في مواد الجنايات، ما لم ينص القانون على خلاف ذلك."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_12_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_12> ;
    dzdoc:position 0 ;
    dzdoc:text "المنع من الإقامة هو حظر تواجد المحكوم عليه في بعض الأماكن. ولا يجوز أن تفوق مدته خمس (5) سنوات في مواد الجنح وعشر (10) سنوات في مواد الجنايات، ما لم ينص القانون على خلاف ذلك."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_142_obligation_0_f4ead279> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasActivity <https://legal.dz/resource/order/1966-06-08/66-156#art_142_obligation_0_f4ead279_activity_60b4d6edb4> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_142> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_142_obligation_0_f4ead279_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "كل قاض أو موظف أو ضابط عمومي فصل أو عزل أو أوقف أو حرم قانونا من وظيفته يستمر في ممارسة أعمال وظيفته بعد استلامه التبليغ الرسمي بالقرار المتعلق به يعاقب بالحبس من ستة أشهر إلى سنتين وبغرامة من 500 إلى 1.000 دج."@ar ;
    dznorm:sourceArticle "art_142" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_145_defocc_4970fea15314> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 231 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:insult ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_145> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_145_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "تعتبر إهانة ويعاقب عليها على هذا الاعتبار قيام أحد الأشخاص بتبليغ السلطات العمومية بجريمة يعلم بعدم وقوعها أو تقديمه دليلا كاذبا متعلقا بجريمة وهمية أو تقريره أمام السلطة القضائية بأنه مرتكب جريمة لم يرتكبها أو لم يشترك في ارتكابها."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_145_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_145> ;
    dzdoc:position 0 ;
    dzdoc:text "تعتبر إهانة ويعاقب عليها على هذا الاعتبار قيام أحد الأشخاص بتبليغ السلطات العمومية بجريمة يعلم بعدم وقوعها أو تقديمه دليلا كاذبا متعلقا بجريمة وهمية أو تقريره أمام السلطة القضائية بأنه مرتكب جريمة لم يرتكبها أو لم يشترك في ارتكابها."@ar .

