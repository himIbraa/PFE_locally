<https://legal.dz/resource/order/1966-06-08/66-156#version_art_319> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ويجوز الحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 من هذا القانون من سنة على الأقل إلى خمس سنوات على الأكثر وذلك في حالة ما إذا قضي عليه بعقوبة جنحة فقط طبقا للمواد من 314 إلى 317 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_319_19660608_OpEnact_3ea8afa79b> ;
