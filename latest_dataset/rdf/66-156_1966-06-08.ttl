<https://legal.dz/resource/order/1966-06-08/66-156#art_164> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_5> ;
    dzdoc:eId "art_164" ;
    dzdoc:fullText "وفي جميع الأحوال المنصوص عليها في هذا القسم لا يجوز تحريك الدعوى العمومية إلا بناء على شكوى من وزير الدفاع الوطني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_164_permission_0_e53c1d63> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_164> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_164_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_164_19660608_OpEnact_a166ff8333> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1966-06-08/66-156#art_164_prohibition_0_e53c1d63> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "164" ;
    dzdoc:position 239 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_164_condition_0_c4bba37f> ;
    dzdoc:usesTerm dzterm:minister_defense .

<https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_1_sec_3> ;
    dzdoc:eId "art_16_bis_1" ;
    dzdoc:fullText "يترتب على عقوبة غلق المؤسسة منع المحكوم عليه من أن يمارس فيها النشاط الذي ارتكبت الجريمة بمناسبته . ويحكم بهذه العقوبة إما بصفة نهائية أو لمدة لا تزيد عن عشر (10) سنوات في حالة الإدانة لارتكاب جناية، وخمس (5) سنوات في حالة الإدانة لارتكاب جنحة. ويجوز أن يؤمر بالنفاذ المعجل بالنسبة لهذا الإجراء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_1_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_1_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_1_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_1_19660608_OpEnact_a0aa184f3f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_1_obligation_0_5f9d0881> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "16 مكرر 1" ;
    dzdoc:position 29 ;
    dzdoc:usesTerm dzterm:closure_of_establishment .

<https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_1_sec_3> ;
    dzdoc:eId "art_16_bis_3" ;
    dzdoc:fullText "يترتب على عقوبة الحظر من إصدار الشيكات و / أو استعمال بطاقات الدفع إلزام المحكوم عليه بإرجاع الدفاتر والبطاقات التي بحوزته أو التي عند وكلائه إلى المؤسسة المصرفية المصدرة لها . غير أنه لا يطبق هذا الحظر على الشيكات التي تسمح بسحب الأموال من طرف الساحب لدى المسحوب عليه أو تلك المضمنة . لا تتجاوز مدة الحظر عشر (10) سنوات في حالة الإدانة لارتكاب جناية، وخمس (5) سنوات في حالة الإدانة لارتكاب جنحة. ويجوز أن يؤمر بالنفاذ المعجل بالنسبة لهذا الإجراء. يعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج كل من أصدر شيكا أو أكثر و / أو استعمل بطاقة الدفع رغم منعه من ذلك، دون الإخلال بتطبيق العقوبات المنصوص عليها في المادة 374 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_3_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_3_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_3_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_3_para_3>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_3_para_4> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_3_19660608_OpEnact_1388d243d2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_3_obligation_0_97b06550> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "16 مكرر 3" ;
    dzdoc:position 31 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_374> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_374> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_3_condition_0_ce444fb4> ;
    dzdoc:usesTerm dzterm:check_prohibition .

<https://legal.dz/resource/order/1966-06-08/66-156#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_1_sec_3> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "للمحكمة عند الحكم بالإدانة أن تأمر في الحالات التي يحددها القانون بنشر الحكم بأكمله أو مستخرج منه في جريدة أو أكثر يعينها، أو بتعليقه في الأماكن التي يبينها، وذلك كله على نفقة المحكوم عليه، على ألا تتجاوز مصاريف النشر المبلغ الذي يحدده الحكم بالإدانة لهذا الغرض، وألا تتجاوز مدة التعليق شهرا واحدا. يعاقب بالحبس من ثلاثة (3) أشهر إلى سنتين (2) وبغرامة من 25.000 دج إلى 200.000 دج كل من قام بإتلاف أو إخفاء أو تمزيق المعلقات الموضوعة تطبيقا للفقرة السابقة كليا أو جزئيا ، ويأمر الحكم من جديد بتنفيذ التعليق على نفقة الفاعل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_18_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_18_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_18_19660608_OpEnact_27c899ea90> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_18_obligation_0_125048d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "18" ;
    dzdoc:position 36 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_233> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_7> ;
    dzdoc:eId "art_233" ;
    dzdoc:fullText "كل من شهد زورا في مواد الجنح سواء ضد المتهم أو لصالحه يعاقب بالحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 7.500 دينار. وإذا قبض شاهد الزور نقودا أو أية مكافأة كانت أو تلقى وعودا فيجوز رفع العقوبة إلى عشر سنوات والحد الأقصى للغرامة إلى 15.000 دينار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_233> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_233_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_233_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_233_19660608_OpEnact_f3eda1a7e5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_233_obligation_0_2034d10b>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_233_obligation_1_e56f360e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "233" ;
    dzdoc:position 317 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_233_condition_0_3ff475e7> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_236> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_7> ;
    dzdoc:eId "art_236" ;
    dzdoc:fullText "كل من استعمل الوعود أو العطايا أو الهدايا أو الضغط أو التهديد أو التعدي أو المناورة أو التحايل لحمل الغير على الإدلاء بأقوال أو بإقرارات كاذبة أو على إعطاء شهادة كاذبة وذلك في أية مادة وفي أية حالة كانت عليها الإجراءات أو بغرض المطالبة أو الدفاع أمام القضاء سواء أنتجت هذه الأفعال آثارها أو لم تنتجه يعاقب بالحبس من سنة إلى ثلاث سنوات وبغرامة من 500 إلى 2.000 دينار أو بإحدى هاتين العقوبتين ما لم يعتبر الفعل اشتراكا في إحدى الجرائم الأشد المنصوص عليها في المواد 232 و 233 و 235 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_236> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_236_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_236_19660608_OpEnact_5353cb93ac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_236_obligation_0_9cdd67f9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "236" ;
    dzdoc:position 320 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_232>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_233>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_235> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_232>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_233>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_235> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_236_condition_0_0fb74821> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_263_مكرر2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_263_مكرر2" ;
    dzdoc:fullText "يعاقب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 150.000 دج إلى 800.000 دج، كل موظف يمارس أو يحرض أو يأمر بممارسة التعذيب من أجل الحصول على اعترافات أو معلومات أو لأي سبب آخر. إذا سبق التعذيب أو صاحب أو تلى جناية غير القتل العمد ، تكون العقوبة السجن المؤبد . يعاقب بالسجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 100.000 دج إلى 500.000 دج ، كل موظف يوافق أو يسكت عن الأفعال المذكورة في المادة 263 مكرر من هذا القانون. 2- أعمال العنف العمدية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_263_مكرر2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_263_مكرر2_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263_مكرر2_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263_مكرر2_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263_مكرر2_para_3> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_263__2_19660608_OpEnact_e237bf4aec> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_263_مكرر2_obligation_0_daf943d6>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263_مكرر2_obligation_1_d2619aee>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263_مكرر2_obligation_2_c609c749> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 263 مكرر2" ;
    dzdoc:position 351 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_263_مكرر> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_263_مكرر> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_263_مكرر2_condition_0_fddb4519> ;
    dzdoc:usesTerm dzterm:التعذيب,
        dzterm:موظف .

<https://legal.dz/resource/order/1966-06-08/66-156#art_266> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_266" ;
    dzdoc:fullText "إذا وقع الجرح أو الضرب أو غير ذلك من أعمال العنف أو الاعتداءات الأخرى مع سبق الإصرار أو الترصد أو مع حمل أسلحة ولم يؤد إلى مرض أو عجز كلي عن العمل لمدة تتجاوز خمسة عشر (15) يوما ، فيعاقب الجاني بالحبس من سنتين (2) إلى عشر (10) سنوات وبغرامة من 200.000 دج إلى 1.000.000دج . ويمكن مصادرة الأشياء التي استعملت أو قد تستعمل لتنفيذ الجريمة مع مراعاة حقوق الغير حسن النية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_266> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_266_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_266_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_266_19660608_OpEnact_c3555672a2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_266_obligation_0_51a9975a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 266" ;
    dzdoc:position 354 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_266_condition_0_ea3191b0> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5> ;
    dzdoc:eId "art_303_bis_2" ;
    dzdoc:fullText "يجوز للمحكمة أن تحظر على المحكوم عليه من أجل الجرائم المنصوص عليها في المادتين 303 مكرر و 303 مكرر 1 ، ممارسة حق أو أكثر من الحقوق المنصوص عليها في المادة 9 مكرر 1 لمدة لا تتجاوز خمس (5) سنوات، كما يجوز لها أن تأمر بنشر حكم الإدانة طبقا للكيفيات المبينة في المادة 18 من هذا القانون. ويتعين دائما الحكم بمصادرة الأشياء التي استعملت لارتكاب الجريمة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_2_permission_0_1bc8adce> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_2_right_0_7cf14107> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_2_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_2_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_2_19660608_OpEnact_f370256a55> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_2_obligation_0_c5dcad83> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 2" ;
    dzdoc:position 402 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_18>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_18>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_331> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_5> ;
    dzdoc:eId "art_331" ;
    dzdoc:fullText "يعاقب بالحبس من ستة (6) أشهر إلى (3) سنوات وبغرامة من 50.000 دج إلى 300.000 دج كل من امتنع عمدا، ولمدة تتجاوز الشهرين (2) عن تقديم المبالغ المقررة قضاء لإعالة أسرته، وعن أداء كامل قيمة النفقة المقررة عليه إلى زوجه أو أصوله أو فروعه، وذلك رغم صدور حكم ضده بإلزامه بدفع نفقة إليهم . ويفترض أن عدم الدفع عمدي ما لم يثبت العكس، ولا يعتبر الإعسار الناتج عن الاعتياد على سوء السلوك أو الكسل أو السكر عذرا مقبولا من المدين في أية حالة من الأحوال. دون الإخلال بتطبيق أحكام المواد 37 و 40 و 329 من قانون الإجراءات الجزائية تختص أيضا بالحكم في الجنح المذكورة في هذه المادة محكمة موطن أو محل إقامة الشخص المقرر له قبض النفقة أو المنتفع بالمعونة. ويضع صفح الضحية بعد دفع المبالغ المستحقة حدا للمتابعة الجزائية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_331> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_331_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_331_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_331_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_331_para_3> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_331_19660608_OpEnact_296d7456db> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_331_obligation_0_49af3078> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "331" ;
    dzdoc:position 472 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_331> ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1966-06-08/66-156#art_331_extref_06bcf026>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_331_extref_0f26b254>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_331_extref_58053f74> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_331> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_337> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_6> ;
    dzdoc:eId "art_337" ;
    dzdoc:fullText "إذا كان الجاني من أصول من وقع عليه الفعل المخل بالحياء أو هتك العرض أو كان من فئة من لهم سلطة عليه أو كان من معلميه أو ممن يخدمونه بأجر أو كان خادما بأجر لدى الأشخاص المبينين عاليه أو كان موظفا أو من رجال الدين أو إذا كان الجاني مهما كانت صفته قد استعان في ارتكاب الجناية بشخص أو أكثر فتكون العقوبة السجن المؤقت من عشر سنوات إلى عشرين سنة في الحالة المنصوص عليها في الفقرة الأولى من المادة 334 والسجن المؤبد في الحالتين المنصوص عليهما في المادتين 335 و 336 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_337> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_337_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_337_19660608_OpEnact_1333bf0b38> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_337_obligation_0_b93e2e79> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "337" ;
    dzdoc:position 480 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_334>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_335>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_336> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_334>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_335>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_336> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_337_condition_0_bfc99b3f> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:incest ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_6> ;
    dzdoc:eId "art_337_bis" ;
    dzdoc:fullText "تعتبر من الفواحش بين ذوي المحارم العلاقات الجنسية التي ترتكب بين : 1- الأقارب من الفروع أو الأصول، 2- الإخوة والأخوات الأشقاء، أو من الأب أو من الأم، 3- شخص وابن أحد إخوته أو أخواته الأشقاء أو من الأب أو من الأم أو من أحد فروعه، 4- الأم أو الأب والزوج أو الزوجة والأرمل أو أرملة ابنه أو مع أحد آخر من فروعه، 5- والد الزوج أو الزوجة أو زوج الأم أو زوجة الأب وفروع الزوج الآخر، 6- أشخاص يكون أحدهم زوجا لأخ أو لأخت. تكون العقوبة السجن من عشر (10) سنوات إلى عشرين (20) سنة في الحالتين 1 و 2 والحبس من خمس (5) سنوات إلى عشر (10) سنوات في الحالات 3 و 4 و 5 والحبس من سنتين (2) إلى خمس (5) سنوات في الحالة 6 أعلاه . وتطبق على العلاقات الجنسية بين الكافل والمكفول العقوبة المقررة للفاحشة المرتكبة بين الأقارب من الفروع أو الأصول. ويتضمن الحكم المقضي به ضد الأب أو الأم أو الكافل سقوط الولاية و/أو الكفالة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_337_bis> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis_defocc_8fe92d8a20f0> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis_para_3> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_337_bis_19660608_OpEnact_951199253c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis_obligation_0_ea400d68> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "337 مكرر" ;
    dzdoc:position 481 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_363> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_363" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى ثلاث سنوات وبغرامة من 500 إلى 3.000 دينار الشريك في الميراث أو المدعي بحق في تركة الذي يستولي بطريق الغش على كامل الإرث أو على جزء منه قبل قسمته . وتطبق العقوبة ذاتها على الشريك في الملك أو على أحد المساهمين الذي يستولي بطريق الغش على أشياء مشتركة أو على مال الشركة . ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة لمدة سنة على الأقل وخمس سنوات على الأكثر. ويعاقب على الشروع في الجنح المنصوص عليها في هذه المادة بالعقوبات ذاتها المقررة للجريمة التامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_363> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_363_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_363_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_363_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_363_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_363_19660608_OpEnact_6fcf3317fa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_363_obligation_0_413cba34>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_363_obligation_1_2373c70e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "363" ;
    dzdoc:position 514 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_412> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_412" ;
    dzdoc:fullText "كل من أتلف عمدا بضائع أو مواد أو محركات أو أجهزة أيا كانت مستعملة في الصناعة وذلك بواسطة مواد من شأنها الإتلاف أو بأية وسيلة أخرى يعاقب بالحبس من ثلاثة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 5.000 دينار. وإذا كان مرتكب الجريمة عاملا في المصنع أو مستخدما في المحل التجاري فتكون العقوبة الحبس من سنتين إلى خمس سنوات. وفي جميع الحالات يجوز أن يحكم على الجاني علاوة على ذلك بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 من هذا القانون وبالمنع من الإقامة وذلك لمدة سنة على الأقل وخمس سنوات على الأكثر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_412_permission_0_a70a0d20> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_412> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_412_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_412_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_412_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_412_19660608_OpEnact_86dbeb50ef> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_412_obligation_0_0fa72717> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "412" ;
    dzdoc:position 586 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_412_condition_0_f956ce6f> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "يعاقب الشريك في جناية أو جنحة بالعقوبة المقررة للجناية أو الجنحة. ولا تؤثر الظروف الشخصية التي ينتج عنها تشديد أو تخفيف العقوبة أو الإعفاء منها إلا بالنسبة للفاعل أو الشريك الذي تتصل به هذه الظروف. والظروف الموضوعية اللصيقة بالجريمة التي تؤدي إلى تشديد أو تخفيف العقوبة التي توقع على من ساهم فيها يترتب عليها تشديدها أو تخفيفها، بحسب ما إذا كان يعلم أو لا يعلم بهذه الظروف. ولا يعاقب على الاشتراك في المخالفة على الإطلاق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_44_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_44_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_44_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_44_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_44_19660608_OpEnact_1f38ab1f2b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_44_obligation_0_fb47ae4a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "44" ;
    dzdoc:position 66 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_451> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_451" ;
    dzdoc:fullText "يعاقب بغرامة من 100 إلى 500 دج ويجوز أن يعاقب أيضا بالحبس لمدة خمسة أيام على الأكثر : 1 - كل من ارتدى علنا في غير الحالات المنصوص عليها في المادة 246 لباسا يتشابه مع بذلة حددتها لنصوص التطبيقية وكان من شأن هذا التشابه أن يخلط الجمهور بينها. 2 - الخبازون و الجزارون الذين يبيعون خبزا أو لحوما بأكثر من الأسعار المحددة في التعريفة المقررة والمعلنة قانونا. 3 - كل من استعمل أوزانا أو مقاييس تغاير تلك التي قررتها القوانين السارية المفعول. 4 - أصحاب النزل والفنادق ومؤجرو المساكن المفروشة الذين يهملون قيد أسماء وألقاب وصفات أي شخص يبيت لديهم أو يمضى الليل كله أو بعضه في هذه الأماكن ومحل إقامته المعتادة وتاريخ وصوله في سجلات منتظمة ودون ترك بياض وذلك بمجرد وصوله وكذا تاريخ خروجه بمجرد مغادرته ولا يقومون بتقديم هذا السجل إلى السلطة المختصة في المواعيد التي تحددها النظم أو عند طلبها منهم. 5 - كل من أقام أو وضع ألعابا لليانصيب أو غيرها من ألعاب القمار في الشوارع أو الطرق أو الساحات أو الأماكن العمومية. 6 - كل من قبل أو حاز أو استعمل وسائل للدفع يكون الغرض منها أن تكمل أو تحل محل العملة ذات السعر القانوني. 7 - كل من رفض قبول العملة والنقود الوطنية غير المزورة أو غير المزيفة بالقيمة المقررة لها قانون. 8 - كل من رفض القيام بأعمال أو بأداء خدمات أو بتقديم مساعدة طلبت منه قانونا أو أهمل ذلك وكان بإمكانه القيام بهذا وذلك في ظروف وقعت فيها حوادث أو ضياع أو غرق أو نصب أو حريق أو كوارث أخرى وكذلك في حالات النهب والسلب أو تلبس أو صياح الجمهور أو تنفيذ قضائي. 9 - كل من قدم أو باع أو عرض للبيع بضائع في أماكن عمومية مخالفا بذلك اللوائح التنظيمية للشرطة في هذه الأماكن دون الحصول على إذن أو تصريح قانوني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_451> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_451_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_451_19660608_OpEnact_c6732ba0b6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_451_obligation_0_98a55ec7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "451" ;
    dzdoc:position 640 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_246> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_246> ;
    dzdoc:usesTerm dzterm:bakers,
        dzterm:butchers .

<https://legal.dz/resource/order/1966-06-08/66-156#art_465> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_2_sec_4> ;
    dzdoc:eId "art_465" ;
    dzdoc:fullText "يعاقب العائد في مادة المخالفات المنصوص عليها في هذا الباب بما يأتي : في حالة العود في إحدى المخالفات الواردة في الفصل الأول ، بالحبس الذي قد تصل مدته إلى شهر (1) وبغرامة قد تصل إلى 24.000 دج، في حالة العود في إحدى المخالفات الواردة في الفصل الثاني ، بالحبس الذي قد تصل مدته إلى عشرة (10) أيام وبغرامة قد تصل إلى 16.000 دج، في حالة العود في إحدى المخالفات الواردة في الفصل الثالث ، بالحبس الذي قد تصل مدته إلى خمسة (5) أيام وبغرامة قد تصل إلى 12.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_465> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_465_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_465_19660608_OpEnact_e79f86c222> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_465_obligation_0_e862104d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 465" ;
    dzdoc:position 654 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_465_condition_0_321a083c>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_465_condition_1_8759546b>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_465_condition_2_372386a0> ;
    dzdoc:usesTerm dzterm:recidivist .

<https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_53_bis" ;
    dzdoc:fullText "عندما تطبق العقوبات المشددة بفعل حالة العود ، فإن التخفيف الناتج عن منح الظروف المخففة ينصب على الحدود القصوى الجديدة المقررة قانونا. إذا كانت العقوبة الجديدة السالبة للحرية المقررة هي السجن المؤقت من خمس (5) سنوات إلى عشرين (20) سنة ، فإن الحد الأدنى للعقوبة المخففة لا يجوز أن يقل عن ثلاث (3) سنوات حبسا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_permission_0_3fecbbb2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_bis_19660608_OpEnact_f23466ca99> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_obligation_0_8c0bcdce> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_prohibition_0_3fecbbb2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "53 مكرر" ;
    dzdoc:position 77 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_condition_0_45d32f7f>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_condition_1_6e7b2b32> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_54_bis_1" ;
    dzdoc:fullText "إذا سبق الحكم نهائيا على شخص طبيعي من أجل جناية أو جنحة معاقب عليها قانونا بعقوبة حدها الأقصى يزيد عن خمس (5) سنوات حبسا، وارتكب خلال العشر سنوات التالية لقضاء العقوبة السابقة، جنحة معاقبا عليها بنفس العقوبة ، فإن الحد الأقصى لعقوبة الحبس والغرامة المقرر لهذه الجنحة يرفع وجوبا إلى الضعف . ويرفع الحد الأقصى للعقوبة السالبة للحرية إلى عشرين (20) سنة حبسا، إذا كان الحد الأقصى للعقوبة المقررة قانونا لهذه الجنحة يزيد عن عشر (10) سنوات وإذا كان هذا الحد يساوي عشرين (20) سنة حبسا، فإن الحد الأدنى لهذه العقوبة يرفع وجوبا إلى الضعف . كما يجوز الحكم أيضا بواحدة أو أكثر من العقوبات التكميلية المنصوص عليها في المادة 9 من هذا القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_1_permission_0_c35c9283> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_1_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_1_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_1_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis_1_19660608_OpEnact_fc3911bf36> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_1_obligation_0_bf60a5af>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_1_obligation_1_947a2f66> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "54 مكرر 1" ;
    dzdoc:position 88 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_9> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_9> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_1_condition_0_91ac57f2> ;
    dzdoc:usesTerm dzterm:complementary_penalties,
        dzterm:person .

<https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_54_bis_5" ;
    dzdoc:fullText "إذا سبق الحكم نهائيا على شخص معنوي من أجل جناية أو جنحة معاقب عليها قانونا بالنسبة للشخص الطبيعي بغرامة حدها الأقصى يفوق 500.000 دج، وقامت مسؤوليته الجزائية من جراء ارتكاب جناية ، فإن النسبة القصوى للغرامة المطبقة تساوي عشر (10) مرات الحد الأقصى لعقوبة الغرامة المنصوص عليها في القانون الذي يعاقب على هذه الجناية . عندما تكون الجناية غير معاقب عليها بغرامة بالنسبة للشخص الطبيعي ، فإن الحد الأقصى للغرامة المطبق على الشخص المعنوي ، في خالة العود، هو 20.000.000 دج عندما يتعلق الأمر بجناية معاقب عليها بالإعدام أو السجن المؤبد ، و يكون هذا الحد 10.000.000 دج عندما تكون الجناية معاقبا عليها بالسجن المؤقت ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_5_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_5_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis_5_19660608_OpEnact_eca5d6727e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_5_obligation_0_5c4d7272>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_5_obligation_1_9aff74a5>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_5_obligation_2_40183cd6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 54 مكرر 5" ;
    dzdoc:position 92 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_5_condition_0_e378aa44>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_5_condition_1_9cf7c66c> ;
    dzdoc:usesTerm dzterm:legal_person .

<https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_6> a dzdoc:Article ;
