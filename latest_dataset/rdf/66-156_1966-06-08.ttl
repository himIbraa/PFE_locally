<https://legal.dz/resource/order/1966-06-08/66-156#version_art_298> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب على القذف الموجه إلى الأفراد بالحبس من شهرين (2) إلى ستة (6) أشهر وبغرامة من 25.000 دج إلى 50.000 دج أو بإحدى هاتين العقوبتين. ويضع صفح الضحية حدا للمتابعة الجزائية. ويعاقب على القذف الموجه إلى شخص أو أكثر بسبب انتمائهم إلى مجموعة عرقية أو مذهبية أو إلى دين معين بالحبس من شهر (1) إلى سنة (1) وبغرامة من 10.000 دج إلى 100.000 دج أو بإحدى هاتين العقوبتين فقط إذا كان الغرض هو التحريض على الكراهية بين المواطنين أو السكان ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_298_19660608_OpEnact_e77ddbf087> ;
    dzdoc:replacementText "يعاقب على القذف الموجه إلى الأفراد بالحبس من شهرين (2) إلى ستة (6) أشهر وبغرامة من 25.000 دج إلى 50.000 دج أو بإحدى هاتين العقوبتين. ويضع صفح الضحية حدا للمتابعة الجزائية. ويعاقب على القذف الموجه إلى شخص أو أكثر بسبب انتمائهم إلى مجموعة عرقية أو مذهبية أو إلى دين معين بالحبس من شهر (1) إلى سنة (1) وبغرامة من 10.000 دج إلى 100.000 دج أو بإحدى هاتين العقوبتين فقط إذا كان الغرض هو التحريض على الكراهية بين المواطنين أو السكان ."@ar ;
