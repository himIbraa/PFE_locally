<https://legal.dz/resource/order/1966-06-08/66-156#art_5_bis_3_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_5_bis_3> ;
    dzdoc:position 0 ;
