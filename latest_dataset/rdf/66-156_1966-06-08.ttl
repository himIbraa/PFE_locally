<https://legal.dz/resource/order/1966-06-08/66-156#version_art_333> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين إلى سنتين وبغرامة من 500 إلى 2.000 دج كل من ارتكب فعلا علانيا مخلا بالحياء . وإذا كان الفعل العلني المخل بالحياء من أفعال الشذوذ الجنسي ارتكب ضد شخص من نفس الجنس تكون العقوبة بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة من 1.000 إلى 10.000 دج ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_333_19660608_OpEnact_f9f3930dd7> ;
    dzdoc:replacementText "يعاقب بالحبس من شهرين إلى سنتين وبغرامة من 500 إلى 2.000 دج كل من ارتكب فعلا علانيا مخلا بالحياء . وإذا كان الفعل العلني المخل بالحياء من أفعال الشذوذ الجنسي ارتكب ضد شخص من نفس الجنس تكون العقوبة بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة من 1.000 إلى 10.000 دج ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_333> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
