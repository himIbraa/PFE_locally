<https://legal.dz/resource/order/1966-06-08/66-156#art_396_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_396> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالسجن المؤقت من عشر سنوات إلى عشرين سنة كل من وضع النار عمدا في الأموال الآتية إذا لم تكن مملوكة له: مبان أو مساكن أو غرف أو خيم أو أكشاك ولو متنقلة أو بواخر أو سفن أو مخازن أو ورش إذا كانت غير مسكونة أو غير مستعملة للسكنى، مركبات أو طائرات ليس بها أشخاص، غابات أو حقول مزروعة أشجارا أو مقاطع أشجار أو أخشاب موضوعة في أكوام وعلى هيئة مكعبات، محصولات قائمة أو قش أو محصولات موضوعة في أكوام أو في حزم، عربات سكة حديد سواء محملة بالبضائع أو بأشياء منقولة أخرى أو فارغة إذ لم تكن ضمن قطار به أشخاص."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_397_obligation_0_29125dfc> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1966-06-08/66-156#art_397_obligation_0_29125dfc_ref_3c4403a2ee87> ;
