<https://legal.dz/resource/order/1966-06-08/66-156#art_320_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_320_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق أحكام المادة 60 مكرر على الجرائم المنصوص عليها في المواد 314 الفقرتان 3 و 4 و 315 الفقرات 3 و 4 و 5 و 316 الفقرة 4 و 317 الفقرتان 4 و 5 و 318 و 319 مكرر من هذا القسم.(1)"@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_320_obligation_0_80e7dae9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_320> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 500 إلى 20.000 دينار :"@ar ;
    dznorm:sourceArticle "art_320" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_320_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_320> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 500 إلى 20.000 دينار : 1- كل من حرض أبوين أو أحدهما على التخلي عن طفلهما المولود أو الذي سيولد وذلك بنية الحصول على فائدة. 2- كل من تحصل من أبوين أو من أحدهما على عقد يتعهدان بمقتضاه بالتخلي عن طفلهما الذي سيولد أو شرع في ذلك وكل من حاز مثل هذا العقد أو استعمله أو شرع في استعماله. 3- كل من قدم وساطته للحصول على طفل بنية التوصل إلى فائدة أو شرع في ذلك."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_321_condition_0_de4e3b7b> a dznorm:Condition ;
    dznorm:conditionText "وإذا لم يثبت أن الطفل قد ولد حيا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_321> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_321_condition_1_9c5702d4> a dznorm:Condition ;
    dznorm:conditionText "وإذا ثبت أن الطفل لم يولد حيا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_321> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_321_condition_2_98a062c6> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1966-06-08/66-156#art_321_condition_2_98a062c6_role_0be95d76cf> ;
    dznorm:conditionText "إذا قدم فعلا الولد على أنه ولد لامرأة لم تضع حملا، بعد تسليم اختياري أو إهمال من والديه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_321> ;
    dznorm:position 2 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_321_condition_2_98a062c6_role_0be95d76cf> a dznorm:Role ;
