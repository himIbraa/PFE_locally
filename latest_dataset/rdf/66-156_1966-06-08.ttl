    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من شهرين إلى ثلاث سنوات وبغرامة من 2.000 إلى 20.000 دج كل من يحوز دون سبب شرعي"@ar ;
    dznorm:sourceArticle "art_433" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_433_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_433> ;
    dzdoc:position 0 ;
    dzdoc:text """يعاقب بالحبس من شهرين إلى ثلاث سنوات وبغرامة من 2.000 إلى 20.000 دج كل من يحوز دون سبب شرعي :
            
            
            سواء مواد صالحة لتغذية الإنسان أو الحيوانات أو مشروبات أو منتوجات فلاحية أو طبيعية يعلم أنها مغشوشة أو فاسدة أو مسمومة،
            
            
            سواء مواد طبية مغشوشة،
            
            
            سواء مواد خاصة تستعمل في غش مواد صالحة لتغذية الإنسان أو الحيوانات أو مشروبات أو منتوجات فلاحية أو طبية،
            
            
            سواء موازين أو مكاييل خاطئة أو آلات أخرى غير مطابقة تستعمل في وزن أو كيل السلع. سواء مواد صالحة لتغذية الإنسان أو الحيوانات أو مشروبات أو منتوجات فلاحية أو طبيعية يعلم أنها مغشوشة أو فاسدة أو مسمومة، سواء مواد طبية مغشوشة، سواء مواد خاصة تستعمل في غش مواد صالحة لتغذية الإنسان أو الحيوانات أو مشروبات أو منتوجات فلاحية أو طبية، سواء موازين أو مكاييل خاطئة أو آلات أخرى غير مطابقة تستعمل في وزن أو كيل السلع."""@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_434_obligation_0_bca96c1c> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
