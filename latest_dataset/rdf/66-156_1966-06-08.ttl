<https://legal.dz/resource/order/1966-06-08/66-156#version_art_465> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب العائد في مادة المخالفات المنصوص عليها في هذا الباب بما يأتي : في حالة العود في إحدى المخالفات الواردة في الفصل الأول ، بالحبس الذي قد تصل مدته إلى شهر (1) وبغرامة قد تصل إلى 24.000 دج، في حالة العود في إحدى المخالفات الواردة في الفصل الثاني ، بالحبس الذي قد تصل مدته إلى عشرة (10) أيام وبغرامة قد تصل إلى 16.000 دج، في حالة العود في إحدى المخالفات الواردة في الفصل الثالث ، بالحبس الذي قد تصل مدته إلى خمسة (5) أيام وبغرامة قد تصل إلى 12.000 دج."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_465_19660608_OpEnact_e79f86c222> ;
    dzdoc:replacementText "يعاقب العائد في مادة المخالفات المنصوص عليها في هذا الباب بما يأتي : في حالة العود في إحدى المخالفات الواردة في الفصل الأول ، بالحبس الذي قد تصل مدته إلى شهر (1) وبغرامة قد تصل إلى 24.000 دج، في حالة العود في إحدى المخالفات الواردة في الفصل الثاني ، بالحبس الذي قد تصل مدته إلى عشرة (10) أيام وبغرامة قد تصل إلى 16.000 دج، في حالة العود في إحدى المخالفات الواردة في الفصل الثالث ، بالحبس الذي قد تصل مدته إلى خمسة (5) أيام وبغرامة قد تصل إلى 12.000 دج."@ar ;
