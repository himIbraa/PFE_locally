<https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis_defocc_8fe92d8a20f0> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 66 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:incest ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """تعتبر من الفواحش بين ذوي المحارم العلاقات الجنسية التي ترتكب بين :
                
                
                1- الأقارب من الفروع أو الأصول،
                
                
                2- الإخوة والأخوات الأشقاء، أو من الأب أو من الأم،
                
                
                3- شخص وابن أحد إخوته أو أخواته الأشقاء أو من الأب أو من الأم أو من أحد فروعه،
                
                
                4- الأم أو الأب والزوج أو الزوجة والأرمل أو أرملة ابنه أو مع أحد آخر من فروعه،
                
                
                5- والد الزوج أو الزوجة أو زوج الأم أو زوجة الأب وفروع الزوج الآخر،
                
                
                6- أشخاص يكون أحدهم زوجا لأخ أو لأخت."""@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "تعتبر من الفواحش بين ذوي المحارم العلاقات الجنسية التي ترتكب بين : 1- الأقارب من الفروع أو الأصول، 2- الإخوة والأخوات الأشقاء، أو من الأب أو من الأم، 3- شخص وابن أحد إخوته أو أخواته الأشقاء أو من الأب أو من الأم أو من أحد فروعه، 4- الأم أو الأب والزوج أو الزوجة والأرمل أو أرملة ابنه أو مع أحد آخر من فروعه، 5- والد الزوج أو الزوجة أو زوج الأم أو زوجة الأب وفروع الزوج الآخر، 6- أشخاص يكون أحدهم زوجا لأخ أو لأخت."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_33_defocc_bbb2af240392> a dzdoc:DefinitionOccurrence ;
