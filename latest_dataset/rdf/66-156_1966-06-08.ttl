    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_183_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "كل هجوم على الموظفين أو ممثلي السلطة العمومية الذين يقومون بتنفيذ الأوامر أو القرارات الصادرة منها أو القوانين أو اللوائح أو القرارات أو الأوامر القضائية وكذلك كل مقاومة لهم بالعنف أو التعدي تكون جريمة العصيان."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_183_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_183> ;
    dzdoc:position 0 ;
    dzdoc:text "كل هجوم على الموظفين أو ممثلي السلطة العمومية الذين يقومون بتنفيذ الأوامر أو القرارات الصادرة منها أو القوانين أو اللوائح أو القرارات أو الأوامر القضائية وكذلك كل مقاومة لهم بالعنف أو التعدي تكون جريمة العصيان."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_185_obligation_1_48bdda0e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_185> ;
