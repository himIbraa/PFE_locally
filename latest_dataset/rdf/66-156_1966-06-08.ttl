<https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز الحكم على الشخص المدان لارتكابه جناية أو جنحة بـ المنع من ممارسة مهنة أو نشاط ، إذا ثبت للجهة القضائية أن للجريمة التي ارتكبها صلة مباشرة بمزاولتهما ، وأن ثمة خطر في استمرار ممارسته لأي منهما . ويصدر الحكم بالمنع لمدة لا تتجاوز عشر (10) سنوات في حالة الإدانة لارتكاب جناية وخمس (5) سنوات في حالة الإدانة لارتكاب جنحة. ويجوز أن يؤمر بالنفاذ المعجل بالنسبة لهذا الإجراء."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_19660608_OpEnact_cd2a548c56> ;
    dzdoc:replacementText "يجوز الحكم على الشخص المدان لارتكابه جناية أو جنحة بـ المنع من ممارسة مهنة أو نشاط ، إذا ثبت للجهة القضائية أن للجريمة التي ارتكبها صلة مباشرة بمزاولتهما ، وأن ثمة خطر في استمرار ممارسته لأي منهما . ويصدر الحكم بالمنع لمدة لا تتجاوز عشر (10) سنوات في حالة الإدانة لارتكاب جناية وخمس (5) سنوات في حالة الإدانة لارتكاب جنحة. ويجوز أن يؤمر بالنفاذ المعجل بالنسبة لهذا الإجراء."@ar ;
