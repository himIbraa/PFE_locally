<https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_3> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون الشخص المعنوي مسؤولا جزائيا عن الجرائم المحددة في الأقسام 3 و4 و 5 من هذا الفصل، وذلك طبقا للشروط المنصوص عليها في المادة 51 مكرر . وتطبق على الشخص المعنوي عقوبة الغرامة حسب الكيفيات المنصوص عليها في المادة 18 مكرر ، وفي المادة 18 مكرر 2 عند الاقتضاء. ويتعرض أيضا لواحدة أو أكثر من العقوبات التكميلية المنصوص عليها في المادة 18 مكرر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_3_19660608_OpEnact_7a9fe01a56> ;
    dzdoc:replacementText "يكون الشخص المعنوي مسؤولا جزائيا عن الجرائم المحددة في الأقسام 3 و4 و 5 من هذا الفصل، وذلك طبقا للشروط المنصوص عليها في المادة 51 مكرر . وتطبق على الشخص المعنوي عقوبة الغرامة حسب الكيفيات المنصوص عليها في المادة 18 مكرر ، وفي المادة 18 مكرر 2 عند الاقتضاء. ويتعرض أيضا لواحدة أو أكثر من العقوبات التكميلية المنصوص عليها في المادة 18 مكرر ."@ar ;
