<https://legal.dz/resource/order/1966-06-08/66-156#art_59_condition_0_64e3f575> a dznorm:Condition ;
    dznorm:conditionText "إذا ارتكب بعد ذلك جناية أو جنحة إلا حسبما يكون الحكم الأول قد صدر في جناية أو جنحة معاقب عليها طبقا للقوانين الجزائية العادية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_59> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_59_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_59> ;
    dzdoc:position 0 ;
    dzdoc:text "كل من سبق الحكم عليه من محكمة عسكرية لا يعاقب بعقوبة العود إذا ارتكب بعد ذلك جناية أو جنحة إلا حسبما يكون الحكم الأول قد صدر في جناية أو جنحة معاقب عليها طبقا للقوانين الجزائية العادية."@ar .

