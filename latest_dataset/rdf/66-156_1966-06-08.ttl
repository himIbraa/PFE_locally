<https://legal.dz/resource/order/1966-06-08/66-156#version_art_192> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من هيأ أو سهل الهروب أو شرع في ذلك من غير الأشخاص المبينين في المادة 190 يعاقب بالحبس من شهر إلى ستة أشهر وبغرامة من 500 إلى 1.000 دينار حتى ولو لم يتم الهروب. وتكون العقوبة الحبس من سنتين إلى خمس سنوات والغرامة من 1.000 إلى 2.000 دينار إذا كانت هناك رشوة للحراس أو تواطؤ معهم . وتكون العقوبة الحبس من سنتين إلى خمس سنوات والغرامة من 1.000 إلى 4.000 دينار إذا تضمنت المساعدة تقديم سلاح ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_192_19660608_OpEnact_8c0a4690ca> ;
    dzdoc:replacementText "كل من هيأ أو سهل الهروب أو شرع في ذلك من غير الأشخاص المبينين في المادة 190 يعاقب بالحبس من شهر إلى ستة أشهر وبغرامة من 500 إلى 1.000 دينار حتى ولو لم يتم الهروب. وتكون العقوبة الحبس من سنتين إلى خمس سنوات والغرامة من 1.000 إلى 2.000 دينار إذا كانت هناك رشوة للحراس أو تواطؤ معهم . وتكون العقوبة الحبس من سنتين إلى خمس سنوات والغرامة من 1.000 إلى 4.000 دينار إذا تضمنت المساعدة تقديم سلاح ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
