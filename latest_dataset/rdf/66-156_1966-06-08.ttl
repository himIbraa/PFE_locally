    dzdoc:position 1 ;
    dzdoc:text "وإذا كان مرتكب الجريمة عاملا في المصنع أو مستخدما في المحل التجاري فتكون العقوبة الحبس من سنتين إلى خمس سنوات."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_412_para_2> a dzdoc:Paragraph ;
