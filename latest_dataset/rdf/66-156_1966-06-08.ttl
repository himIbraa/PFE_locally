<https://legal.dz/resource/order/1966-06-08/66-156#version_art_81> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالإعدام : كل من تولى قيادة عسكرية أيا كانت بدون وجه حق أو بدون سبب مشروع، وكل من احتفظ بمثل هذه القيادة ضد أمر الحكومة، والقواد الذين يبقون جيوشهم وقواتهم مجتمعة بعد أن صدر لهم الأمر بتسريحها أو تفريقها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_81_19660608_OpEnact_3036ab19be> ;
