<https://legal.dz/resource/order/1966-06-08/66-156#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:residence_restriction ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_1_sec_3> ;
    dzdoc:eId "art_11" ;
    dzdoc:fullText "تحديد الإقامة هو إلزام المحكوم عليه بأن يقيم في نطاق إقليمي يعينه الحكم لمدة لا تتجاوز خمس (5) سنوات . يبدأ تنفيذ تحديد الإقامة من يوم انقضاء العقوبة الأصلية أو الإفراج عن المحكوم عليه. يبلغ الحكم إلى وزارة الداخلية التي يمكنها أن تصدر رخصا مؤقتة للتنقل خارج المنطقة المنصوص عليها في الفقرة السابقة. يعاقب الشخص الذي يخالف أحد تدابير تحديد الإقامة بالحبس من ثلاثة (3) أشهر إلى (3) سنوات وبغرامة من 25.000 دج إلى 300.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_11> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_11_defocc_20a6705e9050> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_11_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_11_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_11_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_11_para_3> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_11_19660608_OpEnact_ea052f5011> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_11_obligation_0_4542912e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "11" ;
    dzdoc:position 19 ;
    dzdoc:usesTerm dzterm:interior_ministry .

<https://legal.dz/resource/order/1966-06-08/66-156#art_161> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_5> ;
    dzdoc:eId "art_161" ;
    dzdoc:fullText "كل شخص مكلف يتخلى إما شخصيا أو كعضو في شركة توريد أو مقاولات أو وكالات تعمل لحساب الجيش الوطني الشعبي ، عن القيام بالخدمات التي عهدت إليه ما لم تكرهه على ذلك قوة قاهرة ، يعاقب بالسجن من خمس سنوات إلى عشر سنوات وبغرامة لا يتجاوز مقدارها ربع التعويضات المدنية، ولا تقل عن مبلغ 2.000 دج، كل ذلك دون الإخلال بتطبيق العقوبات الأشد في حالة المخابرة مع العدو. ويحكم على متعهدي التموين أو عملائهم أيضا بهذه العقوبات عند مشاركتهم في الجريمة. ويعاقب الموظفون أو الوكلاء والمندوبون أو المأجورون من الدولة الذين حضروا أو ساعدوا الجناة على التخلف عن القيام بخدماتهم، بالسجن من عشر سنوات إلى عشرين سنة، دون الإخلال بتطبيق العقوبات الأشد في حالة المخابرة مع العدو."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_161> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_161_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_161_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_161_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_161_19660608_OpEnact_9e77f7cbeb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_161_obligation_0_2991aed7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "161" ;
    dzdoc:position 236 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_161_condition_0_b6e463a6> ;
    dzdoc:usesTerm dzterm:anp .

<https://legal.dz/resource/order/1966-06-08/66-156#art_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_1_sec_3> ;
    dzdoc:eId "art_17" ;
    dzdoc:fullText "منع الشخص الاعتباري من الاستمرار في ممارسة نشاطه يقتضي أن لا يستمر هذا النشاط حتى ولو كانت تحت اسم آخر أو مع مديرين أو أعضاء مجلس إدارة أو مسيرين آخرين ويترتب على ذلك تصفية أمواله مع المحافظة على حقوق الغير حسن النية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_17_right_0_ab7d72ae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_17> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_17_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_17_19660608_OpEnact_cde1466caf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_17_obligation_0_94af8a1e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "17" ;
    dzdoc:position 35 ;
    dzdoc:usesTerm dzterm:legal_person .

<https://legal.dz/resource/order/1966-06-08/66-156#art_180> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_1> ;
    dzdoc:eId "art_180" ;
    dzdoc:fullText "فيما عدا الحالات المنصوص عليها في المادتين 42 و 91 فقرات 2 و 3 و 4 كل من أخفى عمدا شخصا يعلم أنه ارتكب جناية أو أن العدالة تبحث عنه بسبب هذا الفعل وكل من حال عمدا دون القبض على الجاني أو البحث عنه أو شرع في ذلك وكل من ساعده على الاختفاء أو الهرب يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 1.000 إلى 10.000 دينار أو بإحدى هاتين العقوبتين . ولا تطبق أحكام الفقرة السابقة على أقارب وأصهار الجاني لغاية الدرجة الرابعة فيما عدا ما يتعلق بالجنايات التي ترتكب ضد القصر الذين لا تجاوز سنهم 13 سنة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_180> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_180_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_180_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_180_19660608_OpEnact_6a5b1a8439> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_180_obligation_0_e715de0b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 180" ;
    dzdoc:position 260 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_42>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_91> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_42>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_91> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_180_condition_0_b6aa4a2f> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_187> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_2> ;
    dzdoc:eId "art_187" ;
    dzdoc:fullText "كل من يعترض بطريق الاعتداء على تنفيذ أعمال أمرت أو رخصت بها السلطة العمومية يعاقب بالحبس من ثلاثة أشهر إلى سنة وبغرامة لا تتجاوز ربع التعويضات المدنية ولا تقل عن 1.000 دج . وكل من يعترض بطريق التجمهر أو التهديد أو العنف على تنفيذ هذه الأعمال يعاقب بالحبس من ثلاثة أشهر إلى سنتين وبالغرامة المنصوص عليها في الفقرة السابقة أعلاه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_187> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_187_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_187_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_187_19660608_OpEnact_3f08695c67> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_187_obligation_0_09aefbeb>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_187_obligation_1_6e4da171> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "187" ;
    dzdoc:position 267 ;
    dzdoc:usesTerm dzterm:السلطة_العمومية .

<https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_1_bis> ;
    dzdoc:eId "art_18_bis_3" ;
    dzdoc:fullText "عندما يعاقب شخص معنوي بواحدة أو أكثر من العقوبات التكميلية المنصوص عليها في المادة 18 مكرر ، فإن خرق الالتزامات المترتبة على هذا الحكم من طرف شخص طبيعي يعاقب عليه بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج. ويمكن كذلك التصريح بقيام المسؤولية الجزائية للشخص المعنوي عن الجريمة المذكورة أعلاه، وذلك حسب الشروط المنصوص عليها في المادة 51 مكرر ، ويتعرض في هذه الحالة إلى عقوبة الغرامة حسب الكيفيات المنصوص عليها في المادة 18 مكرر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_18_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_3_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_3_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_18_bis_3_19660608_OpEnact_3cc4d1eb66> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_3_obligation_0_ad4683c9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "18 مكرر 3" ;
    dzdoc:position 40 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_3_condition_0_8c070d5d>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_3_condition_1_bd8093fd> ;
    dzdoc:usesTerm dzterm:legal_entity .

<https://legal.dz/resource/order/1966-06-08/66-156#art_217> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_3> ;
    dzdoc:eId "art_217" ;
    dzdoc:fullText "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 1.000 دينار كل شخص ليس طرفا في المحرر أدلى أمام الموظف العمومي بتقرير يعلم أنه غير مطابق للحقيقة . ذلك فإنه يستفيد من العذر المعفي بالشروط المنصوص عليها في المادة 52 كل من أدلى بوصفه شاهدا أمام بإقرار غير مطابق للحقيقة ثم عدل عنه قبل أن يترتب على استعمال المحرر أي ضرر للغير ومع الموظف العمومي وقبل أن يكون هو نفسه موضوعا للتحقيق ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_217_right_0_606f6e01> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_217> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_217_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_217_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_217_19660608_OpEnact_061ae541a7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_217_obligation_0_55182525> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "217" ;
    dzdoc:position 300 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_52> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_52> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_217_condition_0_366307b8> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_22> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:judicial_placement ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_2> ;
    dzdoc:eId "art_22" ;
    dzdoc:fullText "الوضع القضائي في مؤسسة علاجية هو وضع شخص مصاب بإدمان اعتيادي ناتج عن تعاطي مواد كحولية أو مخدرات أو مؤثرات عقلية، تحت الملاحظة في مؤسسة مهيأة لهذا الغرض، وذلك بناء على أمر أو حكم أو قرار قضائي صادر من الجهة المحال إليها الشخص إذا بدا أن السلوك الإجرامي للمعني مرتبط بهذا الإدمان. يمكن أن يصدر الأمر بـ الوضع القضائي في مؤسسة علاجية طبقا للشروط المنصوص عليها في المادة 21 (الفقرة 2). تجوز مراجعة الوضع القضائي في مؤسسة علاجية ، بالنظر إلى تطور الخطورة الإجرامية للمعني، وفقا للإجراءات والكيفيات المنصوص عليها في التشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_22_permission_0_462ae982> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_22> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_22_defocc_71173a94632e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_22_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_22_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_22_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_22_19660608_OpEnact_ef0b2e1a1f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 22" ;
    dzdoc:position 44 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_21> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_21> ;
    dzdoc:usesTerm dzterm:judicial_placement .

<https://legal.dz/resource/order/1966-06-08/66-156#art_222> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_5> ;
    dzdoc:eId "art_222" ;
    dzdoc:fullText "كل من قلد أو زور أو زيف رخصا أو شهادات أو كتابات أو بطاقات أو نشرات أو إيصالات أو جوازات سفر أو أوامر خدمة أو وثائق سفر أو تصاريح مرور أو غيرها من الوثائق التي تصدرها الإدارات العمومية بغرض إثبات حق أو شخصية أو صفة أو منح إذن يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة من 1.500 إلى 15.000 دينار. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 من سنة على الأقل إلى خمس سنوات على الأكثر. ويعاقب على الشروع بمثل ما يعاقب به على الجريمة التامة . تطبق العقوبات ذاتها على : من استعمل الوثائق المقلدة أو المزورة أو المزيفة المذكورة مع علمه بذلك. من استعمل إحدى الوثائق المشار إليها في الفقرة الأولى مع علمه أن البيانات المدونة بها أصبحت غير كاملة أو غير صحيحة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_222> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_222_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_222_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_222_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_222_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_222_19660608_OpEnact_579dcefee3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 222" ;
    dzdoc:position 305 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_227> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_5> ;
    dzdoc:eId "art_227" ;
    dzdoc:fullText "كل من حرر باسم أحد الموظفين أو أحد القائمين بوظيفة عمومية دون أن تكون له صفة في ذلك شهادة بحسن السلوك أو بالفقر أو بإثبات غير ذلك من الظروف التي من شأنها أن تدعو إلى وضع الشخص المعين في هذه الشهادة تحت رعاية السلطات أو الأفراد أو إلى حصوله على عمل أو قرض أو معونة يعاقب بالحبس من ستة أشهر إلى سنتين. وتطبق العقوبات ذاتها على : من زور شهادة كانت أصلا صحيحة وذلك ليجعلها تنطبق على غير الشخص الذي صدرت أصلا له. من استعمل الشهادة وهي مصطنعة أو مزورة على هذه الصورة. وإذا كانت الشهادة منسوبة إلى أحد الأفراد العاديين فإن اصطناعها أو استعمالها يعاقب عليه بالحبس من شهر إلى ستة أشهر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_227> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_227_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_227_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_227_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_227_19660608_OpEnact_8f06e795f0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_227_obligation_0_97a66c0e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "227" ;
    dzdoc:position 310 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_227_condition_0_0e311931> ;
    dzdoc:usesTerm dzterm:employee .

<https://legal.dz/resource/order/1966-06-08/66-156#art_270> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_270" ;
    dzdoc:fullText "إذا نتج عن الضرب أو الجرح أو العنف أو التعدي أو الحرمان المشار إليه في المادة السابقة مرض أو عدم القدرة على الحركة أو عجز كلي عن العمل لأكثر من خمسة عشر يوما، أو إذا وجد سبق إصرار، أو ترصد فتكون العقوبة الحبس من ثلاث إلى عشر سنوات والغرامة من 500 إلى 6.000 دج. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من الحقوق الواردة في المادة 14 من هذا القانون وبالمنع من الإقامة من سنة على الأقل إلى خمس سنوات على الأكثر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_270> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_270_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_270_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_270_19660608_OpEnact_c1bd5b54e7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 270" ;
    dzdoc:position 358 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_269> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_269> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_270_condition_0_83343a3a> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_290> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_3> ;
    dzdoc:eId "art_290" ;
    dzdoc:fullText "تضاعف العقوبات المنصوص عليها في المادتين 288 و 289 إذا كان مرتكب الجنحة في حالة سكر أو حاول التهرب من المسؤولية الجنائية أو المدنية التي يمكن أن تقع عليه وذلك بالفرار أو بتغيير حالة الأماكن أو بأية طريقة أخرى ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_290_permission_0_e49fcf60> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_290> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_290_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_290_19660608_OpEnact_ae0f173b7c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_290_obligation_0_31e9d4be> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 290" ;
    dzdoc:position 379 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_288>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_289> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_288>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_289> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_290_condition_0_dfe686c0> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_1_sec_2> ;
    dzdoc:eId "art_30" ;
    dzdoc:fullText "كل محاولات لارتكاب جناية تبتدئ بالشروع في التنفيذ أو بأفعال لا لبس فيها تؤدي مباشرة إلى ارتكابها تعتبر كالجناية نفسها إذا لم توقف أو لم يخب أثرها إلا نتيجة لظروف مستقلة عن إرادة مرتكبها حتى ولو لم يمكن بلوغ الهدف المقصود بسبب ظرف مادي يجهله مرتكبها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_30_permission_0_e69bf1e6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_30> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_30_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_30_19660608_OpEnact_a0be19ca27> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 30" ;
    dzdoc:position 52 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_30_condition_0_636a0073>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_30_condition_1_3fbdc276> ;
    dzdoc:usesTerm dzterm:felony .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis_1> ;
    dzdoc:eId "art_303_bis_20" ;
    dzdoc:fullText "يعاقب على الجرائم المنصوص عليها في المادتين 303 مكرر 18 و 303 مكرر 19 ، بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.500.000 دج، إذا ارتكبت الجريمة مع توافر أحد الظروف الآتية : إذا كانت الضحية قاصرا أو شخصا مصابا بإعاقة ذهنية، إذا سهلت وظيفة الفاعل أو مهنته ارتكاب الجريمة، إذا ارتكبت الجريمة من طرف أكثر من شخص، إذا ارتكبت الجريمة مع حمل السلاح أو التهديد باستعماله، إذا ارتكبت الجريمة من طرف جماعة إجرامية منظمة أو كانت ذات طابع عابر للحدود الوطنية. ويعاقب بالسجن من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج، على ارتكاب الجرائم المنصوص عليها في المادتين 303 مكرر 16 و 303 مكرر 17 ، إذا ارتكبت الجريمة مع توافر أحد الظروف المنصوص عليها في الفقرة الأولى من هذه المادة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_20> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_20_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_20_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_20_19660608_OpEnact_5ea7ee56c3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_20_obligation_0_dfac1964>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_20_obligation_1_67cd3b40> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 20" ;
    dzdoc:position 420 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_16>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_17>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_18>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_19> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_16>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_17>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_18>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_19> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis_1> ;
    dzdoc:eId "art_303_bis_24" ;
    dzdoc:fullText "يعفى من العقوبة المقررة كل من يبلغ السلطات الإدارية أو القضائية عن جريمة الاتجار بالأعضاء قبل البدء في تنفيذها أو الشروع فيها . وتخفض العقوبة إلى النصف إذا تم الإبلاغ بعد انتهاء تنفيذ الجريمة أو الشروع فيها وقبل تحريك الدعوى العمومية أو إذا مكن بعد تحريك الدعوى العمومية من إيقاف الفاعل الأصلي أو الشركاء في نفس الجريمة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_24_right_0_13e4b18b>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_24_right_1_97149f1e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_24_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_24_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_24_19660608_OpEnact_735c6b2c92> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 24" ;
    dzdoc:position 424 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_24_condition_0_8a62c8cf>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_24_condition_1_813dc5d8> ;
    dzdoc:usesTerm dzterm:organ_trafficking .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis_2> ;
    dzdoc:eId "art_303_bis_32" ;
    dzdoc:fullText "يعاقب على تهريب المهاجرين بالسجن من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج إذا ارتكب مع توافر أحد الظروف الآتية : إذا سهلت وظيفة الفاعل ارتكاب الجريمة ، إذا ارتكبت الجريمة من طرف أكثر من شخص ، إذا ارتكبت الجريمة بحمل السلاح أو التهديد باستعماله ، إذا ارتكبت الجريمة من طرف جماعة إجرامية منظمة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_32> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_32_19660608_OpEnact_d69e1d4a9f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 32" ;
    dzdoc:position 432 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32_condition_0_3a943368>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32_condition_1_64b034b4>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32_condition_2_5994863c>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32_condition_3_3e157914>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_32_condition_4_a7f674be> ;
    dzdoc:usesTerm dzterm:human_smuggling .

<https://legal.dz/resource/order/1966-06-08/66-156#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "في حالة تعدد جنايات أو جنح محالة معا إلى محكمة واحدة فإنه يقضي بعقوبة واحدة سالبة للحرية و لا يجوز أن تجاوز مدتها الحد الأقصى للعقوبة المقررة قانونا للجريمة الأشد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_34_permission_0_cdf2bc76> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_34_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_34_19660608_OpEnact_5b50aa690e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_34_obligation_0_2b9e9b06> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 34" ;
    dzdoc:position 56 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_34_condition_0_f23f4a80> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_343> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_7> ;
    dzdoc:eId "art_343" ;
    dzdoc:fullText "يعاقب بالحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 20.000 دج وما لم يكن الفعل المقترف جريمة أشد ، كل من ارتكب عمدا أحد الأفعال الآتية : ساعد أو عاون أو حمى دعارة الغير أو أغرى الغير على الدعارة وذلك بأية طريقة كانت. أقتسم متحصلات دعارة الغير أو تلقى معونة من شخص يحترف الدعارة عادة أو يستغل هو نفسه موارد دعارة الغير وذلك على أية صورة كانت. عاش مع شخص يحترف الدعارة عادة. عجز عن تبرير الموارد التي تتفق وطريقة معيشته حالة أنه على علاقات معتادة مع شخص أو أكثر من الذين يحترفون الدعارة . استخدم أو استدرج أو أعال شخصا ولو بالغا بقصد ارتكاب الدعارة ولو برضاه أو أغواه على احتراف الدعارة أو الفسق . قام بالوساطة بأية صفة كانت بين أشخاص يحترفون الدعارة أو الفسق وبين أفراد يستغلون دعارة أو فسق الغير أو يكافئون الغير عليه. عرقل أعمال الوقاية أو الإشراف أو المساعدة والتأهيل التي تقوم بها منظمات متخصصة لصالح أشخاص يحترفون الدعارة أو يخشى عليهم من احترافها وذلك بطريق التهديد أو الضغط أو التحايل أو بأية وسيلة أخرى. ويعاقب على الشروع في ارتكاب الجنح المشار إليها في هذه المادة بالعقوبات ذاتها المنصوص عليها بالنسبة لتلك الجنح.(1)"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_343> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_343_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_343_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_343_19660608_OpEnact_313cae600c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "343" ;
    dzdoc:position 489 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_343> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_343> ;
    dzdoc:usesTerm dzterm:debauchery,
        dzterm:prostitution .

<https://legal.dz/resource/order/1966-06-08/66-156#art_347> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_7> ;
    dzdoc:eId "art_347" ;
    dzdoc:fullText "يعاقب بالحبس من ستة أشهر إلى سنتين وبغرامة من 1.000 إلى 20.000 دج كل من قام علنا بإغراء أشخاص من أي من الجنسين بقصد تحريضهم على الفسق وذلك بالإشارة والأقوال أو الكتابات أو بأية وسيلة أخرى. ويعاقب على الشروع بالعقوبات ذاتها المقررة للجريمة التامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_347> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_347_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_347_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_347_19660608_OpEnact_b252d8033f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_347_obligation_0_9d208a16>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_347_obligation_1_f162f446> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "347" ;
    dzdoc:position 493 ;
    dzdoc:usesTerm dzterm:debauchery .

<https://legal.dz/resource/order/1966-06-08/66-156#art_386> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_5> ;
    dzdoc:eId "art_386" ;
    dzdoc:fullText "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 2.000 إلى 20.000 دج كل من انتزع عقارا مملوكا للغير وذلك خلسة أو بطرق التدليس . وإذا كان انتزاع الملكية قد وقع ليلا بالتهديد أو العنف أو بطريقة التسلق أو الكسر من عدة أشخاص أو مع حمل سلاح ظاهر أو مخبأ بواسطة واحد أو أكثر من الجناة فتكون العقوبة الحبس من سنتين إلى عشر سنوات والغرامة من 10.000 دج إلى 30.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_386> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_386_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_386_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_386_19660608_OpEnact_910c90fc3d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_386_obligation_0_a9555dc8>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_386_obligation_1_6dd02fd7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "386" ;
    dzdoc:position 541 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_386_condition_0_7c3009d5>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_386_condition_1_a4d5b911> ;
    dzdoc:usesTerm dzterm:property_seizure .

<https://legal.dz/resource/order/1966-06-08/66-156#art_444> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_444" ;
    dzdoc:fullText "يعاقب بالحبس من عشرة أيام على الأقل إلى شهرين على الأكثر وبغرامة من 100 إلى 1.000 دج أو بإحدى العقوبتين : 1 - كل من اقتلع أو خرب أو قطع أو قشر شجرة لإهلاكها مع علمه أنها مملوكة للغير وكل من أتلف طعما وكل من قطع حشائش أو بذورا ناضجة أو خضراء مع علمه أنها مملوكة للغير . 2 - كل من أغرق الطرق أو أملاك الغير وذلك برفعه مصب مياه المطاحن أو المصانع أو المستنقعات عن منسوب الارتفاع الذي تحدده السلطة المختصة . 3 - كل من أرسل إلى شخص أي شيء مصحوب وبرسالة يذكر فيها أنه في إمكانه قبول مقابل دفع ثمنه المحدد أو إعادته إلى مرسله حتى ولو لم تكن إعادته على نفقة المرسل إليه وذلك متى لم يكن الأخير قد سبق له أن طلبه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_444> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_444_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_444_19660608_OpEnact_495b1921ed> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_444_obligation_0_723c2f48> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "444" ;
    dzdoc:position 632 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_444_condition_0_70eb49cd>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_444_condition_1_70eb49cd>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_444_condition_2_53538884> ;
    dzdoc:usesTerm dzterm:authority .

<https://legal.dz/resource/order/1966-06-08/66-156#art_444_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_1_sec_1_subsec_6> ;
    dzdoc:eId "art_444_bis" ;
    dzdoc:fullText "يعاقب بغرامة من 100 إلى 1.000 دج كما يجوز أن يعاقب بالحبس من عشرة أيام إلى شهرين كل من يعيق الطريق العام بأن يضع أو يترك فيها دون ضرورة مواد أو أشياء كيفما كانت من شأنها أن تمنع أو تنقص من حرية المرور أو تجعل المرور غير مأمون ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_444_bis_permission_0_0134d519> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_444_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_444_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_444_bis_19660608_OpEnact_1e031475b5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_444_bis_obligation_0_c900dc1e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "444 مكرر" ;
    dzdoc:position 633 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_444_bis_condition_0_0f264c7a> ;
    dzdoc:usesTerm dzterm:public_road .

<https://legal.dz/resource/order/1966-06-08/66-156#art_450> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_2_sec_1_subsec_5> ;
    dzdoc:eId "art_450" ;
    dzdoc:fullText "يعاقب بغرامة من 100 إلى 500 دج ويجوز أن يعاقب أيضا بالحبس لمدة عشرة أيام على الأكثر : 1 - كل من قام بكتابات أو وضع علامات أو رسوم بأية طريقة كانت وبغير إذن من السلطات الإدارية على أموال منقولة أو عقارية مملوكة للدولة أو المجموعات المحلية أو على مال واقع في أملاك أي منهما أو بغرض تسيير خدمة عمومية أو لأنها موضوعة تحت تصرف الجمهور. 2 - كل من قام بكتابات أو وضع علامات أو رسوم على عقار بأية وسيلة كانت دون أن يكون مالكا أو مستأجرا له أو منتفعا به وبغير إذن من أي من هؤلاء الأشخاص. 3 - كل من أتلف خنادق أو أسوارا أو قطع فروعا من سياج أخضر أو نزع أخشاب جافة منه. 4 - كل من تسبب عمدا في الإضرار بممتلكات منقولة للغير وذلك في غير الحالات المنصوص عليها في المواد من 395 حتى المادة 417 . 5 - كل من سرق محصولات أو غيرها من المنتجات الصالحة من الحقل وكانت غير منفصلة عن الأرض قبل سرقتها وذلك بشرط عدم قيام أي ظرف من الظروف المنصوص عليها في المادة 361 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_450> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_450_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_450_19660608_OpEnact_e26920b52c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_450_obligation_0_b718f5d6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "450" ;
    dzdoc:position 639 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_361>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_395>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_417> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_361>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_395>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_417> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_450_condition_0_6cbad082> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_454> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_454" ;
    dzdoc:fullText "تضبط وتصادر طبقا لأحكام المادتين 15 و 16 : الأشياء المشتراة أو المرتهنة طبقا للشروط المنصوص عليها في الفقرة الرابعة من المادة 453 وذلك ما لم يعثر على مالكها الحقيقي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_454> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_454_para_0>,
