<https://legal.dz/resource/order/1966-06-08/66-156#version_art_235> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من شهد زورا في المواد المدنية أو الإدارية يعاقب بالحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 2.000 دينار. وإذا قبض شاهد الزور نقودا أو أية مكافأة كانت أو تلقى وعودا فيجوز رفع عقوبة الحبس إلى عشر سنوات والغرامة إلى 4.000 دينار. وتطبق أحكام هذه المادة على شهادة الزور التي ترتكب في دعوة مدنية مرفوعة أمام القضاء الجزائي تبعا لدعوى جزائية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_235_19660608_OpEnact_f26a3b26cf> ;
    dzdoc:replacementText "كل من شهد زورا في المواد المدنية أو الإدارية يعاقب بالحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 2.000 دينار. وإذا قبض شاهد الزور نقودا أو أية مكافأة كانت أو تلقى وعودا فيجوز رفع عقوبة الحبس إلى عشر سنوات والغرامة إلى 4.000 دينار. وتطبق أحكام هذه المادة على شهادة الزور التي ترتكب في دعوة مدنية مرفوعة أمام القضاء الجزائي تبعا لدعوى جزائية."@ar ;
