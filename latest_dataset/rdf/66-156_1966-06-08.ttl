    dznorm:position 0 ;
    dznorm:provisionText "كل حكم عن إحدى الجرائم المنصوص عليها في هذا القسم يستوجب بقوة القانون الحكم بالمنع من ممارسة أية مهنة أو أداء أي عمل بأية صفة كانت في العيادات أو دور الولادة أو في أية مؤسسة عمومية أو خاصة تستقبل عادة نساء في حالة حمل حقيقي أو ظاهر أو مفترض وذلك بأجر أو بغير أجر."@ar ;
    dznorm:sourceArticle "art_311" .

