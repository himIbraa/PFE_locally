    dznorm:provisionText "يعاقب بالسجن المؤقت من عشر سنوات إلى عشرين سنة"@ar ;
    dznorm:sourceArticle "art_71" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_71_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_71> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالسجن المؤقت من عشر سنوات إلى عشرين سنة كل من : يعرض الجزائر لإعلان الحرب بإتيانه أعمالا عدوانية لا تقرها الحكومة. يعرض الجزائر إلى أعمال انتقامية بإتيانه أعمالا عدوانية لا تقرها الحكومة. يجري مع عملاء دولة أجنبية مخابرات من شأنها الإضرار بالمركز العسكري أو الدبلوماسي للجزائر أو بمصالحها الاقتصادية الجوهرية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_72_condition_0_7ebd6ad7> a dznorm:Condition ;
    dznorm:conditionText "في وقت الحرب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_72> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_72_obligation_0_10624839> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
