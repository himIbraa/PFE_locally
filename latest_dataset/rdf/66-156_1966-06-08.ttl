<https://legal.dz/resource/order/1966-06-08/66-156#art_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_2> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "كل تحريض مباشر على التجمهر غير المسلح سواء بخطب تلقى علنا أو بكتابات أو مطبوعات تعلق أو توزع يعاقب عليه بالحبس من شهرين إلى سنة إذا نتج عنه حدوث أثره وتكون العقوبة الحبس من شهر واحد إلى ستة أشهر وبغرامة من 2.000 إلى 5.000 دينار أو بإحدى هاتين العقوبتين في الحالة العكسية . كل تحريض مباشر بنفس الوسائل على التجمهر المسلح يعاقب عليه بالحبس من سنة إلى خمس سنوات إذا نتج عنه حدوث أثره . وتكون العقوبة الحبس من ثلاثة أشهر إلى سنة وبغرامة من 2.000 إلى 10.000 دينار أو بإحدى هاتين العقوبتين في الحالة العكسية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_100> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_100_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_100_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_100_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_100_19660608_OpEnact_1e06abc062> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_100_obligation_0_12d9a941>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_100_obligation_1_997afe98>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_100_obligation_2_795edbdd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "100" ;
    dzdoc:position 157 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_102> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_102" ;
    dzdoc:fullText "إذا منع مواطن أو أكثر من ممارسة حق الانتخاب بوسائل التجمهر أو التعدي أو التهديد ، فيعاقب كل واحد من الجناة بالحبس من ستة أشهر على الأقل إلى سنتين على الأكثر وبحرمانه من حق الانتخاب والترشيح لمدة سنة على الأقل وخمس سنوات على الأكثر ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_102_right_0_99ac88b7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_102> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_102_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_102_19660608_OpEnact_f4cb3d880e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_102_obligation_0_9d97d91c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "102" ;
    dzdoc:position 159 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_102_condition_0_9d8f13c0> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "كل عون في مؤسسة إعادة التربية أو في مكان مخصص بحراسة المقبوض عليهم يتسلم مسجونا دون أن يكون مصحوبا بأوامر حبس قانونية أو يرفض تقديم هذا المسجون إلى السلطات أو الأشخاص المخول لهم زيارته بدون أن يثبت وجود منع من القاضي المحقق أو يرفض تقديم سجلاته إلى هؤلاء الأشخاص المختصين ، يكون قد ارتكب جريمة الحجز التحكمي ويعاقب بالحبس مدة من ستة أشهر إلى سنتين وبغرامة من 500 إلى 1.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_110_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_110_19660608_OpEnact_f461bf4064> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_110_obligation_0_15b67e26> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "110" ;
    dzdoc:position 167 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_110_condition_0_6e074122> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_139> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_139" ;
    dzdoc:fullText "ويعاقب الجاني فضلا عن ذلك بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وذلك من خمس سنوات على الأقل إلى عشر سنوات على الأكثر. كما يجوز أن يحرم من ممارسة كافة الوظائف أو كافة الخدمات العمومية لمدة عشر سنوات على الأكثر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_139_permission_0_53b81af2> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_139_right_0_5148c125> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_139> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_139_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_139_19660608_OpEnact_5a5543c908> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "139" ;
    dzdoc:position 204 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_144_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_144_bis" ;
    dzdoc:fullText "يعاقب بغرامة من 100.000 دج إلى 500.000 دج ، كل من أساء إلى رئيس الجمهورية بعبارات تتضمن إهانة أو سبا أو قذفا سواء كان ذلك عن طريق الكتابة أو الرسم أو التصريح أو بأية آلية لبث الصوت أو الصورة أو بأية وسيلة إلكترونية أو معلوماتية أو إعلامية أخرى. تباشر النيابة العامة إجراءات المتابعة الجزائية تلقائيا . وفي حالة العود ، تضاعف الغرامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_144_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_144_bis_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_144_bis_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_144_bis_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_144_bis_19660608_OpEnact_6dd040ad16> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_144_bis_obligation_0_7db57ed6>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_144_bis_obligation_1_118a8fdd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "144 مكرر" ;
    dzdoc:position 210 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_144_bis_condition_0_f24439c6> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/order/1966-06-08/66-156#art_158> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_3> ;
    dzdoc:eId "art_158" ;
    dzdoc:fullText "يعاقب بالسجن من خمس إلى عشر سنوات كل من يتلف أو يشوه أو يبدد أو ينتزع عمدا أوراقا أو سجلات أو عقودا أو سندات محفوظة في المحفوظات أو أقلام الكتاب أو المستودعات العمومية أو مسلمة إلى أمين عمومي بهذه الصفة . وإذا وقع الإتلاف أو التشويه أو التبديد أو الانتزاع من الأمين العمومي أو بطريق العنف ضد الأشخاص فيكون السجن من عشر سنوات إلى عشرين سنة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_158> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_158_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_158_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_158_19660608_OpEnact_af9c94ff02> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_158_obligation_0_63dd2733> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 158" ;
    dzdoc:position 226 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_158_condition_0_1e481198> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_1_sec_3> ;
    dzdoc:eId "art_16_bis_2" ;
    dzdoc:fullText "يترتب على عقوبة الإقصاء من الصفقات العمومية منع المحكوم عليه من المشاركة بصفة مباشرة أو غير مباشرة في أية صفقة عمومية ، إما نهائيا أو لمدة لا تزيد عن عشر (10) سنوات في حالة الإدانة لارتكاب جناية، وخمس (5) سنوات في حالة الإدانة لارتكاب جنحة. ويجوز أن يؤمر بالنفاذ المعجل بالنسبة لهذا الإجراء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_2_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_2_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_2_19660608_OpEnact_e6472965f2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_2_obligation_0_c14c119b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "16 مكرر 2" ;
    dzdoc:position 30 ;
    dzdoc:usesTerm dzterm:exclusion_from_public_procurement .

<https://legal.dz/resource/order/1966-06-08/66-156#art_209> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_2> ;
    dzdoc:eId "art_209" ;
    dzdoc:fullText "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 10.000 دينار كل من : قلد العلامات المعدة لوضعها باسم الحكومة أو أي مرفق عام على مختلف أنواع السلع أو البضائع أو استعمل هذه العلامات المزورة. قلد خاتما أو طابعا أو علامة لأية سلطة أو استعمل الخاتم أو الطابع أو العلامة المقلدة. قلد الأوراق المعنونة أو المطبوعات الرسمية المستعملة في الأجهزة الرئيسية للدولة أو في الإدارات العمومية أو في مختلف جهات القضاء أو باعها أو روجها أو وزعها أو استعمل هذه الأوراق أو المطبوعات المقلدة. قلد أو زور طوابع البريد أو بصمات التخليص أو قسائم الرد التي تصدرها إدارة البريد أو الطوابع المالية المنفصلة أو الأوراق أو النماذج المدموغة أو باع أو روج أو وزع أو استعمل الطوابع أو العلامات أو قسائم الرد أو الأوراق أو النماذج المدموغة المذكورة وهي مقلدة أو مزورة مع علمه بذلك. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة من سنة إلى خمس سنوات على الأكثر. ويعاقب على الشروع في الجرائم المبينة أعلاه كالجريمة التامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_209> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_209_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_209_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_209_19660608_OpEnact_75e9111339> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_209_obligation_0_6136049f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 209" ;
    dzdoc:position 292 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_220> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_4> ;
    dzdoc:eId "art_220" ;
    dzdoc:fullText "كل شخص ارتكب تزويرا بإحدى الطرق المنصوص عليها في المادة 216 في محررات عرفية أو شرع في ذلك يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 2.000 دينار . ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة من سنة إلى خمس سنوات على الأكثر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_220> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_220_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_220_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_220_19660608_OpEnact_47f2b973d0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_220_obligation_0_34d93535> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 220" ;
    dzdoc:position 303 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_216> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_216> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_231> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_6> ;
    dzdoc:eId "art_231" ;
    dzdoc:fullText "يحكم على الجناة بغرامة يكون حدها الأدنى 500 دينار والأقصى 15.000 دينار ومع ذلك يجوز زيادة الغرامة إلى مقدار ربع الفائدة غير المشروعة التي جلبها التزوير إلى مرتكبي الجناية أو الجنحة وإلى شركائهم أو من استعملوا القطعة المزيفة أو التي كان مقررا أن يجلبها التزوير إليهم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_231_permission_0_7c4a317d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_231> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_231_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_231_19660608_OpEnact_da22ce8a7f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_231_obligation_0_855d5204> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 231" ;
    dzdoc:position 315 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_231_condition_0_7e431d3f> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_252> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_8> ;
    dzdoc:eId "art_252" ;
    dzdoc:fullText "يعاقب بالحبس من شهر إلى ستة أشهر وبغرامة من 500 إلى 50.000 دينار أو بإحدى هاتين العقوبتين مؤسسو أو مديرو أو مسيرو الشركات أو المؤسسات ذات الغرض التجاري أو الصناعي أو المالي الذين يضعون اسم أحد أعضاء الحكومة أو إحدى الهيئات النيابية مع ذكر صفته في أية دعاية يقومون بها لصالح المشروع الذي يديرونه أو يزمعون إنشاءه أو يتركون الغير يفعل شيئا من ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_252> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_252_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_252_19660608_OpEnact_ed98481543> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_252_obligation_0_1ee8bdc7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "252" ;
    dzdoc:position 336 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_252_condition_0_72812031> ;
    dzdoc:usesTerm dzterm:directors,
        dzterm:founders,
        dzterm:managers .

<https://legal.dz/resource/order/1966-06-08/66-156#art_263_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_263_bis_1" ;
    dzdoc:fullText "يعاقب بالسجن المؤقت من خمس (5) سنوات إلى عشرة (10) سنوات وبغرامة من 100.000 دج إلى 500.000 دج كل من يمارس أو يحرض أو يأمر بممارسة التعذيب على شخص . يعاقب على التعذيب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 150.000 دج إلى 800.000 دج ، إذا سبق أو صاحب أو تلى جناية غير القتل العمد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_263_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_263_bis_1_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_263_bis_1_19660608_OpEnact_b29b895f29> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_263_bis_1_obligation_0_73536473>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263_bis_1_obligation_1_36bfaf5b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "263 مكرر 1" ;
    dzdoc:position 350 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_263_bis_1_condition_0_873f030b> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_265> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_265" ;
    dzdoc:fullText "إذا وجد سبق إصرار أو ترصد فإن العقوبة تكون السجن المؤبد إذا حدثت الوفاة ، وتكون السجن المؤقت من عشر سنوات إلى عشرين سنة إذا أدت أعمال العنف إلى فقد أو بتر أحد الأعضاء أو الحرمان من استعماله أو فقد البصر أو فقد إبصار إحدى العينين أو أية عاهة مستديمة أخرى وتكون السجن المؤقت من خمس إلى عشر سنوات في الحالة المنصوص عليها في الفقرة الأولى من المادة 264 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_265> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_265_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_265_19660608_OpEnact_7256fd5e05> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_265_obligation_0_0ca58d35> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 265" ;
    dzdoc:position 353 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_264> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_264> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_265_condition_0_9a6b43f2> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_272> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_272" ;
    dzdoc:fullText "إذا كان الجناة هم أحد الوالدين الشرعيين أو غيرهما من الأصول الشرعيين أو أي شخص آخر له سلطة على الطفل أو يتولى رعايته فيكون عقابهم كما يلي : 1) بالعقوبات الواردة في المادة 270 وذلك في الحالة المنصوص عليها في المادة 269 . 2) بالسجن المؤقت من خمس إلى عشر سنوات وذلك في الحالة المنصوص عليها في المادة 270 . 3) بالسجن المؤبد وذلك في الحالات المنصوص عليها في الفقرتين 1 و 2 من المادة 271 . 4) بالإعدام وذلك في الحالات المنصوص عليها في الفقرتين 3 و 4 من المادة 271 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_272> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_272_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_272_19660608_OpEnact_21f693022d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 272" ;
    dzdoc:position 360 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_269>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_270>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_271>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_271__para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_271__para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_271__para_3>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_271__para_4> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_269>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_270>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_271>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_271__para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_271__para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_271__para_3>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_271__para_4> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_272_condition_0_c201c7b8> ;
    dzdoc:usesTerm dzterm:death_penalty,
        dzterm:life_imprisonment,
        dzterm:prison_sentence .

<https://legal.dz/resource/order/1966-06-08/66-156#art_274> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_274" ;
    dzdoc:fullText "كل من ارتكب جناية الخصاء يعاقب بالسجن المؤبد . ويعاقب الجاني بالإعدام إذا أدت إلى الوفاة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_274> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_274_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_274_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_274_19660608_OpEnact_280b8eeaf9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 274" ;
    dzdoc:position 362 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_274_condition_0_49464f3e> ;
    dzdoc:usesTerm dzterm:castration,
        dzterm:death_penalty,
        dzterm:life_imprisonment .

<https://legal.dz/resource/order/1966-06-08/66-156#art_283> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_283" ;
    dzdoc:fullText "إذا ثبت قيام العذر فتخفض العقوبة على الوجه الآتي : 1) الحبس من سنة إلى خمس سنوات إذا تعلق الأمر بجناية عقوبتها الإعدام أو السجن المؤبد. 2) الحبس من ستة أشهر إلى سنتين إذا تعلق الأمر بأية جناية أخرى. 3) الحبس من شهر إلى ثلاثة أشهر إذا تعلق الأمر بجنحة. في الحالات المنصوص عليها في الفقرتين 1 و 2 من هذه المادة يجوز أن يحكم أيضا على الجاني بالمنع من الإقامة من خمس سنوات على الأقل إلى عشر سنوات على الأكثر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_283_permission_0_b2313978> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_283> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_283_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_283_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_283_19660608_OpEnact_a961bfd5da> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 283" ;
    dzdoc:position 372 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_283_condition_0_dad3fb02> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_288> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_3> ;
    dzdoc:eId "art_288" ;
    dzdoc:fullText "كل من قتل خطأ تسبب في ذلك برعونته أو عدم احتياطه أو عدم انتباهه أو إهماله أو عدم مراعاته الأنظمة يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة من 1.000 إلى 20.000 دينار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_288> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_288_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_288_19660608_OpEnact_1f19d7508b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_288_obligation_0_674ad321> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 288" ;
    dzdoc:position 377 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_288_condition_0_9434a3cb> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_295> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_4> ;
    dzdoc:eId "art_295" ;
    dzdoc:fullText "كل من يدخل فجأة أو خدعة أو يقتحم منزل مواطن يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 1.000 إلى 10.000 دج . وإذا ارتكبت الجنحة بالتهديد أو بالعنف تكون العقوبة بالحبس من خمس سنوات على الأقل إلى عشر سنوات على الأكثر وبغرامة من 5.000 إلى 20.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_295> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_295_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_295_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_295_19660608_OpEnact_703b6423b4> ;
