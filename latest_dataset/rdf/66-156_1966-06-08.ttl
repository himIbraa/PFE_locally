<https://legal.dz/resource/order/1966-06-08/66-156#version_art_137_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل موظف أو ضابط عمومي سخر أموالا منقولة أو عقارية خارج نطاق الحالات والشروط المحددة قانونا ، يعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 10.000 دج إلى 100.000دج . كما يعد الفاعل مسؤولا مسؤولية مدنية شخصية وتتحمل الدولة كذلك مسؤوليتها المدنية، على أن يكون لها حق الرجوع على الفاعل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_137_bis_19660608_OpEnact_49c59d68dd> ;
