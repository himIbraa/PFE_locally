    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_134> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_134_para_0> ;
