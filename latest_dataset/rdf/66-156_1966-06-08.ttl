    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من شهرين (2) إلى سنة (1) وبغرامة من 25.000 دج إلى 100.000دج"@ar ;
    dznorm:sourceArticle "art_330" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_330_obligation_1_b96a5f31> a dznorm:Obligation ;
