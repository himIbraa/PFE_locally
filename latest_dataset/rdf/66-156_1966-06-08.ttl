<https://legal.dz/resource/order/1966-06-08/66-156#version_art_316> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من ترك طفلا أو عاجزا غير قادر على حماية نفسه بسبب حالته البدنية أو العقلية أو عرضه للخطر في مكان غير خال من الناس أو حمل الغير على ذلك يعاقب لمجرد هذا الفعل بالحبس من ثلاثة أشهر إلى سنة . إذا نشأ عن الترك أو التعريض للخطر مرض أو عجز كلي لمدة تجاوز عشرين يوما فيكون الحبس من ستة أشهر إلى سنتين. وإذا حدث للطفل أو للعاجز بتر أو عجز في أحد الأعضاء أو أصيب بعاهة مستديمة فتكون العقوبة هي الحبس من سنتين إلى خمس سنوات. وإذا أدى ذلك إلى الوفاة فتكون العقوبة هي السجن من خمس إلى عشر سنوات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_316_19660608_OpEnact_034dcb6ca5> ;
    dzdoc:replacementText "كل من ترك طفلا أو عاجزا غير قادر على حماية نفسه بسبب حالته البدنية أو العقلية أو عرضه للخطر في مكان غير خال من الناس أو حمل الغير على ذلك يعاقب لمجرد هذا الفعل بالحبس من ثلاثة أشهر إلى سنة . إذا نشأ عن الترك أو التعريض للخطر مرض أو عجز كلي لمدة تجاوز عشرين يوما فيكون الحبس من ستة أشهر إلى سنتين. وإذا حدث للطفل أو للعاجز بتر أو عجز في أحد الأعضاء أو أصيب بعاهة مستديمة فتكون العقوبة هي الحبس من سنتين إلى خمس سنوات. وإذا أدى ذلك إلى الوفاة فتكون العقوبة هي السجن من خمس إلى عشر سنوات."@ar ;
