    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يجب على القاضي أن يأمر بالحرمان من حق أو أكثر من الحقوق المنصوص عليها أعلاه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> ;
    dzdoc:position 1 ;
    dzdoc:text "في حالة الحكم بعقوبة جنائية، يجب على القاضي أن يأمر بالحرمان من حق أو أكثر من الحقوق المنصوص عليها أعلاه لمدة أقصاها عشر (10) سنوات، تسري من يوم انقضاء العقوبة الأصلية أو الإفراج عن المحكوم عليه."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_condition_0_86af579e> a dznorm:Condition ;
    dznorm:conditionText "في حالة الحكم بعقوبة جنائية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_obligation_0_38898419> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis> ;
    dznorm:position 0 ;
    dznorm:provisionText "تأمر المحكمة وجوبا بالحجر القانوني"@ar ;
    dznorm:sourceArticle "art_9_bis" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis> ;
    dzdoc:position 1 ;
    dzdoc:text "تتم إدارة أمواله طبقا للإجراءات المقررة في حالة الحجر القضائي."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_9_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_9> ;
    dzdoc:position 0 ;
    dzdoc:text "العقوبات التكميلية هي : الحجر القانوني، الحرمان من ممارسة الحقوق الوطنية والمدنية والعائلية، تحديد الإقامة، المنع من الإقامة، المصادرة الجزئية للأموال، المنع المؤقت من ممارسة مهنة أو نشاط، إغلاق المؤسسة، الإقصاء من الصفقات العمومية، الحظر من إصدار الشيكات و/ أو استعمال بطاقات الدفع، تعليق أو سحب رخصة السياقة أو إلغاؤها مع المنع من استصدار رخصة جديدة، سحب جواز السفر، نشر أو تعليق حكم أو قرار الإدانة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis_dup_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis_dup_1> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 300.000 دج ، كل من تعمد المساس بحرمة الحياة الخاصة للأشخاص، بأية تقنية كانت وذلك: بالتقاط أو تسجيل أو نقل مكالمات أو أحاديث خاصة أو سرية، بغير إذن صاحبها أو رضاه. بالتقاط أو تسجيل أو نقل صورة لشخص في مكان خاص، بغير إذن صاحبها أو رضاه."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis_dup_1_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis_dup_1> ;
    dzdoc:position 1 ;
    dzdoc:text "يعاقب على الشروع في ارتكاب الجنحة المنصوص عليها في هذه المادة بالعقوبات ذاتها المقررة للجريمة التامة. ويضع صفح الضحية حدا للمتابعة الجزائية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 300.000 دج ، كل من تعمد المساس بحرمة الحياة الخاصة للأشخاص، بأية تقنية كانت وذلك: بالتقاط أو تسجيل أو نقل مكالمات أو أحاديث خاصة أو سرية، بغير إذن صاحبها أو رضاه. بالتقاط أو تسجيل أو نقل صورة لشخص في مكان خاص، بغير إذن صاحبها أو رضاه."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis> ;
    dzdoc:position 1 ;
    dzdoc:text "يعاقب على الشروع في ارتكاب الجنحة المنصوص عليها في هذه المادة بالعقوبات ذاتها المقررة للجريمة التامة. ويضع صفح الضحية حدا للمتابعة الجزائية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#lifecycle_0d687e31a312> a dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1965-11-16/65-278> ;
    dzdoc:confidenceScore 0.94 ;
    dzdoc:evidenceText "تلغى جميع الأحكام المخالفة لهذا الأمر، الذي يسري مفعوله في تاريخ تطبيق الأمر رقم 65-278 المؤرخ في 22 رجب عام 1385 الموافق 16 نوفمبر سنة 1965 المتضمن التنظيم القضائي المشار إليه والذي ينشر في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 18 صفر عام 1386 الموافق 8 يونيو سنة 1966."@ar ;
    dzdoc:isContradictory false ;
    dzdoc:lifecycleRelationType "repeals" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:ruleId "lifecycle_explicit_repeal_phrase" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_468> .

