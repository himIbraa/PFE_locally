<https://legal.dz/resource/order/1966-06-08/66-156#art_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_1_sec_1> ;
    dzdoc:eId "art_27" ;
    dzdoc:fullText "تقسم الجرائم تبعا لخطورتها إلى جنايات و جنح و مخالفات وتطبق عليها العقوبات المقررة للجنايات أو الجنح أو المخالفات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_27_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_27_19660608_OpEnact_94437ed0a6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 27" ;
    dzdoc:position 49 ;
    dzdoc:usesTerm dzterm:contraventions,
        dzterm:felonies,
        dzterm:misdemeanors,
        dzterm:offenses,
        dzterm:penalties .

<https://legal.dz/resource/order/1966-06-08/66-156#art_282> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_282" ;
    dzdoc:fullText "لا عذر إطلاقا لمن يقتل أباه أو أمه أو أحد أصوله."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_282> ;
