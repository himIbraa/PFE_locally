<https://legal.dz/resource/order/1966-06-08/66-156#version_art_11> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحديد الإقامة هو إلزام المحكوم عليه بأن يقيم في نطاق إقليمي يعينه الحكم لمدة لا تتجاوز خمس (5) سنوات . يبدأ تنفيذ تحديد الإقامة من يوم انقضاء العقوبة الأصلية أو الإفراج عن المحكوم عليه. يبلغ الحكم إلى وزارة الداخلية التي يمكنها أن تصدر رخصا مؤقتة للتنقل خارج المنطقة المنصوص عليها في الفقرة السابقة. يعاقب الشخص الذي يخالف أحد تدابير تحديد الإقامة بالحبس من ثلاثة (3) أشهر إلى (3) سنوات وبغرامة من 25.000 دج إلى 300.000 دج ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_11_19660608_OpEnact_ea052f5011> ;
    dzdoc:replacementText "تحديد الإقامة هو إلزام المحكوم عليه بأن يقيم في نطاق إقليمي يعينه الحكم لمدة لا تتجاوز خمس (5) سنوات . يبدأ تنفيذ تحديد الإقامة من يوم انقضاء العقوبة الأصلية أو الإفراج عن المحكوم عليه. يبلغ الحكم إلى وزارة الداخلية التي يمكنها أن تصدر رخصا مؤقتة للتنقل خارج المنطقة المنصوص عليها في الفقرة السابقة. يعاقب الشخص الذي يخالف أحد تدابير تحديد الإقامة بالحبس من ثلاثة (3) أشهر إلى (3) سنوات وبغرامة من 25.000 دج إلى 300.000 دج ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_11> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_11> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_110> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل عون في مؤسسة إعادة التربية أو في مكان مخصص بحراسة المقبوض عليهم يتسلم مسجونا دون أن يكون مصحوبا بأوامر حبس قانونية أو يرفض تقديم هذا المسجون إلى السلطات أو الأشخاص المخول لهم زيارته بدون أن يثبت وجود منع من القاضي المحقق أو يرفض تقديم سجلاته إلى هؤلاء الأشخاص المختصين ، يكون قد ارتكب جريمة الحجز التحكمي ويعاقب بالحبس مدة من ستة أشهر إلى سنتين وبغرامة من 500 إلى 1.000 دج ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_110_19660608_OpEnact_f461bf4064> ;
    dzdoc:replacementText "كل عون في مؤسسة إعادة التربية أو في مكان مخصص بحراسة المقبوض عليهم يتسلم مسجونا دون أن يكون مصحوبا بأوامر حبس قانونية أو يرفض تقديم هذا المسجون إلى السلطات أو الأشخاص المخول لهم زيارته بدون أن يثبت وجود منع من القاضي المحقق أو يرفض تقديم سجلاته إلى هؤلاء الأشخاص المختصين ، يكون قد ارتكب جريمة الحجز التحكمي ويعاقب بالحبس مدة من ستة أشهر إلى سنتين وبغرامة من 500 إلى 1.000 دج ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_110> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_110> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
