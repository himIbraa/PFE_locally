    dzdoc:position 1 ;
    dzdoc:text "وتطبق ذات العقوبة على من أعار مكانا لحبس أو لحجز هذا الشخص."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_291_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_291> ;
