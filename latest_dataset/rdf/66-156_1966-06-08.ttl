<https://legal.dz/resource/order/1966-06-08/66-156#art_466> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_3> ;
    dzdoc:eId "art_466" ;
    dzdoc:fullText "في مواد المخالفات تحدد أحكام المادة 53 مدى توافر الظروف المخففة وآثارها. أحكام عامة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_466> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_466_para_0>,
