<https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis_obligation_0_4185c6ab_role_0675be6e9f> a dznorm:Role ;
    rdfs:label "فترة أمنية"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "وتطبق في حالة الحكم بعقوبة سالبة للحرية مدتها تساوي أو تزيد عن عشر (10) سنوات، أو تزيد عنها بالنسبة للجرائم التي ورد النص فيها صراحة على فترة أمنية."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis> ;
    dzdoc:position 1 ;
    dzdoc:text "وتطبق في حالة الحكم بعقوبة سالبة للحرية مدتها تساوي أو تزيد عن عشر (10) سنوات، أو تزيد عنها بالنسبة للجرائم التي ورد النص فيها صراحة على فترة أمنية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis> ;
    dzdoc:position 2 ;
    dzdoc:text "تساوي مدة الفترة الأمنية نصف (2/1) مدة العقوبة المحكوم بها، وتكون مدتها عشرين (20) سنة في حالة الحكم بالسجن المؤبد."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis> ;
    dzdoc:position 3 ;
    dzdoc:text "إذا صدر الحكم المتعلق بالفترة الأمنية عن محكمة الجنايات، فإنه يتعين مراعاة القواعد المقررة في أحكام المادة 309 من قانون الإجراءات الجزائية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis> ;
    dzdoc:position 4 ;
    dzdoc:text "بالنسبة للجرائم التي لم ينص القانون فيها صراحة على فترة أمنية، يجوز لجهة الحكم التي تحكم فيها بعقوبة سالبة للحرية مدتها تساوي أو تزيد عن خمس (5) سنوات، أن تحدد فترة أمنية لا يمكن للمحكوم عليه أن يستفيد خلالها من أي تدبير من تدابير تطبيق العقوبة المذكورة في الفقرة الأولى من هذه المادة. ولا يجوز أن تفوق مدة هذه الفترة الأمنية ثلثي (3/2) العقوبة المحكوم بها ، أو عشرين (20) سنة في حالة الحكم بالسجن المؤبد."@ar .

