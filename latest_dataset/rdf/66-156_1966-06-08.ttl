<https://legal.dz/resource/order/1966-06-08/66-156#art_350_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_350_bis_1" ;
    dzdoc:fullText "يعاقب بالحبس من سنتين (2) إلى عشر (10) سنوات وبغرامة من 200.000 دج إلى 1.000.000 دج، كل من سرق أو حاول سرقة ممتلك ثقافي منقول محمي أو معرف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_350_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_350_bis_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_350_bis_1_19660608_OpEnact_9d51cc6daa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 350 مكرر 1" ;
    dzdoc:position 499 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_357> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:climbing ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_357" ;
    dzdoc:fullText "يوصف بالتسلق الدخول إلى المنازل أو المباني أو الأحواش أو حظائر الدواجن أو أية أبنية أو بساتين أو حدائق أو أماكن مسورة وذلك بطريق تسور الحيطان أو الأبواب أو السقوف أو أية أسوار أخرى. والدخول عن طريق مداخل تحت الأرض غير تلك التي أعدت لاستعمالها للدخول يعد ظرفا مشددا كالتسلق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_357> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_357_defocc_9588f897a1c0> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_357_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_357_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_357_19660608_OpEnact_ce338ea1d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 357" ;
    dzdoc:position 508 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_358> a dzdoc:Article ;
