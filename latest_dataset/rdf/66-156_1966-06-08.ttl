<https://legal.dz/resource/order/1966-06-08/66-156#version_art_200> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 300.000 دج، كل من قام بتلوين النقود ذات السعر القانوني في الإقليم الوطني أو في الخارج، بغرض التضليل في نوع معدنها، أو أصدر مثل هذه النقود الملونة أو أدخلها إليه . وتوقع العقوبة ذاتها على من ساهم في تلوين أو إصدار أو إدخال النقود المذكورة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_200_19660608_OpEnact_6db1c78cc9> ;
    dzdoc:replacementText "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 300.000 دج، كل من قام بتلوين النقود ذات السعر القانوني في الإقليم الوطني أو في الخارج، بغرض التضليل في نوع معدنها، أو أصدر مثل هذه النقود الملونة أو أدخلها إليه . وتوقع العقوبة ذاتها على من ساهم في تلوين أو إصدار أو إدخال النقود المذكورة ."@ar ;
