<https://legal.dz/resource/order/1966-06-08/66-156#version_art_164> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "وفي جميع الأحوال المنصوص عليها في هذا القسم لا يجوز تحريك الدعوى العمومية إلا بناء على شكوى من وزير الدفاع الوطني ."@ar ;
    dzdoc:isAuthoritative true ;
