        <https://legal.dz/resource/order/1966-06-08/66-156#art_265_obligation_0_0ca58d35_condition_1> ;
    dznorm:position 0 ;
    dznorm:provisionText "العقوبة تكون السجن المؤبد إذا حدثت الوفاة، وتكون السجن المؤقت من عشر سنوات إلى عشرين سنة إذا أدت أعمال العنف إلى فقد أو بتر أحد الأعضاء أو الحرمان من استعماله أو فقد البصر أو فقد إبصار إحدى العينين أو أية عاهة مستديمة أخرى وتكون السجن المؤقت من خمس إلى عشر سنوات في الحالة المنصوص عليها في الفقرة الأولى من المادة 264"@ar ;
    dznorm:sourceArticle "art_265" .

