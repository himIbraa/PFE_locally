<https://legal.dz/resource/order/1966-06-08/66-156#art_380_obligation_0_06df4a79> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_380> ;
    dznorm:position 0 ;
    dznorm:provisionText "كل من استغل حاجة لقاصر لم يكمل التاسعة عشرة أو ميلا أو هوى أو عدم خبرة فيه ليختلس منه التزامات أو إبراء منها أو أية تصرفات أخرى تشغل ذمته المالية وذلك إضرارا به يعاقب بالحبس من ثلاثة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 10.000 دج."@ar ;
    dznorm:sourceArticle "art_380" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_380_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_380> ;
    dzdoc:position 0 ;
    dzdoc:text "كل من استغل حاجة لقاصر لم يكمل التاسعة عشرة أو ميلا أو هوى أو عدم خبرة فيه ليختلس منه التزامات أو إبراء منها أو أية تصرفات أخرى تشغل ذمته المالية وذلك إضرارا به يعاقب بالحبس من ثلاثة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 10.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_380_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_380> ;
    dzdoc:position 1 ;
    dzdoc:text "وتكون العقوبة الحبس من سنة إلى خمس سنوات والغرامة من 1.000 إلى 15.000 دج إذا كان المجني عليه موضوعا تحت رعاية الجاني أو رقابته أو سلطته وفي جميع الحالات المنصوص عليها في هذه المادة يجوز أن يحكم أيضا على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة وذلك لمدة سنة على الأقل وخمس سنوات على الأكثر."@ar .

