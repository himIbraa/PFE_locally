    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_257> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:versionText "الترصد هو انتظار شخص لفترة طالت أو قصرت في مكان أو أكثر وذلك إما لإزهاق روحه أو للاعتداء عليه."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_258_19660608_OpEnact_74aecbaea2> a dzdoc:ArticleVersion ;
