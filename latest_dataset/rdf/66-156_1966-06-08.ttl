<https://legal.dz/resource/order/1966-06-08/66-156#version_art_143> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "فيما عدا الحالات التي يقرر فيها القانون عقوبات في الجنايات أو الجنح التي يرتكبها الموظفون العموميون أو القائمون بوظائف عمومية فإن من يساهم منهم في جنايات أو جنح أخرى مما يكلفون بمراقبتها أو ضبطها يعاقب على الوجه الآتي : إذا كان الأمر متعلقا بجنحة فتضاعف العقوبة المقررة لتلك الجنحة، إذا كان الأمر متعلقا بجناية فتكون العقوبة كما يلي : السجن المؤقت من عشر سنوات إلى عشرين سنة إذا كانت عقوبة الجناية المقررة على غيره من الفاعلين هي السجن المؤقت من خمس إلى عشر سنوات ، السجن المؤبد إذا كانت عقوبة الجناي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_143_19660608_OpEnact_aacfeb1689> ;
    dzdoc:replacementText "فيما عدا الحالات التي يقرر فيها القانون عقوبات في الجنايات أو الجنح التي يرتكبها الموظفون العموميون أو القائمون بوظائف عمومية فإن من يساهم منهم في جنايات أو جنح أخرى مما يكلفون بمراقبتها أو ضبطها يعاقب على الوجه الآتي : إذا كان الأمر متعلقا بجنحة فتضاعف العقوبة المقررة لتلك الجنحة، إذا كان الأمر متعلقا بجناية فتكون العقوبة كما يلي : السجن المؤقت من عشر سنوات إلى عشرين سنة إذا كانت عقوبة الجناية المقررة على غيره من الفاعلين هي السجن المؤقت من خمس إلى عشر سنوات ، السجن المؤبد إذا كانت عقوبة الجناية المقررة على غيره من الفاعلين هي : السجن المؤقت من عشر سنوات إلى عشرين سنة ، وتطبق العقوبة نفسها دون تغليظها فيما عدا الحالات السابق بيانها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_143> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
