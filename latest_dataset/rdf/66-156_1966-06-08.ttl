<https://legal.dz/resource/order/1966-06-08/66-156#version_art_57_19660608_OpEnact_4673ccd716> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_57> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1966-06-08/66-156#art_57> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_57> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:versionText "تعتبر من نفس النوع لتحديد العود الجرائم التي تشملها إحدى الفقرات الآتية : 1- اختلاس الأموال العمومية أو الخاصة والسرقة والإخفاء والنصب وخيانة الأمانة والرشوة. 2 - خيانة الائتمان على بياض وإصدار أو قبول شيكات بدون رصيد والتزوير واستعمال المحررات المزورة، 3- تبييض الأموال والإفلاس بالتدليس والاستيلاء على مال الشركة بطريق الغش وابتزاز الأموال، 4- القتل الخطأ والجرح الخطأ وجنحة الهروب والسياقة في حالة السكر، 5- الضرب والجرح العمدي والمشاجرة والتهديد والتعدي والعصيان، 6- الفعل المخل بالحياء بدون عنف والفعل العلني المخل بالحياء واعتياد التحريض على الفسق وفساد الأخلاق والمساعدة على الدعارة والتحرش الجنسي."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_58_19660608_OpEnact_63f39b3c26> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
