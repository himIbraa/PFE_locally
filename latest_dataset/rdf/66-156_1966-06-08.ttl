<https://legal.dz/resource/order/1966-06-08/66-156#art_313> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_313" ;
    dzdoc:fullText "كل من يخالف المنع المحكوم به طبقا للمواد 306 فقرة 2 و 311 و 312 يعاقب بالحبس من ستة أشهر إلى سنتين وبغرامة من 500 إلى 5.000 دينار أو بإحدى هاتين العقوبتين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_313> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_313_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_313_19660608_OpEnact_526c63fd60> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_313_obligation_0_23dc08b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 313" ;
    dzdoc:position 451 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_306>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_311>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_312> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_306>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_311>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_312> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_319> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_319" ;
    dzdoc:fullText "ويجوز الحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 من هذا القانون من سنة على الأقل إلى خمس سنوات على الأكثر وذلك في حالة ما إذا قضي عليه بعقوبة جنحة فقط طبقا للمواد من 314 إلى 317 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_319> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_319_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_319_19660608_OpEnact_3ea8afa79b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 319" ;
    dzdoc:position 457 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_314>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_317> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_314>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_317> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_319_condition_0_7234e78a> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_320> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_320" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 500 إلى 20.000 دينار : 1- كل من حرض أبوين أو أحدهما على التخلي عن طفلهما المولود أو الذي سيولد وذلك بنية الحصول على فائدة. 2- كل من تحصل من أبوين أو من أحدهما على عقد يتعهدان بمقتضاه بالتخلي عن طفلهما الذي سيولد أو شرع في ذلك وكل من حاز مثل هذا العقد أو استعمله أو شرع في استعماله. 3- كل من قدم وساطته للحصول على طفل بنية التوصل إلى فائدة أو شرع في ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_320> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_320_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_320_19660608_OpEnact_b927d92bf5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_320_obligation_0_80e7dae9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "320" ;
    dzdoc:position 459 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_327> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_327" ;
    dzdoc:fullText "كل من لم يسلم طفلا موضوعا تحت رعايته إلى الأشخاص الذين لهم الحق في المطالبة به يعاقب بالحبس من سنتين إلى خمس سنوات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_327> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_327_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_327_19660608_OpEnact_6496502c1c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_327_obligation_0_3ec9efc0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "327" ;
    dzdoc:position 467 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_329> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_329" ;
    dzdoc:fullText "كل من تعمد إخفاء قاصر كان قد خطف أو أبعد أو هربه من البحث عنه وكل من أخفاه عن السلطة التي يخضع لها قانونا يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 2.500 دينار أو بإحدى هاتين العقوبتين، وذلك فيما عدا الحالة التي يكون فيها الفعل جريمة اشتراك معاقب عليها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_329> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_329_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_329_19660608_OpEnact_d0b5a5cab3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_329_obligation_0_061442ba> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "329" ;
    dzdoc:position 469 ;
    dzdoc:usesTerm dzterm:minor .

<https://legal.dz/resource/order/1966-06-08/66-156#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:تعدد_الجرائم ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "يعتبر تعددا في الجرائم أن ترتكب في وقت واحد أو في أوقات متعددة عدة جرائم لا يفصل بينها حكم نهائي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_33> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_33_defocc_bbb2af240392> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_33_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_33_19660608_OpEnact_2a8c1a5c59> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 33" ;
    dzdoc:position 55 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_333_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_6> ;
    dzdoc:eId "art_333_bis" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى سنتين وبغرامة من 500 إلى 2.000 دج كل من صنع أو حاز أو استورد أو سعى في استيراد من أجل التجارة أو وزع أو أجر أو لصق أو أقام معرضا أو عرض أو شرع في العرض للجمهور أو باع أو شرع في البيع أو وزع أو شرع في التوزيع كل مطبوع أو محررا أو رسم أو إعلان أو صور أو لوحات زيتية أو صور فوتوغرافية أو أصل الصورة أو قالبها أو أنتج أي شيء مخل بالحياء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_333_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_333_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_333_bis_19660608_OpEnact_2ce3bdbee8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_333_bis_obligation_0_6aa865f6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "333 مكرر" ;
    dzdoc:position 475 ;
    dzdoc:usesTerm dzterm:indecent_material .

<https://legal.dz/resource/order/1966-06-08/66-156#art_350_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_350_bis_2" ;
    dzdoc:fullText "يعاقب بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.500.000 دج على الجرائم المنصوص عليها في المادة 350 مكرر 1 أعلاه متى توافرت أحد الظروف الآتية : إذا سهلت وظيفة الفاعل ارتكاب الجريمة، إذا ارتكبت الجريمة من طرف أكثر من شخص، إذا ارتكبت الجريمة مع حمل السلاح أو التهديد باستعماله، إذا ارتكبت الجريمة من طرف جماعة إجرامية منظمة أو كانت ذات طابع عابر للحدود الوطنية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_350_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_350_bis_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_350_bis_2_19660608_OpEnact_6b2afbef87> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 350 مكرر 2" ;
    dzdoc:position 500 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_350_bis_1> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_350_bis_1> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_350_bis_2_condition_0_8e698e93> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_355> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:inhabited_house ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_355" ;
    dzdoc:fullText "يعد منزلا مسكونا كل مبنى أو دار أو غرفة أو خيمة أو كشك ولو متنقل متى كان معدا للسكن وإن لم يكن مسكونا وقتذاك وكافة توابعه مثل الأحواش وحظائر الدواجن ومخازن الغلال والإسطبلات والمباني التي توجد بداخلها مهما كان استعمالها حتى ولو كانت محاطة بسياج خاص داخل السياج أو السور العمومي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_355> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_355_defocc_266a8175b381> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_355_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_355_19660608_OpEnact_72e9525951> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 355" ;
    dzdoc:position 506 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_1_sec_3> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "تضم العقوبات المالية ما لم يقرر القاضي خلاف ذلك بنص صريح ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_36_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_36_19660608_OpEnact_d718e27a5c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 36" ;
    dzdoc:position 58 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_36_condition_0_b1f9f3d8> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_379> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_379" ;
    dzdoc:fullText "إذا وقعت خيانة الأمانة من قائم بوظيفة عمومية أو بوظيفة قضائية أثناء مباشرة أعمال وظيفته أو بمناسبتها فتكون العقوبة السجن المؤقت من خمس إلى عشر سنوات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_379> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_379_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_379_19660608_OpEnact_91faffaf09> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "379" ;
    dzdoc:position 532 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_379_condition_0_81d469d8> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_382> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_382" ;
    dzdoc:fullText "كل من قدم سندات أو أوراق أو مذكرات في منازعة إدارية أو قضائية ثم اختلسها بأية طريقة كانت أو امتنع عن إعادة تقديمها يعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 100 إلى 1.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_382> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_382_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_382_19660608_OpEnact_2f740800d6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "382" ;
    dzdoc:position 535 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_382_condition_0_909d7637> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_382_bis" ;
    dzdoc:fullText "عندما ترتكب الجرائم المنصوص عليها في الأقسام الأول والثاني والثالث من الفصل الثالث من هذا الباب ضد الدولة أو الأشخاص الاعتبارية المشار إليها في المادة 119 فإن الجاني يعاقب : 1 - بالسجن المؤبد في الحالات الواردة في المواد 352 و 353 و 354 . 2 - بالحبس من سنتين (2) إلى عشر (10) سنوات إذا كان الأمر يتعلق بجنحة، باستثناء الحالة التي تنص عليها المادة 370 من قانون العقوبات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_382_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_382_bis_19660608_OpEnact_c52140c757> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "382 مكرر" ;
    dzdoc:position 536 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_119>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_352>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_353>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_354>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_370> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_119>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_352>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_353>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_354>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_370> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis_condition_0_0a57a49b> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:money_laundering ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_6_bis> ;
    dzdoc:eId "art_389_bis" ;
    dzdoc:fullText "يعتبر تبييضا للأموال : أ- تحويل الممتلكات أو نقلها مع علم الفاعل بأنها عائدات إجرامية، بغرض إخفاء أو تمويه المصدر غير المشروع لتلك الممتلكات أو مساعدة أي شخص متورط في ارتكاب الجريمة الأصلية التي تأتت منها هذه الممتلكات على الإفلات من الآثار القانونية لفعلته. ب- إخفاء أو تمويه الطبيعة الحقيقية للممتلكات أو مصدرها أو مكانها أو كيفية التصرف فيها أو حركتها أو الحقوق المتعلقة بها، مع علم الفاعل أنها عائدات إجرامية. ج- اكتساب الممتلكات أو حيازتها أو استخدامها مع علم الشخص القائم بذلك وقت تلقيها، أنها تشكل عائدات إجرامية. د- المشاركة في ارتكاب أي من الجرائم المقررة وفقا لهذه المادة ، أو التواطؤ أو التآمر على ارتكابها ومحاولة ارتكابها والمساعدة والتحريض على ذلك وتسهيله وإسداء المشورة بشأنه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_389_bis> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_defocc_1fac8519f8d2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_389_bis_19660608_OpEnact_5f62129844> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "389 مكرر" ;
    dzdoc:position 545 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_7_bis> ;
    dzdoc:eId "art_394_bis_4" ;
    dzdoc:fullText "يعاقب الشخص المعنوي الذي يرتكب إحدى الجرائم المنصوص عليها في هذا القسم بغرامة تعادل خمس (5) مرات الحد الأقصى للغرامة المقررة للشخص الطبيعي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_394_bis_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_394_bis_4_19660608_OpEnact_214cb9eb9d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_4_obligation_0_8f146d55> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 394 مكرر 4" ;
    dzdoc:position 562 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_405_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_405_bis" ;
    dzdoc:fullText "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة من 10.000 إلى 20.000 دج كل من تسبب بغير قصد في حريق أدى إلى إتلاف أموال الغير وكان ذلك نشأ عن رعونته أو عدم احتياطه أو عدم انتباهه أو إهماله أو عدم مراعاة النظم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_405_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_405_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_405_bis_19660608_OpEnact_2bcf2cb40b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_405_bis_obligation_0_6022d705> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "405 مكرر" ;
    dzdoc:position 578 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_406_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_406_bis" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى سنتين وبغرامة من 500 إلى 5.000 دج، كل من خرب عمدا أجزاء من عقار هو ملك الغير ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_406_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_406_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_406_bis_19660608_OpEnact_c80bf214ea> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_406_bis_obligation_0_8cbde592> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "406 مكرر" ;
    dzdoc:position 580 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_41> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:فاعل ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_41" ;
    dzdoc:fullText "يعتبر فاعلا كل من ساهم مساهمة مباشرة في تنفيذ الجريمة أو حرض على ارتكاب الفعل بالهبة أو الوعد أو تهديد أو إساءة استعمال السلطة أو الولاية أو التحايل أو التدليس الإجرامي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_41> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_41_defocc_4535c238a234> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_41_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_41_19660608_OpEnact_6d55903c3d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "41" ;
    dzdoc:position 63 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_413_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_413_bis" ;
    dzdoc:fullText "يعاقب بالحبس من ستة أشهر إلى سنتين وبغرامة من 500 إلى 1.000 دج : 1 - كل من أطلق مواشي من أي نوع كانت في أرض مملوكة للغير وعلى الأخص في المشاتل أو في الكروم أو مزارع الصفصاف أو الكبار أو الزيتون أو التوت أو الرمان أو البرتقال أو غيرها من الأشجار المماثلة أو في مزارع أو مشاتل الأشجار ذات الثمار أو غيرها المهيأة بعمل الإنسان. 2 - كل من جعل مواشي أو دواب الجر أو الحمل أو الركوب تمر في أرض الغير المبذورة أو التي بها محاصل في أي فصل كان أو تركها تمر فيها. 3 - كل من جعل مواشيه أو دوابه المعدة للجر أو الحمل أو الركوب تمر في أرض الغير قبل جني المحصول."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_413_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_413_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_413_bis_19660608_OpEnact_84cfc7dc87> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_413_bis_obligation_0_ae0636c4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "413 مكرر" ;
    dzdoc:position 588 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_414> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_414" ;
    dzdoc:fullText "كل من أتلف أو كسر أية أداة من أدوات الزراعة أو حظائر المواشي أو أكشاك ثابتة أو متنقلة للحراس أو جعلها غير صالحة للاستعمال يعاقب بالحبس من شهرين إلى خمس سنوات وبغرامة من 500 إلى 1.000 دينار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_414> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_414_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_414_19660608_OpEnact_13440405a3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_414_obligation_0_490b9b3e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "414" ;
    dzdoc:position 589 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_433> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_4> ;
    dzdoc:eId "art_433" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى ثلاث سنوات وبغرامة من 2.000 إلى 20.000 دج كل من يحوز دون سبب شرعي : سواء مواد صالحة لتغذية الإنسان أو الحيوانات أو مشروبات أو منتوجات فلاحية أو طبيعية يعلم أنها مغشوشة أو فاسدة أو مسمومة، سواء مواد طبية مغشوشة، سواء مواد خاصة تستعمل في غش مواد صالحة لتغذية الإنسان أو الحيوانات أو مشروبات أو منتوجات فلاحية أو طبية، سواء موازين أو مكاييل خاطئة أو آلات أخرى غير مطابقة تستعمل في وزن أو كيل السلع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_433> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_433_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_433_19660608_OpEnact_856c9702b8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_433_obligation_0_012468e1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "433" ;
    dzdoc:position 617 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_434> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_4> ;
    dzdoc:eId "art_434" ;
    dzdoc:fullText "يعاقب بأقصى العقوبات المنصوص عليها في المواد السابقة : 1 - كل متصرف أو محاسب يكون قد قام بالغش أو عمل على غش مواد أو أشياء أو مواد غذائية أو سوائل عهدت إليه قصد حراستها أو موضوعة تحت مراقبته أو يكون قد وزع عمدا أو عمل على توزيع المواد المذكورة أو الأشياء أو المواد الغذائية أو السوائل المغشوشة، 2 - كل متصرف أو محاسب يكون قد وزع عمدا أو عمل على توزيع لحوم حيوانات مصابة بأمراض معدية أو أشياء أو مواد غذائية أو سوائل فاسدة أو متلفة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_434> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_434_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_434_19660608_OpEnact_349f72bbc4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_434_obligation_0_bca96c1c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "434" ;
    dzdoc:position 618 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_429> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_429> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_435> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_4> ;
    dzdoc:eId "art_435" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى سنتين وبغرامة من 2.000 إلى 20.000 دج ودون إخلال بالعقوبات المقررة في المادة 183 وما يليها من هذا القانون كل من يضع الضباط وأعوان الشرطة القضائية وكذلك الموظفين الذين يسند إليهم القانون سلطة معاينة المخالفات المشار إليها في المواد 427 و 428 و 429 و 430 في موقع استحالة للقيام بوظائفهم، إما برفض عدم السماح لهم بالدخول إلى المحال الصناعية أو محال التخزين أو محال البيع أو بأية كيفية أخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_435> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_435_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_435_19660608_OpEnact_ad4e1ef084> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_435_obligation_0_0513be7a> ;
