<https://legal.dz/resource/order/1966-06-08/66-156#version_art_225> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل شخص اصطنع باسم طبيب أو جراح أو طبيب أسنان أو قابلة، شهادة مرضية أو شهادة بوجود عجز، وذلك بقصد أن يعفي نفسه، أو يعفي الغير من أية خدمة عمومية كانت، يعاقب بالحبس من سنة (1) إلى ثلاث (3) سنوات وبغرامة من 100.000 دج إلى 300.000 دج."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_225_19660608_OpEnact_28dba3c821> ;
    dzdoc:replacementText "كل شخص اصطنع باسم طبيب أو جراح أو طبيب أسنان أو قابلة، شهادة مرضية أو شهادة بوجود عجز، وذلك بقصد أن يعفي نفسه، أو يعفي الغير من أية خدمة عمومية كانت، يعاقب بالحبس من سنة (1) إلى ثلاث (3) سنوات وبغرامة من 100.000 دج إلى 300.000 دج."@ar ;
    dzdoc:resolutionStatus "resolved" ;
