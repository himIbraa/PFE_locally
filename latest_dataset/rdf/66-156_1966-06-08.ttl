<https://legal.dz/resource/order/1966-06-08/66-156#art_264_obligation_0_a5427efc> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/order/1966-06-08/66-156#art_264_obligation_0_a5427efc_period_a0ed91a92a> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_264> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_264_obligation_0_a5427efc_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "كل من أحدث عمدا جروحا للغير أو ضربه أو ارتكب أي عمل آخر من أعمال العنف أو التعدي، يعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج، إذا نتج عن هذه الأنواع من العنف مرض أو عجز كلي عن العمل لمدة تزيد عن خمسة عشر (15) يوما."@ar ;
    dznorm:sourceArticle "art_264" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_284_obligation_0_2047baf1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1966-06-08/66-156#art_284_obligation_0_2047baf1_role_e89e846492> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_284> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_284_obligation_0_2047baf1_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "كل من هدد بارتكاب جرائم القتل أو السجن أو أي اعتداء آخر على الأشخاص مما يعاقب عليها بالإعدام أو السجن المؤبد وكان ذلك بمحرر موقع أو غير موقع عليه، أو بصور أو رموز أو شعارات، يعاقب بالحبس من سنتين إلى عشر سنوات وبغرامة من 500 إلى 5.000 دج، إذا كان التهديد مصحوبا بأمر بإيداع مبلغ من النقود في مكان معين أو بتنفيذ أي شرط آخر."@ar ;
    dznorm:sourceArticle "art_284" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_285_obligation_0_ea09cdb0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_285> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_285_obligation_0_ea09cdb0_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "إذا لم يكن التهديد مصحوبا بأي أمر أو شرط فيعاقب الجاني بالحبس من سنة إلى ثلاث سنوات وبغرامة من 500 إلى 2.500 دينار."@ar ;
    dznorm:sourceArticle "art_285" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_286_obligation_0_5a8584f9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_286> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_286_obligation_0_5a8584f9_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "إذا كان التهديد مصحوبا بأمر أو شرط شفهي فيعاقب الجاني بالحبس من ستة أشهر إلى سنتين وبغرامة من 500 إلى 1.500 دينار."@ar ;
    dznorm:sourceArticle "art_286" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_287_obligation_0_13e3fc56> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1966-06-08/66-156#art_287_obligation_0_13e3fc56_ref_1d477a5197f9>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_287_obligation_0_13e3fc56_ref_7508e197ed14> ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_284>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_286> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_284>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_286> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_287> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_287_obligation_0_13e3fc56_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "كل من هدد بالاعتداء أو العنف غير المنصوص عليه في المادة 284 وذلك بإحدى الطرق المنصوص عليها في المواد من 284 إلى 286 يعاقب بالحبس من ثلاثة أشهر إلى سنة وبغرامة من 500 إلى 1.000 دج إذا كان التهديد مصحوبا بأمر أو شرط."@ar ;
    dznorm:sourceArticle "art_287" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_1_defocc_bd0ec40f19e5> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 344 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:discrimination ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_1> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_1_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يشكل تمييزا كل تفرقة أو استثناء أو تقييد أو تفضيل يقوم على أساس الجنس أو العرق أو اللون أو النسب أو الأصل القومي أو الإثني أو الإعاقة ويستهدف أو يستتبع تعطيل أو عرقلة الاعتراف بحقوق الإنسان والحريات الأساسية أو التمتع بها أو ممارستها على قدم المساواة، في الميدان السياسي والاقتصادي والاجتماعي والثقافي أو في أي ميدان آخر من ميادين الحياة العامة. يعاقب على التمييز بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 150.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_1> ;
    dzdoc:position 0 ;
    dzdoc:text "يشكل تمييزا كل تفرقة أو استثناء أو تقييد أو تفضيل يقوم على أساس الجنس أو العرق أو اللون أو النسب أو الأصل القومي أو الإثني أو الإعاقة ويستهدف أو يستتبع تعطيل أو عرقلة الاعتراف بحقوق الإنسان والحريات الأساسية أو التمتع بها أو ممارستها على قدم المساواة، في الميدان السياسي والاقتصادي والاجتماعي والثقافي أو في أي ميدان آخر من ميادين الحياة العامة. يعاقب على التمييز بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 150.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_296_defocc_b853247bcedb> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 122 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:قذف ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_296> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_296_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يعد قذفا كل ادعاء بواقعة من شأنها المساس بشرف واعتبار الأشخاص أو الهيئة المدعى عليها به أو إسنادها إليهم أو إلى تلك الهيئة ويعاقب على نشر هذا الادعاء أو ذلك الإسناد مباشرة أو بطريق إعادة النشر حتى ولو تم ذلك على وجه التشكيك أو إذا قصد به شخص أو هيئة دون ذكر الاسم ولكن كان من الممكن تحديدهما من عبارات الحديث أو الصياح أو التهديد أو الكتابة أو المنشورات أو اللافتات أو الإعلانات موضوع الجريمة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_296_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_296> ;
    dzdoc:position 0 ;
    dzdoc:text "يعد قذفا كل ادعاء بواقعة من شأنها المساس بشرف واعتبار الأشخاص أو الهيئة المدعى عليها به أو إسنادها إليهم أو إلى تلك الهيئة ويعاقب على نشر هذا الادعاء أو ذلك الإسناد مباشرة أو بطريق إعادة النشر حتى ولو تم ذلك على وجه التشكيك أو إذا قصد به شخص أو هيئة دون ذكر الاسم ولكن كان من الممكن تحديدهما من عبارات الحديث أو الصياح أو التهديد أو الكتابة أو المنشورات أو اللافتات أو الإعلانات موضوع الجريمة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_297_defocc_c44af77bbc70> a dzdoc:DefinitionOccurrence ;
