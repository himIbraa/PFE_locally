    dzdoc:sourceTextSpan "يعاقب بالسجن المؤقت من خمس إلى عشر سنوات، الولاة ورؤساء الدوائر ورؤساء المجالس الشعبية البلدية وغيرهم من رجال الإدارة الذين يتدخلون في أعمال الوظيفة التشريعية وفقا لما هو مقرر في الفقرة الأولى من المادة 116 أو الذين يتخذون قرارات عامة أو تدابير ترمي إلى إصدار أية أوامر أو نواه إلى المحاكم أو إلى المجالس"@ar ;
    dzdoc:targetEId "art_116" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_117_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_117> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالسجن المؤقت من خمس إلى عشر سنوات، الولاة ورؤساء الدوائر ورؤساء المجالس الشعبية البلدية وغيرهم من رجال الإدارة الذين يتدخلون في أعمال الوظيفة التشريعية وفقا لما هو مقرر في الفقرة الأولى من المادة 116 أو الذين يتخذون قرارات عامة أو تدابير ترمي إلى إصدار أية أوامر أو نواه إلى المحاكم أو إلى المجالس."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_118_condition_0_f59d9f81> a dznorm:Condition ;
    dznorm:conditionText "عندما يتجاوز رجال الإدارة الوظائف القضائية بتقريرهم الاختصاص بالحقوق والمصالح التي تدخل في اختصاص المحاكم ثم بقيامهم بعد اعتراض الأطراف أو واحد منهم، ورغم هذا الاعتراض بالفصل في الدعوى قبل أن تصدر السلطة العليا قرارها فيها بالفصل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_118> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_118_obligation_0_88c2995f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_118> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقبون بغرامة لا تقل عن 500 دج ولا تتجاوز 3.000 دج"@ar ;
    dznorm:sourceArticle "art_118" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_118_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_118> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما يتجاوز رجال الإدارة الوظائف القضائية بتقريرهم الاختصاص بالحقوق والمصالح التي تدخل في اختصاص المحاكم ثم بقيامهم بعد اعتراض الأطراف أو واحد منهم، ورغم هذا الاعتراض بالفصل في الدعوى قبل أن تصدر السلطة العليا قرارها فيها بالفصل يعاقبون بغرامة لا تقل عن 500 دج ولا تتجاوز 3.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_119_bis_1_para_0> a dzdoc:Paragraph ;
