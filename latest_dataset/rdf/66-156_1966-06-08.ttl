<https://legal.dz/resource/order/1966-06-08/66-156#version_art_77> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالإعدام الاعتداء الذي يكون الغرض منه إما القضاء على نظام الحكم أو تغييره، وإما تحريض المواطنين أو السكان على حمل السلاح ضد سلطة الدولة أو ضد بعضهم بعضا، وإما المساس بوحدة التراب الوطني. ويعتبر في حكم الاعتداء تنفيذ الاعتداء أو محاولة تنفيذه. تطبق أحكام المادة 60 مكرر على الجناية المنصوص عليها في هذه المادة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_77_19660608_OpEnact_b001b2d2f2> ;
