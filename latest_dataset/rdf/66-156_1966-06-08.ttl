    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالإعدام"@ar ;
    dznorm:sourceArticle "art_80" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_80_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_80> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالإعدام كل من كون قوات مسلحة أو عمل على تكوينها وكل من استخدم أو جند جنودا أو عمل على استخدامهم أو زودهم بالأسلحة أو الذخيرة بدون أمر أو إذن من السلطة الشرعية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_81_obligation_0_f4930fed> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_81> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالإعدام"@ar ;
    dznorm:sourceArticle "art_81" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_81_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_81> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالإعدام : كل من تولى قيادة عسكرية أيا كانت بدون وجه حق أو بدون سبب مشروع، وكل من احتفظ بمثل هذه القيادة ضد أمر الحكومة، والقواد الذين يبقون جيوشهم وقواتهم مجتمعة بعد أن صدر لهم الأمر بتسريحها أو تفريقها."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_82_para_0> a dzdoc:Paragraph ;
