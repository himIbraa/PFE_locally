    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_112> ;
    dznorm:conditionText "إذا اتخذت إجراءات ضد تنفيذ القوانين أو أوامر الحكومة وكان تدبيرها بإحدى الطرق المذكورة في المادة 112"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_113> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_113_condition_0_cec57a4e_ref_72998a6c6fb2> a dzdoc:Reference ;
    rdfs:label "المادة 112"@ar ;
