    dzdoc:versionText "ملغاة"@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_260_19660608_OpEnact_49ce8cf8bc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_260> ;
