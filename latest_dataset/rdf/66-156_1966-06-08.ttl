<https://legal.dz/resource/order/1966-06-08/66-156#version_art_113> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا اتخذت إجراءات ضد تنفيذ القوانين أو أوامر الحكومة وكان تدبيرها بإحدى الطرق المذكورة في المادة 112 فيعاقب الجناة بالسجن المؤقت من خمس إلى عشر سنوات. وإذا كان تدبير هذه الإجراءات تم بين سلطات مدنية وهيئات عسكرية أو رؤسائها فيعاقب المحرضون عليها بالسجن المؤقت من عشر سنوات إلى عشرين سنة أما باقي الجناة فيعاقبون بالسجن المؤقت من خمس إلى عشر سنوات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_113_19660608_OpEnact_a7834301db> ;
    dzdoc:replacementText "إذا اتخذت إجراءات ضد تنفيذ القوانين أو أوامر الحكومة وكان تدبيرها بإحدى الطرق المذكورة في المادة 112 فيعاقب الجناة بالسجن المؤقت من خمس إلى عشر سنوات. وإذا كان تدبير هذه الإجراءات تم بين سلطات مدنية وهيئات عسكرية أو رؤسائها فيعاقب المحرضون عليها بالسجن المؤقت من عشر سنوات إلى عشرين سنة أما باقي الجناة فيعاقبون بالسجن المؤقت من خمس إلى عشر سنوات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_113> ;
