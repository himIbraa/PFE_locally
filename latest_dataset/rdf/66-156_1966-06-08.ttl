    dzdoc:position 0 ;
    dzdoc:text "كل من فتح بغير ترخيص محلا لألعاب الحظ وسمح بحرية دخول الجمهور فيه أو بدخولهم بناء على تقديم الأعضاء المشتركين فيه أو الداعين إلى دخوله أو الأشخاص الذين لهم مصالح في استغلاله يعاقب بالحبس من ثلاثة أشهر إلى سنة وبغرامة من 500 إلى 20.000 دينار. والحال كذلك بالنسبة لصيارفة ومديري ومندوبي ومستخدمي هذا المحل."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_165_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_165> ;
    dzdoc:position 1 ;
