<https://legal.dz/resource/order/1966-06-08/66-156#version_art_162> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وقع تأخير في التسليم أو في الأعمال بسبب الإهمال دون التخلف عن القيام بالخدمات فيعاقب الفاعلون بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة لا تجاوز ربع التعويضات المدنية ولا تقل عن 500 دينار."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_162_19660608_OpEnact_c5288c6b6c> ;
    dzdoc:replacementText "إذا وقع تأخير في التسليم أو في الأعمال بسبب الإهمال دون التخلف عن القيام بالخدمات فيعاقب الفاعلون بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة لا تجاوز ربع التعويضات المدنية ولا تقل عن 500 دينار."@ar ;
    dzdoc:resolutionStatus "resolved" ;
