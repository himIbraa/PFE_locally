    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:versionText "القتل قد يقترن بسبق الإصرار أو الترصد ."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_256_19660608_OpEnact_a46304be23> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_256> ;
