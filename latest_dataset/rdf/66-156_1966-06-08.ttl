<https://legal.dz/resource/order/1966-06-08/66-156#art_150> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_2> ;
    dzdoc:eId "art_150" ;
    dzdoc:fullText "كل من هدم أو خرب أو دنس القبور بأية طريقة كانت يعاقب بالحبس من ستة أشهر إلى سنتين وبغرامة من 500 إلى 2.000 دينار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_150> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_150_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_150_19660608_OpEnact_12296dde93> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 150" ;
    dzdoc:position 218 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_151> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_2> ;
    dzdoc:eId "art_151" ;
    dzdoc:fullText "كل من يرتكب فعلا يمس بالحرمة الواجبة للموتى في المقابر أو في غيرها من أماكن الدفن يعاقب بالحبس من ثلاثة أشهر إلى سنتين وبغرامة من 500 إلى 2.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_151> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_151_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_151_19660608_OpEnact_d4de408585> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 151" ;
    dzdoc:position 219 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_152> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_2> ;
    dzdoc:eId "art_152" ;
    dzdoc:fullText "كل من انتهك حرمة مدفن أو قام بدفن جثة أو إخراجها خفية يعاقب بالحبس من ثلاثة أشهر إلى سنة وبغرامة من 500 إلى 2.000 دينار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_152> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_152_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_152_19660608_OpEnact_2f2deef676> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 152" ;
    dzdoc:position 220 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_153> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_2> ;
    dzdoc:eId "art_153" ;
    dzdoc:fullText "كل من دنس أو شوه جثة أو وقع منه عليها أي عمل من أعمال الوحشية أو الفحش يعاقب بالحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 2.000 دينار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_153> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_153_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_153_19660608_OpEnact_7c9d08f441> ;
