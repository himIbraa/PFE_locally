<https://legal.dz/resource/order/1966-06-08/66-156#version_art_43> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يأخذ حكم الشريك من اعتاد أن يقدم مسكنا أو ملجأ أو مكانا للاجتماع لواحد أو أكثر من الأشرار الذين يمارسون اللصوصية أو العنف ضد أمن الدولة أو الأمن العام أو ضد الأشخاص أو الأموال بسلوكهم الإجرامي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_43_19660608_OpEnact_91afcab611> ;
    dzdoc:replacementText "يأخذ حكم الشريك من اعتاد أن يقدم مسكنا أو ملجأ أو مكانا للاجتماع لواحد أو أكثر من الأشرار الذين يمارسون اللصوصية أو العنف ضد أمن الدولة أو الأمن العام أو ضد الأشخاص أو الأموال بسلوكهم الإجرامي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_43> ;
