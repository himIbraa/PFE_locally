<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7_obligation_1_0909d75f_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7_obligation_1_0909d75f> ;
    dznorm:conditionText "عندما تتعلق هذه الأخيرة بمواد متفجرة أو أية مادة تدخل في تركيبها أو صناعتها"@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7_obligation_2_584f2cac> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7> ;
    dznorm:position 2 ;
    dznorm:provisionText "يعاقب بالسجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة مالية من 100.000 دج إلى 500.000 دج، كل من يبيع عن علم أسلحة بيضاء أو يشتريها أو يوزعها أو يستوردها أو يصنعها لأغراض مخالفة للقانون."@ar ;
    dznorm:sourceArticle "art_87_bis_7" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة مالية من 500.000 دج إلى 1.000.000 دج، كل من يحوز أسلحة ممنوعة أو ذخائر يستولي عليها أو يحملها أو يتاجر فيها أو يستوردها أو يصدرها أو يصنعها أو يصلحها أو يستعملها دون رخصة من السلطة المختصة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7> ;
    dzdoc:position 1 ;
    dzdoc:text "يعاقب بالإعدام مرتكب الأفعال المنصوص عليها في الفقرة السابقة عندما تتعلق هذه الأخيرة بمواد متفجرة أو أية مادة تدخل في تركيبها أو صناعتها."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7> ;
    dzdoc:position 2 ;
    dzdoc:text "يعاقب بالسجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة مالية من 100.000 دج إلى 500.000 دج، كل من يبيع عن علم أسلحة بيضاء أو يشتريها أو يوزعها أو يستوردها أو يصنعها لأغراض مخالفة للقانون."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_8_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_8> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يمكن في كل الحالات أن تكون عقوبات السجن المؤقتة الصادرة، تطبيقا لأحكام هذا الأمر أقل من : عشرين (20) سنة سجنا مؤقتا عندما تكون العقوبة الصادرة عقوبة السجن المؤبد، النصف عندما تكون العقوبة الصادرة عقوبة السجن المؤقت."@ar .

