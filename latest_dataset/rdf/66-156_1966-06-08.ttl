    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_254> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:versionText "القتل هو إزهاق روح إنسان عمدا."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_255_19660608_OpEnact_885f1c2d74> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
