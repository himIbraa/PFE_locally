<https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_3_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_3> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 1.000 إلى 10.000 دج كل من قام عمدا بتخريب أو هدم أو تدنيس الأماكن المعدة للعبادة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_4_obligation_0_5f6a954f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
