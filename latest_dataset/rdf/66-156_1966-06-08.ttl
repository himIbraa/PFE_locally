<https://legal.dz/resource/order/1966-06-08/66-156#art_298_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5> ;
    dzdoc:eId "art_298_bis" ;
    dzdoc:fullText "يعاقب على السب الموجه إلى شخص أو أكثر بسبب انتمائهم إلى مجموعة عرقية أو مذهبية أو إلى دين معين بالحبس من خمسة (5) أيام إلى ستة (6) أشهر وبغرامة من 5.000 إلى 50.000 دج أو بإحدى هاتين العقوبتين فقط."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_298_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_298_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_298_bis_19660608_OpEnact_db1e843346> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "298 مكرر" ;
    dzdoc:position 394 ;
    dzdoc:usesTerm dzterm:سب .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5> ;
    dzdoc:eId "art_303" ;
    dzdoc:fullText "كل من يفض أو يتلف رسائل أو مراسلات موجهة إلى الغير وذلك بسوء نية وفي غير الحالات المنصوص عليها في المادة 137 يعاقب بالحبس من شهر (1) إلى سنة (1) وبغرامة من 25.000 دج إلى 100.000 دج أو بإحدى هاتين العقوبتين فقط."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_19660608_OpEnact_c12138b8dc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303" ;
    dzdoc:position 399 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_137> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_137> .

