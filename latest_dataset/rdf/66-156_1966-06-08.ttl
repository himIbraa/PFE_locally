    dznorm:provisionText "تكون العقوبة الحبس من سنتين إلى خمس سنوات والغرامة من 1.000 إلى 10.000 دج إذا كان أكثر من شخصين من المجتمعين يحملون أسلحة ظاهرة"@ar ;
    dznorm:sourceArticle "art_185" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_188_obligation_1_abceb3d8> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_188> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_188_obligation_1_abceb3d8_condition_0> ;
    dznorm:position 1 ;
    dznorm:provisionText "ويعاقب الجاني بالحبس من سنتين إلى خمس سنوات إذا وقع الهروب أو الشروع فيه بالعنف أو بالتهديد ضد الأشخاص أو بواسطة الكسر أو تحطيم باب السجن."@ar ;
    dznorm:sourceArticle "art_188" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_191_defocc_f9c102a879b7> a dzdoc:DefinitionOccurrence ;
