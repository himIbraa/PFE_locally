<https://legal.dz/resource/order/1966-06-08/66-156#version_art_250> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في جميع الحالات المنصوص عليها في هذا القسم يجوز لجهة القضاء أن تأمر إما بنشر الحكم كاملا أو ملخص منه في الصحف التي تعينها أو بتعليقه في الأماكن التي تبينها وذلك على نفقة المحكوم عليه. وتأمر نفس جهة القضاء بأن يؤشر على هامش الأوراق الرسمية أو أوراق الحالة المدنية التي اتخذ فيها اللقب بغير حق أو ذكر فيها الاسم محرفا وذلك إذا ما رأت وجها لذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_250_19660608_OpEnact_80389837b3> ;
