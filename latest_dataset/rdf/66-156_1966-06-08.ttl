<https://legal.dz/resource/order/1966-06-08/66-156#version_art_311> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل حكم عن إحدى الجرائم المنصوص عليها في هذا القسم يستوجب بقوة القانون الحكم بالمنع من ممارسة أية مهنة أو أداء أي عمل بأية صفة كانت في العيادات أو دور الولادة أو في أية مؤسسة عمومية أو خاصة تستقبل عادة نساء في حالة حمل حقيقي أو ظاهر أو مفترض وذلك بأجر أو بغير أجر. وكل حكم عن الشروع أو الاشتراك في الجرائم ذاتها يستتبع ذات المنع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_311_19660608_OpEnact_95bd8a0859> ;
    dzdoc:replacementText "كل حكم عن إحدى الجرائم المنصوص عليها في هذا القسم يستوجب بقوة القانون الحكم بالمنع من ممارسة أية مهنة أو أداء أي عمل بأية صفة كانت في العيادات أو دور الولادة أو في أية مؤسسة عمومية أو خاصة تستقبل عادة نساء في حالة حمل حقيقي أو ظاهر أو مفترض وذلك بأجر أو بغير أجر. وكل حكم عن الشروع أو الاشتراك في الجرائم ذاتها يستتبع ذات المنع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_311> ;
