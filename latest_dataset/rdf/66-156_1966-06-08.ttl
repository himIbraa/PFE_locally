    dznorm:sourceArticle "art_203" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_203_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_203> ;
    dzdoc:position 0 ;
    dzdoc:text "كل من صنع أو حصل أو حاز مواد أو أدوات معدة لصناعة أو تقليد أو تزوير نقود أو سندات قرض عام أو حصل عليها أو احتفظ بها أو تنازل عنها يعاقب بالحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 5.000 دينار ما لم يشكل الفعل جريمة أشد."@ar .

