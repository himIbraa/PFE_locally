<https://legal.dz/resource/order/1966-06-08/66-156#version_art_361> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من سرق خيولا أو دوابا للحمل أو الجر أو الركوب أو مواشي كبيرة أو صغيرة أو أدوات للزراعة أو شرع في شيء من ذلك يعاقب بالحبس من سنة على الأقل إلى خمس سنوات على الأكثر وبغرامة من 1.000 إلى 10.000 دج. وكل من سرق من حقول، محاصيل أو منتجات أخرى نافعة للأرض قد قطعت منها حتى ولو كانت قد وضعت في حزم أو أكوام أو شرع في ذلك يعاقب بالحبس من خمسة عشر يوما إلى سنتين وبغرامة من 500 إلى 1.000دج. ويعاقب بالحبس من 15 يوما إلى سنة وبغرامة من 500 إلى 1.000 دج على سرقة أخشاب من أماكن قطع الأخشاب أو أحجار من المحاجر"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_361_19660608_OpEnact_ebfde51633> ;
    dzdoc:replacementText "كل من سرق خيولا أو دوابا للحمل أو الجر أو الركوب أو مواشي كبيرة أو صغيرة أو أدوات للزراعة أو شرع في شيء من ذلك يعاقب بالحبس من سنة على الأقل إلى خمس سنوات على الأكثر وبغرامة من 1.000 إلى 10.000 دج. وكل من سرق من حقول، محاصيل أو منتجات أخرى نافعة للأرض قد قطعت منها حتى ولو كانت قد وضعت في حزم أو أكوام أو شرع في ذلك يعاقب بالحبس من خمسة عشر يوما إلى سنتين وبغرامة من 500 إلى 1.000دج. ويعاقب بالحبس من 15 يوما إلى سنة وبغرامة من 500 إلى 1.000 دج على سرقة أخشاب من أماكن قطع الأخشاب أو أحجار من المحاجر وكذلك على سرقة الأسماك من البرك أو الأحواض أو الخزانات. وإذا ارتكبت السرقة ليلا أو من عدة أشخاص أو بالاستعانة بعربات أو بحيوانات للحمل فتكون العقوبة الحبس من سنة إلى خمس سنوات والغرامة من 1.000 إلى 10.000 دج . وكل من سرق محاصيل أو منتجات أخرى نافعة للأرض لم تكن قبل سرقتها مفصولة من الأرض وذلك بواسطة سلال أو أكياس أو أشياء أخرى مماثلة وسواء كان ذلك ليلا أو بواسطة عربات أو حيوانات للحمل أو وقعت من شخصين أو أكثر أو شرع في ذلك يعاقب بالحبس من ثلاثة أشهر إلى سنتين وبغرامة من 1.000 إلى 10.000دج."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_361> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_361> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_362> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من نزع نصب الحدود الموضوعة للفصل بين الأملاك في سبيل ارتكاب السرقة يعاقب بالحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 2.000 دينار . ويجوز علاوة على ذلك أن يقضى على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وذلك لمدة سنة على الأقل وخمس سنوات على الأكثر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_362_19660608_OpEnact_960260837d> ;
    dzdoc:replacementText "كل من نزع نصب الحدود الموضوعة للفصل بين الأملاك في سبيل ارتكاب السرقة يعاقب بالحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 2.000 دينار . ويجوز علاوة على ذلك أن يقضى على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وذلك لمدة سنة على الأقل وخمس سنوات على الأكثر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_362> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
