<https://legal.dz/resource/order/1966-06-08/66-156#version_art_417_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالإعدام كل من استعمل العنف أو التهديد من أجل التحكم في طائرة على متنها ركاب أو السيطرة عليها. وتكون العقوبة السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وغرامة من 1.000.000 دج إلى 2.000.000 دج ، إذا ارتكبت الأفعال المذكورة في الفقرة السابقة على وسيلة للنقل البحري أو البري ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
