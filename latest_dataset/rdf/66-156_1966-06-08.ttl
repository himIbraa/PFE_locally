<https://legal.dz/resource/order/1966-06-08/66-156#version_art_402> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من وضع عمدا آلة متفجرة في طريق عام أو خاص، يعاقب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج. غير أنه إذا وضعت الآلة بقصد القتل ، فيعتبر إيداعها شروعا في القتل، ويعاقب عليه بهذه الصفة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
