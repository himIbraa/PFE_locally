<https://legal.dz/resource/order/1966-06-08/66-156#version_art_396> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن المؤقت من عشر سنوات إلى عشرين سنة كل من وضع النار عمدا في الأموال الآتية إذا لم تكن مملوكة له : مبان أو مساكن أو غرف أو خيم أو أكشاك ولو متنقلة أو بواخر أو سفن أو مخازن أو ورش إذا كانت غير مسكونة أو غير مستعملة للسكنى، مركبات أو طائرات ليس بها أشخاص، غابات أو حقول مزروعة أشجارا أو مقاطع أشجار أو أخشاب موضوعة في أكوام وعلى هيئة مكعبات، محصولات قائمة أو قش أو محصولات موضوعة في أكوام أو في حزم، عربات سكة حديد سواء محملة بالبضائع أو بأشياء منقولة أخرى أو فارغة إذ لم تكن ضمن قطار به أشخا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_396_19660608_OpEnact_95c175458c> ;
    dzdoc:replacementText "يعاقب بالسجن المؤقت من عشر سنوات إلى عشرين سنة كل من وضع النار عمدا في الأموال الآتية إذا لم تكن مملوكة له : مبان أو مساكن أو غرف أو خيم أو أكشاك ولو متنقلة أو بواخر أو سفن أو مخازن أو ورش إذا كانت غير مسكونة أو غير مستعملة للسكنى، مركبات أو طائرات ليس بها أشخاص، غابات أو حقول مزروعة أشجارا أو مقاطع أشجار أو أخشاب موضوعة في أكوام وعلى هيئة مكعبات، محصولات قائمة أو قش أو محصولات موضوعة في أكوام أو في حزم، عربات سكة حديد سواء محملة بالبضائع أو بأشياء منقولة أخرى أو فارغة إذ لم تكن ضمن قطار به أشخاص."@ar ;
    dzdoc:resolutionStatus "resolved" ;
