<https://legal.dz/resource/order/1966-06-08/66-156#art_147> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_147" ;
    dzdoc:fullText "الأفعال الآتية تعرض مرتكبيها للعقوبات المقررة في الفقرتين 1 و 3 من المادة 144 . الأفعال والأقوال والكتابات العلنية التي يكون الغرض منها التأثير على أحكام القضاة طالما أن الدعوى لم يفصل فيها نهائيا. الأفعال والأقوال والكتابات العلنية التي يكون الغرض منها التقليل من شأن الأحكام القضائية والتي يكون من طبيعتها المساس بسلطة القضاء أو استقلاله."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_147> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_147_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_147_19660608_OpEnact_d4dd925e1c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "147" ;
    dzdoc:position 215 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_144> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_144> .

