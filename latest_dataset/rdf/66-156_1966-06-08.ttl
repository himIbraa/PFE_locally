<https://legal.dz/resource/order/1966-06-08/66-156#art_208_obligation_0_61e86569> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_208> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من شهر إلى ستة أشهر وبغرامة من 500 إلى 1.000 دينار أو بإحدى هاتين العقوبتين ما لم يكون الفعل جريمة أشد كل من :"@ar ;
    dznorm:sourceArticle "art_208" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_208_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_208> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من شهر إلى ستة أشهر وبغرامة من 500 إلى 1.000 دينار أو بإحدى هاتين العقوبتين ما لم يكون الفعل جريمة أشد كل من : صنع خاتما أو طابعا أو ختما أو علامة للدولة أو لأية سلطة كانت بغير إذن كتابي من ممثليها المخولين من الدولة أو من تلك السلطة. صنع أو احتفظ أو وزع أو اشترى أو باع طابعا أو خاتما أو علامة أو ختما من المحتمل أن يخلط بينها وبين مثيلاتها الخاصة بالدولة أو بأية سلطة كانت حتى ولو كانت أجنبية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_209_obligation_0_6136049f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_209> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 10.000 دينار كل من :"@ar ;
    dznorm:sourceArticle "art_209" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_209_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_209> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 10.000 دينار كل من : قلد العلامات المعدة لوضعها باسم الحكومة أو أي مرفق عام على مختلف أنواع السلع أو البضائع أو استعمل هذه العلامات المزورة. قلد خاتما أو طابعا أو علامة لأية سلطة أو استعمل الخاتم أو الطابع أو العلامة المقلدة. قلد الأوراق المعنونة أو المطبوعات الرسمية المستعملة في الأجهزة الرئيسية للدولة أو في الإدارات العمومية أو في مختلف جهات القضاء أو باعها أو روجها أو وزعها أو استعمل هذه الأوراق أو المطبوعات المقلدة. قلد أو زور طوابع البريد أو بصمات التخليص أو قسائم الرد التي تصدرها إدارة البريد أو الطوابع المالية المنفصلة أو الأوراق أو النماذج المدموغة أو باع أو روج أو وزع أو استعمل الطوابع أو العلامات أو قسائم الرد أو الأوراق أو النماذج المدموغة المذكورة وهي مقلدة أو مزورة مع علمه بذلك."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_209_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_209> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة من سنة إلى خمس سنوات على الأكثر. ويعاقب على الشروع في الجرائم المبينة أعلاه كالجريمة التامة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_20_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_20> ;
    dzdoc:position 0 ;
    dzdoc:text "ملغاة"@ar .

