<https://legal.dz/resource/order/1966-06-08/66-156#version_art_449> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بغرامة من 100 إلى 500 دج ويجوز أن يعاقب أيضا بالحبس لمدة عشرة أيام على الأكثر كل من أساء دون مقتضى معاملة حيوان من الحيوانات المنزلية أو المستأنسة أو المأسورة سواء كان ذلك علنيا أو غير علني . ويجوز للمحكمة في حالة الحكم على مالك الحيوان أو إذا كان مالكه مجهولا أن تأمر بإيداع الحيوان في مؤسسة ذات منفعة عمومية لحماية الحيوانات أو تقرر اعتبارها كذلك وللمؤسسة في هذه الحالة حرية التصرف فيه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_449_19660608_OpEnact_9887604250> ;
    dzdoc:replacementText "يعاقب بغرامة من 100 إلى 500 دج ويجوز أن يعاقب أيضا بالحبس لمدة عشرة أيام على الأكثر كل من أساء دون مقتضى معاملة حيوان من الحيوانات المنزلية أو المستأنسة أو المأسورة سواء كان ذلك علنيا أو غير علني . ويجوز للمحكمة في حالة الحكم على مالك الحيوان أو إذا كان مالكه مجهولا أن تأمر بإيداع الحيوان في مؤسسة ذات منفعة عمومية لحماية الحيوانات أو تقرر اعتبارها كذلك وللمؤسسة في هذه الحالة حرية التصرف فيه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
