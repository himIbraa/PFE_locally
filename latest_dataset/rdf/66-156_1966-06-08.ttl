<https://legal.dz/resource/order/1966-06-08/66-156#version_art_64> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرتكب جريمة التجسس ويعاقب بالإعدام كل أجنبي يقوم بأحد الأفعال المنصوص عليها في الفقرات 2 و 3 و 4 من المادة 61 وفي المادتين 62 و 63 . ويعاقب من يحرض على ارتكاب إحدى الجنايات المنصوص عليها في هذه المادة و المواد 61 و 62 و 63 أو يعرض ارتكابها بالعقوبة المقرر للجنايات ذاتها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
