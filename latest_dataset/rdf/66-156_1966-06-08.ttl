    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_260> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:versionText "التسميم هو الاعتداء على حياة إنسان بتأثير مواد يمكن أن تؤدي إلى الوفاة عاجلا أو آجلا أيا كان استعمال أو إعطاء هذه المواد ومهما كانت النتائج التي تؤدي إليها."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_261_19660608_OpEnact_10e10b78a8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_261> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1966-06-08/66-156#art_261> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_261> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:versionText "يعاقب بالإعدام كل من ارتكب جريمة القتل أو قتل الأصول أو التسميم. ومع ذلك تعاقب الأم، سواء كانت فاعلة أصلية أو شريكة في قتل ابنها حديث العهد بالولادة بالسجن المؤقت من عشر سنوات إلى عشرين سنة على أن لا يطبق هذا النص على من ساهموا أو اشتركوا معها في ارتكاب الجريمة ."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_262_19660608_OpEnact_a6808e9474> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
