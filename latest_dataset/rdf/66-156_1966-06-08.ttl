    dzdoc:position 0 ;
    dzdoc:text "المادة 7 :"@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_80_condition_0_a3c5030b> a dznorm:Condition ;
    dznorm:conditionText "بدون أمر أو إذن من السلطة الشرعية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_80> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_80_obligation_0_f4930fed> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
