<https://legal.dz/resource/order/1966-06-08/66-156#version_art_233> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من شهد زورا في مواد الجنح سواء ضد المتهم أو لصالحه يعاقب بالحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 7.500 دينار. وإذا قبض شاهد الزور نقودا أو أية مكافأة كانت أو تلقى وعودا فيجوز رفع العقوبة إلى عشر سنوات والحد الأقصى للغرامة إلى 15.000 دينار."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
