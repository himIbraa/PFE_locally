<https://legal.dz/resource/order/1966-06-08/66-156#art_137_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_137_bis" ;
    dzdoc:fullText "كل موظف أو ضابط عمومي سخر أموالا منقولة أو عقارية خارج نطاق الحالات والشروط المحددة قانونا ، يعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 10.000 دج إلى 100.000دج . كما يعد الفاعل مسؤولا مسؤولية مدنية شخصية وتتحمل الدولة كذلك مسؤوليتها المدنية، على أن يكون لها حق الرجوع على الفاعل ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_137_bis_right_0_3031beef> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_137_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_137_bis_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_137_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_137_bis_19660608_OpEnact_49c59d68dd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_137_bis_obligation_0_b900b0d3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "137 مكرر" ;
    dzdoc:position 201 ;
    dzdoc:usesTerm dzterm:official,
        dzterm:public_officer .

<https://legal.dz/resource/order/1966-06-08/66-156#art_155> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_3> ;
    dzdoc:eId "art_155" ;
    dzdoc:fullText "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات كل من كسر عمدا الأختام الموضوعة بناء على أمر من السلطة العمومية أو شرع عمدا في كسرها . وإذا كان كسر الأختام أو الشروع فيه قد وقع من الحارس أو بطريق العنف ضد الأشخاص أو بغرض سرقة أو إتلاف أدلة أو أوراق إثبات في إجراءات جزائية فيكون الحبس من سنتين إلى خمس سنوات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_155> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_155_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_155_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_155_19660608_OpEnact_e9b13464f0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_155_obligation_0_5ad5d9b0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 155" ;
    dzdoc:position 223 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_155_condition_0_442ab69d> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_168> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_6> ;
    dzdoc:eId "art_168" ;
    dzdoc:fullText "يعاقب بالحبس من شهر إلى ثلاثة أشهر وبغرامة من 500 إلى 5.000 دينار كل من روج أو باع أو وزع أوراق اليانصيب غير المصرح به وكل من أعلن عن وجود هذا النصيب أو سهل إصدار أوراقه وذلك بواسطة الإعلانات أو النشرات أو الملصقات أو بأية طريقة أخرى من طرق الإعلان. ويجب أن يقضى بمصادرة المبالغ التي توجد في حيازة المروجين والبائعين والموزعين والناتجة عن بيع هذه الأوراق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_168> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_168_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_168_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_168_19660608_OpEnact_1cc0c0ee05> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_168_obligation_0_531eb190>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_168_obligation_1_db292ca0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "168" ;
    dzdoc:position 243 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_173> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_7> ;
    dzdoc:eId "art_173" ;
    dzdoc:fullText "وإذا وقع رفع أو خفض الأسعار أو شرع في ذلك على الحبوب أو الدقيق أو المواد التي من نوعه والمواد الغذائية أو المشروبات أو المستحضرات الطبية أو مواد الوقود أو الأسمدة التجارية تكون العقوبة الحبس من سنة إلى خمس سنوات والغرامة من 1.000 دج إلى 10.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_173> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_173_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_173_19660608_OpEnact_16333f3ec7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "173" ;
    dzdoc:position 248 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_173_condition_0_4b755456> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_174> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_7> ;
    dzdoc:eId "art_174" ;
    dzdoc:fullText "في جميع الحالات المنصوص عليها في المادتين 172 و 173 يعاقب الجاني بالمنع من الإقامة من سنتين إلى خمس سنوات وبالمنع من ممارسة حق أو أكثر من الحقوق المذكورة في المادة 14 وذلك بصرف النظر عن تطبيق المادة 23 . ويجب على القاضي حتى ولو طبق الظروف المخففة أن يأمر بنشر حكمه وتعليقه طبقا لأحكام المادة 18 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_174> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_174_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_174_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_174_19660608_OpEnact_d57c440c09> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_174_obligation_0_37a7890d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "174" ;
    dzdoc:position 250 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_172>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_173>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_18>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_23> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_172>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_173>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_18>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_23> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_175_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_8> ;
    dzdoc:eId "art_175_bis_1" ;
    dzdoc:fullText "دون الإخلال بالأحكام التشريعية الأخرى السارية المفعول، يعاقب بالحبس من شهرين (2) إلى ستة (6) أشهر وبغرامة من 20.000 إلى 60.000 دج أو بإحدى هاتين العقوبتين، كل جزائري أو أجنبي مقيم يغادر الإقليم الوطني بصفة غير شرعية ، أثناء اجتيازه أحد مراكز الحدود البرية أو البحرية أو الجوية، وذلك بانتحاله هوية أو باستعماله وثائق مزورة أو أي وسيلة احتيالية أخرى للتملص من تقديم الوثائق الرسمية اللازمة أو من القيام بالإجراءات التي توجبها القوانين والأنظمة السارية المفعول . وتطبق نفس العقوبة على كل شخص يغادر الإقليم الوطني عبر منافذ أو أماكن غير مراكز الحدود ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_175_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_175_bis_1_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_175_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_175_bis_1_19660608_OpEnact_956b636843> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_175_bis_1_obligation_0_a499c239>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_175_bis_1_obligation_1_70058fa1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "175 مكرر 1" ;
    dzdoc:position 253 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_175_bis_1_condition_0_cc91ac8b> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_183> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:جريمة_العصيان ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_2> ;
    dzdoc:eId "art_183" ;
    dzdoc:fullText "كل هجوم على الموظفين أو ممثلي السلطة العمومية الذين يقومون بتنفيذ الأوامر أو القرارات الصادرة منها أو القوانين أو اللوائح أو القرارات أو الأوامر القضائية وكذلك كل مقاومة لهم بالعنف أو التعدي تكون جريمة العصيان . والتهديد بالعنف يعتبر في حكم العنف ذاته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_183> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_183_defocc_6d5e6f3bc5f3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_183_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_183_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_183_19660608_OpEnact_ffa51b32ef> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "183" ;
    dzdoc:position 263 ;
    dzdoc:usesTerm dzterm:السلطة_العمومية,
        dzterm:الموظفين .

<https://legal.dz/resource/order/1966-06-08/66-156#art_184> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_2> ;
    dzdoc:eId "art_184" ;
    dzdoc:fullText "يعاقب على العصيان الذي يرتكبه شخص أو شخصان بالحبس من ثلاثة أشهر إلى سنتين وبغرامة من 500 إلى 1.000 دج أو بإحدى هاتين العقوبتين ، و إذا كان الجاني أو أحد الجانيين مسلحا فيكون الحبس من ستة أشهر إلى ثلاث سنوات وبغرامة من 1.000 إلى 5.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_184> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_184_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_184_19660608_OpEnact_e3db6fd870> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_184_obligation_0_ac1e0321>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_184_obligation_1_c491d1d1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "184" ;
    dzdoc:position 264 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_184_condition_0_b1740d8f> ;
    dzdoc:usesTerm dzterm:العصيان .

<https://legal.dz/resource/order/1966-06-08/66-156#art_192> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_3> ;
    dzdoc:eId "art_192" ;
    dzdoc:fullText "كل من هيأ أو سهل الهروب أو شرع في ذلك من غير الأشخاص المبينين في المادة 190 يعاقب بالحبس من شهر إلى ستة أشهر وبغرامة من 500 إلى 1.000 دينار حتى ولو لم يتم الهروب. وتكون العقوبة الحبس من سنتين إلى خمس سنوات والغرامة من 1.000 إلى 2.000 دينار إذا كانت هناك رشوة للحراس أو تواطؤ معهم . وتكون العقوبة الحبس من سنتين إلى خمس سنوات والغرامة من 1.000 إلى 4.000 دينار إذا تضمنت المساعدة تقديم سلاح ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_192> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_192_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_192_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_192_19660608_OpEnact_8c0a4690ca> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_192_obligation_0_3996329d>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_192_obligation_1_b717101d>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_192_obligation_2_9daea487> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "192" ;
    dzdoc:position 273 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_190> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_190> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_200> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_1> ;
    dzdoc:eId "art_200" ;
    dzdoc:fullText "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 300.000 دج، كل من قام بتلوين النقود ذات السعر القانوني في الإقليم الوطني أو في الخارج، بغرض التضليل في نوع معدنها، أو أصدر مثل هذه النقود الملونة أو أدخلها إليه . وتوقع العقوبة ذاتها على من ساهم في تلوين أو إصدار أو إدخال النقود المذكورة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_200> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_200_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_200_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_200_19660608_OpEnact_6db1c78cc9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_200_obligation_0_b63411d2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_200_obligation_1_e36bec41> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "200" ;
    dzdoc:position 283 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_203> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_1> ;
    dzdoc:eId "art_203" ;
    dzdoc:fullText "كل من صنع أو حصل أو حاز مواد أو أدوات معدة لصناعة أو تقليد أو تزوير نقود أو سندات قرض عام أو حصل عليها أو احتفظ بها أو تنازل عنها يعاقب بالحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 5.000 دينار ما لم يشكل الفعل جريمة أشد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_203> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_203_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_203_19660608_OpEnact_f654651dab> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_203_obligation_0_3d81dcd8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "203" ;
    dzdoc:position 286 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_203_condition_0_08a4072c> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_2> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "ملغاة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_23_para_0> ;
    dzdoc:hasStatus dzdoc:StatusRepealed ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_23_19660608_OpEnact_427863618b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
