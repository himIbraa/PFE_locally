<https://legal.dz/resource/order/1966-06-08/66-156#version_art_326> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من خطف أو أبعد قاصرا لم يكمل الثامنة عشرة وذلك بغير عنف أو تهديد أو تحايل أو شرع في ذلك فيعاقب بالحبس لمدة من سنة إلى خمس سنوات وبغرامة من 500 إلى 2.000 دينار. وإذا تزوجت القاصر المخطوفة أو المبعدة من خاطفها فلا تتخذ إجراءات المتابعة الجزائية ضد الأخير إلا بناء على شكوى الأشخاص الذين لهم صفة في طلب إبطال الزواج ولا يجوز الحكم عليه إلا بعد القضاء بإبطاله."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_326_19660608_OpEnact_887760ca7d> ;
    dzdoc:replacementText "كل من خطف أو أبعد قاصرا لم يكمل الثامنة عشرة وذلك بغير عنف أو تهديد أو تحايل أو شرع في ذلك فيعاقب بالحبس لمدة من سنة إلى خمس سنوات وبغرامة من 500 إلى 2.000 دينار. وإذا تزوجت القاصر المخطوفة أو المبعدة من خاطفها فلا تتخذ إجراءات المتابعة الجزائية ضد الأخير إلا بناء على شكوى الأشخاص الذين لهم صفة في طلب إبطال الزواج ولا يجوز الحكم عليه إلا بعد القضاء بإبطاله."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_326> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
