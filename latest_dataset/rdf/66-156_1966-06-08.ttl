    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان مرتكب الحادث من أصول الطفل أو العاجز أو ممن لهم سلطة عليه أو ممن يتولون رعايته فتكون العقوبة كما يلي: الحبس من سنتين إلى خمس سنوات في الحالات المنصوص عليها في الفقرة الأولى من المادة 314 ، السجن من خمس إلى عشر سنوات في الحالة المنصوص عليها في الفقرة الثانية من المادة المذكورة، السجن من عشر سنوات إلى عشرين سنة في الحالة المنصوص عليها في الفقرة الثالثة من المادة المذكورة، السجن المؤبد في الحالة المنصوص عليها في الفقرة الرابعة من المادة المذكورة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_315_19660608_OpEnact_4084c671a1> ;
    dzdoc:replacementText "إذا كان مرتكب الحادث من أصول الطفل أو العاجز أو ممن لهم سلطة عليه أو ممن يتولون رعايته فتكون العقوبة كما يلي: الحبس من سنتين إلى خمس سنوات في الحالات المنصوص عليها في الفقرة الأولى من المادة 314 ، السجن من خمس إلى عشر سنوات في الحالة المنصوص عليها في الفقرة الثانية من المادة المذكورة، السجن من عشر سنوات إلى عشرين سنة في الحالة المنصوص عليها في الفقرة الثالثة من المادة المذكورة، السجن المؤبد في الحالة المنصوص عليها في الفقرة الرابعة من المادة المذكورة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
