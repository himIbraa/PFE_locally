<https://legal.dz/resource/order/1966-06-08/66-156#version_art_188> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين إلى ثلاث سنوات كل من كان مقبوضا عليه أو معتقلا قانونا بمقتضى أمر أو حكم قضائي ويهرب أو يحاول الهروب من الأماكن التي خصصتها السلطة المختصة لحبسه أو من مكان العمل أو أثناء نقله. ويعاقب الجاني بالحبس من سنتين إلى خمس سنوات إذا وقع الهروب أو الشروع فيه بالعنف أو بالتهديد ضد الأشخاص أو بواسطة الكسر أو تحطيم باب السجن ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_188_19660608_OpEnact_82095c443e> ;
    dzdoc:replacementText "يعاقب بالحبس من شهرين إلى ثلاث سنوات كل من كان مقبوضا عليه أو معتقلا قانونا بمقتضى أمر أو حكم قضائي ويهرب أو يحاول الهروب من الأماكن التي خصصتها السلطة المختصة لحبسه أو من مكان العمل أو أثناء نقله. ويعاقب الجاني بالحبس من سنتين إلى خمس سنوات إذا وقع الهروب أو الشروع فيه بالعنف أو بالتهديد ضد الأشخاص أو بواسطة الكسر أو تحطيم باب السجن ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_188> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_188> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
