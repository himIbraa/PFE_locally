<https://legal.dz/resource/order/1966-06-08/66-156#version_art_263_bis_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن المؤقت من خمس (5) سنوات إلى عشرة (10) سنوات وبغرامة من 100.000 دج إلى 500.000 دج كل من يمارس أو يحرض أو يأمر بممارسة التعذيب على شخص . يعاقب على التعذيب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 150.000 دج إلى 800.000 دج ، إذا سبق أو صاحب أو تلى جناية غير القتل العمد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_263_bis_1_19660608_OpEnact_b29b895f29> ;
    dzdoc:replacementText "يعاقب بالسجن المؤقت من خمس (5) سنوات إلى عشرة (10) سنوات وبغرامة من 100.000 دج إلى 500.000 دج كل من يمارس أو يحرض أو يأمر بممارسة التعذيب على شخص . يعاقب على التعذيب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 150.000 دج إلى 800.000 دج ، إذا سبق أو صاحب أو تلى جناية غير القتل العمد ."@ar ;
