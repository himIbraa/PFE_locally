<https://legal.dz/resource/order/1966-06-08/66-156#version_art_291> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة كل من اختطف أو قبض أو حبس أو حجز أي شخص بدون أمر من السلطات المختصة وخارج الحالات التي يجيز أو يأمر فيها القانون بالقبض على الأفراد. وتطبق ذات العقوبة على من أعار مكانا لحبس أو لحجز هذا الشخص. إذا استمر الحبس أو الحجز لمدة أكثر من شهر فتكون العقوبة السجن المؤبد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_291_19660608_OpEnact_866fcfe0f2> ;
