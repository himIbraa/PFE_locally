    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_262> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:versionText "يعاقب باعتباره قاتلا كل مجرم مهما كان وصفه استعمل التعذيب أو ارتكب أعمال وحشية لارتكاب جنايته ."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_263_19660608_OpEnact_92b53d3ca8> a dzdoc:ArticleVersion ;
