    dzdoc:evidenceText "كل من تحصل على صحيفة السوابق القضائية باسم الغير، وذلك بانتحاله اسما كاذبا أو صفة كاذبة، يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 300.000 دج ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_248_19660608_OpEnact_e2f4103c15> ;
