<https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_4> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد اتجار بالأشخاص، تجنيد أو نقل أو تنقيل أو إيواء أو استقبال شخص أو أكثر بواسطة التهديد بالقوة أو باستعمالها أو غير ذلك من أشكال الإكراه، أو الاختطاف أو الاحتيال أو الخداع أو إساءة استعمال السلطة أو استغلال حالة استضعاف أو بإعطاء أو تلقي مبالغ مالية أو مزايا لنيل موافقة شخص له سلطة على شخص آخر بقصد الاستغلال. ويشمل الاستغلال استغلال دعارة الغير أو سائر أشكال الاستغلال الجنسي أو استغلال الغير في التسول أو السخرة أو الخدمة كرها أو الاسترقاق أو الممارسات الشبيهة بالرق أو الاستعباد أو نزع الأعضاء. "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_4_19660608_OpEnact_966df2e652> ;
    dzdoc:replacementText "يعد اتجار بالأشخاص، تجنيد أو نقل أو تنقيل أو إيواء أو استقبال شخص أو أكثر بواسطة التهديد بالقوة أو باستعمالها أو غير ذلك من أشكال الإكراه، أو الاختطاف أو الاحتيال أو الخداع أو إساءة استعمال السلطة أو استغلال حالة استضعاف أو بإعطاء أو تلقي مبالغ مالية أو مزايا لنيل موافقة شخص له سلطة على شخص آخر بقصد الاستغلال. ويشمل الاستغلال استغلال دعارة الغير أو سائر أشكال الاستغلال الجنسي أو استغلال الغير في التسول أو السخرة أو الخدمة كرها أو الاسترقاق أو الممارسات الشبيهة بالرق أو الاستعباد أو نزع الأعضاء. يعاقب على الاتجار بالأشخاص بالحبس من ثلاث (3) سنوات إلى عشر (10) سنوات وبغرامة من 300.000 دج إلى 1.000.000 دج. يعاقب على الاتجار بالأشخاص بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.500.000 دج، إذا سهل ارتكابه حالة استضعاف الضحية الناتجة عن سنها أو مرضها أو عجزها البدني أو الذهني، متى كانت هذه الظروف ظاهرة أو معلومة لدى الفاعل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

