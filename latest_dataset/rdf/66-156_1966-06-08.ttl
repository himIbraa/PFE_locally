<https://legal.dz/resource/order/1966-06-08/66-156#art_291_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_291> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة كل من اختطف أو قبض أو حبس أو حجز أي شخص بدون أمر من السلطات المختصة وخارج الحالات التي يجيز أو يأمر فيها القانون بالقبض على الأفراد."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_291_para_1> a dzdoc:Paragraph ;
