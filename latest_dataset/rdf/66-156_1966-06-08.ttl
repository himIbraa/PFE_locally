    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "253" ;
    dzdoc:position 337 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_252> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_252> ;
