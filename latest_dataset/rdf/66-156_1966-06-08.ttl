<https://legal.dz/resource/order/1966-06-08/66-156#version_art_368> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يعاقب على السرقات التي ترتكب من الأشخاص المبينين فيما بعد ولا تخول إلا الحق في التعويض المدني : (1) الأصول إضرارا بأولادهم أو غيرهم من الفروع. (2) الفروع إضرارا بأصولهم. (3) أحد الزوجين إضرارا بالزوج الآخر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_368_19660608_OpEnact_7f68a7f1a7> ;
    dzdoc:replacementText "لا يعاقب على السرقات التي ترتكب من الأشخاص المبينين فيما بعد ولا تخول إلا الحق في التعويض المدني : (1) الأصول إضرارا بأولادهم أو غيرهم من الفروع. (2) الفروع إضرارا بأصولهم. (3) أحد الزوجين إضرارا بالزوج الآخر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_368> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
