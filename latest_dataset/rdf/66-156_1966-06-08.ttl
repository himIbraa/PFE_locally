<https://legal.dz/resource/order/1966-06-08/66-156#version_art_13> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز أن يحكم بـ المنع من الإقامة في حالة الإدانة لارتكاب جناية أو جنحة. عندما ينص القانون على عقوبة المنع من الإقامة في التراب الوطني ، يجوز الحكم بها، إما نهائيا أو لمدة عشر (10) سنوات على الأكثر، على كل أجنبي مدان لارتكابه جناية أو جنحة. عندما يكون هذا المنع مقترنا بعقوبة سالبة للحرية ، فإن تطبيقه يوقف طوال آجال تنفيذ هذه العقوبة، ويستأنف بالنسبة للمدة المحددة بحكم الإدانة من يوم انقضاء العقوبة الأصلية أو الإفراج عن المحكوم عليه. يترتب على المنع من الإقامة في التراب الوطني اقتياد المحكوم عليه "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_13_19660608_OpEnact_905998d3a0> ;
    dzdoc:replacementText "يجوز أن يحكم بـ المنع من الإقامة في حالة الإدانة لارتكاب جناية أو جنحة. عندما ينص القانون على عقوبة المنع من الإقامة في التراب الوطني ، يجوز الحكم بها، إما نهائيا أو لمدة عشر (10) سنوات على الأكثر، على كل أجنبي مدان لارتكابه جناية أو جنحة. عندما يكون هذا المنع مقترنا بعقوبة سالبة للحرية ، فإن تطبيقه يوقف طوال آجال تنفيذ هذه العقوبة، ويستأنف بالنسبة للمدة المحددة بحكم الإدانة من يوم انقضاء العقوبة الأصلية أو الإفراج عن المحكوم عليه. يترتب على المنع من الإقامة في التراب الوطني اقتياد المحكوم عليه الأجنبي إلى الحدود مباشرة أو عند انقضاء عقوبة الحبس أو السجن. يعاقب الشخص الأجنبي الذي يخالف عقوبة المنع من الإقامة بالتراب الوطني المحكوم بها عليه، بالحبس من ثلاثة (3) أشهر إلى ثلاث (3) سنوات وبغرامة من 25.000 دج إلى 300.000 دج."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_13> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_13> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

