<https://legal.dz/resource/order/1966-06-08/66-156#art_170> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_7> ;
    dzdoc:eId "art_170" ;
    dzdoc:fullText "كل إخلال بالنظم المتعلقة بالمنتجات المعدة للتصدير التي من شأنها ضمان جودة صنفها ونوعها وأحجامها يعاقب بغرامة من 500 إلى 20.000 دج وبمصادرة البضائع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_170> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_170_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_170_19660608_OpEnact_a33bcae400> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_170_obligation_0_a6774fb5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "170" ;
    dzdoc:position 245 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_175> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:bid_interference ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_7> ;
    dzdoc:eId "art_175" ;
    dzdoc:fullText "يرتكب جريمة التعرض لحرية المزايدات ويعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 500 إلى 200.000 دينار كل من عرقل حرية المزايدات أو المناقصات أو تعرض لها أو أخل بها بطريق التعدي أو العنف أو التهديد وذلك في المزايدات على الملكية أو حق الانتفاع أو على تأجير الأموال العقارية أو المنقولة أو على المقاولات أو التوريدات أو الإستغلالات أو أية خدمات أخرى أو شرع في ذلك سواء قبل المزايدة أو المناقصة أو أثناءهما. ويعاقب بذات العقوبة كل من يبعد المزايدين أو يحد من حرية المزايدة أو المناقصة أو يشرع في ذلك سواء بطريق الهبات أو الوعود أو بالاتفاقات أو الطرق الاحتيالية وكذلك كل من تلقى هذه الهبات أو قبل هذه الوعود."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_175> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_175_defocc_3a1e3248f7cb> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_175_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_175_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_175_19660608_OpEnact_8fd6e6f1c9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "175" ;
    dzdoc:position 251 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_175_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_7> ;
    dzdoc:eId "art_175_bis" ;
    dzdoc:fullText "يكون الشخص المعنوي مسؤولا جزائيا عن الجرائم المحددة في هذا الفصل، وذلك طبقا للشروط المنصوص عليها في المادة 51 مكرر من هذا القانون. تطبق على الشخص المعنوي عقوبة الغرامة حسب الكيفيات المقررة في المادة 18 مكرر ، وفي المادة 18 مكرر 2 من هذا القانون عند الاقتضاء. ويتعرض أيضا لواحدة أو أكثر من العقوبات التكميلية المنصوص عليها في المادة 18 مكرر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_175_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_175_bis_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_175_bis_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_175_bis_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_175_bis_19660608_OpEnact_ff24f5dc1c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "175 مكرر" ;
    dzdoc:position 252 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:usesTerm dzterm:legal_person .

<https://legal.dz/resource/order/1966-06-08/66-156#art_177_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_1> ;
    dzdoc:eId "art_177_bis_1" ;
    dzdoc:fullText "يكون الشخص المعنوي مسؤولا جزائيا وفقا للشروط المنصوص عليها في المادة 51 مكرر أعلاه، عن الجرائم المنصوص عليها في المادة 176 من هذا القانون ويعاقب بالغرامة التي تساوي خمس (5) مرات الحد الأقصى للغرامة المقررة للشخص الطبيعي المنصوص عليها في المادة 177 من هذا القانون . ويتعرض أيضا لواحدة أو أكثر من العقوبات الآتية : 1- مصادرة الشيء الذي استعمل في ارتكاب الجريمة أو نتج عنها، 2- المنع لمدة خمس (5) سنوات من مزاولة بطريقة مباشرة أو غير مباشرة ، النشاط الذي أدى إلى الجريمة أو الذي ارتكبت الجريمة بمناسبته، 3- الإقصاء من الصفقات العمومية لمدة خمس (5) سنوات، 4- غلق المؤسسة أو فرع من فروعها لمدة لا تتجاوز خمس (5) سنوات، 5- حل الشخص المعنوي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_177_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_177_bis_1_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_177_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_177_bis_1_19660608_OpEnact_45e7d083aa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_177_bis_1_obligation_0_4e25a837> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "177 مكرر 1" ;
    dzdoc:position 257 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_176>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_177>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_176>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_177>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_179> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_1> ;
    dzdoc:eId "art_179" ;
    dzdoc:fullText "يستفيد من العذر المعفي وفقا للشروط المقررة في المادة 52 من يقوم من الجناة بالكشف للسلطات عن الاتفاق الذي تم أو عن وجود الجمعية وذلك قبل أي شروع في الجناية موضوع الجمعية أو الاتفاق وقبل البدء في التحقيق ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_179_right_0_b1013b50> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_179> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_179_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_179_19660608_OpEnact_05908c9a08> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "179" ;
    dzdoc:position 259 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_52> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_52> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_179_condition_0_424737c4> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_186> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_2> ;
    dzdoc:eId "art_186" ;
    dzdoc:fullText "لا يقضى بعقوبة ما عن جريمة العصيان على الأشخاص الذين كانوا أعضاء في الاجتماع دون أن يؤدوا فيه خدمة أو وظيفة وانسحبوا منه عند أول تنبيه من السلطة العمومية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_186> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_186_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_186_19660608_OpEnact_2d82fbd361> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "186" ;
    dzdoc:position 266 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_186_condition_0_a510c749> ;
    dzdoc:usesTerm dzterm:السلطة_العمومية,
        dzterm:جريمة_العصيان .

<https://legal.dz/resource/order/1966-06-08/66-156#art_193> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_3> ;
    dzdoc:eId "art_193" ;
    dzdoc:fullText "يحكم على جميع من أعانوا أو سهلوا الهروب عمدا بأن يعوضوا متضامنين للمجني عليه أو لذوي حقوقه الضرر الناشئ عن الجريمة التي كان الهارب معتقلا من أجلها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_193> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_193_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_193_19660608_OpEnact_de50dd61b1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_193_obligation_0_202d6a94> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "193" ;
    dzdoc:position 274 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_195> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_4> ;
    dzdoc:eId "art_195" ;
    dzdoc:fullText "يعاقب بالحبس من شهر إلى ستة أشهر كل من اعتاد ممارسة التسول في أي مكان كان وذلك رغم وجود وسائل التعيش لديه أو إمكانه الحصول عليها بالعمل أو بأية طريقة مشروعة أخرى ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_195> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_195_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_195_19660608_OpEnact_8a9b1494af> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 195" ;
    dzdoc:position 276 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_195_condition_0_2247117b> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_204> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_1> ;
    dzdoc:eId "art_204" ;
    dzdoc:fullText "يجب الحكم ب المصادرة المنصوص عليها في المادة 25 في الجرائم المشار إليها في المواد 197 و 201 و 203 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_204> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_204_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_204_19660608_OpEnact_21bb83019c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_204_obligation_0_e457f309> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "204" ;
    dzdoc:position 287 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_197>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_201>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_203>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_25> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_197>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_201>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_203>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_25> ;
    dzdoc:usesTerm dzterm:confiscation .

<https://legal.dz/resource/order/1966-06-08/66-156#art_207> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_2> ;
    dzdoc:eId "art_207" ;
    dzdoc:fullText "يعاقب بالسجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج كل من تحصل بغير حق على طوابع أو مطارق أو دمغات صحيحة خاصة بالدولة والمبينة في المادة 206 ، ووضعها أو استعملها استعمالا ضارا بحقوق ومصالح الدولة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_207> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_207_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_207_19660608_OpEnact_d8032fa2b5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_207_obligation_0_b390fd36> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 207" ;
    dzdoc:position 290 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_206> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_206> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_210> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_2> ;
    dzdoc:eId "art_210" ;
    dzdoc:fullText "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 5.000 دينار كل من تحصل بغير حق على أختام صحيحة أو علامات أو مطبوعات من المنصوص عليها في المادة 209 ووضعها أو استعملها بطريق الغش أو شرع في ذلك . ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة من سنة إلى خمس سنوات على الأكثر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_210> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_210_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_210_19660608_OpEnact_e34fb40318> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_210_obligation_0_549701b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 210" ;
    dzdoc:position 293 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_209> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_209> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_211> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_2> ;
    dzdoc:eId "art_211" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين إلى سنة وبغرامة من 500 إلى 1.000 دينار كل من : 1 ) استعمل طوابع بريد أو طوابع منفصلة أو أوراق أو نماذج مدموغة سبق استعمالها أو زيف الطوابع بأية وسيلة كانت بغرض أن يتفادى ختمها لإبطالها وأن يسمح بهذه الطريقة باستعمالها بعد ذلك. 2 ) زاد من قيمة طوابع البريد أو غيرها من الأوراق البريدية ذات القيمة المالية سواء كانت قد أبطلت أم لا وذلك بالطباعة أو التخريم أو بأية وسيلة أخرى أو باع أو روج أو عرض أو وزع أو صدر هذه الطوابع التي زيدت قيمتها. 3 ) قلد أو أصدر أو زيف قسائم سداد الضريبة أو الطوابع أو بصمات التخليص أو قسائم الرد التي تصدرها إدارة البريد في بلد أجنبي أو باع أو روج أو وزع قسائم سداد الضريبة أو الطوابع أو بصمات التخليص أو قسائم الرد المذكورة أو استعملها مع علمه بذلك."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_211_permission_0_80c64ff6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_211> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_211_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_211_19660608_OpEnact_f51b5230d0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_211_obligation_0_3cbd5be4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 211" ;
    dzdoc:position 294 ;
    dzdoc:usesTerm dzterm:postage_stamps .

<https://legal.dz/resource/order/1966-06-08/66-156#art_213> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_2> ;
    dzdoc:eId "art_213" ;
    dzdoc:fullText "يجب الحكم بالمصادرة المنصوص عليها في المادة 25 في الجرائم المحددة في هذا القسم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_213> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_213_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_213_19660608_OpEnact_ca017b3e19> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_213_obligation_0_e457f309> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 213" ;
    dzdoc:position 296 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_25> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_25> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_223> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_5> ;
    dzdoc:eId "art_223" ;
    dzdoc:fullText "كل من تحصل بغير حق على إحدى الوثائق المبينة في المادة 222 أو شرع في الحصول عليها سواء بالإدلاء بإقرارات كاذبة أو بانتحال اسم كاذب أو صفة كاذبة أو بتقديم معلومات أو شهادات أو إقرارات كاذبة يعاقب بالحبس من ثلاثة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 5.000 دينار. وتطبق العقوبات ذاتها على من استعمل مثل هذه الوثيقة وكان قد حصل عليها بالشروط السابق بيانها أو كانت قد صدرت باسم غير اسمه. و الموظف الذي يسلم أو يأمر بتسليم إحدى الوثائق المعينة في المادة 222 إلى شخص يعلم أن لا حق له فيها يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 1.500 إلى 15.000 دينار ما لم يكون الفعل إحدى الجرائم الأشد المنصوص عليها في المواد من 126 إلى 134 ويجوز علاوة على ذلك أن يحكم عليه بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 من سنة على الأقل إلى خمس سنوات على الأكثر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_223> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_223_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_223_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_223_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_223_19660608_OpEnact_523a3473d0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 223" ;
    dzdoc:position 306 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_126>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_134>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_222> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_126>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_134>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_222> ;
    dzdoc:usesTerm dzterm:official .

<https://legal.dz/resource/order/1966-06-08/66-156#art_240> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_7> ;
    dzdoc:eId "art_240" ;
    dzdoc:fullText "كل شخص وجهت إليه اليمين أو ردت عليه في المواد المدنية وحلفها كذبا يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 2.000 دينار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_240> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_240_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_240_19660608_OpEnact_1c443175fd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_240_obligation_0_fb29a7f4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 240" ;
    dzdoc:position 324 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_240_condition_0_88d2f4db> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_248> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_8> ;
    dzdoc:eId "art_248" ;
    dzdoc:fullText "كل من تحصل على صحيفة السوابق القضائية باسم الغير، وذلك بانتحاله اسما كاذبا أو صفة كاذبة، يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 300.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_248> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_248_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_248_19660608_OpEnact_e2f4103c15> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_248_obligation_0_4969c4cc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 248" ;
    dzdoc:position 332 ;
    dzdoc:usesTerm dzterm:criminal_record .

<https://legal.dz/resource/order/1966-06-08/66-156#art_253> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_8> ;
    dzdoc:eId "art_253" ;
    dzdoc:fullText "تطبق العقوبات المنصوص عليها في المادة 252 على مؤسسي و مديري و مسيري الشركات أو المؤسسات ذات الغرض التجاري أو الصناعي أو المالي الذين يضعون اسم أحد أعضاء الحكومة السابقين أو اسم قاض أو قاض سابق أو موظف أو موظف سابق أو أحد ذوي المنزلة مع ذكر صفته في أية دعاية يقومون بها لصالح المشروع الذي يديرونه أو يزمعون إنشاءه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_253> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_253_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
