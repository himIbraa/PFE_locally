        "وتقوم المؤامرة بمجرد اتفاق شخصين أو أكثر على التصميم على ارتكابها."@ar,
        "وتقوم المؤامرة بمجرد د اتفاق شخصين أو أكثر على التصميم على ارتكابها"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_78_defocc_63b89f86eca0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_85_defocc_77a0b03077ba> .

dzterm:human_trafficking a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الاتجار بالأشخاص"@ar,
        "يعد اتجار بالأشخاص، تجنيد أو نقل أو تنقيل أو إيواء أو استقبال شخص أو أكثر بواسطة التهديد بالقوة أو باستعمالها أو غير ذلك من أشكال الإكراه، أو الاختطاف أو الاحتيال أو الخداع أو إساءة استعمال السلطة أو استغلال حالة استضعاف أو بإعطاء أو تلقي مبالغ مالية أو مزايا لنيل موافقة شخص له سلطة على شخص آخر بقصد الاستغلال."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4_defocc_110e6092d0d1> .

dzterm:minor a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "القاصر"@ar,
        "قاصر"@ar,
        "قاصرا"@ar .

dzterm:treason a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يرتكب جريمة الخيانة ويعاقب بالإعدام كل جزائري وكل عسكري أو بحار في خدمة الجزائر يقوم بأحد الأعمال الآتية :"@ar,
        "يرتكب جريمة الخيانة ويعاقب بالإعدام كل جزائري وكل عسكري أو بحار في خدمة الجزائر يقوم في وقت الحرب بأحد الأعمال الآتية :"@ar,
        "يكون مرتكبا للخيانة ويعاقب بالإعدام كل جزائري يقوم :"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_61_defocc_1c9ffb232a4e>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_62_defocc_9edf4089a1ca>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_63_defocc_b0049e1c2f5d> .

