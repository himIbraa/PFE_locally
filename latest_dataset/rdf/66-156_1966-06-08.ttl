    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_5_obligation_0_45408f47> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "87 مكرر 5" ;
    dzdoc:position 138 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_90> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_90" ;
    dzdoc:fullText "يعاقب بالإعدام من يقومون بإدارة أو تنظيم حركة تمرد أو من يزودونها أو يمدونها عمدا أو عن علم بالأسلحة أو الذخائر أو أدوات الجرائم أو يرسلون إليها مؤنا أو يجرون مخابرات بأية طريقة كانت مع مديري أو قواد الحركة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_90> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_90_para_0> ;
