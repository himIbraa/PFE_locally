<https://legal.dz/resource/order/1966-06-08/66-156#version_art_293_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من يخطف أو يحاول خطف شخص، عن طريق العنف، أو التهديد أو الاستدراج، يعاقب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج . ويعاقب الفاعل بالسجن المؤبد إذا تعرض الشخص المخطوف إلى تعذيب أو عنف جنسي أو إذا كان الدافع إلى الخطف هو تسديد فدية أو تنفيذ شرط أو أمر . وتطبق على الفاعل العقوبة المنصوص عليها في الفقرة الأولى من المادة 263 من هذا القانون إذا أدى الخطف إلى وفاة الشخص المخطوف . لا يستفيد الجاني من ظروف التخفيف المنصوص عليها في هذا القانون، مع مراع"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_293_bis_19660608_OpEnact_2eef5f0c20> ;
    dzdoc:replacementText "كل من يخطف أو يحاول خطف شخص، عن طريق العنف، أو التهديد أو الاستدراج، يعاقب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج . ويعاقب الفاعل بالسجن المؤبد إذا تعرض الشخص المخطوف إلى تعذيب أو عنف جنسي أو إذا كان الدافع إلى الخطف هو تسديد فدية أو تنفيذ شرط أو أمر . وتطبق على الفاعل العقوبة المنصوص عليها في الفقرة الأولى من المادة 263 من هذا القانون إذا أدى الخطف إلى وفاة الشخص المخطوف . لا يستفيد الجاني من ظروف التخفيف المنصوص عليها في هذا القانون، مع مراعاة أحكام المادة 294 أدناه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_293_bis_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن المؤبد كل من يخطف أو يحاول خطف قاصر لم يكمل ثماني عشرة (18) سنة، عن طريق العنف أو التهديد أو الاستدراج أو غيرها من الوسائل. وتطبق على الفاعل العقوبة المنصوص عليها في الفقرة الأولى من المادة 263 من هذا القانون، إذا تعرض القاصر المخطوف إلى تعذيب أو عنف جنسي أو إذا كان الدافع إلى الخطف هو تسديد فدية أو إذا ترتبت عليه وفاة الضحية . لا يستفيد الجاني من ظروف التخفيف المنصوص عليها في هذا القانون مع مراعاة أحكام المادة 294 أدناه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_293_bis_1_19660608_OpEnact_8d045e5707> ;
    dzdoc:replacementText "يعاقب بالسجن المؤبد كل من يخطف أو يحاول خطف قاصر لم يكمل ثماني عشرة (18) سنة، عن طريق العنف أو التهديد أو الاستدراج أو غيرها من الوسائل. وتطبق على الفاعل العقوبة المنصوص عليها في الفقرة الأولى من المادة 263 من هذا القانون، إذا تعرض القاصر المخطوف إلى تعذيب أو عنف جنسي أو إذا كان الدافع إلى الخطف هو تسديد فدية أو إذا ترتبت عليه وفاة الضحية . لا يستفيد الجاني من ظروف التخفيف المنصوص عليها في هذا القانون مع مراعاة أحكام المادة 294 أدناه."@ar ;
