<https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون العقوبات التي يتعرض لها مرتكب الأفعال المذكورة في المادة 87 مكرر أعلاه، كما يأتي : الإعدام عندما تكون العقوبة المنصوص عليها في القانون السجن المؤبد، السجن المؤبد عندما تكون العقوبة المنصوص عليها في القانون السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة، السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة، عندما تكون العقوبة المنصوص عليها في القانون، السجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات، تكون العقوبة مضاعفة بالنسبة للعقوبات الأخرى. وتطبق أحكام المادة 60 مكرر على الجرائم المنصوص "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_1_19660608_OpEnact_65c24edb7f> ;
    dzdoc:replacementText "تكون العقوبات التي يتعرض لها مرتكب الأفعال المذكورة في المادة 87 مكرر أعلاه، كما يأتي : الإعدام عندما تكون العقوبة المنصوص عليها في القانون السجن المؤبد، السجن المؤبد عندما تكون العقوبة المنصوص عليها في القانون السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة، السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة، عندما تكون العقوبة المنصوص عليها في القانون، السجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات، تكون العقوبة مضاعفة بالنسبة للعقوبات الأخرى. وتطبق أحكام المادة 60 مكرر على الجرائم المنصوص عليها في هذه المادة."@ar ;
