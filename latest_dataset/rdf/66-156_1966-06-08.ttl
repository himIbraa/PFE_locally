<https://legal.dz/resource/order/1966-06-08/66-156#version_art_325_19660608_OpEnact_0f5f22cf9a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1966-06-08"^^xsd:date ;
