<https://legal.dz/resource/order/1966-06-08/66-156#version_art_270> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا نتج عن الضرب أو الجرح أو العنف أو التعدي أو الحرمان المشار إليه في المادة السابقة مرض أو عدم القدرة على الحركة أو عجز كلي عن العمل لأكثر من خمسة عشر يوما، أو إذا وجد سبق إصرار، أو ترصد فتكون العقوبة الحبس من ثلاث إلى عشر سنوات والغرامة من 500 إلى 6.000 دج. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من الحقوق الواردة في المادة 14 من هذا القانون وبالمنع من الإقامة من سنة على الأقل إلى خمس سنوات على الأكثر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_270_19660608_OpEnact_c1bd5b54e7> ;
    dzdoc:replacementText "إذا نتج عن الضرب أو الجرح أو العنف أو التعدي أو الحرمان المشار إليه في المادة السابقة مرض أو عدم القدرة على الحركة أو عجز كلي عن العمل لأكثر من خمسة عشر يوما، أو إذا وجد سبق إصرار، أو ترصد فتكون العقوبة الحبس من ثلاث إلى عشر سنوات والغرامة من 500 إلى 6.000 دج. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من الحقوق الواردة في المادة 14 من هذا القانون وبالمنع من الإقامة من سنة على الأقل إلى خمس سنوات على الأكثر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
