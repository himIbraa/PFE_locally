    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:versionText "قتل الأطفال هو إزهاق روح طفل حديث عهد بالولادة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_25_19660608_OpEnact_ddf10a7aea> a dzdoc:ArticleVersion ;
