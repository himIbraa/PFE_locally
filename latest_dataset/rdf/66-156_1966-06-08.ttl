    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_186> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_186> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_187> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من يعترض بطريق الاعتداء على تنفيذ أعمال أمرت أو رخصت بها السلطة العمومية يعاقب بالحبس من ثلاثة أشهر إلى سنة وبغرامة لا تتجاوز ربع التعويضات المدنية ولا تقل عن 1.000 دج . وكل من يعترض بطريق التجمهر أو التهديد أو العنف على تنفيذ هذه الأعمال يعاقب بالحبس من ثلاثة أشهر إلى سنتين وبالغرامة المنصوص عليها في الفقرة السابقة أعلاه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_187_19660608_OpEnact_3f08695c67> ;
    dzdoc:replacementText "كل من يعترض بطريق الاعتداء على تنفيذ أعمال أمرت أو رخصت بها السلطة العمومية يعاقب بالحبس من ثلاثة أشهر إلى سنة وبغرامة لا تتجاوز ربع التعويضات المدنية ولا تقل عن 1.000 دج . وكل من يعترض بطريق التجمهر أو التهديد أو العنف على تنفيذ هذه الأعمال يعاقب بالحبس من ثلاثة أشهر إلى سنتين وبالغرامة المنصوص عليها في الفقرة السابقة أعلاه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_187> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
