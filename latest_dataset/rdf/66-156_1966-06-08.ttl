<https://legal.dz/resource/order/1966-06-08/66-156#art_178_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_178> ;
    dzdoc:position 0 ;
