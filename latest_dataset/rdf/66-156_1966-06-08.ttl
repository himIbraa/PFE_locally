<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_4_bis> ;
    dzdoc:eId "art_87_bis_6" ;
    dzdoc:fullText "يعاقب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة مالية من 500.000 دج إلى 1.000.000 دج، كل جزائري ينشط أو ينخرط في الخارج في جمعية أو جماعة أو منظمة إرهابية أو تخريبية مهما كان شكلها أو تسميتها حتى وإن كانت أفعالها غير موجهة ضد الجزائر. وتكون العقوبة السجن المؤبد عندما تستهدف الأفعال المبينة أعلاه الإضرار بمصالح الجزائر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_6_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_6_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_87_bis_6_19660608_OpEnact_a5162ac8b6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_6_obligation_0_c0198914>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_6_obligation_1_52004d3e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "87 مكرر 6" ;
    dzdoc:position 139 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_89> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_89" ;
    dzdoc:fullText "يعاقب بالسجن المؤبد كل من يقوم أثناء حركة التمرد بالأفعال الآتية : الاستيلاء على الأسلحة أو الذخائر أو المعدات من أي نوع كانت، سواء أكان ذلك عن طريق استعمال العنف أو التهديد أو نهب المحلات أو المراكز أو المستودعات أو الترسانات أو غيرها من المؤسسات العمومية أو كان ذلك بتجريد أعوان القوات العمومية من الأسلحة. حمل الأسلحة أو الذخائر علانية أو خفية أو ارتداء زي رسمي أو ملابس أو علامات أخرى مدنية أو عسكرية. ويعاقب بالإعدام الأشخاص الذين يستعملون أسلحتهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_89> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_89_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_89_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_89_19660608_OpEnact_d560689b7d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_89_obligation_0_b55b605d>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_89_obligation_1_30f06686> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "89" ;
    dzdoc:position 145 ;
    dzdoc:usesTerm dzterm:insurrection_movement,
        dzterm:public_forces .

