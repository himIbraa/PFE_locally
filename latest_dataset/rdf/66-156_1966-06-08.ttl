<https://legal.dz/resource/order/1966-06-08/66-156#version_art_209> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 10.000 دينار كل من : قلد العلامات المعدة لوضعها باسم الحكومة أو أي مرفق عام على مختلف أنواع السلع أو البضائع أو استعمل هذه العلامات المزورة. قلد خاتما أو طابعا أو علامة لأية سلطة أو استعمل الخاتم أو الطابع أو العلامة المقلدة. قلد الأوراق المعنونة أو المطبوعات الرسمية المستعملة في الأجهزة الرئيسية للدولة أو في الإدارات العمومية أو في مختلف جهات القضاء أو باعها أو روجها أو وزعها أو استعمل هذه الأوراق أو المطبوعات المقلدة. قلد أو زور طوابع البريد"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_209_19660608_OpEnact_75e9111339> ;
    dzdoc:replacementText "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 10.000 دينار كل من : قلد العلامات المعدة لوضعها باسم الحكومة أو أي مرفق عام على مختلف أنواع السلع أو البضائع أو استعمل هذه العلامات المزورة. قلد خاتما أو طابعا أو علامة لأية سلطة أو استعمل الخاتم أو الطابع أو العلامة المقلدة. قلد الأوراق المعنونة أو المطبوعات الرسمية المستعملة في الأجهزة الرئيسية للدولة أو في الإدارات العمومية أو في مختلف جهات القضاء أو باعها أو روجها أو وزعها أو استعمل هذه الأوراق أو المطبوعات المقلدة. قلد أو زور طوابع البريد أو بصمات التخليص أو قسائم الرد التي تصدرها إدارة البريد أو الطوابع المالية المنفصلة أو الأوراق أو النماذج المدموغة أو باع أو روج أو وزع أو استعمل الطوابع أو العلامات أو قسائم الرد أو الأوراق أو النماذج المدموغة المذكورة وهي مقلدة أو مزورة مع علمه بذلك. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة من سنة إلى خمس سنوات على الأكثر. ويعاقب على الشروع في الجرائم المبينة أعلاه كالجريمة التامة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_209> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_209> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_21> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الحجز القضائي في مؤسسة إستشفائية للأمراض العقلية هو وضع الشخص بناء على أمر أو حكم أو قرار قضائي في مؤسسة مهيأة لهذا الغرض بسبب خلل في قواه العقلية قائم وقت ارتكابه الجريمة أو اعتراه بعد ارتكابها. يمكن أن يصدر الأمر بـ الحجز القضائي بموجب أي أمر أو حكم أو قرار بإدانة المتهم أو العفو عنه أو ببراءته أو بانتفاء وجه الدعوى، غير أنه في الحالتين الأخيرتين، يجب أن تكون مشاركته في الوقائع المادية ثابتة . يجب إثبات الخلل العقلي في الحكم الصادر بالحجز القضائي بعد الفحص الطبي . يخضع الشخص الموضوع في مؤسسة إ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_21_19660608_OpEnact_0d4825b2f3> ;
    dzdoc:replacementText "الحجز القضائي في مؤسسة إستشفائية للأمراض العقلية هو وضع الشخص بناء على أمر أو حكم أو قرار قضائي في مؤسسة مهيأة لهذا الغرض بسبب خلل في قواه العقلية قائم وقت ارتكابه الجريمة أو اعتراه بعد ارتكابها. يمكن أن يصدر الأمر بـ الحجز القضائي بموجب أي أمر أو حكم أو قرار بإدانة المتهم أو العفو عنه أو ببراءته أو بانتفاء وجه الدعوى، غير أنه في الحالتين الأخيرتين، يجب أن تكون مشاركته في الوقائع المادية ثابتة . يجب إثبات الخلل العقلي في الحكم الصادر بالحجز القضائي بعد الفحص الطبي . يخضع الشخص الموضوع في مؤسسة إستشفائية للأمراض العقلية لنظام الاستشفاء الإجباري المنصوص عليه في التشريع الجاري به العمل، غير أن النائب العام يبقى مختصا فيما يتعلق بمآل الدعوى العمومية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_21> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_21> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_210> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
