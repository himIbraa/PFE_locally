    rdfs:label "تخفيض عقوبات الحبس والغرامة عن"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "إذا كان المتهم مسبوقا قضائيا، بمفهوم المادة 53 مكرر 5 أدناه ، فإنه لا يجوز تخفيض عقوبات الحبس والغرامة عن الحد الأدنى المقرر قانونا للجنحة المرتكبة عمدا ، ويتعين الحكم بهما في حالة النص عليهما معا. ولا يجوز في أي حال استبدال الحبس بالغرامة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_4> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_6_condition_0_c87a510f> a dznorm:Condition ;
