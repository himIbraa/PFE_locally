<https://legal.dz/resource/order/1966-06-08/66-156#version_art_154> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من خبأ أو أخفى جثة يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة بين 500 إلى 1.000 دينار. وإذا كان المخفي يعلم أن الجثة لشخص مقتول أو متوفى نتيجة ضرب أو جرح فإن العقوبة تكون الحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 5.000 دينار."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_154_19660608_OpEnact_da3e96e056> ;
