<https://legal.dz/resource/order/1966-06-08/66-156#art_178> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_1> ;
    dzdoc:eId "art_178" ;
    dzdoc:fullText "يعاقب بالسجن من خمس إلى عشر سنوات كل من أعان مرتكبي الجنايات المنصوص عليها في المادة 176 بأن زودهم بآلات لارتكابها أو وسائل للمراسلة أو مساكن أو أماكن للاجتماع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_178> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_178_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_178_19660608_OpEnact_fb18e9b593> ;
