    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_4> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_4_obligation_1_e9ee9e29> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
