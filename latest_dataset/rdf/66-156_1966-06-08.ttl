<https://legal.dz/resource/order/1966-06-08/66-156#art_180_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_180> ;
    dzdoc:position 0 ;
    dzdoc:text "فيما عدا الحالات المنصوص عليها في المادتين 42 و 91 فقرات 2 و 3 و 4 كل من أخفى عمدا شخصا يعلم أنه ارتكب جناية أو أن العدالة تبحث عنه بسبب هذا الفعل وكل من حال عمدا دون القبض على الجاني أو البحث عنه أو شرع في ذلك وكل من ساعده على الاختفاء أو الهرب يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 1.000 إلى 10.000 دينار أو بإحدى هاتين العقوبتين."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_180_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_180> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا تطبق أحكام الفقرة السابقة على أقارب وأصهار الجاني لغاية الدرجة الرابعة فيما عدا ما يتعلق بالجنايات التي ترتكب ضد القصر الذين لا تجاوز سنهم 13 سنة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_181_obligation_0_4ad7d239> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
