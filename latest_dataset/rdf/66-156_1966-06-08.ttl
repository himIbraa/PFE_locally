<https://legal.dz/resource/order/1966-06-08/66-156#version_art_35> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا صدرت عدة أحكام سالبة للحرية بسبب تعدد المحاكمات فإن العقوبة الأشد وحدها هي التي تنفذ. ومع ذلك إذا كانت العقوبات المحكوم بها من طبيعة واحدة فإنه يجوز للقاضي بقرار مسبب أن يأمر بضمها كلها أو بعضها في نطاق الحد الأقصى المقرر قانونا للجريمة الأشد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_35_19660608_OpEnact_1093adf53a> ;
    dzdoc:replacementText "إذا صدرت عدة أحكام سالبة للحرية بسبب تعدد المحاكمات فإن العقوبة الأشد وحدها هي التي تنفذ. ومع ذلك إذا كانت العقوبات المحكوم بها من طبيعة واحدة فإنه يجوز للقاضي بقرار مسبب أن يأمر بضمها كلها أو بعضها في نطاق الحد الأقصى المقرر قانونا للجريمة الأشد ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
