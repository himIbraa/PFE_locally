<https://legal.dz/resource/order/1966-06-08/66-156#version_art_187_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين (2) إلى ستة (6) أشهر وبغرامة من 1.000 دج إلى 10.000 دج أو بإحدى هاتين العقوبتين فقط كل من لا يمتثل لأمر تسخير صادر ومبلغ له وفقا للأشكال التنظيمية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_187_bis_19660608_OpEnact_9536bc28d6> ;
    dzdoc:replacementText "يعاقب بالحبس من شهرين (2) إلى ستة (6) أشهر وبغرامة من 1.000 دج إلى 10.000 دج أو بإحدى هاتين العقوبتين فقط كل من لا يمتثل لأمر تسخير صادر ومبلغ له وفقا للأشكال التنظيمية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
