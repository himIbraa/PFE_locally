    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "كل من أخفى عمدا أشياء مختلسة أو مبددة أو متحصلة من جناية أو جنحة في مجموعها أو في جزء منها يعاقب بالحبس من سنة على الأقل إلى خمس سنوات على الأكثر وبغرامة من 500 إلى 20.000 دينار."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_387> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_387_para_0> a dzdoc:Paragraph ;
