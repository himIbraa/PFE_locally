    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dznorm:conditionText "عندما لا ينص القانون على عقوبة الغرامة بالنسبة للأشخاص الطبيعيين سواء في الجنايات أو الجنح، وقامت المسؤولية الجزائية للشخص المعنوي طبقا لأحكام المادة 51 مكرر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2_condition_0_533ae1a2_ref_5a569abca85d> a dzdoc:Reference ;
