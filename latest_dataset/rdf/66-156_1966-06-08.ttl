<https://legal.dz/resource/order/1966-06-08/66-156#version_art_227> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من حرر باسم أحد الموظفين أو أحد القائمين بوظيفة عمومية دون أن تكون له صفة في ذلك شهادة بحسن السلوك أو بالفقر أو بإثبات غير ذلك من الظروف التي من شأنها أن تدعو إلى وضع الشخص المعين في هذه الشهادة تحت رعاية السلطات أو الأفراد أو إلى حصوله على عمل أو قرض أو معونة يعاقب بالحبس من ستة أشهر إلى سنتين. وتطبق العقوبات ذاتها على : من زور شهادة كانت أصلا صحيحة وذلك ليجعلها تنطبق على غير الشخص الذي صدرت أصلا له. من استعمل الشهادة وهي مصطنعة أو مزورة على هذه الصورة. وإذا كانت الشهادة منسوبة إلى أحد الأفر"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_227_19660608_OpEnact_8f06e795f0> ;
    dzdoc:replacementText "كل من حرر باسم أحد الموظفين أو أحد القائمين بوظيفة عمومية دون أن تكون له صفة في ذلك شهادة بحسن السلوك أو بالفقر أو بإثبات غير ذلك من الظروف التي من شأنها أن تدعو إلى وضع الشخص المعين في هذه الشهادة تحت رعاية السلطات أو الأفراد أو إلى حصوله على عمل أو قرض أو معونة يعاقب بالحبس من ستة أشهر إلى سنتين. وتطبق العقوبات ذاتها على : من زور شهادة كانت أصلا صحيحة وذلك ليجعلها تنطبق على غير الشخص الذي صدرت أصلا له. من استعمل الشهادة وهي مصطنعة أو مزورة على هذه الصورة. وإذا كانت الشهادة منسوبة إلى أحد الأفراد العاديين فإن اصطناعها أو استعمالها يعاقب عليه بالحبس من شهر إلى ستة أشهر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_227> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_227> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

