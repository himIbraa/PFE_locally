    dznorm:sourceArticle "art_110_bis" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_110_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_110_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "كل ضابط بالشرطة القضائية الذي يمتنع عن تقديم السجل الخاص المنصوص عليه في المادة 52 الفقرة 3 من قانون الإجراءات الجزائية إلى الأشخاص المختصين بإجراء الرقابة وهو مسجل، يجب أن يتضمن أسماء الأشخاص الذين هم تحت الحراسة القضائية يكون قد ارتكب الجنحة المشار إليها في المادة 110 ويعاقب بنفس العقوبة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_110_bis_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_110_bis> ;
    dzdoc:position 1 ;
    dzdoc:text "وكل ضابط بالشرطة القضائية الذي يتعرض رغم الأوامر الصادرة طبقا لـ المادة 51 من قانون الإجراءات الجزائية من وكيل الجمهورية لإجراء الفحص الطبي لشخص هو تحت الحراسة القضائية الواقعة تحت سلطته يعاقب بالحبس من شهر إلى ثلاثة أشهر وبغرامة من 500 إلى 1.000 دج أو بإحدى هاتين العقوبتين فقط."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_110_condition_0_6e074122> a dznorm:Condition ;
    dznorm:conditionText "يتسلم مسجونا دون أن يكون مصحوبا بأوامر حبس قانونية أو يرفض تقديم هذا المسجون إلى السلطات أو الأشخاص المخول لهم زيارته بدون أن يثبت وجود منع من القاضي المحقق أو يرفض تقديم سجلاته إلى هؤلاء الأشخاص المختصين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_110> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_110_obligation_0_15b67e26> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_110> ;
    dznorm:position 0 ;
    dznorm:provisionText "يكون قد ارتكب جريمة الحجز التحكمي ويعاقب بالحبس مدة من ستة أشهر إلى سنتين وبغرامة من 500 إلى 1.000 دج"@ar ;
    dznorm:sourceArticle "art_110" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_110_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_110> ;
    dzdoc:position 0 ;
    dzdoc:text "كل عون في مؤسسة إعادة التربية أو في مكان مخصص بحراسة المقبوض عليهم يتسلم مسجونا دون أن يكون مصحوبا بأوامر حبس قانونية أو يرفض تقديم هذا المسجون إلى السلطات أو الأشخاص المخول لهم زيارته بدون أن يثبت وجود منع من القاضي المحقق أو يرفض تقديم سجلاته إلى هؤلاء الأشخاص المختصين، يكون قد ارتكب جريمة الحجز التحكمي ويعاقب بالحبس مدة من ستة أشهر إلى سنتين وبغرامة من 500 إلى 1.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_111_condition_0_19432147> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1966-06-08/66-156#art_111_condition_0_19432147_role_162317e090> ;
    dznorm:conditionText "يجري متابعات، أو يصدر أمرا أو حكما أو يوقع عليهما، أو يصدر أمرا قضائيا ضد شخص متمتع بالحصانة القضائية في غير حالات التلبس بالجريمة دون أن يحصل قبل ذلك على رفع الحصانة عنه وفقا للأوضاع القانونية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_111> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_111_condition_0_19432147_role_162317e090> a dznorm:Role ;
