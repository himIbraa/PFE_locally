    dzdoc:occursInArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_15> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_15_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "المصادرة هي الأيلولة النهائية إلى الدولة لمال أو مجموعة أموال معينة، أو ما يعادل قيمتها عند الاقتضاء."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_15_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_15> ;
    dzdoc:position 0 ;
    dzdoc:text "المصادرة هي الأيلولة النهائية إلى الدولة لمال أو مجموعة أموال معينة، أو ما يعادل قيمتها عند الاقتضاء."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_167_defocc_44af9b6a06a9> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 119 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:lottery_acts ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_167> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_167_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "تعتبر من أعمال النصيب العمليات المعروضة على الجمهور تحت أية تسمية مهما كانت والمعدة لإيجاد الأمل في الربح عن طريق الحظ."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_167_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_167> ;
    dzdoc:position 0 ;
    dzdoc:text "تعتبر من أعمال النصيب العمليات المعروضة على الجمهور تحت أية تسمية مهما كانت والمعدة لإيجاد الأمل في الربح عن طريق الحظ."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_172_defocc_498b3824a614> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 39 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:illegal_speculation ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_172> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_172_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يعد مرتكبا لجريمة المضاربة غير المشروعة ويعاقب بالحبس من ستة أشهر إلى خمس سنوات وبغرامة من 5.000 إلى 100.000 دج كل من أحدث بطريق مباشر أو عن طريق وسيط رفعا أو خفضا مصطنعا في أسعار السلع أو البضائع أو الأوراق المالية العمومية أو الخاصة أو شرع في ذلك :
                
                
                بترويج أخبار أو أنباء كاذبة أو مغرضة عمدا بين الجمهور.
                
                
                أو بطرح عروض في السوق بغرض إحداث اضطراب في الأسعار.
                
                
                أو بتقديم عروض بأسعار مرتفعة عن تلك التي كان يطلبها البائعون.
                
                
                أو بالقيام بصفة فردية أو بناء على اجتماع أو ترابط بأعمال في السوق أو الشروع في ذلك بغرض الحصول على ربح غير ناتج عن التطبيق الطبيعي للعرض والطلب.
                
                
                أو بأي طرق أو وسائل احتيالية."""@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_172_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_172> ;
    dzdoc:position 0 ;
    dzdoc:text "يعد مرتكبا لجريمة المضاربة غير المشروعة ويعاقب بالحبس من ستة أشهر إلى خمس سنوات وبغرامة من 5.000 إلى 100.000 دج كل من أحدث بطريق مباشر أو عن طريق وسيط رفعا أو خفضا مصطنعا في أسعار السلع أو البضائع أو الأوراق المالية العمومية أو الخاصة أو شرع في ذلك : بترويج أخبار أو أنباء كاذبة أو مغرضة عمدا بين الجمهور. أو بطرح عروض في السوق بغرض إحداث اضطراب في الأسعار. أو بتقديم عروض بأسعار مرتفعة عن تلك التي كان يطلبها البائعون. أو بالقيام بصفة فردية أو بناء على اجتماع أو ترابط بأعمال في السوق أو الشروع في ذلك بغرض الحصول على ربح غير ناتج عن التطبيق الطبيعي للعرض والطلب. أو بأي طرق أو وسائل احتيالية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_175_defocc_3a1e3248f7cb> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 34 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:bid_interference ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_175> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_175_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يرتكب جريمة التعرض لحرية المزايدات ويعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 500 إلى 200.000 دينار كل من عرقل حرية المزايدات أو المناقصات أو تعرض لها أو أخل بها بطريق التعدي أو العنف أو التهديد وذلك في المزايدات على الملكية أو حق الانتفاع أو على تأجير الأموال العقارية أو المنقولة أو على المقاولات أو التوريدات أو الإستغلالات أو أية خدمات أخرى أو شرع في ذلك سواء قبل المزايدة أو المناقصة أو أثناءهما."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_175_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_175> ;
    dzdoc:position 0 ;
    dzdoc:text "يرتكب جريمة التعرض لحرية المزايدات ويعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 500 إلى 200.000 دينار كل من عرقل حرية المزايدات أو المناقصات أو تعرض لها أو أخل بها بطريق التعدي أو العنف أو التهديد وذلك في المزايدات على الملكية أو حق الانتفاع أو على تأجير الأموال العقارية أو المنقولة أو على المقاولات أو التوريدات أو الإستغلالات أو أية خدمات أخرى أو شرع في ذلك سواء قبل المزايدة أو المناقصة أو أثناءهما."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_176_defocc_fc19824952c0> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 245 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:criminal_association ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_176> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_176_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "كل جمعية أو اتفاق مهما كانت مدته وعدد أعضائه تشكل أو تؤلف بغرض الإعداد لجناية أو أكثر، أو لجنحة أو أكثر ، معاقب عليها بخمس (5) سنوات حبس على الأقل، ضد الأشخاص أو الأملاك تكون جمعية أشرار، وتقوم هذه الجريمة بمجرد التصميم المشترك على القيام بالفعل."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_176_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_176> ;
    dzdoc:position 0 ;
    dzdoc:text "كل جمعية أو اتفاق مهما كانت مدته وعدد أعضائه تشكل أو تؤلف بغرض الإعداد لجناية أو أكثر، أو لجنحة أو أكثر ، معاقب عليها بخمس (5) سنوات حبس على الأقل، ضد الأشخاص أو الأملاك تكون جمعية أشرار، وتقوم هذه الجريمة بمجرد التصميم المشترك على القيام بالفعل."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_177_obligation_0_de6e2803> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1966-06-08/66-156#art_177_obligation_0_de6e2803_role_4cc25424c7> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_177> ;
