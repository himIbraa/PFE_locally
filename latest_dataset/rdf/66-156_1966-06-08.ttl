<https://legal.dz/resource/order/1966-06-08/66-156#art_221_obligation_0_a51cdfb0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1966-06-08/66-156#art_221_obligation_0_a51cdfb0_ref_2c4b74944823>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_221_obligation_0_a51cdfb0_ref_e769c19aa96c> ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_219>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_220> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_219>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_220> ;
