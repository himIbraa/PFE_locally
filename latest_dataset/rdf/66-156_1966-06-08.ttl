<https://legal.dz/resource/order/1966-06-08/66-156#art_371_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_371> ;
    dzdoc:position 0 ;
    dzdoc:text "(معدلة كل من تحصل بطريق التهديد كتابة أو شفاهة أو بإفشاء أو نسبة أمور شائنة على أموال أو أوراق مالية أو على توقيع أو على المحررات المبينة في المادة 370 أو شرع في ذلك يكون قد ارتكب جريمة التهديد بالتشهير ويعاقب بالحبس من سنتين إلى خمس سنوات وبغرامة من 2.000 إلى 30.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_371_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_371> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من كافة الحقوق الواردة في المادة 14 أو من بعضها لمدة سنة على الأقل وخمس سنوات على الأكثر."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_372_condition_0_7edaeb11> a dznorm:Condition ;
    dznorm:conditionText "وإذا وقعت الجنحة من شخص لجأ إلى الجمهور بقصد إصدار أسهم أو سندات أو أذونات أو حصص أو أية سندات مالية سواء لشركات أو مشروعات تجارية أو صناعية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_372> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_372_obligation_0_654b3824> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
