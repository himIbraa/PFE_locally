<https://legal.dz/resource/order/1966-06-08/66-156#art_265_obligation_0_0ca58d35_condition_1> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/order/1966-06-08/66-156#art_265_obligation_0_0ca58d35> ;
    dznorm:conditionText "إذا أدت أعمال العنف إلى فقد أو بتر أحد الأعضاء أو الحرمان من استعماله أو فقد البصر أو فقد إبصار إحدى العينين أو أية عاهة مستديمة أخرى"@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_265_obligation_0_0ca58d35_ref_1e9a95541756> a dzdoc:Reference ;
    rdfs:label "الفقرة الأولى من المادة 264"@ar ;
    dzdoc:frbrUri "#art_264"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1966-06-08/66-156#art_264> ;
    dzdoc:sourceEId "art_265" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "العقوبة تكون السجن المؤبد إذا حدثت الوفاة، وتكون السجن المؤقت من عشر سنوات إلى عشرين سنة إذا أدت أعمال العنف إلى فقد أو بتر أحد الأعضاء أو الحرمان من استعماله أو فقد البصر أو فقد إبصار إحدى العينين أو أية عاهة مستديمة أخرى وتكون السجن المؤقت من خمس إلى عشر سنوات في الحالة المنصوص عليها في الفقرة الأولى من المادة 264"@ar ;
    dzdoc:targetEId "art_264" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_265_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_265> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا وجد سبق إصرار أو ترصد فإن العقوبة تكون السجن المؤبد إذا حدثت الوفاة، وتكون السجن المؤقت من عشر سنوات إلى عشرين سنة إذا أدت أعمال العنف إلى فقد أو بتر أحد الأعضاء أو الحرمان من استعماله أو فقد البصر أو فقد إبصار إحدى العينين أو أية عاهة مستديمة أخرى وتكون السجن المؤقت من خمس إلى عشر سنوات في الحالة المنصوص عليها في الفقرة الأولى من المادة 264."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_266_condition_0_ea3191b0> a dznorm:Condition ;
    dzdoc:hasPeriod <https://legal.dz/resource/order/1966-06-08/66-156#art_266_condition_0_ea3191b0_period_adcb47d1e5> ;
    dznorm:conditionText "إذا وقع الجرح أو الضرب أو غير ذلك من أعمال العنف أو الاعتداءات الأخرى مع سبق الإصرار أو الترصد أو مع حمل أسلحة ولم يؤد إلى مرض أو عجز كلي عن العمل لمدة تتجاوز خمسة عشر (15) يوما"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_266> ;
    dznorm:position 0 .

