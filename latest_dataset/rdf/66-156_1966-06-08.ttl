<https://legal.dz/resource/order/1966-06-08/66-156#version_art_201> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا عقوبة على من تسلم نقودا معدنية أو أوراقا نقدية مقلدة أو مزورة أو مزيفة أو ملونة وهو يعتقد أنها صحيحة و طرحها للتداول وهو يجهل ما يعيبها . كل من طرح النقود المذكورة للتداول بعد أن يكشف ما يعيبها يعاقب بالحبس من شهر إلى ستة أشهر وبغرامة تساوي أربعة أضعاف المبلغ الذي طرحه للتداول بهذه الكيفية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_201_19660608_OpEnact_65fa8a50ec> ;
    dzdoc:replacementText "لا عقوبة على من تسلم نقودا معدنية أو أوراقا نقدية مقلدة أو مزورة أو مزيفة أو ملونة وهو يعتقد أنها صحيحة و طرحها للتداول وهو يجهل ما يعيبها . كل من طرح النقود المذكورة للتداول بعد أن يكشف ما يعيبها يعاقب بالحبس من شهر إلى ستة أشهر وبغرامة تساوي أربعة أضعاف المبلغ الذي طرحه للتداول بهذه الكيفية ."@ar ;
