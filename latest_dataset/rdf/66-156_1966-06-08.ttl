<https://legal.dz/resource/order/1966-06-08/66-156#art_85_obligation_0_25923ae3> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/order/1966-06-08/66-156#art_85_obligation_0_25923ae3_ref_632ec7e44b54> ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_84> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_84> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_85> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_85_obligation_0_25923ae3_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "المؤامرة التي يكون الغرض منها ارتكاب الجناية المنصوص عليها في المادة 84 يعاقب عليها بالسجن المؤبد إذا تلاها فعل ارتكب أو بدئ في ارتكابه للإعداد لتنفيذها."@ar ;
    dznorm:sourceArticle "art_85" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_85_obligation_1_d703cb74> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_85> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_85_obligation_1_d703cb74_condition_0> ;
    dznorm:position 1 ;
    dznorm:provisionText "وتكون العقوبة السجن المؤقت من عشر سنوات إلى عشرين سنة إذا لم يكن قد تلا المؤامرة فعل ارتكب أو بدئ في ارتكابه للإعداد لتنفيذها."@ar ;
    dznorm:sourceArticle "art_85" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_85_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_85> ;
    dzdoc:position 2 ;
    dzdoc:text "وتقوم المؤامرة بمجرد اتفاق شخصين أو أكثر على التصميم على ارتكابها."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10_obligation_0_fb078550> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_10_obligation_0_fb078550_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من سنة (1) إلى ثلاث (3) سنوات وبغرامة من 10.000 دج إلى 100.000 دج كل من أدى خطبة أو حاول تأديتها داخل مسجد أو في أي مكان عمومي تقام فيه الصلاة دون أن يكون معينا أو معتمدا من طرف السلطة العمومية المؤهلة أو مرخصا له من طرفها للقيام بذلك."@ar ;
    dznorm:sourceArticle "art_87_bis_10" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_6_obligation_1_52004d3e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_6> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_6_obligation_1_52004d3e_condition_0> ;
    dznorm:position 1 ;
    dznorm:provisionText "وتكون العقوبة السجن المؤبد عندما تستهدف الأفعال المبينة أعلاه الإضرار بمصالح الجزائر."@ar ;
    dznorm:sourceArticle "art_87_bis_6" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7_obligation_0_c48ddcfd> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7_obligation_0_c48ddcfd_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة مالية من 500.000 دج إلى 1.000.000 دج، كل من يحوز أسلحة ممنوعة أو ذخائر يستولي عليها أو يحملها أو يتاجر فيها أو يستوردها أو يصدرها أو يصنعها أو يصلحها أو يستعملها دون رخصة من السلطة المختصة."@ar ;
    dznorm:sourceArticle "art_87_bis_7" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7_obligation_1_0909d75f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_7_obligation_1_0909d75f_condition_0> ;
    dznorm:position 1 ;
    dznorm:provisionText "يعاقب بالإعدام مرتكب الأفعال المنصوص عليها في الفقرة السابقة عندما تتعلق هذه الأخيرة بمواد متفجرة أو أية مادة تدخل في تركيبها أو صناعتها."@ar ;
    dznorm:sourceArticle "art_87_bis_7" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_9_obligation_0_388b0fe8_ref_bd7f73d22835> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "المادة 6 من قانون العقوبات"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-156#art_6"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-156#art_6"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-156#art_6" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:sourceEId "art_87_bis_9" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يجب النطق بالعقوبات التبعية المنصوص عليها في المادة 6 من قانون العقوبات لمدة سنتين (2) إلى عشر (10) سنوات في حالة الحكم بعقوبة جنائية تطبيقا لأحكام هذا الأمر."@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:targetEId "art_6" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_defocc_efe35216fcc6> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 170 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:terrorism_act ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يعتبر فعلا إرهابيا أو تخريبيا، في مفهوم هذا الأمر، كل فعل يستهدف أمن الدولة والوحدة الوطنية والسلامة الترابية واستقرار المؤسسات وسيرها العادي عن طريق أي عمل غرضه ما يأتي:
                
                بث الرعب في أوساط السكان وخلق جو انعدام الأمن من خلال الاعتداء المعنوي أو الجسدي على الأشخاص أو تعريض حياتهم أو حريتهم أو أمنهم للخطر أو المس بممتلكاتهم،
                عرقلة حركة المرور أو حرية التنقل في الطرق والتجمهر أو الاعتصام في الساحات العمومية،
                الاعتداء على رموز الأمة والجمهورية ونبش أو تدنيس القبور،
                الاعتداء على وسائل المواصلات والنقل والملكيات العمومية والخاصة والاستحواذ عليها أو احتلالها دون مسوغ قانوني،
                الاعتداء على المحيط أو إدخال مادة أو تسريبها في الجو أو في باطن الأرض أو إلقائها عليها أو في المياه بما فيها المياه الإقليمية من شأنها جعل صحة الإنسان أو الحيوان أو البيئة الطبيعية في خطر،
                عرقلة عمل السلطات العمومية أو حرية ممارسة العبادة والحريات العامة وسير المؤسسات المساعدة للمرفق العام،
                عرقلة سير المؤسسات العمومية أو الاعتداء على حياة أعوانها أو ممتلكاتهم أو عرقلة تطبيق القوانين والتنظيمات.
                تحويل الطائرات أو السفن أو أي وسيلة أخرى من وسائل النقل،
                إتلاف منشآت الملاحة الجوية أو البحرية أو البرية،
                تخريب أو إتلاف وسائل الاتصال،
                احتجاز الرهائن،
                الاعتداءات باستعمال المتفجرات أو المواد البيولوجية أو الكيميائية أو النووية أو المشعة،
                تمويل إرهابي أو منظمة إرهابية."""@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_87_bis> ;
    dzdoc:position 0 ;
    dzdoc:text """يعتبر فعلا إرهابيا أو تخريبيا، في مفهوم هذا الأمر، كل فعل يستهدف أمن الدولة والوحدة الوطنية والسلامة الترابية واستقرار المؤسسات وسيرها العادي عن طريق أي عمل غرضه ما يأتي:
                
                بث الرعب في أوساط السكان وخلق جو انعدام الأمن من خلال الاعتداء المعنوي أو الجسدي على الأشخاص أو تعريض حياتهم أو حريتهم أو أمنهم للخطر أو المس بممتلكاتهم،
                عرقلة حركة المرور أو حرية التنقل في الطرق والتجمهر أو الاعتصام في الساحات العمومية،
                الاعتداء على رموز الأمة والجمهورية ونبش أو تدنيس القبور،
                الاعتداء على وسائل المواصلات والنقل والملكيات العمومية والخاصة والاستحواذ عليها أو احتلالها دون مسوغ قانوني،
                الاعتداء على المحيط أو إدخال مادة أو تسريبها في الجو أو في باطن الأرض أو إلقائها عليها أو في المياه بما فيها المياه الإقليمية من شأنها جعل صحة الإنسان أو الحيوان أو البيئة الطبيعية في خطر،
                عرقلة عمل السلطات العمومية أو حرية ممارسة العبادة والحريات العامة وسير المؤسسات المساعدة للمرفق العام،
                عرقلة سير المؤسسات العمومية أو الاعتداء على حياة أعوانها أو ممتلكاتهم أو عرقلة تطبيق القوانين والتنظيمات.
                تحويل الطائرات أو السفن أو أي وسيلة أخرى من وسائل النقل،
                إتلاف منشآت الملاحة الجوية أو البحرية أو البرية،
                تخريب أو إتلاف وسائل الاتصال،
                احتجاز الرهائن،
                الاعتداءات باستعمال المتفجرات أو المواد البيولوجية أو الكيميائية أو النووية أو المشعة،
                تمويل إرهابي أو منظمة إرهابية. بث الرعب في أوساط السكان وخلق جو انعدام الأمن من خلال الاعتداء المعنوي أو الجسدي على الأشخاص أو تعريض حياتهم أو حريتهم أو أمنهم للخطر أو المس بممتلكاتهم، عرقلة حركة المرور أو حرية التنقل في الطرق والتجمهر أو الاعتصام في الساحات العمومية، الاعتداء على رموز الأمة والجمهورية ونبش أو تدنيس القبور، الاعتداء على وسائل المواصلات والنقل والملكيات العمومية والخاصة والاستحواذ عليها أو احتلالها دون مسوغ قانوني، الاعتداء على المحيط أو إدخال مادة أو تسريبها في الجو أو في باطن الأرض أو إلقائها عليها أو في المياه بما فيها المياه الإقليمية من شأنها جعل صحة الإنسان أو الحيوان أو البيئة الطبيعية في خطر، عرقلة عمل السلطات العمومية أو حرية ممارسة العبادة والحريات العامة وسير المؤسسات المساعدة للمرفق العام، عرقلة سير المؤسسات العمومية أو الاعتداء على حياة أعوانها أو ممتلكاتهم أو عرقلة تطبيق القوانين والتنظيمات. تحويل الطائرات أو السفن أو أي وسيلة أخرى من وسائل النقل، إتلاف منشآت الملاحة الجوية أو البحرية أو البرية، تخريب أو إتلاف وسائل الاتصال، احتجاز الرهائن، الاعتداءات باستعمال المتفجرات أو المواد البيولوجية أو الكيميائية أو النووية أو المشعة، تمويل إرهابي أو منظمة إرهابية."""@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_93_defocc_438eb6bad327> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 80 ;
