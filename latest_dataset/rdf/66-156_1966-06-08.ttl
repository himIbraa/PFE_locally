dzterm:security_period a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الفترة الأمنية"@ar,
        "يقصد بالفترة الأمنية حرمان المحكوم عليه من تدابير التوقيف المؤقت لتطبيق العقوبة، والوضع في الورشات الخارجية أو البيئة المفتوحة، وإجازات الخروج، والحرية النصفية والإفراج المشروط للمدة المعينة في هذه المادة أو للفترة التي تحددها الجهة القضائية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis_defocc_a8deb831e673> .

