    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_7> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:versionText "المادة 7 :"@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_80_19660608_OpEnact_05f23f0d8e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_80> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1966-06-08/66-156#art_80> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_80> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:versionText "يعاقب بالإعدام كل من كون قوات مسلحة أو عمل على تكوينها وكل من استخدم أو جند جنودا أو عمل على استخدامهم أو زودهم بالأسلحة أو الذخيرة بدون أمر أو إذن من السلطة الشرعية ."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_81_19660608_OpEnact_3036ab19be> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_81> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1966-06-08/66-156#art_81> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_81> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:versionText "يعاقب بالإعدام : كل من تولى قيادة عسكرية أيا كانت بدون وجه حق أو بدون سبب مشروع، وكل من احتفظ بمثل هذه القيادة ضد أمر الحكومة، والقواد الذين يبقون جيوشهم وقواتهم مجتمعة بعد أن صدر لهم الأمر بتسريحها أو تفريقها."@ar .

