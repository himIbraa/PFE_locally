    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "178" ;
    dzdoc:position 258 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_176> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_176> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_181> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_1> ;
    dzdoc:eId "art_181" ;
    dzdoc:fullText "فيما عدا الحالة المنصوص عليها في الفقرة الأولى من المادة 91 يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 1.000 إلى 10.000 دينار أو بإحدى هاتين العقوبتين كل من يعلم بالشروع في جناية أو بوقوعها فعلا ولم يخبر السلطات فورا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_181> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_181_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_181_19660608_OpEnact_b0dde40bc3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_181_obligation_0_4ad7d239> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 181" ;
    dzdoc:position 261 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_91> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_91> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_187_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_2> ;
    dzdoc:eId "art_187_bis" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين (2) إلى ستة (6) أشهر وبغرامة من 1.000 دج إلى 10.000 دج أو بإحدى هاتين العقوبتين فقط كل من لا يمتثل لأمر تسخير صادر ومبلغ له وفقا للأشكال التنظيمية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_187_bis> ;
