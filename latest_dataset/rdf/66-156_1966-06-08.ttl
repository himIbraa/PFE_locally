    dzdoc:text "إذا وقع القبض أو الاختطاف مع ارتداء بزة رسمية أو شارة نظامية أو يبدو عليها ذلك على النحو المبين في المادة 246 أو بانتحال اسم كاذب أو بموجب أمر مزور على السلطة العمومية فتكون العقوبة السجن المؤبد."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_292_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_292> ;
    dzdoc:position 1 ;
    dzdoc:text "وتطبق العقوبة ذاتها إذا وقع القبض أو الاختطاف بواسطة إحدى وسائل النقل الآلية أو بتهديد المجني عليه بالقتل."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1_condition_0_a199b67e> a dznorm:Condition ;
    dznorm:conditionText "إذا تعرض القاصر المخطوف إلى تعذيب أو عنف جنسي أو إذا كان الدافع إلى الخطف هو تسديد فدية أو إذا ترتبت عليه وفاة الضحية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1_obligation_0_94a1b77a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالسجن المؤبد"@ar ;
    dznorm:sourceArticle "art_293_bis_1" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالسجن المؤبد كل من يخطف أو يحاول خطف قاصر لم يكمل ثماني عشرة (18) سنة، عن طريق العنف أو التهديد أو الاستدراج أو غيرها من الوسائل."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1> ;
    dzdoc:position 1 ;
    dzdoc:text "وتطبق على الفاعل العقوبة المنصوص عليها في الفقرة الأولى من المادة 263 من هذا القانون، إذا تعرض القاصر المخطوف إلى تعذيب أو عنف جنسي أو إذا كان الدافع إلى الخطف هو تسديد فدية أو إذا ترتبت عليه وفاة الضحية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_1> ;
    dzdoc:position 2 ;
    dzdoc:text "لا يستفيد الجاني من ظروف التخفيف المنصوص عليها في هذا القانون مع مراعاة أحكام المادة 294 أدناه."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_condition_0_f2177b50> a dznorm:Condition ;
    dznorm:conditionText "إذا تعرض الشخص المخطوف إلى تعذيب أو عنف جنسي أو إذا كان الدافع إلى الخطف هو تسديد فدية أو تنفيذ شرط أو أمر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis_condition_1_7b7c80fa> a dznorm:Condition ;
    dznorm:conditionText "إذا أدى الخطف إلى وفاة الشخص المخطوف"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_293_bis> ;
    dznorm:position 1 .

