        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا ألحقت المادة الغذائية أو الطبية المغشوشة أو الفاسدة بالشخص الذي تناولها، أو الذي قدمت له مرضا أو عجزا عن العمل ، يعاقب مرتكب الغش وكذا الذي عرض أو وضع للبيع أو باع تلك المادة وهو يعلم أنها مغشوشة أو فاسدة أو سامة، بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج . ويعاقب الجناة بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج على 2.000.000 دج ، إذا تسببت تلك المادة في مرض غير قابل للشفاء، أو في فقد استعمال عضو أو في عاهة مستديمة . وي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_432_19660608_OpEnact_8a7ba0259b> ;
    dzdoc:replacementText "إذا ألحقت المادة الغذائية أو الطبية المغشوشة أو الفاسدة بالشخص الذي تناولها، أو الذي قدمت له مرضا أو عجزا عن العمل ، يعاقب مرتكب الغش وكذا الذي عرض أو وضع للبيع أو باع تلك المادة وهو يعلم أنها مغشوشة أو فاسدة أو سامة، بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج . ويعاقب الجناة بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج على 2.000.000 دج ، إذا تسببت تلك المادة في مرض غير قابل للشفاء، أو في فقد استعمال عضو أو في عاهة مستديمة . ويعاقب الجناة بالسجن المؤبد ، إذا تسببت تلك المادة في موت إنسان ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_432> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
