<https://legal.dz/resource/order/1966-06-08/66-156#art_79_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_79> ;
    dzdoc:position 0 ;
    dzdoc:text "كل من يعمل بأية وسيلة كانت على المساس بسلامة وحدة الوطن، وذلك في غير الحالات المنصوص عليها في المادتين 77 و 78 يعاقب بالحبس لمدة سنة إلى عشر سنوات وبغرامة من 3.000 دج إلى 70.000 دج، مع جواز حرمانه من الحقوق المشار إليها في المادة 14 من هذا القانون."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_7_para_0> a dzdoc:Paragraph ;
