<https://legal.dz/resource/order/1966-06-08/66-156#version_art_411> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب على النهب أو على أي إتلاف لمواد غذائية أو بضائع أو قيم منقولة أو ممتلكات منقولة يقع من مجموعة أفراد أو من عصابة وبطريق القوة السافرة بالسجن المؤقت من عشر سنوات إلى عشرين سنة. ومع ذلك تكون مدة عقوبة السجن من خمس إلى عشر سنوات بالنسبة لمن يثبت منهم أنه استدرج إلى المساهمة في أعمال العنف المذكورة بالتحريض أو بالترغيب."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_411_19660608_OpEnact_edc9d758f2> ;
