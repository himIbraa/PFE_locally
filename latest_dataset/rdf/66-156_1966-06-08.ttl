<https://legal.dz/resource/order/1966-06-08/66-156#version_art_327> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من لم يسلم طفلا موضوعا تحت رعايته إلى الأشخاص الذين لهم الحق في المطالبة به يعاقب بالحبس من سنتين إلى خمس سنوات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_327_19660608_OpEnact_6496502c1c> ;
    dzdoc:replacementText "كل من لم يسلم طفلا موضوعا تحت رعايته إلى الأشخاص الذين لهم الحق في المطالبة به يعاقب بالحبس من سنتين إلى خمس سنوات."@ar ;
