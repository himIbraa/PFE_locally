    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعتبر من الفواحش بين ذوي المحارم العلاقات الجنسية التي ترتكب بين : 1- الأقارب من الفروع أو الأصول، 2- الإخوة والأخوات الأشقاء، أو من الأب أو من الأم، 3- شخص وابن أحد إخوته أو أخواته الأشقاء أو من الأب أو من الأم أو من أحد فروعه، 4- الأم أو الأب والزوج أو الزوجة والأرمل أو أرملة ابنه أو مع أحد آخر من فروعه، 5- والد الزوج أو الزوجة أو زوج الأم أو زوجة الأب وفروع الزوج الآخر، 6- أشخاص يكون أحدهم زوجا لأخ أو لأخت. تكون العقوبة السجن من عشر (10) سنوات إلى عشرين (20) سنة في الحالتين 1 و 2 والحبس من خم"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_337_bis_19660608_OpEnact_951199253c> ;
    dzdoc:replacementText "تعتبر من الفواحش بين ذوي المحارم العلاقات الجنسية التي ترتكب بين : 1- الأقارب من الفروع أو الأصول، 2- الإخوة والأخوات الأشقاء، أو من الأب أو من الأم، 3- شخص وابن أحد إخوته أو أخواته الأشقاء أو من الأب أو من الأم أو من أحد فروعه، 4- الأم أو الأب والزوج أو الزوجة والأرمل أو أرملة ابنه أو مع أحد آخر من فروعه، 5- والد الزوج أو الزوجة أو زوج الأم أو زوجة الأب وفروع الزوج الآخر، 6- أشخاص يكون أحدهم زوجا لأخ أو لأخت. تكون العقوبة السجن من عشر (10) سنوات إلى عشرين (20) سنة في الحالتين 1 و 2 والحبس من خمس (5) سنوات إلى عشر (10) سنوات في الحالات 3 و 4 و 5 والحبس من سنتين (2) إلى خمس (5) سنوات في الحالة 6 أعلاه . وتطبق على العلاقات الجنسية بين الكافل والمكفول العقوبة المقررة للفاحشة المرتكبة بين الأقارب من الفروع أو الأصول. ويتضمن الحكم المقضي به ضد الأب أو الأم أو الكافل سقوط الولاية و/أو الكفالة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_337_bis> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
