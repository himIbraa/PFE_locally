    dznorm:position 0 ;
    dznorm:provisionText "يعاقب الشخص الذي يخالف أحد تدابير تحديد الإقامة بالحبس من ثلاثة (3) أشهر إلى (3) سنوات وبغرامة من 25.000 دج إلى 300.000 دج"@ar ;
    dznorm:sourceArticle "art_11" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_11_para_1> a dzdoc:Paragraph ;
