<https://legal.dz/resource/order/1966-06-08/66-156#version_art_109> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الموظفون العموميون و رجال القوة العمومية و مندوبو السلطة العمومية والمكلفون بـ الشرطة الإدارية أو الضبط القضائي الذين يرفضون أو يهملون الاستجابة إلى طلب يرمي إلى ضبط واقعة حجز غير قانوني وتحكمي إما في المؤسسات أو في الأماكن المخصصة لحجز المقبوض عليهم أو في أي مكان آخر ولا يثبتون أنهم أطلعوا السلطة الرئاسية عن ذلك يعاقبون بالسجن المؤقت من خمس إلى عشر سنوات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_109_19660608_OpEnact_444e84ae48> ;
    dzdoc:replacementText "الموظفون العموميون و رجال القوة العمومية و مندوبو السلطة العمومية والمكلفون بـ الشرطة الإدارية أو الضبط القضائي الذين يرفضون أو يهملون الاستجابة إلى طلب يرمي إلى ضبط واقعة حجز غير قانوني وتحكمي إما في المؤسسات أو في الأماكن المخصصة لحجز المقبوض عليهم أو في أي مكان آخر ولا يثبتون أنهم أطلعوا السلطة الرئاسية عن ذلك يعاقبون بالسجن المؤقت من خمس إلى عشر سنوات ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_109> ;
