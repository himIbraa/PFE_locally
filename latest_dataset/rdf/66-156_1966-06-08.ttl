    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_375_19660608_OpEnact_4ec5607481> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "375" ;
    dzdoc:position 527 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_375_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
