<https://legal.dz/resource/order/1966-06-08/66-156#version_art_314> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من ترك طفلا أو عاجزا غير قادر على حماية نفسه بسبب حالته البدنية أو العقلية أو عرضه للخطر في مكان خال من الناس أو حمل الغير على ذلك يعاقب لمجرد هذا الفعل بالحبس من سنة إلى ثلاث سنوات . فإذا نشأ عن الترك أو التعريض للخطر مرض أو عجز كلي لمدة تجاوز عشرين يوما فيكون الحبس من سنتين إلى خمس سنوات. وإذا حدث للطفل أو للعاجز بتر أو عجز في أحد الأعضاء أو أصيب بعاهة مستديمة فتكون العقوبة هي السجن من خمس إلى عشر سنوات. وإذا تسبب الترك أو التعريض للخطر في الموت فتكون العقوبة هي السجن من عشر سنوات إلى عشرين"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_314_19660608_OpEnact_458ddbab11> ;
    dzdoc:replacementText "كل من ترك طفلا أو عاجزا غير قادر على حماية نفسه بسبب حالته البدنية أو العقلية أو عرضه للخطر في مكان خال من الناس أو حمل الغير على ذلك يعاقب لمجرد هذا الفعل بالحبس من سنة إلى ثلاث سنوات . فإذا نشأ عن الترك أو التعريض للخطر مرض أو عجز كلي لمدة تجاوز عشرين يوما فيكون الحبس من سنتين إلى خمس سنوات. وإذا حدث للطفل أو للعاجز بتر أو عجز في أحد الأعضاء أو أصيب بعاهة مستديمة فتكون العقوبة هي السجن من خمس إلى عشر سنوات. وإذا تسبب الترك أو التعريض للخطر في الموت فتكون العقوبة هي السجن من عشر سنوات إلى عشرين سنة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
