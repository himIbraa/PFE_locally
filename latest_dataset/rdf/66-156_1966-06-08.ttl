<https://legal.dz/resource/order/1966-06-08/66-156#art_111_obligation_0_4bea4be6_period_b120f054bc> a dznorm:Period ;
    rdfs:label "لمدة ستة أشهر إلى ثلاث سنوات"@ar ;
