<https://legal.dz/resource/order/1966-06-08/66-156#art_150_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_150> ;
    dzdoc:position 0 ;
    dzdoc:text "كل من هدم أو خرب أو دنس القبور بأية طريقة كانت يعاقب بالحبس من ستة أشهر إلى سنتين وبغرامة من 500 إلى 2.000 دينار."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_151_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_151> ;
    dzdoc:position 0 ;
    dzdoc:text "كل من يرتكب فعلا يمس بالحرمة الواجبة للموتى في المقابر أو في غيرها من أماكن الدفن يعاقب بالحبس من ثلاثة أشهر إلى سنتين وبغرامة من 500 إلى 2.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_152_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_152> ;
    dzdoc:position 0 ;
    dzdoc:text "كل من انتهك حرمة مدفن أو قام بدفن جثة أو إخراجها خفية يعاقب بالحبس من ثلاثة أشهر إلى سنة وبغرامة من 500 إلى 2.000 دينار."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_153_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_153> ;
    dzdoc:position 0 ;
    dzdoc:text "كل من دنس أو شوه جثة أو وقع منه عليها أي عمل من أعمال الوحشية أو الفحش يعاقب بالحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 2.000 دينار."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_154_condition_0_a85900e1> a dznorm:Condition ;
    dznorm:conditionText "وإذا كان المخفي يعلم أن الجثة لشخص مقتول أو متوفى نتيجة ضرب أو جرح"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_154> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_154_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_154> ;
    dzdoc:position 0 ;
    dzdoc:text "كل من خبأ أو أخفى جثة يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة بين 500 إلى 1.000 دينار."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_154_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_154> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا كان المخفي يعلم أن الجثة لشخص مقتول أو متوفى نتيجة ضرب أو جرح فإن العقوبة تكون الحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 5.000 دينار."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_155_condition_0_442ab69d> a dznorm:Condition ;
    dznorm:conditionText "وإذا كان كسر الأختام أو الشروع فيه قد وقع من الحارس أو بطريق العنف ضد الأشخاص أو بغرض سرقة أو إتلاف أدلة أو أوراق إثبات في إجراءات جزائية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_155> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_155_obligation_0_5ad5d9b0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1966-06-08/66-156#art_155_obligation_0_5ad5d9b0_role_3e88b0b141> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_155> ;
    dznorm:position 0 ;
    dznorm:provisionText "كسر عمدا الأختام الموضوعة بناء على أمر من السلطة العمومية أو شرع عمدا في كسرها"@ar ;
    dznorm:sourceArticle "art_155" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_155_obligation_0_5ad5d9b0_role_3e88b0b141> a dznorm:Role ;
    rdfs:label "أمر من السلطة العمومية"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "كسر عمدا الأختام الموضوعة بناء على أمر من السلطة العمومية أو شرع عمدا في كسرها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_155> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_155_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_155> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات كل من كسر عمدا الأختام الموضوعة بناء على أمر من السلطة العمومية أو شرع عمدا في كسرها."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_155_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_155> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا كان كسر الأختام أو الشروع فيه قد وقع من الحارس أو بطريق العنف ضد الأشخاص أو بغرض سرقة أو إتلاف أدلة أو أوراق إثبات في إجراءات جزائية فيكون الحبس من سنتين إلى خمس سنوات."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_156_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_156> ;
    dzdoc:position 0 ;
    dzdoc:text ""@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_157_condition_0_5d36c6e8> a dznorm:Condition ;
    dznorm:conditionText "إذا وقع الكسر نتيجة إهماله"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_157> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_157_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_157> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب الحارس بالحبس لمدة من شهر إلى ستة شهور إذا وقع الكسر نتيجة إهماله."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_158_condition_0_1e481198> a dznorm:Condition ;
    dznorm:conditionText "وإذا وقع الإتلاف أو التشويه أو التبديد أو الانتزاع من الأمين العمومي أو بطريق العنف ضد الأشخاص"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_158> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_158_obligation_0_63dd2733> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_158> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتلف أو يشوه أو يبدد أو ينتزع عمدا أوراقا أو سجلات أو عقودا أو سندات محفوظة في المحفوظات أو أقلام الكتاب أو المستودعات العمومية أو مسلمة إلى أمين عمومي بهذه الصفة"@ar ;
    dznorm:sourceArticle "art_158" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_158_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_158> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالسجن من خمس إلى عشر سنوات كل من يتلف أو يشوه أو يبدد أو ينتزع عمدا أوراقا أو سجلات أو عقودا أو سندات محفوظة في المحفوظات أو أقلام الكتاب أو المستودعات العمومية أو مسلمة إلى أمين عمومي بهذه الصفة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_158_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_158> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا وقع الإتلاف أو التشويه أو التبديد أو الانتزاع من الأمين العمومي أو بطريق العنف ضد الأشخاص فيكون السجن من عشر سنوات إلى عشرين سنة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_159_condition_0_c15dcf52> a dznorm:Condition ;
    dznorm:conditionText "إذا كان الإتلاف أو التشويه أو التبديد أو الانتزاع قد وقع نتيجة إهماله"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_159> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_159_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_159> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب الأمين العمومي بالحبس من ستة أشهر إلى سنتين إذا كان الإتلاف أو التشويه أو التبديد أو الانتزاع قد وقع نتيجة إهماله."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1_condition_0_9ce4e175> a dznorm:Condition ;
    dznorm:conditionText "في حالة الإدانة لارتكاب جناية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1_condition_1_27f91ca5> a dznorm:Condition ;
    dznorm:conditionText "وفي حالة الإدانة لارتكاب جنحة أو مخالفة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1_obligation_0_6912f78e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1> ;
    dznorm:position 0 ;
    dznorm:provisionText "تأمر المحكمة بمصادرة الأشياء التي استعملت أو كانت ستستعمل في تنفيذ الجريمة أو التي تحصلت منها، وكذلك الهبات أو المنافع الأخرى التي استعملت لمكافأة مرتكب الجريمة"@ar ;
    dznorm:sourceArticle "art_15_bis_1" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1_obligation_1_7ca46b79> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1_obligation_1_7ca46b79_role_99b803ca54> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1> ;
    dznorm:position 1 ;
    dznorm:provisionText "يؤمر بمصادرة الأشياء المذكورة في الفقرة السابقة وجوبا إذا كان القانون ينص صراحة على هذه العقوبة"@ar ;
    dznorm:sourceArticle "art_15_bis_1" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1_obligation_1_7ca46b79_role_99b803ca54> a dznorm:Role ;
    rdfs:label "هذه العقوبة"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يؤمر بمصادرة الأشياء المذكورة في الفقرة السابقة وجوبا إذا كان القانون ينص صراحة على هذه العقوبة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1> ;
    dzdoc:position 0 ;
    dzdoc:text "في حالة الإدانة لارتكاب جناية، تأمر المحكمة بمصادرة الأشياء التي استعملت أو كانت ستستعمل في تنفيذ الجريمة أو التي تحصلت منها، وكذلك الهبات أو المنافع الأخرى التي استعملت لمكافأة مرتكب الجريمة، مع مراعاة حقوق الغير حسن النية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_1> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي حالة الإدانة لارتكاب جنحة أو مخالفة يؤمر بمصادرة الأشياء المذكورة في الفقرة السابقة وجوبا إذا كان القانون ينص صراحة على هذه العقوبة، وذلك مع مراعاة حقوق الغير حسن النية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis> ;
    dzdoc:position 0 ;
    dzdoc:text ""@ar .

