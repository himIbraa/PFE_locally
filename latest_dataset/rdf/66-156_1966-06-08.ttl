    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_1_sec_1> ;
    dzdoc:eId "art_5" ;
    dzdoc:fullText "العقوبات الأصلية في مادة الجنايات هي : الإعدام، السجن المؤبد، السجن المؤقت لمدة تتراوح بين خمس (5) سنوات وعشرين (20) سنة، ما عدا في الحالات التي يقرر فيها القانون حدودا أخرى قصوى . العقوبات الأصلية في مادة الجنح هي : الحبس مدة تتجاوز شهرين إلى خمس سنوات ماعدا الحالات التي يقرر فيها القانون حدودا أخرى ، الغرامة التي تتجاوز 20.000 دج. العقوبات الأصلية في مادة المخالفات هي : الحبس من يوم واحد على الأقل إلى شهرين على الأكثر، الغرامة من 2000 دج إلى 20.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_5> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_5_defocc_8547d5642b57>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_5_defocc_86920c8d53c8>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_5_defocc_d56e0adb8118> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_5_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_5_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_5_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_5_19660608_OpEnact_e40d9b5fb1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "5" ;
    dzdoc:position 4 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_5_condition_0_cfed646e>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_5_condition_1_84914058> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_53_bis_2" ;
    dzdoc:fullText "لا يجوز في مادة الجنايات، النطق بالغرامة وحدها ، و يحكم بها دائما في إطار الحدين المنصوص عليهما في القانون ، سواء كانت مقررة أصلا أم لا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_2_permission_0_82baae0f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_bis_2_19660608_OpEnact_4534461d3b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_2_obligation_0_af0b2195>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_2_obligation_1_6b068fa3> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1966-06-08/66-156#art_53_bis_2_prohibition_0_82baae0f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "53 مكرر 2" ;
    dzdoc:position 79 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_54_bis_10" ;
    dzdoc:fullText "يجوز للقاضي أن يثير تلقائيا حالة العود إذا لم يكن منوها عنها في إجراءات المتابعة ، و إذا رفض المتهم محاكمته على هذا الظرف المشدد ، فتطبق عليه تدابير الفقرتين 3 و 4 من المادة 338 من قانون الإجراءات الجزائية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_10_permission_0_0495c006> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_10_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis_10_19660608_OpEnact_abde94a5b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "54 مكرر 10" ;
    dzdoc:position 97 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_10_extref_0446c330>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_10_extref_5d7a9131>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_10_extref_eef1b44b> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_10_condition_0_ad3da7ff>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_10_condition_1_0614d3ce> ;
    dzdoc:usesTerm dzterm:recidivism .

<https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_54_bis_2" ;
    dzdoc:fullText "إذا سبق الحكم نهائيا على شخص طبيعي ، من أجل جناية أو جنحة معاقب عليها قانونا بعقوبة حدها الأقصى يزيد عن خمس (5) سنوات حبسا، وارتكب خلال الخمس سنوات التالية لقضاء العقوبة السابقة جنحة معاقبا عليها قانونا بعقوبة حدها الأقصى يساوي أو يقل عن خمس (5) سنوات حبسا ، فإن الحد الأقصى لعقوبة الحبس والغرامة المقررة لهذه الجنحة يرفع وجوبا إلى الضعف . كما يجوز الحكم بواحدة أو أكثر من العقوبات التكميلية المنصوص عليها في المادة 9 من هذا القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_2_permission_0_ed95ef09> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_2_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_2_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis_2_19660608_OpEnact_e79d69cdf1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_2_obligation_0_10269bdb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "54 مكرر 2" ;
    dzdoc:position 89 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_9> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_9> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_54_bis_2_condition_0_87acd1fe> ;
