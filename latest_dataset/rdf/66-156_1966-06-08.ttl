    dznorm:position 0 ;
    dznorm:provisionText "يعاقب على الاشتراك في جمعية الأشرار بالسجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج، إذا تم الإعداد لارتكاب جنايات"@ar ;
    dznorm:sourceArticle "art_177" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_177_obligation_1_4e0bbc12> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_177> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_177_obligation_1_4e0bbc12_condition_0> ;
    dznorm:position 1 ;
    dznorm:provisionText "وتكون العقوبة الحبس من سنتين (2) إلى خمس (5) سنوات والغرامة من 100.000 دج إلى 500.000 دج، إذا تم الإعداد لارتكاب جنح"@ar ;
    dznorm:sourceArticle "art_177" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_183_defocc_6d5e6f3bc5f3> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 209 ;
    dzdoc:charStart 0 ;
