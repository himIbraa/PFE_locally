<https://legal.dz/resource/order/1966-06-08/66-156#version_art_155> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات كل من كسر عمدا الأختام الموضوعة بناء على أمر من السلطة العمومية أو شرع عمدا في كسرها . وإذا كان كسر الأختام أو الشروع فيه قد وقع من الحارس أو بطريق العنف ضد الأشخاص أو بغرض سرقة أو إتلاف أدلة أو أوراق إثبات في إجراءات جزائية فيكون الحبس من سنتين إلى خمس سنوات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_155_19660608_OpEnact_e9b13464f0> ;
    dzdoc:replacementText "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات كل من كسر عمدا الأختام الموضوعة بناء على أمر من السلطة العمومية أو شرع عمدا في كسرها . وإذا كان كسر الأختام أو الشروع فيه قد وقع من الحارس أو بطريق العنف ضد الأشخاص أو بغرض سرقة أو إتلاف أدلة أو أوراق إثبات في إجراءات جزائية فيكون الحبس من سنتين إلى خمس سنوات."@ar ;
