<https://legal.dz/resource/order/1966-06-08/66-156#art_210_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_210> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 5.000 دينار كل من تحصل بغير حق على أختام صحيحة أو علامات أو مطبوعات من المنصوص عليها في المادة 209 ووضعها أو استعملها بطريق الغش أو شرع في ذلك. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة من سنة إلى خمس سنوات على الأكثر."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_211_obligation_0_3cbd5be4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_211> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من شهرين إلى سنة وبغرامة من 500 إلى 1.000 دينار"@ar ;
    dznorm:sourceArticle "art_211" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_211_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_211> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من شهرين إلى سنة وبغرامة من 500 إلى 1.000 دينار كل من : 1 ) استعمل طوابع بريد أو طوابع منفصلة أو أوراق أو نماذج مدموغة سبق استعمالها أو زيف الطوابع بأية وسيلة كانت بغرض أن يتفادى ختمها لإبطالها وأن يسمح بهذه الطريقة باستعمالها بعد ذلك. 2 ) زاد من قيمة طوابع البريد أو غيرها من الأوراق البريدية ذات القيمة المالية سواء كانت قد أبطلت أم لا وذلك بالطباعة أو التخريم أو بأية وسيلة أخرى أو باع أو روج أو عرض أو وزع أو صدر هذه الطوابع التي زيدت قيمتها. 3 ) قلد أو أصدر أو زيف قسائم سداد الضريبة أو الطوابع أو بصمات التخليص أو قسائم الرد التي تصدرها إدارة البريد في بلد أجنبي أو باع أو روج أو وزع قسائم سداد الضريبة أو الطوابع أو بصمات التخليص أو قسائم الرد المذكورة أو استعملها مع علمه بذلك."@ar .

