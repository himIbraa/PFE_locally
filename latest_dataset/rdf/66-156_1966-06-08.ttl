<https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_defocc_1fac8519f8d2> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 20 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:money_laundering ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يعتبر تبييضا للأموال :
                
                
                أ- تحويل الممتلكات أو نقلها مع علم الفاعل بأنها عائدات إجرامية، بغرض إخفاء أو تمويه المصدر غير المشروع لتلك الممتلكات أو مساعدة أي شخص متورط في ارتكاب الجريمة الأصلية التي تأتت منها هذه الممتلكات على الإفلات من الآثار القانونية لفعلته.
                
                
                ب- إخفاء أو تمويه الطبيعة الحقيقية للممتلكات أو مصدرها أو مكانها أو كيفية التصرف فيها أو حركتها أو الحقوق المتعلقة بها، مع علم الفاعل أنها عائدات إجرامية.
                
                
                ج- اكتساب الممتلكات أو حيازتها أو استخدامها مع علم الشخص القائم بذلك وقت تلقيها، أنها تشكل عائدات إجرامية.
                
                
                د- المشاركة في ارتكاب أي من الجرائم المقررة وفقا لهذه المادة ، أو التواطؤ أو التآمر على ارتكابها ومحاولة ارتكابها والمساعدة والتحريض على ذلك وتسهيله وإسداء المشورة بشأنه."""@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر تبييضا للأموال : أ- تحويل الممتلكات أو نقلها مع علم الفاعل بأنها عائدات إجرامية، بغرض إخفاء أو تمويه المصدر غير المشروع لتلك الممتلكات أو مساعدة أي شخص متورط في ارتكاب الجريمة الأصلية التي تأتت منها هذه الممتلكات على الإفلات من الآثار القانونية لفعلته. ب- إخفاء أو تمويه الطبيعة الحقيقية للممتلكات أو مصدرها أو مكانها أو كيفية التصرف فيها أو حركتها أو الحقوق المتعلقة بها، مع علم الفاعل أنها عائدات إجرامية. ج- اكتساب الممتلكات أو حيازتها أو استخدامها مع علم الشخص القائم بذلك وقت تلقيها، أنها تشكل عائدات إجرامية. د- المشاركة في ارتكاب أي من الجرائم المقررة وفقا لهذه المادة ، أو التواطؤ أو التآمر على ارتكابها ومحاولة ارتكابها والمساعدة والتحريض على ذلك وتسهيله وإسداء المشورة بشأنه."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_395_obligation_0_8bbce34e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1966-06-08/66-156#art_395_obligation_0_8bbce34e_role_2feb6a29e9> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_395> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_395_obligation_0_8bbce34e_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالسجن المؤبد كل من وضع النار عمدا في مبان أو مساكن أو غرف أو خيم أو أكشاك ولو متنقلة أو بواخر أو سفن أو مخازن أو ورش ، وذلك إذا كانت مسكونة أو مستعملة للسكنى، وعلى العموم في أماكن مسكونة أو مستعملة للسكنى، سواء كانت مملوكة أو غير مملوكة لمرتكب الجناية."@ar ;
    dznorm:sourceArticle "art_395" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_396_bis_obligation_0_8fce5c36> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_396_bis> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_396_bis_obligation_0_8fce5c36_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "تطبق عقوبة السجن المؤبد إذا كانت الجرائم المذكورة في المادتين 395 و396 تتعلق بأملاك الدولة أو بأملاك الجماعات المحلية أو المؤسسات أو الهيئات الخاضعة للقانون العام."@ar ;
    dznorm:sourceArticle "art_396_bis" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_396_obligation_0_2c6ce08d> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_396> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_396_obligation_0_2c6ce08d_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالسجن المؤقت من عشر سنوات إلى عشرين سنة كل من وضع النار عمدا في الأموال الآتية إذا لم تكن مملوكة له:"@ar ;
    dznorm:sourceArticle "art_396" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_399_obligation_0_167112d6> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_399> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_399_obligation_0_167112d6_condition_0> ;
