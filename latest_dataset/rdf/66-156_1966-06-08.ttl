<https://legal.dz/resource/order/1966-06-08/66-156#version_art_112> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا اتخذت إجراءات مخالفة للقوانين وكان تدبيرها عن طريق اجتماع أفراد أو هيئات تتولى أي قدر من السلطة العمومية أو عن طريق رسل أو مراسلات فيعاقب الجناة بالحبس من شهر إلى ستة أشهر. ويجوز علاوة على ذلك أن يقضى بحرمانهم من حق أو أكثر من الحقوق المبينة في المادة 14 ومن تولي أية وظيفة أو خدمة عمومية لمدة عشر سنوات على الأكثر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_112_19660608_OpEnact_231c2626bf> ;
    dzdoc:replacementText "إذا اتخذت إجراءات مخالفة للقوانين وكان تدبيرها عن طريق اجتماع أفراد أو هيئات تتولى أي قدر من السلطة العمومية أو عن طريق رسل أو مراسلات فيعاقب الجناة بالحبس من شهر إلى ستة أشهر. ويجوز علاوة على ذلك أن يقضى بحرمانهم من حق أو أكثر من الحقوق المبينة في المادة 14 ومن تولي أية وظيفة أو خدمة عمومية لمدة عشر سنوات على الأكثر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_112> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_112> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
