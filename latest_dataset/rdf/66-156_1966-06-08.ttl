    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يعد اتجار بالأشخاص، تجنيد أو نقل أو تنقيل أو إيواء أو استقبال شخص أو أكثر بواسطة التهديد بالقوة أو باستعمالها أو غير ذلك من أشكال الإكراه، أو الاختطاف أو الاحتيال أو الخداع أو إساءة استعمال السلطة أو استغلال حالة استضعاف أو بإعطاء أو تلقي مبالغ مالية أو مزايا لنيل موافقة شخص له سلطة على شخص آخر بقصد الاستغلال."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4_obligation_1_8ce9a997> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4_obligation_1_8ce9a997_role_d57ee11def> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4_obligation_1_8ce9a997_condition_0> ;
    dznorm:position 1 ;
    dznorm:provisionText "يعاقب على الاتجار بالأشخاص بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.500.000 دج، إذا سهل ارتكابه حالة استضعاف الضحية الناتجة عن سنها أو مرضها أو عجزها البدني أو الذهني، متى كانت هذه الظروف ظاهرة أو معلومة لدى الفاعل."@ar ;
    dznorm:sourceArticle "art_303_bis_4" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4> ;
