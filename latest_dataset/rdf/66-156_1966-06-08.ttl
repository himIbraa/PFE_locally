<https://legal.dz/resource/order/1966-06-08/66-156#version_art_366> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من طلب تقديم مشروبات أو مأكولات إليه واستهلكها كلها أو بعضها في المحال المخصصة لذلك حتى ولو كان يقيم في تلك المحال مع علمه أنه لا يستطيع دفع ثمنها على الإطلاق يعاقب بالحبس من شهرين على الأقل إلى ستة أشهر على الأكثر وبغرامة من 500 إلى 1.500 دينار . وتطبق العقوبة ذاتها على كل من يطلب تخصيص غرفة أو أكثر له في فندق أو نزل ويشغلها فعلا علمه أنه لا يستطيع دفع أجرها على الإطلاق . ومع ذلك يجب أن لا تجاوز مدة الإقامة عشرة أيام وذلك في الحالتين المنصوص عليهما في الفقرتين السابقتين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_366_19660608_OpEnact_7dcc2fc9d4> ;
    dzdoc:replacementText "كل من طلب تقديم مشروبات أو مأكولات إليه واستهلكها كلها أو بعضها في المحال المخصصة لذلك حتى ولو كان يقيم في تلك المحال مع علمه أنه لا يستطيع دفع ثمنها على الإطلاق يعاقب بالحبس من شهرين على الأقل إلى ستة أشهر على الأكثر وبغرامة من 500 إلى 1.500 دينار . وتطبق العقوبة ذاتها على كل من يطلب تخصيص غرفة أو أكثر له في فندق أو نزل ويشغلها فعلا علمه أنه لا يستطيع دفع أجرها على الإطلاق . ومع ذلك يجب أن لا تجاوز مدة الإقامة عشرة أيام وذلك في الحالتين المنصوص عليهما في الفقرتين السابقتين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_366> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
