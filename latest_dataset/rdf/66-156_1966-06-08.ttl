    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_24> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:versionText "ملغاة"@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_250_19660608_OpEnact_80389837b3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_250> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1966-06-08/66-156#art_250> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_250> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:versionText "في جميع الحالات المنصوص عليها في هذا القسم يجوز لجهة القضاء أن تأمر إما بنشر الحكم كاملا أو ملخص منه في الصحف التي تعينها أو بتعليقه في الأماكن التي تبينها وذلك على نفقة المحكوم عليه. وتأمر نفس جهة القضاء بأن يؤشر على هامش الأوراق الرسمية أو أوراق الحالة المدنية التي اتخذ فيها اللقب بغير حق أو ذكر فيها الاسم محرفا وذلك إذا ما رأت وجها لذلك ."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_251_19660608_OpEnact_bd6eb300df> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1966-06-08"^^xsd:date ;
