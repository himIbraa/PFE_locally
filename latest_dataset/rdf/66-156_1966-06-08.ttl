    dzdoc:evidenceText "يترتب على عقوبة الإقصاء من الصفقات العمومية منع المحكوم عليه من المشاركة بصفة مباشرة أو غير مباشرة في أية صفقة عمومية ، إما نهائيا أو لمدة لا تزيد عن عشر (10) سنوات في حالة الإدانة لارتكاب جناية، وخمس (5) سنوات في حالة الإدانة لارتكاب جنحة. ويجوز أن يؤمر بالنفاذ المعجل بالنسبة لهذا الإجراء."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
