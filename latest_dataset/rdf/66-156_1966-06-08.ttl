<https://legal.dz/resource/order/1966-06-08/66-156#version_art_263_مكرر2> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 150.000 دج إلى 800.000 دج، كل موظف يمارس أو يحرض أو يأمر بممارسة التعذيب من أجل الحصول على اعترافات أو معلومات أو لأي سبب آخر. إذا سبق التعذيب أو صاحب أو تلى جناية غير القتل العمد ، تكون العقوبة السجن المؤبد . يعاقب بالسجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 100.000 دج إلى 500.000 دج ، كل موظف يوافق أو يسكت عن الأفعال المذكورة في المادة 263 مكرر من هذا القانون. 2- أعمال العنف العمدية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_263__2_19660608_OpEnact_e237bf4aec> ;
    dzdoc:replacementText "يعاقب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 150.000 دج إلى 800.000 دج، كل موظف يمارس أو يحرض أو يأمر بممارسة التعذيب من أجل الحصول على اعترافات أو معلومات أو لأي سبب آخر. إذا سبق التعذيب أو صاحب أو تلى جناية غير القتل العمد ، تكون العقوبة السجن المؤبد . يعاقب بالسجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 100.000 دج إلى 500.000 دج ، كل موظف يوافق أو يسكت عن الأفعال المذكورة في المادة 263 مكرر من هذا القانون. 2- أعمال العنف العمدية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_263_مكرر2> ;
