<https://legal.dz/resource/order/1966-06-08/66-156#art_111> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_111" ;
    dzdoc:fullText "يعاقب بالحبس لمدة ستة أشهر إلى ثلاث سنوات كل قاض أو ضابط بالشرطة القضائية يجري متابعات، أو يصدر أمرا أو حكما أو يوقع عليهما، أو يصدر أمرا قضائيا ضد شخص متمتع بالحصانة القضائية في غير حالات التلبس بالجريمة دون أن يحصل قبل ذلك على رفع الحصانة عنه وفقا للأوضاع القانونية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_111> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_111_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_111_19660608_OpEnact_ada2ed4d14> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_111_obligation_0_4bea4be6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "111" ;
    dzdoc:position 169 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_111_condition_0_19432147> ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:judicial_police_officer .

<https://legal.dz/resource/order/1966-06-08/66-156#art_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_3_subsec_3> ;
    dzdoc:eId "art_114" ;
    dzdoc:fullText "في الحالة التي يكون فيها الغرض من تدبير اتخاذ الإجراءات بين سلطات مدنية وهيئات عسكرية أو رؤسائها أو كانت نتيجتها الاعتداء على الأمن الداخلي للدولة ، تكون عقوبة المحرضين السجن المؤبد، والجناة الآخرين السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة والغرامة من 1.000.000 دج إلى 2.000.000 دج. تطبق أحكام المادة 60 مكرر على الجناية المنصوص عليها في هذه المادة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_114> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_114_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_114_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_114_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_114_19660608_OpEnact_49ef703f51> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 114" ;
    dzdoc:position 172 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_114_condition_0_174abf57> .

