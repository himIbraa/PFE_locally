    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_414_19660608_OpEnact_13440405a3> ;
    dzdoc:replacementText "كل من أتلف أو كسر أية أداة من أدوات الزراعة أو حظائر المواشي أو أكشاك ثابتة أو متنقلة للحراس أو جعلها غير صالحة للاستعمال يعاقب بالحبس من شهرين إلى خمس سنوات وبغرامة من 500 إلى 1.000 دينار ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_414> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_414> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_415> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من سمم دواب الجر أو الركوب أو الحمل أو مواش ذات قرون أو خراف أو ماعز أو أية مواش أخرى أو كلاب الحراسة أو أسماك موجودة في البرك أو الأحواض أو الخزانات يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 3.000 دينار . ويجوز علاوة على ذلك الحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 من هذا القانون وبالمنع من الإقامة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_415_19660608_OpEnact_075603d713> ;
    dzdoc:replacementText "كل من سمم دواب الجر أو الركوب أو الحمل أو مواش ذات قرون أو خراف أو ماعز أو أية مواش أخرى أو كلاب الحراسة أو أسماك موجودة في البرك أو الأحواض أو الخزانات يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 3.000 دينار . ويجوز علاوة على ذلك الحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 من هذا القانون وبالمنع من الإقامة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_415> ;
