<https://legal.dz/resource/order/1966-06-08/66-156#version_art_312> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة صدور حكم من جهة قضائية أجنبية حاز قوة الشيء المقضي فيه عن أفعال تكون إحدى الجرائم المحددة في هذا القسم طبقا للقانون الجزائري ، تقرر محكمة محل إقامة المحكوم عليه منعقدة في غرفة مشورة وبناء على طلب النيابة العامة وبعد دعوة صاحب الشأن قانونا للحضور أنه ثمة محل لتطبيق المنع المنصوص عليه في المادة 311 ."@ar ;
