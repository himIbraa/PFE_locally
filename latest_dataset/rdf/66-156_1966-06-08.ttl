<https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_5> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب على الاتجار بالأشخاص بالسجن من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج إذا ارتكبت الجريمة مع توافر ظرف على الأقل من الظروف الآتية : إذا كان الفاعل زوجا للضحية أو أحد أصولها أو فروعها أو وليها أو كانت له سلطة عليها أو كان موظفا ممن سهلت له وظيفته ارتكاب الجريمة إذا ارتكبت الجريمة من طرف أكثر من شخص، إذا ارتكبت الجريمة مع حمل السلاح أو التهديد باستعماله، إذا ارتكبت الجريمة من طرف جماعة إجرامية منظمة أو كانت ذات طابع عابر للحدود الوطنية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
