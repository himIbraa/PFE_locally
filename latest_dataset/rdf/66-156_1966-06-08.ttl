<https://legal.dz/resource/order/1966-06-08/66-156#version_art_119_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 200.000 دج ، كل موظف عمومي في مفهوم المادة 2 من القانون رقم 06-01 المؤرخ في 20 فبراير سنة 2006 والمتعلق بالوقاية من الفساد ومكافحته، تسبب بإهماله الواضح في سرقة قة أو اختلاس أو تلف أو ضياع أموال عمومية أو خاصة أو أشياء تقوم مقامها أو وثائق أو سندات أو عقود أو أموال منقولة وضعت تحت يده سواء بحكم وظيفته أو بسببها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_119_bis_19660608_OpEnact_eeec5cf371> ;
    dzdoc:replacementText "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 200.000 دج ، كل موظف عمومي في مفهوم المادة 2 من القانون رقم 06-01 المؤرخ في 20 فبراير سنة 2006 والمتعلق بالوقاية من الفساد ومكافحته، تسبب بإهماله الواضح في سرقة قة أو اختلاس أو تلف أو ضياع أموال عمومية أو خاصة أو أشياء تقوم مقامها أو وثائق أو سندات أو عقود أو أموال منقولة وضعت تحت يده سواء بحكم وظيفته أو بسببها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_119_bis> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
