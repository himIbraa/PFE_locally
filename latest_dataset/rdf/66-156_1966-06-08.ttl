    dznorm:position 0 ;
    dznorm:provisionText "يقوم بفض أو اختلاس أو إتلاف رسائل مسلمة إلى البريد أو يسهل فضها أو اختلاسها أو إتلافها"@ar ;
    dznorm:sourceArticle "art_137" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_137_obligation_1_2054ff68> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
