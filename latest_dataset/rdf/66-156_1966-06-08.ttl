<https://legal.dz/resource/order/1966-06-08/66-156#art_326> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_4> ;
    dzdoc:eId "art_326" ;
    dzdoc:fullText "كل من خطف أو أبعد قاصرا لم يكمل الثامنة عشرة وذلك بغير عنف أو تهديد أو تحايل أو شرع في ذلك فيعاقب بالحبس لمدة من سنة إلى خمس سنوات وبغرامة من 500 إلى 2.000 دينار. وإذا تزوجت القاصر المخطوفة أو المبعدة من خاطفها فلا تتخذ إجراءات المتابعة الجزائية ضد الأخير إلا بناء على شكوى الأشخاص الذين لهم صفة في طلب إبطال الزواج ولا يجوز الحكم عليه إلا بعد القضاء بإبطاله."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_326_permission_0_6dc42237> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_326> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_326_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_326_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_326_19660608_OpEnact_887760ca7d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_326_obligation_0_e684b602> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "326" ;
    dzdoc:position 466 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_326_condition_0_06d769ba> ;
    dzdoc:usesTerm dzterm:minor .

<https://legal.dz/resource/order/1966-06-08/66-156#art_352> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_352" ;
    dzdoc:fullText "يعاقب بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج، كل من ارتكب السرقة في الطرق العمومية أو في المركبات المستعملة لنقل المسافرين أو المراسلات أو الأمتعة أو في داخل نطاق السكك الحديدية والمحطات والموانئ والمطارات وأرصفة الشحن أو التفريغ. ويجوز أيضا أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 9 مكرر 1 وبالمنع من الإقامة طبقا للشروط المنصوص عليها في المادتين 12 و 13 من هذا القانون. يعاقب على الشروع في ارتكاب الجنحة المنصوص عليها في الفقرة السابقة بالعقوبات ذاتها المقررة للجريمة التامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_352> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_352_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_352_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_352_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_352_19660608_OpEnact_07871711da> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_352_obligation_0_8fe036df>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_352_obligation_1_4b038755> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 352" ;
    dzdoc:position 503 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_12>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_13>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_12>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_13>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> ;
    dzdoc:usesTerm dzterm:theft .

<https://legal.dz/resource/order/1966-06-08/66-156#art_368> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_368" ;
    dzdoc:fullText "لا يعاقب على السرقات التي ترتكب من الأشخاص المبينين فيما بعد ولا تخول إلا الحق في التعويض المدني : (1) الأصول إضرارا بأولادهم أو غيرهم من الفروع. (2) الفروع إضرارا بأصولهم. (3) أحد الزوجين إضرارا بالزوج الآخر."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_368_right_0_c886188a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_368> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_368_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_368_19660608_OpEnact_7f68a7f1a7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "368" ;
    dzdoc:position 519 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_6_bis> ;
    dzdoc:eId "art_389_bis_7" ;
    dzdoc:fullText "يعاقب الشخص المعنوي الذي يرتكب الجريمة المنصوص عليها في المادتين 389 مكرر 1 و 389 مكرر 2 بالعقوبات الآتية : غرامة لا يمكن أن تقل عن أربع (4) مرات الحد الأقصى للغرامة المنصوص عليها في المادتين 389 مكرر 1 و 389 مكرر 2 من هذا القانون. مصادرة الممتلكات والعائدات التي تم تبييضها. مصادرة الوسائل والمعدات التي استعملت في ارتكاب الجريمة. إذا تعذر تقديم أو حجز الممتلكات محل المصادرة ، تحكم الجهة القضائية المختصة بعقوبة مالية تساوي قيمة هذه الممتلكات . ويمكن الجهة القضائية أن تقضي بالإضافة إلى ذلك بإحدى العقوبتين الآتيتين: المنع من مزاولة نشاط مهني أو اجتماعي لمدة لا تتجاوز خمس (5) سنوات. حل الشخص المعنوي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_7_permission_0_019b0547> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_389_bis_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_7_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_7_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_7_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_389_bis_7_19660608_OpEnact_f8437dcb17> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_7_obligation_0_2a5c0460>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_7_obligation_1_7526aab2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "389 مكرر 7" ;
    dzdoc:position 552 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_2> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_2> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_389_bis_7_condition_0_438e6963> ;
    dzdoc:usesTerm dzterm:legal_entity .

<https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_417_bis" ;
    dzdoc:fullText "يعاقب بالإعدام كل من استعمل العنف أو التهديد من أجل التحكم في طائرة على متنها ركاب أو السيطرة عليها. وتكون العقوبة السجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وغرامة من 1.000.000 دج إلى 2.000.000 دج ، إذا ارتكبت الأفعال المذكورة في الفقرة السابقة على وسيلة للنقل البحري أو البري ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_417_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_417_bis_19660608_OpEnact_9aff71fd9f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_obligation_0_f4930fed>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_obligation_1_bc17f4fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "417 مكرر" ;
    dzdoc:position 593 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_condition_0_a34079e3> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_417_bis_3" ;
    dzdoc:fullText "يكون الشخص المعنوي مسؤولا جزائيا عن الجرائم المحددة في الأقسام 4 و 5 و 6 و 8 من هذا الفصل ، وذلك حسب الشروط المنصوص عليها في المادة 51 مكرر من هذا القانون . تطبق على الشخص المعنوي عقوبة الغرامة ، حسب الكيفيات المنصوص عليها في المادة 18 مكرر ، وفي المادة 18 مكرر 2 عند الاقتضاء . ويتعرض أيضا إلى واحدة أو أكثر من العقوبات التكميلية المنصوص عليها في المادة 18 مكرر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_417_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_3_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_3_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_3_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_417_bis_3_19660608_OpEnact_533dc985ad> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_3_obligation_0_dfc1dde6>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_3_obligation_1_232c10e2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "417 مكرر 3" ;
    dzdoc:position 596 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_3_condition_0_ad6ee8af>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_3_condition_1_8a378d71> ;
    dzdoc:usesTerm dzterm:legal_person .

<https://legal.dz/resource/order/1966-06-08/66-156#art_445> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_1_sec_1_subsec_7> ;
    dzdoc:eId "art_445" ;
    dzdoc:fullText "يعاقب العائد في مادة المخالفات المنصوص عليها في هذا الباب بالحبس لمدة قد تصل إلى أربعة (4) أشهر وبغرامة قد تصل إلى 40.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_445> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_445_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_445_19660608_OpEnact_3156e628a0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_445_obligation_0_5fa00957> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 445" ;
    dzdoc:position 634 ;
    dzdoc:usesTerm dzterm:infractions,
        dzterm:recidivist .

<https://legal.dz/resource/order/1966-06-08/66-156#art_449> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_2_sec_1_subsec_4> ;
    dzdoc:eId "art_449" ;
    dzdoc:fullText "يعاقب بغرامة من 100 إلى 500 دج ويجوز أن يعاقب أيضا بالحبس لمدة عشرة أيام على الأكثر كل من أساء دون مقتضى معاملة حيوان من الحيوانات المنزلية أو المستأنسة أو المأسورة سواء كان ذلك علنيا أو غير علني . ويجوز للمحكمة في حالة الحكم على مالك الحيوان أو إذا كان مالكه مجهولا أن تأمر بإيداع الحيوان في مؤسسة ذات منفعة عمومية لحماية الحيوانات أو تقرر اعتبارها كذلك وللمؤسسة في هذه الحالة حرية التصرف فيه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_449> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_449_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_449_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_449_19660608_OpEnact_9887604250> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_449_obligation_0_690095e0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 449" ;
    dzdoc:position 638 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_449_condition_0_fd4f3da1> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_467_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_3> ;
    dzdoc:eId "art_467_bis_1" ;
    dzdoc:fullText "ترفع قيمة الغرامات المقررة في مادة المخالفات كما يأتي : إذا كانت الغرامة من 20 دج إلى 50 دج ، يصبح مبلغها من 2.000 دج إلى 4.000 دج، إذا كانت الغرامة من 30 دج إلى 100 دج ، يصبح مبلغها من 3.000 دج إلى 6.000 دج، إذا كانت الغرامة من 50 دج إلى 200 دج ، يصبح مبلغها من 4.000 دج إلى 8.000 دج، إذا كانت الغرامة من 50 دج إلى 500 دج ، يصبح مبلغها من 5.000 دج إلى 10.000 دج، إذا كانت الغرامة من 100 دج إلى 500 دج ، يصبح مبلغها من 6.000 دج إلى 12.000 دج، إذا كانت الغرامة من 100 دج إلى 1000 دج ، يصبح مبلغها من 8.000 دج إلى 16.000 دج، إذا كانت الغرامة من 500 دج إلى 1000 دج ، يصبح مبلغها من 10.000 دج إلى 20.000 دج.(2)"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_467_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_467_bis_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_467_bis_1_19660608_OpEnact_c2ecfa7d21> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 467 مكرر 1" ;
    dzdoc:position 658 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_467_bis_1_condition_0_d4473669>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_467_bis_1_condition_1_4235db71>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_467_bis_1_condition_2_ee7a1369>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_467_bis_1_condition_3_3f85a98c>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_467_bis_1_condition_4_3e366940>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_467_bis_1_condition_5_e5fe910b>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_467_bis_1_condition_6_7b06bafb> ;
    dzdoc:usesTerm dzterm:infractions .

<https://legal.dz/resource/order/1966-06-08/66-156#art_5> a dzdoc:Article ;
