    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis_1> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis_condition_0_0a57a49b> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis_condition_0_0a57a49b_ref_1da4c491e3b9> ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_119> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_119> ;
    dznorm:conditionText "عندما ترتكب الجرائم المنصوص عليها في الأقسام الأول والثاني والثالث من الفصل الثالث من هذا الباب ضد الدولة أو الأشخاص الاعتبارية المشار إليها في المادة 119"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis_condition_0_0a57a49b_ref_1da4c491e3b9> a dzdoc:Reference ;
    rdfs:label "المادة 119"@ar ;
    dzdoc:frbrUri "#art_119"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1966-06-08/66-156#art_119> ;
    dzdoc:sourceEId "art_382_bis" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "عندما ترتكب الجرائم المنصوص عليها في الأقسام الأول والثاني والثالث من الفصل الثالث من هذا الباب ضد الدولة أو الأشخاص الاعتبارية المشار إليها في المادة 119"@ar ;
    dzdoc:targetEId "art_119" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_382_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "عندما ترتكب الجرائم المنصوص عليها في الأقسام الأول والثاني والثالث من الفصل الثالث من هذا الباب ضد الدولة أو الأشخاص الاعتبارية المشار إليها في المادة 119 فإن الجاني يعاقب : 1 - بالسجن المؤبد في الحالات الواردة في المواد 352 و 353 و354. 2 - بالحبس من سنتين (2) إلى عشر (10) سنوات إذا كان الأمر يتعلق بجنحة، باستثناء الحالة التي تنص عليها المادة 370 من قانون العقوبات."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_382_condition_0_909d7637> a dznorm:Condition ;
    dznorm:conditionText "كل من قدم سندات أو أوراق أو مذكرات في منازعة إدارية أو قضائية ثم اختلسها بأية طريقة كانت أو امتنع عن إعادة تقديمها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_382> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_382_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_382> ;
    dzdoc:position 0 ;
    dzdoc:text "كل من قدم سندات أو أوراق أو مذكرات في منازعة إدارية أو قضائية ثم اختلسها بأية طريقة كانت أو امتنع عن إعادة تقديمها يعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 100 إلى 1.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_383_condition_0_1ae61f21> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1966-06-08/66-156#art_383_condition_0_1ae61f21_ref_5447306bef7d> ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1966-06-08/66-156#art_383_condition_0_1ae61f21_ref_5447306bef7d> ;
    dznorm:conditionText "كل من ثبتت مسؤوليته لارتكابه جريمة التفليس في الحالات المنصوص عليها في القانون التجاري"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_383> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_383_extref_5447306b> a dzdoc:ExternalReference ;
    rdfs:label "القانون التجاري"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/commercial"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/code/commercial"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/commercial" ;
    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_383_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_383> ;
    dzdoc:position 0 ;
    dzdoc:text "كل من ثبتت مسؤوليته لارتكابه جريمة التفليس في الحالات المنصوص عليها في القانون التجاري يعاقب : عن التفليس بالتقصير بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من 25.000 دج إلى 200.000 دج. عن التفليس بالتدليس بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_383_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_383> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجوز علاوة على ذلك أن يقضى على المفلس بالتدليس بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 9 مكرر 1 من هذا القانون لمدة سنة (1) على الأقل وخمس (5) سنوات على الأكثر."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_384_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_384> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب الشركاء في التفليس بالتقصير والتفليس بالتدليس بالعقوبات المنصوص عليها في المادة 383 من هذا القانون، حتى ولو لم تكن لهم صفة التاجر."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_385_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_385> ;
    dzdoc:position 0 ;
    dzdoc:text "ملغاة"@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_386_condition_0_7c3009d5> a dznorm:Condition ;
    dznorm:conditionText "خلسة أو بطرق التدليس"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_386> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_386_condition_1_a4d5b911> a dznorm:Condition ;
    dznorm:conditionText "وإذا كان انتزاع الملكية قد وقع ليلا بالتهديد أو العنف أو بطريقة التسلق أو الكسر من عدة أشخاص أو مع حمل سلاح ظاهر أو مخبأ بواسطة واحد أو أكثر من الجناة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_386> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_386_obligation_0_a9555dc8> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_386> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 2.000 إلى 20.000 دج"@ar ;
    dznorm:sourceArticle "art_386" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_386_obligation_1_6dd02fd7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_386> ;
    dznorm:position 1 ;
    dznorm:provisionText "العقوبة الحبس من سنتين إلى عشر سنوات والغرامة من 10.000 دج إلى 30.000 دج"@ar ;
    dznorm:sourceArticle "art_386" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_386_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_386> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 2.000 إلى 20.000 دج كل من انتزع عقارا مملوكا للغير وذلك خلسة أو بطرق التدليس."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_386_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_386> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا كان انتزاع الملكية قد وقع ليلا بالتهديد أو العنف أو بطريقة التسلق أو الكسر من عدة أشخاص أو مع حمل سلاح ظاهر أو مخبأ بواسطة واحد أو أكثر من الجناة فتكون العقوبة الحبس من سنتين إلى عشر سنوات والغرامة من 10.000 دج إلى 30.000 دج."@ar .

