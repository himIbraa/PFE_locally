    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_9> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_9> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_39> a dzdoc:Article ;
