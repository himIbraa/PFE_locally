    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_181> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 1.000 إلى 10.000 دينار أو بإحدى هاتين العقوبتين كل من يعلم بالشروع في جناية أو بوقوعها فعلا ولم يخبر السلطات فورا"@ar ;
    dznorm:sourceArticle "art_181" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_181_para_0> a dzdoc:Paragraph ;
