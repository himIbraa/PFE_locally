<https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_24> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعفى من العقوبة المقررة كل من يبلغ السلطات الإدارية أو القضائية عن جريمة الاتجار بالأعضاء قبل البدء في تنفيذها أو الشروع فيها . وتخفض العقوبة إلى النصف إذا تم الإبلاغ بعد انتهاء تنفيذ الجريمة أو الشروع فيها وقبل تحريك الدعوى العمومية أو إذا مكن بعد تحريك الدعوى العمومية من إيقاف الفاعل الأصلي أو الشركاء في نفس الجريمة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_24_19660608_OpEnact_735c6b2c92> ;
    dzdoc:replacementText "يعفى من العقوبة المقررة كل من يبلغ السلطات الإدارية أو القضائية عن جريمة الاتجار بالأعضاء قبل البدء في تنفيذها أو الشروع فيها . وتخفض العقوبة إلى النصف إذا تم الإبلاغ بعد انتهاء تنفيذ الجريمة أو الشروع فيها وقبل تحريك الدعوى العمومية أو إذا مكن بعد تحريك الدعوى العمومية من إيقاف الفاعل الأصلي أو الشركاء في نفس الجريمة ."@ar ;
