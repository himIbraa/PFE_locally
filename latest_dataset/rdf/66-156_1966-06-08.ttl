    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_397> ;
    dznorm:position 0 ;
    dznorm:provisionText "كل من وضع النار في أحد الأموال التي عددتها المادة 396 وكانت مملوكة له أو حمل الغير على وضعها فيها وتسبب بذلك عمدا في إحداث أي ضرر بالغير يعاقب بالسجن المؤقت من خمس إلى عشر سنوات."@ar ;
    dznorm:sourceArticle "art_397" .

