<https://legal.dz/resource/order/1966-06-08/66-156#art_224> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_5> ;
    dzdoc:eId "art_224" ;
    dzdoc:fullText "مؤجرو الغرف المفروشة وأصحاب النزل الذين يقيدون عمدا في سجلاتهم أسماء كاذبة أو منتحلة لأشخاص ينزلون عندهم أو يغفلون قيدهم بالتواطؤ معهم يعاقبون بالحبس من شهر إلى ستة أشهر وبغرامة من 500 إلى 5.000 دينار أو بإحدى هاتين العقوبتين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_224> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_224_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_224_19660608_OpEnact_3e8a3d6c4f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 224" ;
    dzdoc:position 307 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_225> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_7_subsec_5> ;
    dzdoc:eId "art_225" ;
    dzdoc:fullText "كل شخص اصطنع باسم طبيب أو جراح أو طبيب أسنان أو قابلة، شهادة مرضية أو شهادة بوجود عجز، وذلك بقصد أن يعفي نفسه، أو يعفي الغير من أية خدمة عمومية كانت، يعاقب بالحبس من سنة (1) إلى ثلاث (3) سنوات وبغرامة من 100.000 دج إلى 300.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_225> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_225_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_225_19660608_OpEnact_28dba3c821> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 225" ;
    dzdoc:position 308 .

