    dzdoc:evidenceText "إذا سبق الحكم نهائيا على شخص طبيعي من أجل مخالفة، وارتكب خلال السنة التالية لقضاء العقوبة السابقة نفس المخالفة ، تطبق عليه العقوبات المشددة لحالة العود المنصوص عليها في المادتين 445 و 465 من هذا القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_54_bis_4_19660608_OpEnact_57cc69b89b> ;
