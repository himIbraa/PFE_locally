<https://legal.dz/resource/order/1966-06-08/66-156#art_375_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_375_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "دون الإخلال بتطبيق أحكام المواد 37 و 40 و 329 من قانون الإجراءات الجزائية، تختص أيضا محكمة مكان الوفاء بالشيك أو محكمة مكان إقامة المستفيد من الشيك بالبحث والمتابعة والتحقيق والحكم في الجرائم المنصوص عليها في المادتين 16 مكرر 3 و 374 من هذا القانون."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_375_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_375> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بالحبس من سنة إلى عشر سنوات وبغرامة لا تقل عن قيمة الشيك أو عن قيمة النقص في الرصيد: (1) كل من زور أو زيف شيكا. (2) كل من قبل استلام شيك مزور أو مزيف مع علمه بذلك."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_376_obligation_0_2a829104> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1966-06-08/66-156#art_376_obligation_0_2a829104_role_ddb728e318> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_376> ;
    dznorm:position 0 ;
    dznorm:provisionText "كل من اختلس أو بدد بسوء نية أوراقا تجارية أو نقودا أو بضائع أو أوراقا مالية أو مخالصات أو أية محررات أخرى تتضمن أو تثبت التزاما أو إبراء لم تكن قد سلمت إليه إلا على سبيل الإجازة أو الوديعة أو الوكالة أو الرهن أو عارية الاستعمال أو لأداء عمل بأجر أو بغير أجر بشرط ردها أو تقديمها أو لاستعمالها أو لاستخدامها في عمل معين وذلك إضرارا بمالكيها أو واضعي اليد عليها أو حائزيها يعد مرتكبا لجريمة خيانة الأمانة ويعاقب بالحبس من ثلاثة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 20.000 دج."@ar ;
    dznorm:sourceArticle "art_376" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_376_obligation_0_2a829104_role_ddb728e318> a dznorm:Role ;
    rdfs:label "سبيل الإجازة أو الوديعة"@ar ;
