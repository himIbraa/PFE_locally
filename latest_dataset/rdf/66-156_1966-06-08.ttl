<https://legal.dz/resource/order/1966-06-08/66-156#art_468_extref_f5515a17> a dzdoc:ExternalReference ;
    rdfs:label "الأمر رقم 65-278 المؤرخ في 22 رجب عام 1385 الموافق 16 نوفمبر سنة 1965"@ar ;
    dzdoc:frbrUri "/akn/dz/act/order/1965-11-16/65-278"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/order/1965-11-16/65-278"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/order/1965-11-16/65-278" ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1965-11-16/65-278> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/order/1965-11-16/65-278"^^xsd:anyURI .

<https://legal.dz/resource/order/1966-06-08/66-156#art_468_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_468> ;
    dzdoc:position 0 ;
    dzdoc:text "تلغى جميع الأحكام المخالفة لهذا الأمر، الذي يسري مفعوله في تاريخ تطبيق الأمر رقم 65-278 المؤرخ في 22 رجب عام 1385 الموافق 16 نوفمبر سنة 1965 المتضمن التنظيم القضائي المشار إليه والذي ينشر في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_468_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_468> ;
    dzdoc:position 1 ;
    dzdoc:text "حرر بالجزائر في 18 صفر عام 1386 الموافق 8 يونيو سنة 1966."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_46_condition_0_cc98e6b0> a dznorm:Condition ;
    dznorm:conditionText "إذا لم ترتكب الجريمة المزعم ارتكابها لمجرد امتناع من كان ينوي ارتكابها بإرادته وحدها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_46> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_46_obligation_0_5d59bb00> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_46> ;
    dznorm:position 0 ;
    dznorm:provisionText "المحرض عليها يعاقب رغم ذلك بالعقوبات المقررة لهذه الجريمة."@ar ;
    dznorm:sourceArticle "art_46" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_46_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_46> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا لم ترتكب الجريمة المزعم ارتكابها لمجرد امتناع من كان ينوي ارتكابها بإرادته وحدها فإن المحرض عليها يعاقب رغم ذلك بالعقوبات المقررة لهذه الجريمة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_47_condition_0_1975e3dd> a dznorm:Condition ;
    dznorm:conditionText "حالة جنون وقت ارتكاب الجريمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_47> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_47_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_47> ;
    dzdoc:position 0 ;
    dzdoc:text "لا عقوبة على من كان في حالة جنون وقت ارتكاب الجريمة وذلك دون الإخلال بأحكام الفقرة 2 من المادة 21."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_48_condition_0_7343d36f> a dznorm:Condition ;
    dznorm:conditionText "اضطرته إلى ارتكاب الجريمة قوة لا قبل له بدفعها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_48> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_48_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_48> ;
    dzdoc:position 0 ;
    dzdoc:text "لا عقوبة لمن اضطرته إلى ارتكاب الجريمة قوة لا قبل له بدفعها."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_49_condition_0_07b7c0f4> a dznorm:Condition ;
    dznorm:conditionText "لم يكمل عشر (10) سنوات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_49> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_49_condition_1_5a35eae6> a dznorm:Condition ;
    dznorm:conditionText "يتراوح سنه من 10 إلى أقل من 13 سنة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_49> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_49_condition_2_2526bfdf> a dznorm:Condition ;
    dznorm:conditionText "يبلغ سنه من 13 إلى 18 سنة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_49> ;
    dznorm:position 2 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_49_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_49> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يكون محلا للمتابعة الجزائية القاصر الذي لم يكمل عشر (10) سنوات. لا توقع على القاصر الذي يتراوح سنه من 10 إلى أقل من 13 سنة إلا تدابير الحماية أو التهذيب."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_49_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_49> ;
    dzdoc:position 1 ;
    dzdoc:text "ومع ذلك، فإنه في مواد المخالفات لا يكون محلا إلا للتوبيخ."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_49_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_49> ;
    dzdoc:position 2 ;
    dzdoc:text "ويخضع القاصر الذي يبلغ سنه من 13 إلى 18 سنة إما لتدابير الحماية أو التهذيب أو لعقوبات مخففة."@ar .

