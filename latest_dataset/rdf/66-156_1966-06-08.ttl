<https://legal.dz/resource/order/1966-06-08/66-156#art_57> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_57" ;
    dzdoc:fullText "تعتبر من نفس النوع لتحديد العود الجرائم التي تشملها إحدى الفقرات الآتية : 1- اختلاس الأموال العمومية أو الخاصة والسرقة والإخفاء والنصب وخيانة الأمانة والرشوة. 2 - خيانة الائتمان على بياض وإصدار أو قبول شيكات بدون رصيد والتزوير واستعمال المحررات المزورة، 3- تبييض الأموال والإفلاس بالتدليس والاستيلاء على مال الشركة بطريق الغش وابتزاز الأموال، 4- القتل الخطأ والجرح الخطأ وجنحة الهروب والسياقة في حالة السكر، 5- الضرب والجرح العمدي والمشاجرة والتهديد والتعدي والعصيان، 6- الفعل المخل بالحياء بدون عنف والفعل العلني المخل بالحياء واعتياد التحريض على الفسق وفساد الأخلاق والمساعدة على الدعارة والتحرش الجنسي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_57> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_57_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_57_19660608_OpEnact_4673ccd716> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "57" ;
    dzdoc:position 100 ;
    dzdoc:usesTerm dzterm:recidivism .

