    dzdoc:occursInParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_2_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يعتبر من الغير حسن النية، الأشخاص الذين لم يكونوا شخصيا محل متابعة أو إدانة من أجل الوقائع التي أدت إلى المصادرة، ولديهم سند ملكية أو حيازة صحيح ومشروع على الأشياء القابلة للمصادرة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_2_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_15_bis_2> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر من الغير حسن النية، الأشخاص الذين لم يكونوا شخصيا محل متابعة أو إدانة من أجل الوقائع التي أدت إلى المصادرة، ولديهم سند ملكية أو حيازة صحيح ومشروع على الأشياء القابلة للمصادرة."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_15_defocc_4f049e4c5d01> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 101 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:confiscation ;
