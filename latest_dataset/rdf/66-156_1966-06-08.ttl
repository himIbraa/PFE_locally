<https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_1_sec_3> ;
    dzdoc:eId "art_16_bis_5" ;
    dzdoc:fullText "يجوز للجهة القضائية أن تحكم بسحب جواز السفر لمدة لا تزيد عن خمس (5) سنوات في حالة الإدانة من أجل جناية أو جنحة، وذلك من تاريخ النطق بالحكم. يجوز أن يؤمر بالنفاذ المعجل بالنسبة لهذا الإجراء. ويبلغ الحكم إلى وزارة الداخلية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_5_permission_0_4ac4666a>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_5_permission_1_2b116674> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_5_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_5_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_5_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_16_bis_5_19660608_OpEnact_7e9a8fafcc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_16_bis_5_obligation_0_c03d5b2f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "16 مكرر 5" ;
    dzdoc:position 33 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_176> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:criminal_association ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_1> ;
    dzdoc:eId "art_176" ;
    dzdoc:fullText "كل جمعية أو اتفاق مهما كانت مدته وعدد أعضائه تشكل أو تؤلف بغرض الإعداد لجناية أو أكثر، أو لجنحة أو أكثر ، معاقب عليها بخمس (5) سنوات حبس على الأقل، ضد الأشخاص أو الأملاك تكون جمعية أشرار ، وتقوم هذه الجريمة بمجرد التصميم المشترك على القيام بالفعل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_176> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_176_defocc_fc19824952c0> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_176_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_176_19660608_OpEnact_46119a3508> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "176" ;
    dzdoc:position 254 ;
    dzdoc:usesTerm dzterm:criminal_association .

<https://legal.dz/resource/order/1966-06-08/66-156#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:judicial_confinement ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1_chp_2> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "الحجز القضائي في مؤسسة إستشفائية للأمراض العقلية هو وضع الشخص بناء على أمر أو حكم أو قرار قضائي في مؤسسة مهيأة لهذا الغرض بسبب خلل في قواه العقلية قائم وقت ارتكابه الجريمة أو اعتراه بعد ارتكابها. يمكن أن يصدر الأمر بـ الحجز القضائي بموجب أي أمر أو حكم أو قرار بإدانة المتهم أو العفو عنه أو ببراءته أو بانتفاء وجه الدعوى، غير أنه في الحالتين الأخيرتين، يجب أن تكون مشاركته في الوقائع المادية ثابتة . يجب إثبات الخلل العقلي في الحكم الصادر بالحجز القضائي بعد الفحص الطبي . يخضع الشخص الموضوع في مؤسسة إستشفائية للأمراض العقلية لنظام الاستشفاء الإجباري المنصوص عليه في التشريع الجاري به العمل، غير أن النائب العام يبقى مختصا فيما يتعلق بمآل الدعوى العمومية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_21_permission_0_c2b83de1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_21> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_21_defocc_c931cfffae0e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_21_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_21_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_21_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_21_para_3> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_21_19660608_OpEnact_0d4825b2f3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_21_obligation_0_89225613> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 21" ;
    dzdoc:position 43 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_21_condition_0_09275b43> ;
    dzdoc:usesTerm dzterm:judicial_confinement,
        dzterm:prosecutor_general .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:human_trafficking ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis> ;
    dzdoc:eId "art_303_bis_4" ;
    dzdoc:fullText "يعد اتجار بالأشخاص، تجنيد أو نقل أو تنقيل أو إيواء أو استقبال شخص أو أكثر بواسطة التهديد بالقوة أو باستعمالها أو غير ذلك من أشكال الإكراه، أو الاختطاف أو الاحتيال أو الخداع أو إساءة استعمال السلطة أو استغلال حالة استضعاف أو بإعطاء أو تلقي مبالغ مالية أو مزايا لنيل موافقة شخص له سلطة على شخص آخر بقصد الاستغلال. ويشمل الاستغلال استغلال دعارة الغير أو سائر أشكال الاستغلال الجنسي أو استغلال الغير في التسول أو السخرة أو الخدمة كرها أو الاسترقاق أو الممارسات الشبيهة بالرق أو الاستعباد أو نزع الأعضاء. يعاقب على الاتجار بالأشخاص بالحبس من ثلاث (3) سنوات إلى عشر (10) سنوات وبغرامة من 300.000 دج إلى 1.000.000 دج. يعاقب على الاتجار بالأشخاص بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.500.000 دج، إذا سهل ارتكابه حالة استضعاف الضحية الناتجة عن سنها أو مرضها أو عجزها البدني أو الذهني، متى كانت هذه الظروف ظاهرة أو معلومة لدى الفاعل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_4> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4_defocc_110e6092d0d1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_4_19660608_OpEnact_966df2e652> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4_obligation_0_a3b002bb>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4_obligation_1_8ce9a997> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 4" ;
    dzdoc:position 404 ;
    dzdoc:usesTerm dzterm:human_trafficking .

<https://legal.dz/resource/order/1966-06-08/66-156#art_321> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_3> ;
    dzdoc:eId "art_321" ;
    dzdoc:fullText "يعاقب بالسجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج ، كل من نقل عمدا طفلا، أو أخفاه، أو استبدل طفلا آخر به أو قدمه على أنه ولد امرأة لم تضع، وذلك في ظروف من شأنها أن يتعذر التحقق من شخصيته. وإذا لم يثبت أن الطفل قد ولد حيا ، فتكون العقوبة الحبس من سنة (1) إلى خمس (5) سنوات وغرامة من 100.000 دج إلى 500.000 دج. وإذا ثبت أن الطفل لم يولد حيا ، فيعاقب بالحبس من شهر (1) إلى شهرين (2) وبغرامة من 10.000 دج إلى 20.000 دج. غير أنه إذا قدم فعلا الولد على أنه ولد لامرأة لم تضع حملا، بعد تسليم اختياري أو إهمال من والديه ، فيعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج. يكون الشخص المعنوي مسؤولا جزائيا عن الجريمة المحددة في الفقرات أعلاه ، وذلك طبقا للشروط المنصوص عليها في المادة 51 مكرر من هذا القانون. تطبق على الشخص المعنوي عقوبة الغرامة حسب الكيفيات المنصوص عليها في المادتين 18 مكرر ، وفي المادة 18 مكرر 2 عند الاقتضاء. ويتعرض أيضا لواحدة أو أكثر من العقوبات التكميلية المنصوص عليها في المادة 18 مكرر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_321> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_321_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_321_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_321_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_321_para_3>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_321_para_4>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_321_para_5>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_321_para_6> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_321_19660608_OpEnact_521d7911bf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_321_obligation_0_2f3f7cac>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_321_obligation_1_ab8d34c5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "321" ;
    dzdoc:position 461 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_321_condition_0_de4e3b7b>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_321_condition_1_9c5702d4>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_321_condition_2_98a062c6> ;
    dzdoc:usesTerm dzterm:legal_person .

<https://legal.dz/resource/order/1966-06-08/66-156#art_364> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_364" ;
    dzdoc:fullText "يعاقب بالحبس لمدة ستة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 5.000 دج المحجوز عليه الذي يتلف أو يبدد الأشياء المحجوزة والموضوعة تحت حراسته أو يشرع في ذلك . وإذا كانت الأشياء المحجوزة مسلمة إلى الغير لحراستها فتكون العقوبة الحبس من سنتين إلى خمس سنوات والغرامة من 1.000 إلى 10.000 دج. وتطبق العقوبة المنصوص عليها في الفقرة السابقة أيضا على المدين أو المقترض أو الراهن الذي يتلف أو يختلس الأشياء التي سلمها على سبيل الرهن أو شرع في ذلك. وفي جميع الحالات المعينة أعلاه يجوز أن يحكم علاوة على ذلك على الجاني بالحرمان من كافة الحقوق الواردة في المادة 14 أو من بعضها وبالمنع من الإقامة لمدة سنتين على الأقل وخمس سنوات على الأكثر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_364_permission_0_804909a3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_364> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_364_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_364_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_364_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_364_para_3> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_364_19660608_OpEnact_735ad741e2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_364_obligation_0_36b458f5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "364" ;
    dzdoc:position 515 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_364_condition_0_65443aa9> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:original_punishments,
        dzterm:supplementary_punishments ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_1> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "المادة 4 : يكون جزاء الجرائم بتطبيق العقوبات وتكون الوقاية منها باتخاذ تدابير أمن . العقوبات الأصلية هي تلك التي يجوز الحكم بها دون أن تقترن بها أية عقوبة أخرى. العقوبات التكميلية هي تلك التي لا يجوز الحكم بها مستقلة عن عقوبة أصلية، فيما عدا الحالات التي ينص عليها القانون صراحة، وهي إما إجبارية أو اختيارية. إن ل تدابير الأمن هدف وقائي. يعتبر الأشخاص المحكوم عليهم بسبب نفس الجريمة متضامنين في رد الأشياء والتعويضات المدنية والمصاريف القضائية ، مع مراعاة ما نصت عليه المادتان 310 الفقرة 4 و 370 من قانون الإجراءات الجزائية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_4_permission_0_63b766c1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_4_permission_1_a3257c2d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_4> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_4_defocc_0c0c0156b26c>,
