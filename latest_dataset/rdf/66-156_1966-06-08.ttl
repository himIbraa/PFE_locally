<https://legal.dz/resource/order/1966-06-08/66-156#version_art_339> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقضى بالحبس من سنة إلى سنتين على كل امرأة متزوجة ثبت ارتكابها جريمة الزنا . وتطبق العقوبة ذاتها على كل من ارتكب جريمة الزنا مع امرأة يعلم أنها متزوجة. ويعاقب الزوج الذي يرتكب جريمة الزنا بالحبس من سنة إلى سنتين وتطبق العقوبة ذاتها على شريكته. ولا تتخذ الإجراءات إلا بناء على شكوى الزوج المضرور ، وإن صفح هذا الأخير يضع حدا لكل متابعة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_339_19660608_OpEnact_0f0d9db101> ;
