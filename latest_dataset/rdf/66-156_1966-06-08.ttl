    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_210_19660608_OpEnact_e34fb40318> ;
    dzdoc:replacementText "يعاقب بالحبس من ستة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 5.000 دينار كل من تحصل بغير حق على أختام صحيحة أو علامات أو مطبوعات من المنصوص عليها في المادة 209 ووضعها أو استعملها بطريق الغش أو شرع في ذلك . ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة من سنة إلى خمس سنوات على الأكثر."@ar ;
