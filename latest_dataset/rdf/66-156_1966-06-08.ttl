    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_95> ;
    dzdoc:position 2 ;
    dzdoc:text "ويجوز للمحكمة علاوة على ذلك أن تقضي بالحرمان من الحقوق المبينة في المادة 14 من هذا القانون."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_96_bis_condition_0_b1b8d3f5> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1966-06-08/66-156#art_96_bis_condition_0_b1b8d3f5_ref_5a569abca85d> ;
