<https://legal.dz/resource/order/1966-06-08/66-156#book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5> ;
    dzdoc:eId "book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis" ;
    dzdoc:fullText "يعاقب بالحبس من ستة (6) أشهر إلى ثلاث (3) سنوات وبغرامة من 50.000 دج إلى 300.000 دج ، كل من تعمد المساس بحرمة الحياة الخاصة للأشخاص، بأية تقنية كانت وذلك: بالتقاط أو تسجيل أو نقل مكالمات أو أحاديث خاصة أو سرية، بغير إذن صاحبها أو رضاه. بالتقاط أو تسجيل أو نقل صورة لشخص في مكان خاص، بغير إذن صاحبها أو رضاه. يعاقب على الشروع في ارتكاب الجنحة المنصوص عليها في هذه المادة بالعقوبات ذاتها المقررة للجريمة التامة. ويضع صفح الضحية حدا للمتابعة الجزائية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_book_3_book_3_chp_2_book_3_chp_2_sec_1_book_3_chp_2_sec_1_subsec_5_art_303_bis_19660608_OpEnact_998fa2e6e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر" ;
    dzdoc:position 400 .

