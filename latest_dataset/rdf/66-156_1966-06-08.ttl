<https://legal.dz/resource/order/1966-06-08/66-156#version_art_386> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 2.000 إلى 20.000 دج كل من انتزع عقارا مملوكا للغير وذلك خلسة أو بطرق التدليس . وإذا كان انتزاع الملكية قد وقع ليلا بالتهديد أو العنف أو بطريقة التسلق أو الكسر من عدة أشخاص أو مع حمل سلاح ظاهر أو مخبأ بواسطة واحد أو أكثر من الجناة فتكون العقوبة الحبس من سنتين إلى عشر سنوات والغرامة من 10.000 دج إلى 30.000 دج ."@ar ;
