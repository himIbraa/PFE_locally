<https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_2> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمحكمة أن تحظر على المحكوم عليه من أجل الجرائم المنصوص عليها في المادتين 303 مكرر و 303 مكرر 1 ، ممارسة حق أو أكثر من الحقوق المنصوص عليها في المادة 9 مكرر 1 لمدة لا تتجاوز خمس (5) سنوات، كما يجوز لها أن تأمر بنشر حكم الإدانة طبقا للكيفيات المبينة في المادة 18 من هذا القانون. ويتعين دائما الحكم بمصادرة الأشياء التي استعملت لارتكاب الجريمة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_2_19660608_OpEnact_f370256a55> ;
    dzdoc:replacementText "يجوز للمحكمة أن تحظر على المحكوم عليه من أجل الجرائم المنصوص عليها في المادتين 303 مكرر و 303 مكرر 1 ، ممارسة حق أو أكثر من الحقوق المنصوص عليها في المادة 9 مكرر 1 لمدة لا تتجاوز خمس (5) سنوات، كما يجوز لها أن تأمر بنشر حكم الإدانة طبقا للكيفيات المبينة في المادة 18 من هذا القانون. ويتعين دائما الحكم بمصادرة الأشياء التي استعملت لارتكاب الجريمة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_2> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_2> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_20> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب على الجرائم المنصوص عليها في المادتين 303 مكرر 18 و 303 مكرر 19 ، بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.500.000 دج، إذا ارتكبت الجريمة مع توافر أحد الظروف الآتية : إذا كانت الضحية قاصرا أو شخصا مصابا بإعاقة ذهنية، إذا سهلت وظيفة الفاعل أو مهنته ارتكاب الجريمة، إذا ارتكبت الجريمة من طرف أكثر من شخص، إذا ارتكبت الجريمة مع حمل السلاح أو التهديد باستعماله، إذا ارتكبت الجريمة من طرف جماعة إجرامية منظمة أو كانت ذات طابع عابر للحدود الوطنية. ويعاقب بالسجن من عش"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_20_19660608_OpEnact_5ea7ee56c3> ;
    dzdoc:replacementText "يعاقب على الجرائم المنصوص عليها في المادتين 303 مكرر 18 و 303 مكرر 19 ، بالحبس من خمس (5) سنوات إلى خمس عشرة (15) سنة وبغرامة من 500.000 دج إلى 1.500.000 دج، إذا ارتكبت الجريمة مع توافر أحد الظروف الآتية : إذا كانت الضحية قاصرا أو شخصا مصابا بإعاقة ذهنية، إذا سهلت وظيفة الفاعل أو مهنته ارتكاب الجريمة، إذا ارتكبت الجريمة من طرف أكثر من شخص، إذا ارتكبت الجريمة مع حمل السلاح أو التهديد باستعماله، إذا ارتكبت الجريمة من طرف جماعة إجرامية منظمة أو كانت ذات طابع عابر للحدود الوطنية. ويعاقب بالسجن من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج، على ارتكاب الجرائم المنصوص عليها في المادتين 303 مكرر 16 و 303 مكرر 17 ، إذا ارتكبت الجريمة مع توافر أحد الظروف المنصوص عليها في الفقرة الأولى من هذه المادة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_20> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_20> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

