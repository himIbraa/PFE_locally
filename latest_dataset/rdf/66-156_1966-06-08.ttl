    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "256" ;
    dzdoc:position 341 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_257> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:lying_in_wait ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_257" ;
    dzdoc:fullText "الترصد هو انتظار شخص لفترة طالت أو قصرت في مكان أو أكثر وذلك إما لإزهاق روحه أو للاعتداء عليه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_257> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_257_defocc_664bb889f20c> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_257_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_257_19660608_OpEnact_ebdc158e02> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "257" ;
    dzdoc:position 342 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_258> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:parricide ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_258" ;
    dzdoc:fullText "قتل الأصول هو إزهاق روح الأب أو الأم أو أي من الأصول الشرعيين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_258> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_258_defocc_693fa2bf7703> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_258_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_258_19660608_OpEnact_74aecbaea2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "258" ;
    dzdoc:position 343 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_259> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:infanticide ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_259" ;
    dzdoc:fullText "قتل الأطفال هو إزهاق روح طفل حديث عهد بالولادة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_259> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_259_defocc_1fc4449e9bfe> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_259_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_259_19660608_OpEnact_ea006d796f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "259" ;
    dzdoc:position 344 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_262> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_262" ;
    dzdoc:fullText "يعاقب باعتباره قاتلا كل مجرم مهما كان وصفه استعمل التعذيب أو ارتكب أعمال وحشية لارتكاب جنايته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_262> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_262_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_262_19660608_OpEnact_a6808e9474> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_262_obligation_0_c121adff> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "262" ;
    dzdoc:position 347 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_263_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:torture ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_263_bis" ;
    dzdoc:fullText "يقصد بالتعذيب كل عمل ينتج عنه عذاب أو ألم شديد جسديا كان أو عقليا يلحق عمدا بشخص ما، مهما كان سببه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_263_bis> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_263_bis_defocc_d011daced92f> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_263_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_263_bis_19660608_OpEnact_7e5c15c1d8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "263 مكرر" ;
    dzdoc:position 349 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_273> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_1> ;
    dzdoc:eId "art_273" ;
    dzdoc:fullText "كل من ساعد عمدا شخصا في الأفعال التي تساعده على الانتحار أو تسهله له أو زوده بالأسلحة أو السم أو بالآلات المعدة للانتحار مع علمه بأنها سوف تستعمل في هذا الغرض يعاقب بالحبس من سنة إلى خمس سنوات إذا نفذ الانتحار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_273> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_273_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_273_19660608_OpEnact_92fecf098b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 273" ;
    dzdoc:position 361 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_273_condition_0_ab28356c> ;
    dzdoc:usesTerm dzterm:imprisonment .

<https://legal.dz/resource/order/1966-06-08/66-156#art_287> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_2> ;
    dzdoc:eId "art_287" ;
    dzdoc:fullText "كل من هدد بالاعتداء أو العنف غير المنصوص عليه في المادة 284 وذلك بإحدى الطرق المنصوص عليها في المواد من 284 إلى 286 يعاقب بالحبس من ثلاثة أشهر إلى سنة وبغرامة من 500 إلى 1.000 دج إذا كان التهديد مصحوبا بأمر أو شرط ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_287> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_287_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_287_19660608_OpEnact_46e339518b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_287_obligation_0_13e3fc56> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "287" ;
    dzdoc:position 376 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_284>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_286> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_284>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_286> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_4> ;
    dzdoc:eId "art_295_bis_3" ;
    dzdoc:fullText "لا تطبق أحكام المادتين 295 مكرر 1 و 295 مكرر 2 من هذا القانون إذا بني التمييز : على أساس الحالة الصحية من خلال عمليات هدفها الوقاية من مخاطر الوفاة أو مخاطر المساس بالسلامة البدنية للشخص أو العجز عن العمل أو من الإعاقة وتغطية هذه المخاطر، على أساس الحالة الصحية و/أو الإعاقة وتتمثل في رفض التشغيل المبني على عدم القدرة على العمل الثابتة طبيا وفقا لأحكام تشريع العمل أو القانون الأساسي للوظيفة العمومية، على أساس الجنس، فيما يخص التوظيف، عندما يكون الانتماء لجنس أو لآخر حسب تشريع العمل أو القانون الأساسي للوظيفة العمومية شرطا أساسيا لممارسة عمل أو نشاط مهني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_295_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_295_bis_3_19660608_OpEnact_07b3f262fd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "295 مكرر 3" ;
    dzdoc:position 390 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_2> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_2> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_3_condition_0_2a6065dd> ;
    dzdoc:usesTerm dzterm:discrimination .

<https://legal.dz/resource/order/1966-06-08/66-156#art_296> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:قذف ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5> ;
    dzdoc:eId "art_296" ;
    dzdoc:fullText "يعد قذفا كل ادعاء بواقعة من شأنها المساس بشرف واعتبار الأشخاص أو الهيئة المدعى عليها به أو إسنادها إليهم أو إلى تلك الهيئة ويعاقب على نشر هذا الادعاء أو ذلك الإسناد مباشرة أو بطريق إعادة النشر حتى ولو تم ذلك على وجه التشكيك أو إذا قصد به شخص أو هيئة دون ذكر الاسم ولكن كان من الممكن تحديدهما من عبارات الحديث أو الصياح أو التهديد أو الكتابة أو المنشورات أو اللافتات أو الإعلانات موضوع الجريمة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_296> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_296_defocc_b853247bcedb> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_296_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_296_19660608_OpEnact_986a87c7d4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "296" ;
    dzdoc:position 391 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_297> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:سب ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5> ;
    dzdoc:eId "art_297" ;
    dzdoc:fullText "يعد سبا كل تعبير مشين أو عبارة تتضمن تحقيرا أو قدحا لا ينطوي على إسناد أية واقعة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_297> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_297_defocc_c44af77bbc70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_297_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_297_19660608_OpEnact_a4a1c8687c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "297" ;
    dzdoc:position 392 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_299> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5> ;
    dzdoc:eId "art_299" ;
    dzdoc:fullText "يعاقب على السب الموجه إلى فرد أو عدة أفراد بالحبس من شهر (1) إلى ثلاثة (3) أشهر وبغرامة من 10.000 دج إلى 25.000 دج. ويضع صفح الضحية حدا للمتابعة الجزائية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_299> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_299_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_299_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_299_19660608_OpEnact_f398e706b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "299" ;
    dzdoc:position 395 ;
    dzdoc:usesTerm dzterm:سب .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis> ;
    dzdoc:eId "art_303_bis_12" ;
    dzdoc:fullText "لا يعتد برضا الضحية متى استخدم الفاعل أيا من الوسائل المبينة في المادة 303 مكرر 4 ( الفقرة الأولى) من هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_12_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_12_19660608_OpEnact_202e49dd7c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 12" ;
    dzdoc:position 412 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_4> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_12_condition_0_f37c4465> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis> ;
    dzdoc:eId "art_303_bis_14" ;
    dzdoc:fullText "تأمر الجهة القضائية في حالة الإدانة بالجرائم المنصوص عليها في هذا القسم بمصادرة الوسائل المستعملة في ارتكابها والأموال المتحصل عليها بصفة غير مشروعة ، مع مراعاة حقوق الغير حسن النية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_14_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_14_19660608_OpEnact_f39ca29391> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_14_obligation_0_43546deb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 14" ;
    dzdoc:position 414 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_26> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis_1> ;
    dzdoc:eId "art_303_bis_26" ;
    dzdoc:fullText "يكون الشخص المعنوي مسؤولا جزائيا عن الجرائم المنصوص عليها في هذا القسم، حسب الشروط المنصوص عليها في المادة 51 مكرر من هذا القانون. وتطبق على الشخص المعنوي العقوبات المنصوص عليها في المادة 18 مكرر من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_26> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_26_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_26_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_26_19660608_OpEnact_5e4eb40a58> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 26" ;
    dzdoc:position 426 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_51_bis> ;
    dzdoc:usesTerm dzterm:legal_person .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis_1> ;
    dzdoc:eId "art_303_bis_28" ;
    dzdoc:fullText "تأمر الجهة القضائية في حالة الإدانة بالجرائم المنصوص عليها في هذا القسم بمصادرة الوسائل المستعملة في ارتكابها والأموال المتحصل عليها بصفة غير مشروعة ، مع مراعاة حقوق الغير حسن النية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_28_19660608_OpEnact_cead6336b1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_28_obligation_0_43546deb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 28" ;
    dzdoc:position 428 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis_2> ;
    dzdoc:eId "art_303_bis_34" ;
    dzdoc:fullText "لا يستفيد الشخص المدان لارتكابه أحد الأفعال المجرمة في هذا القسم من الظروف المخففة المنصوص عليها في المادة 53 من هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_34_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_34_19660608_OpEnact_40d521a967> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_34_obligation_0_8c4c190c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 34" ;
    dzdoc:position 434 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_53> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_53> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis_2> ;
    dzdoc:eId "art_303_bis_40" ;
    dzdoc:fullText "تأمر الجهة القضائية في حالة الإدانة بالجرائم المنصوص عليها في هذا القسم بمصادرة الوسائل المستعملة في ارتكابها والأموال المتحصل عليها بصفة غير مشروعة ، مع مراعاة حقوق الغير حسن النية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_40_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_40_19660608_OpEnact_e5e9279464> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_40_obligation_0_43546deb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
