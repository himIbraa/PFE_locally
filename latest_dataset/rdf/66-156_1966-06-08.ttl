<https://legal.dz/resource/order/1966-06-08/66-156#version_art_5> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "العقوبات الأصلية في مادة الجنايات هي : الإعدام، السجن المؤبد، السجن المؤقت لمدة تتراوح بين خمس (5) سنوات وعشرين (20) سنة، ما عدا في الحالات التي يقرر فيها القانون حدودا أخرى قصوى . العقوبات الأصلية في مادة الجنح هي : الحبس مدة تتجاوز شهرين إلى خمس سنوات ماعدا الحالات التي يقرر فيها القانون حدودا أخرى ، الغرامة التي تتجاوز 20.000 دج. العقوبات الأصلية في مادة المخالفات هي : الحبس من يوم واحد على الأقل إلى شهرين على الأكثر، الغرامة من 2000 دج إلى 20.000 دج."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_5_19660608_OpEnact_e40d9b5fb1> ;
    dzdoc:replacementText "العقوبات الأصلية في مادة الجنايات هي : الإعدام، السجن المؤبد، السجن المؤقت لمدة تتراوح بين خمس (5) سنوات وعشرين (20) سنة، ما عدا في الحالات التي يقرر فيها القانون حدودا أخرى قصوى . العقوبات الأصلية في مادة الجنح هي : الحبس مدة تتجاوز شهرين إلى خمس سنوات ماعدا الحالات التي يقرر فيها القانون حدودا أخرى ، الغرامة التي تتجاوز 20.000 دج. العقوبات الأصلية في مادة المخالفات هي : الحبس من يوم واحد على الأقل إلى شهرين على الأكثر، الغرامة من 2000 دج إلى 20.000 دج."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_5> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_5> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_50> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا قضي بأن يخضع القاصر الذي يبلغ سنه من 13 إلى 18 لحكم جزائي فإن العقوبة التي عليه تكون كالآتي : إذا كانت العقوبة التي تفرض عليه هي الإعدام أو السجن المؤبد فإنه يحكم عليه بعقوبة الحبس من عشر سنوات إلى عشرين سنة. وإذا كانت العقوبة هي السجن أو الحبس المؤقت فإنه يحكم عليه بالحبس لمدة تساوي نصف المدة التي كان يتعين الحكم عليه بها إذا كان بالغا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_50_19660608_OpEnact_e6df832b43> ;
    dzdoc:replacementText "إذا قضي بأن يخضع القاصر الذي يبلغ سنه من 13 إلى 18 لحكم جزائي فإن العقوبة التي عليه تكون كالآتي : إذا كانت العقوبة التي تفرض عليه هي الإعدام أو السجن المؤبد فإنه يحكم عليه بعقوبة الحبس من عشر سنوات إلى عشرين سنة. وإذا كانت العقوبة هي السجن أو الحبس المؤقت فإنه يحكم عليه بالحبس لمدة تساوي نصف المدة التي كان يتعين الحكم عليه بها إذا كان بالغا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_50> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
