<https://legal.dz/resource/order/1966-06-08/66-156#version_art_395> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالسجن المؤبد كل من وضع النار عمدا في مبان أو مساكن أو غرف أو خيم أو أكشاك ولو متنقلة أو بواخر أو سفن أو مخازن أو ورش ، وذلك إذا كانت مسكونة أو مستعملة للسكنى ، وعلى العموم في أماكن مسكونة أو مستعملة للسكنى، سواء كانت مملوكة أو غير مملوكة لمرتكب الجناية. وتطبق العقوبة ذاتها على من وضع النار عمدا في مركبات أو طائرات أو عربات سكة حديد ليس بها أشخاص ولكن تدخل ضمن قطار يستعمله أشخاص."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_395_19660608_OpEnact_8a88fccf86> ;
    dzdoc:replacementText "يعاقب بالسجن المؤبد كل من وضع النار عمدا في مبان أو مساكن أو غرف أو خيم أو أكشاك ولو متنقلة أو بواخر أو سفن أو مخازن أو ورش ، وذلك إذا كانت مسكونة أو مستعملة للسكنى ، وعلى العموم في أماكن مسكونة أو مستعملة للسكنى، سواء كانت مملوكة أو غير مملوكة لمرتكب الجناية. وتطبق العقوبة ذاتها على من وضع النار عمدا في مركبات أو طائرات أو عربات سكة حديد ليس بها أشخاص ولكن تدخل ضمن قطار يستعمله أشخاص."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_395> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
