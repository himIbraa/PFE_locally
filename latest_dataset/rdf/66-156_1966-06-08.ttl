    dznorm:position 0 ;
    dznorm:provisionText "كل من أتلف عمدا بضائع أو مواد أو محركات أو أجهزة أيا كانت مستعملة في الصناعة وذلك بواسطة مواد من شأنها الإتلاف أو بأية وسيلة أخرى يعاقب بالحبس من ثلاثة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 5.000 دينار."@ar ;
    dznorm:sourceArticle "art_412" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_412_para_0> a dzdoc:Paragraph ;
