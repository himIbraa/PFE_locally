<https://legal.dz/resource/order/1966-06-08/66-156#art_331_obligation_0_49af3078> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/order/1966-06-08/66-156#art_331_obligation_0_49af3078_period_63673d5340> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_331> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من ستة (6) أشهر إلى (3) سنوات وبغرامة من 50.000 دج إلى 300.000 دج كل من امتنع عمدا، ولمدة تتجاوز الشهرين (2) عن تقديم المبالغ المقررة قضاء لإعالة أسرته، وعن أداء كامل قيمة النفقة المقررة عليه إلى زوجه أو أصوله أو فروعه، وذلك رغم صدور حكم ضده بإلزامه بدفع نفقة إليهم"@ar ;
    dznorm:sourceArticle "art_331" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_331_obligation_0_49af3078_period_63673d5340> a dznorm:Period ;
