    dzdoc:number "303 مكرر 37" ;
    dzdoc:position 437 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_37_condition_0_04f07b0c> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis> ;
    dzdoc:eId "art_303_bis_5" ;
    dzdoc:fullText "يعاقب على الاتجار بالأشخاص بالسجن من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج إذا ارتكبت الجريمة مع توافر ظرف على الأقل من الظروف الآتية : إذا كان الفاعل زوجا للضحية أو أحد أصولها أو فروعها أو وليها أو كانت له سلطة عليها أو كان موظفا ممن سهلت له وظيفته ارتكاب الجريمة إذا ارتكبت الجريمة من طرف أكثر من شخص، إذا ارتكبت الجريمة مع حمل السلاح أو التهديد باستعماله، إذا ارتكبت الجريمة من طرف جماعة إجرامية منظمة أو كانت ذات طابع عابر للحدود الوطنية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_5_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_5_19660608_OpEnact_50bc8f8f9f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_5_obligation_0_b498dabb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 5" ;
    dzdoc:position 405 ;
    dzdoc:usesTerm dzterm:human_trafficking .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis> ;
    dzdoc:eId "art_303_bis_8" ;
    dzdoc:fullText "تقضي الجهة القضائية المختصة بمنع أي أجنبي حكم عليه بسبب إحدى الجرائم المنصوص عليها في هذا القسم من الإقامة في التراب الوطني إما نهائيا أو لمدة عشر (10) سنوات على الأكثر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_8_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_8_19660608_OpEnact_a6027d754d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_8_obligation_0_595bcd15> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 8" ;
    dzdoc:position 408 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis> ;
    dzdoc:eId "art_303_bis_9" ;
    dzdoc:fullText "يعفى من العقوبة المقررة كل من يبلغ السلطات الإدارية أو القضائية عن جريمة الاتجار بالأشخاص قبل البدء في تنفيذها أو الشروع فيها. وتخفض العقوبة إلى النصف إذا تم الإبلاغ بعد انتهاء تنفيذ الجريمة أو الشروع فيها وقبل تحريك الدعوى العمومية أو إذا مكن بعد تحريك الدعوى العمومية من إيقاف الفاعل الأصلي أو الشركاء في نفس الجريمة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_9_right_0_0cfe47b2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_9_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_9_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_9_19660608_OpEnact_f27e315e28> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_9_obligation_0_dc022057> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 9" ;
    dzdoc:position 409 ;
    dzdoc:usesTerm dzterm:human_trafficking .

<https://legal.dz/resource/order/1966-06-08/66-156#art_305> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_305" ;
    dzdoc:fullText "إذا ثبت أن الجاني يمارس عادة الأفعال المشار إليها في المادة 304 فتضاعف عقوبة الحبس في الحالة المنصوص عليها في الفقرة الأولى وترفع عقوبة السجن المؤقت إلى الحد الأقصى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_305> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_305_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_305_19660608_OpEnact_0e2d093b4e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 305" ;
    dzdoc:position 443 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_304> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_304> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_305_condition_0_569b3f7e> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_315> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_315" ;
    dzdoc:fullText "إذا كان مرتكب الحادث من أصول الطفل أو العاجز أو ممن لهم سلطة عليه أو ممن يتولون رعايته فتكون العقوبة كما يلي: الحبس من سنتين إلى خمس سنوات في الحالات المنصوص عليها في الفقرة الأولى من المادة 314 ، السجن من خمس إلى عشر سنوات في الحالة المنصوص عليها في الفقرة الثانية من المادة المذكورة، السجن من عشر سنوات إلى عشرين سنة في الحالة المنصوص عليها في الفقرة الثالثة من المادة المذكورة، السجن المؤبد في الحالة المنصوص عليها في الفقرة الرابعة من المادة المذكورة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_315> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_315_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_315_19660608_OpEnact_4084c671a1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 315" ;
    dzdoc:position 453 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_314> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_314> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_315_condition_0_42fa87f7> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_318> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_318" ;
    dzdoc:fullText "يعاقب الجاني بالعقوبات المنصوص عليها في المواد من 261 إلى 263 على حسب الأحوال إذا تسبب في الوفاة مع توافر نية إحداثها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_318> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_318_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_318_19660608_OpEnact_46426e5e19> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 318" ;
    dzdoc:position 456 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_261>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_261>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_263> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_318_condition_0_de486c8b> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_351> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_351" ;
    dzdoc:fullText "يعاقب مرتكبو السرقة بالسجن المؤبد إذا كانوا يحملون أو يحمل أحد منهم أسلحة ظاهرة أو مخبأة حتى ولو وقعت السرقة من شخص واحد ولم يتوافر أي ظرف مشدد آخر . وتطبق العقوبة ذاتها إذا كان الجناة يضعون السلاح أو يضعه أحدهم في المركبة التي استقلوها إلى مكان الجريمة أو استعملوها في تأمين فرارهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_351> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_351_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_351_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_351_19660608_OpEnact_0d1cca76b7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 351" ;
    dzdoc:position 501 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_351_condition_0_6a51b88d>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_351_condition_1_29acbe9f> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_356> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:breaking ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_356" ;
    dzdoc:fullText "يوصف بالكسر فتح أي جهاز من أجهزة الأقفال بالقوة أو الشروع في ذلك سواء بكسره أو بإتلافه أو بأية طريقة أخرى بحيث يسمح لأي شخص بالدخول إلى مكان مغلق أو بالاستيلاء على أي شيء يوجد في مكان مقفول أو في أثاث أو وعاء مغلق."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_356_permission_0_311cac3a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_356> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_356_defocc_eea41b0cf22d> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_356_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_356_19660608_OpEnact_fd6fffaf31> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 356" ;
    dzdoc:position 507 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_360> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:public_roads ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_360" ;
    dzdoc:fullText "تعتبر طرقا عمومية الطرق والمسالك والدروب وكافة الأماكن الأخرى المخصصة لاستعمال الجمهور والواقعة خارج مجموعات المساكن والتي يجوز لأي فرد أن يمر بها بحرية في أية ساعة من ساعات النهار أو الليل دون اعتراض قانوني من أي كان."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_360_permission_0_8d02985e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_360> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_360_defocc_72dd8564b807> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_360_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_360_19660608_OpEnact_74935964a1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 360" ;
    dzdoc:position 511 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_365> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_365" ;
    dzdoc:fullText "في جميع الحالات المنصوص عليها في المادة 364 يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 1.000 إلى 10.000 دج كل من أخفى عمدا الأشياء المبددة . وتطبق العقوبة ذاتها على زوج أو أصول أو فروع المحجوز عليه أو المدين أو المقترض أو الراهن الذين ساعدوه على الإتلاف أو التبديد أو على الشروع في إتلاف أو تبديد هذه الأشياء. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من كافة الحقوق الواردة في المادة 14 أو من بعضها وبالمنع من الإقامة لمدة سنة على الأقل وخمس سنوات على الأكثر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_365> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_365_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_365_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_365_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_365_19660608_OpEnact_65c6277e39> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_365_obligation_0_22c66fc2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "365" ;
    dzdoc:position 516 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_364> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_364> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_1_sec_4> ;
    dzdoc:eId "art_39" ;
    dzdoc:fullText "لا جريمة : 1 - إذا كان الفعل قد أمر أو أذن به القانون . 2 - إذا كان الفعل قد دفعت إليه الضرورة الحالة للدفاع المشروع عن النفس أو عن الغير أو عن مال مملوك للشخص أو للغير بشرط أن يكون الدفاع متناسبا مع جسامة الاعتداء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_39> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_39_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_39_19660608_OpEnact_8c5a1de971> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 39" ;
    dzdoc:position 61 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_39_condition_0_a5b1c267>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_39_condition_1_97d51a3e>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_39_condition_2_e46cdb5e> ;
    dzdoc:usesTerm dzterm:crime .

<https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_7_bis> ;
    dzdoc:eId "art_394_bis_6" ;
    dzdoc:fullText "مع الاحتفاظ بـ حقوق الغير حسن النية ، يحكم بمصادرة الأجهزة والبرامج والوسائل المستخدمة مع إغلاق المواقع التي تكون محلا لجريمة من الجرائم المعاقب عليها وفقا لهذا القسم، علاوة على إغلاق المحل أو مكان الاستغلال إذا كانت الجريمة قد ارتكبت بعلم مالكها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_6_right_0_ef7bdd82> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_394_bis_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_6_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_394_bis_6_19660608_OpEnact_d33dab05e4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_6_obligation_0_523fdd98> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 394 مكرر 6" ;
    dzdoc:position 564 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_396_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_396_bis" ;
    dzdoc:fullText "تطبق عقوبة السجن المؤبد إذا كانت الجرائم المذكورة في المادتين 395 و 396 تتعلق بأملاك الدولة أو بأملاك الجماعات المحلية أو المؤسسات أو الهيئات الخاضعة للقانون العام ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_396_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_396_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_396_bis_19660608_OpEnact_1be7004016> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_396_bis_obligation_0_8fce5c36> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "396 مكرر" ;
    dzdoc:position 568 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_395>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_396> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_395>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_396> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_397> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_397" ;
    dzdoc:fullText "كل من وضع النار في أحد الأموال التي عددتها المادة 396 وكانت مملوكة له أو حمل الغير على وضعها فيها وتسبب بذلك عمدا في إحداث أي ضرر بالغير يعاقب بالسجن المؤقت من خمس إلى عشر سنوات. ويعاقب بنفس العقوبة كل من وضع النار بأمر من المالك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_397> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_397_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_397_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_397_19660608_OpEnact_a7290a68a7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_397_obligation_0_29125dfc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "397" ;
    dzdoc:position 569 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_396> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_396> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_398> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_398" ;
    dzdoc:fullText "كل من وضع النار عمدا في أية أشياء سواء كانت مملوكة له أم لا وكانت موضوعة بطريقة تؤدي إلى امتداد النار وأدى هذا الامتداد إلى إشعال النار في الأموال المملوكة للغير والتي عددتها المادة 396 يعاقب بالسجن المؤقت من خمس إلى عشر سنوات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_398> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_398_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_398_19660608_OpEnact_61339e2336> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_398_obligation_0_6c080ab7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "398" ;
    dzdoc:position 570 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_396> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_396> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_403> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_403" ;
    dzdoc:fullText "إذا نتجت وفاة شخص أو أكثر من ارتكاب الجرائم المنصوص عليها في المادة 401 ، يعاقب الجاني بالإعدام، وإذا سببت الجريمة جروحا أو عاهة مستديمة فتكون العقوبة السجن المؤبد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_403> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_403_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_403_19660608_OpEnact_327fb9d48e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "403" ;
    dzdoc:position 575 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_401> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_401> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_403_condition_0_7d999baa> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_409> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_409" ;
    dzdoc:fullText "فيما عدا الحالات المنصوص عليها في المادة 158 كل من أحرق أو خرب عمدا بأية طريقة كانت سجلات أو نسخا أو عقودا أصلية للسلطات العمومية أو سندات أو أوراقا مالية أو سفاتج (كمبيالات) أو أوراقا تجارية أو مصرفية تتضمن أو تنشئ التزامات أو تصرفات أو إبراء منها يعاقب بالسجن المؤقت من خمس إلى عشر سنوات إذا كانت المستندات المخربة من عقود السلطة العمومية أو من الأوراق التجارية أو المصرفية وبالحبس من سنتين إلى خمس سنوات وبغرامة من 500 إلى 3.000 دينار إذا تعلق الأمر بأية مستندات أخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_409> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_409_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_409_19660608_OpEnact_66ee512901> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_409_obligation_0_39da3a3b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "409" ;
    dzdoc:position 583 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_158> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_158> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_416> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_416" ;
    dzdoc:fullText "كل من أوجد أو نشر عمدا أمراضا معدية في الحيوانات المنزلية أو الطيور في أقفاصها أو النحل أو دود القز أو حيوانات الصيد أو الأسماك في البحيرات والأنهار يعاقب بالحبس من سنة إلى خمس سنوات وبغرامة من 500 إلى 30.000 دج ويعاقب على الشروع كالجريمة التامة. وكل من نقل عمدا مرضا معديا إلى أي حيوان كان متسببا بذلك عن عمد في نشر وباء حيواني أو أمراض معدية أو مساهما في نشرها في أي من الأنواع السابق بيانها يعاقب بغرامة من 500 إلى 15.000 دينار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_416> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_416_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_416_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_416_19660608_OpEnact_a83083cd0e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_416_obligation_0_aeab03ce>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_416_obligation_1_e7b19c06> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "416" ;
    dzdoc:position 591 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_417> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_417" ;
    dzdoc:fullText "كل من ردم حفرة أو هدم سورا مهما كانت المواد التي صنع بها أو قطع أو اقتلع سياجا أخضر أو أخشابا جافة منه أو نقل أو ألغى أنصاب الحدود أو أية علامات أخرى غرست لفصل الحدود بين مختلف الأملاك أو تعورف عليها كفاصل بينها يعاقب بالحبس من شهرين إلى سنة وبغرامة من 500 إلى 1.000 دينار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_417> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_417_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_417_19660608_OpEnact_4fce5c1747> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_417_obligation_0_3cbd5be4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "417" ;
    dzdoc:position 592 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_417_bis_1" ;
    dzdoc:fullText "يعاقب بالسجن المؤبد كل من تعمد تقديم معلومات خاطئة يعلم أنها قد تعرض سلامة طائرة في الجو أو باخرة للخطر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_417_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_417_bis_1_19660608_OpEnact_8feff10b75> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_417_bis_1_obligation_0_94a1b77a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "417 مكرر 1" ;
    dzdoc:position 594 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_440> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_440" ;
    dzdoc:fullText "يعاقب بالحبس من عشرة أيام على الأقل إلى شهرين على الأكثر وبغرامة من 100 إلى 1.000 دج أو بإحدى هاتين العقوبتين كل من أهان بالقول أو الإشارة أو التهديد أو الكتابة أو الرسم غير العلني أو بإرسال أية أشياء لنفس الغرض مواطنا مكلفا بأعباء خدمة عمومية أثناء قيامه بأعباء وظيفته أو بمناسبة قيامه بها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_440> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_440_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_440_19660608_OpEnact_b18bbf3191> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_440_obligation_0_805dd5d4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "440" ;
    dzdoc:position 625 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_440_condition_0_fb2b3ee8> ;
    dzdoc:usesTerm dzterm:citizen,
        dzterm:public_service .

<https://legal.dz/resource/order/1966-06-08/66-156#art_467_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_4_chp_3> ;
    dzdoc:eId "art_467_bis" ;
    dzdoc:fullText "ترفع قيمة الغرامات المقررة في مادة الجنح كما يأتي : يرفع الحد الأدنى للغرامات إلى 20.001 دج، إذا كان هذا الحد أقل من 20.000 دج ، يرفع الحد الأقصى للغرامات إلى 100.000 دج، إذا كان هذا الحد أقل من 100.000 دج ، يضاعف الحد الأقصى لغرامات الجنح الأخرى إذا كان هذا الحد يساوي أو يفوق 100.000 دج ، ما عدا الحالات التي ينص القانون فيها على حدود أخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_467_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_467_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_467_bis_19660608_OpEnact_1cd2f3eec4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 467 مكرر" ;
    dzdoc:position 657 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_467_bis_condition_0_4ddcb3d2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_467_bis_condition_1_51dc7ca2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_467_bis_condition_2_139385c3> ;
    dzdoc:usesTerm dzterm:misdemeanors .

<https://legal.dz/resource/order/1966-06-08/66-156#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "إذا قضي بأن يخضع القاصر الذي يبلغ سنه من 13 إلى 18 لحكم جزائي فإن العقوبة التي عليه تكون كالآتي : إذا كانت العقوبة التي تفرض عليه هي الإعدام أو السجن المؤبد فإنه يحكم عليه بعقوبة الحبس من عشر سنوات إلى عشرين سنة. وإذا كانت العقوبة هي السجن أو الحبس المؤقت فإنه يحكم عليه بالحبس لمدة تساوي نصف المدة التي كان يتعين الحكم عليه بها إذا كان بالغا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_50> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_50_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_50_19660608_OpEnact_e6df832b43> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 50" ;
    dzdoc:position 72 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_50_condition_0_09b5e6e3>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_50_condition_1_0990cfd4>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_50_condition_2_954ecc98> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_2_chp_2_sec_3_subsec_4> ;
    dzdoc:eId "art_60_bis_1" ;
    dzdoc:fullText "ما لم ينص مرسوم العفو على خلاف ذلك ، يترتب على تخفيض العقوبات الممنوحة خلال الفترة الأمنية تقليص هذه الفترة بقدر مدة التخفيض من العقوبة. ويترتب على استبدال عقوبة السجن المؤبد بمدة عشرين (20) سنة تقليص الفترة الأمنية إلى عشرة (10) سنوات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_60_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis_1_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_60_bis_1_19660608_OpEnact_be22206286> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "60 مكرر 1" ;
    dzdoc:position 105 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis_1_condition_0_dd66e465> ;
    dzdoc:usesTerm dzterm:security_period .

<https://legal.dz/resource/order/1966-06-08/66-156#art_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_70" ;
    dzdoc:fullText "يعاقب بالسجن المؤقت من عشر سنوات إلى عشرين سنة كل من : دخل متخفيا أو منتحلا اسما كاذبا أو مخفيا صفته أو جنسيته إلى حصن أو منشأة أو مركز أو مستودع أو إلى أماكن عمل أو ثكنات أو مخيمات أو معسكرات للجيش أو إلى منشآت حربية أو تجارية مستعملة للدفاع الوطني أو في سفن أو مركبات للملاحة الجوية أو في سيارة عسكرية مسلحة أو في مؤسسة عسكرية أو بحرية من أي نوع كانت أو في مؤسسة أو ورشة عمل تهم الدفاع الوطني. نظم بطريقة خفية أية طريقة للمراسلة أو الاتصال عن بعد من شأنها الإضرار بالدفاع الوطني حتى ولو لم يتخف أو يخف اسمه أو صفته أو جنسيته. حلق فوق الأرض الجزائرية باستعمال أية طائرة أجنبية دون أن يكون مصرحا له بذلك بمقتضى اتفاق دبلوماسي أو تصريح من السلطة الجزائرية. قام بعمل رسومات أو بأخذ صور أو برسم خرائط أو بعمليات طبوغرافية في منطقة محرمة حددتها السلطة العسكرية أو البحرية وذلك بداخل أو حول الأماكن أو المنشآت أو المراكز أو المؤسسات العسكرية أو البحرية أو التي تهم الدفاع الوطني بغير إذن من تلك السلطات. أقام في دائرة معينة حول المنشآت المحصنة أو المؤسسات العسكرية أو البحرية بالرغم من الحظر الذي يصدر مرسوم بتقريره. أفشى إلى شخص لا صفة له معلومات متعلقة إما بالتدابير التي تتخذ لكشف مرتكبي الجنايات والجنح المنصوص عليها في القسمين الأول والثاني من هذا الفصل وشركائهم وللقبض عليهم وإما بسير إجراءات المتابعة والتحقيق وإما بسير المحاكمة أمام جهات القضاء أو أذاع شيئا من ذلك علنا. ومع ذلك يعاقب مرتكبو الجرائم المنصوص عليها في الفقرات 3 و 4 و 6 أعلاه في وقت السلم بالحبس من سنة إلى خمس سنوات وبغرامة من 3.000 إلى 70.000 دينار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_70_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_70_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_70_19660608_OpEnact_cfb92ff3b1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_70_obligation_0_10624839>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_70_obligation_1_07579316> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "70" ;
