<https://legal.dz/resource/order/1966-06-08/66-156#version_art_145> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعتبر إهانة ويعاقب عليها على هذا الاعتبار قيام أحد الأشخاص بتبليغ السلطات العمومية بجريمة يعلم بعدم وقوعها أو تقديمه دليلا كاذبا متعلقا بجريمة وهمية أو تقريره أمام السلطة القضائية بأنه مرتكب جريمة لم يرتكبها أو لم يشترك في ارتكابها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_145_19660608_OpEnact_9553791291> ;
    dzdoc:replacementText "تعتبر إهانة ويعاقب عليها على هذا الاعتبار قيام أحد الأشخاص بتبليغ السلطات العمومية بجريمة يعلم بعدم وقوعها أو تقديمه دليلا كاذبا متعلقا بجريمة وهمية أو تقريره أمام السلطة القضائية بأنه مرتكب جريمة لم يرتكبها أو لم يشترك في ارتكابها ."@ar ;
