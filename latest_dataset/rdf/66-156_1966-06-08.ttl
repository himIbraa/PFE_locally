<https://legal.dz/resource/order/1966-06-08/66-156#art_60_bis_defocc_a8deb831e673> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 242 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:security_period ;
