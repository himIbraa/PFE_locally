    dzdoc:number "المادة 25" ;
    dzdoc:position 47 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_4> ;
    dzdoc:eId "art_295_bis_2" ;
    dzdoc:fullText "يعاقب الشخص المعنوي الذي يرتكب التمييز المنصوص عليه في المادة 295 مكرر 1 أعلاه، بغرامة من 150.000 دج إلى 750.000 دج دون الإخلال بالعقوبات التي قد تطبق على مسيريه . ويتعرض أيضا إلى عقوبة أو أكثر من العقوبات التكميلية المنصوص عليها في المادة 18 مكرر من هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_295_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_2_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_2_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_295_bis_2_19660608_OpEnact_51b739f649> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_2_obligation_0_11a07b6a>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_2_obligation_1_5b550d77> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "295 مكرر 2" ;
    dzdoc:position 389 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_1> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_18_bis>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_295_bis_1> ;
    dzdoc:usesTerm dzterm:legal_person .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis_1> ;
    dzdoc:eId "art_303_bis_17" ;
    dzdoc:fullText "يعاقب بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج، كل من ينتزع عضوا من شخص على قيد الحياة دون الحصول على الموافقة وفقا للشروط المنصوص عليها في التشريع الساري المفعول . وتطبق نفس العقوبة إذا تم انتزاع عضو من شخص ميت دون مرا اعاة التشريع الساري المفعول ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_17> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_17_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_17_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_17_19660608_OpEnact_62f544d0f5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_17_obligation_0_fd3fd895>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_17_obligation_1_f0785c3c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 17" ;
    dzdoc:position 417 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis_1> ;
    dzdoc:eId "art_303_bis_18" ;
    dzdoc:fullText "يعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج، كل من قام بانتزاع أنسجة أو خلايا أو بجمع مواد من جسم شخص مقابل دفع مبلغ مالي أو أي منفعة أخرى مهما كانت طبيعتها . وتطبق نفس العقوبة على كل من يتوسط قصد تشجيع أو تسهيل الحصول على أنسجة أو خلايا أو جمع مواد من جسم شخص ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_18_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_18_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_18_19660608_OpEnact_65808d6651> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_18_obligation_0_368b9872>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_18_obligation_1_98848d1b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 18" ;
    dzdoc:position 418 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_1_subsec_5_bis_1> ;
    dzdoc:eId "art_303_bis_19" ;
    dzdoc:fullText "يعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج، كل من ينتزع نسيجا أو خلايا أو يجمع مادة من جسم شخص على قيد الحياة دون الحصول على الموافقة المنصوص عليها في التشريع الساري المفعول . وتطبق نفس العقوبة إذا تم انتزاع نسيج أو خلايا أو جمع مواد من شخص ميت دون مراعاة التشريع الساري المفعول ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_19_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_19_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_303_bis_19_19660608_OpEnact_de02a5acba> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_19_obligation_0_769e6d68>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_303_bis_19_obligation_1_fc7a52b0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "303 مكرر 19" ;
    dzdoc:position 419 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_334> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_6> ;
    dzdoc:eId "art_334" ;
    dzdoc:fullText "يعاقب بالحبس من خمس إلى عشر سنوات كل من ارتكب فعلا مخلا بالحياء ضد قاصر لم يكمل السادسة عشرة ذكرا كان أو أنثى بغير عنف أو شرع في ذلك. ويعاقب بالسجن المؤقت من خمس إلى عشر سنوات أحد الأصول الذي يرتكب فعلا مخلا بالحياء ضد قاصر ولو تجاوز السادسة عشرة من عمره ولم يصبح بعد راشدا بالزواج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_334> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_334_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_334_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_334_19660608_OpEnact_e4663715fb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_334_obligation_0_46bf1302>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_334_obligation_1_1c018cb3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "334" ;
    dzdoc:position 477 ;
    dzdoc:usesTerm dzterm:indecent_act .

<https://legal.dz/resource/order/1966-06-08/66-156#art_349> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_2_subsec_7> ;
    dzdoc:eId "art_349" ;
    dzdoc:fullText "يجوز في جميع الحالات الحكم أيضا على مرتكبي الجنح المنصوص عليها في هذا القسم بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة وذلك لمدة سنة على الأقل إلى خمس سنوات على الأكثر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_349_permission_0_db53b70d> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1966-06-08/66-156#art_349_right_0_5148c125> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_349> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_349_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_349_19660608_OpEnact_126a9ddb07> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "349" ;
    dzdoc:position 495 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_14> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_349_condition_0_5329e9f9> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_350> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:thief ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_350" ;
    dzdoc:fullText "كل من اختلس شيئا غير مملوك له يعد سارقا ويعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج. وتطبق نفس العقوبة على اختلاس المياه والغاز والكهرباء. يجوز أن يحكم على الجاني علاوة على ذلك بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 9 مكرر 1 لمدة سنة (1) على الأقل وخمس (5) سنوات على الأكثر، وبالمنع من الإقامة طبقا للشروط المنصوص عليها في المادتين 12 و 13 من هذا القانون. ويعاقب على الشروع في هذه الجنحة بالعقوبات ذاتها المقررة للجريمة التامة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_350_permission_0_13987d07> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_350> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_350_defocc_8d98ebf003e8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_350_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_350_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_350_para_2>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_350_para_3> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_350_19660608_OpEnact_ec294cb6d6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 350" ;
    dzdoc:position 497 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_12>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_13>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_12>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_13>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_370> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_370" ;
    dzdoc:fullText "كل من انتزع بالقوة أو العنف أو الإكراه توقيعا أو ورقة أو عقدا أو سندا أو أي مستند كان يتضمن أو يثبت التزاما أو تصرفا أو ابراءا يعاقب بالسجن المؤقت من خمس إلى عشر سنوات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_370> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_370_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_370_19660608_OpEnact_1e42aae3ad> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "370" ;
    dzdoc:position 521 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_370_condition_0_dee7540c> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_7_bis> ;
    dzdoc:eId "art_394_bis" ;
    dzdoc:fullText "يعاقب بالحبس من ثلاثة (3) أشهر إلى سنة (1) وبغرامة من 50.000 دج إلى 100.000دج كل من يدخل أو يبقي عن طريق الغش في كل أو جزء من منظومة للمعالجة الآلية للمعطيات أو يحاول ذلك . تضاعف العقوبة إذا ترتب على ذلك حذف أو تغيير لمعطيات المنظومة . وإذا ترتب على الأفعال المذكورة أعلاه تخريب نظام اشتغال المنظومة تكون العقوبة الحبس من ستة (6) أشهر إلى سنتين (2) والغرامة من 50.000 دج إلى 150.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_394_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_para_1>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_394_bis_19660608_OpEnact_ccc768b7f3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_obligation_0_c3c78652>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_obligation_1_d6f23a21>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_obligation_2_04206035> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 394 مكرر" ;
    dzdoc:position 558 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_condition_0_11c13de5>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_condition_1_2592cba5>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_394_bis_condition_2_d6f817f5> ;
    dzdoc:usesTerm dzterm:automated_data_processing_system .

<https://legal.dz/resource/order/1966-06-08/66-156#art_399> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_399" ;
    dzdoc:fullText "في جميع الحالات المنصوص عليها في المواد من 396 إلى 398 يعاقب مرتكب الجريمة بالإعدام إذا أدى هذا الحريق العمد إلى موت شخص أو عدة أشخاص . وإذا تسبب الحريق في إحداث جرح أو عاهة مستديمة فتكون العقوبة السجن المؤبد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_399> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_399_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_399_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_399_19660608_OpEnact_2410829b99> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_399_obligation_0_167112d6>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_399_obligation_1_928de46e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "399" ;
    dzdoc:position 571 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_396>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_398> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_396>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_398> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_402> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_402" ;
    dzdoc:fullText "كل من وضع عمدا آلة متفجرة في طريق عام أو خاص، يعاقب بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج. غير أنه إذا وضعت الآلة بقصد القتل ، فيعتبر إيداعها شروعا في القتل، ويعاقب عليه بهذه الصفة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_402> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_402_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_402_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
