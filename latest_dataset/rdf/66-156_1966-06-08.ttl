<https://legal.dz/resource/order/1966-06-08/66-156#version_art_462> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بغرامة من 30 إلى 100 دج ويجوز أن يعاقب أيضا بالحبس لمدة ثلاثة أيام على الأكثر : كل من كان ملزما بإنارة جزء من طريق عام وأهمل إنارته . كل من أهمل إنارة المواد التي يضعها أو الحفر التي يحدثها في الشوارع أو في الساحات مخالفا بذلك القوانين واللوائح التنظيمية. كل من أهمل تنفيذ اللوائح التنظيمية أو القرارات المتعلقة بالطرق العمومية أو اطاعة الإنذار الصادر من السلطة الإدارية بإصلاح أو هدم المباني الآيلة للسقوط أو رفض ذلك . كل من أهمل تنظيف الشوارع أو الممرات في المناطق التي يترك فيها أمر هذه العن"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_462_19660608_OpEnact_e68074a453> ;
    dzdoc:replacementText "يعاقب بغرامة من 30 إلى 100 دج ويجوز أن يعاقب أيضا بالحبس لمدة ثلاثة أيام على الأكثر : كل من كان ملزما بإنارة جزء من طريق عام وأهمل إنارته . كل من أهمل إنارة المواد التي يضعها أو الحفر التي يحدثها في الشوارع أو في الساحات مخالفا بذلك القوانين واللوائح التنظيمية. كل من أهمل تنفيذ اللوائح التنظيمية أو القرارات المتعلقة بالطرق العمومية أو اطاعة الإنذار الصادر من السلطة الإدارية بإصلاح أو هدم المباني الآيلة للسقوط أو رفض ذلك . كل من أهمل تنظيف الشوارع أو الممرات في المناطق التي يترك فيها أمر هذه العناية للسكان . كل من ألقى أو وضع في الطريق العمومي أقذار أو كناسات أو مياها قذرة أو أية مواد أخرى يؤدي سقوطها إلى إحداث ضرر أو تتصاعد منها روائح ضارة بالصحة أو كريهة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_462> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
