<https://legal.dz/resource/order/1966-06-08/66-156#version_art_350> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من اختلس شيئا غير مملوك له يعد سارقا ويعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج. وتطبق نفس العقوبة على اختلاس المياه والغاز والكهرباء. يجوز أن يحكم على الجاني علاوة على ذلك بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 9 مكرر 1 لمدة سنة (1) على الأقل وخمس (5) سنوات على الأكثر، وبالمنع من الإقامة طبقا للشروط المنصوص عليها في المادتين 12 و 13 من هذا القانون. ويعاقب على الشروع في هذه الجنحة بالعقوبات ذاتها المقررة للجريمة التامة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_350_19660608_OpEnact_ec294cb6d6> ;
    dzdoc:replacementText "كل من اختلس شيئا غير مملوك له يعد سارقا ويعاقب بالحبس من سنة (1) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج. وتطبق نفس العقوبة على اختلاس المياه والغاز والكهرباء. يجوز أن يحكم على الجاني علاوة على ذلك بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 9 مكرر 1 لمدة سنة (1) على الأقل وخمس (5) سنوات على الأكثر، وبالمنع من الإقامة طبقا للشروط المنصوص عليها في المادتين 12 و 13 من هذا القانون. ويعاقب على الشروع في هذه الجنحة بالعقوبات ذاتها المقررة للجريمة التامة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
