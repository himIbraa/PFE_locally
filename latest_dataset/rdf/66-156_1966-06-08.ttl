    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_321> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_321_obligation_0_2f3f7cac> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1966-06-08/66-156#art_321_obligation_0_2f3f7cac_role_ced5804a6b> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_321> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالسجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج ، كل من نقل عمدا طفلا، أو أخفاه، أو استبدل طفلا آخر به أو قدمه على أنه ولد امرأة لم تضع، وذلك في ظروف من شأنها أن يتعذر التحقق من شخصيته."@ar ;
    dznorm:sourceArticle "art_321" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_321_obligation_0_2f3f7cac_role_ced5804a6b> a dznorm:Role ;
