    dzdoc:frbrUri "#art_177"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1966-06-08/66-156#art_177> ;
    dzdoc:sourceEId "art_177_bis_1" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يكون الشخص المعنوي مسؤولا جزائيا وفقا للشروط المنصوص عليها في المادة 51 مكرر أعلاه، عن الجرائم المنصوص عليها في المادة 176 من هذا القانون ويعاقب بالغرامة التي تساوي خمس (5) مرات الحد الأقصى للغرامة المقررة للشخص الطبيعي المنصوص عليها في المادة 177 من هذا القانون"@ar ;
    dzdoc:targetEId "art_177" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_177_bis_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_177_bis_1> ;
    dzdoc:position 0 ;
    dzdoc:text "يكون الشخص المعنوي مسؤولا جزائيا وفقا للشروط المنصوص عليها في المادة 51 مكرر أعلاه، عن الجرائم المنصوص عليها في المادة 176 من هذا القانون ويعاقب بالغرامة التي تساوي خمس (5) مرات الحد الأقصى للغرامة المقررة للشخص الطبيعي المنصوص عليها في المادة 177 من هذا القانون."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_177_bis_1_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_177_bis_1> ;
    dzdoc:position 1 ;
    dzdoc:text "ويتعرض أيضا لواحدة أو أكثر من العقوبات الآتية : 1- مصادرة الشيء الذي استعمل في ارتكاب الجريمة أو نتج عنها، 2- المنع لمدة خمس (5) سنوات من مزاولة بطريقة مباشرة أو غير مباشرة ، النشاط الذي أدى إلى الجريمة أو الذي ارتكبت الجريمة بمناسبته، 3- الإقصاء من الصفقات العمومية لمدة خمس (5) سنوات، 4- غلق المؤسسة أو فرع من فروعها لمدة لا تتجاوز خمس (5) سنوات، 5- حل الشخص المعنوي."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_177_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_177_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "دون الإخلال بأحكام المادة 42 من هذا القانون يعد اشتراكا في جمعية الأشرار المنصوص عليها في هذا القسم : 1- كل اتفاق بين شخصين أو أكثر لارتكاب إحدى الجرائم المنصوص عليها في المادة 176 من هذا القانون، بغرض الحصول على منفعة مالية أو مادية أخرى. 2- قيام الشخص عن علم بهدف جمعية الأشرار أو بعزمها على ارتكاب جرائم معينة بدور فاعل في : أ- نشاط جمعية الأشرار وفي أنشطة أخرى تضطلع بها هذه الجماعة مع علمه أن مشاركته ستساهم في تحقيق الهدف الإجرامي للجماعة. ب- تنظيم ارتكاب جريمة من قبل جمعية الأشرار أو الإيعاز بارتكاب تلك الجريمة أو المساعدة أو التحريض عليه أو تيسيره أو إبداء المشورة بشأنه."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_177_obligation_0_de6e2803_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/order/1966-06-08/66-156#art_177_obligation_0_de6e2803> ;
    dznorm:conditionText "إذا تم الإعداد لارتكاب جنايات"@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_177_obligation_0_de6e2803_role_4cc25424c7> a dznorm:Role ;
    rdfs:label "الاشتراك في جمعية الأشرار"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يعاقب على الاشتراك في جمعية الأشرار بالسجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج، إذا تم الإعداد لارتكاب جنايات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_177> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_177_obligation_1_4e0bbc12_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/order/1966-06-08/66-156#art_177_obligation_1_4e0bbc12> ;
    dznorm:conditionText "إذا تم الإعداد لارتكاب جنح"@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_177_obligation_2_53dd127a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_177> ;
    dznorm:position 2 ;
    dznorm:provisionText "ويعاقب منظم جمعية الأشرار أو من يباشر فيها أية قيادة كانت بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 5.000.000 دج"@ar ;
    dznorm:sourceArticle "art_177" .

<https://legal.dz/resource/order/1966-06-08/66-156#art_177_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_177> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب على الاشتراك في جمعية الأشرار بالسجن المؤقت من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج، إذا تم الإعداد لارتكاب جنايات."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_177_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_177> ;
    dzdoc:position 1 ;
    dzdoc:text "وتكون العقوبة الحبس من سنتين (2) إلى خمس (5) سنوات والغرامة من 100.000 دج إلى 500.000 دج، إذا تم الإعداد لارتكاب جنح."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_177_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_177> ;
    dzdoc:position 2 ;
    dzdoc:text "ويعاقب منظم جمعية الأشرار أو من يباشر فيها أية قيادة كانت بالسجن المؤقت من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 5.000.000 دج."@ar .

