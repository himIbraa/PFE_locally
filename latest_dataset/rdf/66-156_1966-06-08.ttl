<https://legal.dz/resource/order/1966-06-08/66-156#version_art_333_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين إلى سنتين وبغرامة من 500 إلى 2.000 دج كل من صنع أو حاز أو استورد أو سعى في استيراد من أجل التجارة أو وزع أو أجر أو لصق أو أقام معرضا أو عرض أو شرع في العرض للجمهور أو باع أو شرع في البيع أو وزع أو شرع في التوزيع كل مطبوع أو محررا أو رسم أو إعلان أو صور أو لوحات زيتية أو صور فوتوغرافية أو أصل الصورة أو قالبها أو أنتج أي شيء مخل بالحياء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_333_bis_19660608_OpEnact_2ce3bdbee8> ;
    dzdoc:replacementText "يعاقب بالحبس من شهرين إلى سنتين وبغرامة من 500 إلى 2.000 دج كل من صنع أو حاز أو استورد أو سعى في استيراد من أجل التجارة أو وزع أو أجر أو لصق أو أقام معرضا أو عرض أو شرع في العرض للجمهور أو باع أو شرع في البيع أو وزع أو شرع في التوزيع كل مطبوع أو محررا أو رسم أو إعلان أو صور أو لوحات زيتية أو صور فوتوغرافية أو أصل الصورة أو قالبها أو أنتج أي شيء مخل بالحياء ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
