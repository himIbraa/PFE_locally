<https://legal.dz/resource/order/1966-06-08/66-156#art_113> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_3_subsec_3> ;
    dzdoc:eId "art_113" ;
    dzdoc:fullText "إذا اتخذت إجراءات ضد تنفيذ القوانين أو أوامر الحكومة وكان تدبيرها بإحدى الطرق المذكورة في المادة 112 فيعاقب الجناة بالسجن المؤقت من خمس إلى عشر سنوات. وإذا كان تدبير هذه الإجراءات تم بين سلطات مدنية وهيئات عسكرية أو رؤسائها فيعاقب المحرضون عليها بالسجن المؤقت من عشر سنوات إلى عشرين سنة أما باقي الجناة فيعاقبون بالسجن المؤقت من خمس إلى عشر سنوات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_113> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_113_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_113_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_113_19660608_OpEnact_a7834301db> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 113" ;
    dzdoc:position 171 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_112> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_112> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_113_condition_0_cec57a4e>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_113_condition_1_6e29191d> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_144_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_1> ;
    dzdoc:eId "art_144_bis_2" ;
    dzdoc:fullText "يعاقب بالحبس من ثلاث (3) سنوات إلى خمس (5) سنوات وبغرامة من 50.000 دج إلى 100.000 دج أو بإحدى هاتين العقوبتين فقط كل من أساء إلى الرسول (صلى الله عليه وسلم) أو بقية الأنبياء أو استهزأ بالمعلوم من الدين بالضرورة أو بأية شعيرة من شعائر الإسلام سواء عن طريق الكتابة أو الرسم أو التصريح أو أية وسيلة أخرى. تباشر النيابة العامة إجراءات المتابعة الجزائية تلقائيا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_144_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_144_bis_2_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_144_bis_2_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_144_bis_2_19660608_OpEnact_58f7a643cf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_144_bis_2_obligation_0_6f026c0b>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_144_bis_2_obligation_1_118a8fdd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "144 مكرر 2" ;
    dzdoc:position 212 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_159> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_3> ;
    dzdoc:eId "art_159" ;
    dzdoc:fullText "يعاقب الأمين العمومي بالحبس من ستة أشهر إلى سنتين إذا كان الإتلاف أو التشويه أو التبديد أو الانتزاع قد وقع نتيجة إهماله ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_159> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_159_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_159_19660608_OpEnact_9fc9dbc6fd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 159" ;
    dzdoc:position 227 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_159_condition_0_c15dcf52> ;
    dzdoc:usesTerm dzterm:public_trustee .

<https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_4> ;
    dzdoc:eId "art_160_bis_8" ;
    dzdoc:fullText "في كل الحالات المنصوص عليها في المواد 160 مكرر 5 ، 160 مكرر 6 ، 160 مكرر 7 يمكن أن تأمر المحكمة بالحرمان من الحقوق الوطنية المنصوص عليها في المادة 9 مكرر 1 من قانون العقوبات."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_8_permission_0_ba549e2a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_160_bis_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_8_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_160_bis_8_19660608_OpEnact_90265d6031> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 160 مكرر 8" ;
    dzdoc:position 235 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_5>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_6>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_7>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_5>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_6>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_7>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_9_bis_1> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_160_bis_8_condition_0_708b0c7e> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_166> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_6> ;
    dzdoc:eId "art_166" ;
    dzdoc:fullText "تطبق العقوبات وتدابير الأمن المقررة في المادة 165 على الفاعلين والمنظمين والمديرين والمندوبين والمستخدمين الذين يقومون بأعمال النصيب غير المصرح بها. وتستبدل مصادرة العقار موضوع النصيب بالغرامة التي يجوز أن تصل إلى القيمة التقديرية لهذا العقار."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1966-06-08/66-156#art_166_permission_0_4f695466> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_166> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_166_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_166_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_166_19660608_OpEnact_d11c90d6f3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "166" ;
    dzdoc:position 241 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_165> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_165> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_172> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:illegal_speculation ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_5_subsec_7> ;
    dzdoc:eId "art_172" ;
    dzdoc:fullText "يعد مرتكبا لجريمة المضاربة غير المشروعة ويعاقب بالحبس من ستة أشهر إلى خمس سنوات وبغرامة من 5.000 إلى 100.000 دج كل من أحدث بطريق مباشر أو عن طريق وسيط رفعا أو خفضا مصطنعا في أسعار السلع أو البضائع أو الأوراق المالية العمومية أو الخاصة أو شرع في ذلك : بترويج أخبار أو أنباء كاذبة أو مغرضة عمدا بين الجمهور. أو بطرح عروض في السوق بغرض إحداث اضطراب في الأسعار. أو بتقديم عروض بأسعار مرتفعة عن تلك التي كان يطلبها البائعون. أو بالقيام بصفة فردية أو بناء على اجتماع أو ترابط بأعمال في السوق أو الشروع في ذلك بغرض الحصول على ربح غير ناتج عن التطبيق الطبيعي للعرض والطلب. أو بأي طرق أو وسائل احتيالية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_172> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_172_defocc_498b3824a614> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_172_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_172_19660608_OpEnact_0483cea3a9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "172" ;
    dzdoc:position 247 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_189> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_3> ;
    dzdoc:eId "art_189" ;
    dzdoc:fullText "العقوبة التي يقضى بها تنفيذا لأحكام المادة 188 ضد المحبوس الذي هرب أو شرع في الهروب تضم إلى أية عقوبة مؤقتة سالبة للحرية محكوم بها عن الجريمة التي أدت إلى القبض عليه أو حبسه وذلك استثناء من المادة 35 . وإذا كان التحقيق في هذه الجريمة الأخيرة قد انتهى بأمر أو بقرار بأن لا وجه للمتابعة أو بحكم بالبراءة أو بالإعفاء من العقوبة فإن مدة الحبس الاحتياطي الناشئ عنها لا تستنزل من مدة العقوبة المحكوم بها عن الهروب أو الشروع فيه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_189> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_189_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_189_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_189_19660608_OpEnact_3d1c3a2e72> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1966-06-08/66-156#art_189_obligation_0_f31f2b82> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "189" ;
    dzdoc:position 270 ;
    dzdoc:references <https://legal.dz/resource/order/1966-06-08/66-156#art_188>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_35> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1966-06-08/66-156#art_188>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_35> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_189_condition_0_260da33b> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_195_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_4> ;
    dzdoc:eId "art_195_bis" ;
    dzdoc:fullText "يعاقب بالحبس من ستة (6) أشهر إلى سنتين (2) ، كل من يتسول بقاصر لم يكمل 18 سنة أو يعرضه للتسول . تضاعف العقوبة عندما يكون الفاعل أحد أصول القاصر أو أي شخص له سلطة عليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_195_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1966-06-08/66-156#art_195_bis_para_0>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_195_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_195_bis_19660608_OpEnact_a21feb6bba> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:introducedOn "1966-06-08"^^xsd:date ;
    dzdoc:number "المادة 195 مكرر" ;
    dzdoc:position 277 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1966-06-08/66-156#art_195_bis_condition_0_164d1167>,
        <https://legal.dz/resource/order/1966-06-08/66-156#art_195_bis_condition_1_fa80be90> .

<https://legal.dz/resource/order/1966-06-08/66-156#art_196> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:definesTerm dzterm:متشرد ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1966-06-08/66-156#book_3_chp_1_sec_6_subsec_4> ;
    dzdoc:eId "art_196" ;
    dzdoc:fullText "يعد متشردا ويعاقب بالحبس من شهر إلى ستة أشهر كل من ليس له محل إقامة ثابت ولا وسائل تعيش ولا يمارس عادة حرفة أو مهنة رغم قدرته على العمل ويكون قد عجز عن إثبات أنه قدم طلبا للعمل أو يكون قد رفض عملا بأجر عرض عليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1966-06-08/66-156#version_art_196> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1966-06-08/66-156#art_196_defocc_b7fa5e18a3dd> ;
