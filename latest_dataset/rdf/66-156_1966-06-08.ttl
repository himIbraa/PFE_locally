    dzdoc:position 0 ;
    dzdoc:text "تقسم الجرائم تبعا لخطورتها إلى جنايات وجنح ومخالفات وتطبق عليها العقوبات المقررة للجنايات أو الجنح أو المخالفات."@ar .

<https://legal.dz/resource/order/1966-06-08/66-156#art_280_condition_0_89385a63> a dznorm:Condition ;
    dznorm:conditionText "إذا دفعه فورا إلى ارتكابها وقوع هتك عرض بالعنف"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_280> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_280_para_0> a dzdoc:Paragraph ;
