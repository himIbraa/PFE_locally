    dznorm:conditionText "الشروط المنصوص عليها في المادة 51 مكرر من هذا القانون"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1966-06-08/66-156#art_96_bis> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1966-06-08/66-156#art_96_bis_condition_0_b1b8d3f5_ref_5a569abca85d> a dzdoc:Reference ;
    rdfs:label "المادة 51 مكرر"@ar ;
    dzdoc:frbrUri "#art_51_bis"^^xsd:anyURI ;
