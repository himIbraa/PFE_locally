<https://legal.dz/resource/order/1966-06-08/66-156#version_art_380> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من استغل حاجة لقاصر لم يكمل التاسعة عشرة أو ميلا أو هوى أو عدم خبرة فيه ليختلس منه التزامات أو إبراء منها أو أية تصرفات أخرى تشغل ذمته المالية وذلك إضرارا به يعاقب بالحبس من ثلاثة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 10.000 دج. وتكون العقوبة الحبس من سنة إلى خمس سنوات والغرامة من 1.000 إلى 15.000 دج إذا كان المجني عليه موضوعا تحت رعاية الجاني أو رقابته أو سلطته وفي جميع الحالات المنصوص عليها في هذه المادة يجوز أن يحكم أيضا على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_380_19660608_OpEnact_f18c6820a7> ;
    dzdoc:replacementText "كل من استغل حاجة لقاصر لم يكمل التاسعة عشرة أو ميلا أو هوى أو عدم خبرة فيه ليختلس منه التزامات أو إبراء منها أو أية تصرفات أخرى تشغل ذمته المالية وذلك إضرارا به يعاقب بالحبس من ثلاثة أشهر إلى ثلاث سنوات وبغرامة من 500 إلى 10.000 دج. وتكون العقوبة الحبس من سنة إلى خمس سنوات والغرامة من 1.000 إلى 15.000 دج إذا كان المجني عليه موضوعا تحت رعاية الجاني أو رقابته أو سلطته وفي جميع الحالات المنصوص عليها في هذه المادة يجوز أن يحكم أيضا على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة وذلك لمدة سنة على الأقل وخمس سنوات على الأكثر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_380> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_380> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_381> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من أؤتمن على ورقة موقعة على بياض وخان أمانتها بأن حرر عليها زورا التزاما أو إبراء منه، أو أي تصرف آخر يمكن أن يعرض شخص الموقع أو ذمته المالية للضرر يعاقب بالحبس من سنة على الأقل إلى خمس سنوات على الأكثر وبغرامة من 1.000 إلى 50.000 دج. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة من سنة على الأقل إلى خمس سنوات على الأكثر. وفي الحالة التي لا تكون الورقة الموقعة على بياض قد عهد بها إليه فتتخذ ضده الإجراءات الجزائية بوصفه مزورا وي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_381_19660608_OpEnact_c13e0b2ee2> ;
    dzdoc:replacementText "كل من أؤتمن على ورقة موقعة على بياض وخان أمانتها بأن حرر عليها زورا التزاما أو إبراء منه، أو أي تصرف آخر يمكن أن يعرض شخص الموقع أو ذمته المالية للضرر يعاقب بالحبس من سنة على الأقل إلى خمس سنوات على الأكثر وبغرامة من 1.000 إلى 50.000 دج. ويجوز علاوة على ذلك أن يحكم على الجاني بالحرمان من حق أو أكثر من الحقوق الواردة في المادة 14 وبالمنع من الإقامة من سنة على الأقل إلى خمس سنوات على الأكثر. وفي الحالة التي لا تكون الورقة الموقعة على بياض قد عهد بها إليه فتتخذ ضده الإجراءات الجزائية بوصفه مزورا ويعاقب بهذا الوصف."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_381> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1966-06-08/66-156#art_381> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1966-06-08"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1966-06-08/66-156#version_art_382> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل من قدم سندات أو أوراق أو مذكرات في منازعة إدارية أو قضائية ثم اختلسها بأية طريقة كانت أو امتنع عن إعادة تقديمها يعاقب بالحبس من شهرين إلى ستة أشهر وبغرامة من 100 إلى 1.000 دج."@ar ;
    dzdoc:isAuthoritative true ;
