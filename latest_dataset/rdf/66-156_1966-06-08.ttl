    dzdoc:assertsTarget <https://legal.dz/resource/order/1966-06-08/66-156> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز في مادة الجنايات، النطق بالغرامة وحدها ، و يحكم بها دائما في إطار الحدين المنصوص عليهما في القانون ، سواء كانت مقررة أصلا أم لا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1966-06-08/66-156#version_art_53_bis_2_19660608_OpEnact_4534461d3b> ;
