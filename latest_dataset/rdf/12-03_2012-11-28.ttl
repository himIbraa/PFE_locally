    dznorm:expressedIn <https://legal.dz/resource/law/2012-11-28/03-12#art_22> ;
    dznorm:position 0 ;
    dznorm:provisionText "يندرج برنامج الوقاية واكتشاف ومكافحة تبييض الأموال وتمويل الإرهاب، كما تنص عليه المادة الأولى من هذا النظام، ضمن جهاز الرقابة الداخلية للمصارف و والمؤسسات المالية والمصالح المالية لبريد الجزائر"@ar ;
    dznorm:sourceArticle "art_22" .

<https://legal.dz/resource/law/2012-11-28/03-12#art_22_obligation_0_17e13afe_ref_5a717770d75f> a dzdoc:Reference ;
    rdfs:label "المادة الأولى"@ar ;
    dzdoc:frbrUri "#art_1"^^xsd:anyURI ;
