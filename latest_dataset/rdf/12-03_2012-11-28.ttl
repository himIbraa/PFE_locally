<https://legal.dz/resource/law/2012-11-28/03-12#version_art_18> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر أن تضع برنامج تكوين دائم يحضر بصفة لائقة مستخدميهم على معرفة التدابير المتعلقة بمكافحة تبييض الأموال و تمويل الإرهاب . ويجب أن تتلاءم كل من رزنامة ومضمون هذه الدورات المنظمة مع الاحتياجات الخاصة للمؤسسة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2012-11-28/03-12#version_art_18_20121128_OpEnact_a56b85ef4b> ;
    dzdoc:replacementText "يجب على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر أن تضع برنامج تكوين دائم يحضر بصفة لائقة مستخدميهم على معرفة التدابير المتعلقة بمكافحة تبييض الأموال و تمويل الإرهاب . ويجب أن تتلاءم كل من رزنامة ومضمون هذه الدورات المنظمة مع الاحتياجات الخاصة للمؤسسة ."@ar ;
