<https://legal.dz/resource/law/2012-11-28/03-12#version_art_22> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يندرج برنامج الوقاية واكتشاف ومكافحة تبييض الأموال و تمويل الإرهاب ، كما تنص عليه المادة الأولى من هذا النظام، ضمن جهاز الرقابة الداخلية للمصارف و والمؤسسات المالية والمصالح المالية لبريد الجزائر و يعد تقرير سنوي في هذا المجال يرسل إلى اللجنة المصرفية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
