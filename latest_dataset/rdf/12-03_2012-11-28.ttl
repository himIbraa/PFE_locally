    dzdoc:sourceEId "art_1" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يجب على المصارف والمؤسسات المالية والمصالح المالية لبريد الجزائر، تطبيقا لالقانون رقم 01-05 المؤرخ في 27 ذي الحجة عام 1425 الموافق 6 فبراير سنة 2005 ، المعدل والمتمم والمتعلق بالوقاية من تبييض الأموال وتمويل الإرهاب ومكافحتهما ، كما هو منصوص عليه في المادتين 2 و 3 منه، الالتزام باليقظة"@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/2005-02-06/05-01"^^xsd:anyURI ;
    dzdoc:targetEId "art_2" .

