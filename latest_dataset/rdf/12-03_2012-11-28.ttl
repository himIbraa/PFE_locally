<https://legal.dz/resource/law/2012-11-28/03-12#version_art_23> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقيم محافظو الحسابات مطابقة الإجراءات الداخلية الخاصة بالوقاية من تبييض الأموال و تمويل الإرهاب ومكافحتهما ، لكل من المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر مقارنة مع الممارسات المطابقة للمعايير وممارسات الحذر السارية المفعول ويرسل تقرير سنوي إلى اللجنة المصرفية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
