<https://legal.dz/resource/law/2012-11-28/03-12#version_art_24> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرسل مفتشو بنك الجزائر المفوضون من قبل اللجنة المصرفية الناشطون في إطار الرقابة بعين المكان أو في إطار الرقابة على أساس المستندات، فورا ، تقريرا عن طريق التسلسل السلمي إلى خلية معالجة الاستعلام المالي بمجرد اكتشافهم لعملية تتضمن المميزات المذكورة في المادة 10 من هذا النظام ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2012-11-28/03-12#version_art_24_20121128_OpEnact_ced6045f73> ;
    dzdoc:replacementText "يرسل مفتشو بنك الجزائر المفوضون من قبل اللجنة المصرفية الناشطون في إطار الرقابة بعين المكان أو في إطار الرقابة على أساس المستندات، فورا ، تقريرا عن طريق التسلسل السلمي إلى خلية معالجة الاستعلام المالي بمجرد اكتشافهم لعملية تتضمن المميزات المذكورة في المادة 10 من هذا النظام ."@ar ;
