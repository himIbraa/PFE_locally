<https://legal.dz/resource/law/2012-11-28/03-12#art_21_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2012-11-28/03-12#art_21> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب على المصارف والمؤسسات المالية أن تسهر على تطبيق نصوص هذا النظام من طرف فروعها والفروع التابعة لها الموجودة في الخارج، في حدود ما تسمح به القوانين والأنظمة للبلد المضيف. وعند استحالة ذلك، يتم الرجوع إلى اللجنة المصرفية."@ar .

<https://legal.dz/resource/law/2012-11-28/03-12#art_22_obligation_0_17e13afe> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
