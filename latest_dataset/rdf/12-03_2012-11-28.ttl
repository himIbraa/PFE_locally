<https://legal.dz/resource/law/2012-11-28/03-12#art_12_obligation_2_08778b49> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
