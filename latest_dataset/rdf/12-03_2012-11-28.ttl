<https://legal.dz/resource/law/2012-11-28/03-12#version_art_3> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن تأخذ المعايير المتعلقة بمعرفة الزبائن بعين الاعتبار العناصر الأساسية لتسيير المخاطر وإجراءات الرقابة ، لاسيما : سياسة قبول الزبائن الجدد، تحديد هوية الزبائن ومتابعة العمليات وحركاتها، رقابة مستمرة على الزبائن وعلى الحسابات المتضمنة لمخاطر. يجب على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر أن تعرف هوية وعنوان زبائنها كما يجب عليها مراقبة حركات الحسابات لاكتشاف أنواع العمليات والمعاملات غير الاعتيادية و/ أو غير العادية ومبررها الاقتصادي بالنسبة لزبون محدد أو صنف من الحسابات"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2012-11-28/03-12#version_art_3_20121128_OpEnact_3d941f8c86> ;
    dzdoc:replacementText "يجب أن تأخذ المعايير المتعلقة بمعرفة الزبائن بعين الاعتبار العناصر الأساسية لتسيير المخاطر وإجراءات الرقابة ، لاسيما : سياسة قبول الزبائن الجدد، تحديد هوية الزبائن ومتابعة العمليات وحركاتها، رقابة مستمرة على الزبائن وعلى الحسابات المتضمنة لمخاطر. يجب على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر أن تعرف هوية وعنوان زبائنها كما يجب عليها مراقبة حركات الحسابات لاكتشاف أنواع العمليات والمعاملات غير الاعتيادية و/ أو غير العادية ومبررها الاقتصادي بالنسبة لزبون محدد أو صنف من الحسابات ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
