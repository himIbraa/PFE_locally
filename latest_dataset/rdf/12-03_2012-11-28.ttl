    rdfs:label "المادة 18 من القانون رقم 05-01 المؤرخ في 6 فبراير سنة 2005 والمتعلق بالوقاية من تبييض الأموال وتمويل الإرهاب ومكافحتهما المعدل والمتمم"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/2005-02-06/05-01#art_18"^^xsd:anyURI ;
