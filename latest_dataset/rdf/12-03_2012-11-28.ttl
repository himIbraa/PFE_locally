dzterm:banking_commission a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "اللجنة المصرفية"@ar .

<https://legal.dz/resource/law/2012-11-28/03-12#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2012-11-28/03-12#chp_10> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "يقيم محافظو الحسابات مطابقة الإجراءات الداخلية الخاصة بالوقاية من تبييض الأموال و تمويل الإرهاب ومكافحتهما ، لكل من المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر مقارنة مع الممارسات المطابقة للمعايير وممارسات الحذر السارية المفعول ويرسل تقرير سنوي إلى اللجنة المصرفية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2012-11-28/03-12#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2012-11-28/03-12#art_23_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2012-11-28/03-12#version_art_23_20121128_OpEnact_cf7e92e764> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2012-11-28/03-12#art_23_obligation_0_12ff969b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:introducedOn "2012-11-28"^^xsd:date ;
    dzdoc:number "المادة 23" ;
    dzdoc:position 22 ;
    dzdoc:usesTerm dzterm:auditors,
        dzterm:banking_commission,
        dzterm:banks,
        dzterm:financial_institutions,
        dzterm:money_laundering,
        dzterm:postal_financial_services,
        dzterm:terrorism_financing .

<https://legal.dz/resource/law/2012-11-28/03-12#art_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2012-11-28/03-12#chp_12> ;
    dzdoc:eId "art_27" ;
    dzdoc:fullText "تصدر اللجنة المصرفية و بنك الجزائر ، عند الاقتضاء، خطوطا توجيهية ويضمنان عودة المعلومة من أجل تطبيق الإجراءات الوطنية في مجال الوقاية ومكافحة تبييض الأموال و تمويل الإرهاب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2012-11-28/03-12#version_art_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2012-11-28/03-12#art_27_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2012-11-28/03-12#version_art_27_20121128_OpEnact_311503f703> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2012-11-28/03-12#art_27_obligation_0_e910f0d0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:introducedOn "2012-11-28"^^xsd:date ;
    dzdoc:number "المادة 27" ;
    dzdoc:position 26 ;
    dzdoc:usesTerm dzterm:bank_of_algeria,
        dzterm:banking_commission,
        dzterm:money_laundering,
        dzterm:terrorism_financing .

<https://legal.dz/resource/law/2012-11-28/03-12#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2012-11-28/03-12#chp_12> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "تلغى أحكام النظام رقم 05-05 المؤرخ في 13 ذي القعدة عام 1426 الموافق 15 ديسمبر سنة 2005 والمتعلق بالوقاية من تبييض الأموال وتمويل الإرهاب ومكافحتهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2012-11-28/03-12#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2012-11-28/03-12#art_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2012-11-28/03-12#version_art_28_20121128_OpEnact_ccabfdb361> ;
