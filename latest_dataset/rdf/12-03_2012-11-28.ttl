    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2012-11-28/03-12#version_art_11> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر اتخاذ الإجراءات المناسبة، قصد الوقاية من خطر استعمال، لأغراض تبييض الأموال أو تمويل الإرهاب التكنولوجيات الجديدة أو قيد التطوير، ذات الصلة بمنتوجات أو تعاملات تجارية أو آليات توزيع ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2012-11-28/03-12#version_art_11_20121128_OpEnact_abf118e91f> ;
    dzdoc:replacementText "يجب على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر اتخاذ الإجراءات المناسبة، قصد الوقاية من خطر استعمال، لأغراض تبييض الأموال أو تمويل الإرهاب التكنولوجيات الجديدة أو قيد التطوير، ذات الصلة بمنتوجات أو تعاملات تجارية أو آليات توزيع ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2012-11-28/03-12#art_11> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2012-11-28/03-12#art_11> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2012-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2012-11-28/03-12#version_art_12> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تخضع المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر قانونا لـ واجب الإخطار بالشبهة في الشكل التنظيمي و يجب عليها أن تطالب وصل الاستلام . يجب على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر تأجيل تنفيذ كل عملية تتعلق بأموال تبدو أنها متأتية من مخالفة أو يشتبه أنها موجهة لـ تبييض الأموال و/أو تمويل الإرهاب والإبلاغ عنها إلى خلية معالجة الاستعلام المالي . يتعين الإخطار بالشبهة بمجرد وجودها حتى ولو تعذر تأجيل تلك العمليات أو بعد إنجازها . يجب الإبلاغ عن كل معلومات تؤدي إلى"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2012-11-28/03-12#version_art_12_20121128_OpEnact_da40f5c828> ;
    dzdoc:replacementText "تخضع المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر قانونا لـ واجب الإخطار بالشبهة في الشكل التنظيمي و يجب عليها أن تطالب وصل الاستلام . يجب على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر تأجيل تنفيذ كل عملية تتعلق بأموال تبدو أنها متأتية من مخالفة أو يشتبه أنها موجهة لـ تبييض الأموال و/أو تمويل الإرهاب والإبلاغ عنها إلى خلية معالجة الاستعلام المالي . يتعين الإخطار بالشبهة بمجرد وجودها حتى ولو تعذر تأجيل تلك العمليات أو بعد إنجازها . يجب الإبلاغ عن كل معلومات تؤدي إلى تأكيد الشبهة أو نفيها دون تأخير إلى خلية معالجة الاستعلام المالي . يجب أن يتم الإبلاغ بالشبهة وفق النموذج التنظيمي . يجب على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر أن تتقيد بالتدابير التحفظية المنصوص عليها في المادة 18 من القانون رقم 05-01 المؤرخ في 6 فبراير سنة 2005 والمتعلق بالوقاية من تبييض الأموال وتمويل الإرهاب ومكافحتهما المعدل والمتمم ، كما يجب السهر على تطبيقها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2012-11-28/03-12#art_12> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2012-11-28/03-12#art_12> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2012-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2012-11-28/03-12#version_art_13> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب استفسار إجراءات الإخطار بالعمليات المشتبه فيها بصفة واضحة كتابيا من كل مصرف و مؤسسة مالية و المصالح المالية لبريد الجزائر ويتم الإبلاغ عنها المستخدميها . ويجب أن تحدد هذه الإجراءات الداخلية أيضا شروط الإخطار بالشبهة إلى خلية معالجة الاستعلام المالي ."@ar ;
    dzdoc:isAuthoritative true ;
