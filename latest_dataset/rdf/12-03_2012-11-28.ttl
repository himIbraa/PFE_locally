<https://legal.dz/resource/law/2012-11-28/03-12#version_art_19> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر أن تعين على الأقل إطارا ساميا مسؤولا على المطابقة في مجال مكافحة تبييض الأموال و تمويل الإرهاب ، بصفته مراسلا لـ خلية معالجة الاستعلام المالي ويكلف بالسهر على التقيد بسياساتها وإجراءاتها المطبقة في مجال مكافحة تبييض الأموال و تمويل الإرهاب . يجب على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر أن تتأكد من إبلاغ هذه الإجراءات إلى جميع المستخدمين وبأنها تسمح لكل عون أن يبلغ بإخطار المسؤول بالمطابقة في مجال مكافحة تبيي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2012-11-28/03-12#version_art_19_20121128_OpEnact_eb85c36c70> ;
    dzdoc:replacementText "يجب على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر أن تعين على الأقل إطارا ساميا مسؤولا على المطابقة في مجال مكافحة تبييض الأموال و تمويل الإرهاب ، بصفته مراسلا لـ خلية معالجة الاستعلام المالي ويكلف بالسهر على التقيد بسياساتها وإجراءاتها المطبقة في مجال مكافحة تبييض الأموال و تمويل الإرهاب . يجب على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر أن تتأكد من إبلاغ هذه الإجراءات إلى جميع المستخدمين وبأنها تسمح لكل عون أن يبلغ بإخطار المسؤول بالمطابقة في مجال مكافحة تبييض الأموال و تمويل الإرهاب بأي عملية محل شبهة و يتم تحرير تقرير سنوي يرسل إلى اللجنة المصرفية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2012-11-28/03-12#art_19> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2012-11-28/03-12#art_19> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2012-11-28"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2012-11-28/03-12#version_art_2> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2012-11-28/03-12> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتعين على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر ، لتفادي التعرض إلى خاطر مرتبطة بزبائنها وأطرافها المقابلة السهر على وجود معايير داخلية \"معرفة الزبائن\" ومطابقتها باستمرار . تتعدى تدابير الحماية المتعلقة بمعرفة الزبائن نطاق عملية عادية لفتح حساب ومسكه. و تستلزم من المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر واجب الرعاية الصارمة فيما يخص الحسابات والعمليات التي قد تشكل خطرا ومراقبة حذرة للنشاطات والعمليات التي قد تكون محل شبهة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2012-11-28/03-12#version_art_2_20121128_OpEnact_4475323e8c> ;
    dzdoc:replacementText "يتعين على المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر ، لتفادي التعرض إلى خاطر مرتبطة بزبائنها وأطرافها المقابلة السهر على وجود معايير داخلية \"معرفة الزبائن\" ومطابقتها باستمرار . تتعدى تدابير الحماية المتعلقة بمعرفة الزبائن نطاق عملية عادية لفتح حساب ومسكه. و تستلزم من المصارف و المؤسسات المالية و المصالح المالية لبريد الجزائر واجب الرعاية الصارمة فيما يخص الحسابات والعمليات التي قد تشكل خطرا ومراقبة حذرة للنشاطات والعمليات التي قد تكون محل شبهة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
