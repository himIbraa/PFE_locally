    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يراعي في قسمة التركات أحكام المادتين 109 و 173 من هذا القانون وما ورد في القانون المدني فيما يتعلق ب الملكية الشائعة . وفي حالة وجود قاصر بين الورثة يجب أن تكون القسمة عن طريق القضاء ."@ar ;
