<https://legal.dz/resource/law/1984-06-09/84-11#art_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_27" ;
    dzdoc:fullText "يحرم من الرضاع ما يحرم من النسب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_27_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_27_19840609_OpEnact_be116db613> ;
