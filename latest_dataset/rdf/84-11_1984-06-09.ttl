<https://legal.dz/resource/law/1984-06-09/84-11#version_art_73> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وقع النزاع بين الزوجين أو ورثتهما في متاع البيت وليس لأحدهما بينة فالقول للزوجة أو ورثتها مع اليمين في المعتاد للنساء والقول للزوج أو ورثته مع اليمين في المعتاد للرجال. والمشتركات بينهما يتقسمانها مع اليمين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_73_19840609_OpEnact_b39e3b5f5c> ;
