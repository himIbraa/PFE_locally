<https://legal.dz/resource/law/1984-06-09/84-11#version_art_36> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على الزوجين : المحافظة على الروابط الزوجية وواجبات الحياة المشتركة، المعاشرة بالمعروف، وتبادل الاحترام والمودة والرحمة، التعاون على مصلحة الأسرة ورعاية الأولاد وحسن تربيتهم، التشاور في تسيير شؤون الأسرة وتباعد الولادات، حسن معاملة كل منهما لأبوي الآخر وأقاربه واحترامهم وزيارتهم، المحافظة على روابط القرابة والتعامل مع الوالدين الأقربين بالحسنى والمعروف، زيارة كل منهما لأبويه وأقاربه واستضافتهم بالمعروف."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_36_19840609_OpEnact_cd52d3317c> ;
    dzdoc:replacementText "يجب على الزوجين : المحافظة على الروابط الزوجية وواجبات الحياة المشتركة، المعاشرة بالمعروف، وتبادل الاحترام والمودة والرحمة، التعاون على مصلحة الأسرة ورعاية الأولاد وحسن تربيتهم، التشاور في تسيير شؤون الأسرة وتباعد الولادات، حسن معاملة كل منهما لأبوي الآخر وأقاربه واحترامهم وزيارتهم، المحافظة على روابط القرابة والتعامل مع الوالدين الأقربين بالحسنى والمعروف، زيارة كل منهما لأبويه وأقاربه واستضافتهم بالمعروف."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_36> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_36> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:targetScope "whole_article" ;
