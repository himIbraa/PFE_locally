<https://legal.dz/resource/law/1984-06-09/84-11#version_art_158> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا اجتمع الجد العاصب مع الإخوة الأشقاء ، أو مع الإخوة للأب ذكورا أو إناثا أو مختلطين فله الأفضل من جميع ثلث المال أو المقاسمة . وإذا اجتمع مع الإخوة و ذوي الفروض فله الأفضل من : سدس جميع المال، أو ثلث ما بقى بعد ذوي الفروض ، أو مقاسمة الإخوة كذكر منهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_158_19840609_OpEnact_98290af0b9> ;
