dzterm:marriage a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الزواج"@ar,
        "الزواج هو عقد رضائي يتم بين رجل وامرأة على الوجه الشرعي، من أهدافه، تكوين أسرة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_4_defocc_8d83aacd87ee>,
        <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_4_defocc_ed62c22c50ec> .

dzterm:mother a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "أم"@ar,
        "الأم"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_101> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_5> ;
    dzdoc:eId "art_101" ;
    dzdoc:fullText "من بلغ سن الرشد وهو مجنون، أو معتوه، أو سفيه، أو طرأت عليه إحدى الحالات المذكورة بعد رشده يحجر عليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_101> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_101_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_101_19840609_OpEnact_6bd4f66431> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_101_obligation_0_f0490341> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "101" ;
    dzdoc:position 108 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_101_condition_0_c22a5373> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_103> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_5> ;
    dzdoc:eId "art_103" ;
    dzdoc:fullText "يجب أن يكون الحجر بحكم وللقاضي أن يستعين بأهل الخبرة في إثبات أسباب الحجر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_103> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_103_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_103_19840609_OpEnact_e87d349184> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_103_obligation_0_4ed2b4f7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "103" ;
    dzdoc:position 110 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_106> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_5> ;
    dzdoc:eId "art_106" ;
    dzdoc:fullText "الحكم بالحجر قابل لكل طرق الطعن و يجب نشره للإعلام ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_106> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_106_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_106_19840609_OpEnact_4d271c9265> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_106_obligation_0_f1b2c007> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "106" ;
    dzdoc:position 113 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_111> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_6> ;
    dzdoc:eId "art_111" ;
    dzdoc:fullText "على القاضي عندما يحكم بالفقيد أن يحصر أموال المفقود وأن يعين في حكمه مقدما من الأقارب أو غيرهم لتسيير أموال المفقود ويتسلم ما استحقه من ميراث أو تبرع مع مراعاة أحكام المادة (99) من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_111> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_111_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_111_19840609_OpEnact_d174293f32> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_111_obligation_0_7c84502f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "111" ;
    dzdoc:position 118 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_99> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_99> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_115> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_6> ;
    dzdoc:eId "art_115" ;
    dzdoc:fullText "لا يورث المفقود ولا تقسم أمواله إلا بعد صدور الحكم بموته ، و في حالة رجوعه أو ظهوره حيا يسترجع ما بقى عينا من أمواله أو قيمة ما بيع منها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_115_right_0_baad9d3e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_115> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_115_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_115_19840609_OpEnact_b7a2c438de> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_115_obligation_0_42806ed4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "115" ;
    dzdoc:position 122 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_117> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_7> ;
    dzdoc:eId "art_117" ;
    dzdoc:fullText "المادة 117 : يجب أن تكون الكفالة أمام المحكمة أو أمام الموثق وأن تتم برضا من له أبوان."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_117> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_117_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_117_19840609_OpEnact_6889ddb96c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_117_obligation_0_cd6b94f8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "117" ;
    dzdoc:position 124 ;
    dzdoc:usesTerm dzterm:kafala .

<https://legal.dz/resource/law/1984-06-09/84-11#art_118> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_7> ;
    dzdoc:eId "art_118" ;
    dzdoc:fullText "المادة 118 : يشترط أن يكون الكافل مسلما، عاقلا أهلا للقيام بشؤون المكفول وقادرا على رعايته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_118> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_118_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_118_19840609_OpEnact_93c6bb5e30> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "118" ;
    dzdoc:position 125 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_118_condition_0_fad4afea> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_124> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_7> ;
    dzdoc:eId "art_124" ;
    dzdoc:fullText "المادة 124 : إذا طلب الأبوان أو أحدهما عودة الولد المكفول إلى ولايتهما يخير الولد في الالتحاق بهما إذا بلغ سن التمييز وإن لم يكن مميزا لا يسلم إلا بإذن من القاضي مع مراعاة مصلحة المكفول."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_124> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_124_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_124_19840609_OpEnact_4728ed7634> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "124" ;
    dzdoc:position 131 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_124_condition_0_dde6defd>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_124_condition_1_df39be5e> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_125> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_7> ;
    dzdoc:eId "art_125" ;
    dzdoc:fullText "المادة 125 : التخلي عن الكفالة يتم أمام الجهة التي أقرت الكفالة ، وأن يكون بعلم النيابة العامة وفي حالة الوفاة تنتقل الكفالة إلى الورثة إن التزموا بذلك وإلا فعلى القاضي أن يسند أمر القاصر إلى الجهة المختصة بالرعاية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_125> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_125_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_125_19840609_OpEnact_1a26e8bdd8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_125_obligation_0_d69665e2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "125" ;
    dzdoc:position 132 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_125_condition_0_2f8ce397> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_132> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_1> ;
    dzdoc:eId "art_132" ;
    dzdoc:fullText "إذا توفي أحد الزوجين قبل صدور الحكم بالطلاق أو كانت الوفاة في عدة الطلاق ، استحق الحي منهما الإرث ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_132_right_0_6f18ad75> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_132> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_132_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_132_19840609_OpEnact_f9c7d30b6b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "132" ;
    dzdoc:position 139 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_132_condition_0_c0675b7f> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_134> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_1> ;
    dzdoc:eId "art_134" ;
    dzdoc:fullText "لا يرث الحمل إلا إذا ولد حيا ، ويعتبر حيا إذا استهل صارخا أو بدت منه علامة ظاهرة بالحياة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_134> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_134_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_134_19840609_OpEnact_52988f8a6b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "134" ;
    dzdoc:position 141 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_134_condition_0_086e00c3>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_134_condition_1_87b448cc> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_145> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_2> ;
    dzdoc:eId "art_145" ;
    dzdoc:fullText "أصحاب الربع اثنان وهما : 1- الزوج عند وجود الفرع الوارث لزوجته ، 2- الزوجة أو الزوجات بشرط عدم وجود الفرع الوارث للزوج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_145> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_145_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_145_19840609_OpEnact_7271a71a95> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 145" ;
    dzdoc:position 152 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_145_condition_0_04b09efc>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_145_condition_1_84c1ce6c> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_159> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:al_hajb ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_5> ;
    dzdoc:eId "art_159" ;
    dzdoc:fullText "الحجب هو منع الوارث من الميراث كلا أو بعضا وهو نوعان : 1- حجب نقصان ، 2- حجب إسقاط . حجب النقصان"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_159> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_159_defocc_0ada13bebd5f> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_159_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_159_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_159_19840609_OpEnact_5047c32b93> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "159" ;
    dzdoc:position 166 ;
    dzdoc:usesTerm dzterm:hajb_isqat,
        dzterm:hajb_nuqsan .

<https://legal.dz/resource/law/1984-06-09/84-11#art_164> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_5> ;
    dzdoc:eId "art_164" ;
    dzdoc:fullText "يحجب كل من الأب و الابن و ابن الابن وان نزل، الأخت الشقيقة و يحجب الأخت لأب كل من الأب ، و الابن ، و ابن الابن وان نزل، و الأخ الشقيق و الأخت الشقيقة إذا كانت عاصبة مع غيرها ، والأختين الشقيقتين، إذا لم يوجد أخ للأب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_164> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_164_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_164_19840609_OpEnact_fc1cecb92f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_164_obligation_0_419731ed>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_164_obligation_1_9891a776> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "164" ;
    dzdoc:position 171 ;
    dzdoc:usesTerm dzterm:father,
        dzterm:full_brother,
        dzterm:full_sister,
        dzterm:grandson,
        dzterm:paternal_sister,
        dzterm:son .

<https://legal.dz/resource/law/1984-06-09/84-11#art_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_17" ;
    dzdoc:fullText "في حالة النزاع في الصداق بين الزوجين أو ورثتهما وليس لأحدهما بينة وكان قبل الدخول ، فالقول للزوجة أو ورثتها مع اليمين و إذا كان بعد البناء فالقول للزوج أو ورثته مع اليمين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_17> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_17_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_17_19840609_OpEnact_8d773c1c6a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "17" ;
    dzdoc:position 21 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_17_condition_0_103350df>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_17_condition_1_d33998fc> ;
    dzdoc:usesTerm dzterm:dower,
        dzterm:husband,
        dzterm:wife .

<https://legal.dz/resource/law/1984-06-09/84-11#art_170> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_7> ;
    dzdoc:eId "art_170" ;
    dzdoc:fullText "أسهم الأحفاد تكون بمقدار حصة أصلهم لو بقي حيا على أن لا يتجاوز ذلك ثلث التركة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_170> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_170_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_170_19840609_OpEnact_c35b5ed7b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "170" ;
    dzdoc:position 177 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_170_condition_0_4319c9c6>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_170_condition_1_6c2a1ce0> ;
    dzdoc:usesTerm dzterm:estate,
        dzterm:grandchildren .

<https://legal.dz/resource/law/1984-06-09/84-11#art_171> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_7> ;
    dzdoc:eId "art_171" ;
    dzdoc:fullText "لا يستحق هؤلاء الأحفاد التنزيل إن كانوا وارثين للأصل جدا كان أو جدة أو كان قد أوصى لهم، أو أعطاهم في حياته بلا عوض مقدار ما يستحق بهذه الوصية ، فان أوصى لهم أو لأحدهم بأقل من ذلك وجب التنزيل بمقدار ما يتم به نصيبهم أو نصيب أحدهم من التركة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_171> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_171_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_171_19840609_OpEnact_8b8672bc71> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_171_obligation_0_b615d63a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "171" ;
    dzdoc:position 178 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_171_condition_0_fb6c0891> ;
    dzdoc:usesTerm dzterm:estate,
        dzterm:grandchildren .

<https://legal.dz/resource/law/1984-06-09/84-11#art_172> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_7> ;
    dzdoc:eId "art_172" ;
    dzdoc:fullText "أن لا يكون الأحفاد قد ورثوا من أبيهم أو أمهم ما لا يقل عن مناب مورثهم من أبيه أو أمه . ويكون هذا التنزيل للذكر مثل حظ الأنثيين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_172> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_172_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_172_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_172_19840609_OpEnact_3e1d6018e7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "172" ;
    dzdoc:position 179 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_172_condition_0_5cfcb156> ;
    dzdoc:usesTerm dzterm:grandchildren .

<https://legal.dz/resource/law/1984-06-09/84-11#art_176> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:mushtaraka ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_9> ;
    dzdoc:eId "art_176" ;
    dzdoc:fullText "يأخذ الذكر من الإخوة كالأنثى في المشتركة ، وهي زوج و أم أو جدة و إخوة لأم ، و إخوة أشقاء ، فيشتركان في الثلث الإخوة للأم و الإخوة الأشقاء الذكور والإناث في ذلك سواء على عدد رؤوسهم لأن جميعهم من أم واحدة. مسألة الغراوين"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_176> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_176_defocc_53463d3441f5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_176_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_176_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_176_19840609_OpEnact_ec699ef98b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "176" ;
    dzdoc:position 183 ;
    dzdoc:usesTerm dzterm:brothers,
        dzterm:brothers_full,
        dzterm:brothers_maternal,
        dzterm:grandmother,
        dzterm:husband,
        dzterm:mother .

<https://legal.dz/resource/law/1984-06-09/84-11#art_178> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_9> ;
    dzdoc:eId "art_178" ;
    dzdoc:fullText "إذا اجتمع زوج ، و أم ، و أخت شقيقة أو لأب كان للزوج النصف، وللأخت النصف وللأم الثلث أصلها من ستة وتعول إلى ثمانية للزوج ثلاثة، وللأخت ثلاثة وللأم اثنان. مسألة المنبرية"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_178> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_178_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_178_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_178_19840609_OpEnact_2145bcb7e9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "178" ;
    dzdoc:position 185 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_178_condition_0_9f632c3b> ;
    dzdoc:usesTerm dzterm:husband,
        dzterm:mother,
        dzterm:sister,
        dzterm:sister_paternal .

<https://legal.dz/resource/law/1984-06-09/84-11#art_183> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_10> ;
    dzdoc:eId "art_183" ;
    dzdoc:fullText "يجب أن تتبع الإجراءات المستعجلة في قسمة التركات فيما يتعلق بالمواعيد وسر موضوعها، وطرق الطعن في أحكامها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_183> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_183_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_183_19840609_OpEnact_d9fb04fe58> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_183_obligation_0_8269a2f8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 183" ;
    dzdoc:position 190 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_185> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_185" ;
    dzdoc:fullText "تكون الوصية في حدود ثلث التركة، وما زاد على الثلث توقف على إجازة الورثة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_185> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_185_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_185_19840609_OpEnact_f90c3b166e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 185" ;
    dzdoc:position 192 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_185_condition_0_1432b661> ;
    dzdoc:usesTerm dzterm:وصية .

<https://legal.dz/resource/law/1984-06-09/84-11#art_186> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_186" ;
    dzdoc:fullText "يشترط في الموصي أن يكون سليم العقل، بالغا من العمر تسع عشرة (19) سنة على الأقل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_186> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_186_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_186_19840609_OpEnact_c418e7a9bd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 186" ;
    dzdoc:position 193 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_186_condition_0_45f11453> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_19" ;
    dzdoc:fullText "للزوجين أن يشترطا في عقد الزواج أو في عقد رسمي لاحق كل الشروط التي يريانها ضرورية ، ولا سيما شرط عدم تعدد الزوجات و عمل المرأة ، ما لم تتنافى هذه الشروط مع أحكام هذا القانون ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_19_right_0_93574c0f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_19_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_19_19840609_OpEnact_11e5550d9a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "19" ;
    dzdoc:position 23 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_19_condition_0_0dfa0a6c> ;
    dzdoc:usesTerm dzterm:non_polygamy_condition,
        dzterm:womens_work_condition .

<https://legal.dz/resource/law/1984-06-09/84-11#art_191> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_191" ;
    dzdoc:fullText "تثبت الوصية : 1- بتصريح الموصي أمام الموثق وتحرير عقد بذلك، 2- وفي حالة وجود مانع قاهر تثبت الوصية بحكم، ويؤشر به على هامش أصل الملكية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_191> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_191_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_191_19840609_OpEnact_6f1e1b5b7d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 191" ;
    dzdoc:position 198 ;
    dzdoc:usesTerm dzterm:وصية .

<https://legal.dz/resource/law/1984-06-09/84-11#art_198> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_198" ;
    dzdoc:fullText "إذا مات الموصى له قبل القبول فلورثته الحق في القبول أو الرد ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_198_right_0_957501bb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_198> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_198_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_198_19840609_OpEnact_517605c3d4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 198" ;
    dzdoc:position 205 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_198_condition_0_93969bcc> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_199> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_199" ;
    dzdoc:fullText "إذا علقت الوصية على شرط استحقها الموصى له بعد إنجاز الشرط وإذا كان الشرط غير صحت الوصية وبطل الشرط."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_199> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_199_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_199_19840609_OpEnact_7303da66f3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 199" ;
    dzdoc:position 206 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_199_condition_0_c71b5a01> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_204> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_2> ;
    dzdoc:eId "art_204" ;
    dzdoc:fullText "الهبة في مرض الموت، والأمراض والحالات المخيفة، تعتبر وصية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_204> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_204_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_204_19840609_OpEnact_0a367b58a9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 204" ;
    dzdoc:position 211 ;
    dzdoc:usesTerm dzterm:gift .

<https://legal.dz/resource/law/1984-06-09/84-11#art_207> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_2> ;
    dzdoc:eId "art_207" ;
    dzdoc:fullText "إذا كان الشيء الموهب بيد الموهوب له قبل الهبة يعتبر حيازة و إذا كان بيد الغير وجب إخباره بها ليعتبر حائزا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_207> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_207_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_207_19840609_OpEnact_be82030d0b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 207" ;
    dzdoc:position 214 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_207_condition_0_48e1ecee>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_207_condition_1_90372b87> ;
    dzdoc:usesTerm dzterm:donee .

<https://legal.dz/resource/law/1984-06-09/84-11#art_210> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_2> ;
    dzdoc:eId "art_210" ;
    dzdoc:fullText "يحوز الموهوب له الشيء بنفسه أو بوكيله. وإذا كان قاصرا ، أو محجورا عليه يتولى الحيازة من ينوب عنه قانونا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_210> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_210_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_210_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_210_19840609_OpEnact_b29deb6962> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 210" ;
    dzdoc:position 217 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_210_condition_0_f57ab7ae> ;
    dzdoc:usesTerm dzterm:donee .

<https://legal.dz/resource/law/1984-06-09/84-11#art_216> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_3> ;
    dzdoc:eId "art_216" ;
    dzdoc:fullText "يجب أن يكون المال المحبس مملوكا للواقف معينا، خاليا من النزاع، ولو كان مشاعا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_216> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_216_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_216_19840609_OpEnact_8383ed020a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_216_obligation_0_50015fb8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "216" ;
    dzdoc:position 223 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_220> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_3> ;
    dzdoc:eId "art_220" ;
    dzdoc:fullText "يبقى الحبس قائما مهما طرأ على الشيء المحبس تغيير في طبيعته. وإذا نتج عن التغيير تعويض ينزل منزلة الحبس."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_220> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_220_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_220_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_220_19840609_OpEnact_a9594e369e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "220" ;
    dzdoc:position 227 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_220_condition_0_486b0da8> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_221> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_4> ;
    dzdoc:eId "art_221" ;
    dzdoc:fullText "يطبق هذا القانون على كل المواطنين الجزائريين وعلى غيرهم من المقيمين بالجزائر مع مراعاة الأحكام الواردة في القانون المدني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_221> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_221_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_221_19840609_OpEnact_09eef714ec> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_221_obligation_0_f657a3c5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 221" ;
    dzdoc:position 228 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1984-06-09/84-11#art_221_extref_b3b6a52d> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_224> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_4> ;
    dzdoc:eId "art_224" ;
    dzdoc:fullText "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 9 رمضان عام 1404 الموافق 9 يونيو سنة 1984. الشاذلي بن جديد"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_224> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_224_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_224_para_1>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_224_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_224_19840609_OpEnact_94e7311825> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 224" ;
    dzdoc:position 231 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "يجب أن يكون كل من الزوجين خلوا من الموانع الشرعية المؤبدة والمؤقتة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_23_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_23_19840609_OpEnact_b7112495a7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_23_obligation_0_33f1ff89> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "23" ;
    dzdoc:position 27 ;
    dzdoc:usesTerm dzterm:impediments .

<https://legal.dz/resource/law/1984-06-09/84-11#art_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:temporary_prohibitions ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_30" ;
    dzdoc:fullText "يحرم من النساء مؤقتا : المحصنة، المعتدة من طلاق أو وفاة، المطلقة ثلاثا، كما يحرم مؤقتا الجمع بين الأختين أو بين المرأة وعمتها أو خالتها، سواء كانت شقيقة أو لأب أو لأم أو من رضاع، زواج المسلمة مع غير المسلم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_30> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_30_defocc_d0ce3a702954> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_30_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_30_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_30_19840609_OpEnact_946638692c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "30" ;
    dzdoc:position 34 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_35> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_3> ;
    dzdoc:eId "art_35" ;
    dzdoc:fullText "إذا اقترن عقد الزواج بشرط ينافيه كان ذلك الشرط باطلا والعقد صحيحا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_35> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_35_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_35_19840609_OpEnact_eab51aa878> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_35_obligation_0_969d5237> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "35" ;
    dzdoc:position 39 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_35_condition_0_c27c83ed> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_41> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_5> ;
    dzdoc:eId "art_41" ;
    dzdoc:fullText "ينسب الولد لأبيه متى كان الزواج شرعيا وأمكن الاتصال ولم ينفه بالطرق المشروعة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_41> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_41_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_41_19840609_OpEnact_c8e4e00f50> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_41_obligation_0_bab06ecc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "41" ;
    dzdoc:position 45 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_41_condition_0_53d9ad09> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_5> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "يثبت النسب بالإقرار بالبنوة، أو الأبوة أو الأمومة، لمجهول النسب ولو في مرض الموت متى صدقه العقل أو العادة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_44_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_44_19840609_OpEnact_20f1aba52c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_44_obligation_0_d63d16c6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "44" ;
    dzdoc:position 48 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_44_condition_0_8309e431> ;
    dzdoc:usesTerm dzterm:lineage .

<https://legal.dz/resource/law/1984-06-09/84-11#art_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_5> ;
    dzdoc:eId "art_45" ;
    dzdoc:fullText "الإقرار بالنسب في غير البنوة، والأبوة، والأمومة لا يسري على غير المقر إلا بتصديقه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_45> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_45_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_45_19840609_OpEnact_d8f63a3c9f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_45_obligation_0_d94bc83e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "45" ;
    dzdoc:position 49 ;
    dzdoc:usesTerm dzterm:lineage .

<https://legal.dz/resource/law/1984-06-09/84-11#art_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_52" ;
    dzdoc:fullText "إذا تبين للقاضي تعسف الزوج في الطلاق حكم للمطلقة بالتعويض عن الضرر اللاحق بها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_52_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_52_19840609_OpEnact_96d096e2e6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_52_obligation_0_80b7ae96> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "52" ;
    dzdoc:position 57 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_52_condition_0_c96fe33d> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_53_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_53_bis" ;
    dzdoc:fullText "يجوز للقاضي في حالة الحكم بالتطليق أن يحكم للمطلقة بالتعويض عن الضرر اللاحق بها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_53_bis_permission_0_5e32213f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_53_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_53_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_53_bis_19840609_OpEnact_8f56dc64db> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "53 مكرر" ;
    dzdoc:position 59 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_55> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_55" ;
    dzdoc:fullText "عند نشوز أحد الزوجين يحكم القاضي بالطلاق وبالتعويض للطرف المتضرر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_55> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_55_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_55_19840609_OpEnact_7da274bba2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_55_obligation_0_32200b06> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "55" ;
    dzdoc:position 61 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_55_condition_0_67312220> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "إن اقتران الفاتحة بالخطبة لا يعد زواجا. غير أن اقتران الفاتحة بالخطبة بمجلس العقد يعتبر زواجا متى توافر ركن الرضا وشروط الزواج المنصوص عليها في المادة 9 مكرر من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_6_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_6_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_6_19840609_OpEnact_81bb6b400f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "6" ;
    dzdoc:position 6 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_9_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_9_bis> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_6_condition_0_477a421a> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "الأم أولى بحضانة ولدها، ثم الأب ، ثم الجدة لأم، ثم الجدة لأب، ثم الخالة، ثم العمة، ثم الأقربون درجة مع مراعاة مصلحة المحضون في كل ذلك، و على القاضي عندما يحكم بإسناد الحضانة أن يحكم بحق الزيارة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_64_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_64_19840609_OpEnact_31b735a62f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_64_obligation_0_92abcd83> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 64" ;
    dzdoc:position 71 ;
    dzdoc:usesTerm dzterm:father,
        dzterm:mother .

<https://legal.dz/resource/law/1984-06-09/84-11#art_73> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_73" ;
    dzdoc:fullText "إذا وقع النزاع بين الزوجين أو ورثتهما في متاع البيت وليس لأحدهما بينة فالقول للزوجة أو ورثتها مع اليمين في المعتاد للنساء والقول للزوج أو ورثته مع اليمين في المعتاد للرجال. والمشتركات بينهما يتقسمانها مع اليمين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_73> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_73_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_73_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_73_19840609_OpEnact_b39e3b5f5c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "73" ;
    dzdoc:position 80 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_73_condition_0_424fd876> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_3> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "تجب نفقة الأصول على الفروع والفروع على الأصول حسب القدرة والاحتياج ودرجة القرابة في الإرث."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_77_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_77_19840609_OpEnact_3a2018d72a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_77_obligation_0_9c63d124> ;
