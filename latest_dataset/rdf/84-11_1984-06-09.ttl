<https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_6_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_6> ;
    dzdoc:position 0 ;
    dzdoc:text "إن اقتران الفاتحة بالخطبة لا يعد زواجا."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_6_para_1> a dzdoc:Paragraph ;
