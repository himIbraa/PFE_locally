<https://legal.dz/resource/law/1984-06-09/84-11#art_212> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_2> ;
    dzdoc:eId "art_212" ;
    dzdoc:fullText "الهبة بقصد المنفعة العامة لا رجوع فيها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_212> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_212_para_0> ;
