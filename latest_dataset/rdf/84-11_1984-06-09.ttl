<https://legal.dz/resource/law/1984-06-09/84-11#version_art_67> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسقط الحضانة باختلال أحد الشروط المنصوص عليها في المادة 62 أعلاه. ولا يمكن لعمل المرأة أن يشكل سببا من أسباب سقوط الحق عنها في ممارسة الحضانة. غير أنه يجب في جميع الحالات مراعاة مصلحة المحضون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_67_19840609_OpEnact_c1593dd322> ;
    dzdoc:replacementText "تسقط الحضانة باختلال أحد الشروط المنصوص عليها في المادة 62 أعلاه. ولا يمكن لعمل المرأة أن يشكل سببا من أسباب سقوط الحق عنها في ممارسة الحضانة. غير أنه يجب في جميع الحالات مراعاة مصلحة المحضون ."@ar ;
