    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "119" ;
    dzdoc:position 126 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_12> a dzdoc:Article ;
