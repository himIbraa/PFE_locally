<https://legal.dz/resource/law/1984-06-09/84-11#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "يسمح بالزواج بأكثر من زوجة واحدة في حدود الشريعة الإسلامية متى وجد المبرر الشرعي وتوفرت شروط ونية العدل . يجب على الزوج إخبار الزوجة السابقة والمرأة التي يقبل على الزواج بها وأن يقدم طلب الترخيص بالزواج إلى رئيس المحكمة لمكان مسكن الزوجية . يمكن رئيس المحكمة أن يرخص بالزواج الجديد، إذا تأكد من موافقتهما وأثبت الزوج المبرر الشرعي وقدرته على توفير العدل والشروط الضرورية للحياة الزوجية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_8_permission_0_2ace9dc7>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_8_permission_1_237d1159> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_8_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_8_para_1>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_8_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
