<https://legal.dz/resource/law/1984-06-09/84-11#art_83_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_83> ;
    dzdoc:position 0 ;
    dzdoc:text "من بلغ سن التمييز ولم يبلغ سن الرشد طبقا لالمادة (43) من القانون المدني تكون تصرفاته نافذة إذا كانت نافعة له، وباطلة إذا كانت ضارة به وتتوقف على إجازة الولي أو الوصي فيما إذا كانت مترددة بين النفع والضرر، وفي حالة النزاع يرفع الأمر للقضاء."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_84_condition_0_8be6a682> a dznorm:Condition ;
