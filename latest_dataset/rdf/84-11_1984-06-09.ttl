    dzdoc:hasAction <https://legal.dz/resource/law/1984-06-09/84-11#art_13_prohibition_0_c6f750ad_action_3d97bc4229>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_13_prohibition_0_c6f750ad_action_cc2362c413> ;
