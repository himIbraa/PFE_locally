    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تصح الوصية مع اختلاف الدين."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_201_19840609_OpEnact_a39ce1803c> a dzdoc:ArticleVersion ;
