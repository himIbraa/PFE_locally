    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يمنع من الميراث الأشخاص الآتية أوصافهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_135> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_135_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_135> ;
    dzdoc:position 0 ;
    dzdoc:text "يمنع من الميراث الأشخاص الآتية أوصافهم : 1- قاتل المورث عمدا أو عدوانا سواء كان القاتل فاعلا أصليا أو شريكا، 2- شاهد الزور الذي أدت شهادته إلى الحكم بالإعدام وتنفيذه، 3- العالم بالقتل أو تدبيره إذا لم يخبر السلطات المعنية."@ar .

