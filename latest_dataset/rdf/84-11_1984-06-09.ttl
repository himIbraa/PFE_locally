dzterm:وصية a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوصية"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_184_defocc_6ef1a3aaa786> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_182> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_10> ;
    dzdoc:eId "art_182" ;
    dzdoc:fullText "في حالة عدم وجود ولي أو وصي يجوز لمن له مصلحة أو للنيابة العامة أن يتقدم إلى المحكمة بطلب تصفية التركة وبتعيين مقدم ، و لرئيس المحكمة أن يقرر وضع الأختام، وإيداع النقود والأشياء ذات القيمة، وأن يفصل في الطلب ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_182_permission_0_7b85ac57> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_182_right_0_5a63617f>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_182_right_1_6b25ebb1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_182> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_182_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_182_19840609_OpEnact_1c73f97e84> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 182" ;
    dzdoc:position 189 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_182_condition_0_b5783130> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_205> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_2> ;
    dzdoc:eId "art_205" ;
    dzdoc:fullText "يجوز للواهب أن يهب كل ممتلكاته أو جزءا منها عينا، أو منفعة، أو دينا لدى الغير ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_205_permission_0_170a0c8d> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_205_right_0_41d01471> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_205> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_205_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_205_19840609_OpEnact_470b9f25c9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 205" ;
    dzdoc:position 212 ;
    dzdoc:usesTerm dzterm:donor .

<https://legal.dz/resource/law/1984-06-09/84-11#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_3> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "كل زواج بإحدى المحرمات يفسخ قبل الدخول وبعده ويترتب عليه ثبوت النسب ، و وجوب الاستبراء ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_34_right_0_31f0c5fc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_34_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_34_19840609_OpEnact_61d4384867> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_34_obligation_0_bcd9aecd>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_34_obligation_1_9350da6f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "34" ;
    dzdoc:position 38 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_34_condition_0_5514c1b3> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_5> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "يثبت النسب بالزواج الصحيح أو بالإقرار أو بالبينة أو بنكاح الشبهة أو بكل زواج تم فسخه بعد الدخول طبقا للمواد 32 و 33 و 34 من هذا القانون. يجوز للقاضي اللجوء إلى الطرق العلمية لإثبات النسب ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_40_permission_0_f20dea72> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_40_right_0_a85db1f1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_40_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_40_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_40_19840609_OpEnact_9dacc7a902> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_40_obligation_0_7213b22d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "40" ;
    dzdoc:position 44 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_32>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_33>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_34> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_32>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_33>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_34> ;
    dzdoc:usesTerm dzterm:lineage .

<https://legal.dz/resource/law/1984-06-09/84-11#art_56> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_56" ;
    dzdoc:fullText "إذا اشتد الخصام بين الزوجين ولم يثبت الضرر وجب تعيين حكمين للتوفيق بينهما . يعين القاضي الحكمين، حكما من أهل الزوج وحكما من أهل الزوجة، وعلى هذين الحكمين أن يقدما تقريرا عن مهمتهما في أجل شهرين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_56> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_56_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_56_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_56_19840609_OpEnact_13aeb0d9a7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_56_obligation_0_8f1d77d3>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_56_obligation_1_5410141d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "56" ;
    dzdoc:position 62 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_56_condition_0_e590200b> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_2> ;
    dzdoc:eId "art_87" ;
    dzdoc:fullText "يكون الأب وليا على أولاده القصر، وبعد وفاته تحل الأم محله قانونا. وفي حالة غياب الأب أو حصول مانع له ، تحل الأم محله في القيام بالأمور المستعجلة المتعلقة بالأولاد . وفي حالة الطلاق ، يمنح القاضي الولاية لمن أسندت له حضانة الأولاد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_87> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_87_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_87_para_1>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_87_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_87_19840609_OpEnact_59307e84ef> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_87_obligation_0_c5f6d34b>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_87_obligation_1_5d3b2133> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "87" ;
    dzdoc:position 94 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_87_condition_0_4ba5ade0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_87_condition_1_ccbbbadd> ;
    dzdoc:usesTerm dzterm:father,
        dzterm:mother .

<https://legal.dz/resource/law/1984-06-09/84-11#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_2> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "على الولي أن يتصرف في أموال القاصر تصرف الرجل الحريص ويكون مسؤولا طبقا لمقتضيات القانون العام . وعليه أن يستأذن القاضي في التصرفات التالية : بيع العقار، وقسمته، ورهنه، وإجراء المصالحة، بيع المنقولات ذات الأهمية الخاصة، استثمار أموال القاصر بالإقراض، أو الاقتراض أو المساهمة في شركة، إيجار عقار القاصر لمدة تزيد على ثلاث سنوات أو تمتد لأكثر من سنة بعد بلوغه سن الرشد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_88_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_88_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_88_19840609_OpEnact_40e3222f4f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_88_obligation_0_afa82c70>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_88_obligation_1_160ccd91> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "88" ;
    dzdoc:position 95 .

