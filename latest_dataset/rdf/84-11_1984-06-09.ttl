<https://legal.dz/resource/law/1984-06-09/84-11#art_200> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_200" ;
    dzdoc:fullText "تصح الوصية مع اختلاف الدين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_200> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_200_para_0> ;
