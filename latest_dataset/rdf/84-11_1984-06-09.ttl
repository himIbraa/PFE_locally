    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_92_19840609_OpEnact_bd124d3fb9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "92" ;
    dzdoc:position 99 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_86> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_86> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_92_condition_0_9cd3f65c> ;
    dzdoc:usesTerm dzterm:guardian .

<https://legal.dz/resource/law/1984-06-09/84-11#book_3> a dzdoc:Book ;
