    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان الموجود من العصبة أكثر من واحد واتحدوا في الجهة كان الترجيح بينهم بالدرجة فيقدم أقربهم درجة إلى الميت، و إذا اتحدوا في الجهة والدرجة كان الترجيح بقوة القرابة فمن كان ذا قرابتين قدم على من كان ذا قرابة واحدة، و إذا اتحدوا في الجهة والدرجة والقرابة ورثوا بالتعصيب واشتركوا في المال بالسوية. العاصب بغيره"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_154_19840609_OpEnact_06f4a83300> ;
    dzdoc:replacementText "إذا كان الموجود من العصبة أكثر من واحد واتحدوا في الجهة كان الترجيح بينهم بالدرجة فيقدم أقربهم درجة إلى الميت، و إذا اتحدوا في الجهة والدرجة كان الترجيح بقوة القرابة فمن كان ذا قرابتين قدم على من كان ذا قرابة واحدة، و إذا اتحدوا في الجهة والدرجة والقرابة ورثوا بالتعصيب واشتركوا في المال بالسوية. العاصب بغيره"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_154> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_154> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
