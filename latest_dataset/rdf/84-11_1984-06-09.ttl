<https://legal.dz/resource/law/1984-06-09/84-11#version_art_173> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يوقف من التركة للحمل الأكثر من حظ ابن واحد أو بنت واحدة إذا كان الحمل يشارك الورثة أو يحجبهم حجب نقصان ، فان كان يحجبهم حجب حرمان يوقف الكل ولا تقسم التركة إلى أن تضع الحامل حملها ."@ar ;
