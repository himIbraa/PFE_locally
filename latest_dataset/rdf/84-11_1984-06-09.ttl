    dzdoc:occursInParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_14_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "الصداق هو ما يدفع نحلة للزوجة من نقود أو غيرها من كل ما هو مباح شرعا وهو ملك لها تتصرف فيه كما تشاء."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_14_para_0> a dzdoc:Paragraph ;
