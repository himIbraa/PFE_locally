<https://legal.dz/resource/law/1984-06-09/84-11#art_91> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_2> ;
    dzdoc:eId "art_91" ;
    dzdoc:fullText "تنتهي وظيفة الولي : بعجزه، بموته، بالحجر عليه، بإسقاط الولاية عنه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_91> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_91_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_91_19840609_OpEnact_2e7891607c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "91" ;
    dzdoc:position 98 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_95> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_3> ;
    dzdoc:eId "art_95" ;
    dzdoc:fullText "للـ وصي نفس سلطة الولي في التصرف وفقا لأحكام المواد 88 و 89 و 90 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_95> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_95_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_95_19840609_OpEnact_3d75348300> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "95" ;
    dzdoc:position 102 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_88>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_89>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_90> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_88>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_89>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_90> ;
    dzdoc:usesTerm dzterm:guardian .

<https://legal.dz/resource/law/1984-06-09/84-11#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_3> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "تنتهي مهمة الوصي : 1 - بموت القاصر، أو زوال أهلية الوصي أو موته، 2 - ببلوغ القاصر سن الرشد ما لم يصدر حكم من القضاء بالحجر عليه، 3 - بانتهاء المهام التي أقيم الوصي من أجلها، 4 - بقبول عذره في التخلي عن مهمته، 5 - بعزله بناء على طلب من له مصلحة إذا ثبت من تصرفات الوصي ما يهدد مصلحة القاصر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_96_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_96_19840609_OpEnact_ffe1da5a8b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "96" ;
    dzdoc:position 103 ;
    dzdoc:usesTerm dzterm:guardian .

