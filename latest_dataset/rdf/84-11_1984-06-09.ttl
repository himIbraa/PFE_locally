<https://legal.dz/resource/law/1984-06-09/84-11#art_217> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_3> ;
    dzdoc:eId "art_217" ;
    dzdoc:fullText "يثبت الوقف بما تثبت به الوصية طبقا للمادة 191 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_217> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_217_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_217_19840609_OpEnact_4ec292188f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
