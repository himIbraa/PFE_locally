<https://legal.dz/resource/law/1984-06-09/84-11#version_art_7_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على طالبي الزواج أن يقدما وثيقة طبية، لا يزيد تاريخها عن ثلاثة (3) أشهر تثبت خلوهما من أي مرض أو أي عامل قد يشكل خطرا يتعارض مع الزواج . يتعين على الموثق أو ضابط الحالة المدنية ، أن يتأكد قبل تحرير عقد الزواج من خضوع الطرفين للفحوصات الطبية ومن علمهما بما قد تكشف عنه من أمراض أو عوامل قد يشكل خطرا يتعارض مع الزواج . ويؤشر بذلك في عقد الزواج. تحدد شروط وكيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_7_bis_19840609_OpEnact_e6ac751d57> ;
    dzdoc:replacementText "يجب على طالبي الزواج أن يقدما وثيقة طبية، لا يزيد تاريخها عن ثلاثة (3) أشهر تثبت خلوهما من أي مرض أو أي عامل قد يشكل خطرا يتعارض مع الزواج . يتعين على الموثق أو ضابط الحالة المدنية ، أن يتأكد قبل تحرير عقد الزواج من خضوع الطرفين للفحوصات الطبية ومن علمهما بما قد تكشف عنه من أمراض أو عوامل قد يشكل خطرا يتعارض مع الزواج . ويؤشر بذلك في عقد الزواج. تحدد شروط وكيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_7_bis> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_7_bis> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسمح بالزواج بأكثر من زوجة واحدة في حدود الشريعة الإسلامية متى وجد المبرر الشرعي وتوفرت شروط ونية العدل . يجب على الزوج إخبار الزوجة السابقة والمرأة التي يقبل على الزواج بها وأن يقدم طلب الترخيص بالزواج إلى رئيس المحكمة لمكان مسكن الزوجية . يمكن رئيس المحكمة أن يرخص بالزواج الجديد، إذا تأكد من موافقتهما وأثبت الزوج المبرر الشرعي وقدرته على توفير العدل والشروط الضرورية للحياة الزوجية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_8_19840609_OpEnact_5fb6a8dcdb> ;
    dzdoc:replacementText "يسمح بالزواج بأكثر من زوجة واحدة في حدود الشريعة الإسلامية متى وجد المبرر الشرعي وتوفرت شروط ونية العدل . يجب على الزوج إخبار الزوجة السابقة والمرأة التي يقبل على الزواج بها وأن يقدم طلب الترخيص بالزواج إلى رئيس المحكمة لمكان مسكن الزوجية . يمكن رئيس المحكمة أن يرخص بالزواج الجديد، إذا تأكد من موافقتهما وأثبت الزوج المبرر الشرعي وقدرته على توفير العدل والشروط الضرورية للحياة الزوجية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_8> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
