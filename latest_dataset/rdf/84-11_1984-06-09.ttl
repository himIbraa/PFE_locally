<https://legal.dz/resource/law/1984-06-09/84-11#art_150_defocc_299ec8388092> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 87 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:عاصب ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_150> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_150_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "العاصب هو من يستحق التركة كلها عند إنفراده، أو ما بقى منها بعد أخذ أصحاب الفروض حقوقهم، وان استغرقت الفروض التركة فلا شيء له."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_150_para_0> a dzdoc:Paragraph ;
