    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_205> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_205> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_205> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجوز للواهب أن يهب كل ممتلكاته أو جزءا منها عينا، أو منفعة، أو دينا لدى الغير ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_206_19840609_OpEnact_23955ff89d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_206> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_206> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_206> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تنعقد الهبة بالإيجاب والقبول، وتتم الحيازة، و مراعاة أحكام قانون التوثيق في العقارات والإجراءات الخاصة في المنقولات . وإذا اختل أحد القيود السابقة بطلت الهبة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_207_19840609_OpEnact_be82030d0b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_207> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_207> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_207> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا كان الشيء الموهب بيد الموهوب له قبل الهبة يعتبر حيازة و إذا كان بيد الغير وجب إخباره بها ليعتبر حائزا ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_208_19840609_OpEnact_8b1e33feca> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_208> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_208> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_208> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا كان الواهب ولي الموهوب له ، أو زوجه أو كان الموهوب مشاعا فان التوثيق والإجراءات الإدارية تغنى عن الحيازة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_209_19840609_OpEnact_3193da293d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_209> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_209> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_209> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تصح الهبة للحمل بشرط أن يولد حيا ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_20_19840609_OpEnact_857af0e82a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_20> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_20> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_20> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_210_19840609_OpEnact_b29deb6962> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_210> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_210> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_210> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يحوز الموهوب له الشيء بنفسه أو بوكيله. وإذا كان قاصرا ، أو محجورا عليه يتولى الحيازة من ينوب عنه قانونا ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_211_19840609_OpEnact_63b308c7ba> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_211> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_211> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_211> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "للأبوين حق الرجوع في الهبة لولدهما مهما كانت سنه إلا في الحالات التالية: إذا كانت الهبة من أجل زواج الموهوب له، إذا كانت الهبة لضمان قرض أو قضاء دين، إذا تصرف الموهوب له في الشيء الموهوب ببيع، أو تبرع منه أو أدخل عليه ما غير طبيعته."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_212_19840609_OpEnact_f614de7b1d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_212> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_212> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_212> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الهبة بقصد المنفعة العامة لا رجوع فيها."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_213_19840609_OpEnact_dd1346d3a1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_213> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_213> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_213> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الوقف حبس المال عن التملك لأي شخص على وجه التأبيد والتصدق ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_214_19840609_OpEnact_d79c85a72c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_214> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_214> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_214> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجوز للواقف أن يحتفظ بمنفعة الشيء المحبس مدة حياته ، على أن يكون مآل الوقف بعد ذلك إلى الجهة المعنية ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_215_19840609_OpEnact_9f6f652454> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_215> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_215> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_215> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يشترط في الوقف والموقوف ما يشترط في الواهب والموهوب طبقا للمادتين 204 و 205 من هذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_216_19840609_OpEnact_8383ed020a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_216> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_216> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_216> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجب أن يكون المال المحبس مملوكا للواقف معينا، خاليا من النزاع، ولو كان مشاعا ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_217_19840609_OpEnact_4ec292188f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_217> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_217> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_217> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يثبت الوقف بما تثبت به الوصية طبقا للمادة 191 من هذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_218_19840609_OpEnact_6fb5cb5623> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_218> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_218> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_218> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "ينفذ شرط الواقف ما لم يتناف ومقتضيات الوقف شرعا ، وإلا بطل الشرط وبقي الوقف."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_219_19840609_OpEnact_1e650d22bc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_219> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_219> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_219> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "كل ما أحدثه المحبس عليه من بناء أو غرس في الحبس يعتبر من الشيء المحبس."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_21_19840609_OpEnact_f0fe4661b5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_21> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_21> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_21> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تطبق أحكام قانون الحالة المدنية في إجراءات تسجيل عقد الزواج ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_220_19840609_OpEnact_a9594e369e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_220> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_220> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_220> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يبقى الحبس قائما مهما طرأ على الشيء المحبس تغيير في طبيعته. وإذا نتج عن التغيير تعويض ينزل منزلة الحبس."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_221_19840609_OpEnact_09eef714ec> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_221> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_221> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_221> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يطبق هذا القانون على كل المواطنين الجزائريين وعلى غيرهم من المقيمين بالجزائر مع مراعاة الأحكام الواردة في القانون المدني ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_222_19840609_OpEnact_32e747b5ee> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_222> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_222> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_222> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "كل ما لم يرد النص عليه في هذا القانون يرجع فيه إلى أحكام الشريعة الإسلامية ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_223_19840609_OpEnact_aaf418fb26> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_223> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_223> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_223> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تلغى جميع الأحكام المخالفة لهذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_224_19840609_OpEnact_94e7311825> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_224> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_224> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_224> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 9 رمضان عام 1404 الموافق 9 يونيو سنة 1984. الشاذلي بن جديد"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_22_19840609_OpEnact_a961830553> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_22> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_22> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_22> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يثبت الزواج بمستخرج من سجل الحالة المدنية ، و في حالة عدم تسجيله يثبت بحكم قضائي . يجب تسجيل حكم تثبيت الزواج في الحالة المدنية بسعي من النيابة العامة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_23_19840609_OpEnact_b7112495a7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_23> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_23> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_23> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجب أن يكون كل من الزوجين خلوا من الموانع الشرعية المؤبدة والمؤقتة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_24_19840609_OpEnact_883f660d91> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_24> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_24> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_24> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "موانع النكاح المؤبدة هي : القرابة، المصاهرة، الرضاع."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_25_19840609_OpEnact_15a1ee41f3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_25> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_25> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_25> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المحرمات بالقرابة هي : الأمهات والبنات، والأخوات والعمات والخالات وبنات الأخ ، وبنات الأخت."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_26_19840609_OpEnact_fad858725d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_26> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_26> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_26> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المحرمات بالمصاهرة هي : 1 - أصول الزوجة بمجرد العقد عليها، 2 - فروعها إن حصل الدخول بها، 3 - أرامل أو مطلقات أصول الزوج وإن علوا، 4 - أرامل أو مطلقات فروع الزوج وإن نزلوا."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_27_19840609_OpEnact_be116db613> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_27> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_27> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_27> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يحرم من الرضاع ما يحرم من النسب."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_28_19840609_OpEnact_2aa141929d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_28> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_28> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_28> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يعد الطفل الرضيع وحده دون إخوته وأخواته ولدا للمرضعة وزوجها وأخا لجميع أولادها، ويسري التحريم عليه وعلى فروعه."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_29_19840609_OpEnact_f427e22357> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_29> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_29> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_29> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "لا يحرم الرضاع إلا ما حصل قبل الفطام أو في الحولين سواء كان اللبن قليلا أو كثيرا ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_2_19840609_OpEnact_506ac64735> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_2> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الأسرة هي الخلية الأساسية للمجتمع وتتكون من أشخاص تجمع بينهم صلة الزوجية وصلة القرابة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_30_19840609_OpEnact_946638692c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_30> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_30> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_30> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يحرم من النساء مؤقتا : المحصنة، المعتدة من طلاق أو وفاة، المطلقة ثلاثا، كما يحرم مؤقتا الجمع بين الأختين أو بين المرأة وعمتها أو خالتها، سواء كانت شقيقة أو لأب أو لأم أو من رضاع، زواج المسلمة مع غير المسلم."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_31_19840609_OpEnact_8fc884bf22> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_31> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_31> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_31> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يخضع زواج الجزائريين والجزائريات بالأجانب من الجنسين إلى أحكام تنظيمية ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_32_19840609_OpEnact_8bed1634e6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_32> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_32> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_32> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يبطل الزواج ، إذا اشتمل على مانع أو شرط يتنافى ومقتضيات العقد ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_33_19840609_OpEnact_5c8f9fc551> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_33> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_33> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_33> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يبطل الزواج إذا اختل ركن الرضا . إذا تم الزواج بدون شاهدين أو صداق أو ولي في حالة وجوبه ، يفسخ قبل الدخول ولا صداق فيه ، و يثبت بعد الدخول بصداق المثل ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_34_19840609_OpEnact_61d4384867> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_34> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_34> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_34> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "كل زواج بإحدى المحرمات يفسخ قبل الدخول وبعده ويترتب عليه ثبوت النسب ، و وجوب الاستبراء ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_35_19840609_OpEnact_eab51aa878> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_35> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_35> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_35> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا اقترن عقد الزواج بشرط ينافيه كان ذلك الشرط باطلا والعقد صحيحا ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_36_19840609_OpEnact_cd52d3317c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_36> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_36> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_36> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجب على الزوجين : المحافظة على الروابط الزوجية وواجبات الحياة المشتركة، المعاشرة بالمعروف، وتبادل الاحترام والمودة والرحمة، التعاون على مصلحة الأسرة ورعاية الأولاد وحسن تربيتهم، التشاور في تسيير شؤون الأسرة وتباعد الولادات، حسن معاملة كل منهما لأبوي الآخر وأقاربه واحترامهم وزيارتهم، المحافظة على روابط القرابة والتعامل مع الوالدين الأقربين بالحسنى والمعروف، زيارة كل منهما لأبويه وأقاربه واستضافتهم بالمعروف."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_37_19840609_OpEnact_873b1b4ae1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_37> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_37> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_37> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "لكل واحد من الزوجين ذمة مالية مستقلة عن ذمة الآخر. غير أنه يجوز للزوجين أن يتفقا في عقد الزواج أو في عقد رسمي لاحق، حول الأموال المشتركة بينهما، التي يكتسبانها خلال الحياة الزوجية وتحديد النسب التي تؤول إلى كل واحد منها."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_38_19840609_OpEnact_b939838e4b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_38> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_38> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_38> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_39_19840609_OpEnact_7461a1006f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_39> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_39> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_39> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_3_19840609_OpEnact_3aa769bbd1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_3> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_3> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_3> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تعتمد الأسرة في حياتها على الترابط والتكافل وحسن المعاشرة والتربية الحسنة وحسن الخلق ونبذ الآفات الاجتماعية."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_3_bis_19840609_OpEnact_0277bb3204> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_3_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_3_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_3_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تعد النيابة العامة طرفا أصليا في جميع القضايا الرامية إلى تطبيق أحكام هذا القانون ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_40_19840609_OpEnact_9dacc7a902> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_40> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_40> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_40> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يثبت النسب بالزواج الصحيح أو بالإقرار أو بالبينة أو بنكاح الشبهة أو بكل زواج تم فسخه بعد الدخول طبقا للمواد 32 و 33 و 34 من هذا القانون. يجوز للقاضي اللجوء إلى الطرق العلمية لإثبات النسب ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_41_19840609_OpEnact_c8e4e00f50> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_41> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_41> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_41> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "ينسب الولد لأبيه متى كان الزواج شرعيا وأمكن الاتصال ولم ينفه بالطرق المشروعة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_42_19840609_OpEnact_08273d46f4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_42> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_42> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_42> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "أقل مدة الحمل ستة أشهر وأقصاها عشر (10) أشهر ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_43_19840609_OpEnact_c4e9658762> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_43> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_43> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_43> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "ينسب الولد لأبيه إذا وضع الحمل خلال عشرة (10) أشهر من تاريخ الانفصال أو الوفاة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_44_19840609_OpEnact_20f1aba52c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_44> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_44> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_44> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يثبت النسب بالإقرار بالبنوة، أو الأبوة أو الأمومة، لمجهول النسب ولو في مرض الموت متى صدقه العقل أو العادة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_45_19840609_OpEnact_d8f63a3c9f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_45> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_45> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_45> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الإقرار بالنسب في غير البنوة، والأبوة، والأمومة لا يسري على غير المقر إلا بتصديقه ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_45_bis_19840609_OpEnact_be048ffadf> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_45_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_45_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_45_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجوز للزوجين اللجوء إلى التلقيح الاصطناعي . يخضع التلقيح الاصطناعي للشروط الآتية : أن يكون الزواج شرعيا، أن يكون التلقيح برضا الزوجين وأثناء حياتهما، أن يتم بمني الزوج وبويضة رحم الزوجة دون غيرهما. لا يجوز اللجوء إلى التلقيح الاصطناعي باستعمال الأم البديلة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_46_19840609_OpEnact_82d5ff76d8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_46> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_46> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_46> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يمنع التبني شرعا وقانونا ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_47_19840609_OpEnact_cd64f974b4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_47> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_47> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_47> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تنحل الرابطة الزوجية بـ الطلاق أو الوفاة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_48_19840609_OpEnact_422e1cb699> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_48> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_48> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_48> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "مع مراعاة أحكام المادة 49 أدناه ، يحل عقد الزواج بالطلاق الذي يتم بإرادة الزوج أو بتراضي الزوجين أو بطلب من الزوجة في حدود ما ورد في المادتين 53 و 54 من هذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_49_19840609_OpEnact_1efe4b9d37> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_49> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_49> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_49> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "لا يثبت الطلاق إلا بحكم بعد عدة محاولات صلح يجريها القاضي دون أن تتجاوز مدته ثلاثة (3) أشهر ابتداء من تاريخ رفع الدعوى . يتعين على القاضي تحرير محضر يبين مساعي ونتائج محاولات الصلح ، يوقعه مع كاتب الضبط والطرفين . تسجل أحكام الطلاق وجوبا في الحالة المدنية بسعي من النيابة العامة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_4_19840609_OpEnact_f3fbd534c7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_4> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_4> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_4> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الزواج هو عقد رضائي يتم بين رجل وامرأة على الوجه الشرعي، من أهدافه، تكوين أسرة"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_50_19840609_OpEnact_8ff835b289> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_50> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_50> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_50> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "من راجع زوجته أثناء محاولة الصلح لا يحتاج إلى عقد جديد ومن راجعها بعد صدور الحكم بالطلاق يحتاج إلى عقد جديد."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_51_19840609_OpEnact_628dd44d67> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_51> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_51> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_51> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "لا يمكن أن يراجع الرجل من طلقها ثلاث مرات متتالية إلا بعد أن تتزوج غيره وتطلق منه أو يموت عنها بعد البناء ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_52_19840609_OpEnact_96d096e2e6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_52> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_52> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_52> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا تبين للقاضي تعسف الزوج في الطلاق حكم للمطلقة بالتعويض عن الضرر اللاحق بها ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_53_19840609_OpEnact_27262ab900> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_53> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_53> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_53> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجوز للزوجة أن تطلب التطليق للأسباب الآتية : عدم الإنفاق بعد صدور الحكم بوجوبه ما لم تكن عالمة بإعساره وقت الزواج، مع مراعاة المواد 78 و 79 و 80 من هذا القانون، العيوب التي تحول دون تحقيق الهدف من الزواج، الهجر في المضجع فوق أربعة أشهر، الحكم على الزوج عن جريمة فيها مساس بشرف الأسرة وتستحيل معها مواصلة العشرة والحياة الزوجية، الغيبة بعد مرور سنة بدون عذر ولا نفقة، مخالفة الأحكام الواردة في المادة 8 أعلاه، ارتكاب فاحشة مبينة، الشقاق المستمر بين الزوجين، مخالفة الشروط المتفق عليها في عقد الزواج، كل ضرر معتبر شرعا."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_53_bis_19840609_OpEnact_8f56dc64db> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_53_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_53_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_53_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجوز للقاضي في حالة الحكم بالتطليق أن يحكم للمطلقة بالتعويض عن الضرر اللاحق بها."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_54_19840609_OpEnact_6a660b9f4a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_54> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_54> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_54> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجوز للزوجة دون موافقة الزوج أن تخالع نفسها بمقابل مالي . إذا لم يتفق الزوجان على المقابل المالي للخلع ، يحكم القاضي بما لا يتجاوز قيمة صداق المثل وقت صدور الحكم ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_55_19840609_OpEnact_7da274bba2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_55> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_55> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_55> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "عند نشوز أحد الزوجين يحكم القاضي بالطلاق وبالتعويض للطرف المتضرر ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_56_19840609_OpEnact_13aeb0d9a7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_56> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_56> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_56> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا اشتد الخصام بين الزوجين ولم يثبت الضرر وجب تعيين حكمين للتوفيق بينهما . يعين القاضي الحكمين، حكما من أهل الزوج وحكما من أهل الزوجة، وعلى هذين الحكمين أن يقدما تقريرا عن مهمتهما في أجل شهرين ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_57_19840609_OpEnact_ca80d9b546> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_57> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_57> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_57> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تكون الأحكام الصادرة في دعاوى الطلاق والتطليق والخلع غير قابلة للاستئناف فيما عدا جوانبها المادية. تكون الأحكام المتعلقة بالحضانة قابلة للاستئناف."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_57_bis_19840609_OpEnact_4296d35f5f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_57_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_57_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_57_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجوز للقاضي الفصل على وجه الاستعجال بموجب أمر على عريضة في جميع التدابير المؤقتة ولا سيما ما تعلق منها بالنفقة والحضانة والزيارة والمسكن."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_58_19840609_OpEnact_926534bae2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_58> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_58> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_58> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تعتد المطلقة المدخول بها غير الحامل بثلاثة قروء، واليائس من المحيض بثلاثة أشهر من تاريخ التصريح بالطلاق ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_59_19840609_OpEnact_6f1bf1a399> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_59> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_59> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_59> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تعتد المتوفى عنها زوجها بمضي أربعة أشهر وعشرة أيام، وكذا زوجة المفقود من تاريخ صدور الحكم ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_5_19840609_OpEnact_4d5ee30a40> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_5> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_5> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_5> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الخطبة وعد بالزواج. يجوز للطرفين العدول عن الخطبة. إذا ترتب عن العدول عن الخطبة ضرر مادي أو معنوي لأحد الطرفين جاز الحكم له بالتعويض. يسترد الخاطب من المخطوبة شيئا مما أهداها إن كان العدول منه ، و عليه أن يرد للمخطوبة ما لم يستهلك مما أهدته له أو قيمته. وإن كان العدول من المخطوبة ، فعليها أن ترد للخاطب ما لم يستهلك من هدايا أو قيمته."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_60_19840609_OpEnact_96646aa898> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_60> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_60> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_60> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "عدة الحامل وضع حملها ، وأقصى مدة الحمل عشرة (10) أشهر من تاريخ الطلاق أو الوفاة."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_61_19840609_OpEnact_253ace8906> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_61> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_61> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_61> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "لا تخرج الزوجة المطلقة ولا المتوفى عنها زوجها من السكن العائلي ما دامت في عدة طلاقها أو وفاة زوجها إلا في حالة الفاحشة المبينة ولها الحق في النفقة في عدة الطلاق ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_62_19840609_OpEnact_67b25d8a88> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_62> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_62> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_62> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الحضانة هي رعاية الولد وتعليمه والقيام بتربيته على دين أبيه والسهر على حمايته وحفظه صحة وخلقا . ويشترط في الحاضن أن يكون أهلا للقيام بذلك ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_63_19840609_OpEnact_42b6b621f4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_63> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_63> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_63> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_64_19840609_OpEnact_31b735a62f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_64> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_64> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_64> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الأم أولى بحضانة ولدها، ثم الأب ، ثم الجدة لأم، ثم الجدة لأب، ثم الخالة، ثم العمة، ثم الأقربون درجة مع مراعاة مصلحة المحضون في كل ذلك، و على القاضي عندما يحكم بإسناد الحضانة أن يحكم بحق الزيارة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_65_19840609_OpEnact_3427884cde> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_65> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_65> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_65> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تنقضي مدة حضانة الذكر ببلوغه (10) سنوات، والأنثى ببلوغها سن الزواج، و للقاضي أن يمدد الحضانة بالنسبة للذكر إلى (16) سنة إذا كانت الحاضنة أما لم تتزوج ثانية . على أن يراعى في الحكم بانتهائها مصلحة المحضون ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_66_19840609_OpEnact_8dec783e4b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_66> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_66> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_66> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يسقط حق الحاضنة بالتزوج بغير قريب محرم، وبالتنازل ما لم يضر بمصلحة المحضون ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_67_19840609_OpEnact_c1593dd322> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_67> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_67> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_67> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تسقط الحضانة باختلال أحد الشروط المنصوص عليها في المادة 62 أعلاه. ولا يمكن لعمل المرأة أن يشكل سببا من أسباب سقوط الحق عنها في ممارسة الحضانة. غير أنه يجب في جميع الحالات مراعاة مصلحة المحضون ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_68_19840609_OpEnact_ede2b6a64e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_68> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_68> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_68> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا لم يطلب من له الحق في الحضانة مدة تزيد عن سنة بدون عذر سقط حقه فيها."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_69_19840609_OpEnact_0a5fd58c0a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_69> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_69> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_69> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا أراد الشخص الموكول له حق الحضانة أن يستوطن في بلد أجنبي رجع الأمر للقاضي في إثبات الحضانة له أو إسقاطها عنه، مع مراعاة مصلحة المحضون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_6_19840609_OpEnact_81bb6b400f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_6> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_6> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_6> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إن اقتران الفاتحة بالخطبة لا يعد زواجا. غير أن اقتران الفاتحة بالخطبة بمجلس العقد يعتبر زواجا متى توافر ركن الرضا وشروط الزواج المنصوص عليها في المادة 9 مكرر من هذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_70_19840609_OpEnact_6fe18c54ae> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_70> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_70> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_70> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تسقط حضانة الجدة أو الخالة إذا سكنت بمحضونها مع أم المحضون المتزوجة بغير قريب ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_71_19840609_OpEnact_f239528339> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_71> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_71> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_71> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يعود الحق في الحضانة إذا زال سبب سقوطه غير الاختياري ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_72_19840609_OpEnact_2a6be2f280> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_72> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_72> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_72> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "في حالة الطلاق ، يجب على الأب أن يوفر ، لممارسة الحضانة، سكنا ملائما للحاضنة ، و إن تعذر ذلك فعليه دفع بدل الإيجار . وتبقى الحاضنة في بيت الزوجية حتى تنفيذ الأب للحكم القضائي المتعلق بالسكن ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_73_19840609_OpEnact_b39e3b5f5c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_73> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_73> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_73> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا وقع النزاع بين الزوجين أو ورثتهما في متاع البيت وليس لأحدهما بينة فالقول للزوجة أو ورثتها مع اليمين في المعتاد للنساء والقول للزوج أو ورثته مع اليمين في المعتاد للرجال. والمشتركات بينهما يتقسمانها مع اليمين."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_74_19840609_OpEnact_a77170a8aa> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_74> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_74> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_74> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تجب نفقة الزوجة على زوجها بالدخول بها أو دعوتها إليه ببينة مع مراعاة أحكام المواد 78 و 79 و 80 من هذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_75_19840609_OpEnact_6096b65b3c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_75> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_75> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_75> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تجب نفقة الولد على الأب ما لم يكن له مال ، فبالنسبة للذكور إلى سن الرشد والإناث إلى الدخول وتستمر في حالة ما إذا كان الولد عاجزا لآفة عقلية أو بدنية أو مزاولا للدراسة وتسقط بالاستغناء عنها بالكسب."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_76_19840609_OpEnact_01da5bdc3e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_76> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_76> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_76> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "في حالة عجز الأب تجب نفقة الأولاد على الأم إذا كانت قادرة على ذلك ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_77_19840609_OpEnact_3a2018d72a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_77> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_77> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_77> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تجب نفقة الأصول على الفروع والفروع على الأصول حسب القدرة والاحتياج ودرجة القرابة في الإرث."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_78_19840609_OpEnact_25fad1e800> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_78> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_78> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_78> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تشمل النفقة : الغذاء والكسوة والعلاج، والسكن أو أجرته، وما يعتبر من الضروريات في العرف والعادة."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_79_19840609_OpEnact_5d881cee90> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_79> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_79> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_79> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يراعي القاضي في تقدير النفقة حال الطرفين وظروف المعاش ولا يراجع تقديره قبل مضى سنة من الحكم."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_7_19840609_OpEnact_cf77f7b424> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_7> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_7> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_7> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تكتمل أهلية الرجل والمرأة في الزواج بتمام 19 سنة . وللقاضي أن يرخص بالزواج قبل ذلك لمصلحة أو ضرورة، متى تأكدت قدرة الطرفين على الزواج . يكتسب الزوج القاصر أهلية التقاضي فيما يتعلق بآثار عقد الزواج من حقوق والتزامات ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_7_bis_19840609_OpEnact_e6ac751d57> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_7_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_7_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_7_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجب على طالبي الزواج أن يقدما وثيقة طبية، لا يزيد تاريخها عن ثلاثة (3) أشهر تثبت خلوهما من أي مرض أو أي عامل قد يشكل خطرا يتعارض مع الزواج . يتعين على الموثق أو ضابط الحالة المدنية ، أن يتأكد قبل تحرير عقد الزواج من خضوع الطرفين للفحوصات الطبية ومن علمهما بما قد تكشف عنه من أمراض أو عوامل قد يشكل خطرا يتعارض مع الزواج . ويؤشر بذلك في عقد الزواج. تحدد شروط وكيفيات تطبيق هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_80_19840609_OpEnact_4bd7ef1904> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_80> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_80> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_80> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تستحق النفقة من تاريخ رفع الدعوى وللقاضي أن يحكم باستحقاقها بناء على بينة لمدة لا تتجاوز سنة قبل رفع الدعوى."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_81_19840609_OpEnact_af82515bef> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_81> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_81> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_81> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "من كان فاقد الأهلية أو ناقصها لصغر السن، أو جنون، أو عته، أو سفه ، ينوب عنه قانونا ولي أو وصي أو مقدم طبقا لأحكام هذا القانون ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_82_19840609_OpEnact_41cca8c588> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_82> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_82> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_82> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "من لم يبلغ سن التمييز لصغر سنه طبقا ل المادة (42) من القانون المدني تعتبر جميع تصرفاته باطلة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_83_19840609_OpEnact_ceccf0649c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_83> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_83> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_83> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "من بلغ سن التمييز ولم يبلغ سن الرشد طبقا ل المادة (43) من القانون المدني تكون تصرفاته نافذة إذا كانت نافعة له ، وباطلة إذا كانت ضارة به وتتوقف على إجازة الولي أو الوصي فيما إذا كانت مترددة بين النفع والضرر ، وفي حالة النزاع يرفع الأمر للقضاء."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_84_19840609_OpEnact_8d0879116d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_84> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_84> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_84> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "للقاضي أن يأذن لمن يبلغ سن التمييز في التصرف جزئيا أو كليا في أمواله ، بناء على طلب من له مصلحة ، وله الرجوع في الإذن إذا ثبت لديه ما يبرر ذلك ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_85_19840609_OpEnact_5ba0c2d099> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_85> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_85> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_85> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تعتبر تصرفات المجنون والمعتوه والسفيه غير نافذة إذا صدرت في حالة الجنون، أو العته، أو السفه ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_86_19840609_OpEnact_be789c76fa> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_86> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_86> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_86> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "من بلغ سن الرشد ولم يحجر عليه يعتبر كامل الأهلية وفقا لأحكام المادة 40 من القانون المدني ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_87_19840609_OpEnact_59307e84ef> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_87> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_87> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_87> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يكون الأب وليا على أولاده القصر، وبعد وفاته تحل الأم محله قانونا. وفي حالة غياب الأب أو حصول مانع له ، تحل الأم محله في القيام بالأمور المستعجلة المتعلقة بالأولاد . وفي حالة الطلاق ، يمنح القاضي الولاية لمن أسندت له حضانة الأولاد ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_88_19840609_OpEnact_40e3222f4f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_88> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_88> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_88> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "على الولي أن يتصرف في أموال القاصر تصرف الرجل الحريص ويكون مسؤولا طبقا لمقتضيات القانون العام . وعليه أن يستأذن القاضي في التصرفات التالية : بيع العقار، وقسمته، ورهنه، وإجراء المصالحة، بيع المنقولات ذات الأهمية الخاصة، استثمار أموال القاصر بالإقراض، أو الاقتراض أو المساهمة في شركة، إيجار عقار القاصر لمدة تزيد على ثلاث سنوات أو تمتد لأكثر من سنة بعد بلوغه سن الرشد."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_89_19840609_OpEnact_016a64a533> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_89> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_89> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_89> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "على القاضي أن يراعي في الإذن : حالة الضرورة والمصلحة، وأن يتم بيع العقار بالمزاد العلني ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_8_19840609_OpEnact_5fb6a8dcdb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_8> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_8> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_8> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يسمح بالزواج بأكثر من زوجة واحدة في حدود الشريعة الإسلامية متى وجد المبرر الشرعي وتوفرت شروط ونية العدل . يجب على الزوج إخبار الزوجة السابقة والمرأة التي يقبل على الزواج بها وأن يقدم طلب الترخيص بالزواج إلى رئيس المحكمة لمكان مسكن الزوجية . يمكن رئيس المحكمة أن يرخص بالزواج الجديد، إذا تأكد من موافقتهما وأثبت الزوج المبرر الشرعي وقدرته على توفير العدل والشروط الضرورية للحياة الزوجية ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_8_bis_19840609_OpEnact_1b09ea4566> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_8_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_8_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_8_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "في حالة التدليس ، يجوز لكل زوجة رفع دعوى قضائية ضد الزوج للمطالبة بالتطليق ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_8_bis_1_19840609_OpEnact_2d26e194f4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_8_bis_1> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_8_bis_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_8_bis_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يفسخ الزواج الجديد قبل الدخول، إذا لم يستصدر الزوج ترخيصا من القاضي وفقا للشروط المنصوص عليها في المادة 8 أعلاه ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_90_19840609_OpEnact_1d111d366d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_90> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_90> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_90> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا تعارضت مصالح الولي ومصالح القاصر يعين القاضي متصرفا خاصا تلقائيا أو بناء على طلب من له مصلحة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_91_19840609_OpEnact_2e7891607c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_91> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_91> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_91> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تنتهي وظيفة الولي : بعجزه، بموته، بالحجر عليه، بإسقاط الولاية عنه."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_92_19840609_OpEnact_bd124d3fb9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_92> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_92> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_92> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجوز للأب أو الجد تعيين وصي للولد القاصر إذا لم تكن له أم تتولى أموره أو تثبت عدم أهليتها لذلك بالطرق القانونية وإذا تعدد الأوصياء فللقاضي اختيار الأصلح منهم مع مراعاة أحكام المادة (86) من هذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_93_19840609_OpEnact_f466fa79e9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_93> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_93> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_93> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يشترط في الوصي أن يكون مسلما عاقلا بالغا قادرا أمينا حسن التصرف وللقاضي عزله إذا لم تتوفر فيه الشروط المذكورة."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_94_19840609_OpEnact_da8538aa51> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_94> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_94> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_94> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجب عرض الوصاية على القاضي بمجرد وفاة الأب لتثبيتها أو رفضها ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_95_19840609_OpEnact_3d75348300> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_95> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_95> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_95> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "للـ وصي نفس سلطة الولي في التصرف وفقا لأحكام المواد 88 و 89 و 90 من هذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_96_19840609_OpEnact_ffe1da5a8b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_96> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_96> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_96> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تنتهي مهمة الوصي : 1 - بموت القاصر، أو زوال أهلية الوصي أو موته، 2 - ببلوغ القاصر سن الرشد ما لم يصدر حكم من القضاء بالحجر عليه، 3 - بانتهاء المهام التي أقيم الوصي من أجلها، 4 - بقبول عذره في التخلي عن مهمته، 5 - بعزله بناء على طلب من له مصلحة إذا ثبت من تصرفات الوصي ما يهدد مصلحة القاصر."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_97_19840609_OpEnact_d5551591ca> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_97> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_97> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_97> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "على الوصي الذي انتهت مهمته أن يسلم الأموال التي في عهدته ويقدم عنها حسابا بالمستندات إلى من يخلفه أو إلى القاصر الذي رشد أو إلى ورثته في مدة لا تتجاوز شهرين من تاريخ انتهاء مهمته . وأن يقدم صورة عن الحساب المذكور إلى القضاء . وفي حالة وفاة الوصي أو فقده فعلى ورثته تسليم أموال القاصر بواسطة القضاء إلى المعني بالأمر ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_98_19840609_OpEnact_fec5c1af57> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_98> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_98> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_98> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يكون الوصي مسؤولا عما يلحق أموال القاصر من ضرر بسبب تقصيره ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_99_19840609_OpEnact_5250997209> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_99> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_99> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_99> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المقدم هو من تعينه المحكمة في حالة عدم وجود ولي أوصي على من كان فاقد الأهلية أو ناقصها بناء على طلب أحد أقاربه، أو ممن له مصلحة أو من النيابة العامة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_9_19840609_OpEnact_a792766c56> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_9> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_9> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_9> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "ينعقد الزواج بتبادل رضا الزوجين."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_9_bis_19840609_OpEnact_9d37db0553> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_9_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_9_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_9_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجب أن تتوفر في عقد الزواج الشروط الآتية : أهلية الزواج، الصداق، الولي، شاهدان انعدام الموانع الشرعية للزواج."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_1_19840609_OpEnact_ff9424e4a2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_1> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تخضع جميع العلاقات بين أفراد الأسرة لأحكام هذا القانون ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_2_19840609_OpEnact_d58db1c60b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_2> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الأسرة هي الخلية الأساسية للمجتمع وتتكون من أشخاص تجمع بينهم صلة الزوجية وصلة القرابة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_3_19840609_OpEnact_b76732ebeb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_3> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_3> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_3> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تعتمد الأسرة في حياتها على الترابط والتكافل وحسن المعاشرة والتربية الحسنة وحسن الخلق ونبذ الآفات الاجتماعية."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_4_19840609_OpEnact_f7d95cd756> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_4> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_4> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_4> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الزواج هو عقد رضائي يتم بين رجل وامرأة على الوجه الشرعي، من أهدافه، تكوين أسرة"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_6_19840609_OpEnact_9207f6236a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_6> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_6> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_6> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إن اقتران الفاتحة بالخطبة لا يعد زواجا. غير أن اقتران الفاتحة بالخطبة بمجلس العقد يعتبر زواجا متى توافر ركن الرضا وشروط الزواج المنصوص عليها في المادة 9 مكرر من هذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_7_19840609_OpEnact_cb1eae3fcd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_7> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_7> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_7> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تكتمل أهلية الرجل والمرأة في الزواج بتمام 19 سنة . وللقاضي أن يرخص بالزواج قبل ذلك لمصلحة أو ضرورة، متى تأكدت قدرة الطرفين على الزواج . يكتسب الزوج القاصر أهلية التقاضي فيما يتعلق بآثار عقد الزواج من حقوق والتزامات ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_8_19840609_OpEnact_92b50b16ce> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_8> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_8> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_8> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يسمح بالزواج بأكثر من زوجة واحدة في حدود الشريعة الإسلامية متى وجد المبرر الشرعي وتوفرت شروط ونية العدل . يجب على الزوج إخبار الزوجة السابقة والمرأة التي يقبل على الزواج بها وأن يقدم طلب الترخيص بالزواج إلى رئيس المحكمة لمكان مسكن الزوجية . يمكن رئيس المحكمة أن يرخص بالزواج الجديد، إذا تأكد من موافقتهما وأثبت الزوج المبرر الشرعي وقدرته على توفير العدل والشروط الضرورية للحياة الزوجية ."@ar .

