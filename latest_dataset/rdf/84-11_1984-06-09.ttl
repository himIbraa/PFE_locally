<https://legal.dz/resource/law/1984-06-09/84-11#version_art_143> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الفروض المحددة ستة وهي : النصف، والربع، والثمن، والثلثان، والثلث، والسدس. أصحاب النصف"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_143_19840609_OpEnact_43a606b71f> ;
