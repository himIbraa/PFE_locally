    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تخضع جميع العلاقات بين أفراد الأسرة لأحكام هذا القانون ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_200_19840609_OpEnact_2ec8404779> a dzdoc:ArticleVersion ;
