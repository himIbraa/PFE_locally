    dzdoc:number "130" ;
    dzdoc:position 137 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_136> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_1> ;
    dzdoc:eId "art_136" ;
    dzdoc:fullText "الممنوع من الإرث للأسباب المذكورة أعلاه لا يحجب غيره."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_136> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_136_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_136_19840609_OpEnact_94eff9c498> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "136" ;
    dzdoc:position 143 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_139> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_2> ;
    dzdoc:eId "art_139" ;
    dzdoc:fullText "ينقسم الورثة إلى: 1- أصحاب فروض، 2- عصبة، 3- ذوي الأرحام."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_139> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_139_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_139_19840609_OpEnact_936e85f057> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 139" ;
    dzdoc:position 146 ;
    dzdoc:usesTerm dzterm:heirs .

<https://legal.dz/resource/law/1984-06-09/84-11#art_153> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_3> ;
    dzdoc:eId "art_153" ;
    dzdoc:fullText "العصبة بالنفس أربع جهات يقدم بعضها على بعض عند الاجتماع حسب الترتيب الآتي: 1- جهة البنوة وتشمل الابن وابن الابن مهما نزلت درجته، 2- جهة الأبوة وتشمل الأب، والجد الصحيح مهما علا . مع مر اعاة أحوال الجد، 3- جهة الأخوة وتشمل الإخوة الأشقاء أو لأب وأبناءهم مهما نزلوا، 4- جهة العمومة وتشمل أعمام الميت، وأعمام أبيه، وأعمام جده مهما علا، وأبناءهم مهما نزلوا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_153> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_153_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_153_19840609_OpEnact_fdf4fab1b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "153" ;
    dzdoc:position 160 ;
    dzdoc:usesTerm dzterm:عصبة_بالنفس .

<https://legal.dz/resource/law/1984-06-09/84-11#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "يتم عقد الزواج أمام الموثق أو أمام موظف مؤهل قانونا مع مراعاة ما ورد في المادتين 9 و 9 مكرر من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_18_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_18_19840609_OpEnact_028cc45112> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "18" ;
    dzdoc:position 22 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_9>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_9_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_9>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_9_bis> ;
    dzdoc:usesTerm dzterm:marriage,
        dzterm:notary,
        dzterm:qualified_officer .

<https://legal.dz/resource/law/1984-06-09/84-11#art_188> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_188" ;
    dzdoc:fullText "لا يستحق الوصية من قتل الموصي عمدا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_188> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_188_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_188_19840609_OpEnact_21a2336b44> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 188" ;
    dzdoc:position 195 ;
    dzdoc:usesTerm dzterm:وصية .

<https://legal.dz/resource/law/1984-06-09/84-11#art_193> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_193" ;
    dzdoc:fullText "رهن الموصى به لا يعد رجوعا في الوصية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_193> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_193_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_193_19840609_OpEnact_bfb00882c8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 193" ;
    dzdoc:position 200 ;
    dzdoc:usesTerm dzterm:وصية .

<https://legal.dz/resource/law/1984-06-09/84-11#art_194> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_194" ;
    dzdoc:fullText "إذا أوصي لشخص ثم أوصي لثان يكون الموصى به مشتركا بينهما."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_194> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_194_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_194_19840609_OpEnact_762040b75c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 194" ;
    dzdoc:position 201 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_195> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_195" ;
    dzdoc:fullText "إذا كانت الوصية لشخصين معينين دون أن يحدد ما يستحقه كل منهما ومات أحدهما وقت الوصية أو بعدها قبل وفاة الموصي، فالوصية كلها للحي منهما ، أما إذا حدد ما يستحقه كل منهما فالحي لا يستحق إلا ما حدد له."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_195> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_195_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_195_19840609_OpEnact_acc97d3278> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 195" ;
    dzdoc:position 202 ;
    dzdoc:usesTerm dzterm:وصية .

<https://legal.dz/resource/law/1984-06-09/84-11#art_196> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_196" ;
    dzdoc:fullText "الوصية ، بمنفعة لمدة غير محدودة تنتهي بوفاة الموصى له وتعتبر عمرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_196> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_196_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_196_19840609_OpEnact_870af5b39e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 196" ;
    dzdoc:position 203 ;
    dzdoc:usesTerm dzterm:وصية .

<https://legal.dz/resource/law/1984-06-09/84-11#art_197> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_197" ;
    dzdoc:fullText "يكون قبول الوصية صراحة أو ضمنا بعد وفاة الوصي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_197> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_197_para_0> ;
