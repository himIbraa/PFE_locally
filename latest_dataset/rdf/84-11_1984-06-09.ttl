<https://legal.dz/resource/law/1984-06-09/84-11#version_art_171> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يستحق هؤلاء الأحفاد التنزيل إن كانوا وارثين للأصل جدا كان أو جدة أو كان قد أوصى لهم، أو أعطاهم في حياته بلا عوض مقدار ما يستحق بهذه الوصية ، فان أوصى لهم أو لأحدهم بأقل من ذلك وجب التنزيل بمقدار ما يتم به نصيبهم أو نصيب أحدهم من التركة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_171_19840609_OpEnact_8b8672bc71> ;
