    dzdoc:position 115 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_147> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_2> ;
    dzdoc:eId "art_147" ;
    dzdoc:fullText "أصحاب الثلثين أربعة وهن : 1- بنتان فأكثر بشرط عدم وجود الابن ، 2- بنتا الابن فأكثر بشرط عدم وجود ولد الصلب، وابن الابن في درجتهما ، 3- الشقيقتان فأكثر بشرط عدم وجود الشقيق الذكر، أو الأب أو ولد الصلب ، 4- الأختان لأب فأكثر بشرط عدم وجود الأخ لأب، ومن ذكر في الشقيقتين . أصحاب الثلث"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_147> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_147_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_147_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_147_19840609_OpEnact_3b32b785ec> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 147" ;
    dzdoc:position 154 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_147_condition_0_81486d73>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_147_condition_1_b6c16504>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_147_condition_2_82974ae9>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_147_condition_3_6997392f> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_158> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_4> ;
    dzdoc:eId "art_158" ;
    dzdoc:fullText "إذا اجتمع الجد العاصب مع الإخوة الأشقاء ، أو مع الإخوة للأب ذكورا أو إناثا أو مختلطين فله الأفضل من جميع ثلث المال أو المقاسمة . وإذا اجتمع مع الإخوة و ذوي الفروض فله الأفضل من : سدس جميع المال، أو ثلث ما بقى بعد ذوي الفروض ، أو مقاسمة الإخوة كذكر منهم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_158_right_0_96b3e5b9>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_158_right_1_56a395e3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_158> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_158_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_158_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_158_19840609_OpEnact_98290af0b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "158" ;
    dzdoc:position 165 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_158_condition_0_378f4e2a>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_158_condition_1_de8bd83f> ;
    dzdoc:usesTerm dzterm:fard_heirs,
        dzterm:full_siblings,
        dzterm:grandfather,
        dzterm:paternal_siblings,
        dzterm:siblings .

<https://legal.dz/resource/law/1984-06-09/84-11#art_165> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_5> ;
    dzdoc:eId "art_165" ;
    dzdoc:fullText "يحجب الأخ للأب أبناء الإخوة الأشقاء أو الأب . يحجب أبناء الإخوة الأشقاء أبناء الإخوة لأب ، يحجب أبناء الإخوة الأشقاء أولاد الأعمام وبنيهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_165> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_165_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_165_para_1>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_165_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_165_19840609_OpEnact_c2174e27ef> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_165_obligation_0_79021439>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_165_obligation_1_0c1459ce>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_165_obligation_2_716cec7f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "165" ;
    dzdoc:position 172 ;
    dzdoc:usesTerm dzterm:paternal_brother .

<https://legal.dz/resource/law/1984-06-09/84-11#art_181> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_10> ;
    dzdoc:eId "art_181" ;
    dzdoc:fullText "يراعي في قسمة التركات أحكام المادتين 109 و 173 من هذا القانون وما ورد في القانون المدني فيما يتعلق ب الملكية الشائعة . وفي حالة وجود قاصر بين الورثة يجب أن تكون القسمة عن طريق القضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_181> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_181_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_181_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_181_19840609_OpEnact_31d41e6b15> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_181_obligation_0_62194dd6>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_181_obligation_1_6ce5c6c8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 181" ;
    dzdoc:position 188 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_109>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_173> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_109>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_173> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_181_condition_0_0e3d3a31> ;
    dzdoc:usesTerm dzterm:common_property,
        dzterm:division_of_estates .

<https://legal.dz/resource/law/1984-06-09/84-11#art_202> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:هبة ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_202" ;
    dzdoc:fullText "الهبة تمليك بلا عوض. ويجوز للواهب أن يشترط على الموهب له القيام بالتزام يتوقف على إنجاز الشرط."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_202_right_0_c0aaa798> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_202> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_202_defocc_bec87ee71026> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_202_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_202_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_202_19840609_OpEnact_041044d6a4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 202" ;
    dzdoc:position 209 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_32> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_3> ;
    dzdoc:eId "art_32" ;
    dzdoc:fullText "يبطل الزواج ، إذا اشتمل على مانع أو شرط يتنافى ومقتضيات العقد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_32> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_32_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_32_19840609_OpEnact_8bed1634e6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_32_obligation_0_fa3c1c1d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "32" ;
    dzdoc:position 36 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_32_condition_0_c5dd1a62> ;
    dzdoc:usesTerm dzterm:marriage .

<https://legal.dz/resource/law/1984-06-09/84-11#art_43> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_5> ;
    dzdoc:eId "art_43" ;
    dzdoc:fullText "ينسب الولد لأبيه إذا وضع الحمل خلال عشرة (10) أشهر من تاريخ الانفصال أو الوفاة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_43> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_43_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_43_19840609_OpEnact_c4e9658762> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_43_obligation_0_bab06ecc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "43" ;
    dzdoc:position 47 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_43_condition_0_a5af8471> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:custody ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "الحضانة هي رعاية الولد وتعليمه والقيام بتربيته على دين أبيه والسهر على حمايته وحفظه صحة وخلقا . ويشترط في الحاضن أن يكون أهلا للقيام بذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_62> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_62_defocc_c0fd6cddb67f> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_62_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_62_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_62_19840609_OpEnact_67b25d8a88> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 62" ;
    dzdoc:position 69 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_62_condition_0_4d0150da> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_3> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "في حالة عجز الأب تجب نفقة الأولاد على الأم إذا كانت قادرة على ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_76_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_76_19840609_OpEnact_01da5bdc3e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_76_obligation_0_efeee4ce> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "76" ;
    dzdoc:position 83 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_76_condition_0_a481fb2a>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_76_condition_1_8ee6880c> ;
    dzdoc:usesTerm dzterm:maintenance .

<https://legal.dz/resource/law/1984-06-09/84-11#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:maintenance ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_3> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "تشمل النفقة : الغذاء والكسوة والعلاج، والسكن أو أجرته، وما يعتبر من الضروريات في العرف والعادة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_78> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_78_defocc_f2cd595cea20> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_78_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_78_19840609_OpEnact_25fad1e800> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "78" ;
    dzdoc:position 85 ;
    dzdoc:usesTerm dzterm:maintenance .

<https://legal.dz/resource/law/1984-06-09/84-11#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_3> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "يراعي القاضي في تقدير النفقة حال الطرفين وظروف المعاش ولا يراجع تقديره قبل مضى سنة من الحكم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_79_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_79_19840609_OpEnact_5d881cee90> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_79_obligation_0_f30eb798> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "79" ;
    dzdoc:position 86 ;
    dzdoc:usesTerm dzterm:maintenance .

<https://legal.dz/resource/law/1984-06-09/84-11#art_80> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_3> ;
    dzdoc:eId "art_80" ;
    dzdoc:fullText "تستحق النفقة من تاريخ رفع الدعوى وللقاضي أن يحكم باستحقاقها بناء على بينة لمدة لا تتجاوز سنة قبل رفع الدعوى."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_80_right_0_a979ad3c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_80> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_80_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_80_19840609_OpEnact_4bd7ef1904> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "80" ;
    dzdoc:position 87 ;
    dzdoc:usesTerm dzterm:maintenance .

<https://legal.dz/resource/law/1984-06-09/84-11#art_8_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_8_bis" ;
    dzdoc:fullText "في حالة التدليس ، يجوز لكل زوجة رفع دعوى قضائية ضد الزوج للمطالبة بالتطليق ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_8_bis_permission_0_cfacc628> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_8_bis_right_0_ab611818> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_8_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_8_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_8_bis_19840609_OpEnact_1b09ea4566> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "8 مكرر" ;
    dzdoc:position 10 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_8_bis_condition_0_9542c715> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_90> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_2> ;
    dzdoc:eId "art_90" ;
    dzdoc:fullText "إذا تعارضت مصالح الولي ومصالح القاصر يعين القاضي متصرفا خاصا تلقائيا أو بناء على طلب من له مصلحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_90> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_90_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_90_19840609_OpEnact_1d111d366d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_90_obligation_0_db03d922> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "90" ;
    dzdoc:position 97 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_90_condition_0_75d4c97e> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_92> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_3> ;
    dzdoc:eId "art_92" ;
    dzdoc:fullText "يجوز للأب أو الجد تعيين وصي للولد القاصر إذا لم تكن له أم تتولى أموره أو تثبت عدم أهليتها لذلك بالطرق القانونية وإذا تعدد الأوصياء فللقاضي اختيار الأصلح منهم مع مراعاة أحكام المادة (86) من هذا القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_92_permission_0_b40703e0> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_92_right_0_66bc5e37> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_92> ;
