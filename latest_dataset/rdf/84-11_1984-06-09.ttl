<https://legal.dz/resource/law/1984-06-09/84-11#art_201> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_201" ;
    dzdoc:fullText "تبطل الوصية بموت الموصى له قبل الموصي، أو بردها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_201> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_201_para_0> ;
