    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تشترط في الواهب أن يكون سليم العقل، بالغا تسع عشرة (19) سنة وغير محجور عليه ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_204_19840609_OpEnact_0a367b58a9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
