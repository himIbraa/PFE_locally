    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "الزواج هو عقد رضائي يتم بين رجل وامرأة على الوجه الشرعي، من أهدافه، تكوين أسرة"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_4_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_4> ;
    dzdoc:position 0 ;
    dzdoc:text "الزواج هو عقد رضائي يتم بين رجل وامرأة على الوجه الشرعي، من أهدافه، تكوين أسرة"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#preamble_segment_0> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#preamble> ;
    dzdoc:position 0 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "إن رئيس الجمهورية،"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#preamble_segment_2> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#preamble> ;
    dzdoc:position 2 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبناء على ما أقره المجلس الشعبي الوطني،"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_100_19840609_OpEnact_63591ffc9c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_100> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_100> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_100> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يقوم المقدم مقام الوصي ويخضع لنفس الأحكام ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_101_19840609_OpEnact_6bd4f66431> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_101> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_101> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_101> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "من بلغ سن الرشد وهو مجنون، أو معتوه، أو سفيه، أو طرأت عليه إحدى الحالات المذكورة بعد رشده يحجر عليه ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_102_19840609_OpEnact_bebc9b1500> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_102> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_102> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_102> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يكون الحجر بناء على طلب أحد الأقارب أو ممن له مصلحة ، أو من النيابة العامة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_103_19840609_OpEnact_e87d349184> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_103> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_103> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_103> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجب أن يكون الحجر بحكم وللقاضي أن يستعين بأهل الخبرة في إثبات أسباب الحجر."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_104_19840609_OpEnact_3940008621> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_104> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_104> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_104> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا لم يكن للمحجور عليه ولي، أو وصي وجب على القاضي أن يعين في نفس الحكم مقدما لرعاية المحجور عليه والقيام بشؤونه مع مراعاة أحكام المادة 100 من هذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_105_19840609_OpEnact_a40953a29a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_105> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_105> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_105> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجب أن يمكن الشخص الذي يراد التحجير عليه من الدفاع عن حقوقه وللمحكمة أن تعين له مساعدا إذا رأت في ذلك مصلحة."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_106_19840609_OpEnact_4d271c9265> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_106> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_106> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_106> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الحكم بالحجر قابل لكل طرق الطعن و يجب نشره للإعلام ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_107_19840609_OpEnact_fd92eac5fd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_107> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_107> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_107> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تعتبر تصرفات المحجور عليه بعد الحكم باطلة، وقبل الحكم إذا كانت أسباب الحجر ظاهرة وفاشية وقت صدورها ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_108_19840609_OpEnact_4844a47144> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_108> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_108> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_108> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يمكن رفع الحجر إذا زالت أسبابه بناء على طلب المحجور عليه."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_109_19840609_OpEnact_7e585ba18a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_109> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_109> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_109> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المفقود هو الشخص الغائب الذي لا يعرف مكانه ولا يعرف حياته أو موته و لا يعتبر مفقودا إلا بحكم ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_10_19840609_OpEnact_5eef7b27cb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_10> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_10> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_10> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يكون الرضا بإيجاب من أحد الطرفين وقبول من الطرف الآخر بكل لفظ يفيد معنى النكاح شرعا. ويصح الإيجاب والقبول من العاجز بكل ما يفيد معنى النكاح لغة أو عرفا كالكتابة والإشارة."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_110_19840609_OpEnact_85a8b6fc51> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_110> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_110> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_110> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الغائب الذي منعته ظروف قاهرة من الرجوع إلى محل إقامته أو إدارة شؤونه بنفسه أو بواسطة مدة سنة وتسبب غيابه في ضرر الغير يعتبر كالمفقود."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_111_19840609_OpEnact_d174293f32> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_111> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_111> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_111> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "على القاضي عندما يحكم بالفقيد أن يحصر أموال المفقود وأن يعين في حكمه مقدما من الأقارب أو غيرهم لتسيير أموال المفقود ويتسلم ما استحقه من ميراث أو تبرع مع مراعاة أحكام المادة (99) من هذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_112_19840609_OpEnact_57d44a0035> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_112> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_112> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_112> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "لزوجة المفقود أو الغائب أن تطلب الطلاق بناء على الفقرة الخامسة من المادة 53 من هذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_113_19840609_OpEnact_13ca3f913a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_113> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_113> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_113> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجوز الحكم بموت المفقود في الحروب والحالات الاستثنائية بمضي أربع سنوات بعد التحري ، وفي الحالات التي تغلب فيها السلامة يفوض الأمر إلى القاضي في تقدير المدة المناسبة بعد مضي أربع سنوات."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_114_19840609_OpEnact_fae80b86b5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_114> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_114> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_114> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يصدر الحكم بفقدان أو موت المفقود بناء على طلب أحد الورثة أو من له مصلحة أو النيابة العامة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_115_19840609_OpEnact_b7a2c438de> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_115> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_115> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_115> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "لا يورث المفقود ولا تقسم أمواله إلا بعد صدور الحكم بموته ، و في حالة رجوعه أو ظهوره حيا يسترجع ما بقى عينا من أمواله أو قيمة ما بيع منها ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_116_19840609_OpEnact_885598e56d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_116> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_116> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_116> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المادة 116 : الكفالة التزام على وجه التبرع بالقيام بولد قاصر من نفقة وتربية ورعاية قيام الأب بابنه وتتم بعقد شرعي."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_117_19840609_OpEnact_6889ddb96c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_117> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_117> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_117> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المادة 117 : يجب أن تكون الكفالة أمام المحكمة أو أمام الموثق وأن تتم برضا من له أبوان."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_118_19840609_OpEnact_93c6bb5e30> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_118> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_118> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_118> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المادة 118 : يشترط أن يكون الكافل مسلما، عاقلا أهلا للقيام بشؤون المكفول وقادرا على رعايته."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_119_19840609_OpEnact_f310297e08> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_119> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_119> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_119> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المادة 119 : الولد المكفول إما أن يكون مجهول النسب أو معلوم النسب."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_11_19840609_OpEnact_1055b4bacb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_11> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_11> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_11> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تعقد المرأة الراشدة زواجها بحضور واليها وهو أبوها أو أحد أقاربها أو أي شخص آخر تختاره. دون الإخلال بأحكام المادة 7 من هذا القانون، يتولى زواج القصر أولياؤهم وهم الأب، فأحد الأقارب الأولين والقاضي ولي من لا ولي له."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_120_19840609_OpEnact_9a1bd1a605> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_120> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_120> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_120> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المادة 120 : يجب أن يحتفظ الولد المكفول بنسبه الأصلي إن كان معلوم النسب وإن كان مجهول النسب تطبق عليه المادة 64 من قانون الحالة المدنية ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_121_19840609_OpEnact_b7e526f81c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_121> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_121> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_121> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المادة 121 : تخول الكفالة الكافل الولاية القانونية وجميع المنح العائلية والدراسية التي يتمتع بها الولد الأصلي."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_122_19840609_OpEnact_8a731e5c60> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_122> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_122> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_122> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المادة 122 : يدير الكافل أموال الولد المكفول المكتسبة من الإرث والوصية، أو الهبة لصالح الولد المكفول."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_123_19840609_OpEnact_b9ffa4f067> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_123> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_123> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_123> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المادة 123 : يجوز للكافل أن يوصي أو يتبرع للمكفول بماله في حدود الثلث ، وإن أوصى أو تبرع بأكثر من ذلك، بطل ما زاد على الثلث إلا إذا أجازه الورثة."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_124_19840609_OpEnact_4728ed7634> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_124> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_124> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_124> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المادة 124 : إذا طلب الأبوان أو أحدهما عودة الولد المكفول إلى ولايتهما يخير الولد في الالتحاق بهما إذا بلغ سن التمييز وإن لم يكن مميزا لا يسلم إلا بإذن من القاضي مع مراعاة مصلحة المكفول."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_125_19840609_OpEnact_1a26e8bdd8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_125> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_125> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_125> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المادة 125 : التخلي عن الكفالة يتم أمام الجهة التي أقرت الكفالة ، وأن يكون بعلم النيابة العامة وفي حالة الوفاة تنتقل الكفالة إلى الورثة إن التزموا بذلك وإلا فعلى القاضي أن يسند أمر القاصر إلى الجهة المختصة بالرعاية."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_126_19840609_OpEnact_058d1c8faf> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_126> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_126> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_126> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "المادة 126 : أسباب الإرث : القرابة، والزوجية."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_127_19840609_OpEnact_408c067332> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_127> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_127> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_127> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يستحق الإرث بموت المورث حقيقة أو باعتباره ميتا بحكم القاضي."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_128_19840609_OpEnact_da42de3554> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_128> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_128> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_128> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يشترط لاستحقاق الإرث أن يكون الوارث حيا أو حملا وقت افتتاح التركة ، مع ثبوت سبب الإرث وعدم وجود مانع من الإرث."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_129_19840609_OpEnact_07baaa3582> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_129> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_129> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_129> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا توفى اثنان أو أكثر ولم يعلم أيهم هلك أولا فلا استحقاق لأحدهم في تركة الآخر سواء كان موتهم في حادث واحد أم لا."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_12_19840609_OpEnact_f2d4440d4e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_12> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_12> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_12> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_130_19840609_OpEnact_39835cd2e8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_130> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_130> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_130> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يوجب النكاح التوارث بين الزوجين ولو لم يقع بناء."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_131_19840609_OpEnact_f48eee5195> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_131> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_131> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_131> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا ثبت بطلان النكاح فلا توارث بين الزوجين."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_132_19840609_OpEnact_f9c7d30b6b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_132> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_132> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_132> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا توفي أحد الزوجين قبل صدور الحكم بالطلاق أو كانت الوفاة في عدة الطلاق ، استحق الحي منهما الإرث ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_133_19840609_OpEnact_68d5c15bb9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_133> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_133> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_133> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا كان الوارث مفقودا ولم يحكم بموته يعتبر حيا وفقا لأحكام المادة 113 من هذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_134_19840609_OpEnact_52988f8a6b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_134> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_134> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_134> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "لا يرث الحمل إلا إذا ولد حيا ، ويعتبر حيا إذا استهل صارخا أو بدت منه علامة ظاهرة بالحياة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_135_19840609_OpEnact_b0f45d1d91> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_135> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_135> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_135> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يمنع من الميراث الأشخاص الآتية أوصافهم : 1- قاتل المورث عمدا أو عدوانا سواء كان القاتل فاعلا أصليا أو شريكا، 2- شاهد الزور الذي أدت شهادته إلى الحكم بالإعدام وتنفيذه، 3- العالم بالقتل أو تدبيره إذا لم يخبر السلطات المعنية."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_136_19840609_OpEnact_94eff9c498> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_136> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_136> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_136> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الممنوع من الإرث للأسباب المذكورة أعلاه لا يحجب غيره."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_137_19840609_OpEnact_7a7c8301f2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_137> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_137> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_137> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يرث القاتل خطأ من المال دون الدية أو التعويض."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_138_19840609_OpEnact_2e8c69ee67> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_138> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_138> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_138> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يمنع من الإرث اللعان والردة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_139_19840609_OpEnact_936e85f057> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_139> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_139> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_139> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "ينقسم الورثة إلى: 1- أصحاب فروض، 2- عصبة، 3- ذوي الأرحام."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_13_19840609_OpEnact_a6a1315516> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_13> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_13> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_13> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "لا يجوز للولي، أبا كان أو غيره، أن يجبر القاصرة التي هي في ولايته على الزواج ، و لا يجوز له أن يزوجها بدون موافقتها ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_140_19840609_OpEnact_64358aadbb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_140> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_140> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_140> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "ذوو الفروض هم الذين حددت أسهمهم في التركة شرعا."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_141_19840609_OpEnact_523e801f38> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_141> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_141> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_141> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يرث من الرجال الأب والجد للأب، وإن علا، والزوج، والأخ للأم، والأخ الشقيق، في المسألة العمرية."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_142_19840609_OpEnact_45718e2053> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_142> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_142> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_142> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يرث من النساء البنت وبنت الابن، وإن نزل، والأم والزوجة، والجدة من الجهتين وإن علت، والأخت الشقيقة، والأخت لأب، والأخت لأم."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_143_19840609_OpEnact_43a606b71f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_143> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_143> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_143> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الفروض المحددة ستة وهي : النصف، والربع، والثمن، والثلثان، والثلث، والسدس. أصحاب النصف"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_144_19840609_OpEnact_436458692e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_144> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_144> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_144> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "أصحاب النصف خمسة وهم : 1- الزوج و يستحق النصف من تركة زوجته بشرط عدم وجود الفرع الوارث لها ، 2- البنت بشرط إنفرادها عن ولد الصلب ذكرا كان أو أنثى ، 3- بنت الابن بشرط إنفرادها عن ولد الصلب ذكرا كان أو أنثى وولد الابن في درجتها ، 4- الأخت الشقيقة بشرط إنفرادها، وعدم وجود الشقيق والأب، وولد الصلب، وولد الابن ذكرا أو أنثى، وعدم وجود الجد الذي يعصبها ، 5- الأخت لأب بشرط انفرادها وعدم وجود الأخ والأخت لأب، وعدم وجود من ذكر في الشقيقة . أصحاب الربع"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_145_19840609_OpEnact_7271a71a95> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_145> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_145> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_145> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "أصحاب الربع اثنان وهما : 1- الزوج عند وجود الفرع الوارث لزوجته ، 2- الزوجة أو الزوجات بشرط عدم وجود الفرع الوارث للزوج ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_146_19840609_OpEnact_14c5bfe875> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_146> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_146> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_146> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "وارث الثمن أصحاب الثمن الزوجة أو الزوجات عند وجود الفرع الوارث للزوج . أصحاب الثلثين"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_147_19840609_OpEnact_3b32b785ec> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_147> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_147> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_147> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "أصحاب الثلثين أربعة وهن : 1- بنتان فأكثر بشرط عدم وجود الابن ، 2- بنتا الابن فأكثر بشرط عدم وجود ولد الصلب، وابن الابن في درجتهما ، 3- الشقيقتان فأكثر بشرط عدم وجود الشقيق الذكر، أو الأب أو ولد الصلب ، 4- الأختان لأب فأكثر بشرط عدم وجود الأخ لأب، ومن ذكر في الشقيقتين . أصحاب الثلث"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_148_19840609_OpEnact_3c07320b57> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_148> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_148> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_148> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "أصحاب الثلث ثلاثة وهم : 1- الأم بشرط عدم وجود الفرع الوارث أو عدد من الإخوة سواء كانوا أشقاء أو لأب أو لأم ولو لم يرثوا ، 2- الإخوة لأم بشرط انفرادهم عن الأب، والجد للأب، وولد الصلب وولد الابن ذكرا كان أو أنثى ، 3- الجد إن كان مع إخوة وكان الثلث أحضي له . أصحاب السدس"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_149_19840609_OpEnact_d133a0309a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_149> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_149> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_149> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "أصحاب السدس سبعة هم : 1- الأب بشرط وجود الولد، أو ولد الابن ذكرا كان أو أنثى ، 2- الأم بشرط وجود فرع وارث أو عدد من الإخوة سواء كانوا وارثين أو محجوبين ، 3- الجد للأب عند وجود الولد، أو ولد الابن، وعند عدم وجود الأب ، 4- الجدة سواء لأب أو لأم وكانت منفردة، فان اجتمعت جدتان وكانتا في درجة واحدة قسم السدس بينهما، أو كانت التي للأم أبعد، فان كانت هي الأقرب اختصت بالسدس ، 5- بنت الابن ولو تعددت بشرط أن تكون مع بنت واحدة وأن لا يكون معها ابن ابن في درجتها ، 6- الأخت للأب ولو تعددت بشرط أن تكون مع شقيقة واحدة، وانفرادها عن الأخ للأب، والأب والولد ذكرا كان أو أنثى 7- الأخ للأم بشرط أن يكون منفردا ذكرا كان أو أنثى، وعدم وجود الأصل والفرع الوارث ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_14_19840609_OpEnact_b1d32a6046> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_14> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_14> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_14> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الصداق هو ما يدفع نحلة للزوجة من نقود أو غيرها من كل ما هو مباح شرعا وهو ملك لها تتصرف فيه كما تشاء ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_150_19840609_OpEnact_7a7df2393a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_150> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_150> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_150> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "العاصب هو من يستحق التركة كلها عند إنفراده، أو ما بقى منها بعد أخذ أصحاب الفروض حقوقهم، وان استغرقت الفروض التركة فلا شيء له."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_151_19840609_OpEnact_63ab36042c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_151> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_151> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_151> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "العصبة ثلاثة أنواع : 1- عاصب بنفسه، 2- عاصب بغيره. 3- عاصب غيره. العاصب بنفسه"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_152_19840609_OpEnact_a2d1b3b3f7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_152> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_152> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_152> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "العاصب بنفسه هو كل ذكر ينتمي إلى الهالك، بواسطة ذكر."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_153_19840609_OpEnact_fdf4fab1b3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_153> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_153> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_153> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "العصبة بالنفس أربع جهات يقدم بعضها على بعض عند الاجتماع حسب الترتيب الآتي: 1- جهة البنوة وتشمل الابن وابن الابن مهما نزلت درجته، 2- جهة الأبوة وتشمل الأب، والجد الصحيح مهما علا . مع مر اعاة أحوال الجد، 3- جهة الأخوة وتشمل الإخوة الأشقاء أو لأب وأبناءهم مهما نزلوا، 4- جهة العمومة وتشمل أعمام الميت، وأعمام أبيه، وأعمام جده مهما علا، وأبناءهم مهما نزلوا."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_154_19840609_OpEnact_06f4a83300> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_154> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_154> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_154> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا كان الموجود من العصبة أكثر من واحد واتحدوا في الجهة كان الترجيح بينهم بالدرجة فيقدم أقربهم درجة إلى الميت، و إذا اتحدوا في الجهة والدرجة كان الترجيح بقوة القرابة فمن كان ذا قرابتين قدم على من كان ذا قرابة واحدة، و إذا اتحدوا في الجهة والدرجة والقرابة ورثوا بالتعصيب واشتركوا في المال بالسوية. العاصب بغيره"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_155_19840609_OpEnact_9094ba4960> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_155> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_155> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_155> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "العاصب بغيره هو كل أنثى عصبها ذكر وهي : 1- البنت مع أخيها، 2- بنت الابن مع أخيها، أو ابن عمها المساوي لها في الدرجة أو ابن ابن عمها الأسفل درجة بشرط أن لا ترث بالفرض ، 3- الأخت الشقيقة مع أخيها الشقيق، 4- الأخت لأب مع أخيها لأب. وفي كل هذه الأحوال، يكون الإرث للذكر مثل حظ الأنثيين. العاصب مع غيره"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_156_19840609_OpEnact_7110c99820> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_156> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_156> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_156> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "العاصب مع غيره : الأخت الشقيقة، أو لأب وإن تعددت عند وجود واحدة فأكثر من بنات الصلب، أو بنات الابن بشرط عدم وجود الأخ المساوي لها في الدرجة، أو الجد ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_157_19840609_OpEnact_a817f3eec9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_157> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_157> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_157> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "لا تكون الأخت لأب عاصبة إلا عند عدم وجود أخت شقيقة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_158_19840609_OpEnact_98290af0b9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_158> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_158> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_158> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا اجتمع الجد العاصب مع الإخوة الأشقاء ، أو مع الإخوة للأب ذكورا أو إناثا أو مختلطين فله الأفضل من جميع ثلث المال أو المقاسمة . وإذا اجتمع مع الإخوة و ذوي الفروض فله الأفضل من : سدس جميع المال، أو ثلث ما بقى بعد ذوي الفروض ، أو مقاسمة الإخوة كذكر منهم."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_159_19840609_OpEnact_5047c32b93> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_159> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_159> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_159> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الحجب هو منع الوارث من الميراث كلا أو بعضا وهو نوعان : 1- حجب نقصان ، 2- حجب إسقاط . حجب النقصان"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_15_19840609_OpEnact_750777deb7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_15> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_15> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_15> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يحدد الصداق في العقد، سواء كان معجلا أو مؤجلا . في حالة عدم تحديد قيمة الصداق ، تستحق الزوجة صداق المثل ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_160_19840609_OpEnact_68cc1c0d66> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_160> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_160> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_160> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الورثة الذين لهم فرضان خمسة وهم : الزوج ، و الزوجة ، و الأم ، و بنت الابن ، و الأخت لأب . 1- الزوج يرث النصف عند عدم وجود الفرع الوارث ، والربع عند وجوده ، 2- الزوجة أو الزوجات ترث الربع عند عدم وجود الفرع الوارث ، والثمن عند وجوده ، 3- الأم ترث الثلث عند عدم وجود الفرع الوارث، أو عدم وجود عدد من الإخوة أو الأخوات مطلقا ، وترث السدس مع وجود من ذكر ، 4- بنت الابن ترث النصف إذا انفردت ، والسدس إذا كانت مع بنت الصلب الواحدة ، وفي حالة تعدد بنات الابن يرثن السدس بدل الثلثين وحكم كل بنت ابن مع بنت ابن أعلى منها درجة كحكم بنت الابن مع بنت الصلب، 5- الأخت لأب ترث النصف إذا انفردت ، والسدس إذا كانت مع الأخت الشقيقة ، وفي حالة تعدد الأخوات للأب مع الأخت الشقيقة يشتركن في السدس. حجب الإسقاط"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_161_19840609_OpEnact_b9daae5ac0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_161> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_161> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_161> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تحجب الأم كل جدة ، و تحجب الجدة لأم القريبة الجدة لأب البعيدة و يحجب الأب و الجد أصلهما من الجدات ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_162_19840609_OpEnact_e6cdf80b6b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_162> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_162> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_162> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يحجب كل من الأب ، و الجد الصحيح وإن علا، و الولد و ولد الابن وان نزل، أولاد الأخ ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_163_19840609_OpEnact_0e4cca9480> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_163> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_163> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_163> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يحجب كل من الابن و ابن الابن وان نزل بنت الابن التي تكون انزل منه درجة و يحجبهما أيضا بنتان أو بنتا ابن أعلى منها درجة ما لم يكن معها من يعصبها ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_164_19840609_OpEnact_fc1cecb92f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_164> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_164> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_164> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يحجب كل من الأب و الابن و ابن الابن وان نزل، الأخت الشقيقة و يحجب الأخت لأب كل من الأب ، و الابن ، و ابن الابن وان نزل، و الأخ الشقيق و الأخت الشقيقة إذا كانت عاصبة مع غيرها ، والأختين الشقيقتين، إذا لم يوجد أخ للأب ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_165_19840609_OpEnact_c2174e27ef> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_165> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_165> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_165> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يحجب الأخ للأب أبناء الإخوة الأشقاء أو الأب . يحجب أبناء الإخوة الأشقاء أبناء الإخوة لأب ، يحجب أبناء الإخوة الأشقاء أولاد الأعمام وبنيهم ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_166_19840609_OpEnact_daac3bac55> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_166> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_166> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_166> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "العول هو زيادة سهام أصحاب الفروض على أصل المسألة. فإذا زادت أنصبة الفروض عليها قسمت التركة بينهم بنسبة أنصبائهم في الإرث. الرد على ذوي الفروض"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_167_19840609_OpEnact_a9cbb16c91> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_167> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_167> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_167> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا لم تستغرق التركة ولم يوجد عصبة من النسب رد الباقي على غير الزوجين من أصحاب الفروض بنسبة فروضهم. ويرد باقي التركة إلى أحد الزوجين إذا لم يوجد عصبة من النسب أو أحد أصحاب الفروض النسبية، أو أحد ذوي الأرحام . الدفع إلى ذوي الأرحام"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_168_19840609_OpEnact_6ce2ba9893> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_168> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_168> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_168> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يرث ذوو الأرحام عند الاستحقاق على الترتيب الآتي : أولاد البنات وان نزلوا، وأولاد بنات الابن وان نزلوا، فأولادهم بالميراث أقربهم إلى الميت درجة، فان استووا في الدرجة فولد صاحب الفرض أولى من ولد ذوي الرحم، وان استووا في الدرجة ولم يكن فيهم ولد صاحب فرض أو كانوا كلهم يدلون بصاحب فرض اشتركوا في الإرث."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_169_19840609_OpEnact_1768778f85> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_169> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_169> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_169> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "من توفى وله أحفاد وقد مات مورثهم قبله أو معه وجب تنزيلهم منزلة أصلهم في التركة بالشرائط التالية ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_16_19840609_OpEnact_a71e7e372c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_16> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_16> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_16> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تستحق الزوجة الصداق كاملا بالدخول، أو بوفاة الزوج ، و تستحق نصفه عند الطلاق قبل الدخول ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_170_19840609_OpEnact_c35b5ed7b5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_170> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_170> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_170> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "أسهم الأحفاد تكون بمقدار حصة أصلهم لو بقي حيا على أن لا يتجاوز ذلك ثلث التركة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_171_19840609_OpEnact_8b8672bc71> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_171> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_171> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_171> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "لا يستحق هؤلاء الأحفاد التنزيل إن كانوا وارثين للأصل جدا كان أو جدة أو كان قد أوصى لهم، أو أعطاهم في حياته بلا عوض مقدار ما يستحق بهذه الوصية ، فان أوصى لهم أو لأحدهم بأقل من ذلك وجب التنزيل بمقدار ما يتم به نصيبهم أو نصيب أحدهم من التركة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_172_19840609_OpEnact_3e1d6018e7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_172> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_172> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_172> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "أن لا يكون الأحفاد قد ورثوا من أبيهم أو أمهم ما لا يقل عن مناب مورثهم من أبيه أو أمه . ويكون هذا التنزيل للذكر مثل حظ الأنثيين."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_173_19840609_OpEnact_df2b856cb9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_173> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_173> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_173> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يوقف من التركة للحمل الأكثر من حظ ابن واحد أو بنت واحدة إذا كان الحمل يشارك الورثة أو يحجبهم حجب نقصان ، فان كان يحجبهم حجب حرمان يوقف الكل ولا تقسم التركة إلى أن تضع الحامل حملها ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_174_19840609_OpEnact_2c3c667930> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_174> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_174> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_174> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا ادعت المرأة الحمل وكذبها الورثة تعرض على أهل المعرفة مع مراعاة أحكام المادة 43 من هذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_175_19840609_OpEnact_ff5792b7c2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_175> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_175> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_175> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "لا يفرض للأخت مع الجد في مسألة إلا في الاكدرية وهي : زوج ، و أم ، و أخت شقيقة أو لأب ، و جد فيضم الجد ما حسب له إلى ما حسب لها ويقسمان للذكر مثل حظ الأنثيين، أصلها من ستة، وتعول إلى تسعة، وتصح من سبعة وعشرين للزوج تسعة وللأم ستة، وللأخت أربعة، وللجد ثمانية. مسألة مشتركة"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_176_19840609_OpEnact_ec699ef98b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_176> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_176> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_176> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يأخذ الذكر من الإخوة كالأنثى في المشتركة ، وهي زوج و أم أو جدة و إخوة لأم ، و إخوة أشقاء ، فيشتركان في الثلث الإخوة للأم و الإخوة الأشقاء الذكور والإناث في ذلك سواء على عدد رؤوسهم لأن جميعهم من أم واحدة. مسألة الغراوين"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_177_19840609_OpEnact_0cbde1a12f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_177> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_177> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_177> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا اجتمعت زوجة ، و أبوان ، فللزوجة الربع وللأم ثلث ما بقى وهو الربع وللأب ما بقي، فإذا اجتمع زوج و أبوان فللزوج النصف وللأم ثلث ما بقي وهو السدس وما بقي للأب. مسألة المباهلة"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_178_19840609_OpEnact_2145bcb7e9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_178> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_178> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_178> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا اجتمع زوج ، و أم ، و أخت شقيقة أو لأب كان للزوج النصف، وللأخت النصف وللأم الثلث أصلها من ستة وتعول إلى ثمانية للزوج ثلاثة، وللأخت ثلاثة وللأم اثنان. مسألة المنبرية"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_179_19840609_OpEnact_1385271197> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_179> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_179> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_179> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا اجتمعت زوجة و بنتان و أبوان صحت فريضتهم من أربعة وعشرين وتعول إلى سبعة وعشرين، للبنتين الثلثان - ستة عشر - وللأبوين الثلث - ثمانية - وللزوجة الثمن - ثلاثة - ويصير ثمنها تسعا."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_17_19840609_OpEnact_8d773c1c6a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_17> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_17> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_17> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "في حالة النزاع في الصداق بين الزوجين أو ورثتهما وليس لأحدهما بينة وكان قبل الدخول ، فالقول للزوجة أو ورثتها مع اليمين و إذا كان بعد البناء فالقول للزوج أو ورثته مع اليمين."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_180_19840609_OpEnact_6ade22fe85> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_180> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_180> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_180> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يؤخذ من التركة حسب الترتيب الآتي: 1- مصاريف التجهيز، والدفن بالقدر المشروع، 2- الديون الثابتة في ذمة المتوفى، 3- الوصية."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_181_19840609_OpEnact_31d41e6b15> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_181> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_181> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_181> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يراعي في قسمة التركات أحكام المادتين 109 و 173 من هذا القانون وما ورد في القانون المدني فيما يتعلق ب الملكية الشائعة . وفي حالة وجود قاصر بين الورثة يجب أن تكون القسمة عن طريق القضاء ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_182_19840609_OpEnact_1c73f97e84> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_182> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_182> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_182> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "في حالة عدم وجود ولي أو وصي يجوز لمن له مصلحة أو للنيابة العامة أن يتقدم إلى المحكمة بطلب تصفية التركة وبتعيين مقدم ، و لرئيس المحكمة أن يقرر وضع الأختام، وإيداع النقود والأشياء ذات القيمة، وأن يفصل في الطلب ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_183_19840609_OpEnact_d9fb04fe58> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_183> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_183> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_183> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجب أن تتبع الإجراءات المستعجلة في قسمة التركات فيما يتعلق بالمواعيد وسر موضوعها، وطرق الطعن في أحكامها ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_184_19840609_OpEnact_cac76bd94e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_184> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_184> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_184> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الوصية تمليك مضاف إلى ما بعد الموت بطريق التبرع."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_185_19840609_OpEnact_f90c3b166e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_185> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_185> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_185> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تكون الوصية في حدود ثلث التركة، وما زاد على الثلث توقف على إجازة الورثة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_186_19840609_OpEnact_c418e7a9bd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_186> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_186> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_186> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يشترط في الموصي أن يكون سليم العقل، بالغا من العمر تسع عشرة (19) سنة على الأقل ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_187_19840609_OpEnact_69e1dfec9d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_187> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_187> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_187> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تصح الوصية للحمل بشرط أن يولد حيا ، وإذا ولد توائم يستحقونها بالتساوي ولو اختلف الجنس."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_188_19840609_OpEnact_21a2336b44> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_188> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_188> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_188> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "لا يستحق الوصية من قتل الموصي عمدا."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_189_19840609_OpEnact_58271b2494> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_189> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_189> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_189> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "لا وصية لوارث إلا إذا أجازها الورثة بعد وفاة الموصي ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_18_19840609_OpEnact_028cc45112> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_18> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_18> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_18> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يتم عقد الزواج أمام الموثق أو أمام موظف مؤهل قانونا مع مراعاة ما ورد في المادتين 9 و 9 مكرر من هذا القانون."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_190_19840609_OpEnact_8c5851eb66> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_190> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_190> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_190> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "للموصي أن يوصي بالأموال التي يملكها والتي تدخل في ملكه قبل موته عينا أو منفعة ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_191_19840609_OpEnact_6f1e1b5b7d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_191> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_191> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_191> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تثبت الوصية : 1- بتصريح الموصي أمام الموثق وتحرير عقد بذلك، 2- وفي حالة وجود مانع قاهر تثبت الوصية بحكم، ويؤشر به على هامش أصل الملكية."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_192_19840609_OpEnact_269ab856bc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_192> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_192> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_192> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يجوز الرجوع في الوصية صراحة أو ضمنا ، فالرجوع الصريح يكون بوسائل إثباتها والضمني يكون بكل تصرف يستخلص منه الرجوع فيها."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_193_19840609_OpEnact_bfb00882c8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_193> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_193> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_193> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "رهن الموصى به لا يعد رجوعا في الوصية ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_194_19840609_OpEnact_762040b75c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_194> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_194> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_194> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا أوصي لشخص ثم أوصي لثان يكون الموصى به مشتركا بينهما."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_195_19840609_OpEnact_acc97d3278> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_195> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_195> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_195> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا كانت الوصية لشخصين معينين دون أن يحدد ما يستحقه كل منهما ومات أحدهما وقت الوصية أو بعدها قبل وفاة الموصي، فالوصية كلها للحي منهما ، أما إذا حدد ما يستحقه كل منهما فالحي لا يستحق إلا ما حدد له."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_196_19840609_OpEnact_870af5b39e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_196> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_196> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_196> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الوصية ، بمنفعة لمدة غير محدودة تنتهي بوفاة الموصى له وتعتبر عمرى."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_197_19840609_OpEnact_36552cded8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_197> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_197> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_197> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "يكون قبول الوصية صراحة أو ضمنا بعد وفاة الوصي."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_198_19840609_OpEnact_517605c3d4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_198> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_198> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_198> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا مات الموصى له قبل القبول فلورثته الحق في القبول أو الرد ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_199_19840609_OpEnact_7303da66f3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_199> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_199> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_199> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "إذا علقت الوصية على شرط استحقها الموصى له بعد إنجاز الشرط وإذا كان الشرط غير صحت الوصية وبطل الشرط."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_19_19840609_OpEnact_11e5550d9a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_19> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_19> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_19> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "للزوجين أن يشترطا في عقد الزواج أو في عقد رسمي لاحق كل الشروط التي يريانها ضرورية ، ولا سيما شرط عدم تعدد الزوجات و عمل المرأة ، ما لم تتنافى هذه الشروط مع أحكام هذا القانون ."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_1_19840609_OpEnact_1a36f4b459> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
