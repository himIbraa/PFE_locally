    dzdoc:position 0 ;
    dzdoc:text "العاصب هو من يستحق التركة كلها عند إنفراده، أو ما بقى منها بعد أخذ أصحاب الفروض حقوقهم، وان استغرقت الفروض التركة فلا شيء له."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_152_defocc_00abd3782256> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 52 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:عاصب_بنفسه ;
