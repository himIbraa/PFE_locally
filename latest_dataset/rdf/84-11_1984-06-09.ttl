<https://legal.dz/resource/law/1984-06-09/84-11#art_126> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_7> ;
    dzdoc:eId "art_126" ;
    dzdoc:fullText "المادة 126 : أسباب الإرث : القرابة، والزوجية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_126> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_126_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_126_19840609_OpEnact_058d1c8faf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "126" ;
    dzdoc:position 133 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_130> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_1> ;
    dzdoc:eId "art_130" ;
    dzdoc:fullText "يوجب النكاح التوارث بين الزوجين ولو لم يقع بناء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_130> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_130_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_130_19840609_OpEnact_39835cd2e8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
