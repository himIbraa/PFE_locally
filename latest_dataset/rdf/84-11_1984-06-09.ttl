<https://legal.dz/resource/law/1984-06-09/84-11#version_art_149> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "أصحاب السدس سبعة هم : 1- الأب بشرط وجود الولد، أو ولد الابن ذكرا كان أو أنثى ، 2- الأم بشرط وجود فرع وارث أو عدد من الإخوة سواء كانوا وارثين أو محجوبين ، 3- الجد للأب عند وجود الولد، أو ولد الابن، وعند عدم وجود الأب ، 4- الجدة سواء لأب أو لأم وكانت منفردة، فان اجتمعت جدتان وكانتا في درجة واحدة قسم السدس بينهما، أو كانت التي للأم أبعد، فان كانت هي الأقرب اختصت بالسدس ، 5- بنت الابن ولو تعددت بشرط أن تكون مع بنت واحدة وأن لا يكون معها ابن ابن في درجتها ، 6- الأخت للأب ولو تعددت بشرط أن تكون مع شقي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_149_19840609_OpEnact_d133a0309a> ;
    dzdoc:replacementText "أصحاب السدس سبعة هم : 1- الأب بشرط وجود الولد، أو ولد الابن ذكرا كان أو أنثى ، 2- الأم بشرط وجود فرع وارث أو عدد من الإخوة سواء كانوا وارثين أو محجوبين ، 3- الجد للأب عند وجود الولد، أو ولد الابن، وعند عدم وجود الأب ، 4- الجدة سواء لأب أو لأم وكانت منفردة، فان اجتمعت جدتان وكانتا في درجة واحدة قسم السدس بينهما، أو كانت التي للأم أبعد، فان كانت هي الأقرب اختصت بالسدس ، 5- بنت الابن ولو تعددت بشرط أن تكون مع بنت واحدة وأن لا يكون معها ابن ابن في درجتها ، 6- الأخت للأب ولو تعددت بشرط أن تكون مع شقيقة واحدة، وانفرادها عن الأخ للأب، والأب والولد ذكرا كان أو أنثى 7- الأخ للأم بشرط أن يكون منفردا ذكرا كان أو أنثى، وعدم وجود الأصل والفرع الوارث ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_149> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_149> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

