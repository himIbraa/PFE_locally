<https://legal.dz/resource/law/1984-06-09/84-11#version_art_87> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون الأب وليا على أولاده القصر، وبعد وفاته تحل الأم محله قانونا. وفي حالة غياب الأب أو حصول مانع له ، تحل الأم محله في القيام بالأمور المستعجلة المتعلقة بالأولاد . وفي حالة الطلاق ، يمنح القاضي الولاية لمن أسندت له حضانة الأولاد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_87_19840609_OpEnact_59307e84ef> ;
    dzdoc:replacementText "يكون الأب وليا على أولاده القصر، وبعد وفاته تحل الأم محله قانونا. وفي حالة غياب الأب أو حصول مانع له ، تحل الأم محله في القيام بالأمور المستعجلة المتعلقة بالأولاد . وفي حالة الطلاق ، يمنح القاضي الولاية لمن أسندت له حضانة الأولاد ."@ar ;
