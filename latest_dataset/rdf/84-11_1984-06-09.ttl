<https://legal.dz/resource/law/1984-06-09/84-11#art_45_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_5> ;
    dzdoc:eId "art_45_bis" ;
    dzdoc:fullText "يجوز للزوجين اللجوء إلى التلقيح الاصطناعي . يخضع التلقيح الاصطناعي للشروط الآتية : أن يكون الزواج شرعيا، أن يكون التلقيح برضا الزوجين وأثناء حياتهما، أن يتم بمني الزوج وبويضة رحم الزوجة دون غيرهما. لا يجوز اللجوء إلى التلقيح الاصطناعي باستعمال الأم البديلة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_45_bis_permission_0_ac1e5ade>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_45_bis_permission_1_bc91364c> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_45_bis_right_0_ac7624f0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_45_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_45_bis_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_45_bis_para_1>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_45_bis_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_45_bis_19840609_OpEnact_be048ffadf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_45_bis_obligation_0_cbd3410f> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/1984-06-09/84-11#art_45_bis_prohibition_0_bc91364c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "45 مكرر" ;
    dzdoc:position 50 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_13" ;
    dzdoc:fullText "لا يجوز للولي، أبا كان أو غيره، أن يجبر القاصرة التي هي في ولايته على الزواج ، و لا يجوز له أن يزوجها بدون موافقتها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_13_permission_0_c6f750ad> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_13> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_13_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_13_19840609_OpEnact_a6a1315516> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_13_obligation_0_d44a8b3f>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_13_obligation_1_b00fc069> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/1984-06-09/84-11#art_13_prohibition_0_c6f750ad> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "13" ;
    dzdoc:position 17 .

<https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_4> ;
    dzdoc:eId "book_4_book_4_sec_4_art_8" ;
    dzdoc:fullText "يسمح بالزواج بأكثر من زوجة واحدة في حدود الشريعة الإسلامية متى وجد المبرر الشرعي وتوفرت شروط ونية العدل . يجب على الزوج إخبار الزوجة السابقة والمرأة التي يقبل على الزواج بها وأن يقدم طلب الترخيص بالزواج إلى رئيس المحكمة لمكان مسكن الزوجية . يمكن رئيس المحكمة أن يرخص بالزواج الجديد، إذا تأكد من موافقتهما وأثبت الزوج المبرر الشرعي وقدرته على توفير العدل والشروط الضرورية للحياة الزوجية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_8_permission_0_2ace9dc7>,
        <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_8_permission_1_237d1159> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_8_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_8_para_1>,
        <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_8_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_8_19840609_OpEnact_92b50b16ce> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_8_obligation_0_7074e2ed> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "8" ;
    dzdoc:position 238 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_8_condition_0_dff61eb8>,
        <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_8_condition_1_e46ce996> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_9_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_9_bis" ;
    dzdoc:fullText "يجب أن تتوفر في عقد الزواج الشروط الآتية : أهلية الزواج، الصداق، الولي، شاهدان انعدام الموانع الشرعية للزواج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_9_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_9_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_9_bis_19840609_OpEnact_9d37db0553> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_9_bis_obligation_0_5c6b0bc3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "9 مكرر" ;
    dzdoc:position 13 .

