    dzdoc:eId "art_1" ;
    dzdoc:fullText "تخضع جميع العلاقات بين أفراد الأسرة لأحكام هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_1_para_0> ;
