<https://legal.dz/resource/law/1984-06-09/84-11#version_art_211> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للأبوين حق الرجوع في الهبة لولدهما مهما كانت سنه إلا في الحالات التالية: إذا كانت الهبة من أجل زواج الموهوب له، إذا كانت الهبة لضمان قرض أو قضاء دين، إذا تصرف الموهوب له في الشيء الموهوب ببيع، أو تبرع منه أو أدخل عليه ما غير طبيعته."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
