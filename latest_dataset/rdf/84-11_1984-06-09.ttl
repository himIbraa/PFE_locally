        <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_7_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_7_19840609_OpEnact_cb1eae3fcd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_7_obligation_0_92399e43> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
