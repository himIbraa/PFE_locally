<https://legal.dz/resource/law/1984-06-09/84-11#art_108> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_5> ;
    dzdoc:eId "art_108" ;
    dzdoc:fullText "يمكن رفع الحجر إذا زالت أسبابه بناء على طلب المحجور عليه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_108_permission_0_0cc7e29c> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_108_right_0_441fba03> ;
