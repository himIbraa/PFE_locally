<https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_4> ;
    dzdoc:eId "book_4_book_4_sec_4_art_1" ;
    dzdoc:fullText "تخضع جميع العلاقات بين أفراد الأسرة لأحكام هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_1_19840609_OpEnact_ff9424e4a2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_1_obligation_0_d845ea9c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة الأولى" ;
    dzdoc:position 232 ;
    dzdoc:usesTerm dzterm:family .

<https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:family ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_4> ;
    dzdoc:eId "book_4_book_4_sec_4_art_2" ;
    dzdoc:fullText "الأسرة هي الخلية الأساسية للمجتمع وتتكون من أشخاص تجمع بينهم صلة الزوجية وصلة القرابة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_2> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_2_defocc_31017ba24f0e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_2_19840609_OpEnact_d58db1c60b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 2" ;
    dzdoc:position 233 .

<https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:marriage ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_4> ;
    dzdoc:eId "book_4_book_4_sec_4_art_4" ;
    dzdoc:fullText "الزواج هو عقد رضائي يتم بين رجل وامرأة على الوجه الشرعي، من أهدافه، تكوين أسرة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_4> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_4_defocc_ed62c22c50ec> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_4_19840609_OpEnact_f7d95cd756> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "4" ;
    dzdoc:position 235 .

dzterm:family a skos:Concept,
