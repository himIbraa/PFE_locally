<https://legal.dz/resource/law/1984-06-09/84-11#version_art_182> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة عدم وجود ولي أو وصي يجوز لمن له مصلحة أو للنيابة العامة أن يتقدم إلى المحكمة بطلب تصفية التركة وبتعيين مقدم ، و لرئيس المحكمة أن يقرر وضع الأختام، وإيداع النقود والأشياء ذات القيمة، وأن يفصل في الطلب ."@ar ;
