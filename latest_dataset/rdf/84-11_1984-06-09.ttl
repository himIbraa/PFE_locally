dzterm:father a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الأب"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_102> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_5> ;
    dzdoc:eId "art_102" ;
    dzdoc:fullText "يكون الحجر بناء على طلب أحد الأقارب أو ممن له مصلحة ، أو من النيابة العامة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_102> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_102_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_102_19840609_OpEnact_bebc9b1500> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "102" ;
    dzdoc:position 109 ;
    dzdoc:usesTerm dzterm:prosecution .

<https://legal.dz/resource/law/1984-06-09/84-11#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_11" ;
    dzdoc:fullText "تعقد المرأة الراشدة زواجها بحضور واليها وهو أبوها أو أحد أقاربها أو أي شخص آخر تختاره. دون الإخلال بأحكام المادة 7 من هذا القانون، يتولى زواج القصر أولياؤهم وهم الأب، فأحد الأقارب الأولين والقاضي ولي من لا ولي له."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_11> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_11_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_11_19840609_OpEnact_1055b4bacb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "11" ;
    dzdoc:position 15 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_7> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_7> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_6> ;
    dzdoc:eId "art_114" ;
    dzdoc:fullText "يصدر الحكم بفقدان أو موت المفقود بناء على طلب أحد الورثة أو من له مصلحة أو النيابة العامة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_114> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_114_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_114_19840609_OpEnact_fae80b86b5> ;
