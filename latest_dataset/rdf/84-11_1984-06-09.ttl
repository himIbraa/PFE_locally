<https://legal.dz/resource/law/1984-06-09/84-11#art_36_obligation_0_9949d908_role_90dacc9eed> a dznorm:Role ;
    rdfs:label "الزوجين"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يجب على الزوجين :"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_36> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_36_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_36> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب على الزوجين : المحافظة على الروابط الزوجية وواجبات الحياة المشتركة، المعاشرة بالمعروف، وتبادل الاحترام والمودة والرحمة، التعاون على مصلحة الأسرة ورعاية الأولاد وحسن تربيتهم، التشاور في تسيير شؤون الأسرة وتباعد الولادات، حسن معاملة كل منهما لأبوي الآخر وأقاربه واحترامهم وزيارتهم، المحافظة على روابط القرابة والتعامل مع الوالدين الأقربين بالحسنى والمعروف، زيارة كل منهما لأبويه وأقاربه واستضافتهم بالمعروف."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_37_condition_0_2a21f7b9> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/law/1984-06-09/84-11#art_37_condition_0_2a21f7b9_action_0eff72ad84> ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/1984-06-09/84-11#art_37_condition_0_2a21f7b9_period_9751b14de0> ;
    dznorm:conditionText "يجوز للزوجين أن يتفقا في عقد الزواج أو في عقد رسمي لاحق، حول الأموال المشتركة بينهما، التي يكتسبانها خلال الحياة الزوجية وتحديد النسب التي تؤول إلى كل واحد منها."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_37> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_37_condition_0_2a21f7b9_action_0eff72ad84> a dznorm:Action ;
