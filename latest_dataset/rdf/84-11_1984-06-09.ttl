    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "82" ;
    dzdoc:position 89 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1984-06-09/84-11#art_82_extref_dce44844> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_82_condition_0_e5678e9d> .

