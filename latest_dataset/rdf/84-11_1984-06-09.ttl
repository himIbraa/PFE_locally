<https://legal.dz/resource/law/1984-06-09/84-11#version_art_45_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للزوجين اللجوء إلى التلقيح الاصطناعي . يخضع التلقيح الاصطناعي للشروط الآتية : أن يكون الزواج شرعيا، أن يكون التلقيح برضا الزوجين وأثناء حياتهما، أن يتم بمني الزوج وبويضة رحم الزوجة دون غيرهما. لا يجوز اللجوء إلى التلقيح الاصطناعي باستعمال الأم البديلة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
