<https://legal.dz/resource/law/1984-06-09/84-11#art_177_condition_1_05f65168> a dznorm:Condition ;
    dznorm:conditionText "فإذا اجتمع زوج وأبوان"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_177> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_177_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_177> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا اجتمعت زوجة، وأبوان، فللزوجة الربع وللأم ثلث ما بقى وهو الربع وللأب ما بقي، فإذا اجتمع زوج وأبوان فللزوج النصف وللأم ثلث ما بقي وهو السدس وما بقي للأب."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_177_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_177> ;
    dzdoc:position 1 ;
