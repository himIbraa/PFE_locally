    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الهبة في مرض الموت، والأمراض والحالات المخيفة، تعتبر وصية."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_205_19840609_OpEnact_470b9f25c9> a dzdoc:ArticleVersion ;
