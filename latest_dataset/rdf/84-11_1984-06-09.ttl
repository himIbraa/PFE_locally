<https://legal.dz/resource/law/1984-06-09/84-11#version_art_5> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الخطبة وعد بالزواج. يجوز للطرفين العدول عن الخطبة. إذا ترتب عن العدول عن الخطبة ضرر مادي أو معنوي لأحد الطرفين جاز الحكم له بالتعويض. يسترد الخاطب من المخطوبة شيئا مما أهداها إن كان العدول منه ، و عليه أن يرد للمخطوبة ما لم يستهلك مما أهدته له أو قيمته. وإن كان العدول من المخطوبة ، فعليها أن ترد للخاطب ما لم يستهلك من هدايا أو قيمته."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_5_19840609_OpEnact_4d5ee30a40> ;
    dzdoc:replacementText "الخطبة وعد بالزواج. يجوز للطرفين العدول عن الخطبة. إذا ترتب عن العدول عن الخطبة ضرر مادي أو معنوي لأحد الطرفين جاز الحكم له بالتعويض. يسترد الخاطب من المخطوبة شيئا مما أهداها إن كان العدول منه ، و عليه أن يرد للمخطوبة ما لم يستهلك مما أهدته له أو قيمته. وإن كان العدول من المخطوبة ، فعليها أن ترد للخاطب ما لم يستهلك من هدايا أو قيمته."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_5> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_5> ;
