    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحرم من النساء مؤقتا : المحصنة، المعتدة من طلاق أو وفاة، المطلقة ثلاثا، كما يحرم مؤقتا الجمع بين الأختين أو بين المرأة وعمتها أو خالتها، سواء كانت شقيقة أو لأب أو لأم أو من رضاع، زواج المسلمة مع غير المسلم."@ar ;
