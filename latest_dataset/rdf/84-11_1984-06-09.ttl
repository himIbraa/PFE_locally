<https://legal.dz/resource/law/1984-06-09/84-11#art_81> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_1> ;
    dzdoc:eId "art_81" ;
    dzdoc:fullText "من كان فاقد الأهلية أو ناقصها لصغر السن، أو جنون، أو عته، أو سفه ، ينوب عنه قانونا ولي أو وصي أو مقدم طبقا لأحكام هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_81> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_81_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_81_19840609_OpEnact_af82515bef> ;
