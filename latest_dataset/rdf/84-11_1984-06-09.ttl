<https://legal.dz/resource/law/1984-06-09/84-11#version_art_148> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "أصحاب الثلث ثلاثة وهم : 1- الأم بشرط عدم وجود الفرع الوارث أو عدد من الإخوة سواء كانوا أشقاء أو لأب أو لأم ولو لم يرثوا ، 2- الإخوة لأم بشرط انفرادهم عن الأب، والجد للأب، وولد الصلب وولد الابن ذكرا كان أو أنثى ، 3- الجد إن كان مع إخوة وكان الثلث أحضي له . أصحاب السدس"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_148_19840609_OpEnact_3c07320b57> ;
    dzdoc:replacementText "أصحاب الثلث ثلاثة وهم : 1- الأم بشرط عدم وجود الفرع الوارث أو عدد من الإخوة سواء كانوا أشقاء أو لأب أو لأم ولو لم يرثوا ، 2- الإخوة لأم بشرط انفرادهم عن الأب، والجد للأب، وولد الصلب وولد الابن ذكرا كان أو أنثى ، 3- الجد إن كان مع إخوة وكان الثلث أحضي له . أصحاب السدس"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_148> ;
