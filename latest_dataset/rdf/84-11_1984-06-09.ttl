<https://legal.dz/resource/law/1984-06-09/84-11#art_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:betrothal ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_5" ;
    dzdoc:fullText "الخطبة وعد بالزواج. يجوز للطرفين العدول عن الخطبة. إذا ترتب عن العدول عن الخطبة ضرر مادي أو معنوي لأحد الطرفين جاز الحكم له بالتعويض. يسترد الخاطب من المخطوبة شيئا مما أهداها إن كان العدول منه ، و عليه أن يرد للمخطوبة ما لم يستهلك مما أهدته له أو قيمته. وإن كان العدول من المخطوبة ، فعليها أن ترد للخاطب ما لم يستهلك من هدايا أو قيمته."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_5_permission_0_40e06a13> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_5_right_0_40e06a13>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_5_right_1_b88fa5a1>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_5_right_2_5c1b765d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_5> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_5_defocc_34de712d7bd1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_5_para_0>,
