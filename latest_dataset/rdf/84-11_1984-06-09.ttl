<https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_4> ;
    dzdoc:eId "book_4_book_4_sec_4_art_6" ;
    dzdoc:fullText "إن اقتران الفاتحة بالخطبة لا يعد زواجا. غير أن اقتران الفاتحة بالخطبة بمجلس العقد يعتبر زواجا متى توافر ركن الرضا وشروط الزواج المنصوص عليها في المادة 9 مكرر من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_6_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_6_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_book_4_book_4_sec_4_art_6_19840609_OpEnact_9207f6236a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "6" ;
    dzdoc:position 236 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_9_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_9_bis> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_6_condition_0_477a421a> .

dzterm:maintenance a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "النفقة"@ar,
        "تشمل النفقة : الغذاء والكسوة والعلاج، والسكن أو أجرته، وما يعتبر من الضروريات في العرف والعادة."@ar,
        "نفقة الأصول"@ar,
        "نفقة الأولاد"@ar,
        "نفقة الزوجة"@ar,
        "نفقة الولد"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_78_defocc_f2cd595cea20> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_4> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "يقوم المقدم مقام الوصي ويخضع لنفس الأحكام ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_100> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_100_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_100_19840609_OpEnact_63591ffc9c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_100_obligation_0_e165331d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 100" ;
    dzdoc:position 107 ;
    dzdoc:usesTerm dzterm:مقدم,
        dzterm:وصي .

<https://legal.dz/resource/law/1984-06-09/84-11#art_104> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_5> ;
    dzdoc:eId "art_104" ;
    dzdoc:fullText "إذا لم يكن للمحجور عليه ولي، أو وصي وجب على القاضي أن يعين في نفس الحكم مقدما لرعاية المحجور عليه والقيام بشؤونه مع مراعاة أحكام المادة 100 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_104> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_104_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_104_19840609_OpEnact_3940008621> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_104_obligation_0_1e3e0d39> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "104" ;
    dzdoc:position 111 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_100> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_100> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_104_condition_0_6663803e> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_120> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_7> ;
    dzdoc:eId "art_120" ;
    dzdoc:fullText "المادة 120 : يجب أن يحتفظ الولد المكفول بنسبه الأصلي إن كان معلوم النسب وإن كان مجهول النسب تطبق عليه المادة 64 من قانون الحالة المدنية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_120> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_120_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_120_19840609_OpEnact_9a1bd1a605> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_120_obligation_0_182716ca> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "120" ;
    dzdoc:position 127 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1984-06-09/84-11#art_120_extref_e2b9fc28> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_120_condition_0_785b7942> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_161> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_5> ;
    dzdoc:eId "art_161" ;
    dzdoc:fullText "تحجب الأم كل جدة ، و تحجب الجدة لأم القريبة الجدة لأب البعيدة و يحجب الأب و الجد أصلهما من الجدات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_161> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_161_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_161_19840609_OpEnact_b9daae5ac0> ;
