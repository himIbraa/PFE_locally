    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_2> ;
    dzdoc:position 0 ;
    dzdoc:text "الأسرة هي الخلية الأساسية للمجتمع وتتكون من أشخاص تجمع بينهم صلة الزوجية وصلة القرابة."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#book_4_book_4_sec_4_art_4_defocc_ed62c22c50ec> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 78 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
