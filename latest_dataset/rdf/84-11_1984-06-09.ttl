    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_7> ;
    dzdoc:eId "art_119" ;
    dzdoc:fullText "المادة 119 : الولد المكفول إما أن يكون مجهول النسب أو معلوم النسب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_119> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_119_para_0> ;
