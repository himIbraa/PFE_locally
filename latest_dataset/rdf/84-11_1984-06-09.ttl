<https://legal.dz/resource/law/1984-06-09/84-11#art_141_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_141> ;
    dzdoc:position 0 ;
    dzdoc:text "يرث من الرجال الأب والجد للأب، وإن علا، والزوج، والأخ للأم، والأخ الشقيق، في المسألة العمرية."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_141_right_0_d36be6e1> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_141> ;
    dznorm:position 0 ;
    dznorm:provisionText "يرث من الرجال الأب والجد للأب، وإن علا، والزوج، والأخ للأم، والأخ الشقيق، في المسألة العمرية."@ar ;
    dznorm:sourceArticle "art_141" .

<https://legal.dz/resource/law/1984-06-09/84-11#art_142_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_142> ;
    dzdoc:position 0 ;
    dzdoc:text "يرث من النساء البنت وبنت الابن، وإن نزل، والأم والزوجة، والجدة من الجهتين وإن علت، والأخت الشقيقة، والأخت لأب، والأخت لأم."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_142_right_0_7929c2b9> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_142> ;
    dznorm:position 0 ;
    dznorm:provisionText "يرث من النساء البنت وبنت الابن، وإن نزل، والأم والزوجة، والجدة من الجهتين وإن علت، والأخت الشقيقة، والأخت لأب، والأخت لأم."@ar ;
    dznorm:sourceArticle "art_142" .

<https://legal.dz/resource/law/1984-06-09/84-11#art_143_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_143> ;
    dzdoc:position 0 ;
    dzdoc:text "الفروض المحددة ستة وهي : النصف، والربع، والثمن، والثلثان، والثلث، والسدس."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_143_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_143> ;
    dzdoc:position 1 ;
    dzdoc:text "أصحاب النصف"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_144_condition_0_99628581> a dznorm:Condition ;
    dznorm:conditionText "بشرط عدم وجود الفرع الوارث لها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_144> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_144_condition_1_aafef550> a dznorm:Condition ;
    dznorm:conditionText "بشرط إنفرادها عن ولد الصلب ذكرا كان أو أنثى"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_144> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_144_condition_2_93909562> a dznorm:Condition ;
    dznorm:conditionText "بشرط إنفرادها عن ولد الصلب ذكرا كان أو أنثى وولد الابن في درجتها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_144> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_144_condition_3_67ae2193> a dznorm:Condition ;
    dznorm:conditionText "بشرط إنفرادها، وعدم وجود الشقيق والأب، وولد الصلب، وولد الابن ذكرا أو أنثى، وعدم وجود الجد الذي يعصبها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_144> ;
    dznorm:position 3 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_144_condition_4_ce128ece> a dznorm:Condition ;
    dznorm:conditionText "بشرط انفرادها وعدم وجود الأخ والأخت لأب، وعدم وجود من ذكر في الشقيقة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_144> ;
    dznorm:position 4 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_144_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_144> ;
    dzdoc:position 0 ;
    dzdoc:text "أصحاب النصف خمسة وهم : 1- الزوج ويستحق النصف من تركة زوجته بشرط عدم وجود الفرع الوارث لها، 2- البنت بشرط إنفرادها عن ولد الصلب ذكرا كان أو أنثى، 3- بنت الابن بشرط إنفرادها عن ولد الصلب ذكرا كان أو أنثى وولد الابن في درجتها، 4- الأخت الشقيقة بشرط إنفرادها، وعدم وجود الشقيق والأب، وولد الصلب، وولد الابن ذكرا أو أنثى، وعدم وجود الجد الذي يعصبها، 5- الأخت لأب بشرط انفرادها وعدم وجود الأخ والأخت لأب، وعدم وجود من ذكر في الشقيقة."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_144_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_144> ;
    dzdoc:position 1 ;
    dzdoc:text "أصحاب الربع"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_144_right_0_b23f4110> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_144> ;
    dznorm:position 0 ;
    dznorm:provisionText "يستحق النصف من تركة زوجته"@ar ;
    dznorm:sourceArticle "art_144" .

<https://legal.dz/resource/law/1984-06-09/84-11#art_145_condition_0_04b09efc> a dznorm:Condition ;
    dznorm:conditionText "عند وجود الفرع الوارث لزوجته"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_145> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_145_condition_1_84c1ce6c> a dznorm:Condition ;
    dznorm:conditionText "بشرط عدم وجود الفرع الوارث للزوج"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_145> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_145_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_145> ;
    dzdoc:position 0 ;
    dzdoc:text "أصحاب الربع اثنان وهما : 1- الزوج عند وجود الفرع الوارث لزوجته، 2- الزوجة أو الزوجات بشرط عدم وجود الفرع الوارث للزوج."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_146_condition_0_17045d48> a dznorm:Condition ;
    dznorm:conditionText "عند وجود الفرع الوارث للزوج"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_146> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_146_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_146> ;
    dzdoc:position 0 ;
    dzdoc:text "وارث الثمن"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_146_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_146> ;
    dzdoc:position 1 ;
    dzdoc:text "أصحاب الثمن"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_146_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_146> ;
    dzdoc:position 2 ;
    dzdoc:text "الزوجة أو الزوجات عند وجود الفرع الوارث للزوج."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_146_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_146> ;
    dzdoc:position 3 ;
    dzdoc:text "أصحاب الثلثين"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_147_condition_0_81486d73> a dznorm:Condition ;
    dznorm:conditionText "بشرط عدم وجود الابن"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_147> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_147_condition_1_b6c16504> a dznorm:Condition ;
    dznorm:conditionText "بشرط عدم وجود ولد الصلب، وابن الابن في درجتهما"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_147> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_147_condition_2_82974ae9> a dznorm:Condition ;
    dznorm:conditionText "بشرط عدم وجود الشقيق الذكر، أو الأب أو ولد الصلب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_147> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_147_condition_3_6997392f> a dznorm:Condition ;
    dznorm:conditionText "بشرط عدم وجود الأخ لأب، ومن ذكر في الشقيقتين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_147> ;
    dznorm:position 3 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_147_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_147> ;
    dzdoc:position 0 ;
    dzdoc:text "أصحاب الثلثين أربعة وهن : 1- بنتان فأكثر بشرط عدم وجود الابن، 2- بنتا الابن فأكثر بشرط عدم وجود ولد الصلب، وابن الابن في درجتهما، 3- الشقيقتان فأكثر بشرط عدم وجود الشقيق الذكر، أو الأب أو ولد الصلب، 4- الأختان لأب فأكثر بشرط عدم وجود الأخ لأب، ومن ذكر في الشقيقتين."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_147_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_147> ;
    dzdoc:position 1 ;
    dzdoc:text "أصحاب الثلث"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_148_condition_0_c4c8c0b1> a dznorm:Condition ;
    dznorm:conditionText "بشرط عدم وجود الفرع الوارث أو عدد من الإخوة سواء كانوا أشقاء أو لأب أو لأم ولو لم يرثوا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_148> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_148_condition_1_d56483d9> a dznorm:Condition ;
    dznorm:conditionText "بشرط انفرادهم عن الأب، والجد للأب، وولد الصلب وولد الابن ذكرا كان أو أنثى"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_148> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_148_condition_2_df039d3c> a dznorm:Condition ;
    dznorm:conditionText "إن كان مع إخوة وكان الثلث أحضي له"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_148> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_148_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_148> ;
    dzdoc:position 0 ;
    dzdoc:text "أصحاب الثلث ثلاثة وهم : 1- الأم بشرط عدم وجود الفرع الوارث أو عدد من الإخوة سواء كانوا أشقاء أو لأب أو لأم ولو لم يرثوا، 2- الإخوة لأم بشرط انفرادهم عن الأب، والجد للأب، وولد الصلب وولد الابن ذكرا كان أو أنثى، 3- الجد إن كان مع إخوة وكان الثلث أحضي له."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_148_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_148> ;
    dzdoc:position 1 ;
    dzdoc:text "أصحاب السدس"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_149_condition_0_62202661> a dznorm:Condition ;
    dznorm:conditionText "بشرط وجود الولد، أو ولد الابن ذكرا كان أو أنثى"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_149> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_149_condition_1_cc5010fb> a dznorm:Condition ;
    dznorm:conditionText "بشرط وجود فرع وارث أو عدد من الإخوة سواء كانوا وارثين أو محجوبين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_149> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_149_condition_2_bac63ea4> a dznorm:Condition ;
    dznorm:conditionText "عند وجود الولد، أو ولد الابن، وعند عدم وجود الأب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_149> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_149_condition_3_15c33e14> a dznorm:Condition ;
    dznorm:conditionText "فان اجتمعت جدتان وكانتا في درجة واحدة قسم السدس بينهما، أو كانت التي للأم أبعد، فان كانت هي الأقرب اختصت بالسدس"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_149> ;
    dznorm:position 3 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_149_condition_4_3431897b> a dznorm:Condition ;
    dznorm:conditionText "بشرط أن تكون مع بنت واحدة وأن لا يكون معها ابن ابن في درجتها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_149> ;
    dznorm:position 4 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_149_condition_5_fe4dd8bd> a dznorm:Condition ;
    dznorm:conditionText "بشرط أن تكون مع شقيقة واحدة، وانفرادها عن الأخ للأب، والأب والولد ذكرا كان أو أنثى"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_149> ;
    dznorm:position 5 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_149_condition_6_77eeb4b9> a dznorm:Condition ;
    dznorm:conditionText "بشرط أن يكون منفردا ذكرا كان أو أنثى، وعدم وجود الأصل والفرع الوارث"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_149> ;
    dznorm:position 6 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_151_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_151> ;
    dzdoc:position 0 ;
    dzdoc:text "العصبة ثلاثة أنواع : 1- عاصب بنفسه، 2- عاصب بغيره. 3- عاصب غيره."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_151_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_151> ;
    dzdoc:position 1 ;
    dzdoc:text "العاصب بنفسه"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_153_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_153> ;
    dzdoc:position 0 ;
    dzdoc:text "العصبة بالنفس أربع جهات يقدم بعضها على بعض عند الاجتماع حسب الترتيب الآتي: 1- جهة البنوة وتشمل الابن وابن الابن مهما نزلت درجته، 2- جهة الأبوة وتشمل الأب، والجد الصحيح مهما علا . مع مر اعاة أحوال الجد، 3- جهة الأخوة وتشمل الإخوة الأشقاء أو لأب وأبناءهم مهما نزلوا، 4- جهة العمومة وتشمل أعمام الميت، وأعمام أبيه، وأعمام جده مهما علا، وأبناءهم مهما نزلوا."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_154_condition_0_a0154215> a dznorm:Condition ;
    dznorm:conditionText "إذا كان الموجود من العصبة أكثر من واحد واتحدوا في الجهة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_154> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_154_condition_1_afb6446b> a dznorm:Condition ;
    dznorm:conditionText "إذا اتحدوا في الجهة والدرجة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_154> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_154_condition_2_77ab6071> a dznorm:Condition ;
    dznorm:conditionText "إذا اتحدوا في الجهة والدرجة والقرابة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_154> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_154_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_154> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان الموجود من العصبة أكثر من واحد واتحدوا في الجهة كان الترجيح بينهم بالدرجة فيقدم أقربهم درجة إلى الميت، وإذا اتحدوا في الجهة والدرجة كان الترجيح بقوة القرابة فمن كان ذا قرابتين قدم على من كان ذا قرابة واحدة، وإذا اتحدوا في الجهة والدرجة والقرابة ورثوا بالتعصيب واشتركوا في المال بالسوية."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_154_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_154> ;
    dzdoc:position 1 ;
    dzdoc:text "العاصب بغيره"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_155_condition_0_85cb41e2> a dznorm:Condition ;
    dznorm:conditionText "بشرط أن لا ترث بالفرض"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_155> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_155_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_155> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي كل هذه الأحوال، يكون الإرث للذكر مثل حظ الأنثيين."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_155_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_155> ;
    dzdoc:position 2 ;
    dzdoc:text "العاصب مع غيره"@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_156_condition_0_6bfced66> a dznorm:Condition ;
    dznorm:conditionText "عند وجود واحدة فأكثر من بنات الصلب، أو بنات الابن بشرط عدم وجود الأخ المساوي لها في الدرجة، أو الجد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_156> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_156_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_156> ;
    dzdoc:position 0 ;
    dzdoc:text "العاصب مع غيره : الأخت الشقيقة، أو لأب وإن تعددت عند وجود واحدة فأكثر من بنات الصلب، أو بنات الابن بشرط عدم وجود الأخ المساوي لها في الدرجة، أو الجد."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_157_condition_0_59e5cd0a> a dznorm:Condition ;
    dznorm:conditionText "عند عدم وجود أخت شقيقة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_157> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_157_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_157> ;
    dzdoc:position 0 ;
    dzdoc:text "لا تكون الأخت لأب عاصبة إلا عند عدم وجود أخت شقيقة."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_158_condition_0_378f4e2a> a dznorm:Condition ;
    dznorm:conditionText "إذا اجتمع الجد العاصب مع الإخوة الأشقاء، أو مع الإخوة للأب ذكورا أو إناثا أو مختلطين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_158> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_158_condition_1_de8bd83f> a dznorm:Condition ;
    dznorm:conditionText "وإذا اجتمع مع الإخوة وذوي الفروض"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_158> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_158_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_158> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا اجتمع الجد العاصب مع الإخوة الأشقاء، أو مع الإخوة للأب ذكورا أو إناثا أو مختلطين فله الأفضل من جميع ثلث المال أو المقاسمة."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_158_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_158> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا اجتمع مع الإخوة وذوي الفروض فله الأفضل من : سدس جميع المال، أو ثلث ما بقى بعد ذوي الفروض، أو مقاسمة الإخوة كذكر منهم."@ar .

