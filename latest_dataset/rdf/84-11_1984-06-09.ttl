<https://legal.dz/resource/law/1984-06-09/84-11#art_223> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_4> ;
    dzdoc:eId "art_223" ;
    dzdoc:fullText "تلغى جميع الأحكام المخالفة لهذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_223> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_223_para_0> ;
