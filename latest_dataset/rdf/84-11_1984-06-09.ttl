<https://legal.dz/resource/law/1984-06-09/84-11#version_art_10> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون الرضا بإيجاب من أحد الطرفين وقبول من الطرف الآخر بكل لفظ يفيد معنى النكاح شرعا. ويصح الإيجاب والقبول من العاجز بكل ما يفيد معنى النكاح لغة أو عرفا كالكتابة والإشارة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_10_19840609_OpEnact_5eef7b27cb> ;
    dzdoc:replacementText "يكون الرضا بإيجاب من أحد الطرفين وقبول من الطرف الآخر بكل لفظ يفيد معنى النكاح شرعا. ويصح الإيجاب والقبول من العاجز بكل ما يفيد معنى النكاح لغة أو عرفا كالكتابة والإشارة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
