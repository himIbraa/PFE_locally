    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_2> ;
    dzdoc:eId "art_149" ;
    dzdoc:fullText "أصحاب السدس سبعة هم : 1- الأب بشرط وجود الولد، أو ولد الابن ذكرا كان أو أنثى ، 2- الأم بشرط وجود فرع وارث أو عدد من الإخوة سواء كانوا وارثين أو محجوبين ، 3- الجد للأب عند وجود الولد، أو ولد الابن، وعند عدم وجود الأب ، 4- الجدة سواء لأب أو لأم وكانت منفردة، فان اجتمعت جدتان وكانتا في درجة واحدة قسم السدس بينهما، أو كانت التي للأم أبعد، فان كانت هي الأقرب اختصت بالسدس ، 5- بنت الابن ولو تعددت بشرط أن تكون مع بنت واحدة وأن لا يكون معها ابن ابن في درجتها ، 6- الأخت للأب ولو تعددت بشرط أن تكون مع شقيقة واحدة، وانفرادها عن الأخ للأب، والأب والولد ذكرا كان أو أنثى 7- الأخ للأم بشرط أن يكون منفردا ذكرا كان أو أنثى، وعدم وجود الأصل والفرع الوارث ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_149> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_149_defocc_934e4d282091> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_149_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_149_19840609_OpEnact_d133a0309a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "149" ;
    dzdoc:position 156 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_149_condition_0_62202661>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_149_condition_1_cc5010fb>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_149_condition_2_bac63ea4>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_149_condition_3_15c33e14>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_149_condition_4_3431897b>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_149_condition_5_fe4dd8bd>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_149_condition_6_77eeb4b9> ;
    dzdoc:usesTerm dzterm:father,
        dzterm:grandmother,
        dzterm:maternal_brother,
        dzterm:mother,
        dzterm:paternal_grandfather,
        dzterm:paternal_sister,
        dzterm:son_daughter .

<https://legal.dz/resource/law/1984-06-09/84-11#art_173> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_8> ;
    dzdoc:eId "art_173" ;
    dzdoc:fullText "يوقف من التركة للحمل الأكثر من حظ ابن واحد أو بنت واحدة إذا كان الحمل يشارك الورثة أو يحجبهم حجب نقصان ، فان كان يحجبهم حجب حرمان يوقف الكل ولا تقسم التركة إلى أن تضع الحامل حملها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_173> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_173_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_173_19840609_OpEnact_df2b856cb9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_173_obligation_0_ab46ca04> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "173" ;
    dzdoc:position 180 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_173_condition_0_16d2f405>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_173_condition_1_35da3c21> ;
    dzdoc:usesTerm dzterm:estate .

<https://legal.dz/resource/law/1984-06-09/84-11#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_3> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "يبطل الزواج إذا اختل ركن الرضا . إذا تم الزواج بدون شاهدين أو صداق أو ولي في حالة وجوبه ، يفسخ قبل الدخول ولا صداق فيه ، و يثبت بعد الدخول بصداق المثل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_33_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_33_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_33_19840609_OpEnact_5c8f9fc551> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_33_obligation_0_fa3c1c1d>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_33_obligation_1_fe00e384>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_33_obligation_2_a27f1cd7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "33" ;
    dzdoc:position 37 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_33_condition_0_6a0dad2f>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_33_condition_1_d694030c> ;
    dzdoc:usesTerm dzterm:marriage .

<https://legal.dz/resource/law/1984-06-09/84-11#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_4> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "لكل واحد من الزوجين ذمة مالية مستقلة عن ذمة الآخر. غير أنه يجوز للزوجين أن يتفقا في عقد الزواج أو في عقد رسمي لاحق، حول الأموال المشتركة بينهما، التي يكتسبانها خلال الحياة الزوجية وتحديد النسب التي تؤول إلى كل واحد منها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_37_permission_0_e5ad302f> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_37_right_0_340fd320> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_37_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_37_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_37_19840609_OpEnact_873b1b4ae1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "37" ;
    dzdoc:position 41 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_37_condition_0_2a21f7b9> ;
    dzdoc:usesTerm dzterm:spouse .

<https://legal.dz/resource/law/1984-06-09/84-11#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "في حالة الطلاق ، يجب على الأب أن يوفر ، لممارسة الحضانة، سكنا ملائما للحاضنة ، و إن تعذر ذلك فعليه دفع بدل الإيجار . وتبقى الحاضنة في بيت الزوجية حتى تنفيذ الأب للحكم القضائي المتعلق بالسكن ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_72_right_0_8225d2b7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_72_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_72_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_72_19840609_OpEnact_2a6be2f280> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_72_obligation_0_69c89a4b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 72" ;
    dzdoc:position 79 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_72_condition_0_421f4da4>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_72_condition_1_054a039a> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_97> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_3> ;
    dzdoc:eId "art_97" ;
    dzdoc:fullText "على الوصي الذي انتهت مهمته أن يسلم الأموال التي في عهدته ويقدم عنها حسابا بالمستندات إلى من يخلفه أو إلى القاصر الذي رشد أو إلى ورثته في مدة لا تتجاوز شهرين من تاريخ انتهاء مهمته . وأن يقدم صورة عن الحساب المذكور إلى القضاء . وفي حالة وفاة الوصي أو فقده فعلى ورثته تسليم أموال القاصر بواسطة القضاء إلى المعني بالأمر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_97> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_97_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_97_para_1>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_97_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_97_19840609_OpEnact_d5551591ca> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_97_obligation_0_874593a6>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_97_obligation_1_e8f347bb>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_97_obligation_2_1ae58156> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "97" ;
    dzdoc:position 104 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_97_condition_0_fc189cd5> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "يجوز للزوجة أن تطلب التطليق للأسباب الآتية : عدم الإنفاق بعد صدور الحكم بوجوبه ما لم تكن عالمة بإعساره وقت الزواج، مع مراعاة المواد 78 و 79 و 80 من هذا القانون، العيوب التي تحول دون تحقيق الهدف من الزواج، الهجر في المضجع فوق أربعة أشهر، الحكم على الزوج عن جريمة فيها مساس بشرف الأسرة وتستحيل معها مواصلة العشرة والحياة الزوجية، الغيبة بعد مرور سنة بدون عذر ولا نفقة، مخالفة الأحكام الواردة في المادة 8 أعلاه، ارتكاب فاحشة مبينة، الشقاق المستمر بين الزوجين، مخالفة الشروط المتفق عليها في عقد الزواج، كل ضرر معتبر شرعا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_53_permission_0_de2c4c7b> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_53_right_0_3daa0349> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_53_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_53_19840609_OpEnact_27262ab900> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "53" ;
    dzdoc:position 58 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_78>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_79>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_8>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_80> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_78>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_79>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_8>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_80> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "تكتمل أهلية الرجل والمرأة في الزواج بتمام 19 سنة . وللقاضي أن يرخص بالزواج قبل ذلك لمصلحة أو ضرورة، متى تأكدت قدرة الطرفين على الزواج . يكتسب الزوج القاصر أهلية التقاضي فيما يتعلق بآثار عقد الزواج من حقوق والتزامات ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_7_permission_0_262bcd7c> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_7_right_0_c460bf01> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_7_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_7_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_7_19840609_OpEnact_cf77f7b424> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_7_obligation_0_92399e43> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "7" ;
    dzdoc:position 7 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_7_condition_0_4fc1abbb> ;
    dzdoc:usesTerm dzterm:legal_capacity .

<https://legal.dz/resource/law/1984-06-09/84-11#art_54> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_54" ;
    dzdoc:fullText "يجوز للزوجة دون موافقة الزوج أن تخالع نفسها بمقابل مالي . إذا لم يتفق الزوجان على المقابل المالي للخلع ، يحكم القاضي بما لا يتجاوز قيمة صداق المثل وقت صدور الحكم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_54_permission_0_ba6707e2> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_54_right_0_663bfdf8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_54> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_54_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_54_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_54_19840609_OpEnact_6a660b9f4a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_54_obligation_0_a5a1a71f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "54" ;
    dzdoc:position 60 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_54_condition_0_9fafd17f> .

