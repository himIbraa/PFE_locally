<https://legal.dz/resource/law/1984-06-09/84-11#version_art_17> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة النزاع في الصداق بين الزوجين أو ورثتهما وليس لأحدهما بينة وكان قبل الدخول ، فالقول للزوجة أو ورثتها مع اليمين و إذا كان بعد البناء فالقول للزوج أو ورثته مع اليمين."@ar ;
