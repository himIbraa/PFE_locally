    dzdoc:position 31 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "يعد الطفل الرضيع وحده دون إخوته وأخواته ولدا للمرضعة وزوجها وأخا لجميع أولادها، ويسري التحريم عليه وعلى فروعه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_28_19840609_OpEnact_2aa141929d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "28" ;
    dzdoc:position 32 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_3> a dzdoc:Article ;
