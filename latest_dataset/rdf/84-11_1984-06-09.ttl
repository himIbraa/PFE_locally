    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "تبطل الوصية بموت الموصى له قبل الموصي، أو بردها."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_202_19840609_OpEnact_041044d6a4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_202> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1984-06-09/84-11#art_202> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_202> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:versionText "الهبة تمليك بلا عوض. ويجوز للواهب أن يشترط على الموهب له القيام بالتزام يتوقف على إنجاز الشرط."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#version_art_203_19840609_OpEnact_33eca3b670> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1984-06-09"^^xsd:date ;
