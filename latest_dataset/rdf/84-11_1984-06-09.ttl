<https://legal.dz/resource/law/1984-06-09/84-11#art_105> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_5> ;
    dzdoc:eId "art_105" ;
    dzdoc:fullText "يجب أن يمكن الشخص الذي يراد التحجير عليه من الدفاع عن حقوقه وللمحكمة أن تعين له مساعدا إذا رأت في ذلك مصلحة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_105_permission_0_62ebd4a9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_105> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_105_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_105_19840609_OpEnact_a40953a29a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_105_obligation_0_34932df6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "105" ;
    dzdoc:position 112 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_135> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_1> ;
    dzdoc:eId "art_135" ;
    dzdoc:fullText "يمنع من الميراث الأشخاص الآتية أوصافهم : 1- قاتل المورث عمدا أو عدوانا سواء كان القاتل فاعلا أصليا أو شريكا، 2- شاهد الزور الذي أدت شهادته إلى الحكم بالإعدام وتنفيذه، 3- العالم بالقتل أو تدبيره إذا لم يخبر السلطات المعنية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_135> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_135_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_135_19840609_OpEnact_b0f45d1d91> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_135_obligation_0_eb889e7a> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/1984-06-09/84-11#art_135_prohibition_0_06dda20f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "135" ;
    dzdoc:position 142 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_138> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_1> ;
    dzdoc:eId "art_138" ;
    dzdoc:fullText "يمنع من الإرث اللعان والردة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_138> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_138_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_138_19840609_OpEnact_2e8c69ee67> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_138_obligation_0_33016ccd> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/1984-06-09/84-11#art_138_prohibition_0_0b53b784> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "138" ;
    dzdoc:position 145 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_146> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_2> ;
    dzdoc:eId "art_146" ;
    dzdoc:fullText "وارث الثمن أصحاب الثمن الزوجة أو الزوجات عند وجود الفرع الوارث للزوج . أصحاب الثلثين"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_146> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_146_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_146_para_1>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_146_para_2>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_146_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_146_19840609_OpEnact_14c5bfe875> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 146" ;
    dzdoc:position 153 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_146_condition_0_17045d48> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_148> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_2> ;
    dzdoc:eId "art_148" ;
    dzdoc:fullText "أصحاب الثلث ثلاثة وهم : 1- الأم بشرط عدم وجود الفرع الوارث أو عدد من الإخوة سواء كانوا أشقاء أو لأب أو لأم ولو لم يرثوا ، 2- الإخوة لأم بشرط انفرادهم عن الأب، والجد للأب، وولد الصلب وولد الابن ذكرا كان أو أنثى ، 3- الجد إن كان مع إخوة وكان الثلث أحضي له . أصحاب السدس"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_148> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_148_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_148_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_148_19840609_OpEnact_3c07320b57> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 148" ;
    dzdoc:position 155 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_148_condition_0_c4c8c0b1>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_148_condition_1_d56483d9>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_148_condition_2_df039d3c> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "يحدد الصداق في العقد، سواء كان معجلا أو مؤجلا . في حالة عدم تحديد قيمة الصداق ، تستحق الزوجة صداق المثل ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_15_right_0_02ce3c99> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_15_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_15_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_15_19840609_OpEnact_750777deb7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_15_obligation_0_23987c3f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "15" ;
    dzdoc:position 19 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_15_condition_0_5a7e9ca8> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_154> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_3> ;
    dzdoc:eId "art_154" ;
    dzdoc:fullText "إذا كان الموجود من العصبة أكثر من واحد واتحدوا في الجهة كان الترجيح بينهم بالدرجة فيقدم أقربهم درجة إلى الميت، و إذا اتحدوا في الجهة والدرجة كان الترجيح بقوة القرابة فمن كان ذا قرابتين قدم على من كان ذا قرابة واحدة، و إذا اتحدوا في الجهة والدرجة والقرابة ورثوا بالتعصيب واشتركوا في المال بالسوية. العاصب بغيره"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_154> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_154_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_154_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_154_19840609_OpEnact_06f4a83300> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "154" ;
    dzdoc:position 161 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_154_condition_0_a0154215>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_154_condition_1_afb6446b>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_154_condition_2_77ab6071> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_155> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:عاصب_بغيره ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_3> ;
    dzdoc:eId "art_155" ;
    dzdoc:fullText "العاصب بغيره هو كل أنثى عصبها ذكر وهي : 1- البنت مع أخيها، 2- بنت الابن مع أخيها، أو ابن عمها المساوي لها في الدرجة أو ابن ابن عمها الأسفل درجة بشرط أن لا ترث بالفرض ، 3- الأخت الشقيقة مع أخيها الشقيق، 4- الأخت لأب مع أخيها لأب. وفي كل هذه الأحوال، يكون الإرث للذكر مثل حظ الأنثيين. العاصب مع غيره"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_155> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_155_defocc_e912b9c0503e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_155_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_155_para_1>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_155_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_155_19840609_OpEnact_9094ba4960> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "155" ;
    dzdoc:position 162 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_155_condition_0_85cb41e2> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "تستحق الزوجة الصداق كاملا بالدخول، أو بوفاة الزوج ، و تستحق نصفه عند الطلاق قبل الدخول ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_16_right_0_ae15a1f2>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_16_right_1_73dc4fc5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_16_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_16_19840609_OpEnact_a71e7e372c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "16" ;
    dzdoc:position 20 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_16_condition_0_81d29352>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_16_condition_1_43d33e8d> ;
    dzdoc:usesTerm dzterm:dower,
        dzterm:husband,
        dzterm:wife .

<https://legal.dz/resource/law/1984-06-09/84-11#art_166> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:العول ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_6> ;
    dzdoc:eId "art_166" ;
    dzdoc:fullText "العول هو زيادة سهام أصحاب الفروض على أصل المسألة. فإذا زادت أنصبة الفروض عليها قسمت التركة بينهم بنسبة أنصبائهم في الإرث. الرد على ذوي الفروض"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_166> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_166_defocc_ca92a0fdca2c> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_166_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_166_para_1>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_166_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_166_19840609_OpEnact_daac3bac55> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "166" ;
    dzdoc:position 173 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_166_condition_0_12727a1f> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_167> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_6> ;
    dzdoc:eId "art_167" ;
    dzdoc:fullText "إذا لم تستغرق التركة ولم يوجد عصبة من النسب رد الباقي على غير الزوجين من أصحاب الفروض بنسبة فروضهم. ويرد باقي التركة إلى أحد الزوجين إذا لم يوجد عصبة من النسب أو أحد أصحاب الفروض النسبية، أو أحد ذوي الأرحام . الدفع إلى ذوي الأرحام"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_167> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_167_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_167_para_1>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_167_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_167_19840609_OpEnact_a9cbb16c91> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "167" ;
    dzdoc:position 174 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_167_condition_0_e5ca8f48>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_167_condition_1_e5ba4662> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_168> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_6> ;
    dzdoc:eId "art_168" ;
    dzdoc:fullText "يرث ذوو الأرحام عند الاستحقاق على الترتيب الآتي : أولاد البنات وان نزلوا، وأولاد بنات الابن وان نزلوا، فأولادهم بالميراث أقربهم إلى الميت درجة، فان استووا في الدرجة فولد صاحب الفرض أولى من ولد ذوي الرحم، وان استووا في الدرجة ولم يكن فيهم ولد صاحب فرض أو كانوا كلهم يدلون بصاحب فرض اشتركوا في الإرث."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_168_right_0_6cfbd233> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_168> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_168_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_168_19840609_OpEnact_6ce2ba9893> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "168" ;
    dzdoc:position 175 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_168_condition_0_66ab58f2>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_168_condition_1_4a5a7e44> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_192> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_192" ;
    dzdoc:fullText "يجوز الرجوع في الوصية صراحة أو ضمنا ، فالرجوع الصريح يكون بوسائل إثباتها والضمني يكون بكل تصرف يستخلص منه الرجوع فيها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_192_permission_0_48a21160> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_192_right_0_0f7dc56e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_192> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_192_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_192_19840609_OpEnact_269ab856bc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 192" ;
    dzdoc:position 199 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_22> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_22" ;
    dzdoc:fullText "يثبت الزواج بمستخرج من سجل الحالة المدنية ، و في حالة عدم تسجيله يثبت بحكم قضائي . يجب تسجيل حكم تثبيت الزواج في الحالة المدنية بسعي من النيابة العامة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_22> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_22_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_22_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_22_19840609_OpEnact_a961830553> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_22_obligation_0_2aa32296> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "22" ;
    dzdoc:position 26 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_22_condition_0_d8185d9e> ;
    dzdoc:usesTerm dzterm:civil_status_registry,
        dzterm:marriage .

<https://legal.dz/resource/law/1984-06-09/84-11#art_46> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_5> ;
    dzdoc:eId "art_46" ;
    dzdoc:fullText "يمنع التبني شرعا وقانونا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_46> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_46_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_46_19840609_OpEnact_82d5ff76d8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_46_obligation_0_b7a496d0> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/1984-06-09/84-11#art_46_prohibition_0_502a0b86> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "46" ;
    dzdoc:position 51 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "لا يمكن أن يراجع الرجل من طلقها ثلاث مرات متتالية إلا بعد أن تتزوج غيره وتطلق منه أو يموت عنها بعد البناء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_51_permission_0_a9f43a90> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_51_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_51_19840609_OpEnact_628dd44d67> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "51" ;
    dzdoc:position 56 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_51_condition_0_27c255dd> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_57_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_57_bis" ;
    dzdoc:fullText "يجوز للقاضي الفصل على وجه الاستعجال بموجب أمر على عريضة في جميع التدابير المؤقتة ولا سيما ما تعلق منها بالنفقة والحضانة والزيارة والمسكن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1984-06-09/84-11#art_57_bis_permission_0_f7cfa90a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_57_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_57_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_57_bis_19840609_OpEnact_4296d35f5f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "57 مكرر" ;
    dzdoc:position 64 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_65> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_65" ;
    dzdoc:fullText "تنقضي مدة حضانة الذكر ببلوغه (10) سنوات، والأنثى ببلوغها سن الزواج، و للقاضي أن يمدد الحضانة بالنسبة للذكر إلى (16) سنة إذا كانت الحاضنة أما لم تتزوج ثانية . على أن يراعى في الحكم بانتهائها مصلحة المحضون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_65> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_65_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_65_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_65_19840609_OpEnact_3427884cde> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_65_obligation_0_74e8e182> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 65" ;
    dzdoc:position 72 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_65_condition_0_96292d8f> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_83> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_1> ;
    dzdoc:eId "art_83" ;
    dzdoc:fullText "من بلغ سن التمييز ولم يبلغ سن الرشد طبقا ل المادة (43) من القانون المدني تكون تصرفاته نافذة إذا كانت نافعة له ، وباطلة إذا كانت ضارة به وتتوقف على إجازة الولي أو الوصي فيما إذا كانت مترددة بين النفع والضرر ، وفي حالة النزاع يرفع الأمر للقضاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_83> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_83_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_83_19840609_OpEnact_ceccf0649c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "83" ;
    dzdoc:position 90 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1984-06-09/84-11#art_83_extref_99320cdb> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_83_condition_0_e24ee7b4>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_83_condition_1_056d872e>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_83_condition_2_aa4ded4e>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_83_condition_3_769e8cc6> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_84> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_1> ;
    dzdoc:eId "art_84" ;
    dzdoc:fullText "للقاضي أن يأذن لمن يبلغ سن التمييز في التصرف جزئيا أو كليا في أمواله ، بناء على طلب من له مصلحة ، وله الرجوع في الإذن إذا ثبت لديه ما يبرر ذلك ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_84_right_0_d7628f04> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_84> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_84_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_84_19840609_OpEnact_8d0879116d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "84" ;
    dzdoc:position 91 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_84_condition_0_8be6a682>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_84_condition_1_f694383b> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:full_capacity ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_1> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "من بلغ سن الرشد ولم يحجر عليه يعتبر كامل الأهلية وفقا لأحكام المادة 40 من القانون المدني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_86> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_86_defocc_523c20c6219e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_86_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_86_19840609_OpEnact_be789c76fa> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "86" ;
    dzdoc:position 93 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/1984-06-09/84-11#art_86_extref_1f4b850b> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_86_condition_0_12cf7dc1> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_89> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_2> ;
    dzdoc:eId "art_89" ;
    dzdoc:fullText "على القاضي أن يراعي في الإذن : حالة الضرورة والمصلحة، وأن يتم بيع العقار بالمزاد العلني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_89> ;
