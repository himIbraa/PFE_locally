<https://legal.dz/resource/law/1984-06-09/84-11#version_art_175> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يفرض للأخت مع الجد في مسألة إلا في الاكدرية وهي : زوج ، و أم ، و أخت شقيقة أو لأب ، و جد فيضم الجد ما حسب له إلى ما حسب لها ويقسمان للذكر مثل حظ الأنثيين، أصلها من ستة، وتعول إلى تسعة، وتصح من سبعة وعشرين للزوج تسعة وللأم ستة، وللأخت أربعة، وللجد ثمانية. مسألة مشتركة"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_175_19840609_OpEnact_ff5792b7c2> ;
    dzdoc:replacementText "لا يفرض للأخت مع الجد في مسألة إلا في الاكدرية وهي : زوج ، و أم ، و أخت شقيقة أو لأب ، و جد فيضم الجد ما حسب له إلى ما حسب لها ويقسمان للذكر مثل حظ الأنثيين، أصلها من ستة، وتعول إلى تسعة، وتصح من سبعة وعشرين للزوج تسعة وللأم ستة، وللأخت أربعة، وللجد ثمانية. مسألة مشتركة"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_175> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/1984-06-09/84-11> ;
