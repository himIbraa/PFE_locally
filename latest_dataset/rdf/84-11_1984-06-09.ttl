    dzdoc:number "217" ;
    dzdoc:position 224 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_191> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_191> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_219> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_3> ;
    dzdoc:eId "art_219" ;
    dzdoc:fullText "كل ما أحدثه المحبس عليه من بناء أو غرس في الحبس يعتبر من الشيء المحبس."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_219> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_219_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_219_19840609_OpEnact_1e650d22bc> ;
