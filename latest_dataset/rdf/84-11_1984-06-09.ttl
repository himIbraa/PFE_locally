    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "10" ;
    dzdoc:position 14 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_107> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_5> ;
    dzdoc:eId "art_107" ;
    dzdoc:fullText "تعتبر تصرفات المحجور عليه بعد الحكم باطلة، وقبل الحكم إذا كانت أسباب الحجر ظاهرة وفاشية وقت صدورها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_107> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_107_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_107_19840609_OpEnact_fd92eac5fd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "107" ;
    dzdoc:position 114 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_107_condition_0_362dc22c> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_6> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "الغائب الذي منعته ظروف قاهرة من الرجوع إلى محل إقامته أو إدارة شؤونه بنفسه أو بواسطة مدة سنة وتسبب غيابه في ضرر الغير يعتبر كالمفقود."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_110_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_110_19840609_OpEnact_85a8b6fc51> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "110" ;
    dzdoc:position 117 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_110_condition_0_d361e300> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_112> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_6> ;
    dzdoc:eId "art_112" ;
    dzdoc:fullText "لزوجة المفقود أو الغائب أن تطلب الطلاق بناء على الفقرة الخامسة من المادة 53 من هذا القانون."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_112_right_0_379cfea9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_112> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_112_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_112_19840609_OpEnact_57d44a0035> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "112" ;
    dzdoc:position 119 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_53> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_53> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_116> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:kafala ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_7> ;
    dzdoc:eId "art_116" ;
    dzdoc:fullText "المادة 116 : الكفالة التزام على وجه التبرع بالقيام بولد قاصر من نفقة وتربية ورعاية قيام الأب بابنه وتتم بعقد شرعي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_116> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_116_defocc_175393cf71df> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_116_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_116_19840609_OpEnact_885598e56d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "116" ;
    dzdoc:position 123 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_121> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_7> ;
    dzdoc:eId "art_121" ;
    dzdoc:fullText "المادة 121 : تخول الكفالة الكافل الولاية القانونية وجميع المنح العائلية والدراسية التي يتمتع بها الولد الأصلي."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_121_right_0_811e06f7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_121> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_121_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_121_19840609_OpEnact_b7e526f81c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "121" ;
    dzdoc:position 128 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_122> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_7> ;
    dzdoc:eId "art_122" ;
    dzdoc:fullText "المادة 122 : يدير الكافل أموال الولد المكفول المكتسبة من الإرث والوصية، أو الهبة لصالح الولد المكفول."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_122> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_122_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_122_19840609_OpEnact_8a731e5c60> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_122_obligation_0_47ed4879> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "122" ;
    dzdoc:position 129 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_127> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_1> ;
    dzdoc:eId "art_127" ;
    dzdoc:fullText "يستحق الإرث بموت المورث حقيقة أو باعتباره ميتا بحكم القاضي."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_127_right_0_41e93c75> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_127> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_127_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_127_19840609_OpEnact_408c067332> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "127" ;
    dzdoc:position 134 ;
    dzdoc:usesTerm dzterm:deceased .

<https://legal.dz/resource/law/1984-06-09/84-11#art_128> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_1> ;
    dzdoc:eId "art_128" ;
    dzdoc:fullText "يشترط لاستحقاق الإرث أن يكون الوارث حيا أو حملا وقت افتتاح التركة ، مع ثبوت سبب الإرث وعدم وجود مانع من الإرث."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_128> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_128_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_128_19840609_OpEnact_da42de3554> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "128" ;
    dzdoc:position 135 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_128_condition_0_692312e8> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_129> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_1> ;
    dzdoc:eId "art_129" ;
    dzdoc:fullText "إذا توفى اثنان أو أكثر ولم يعلم أيهم هلك أولا فلا استحقاق لأحدهم في تركة الآخر سواء كان موتهم في حادث واحد أم لا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_129> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_129_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_129_19840609_OpEnact_07baaa3582> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "129" ;
    dzdoc:position 136 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_129_condition_0_08e73d9c> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_131> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_1> ;
    dzdoc:eId "art_131" ;
    dzdoc:fullText "إذا ثبت بطلان النكاح فلا توارث بين الزوجين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_131> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_131_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_131_19840609_OpEnact_f48eee5195> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "131" ;
    dzdoc:position 138 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_131_condition_0_0c1b4e20> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_133> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_1> ;
    dzdoc:eId "art_133" ;
    dzdoc:fullText "إذا كان الوارث مفقودا ولم يحكم بموته يعتبر حيا وفقا لأحكام المادة 113 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_133> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_133_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_133_19840609_OpEnact_68d5c15bb9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "133" ;
    dzdoc:position 140 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_113> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_113> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_133_condition_0_1876e807> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_137> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_1> ;
    dzdoc:eId "art_137" ;
    dzdoc:fullText "يرث القاتل خطأ من المال دون الدية أو التعويض."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_137_right_0_afabbef6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_137> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_137_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_137_19840609_OpEnact_7a7c8301f2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "137" ;
    dzdoc:position 144 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:sadaq ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_14" ;
    dzdoc:fullText "الصداق هو ما يدفع نحلة للزوجة من نقود أو غيرها من كل ما هو مباح شرعا وهو ملك لها تتصرف فيه كما تشاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_14> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_14_defocc_e186f9e82ee3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_14_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_14_19840609_OpEnact_b1d32a6046> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "14" ;
    dzdoc:position 18 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_140> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:fard_heirs ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_2> ;
    dzdoc:eId "art_140" ;
    dzdoc:fullText "ذوو الفروض هم الذين حددت أسهمهم في التركة شرعا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_140> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_140_defocc_15ec5245cf67> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_140_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_140_19840609_OpEnact_64358aadbb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 140" ;
    dzdoc:position 147 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_141> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_2> ;
    dzdoc:eId "art_141" ;
    dzdoc:fullText "يرث من الرجال الأب والجد للأب، وإن علا، والزوج، والأخ للأم، والأخ الشقيق، في المسألة العمرية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_141_right_0_d36be6e1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_141> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_141_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_141_19840609_OpEnact_523e801f38> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 141" ;
    dzdoc:position 148 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_142> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_2> ;
    dzdoc:eId "art_142" ;
    dzdoc:fullText "يرث من النساء البنت وبنت الابن، وإن نزل، والأم والزوجة، والجدة من الجهتين وإن علت، والأخت الشقيقة، والأخت لأب، والأخت لأم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_142_right_0_7929c2b9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_142> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_142_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_142_19840609_OpEnact_45718e2053> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 142" ;
    dzdoc:position 149 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_143> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_2> ;
    dzdoc:eId "art_143" ;
    dzdoc:fullText "الفروض المحددة ستة وهي : النصف، والربع، والثمن، والثلثان، والثلث، والسدس. أصحاب النصف"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_143> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_143_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_143_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_143_19840609_OpEnact_43a606b71f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 143" ;
    dzdoc:position 150 ;
    dzdoc:usesTerm dzterm:fard .

<https://legal.dz/resource/law/1984-06-09/84-11#art_150> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:عاصب ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_3> ;
    dzdoc:eId "art_150" ;
    dzdoc:fullText "العاصب هو من يستحق التركة كلها عند إنفراده، أو ما بقى منها بعد أخذ أصحاب الفروض حقوقهم، وان استغرقت الفروض التركة فلا شيء له."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_150> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_150_defocc_299ec8388092> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_150_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_150_19840609_OpEnact_7a7df2393a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "150" ;
    dzdoc:position 157 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_151> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_3> ;
    dzdoc:eId "art_151" ;
    dzdoc:fullText "العصبة ثلاثة أنواع : 1- عاصب بنفسه، 2- عاصب بغيره. 3- عاصب غيره. العاصب بنفسه"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_151> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_151_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_151_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_151_19840609_OpEnact_63ab36042c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "151" ;
    dzdoc:position 158 ;
    dzdoc:usesTerm dzterm:عصبة .

<https://legal.dz/resource/law/1984-06-09/84-11#art_152> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:عاصب_بنفسه ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_3> ;
    dzdoc:eId "art_152" ;
    dzdoc:fullText "العاصب بنفسه هو كل ذكر ينتمي إلى الهالك، بواسطة ذكر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_152> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_152_defocc_00abd3782256> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_152_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_152_19840609_OpEnact_a2d1b3b3f7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "152" ;
    dzdoc:position 159 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_156> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_3> ;
    dzdoc:eId "art_156" ;
    dzdoc:fullText "العاصب مع غيره : الأخت الشقيقة، أو لأب وإن تعددت عند وجود واحدة فأكثر من بنات الصلب، أو بنات الابن بشرط عدم وجود الأخ المساوي لها في الدرجة، أو الجد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_156> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_156_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_156_19840609_OpEnact_7110c99820> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "156" ;
    dzdoc:position 163 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_156_condition_0_6bfced66> ;
    dzdoc:usesTerm dzterm:عاصب_مع_غيره .

<https://legal.dz/resource/law/1984-06-09/84-11#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_3> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "لا تكون الأخت لأب عاصبة إلا عند عدم وجود أخت شقيقة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_157_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_157_19840609_OpEnact_a817f3eec9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "157" ;
    dzdoc:position 164 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_157_condition_0_59e5cd0a> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_162> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_5> ;
    dzdoc:eId "art_162" ;
    dzdoc:fullText "يحجب كل من الأب ، و الجد الصحيح وإن علا، و الولد و ولد الابن وان نزل، أولاد الأخ ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_162> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_162_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_162_19840609_OpEnact_e6cdf80b6b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_162_obligation_0_143b7389> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "162" ;
    dzdoc:position 169 ;
    dzdoc:usesTerm dzterm:father,
        dzterm:grandfather,
        dzterm:grandson,
        dzterm:son .

<https://legal.dz/resource/law/1984-06-09/84-11#art_169> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_7> ;
    dzdoc:eId "art_169" ;
    dzdoc:fullText "من توفى وله أحفاد وقد مات مورثهم قبله أو معه وجب تنزيلهم منزلة أصلهم في التركة بالشرائط التالية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_169> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_169_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_169_19840609_OpEnact_1768778f85> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_169_obligation_0_143ad03b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "169" ;
    dzdoc:position 176 ;
    dzdoc:usesTerm dzterm:estate,
        dzterm:grandchildren .

<https://legal.dz/resource/law/1984-06-09/84-11#art_179> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_9> ;
    dzdoc:eId "art_179" ;
    dzdoc:fullText "إذا اجتمعت زوجة و بنتان و أبوان صحت فريضتهم من أربعة وعشرين وتعول إلى سبعة وعشرين، للبنتين الثلثان - ستة عشر - وللأبوين الثلث - ثمانية - وللزوجة الثمن - ثلاثة - ويصير ثمنها تسعا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_179> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_179_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_179_19840609_OpEnact_1385271197> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "179" ;
    dzdoc:position 186 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_179_condition_0_c0b493c9> ;
    dzdoc:usesTerm dzterm:daughters,
        dzterm:parents,
        dzterm:wife .

<https://legal.dz/resource/law/1984-06-09/84-11#art_180> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_9> ;
    dzdoc:eId "art_180" ;
    dzdoc:fullText "يؤخذ من التركة حسب الترتيب الآتي: 1- مصاريف التجهيز، والدفن بالقدر المشروع، 2- الديون الثابتة في ذمة المتوفى، 3- الوصية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_180> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_180_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_180_19840609_OpEnact_6ade22fe85> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_180_obligation_0_58d2c591> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "180" ;
    dzdoc:position 187 ;
    dzdoc:usesTerm dzterm:estate .

<https://legal.dz/resource/law/1984-06-09/84-11#art_184> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:وصية ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_184" ;
    dzdoc:fullText "الوصية تمليك مضاف إلى ما بعد الموت بطريق التبرع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_184> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_184_defocc_6ef1a3aaa786> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_184_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_184_19840609_OpEnact_cac76bd94e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 184" ;
    dzdoc:position 191 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_187> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_187" ;
    dzdoc:fullText "تصح الوصية للحمل بشرط أن يولد حيا ، وإذا ولد توائم يستحقونها بالتساوي ولو اختلف الجنس."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_187> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_187_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_187_19840609_OpEnact_69e1dfec9d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 187" ;
    dzdoc:position 194 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_187_condition_0_8586c8f0> ;
    dzdoc:usesTerm dzterm:وصية .

<https://legal.dz/resource/law/1984-06-09/84-11#art_189> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_189" ;
    dzdoc:fullText "لا وصية لوارث إلا إذا أجازها الورثة بعد وفاة الموصي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_189> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_189_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_189_19840609_OpEnact_58271b2494> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 189" ;
    dzdoc:position 196 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_189_condition_0_21efd243> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_190> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_1> ;
    dzdoc:eId "art_190" ;
    dzdoc:fullText "للموصي أن يوصي بالأموال التي يملكها والتي تدخل في ملكه قبل موته عينا أو منفعة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_190_right_0_58a14b34> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_190> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_190_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_190_19840609_OpEnact_8c5851eb66> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 190" ;
    dzdoc:position 197 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:family ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#body> ;
    dzdoc:eId "art_2" ;
    dzdoc:fullText "الأسرة هي الخلية الأساسية للمجتمع وتتكون من أشخاص تجمع بينهم صلة الزوجية وصلة القرابة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_2> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_2_defocc_5226ebd99a45> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_2_19840609_OpEnact_506ac64735> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 2" ;
    dzdoc:position 1 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_203> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_2> ;
    dzdoc:eId "art_203" ;
    dzdoc:fullText "تشترط في الواهب أن يكون سليم العقل، بالغا تسع عشرة (19) سنة وغير محجور عليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_203> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_203_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_203_19840609_OpEnact_33eca3b670> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 203" ;
    dzdoc:position 210 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_203_condition_0_40c1c1f2> ;
    dzdoc:usesTerm dzterm:donor .

<https://legal.dz/resource/law/1984-06-09/84-11#art_208> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_2> ;
    dzdoc:eId "art_208" ;
    dzdoc:fullText "إذا كان الواهب ولي الموهوب له ، أو زوجه أو كان الموهوب مشاعا فان التوثيق والإجراءات الإدارية تغنى عن الحيازة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_208> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_208_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_208_19840609_OpEnact_8b1e33feca> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 208" ;
    dzdoc:position 215 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_208_condition_0_9d3eb916> ;
    dzdoc:usesTerm dzterm:donee,
        dzterm:donor .

<https://legal.dz/resource/law/1984-06-09/84-11#art_209> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_2> ;
    dzdoc:eId "art_209" ;
    dzdoc:fullText "تصح الهبة للحمل بشرط أن يولد حيا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_209> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_209_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_209_19840609_OpEnact_3193da293d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 209" ;
    dzdoc:position 216 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_209_condition_0_8586c8f0> ;
    dzdoc:usesTerm dzterm:gift .

<https://legal.dz/resource/law/1984-06-09/84-11#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "تطبق أحكام قانون الحالة المدنية في إجراءات تسجيل عقد الزواج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_21_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_21_19840609_OpEnact_f0fe4661b5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_21_obligation_0_745e5c9d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "21" ;
    dzdoc:position 25 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_211> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_2> ;
    dzdoc:eId "art_211" ;
    dzdoc:fullText "للأبوين حق الرجوع في الهبة لولدهما مهما كانت سنه إلا في الحالات التالية: إذا كانت الهبة من أجل زواج الموهوب له، إذا كانت الهبة لضمان قرض أو قضاء دين، إذا تصرف الموهوب له في الشيء الموهوب ببيع، أو تبرع منه أو أدخل عليه ما غير طبيعته."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_211_right_0_edcd092c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_211> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_211_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_211_19840609_OpEnact_63b308c7ba> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 211" ;
    dzdoc:position 218 ;
    dzdoc:usesTerm dzterm:gift .

<https://legal.dz/resource/law/1984-06-09/84-11#art_213> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:waqf ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_3> ;
    dzdoc:eId "art_213" ;
    dzdoc:fullText "الوقف حبس المال عن التملك لأي شخص على وجه التأبيد والتصدق ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_213> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_213_defocc_1ca2a39c8997> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_213_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_213_19840609_OpEnact_dd1346d3a1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "213" ;
    dzdoc:position 220 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_215> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_3> ;
    dzdoc:eId "art_215" ;
    dzdoc:fullText "يشترط في الوقف والموقوف ما يشترط في الواهب والموهوب طبقا للمادتين 204 و 205 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_215> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_215_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_215_19840609_OpEnact_9f6f652454> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_215_obligation_0_a8e02fa3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "215" ;
    dzdoc:position 222 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_204>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_205> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_204>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_205> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_218> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_3> ;
    dzdoc:eId "art_218" ;
    dzdoc:fullText "ينفذ شرط الواقف ما لم يتناف ومقتضيات الوقف شرعا ، وإلا بطل الشرط وبقي الوقف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_218> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_218_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_218_19840609_OpEnact_6fb5cb5623> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "218" ;
    dzdoc:position 225 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_218_condition_0_75e00de5> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_222> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_4> ;
    dzdoc:eId "art_222" ;
    dzdoc:fullText "كل ما لم يرد النص عليه في هذا القانون يرجع فيه إلى أحكام الشريعة الإسلامية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_222> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_222_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_222_19840609_OpEnact_32e747b5ee> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_222_obligation_0_dc9f41d8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 222" ;
    dzdoc:position 229 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:permanent_impediments ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "موانع النكاح المؤبدة هي : القرابة، المصاهرة، الرضاع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_24> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_24_defocc_002fd15d8343> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_24_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_24_19840609_OpEnact_883f660d91> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "24" ;
    dzdoc:position 28 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:kinship_prohibitions ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "المحرمات بالقرابة هي : الأمهات والبنات، والأخوات والعمات والخالات وبنات الأخ ، وبنات الأخت."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_25> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_25_defocc_85315d5829e2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_25_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_25_19840609_OpEnact_15a1ee41f3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "25" ;
    dzdoc:position 29 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_26> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:affinity_prohibitions ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_26" ;
    dzdoc:fullText "المحرمات بالمصاهرة هي : 1 - أصول الزوجة بمجرد العقد عليها، 2 - فروعها إن حصل الدخول بها، 3 - أرامل أو مطلقات أصول الزوج وإن علوا، 4 - أرامل أو مطلقات فروع الزوج وإن نزلوا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_26> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_26_defocc_047cfc843aed> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_26_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_26_19840609_OpEnact_fad858725d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "26" ;
    dzdoc:position 30 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_29" ;
    dzdoc:fullText "لا يحرم الرضاع إلا ما حصل قبل الفطام أو في الحولين سواء كان اللبن قليلا أو كثيرا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_29_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_29_19840609_OpEnact_f427e22357> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "29" ;
    dzdoc:position 33 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_29_condition_0_e6bd61ee> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "يخضع زواج الجزائريين والجزائريات بالأجانب من الجنسين إلى أحكام تنظيمية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_31_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_31_19840609_OpEnact_8fc884bf22> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_31_obligation_0_a33c4d30> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "31" ;
    dzdoc:position 35 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_3_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#body> ;
    dzdoc:eId "art_3_bis" ;
    dzdoc:fullText "تعد النيابة العامة طرفا أصليا في جميع القضايا الرامية إلى تطبيق أحكام هذا القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_3_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_3_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_3_bis_19840609_OpEnact_0277bb3204> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_3_bis_obligation_0_b05255fc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 3 مكرر" ;
    dzdoc:position 3 ;
    dzdoc:usesTerm dzterm:prosecution .

<https://legal.dz/resource/law/1984-06-09/84-11#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:marriage ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "الزواج هو عقد رضائي يتم بين رجل وامرأة على الوجه الشرعي، من أهدافه، تكوين أسرة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_4> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_4_defocc_8d83aacd87ee> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_4_19840609_OpEnact_f3fbd534c7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "4" ;
    dzdoc:position 4 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_5> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "أقل مدة الحمل ستة أشهر وأقصاها عشر (10) أشهر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_42> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_42_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_42_19840609_OpEnact_08273d46f4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "42" ;
    dzdoc:position 46 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_42_condition_0_6c05a3ef> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "مع مراعاة أحكام المادة 49 أدناه ، يحل عقد الزواج بالطلاق الذي يتم بإرادة الزوج أو بتراضي الزوجين أو بطلب من الزوجة في حدود ما ورد في المادتين 53 و 54 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_48_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_48_19840609_OpEnact_422e1cb699> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "48" ;
    dzdoc:position 53 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_49>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_53>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_54> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_49>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_53>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_54> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_48_condition_0_053c7cb4> ;
    dzdoc:usesTerm dzterm:marriage_contract .

<https://legal.dz/resource/law/1984-06-09/84-11#art_57> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_57" ;
    dzdoc:fullText "تكون الأحكام الصادرة في دعاوى الطلاق والتطليق والخلع غير قابلة للاستئناف فيما عدا جوانبها المادية. تكون الأحكام المتعلقة بالحضانة قابلة للاستئناف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_57> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_57_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_57_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_57_19840609_OpEnact_ca80d9b546> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "57" ;
    dzdoc:position 63 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_58> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_58" ;
    dzdoc:fullText "تعتد المطلقة المدخول بها غير الحامل بثلاثة قروء، واليائس من المحيض بثلاثة أشهر من تاريخ التصريح بالطلاق ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_58> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_58_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_58_19840609_OpEnact_926534bae2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_58_obligation_0_edb9067b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 58" ;
    dzdoc:position 65 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "تعتد المتوفى عنها زوجها بمضي أربعة أشهر وعشرة أيام، وكذا زوجة المفقود من تاريخ صدور الحكم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_59_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_59_19840609_OpEnact_6f1bf1a399> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_59_obligation_0_42682f2e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 59" ;
    dzdoc:position 66 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "عدة الحامل وضع حملها ، وأقصى مدة الحمل عشرة (10) أشهر من تاريخ الطلاق أو الوفاة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_60_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_60_19840609_OpEnact_96646aa898> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_60_obligation_0_a9cb86bf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 60" ;
    dzdoc:position 67 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_66> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_66" ;
    dzdoc:fullText "يسقط حق الحاضنة بالتزوج بغير قريب محرم، وبالتنازل ما لم يضر بمصلحة المحضون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_66> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_66_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_66_19840609_OpEnact_8dec783e4b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 66" ;
    dzdoc:position 73 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_66_condition_0_275f153b> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "إذا لم يطلب من له الحق في الحضانة مدة تزيد عن سنة بدون عذر سقط حقه فيها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_68_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_68_19840609_OpEnact_ede2b6a64e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 68" ;
    dzdoc:position 75 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_68_condition_0_274aa260> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "إذا أراد الشخص الموكول له حق الحضانة أن يستوطن في بلد أجنبي رجع الأمر للقاضي في إثبات الحضانة له أو إسقاطها عنه، مع مراعاة مصلحة المحضون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_69_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_69_19840609_OpEnact_0a5fd58c0a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 69" ;
    dzdoc:position 76 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_69_condition_0_46ea6454> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_70" ;
    dzdoc:fullText "تسقط حضانة الجدة أو الخالة إذا سكنت بمحضونها مع أم المحضون المتزوجة بغير قريب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_70_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_70_19840609_OpEnact_6fe18c54ae> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 70" ;
    dzdoc:position 77 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_70_condition_0_a00e00db> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_71> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_71" ;
    dzdoc:fullText "يعود الحق في الحضانة إذا زال سبب سقوطه غير الاختياري ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_71> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_71_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_71_19840609_OpEnact_f239528339> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 71" ;
    dzdoc:position 78 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_71_condition_0_11bc5322> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_85> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_1> ;
    dzdoc:eId "art_85" ;
    dzdoc:fullText "تعتبر تصرفات المجنون والمعتوه والسفيه غير نافذة إذا صدرت في حالة الجنون، أو العته، أو السفه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_85> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_85_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_85_19840609_OpEnact_5ba0c2d099> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "85" ;
    dzdoc:position 92 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_85_condition_0_9d2ae1dd> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_8_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_8_bis_1" ;
    dzdoc:fullText "يفسخ الزواج الجديد قبل الدخول، إذا لم يستصدر الزوج ترخيصا من القاضي وفقا للشروط المنصوص عليها في المادة 8 أعلاه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_8_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_8_bis_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_8_bis_1_19840609_OpEnact_2d26e194f4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "8 مكرر 1" ;
    dzdoc:position 11 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_8> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_8> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_8_bis_1_condition_0_84ecb086> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_93> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_3> ;
    dzdoc:eId "art_93" ;
    dzdoc:fullText "يشترط في الوصي أن يكون مسلما عاقلا بالغا قادرا أمينا حسن التصرف وللقاضي عزله إذا لم تتوفر فيه الشروط المذكورة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_93> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_93_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_93_19840609_OpEnact_f466fa79e9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "93" ;
    dzdoc:position 100 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_93_condition_0_0c5d0324> ;
    dzdoc:usesTerm dzterm:guardian .

<https://legal.dz/resource/law/1984-06-09/84-11#art_98> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_3> ;
    dzdoc:eId "art_98" ;
    dzdoc:fullText "يكون الوصي مسؤولا عما يلحق أموال القاصر من ضرر بسبب تقصيره ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_98> ;
