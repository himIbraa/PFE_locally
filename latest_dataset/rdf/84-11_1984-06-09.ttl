<https://legal.dz/resource/law/1984-06-09/84-11#art_84_condition_1_f694383b> a dznorm:Condition ;
    dznorm:conditionText "إذا ثبت لديه ما يبرر ذلك"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_84> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_84_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_84> ;
    dzdoc:position 0 ;
    dzdoc:text "للقاضي أن يأذن لمن يبلغ سن التمييز في التصرف جزئيا أو كليا في أمواله، بناء على طلب من له مصلحة، وله الرجوع في الإذن إذا ثبت لديه ما يبرر ذلك."@ar .

