    dzdoc:usesTerm dzterm:father,
        dzterm:grandfather,
        dzterm:mother .

<https://legal.dz/resource/law/1984-06-09/84-11#art_163> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_5> ;
    dzdoc:eId "art_163" ;
    dzdoc:fullText "يحجب كل من الابن و ابن الابن وان نزل بنت الابن التي تكون انزل منه درجة و يحجبهما أيضا بنتان أو بنتا ابن أعلى منها درجة ما لم يكن معها من يعصبها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_163> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_163_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_163_19840609_OpEnact_0e4cca9480> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_163_obligation_0_27f5f492>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_163_obligation_1_40d3e4d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "163" ;
    dzdoc:position 170 ;
    dzdoc:usesTerm dzterm:grandson,
        dzterm:son,
        dzterm:son_daughter .

<https://legal.dz/resource/law/1984-06-09/84-11#art_174> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_8> ;
    dzdoc:eId "art_174" ;
    dzdoc:fullText "إذا ادعت المرأة الحمل وكذبها الورثة تعرض على أهل المعرفة مع مراعاة أحكام المادة 43 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_174> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_174_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_174_19840609_OpEnact_2c3c667930> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_174_obligation_0_b48199e0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "174" ;
    dzdoc:position 181 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_43> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_43> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_174_condition_0_e2b12fcb> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_175> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:akdariya ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_9> ;
    dzdoc:eId "art_175" ;
    dzdoc:fullText "لا يفرض للأخت مع الجد في مسألة إلا في الاكدرية وهي : زوج ، و أم ، و أخت شقيقة أو لأب ، و جد فيضم الجد ما حسب له إلى ما حسب لها ويقسمان للذكر مثل حظ الأنثيين، أصلها من ستة، وتعول إلى تسعة، وتصح من سبعة وعشرين للزوج تسعة وللأم ستة، وللأخت أربعة، وللجد ثمانية. مسألة مشتركة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_175> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_175_defocc_f35d7aed092a> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_175_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_175_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_175_19840609_OpEnact_ff5792b7c2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_175_obligation_0_bb596c81> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "175" ;
    dzdoc:position 182 ;
    dzdoc:usesTerm dzterm:grandfather,
        dzterm:husband,
        dzterm:mother,
        dzterm:sister,
        dzterm:sister_paternal .

<https://legal.dz/resource/law/1984-06-09/84-11#art_177> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_3_sec_9> ;
    dzdoc:eId "art_177" ;
    dzdoc:fullText "إذا اجتمعت زوجة ، و أبوان ، فللزوجة الربع وللأم ثلث ما بقى وهو الربع وللأب ما بقي، فإذا اجتمع زوج و أبوان فللزوج النصف وللأم ثلث ما بقي وهو السدس وما بقي للأب. مسألة المباهلة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_177> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_177_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_177_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_177_19840609_OpEnact_0cbde1a12f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "177" ;
    dzdoc:position 184 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_177_condition_0_031ea301>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_177_condition_1_05f65168> ;
    dzdoc:usesTerm dzterm:husband,
        dzterm:parents,
        dzterm:wife .

<https://legal.dz/resource/law/1984-06-09/84-11#art_206> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_4_sec_2> ;
    dzdoc:eId "art_206" ;
    dzdoc:fullText "تنعقد الهبة بالإيجاب والقبول، وتتم الحيازة، و مراعاة أحكام قانون التوثيق في العقارات والإجراءات الخاصة في المنقولات . وإذا اختل أحد القيود السابقة بطلت الهبة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_206> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_206_para_0>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_206_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_206_19840609_OpEnact_23955ff89d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_206_obligation_0_c97cfcde> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 206" ;
    dzdoc:position 213 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_206_condition_0_ed746a49> ;
    dzdoc:usesTerm dzterm:gift .

<https://legal.dz/resource/law/1984-06-09/84-11#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_1_sec_4> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "يجب على الزوجين : المحافظة على الروابط الزوجية وواجبات الحياة المشتركة، المعاشرة بالمعروف، وتبادل الاحترام والمودة والرحمة، التعاون على مصلحة الأسرة ورعاية الأولاد وحسن تربيتهم، التشاور في تسيير شؤون الأسرة وتباعد الولادات، حسن معاملة كل منهما لأبوي الآخر وأقاربه واحترامهم وزيارتهم، المحافظة على روابط القرابة والتعامل مع الوالدين الأقربين بالحسنى والمعروف، زيارة كل منهما لأبويه وأقاربه واستضافتهم بالمعروف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_36_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_36_19840609_OpEnact_cd52d3317c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_36_obligation_0_9949d908> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "36" ;
    dzdoc:position 40 ;
    dzdoc:usesTerm dzterm:spouse .

<https://legal.dz/resource/law/1984-06-09/84-11#art_61> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_61" ;
    dzdoc:fullText "لا تخرج الزوجة المطلقة ولا المتوفى عنها زوجها من السكن العائلي ما دامت في عدة طلاقها أو وفاة زوجها إلا في حالة الفاحشة المبينة ولها الحق في النفقة في عدة الطلاق ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1984-06-09/84-11#art_61_right_0_41b862ba> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_61> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_61_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_61_19840609_OpEnact_253ace8906> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_61_obligation_0_83d2a253> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 61" ;
    dzdoc:position 68 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_61_condition_0_951f7594> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_74> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_3> ;
    dzdoc:eId "art_74" ;
    dzdoc:fullText "تجب نفقة الزوجة على زوجها بالدخول بها أو دعوتها إليه ببينة مع مراعاة أحكام المواد 78 و 79 و 80 من هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_74> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_74_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_74_19840609_OpEnact_a77170a8aa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_74_obligation_0_fabc9fa2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "74" ;
    dzdoc:position 81 ;
    dzdoc:references <https://legal.dz/resource/law/1984-06-09/84-11#art_78>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_79>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_80> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1984-06-09/84-11#art_78>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_79>,
        <https://legal.dz/resource/law/1984-06-09/84-11#art_80> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_74_condition_0_68892907> ;
    dzdoc:usesTerm dzterm:maintenance .

<https://legal.dz/resource/law/1984-06-09/84-11#art_75> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_1_chp_2_sec_3> ;
    dzdoc:eId "art_75" ;
    dzdoc:fullText "تجب نفقة الولد على الأب ما لم يكن له مال ، فبالنسبة للذكور إلى سن الرشد والإناث إلى الدخول وتستمر في حالة ما إذا كان الولد عاجزا لآفة عقلية أو بدنية أو مزاولا للدراسة وتسقط بالاستغناء عنها بالكسب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_75> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_75_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_75_19840609_OpEnact_6096b65b3c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_75_obligation_0_78adbc89> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "75" ;
    dzdoc:position 82 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_75_condition_0_6e9c8478> ;
    dzdoc:usesTerm dzterm:maintenance .

<https://legal.dz/resource/law/1984-06-09/84-11#art_94> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_3> ;
    dzdoc:eId "art_94" ;
    dzdoc:fullText "يجب عرض الوصاية على القاضي بمجرد وفاة الأب لتثبيتها أو رفضها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_94> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_94_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_94_19840609_OpEnact_da8538aa51> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1984-06-09/84-11#art_94_obligation_0_be25e66e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "94" ;
    dzdoc:position 101 .

<https://legal.dz/resource/law/1984-06-09/84-11#art_99> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:definesTerm dzterm:مقدم ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_4> ;
    dzdoc:eId "art_99" ;
    dzdoc:fullText "المقدم هو من تعينه المحكمة في حالة عدم وجود ولي أوصي على من كان فاقد الأهلية أو ناقصها بناء على طلب أحد أقاربه، أو ممن له مصلحة أو من النيابة العامة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_99> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/1984-06-09/84-11#art_99_defocc_fbee62f3186e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_99_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_99_19840609_OpEnact_5250997209> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "المادة 99" ;
    dzdoc:position 106 ;
    dzdoc:usesTerm dzterm:النيابة_العامة .

