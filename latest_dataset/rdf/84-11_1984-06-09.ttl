<https://legal.dz/resource/law/1984-06-09/84-11#art_149_defocc_934e4d282091> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 11 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:ashab_al_sudus ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/1984-06-09/84-11#art_149> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_149_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """أصحاب السدس سبعة هم :
            
            
            1- الأب بشرط وجود الولد، أو ولد الابن ذكرا كان أو أنثى،
            
            
            2- الأم بشرط وجود فرع وارث أو عدد من الإخوة سواء كانوا وارثين أو محجوبين،
            
            
            3- الجد للأب عند وجود الولد، أو ولد الابن، وعند عدم وجود الأب،
            
            
            4- الجدة سواء لأب أو لأم وكانت منفردة، فان اجتمعت جدتان وكانتا في درجة واحدة قسم السدس بينهما، أو كانت التي للأم أبعد، فان كانت هي الأقرب اختصت بالسدس،
            
            
            5- بنت الابن ولو تعددت بشرط أن تكون مع بنت واحدة وأن لا يكون معها ابن ابن في درجتها،
            
            
            6- الأخت للأب ولو تعددت بشرط أن تكون مع شقيقة واحدة، وانفرادها عن الأخ للأب، والأب والولد ذكرا كان أو أنثى
            
            
            7- الأخ للأم بشرط أن يكون منفردا ذكرا كان أو أنثى، وعدم وجود الأصل والفرع الوارث."""@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_149_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#art_149> ;
    dzdoc:position 0 ;
    dzdoc:text "أصحاب السدس سبعة هم : 1- الأب بشرط وجود الولد، أو ولد الابن ذكرا كان أو أنثى، 2- الأم بشرط وجود فرع وارث أو عدد من الإخوة سواء كانوا وارثين أو محجوبين، 3- الجد للأب عند وجود الولد، أو ولد الابن، وعند عدم وجود الأب، 4- الجدة سواء لأب أو لأم وكانت منفردة، فان اجتمعت جدتان وكانتا في درجة واحدة قسم السدس بينهما، أو كانت التي للأم أبعد، فان كانت هي الأقرب اختصت بالسدس، 5- بنت الابن ولو تعددت بشرط أن تكون مع بنت واحدة وأن لا يكون معها ابن ابن في درجتها، 6- الأخت للأب ولو تعددت بشرط أن تكون مع شقيقة واحدة، وانفرادها عن الأخ للأب، والأب والولد ذكرا كان أو أنثى 7- الأخ للأم بشرط أن يكون منفردا ذكرا كان أو أنثى، وعدم وجود الأصل والفرع الوارث."@ar .

<https://legal.dz/resource/law/1984-06-09/84-11#art_14_defocc_e186f9e82ee3> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 99 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:sadaq ;
