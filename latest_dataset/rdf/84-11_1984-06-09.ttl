    dzdoc:introducedBy <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:introducedOn "1984-06-09"^^xsd:date ;
    dzdoc:number "81" ;
    dzdoc:position 88 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1984-06-09/84-11#art_81_condition_0_74bb0cc2> .

<https://legal.dz/resource/law/1984-06-09/84-11#art_82> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1984-06-09/84-11#book_2_sec_1> ;
    dzdoc:eId "art_82" ;
    dzdoc:fullText "من لم يبلغ سن التمييز لصغر سنه طبقا ل المادة (42) من القانون المدني تعتبر جميع تصرفاته باطلة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1984-06-09/84-11#version_art_82> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1984-06-09/84-11#art_82_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_82_19840609_OpEnact_41cca8c588> ;
