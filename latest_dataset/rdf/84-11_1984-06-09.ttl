<https://legal.dz/resource/law/1984-06-09/84-11#version_art_37> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1984-06-09/84-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لكل واحد من الزوجين ذمة مالية مستقلة عن ذمة الآخر. غير أنه يجوز للزوجين أن يتفقا في عقد الزواج أو في عقد رسمي لاحق، حول الأموال المشتركة بينهما، التي يكتسبانها خلال الحياة الزوجية وتحديد النسب التي تؤول إلى كل واحد منها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1984-06-09/84-11#version_art_37_19840609_OpEnact_873b1b4ae1> ;
    dzdoc:replacementText "لكل واحد من الزوجين ذمة مالية مستقلة عن ذمة الآخر. غير أنه يجوز للزوجين أن يتفقا في عقد الزواج أو في عقد رسمي لاحق، حول الأموال المشتركة بينهما، التي يكتسبانها خلال الحياة الزوجية وتحديد النسب التي تؤول إلى كل واحد منها."@ar ;
