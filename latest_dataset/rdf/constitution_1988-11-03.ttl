<https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_157_condition_0_df8abc75> a dznorm:Condition ;
    dznorm:conditionText "يمكن، عند الاقتضاء، أن تفضي هذه المناقشة الى إصدار لائحة من المجلس الشعبي الوطني"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_157> ;
