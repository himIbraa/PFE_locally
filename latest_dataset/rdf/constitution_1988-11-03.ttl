    dznorm:expressedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_155> ;
    dznorm:position 1 .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_155_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_155> ;
    dzdoc:position 0 ;
    dzdoc:text "يصبح رقم هذه المادة 154، وتحرر هكذا :"@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_155_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_155> ;
