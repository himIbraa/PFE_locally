<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_157> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن المجلس الشعبي الوطني ، بناء على طلب من رئيس الجمهورية ، أو رئيس الحكومة ، أو رئيس المجلس، أن يفتح مناقشة حول السياسة الخارجية . يمكن، عند الاقتضاء، أن تفضي هذه المناقشة الى إصدار لائحة من المجلس الشعبي الوطني يبلغها رئيسه الى رئيس الجمهورية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_157_19881103_OpEnact_b8dd2e53f5> ;
    dzdoc:replacementText "يمكن المجلس الشعبي الوطني ، بناء على طلب من رئيس الجمهورية ، أو رئيس الحكومة ، أو رئيس المجلس، أن يفتح مناقشة حول السياسة الخارجية . يمكن، عند الاقتضاء، أن تفضي هذه المناقشة الى إصدار لائحة من المجلس الشعبي الوطني يبلغها رئيسه الى رئيس الجمهورية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
