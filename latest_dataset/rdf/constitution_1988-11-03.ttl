<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_104> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجسد رئيس الجمهورية ، رئيس الدولة، وحدة الأمة. هو حامي الدستور يجسد الدولة داخل البلاد وخارجها. له أن يخاطب الأمة مباشرة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_104_19881103_OpEnact_d92a10749f> ;
    dzdoc:replacementText "يجسد رئيس الجمهورية ، رئيس الدولة، وحدة الأمة. هو حامي الدستور يجسد الدولة داخل البلاد وخارجها. له أن يخاطب الأمة مباشرة."@ar ;
