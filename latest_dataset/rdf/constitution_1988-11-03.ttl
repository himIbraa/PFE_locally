<https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_5_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_5> ;
    dzdoc:position 0 ;
    dzdoc:text "السيادة الوطنية ملك للشعب"@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_5_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_5> ;
    dzdoc:position 1 ;
    dzdoc:text "يمارس الشعب هذه السيادة عن طريق الاستفتاء"@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_5_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_5> ;
    dzdoc:position 2 ;
    dzdoc:text "يمارس الشعب هذه السيادة كذلك بواسطة ممثليه المنتخبين. ."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_5_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_5> ;
    dzdoc:position 3 ;
