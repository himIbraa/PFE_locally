<https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_147> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#chp_الثاني_السلطة_و_تنظيمها_sec_الثالث_الوظيفة_التشريعية> ;
    dzdoc:eId "art_147" ;
    dzdoc:fullText "يمكن استدعاء المجلس الشعبي الوطني للاجتماع في دورة استثنائية بمبادرة من رئيس الجمهورية أو بطلب من ثلثي أعضاء المجلس او من رئيس الحكومة . تختتم الدورة الاستثنائية بمجرد ما يستنفد المجلس الشعبي الوطني جدول الاعمال الذي استدعي من أجله ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_147_permission_0_e09857d4> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_147_right_0_06ab6665> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_147> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_147_para_0>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_147_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
