<https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_155> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#chp_الثاني_السلطة_و_تنظيمها_sec_الثالث_الوظيفة_التشريعية> ;
    dzdoc:eId "art_155" ;
    dzdoc:fullText "يصبح رقم هذه المادة 154 ، وتحرر هكذا : لـ رئيس الحكومة أن يطلب إجراء مداولة ثانية في القانون الذي تم التصويت عليه ، في ظرف ثلاثين (30) يوما من تاريخ إقراره . وفي هذه الحالة يتم إقرار القانون بأغلبية ثلثي أعضاء المجلس الشعبي الوطني ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_155_right_0_ae4cd71e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_155> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_155_para_0>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_155_para_1>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_155_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_155_19881103_OpEnact_7dd1b531b0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:introducedOn "1988-11-03"^^xsd:date ;
    dzdoc:number "المادة 155" ;
    dzdoc:position 15 ;
    dzdoc:references <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_154> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_154> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_155_condition_0_f81d34f8>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_155_condition_1_840aae1e> ;
    dzdoc:usesTerm dzterm:head_of_government,
        dzterm:national_people_assembly .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_116> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_116" ;
    dzdoc:fullText "لا يجوز بأي حال من الأحوال أن يفوض رئيس الجمهورية سلطته في تعيين نائب أو نواب رئيس الجمهورية، ورئيس الحكومة وأعضائها، أو في إعفائهم من مهامهم، أو في إجراء إستفتاء، أو في حل المجلس الشعبي الوطني، أو في تنظيم إنتخابات تشريعية مسبقة، أو في تطبيق الاحكام المنصوص عليها في المواد من 119 الى 124 من الدستور، وكذلك السلطات المحددة في الفقرات 1 و 2 و 3 و 5 و 8 و المادة 111 من الدستور"@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_116_permission_0_9c046fe3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_116> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_116_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_116_19881103_OpEnact_f5a7b310d8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_116_obligation_0_9c046fe3> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_116_prohibition_0_9c046fe3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:introducedOn "1988-11-03"^^xsd:date ;
    dzdoc:number "116" ;
    dzdoc:position 11 ;
    dzdoc:references <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_111>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_111__para_1>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_111__para_2>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_111__para_3>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_111__para_5>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_111__para_8>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_119>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_124> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_111>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_111__para_1>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_111__para_2>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_111__para_3>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_111__para_5>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_111__para_8>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_119>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_124> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#chp_الثاني_السلطة_و_تنظيمها_sec_الثالث_الوظيفة_التشريعية> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "يمكن المجلس الشعبي الوطني ، بناء على طلب من رئيس الجمهورية ، أو رئيس الحكومة ، أو رئيس المجلس، أن يفتح مناقشة حول السياسة الخارجية . يمكن، عند الاقتضاء، أن تفضي هذه المناقشة الى إصدار لائحة من المجلس الشعبي الوطني يبلغها رئيسه الى رئيس الجمهورية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_157_permission_0_50345974>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_157_permission_1_62e42f4d> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_157_right_0_54a8b6c9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_157_para_0>,
        <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_157_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_157_19881103_OpEnact_b8dd2e53f5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:introducedOn "1988-11-03"^^xsd:date ;
