<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_116> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز بأي حال من الأحوال أن يفوض رئيس الجمهورية سلطته في تعيين نائب أو نواب رئيس الجمهورية، ورئيس الحكومة وأعضائها، أو في إعفائهم من مهامهم، أو في إجراء إستفتاء، أو في حل المجلس الشعبي الوطني، أو في تنظيم إنتخابات تشريعية مسبقة، أو في تطبيق الاحكام المنصوص عليها في المواد من 119 الى 124 من الدستور، وكذلك السلطات المحددة في الفقرات 1 و 2 و 3 و 5 و 8 و المادة 111 من الدستور"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_116_19881103_OpEnact_f5a7b310d8> ;
    dzdoc:replacementText "لا يجوز بأي حال من الأحوال أن يفوض رئيس الجمهورية سلطته في تعيين نائب أو نواب رئيس الجمهورية، ورئيس الحكومة وأعضائها، أو في إعفائهم من مهامهم، أو في إجراء إستفتاء، أو في حل المجلس الشعبي الوطني، أو في تنظيم إنتخابات تشريعية مسبقة، أو في تطبيق الاحكام المنصوص عليها في المواد من 119 الى 124 من الدستور، وكذلك السلطات المحددة في الفقرات 1 و 2 و 3 و 5 و 8 و المادة 111 من الدستور"@ar ;
