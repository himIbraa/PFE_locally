    skos:prefLabel "السيادة الوطنية"@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1151_obligation_0_18edb75c_ref_f0049a66f9c7> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "الدستور"@ar ;
    dzdoc:frbrUri "/akn/dz/act/constitution/2020-12-30/1"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/constitution/2020-12-30/1"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/constitution/2020-12-30/1" ;
    dzdoc:referencesTarget <https://legal.dz/resource/constitution/2020-12-30/1> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceEId "art_1151" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يمارس رئيس الحكومة، زيادة على السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور، الصلاحيات الآتية :"@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/constitution/2020-12-30/1"^^xsd:anyURI .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#preamble_segment_0> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#preamble> ;
    dzdoc:position 0 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "بناء على التعديل الدستوري المصادق عليه في إستفتاء 3 نوفمبر سنة 1988"@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_104_19881103_OpEnact_d92a10749f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_104> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_104> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_104> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "يجسد رئيس الجمهورية ، رئيس الدولة، وحدة الأمة. هو حامي الدستور يجسد الدولة داخل البلاد وخارجها. له أن يخاطب الأمة مباشرة."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_111_19881103_OpEnact_d6f487707c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_111> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_111> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_111> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "يضطلع رئيس الجمهورية ، بالاضافة الى السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور، بالسلطات والصلاحيات الآتية : 1) هو القائد الأعلى لجميع القوات المسلحة للجمهورية، 2) يتولى مسؤولية الدفاع الوطني، 3) يقرر السياسة الخارجية للأمة، طبقا للميثاق الوطني وأحكام الدستور ويوجهها، 4) يعين رئيس الحكومة وينهي مهامه، 5) يرأس مجلس الوزراء، 6) يوقع المراسيم الرئاسية، 7) يعين في الوظائف المدنية والعسكرية طبقا للقانون، 8) له حق اصدار العفو وحق الغاء العقوبات أو تخفيضها، وحق ازالة الآثار القانونية، أيا كانت طبيعتها، التي تترتب على الأحكام التي تصدرها أية جهة قضائية، 9) يمكنه أن يعمد الى استفتاء الشعب في كل قضية ذات أهمية وطنية، 10) يمكنه أن يفوض بعض سلطاته الى نائبه أو الى نوابه مع مراعاة أحكام المادة 116 من الدستور، 11) يعين سفراء الجمهورية والمبعوثين فوق العادة الى الخارج وينهي مهامهم، ويتسلم أوراق اعتماد الممثلين الدبلوماسيين الأجانب، وأوراق انهاء مهامهم، 12) يبرم المعاهدات الدولية ويصادق عليها حسب الشروط التي يحددها الدستور، 13) يسلم أوسمة الدولة ونياشينها وشهاداتها التشريفية."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_113_19881103_OpEnact_82ecf603ea> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_113> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_113> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_113> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "يضبط رئيس الحكومة برنامج حكومته، وينسقه وينفذه. . وهو مسؤول أمام المجلس الشعبي الوطني."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1141_19881103_OpEnact_bbdf159bf1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1141> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1141> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1141> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "يشكل رئيس الحكومة بعد استشارات واسعة، حكومته، ويقدم أعضاءها الذين اختارهم ل رئيس الجمهورية الذي يعينهم."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1142_19881103_OpEnact_865a803879> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1142> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1142> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1142> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "يقدم رئيس الحكومة برنامجه الى المجلس الشعبي الوطني للموافقة عليه. يجري المجلس الشعبي الوطني مناقشة عامة للبرنامج المقدم. ويمكن رئيس الحكومة أن يكيف برنامجه، في ضوء هذه المناقشة."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1143_19881103_OpEnact_870fad3979> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1143> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1143> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1143> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "في حالة عدم موافقة المجلس الشعبي الوطني على البرنامج المعروض ، يقدم رئيس الحكومة لرئيس الجمهورية استقالة حكومته . يعين رئيس الجمهورية من جديد رئيس حكومة"@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1144_19881103_OpEnact_b1507ede96> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1144> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1144> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1144> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "اذا لم تحصل موافقة المجلس الشعبي الوطني على برنامج عمل رئيس الحكومة من جديد ، يحل المجلس قانونا. تنظم انتخابات تشريعية جديدة في أجل أقصاه ثلاثة أشهر."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1145_19881103_OpEnact_91fd1392a8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1145> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1145> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1145> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "تقدم الحكومة للمجلس الشعبي الوطني بيانا سنويا عن السياسة العامة . يعقب هذا البيان نقاش عام حول عمل الحكومة. ويمكن المجلس الشعبي الوطني أن يختتم هذا النقاش بلائحة. الرئيس الحكومة أن يطلب تصويتا بالثقة."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1151_19881103_OpEnact_ad95e5a80b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1151> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1151> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1151> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "يمارس رئيس الحكومة ، زيادة على السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور ، الصلاحيات الآتية : يوزع الصلاحيات بين أعضاء الحكومة مع احترام الأحكام الدستورية، يرأس مجلس الحكومة، يسهر على تنفيذ القوانين والتنظيمات، يوقع المراسيم التنفيذية، يعين في وظائف الدولة طبقا للقانون."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1152_19881103_OpEnact_f24fd26d9f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1152> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1152> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1152> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "ل رئيس الحكومة أن يقدم استقالة حكومته ل رئيس الجمهورية ."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_116_19881103_OpEnact_f5a7b310d8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_116> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_116> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_116> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "لا يجوز بأي حال من الأحوال أن يفوض رئيس الجمهورية سلطته في تعيين نائب أو نواب رئيس الجمهورية، ورئيس الحكومة وأعضائها، أو في إعفائهم من مهامهم، أو في إجراء إستفتاء، أو في حل المجلس الشعبي الوطني، أو في تنظيم إنتخابات تشريعية مسبقة، أو في تطبيق الاحكام المنصوص عليها في المواد من 119 الى 124 من الدستور، وكذلك السلطات المحددة في الفقرات 1 و 2 و 3 و 5 و 8 و المادة 111 من الدستور"@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_147_19881103_OpEnact_be63041aa0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_147> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_147> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_147> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "يمكن استدعاء المجلس الشعبي الوطني للاجتماع في دورة استثنائية بمبادرة من رئيس الجمهورية أو بطلب من ثلثي أعضاء المجلس او من رئيس الحكومة . تختتم الدورة الاستثنائية بمجرد ما يستنفد المجلس الشعبي الوطني جدول الاعمال الذي استدعي من أجله ."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_148_19881103_OpEnact_600b93b73d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_148> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_148> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_148> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "لكل من رئيس الحكومة وأعضاء المجلس الشعبي الوطني أن يبادر بالقوانين . تكون اقتراحات القوانين قابلة للنقاش اذا قدمها عشرون نائبا . تقدم الحكومة مشاريع القوانين المكتب المجلس الشعبي الوطني ."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_153_19881103_OpEnact_bd78917796> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_153> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_153> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_153> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "لـ رئيس الجمهورية ، فيما بين دورتي المجلس الشعبي الوطني ، أن يشرع بأمر، بناء على اقتراح من رئيس الحكومة . وتعرض الحكومة النصوص الصادرة بهذه الكيفية على المجلس الشعبي الوطني في أول دورة لاحقة ليوافق عليها ."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_154_19881103_OpEnact_b8d9fb35a1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_154> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_154> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_154> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "يصبح رقم هذه المادة 155 بدون تغيير."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_155_19881103_OpEnact_7dd1b531b0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_155> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_155> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_155> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "يصبح رقم هذه المادة 154 ، وتحرر هكذا : لـ رئيس الحكومة أن يطلب إجراء مداولة ثانية في القانون الذي تم التصويت عليه ، في ظرف ثلاثين (30) يوما من تاريخ إقراره . وفي هذه الحالة يتم إقرار القانون بأغلبية ثلثي أعضاء المجلس الشعبي الوطني ."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_156_19881103_OpEnact_8435f0b088> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_156> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_156> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_156> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "يمكن رئيس الجمهورية أن يوجه خطابا إلى المجلس الشعبي الوطني ."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_157_19881103_OpEnact_b8dd2e53f5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_157> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_157> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_157> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "يمكن المجلس الشعبي الوطني ، بناء على طلب من رئيس الجمهورية ، أو رئيس الحكومة ، أو رئيس المجلس، أن يفتح مناقشة حول السياسة الخارجية . يمكن، عند الاقتضاء، أن تفضي هذه المناقشة الى إصدار لائحة من المجلس الشعبي الوطني يبلغها رئيسه الى رئيس الجمهورية ."@ar .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_5_19881103_OpEnact_b6f717bb8d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1988-11-03"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_5> ;
    dzdoc:versionOf <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_5> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_5> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:versionText "السيادة الوطنية ملك للشعب يمارس الشعب هذه السيادة عن طريق الاستفتاء يمارس الشعب هذه السيادة كذلك بواسطة ممثليه المنتخبين. . الرئيس الجمهورية أن يرجع مباشرة إلى ارادة الشعب."@ar .

