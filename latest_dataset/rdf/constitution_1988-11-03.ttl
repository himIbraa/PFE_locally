<https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_113> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_113" ;
    dzdoc:fullText "يضبط رئيس الحكومة برنامج حكومته، وينسقه وينفذه. . وهو مسؤول أمام المجلس الشعبي الوطني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_113> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_113_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_113_19881103_OpEnact_82ecf603ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:introducedOn "1988-11-03"^^xsd:date ;
    dzdoc:number "المادة 113" ;
    dzdoc:position 3 ;
    dzdoc:usesTerm dzterm:head_of_government .

<https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1141> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/1988-11-03/[NUMBER]#chp_الثاني_السلطة_و_تنظيمها_sec_الثاني_الوظيفة_التنفيذية> ;
    dzdoc:eId "art_1141" ;
    dzdoc:fullText "يشكل رئيس الحكومة بعد استشارات واسعة، حكومته، ويقدم أعضاءها الذين اختارهم ل رئيس الجمهورية الذي يعينهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1141> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/1988-11-03/[NUMBER]#art_1141_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1141_19881103_OpEnact_bbdf159bf1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:introducedOn "1988-11-03"^^xsd:date ;
    dzdoc:number "المادة (114(1" ;
    dzdoc:position 4 ;
    dzdoc:usesTerm dzterm:head_of_government,
        dzterm:president .

