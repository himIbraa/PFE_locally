<https://legal.dz/resource/law/1988-11-03/[NUMBER]#version_art_1151> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/1988-11-03/[NUMBER]> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمارس رئيس الحكومة ، زيادة على السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور ، الصلاحيات الآتية : يوزع الصلاحيات بين أعضاء الحكومة مع احترام الأحكام الدستورية، يرأس مجلس الحكومة، يسهر على تنفيذ القوانين والتنظيمات، يوقع المراسيم التنفيذية، يعين في وظائف الدولة طبقا للقانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
