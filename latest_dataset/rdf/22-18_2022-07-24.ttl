<https://legal.dz/resource/law/2022-07-24/22-18#art_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:definesTerm dzterm:major_projects_one_stop_shop ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#sec_3> ;
    dzdoc:eId "art_19" ;
    dzdoc:fullText "الشباك الوحيد للمشاريع الكبرى والاستثمارات الأجنبية هو المحاور الوحيد ذو الاختصاص الوطني ، و يكلف بالقيام بكل الإجراءات اللازمة لتجسيد ومرافقة المشاريع الاستثمارية الكبرى والاستثمارات الأجنبية . تحدد معايير تأهيل المشاريع الاستثمارية الكبرى عن طريق التنظيم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2022-07-24/22-18#version_art_19> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2022-07-24/22-18#art_19_defocc_fc3690781dfe> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2022-07-24/22-18#art_19_para_0>,
        <https://legal.dz/resource/law/2022-07-24/22-18#art_19_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_19_20220724_OpEnact_758687aad9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2022-07-24/22-18#art_19_obligation_0_49ee435b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:introducedOn "2022-07-24"^^xsd:date ;
    dzdoc:number "19" ;
    dzdoc:position 18 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2022-07-24/22-18#art_19_condition_0_65691884> ;
    dzdoc:usesTerm dzterm:major_projects_one_stop_shop .

<https://legal.dz/resource/law/2022-07-24/22-18#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#sec_3> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "يضم الشباك الوحيد للمشاريع الكبرى والاستثمارات الأجنبية وكذا الشبابيك الوحيدة اللامركزية ممثلي الهيئات والإدارات المكلفة مباشرة بتنفيذ الإجراءات المرتبطة بما يأتي : تجسيد المشاريع الاستثمارية، منح المقررات والتراخيص وكل وثيقة لها علاقة بممارسة النشاط المرتبط بالمشروع الاستثماري، الحصول على العقار الموجه للاستثمار، متابعة الالتزامات المكتتبة من طرف المستثمر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2022-07-24/22-18#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2022-07-24/22-18#art_21_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_21_20220724_OpEnact_ac2bb27b03> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2022-07-24/22-18#art_21_obligation_0_8ae351c6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:introducedOn "2022-07-24"^^xsd:date ;
    dzdoc:number "21" ;
    dzdoc:position 20 ;
    dzdoc:usesTerm dzterm:decentralized_one_stop_shops,
        dzterm:major_projects_one_stop_shop .

<https://legal.dz/resource/law/2022-07-24/22-18#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#sec_6> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "تلغى كل الأحكام المخالفة لهذا القانون، لا سيما القانون رقم 16-09 المؤرخ في 29 شوال عام 1437 الموافق 3 غشت سنة 2016 والمتعلق بترقية الاستثمار ، باستثناء المادة 37 منه التي تبقى سارية المفعول. دون الإخلال بأحكام المادة 38 من هذا القانون، تبقى النصوص التطبيقية للقانون رقم 16-09 المؤرخ في 29 شوال عام 1437 الموافق 3 غشت سنة 2016 والمذكور أعلاه، سارية المفعول إلى غاية صدور النصوص التنظيمية المتخذة لتطبيق هذا القانون"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2022-07-24/22-18#version_art_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2022-07-24/22-18#art_40_para_0>,
        <https://legal.dz/resource/law/2022-07-24/22-18#art_40_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_40_20220724_OpEnact_fcdc6bb084> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:introducedOn "2022-07-24"^^xsd:date ;
    dzdoc:number "40" ;
    dzdoc:position 39 ;
    dzdoc:references <https://legal.dz/resource/law/2022-07-24/22-18#art_38> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2022-07-24/22-18#art_40_extref_55c504ac>,
        <https://legal.dz/resource/law/2022-07-24/22-18#art_40_extref_b6fe4bf4> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2022-07-24/22-18#art_38> .

<https://legal.dz/resource/law/2022-07-24/22-18#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#sec_4> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "يجب أن تخضع الاستثمارات، قبل إنجازها، للتسجيل لدى الشبابيك الوحيدة المختصة المذكورة في المادة 18 من هذا القانون ، من أجل الاستفادة من المزايا المنصوص عليها في أحكام هذا القانون. يتجسد تسجيل الاستثمار بتسليم شهادة على الفور مرفقة بقائمة السلع والخدمات القابلة للاستفادة من المزايا التي ترخص للمستثمر الاستفادة من الامتيازات التي له حق المطالبة بها لدى الإدارات والهيئات المعنية . تحدد كيفيات تطبيق هذه المادة وكذا قائمة السلع والخدمات غير القابلة للاستفادة من المزايا المحددة في أحكام هذا القانون، عن طريق التنظيم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2022-07-24/22-18#art_25_right_0_93bbc693> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2022-07-24/22-18#version_art_25> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2022-07-24/22-18#art_25_para_0>,
        <https://legal.dz/resource/law/2022-07-24/22-18#art_25_para_1>,
        <https://legal.dz/resource/law/2022-07-24/22-18#art_25_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_25_20220724_OpEnact_204cad4b93> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2022-07-24/22-18#art_25_obligation_0_edffe75e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:introducedOn "2022-07-24"^^xsd:date ;
    dzdoc:number "25" ;
    dzdoc:position 24 ;
    dzdoc:references <https://legal.dz/resource/law/2022-07-24/22-18#art_18> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2022-07-24/22-18#art_18> .

<https://legal.dz/resource/law/2022-07-24/22-18#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#sec_5> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "في حالة ممارسة نشاط مختلط أو عدة أنشطة ، لا تستفيد من المزايا المحددة في هذا القانون إلا تلك القابلة للاستفادة من المزايا. يمسك المستفيد من المزايا بهذا الصدد، محاسبة تسمح بتحديد أرقام الأعمال و النتائج ذات الصلة بالنشاطات القابلة للاستفادة من المزايا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2022-07-24/22-18#version_art_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2022-07-24/22-18#art_34_para_0>,
        <https://legal.dz/resource/law/2022-07-24/22-18#art_34_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_34_20220724_OpEnact_b0cf95e6c7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2022-07-24/22-18#art_34_obligation_0_0da2230c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:introducedOn "2022-07-24"^^xsd:date ;
    dzdoc:number "المادة 34" ;
    dzdoc:position 33 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2022-07-24/22-18#art_34_condition_0_4266d228> ;
    dzdoc:usesTerm dzterm:beneficiary .

