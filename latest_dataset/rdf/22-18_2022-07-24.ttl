<https://legal.dz/resource/law/2022-07-24/22-18#art_17_obligation_0_0e34bf38_ref_4b6fb4376e48> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "المادة 18"@ar ;
    dzdoc:frbrUri "/akn/dz/act/order/2001-08-20/01-03#art_18"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/order/2001-08-20/01-03#art_18"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/order/2001-08-20/01-03#art_18" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:sourceEId "art_17" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يكلف المجلس الوطني للاستثمار، المنشأ بموجب أحكام المادة 18 التي بقيت سارية المفعول ضمن الأمر رقم 01-03 المؤرخ في أول جمادى الثانية عام 1422 الموافق 20 غشت سنة 2001 والمتعلق بتطوير الاستثمار، باقتراح استراتيجية الدولة في مجال الاستثمار، والسهر على تناسقها الشامل وتقييم تنفيذها"@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/order/2001-08-20/01-03"^^xsd:anyURI ;
    dzdoc:targetEId "art_18" .

<https://legal.dz/resource/law/2022-07-24/22-18#art_17_obligation_0_0e34bf38_ref_73a4a73b2703> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "الأمر رقم 01-03 المؤرخ في أول جمادى الثانية عام 1422 الموافق 20 غشت سنة 2001 والمتعلق بتطوير الاستثمار"@ar ;
    dzdoc:frbrUri "/akn/dz/act/order/2001-08-20/01-03"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/order/2001-08-20/01-03"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/order/2001-08-20/01-03" ;
