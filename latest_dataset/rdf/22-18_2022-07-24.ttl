    dznorm:provisionText "تضمن الدولة حماية حقوق الملكية الفكرية طبقا للتشريع المعمول به"@ar ;
    dznorm:sourceArticle "art_9" .

<https://legal.dz/resource/law/2022-07-24/22-18#art_9_para_0> a dzdoc:Paragraph ;
