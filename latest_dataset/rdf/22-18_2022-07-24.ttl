<https://legal.dz/resource/law/2022-07-24/22-18#version_art_12> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "زيادة على أحكام المادة 11 أعلاه، يخضع كل خلاف ناجم عن تطبيق أحكام هذا القانون بين المستثمر الأجنبي و الدولة الجزائرية يتسبب فيه المستثمر أو يكون بسبب إجراء اتخذته الدولة الجزائرية في حقه، للجهات القضائية الجزائرية المختصة، ما لم توجد اتفاقيات ثنائية أو متعددة الأطراف صادقت عليها الدولة الجزائرية تتعلق أحكامها بالمصالحة والوساطة والتحكيم، أو إبرام اتفاق بين الوكالة المذكورة في المادة 18 أدناه، التي تتصرف باسم الدولة والمستثمر ، تسمح للأطراف باللجوء إلى التحكيم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_12_20220724_OpEnact_be8f3eb8fb> ;
    dzdoc:replacementText "زيادة على أحكام المادة 11 أعلاه، يخضع كل خلاف ناجم عن تطبيق أحكام هذا القانون بين المستثمر الأجنبي و الدولة الجزائرية يتسبب فيه المستثمر أو يكون بسبب إجراء اتخذته الدولة الجزائرية في حقه، للجهات القضائية الجزائرية المختصة، ما لم توجد اتفاقيات ثنائية أو متعددة الأطراف صادقت عليها الدولة الجزائرية تتعلق أحكامها بالمصالحة والوساطة والتحكيم، أو إبرام اتفاق بين الوكالة المذكورة في المادة 18 أدناه، التي تتصرف باسم الدولة والمستثمر ، تسمح للأطراف باللجوء إلى التحكيم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2022-07-24/22-18#art_12> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2022-07-24/22-18#art_12> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2022-07-24"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2022-07-24/22-18#version_art_13> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تسري الآثار الناجمة عن مراجعة أو إلغاء هذا القانون التي قد تطرأ مستقبلا، على الاستثمار المنجز في إطار هذا القانون، إلا إذا طلب المستثمر ذلك صراحة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
