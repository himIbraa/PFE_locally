<https://legal.dz/resource/law/2022-07-24/22-18#version_art_3> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرسخ هذا القانون المبادئ الآتية : حرية الاستثمار : كل شخص طبيعي أو معنوي، وطنيا كان أو أجنبيا، مقيم أو غير مقيم، يرغب في الاستثمار، هو حر في اختيار استثماره وذلك في ظل احترام التشريع والتنظيم المعمول بهما ، الشفافية والمساواة في التعامل مع الاستثمارات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_3_20220724_OpEnact_2bcdab966a> ;
    dzdoc:replacementText "يرسخ هذا القانون المبادئ الآتية : حرية الاستثمار : كل شخص طبيعي أو معنوي، وطنيا كان أو أجنبيا، مقيم أو غير مقيم، يرغب في الاستثمار، هو حر في اختيار استثماره وذلك في ظل احترام التشريع والتنظيم المعمول بهما ، الشفافية والمساواة في التعامل مع الاستثمارات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
