<https://legal.dz/resource/law/2022-07-24/22-18#art_17_obligation_0_0e34bf38> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/law/2022-07-24/22-18#art_17_obligation_0_0e34bf38_ref_4b6fb4376e48>,
        <https://legal.dz/resource/law/2022-07-24/22-18#art_17_obligation_0_0e34bf38_ref_73a4a73b2703> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2022-07-24/22-18#art_17_obligation_0_0e34bf38_role_6ba41304e2> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2022-07-24/22-18#art_17_obligation_0_0e34bf38_ref_4b6fb4376e48>,
        <https://legal.dz/resource/law/2022-07-24/22-18#art_17_obligation_0_0e34bf38_ref_73a4a73b2703> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_17> ;
    dznorm:position 0 ;
    dznorm:provisionText "يكلف المجلس الوطني للاستثمار، المنشأ بموجب أحكام المادة 18 التي بقيت سارية المفعول ضمن الأمر رقم 01-03 المؤرخ في أول جمادى الثانية عام 1422 الموافق 20 غشت سنة 2001 والمتعلق بتطوير الاستثمار، باقتراح استراتيجية الدولة في مجال الاستثمار، والسهر على تناسقها الشامل وتقييم تنفيذها"@ar ;
    dznorm:sourceArticle "art_17" .

<https://legal.dz/resource/law/2022-07-24/22-18#art_17_obligation_0_0e34bf38_role_6ba41304e2> a dznorm:Role ;
    rdfs:label "تناسقها الشامل وتقييم تنفيذها"@ar ;
