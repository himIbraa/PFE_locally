<https://legal.dz/resource/law/2022-07-24/22-18#art_21_obligation_0_8ae351c6> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasActivity <https://legal.dz/resource/law/2022-07-24/22-18#art_21_obligation_0_8ae351c6_activity_b9f5c81398>,
        <https://legal.dz/resource/law/2022-07-24/22-18#art_21_obligation_0_8ae351c6_activity_d6f4bf2318> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2022-07-24/22-18#art_21_obligation_0_8ae351c6_role_bc154e8371> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_21> ;
    dznorm:position 0 ;
    dznorm:provisionText """يضم الشباك الوحيد للمشاريع الكبرى والاستثمارات الأجنبية وكذا الشبابيك الوحيدة اللامركزية ممثلي الهيئات والإدارات المكلفة مباشرة بتنفيذ الإجراءات المرتبطة بما يأتي :
          
          تجسيد المشاريع الاستثمارية،
          منح المقررات والتراخيص وكل وثيقة لها علاقة بممارسة النشاط المرتبط بالمشروع الاستثماري،
          الحصول على العقار الموجه للاستثمار،
          متابعة الالتزامات المكتتبة من طرف المستثمر."""@ar ;
    dznorm:sourceArticle "art_21" .

