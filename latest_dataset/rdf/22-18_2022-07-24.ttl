<https://legal.dz/resource/law/2022-07-24/22-18#version_art_30> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون الاستثمارات ذات القدرة العالية لخلق الثروة واستحداث مناصب الشغل، والتي من شأنها الرفع من جاذبية الإقليم وتكون قوة دافعة للنشاط الاقتصادي من أجل تنمية مستدامة، قابلة للاستفادة من نظام \"الاستثمارات المهيكلة\" . تحدد معايير تأهيل الاستثمارات القابلة للاستفادة من \"نظام الاستثمارات المهيكلة\" ، عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_30_20220724_OpEnact_c18029214b> ;
    dzdoc:replacementText "تكون الاستثمارات ذات القدرة العالية لخلق الثروة واستحداث مناصب الشغل، والتي من شأنها الرفع من جاذبية الإقليم وتكون قوة دافعة للنشاط الاقتصادي من أجل تنمية مستدامة، قابلة للاستفادة من نظام \"الاستثمارات المهيكلة\" . تحدد معايير تأهيل الاستثمارات القابلة للاستفادة من \"نظام الاستثمارات المهيكلة\" ، عن طريق التنظيم."@ar ;
