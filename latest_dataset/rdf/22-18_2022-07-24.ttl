dzterm:algerian_investment_promotion_agency a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوكالة الجزائرية لترقية الاستثمار"@ar,
        "تدعى الوكالة الوطنية لتطوير الاستثمار المنشأة بموجب المادة 6 التي بقيت سارية المفعول ضمن الأمر رقم 01-03 المؤرخ في أول جمادى الثانية عام 1422 الموافق 20 غشت سنة 2001 والمتعلق بتطوير الاستثمار، من الآن فصاعدا \"الوكالة الجزائرية لترقية الاستثمار\"، وتدعى في صلب هذا النص \"الوكالة\""@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2022-07-24/22-18#art_18_defocc_aff980e7584c> .

dzterm:committee a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "اللجنة"@ar,
        "لجنة وطنية عليا للطعون المتصلة بالاستثمار"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2022-07-24/22-18#art_11_defocc_f8689de742e0> .

dzterm:investor a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المستثمر"@ar,
        "المستثمر : كل شخص طبيعي أو معنوي، وطنيا كان أو أجنبيا، مقيما أو غير مقيم، بمفهوم التنظيم الخاص بالصرف، ينجز استثمارا طبقا لأحكام هذا القانون."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2022-07-24/22-18#art_5_defocc_96bf1972fffa> .

dzterm:investor_digital_platform a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المنصة الرقمية"@ar,
        "منصة رقمية للمستثمر"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2022-07-24/22-18#art_23_defocc_1697458bc8a7> .

dzterm:national_investment_council a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المجلس الوطني للاستثمار"@ar .

dzterm:structured_investments a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "\"الاستثمارات المهيكلة\""@ar,
        "\"نظام الاستثمارات المهيكلة\""@ar,
        "تكون الاستثمارات ذات القدرة العالية لخلق الثروة واستحداث مناصب الشغل، والتي من شأنها الرفع من جاذبية الإقليم وتكون قوة دافعة للنشاط الاقتصادي من أجل تنمية مستدامة، قابلة للاستفادة من نظام \"الاستثمارات المهيكلة\"."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2022-07-24/22-18#art_30_defocc_ed63b7ef2290> .

<https://legal.dz/resource/law/2022-07-24/22-18#art_5_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_5> ;
    dzdoc:position 0 ;
    dzdoc:text "يقصد، في مفهوم هذا القانون، بما يأتي : المستثمر : كل شخص طبيعي أو معنوي، وطنيا كان أو أجنبيا، مقيما أو غير مقيم، بمفهوم التنظيم الخاص بالصرف، ينجز استثمارا طبقا لأحكام هذا القانون. استثمار الإنشاء : كل استثمار منجز من أجل إنشاء رأسمال تقني من العدم باقتناء أصول بغرض إنشاء نشاط إنتاج السلع و/أو الخدمات. استثمار التوسع : كل استثمار منجز بهدف رفع قدرات إنتاج السلع و/أو الخدمات عن طريق اقتناء وسائل إنتاج جديدة تضاف إلى تلك الموجودة."@ar .

