<https://legal.dz/resource/law/2022-07-24/22-18#version_art_5> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقصد، في مفهوم هذا القانون، بما يأتي : المستثمر : كل شخص طبيعي أو معنوي، وطنيا كان أو أجنبيا، مقيما أو غير مقيم، بمفهوم التنظيم الخاص بالصرف، ينجز استثمارا طبقا لأحكام هذا القانون. استثمار الإنشاء : كل استثمار منجز من أجل إنشاء رأسمال تقني من العدم باقتناء أصول بغرض إنشاء نشاط إنتاج السلع و/أو الخدمات. استثمار التوسع : كل استثمار منجز بهدف رفع قدرات إنتاج السلع و/أو الخدمات عن طريق اقتناء وسائل إنتاج جديدة تضاف إلى تلك الموجودة. لا يخول اقتناء تجهيزات تكميلية ملحقة و/أو مرتبطة طابع التوسع للاستث"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_5_20220724_OpEnact_e36aaa49da> ;
    dzdoc:replacementText "يقصد، في مفهوم هذا القانون، بما يأتي : المستثمر : كل شخص طبيعي أو معنوي، وطنيا كان أو أجنبيا، مقيما أو غير مقيم، بمفهوم التنظيم الخاص بالصرف، ينجز استثمارا طبقا لأحكام هذا القانون. استثمار الإنشاء : كل استثمار منجز من أجل إنشاء رأسمال تقني من العدم باقتناء أصول بغرض إنشاء نشاط إنتاج السلع و/أو الخدمات. استثمار التوسع : كل استثمار منجز بهدف رفع قدرات إنتاج السلع و/أو الخدمات عن طريق اقتناء وسائل إنتاج جديدة تضاف إلى تلك الموجودة. لا يخول اقتناء تجهيزات تكميلية ملحقة و/أو مرتبطة طابع التوسع للاستثمار. وكذلك هو الشأن بالنسبة لاقتناء تجهيزات تجديد أو استبدال مماثلة لتلك الموجودة. استثمار إعادة التأهيل : كل استثمار منجز يتمثل في عمليات اقتناء سلع و/أو خدمات موجهة لمطابقة العتاد والتجهيزات الموجودة من أجل معالجة التأخر التكنولوجي أو بسبب الاهتلاك لقدمها والتي تؤثر عليها من أجل رفع الإنتاجية أو إعادة بعث نشاط متوقف منذ ثلاث (3) سنوات على الأقل. نقل أنشطة من الخارج : عمل التحويل الذي تقوم بموجبه مؤسسة خاضعة للقانون الأجنبي، لكل أو لجزء من أنشطتها من الخارج إلى الجزائر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2022-07-24/22-18#art_5> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2022-07-24/22-18#art_5> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2022-07-24"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2022-07-24/22-18#version_art_6> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن تستفيد المشاريع الاستثمارية القابلة للاستفادة من الأنظمة التحفيزية المنصوص عليها في هذا القانون من أراض تابعة للأملاك الخاصة للدولة . تمنح الأراضي من طرف الهيئات المكلفة بالعقار ، طبقا للشروط والكيفيات المنصوص عليها في التشريع والتنظيم المعمول بهما . توضع المعلومات التي تتعلق بتوفر العقار تحت تصرف المستثمر من طرف الهيئات المكلفة بالعقار ، لا سيما من خلال المنصة الرقمية للمستثمر المذكورة في المادة 23 أدناه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_6_20220724_OpEnact_01c376a359> ;
    dzdoc:replacementText "يمكن أن تستفيد المشاريع الاستثمارية القابلة للاستفادة من الأنظمة التحفيزية المنصوص عليها في هذا القانون من أراض تابعة للأملاك الخاصة للدولة . تمنح الأراضي من طرف الهيئات المكلفة بالعقار ، طبقا للشروط والكيفيات المنصوص عليها في التشريع والتنظيم المعمول بهما . توضع المعلومات التي تتعلق بتوفر العقار تحت تصرف المستثمر من طرف الهيئات المكلفة بالعقار ، لا سيما من خلال المنصة الرقمية للمستثمر المذكورة في المادة 23 أدناه."@ar ;
