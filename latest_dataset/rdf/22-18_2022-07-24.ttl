<https://legal.dz/resource/law/2022-07-24/22-18#version_art_34> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة ممارسة نشاط مختلط أو عدة أنشطة ، لا تستفيد من المزايا المحددة في هذا القانون إلا تلك القابلة للاستفادة من المزايا. يمسك المستفيد من المزايا بهذا الصدد، محاسبة تسمح بتحديد أرقام الأعمال و النتائج ذات الصلة بالنشاطات القابلة للاستفادة من المزايا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_34_20220724_OpEnact_b0cf95e6c7> ;
    dzdoc:replacementText "في حالة ممارسة نشاط مختلط أو عدة أنشطة ، لا تستفيد من المزايا المحددة في هذا القانون إلا تلك القابلة للاستفادة من المزايا. يمسك المستفيد من المزايا بهذا الصدد، محاسبة تسمح بتحديد أرقام الأعمال و النتائج ذات الصلة بالنشاطات القابلة للاستفادة من المزايا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2022-07-24/22-18#art_34> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2022-07-24/22-18> ;
