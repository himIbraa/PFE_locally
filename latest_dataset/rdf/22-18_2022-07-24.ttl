<https://legal.dz/resource/law/2022-07-24/22-18#art_32_obligation_0_e2801b56_ref_bb4e593479ad> a dzdoc:Reference ;
    rdfs:label "المادة 4"@ar ;
    dzdoc:frbrUri "#art_4"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2022-07-24/22-18#art_4> ;
    dzdoc:sourceEId "art_32" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يجب أن تنجز الاستثمارات المذكورة في المادة 4 من هذا القانون، في مدة لا تتعدى ثلاث (3) سنوات"@ar ;
    dzdoc:targetEId "art_4" .

<https://legal.dz/resource/law/2022-07-24/22-18#art_32_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_32> ;
    dzdoc:position 0 ;
    dzdoc:text "مع مراعاة مدة الإعفاء من الرسم العقاري على الملكيات العقارية التي تدخل في إطار الاستثمار، يجب أن تنجز الاستثمارات المذكورة في المادة 4 من هذا القانون، في مدة لا تتعدى ثلاث (3) سنوات، وترفع هذه المدة إلى خمس (5) سنوات فيما يخص الاستثمارات المدرجة ضمن \"نظام المناطق\" و \"نظام الاستثمارات المهيكلة\"."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_32_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_32> ;
    dzdoc:position 1 ;
    dzdoc:text "يسري الأجل المحدد لإنجاز الاستثمار ابتداء من تاريخ تسجيل الاستثمار لدى الوكالة أو ابتداء من تاريخ تسليم رخصة البناء في الحالات التي تكون فيها هذه الرخصة مطلوبة."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_32_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_32> ;
    dzdoc:position 2 ;
    dzdoc:text "ويمكن تمديد أجل الإنجاز لمدة اثني عشر (12) شهرا قابلة للتجديد بصفة استثنائية مرة واحدة لنفس المدة وذلك عندما يتجاوز إنجاز الاستثمار نسبة تقدم معينة."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_32_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_32> ;
    dzdoc:position 3 ;
    dzdoc:text "تحدد كيفيات وشروط تطبيق أحكام هذه المادة، عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_32_right_0_b0bcb9b9> a dznorm:Right ;
