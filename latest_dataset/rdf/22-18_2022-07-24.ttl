<https://legal.dz/resource/law/2022-07-24/22-18#art_28_condition_0_c34ee148> a dznorm:Condition ;
    dznorm:conditionText "تعد قابلة للاستفادة من \"نظام المناطق\"، الاستثمارات المنجزة في :"@ar ;
