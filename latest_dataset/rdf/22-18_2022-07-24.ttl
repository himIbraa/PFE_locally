    dzdoc:targetEId "art_37" .

<https://legal.dz/resource/law/2022-07-24/22-18#art_40_extref_b6fe4bf4> a dzdoc:ExternalReference ;
    rdfs:label "القانون رقم 16-09 المؤرخ في 29 شوال عام 1437 الموافق 3 غشت سنة 2016 والمتعلق بترقية الاستثمار"@ar,
        "للقانون رقم 16-09 المؤرخ في 29 شوال عام 1437 الموافق 3 غشت سنة 2016"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/2016-08-03/16-09"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/2016-08-03/16-09"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/2016-08-03/16-09" ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2016-08-03/16-09> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/2016-08-03/16-09"^^xsd:anyURI .

<https://legal.dz/resource/law/2022-07-24/22-18#art_40_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_40> ;
    dzdoc:position 0 ;
    dzdoc:text "تلغى كل الأحكام المخالفة لهذا القانون، لا سيما القانون رقم 16-09 المؤرخ في 29 شوال عام 1437 الموافق 3 غشت سنة 2016 والمتعلق بترقية الاستثمار، باستثناء المادة 37 منه التي تبقى سارية المفعول."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_40_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_40> ;
    dzdoc:position 1 ;
    dzdoc:text "دون الإخلال بأحكام المادة 38 من هذا القانون، تبقى النصوص التطبيقية للقانون رقم 16-09 المؤرخ في 29 شوال عام 1437 الموافق 3 غشت سنة 2016 والمذكور أعلاه، سارية المفعول إلى غاية صدور النصوص التنظيمية المتخذة لتطبيق هذا القانون"@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_41_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_41> ;
    dzdoc:position 0 ;
    dzdoc:text "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_41_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_41> ;
    dzdoc:position 1 ;
    dzdoc:text "حرر بالجزائر في 25 ذي الحجة عام 1443 الموافق 24 يوليو سنة 2022."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_41_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_41> ;
    dzdoc:position 2 ;
    dzdoc:text "عبد المجيد تبون"@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_4_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_4> ;
    dzdoc:position 0 ;
    dzdoc:text "تخضع لأحكام هذا القانون، الاستثمارات المنجزة من خلال : اقتناء الأصول المادية أو غير المادية التي تندرج مباشرة ضمن نشاطات إنتاج السلع والخدمات في إطار إنشاء أنشطة جديدة وتوسيع قدرات الإنتاج و/أو إعادة تأهيل أدوات الإنتاج، المساهمة في رأسمال مؤسسة في شكل حصص نقدية أو عينية، نقل أنشطة من الخارج."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_5_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_5> ;
    dzdoc:position 1 ;
    dzdoc:text "لا يخول اقتناء تجهيزات تكميلية ملحقة و/أو مرتبطة طابع التوسع للاستثمار. وكذلك هو الشأن بالنسبة لاقتناء تجهيزات تجديد أو استبدال مماثلة لتلك الموجودة."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_6_condition_0_485a3e24> a dznorm:Condition ;
    dznorm:conditionText "طبقا للشروط والكيفيات المنصوص عليها في التشريع والتنظيم المعمول بهما"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_6> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2022-07-24/22-18#art_6_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_6> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن أن تستفيد المشاريع الاستثمارية القابلة للاستفادة من الأنظمة التحفيزية المنصوص عليها في هذا القانون من أراض تابعة للأملاك الخاصة للدولة."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_6_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_6> ;
    dzdoc:position 1 ;
    dzdoc:text "تمنح الأراضي من طرف الهيئات المكلفة بالعقار، طبقا للشروط والكيفيات المنصوص عليها في التشريع والتنظيم المعمول بهما."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_6_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_6> ;
    dzdoc:position 2 ;
    dzdoc:text "توضع المعلومات التي تتعلق بتوفر العقار تحت تصرف المستثمر من طرف الهيئات المكلفة بالعقار، لا سيما من خلال المنصة الرقمية للمستثمر المذكورة في المادة 23 أدناه."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_6_permission_0_e02d9258> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2022-07-24/22-18#art_6_permission_0_e02d9258_action_9bf6551819> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_6> ;
    dznorm:position 0 ;
