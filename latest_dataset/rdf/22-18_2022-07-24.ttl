    dznorm:conditionText "يمكن أن تستفيد الاستثمارات، بمفهوم المادة 4 من هذا القانون بناء على طلب من المستثمر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_24> ;
