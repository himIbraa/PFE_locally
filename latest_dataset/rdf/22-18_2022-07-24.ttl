<https://legal.dz/resource/law/2022-07-24/22-18#art_1_obligation_0_13d018f2> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_1> ;
    dznorm:position 0 ;
    dznorm:provisionText "التزاماتهم"@ar ;
    dznorm:sourceArticle "art_1" .

<https://legal.dz/resource/law/2022-07-24/22-18#art_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_1> ;
    dzdoc:position 0 ;
    dzdoc:text "يهدف هذا القانون إلى تحديد القواعد التي تنظم الاستثمار وحقوق المستثمرين والتزاماتهم، والأنظمة التحفيزية المطبقة على الاستثمارات في الأنشطة الاقتصادية لإنتاج السلع والخدمات المنجزة من طرف الأشخاص الطبيعيين أو المعنويين الوطنيين أو الأجانب، مقيمين كانوا أو غير مقيمين."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_1_right_0_904be88a> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
