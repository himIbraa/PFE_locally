    dzdoc:text "يصدر القانون الآتي نصه :"@ar .

dzterm:decentralized_one_stop_shops a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الشبابيك الوحيدة اللامركزية"@ar,
        "الشبابيك الوحيدة اللامركزية هي بمثابة المحاور الوحيد للمستثمرين على المستوى المحلي"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2022-07-24/22-18#art_20_defocc_209e6ae99b98> .

dzterm:major_projects_one_stop_shop a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الشباك الوحيد للمشاريع الكبرى والاستثمارات الأجنبية"@ar,
        "الشباك الوحيد للمشاريع الكبرى والاستثمارات الأجنبية هو المحاور الوحيد ذو الاختصاص الوطني"@ar ;
