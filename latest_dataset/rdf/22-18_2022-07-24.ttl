<https://legal.dz/resource/law/2022-07-24/22-18#version_art_18> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تدعى الوكالة الوطنية لتطوير الاستثمار المنشأة بموجب المادة 6 التي بقيت سارية المفعول ضمن الأمر رقم 01-03 المؤرخ في أول جمادى الثانية عام 1422 الموافق 20 غشت سنة 2001 والمتعلق بتطوير الاستثمار ، من الآن فصاعدا \"الوكالة الجزائرية لترقية الاستثمار\"، وتدعى في صلب هذا النص \"الوكالة\" . تكلف الوكالة بالتنسيق مع الإدارات والهيئات المعنية بما يأتي: ترقية وتثمين الاستثمار في الجزائر وكذا في الخارج وجاذبية الجزائر، بالاتصال مع الممثليات الدبلوماسية والقنصلية الجزائرية بالخارج، إعلام أوساط الأعمال وتحسيسهم،"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_18_20220724_OpEnact_738289d313> ;
    dzdoc:replacementText "تدعى الوكالة الوطنية لتطوير الاستثمار المنشأة بموجب المادة 6 التي بقيت سارية المفعول ضمن الأمر رقم 01-03 المؤرخ في أول جمادى الثانية عام 1422 الموافق 20 غشت سنة 2001 والمتعلق بتطوير الاستثمار ، من الآن فصاعدا \"الوكالة الجزائرية لترقية الاستثمار\"، وتدعى في صلب هذا النص \"الوكالة\" . تكلف الوكالة بالتنسيق مع الإدارات والهيئات المعنية بما يأتي: ترقية وتثمين الاستثمار في الجزائر وكذا في الخارج وجاذبية الجزائر، بالاتصال مع الممثليات الدبلوماسية والقنصلية الجزائرية بالخارج، إعلام أوساط الأعمال وتحسيسهم، ضمان تسيير المنصة الرقمية للمستثمر، تسجيل ملفات الاستثمار ومعالجتها، مرافقة المستثمر في استكمال الإجراءات المتصلة باستثماره، تسيير المزايا، بما فيها تلك المتعلقة بحافظة المشاريع المصرح بها أو المسجلة قبل تاريخ إصدار هذا القانون، متابعة مدى تقدم وضعية المشاريع الاستثمارية. تنشأ لدى الوكالة الشبابيك الوحيدة الآتية : الشباك الوحيد للمشاريع الكبرى والاستثمارات الأجنبية ، الشبابيك الوحيدة اللامركزية . تحصل الوكالة إتاوة بعنوان معالجة ملفات الاستثمار . يحدد تنظيم الوكالة وسيرها وكذا مبلغ وكيفيات تحصيل الإتاوة عن طريق التنظيم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2022-07-24/22-18#art_18> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2022-07-24/22-18#art_18> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2022-07-24"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2022-07-24/22-18#version_art_19> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الشباك الوحيد للمشاريع الكبرى والاستثمارات الأجنبية هو المحاور الوحيد ذو الاختصاص الوطني ، و يكلف بالقيام بكل الإجراءات اللازمة لتجسيد ومرافقة المشاريع الاستثمارية الكبرى والاستثمارات الأجنبية . تحدد معايير تأهيل المشاريع الاستثمارية الكبرى عن طريق التنظيم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
