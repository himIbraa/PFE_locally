<https://legal.dz/resource/law/2022-07-24/22-18#art_18_obligation_0_1dd21d8e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_18> ;
    dznorm:position 0 ;
    dznorm:provisionText """تكلف الوكالة بالتنسيق مع الإدارات والهيئات المعنية بما يأتي:
          
          ترقية وتثمين الاستثمار في الجزائر وكذا في الخارج وجاذبية الجزائر، بالاتصال مع الممثليات الدبلوماسية والقنصلية الجزائرية بالخارج،
          إعلام أوساط الأعمال وتحسيسهم،
          ضمان تسيير المنصة الرقمية للمستثمر،
          تسجيل ملفات الاستثمار ومعالجتها،
          مرافقة المستثمر في استكمال الإجراءات المتصلة باستثماره،
          تسيير المزايا، بما فيها تلك المتعلقة بحافظة المشاريع المصرح بها أو المسجلة قبل تاريخ إصدار هذا القانون،
          متابعة مدى تقدم وضعية المشاريع الاستثمارية."""@ar ;
    dznorm:sourceArticle "art_18" .

<https://legal.dz/resource/law/2022-07-24/22-18#art_18_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_18> ;
    dzdoc:position 1 ;
    dzdoc:text """تكلف الوكالة بالتنسيق مع الإدارات والهيئات المعنية بما يأتي:
          
          ترقية وتثمين الاستثمار في الجزائر وكذا في الخارج وجاذبية الجزائر، بالاتصال مع الممثليات الدبلوماسية والقنصلية الجزائرية بالخارج،
          إعلام أوساط الأعمال وتحسيسهم،
          ضمان تسيير المنصة الرقمية للمستثمر،
          تسجيل ملفات الاستثمار ومعالجتها،
          مرافقة المستثمر في استكمال الإجراءات المتصلة باستثماره،
          تسيير المزايا، بما فيها تلك المتعلقة بحافظة المشاريع المصرح بها أو المسجلة قبل تاريخ إصدار هذا القانون،
          متابعة مدى تقدم وضعية المشاريع الاستثمارية. ترقية وتثمين الاستثمار في الجزائر وكذا في الخارج وجاذبية الجزائر، بالاتصال مع الممثليات الدبلوماسية والقنصلية الجزائرية بالخارج، إعلام أوساط الأعمال وتحسيسهم، ضمان تسيير المنصة الرقمية للمستثمر، تسجيل ملفات الاستثمار ومعالجتها، مرافقة المستثمر في استكمال الإجراءات المتصلة باستثماره، تسيير المزايا، بما فيها تلك المتعلقة بحافظة المشاريع المصرح بها أو المسجلة قبل تاريخ إصدار هذا القانون، متابعة مدى تقدم وضعية المشاريع الاستثمارية."""@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_18_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_18> ;
    dzdoc:position 2 ;
    dzdoc:text """تنشأ لدى الوكالة الشبابيك الوحيدة الآتية :
          
          الشباك الوحيد للمشاريع الكبرى والاستثمارات الأجنبية،
          الشبابيك الوحيدة اللامركزية. الشباك الوحيد للمشاريع الكبرى والاستثمارات الأجنبية، الشبابيك الوحيدة اللامركزية."""@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_18_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_18> ;
    dzdoc:position 3 ;
    dzdoc:text "تحصل الوكالة إتاوة بعنوان معالجة ملفات الاستثمار."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_18_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_18> ;
    dzdoc:position 4 ;
    dzdoc:text "يحدد تنظيم الوكالة وسيرها وكذا مبلغ وكيفيات تحصيل الإتاوة عن طريق التنظيم."@ar .

