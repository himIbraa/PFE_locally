<https://legal.dz/resource/law/2022-07-24/22-18#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#sec_2> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "زيادة على أحكام المادة 11 أعلاه، يخضع كل خلاف ناجم عن تطبيق أحكام هذا القانون بين المستثمر الأجنبي و الدولة الجزائرية يتسبب فيه المستثمر أو يكون بسبب إجراء اتخذته الدولة الجزائرية في حقه، للجهات القضائية الجزائرية المختصة، ما لم توجد اتفاقيات ثنائية أو متعددة الأطراف صادقت عليها الدولة الجزائرية تتعلق أحكامها بالمصالحة والوساطة والتحكيم، أو إبرام اتفاق بين الوكالة المذكورة في المادة 18 أدناه، التي تتصرف باسم الدولة والمستثمر ، تسمح للأطراف باللجوء إلى التحكيم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2022-07-24/22-18#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2022-07-24/22-18#art_12_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_12_20220724_OpEnact_be8f3eb8fb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:introducedOn "2022-07-24"^^xsd:date ;
    dzdoc:number "12" ;
    dzdoc:position 11 ;
    dzdoc:references <https://legal.dz/resource/law/2022-07-24/22-18#art_11>,
        <https://legal.dz/resource/law/2022-07-24/22-18#art_18> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2022-07-24/22-18#art_11>,
        <https://legal.dz/resource/law/2022-07-24/22-18#art_18> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2022-07-24/22-18#art_12_condition_0_fdf1e11e> ;
    dzdoc:usesTerm dzterm:agency,
        dzterm:algerian_state,
        dzterm:foreign_investor .

<https://legal.dz/resource/law/2022-07-24/22-18#art_13> a dzdoc:Article ;
