    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:transfer_activities ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2022-07-24/22-18#art_5> ;
