    dzdoc:sourceTextSpan "يمكن أن تستفيد الاستثمارات، بمفهوم المادة 4 من هذا القانون بناء على طلب من المستثمر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_24> .

<https://legal.dz/resource/law/2022-07-24/22-18#art_24_condition_0_9dedab8b_ref_bb4e593479ad> a dzdoc:Reference ;
    rdfs:label "المادة 4"@ar ;
    dzdoc:frbrUri "#art_4"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2022-07-24/22-18#art_4> ;
    dzdoc:sourceEId "art_24" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "يمكن أن تستفيد الاستثمارات، بمفهوم المادة 4 من هذا القانون بناء على طلب من المستثمر"@ar ;
    dzdoc:targetEId "art_4" .

<https://legal.dz/resource/law/2022-07-24/22-18#art_24_condition_0_9dedab8b_role_a30ea091ba> a dznorm:Role ;
    rdfs:label "طلب من المستثمر"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يمكن أن تستفيد الاستثمارات، بمفهوم المادة 4 من هذا القانون بناء على طلب من المستثمر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_24> .

<https://legal.dz/resource/law/2022-07-24/22-18#art_24_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_24> ;
    dzdoc:position 0 ;
    dzdoc:text """يمكن أن تستفيد الاستثمارات، بمفهوم المادة 4 من هذا القانون بناء على طلب من المستثمر، من أحد الأنظمة التحفيزية المذكورة أدناه:
          
          النظام التحفيزي للقطاعات ذات الأولوية، ويدعى في صلب النص "نظام القطاعات"،
          النظام التحفيزي للمناطق التي توليها الدولة أهمية خاصة، ويدعى في صلب النص "نظام المناطق"،
          النظام التحفيزي للاستثمارات ذات الطابع المهيكل ويدعى في صلب النص نظام" الاستثمارات المهيكلة". النظام التحفيزي للقطاعات ذات الأولوية، ويدعى في صلب النص "نظام القطاعات"، النظام التحفيزي للمناطق التي توليها الدولة أهمية خاصة، ويدعى في صلب النص "نظام المناطق"، النظام التحفيزي للاستثمارات ذات الطابع المهيكل ويدعى في صلب النص نظام" الاستثمارات المهيكلة"."""@ar .

