    dzdoc:evidenceText "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 25 ذي الحجة عام 1443 الموافق 24 يوليو سنة 2022. عبد المجيد تبون"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
