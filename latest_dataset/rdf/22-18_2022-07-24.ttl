<https://legal.dz/resource/law/2022-07-24/22-18#version_art_2> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ترمي أحكام هذا القانون إلى تشجيع الاستثمار، بهدف: تطوير قطاعات النشاطات ذات الأولوية وذات قيمة مضافة عالية، ضمان تنمية إقليمية مستدامة ومتوازنة، تثمين الموارد الطبيعية والمواد الأولية المحلية، إعطاء الأفضلية للتحويل التكنولوجي وتطوير الابتكار واقتصاد المعرفة، تعميم استعمال التكنولوجيات الحديثة، تفعيل استحداث مناصب الشغل الدائمة وترقية كفاءات الموارد البشرية، تدعيم وتحسين تنافسية الاقتصاد الوطني وقدرته على التصدير."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_2_20220724_OpEnact_074fdbba11> ;
    dzdoc:replacementText "ترمي أحكام هذا القانون إلى تشجيع الاستثمار، بهدف: تطوير قطاعات النشاطات ذات الأولوية وذات قيمة مضافة عالية، ضمان تنمية إقليمية مستدامة ومتوازنة، تثمين الموارد الطبيعية والمواد الأولية المحلية، إعطاء الأفضلية للتحويل التكنولوجي وتطوير الابتكار واقتصاد المعرفة، تعميم استعمال التكنولوجيات الحديثة، تفعيل استحداث مناصب الشغل الدائمة وترقية كفاءات الموارد البشرية، تدعيم وتحسين تنافسية الاقتصاد الوطني وقدرته على التصدير."@ar ;
