    dznorm:expressedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_11> .

<https://legal.dz/resource/law/2022-07-24/22-18#art_11_obligation_0_a7f2cf15_period_9065b68d20> a dznorm:Period ;
    rdfs:label "في أجل لا يتجاوز شهرا واحدا (1)"@ar ;
    dzdoc:confidenceScore 0.68 ;
