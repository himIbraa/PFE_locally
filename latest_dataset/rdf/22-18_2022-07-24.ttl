<https://legal.dz/resource/law/2022-07-24/22-18#version_art_14> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن تكون السلع والخدمات التي استفادت من المزايا المنصوص عليها في أحكام هذا القانون وكذا تلك الممنوحة في ظل الأحكام السابقة، موضوع تحويل أو تنازل بموجب رخصة تسلمها الوكالة المذكورة في المادة 18 أدناه. تحدد كيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_14_20220724_OpEnact_35206daa3c> ;
