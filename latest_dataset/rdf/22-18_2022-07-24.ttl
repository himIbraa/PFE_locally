<https://legal.dz/resource/law/2022-07-24/22-18#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#sec_3> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "الأجهزة المكلفة بالاستثمار هي: المجلس الوطني للاستثمار ، الوكالة الجزائرية لترقية الاستثمار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2022-07-24/22-18#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2022-07-24/22-18#art_16_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_16_20220724_OpEnact_555b93ca06> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:introducedOn "2022-07-24"^^xsd:date ;
    dzdoc:number "16" ;
    dzdoc:position 15 ;
    dzdoc:usesTerm dzterm:algerian_investment_promotion_agency,
        dzterm:investment_bodies,
        dzterm:national_investment_council .

<https://legal.dz/resource/law/2022-07-24/22-18#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#sec_5> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "يعاقب كل من يقوم بسوء نية، بعرقلة الاستثمار بأية وسيلة كانت، وفقا للأحكام المنصوص عليها في التشريع الساري المفعول."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2022-07-24/22-18#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2022-07-24/22-18#art_37_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_37_20220724_OpEnact_4c9541ae95> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:introducedOn "2022-07-24"^^xsd:date ;
    dzdoc:number "المادة 37" ;
    dzdoc:position 36 .

<https://legal.dz/resource/law/2022-07-24/22-18#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#sec_6> ;
    dzdoc:eId "art_39" ;
    dzdoc:fullText "تحول حافظة المشاريع التي كانت تابعة سابقا لاختصاص المجلس الوطني للاستثمار إلى الوكالة ."@ar ;
