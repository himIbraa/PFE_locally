<https://legal.dz/resource/law/2022-07-24/22-18#art_12_condition_0_fdf1e11e> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2022-07-24/22-18#art_12_condition_0_fdf1e11e_ref_2a6559efe308> ;
    dzdoc:references <https://legal.dz/resource/law/2022-07-24/22-18#art_18> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2022-07-24/22-18#art_18> ;
    dznorm:conditionText "ما لم توجد اتفاقيات ثنائية أو متعددة الأطراف صادقت عليها الدولة الجزائرية تتعلق أحكامها بالمصالحة والوساطة والتحكيم، أو إبرام اتفاق بين الوكالة المذكورة في المادة 18 أدناه، التي تتصرف باسم الدولة والمستثمر ، تسمح للأطراف باللجوء إلى التحكيم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_12> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2022-07-24/22-18#art_12_condition_0_fdf1e11e_ref_2a6559efe308> a dzdoc:Reference ;
    rdfs:label "المادة 18"@ar ;
    dzdoc:frbrUri "#art_18"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2022-07-24/22-18#art_18> ;
    dzdoc:sourceEId "art_12" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "ما لم توجد اتفاقيات ثنائية أو متعددة الأطراف صادقت عليها الدولة الجزائرية تتعلق أحكامها بالمصالحة والوساطة والتحكيم، أو إبرام اتفاق بين الوكالة المذكورة في المادة 18 أدناه، التي تتصرف باسم الدولة والمستثمر ، تسمح للأطراف باللجوء إلى التحكيم"@ar ;
    dzdoc:targetEId "art_18" .

<https://legal.dz/resource/law/2022-07-24/22-18#art_12_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_12> ;
    dzdoc:position 0 ;
    dzdoc:text "زيادة على أحكام المادة 11 أعلاه، يخضع كل خلاف ناجم عن تطبيق أحكام هذا القانون بين المستثمر الأجنبي والدولة الجزائرية يتسبب فيه المستثمر أو يكون بسبب إجراء اتخذته الدولة الجزائرية في حقه، للجهات القضائية الجزائرية المختصة، ما لم توجد اتفاقيات ثنائية أو متعددة الأطراف صادقت عليها الدولة الجزائرية تتعلق أحكامها بالمصالحة والوساطة والتحكيم، أو إبرام اتفاق بين الوكالة المذكورة في المادة 18 أدناه، التي تتصرف باسم الدولة والمستثمر ، تسمح للأطراف باللجوء إلى التحكيم."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_13_condition_0_a75e15c2> a dznorm:Condition ;
    dznorm:conditionText "إلا إذا طلب المستثمر ذلك صراحة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_13> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2022-07-24/22-18#art_13_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_13> ;
    dzdoc:position 0 ;
    dzdoc:text "لا تسري الآثار الناجمة عن مراجعة أو إلغاء هذا القانون التي قد تطرأ مستقبلا، على الاستثمار المنجز في إطار هذا القانون، إلا إذا طلب المستثمر ذلك صراحة."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_14_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_14> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن أن تكون السلع والخدمات التي استفادت من المزايا المنصوص عليها في أحكام هذا القانون وكذا تلك الممنوحة في ظل الأحكام السابقة، موضوع تحويل أو تنازل بموجب رخصة تسلمها الوكالة المذكورة في المادة 18 أدناه."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_14_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#art_14> ;
    dzdoc:position 1 ;
    dzdoc:text "تحدد كيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar .

