    dzdoc:position 0 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "إن رئيس الجمهورية،"@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#preamble_segment_1> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2022-07-24/22-18#preamble> ;
    dzdoc:position 1 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبعد رأي مجلس الدولة،"@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#preamble_segment_2> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
