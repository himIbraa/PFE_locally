    dzdoc:sourceEId "art_17" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يكلف المجلس الوطني للاستثمار، المنشأ بموجب أحكام المادة 18 التي بقيت سارية المفعول ضمن الأمر رقم 01-03 المؤرخ في أول جمادى الثانية عام 1422 الموافق 20 غشت سنة 2001 والمتعلق بتطوير الاستثمار، باقتراح استراتيجية الدولة في مجال الاستثمار، والسهر على تناسقها الشامل وتقييم تنفيذها"@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/order/2001-08-20/01-03"^^xsd:anyURI .

<https://legal.dz/resource/law/2022-07-24/22-18#art_18_defocc_aff980e7584c> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 277 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:algerian_investment_promotion_agency ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2022-07-24/22-18#art_18> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2022-07-24/22-18#art_18_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "تدعى الوكالة الوطنية لتطوير الاستثمار المنشأة بموجب المادة 6 التي بقيت سارية المفعول ضمن الأمر رقم 01-03 المؤرخ في أول جمادى الثانية عام 1422 الموافق 20 غشت سنة 2001 والمتعلق بتطوير الاستثمار، من الآن فصاعدا \"الوكالة الجزائرية لترقية الاستثمار\"، وتدعى في صلب هذا النص \"الوكالة\"."@ar .

<https://legal.dz/resource/law/2022-07-24/22-18#art_18_para_0> a dzdoc:Paragraph ;
