<https://legal.dz/resource/law/2022-07-24/22-18#version_art_38> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحتفظ المستثمر بالحقوق والمزايا المكتسبة بطريقة قانونية بموجب التشريعات السابقة لهذا القانون دون الإخلال بأحكام المادة 32 الفقرة (3) أعلاه، تبقى الاستثمارات المستفيدة من المزايا المنصوص عليها في القوانين المتعلقة بتطوير وترقية الاستثمار السابقة لهذا القانون، وكذا مجموع النصوص اللاحقة به، خاضعة للقوانين التي تم التسجيل أو التصريح في ظلها، إلى غاية انقضاء مدة المزايا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_38_20220724_OpEnact_fd8bc19685> ;
    dzdoc:replacementText "يحتفظ المستثمر بالحقوق والمزايا المكتسبة بطريقة قانونية بموجب التشريعات السابقة لهذا القانون دون الإخلال بأحكام المادة 32 الفقرة (3) أعلاه، تبقى الاستثمارات المستفيدة من المزايا المنصوص عليها في القوانين المتعلقة بتطوير وترقية الاستثمار السابقة لهذا القانون، وكذا مجموع النصوص اللاحقة به، خاضعة للقوانين التي تم التسجيل أو التصريح في ظلها، إلى غاية انقضاء مدة المزايا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
