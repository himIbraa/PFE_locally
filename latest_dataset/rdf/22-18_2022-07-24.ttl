<https://legal.dz/resource/law/2022-07-24/22-18#version_art_23> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنشأ \" منصة رقمية للمستثمر \" يسند تسييرها إلى الوكالة ، تسمح بتوفير كل المعلومات اللازمة، لا سيما منها فرص الاستثمار في الجزائر، والعرض العقاري والتحفيزات والمزايا المرتبطة بالاستثمار وكذا الإجراءات ذات الصلة. وتسمح هذه المنصة الرقمية المتصلة بينيا بالأنظمة المعلوماتية للهيئات والإدارات المكلفة بالعملية الاستثمارية، بإزالة الطابع المادي عن جميع الإجراءات والقيام بواسطة الإنترنت بجميع الإجراءات المتصلة بالاستثمار. وتشكل المنصة الرقمية أيضا أداة توجيه ومرافقة للاستثمارات ومتابعتها انطلاقا من تسجيل"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_23_20220724_OpEnact_fb3f82b55b> ;
    dzdoc:replacementText "تنشأ \" منصة رقمية للمستثمر \" يسند تسييرها إلى الوكالة ، تسمح بتوفير كل المعلومات اللازمة، لا سيما منها فرص الاستثمار في الجزائر، والعرض العقاري والتحفيزات والمزايا المرتبطة بالاستثمار وكذا الإجراءات ذات الصلة. وتسمح هذه المنصة الرقمية المتصلة بينيا بالأنظمة المعلوماتية للهيئات والإدارات المكلفة بالعملية الاستثمارية، بإزالة الطابع المادي عن جميع الإجراءات والقيام بواسطة الإنترنت بجميع الإجراءات المتصلة بالاستثمار. وتشكل المنصة الرقمية أيضا أداة توجيه ومرافقة للاستثمارات ومتابعتها انطلاقا من تسجيلها وأثناء فترة استغلالها. تحدد كيفيات تسيير هذه المنصة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2022-07-24/22-18#art_23> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2022-07-24/22-18#art_23> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2022-07-24"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2022-07-24/22-18#version_art_24> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن تستفيد الاستثمارات، بمفهوم المادة 4 من هذا القانون بناء على طلب من المستثمر ، من أحد الأنظمة التحفيزية المذكورة أدناه: النظام التحفيزي للقطاعات ذات الأولوية ، ويدعى في صلب النص \"نظام القطاعات\"، النظام التحفيزي للمناطق التي توليها الدولة أهمية خاصة ، ويدعى في صلب النص \"نظام المناطق\"، النظام التحفيزي للاستثمارات ذات الطابع المهيكل ويدعى في صلب النص نظام\" الاستثمارات المهيكلة\"."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_24_20220724_OpEnact_6fe8c689fc> ;
    dzdoc:replacementText "يمكن أن تستفيد الاستثمارات، بمفهوم المادة 4 من هذا القانون بناء على طلب من المستثمر ، من أحد الأنظمة التحفيزية المذكورة أدناه: النظام التحفيزي للقطاعات ذات الأولوية ، ويدعى في صلب النص \"نظام القطاعات\"، النظام التحفيزي للمناطق التي توليها الدولة أهمية خاصة ، ويدعى في صلب النص \"نظام المناطق\"، النظام التحفيزي للاستثمارات ذات الطابع المهيكل ويدعى في صلب النص نظام\" الاستثمارات المهيكلة\"."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2022-07-24/22-18#art_24> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2022-07-24/22-18> ;
