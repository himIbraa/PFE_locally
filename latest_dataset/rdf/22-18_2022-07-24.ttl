<https://legal.dz/resource/law/2022-07-24/22-18#version_art_4> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2022-07-24/22-18> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تخضع لأحكام هذا القانون، الاستثمارات المنجزة من خلال : اقتناء الأصول المادية أو غير المادية التي تندرج مباشرة ضمن نشاطات إنتاج السلع والخدمات في إطار إنشاء أنشطة جديدة وتوسيع قدرات الإنتاج و/أو إعادة تأهيل أدوات الإنتاج، المساهمة في رأسمال مؤسسة في شكل حصص نقدية أو عينية، نقل أنشطة من الخارج."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2022-07-24/22-18#version_art_4_20220724_OpEnact_83937a6e4f> ;
    dzdoc:replacementText "تخضع لأحكام هذا القانون، الاستثمارات المنجزة من خلال : اقتناء الأصول المادية أو غير المادية التي تندرج مباشرة ضمن نشاطات إنتاج السلع والخدمات في إطار إنشاء أنشطة جديدة وتوسيع قدرات الإنتاج و/أو إعادة تأهيل أدوات الإنتاج، المساهمة في رأسمال مؤسسة في شكل حصص نقدية أو عينية، نقل أنشطة من الخارج."@ar ;
    dzdoc:resolutionStatus "resolved" ;
