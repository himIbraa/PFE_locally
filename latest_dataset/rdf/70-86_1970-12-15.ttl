<https://legal.dz/resource/order/1970-12-15/70-86#art_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#sec_1> ;
    dzdoc:eId "art_2" ;
    dzdoc:fullText "تطبق النصوص المتعلقة بمنح الجنسية الجزائرية كجنسية أصلية على الأشخاص المولودين قبل تاريخ إجراء العمل بهذه الأحكام. غير أن تطبيق هذه النصوص لا يمس بصحة العقود المبرمة من قبل المعنيين بالأمر استنادا على القوانين السابقة ولا بصحة الحقوق المكتسبة من طرف الغير استناد على هذه القوانين نفسها. يسري على شروط اكتساب أو فقدان الجنسية الجزائرية القانون المعمول به في تاريخ حدوث الوقائع أو العقود الناجم عنها الاكتساب أو هذا الفقدان."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1970-12-15/70-86#version_art_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1970-12-15/70-86#art_2_para_0>,
        <https://legal.dz/resource/order/1970-12-15/70-86#art_2_para_1>,
        <https://legal.dz/resource/order/1970-12-15/70-86#art_2_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_2_19701215_OpEnact_07ccc372f4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:introducedOn "1970-12-15"^^xsd:date ;
    dzdoc:number "2" ;
    dzdoc:position 1 ;
    dzdoc:usesTerm dzterm:nationality .

<https://legal.dz/resource/order/1970-12-15/70-86#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#sec_4> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "لا يمتد التجريد من الجنسية إلى زوج المعني وأولاده القصر. غير أنه، يجوز تمديد التجريد من الجنسية إلى الأولاد إذا كان شاملا لأبويهم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1970-12-15/70-86#art_24_permission_0_bf0fc72b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1970-12-15/70-86#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1970-12-15/70-86#art_24_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_24_19701215_OpEnact_b665a9593d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:introducedOn "1970-12-15"^^xsd:date ;
    dzdoc:number "المادة 24" ;
    dzdoc:position 24 .

<https://legal.dz/resource/order/1970-12-15/70-86#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#sec_2> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "إن الولد المكتسب الجنسية الجزائرية بموجب المادة 7 أعلاه يعتبر جزائريا منذ ولادته ولو كان توفر الشروط المطلوبة قانونا لم يثبت إلا بعد ولادته . إن إعطاء صفة جزائري الجنسية منذ الولادة وكذا سحب هذه الصفة أو التخلي عنها بموجب أحكام المادة 7 أعلاه، لا يمس بصحة العقود المبرمة من قبل المعني بالأمر ولا بصحة الحقوق المكتسبة من قبل الغير استنادا إلى الجنسية المكتسبة سابقا من قبل الولد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1970-12-15/70-86#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1970-12-15/70-86#art_8_para_0>,
        <https://legal.dz/resource/order/1970-12-15/70-86#art_8_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_8_19701215_OpEnact_d972ca2fa6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:introducedOn "1970-12-15"^^xsd:date ;
    dzdoc:number "8" ;
    dzdoc:position 7 ;
    dzdoc:references <https://legal.dz/resource/order/1970-12-15/70-86#art_7> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1970-12-15/70-86#art_7> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1970-12-15/70-86#art_8_condition_0_9298ee38> ;
    dzdoc:usesTerm dzterm:nationality .

