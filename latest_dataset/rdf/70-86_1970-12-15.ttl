<https://legal.dz/resource/order/1970-12-15/70-86#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#sec_3> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "يمنح التجنس بموجب مرسوم رئاسي. يمكن أن يغير لقب المعني واسمه، بطلب منه، في مرسوم التجنس. يتولى ضابط الحالة المدنية التأشير في سجلات الحالة المدنية بالبيانات المتعلقة بالتجنس ، وعند الاقتضاء، تغيير والألقاب بناء على أمر من النيابة العامة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1970-12-15/70-86#art_12_permission_0_4a8e137b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1970-12-15/70-86#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1970-12-15/70-86#art_12_para_0>,
        <https://legal.dz/resource/order/1970-12-15/70-86#art_12_para_1>,
        <https://legal.dz/resource/order/1970-12-15/70-86#art_12_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_12_19701215_OpEnact_9442a19a92> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1970-12-15/70-86#art_12_obligation_0_88f32ed1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:introducedOn "1970-12-15"^^xsd:date ;
    dzdoc:number "المادة 12" ;
    dzdoc:position 12 .

<https://legal.dz/resource/order/1970-12-15/70-86#art_26> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#sec_5> ;
    dzdoc:eId "art_26" ;
    dzdoc:fullText "إذا لم تتوفر الشروط القانونية ، يعلن وزير العدل ، عدم قابلية الطلب بموجب مقرر معلل يبلغ إلى المعني. ويمكن وزير العدل ، رغم توفر الشروط القانونية أن يرفض الطلب بموجب قرار يبلغ إلى المعني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1970-12-15/70-86#version_art_26> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1970-12-15/70-86#art_26_para_0>,
        <https://legal.dz/resource/order/1970-12-15/70-86#art_26_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_26_19701215_OpEnact_93e68d1ef7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:introducedOn "1970-12-15"^^xsd:date ;
    dzdoc:number "26" ;
    dzdoc:position 26 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1970-12-15/70-86#art_26_condition_0_aca93ee1>,
        <https://legal.dz/resource/order/1970-12-15/70-86#art_26_condition_1_bcc3a6ce> ;
    dzdoc:usesTerm dzterm:minister_of_justice .

