    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#art_13> ;
    dzdoc:position 1 ;
    dzdoc:text "يتم سحب الجنسية بنفس الأشكال التي تم بها منح التجنس بعد إعلام المعني بذلك قانونا ومنحه مهلة شهرين(2) لتقديم دفوعه."@ar .

<https://legal.dz/resource/order/1970-12-15/70-86#art_13_para_2> a dzdoc:Paragraph ;
