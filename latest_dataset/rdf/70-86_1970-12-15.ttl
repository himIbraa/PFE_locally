<https://legal.dz/resource/order/1970-12-15/70-86#version_art_27> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن بناء على طلب المعني الصريح، أن يتضمن مرسوم اكتساب الجنسية الجزائرية المذكور في المادة 9 مكرر من هذا القانون تغيير اسمه ولقبه. يتولى ضابط الحالة المدنية التأشير في سجلات الحالة المدنية بالبيانات المتعلقة باكتساب الجنسية وعند الاقتضاء، تغيير الاسم واللقب، بناء على أمر من النيابة العامة."@ar ;
