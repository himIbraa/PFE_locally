<https://legal.dz/resource/order/1970-12-15/70-86#art_23_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#art_23> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم التجريد من الجنسية بمرسوم بعد تمكين المعني بالأمر من تقديم ملاحظاته، وله أجل شهرين للقيام بذلك."@ar .

<https://legal.dz/resource/order/1970-12-15/70-86#art_23_right_0_5bc17ccf> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1970-12-15/70-86#art_23> ;
    dznorm:position 0 ;
    dznorm:provisionText "تقديم ملاحظاته"@ar ;
    dznorm:sourceArticle "art_23" .

<https://legal.dz/resource/order/1970-12-15/70-86#art_24_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#art_24> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يمتد التجريد من الجنسية إلى زوج المعني وأولاده القصر. غير أنه، يجوز تمديد التجريد من الجنسية إلى الأولاد إذا كان شاملا لأبويهم."@ar .

