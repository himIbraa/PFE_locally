<https://legal.dz/resource/order/1970-12-15/70-86#version_art_18> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يفقد الجنسية الجزائرية : 1 - الجزائري الذي اكتسب عن طواعية في الخارج جنسية أجنبية وأذن له بموجب مر التخلي عن الجنسية الجزائرية ، 2 - الجزائري، ولو كان قاصر ، الذي له جنسية أجنبية أصلية وأذن له بموجب مرسوم في التخلي عن الجنسية الجزائرية ، 3 - المرأة الجزائرية المتزوجة بأجنبي وتكتسب جراء زواجها جنسية زوجها وأذن لها بموجب مرسوم في التخلي عن الجنسية الجزائرية ، 4 - الجزائري الذي يعلن تخليه عن الجنسية الجزائرية في الحالة المنصوص عليها في الفقرة 2 من المادة 17 أعلاه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_18_19701215_OpEnact_6dee4a2c87> ;
    dzdoc:replacementText "يفقد الجنسية الجزائرية : 1 - الجزائري الذي اكتسب عن طواعية في الخارج جنسية أجنبية وأذن له بموجب مر التخلي عن الجنسية الجزائرية ، 2 - الجزائري، ولو كان قاصر ، الذي له جنسية أجنبية أصلية وأذن له بموجب مرسوم في التخلي عن الجنسية الجزائرية ، 3 - المرأة الجزائرية المتزوجة بأجنبي وتكتسب جراء زواجها جنسية زوجها وأذن لها بموجب مرسوم في التخلي عن الجنسية الجزائرية ، 4 - الجزائري الذي يعلن تخليه عن الجنسية الجزائرية في الحالة المنصوص عليها في الفقرة 2 من المادة 17 أعلاه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1970-12-15/70-86#art_18> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1970-12-15/70-86#art_18> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1970-12-15"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

