<https://legal.dz/resource/order/1970-12-15/70-86#version_art_39> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجري التحقيق والحكم في النزاعات حول الجنسية الجزائرية وفقا لقواعد الإجراءات العادية. عندما تقدم العريضة من قبل أحد الأشخاص يتعين على النيابة العامة أن تبلغ نسخة منها إلى وزير العدل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
