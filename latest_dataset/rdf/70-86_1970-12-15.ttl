<https://legal.dz/resource/order/1970-12-15/70-86#version_art_29_19701215_OpEnact_007003cccb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1970-12-15"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1970-12-15/70-86#version_art_29> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1970-12-15/70-86#art_29> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1970-12-15/70-86#art_29> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:versionText "تنشر المراسيم المتعلقة باكتساب الجنسية في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية وتحدث أثرها تجاه الغير ابتداء من تاريخ هذا النشر."@ar .

<https://legal.dz/resource/order/1970-12-15/70-86#version_art_2_19701215_OpEnact_07ccc372f4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1970-12-15"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1970-12-15/70-86#version_art_2> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1970-12-15/70-86#art_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1970-12-15/70-86#art_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:versionText "تطبق النصوص المتعلقة بمنح الجنسية الجزائرية كجنسية أصلية على الأشخاص المولودين قبل تاريخ إجراء العمل بهذه الأحكام. غير أن تطبيق هذه النصوص لا يمس بصحة العقود المبرمة من قبل المعنيين بالأمر استنادا على القوانين السابقة ولا بصحة الحقوق المكتسبة من طرف الغير استناد على هذه القوانين نفسها. يسري على شروط اكتساب أو فقدان الجنسية الجزائرية القانون المعمول به في تاريخ حدوث الوقائع أو العقود الناجم عنها الاكتساب أو هذا الفقدان."@ar .

<https://legal.dz/resource/order/1970-12-15/70-86#version_art_30_19701215_OpEnact_bd738dfe5d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
