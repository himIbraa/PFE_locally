    dznorm:conditionText "وعندما ينتج الفقدان عن التصريح بالتخلي عن الجنسية المنصوص عليه في المادة 17 أعلاه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1970-12-15/70-86#art_35> ;
