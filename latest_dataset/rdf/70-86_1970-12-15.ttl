    dznorm:expressedIn <https://legal.dz/resource/order/1970-12-15/70-86#art_10> ;
    dznorm:position 6 .

<https://legal.dz/resource/order/1970-12-15/70-86#art_10_condition_7_9dbda6f7> a dznorm:Condition ;
    dznorm:conditionText "أن يثبت اندماجه في المجتمع الجزائري"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1970-12-15/70-86#art_10> ;
    dznorm:position 7 .

<https://legal.dz/resource/order/1970-12-15/70-86#art_10_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#art_10> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن للأجنبي الذي يقدم طلبا لاكتساب الجنسية الجزائرية أن يحصل عليها بشرط : أن يكون مقيما في الجزائر منذ 7 سنوات على الأقل بتاريخ تقديم الطلب، أن يكون مقيما في الجزائر وقت التوقيع على المرسوم الذي يمنح التجنس، أن يكون بالغا سن الرشد، أن تكون سيرته حسنة ولم يسبق الحكم عليه بعقوبة تخل بالشرف، أن يثبت الوسائل الكافية لمعيشته، أن يكون سليم الجسد والعقل، أن يثبت اندماجه في المجتمع الجزائري."@ar .

<https://legal.dz/resource/order/1970-12-15/70-86#art_10_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#art_10> ;
    dzdoc:position 1 ;
    dzdoc:text "ويقدم الطلب إلى وزير العدل الذي يستطيع دائما رفضه ضمن شروط المادة 26 بعده."@ar .

