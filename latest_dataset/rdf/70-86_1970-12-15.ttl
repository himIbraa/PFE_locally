dzterm:algerian_nationality a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الجنسية الجزائرية"@ar .

<https://legal.dz/resource/order/1970-12-15/70-86#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#sec_1> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "تحدد الشروط الضرورية للتمتع بالجنسية الجزائرية بموجب القانون، وعند الاقتضاء بواسطة المعاهدات والاتفاقات الدولية التي يصادق عليها ويتم نشرها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1970-12-15/70-86#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1970-12-15/70-86#art_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_1_19701215_OpEnact_78410ef208> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:introducedOn "1970-12-15"^^xsd:date ;
    dzdoc:number "الأولى" ;
    dzdoc:position 0 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1970-12-15/70-86#art_1_condition_0_27b2c5f4> .

<https://legal.dz/resource/order/1970-12-15/70-86#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#sec_3> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "الآثار الفردية : يتمتع الشخص الذي يكتسب الجنسية الجزائرية بجميع الحقوق المتعلقة بالصفة الجزائرية ابتداء من تاريخ اكتسابها."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1970-12-15/70-86#art_15_right_0_af72a8b9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1970-12-15/70-86#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1970-12-15/70-86#art_15_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_15_19701215_OpEnact_e1fe3efa05> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:introducedOn "1970-12-15"^^xsd:date ;
    dzdoc:number "المادة 15" ;
    dzdoc:position 15 ;
    dzdoc:usesTerm dzterm:nationality .

<https://legal.dz/resource/order/1970-12-15/70-86#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#sec_4> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "يتم التجريد من الجنسية بمرسوم بعد تمكين المعني بالأمر من تقديم ملاحظاته ، وله أجل شهرين للقيام بذلك."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1970-12-15/70-86#art_23_right_0_5bc17ccf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1970-12-15/70-86#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1970-12-15/70-86#art_23_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_23_19701215_OpEnact_33a657565a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:introducedOn "1970-12-15"^^xsd:date ;
    dzdoc:number "المادة 23" ;
    dzdoc:position 23 .

<https://legal.dz/resource/order/1970-12-15/70-86#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#sec_5> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "ترفع طلبات اكتساب الجنسية الجزائرية أو التخلي عنها أو استردادها إلى وزير العدل ، مصحوبة بالعقود والوثائق والمستندات التي تثبت استيفاء الشروط القانونية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1970-12-15/70-86#version_art_25> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1970-12-15/70-86#art_25_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_25_19701215_OpEnact_b3d0af61a2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1970-12-15/70-86#art_25_obligation_0_66f47cb5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:introducedOn "1970-12-15"^^xsd:date ;
    dzdoc:number "25" ;
    dzdoc:position 25 ;
    dzdoc:usesTerm dzterm:minister_of_justice .

<https://legal.dz/resource/order/1970-12-15/70-86#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#sec_5> ;
    dzdoc:eId "art_29" ;
    dzdoc:fullText "تنشر المراسيم المتعلقة باكتساب الجنسية في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية وتحدث أثرها تجاه الغير ابتداء من تاريخ هذا النشر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1970-12-15/70-86#version_art_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1970-12-15/70-86#art_29_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_29_19701215_OpEnact_007003cccb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1970-12-15/70-86#art_29_obligation_0_0267caf9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:introducedOn "1970-12-15"^^xsd:date ;
    dzdoc:number "29" ;
    dzdoc:position 29 .

<https://legal.dz/resource/order/1970-12-15/70-86#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#sec_6> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "يتحمل الإثبات في قضايا الجنسية كل شخص سواء كان بواسطة الدعوى أو عن طريق الدفع يدعي هو نفسه أو شخص آخر بأنه يحمل أو لا يحمل الجنسية الجزائرية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1970-12-15/70-86#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1970-12-15/70-86#art_31_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_31_19701215_OpEnact_994b572168> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1970-12-15/70-86#art_31_obligation_0_1de0257b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:introducedOn "1970-12-15"^^xsd:date ;
    dzdoc:number "المادة 31" ;
    dzdoc:position 31 ;
    dzdoc:usesTerm dzterm:algerian_nationality,
        dzterm:nationality .

<https://legal.dz/resource/order/1970-12-15/70-86#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:definesTerm dzterm:majority_age ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#sec_1> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "يقصد بسن الرشد في مفهوم هذا القانون، سن الرشد المدني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1970-12-15/70-86#version_art_4> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1970-12-15/70-86#art_4_defocc_2c13b488b21f> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1970-12-15/70-86#art_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_4_19701215_OpEnact_0e90a607b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:introducedOn "1970-12-15"^^xsd:date ;
    dzdoc:number "4" ;
