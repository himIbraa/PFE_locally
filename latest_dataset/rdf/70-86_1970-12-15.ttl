<https://legal.dz/resource/order/1970-12-15/70-86#art_12_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#art_12> ;
    dzdoc:position 0 ;
    dzdoc:text "يمنح التجنس بموجب مرسوم رئاسي."@ar .

<https://legal.dz/resource/order/1970-12-15/70-86#art_12_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1970-12-15/70-86#art_12> ;
    dzdoc:position 1 ;
    dzdoc:text "يمكن أن يغير لقب المعني واسمه، بطلب منه، في مرسوم التجنس."@ar .

