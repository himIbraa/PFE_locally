<https://legal.dz/resource/order/1970-12-15/70-86#version_art_35> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يثبت فقدان الجنسية الجزائرية في الحالات المنصوص عليها في الفقرات 1 و 2 و 3 من المادة 18 أعلاه بنظير المرسوم. وعندما ينتج الفقدان عن التصريح بالتخلي عن الجنسية المنصوص عليه في المادة 17 أعلاه ، فإن إثبات الفقدان يتم بالإدلاء بشهادة من وزير العدل تثبت أن التصريح بالتخلي قد وقع عليه بصورة قانونية. ويثبت التجريد من الجنسية الجزائرية بنظير المرسوم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_35_19701215_OpEnact_4f332dd84b> ;
    dzdoc:replacementText "يثبت فقدان الجنسية الجزائرية في الحالات المنصوص عليها في الفقرات 1 و 2 و 3 من المادة 18 أعلاه بنظير المرسوم. وعندما ينتج الفقدان عن التصريح بالتخلي عن الجنسية المنصوص عليه في المادة 17 أعلاه ، فإن إثبات الفقدان يتم بالإدلاء بشهادة من وزير العدل تثبت أن التصريح بالتخلي قد وقع عليه بصورة قانونية. ويثبت التجريد من الجنسية الجزائرية بنظير المرسوم."@ar ;
