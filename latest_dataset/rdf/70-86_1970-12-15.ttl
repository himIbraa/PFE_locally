dzterm:algeria_territory a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يقصد بعبارة \" بالجزائر\" مجموع التراب الجزائري والمياه الإقليمية الجزائرية والسفن والطائرات الجزائرية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1970-12-15/70-86#art_5_defocc_90ec3f8975aa> .

dzterm:majority_age a skos:Concept,
