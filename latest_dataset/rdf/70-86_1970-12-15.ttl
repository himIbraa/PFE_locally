<https://legal.dz/resource/order/1970-12-15/70-86#version_art_7> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتبر من الجنسية الجزائرية بالولادة في الجزائر : 1 - الولد المولود في الجزائر من أبوين مجهولين. غير أن الولد المولود في الجزائر من أبوين مجهولين يعد كأنه لم يكن جزائريا قط إذا ثبت خلال قصوره، انتسابه إلى أجنبي أو أجنبية وكان ينتمي إلى جنسية هذا الأجنبي أو هذه الأجنبية وفقا لقانون جنسية أحدهما . إن الولد الحديث الولادة الذي عثر عليه في الجزائر يعد مولودا فيها ما لم يثبت خلاف ذلك . 2 – الولد المولود في الجزائر من أب مجهول وأم مسماة في شهادة ميلاده دون بيانات أخرى تمكن من إثبات جنسيتها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_7_19701215_OpEnact_bd8965e7b5> ;
    dzdoc:replacementText "يعتبر من الجنسية الجزائرية بالولادة في الجزائر : 1 - الولد المولود في الجزائر من أبوين مجهولين. غير أن الولد المولود في الجزائر من أبوين مجهولين يعد كأنه لم يكن جزائريا قط إذا ثبت خلال قصوره، انتسابه إلى أجنبي أو أجنبية وكان ينتمي إلى جنسية هذا الأجنبي أو هذه الأجنبية وفقا لقانون جنسية أحدهما . إن الولد الحديث الولادة الذي عثر عليه في الجزائر يعد مولودا فيها ما لم يثبت خلاف ذلك . 2 – الولد المولود في الجزائر من أب مجهول وأم مسماة في شهادة ميلاده دون بيانات أخرى تمكن من إثبات جنسيتها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1970-12-15/70-86#art_7> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1970-12-15/70-86#art_7> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1970-12-15"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1970-12-15/70-86#version_art_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن الولد المكتسب الجنسية الجزائرية بموجب المادة 7 أعلاه يعتبر جزائريا منذ ولادته ولو كان توفر الشروط المطلوبة قانونا لم يثبت إلا بعد ولادته . إن إعطاء صفة جزائري الجنسية منذ الولادة وكذا سحب هذه الصفة أو التخلي عنها بموجب أحكام المادة 7 أعلاه، لا يمس بصحة العقود المبرمة من قبل المعني بالأمر ولا بصحة الحقوق المكتسبة من قبل الغير استنادا إلى الجنسية المكتسبة سابقا من قبل الولد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1970-12-15/70-86#version_art_8_19701215_OpEnact_d972ca2fa6> ;
    dzdoc:replacementText "إن الولد المكتسب الجنسية الجزائرية بموجب المادة 7 أعلاه يعتبر جزائريا منذ ولادته ولو كان توفر الشروط المطلوبة قانونا لم يثبت إلا بعد ولادته . إن إعطاء صفة جزائري الجنسية منذ الولادة وكذا سحب هذه الصفة أو التخلي عنها بموجب أحكام المادة 7 أعلاه، لا يمس بصحة العقود المبرمة من قبل المعني بالأمر ولا بصحة الحقوق المكتسبة من قبل الغير استنادا إلى الجنسية المكتسبة سابقا من قبل الولد."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1970-12-15/70-86#art_8> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1970-12-15/70-86> ;
