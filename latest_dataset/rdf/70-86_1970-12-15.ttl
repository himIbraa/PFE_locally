    dzdoc:assertsTarget <https://legal.dz/resource/order/1970-12-15/70-86> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتحمل الإثبات في قضايا الجنسية كل شخص سواء كان بواسطة الدعوى أو عن طريق الدفع يدعي هو نفسه أو شخص آخر بأنه يحمل أو لا يحمل الجنسية الجزائرية ."@ar ;
    dzdoc:isAuthoritative true ;
