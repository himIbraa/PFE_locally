<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_61_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_61> ;
    dzdoc:position 2 ;
    dzdoc:text "يحدد تنظيم وس هذا المركز عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_62_para_0> a dzdoc:Paragraph ;
