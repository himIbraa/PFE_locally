    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_89_obligation_0_1167b2e0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_89_obligation_1_d6f23a21> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
