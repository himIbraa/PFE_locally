<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_3> ;
    dzdoc:eId "art_87" ;
    dzdoc:fullText "يعاقب بغرامة من 800 إلى 1.500 دج ، كل سائق يخالف الأحكام التنظيمية المتعلقة بتركيب جهاز المراقبة الذي يسمح بتسجيل السرعة ومواصفاته وصيانته. في حالة العود ، تضاعف العقوبة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_87_permission_0_8fb34b39> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_87> ;
