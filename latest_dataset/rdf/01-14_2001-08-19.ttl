    dznorm:sourceArticle "art_12" .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_12_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_12> ;
