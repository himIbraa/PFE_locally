<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_139> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_8> ;
    dzdoc:eId "art_139" ;
    dzdoc:fullText "تلغى أحكام القانون رقم 87 - 09 المؤرخ في 11 جمادى الثانية عام 1407 الموافق 10 فبراير سنة 1987 والمتعلق بتنظيم حركة المرور عبر الطرق وسلامتها وأمنها . تبقى النصوص التنظيمية المتخذة لتطبيق القانون المذكور أعلاه ، سارية المفعول مالم تكن مخالفة لهذا القانون إلى غاية نشر النصوص التنظيمية المنصوص عليها في هذا القانون خلال أجل لا يتجاوز أربعة وعشرين (24) شهرا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_139> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_139_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_139_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_139_20010819_OpEnact_fbe8d6de3d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 139" ;
    dzdoc:position 127 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_139_extref_335823a6> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_139_condition_0_b6af8c5e>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_139_condition_1_79fd2dca> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
