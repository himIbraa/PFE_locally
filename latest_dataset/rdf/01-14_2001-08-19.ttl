    dzdoc:eId "art_17" ;
    dzdoc:fullText "يجب على كل سائق أن يكون باستمرار في حالة ووضعية تمكنه من القيام بكل عمليات قيادة السيارة بسهولة ودون تأخير."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_17> ;
