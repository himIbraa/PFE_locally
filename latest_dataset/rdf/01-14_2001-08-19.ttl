<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_116> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "خلافا لأحكام قانون العقوبات ، يعتبر العود في ارتكاب المخالفات الخاصة بسلامة المرور في الطرق مستقلا عن المكان الذي وقعت فيه المخالفة الأولى. تحدد كيفية إثبات العود في ارتكاب هذه المخالفات وفقا لأحكام المواد من 655 إلى 665 من قانون الإجراءات الجزائية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_116_20010819_OpEnact_b8313e38d4> ;
    dzdoc:replacementText "خلافا لأحكام قانون العقوبات ، يعتبر العود في ارتكاب المخالفات الخاصة بسلامة المرور في الطرق مستقلا عن المكان الذي وقعت فيه المخالفة الأولى. تحدد كيفية إثبات العود في ارتكاب هذه المخالفات وفقا لأحكام المواد من 655 إلى 665 من قانون الإجراءات الجزائية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_116> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
