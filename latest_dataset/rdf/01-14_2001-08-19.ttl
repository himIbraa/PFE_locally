    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بغرامة من 50.000 إلى 150.000 دج وبالحبس من شهرين (2) إلى ثمانية عشر (18) شهرا أو بإحدى هاتين العقوبتين فقط، كل شخص يعرض للبيع أو يبيع آلة أو تجهيز مركبة غير معتمد، وذلك عندما يكون الاعتماد قد فرضه التشريع والتنظيم المعمول بهما. في حالة العود، تضاعف العقوبة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_97_20010819_OpEnact_c51668ef83> ;
    dzdoc:replacementText "يعاقب بغرامة من 50.000 إلى 150.000 دج وبالحبس من شهرين (2) إلى ثمانية عشر (18) شهرا أو بإحدى هاتين العقوبتين فقط، كل شخص يعرض للبيع أو يبيع آلة أو تجهيز مركبة غير معتمد، وذلك عندما يكون الاعتماد قد فرضه التشريع والتنظيم المعمول بهما. في حالة العود، تضاعف العقوبة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
