<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_127> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_7> ;
    dzdoc:eId "art_127" ;
    dzdoc:fullText "يتحمل مالك المركبة المهجورة مصاريف رفعها ووضعها في المحشر وإجراء الخبرة وبيعها أو تدميرها. يوضع حاصل البيع بعد أن تخصم منه المصاريف المذكورة في الفقرة أعلاه، تحت تصرف المالك أو ذوي حقوقه، أو عند الاقتضاء، الدائن الضامن الذي يتمكن من إثبات حقوقه خلال أجل مدته سنتان (2). عند انقضاء هذا الأجل، يعود هذا الحاصل إلى الدولة. عندما يقل حاصل البيع عن مبلغ المصاريف المذكورة أعلاه ، يبقى المالك مدينا بالفارق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_127> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_127_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_127_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_127_para_2>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_127_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_127_20010819_OpEnact_5b223095f0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_127_obligation_0_0b5ae7f6>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_127_obligation_1_8d6440ec> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "127" ;
    dzdoc:position 115 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_127_condition_0_d04931e3> ;
    dzdoc:usesTerm dzterm:impound .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_2_subsec_1> ;
    dzdoc:eId "art_30" ;
    dzdoc:fullText "يمنع على السائق الاستعمال اليدوي للهاتف المحمول أو خوذة التصنت الإذاعي والسمعي عندما تكون المركبة في حالة السير ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_30> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_30_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_30_20010819_OpEnact_e380204523> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_30_obligation_0_aef79840> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_30_prohibition_0_7184e252> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "30" ;
    dzdoc:position 23 ;
    dzdoc:usesTerm dzterm:driver .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_2_subsec_1> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "يقتصر استعمال المنبهات الصوتية في حالات الضرورة لوجود خطر فوري . غير أنه يمكن منع استعمالها بواسطة وضع إشارة ملائمة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_31_permission_0_d2fef837> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_31_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_31_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_31_20010819_OpEnact_095a59ff64> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_31_obligation_0_6075ceb1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 31" ;
    dzdoc:position 24 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_31_condition_0_74f220a2> ;
    dzdoc:usesTerm dzterm:acoustic_signals .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_2_subsec_2> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "يجب على الراجلين السير على الأرصفة أو حواف الطرقات المهيأة خصيصا لاستعمالها لهذا الغرض . يمنع كل استعمال آخر للأرصفة يعيق حركة المارة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_34_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_34_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_34_20010819_OpEnact_b8e2e134e3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_34_obligation_0_903c04c3> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_34_prohibition_0_aad4c36b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "34" ;
    dzdoc:position 26 ;
    dzdoc:usesTerm dzterm:pedestrians .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_2_subsec_2> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "في حالة انعدام الإشارات الضوئية يلزم السائقون بالسماح بمرور الراجلين الموجودين في الممرات . عند الاقتراب من الممرات المخصصة للراجلين يجب على السائقين الامتناع عن تجاوز السيارات، دون التأكد من عدم وجود أحد الراجلين في هذا الممر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_38_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_38_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_38_20010819_OpEnact_d7227f1fdf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_38_obligation_0_81214aeb>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_38_obligation_1_02c98d7e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "38" ;
    dzdoc:position 30 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_38_condition_0_aa2b8339> ;
    dzdoc:usesTerm dzterm:drivers,
        dzterm:pedestrians .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_3> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "يمنع إلصاق شريط بلاستيكي أو استعمال أي طريقة أخرى تعتم زجاج المركبة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_48_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_48_20010819_OpEnact_c87203214d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_48_obligation_0_f26ad1a3> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_48_prohibition_0_7cc63554> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 48" ;
    dzdoc:position 39 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_65> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6> ;
    dzdoc:eId "art_65" ;
    dzdoc:fullText "يعاقب طبقا لأحكام المادتين 288 و 289 من قانون العقوبات ، كل سائق ارتكب جريمة الجرح أو القتل الخطأ نتيجة خطأ منه أو تهاونه أو وعدم امتثاله لقواعد حركة المرور في الطريق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_65> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_65_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_65_20010819_OpEnact_b519f7db76> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_65_obligation_0_c4c746a6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 65" ;
    dzdoc:position 56 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_65_extref_3f6efa41>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_65_extref_d0481538> ;
    dzdoc:usesTerm dzterm:driver .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6> ;
    dzdoc:eId "art_70" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين (2) إلى ستة (6) أشهر وبغرامة من 1.500 إلى 5.000 دج أو بإحدى هاتين العقوبتين فقط ، كل سائق لا يمتثل عمدا لإنذار التوقف الصادر عن الأعوان المشار إليهم في المادة 130 من هذا القانون المكلفين بمعاينة المخالفات والحاملين للشارات الخارجية الظاهرة والدالة على صفتهم، أو يرفض الخضوع لكل التحقيقات المفروضة والمتعلقة بالمركبة أو الشخص، والمنصوص عليها في هذا القانون . في حالة العود ، تضاعف العقوبة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_70_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_70_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_70_20010819_OpEnact_c56c2ba836> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_70_obligation_0_342b2049>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_70_obligation_1_d6f23a21> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 70" ;
    dzdoc:position 60 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_130> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_130> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_70_condition_0_b79537e7>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_70_condition_1_f1e41b6f> ;
    dzdoc:usesTerm dzterm:driver .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_75> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6> ;
    dzdoc:eId "art_75" ;
    dzdoc:fullText "يعاقب بغرامة من 1.500 إلى 5.000 دج ، كل شخص يخالف الأحكام التنظيمية المتعلقة بمنع الوقوف أو التوقف على أجزاء الطريق التي يعبر سطحها خط حديدي أو سير المركبات غير مرخص لها بذلك على السكك الحديدية . في حالة العود ، يرفع مبلغ الغرامة إلى 10.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_75> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_75_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_75_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_75_20010819_OpEnact_6257071f55> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_75_obligation_0_1e60f03f>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_75_obligation_1_0c7e16cd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "75" ;
    dzdoc:position 65 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_75_condition_0_f1e41b6f> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_2> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "يعاقب بغرامة من 50.000 إلى 150.000 دج، كل من يقوم بتنظيم سباقات العدو أو سباقات المركبات ذات محرك أو سباقات الدراجات العادية والدراجات النارية بدون ترخيص من السلطة المختصة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_78> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_78_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_78_20010819_OpEnact_9e6aa2ac99> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_78_obligation_0_4dd299ec> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "78" ;
    dzdoc:position 68 .

dzterm:driver a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "السائق"@ar,
        "سائق"@ar,
        "سائق مركبة"@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_104> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_5> ;
    dzdoc:eId "art_104" ;
    dzdoc:fullText "عندما يكون السائق غير حائز الرخصة المقررة للمركبة التي حكم عليه نتيجة سياقتها بعقوبة قد تكون سببا في تعليق أو إلغاء هذه الوثيقة ، تستبدل هذه العقوبات بعقوبة تمنعه من الحصول على رخصة السياقة وتتراوح مدة العقوبة من ستة (6) أشهر إلى سنتين (2) . في حالة العود ، تضاعف المدة القصوى للعقوبة المنصوص عليها أعلاه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_104> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_104_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_104_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_104_20010819_OpEnact_5529cc18b6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_104_obligation_0_29dd7eab>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_104_obligation_1_0752d530> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 104" ;
    dzdoc:position 93 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_104_condition_0_512f6cfa>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_104_condition_1_f1e41b6f> ;
    dzdoc:usesTerm dzterm:driving_license .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_131> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_7> ;
    dzdoc:eId "art_131" ;
    dzdoc:fullText "يمكن مهندسي الأشغال العمومية ورؤساء المناطق والأعوان التقنيين للغابات وحماية الأراضي واستصلاحها، معاينة المخالفات المنصوص عليها في أحكام هذا القانون عندما ترتكب على المسالك الغابية المفتوحة للسير العمومي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_131_permission_0_c76b03a2> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_131_right_0_22c404d0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_131> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_131_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_131_20010819_OpEnact_c7fb75b4b0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "131" ;
    dzdoc:position 119 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_131_condition_0_47148f04> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_133> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_7> ;
    dzdoc:eId "art_133" ;
    dzdoc:fullText "يختص الأعوان المذكورون في المادة 130 أعلاه بمعاينة المخالفات المنصوص عليها في هذا القانون ونصوصه التطبيقية بموجب محضر : أ ) عند اقترانها بالمخالفات المتعلقة بسلامة الأملاك العمومية الخاصة بالطرق ب ) عندما تكون مرتكبة في موقع الورشات الواقعة على المسلك العمومي أو بجوارها، وينتج عنها أو يمكن أن ينتج عنها ضرر يضر بالاستغلال العادي لتلك الورشات المذكورة أو بحماية المستخدمين فيها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_133_permission_0_53292082> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_133> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_133_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_133_20010819_OpEnact_49a81661e4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "133" ;
    dzdoc:position 121 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_130> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_130> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_133_condition_0_a43d1d91>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_133_condition_1_322d9355> ;
    dzdoc:usesTerm dzterm:agents .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_3> ;
    dzdoc:eId "art_52" ;
    dzdoc:fullText "يخضع تحويل ملكية المركبة أو إتلافها إلى تصريح . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_52_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_52_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_52_20010819_OpEnact_5f55625be1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_52_obligation_0_c0de49e6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 52" ;
    dzdoc:position 43 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "يعاقب بغرامة من 800 إلى 1.500 دج كل سائق يستعمل أثناء سير المركبة الهاتف المحمول أو يرتدي خوذة التصنت الإذاعي والسمعي . في حالة وقوع حادث جسماني أدى إلى الجرح أو نتج عنه القتل الخطأ وثبت بوسائل ملائمة أن السائق كان مستعملا للأجهزة المذكورة في الفقرة السابقة حال وقوع الحادث ، يعاقب بغرامة من 5.000 إلى 50.000 دج وبالحبس من ثلاثة (3) أشهر إلى ثلاث (3) سنوات أو بإحدى هاتين العقوبتين فقط . في حالة العود ، تضاعف العقوبة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_76_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_76_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_76_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_76_20010819_OpEnact_7ec0f56551> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_76_obligation_0_9ff792c8>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_76_obligation_1_7e1f70cb>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_76_obligation_2_d6f23a21> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "76" ;
    dzdoc:position 66 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_76_condition_0_2724d9a3>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_76_condition_1_f1e41b6f> .

