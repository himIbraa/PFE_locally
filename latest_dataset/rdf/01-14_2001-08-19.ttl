    dzdoc:position 3 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_122> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_7> ;
    dzdoc:eId "art_122" ;
    dzdoc:fullText "يمكن الشخص المعني بالأمر أن يطعن في قرار وضع المركبة في المحشر أمام وكيل الجمهورية الذي وقعت المخالفة في دائرة اختصاصه. يمكن وكيل الجمهورية أن يؤكد الإجراء المتخذ أو يلغيه في أجل أقصاه خمسة (5) أيام"@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_122_permission_0_15477963>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_122_permission_1_3df12d69> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_122_right_0_15477963> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_122> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_122_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_122_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_122_20010819_OpEnact_3a76ad373d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 122" ;
    dzdoc:position 110 ;
    dzdoc:usesTerm dzterm:prosecutor .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_2_subsec_1> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "يجب التنبيه إلى وجود الخطوط الحديدية المحاذية للطريق أو التي تقطعه ، بواسطة وضع إشارة ملائمة ، ويقع هذا الواجب على عاتق مستغل الخط الحديدي. تحظى بأسبقية المرور الآليات والمركبات التي تسير على الخطوط الحديدية . يتعين على المستعملين الآخرين الذين يعبرون هذه الخطوط ، أن يلتزموا الحيطة والحذر وألا يشكلوا في أي حال من الأحوال عائقا يعيق مرور الآليات والمركبات التي خصصت لها هذه الخطوط ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_28_right_0_84331a92> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_28_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_28_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_28_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_28_20010819_OpEnact_bc62095d70> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_28_obligation_0_8aeb9784>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_28_obligation_1_ebe00b65> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "28" ;
    dzdoc:position 21 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_3> ;
    dzdoc:eId "art_45" ;
    dzdoc:fullText "لا يجوز أن تتجاوز كمية الدخان والغازات السامة التي تنفثها السيارات وكذا الضجيج الذي تحدثه، المستويات المحددة عن طريق التنظيم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_45_permission_0_c590904e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_45> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_45_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
