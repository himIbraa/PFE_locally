    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_49> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:versionText "يجب أن تكون كل مركبة نقل البضائع يفوق وزنها الإجمالي مع الحمولة 3500 كلغ، وكل مركبة نقل الأشخاص تشتمل على أكثر من خمسة عشر (15) مقعدا، مجهزة بجهاز مراقبة وتسجيل السرعة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_4_20010819_OpEnact_3053ebfb01> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
