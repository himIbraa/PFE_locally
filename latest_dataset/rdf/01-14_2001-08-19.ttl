    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:versionText "يتعين على الدولة ترقية سياسة خاصة بالوقاية والأمن في الطرق ."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_50_20010819_OpEnact_9909c075de> a dzdoc:ArticleVersion ;
