<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_138_defocc_520fdd23eed7> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 62 ;
    dzdoc:charStart 5 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:national_database ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_138> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_138_para_0> ;
