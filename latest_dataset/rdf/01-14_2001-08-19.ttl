        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_69> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_113_extref_979fb375>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_113_extref_a5c3d418> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_66>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_69> ;
