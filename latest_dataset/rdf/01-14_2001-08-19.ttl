    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_92_20010819_OpEnact_e0f0b54c69> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_92_obligation_0_c9d7f649> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 92" ;
    dzdoc:position 82 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_50> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_50> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_92_condition_0_c8892ced> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_97> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_4> ;
    dzdoc:eId "art_97" ;
    dzdoc:fullText "يعاقب بغرامة من 50.000 إلى 150.000 دج وبالحبس من شهرين (2) إلى ثمانية عشر (18) شهرا أو بإحدى هاتين العقوبتين فقط، كل شخص يعرض للبيع أو يبيع آلة أو تجهيز مركبة غير معتمد، وذلك عندما يكون الاعتماد قد فرضه التشريع والتنظيم المعمول بهما. في حالة العود، تضاعف العقوبة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_97> ;
