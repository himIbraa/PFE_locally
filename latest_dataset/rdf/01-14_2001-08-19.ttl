<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_73_obligation_0_b4bbe1db> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_73> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بغرامة من 300 إلى 800 دج كل شخص يخالف الأحكام المتعلقة بما يأتي :"@ar ;
    dznorm:sourceArticle "art_73" .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_73_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_73> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب بغرامة من 300 إلى 800 دج كل شخص يخالف الأحكام المتعلقة بما يأتي : سرعة المركبات بدون محرك بمقطورة أو بدون مقطورة أو بدون نصف مقطورة استعمال المنبهات عدد الحيوانات المقرونة الالتزام بتشغيل ضوء أو أضواء المركبة المجرورة بواسطة الحيوانات. الوقوف التعسفي المؤدي إلى التوقف أو الوقوف المعيق، عندما ترتكب المخالفة في أوساط الطريق أو المسالك أو الدروب أو أشرطة الطريق أو الأرصفة أو حافة الطرق المخصصة لمرور مركبات النقل الجماعي والمركبات الأخرى المرخص لها بذلك خصيصا، ولمرور الراجلين. المرور في وسط الطريق أو المسالك أو الدروب أو أشرطة الطريق أو الأرصفة أو حافة الطرق المخصصة لمرور مركبات النقل الجماعي والمركبات الأخرى المرخص لها بذلك خصيصا، ولمرور الراجلين"@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_74_condition_0_9a378191> a dznorm:Condition ;
    dznorm:conditionText "عندما تعاين المخالفة بتجهيزات ملائمة معتمدة من السلطات المختصة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_74> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_74_condition_1_f1e41b6f> a dznorm:Condition ;
