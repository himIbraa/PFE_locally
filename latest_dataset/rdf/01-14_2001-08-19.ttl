    dznorm:position 0 ;
    dznorm:provisionText "تعليم القواعد الخاصة بحركة المرور والوقاية والأمن في الطرق، إجباريا في المؤسسات المدرسية"@ar ;
    dznorm:sourceArticle "art_60" .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_60_para_0> a dzdoc:Paragraph ;
