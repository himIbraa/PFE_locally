    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_42_obligation_0_b8d589b4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 42" ;
    dzdoc:position 34 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_7> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_7> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_1_subsec_2> ;
    dzdoc:eId "art_5" ;
    dzdoc:fullText "يشجع السير على الأقدام و الدراجات العادية والدراجات النارية ووسائل النقل الجماعي في المناطق الحضرية. وتستفيد وسائط التنقل هذه بالأولوية ويتم تشجيعها بمنحها المشالك والمعابر الرواقية أو التهيئات الملائمة بجعل المرور فيها يسيرا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_5_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_5_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_5_20010819_OpEnact_0a7cc34372> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 5" ;
    dzdoc:position 4 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_56> a dzdoc:Article ;
