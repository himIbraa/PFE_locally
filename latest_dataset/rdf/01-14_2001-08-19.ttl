    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:versionText "يجب أن تتوفر كل مركبة على تجهيزات تسمح للسائق أن يكون له مجال رؤية كاف نحو الأمام وإلى الخلف وكذا نحو اليمين واليسار حتى تتسنى له السياقة في أمان ."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_47_20010819_OpEnact_88a7ba9650> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2001-08-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_47> ;
