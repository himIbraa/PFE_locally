    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_53> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:versionText "يجب أن تحمل مركبات المعوقين والمعطوبين إشارة ملائمة ."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_54_20010819_OpEnact_2857b6c99a> a dzdoc:ArticleVersion ;
