    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_137_obligation_0_fbe6a780>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_137_obligation_1_757e4778> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
