<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_63> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في إطار تطبيق المادة 4 أعلاه المتعلقة بترقية السياسة الخاصة بالوقاية في الطرق، تتكفل الدولة بما يأتي : تربية وإعلام المواطن من أجل ترقية الإنضباط في استعمال المسالك العمومية الكفيلة بضمان أمنه، التنظيم الدوري للحملات الخاصة بالوقاية والأمن في الطرق، الحراسة والمراقبة الدائمتين لحركة المرور في الطرق من طرف المصالح المؤهلة التهيئة الملائمة للمنشآت القاعدية للطرق، وضع التجهيزات الأمنية في الطرق وصيانتها بصفة دائمة، تشجيع نشاط الحركة الجمعوية السهر على تطبيق الممراقبة التقنية للمركبات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_63_20010819_OpEnact_7558f167e7> ;
    dzdoc:replacementText "في إطار تطبيق المادة 4 أعلاه المتعلقة بترقية السياسة الخاصة بالوقاية في الطرق، تتكفل الدولة بما يأتي : تربية وإعلام المواطن من أجل ترقية الإنضباط في استعمال المسالك العمومية الكفيلة بضمان أمنه، التنظيم الدوري للحملات الخاصة بالوقاية والأمن في الطرق، الحراسة والمراقبة الدائمتين لحركة المرور في الطرق من طرف المصالح المؤهلة التهيئة الملائمة للمنشآت القاعدية للطرق، وضع التجهيزات الأمنية في الطرق وصيانتها بصفة دائمة، تشجيع نشاط الحركة الجمعوية السهر على تطبيق الممراقبة التقنية للمركبات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
