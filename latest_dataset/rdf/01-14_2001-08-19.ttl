    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:versionText "يمنع إلصاق شريط بلاستيكي أو استعمال أي طريقة أخرى تعتم زجاج المركبة ."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_49_20010819_OpEnact_d842cd8488> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
