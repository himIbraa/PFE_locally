<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على كل سائق مركبة أن يكون حاملا ل رخصة سياقة موافقة للمركبة التي يقودها . بالإضافة إلى رخصة السياقة ، تحدث شهادة مهنية للنقل العمومي للمسافرين والبضائع . تعد بمثابة رخصة سياقة الشهادات المنصوص عليها في التنظيمات الخاصة بقيادة المركبات ذات محرك، عندما لا تكون رخصة السياقة مطلوبة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_8_20010819_OpEnact_7641ab9892> ;
    dzdoc:replacementText "يجب على كل سائق مركبة أن يكون حاملا ل رخصة سياقة موافقة للمركبة التي يقودها . بالإضافة إلى رخصة السياقة ، تحدث شهادة مهنية للنقل العمومي للمسافرين والبضائع . تعد بمثابة رخصة سياقة الشهادات المنصوص عليها في التنظيمات الخاصة بقيادة المركبات ذات محرك، عندما لا تكون رخصة السياقة مطلوبة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_8> ;
