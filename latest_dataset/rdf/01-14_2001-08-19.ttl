    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_54_20010819_OpEnact_2857b6c99a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 54" ;
    dzdoc:position 45 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_55> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_4> ;
    dzdoc:eId "art_55" ;
    dzdoc:fullText "تسلم رخصة السياقة كما هو منصوص عليها في المادة 8 أعلاه للمترشح الذي أجرى بنجاح الامتحانات النظرية والتطبيقية الخاصة بسياقة المركبات. تحدد شروط الالتحاق بالامتحانات المذكورة أعلاه ، وتجديد رخصة السياقة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_55> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_55_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_55_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_55_20010819_OpEnact_92d70c2486> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "55" ;
    dzdoc:position 46 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_8> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_8> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_55_condition_0_32457c0a> ;
    dzdoc:usesTerm dzterm:driving_license .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_61> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_4> ;
    dzdoc:eId "art_61" ;
    dzdoc:fullText "يحدث مركز وطني لرخص السياقة . يقوم المركز الوطني لرخص السياقة بتأطير نشاطات تعليم سياقة السيارة وتنظيم الامتحانات الخاصة برخص السياقة. يحدد تنظيم وس هذا المركز عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_61> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_61_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_61_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_61_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_61_20010819_OpEnact_d8244dc673> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "61" ;
    dzdoc:position 52 ;
    dzdoc:usesTerm dzterm:national_center_driving_licenses .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين (2) إلى ثمانية عشر (18) شهرا، وبغرامة من 5.000 إلى 50.000 دج أو بإحدى هاتين العقوبتين فقط ، كل سائق مركبة رفض الخضوع للفحوص الطبية والاستشفائية والبيولوجية المنصوص عليها في المادة 19 أعلاه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_68_para_0> ;
