    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "17" ;
    dzdoc:position 15 ;
    dzdoc:usesTerm dzterm:driver .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_2_subsec_1> ;
    dzdoc:eId "art_20" ;
    dzdoc:fullText "في حالة وقوع حادث مرور أدى إلى القتل الخطأ ، يجب أن يخضع ضباط أو أعوان الشرطة القضائية السائق إلى فحوص طبية واستشفائية وبيولوجية لإثبات ما إذا كان يقود سيارته تحت تأثير مواد أو أعشاب مصنفة ضمن المخدرات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_20> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_20_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_20_20010819_OpEnact_890d35a048> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_20_obligation_0_538e1029> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "20" ;
