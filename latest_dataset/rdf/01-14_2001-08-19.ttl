<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_84> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من 50.000 إلى 150.000 دج، أو بإحدى هاتين العقوبتين فقط ، كل شخص يضع للسير مركبة ذات محرك أو مقطورة مزودة بلوحة تسجيل أو علامة لاتتطابق مع نوع هذهالمركبة أو الصفة الخاصة بالمنتفع بها . في حالة العود ، تضاعف العقوبة . فضلا عن ذلك، يمكن المحكمة الحكم بمصادرة العتاد المستعمل لصنع لوحات التسجيل والمركبة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_84_20010819_OpEnact_c4b1d43719> ;
    dzdoc:replacementText "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من 50.000 إلى 150.000 دج، أو بإحدى هاتين العقوبتين فقط ، كل شخص يضع للسير مركبة ذات محرك أو مقطورة مزودة بلوحة تسجيل أو علامة لاتتطابق مع نوع هذهالمركبة أو الصفة الخاصة بالمنتفع بها . في حالة العود ، تضاعف العقوبة . فضلا عن ذلك، يمكن المحكمة الحكم بمصادرة العتاد المستعمل لصنع لوحات التسجيل والمركبة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_84> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
