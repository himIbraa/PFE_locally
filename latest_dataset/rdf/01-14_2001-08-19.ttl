    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_65_obligation_0_c4c746a6_ref_3f6efa4122d2>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_65_obligation_0_c4c746a6_ref_d0481538cd1a> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_65_obligation_0_c4c746a6_ref_3f6efa4122d2>,
