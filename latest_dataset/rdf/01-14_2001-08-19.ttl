<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_3> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "عملا ب المادة 7 أعلاه، تخضع السيارات قبل وضعها للسير لأول مرة للمراقبة قصد التأكد من مطابقتها للمواصفات التقنية و التنظيمية."@ar ;
