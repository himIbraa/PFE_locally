    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_19> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_19> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_68_condition_0_0b8557b0> ;
    dzdoc:usesTerm dzterm:driver .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_83> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_3> ;
    dzdoc:eId "art_83" ;
    dzdoc:fullText "يعاقب بغرامة من 1.500 إلى 5.000 دج ، كل شخص يقود في المسالك المفتوحة للسير مركبة ذات محرك أو مقطورة دون أن تكون هذه المركبة حاملة للوحتي التسجيل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_83> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_83_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
