<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_80_obligation_0_a07fb71f_ref_6cb9b4f00bad> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "المادة 408 من قانون العقوبات"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/penal#art_408"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/code/penal#art_408"^^xsd:anyURI ;
