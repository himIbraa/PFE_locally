<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_112> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مع مراعاة أحكام المادتين 108 و 111 من هذا القانون، يقوم الأعوان المؤهلون بسحب رخصة السياقة فورا لمدة لا تتجاوز خمسة عشر (15) يوما في الحالات المنصوص عليها في المواد 65 و 66 و 67 و 69 من هذا القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_112_20010819_OpEnact_8a71b88fd5> ;
    dzdoc:replacementText "مع مراعاة أحكام المادتين 108 و 111 من هذا القانون، يقوم الأعوان المؤهلون بسحب رخصة السياقة فورا لمدة لا تتجاوز خمسة عشر (15) يوما في الحالات المنصوص عليها في المواد 65 و 66 و 67 و 69 من هذا القانون ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_112> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_112> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
