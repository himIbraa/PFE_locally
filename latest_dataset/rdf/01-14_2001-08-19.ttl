<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_127> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتحمل مالك المركبة المهجورة مصاريف رفعها ووضعها في المحشر وإجراء الخبرة وبيعها أو تدميرها. يوضع حاصل البيع بعد أن تخصم منه المصاريف المذكورة في الفقرة أعلاه، تحت تصرف المالك أو ذوي حقوقه، أو عند الاقتضاء، الدائن الضامن الذي يتمكن من إثبات حقوقه خلال أجل مدته سنتان (2). عند انقضاء هذا الأجل، يعود هذا الحاصل إلى الدولة. عندما يقل حاصل البيع عن مبلغ المصاريف المذكورة أعلاه ، يبقى المالك مدينا بالفارق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_127_20010819_OpEnact_5b223095f0> ;
    dzdoc:replacementText "يتحمل مالك المركبة المهجورة مصاريف رفعها ووضعها في المحشر وإجراء الخبرة وبيعها أو تدميرها. يوضع حاصل البيع بعد أن تخصم منه المصاريف المذكورة في الفقرة أعلاه، تحت تصرف المالك أو ذوي حقوقه، أو عند الاقتضاء، الدائن الضامن الذي يتمكن من إثبات حقوقه خلال أجل مدته سنتان (2). عند انقضاء هذا الأجل، يعود هذا الحاصل إلى الدولة. عندما يقل حاصل البيع عن مبلغ المصاريف المذكورة أعلاه ، يبقى المالك مدينا بالفارق."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_127> ;
