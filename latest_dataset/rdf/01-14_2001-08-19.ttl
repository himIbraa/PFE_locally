<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_108> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للوالي عندما يحال عليه محضر إثبات إحدى المخالفات المبينة في المادة 111 أدناه، إذا رأى من غير الواجب حفظ الملف ، أن يصدر بصفة مؤقتة وبعد أخذ رأي لجنة خاصة قرار تعليق رخصة السياقة أو منع اجتياز امتحانها عندما يكون السائق المعني غير متحصل عليها . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_108_20010819_OpEnact_8235330037> ;
    dzdoc:replacementText "يجوز للوالي عندما يحال عليه محضر إثبات إحدى المخالفات المبينة في المادة 111 أدناه، إذا رأى من غير الواجب حفظ الملف ، أن يصدر بصفة مؤقتة وبعد أخذ رأي لجنة خاصة قرار تعليق رخصة السياقة أو منع اجتياز امتحانها عندما يكون السائق المعني غير متحصل عليها . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
