<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_124> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز أن تسحب المركبات التي لا تسمح حالتها بالسير حسب الشروط العادية للأمن من المحشر ، إلا من قبل مصلحين يكلفهم أصحاب المركبات بالقيام بالتصليحات الضرورية. إذا حصل اختلاف على حالة المركبة ، يتم تعيين خبير حسب الشروط التي يحددها التنظيم. في حالة إثباته أن المركبة ليست في حالة تمكنها من السير حسب الشروط العادية للأمن يحدد التصليحات الواجب القيام بها قبل تسليمها لصاحبها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_124_20010819_OpEnact_937e145109> ;
    dzdoc:replacementText "لا يجوز أن تسحب المركبات التي لا تسمح حالتها بالسير حسب الشروط العادية للأمن من المحشر ، إلا من قبل مصلحين يكلفهم أصحاب المركبات بالقيام بالتصليحات الضرورية. إذا حصل اختلاف على حالة المركبة ، يتم تعيين خبير حسب الشروط التي يحددها التنظيم. في حالة إثباته أن المركبة ليست في حالة تمكنها من السير حسب الشروط العادية للأمن يحدد التصليحات الواجب القيام بها قبل تسليمها لصاحبها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_124> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_124> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2001-08-19"^^xsd:date ;
