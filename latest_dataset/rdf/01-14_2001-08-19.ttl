    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 4" ;
    dzdoc:position 3 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_3> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "يجب أن يكون الزجاج كله بما فيه الزجاج الأمامي الواقي من مادة شفافة، ومطابقا للمقاييس المحددة عن طريق التنظيم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_47_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_47_20010819_OpEnact_88a7ba9650> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_47_obligation_0_4aa02119> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 47" ;
    dzdoc:position 38 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_3> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "يجب أن تكون كل مركبة نقل البضائع يفوق وزنها الإجمالي مع الحمولة 3500 كلغ، وكل مركبة نقل الأشخاص تشتمل على أكثر من خمسة عشر (15) مقعدا، مجهزة بجهاز مراقبة وتسجيل السرعة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_49_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_49_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_49_20010819_OpEnact_d842cd8488> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_49_obligation_0_ac3a5bbe> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 49" ;
    dzdoc:position 40 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_3> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "يجب أن تتوفر كل مركبة على لوحة تسجيل . تحدد مواصفات لوحات التسجيل وشروط وكيفيات صنعها وتركيبها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_51_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_51_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_51_20010819_OpEnact_d7fc711cc0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_51_obligation_0_0cc0d98e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 51" ;
    dzdoc:position 42 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_4> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "يكون تعليم القواعد الخاصة بحركة المرور والوقاية والأمن في الطرق، إجباريا في المؤسسات المدرسية . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_60_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_60_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_60_20010819_OpEnact_e091e51e5a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_60_obligation_0_1c5ddaff> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "60" ;
    dzdoc:position 51 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_60> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_60> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_2> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "يعاقب بغرامة من 1.500 إلى 5.000 دج، كل سائق يعبر بعض أجزاء الطرق غير الصالحة للسير بسبب رداءة الطقس أو الأشغال المنبه عليها بإشارات نظامية أو يعبر بعض الجسور ذات الحمولة المحدودة في حالة العود ، يعاقب بالحبس من شهر (1) إلى شهرين (2) وتضاعف الغرامة أو يعاقب بإحدى هاتين العقوبتين فقط ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_77_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_77_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_77_20010819_OpEnact_cd4fbff152> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_77_obligation_0_98ad5d8a>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_77_obligation_1_e9562fbb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "77" ;
    dzdoc:position 67 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_77_condition_0_f1e41b6f> ;
    dzdoc:usesTerm dzterm:driver .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_3> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "يعاقب بغرامة من 1.500 إلى 5.000 دج ، كل سائق يخالف أحكام المادة 16 أعلاه، دون المساس بالتوقيف الفوري للمركبة إلى غاية مطابقتها للأحكام التشريعية والتنظيمية. في حالة العود ، تضاعف العقوبة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_86_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_86_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_86_20010819_OpEnact_f2099fe7ff> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_86_obligation_0_9e812f38>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_86_obligation_1_d6f23a21> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 86" ;
    dzdoc:position 76 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_16> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_16> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_86_condition_0_f1e41b6f> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_89> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
