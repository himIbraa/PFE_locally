    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_54> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:versionText "تحدث بطاقية وطنية لبطاقات تسجيل المركبات تدعى \"بطاقات رمادية\" . تحدد شروط وكيفيات مسك هذه البطاقية عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_55_20010819_OpEnact_92d70c2486> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2001-08-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
