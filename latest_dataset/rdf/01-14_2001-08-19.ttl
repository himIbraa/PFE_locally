    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_4> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "دون المساس بالعقوبات المنصوص عليها في المادتين 108 و 111 أدناه، و يعاقب بالحبس من ثمانية (8) أيام إلى شهر (1) و بغرامة من 1.500 إلى 5.000 دج أو بإحدى هاتين العقوبتين فقط، كل شخص يعرض للبيع أو يبيع أو يحوز أو يستعمل أو يكيف أو يضع أو يركب أو ينقل بأية صفة كانت جهازا أو آلة مخصصة إما للكشف عن الأدوات المستعملة لمعاينة مخالفات التشريع أو التنظيم المتعلق بمرور السيارات، وإما للتشويش على سيرها. يصادر هذا الجهاز أو هذه الآلة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_100> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_100_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_100_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_100_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_100_20010819_OpEnact_1fd2615444> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_100_obligation_0_a201be3b>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_100_obligation_1_bf588e72> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 100" ;
    dzdoc:position 89 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_108>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_111> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_108>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_111> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_103> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_5> ;
    dzdoc:eId "art_103" ;
    dzdoc:fullText "يعاقب بغرامة من 800 إلى 1.500 دج ، كل سائق تحصل على رخصة سياقة منذ أقل من سنتين ، وتجاوز حدود السرعة المنصوص عليها لهذه الفئة من السائقين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_103> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_103_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_103_20010819_OpEnact_038687fb0c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_103_obligation_0_64ae2230> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 103" ;
    dzdoc:position 92 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_103_condition_0_e17b30da> ;
    dzdoc:usesTerm dzterm:driving_license .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_105> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_5> ;
    dzdoc:eId "art_105" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين (2) إلى ستة (6) أشهر وبغرامة من 1.500 إلى 5.000 دج أو بإحدى هاتين العقوبتين فقط ، كل شخص يستمر في قيادة مركبة ذات محرك يقتضي لأجل قيادتها وثيقة ما، رغم تبليغه القرار الصادر بشأنه والمتضمن تعليق أو إلغاء رخصة السياقة أو منع تسليمها . تطبق نفس العقوبات على كل شخص يستلم تبلیغ قرار صادر بشأنه ويتضمن تعليق أو إلغاء رخصة السياقة ، ويرفض تسليم الرخصة المعلقة أو الملغاة إلى العون التابع للسلطة المكلفة بتنفيذ هذا القرار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_105> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_105_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_105_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_105_20010819_OpEnact_9ded7942ec> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_105_obligation_0_342b2049>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_105_obligation_1_bff79378> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 105" ;
    dzdoc:position 94 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_105_condition_0_402f6599>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_105_condition_1_2b3e6fda> ;
    dzdoc:usesTerm dzterm:driving_license .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_2_subsec_2> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "إذا كانت حظائر وقوف المركبات مقامة على الأرصفة أو على الأشرطة الترابية ، يجب على السائقين عند مرورهم عليها السير بسرعة جد منخفضة مع أخذ كل الاحتياطات من أجل عدم الإضرار بالراجلين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_40_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_40_20010819_OpEnact_623fc3cc98> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_40_obligation_0_5f5ecca0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "40" ;
    dzdoc:position 32 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_40_condition_0_40483d67> ;
    dzdoc:usesTerm dzterm:drivers,
        dzterm:pedestrians .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_46> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_3> ;
    dzdoc:eId "art_46" ;
    dzdoc:fullText "يجب أن تتوفر كل مركبة على تجهيزات تسمح للسائق أن يكون له مجال رؤية كاف نحو الأمام وإلى الخلف وكذا نحو اليمين واليسار حتى تتسنى له السياقة في أمان ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_46> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_46_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_46_20010819_OpEnact_886d428437> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_46_obligation_0_62baf587> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 46" ;
    dzdoc:position 37 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_5> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "يحدث مركز وطني و لجان ولائية للوقاية والأمن في الطرق. يوضع هذا المركز تحت وصاية الوزارة المكلفة بالنقل . يمكن أن تنشأ هيئات تكلف بمتابعة تطبيق أحكام هذا القانون. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_64_permission_0_4272298a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_64_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_64_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_64_para_2>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_64_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_64_20010819_OpEnact_1f4867bf0b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 64" ;
    dzdoc:position 55 ;
    dzdoc:usesTerm dzterm:national_center,
        dzterm:provincial_committees,
        dzterm:transport_ministry .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_71> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6> ;
    dzdoc:eId "art_71" ;
    dzdoc:fullText "يعاقب بغرامة من 800 إلى 1.500 دج، كل سائق يخالف الأحكام المتعلقة بما يأتي : 1 - الحد من سرعة المركبات ذات محرك بمقطورة أو بدون مقطورة أو نصف مقطورة والحد من السرعة في بعض مخارج الطرق وبكل صنف مركبة. 2 - التخفيض غير العادي للسرعة بدون أسباب حتمية من شأنه تقليص سيولة حركة المرور. 3 - التقاطع و التجاوز. 4 - إشارات الأمر بالتوقف التام. 5 - منع المرور أو تقييده في بعض الاتجاهات بالنسبة لبعض أصناف المركبات أو بالنسبة للمركبات التي تقوم ببعض أنواع النقل. 6 - حالات الإلزام أو المنع المتعلقة بعبور الخطوط الحديدية الواقعة على الطريق. 7 - التوقف أو الوقوف الخطيرين. 8 - التوقف أو الوقوف بدون ضرورة حتمية على شريط الوقوف الاستعجالي للطريق السريع للسيارات والطريق السريع. 9 - شد حزام الأمن بالنسبة للجالسين في المقاعد الأمامية للمركبة إذا كانت مزودة بهذا الجهاز. 10 - الارتداء الإجباري للخوذة بالنسبة لسائقي الدراجات النارية والراكبين. 11 - القواعد المنظمة لحركة مرور الراجلين لا سيما عند مرورهم في الممرات الخاصة بالراجلين. في حالة العود ، تضاعف العقوبة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_71> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_71_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_71_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_71_20010819_OpEnact_b50bd6049e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_71_obligation_0_2c1efab3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 71" ;
    dzdoc:position 61 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_71_condition_0_f1e41b6f> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "يعاقب بغرامة من 1.500 إلى 5.000 دج، كل سائق يخالف الأحكام المتعلقة بما يأتي: 1 - اتجاهات المرور الإلزامية. 2 - تقاطع الطرق و أسبقية المرور. 3 - استعمال أجهزة الإنارة والإشارة. 4 - حركة السياقة الممنوعة في الطرق السريعة للسيارات والطرق السريعة، والمكوث على الشريط الأرضي الوسطي الفاصل بين أوساط الطرق المكونة للطريق السريع للسيارات والطريق السريع والسير إلى الوراء والتراجع أو استعمال الشريط الوسيط الفاصل. 5 - السير على الخط المتواصل أو اجتيازه عندما يكون هذا الخط منفردا أو مزدوجا مع الخط المتقاطع عندما تكون هذه الحركة ممنوعة. 6 - التغيير الخطير للاتجاه دون تأكد السائق من عدم خطورة هذه الحركة على المستعملين الآخرين وبدون تنبيههم عن رغبته في تغيير الاتجاه. 7 - زيادة السرعة من طرف سائق المركبة أثناء محاولة تجاوزه من طرف سائق أخر. 8 - سير أو وقوف مركبة في وسط الطريق ليلا أو أثناء انتشار الضباب في مكان خال من الإنارة العمومية، إذا كانت هذه المركبة بدون إنارة ولا تحمل إشارة. 9 - منع المرور على مسلك يقع مباشرة على يسار طريق يتضمن ثلاثة مخارج أو أكثر ذات اتجاه واحد للمرور، بالنسبة لمركبات نقل الأشخاص أو البضائع التي يتجاوز طولها 7 أمتار وذات وزن إجمالي للحمولة المرخص بها يفوق طنين (2) . 10- منع نقل الأطفال الذين تقل أعمارهم عن عشر (10) سنوات في الأماكن الأمامية. في حالة العود ، تضاعف العقوبة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_72_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_72_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_72_20010819_OpEnact_78a0d51e75> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_72_obligation_0_8be0ce43> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 72" ;
    dzdoc:position 62 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_72_condition_0_f1e41b6f> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_74> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6> ;
    dzdoc:eId "art_74" ;
    dzdoc:fullText "دون المساس بالعقوبات المتعلقة بسحب رخصة السياقة و عندما تعاين المخالفة بتجهيزات ملائمة معتمدة من السلطات المختصة يعاقب بغرامة مالية من 5.000 إلى 10.000 دج كل شخص تجاوز ب : 40 كلم/ سا السرعة القانونية المرخص بها في الطريق السريع للسيارات والطريق السريع. 30 كلم / سا السرعة القانونية المرخص بها خارج المجمع السكاني. 20 كلم / سا السرعة القانونية المرخص بها داخل المجمع السكاني. في حالة العود ، تضاعف العقوبة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_74> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_74_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_74_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_74_20010819_OpEnact_e77f5cea12> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_74_obligation_0_d9da9022>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_74_obligation_1_d6f23a21> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "74" ;
    dzdoc:position 64 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_74_condition_0_9a378191>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_74_condition_1_f1e41b6f> ;
    dzdoc:usesTerm dzterm:driving_license .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_2> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "يعاقب بغرامة من 1.500 إلى 5.000 دج، منظمو السباقات المذكورة في أعلاه الذين خالفوا الأحكام السارية المفعول، رغم حصولهم على الرخصة . في حالة العود ، تضاعف العقوبة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_79_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_79_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
