<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_102> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_5> ;
    dzdoc:eId "art_102" ;
    dzdoc:fullText "يعاقب بغرامة من 300 إلى 800 دج ، كل سائق تحصل على رخصة سياقة منذ أقل من سنتين، ولم يضع الإشارة الملائمة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_102> ;
