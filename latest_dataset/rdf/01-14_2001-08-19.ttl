        dzterm:pedestrians .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_1_subsec_2> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "يتعين على الدولة ترقية سياسة خاصة بالوقاية والأمن في الطرق ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_4_20010819_OpEnact_3053ebfb01> ;
