<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_57> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_4> ;
    dzdoc:eId "art_57" ;
    dzdoc:fullText "يلقن تعليم سياقة السيارة بمقابل مالي في مؤسسات التكوين المعتمدة. تنظم وتراقب هذه المؤسسات وفقا للشروط المحددة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_57> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_57_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_57_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_57_20010819_OpEnact_5d2d7f804c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "57" ;
    dzdoc:position 48 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_58> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_4> ;
    dzdoc:eId "art_58" ;
    dzdoc:fullText "يرخص بتعليم سياقة السيارة بدون مقابل مالي بالنسبة للأصناف \"أ، أ 1 وب\" من رخصة السياقة ، وفقا للكيفيات المحددة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_58_permission_0_fc57606a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_58> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_58_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_58_20010819_OpEnact_6868124c4b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "58" ;
    dzdoc:position 49 ;
    dzdoc:usesTerm dzterm:driving_license .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_4> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "تتولى المؤسسات المعتمدة، التكوين المهني لسائقي المركبات المخصصة للنقل العمومي للأشخاص والبضائع والمواد الخطيرة. تحدد شروط وكيفيات اعتماد هذه المؤسسات عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_59_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_59_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_59_20010819_OpEnact_c4655a462a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "59" ;
    dzdoc:position 50 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_4> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "تحدث بطاقية وطنية لرخص السياقة . تحدد شروط وكيفيات مسك هذه البطاقية عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_62_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_62_para_1> ;
