    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_93_20010819_OpEnact_9169d50142> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_93_obligation_0_5275f832> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 93" ;
    dzdoc:position 83 ;
    dzdoc:usesTerm dzterm:driving_license,
        dzterm:professional_certificate,
        dzterm:vehicle_documents .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_98> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_4> ;
    dzdoc:eId "art_98" ;
    dzdoc:fullText "يعاقب بغرامة من 200 إلى 300دج كل شخص يستخدم آلة أو تجهيزا لمركبة غير مطابق للأحكام التشريعية والتنظيمية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_98> ;
