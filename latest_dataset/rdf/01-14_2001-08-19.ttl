<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_117> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يتعذر على مرتكب مخالفة خاصة بسلامة المرور في الطرق إثبات محل إقامته أو عمله في التراب الوطني ، يمكن فيما عدا حالة دفع غرامة جزافية ، توقيف المركبة موضوع المخالفة إلى وكيل أن يودع لدى أحد محاسبي الخزينة كفالة يحدد وكيل الجمهورية مقدارها. وفي حالة عدم تقديم مرتكب المخالفة أيا من هذين الضمانين ، يمكن أن توضع المركبة في المحشر وأن تكون النفقات الناجمة عن ذلك على عاتقه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_117_20010819_OpEnact_ca3df3bed3> ;
    dzdoc:replacementText "عندما يتعذر على مرتكب مخالفة خاصة بسلامة المرور في الطرق إثبات محل إقامته أو عمله في التراب الوطني ، يمكن فيما عدا حالة دفع غرامة جزافية ، توقيف المركبة موضوع المخالفة إلى وكيل أن يودع لدى أحد محاسبي الخزينة كفالة يحدد وكيل الجمهورية مقدارها. وفي حالة عدم تقديم مرتكب المخالفة أيا من هذين الضمانين ، يمكن أن توضع المركبة في المحشر وأن تكون النفقات الناجمة عن ذلك على عاتقه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_117> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_117> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2001-08-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_119> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن تطبيق الإجراء المتعلق بالغرامة الجزافية في الحالات الآتية : إذا كانت المخالفة المثبتة تعرض مرتكبها إما لعقوبة أخرى غير العقوبة المالية، وإما لتعويض عن الضرر المسبب للأشخاص أو الممتلكات. في حالة المخالفات المتزامنة والتي لا يترتب على إحداها على الأقل تطبيق الإجراء المتعلق بالغرامة الجزافية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_119_20010819_OpEnact_2fc2420a8a> ;
    dzdoc:replacementText "لا يمكن تطبيق الإجراء المتعلق بالغرامة الجزافية في الحالات الآتية : إذا كانت المخالفة المثبتة تعرض مرتكبها إما لعقوبة أخرى غير العقوبة المالية، وإما لتعويض عن الضرر المسبب للأشخاص أو الممتلكات. في حالة المخالفات المتزامنة والتي لا يترتب على إحداها على الأقل تطبيق الإجراء المتعلق بالغرامة الجزافية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_119> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
