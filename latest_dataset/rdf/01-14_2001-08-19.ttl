    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:versionText "يجب أن تتوفر كل مركبة على لوحة تسجيل . تحدد مواصفات لوحات التسجيل وشروط وكيفيات صنعها وتركيبها عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_52_20010819_OpEnact_5f55625be1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2001-08-19"^^xsd:date ;
