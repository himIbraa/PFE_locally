    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_47> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:versionText "يجب أن يكون الزجاج كله بما فيه الزجاج الأمامي الواقي من مادة شفافة، ومطابقا للمقاييس المحددة عن طريق التنظيم ."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_48_20010819_OpEnact_c87203214d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2001-08-19"^^xsd:date ;
