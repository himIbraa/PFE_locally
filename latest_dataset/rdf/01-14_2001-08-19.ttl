    dznorm:position 1 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_139_extref_335823a6> a dzdoc:ExternalReference ;
    rdfs:label "القانون رقم 87 - 09 المؤرخ في 11 جمادى الثانية عام 1407 الموافق 10 فبراير سنة 1987 والمتعلق بتنظيم حركة المرور عبر الطرق وسلامتها وأمنها"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1987-02-10/87-09"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1987-02-10/87-09"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1987-02-10/87-09" ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/1987-02-10/87-09> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1987-02-10/87-09"^^xsd:anyURI .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_139_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_139> ;
    dzdoc:position 0 ;
    dzdoc:text "تلغى أحكام القانون رقم 87 - 09 المؤرخ في 11 جمادى الثانية عام 1407 الموافق 10 فبراير سنة 1987 والمتعلق بتنظيم حركة المرور عبر الطرق وسلامتها وأمنها."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_139_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_139> ;
    dzdoc:position 1 ;
    dzdoc:text "تبقى النصوص التنظيمية المتخذة لتطبيق القانون المذكور أعلاه ، سارية المفعول مالم تكن مخالفة لهذا القانون إلى غاية نشر النصوص التنظيمية المنصوص عليها في هذا القانون خلال أجل لا يتجاوز أربعة وعشرين (24) شهرا."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_13_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_13> ;
    dzdoc:position 0 ;
    dzdoc:text "تنظم حركة المرور عبر الطرق قصد ضمان أفضل شروط الأمن والسيولة وفي هذا الإطار، تكلف الجماعات الإقليمية بإعداد و تنفيذ مخطط حركة المرور في المنطقة الحضرية للتحكم في تطور حركة السيارات وتقليص تأثيراتها السلبية."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_13_para_1> a dzdoc:Paragraph ;
