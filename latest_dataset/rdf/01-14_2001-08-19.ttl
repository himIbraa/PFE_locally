    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 120" ;
    dzdoc:position 108 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_134> a dzdoc:Article ;
