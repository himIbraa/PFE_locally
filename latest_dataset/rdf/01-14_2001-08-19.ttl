    dznorm:expressedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_65> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب طبقا لأحكام المادتين 288 و 289 من قانون العقوبات"@ar ;
    dznorm:sourceArticle "art_65" .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_65_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_65> ;
    dzdoc:position 0 ;
