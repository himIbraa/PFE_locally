    dzdoc:eId "art_120" ;
    dzdoc:fullText "تحدد قيمة الغرامة الجزافية على النحو الآتي : 200 دج للمستوجبة غرامة لا تتجاوز قيمتها القصوى 300 دج ، 300 دج للمخالفات المستوجبة غرامة لا تتجاوز قيمتها القصوى 800 دج ، 800 دج للمخالفات المستوجبة غرامة لا تتجاوز قيمتها القصوى 1.500 دج ، 1.500 دج للمخالفات المستوجبة غرامة لا تتجاوز قيمتها القصوى 5.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_120> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_120_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_120_20010819_OpEnact_c354b9d982> ;
