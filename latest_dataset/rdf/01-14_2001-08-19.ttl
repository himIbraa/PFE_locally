<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_80> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_2> ;
    dzdoc:eId "art_80" ;
    dzdoc:fullText "يعاقب طبقا للأحكام المنصوص عليها في المادة 408 من قانون العقوبات ، كل من يضع أو يحاول وضع على مسلك مفتوح لحركة المرور أو على خافته المباشرة قصد عرقلة حركة المرور شيئا من شأنه إعاقة سير المركبات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_80> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_80_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_80_20010819_OpEnact_4991e64aae> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_80_obligation_0_a07fb71f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "80" ;
    dzdoc:position 70 ;
