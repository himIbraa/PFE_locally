    dzdoc:eId "art_11" ;
    dzdoc:fullText "استعمال حزام الأمن إجباري . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_11> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_11_para_0>,
