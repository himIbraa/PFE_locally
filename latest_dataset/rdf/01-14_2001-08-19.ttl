    dzdoc:resolutionReason "non_canonical_or_malformed_akn_uri" ;
    dzdoc:resolutionStatus "unresolved" ;
    dzdoc:sourceEId "art_80" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يعاقب طبقا للأحكام المنصوص عليها في المادة 408 من قانون العقوبات ، كل من يضع أو يحاول وضع على مسلك مفتوح لحركة المرور أو على خافته المباشرة قصد عرقلة حركة المرور شيئا من شأنه إعاقة سير المركبات"@ar ;
    dzdoc:targetEId "art_408" .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#preamble_segment_0> a dzdoc:Citation,
