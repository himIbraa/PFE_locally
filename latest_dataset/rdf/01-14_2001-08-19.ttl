    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_45> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:versionText "لا يجوز أن تتجاوز كمية الدخان والغازات السامة التي تنفثها السيارات وكذا الضجيج الذي تحدثه، المستويات المحددة عن طريق التنظيم ."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_46_20010819_OpEnact_886d428437> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2001-08-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
