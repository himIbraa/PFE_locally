    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_52> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:versionText "يخضع تحويل ملكية المركبة أو إتلافها إلى تصريح . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_53_20010819_OpEnact_466d6a27f7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
