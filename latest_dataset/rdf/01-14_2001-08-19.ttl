    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_140_20010819_OpEnact_4f9f2c3664> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_140_obligation_0_d261bccb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
