<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_3> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "ينبغي أن يكون لكل مركبة رقم تسجيل وأن تتوفر على الرخص والوثائق الإدارية اللازمة لسيرها وفقا للشروط المحددة عن طريق التنظيم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_50> ;
