<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_105> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بالحبس من شهرين (2) إلى ستة (6) أشهر وبغرامة من 1.500 إلى 5.000 دج أو بإحدى هاتين العقوبتين فقط ، كل شخص يستمر في قيادة مركبة ذات محرك يقتضي لأجل قيادتها وثيقة ما، رغم تبليغه القرار الصادر بشأنه والمتضمن تعليق أو إلغاء رخصة السياقة أو منع تسليمها . تطبق نفس العقوبات على كل شخص يستلم تبلیغ قرار صادر بشأنه ويتضمن تعليق أو إلغاء رخصة السياقة ، ويرفض تسليم الرخصة المعلقة أو الملغاة إلى العون التابع للسلطة المكلفة بتنفيذ هذا القرار ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_105_20010819_OpEnact_9ded7942ec> ;
