<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_116_defocc_ab9ed6db3a7e> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 90 ;
    dzdoc:charStart 35 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:recidivism ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_116> ;
