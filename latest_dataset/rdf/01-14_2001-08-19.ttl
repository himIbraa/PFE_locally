<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_6> ;
    dzdoc:eId "art_114" ;
    dzdoc:fullText "يعاقب بغرامة من 1.000 إلى 5.000 دج، كل من خالف أحكام هذا القانون والنصوص التنظيمية المتخذة لتطبيقه والمتعلقة بتعليم سياقة المركبات ذات محرك . في حالة العود ، تضاعف العقوبة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_114> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_114_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_114_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_114_20010819_OpEnact_7718e53911> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_114_obligation_0_e263211e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 114" ;
    dzdoc:position 102 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_114_condition_0_f1e41b6f> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_116> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:definesTerm dzterm:recidivism ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_7> ;
    dzdoc:eId "art_116" ;
    dzdoc:fullText "خلافا لأحكام قانون العقوبات ، يعتبر العود في ارتكاب المخالفات الخاصة بسلامة المرور في الطرق مستقلا عن المكان الذي وقعت فيه المخالفة الأولى. تحدد كيفية إثبات العود في ارتكاب هذه المخالفات وفقا لأحكام المواد من 655 إلى 665 من قانون الإجراءات الجزائية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_116> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_116_defocc_ab9ed6db3a7e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_116_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_116_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_116_20010819_OpEnact_b8313e38d4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 116" ;
    dzdoc:position 104 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_116_extref_6a2b19cf>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_116_extref_ffa60151> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_116_condition_0_e2fe42ab> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_119> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_7> ;
    dzdoc:eId "art_119" ;
    dzdoc:fullText "لا يمكن تطبيق الإجراء المتعلق بالغرامة الجزافية في الحالات الآتية : إذا كانت المخالفة المثبتة تعرض مرتكبها إما لعقوبة أخرى غير العقوبة المالية، وإما لتعويض عن الضرر المسبب للأشخاص أو الممتلكات. في حالة المخالفات المتزامنة والتي لا يترتب على إحداها على الأقل تطبيق الإجراء المتعلق بالغرامة الجزافية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_119_permission_0_4ef87bbb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_119> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_119_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_119_20010819_OpEnact_2fc2420a8a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 119" ;
    dzdoc:position 107 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_1_subsec_2> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "يتحمل سائق المركبة المسؤولية الجزائية والمدنية عن المخالفات التي يرتكبها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_12_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_12_20010819_OpEnact_9e7264e013> ;
