<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_35> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على الراجلين عند عبور وسط الطريق التأكد مسبقا من عدم وجود أي خطر داهم، والأخذ في الحسبان أيضا المسافة التي تفصلهم عن المركبة السائرة وسرعتها، واستعمال الممرات المخصصة لهم والمسماة \" ممر الراجلين \"، وذلك كلما وجدت هذه الممرات على مسافة أقل من 30 مترا . يجب عبور وسط الطريق على خط مستقيم، أي تعامديا مع محور وسط الطريق . يمنع على الراجلين التوقف في وسط الطريق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_35_20010819_OpEnact_ffa5a7cd17> ;
    dzdoc:replacementText "يجب على الراجلين عند عبور وسط الطريق التأكد مسبقا من عدم وجود أي خطر داهم، والأخذ في الحسبان أيضا المسافة التي تفصلهم عن المركبة السائرة وسرعتها، واستعمال الممرات المخصصة لهم والمسماة \" ممر الراجلين \"، وذلك كلما وجدت هذه الممرات على مسافة أقل من 30 مترا . يجب عبور وسط الطريق على خط مستقيم، أي تعامديا مع محور وسط الطريق . يمنع على الراجلين التوقف في وسط الطريق."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_35> ;
