<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_94> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_4> ;
    dzdoc:eId "art_94" ;
    dzdoc:fullText "يعاقب بغرامة من 800 إلى 1.500 دج، كل شخص يخالف أحكام المادة 52 أعلاه و الآجال المنصوص عليها في الأحكام التنظيمية المتعلقة ببيع المركبات أو إتلافها واسترجاع بطاقة التسجيل، وتغيير مقر إقامة أي صاحب سيارة أو مقطورة أو نصف مقطورة يزيد وزنها الإجمالي بالحمولة على 500 كلغ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_94> ;
