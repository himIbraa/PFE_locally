<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_113_condition_0_e57d703a_ref_979fb3751601> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "288"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-156#art_288"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-156#art_288"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-156#art_288" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:sourceEId "art_113" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "عندما يرتكب السائق مخالفة أدت إلى الجرح أو القتل الخطأ أثناء سياقة مركبة ذات محرك كان أحد الراجلين ضحية ذلك وعندما يكون هذا السائق قد حكم عليه بعقوبة تطبيقا للمادتين 66 و69 من هذا القانون والمادتين 288 و289 من قانون العقوبات"@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:targetEId "art_288" .

