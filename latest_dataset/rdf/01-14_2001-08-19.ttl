<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_117> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_7> ;
    dzdoc:eId "art_117" ;
    dzdoc:fullText "عندما يتعذر على مرتكب مخالفة خاصة بسلامة المرور في الطرق إثبات محل إقامته أو عمله في التراب الوطني ، يمكن فيما عدا حالة دفع غرامة جزافية ، توقيف المركبة موضوع المخالفة إلى وكيل أن يودع لدى أحد محاسبي الخزينة كفالة يحدد وكيل الجمهورية مقدارها. وفي حالة عدم تقديم مرتكب المخالفة أيا من هذين الضمانين ، يمكن أن توضع المركبة في المحشر وأن تكون النفقات الناجمة عن ذلك على عاتقه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_117_permission_0_8edd5976>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_117_permission_1_782513c7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_117> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_117_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_117_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_117_20010819_OpEnact_ca3df3bed3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 117" ;
    dzdoc:position 105 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_117_condition_0_3b2cf63f>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_117_condition_1_679fe550> ;
    dzdoc:usesTerm dzterm:fine,
        dzterm:prosecutor .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_84> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_3> ;
    dzdoc:eId "art_84" ;
    dzdoc:fullText "يعاقب بالحبس من شهرين (2) إلى سنتين (2) وبغرامة من 50.000 إلى 150.000 دج، أو بإحدى هاتين العقوبتين فقط ، كل شخص يضع للسير مركبة ذات محرك أو مقطورة مزودة بلوحة تسجيل أو علامة لاتتطابق مع نوع هذهالمركبة أو الصفة الخاصة بالمنتفع بها . في حالة العود ، تضاعف العقوبة . فضلا عن ذلك، يمكن المحكمة الحكم بمصادرة العتاد المستعمل لصنع لوحات التسجيل والمركبة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_84_permission_0_b03fb6bb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_84> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_84_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_84_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_84_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_84_20010819_OpEnact_c4b1d43719> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_84_obligation_0_2fcbcb99>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_84_obligation_1_d6f23a21>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_84_obligation_2_1da04ea2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 84" ;
    dzdoc:position 74 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_84_condition_0_14cea8d8>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_84_condition_1_f1e41b6f> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_85> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_3> ;
    dzdoc:eId "art_85" ;
    dzdoc:fullText "يعاقب بغرامة من 1.500 إلى 5.000 دج ، كل سائق يخالف الأحكام المتعلقة بما يأتي : 1 وزن المركبات وطبيعة الأطر المطاطية للمركبات ذات محرك وشكلها وحالتها وشروط استعمالها. 2 - مكابح المركبات المخصصة للنقل الجماعي للأشخاص والبضائع التي يزيد وزن حمولتها المرخص به عن 3500 كلغ. 3 - معيار المركبات، وتركيب أجهزة الإنارة والإشارة للمركبات. 4 - الحمولة القصوى لكل محور. ينبغي الأمر بتوقيف المركبة طبقا لأحكام المادة 121 من هذا القانون. في حالة العود ، تضاعف العقوبة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_85> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_85_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_85_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_85_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_85_20010819_OpEnact_e24a6887bf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_85_obligation_0_9e812f38>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_85_obligation_1_cd127900>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_85_obligation_2_d6f23a21> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 85" ;
    dzdoc:position 75 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_121> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_121> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_85_condition_0_f1e41b6f> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_4> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "خلافا لأحكام المادة 12 أعلاه، يتحمل صاحب بطاقة تسجيل المركبة المسؤولية المدنية عن مخالفة التنظيم المتعلق بوقوف المركبات ، والتي يترتب عليها وحدها دفع غرامة ، إلا إذا أثبت وجود قوة قاهرة أو قدم معلومات تمكن من اكتشاف المرتكب الحقيقي للمخالفة . في حالة تأجير المركبة للغير ، تقع المسؤولية ضمن الشروط نفسها على عاتق المستأجر . وعندما تكون بطاقة تسجيل المركبة باسم شخص معنوي ، تقع المسؤولية المدنية المنصوص عليها في الفقرة الأولى أعلاه، ضمن الشروط نفسها على عاتق الممثل الشرعي لهذا الشخص المعنوي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_96_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_96_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_96_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_96_20010819_OpEnact_9d5d3cb211> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_96_obligation_0_a7f0782a>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_96_obligation_1_6e10010c>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_96_obligation_2_bf32092e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 96" ;
    dzdoc:position 86 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_12> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_12> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_96_condition_0_c470281d>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_96_condition_1_83233427>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_96_condition_2_0fe398d2> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_108> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_5> ;
    dzdoc:eId "art_108" ;
    dzdoc:fullText "يجوز للوالي عندما يحال عليه محضر إثبات إحدى المخالفات المبينة في المادة 111 أدناه، إذا رأى من غير الواجب حفظ الملف ، أن يصدر بصفة مؤقتة وبعد أخذ رأي لجنة خاصة قرار تعليق رخصة السياقة أو منع اجتياز امتحانها عندما يكون السائق المعني غير متحصل عليها . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_108_permission_0_87139950> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_108_right_0_6c0b63f9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_108> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_108_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_108_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_108_20010819_OpEnact_8235330037> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_108_obligation_0_7f623661> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 108" ;
    dzdoc:position 96 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_111> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_111> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_108_condition_0_e2ccdc79> ;
    dzdoc:usesTerm dzterm:driving_license .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_124> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_7> ;
    dzdoc:eId "art_124" ;
    dzdoc:fullText "لا يجوز أن تسحب المركبات التي لا تسمح حالتها بالسير حسب الشروط العادية للأمن من المحشر ، إلا من قبل مصلحين يكلفهم أصحاب المركبات بالقيام بالتصليحات الضرورية. إذا حصل اختلاف على حالة المركبة ، يتم تعيين خبير حسب الشروط التي يحددها التنظيم. في حالة إثباته أن المركبة ليست في حالة تمكنها من السير حسب الشروط العادية للأمن يحدد التصليحات الواجب القيام بها قبل تسليمها لصاحبها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_124_permission_0_e0f9b3fd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_124> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_124_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_124_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_124_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_124_20010819_OpEnact_937e145109> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_124_obligation_0_e0f9b3fd> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_124_prohibition_0_e0f9b3fd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "124" ;
    dzdoc:position 112 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_124_condition_0_3c022270>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_124_condition_1_bfc1a310> ;
    dzdoc:usesTerm dzterm:impound .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_2_subsec_2> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "خارج المجمعات السكانية، يجب على الراجلين في اتجاه سيرهم اتخاذ الجهة اليسرى لوسط الطريق إذا كان ذلك لا يضر بأمنهم . يجب أن يشار لكل سرب أو فرقة أو جماعة من الراجلين تسير كقافلة على وسط الطريق، عند حلول الظلام وأثناء النهار إذا اقتضت الظروف ذلك، خصوصا حين انتشار الضباب ، بواسطة وضع إشارة ضوئية بيضاء في الأمام وإشارة ضوئية حمراء في الخلف . يجب أن يحمل هاتين الإشارتين الضوئيتين عضوان من هذه القافلة يسير كل منهما على بعد 10 أمتار من مقدمتها و 10 أمتار من مؤخرتها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_37_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_37_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_37_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_37_20010819_OpEnact_02cce7f396> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_37_obligation_0_3a88f5af>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_37_obligation_1_23603049>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_37_obligation_2_d23456ba> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "37" ;
    dzdoc:position 29 ;
    dzdoc:usesTerm dzterm:pedestrians .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_1_subsec_2> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "يجب على كل سائق مركبة أن يكون حاملا ل رخصة سياقة موافقة للمركبة التي يقودها . بالإضافة إلى رخصة السياقة ، تحدث شهادة مهنية للنقل العمومي للمسافرين والبضائع . تعد بمثابة رخصة سياقة الشهادات المنصوص عليها في التنظيمات الخاصة بقيادة المركبات ذات محرك، عندما لا تكون رخصة السياقة مطلوبة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_8_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_8_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_8_para_2>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_8_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_8_20010819_OpEnact_7641ab9892> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_8_obligation_0_ea423ae2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 8" ;
    dzdoc:position 7 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_8> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_8> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_8_condition_0_b64d45e7> ;
    dzdoc:usesTerm dzterm:driving_license,
        dzterm:professional_certificate .

dzterm:driving_license a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "رخصة السياقة"@ar,
        "رخصة سياقة"@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_35> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_2_subsec_2> ;
    dzdoc:eId "art_35" ;
    dzdoc:fullText "يجب على الراجلين عند عبور وسط الطريق التأكد مسبقا من عدم وجود أي خطر داهم، والأخذ في الحسبان أيضا المسافة التي تفصلهم عن المركبة السائرة وسرعتها، واستعمال الممرات المخصصة لهم والمسماة \" ممر الراجلين \"، وذلك كلما وجدت هذه الممرات على مسافة أقل من 30 مترا . يجب عبور وسط الطريق على خط مستقيم، أي تعامديا مع محور وسط الطريق . يمنع على الراجلين التوقف في وسط الطريق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_35> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_35_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_35_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_35_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_35_20010819_OpEnact_ffa5a7cd17> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_35_obligation_0_8d43520f>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_35_obligation_1_20fbea43> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_35_prohibition_0_4fb745bb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "35" ;
    dzdoc:position 27 ;
    dzdoc:usesTerm dzterm:pedestrian_crossing,
        dzterm:pedestrians .

