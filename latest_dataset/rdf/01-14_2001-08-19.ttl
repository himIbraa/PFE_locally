<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_2_subsec_2> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "عندما يستحيل عبور وسط الطريق من طرف الراجلين أو يشكل خطرا، بسبب الأشغال وتهيئة الطريق ، يجب اتخاذ التدابير اللازمة لتمكين الراجلين من ممرات بديلة ملائمة ومؤمنة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_36_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_36_20010819_OpEnact_c61fec901e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_36_obligation_0_66cdc8ee> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "36" ;
    dzdoc:position 28 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_36_condition_0_78911767> ;
    dzdoc:usesTerm dzterm:pedestrians .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
