    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بغرامة مالية من 5.000 إلى 10.000 دج كل شخص تجاوز ب :"@ar ;
    dznorm:sourceArticle "art_74" .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_74_obligation_1_d6f23a21> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_74> ;
    dznorm:position 1 ;
    dznorm:provisionText "تضاعف العقوبة"@ar ;
    dznorm:sourceArticle "art_74" .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_74_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_74> ;
    dzdoc:position 0 ;
    dzdoc:text "دون المساس بالعقوبات المتعلقة بسحب رخصة السياقة وعندما تعاين المخالفة بتجهيزات ملائمة معتمدة من السلطات المختصة يعاقب بغرامة مالية من 5.000 إلى 10.000 دج كل شخص تجاوز ب : 40 كلم/ سا السرعة القانونية المرخص بها في الطريق السريع للسيارات والطريق السريع. 30 كلم / سا السرعة القانونية المرخص بها خارج المجمع السكاني. 20 كلم / سا السرعة القانونية المرخص بها داخل المجمع السكاني."@ar .

