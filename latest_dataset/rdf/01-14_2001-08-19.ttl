<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_54> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:definesTerm dzterm:national_file ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_3> ;
    dzdoc:eId "art_54" ;
    dzdoc:fullText "تحدث بطاقية وطنية لبطاقات تسجيل المركبات تدعى \"بطاقات رمادية\" . تحدد شروط وكيفيات مسك هذه البطاقية عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_54> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_54_defocc_e53c5e3dbf39> ;
