<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_110> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن يكون تعليق رخصة السياقة أو إلغاؤها و كذا منع تسليمها، من العقوبات التكميلية التي يمكن أن تحكم بها الجهات القضائية المختصة. ويمكن الحكم بالتنفيذ المعجل لهذه العقوبات التكميلية كتدبير وقائي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_110_20010819_OpEnact_f2a2703764> ;
    dzdoc:replacementText "يمكن أن يكون تعليق رخصة السياقة أو إلغاؤها و كذا منع تسليمها، من العقوبات التكميلية التي يمكن أن تحكم بها الجهات القضائية المختصة. ويمكن الحكم بالتنفيذ المعجل لهذه العقوبات التكميلية كتدبير وقائي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_110> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
