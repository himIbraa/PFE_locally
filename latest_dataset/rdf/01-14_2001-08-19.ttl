<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_63_obligation_0_0f918464> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_63> ;
    dznorm:position 0 ;
    dznorm:provisionText "تتكفل الدولة بما يأتي"@ar ;
    dznorm:sourceArticle "art_63" .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_63_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_63> ;
    dzdoc:position 0 ;
    dzdoc:text "في إطار تطبيق المادة 4 أعلاه المتعلقة بترقية السياسة الخاصة بالوقاية في الطرق، تتكفل الدولة بما يأتي: تربية وإعلام المواطن من أجل ترقية الإنضباط في استعمال المسالك العمومية الكفيلة بضمان أمنه، التنظيم الدوري للحملات الخاصة بالوقاية والأمن في الطرق، الحراسة والمراقبة الدائمتين لحركة المرور في الطرق من طرف المصالح المؤهلة التهيئة الملائمة للمنشآت القاعدية للطرق، وضع التجهيزات الأمنية في الطرق وصيانتها بصفة دائمة، تشجيع نشاط الحركة الجمعوية السهر على تطبيق الممراقبة التقنية للمركبات."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_64_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_64> ;
    dzdoc:position 0 ;
    dzdoc:text "يحدث مركز وطني ولجان ولائية للوقاية والأمن في الطرق."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_64_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_64> ;
    dzdoc:position 1 ;
    dzdoc:text "يوضع هذا المركز تحت وصاية الوزارة المكلفة بالنقل."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_64_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_64> ;
    dzdoc:position 2 ;
    dzdoc:text "يمكن أن تنشأ هيئات تكلف بمتابعة تطبيق أحكام هذا القانون."@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_64_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_64> ;
    dzdoc:position 3 ;
    dzdoc:text "تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar .

