<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_28> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب التنبيه إلى وجود الخطوط الحديدية المحاذية للطريق أو التي تقطعه ، بواسطة وضع إشارة ملائمة ، ويقع هذا الواجب على عاتق مستغل الخط الحديدي. تحظى بأسبقية المرور الآليات والمركبات التي تسير على الخطوط الحديدية . يتعين على المستعملين الآخرين الذين يعبرون هذه الخطوط ، أن يلتزموا الحيطة والحذر وألا يشكلوا في أي حال من الأحوال عائقا يعيق مرور الآليات والمركبات التي خصصت لها هذه الخطوط ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_28_20010819_OpEnact_bc62095d70> ;
    dzdoc:replacementText "يجب التنبيه إلى وجود الخطوط الحديدية المحاذية للطريق أو التي تقطعه ، بواسطة وضع إشارة ملائمة ، ويقع هذا الواجب على عاتق مستغل الخط الحديدي. تحظى بأسبقية المرور الآليات والمركبات التي تسير على الخطوط الحديدية . يتعين على المستعملين الآخرين الذين يعبرون هذه الخطوط ، أن يلتزموا الحيطة والحذر وألا يشكلوا في أي حال من الأحوال عائقا يعيق مرور الآليات والمركبات التي خصصت لها هذه الخطوط ."@ar ;
