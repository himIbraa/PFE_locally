<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_139> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تلغى أحكام القانون رقم 87 - 09 المؤرخ في 11 جمادى الثانية عام 1407 الموافق 10 فبراير سنة 1987 والمتعلق بتنظيم حركة المرور عبر الطرق وسلامتها وأمنها . تبقى النصوص التنظيمية المتخذة لتطبيق القانون المذكور أعلاه ، سارية المفعول مالم تكن مخالفة لهذا القانون إلى غاية نشر النصوص التنظيمية المنصوص عليها في هذا القانون خلال أجل لا يتجاوز أربعة وعشرين (24) شهرا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_139_20010819_OpEnact_fbe8d6de3d> ;
    dzdoc:replacementText "تلغى أحكام القانون رقم 87 - 09 المؤرخ في 11 جمادى الثانية عام 1407 الموافق 10 فبراير سنة 1987 والمتعلق بتنظيم حركة المرور عبر الطرق وسلامتها وأمنها . تبقى النصوص التنظيمية المتخذة لتطبيق القانون المذكور أعلاه ، سارية المفعول مالم تكن مخالفة لهذا القانون إلى غاية نشر النصوص التنظيمية المنصوص عليها في هذا القانون خلال أجل لا يتجاوز أربعة وعشرين (24) شهرا ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_139> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_139> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2001-08-19"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

