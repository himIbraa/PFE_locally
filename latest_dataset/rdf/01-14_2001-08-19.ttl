<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_125> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعتبر مركبات مهجورة المركبات التي تترك في المحشر بعد انقضاء أجل ستين (60) يوما ابتداء من إشعار صاحب المركبة بوجوب سحبها. وفي حالة ما إذا كانت المركبة موضوع رهن مسجل قانونا ، يبلغ هذا الإشعار أيضا إلى الدائن الضامن. وإذا تعذر التعرف على صاحب المركبة ، يبلغ الملف إلى الجهة القضائية المختصة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_125_20010819_OpEnact_113d4062ab> ;
    dzdoc:replacementText "تعتبر مركبات مهجورة المركبات التي تترك في المحشر بعد انقضاء أجل ستين (60) يوما ابتداء من إشعار صاحب المركبة بوجوب سحبها. وفي حالة ما إذا كانت المركبة موضوع رهن مسجل قانونا ، يبلغ هذا الإشعار أيضا إلى الدائن الضامن. وإذا تعذر التعرف على صاحب المركبة ، يبلغ الملف إلى الجهة القضائية المختصة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_125> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
