    dzdoc:usesTerm dzterm:driving_license .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_121> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_7> ;
    dzdoc:eId "art_121" ;
    dzdoc:fullText "يمكن توقيف المركبات المخالفة لقواعد حركة المرور والوقوف المنصوص عليها في هذا القانون ووضعها في المحشر. تحدد حالات وضع المركبة في المحشر وتوقيفها وشروط ومدة ذلك عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_121_permission_0_46e2b986> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_121> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_121_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_121_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_121_20010819_OpEnact_8c012445b0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 121" ;
    dzdoc:position 109 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_125> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:definesTerm dzterm:abandoned_vehicles ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_7> ;
    dzdoc:eId "art_125" ;
    dzdoc:fullText "تعتبر مركبات مهجورة المركبات التي تترك في المحشر بعد انقضاء أجل ستين (60) يوما ابتداء من إشعار صاحب المركبة بوجوب سحبها. وفي حالة ما إذا كانت المركبة موضوع رهن مسجل قانونا ، يبلغ هذا الإشعار أيضا إلى الدائن الضامن. وإذا تعذر التعرف على صاحب المركبة ، يبلغ الملف إلى الجهة القضائية المختصة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_125> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_125_defocc_97bca31e863c> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_125_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_125_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_125_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_125_20010819_OpEnact_113d4062ab> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_125_obligation_0_00e03973> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "125" ;
    dzdoc:position 113 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_125_condition_0_9ddd5fb2>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_125_condition_1_fb992f90> ;
    dzdoc:usesTerm dzterm:impound .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_2_subsec_1> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "الوقوف المرخص في المسالك العمومية مجاني . غير أنه يمكن الجماعات الإقليمية أن تبادر بإجراءات تجعله مقابل ثمن . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_33_permission_0_3d605653> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_33_right_0_dee25801> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_33_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_33_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_33_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_33_20010819_OpEnact_68a4abd440> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 33" ;
    dzdoc:position 25 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_33> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_33> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_33_condition_0_ddddcd1d> .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_3> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "يعاقب بغرامة من 800 إلى 1.500 دج ، كل سائق يخالف الأحكام التنظيمية المتعلقة بمكابح المركبات في غير الحالات المحددة في المادة 85 أعلاه، و مقاسات لوحات التسجيل والتجهيزات وإشارة النقل الاستثنائي ومؤشرات السرعة وربط المقطورات ونصف المقطورات. وفي جميع الحالات، يمكن أن يؤمر بتوقيف المركبة طبقا لأحكام المادة 121 من هذا القانون. في حالة العود ، تضاعف العقوبة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_88_permission_0_4ccfde4d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_88_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_88_para_1>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_88_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_88_20010819_OpEnact_c8d5022b67> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_88_obligation_0_64ae2230>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_88_obligation_1_ce69cdbb>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_88_obligation_2_d6f23a21> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 88" ;
    dzdoc:position 78 ;
