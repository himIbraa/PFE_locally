    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "المادة 12" ;
    dzdoc:position 11 .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_2_subsec_1> ;
    dzdoc:eId "art_13" ;
    dzdoc:fullText "تنظم حركة المرور عبر الطرق قصد ضمان أفضل شروط الأمن والسيولة وفي هذا الإطار، تكلف الجماعات الإقليمية بإعداد و تنفيذ مخطط حركة المرور في المنطقة الحضرية للتحكم في تطور حركة السيارات وتقليص تأثيراتها السلبية. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_13> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_13_para_0>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_13_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_13_20010819_OpEnact_5cd5f7befc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "13" ;
    dzdoc:position 12 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_13> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_13> ;
    dzdoc:usesTerm dzterm:local_authorities .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_132> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_7> ;
    dzdoc:eId "art_132" ;
    dzdoc:fullText "يمكن مهندسي و تقنيي الأشغال العمومية ، دون المساس بـ الحق المخول لجميع الموظفين والأعوان المذكورين في المادة 130 أعلاه ، معاينة الأضرار التي تلحق بالمسالك العمومية، وإعداد محضر عن الأعمال التخريبية المرتكبة بحضورهم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_132_permission_0_58cae508> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_132_right_0_e0369b6e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_132> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_132_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_132_20010819_OpEnact_2ce2d75a52> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "132" ;
    dzdoc:position 120 ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_130> ;
