    dzdoc:text "يصدر القانون الآتي نصه:"@ar .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_130> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#sec_6_subsec_7> ;
    dzdoc:eId "art_130" ;
    dzdoc:fullText "طبقا لأحكام قانون الإجراءات الجزائية ، تتم معاينة المخالفات المنصوص عليها في هذا القانون والنصوص التنظيمية المتخذة لتطبيقه، بموجب محضر يحرر من طرف : ضباط الشرطة القضائية الضباط وذوي الرتب وأعوان الدرك الوطني محافظي الشرطة والضباط ذوي الرتب وأعوان الأمن الوطني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_130> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_130_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_130_20010819_OpEnact_7d8eeeb3a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:introducedOn "2001-08-19"^^xsd:date ;
    dzdoc:number "130" ;
    dzdoc:position 118 ;
    dzdoc:usesTerm dzterm:criminal_procedure_code .

<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_109> a dzdoc:Article ;
