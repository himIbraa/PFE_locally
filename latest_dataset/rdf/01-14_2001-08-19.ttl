        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_113_condition_0_e57d703a_ref_a5c3d4187869> ;
    dzdoc:references <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_66>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_69> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_113_condition_0_e57d703a_ref_979fb3751601>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_113_condition_0_e57d703a_ref_a5c3d4187869> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_66>,
        <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_69> ;
    dznorm:conditionText "عندما يرتكب السائق مخالفة أدت إلى الجرح أو القتل الخطأ أثناء سياقة مركبة ذات محرك كان أحد الراجلين ضحية ذلك وعندما يكون هذا السائق قد حكم عليه بعقوبة تطبيقا للمادتين 66 و69 من هذا القانون والمادتين 288 و289 من قانون العقوبات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_113> ;
    dznorm:position 0 .

