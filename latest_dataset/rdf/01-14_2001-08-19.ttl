<https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_126> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسلم المركبات المهجورة حسب الشروط المنصوص عليها في الفقرة الأولى من المادة 125 أعلاه، أو المصرح بها كذلك بموجب حكم قضائي، إلى مصلحة أملاك الدولة قصد التصرف فيها وفقا للتنظيم المعمول به. إذا لم تجد المركبات مقتنيا بعد الأجل المحدد من طرف كل والي ولاية تسلم هذه المركبات للتدمير بمبادرة من السلطة الإدارية المختصة بسلطات سلامة المرور."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#version_art_126_20010819_OpEnact_71c26b64cb> ;
    dzdoc:replacementText "تسلم المركبات المهجورة حسب الشروط المنصوص عليها في الفقرة الأولى من المادة 125 أعلاه، أو المصرح بها كذلك بموجب حكم قضائي، إلى مصلحة أملاك الدولة قصد التصرف فيها وفقا للتنظيم المعمول به. إذا لم تجد المركبات مقتنيا بعد الأجل المحدد من طرف كل والي ولاية تسلم هذه المركبات للتدمير بمبادرة من السلطة الإدارية المختصة بسلطات سلامة المرور."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19#art_126> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2001-08-19/01-14_2001-08-19> ;
