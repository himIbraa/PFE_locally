<https://legal.dz/resource/order/1975-09-26/75-58#art_548> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_2_subsec_3> ;
    dzdoc:eId "art_548" ;
    dzdoc:fullText "تنتهي العارية بموت أحد الطرفين ما لم يوجد اتفاق يقضي بغير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_548> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_548_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_548_19750926_OpEnact_41455d4537> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 548" ;
    dzdoc:position 575 ;
    dzdoc:usesTerm dzterm:loan_for_use .

<https://legal.dz/resource/order/1975-09-26/75-58#art_556> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_1> ;
    dzdoc:eId "art_556" ;
    dzdoc:fullText "يكون باطلا كل شرط يقصد به إعفاء المهندس المعماري و المقاول من الضمان أو الحد منه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_556> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_556_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_556_19750926_OpEnact_9c47056721> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "556" ;
    dzdoc:position 583 ;
    dzdoc:usesTerm dzterm:architect,
        dzterm:contractor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_557> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_1> ;
    dzdoc:eId "art_557" ;
    dzdoc:fullText "تتقادم دعاوى الضمان المذكورة أعلاه بانقضاء ثلاث (3) سنوات من وقت حصول التهدم أو اكتشاف العيب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_557> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_557_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_557_19750926_OpEnact_a4cbbc5e0c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "557" ;
    dzdoc:position 584 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_585> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_2> ;
    dzdoc:eId "art_585" ;
    dzdoc:fullText "تطبق المواد من 74 إلى 77 الخاصة بالنيابة في علاقات الموكل و الوكيل بالغير الذي يتعامل مع الوكيل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_585> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_585_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_585_19750926_OpEnact_8d35c4844c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 585" ;
    dzdoc:position 622 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_74>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_77> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_74>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_77> ;
    dzdoc:usesTerm dzterm:agent,
        dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_586> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_3> ;
    dzdoc:eId "art_586" ;
    dzdoc:fullText "تنتهي الوكالة بإتمام العمل الموكل فيه أو بانتهاء الأجل المعين للوكالة وتنتهي أيضا بموت الموكل أو الوكيل . كما تنتهي الوكالة أيضا بعزل الوكيل أو بعدول الموكل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_586> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_586_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_586_19750926_OpEnact_791e107645> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "586" ;
    dzdoc:position 623 ;
    dzdoc:usesTerm dzterm:agency,
        dzterm:agent,
        dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "يتم العقد بمجرد أن يتبادل الطرفان التعبير عن إرادتهما المتطابقتين دون الاخلال بالنصوص القانونية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_59_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_59_19750926_OpEnact_454d8597ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 59" ;
    dzdoc:position 65 ;
    dzdoc:usesTerm dzterm:contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_606> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_4> ;
    dzdoc:eId "art_606" ;
    dzdoc:fullText "يحدد الاتفاق أو الحكم القاضي بالحراسة ما على الحارس من التزامات وما له من حقوق وسلطة، والا فتطبق أحكام الوديعة والوكالة بالقدر الذي لا تتعارض فيه مع الأحكام الآتية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_606> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_606_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_606_19750926_OpEnact_de04fd192d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "606" ;
    dzdoc:position 643 ;
    dzdoc:usesTerm dzterm:حارس .

<https://legal.dz/resource/order/1975-09-26/75-58#art_61> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_61" ;
    dzdoc:fullText "ينتج التعبير عن الارادة أثره في الوقت الذي يتصل فيه، بعلم من وجه إليه، ويعتبر وصول التعبير قرينة على العلم به ما لم يقم الدليل على عكس ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_61> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_61_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_61_19750926_OpEnact_1793a2d62e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 61" ;
    dzdoc:position 67 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_620> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_10_sec_3_subsec_1> ;
    dzdoc:eId "art_620" ;
    dzdoc:fullText "تنظم القوانين الخاصة عقد التأمين بالاضافة إلى الأحكام التي يتضمنها هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_620> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_620_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_620_19750926_OpEnact_29ab8d99bc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "620" ;
    dzdoc:position 657 ;
    dzdoc:usesTerm dzterm:insurance_contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_621> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_10_sec_3_subsec_1> ;
    dzdoc:eId "art_621" ;
    dzdoc:fullText "تكون محلا للتأمين كل مصلحة اقتصادية مشروعة تعود على الشخص من دون وقوع خطر"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_621> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_621_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_621_19750926_OpEnact_11f32e9340> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "621" ;
    dzdoc:position 658 ;
    dzdoc:usesTerm dzterm:insurance .

<https://legal.dz/resource/order/1975-09-26/75-58#art_625> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_10_sec_3_subsec_1> ;
    dzdoc:eId "art_625" ;
    dzdoc:fullText "يكون باطلا كل اتفاق يخالف النصوص الواردة في هذا الفصل الا أن يكون ذلك لمصلحة المؤمن له أو لمصلحة المستفيد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_625> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_625_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_625_19750926_OpEnact_f0c0865f18> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "625" ;
    dzdoc:position 662 ;
    dzdoc:usesTerm dzterm:beneficiary,
        dzterm:insured .

