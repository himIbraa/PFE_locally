<https://legal.dz/resource/order/1975-09-26/75-58#version_art_252> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تكون الحوالة نافذة في حق الدائن الا إذا أقرها. وإذا قام المحال عليه أو المدين الأصلي باعلان الحوالة إلى الدائن وعين له أجلا معقولا ليقر الحوالة ثم انقضى الأجل دون صدور الاقرار ، اعتبر سكوت الدائن رفضا للحوالة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_252_19750926_OpEnact_2746476525> ;
    dzdoc:replacementText "لا تكون الحوالة نافذة في حق الدائن الا إذا أقرها. وإذا قام المحال عليه أو المدين الأصلي باعلان الحوالة إلى الدائن وعين له أجلا معقولا ليقر الحوالة ثم انقضى الأجل دون صدور الاقرار ، اعتبر سكوت الدائن رفضا للحوالة."@ar ;
