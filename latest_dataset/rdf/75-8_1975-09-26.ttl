<https://legal.dz/resource/order/1975-09-26/75-58#version_art_507_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبقى الإيجارات المبرمة في ظل التشريع السابق خاضعة له مدة عشر (10) سنوات، ابتداء من تاريخ نشر هذا القانون في الجريدة الرسمية. غير أن الأشخاص الطبيعيين البالغين ستين (60) سنة كاملة عند نشر هذا القانون والذين لهم الحق في البقاء في الأمكنة المعدة للسكن وفقا للتشريع السابق، يبقون يتمتعون بهذا الحق إلى حين وفاتهم. لا يستفيد من هذا الحق الورثة ولا الأشخاص الذين يعيشون معهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_507_bis_19750926_OpEnact_1bfea6d641> ;
    dzdoc:replacementText "تبقى الإيجارات المبرمة في ظل التشريع السابق خاضعة له مدة عشر (10) سنوات، ابتداء من تاريخ نشر هذا القانون في الجريدة الرسمية. غير أن الأشخاص الطبيعيين البالغين ستين (60) سنة كاملة عند نشر هذا القانون والذين لهم الحق في البقاء في الأمكنة المعدة للسكن وفقا للتشريع السابق، يبقون يتمتعون بهذا الحق إلى حين وفاتهم. لا يستفيد من هذا الحق الورثة ولا الأشخاص الذين يعيشون معهم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
