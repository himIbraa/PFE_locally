<https://legal.dz/resource/order/1975-09-26/75-58#art_674_condition_0_d89cd2db> a dznorm:Condition ;
    dznorm:conditionText "بشرط أن لا يستعمل استعمالا تحرمه القوانين والأنظمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_674> ;
