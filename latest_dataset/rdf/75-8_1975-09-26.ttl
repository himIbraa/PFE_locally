<https://legal.dz/resource/order/1975-09-26/75-58#version_art_649> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "من كفل التزام ناقص الأهلية وكانت الكفالة بسبب نقص الأهلية ، كان ملزما بتنفيذ الالتزام إذا لم ينفذه المدين المكفول ، باستثناء الحالة المنصوص عليها في الفقرة الثانية من المادة 654 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
