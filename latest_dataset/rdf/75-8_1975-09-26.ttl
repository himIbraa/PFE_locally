        <https://legal.dz/resource/order/1975-09-26/75-58#art_785> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_784>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_785> ;
