<https://legal.dz/resource/order/1975-09-26/75-58#version_art_923> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يختر الحائز أن يقضي الديون المقيدة أو يطهر العقار من الرهن أو يتخلى عن هذا العقار ، فلا يجوز للدائن المرتهن أن يتخذ في مواجهته نزع الملكية وفقا لأحكام قانون الاجراءات المدنية إلا بعد انذاره بدفع الدين المستحق أو تخلية العقار ، ويكون الانذار بعد التنبيه على المدين بنزع الملكية أو مع هذا التنبيه في وقت واحد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_923_19750926_OpEnact_13ff89f1f4> ;
    dzdoc:replacementText "إذا لم يختر الحائز أن يقضي الديون المقيدة أو يطهر العقار من الرهن أو يتخلى عن هذا العقار ، فلا يجوز للدائن المرتهن أن يتخذ في مواجهته نزع الملكية وفقا لأحكام قانون الاجراءات المدنية إلا بعد انذاره بدفع الدين المستحق أو تخلية العقار ، ويكون الانذار بعد التنبيه على المدين بنزع الملكية أو مع هذا التنبيه في وقت واحد."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_923> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
