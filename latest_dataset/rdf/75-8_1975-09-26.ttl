<https://legal.dz/resource/order/1975-09-26/75-58#version_art_579> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تعدد الوكلاء كانوا مسؤولين بالتضامن متى كانت الوكالة غير قابلة للانقسام أو كان الضرر الذي أصاب الموكل نتيجة خطا مشترك على أن الوكلاء ولو كانوا متضامنين لا يسألون عما فعله أحدهم متجاوزا حدود الوكالة أو متعسفا في تنفيذها. وإذا عين الوكلاء في عقد واحد دون أن يرخص في انفرادهم في العمل كان عليهم أن يعملوا مجتمعين الا إذا كان العمل مما لا يحتاج فيه إلى تبادل الرأي كقبض الدين أو وفائه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_579_19750926_OpEnact_099f0198a5> ;
    dzdoc:replacementText "إذا تعدد الوكلاء كانوا مسؤولين بالتضامن متى كانت الوكالة غير قابلة للانقسام أو كان الضرر الذي أصاب الموكل نتيجة خطا مشترك على أن الوكلاء ولو كانوا متضامنين لا يسألون عما فعله أحدهم متجاوزا حدود الوكالة أو متعسفا في تنفيذها. وإذا عين الوكلاء في عقد واحد دون أن يرخص في انفرادهم في العمل كان عليهم أن يعملوا مجتمعين الا إذا كان العمل مما لا يحتاج فيه إلى تبادل الرأي كقبض الدين أو وفائه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_579> ;
