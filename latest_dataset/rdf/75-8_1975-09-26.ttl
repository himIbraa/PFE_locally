<https://legal.dz/resource/order/1975-09-26/75-58#version_art_893> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا ينفصل الرهن عن الدين المضمون، بل يكون تابعا له في صحته وفي انقضائه ، ما لم ينص القانون على غير ذلك . وإذا كان الراهن غير المدين كان له إلى جانب تمسكه بأوجه الدفع الخاصة به أن يتمسك بما للمدين التمسك به من أوجه الدفع المتعلقة بالدين ، ويبقى له هذا الحق ولو تنازل عنه المدين . 1 - بالنسبة إلى الراهن"@ar ;
