<https://legal.dz/resource/order/1975-09-26/75-58#art_304_condition_1_92e307ba> a dznorm:Condition ;
    dznorm:conditionText "وإذا زال السبب الذي أدى لاتحاد الذمة وكان لزواله أثر رجعي"@ar ;
