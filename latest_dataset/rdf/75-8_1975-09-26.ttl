<https://legal.dz/resource/order/1975-09-26/75-58#version_art_123_bis_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "( جديدة) من وعد الجمهور بجائزة يعطيها عن عمل معين يلزم بإعطائها لمن قام بالعمل ، ولو قام به دون نظر إلى الوعد بالجائزة أو دون علم بها. وإذا لم يعين الواعد أجلا لإنجاز العمل جاز له الرجوع في وعده بإعلان الجمهور، على ألا يؤثر ذلك في حق من أتم العمل قبل الرجوع في الوعد . يمارس حق المطالبة بالجائزة تحت طائلة السقوط في أجل ستة (6) أشهر من تاريخ إعلان العدول للجمهور ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_123_bis_1_19750926_OpEnact_2478d2837f> ;
    dzdoc:replacementText "( جديدة) من وعد الجمهور بجائزة يعطيها عن عمل معين يلزم بإعطائها لمن قام بالعمل ، ولو قام به دون نظر إلى الوعد بالجائزة أو دون علم بها. وإذا لم يعين الواعد أجلا لإنجاز العمل جاز له الرجوع في وعده بإعلان الجمهور، على ألا يؤثر ذلك في حق من أتم العمل قبل الرجوع في الوعد . يمارس حق المطالبة بالجائزة تحت طائلة السقوط في أجل ستة (6) أشهر من تاريخ إعلان العدول للجمهور ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
