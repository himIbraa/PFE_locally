<https://legal.dz/resource/order/1975-09-26/75-58#art_454_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_454> ;
    dzdoc:position 0 ;
    dzdoc:text "القرض بين الافراد يكون دائما بدون أجر ويقع باطلا كل نص يخالف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_455_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_455> ;
    dzdoc:position 0 ;
