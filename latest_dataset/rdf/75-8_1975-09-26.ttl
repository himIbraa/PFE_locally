<https://legal.dz/resource/order/1975-09-26/75-58#version_art_896> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الإيجار الصادر من الراهن لا ينفذ في حق الدائن المرتهن إلا إذا كان ثابت التاريخ قبل تسجيل تنبيه نزع الملكية ، أما إذا لم يكن الإيجار ثابت التاريخ على هذا الوجه، أو كان قد عقد بعد تسجيل التنبيه ولم تعجل فيه الأجرة ، فلا يكون نافذا إلا إذا أمكن اعتباره داخلا في أعمال الادارة الحسنة . وإذا كان الإيجار السابق على تسجيل التنبيه تزيد مدته على تسع (9) سنوات ، فلا يكون نافذا في حق الدائن المرتهن الا لمدة تسع (9) سنوات، ما لم يكن قد سجل قبل قيد الرهن ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_896_19750926_OpEnact_fbb0b85757> ;
    dzdoc:replacementText "الإيجار الصادر من الراهن لا ينفذ في حق الدائن المرتهن إلا إذا كان ثابت التاريخ قبل تسجيل تنبيه نزع الملكية ، أما إذا لم يكن الإيجار ثابت التاريخ على هذا الوجه، أو كان قد عقد بعد تسجيل التنبيه ولم تعجل فيه الأجرة ، فلا يكون نافذا إلا إذا أمكن اعتباره داخلا في أعمال الادارة الحسنة . وإذا كان الإيجار السابق على تسجيل التنبيه تزيد مدته على تسع (9) سنوات ، فلا يكون نافذا في حق الدائن المرتهن الا لمدة تسع (9) سنوات، ما لم يكن قد سجل قبل قيد الرهن ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_896> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
