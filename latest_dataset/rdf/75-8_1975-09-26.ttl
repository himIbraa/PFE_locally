<https://legal.dz/resource/order/1975-09-26/75-58#version_art_711> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تشترك أية مسافة لفتح المناور ، التي تقام من ارتفاع مترين من أرض الغرفة التي يراد إنارتها . ولا يقصد بها الا مرور الهواء ونفاذ النور، دون أن يمكن الاطلاع منها على العقار المجاور ."@ar ;
