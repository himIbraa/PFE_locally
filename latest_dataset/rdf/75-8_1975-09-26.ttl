<https://legal.dz/resource/order/1975-09-26/75-58#version_art_852> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينتهي حق الانتفاع بانقضاء الأجل المعين، فإن لم يعين أجل عد مقرر ا لحياة المنتفع، وهو ينتهي على أي حال بموت المنتفع حتى قبل انقضاء الأجل المعين، وإذا كانت الأرض المنتفع بها مشغولة عند انقضاء الأجل أو عند موت المنتفع بزرع قائم أبقيت للمنتفع أو لورثته إلى حين إدراك الزرع بشرط أن يدفعوا أجرة إيجار الأرض عن هذه الفترة من الزمن ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_852_19750926_OpEnact_b81ae4622f> ;
    dzdoc:replacementText "ينتهي حق الانتفاع بانقضاء الأجل المعين، فإن لم يعين أجل عد مقرر ا لحياة المنتفع، وهو ينتهي على أي حال بموت المنتفع حتى قبل انقضاء الأجل المعين، وإذا كانت الأرض المنتفع بها مشغولة عند انقضاء الأجل أو عند موت المنتفع بزرع قائم أبقيت للمنتفع أو لورثته إلى حين إدراك الزرع بشرط أن يدفعوا أجرة إيجار الأرض عن هذه الفترة من الزمن ."@ar ;
