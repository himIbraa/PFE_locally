<https://legal.dz/resource/order/1975-09-26/75-58#version_art_874> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون نفقة المنشآت اللازمة لاستعمال حق الارتفاق والمحافظة عليه على مالك العقار المرتفق ، ما لم يشترط خلاف ذلك. وإذا كان مالك العقار المرتفق به هو المكلف بأن يقوم بتلك المنشآت على نفقته جاز له دائما أن يتخلص من هذا التكليف بالتخلي عن العقار المرتفق به كله أو بعضه لمالك العقار المرتفق . وإذا كانت المنشآت نافعة أيضا لمالك العقار المرتفق به كانت نفقة الصيانة على الطرفين بنسبة ما يعود على كل منهما من الفائدة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_874_19750926_OpEnact_4164d3af2c> ;
    dzdoc:replacementText "تكون نفقة المنشآت اللازمة لاستعمال حق الارتفاق والمحافظة عليه على مالك العقار المرتفق ، ما لم يشترط خلاف ذلك. وإذا كان مالك العقار المرتفق به هو المكلف بأن يقوم بتلك المنشآت على نفقته جاز له دائما أن يتخلص من هذا التكليف بالتخلي عن العقار المرتفق به كله أو بعضه لمالك العقار المرتفق . وإذا كانت المنشآت نافعة أيضا لمالك العقار المرتفق به كانت نفقة الصيانة على الطرفين بنسبة ما يعود على كل منهما من الفائدة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_874> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
