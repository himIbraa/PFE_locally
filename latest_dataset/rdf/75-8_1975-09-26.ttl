<https://legal.dz/resource/order/1975-09-26/75-58#art_299_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_299> ;
    dzdoc:position 0 ;
    dzdoc:text "تقع المقاصة مهما اختلفت مصادر الديون فيما عدا الحالات التالية : إذا كان أحد الدينين شيئا نزع دون حق من يد مالكه وكان مطلوبا رده، إذا كان أحد الدينين شيئا مودعا أو معارا للاستعمال وكان مطلوبا رده، إذا كان أحد الدينين حقا غير قابل للحجز."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_29_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_29> ;
    dzdoc:position 0 ;
    dzdoc:text "يسري على اكتساب الألقاب وتبديلها القانون المتعلق بالحالة المدنية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_2_obligation_0_e1cf5383> a dznorm:Obligation ;
