<https://legal.dz/resource/order/1975-09-26/75-58#version_art_402> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للقضاة، ولا للمدافعين القضائيين، ولا للمحامين ولا للموثقين ولا لكتاب الضبط، أن يشتروا بانفسهم مباشرة ولا بواسطة اسم مستعار الحق المتنازع فيه كله أو بعضه إذا كان النظر في النزاع يدخل في اختصاص المحكمة التي يباشرون أعمالهم في دائرتها والا كان البيع باطلا."@ar ;
