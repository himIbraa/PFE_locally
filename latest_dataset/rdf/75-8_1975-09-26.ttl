<https://legal.dz/resource/order/1975-09-26/75-58#art_584_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_584> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا وكل أشخاص متعددون وكيلا واحدا في عمل مشترك كان جميع الموكلين متضامنين تجاه الوكيل في تنفيذ الوكالة ما لم يتفق على غير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_585_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_585> ;
    dzdoc:position 0 ;
    dzdoc:text "تطبق المواد من 74 إلى 77 الخاصة بالنيابة في علاقات الموكل والوكيل بالغير الذي يتعامل مع الوكيل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_586_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_586> ;
    dzdoc:position 0 ;
    dzdoc:text "تنتهي الوكالة بإتمام العمل الموكل فيه أو بانتهاء الأجل المعين للوكالة وتنتهي أيضا بموت الموكل أو الوكيل. كما تنتهي الوكالة أيضا بعزل الوكيل أو بعدول الموكل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_587_condition_0_b3d2442b> a dznorm:Condition ;
    dznorm:conditionText "فإذا كانت الوكالة بأجر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_587> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_587_obligation_0_4545a850> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_587> ;
    dznorm:position 0 ;
    dznorm:provisionText "الموكل يكون ملزما بتعويض الوكيل عن الضرر الذي لحقه من جراء عزله في وقت غير مناسب بغير عذر مقبول"@ar ;
    dznorm:sourceArticle "art_587" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_587_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_587> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز للموكل في أي وقت أن ينهي الوكالة أو يقيدها ولو وجد اتفاق يخالف ذلك فإذا كانت الوكالة بأجر فإن الموكل يكون ملزما بتعويض الوكيل عن الضرر الذي لحقه من جراء عزله في وقت غير مناسب بغير عذر مقبول."@ar .

