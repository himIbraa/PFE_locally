<https://legal.dz/resource/order/1975-09-26/75-58#version_art_250> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا حجز ما تحت يد المحال عليه قبل نفاذ الحوالة في حق الغير كانت الحوالة بالنسبة إلى الحاجز بمثابة حجز آخر. وفي هذه الحالة، إذا وقع حجز آخر بعد أن أصبحت الحوالة نافذة في حق الغير ، فإن الدين يقسم بين الحاجز المتقدم والمحال له والحاجز المتأخر قسمة غرماء، على أن يؤخذ من حصة الحاجز المتأخر المبلغ الضروري لتكملة قيمة الحوالة لصالح المحال له."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_250_19750926_OpEnact_e89a6b4c52> ;
    dzdoc:replacementText "إذا حجز ما تحت يد المحال عليه قبل نفاذ الحوالة في حق الغير كانت الحوالة بالنسبة إلى الحاجز بمثابة حجز آخر. وفي هذه الحالة، إذا وقع حجز آخر بعد أن أصبحت الحوالة نافذة في حق الغير ، فإن الدين يقسم بين الحاجز المتقدم والمحال له والحاجز المتأخر قسمة غرماء، على أن يؤخذ من حصة الحاجز المتأخر المبلغ الضروري لتكملة قيمة الحوالة لصالح المحال له."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_250> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_250> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

