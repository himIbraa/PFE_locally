<https://legal.dz/resource/order/1975-09-26/75-58#version_art_12> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسري قانون الدولة التي ينتمي إليها الزوج وقت انعقاد الزواج على الآثار الشخصية والمالية التي يرتبها عقد الزواج. ويسري على انحلال الزواج والانفصال الجسماني القانون الوطني الذي ينتمي إليه الزوج وقت رفع الدعوى."@ar ;
