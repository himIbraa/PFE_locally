<https://legal.dz/resource/order/1975-09-26/75-58#version_art_968> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على الدائن المرتهن أن يقوم بصيانة العقار وبالنفقات اللازمة لحفظه، وأن يدفع ما يستحق سنويا على العقار من ضرائب وتكاليف ، على أن يستنزل من الثمار التي يحصلها قيمة ما أنفق أو يستوفي هذه القيمة من ثمن العقار في المرتبة التي يخولها له القانون. ويجوز للدائن أن يتحلل من هذه الالتزامات إذا هو تخلى عن حق الرهن ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_968_19750926_OpEnact_6ad8656525> ;
    dzdoc:replacementText "يجب على الدائن المرتهن أن يقوم بصيانة العقار وبالنفقات اللازمة لحفظه، وأن يدفع ما يستحق سنويا على العقار من ضرائب وتكاليف ، على أن يستنزل من الثمار التي يحصلها قيمة ما أنفق أو يستوفي هذه القيمة من ثمن العقار في المرتبة التي يخولها له القانون. ويجوز للدائن أن يتحلل من هذه الالتزامات إذا هو تخلى عن حق الرهن ."@ar ;
