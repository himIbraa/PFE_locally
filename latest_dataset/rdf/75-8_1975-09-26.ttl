    dzdoc:position 2 ;
    dzdoc:text "أما إذا كان الباقي من المدة التي نصت عليها الأحكام القديمة أقصر من المدة التي تقررها الأحكام الجديدة فإن التقادم يتم بانقضاء هذا الباقي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_7_para_3> a dzdoc:Paragraph ;
