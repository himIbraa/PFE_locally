<https://legal.dz/resource/order/1975-09-26/75-58#version_art_496> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المستأجر مسؤول عن حريق العين المؤجرة الا إذا اثبت أن الحريق نشأ عن سبب ليس من فعله . فإذا تعدد المستأجرون لعقار واحد كان كل واحد منهم مسؤول عن الحريق بالنسبة للجزء الذي يشغله بما فيهم المؤجر أن كان يسكن العقار الا إذا ثبت أن الحريق بدأ نشوبه في الجزء الذي يشغله أحد المستأجرين فيكون وحده مسؤولا عن الحريق ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_496_19750926_OpEnact_bf203ed337> ;
