<https://legal.dz/resource/order/1975-09-26/75-58#art_130> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_130" ;
    dzdoc:fullText "من سبب ضررا للغير ليتفادى ضررا أكبر ، محدقا به أو بغيره، لا يكون ملزما إلا بالتعويض الذي يراه القاضي مناسبا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_130> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_130_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_130_19750926_OpEnact_e222cf20c7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "130" ;
    dzdoc:position 140 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/order/1975-09-26/75-58#art_133> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_133" ;
    dzdoc:fullText "تسقط دعوى التعويض بانقضاء خمس عشرة (15) سنة من يوم وقوع الفعل الضار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_133> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_133_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_133_19750926_OpEnact_80781998b6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "133" ;
    dzdoc:position 143 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_135> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
