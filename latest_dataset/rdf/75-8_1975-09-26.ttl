    dznorm:conditionText "وإذا كان الحائز شخصا معنويا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_824> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_824_para_1> a dzdoc:Paragraph ;
