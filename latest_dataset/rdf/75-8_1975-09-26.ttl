<https://legal.dz/resource/order/1975-09-26/75-58#version_art_998> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للشركاء الذين اقتسموا منقولا، حق امتياز عليه تأمينا لحق كل منهم في الرجوع على الآخرين بسبب القسمة، وفي استيفاء ما تقرر لهم فيها من معدل . وتكون لامتياز المتقاسم نفس المرتبة التي تكون لامتياز البائع ، فإذا تزاحم الحقان قدم من سبق في التاريخ ."@ar ;
