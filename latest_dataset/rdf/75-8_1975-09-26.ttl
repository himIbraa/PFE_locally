        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينقضي أيضا حق الرهن الحيازي بأحد الأسباب الآتية : إذا تنازل الدائن المرتهن عن هذا الحق على أنه يجوز أن يحصل التنازل ضمنا بتخلي الدائن باختياره عن الشيء المرهون أو من موافقته على التصرف فيه دون تحفظ غير أنه إذا كان الشيء مثقلا بحق تقرر لمصلحة الغير ، فإن تنازل الدائن لا ينفذ في حق هذا الغير إلا برضائه، إذا اجتمع حق الرهن الحيازي مع حق الملكية في يد شخص واحد ، إذا هلك الشيء أو انقضى الحق المرهون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_965_19750926_OpEnact_8fcd5e271d> ;
    dzdoc:replacementText "ينقضي أيضا حق الرهن الحيازي بأحد الأسباب الآتية : إذا تنازل الدائن المرتهن عن هذا الحق على أنه يجوز أن يحصل التنازل ضمنا بتخلي الدائن باختياره عن الشيء المرهون أو من موافقته على التصرف فيه دون تحفظ غير أنه إذا كان الشيء مثقلا بحق تقرر لمصلحة الغير ، فإن تنازل الدائن لا ينفذ في حق هذا الغير إلا برضائه، إذا اجتمع حق الرهن الحيازي مع حق الملكية في يد شخص واحد ، إذا هلك الشيء أو انقضى الحق المرهون ."@ar ;
