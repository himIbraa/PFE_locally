<https://legal.dz/resource/order/1975-09-26/75-58#version_art_839> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "على المالك الذي يرد إليه ملكه أن يدفع إلى الحائز جميع ما أنفقه من المصروفات اللازمة . وفيما يرجع إلى المصروفات النافعة تطبق المادتان 784 و 785 . وإذا كانت المصروفات كمالية فليس للحائز أن يطالب بشيء منها غير أنه يجوز له أن يزيل ما أحدثه من المنشآت بشرط أن يرد الشيء بحالته الأولى الا إذا اختار المالك أن يستبقيها مقابل دفع قيمتها في حالة الهدم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_839_19750926_OpEnact_9a61a54948> ;
    dzdoc:replacementText "على المالك الذي يرد إليه ملكه أن يدفع إلى الحائز جميع ما أنفقه من المصروفات اللازمة . وفيما يرجع إلى المصروفات النافعة تطبق المادتان 784 و 785 . وإذا كانت المصروفات كمالية فليس للحائز أن يطالب بشيء منها غير أنه يجوز له أن يزيل ما أحدثه من المنشآت بشرط أن يرد الشيء بحالته الأولى الا إذا اختار المالك أن يستبقيها مقابل دفع قيمتها في حالة الهدم ."@ar ;
