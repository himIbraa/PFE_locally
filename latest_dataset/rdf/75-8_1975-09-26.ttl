<https://legal.dz/resource/order/1975-09-26/75-58#version_art_994> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المبالغ المترتبة على البذر والسماد وغيره من مواد التخصيب والمواد المقاومة للحشرات، والمبالغ المترتبة على أعمال الزراعة والحصاد، يكون لها امتياز على المحصول الذي صرفت في انتاجه وتكون لها جميعا مرتبة واحدة. وتستوفى هذه المبالغ من ثمن المحصول مباشرة بعد الحقوق المتقدمة الذكر. وكذلك يكون للمبالغ المستحقة في مقابل آلات الزراعة حق امتياز في نفس المرتبة على هذه الآلات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_994_19750926_OpEnact_df841f022a> ;
    dzdoc:replacementText "المبالغ المترتبة على البذر والسماد وغيره من مواد التخصيب والمواد المقاومة للحشرات، والمبالغ المترتبة على أعمال الزراعة والحصاد، يكون لها امتياز على المحصول الذي صرفت في انتاجه وتكون لها جميعا مرتبة واحدة. وتستوفى هذه المبالغ من ثمن المحصول مباشرة بعد الحقوق المتقدمة الذكر. وكذلك يكون للمبالغ المستحقة في مقابل آلات الزراعة حق امتياز في نفس المرتبة على هذه الآلات ."@ar ;
