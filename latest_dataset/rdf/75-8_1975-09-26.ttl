<https://legal.dz/resource/order/1975-09-26/75-58#art_592> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_3_subsec_1> ;
    dzdoc:eId "art_592" ;
    dzdoc:fullText "إذا كانت الوديعة بغير أجر وجب على المودع لديه أن يبذل من العناية في حفظ الشيء ما يبذله في حفظ ماله . وإذا كانت الوديعة بأجر فيجب دوما أن يبذل في حفظها عناية الرجل المعتاد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_592> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_592_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_592_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_592_19750926_OpEnact_185b6c7779> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_592_obligation_0_5beea254>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_592_obligation_1_3491c149> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 592" ;
    dzdoc:position 629 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_592_condition_0_1aaa5849>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_592_condition_1_b73e5e91> ;
    dzdoc:usesTerm dzterm:bailee,
        dzterm:deposit .

<https://legal.dz/resource/order/1975-09-26/75-58#art_594> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_3_subsec_1> ;
    dzdoc:eId "art_594" ;
    dzdoc:fullText "يجب على المودع لديه أن يسلم الشيء إلى المودع بمجرد طلبه الا إذا ظهر من العقد أن الأجل عين لمصلحة المودع لديه . و للمودع لديه أن يلزم المودع بتسليم الشيء في أي وقت ، الا إذا ظهر من العقد أن الأجل عين لمصلحة المودع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_594_right_0_30fe6f1e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_594> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_594_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_594_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_594_19750926_OpEnact_2ce1b7bdac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_594_obligation_0_568fa01f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 594" ;
    dzdoc:position 631 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_594_condition_0_ceace26b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_594_condition_1_41e0c62e> ;
    dzdoc:usesTerm dzterm:bailee,
        dzterm:bailor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_612> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_10_sec_1> ;
    dzdoc:eId "art_612" ;
    dzdoc:fullText "يحظر القمار و الرهان . غير أن الأحكام الواردة في الفقرة السابقة لا تطبق على الرهان الخاص بالمسابقة و الرهان الرياضي الجزائري ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_612> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_612_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_612_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_612_19750926_OpEnact_aeb18855e3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_612_obligation_0_c796ef89> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_612_prohibition_0_99cf483b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "612" ;
    dzdoc:position 649 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_612_condition_0_6bdf0f7a> ;
    dzdoc:usesTerm dzterm:betting,
        dzterm:gambling .

<https://legal.dz/resource/order/1975-09-26/75-58#art_613> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_10_sec_2> ;
    dzdoc:eId "art_613" ;
    dzdoc:fullText "يجوز للشخص أن يلتزم بأن يؤدي إلى شخص آخر مرتبا دوريا مدى الحياة بعوض أو بغير عوض . ويكون هذا الالتزام بعقد أو بوصية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_613_permission_0_23cff50f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_613> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_613_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_613_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_613_19750926_OpEnact_83ab25ae45> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_613_obligation_0_78d11c33> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 613" ;
    dzdoc:position 650 ;
    dzdoc:usesTerm dzterm:pension .

<https://legal.dz/resource/order/1975-09-26/75-58#art_668> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_668" ;
    dzdoc:fullText "إذا كان الكفلاء متضامنين فيما بينهم ووفي أحدهم الدين عند حلوله يجوز له أن يرجع على كل من الباقين بحصته في الدين وبنصيبه في حصة المعسر منهم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_668_permission_0_8da37dec> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_668_right_0_e33458bc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_668> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_668_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_668_19750926_OpEnact_9b31b7f435> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 668" ;
    dzdoc:position 705 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_668_condition_0_8848b56f> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_670> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_2> ;
    dzdoc:eId "art_670" ;
    dzdoc:fullText "يجب على الكفيل أن يخبر المدين قبل أن يقوم بوفاء الدين ، والا سقط حقه في الرجوع على المدين إذا كان هذا قد وفي الدين أو كانت عنده وقت الاستحقاق أسباب تقضي ببطلان الدين أو بانقضائه . فإذا لم يعارض المدين في الوفاء بقي للكفيل الحق في الرجوع عليه ولو كان المدين قد دفع الدين أو كانت لديه أسباب تقضي ببطلانه أو بانقضائه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_670_right_0_4bf9ee53>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_670_right_1_b2c94282> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_670> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_670_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_670_19750926_OpEnact_c03914ca61> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_670_obligation_0_7144f479> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "670" ;
    dzdoc:position 707 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_670_condition_0_9cdbf85a> ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_722> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_722" ;
    dzdoc:fullText "لكل شريك أن يطالب بقسمة المال الشائع ما لم يكن مجبرا على البقاء في الشيوع بمقتضى نص أو اتفاق. ولا يجوز بمقتضى الاتفاق أن تمنح القسمة إلى أجل يجاوز خمس (5) سنوات فإذا لم تجاوز هذه المدة نفذ الاتفاق في حق الشريك وفي حق من يخلفه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_722_permission_0_0e18cbd5> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_722_right_0_3864f5a7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_722> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_722_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_722_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_722_19750926_OpEnact_26fb6e9594> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_722_obligation_0_2ff5970a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 722" ;
    dzdoc:position 762 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_731> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_731" ;
    dzdoc:fullText "يضمن المتقاسمون بعضهم لبعض ما قد يقع من تعرض أو استحقاق لسبب سابق على القسمة ، و يكون كل منهم ملزما بنسبة حصته أن يعوض المتقاسم المتعرض له أو المنتزع حقه على أن تكون العبرة في تقدير الشيء بقيمته وقت القسمة فإذا كان أحد المتقاسمين معسرا ، وزع القدر الذي يلزمه على مستحق الضمان وجميع المتقاسمين غير المعسرين. غير أنه لا محل للضمان إذا كان هناك اتفاق صريح يقضي بالاعفاء منه في الحالة الخاصة التي نشأ عنها ، ويمتنع الضمان أيضا إذا كان الاستحقاق راجعا إلى خطأ المتقاسم نفسه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_731> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_731_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_731_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_731_19750926_OpEnact_4fee707a18> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_731_obligation_0_6e7ed8d5>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_731_obligation_1_144b6a04> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "731" ;
    dzdoc:position 771 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_731_condition_0_956dded2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_731_condition_1_5aa5eb2b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_731_condition_2_ed8c0e6e> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_763> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_763" ;
    dzdoc:fullText "تعقد الجمعية اجتماعا عاديا وجوبا مرة في السنة خلال الثلاثة (3) أشهر التي تلي نشاط نهاية السنة باستدعاء من طرف المتصرف . كما تعقد الاجتماعات استثنائيا عند الاقتضاء باستدعاء من طرف المتصرف بناءا على مبادرة منه أو بطلب من الشركاء في الملكية أو الشاغلين لها. ولا يجوز للجمعية أن تناقش قانونا الا القضايا المقيدة في جدول الأعمال والتي تتم بشأنها الاستدعاءات والاخطارات المثبتة بصورة نظامية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_763_permission_0_5b6899a0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_763> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_763_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_763_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_763_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_763_19750926_OpEnact_72a37a828b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_763_obligation_0_1a485301> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 763" ;
    dzdoc:position 810 ;
    dzdoc:usesTerm dzterm:administrator,
        dzterm:association .

<https://legal.dz/resource/order/1975-09-26/75-58#art_769> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_769" ;
    dzdoc:fullText "لا يمكن بناء طوابق أو عمارات بهدف إنشاء محلات جديدة للاستعمال الخاص الا إذا كان قرار الجمعية القاضي بذلك قد اتخذ بإجماع أعضائها الشركاء في الملكية . ويقتضي قرار إعطاء حق بناء طابق لنفس الغرض فوق عمارة مبنية بالاضافة إلى إجماع الشركاء في الملكية، موافقة الشركاء الساكنين بالطابق العلوي للعمارة المذكورة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_769_permission_0_b903fce8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_769> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_769_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_769_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_769_19750926_OpEnact_58dbc13b1d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_769_obligation_0_aa411692>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_769_obligation_1_29c40a5c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "769" ;
    dzdoc:position 820 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_769_condition_0_d200edfe> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_835> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_835" ;
    dzdoc:fullText "من حاز بسند صحيح منقولا أو حقا عينيا على المنقول أو سندا لحامله فإنه يصبح مالكا له إذا كان حسن النية وقت حيازته . إذا كان حسن النية والسند الصحيح قد توافر لدى الحائز في اعتباره الشيء خاليا من التكاليف والقيود العينية فإنه يكسب ملكية الشيء خالية من هذه التكاليف والقيود العينية . والحيازة في ذاتها قرينة على وجود السند الصحيح وحسن النية ما لم يقم دليل على خلاف ذلك."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_835_right_0_30c879ad>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_835_right_1_9e6fddfa> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_835> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_835_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_835_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_835_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_835_19750926_OpEnact_0c1becead8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 835" ;
    dzdoc:position 886 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_835_condition_0_5fb3f880>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_835_condition_1_0d75b134> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_836> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_836" ;
    dzdoc:fullText "يجوز لمالك المنقول أو السند الحامله إذا فقده أو سرق منه أن يسترده ممن يكون حائزا له بحسن النية وذلك في أجل ثلاث (3) سنوات من وقت الضياع أو السرقة. إذا كان الشيء الضائع أو المسروق قد وجد في حيازة من اشتراه بحسن النية في السوق بالمزاد العلني أو اشتراه ممن يتجر في مثله فإن له أن يطالب ممن يسترد الشيء أن يرد الثمن الذي دفعه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_836_permission_0_532532f7> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_836_right_0_18609b10> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_836> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_836_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_836_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_836_19750926_OpEnact_e39d97a7fb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 836" ;
    dzdoc:position 887 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_836_condition_0_7e6a8374> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_850> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_1> ;
    dzdoc:eId "art_850" ;
    dzdoc:fullText "إذا هلك الشيء أو تلف أو احتاج إلى اصلاحات كبرى مما يجب على المالك أن يتحمل نفقاته أو احتاج إلى اتخاذ اجراء يقيه من خطر غير متوقع فعلى المنتفع أن يبادر باخطار المالك و عليه اخطاره أيضا إذا ادعى أجنبي بحق على الشيء نفسه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_850> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_850_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_850_19750926_OpEnact_d9250c47ed> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_850_obligation_0_0d14b75d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_850_obligation_1_2336ce31> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 850" ;
    dzdoc:position 901 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_850_condition_0_539b3600> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_856> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_1> ;
    dzdoc:eId "art_856" ;
    dzdoc:fullText "لا يجوز التنازل للغير عن حق الاستعمال و حق السكن الا بناء على شرط صريح أو مبرر قوي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_856_permission_0_ba9227e4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_856> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_856_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_856_19750926_OpEnact_3644c11d74> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_856_prohibition_0_ba9227e4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 856" ;
    dzdoc:position 907 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_856_condition_0_901a69a1> ;
    dzdoc:usesTerm dzterm:right_of_habitation,
        dzterm:right_of_use .

<https://legal.dz/resource/order/1975-09-26/75-58#art_881> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_2> ;
    dzdoc:eId "art_881" ;
    dzdoc:fullText "يجوز لمالك العقار المرتفق به أن يتحرر من الارتفاق كله أو بعضه إذا فقد الارتفاق كل منفعة ل لعقار المرتفق أو إذا لم تبق له سوى فائدة محدودة لا تتناسب مع الأعباء الواقعة على العقار المرتفق به ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_881_permission_0_143635de> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_881_right_0_3513955c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_881> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_881_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_881_19750926_OpEnact_39b9135da4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "881" ;
    dzdoc:position 932 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_881_condition_0_8986b1af> ;
    dzdoc:usesTerm dzterm:property .

<https://legal.dz/resource/order/1975-09-26/75-58#art_897> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_897" ;
    dzdoc:fullText "لا تكون المخالصة بالأجرة مقدما لمدة لا تزيد على ثلاث (3) سنوات ولا الحوالة بها كذلك نافذة في حق الدائن المرتهن إلا إذا كان تاريخها ثابتا وسابقا لتسجيل تنبيه نزع الملكية . وإذا كانت المخالصة أو الحوالة لمدة تزيد على ثلاث (3) سنوات فانها لا تكون نافذة في حق الدائن المرتهن الا إذا سجلت قبل قيد الرهن والا خفضت المدة إلى ثلاث (3) سنوات مع مراعاة المقتضى الوارد في الفقرة السابقة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_897> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_897_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_897_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_897_19750926_OpEnact_759e152059> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 897" ;
    dzdoc:position 948 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_897> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_897> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_897_condition_0_df54bb2e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_897_condition_1_2f8be7e5> ;
    dzdoc:usesTerm dzterm:mortgage,
        dzterm:mortgagee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_898> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_898" ;
    dzdoc:fullText "يلتزم الراهن بضمان سلامة الرهن ، وللدائن المرتهن أن يعترض على كل عمل أو تقصير من شأنه انقاص ضمانه انقاصا كبيرا ، وله في حالة الاستعجال أن يتخذ ما يلزم من الوسائل التحفظية اللازمة وأن يرجع على الراهن بما ينفق في ذلك ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_898_right_0_5f013058>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_898_right_1_d2f9742a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_898> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_898_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_898_19750926_OpEnact_df3241e7c8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_898_obligation_0_03515b6f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 898" ;
    dzdoc:position 949 ;
    dzdoc:usesTerm dzterm:mortgage,
        dzterm:mortgagor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_901> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_901" ;
    dzdoc:fullText "إذا كان الراهن شخصا آخر غير المدين فلا يجوز التنفيذ على ماله إلا على ما رهن من ماله، ولا يكون حق الدفع بتجريد المدين إلا إذا وجد اتفاق يقضي بغير ذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_901_permission_0_48f5ed99> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_901> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_901_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_901_19750926_OpEnact_63a2215582> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 901" ;
    dzdoc:position 952 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_901_condition_0_e0d157d3>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_901_condition_1_e068e34a> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_911> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:possessor ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_911" ;
    dzdoc:fullText "يجوز للدائن المرتهن عند حلول أجل الدين أن يقوم بنزع ملكية العقار المرهون من يد الحائز لهذا العقار ، إلا إذا اختار الحائز أن يقضي الدين أو يطهر العقار من الرهن أو يتخلى عنه . ويعتبر حائزا للعقار المرهون كل من انتقلت إليه بأي سبب من الأسباب ملكية هذا العقار أو أي حق عيني آخر قابل للرهن، دون أن يكون مسؤولا مسؤولية شخصية عن الدين المضمون بالرهن ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_911_permission_0_91d180e5> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_911_right_0_a38680d7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_911> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_911_defocc_59a0a2dbf3f3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_911_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_911_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_911_19750926_OpEnact_1ac24e3743> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 911" ;
    dzdoc:position 962 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_911_condition_0_621fc5a4> ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_968> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_4> ;
    dzdoc:eId "art_968" ;
    dzdoc:fullText "يجب على الدائن المرتهن أن يقوم بصيانة العقار وبالنفقات اللازمة لحفظه، وأن يدفع ما يستحق سنويا على العقار من ضرائب وتكاليف ، على أن يستنزل من الثمار التي يحصلها قيمة ما أنفق أو يستوفي هذه القيمة من ثمن العقار في المرتبة التي يخولها له القانون. ويجوز للدائن أن يتحلل من هذه الالتزامات إذا هو تخلى عن حق الرهن ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_968_right_0_91d7d1c2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_968> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_968_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_968_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_968_19750926_OpEnact_6ad8656525> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_968_obligation_0_b8cdda75> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 968" ;
    dzdoc:position 1019 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_979> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_5> ;
    dzdoc:eId "art_979" ;
    dzdoc:fullText "يجوز للمدين في الدين المرهون أن يتمسك تجاه الدائن المرتهن بأوجه الدفع المتعلقة بصحة الحق المضمون بالرهن، وكذلك بأوجه الدفع التي تكون له هو تجاه دائنه الأصلي ، كل ذلك بالقدر الذي يجوز فيه للمدين في حالة الحوالة أن يمسك بهذه الدفوع تجاه المحال إليه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_979_permission_0_c596eb3e> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_979_right_0_abf83735> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_979> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_979_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_979_19750926_OpEnact_86dc839349> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "979" ;
    dzdoc:position 1030 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_979_condition_0_dec42b83> ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:pledged_debt,
        dzterm:pledgee .

