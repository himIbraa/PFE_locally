<https://legal.dz/resource/order/1975-09-26/75-58#version_art_425> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يبين عقد الشركة نصيب كل واحد من الشركاء في الأرباح والخسائر كان نصيب كل واحد منهم بنسبة حصته في رأس المال. فإذا اقتصر العقد على تعيين نصيب الشركاء في الأرباح وجب اعتبار هذا النصيب في الخسارة أيضا، وكذلك الحال إذا اقتصر العقد على تعيين النصيب في الخسارة . وإذا كانت حصة أحد الشركاء مقصورة على عمله وجب أن يقدر نصيبه في الربح والخسارة حسب ما تفيده الشركة من هذا العمل فإذا قدم فوق عمله نقودا أو شيئا آخر كان له نصيب عن العمل وآخر عما قدمه فوقه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_425_19750926_OpEnact_e0a65db478> ;
    dzdoc:replacementText "إذا لم يبين عقد الشركة نصيب كل واحد من الشركاء في الأرباح والخسائر كان نصيب كل واحد منهم بنسبة حصته في رأس المال. فإذا اقتصر العقد على تعيين نصيب الشركاء في الأرباح وجب اعتبار هذا النصيب في الخسارة أيضا، وكذلك الحال إذا اقتصر العقد على تعيين النصيب في الخسارة . وإذا كانت حصة أحد الشركاء مقصورة على عمله وجب أن يقدر نصيبه في الربح والخسارة حسب ما تفيده الشركة من هذا العمل فإذا قدم فوق عمله نقودا أو شيئا آخر كان له نصيب عن العمل وآخر عما قدمه فوقه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
