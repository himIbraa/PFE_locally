<https://legal.dz/resource/order/1975-09-26/75-58#version_art_738> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لأعضاء الأسرة الواحدة الذين تجمعهم وحدة العمل أو المصلحة أن يتفقوا كتابة على إنشاء ملكية للأسرة . وتتكون هذه الملكية إما من تركة ورثوها واتفقوا على جعلها كلها أو بعضها ملكا للأسرة وإما من أي مال آخر لهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_738_19750926_OpEnact_8f496416f6> ;
