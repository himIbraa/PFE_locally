<https://legal.dz/resource/order/1975-09-26/75-58#art_916_condition_0_60607e66> a dznorm:Condition ;
    dznorm:conditionText "إذا أراد الحائز تطهير العقار"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_916> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_916_obligation_0_112d23b0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-58#art_916_obligation_0_112d23b0_role_3ebf54bc60> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_916> ;
    dznorm:position 0 ;
    dznorm:provisionText "وجب عليه أن يوجه إلى الدائنين المقيدة حقوقهم في مواطنهم المختارة المذكورة في القيد إعلانات تشتمل على البيانات الآتية"@ar ;
    dznorm:sourceArticle "art_916" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_916_obligation_0_112d23b0_role_3ebf54bc60> a dznorm:Role ;
    rdfs:label "البيانات الآتية"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "وجب عليه أن يوجه إلى الدائنين المقيدة حقوقهم في مواطنهم المختارة المذكورة في القيد إعلانات تشتمل على البيانات الآتية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_916> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_916_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_916> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا أراد الحائز تطهير العقار وجب عليه أن يوجه إلى الدائنين المقيدة حقوقهم في مواطنهم المختارة المذكورة في القيد إعلانات تشتمل على البيانات الآتية : خلاصة من سند ملكية الحائز تقتصر على بيان نوع التصرف وتاريخه واسم المالك السابق للعقار مع تعيين هذا المالك تعيينا دقيقا ومحل العقار مع تعيينه وتحديده بالدقة، وإذا كان التصرف بيعا يذكر أيضا الثمن وما عسى أن يوجد من تكاليف تعتبر جزءا من هذا الثمن، تاريخ تسجيل ملكية الحائز ورقم التسجيل، المبلغ الذي يقدره الحائز قيمة للعقار ولو كان التصرف بيعا ويجب ألا يقل هذا المبلغ عن السعر الذي يتخذ أساسا لتقدير الثمن في حالة نزع الملكية، ولا أن يقل في أي حال عن الباقي في ذمة الحائز من ثمن العقار إذا كان التصرف بيعا، وإذا كانت أجزاء العقار مثقلة برهون مختلفة و وجب تقدير قيمة كل جزء على حدة، قائمة بالحقوق التي تم قيدها على العقار قبل تسجيل سند الحائز تشتمل على بيان تاريخ هذه القيود ومقدار هذه الحقوق وأسماء الدائنين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_917_obligation_0_692a6845> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-58#art_917_obligation_0_692a6845_action_c01b00420b> ;
