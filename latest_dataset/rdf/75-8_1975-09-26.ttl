<https://legal.dz/resource/order/1975-09-26/75-58#version_art_947> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون للدائن الذي حصل على حق التخصيص نفس الحقوق التي للدائن الذي حصل على رهن رسمي . ويسري على التخصيص ما يسري على الرهن الرسمي من أحكام وخاصة ما يتعلق بالقيد وتجديده وشطبه وعدم تجزئة الحق وأثره ،وانقضائه، وذلك كله مع عدم الإخلال بما ورد من أحكام خاصة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
