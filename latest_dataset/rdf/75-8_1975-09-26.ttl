<https://legal.dz/resource/order/1975-09-26/75-58#version_art_811> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنتقل الحيازة من الحائز إلى غيره إذا اتفقا على ذلك وكان في استطاعة من انتقلت إليه الحيازة أن يسيطر على الحق ولو دون تسلم مادي للشيء موضوع هذا الحق ."@ar ;
