<https://legal.dz/resource/order/1975-09-26/75-58#version_art_153> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على الفضولي أن يمضي في العمل الذي بدأه إلى أن يتمكن رب العمل من مباشرته بنفسه كما يجب عليه أن يخطر بتدخله رب العمل متى استطاع ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_153_19750926_OpEnact_222cd12b2b> ;
    dzdoc:replacementText "يجب على الفضولي أن يمضي في العمل الذي بدأه إلى أن يتمكن رب العمل من مباشرته بنفسه كما يجب عليه أن يخطر بتدخله رب العمل متى استطاع ذلك ."@ar ;
