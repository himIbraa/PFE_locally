        <https://legal.dz/resource/order/1975-09-26/75-58#art_960> ;
    dzdoc:heading "فيما بين المتعاقدين"@ar ;
    dzdoc:number "الأول" ;
    dzdoc:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_118> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_118" ;
    dzdoc:fullText "يجوز في الاشتراط لمصلحة الغير أن يكون المنتفع شخصا مستقبلا أو هيئة مستقبلة كما يجوز أن يكون شخصا أو هيئة لم يعينا وقت العقد متى كان تعيينهما مستطاعا في الوقت الذي يجب أن ينتج العقد فيه أثره طبقا للمشارطة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_118_permission_0_2454eea7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_118> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_118_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_118_19750926_OpEnact_97884d9656> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "118" ;
    dzdoc:position 125 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_118_condition_0_4112a65e> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_124_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:abuse_of_right ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_124_bis" ;
    dzdoc:fullText "يشكل الاستعمال التعسفي للحق خطأ لاسيما في الحالات الآتية : إذا وقع بقصد الاضرار بالغير ، إذا كان يرمي للحصول على فائدة قليلة بالنسبة إلى الضرر الناشئ للغير ، إذا كان الغرض منه الحصول على فائدة غير مشروعة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_124_bis> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_124_bis_defocc_bd7e32d9f052> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_124_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_124_bis_19750926_OpEnact_9af3a2d784> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "124 مكرر" ;
    dzdoc:position 134 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_124_bis_condition_0_1534b6f8>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_124_bis_condition_1_0b199720>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_124_bis_condition_2_99b3f50e> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_132> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_132" ;
    dzdoc:fullText "يعين القاضي طريقة التعويض تبعا للظروف، ويصح أن يكون التعويض مقسطا، كما يصح أن يكون إيرادا مرتبا، ويجوز في هاتين الحالتين إلزام المدين بأن يقدر تأمينا. ويقدر التعويض بالنقد، على أنه يجوز للقاضي ، تبعا للظروف وبناء على طلب المضرور، أن يأمر بإعادة الحالة إلى ما كانت عليه، أو أن يحكم وذلك على سبيل التعويض، بأداء بعض الإعانات تتصل بالفعل غير المشروع."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_132_permission_0_0b483bae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_132> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_132_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_132_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_132_19750926_OpEnact_85faddd370> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "132" ;
    dzdoc:position 142 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/order/1975-09-26/75-58#art_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_17" ;
    dzdoc:fullText "يخضع تكييف المال سواء كان عقارا أو منقولا إلى قانون الدولة التي يوجد فيها . يسري على الحيازة والملكية والحقوق العينية الأخرى قانون موقع العقار . ويسري على المنقول المادي قانون الجهة التي يوجد فيها وقت تحقق السبب الذي ترتب عليه كسب الحيازة أو الملكية أو الحقوق العينية الأخرى، أو فقدها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_17> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_17_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_17_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_17_19750926_OpEnact_14c1ae0df5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_17_obligation_0_67bbcfa9>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_17_obligation_1_4a94f58d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_17_obligation_2_3a3304ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "17" ;
    dzdoc:position 18 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_172> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_172" ;
    dzdoc:fullText "في الالتزام بعمل، إذا كان المطلوب من المدين أن يحافظ على الشيء، أو أن يقوم بإدارته أو أن يتوخى الحيطة في تنفيذ التزامه فإن المدين يكون قد وفى بالالتزام إذا بذل في تنفيذه من العناية كل ما يبذله الشخص العادي، ولو لم يتحقق الغرض المقصود . هذا ما لم ينص القانون أو الاتفاق على خلاف ذلك. وعلى كل حال يبقى المدين مسؤولا عن غشه، أو خطئه الجسيم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_172> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_172_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_172_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_172_19750926_OpEnact_3bfef056b9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_172_obligation_0_78fa86bb>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_172_obligation_1_df095921> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 172" ;
    dzdoc:position 184 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_172_condition_0_3e8ad197> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_174> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_174" ;
    dzdoc:fullText "إذا كان تنفيذ الالتزام عينا غير ممكن أو غير ملائم الا إذا قام به المدين نفسه ، جاز للدائن أن يحصل على حكم بالزام المدين بهذا التنفيذ وبدفع غرامة اجبارية إن امتنع عن ذلك . وإذا رأى القاضي أن مقدار الغرامة ليس كافيا لاكراه المدين الممتنع عن التنفيذ جاز له أن يزيد في الغرامة كلما رأى داعيا للزيادة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_174_right_0_ec405bb0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_174_right_1_f037ead3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_174> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_174_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_174_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_174_19750926_OpEnact_c088d1e3aa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 174" ;
    dzdoc:position 186 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_174_condition_0_d2ebb3ba>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_174_condition_1_08e8917f> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_176> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_176" ;
    dzdoc:fullText "إذا استحال على المدين أن ينفذ الالتزام عينا حكم عليه بتعويض الضرر الناجم عن عدم تنفيذ التزامه، ما لم يثبت أن استحالة التنفيذ نشأت عن سبب لا يد له فيه ، ويكون الحكم كذلك إذا تأخر المدين في تنفيذ التزامه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_176> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_176_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_176_19750926_OpEnact_522b15e0db> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "176" ;
    dzdoc:position 188 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_176_condition_0_7caf9c48>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_176_condition_1_c7553e14>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_176_condition_2_c9c91090> ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_184> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_184" ;
    dzdoc:fullText "لا يكون التعويض المحدد في الاتفاق مستحقا إذا اثبت المدين أن الدائن لم يلحقه أي ضرر . ويجوز للقاضي أن يخفض مبلغ التعويض إذا اثبت المدين أن التقدير كان مفرطا أو أن الالتزام الأصلي قد نفذ في جزء منه . ويكون باطلا كل اتفاق يخالف أحكام الفقرتين أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_184> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_184_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_184_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_184_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_184_19750926_OpEnact_29e0866ed5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "184" ;
    dzdoc:position 197 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_184_condition_0_0a3cb1e6>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_184_condition_1_37034659> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_220> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_220" ;
    dzdoc:fullText "إذا برئت ذمة الدائن قبل أحد الدائنين المتضامنين لسبب غير الوفاء فلا تبرأ ذمته قبل الدائنين الآخرين إلا بقدر حصة الدائن التي برئت ذمته من أجله. لا يجوز لأحد الدائنين المتضامنين أن يقوم بعمل من شأنه الاضرار بالآخرين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_220_permission_0_915cb44a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_220> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_220_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_220_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_220_19750926_OpEnact_c1e81cef33> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_220_prohibition_0_915cb44a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "220" ;
    dzdoc:position 233 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_220_condition_0_c29b0238> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "متى ظهر من الأحكام الواردة في المواد المتقدمة أن القانون الواجب التطبيق هو قانون دولة معينة تتعدد فيها التشريعات ، فإن القانون الداخلي لتلك الدولة هو الذي يقرر أي تشريع منها يجب تطبيقه . إذا لم يوجد في القانون المختص نص في هذا الشأن ، طبق التشريع الغالب في البلد في حالة التعدد الطائفي، أو التشريع المطبق في عاصمة ذلك البلد في حالة التعدد الإقليمي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_23_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_23_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_23_19750926_OpEnact_c5f34008cd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_23_obligation_0_f646c9cc>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_23_obligation_1_0d8dc32b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "23" ;
    dzdoc:position 26 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_11> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_11> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_23_condition_0_da123f82>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_23_condition_1_d73ba804> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_233> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_233" ;
    dzdoc:fullText "إذا صدر حكم على أحد المدينين المتضامنين فلا تكون لهذا الحكم سلطة على الآخرين. أما إذا صدر حكم لصالح أحدهم فيستفيد منه الآخرون، الا إذا كان هذا الحكم مبنيا على فعل خاص بالمدين المعني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_233> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_233_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_233_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_233_19750926_OpEnact_05963c97db> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 233" ;
    dzdoc:position 246 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_233_condition_0_ccee2484>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_233_condition_1_e7638228>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_233_condition_2_31bd6bde> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_237> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_2> ;
    dzdoc:eId "art_237" ;
    dzdoc:fullText "يلزم كل مدين متضامن بوفاء الدين كاملا إذا كان الالتزام لا يقبل الانقسام . ويرجع المدين الذي وفي الدين على باقي المدينين كل بقدر حصته الا إذا تبين من الظروف غير ذلك ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_237_right_0_3164b30b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_237> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_237_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_237_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_237_19750926_OpEnact_d2f732d6d3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_237_obligation_0_ccde0ce6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 237" ;
    dzdoc:position 250 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_237_condition_0_ffc18ff5>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_237_condition_1_e022333d> ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_242> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_242" ;
    dzdoc:fullText "يجوز للدائن المحال له قبل إعلان الحوالة أو قبولها أن يتخذ كل الاجراءات التحفظية ليحافظ بها على الحق المنتقل إليه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_242_permission_0_ed3085b2> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_242_right_0_d9ccd1b8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_242> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_242_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_242_19750926_OpEnact_5fd9f3f519> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 242" ;
    dzdoc:position 255 ;
    dzdoc:usesTerm dzterm:assignee,
        dzterm:assignment .

<https://legal.dz/resource/order/1975-09-26/75-58#art_272> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_272" ;
    dzdoc:fullText "يجوز للمدين بعد استئذان القضاء أن يبيع بالمزاد العلني الأشياء التي يسرع إليها التلف، أو التي تكلف نفقات باهظة في ايداعها أو حراستها وايداع ثمن البيع بالخزينة العمومية . فإذا كان للاشياء سعر معروف في السوق فلا تباع بالمزاد العلني الا إذا تعذر بيعها بالتراضي وبالسعر المتداول عرفا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_272_permission_0_c7ef62ee> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_272_right_0_8ee5905e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_272> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_272_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_272_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_272_19750926_OpEnact_ac74ae00aa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "272" ;
    dzdoc:position 285 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_272_condition_0_69486fd1> ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_292> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_2> ;
    dzdoc:eId "art_292" ;
    dzdoc:fullText "إذا قدم المدين تأمينات حقيقية لكفالة الالتزام القديم فإن الاتفاق على نقل هذه التأمينات إلى الالتزام الجديد تراعى فيه الأحكام الآتية : إذا كان التجديد بتغيير الدين جاز للدائن وللمدين الاتفاق على انتقال التأمينات للالتزام الجديد، في الحدود التي لا تلحق ضررا بالغير، إذا كان التجديد بتغيير المدين جاز للدائن وللمدين الجديد الاتفاق على استبقاء التأمينات العينية دون حاجة إلى رضا المدين القديم، إذا كان التجديد بتغيير الدائن جاز للاطراف الثلاثة المتعاقدين الاتفاق على استبقاء التأمينات. ولا يكون الاتفاق على انتقال التأمينات العينية نافذا في حق الغير، الا إذا تم مع التجديد في وقت واحد، مع مراعاة الأحكام المتعلقة بالتسجيل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_292> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_292_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_292_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_292_19750926_OpEnact_61c3549c6a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 292" ;
    dzdoc:position 305 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_292_condition_0_e3503410>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_292_condition_1_7153e8d9>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_292_condition_2_e424cd47>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_292_condition_3_981341ad> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_303> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_3> ;
    dzdoc:eId "art_303" ;
    dzdoc:fullText "إذا حول الدائن حقه للغير وقبل المدين الحوالة دون تحفظ فلا يجوز لهذا الأخير أن يتمسك قبل المحال له بالمقاصة التي كان تمسك بها قبل قبوله للحوالة وليس له الا الرجوع بحقه على المحيل. أما إذا كان المدين لم يقبل الحوالة ولكن أعلن بها فلا تمنعه هذه الحوالة من أن يتمسك بالمقاصة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_303_permission_0_9d943b7f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_303> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_303_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_303_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_303_19750926_OpEnact_3498524af0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "303" ;
    dzdoc:position 316 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_303_condition_0_5600e922>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_303_condition_1_3881d331> ;
    dzdoc:usesTerm dzterm:مقاصة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_311> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_3> ;
    dzdoc:eId "art_311" ;
    dzdoc:fullText "تتقادم بأربع (4) سنوات الضرائب والرسوم المستحقة للدولة ويبدأ سريان التقادم والرسوم السنوية من نهاية السنة التي تستحق عنها وفي الرسوم المستحقة عن الأوراق القضائية من تاريخ انتهاء المرافعة في الدعوى أو من تاريخ تحريرها إذا لم تحصل مرافعة. ويتقادم بأربع (4) سنوات أيضا الحق في المطالبة برد الضرائب والرسوم التي دفعت بغير حق ويبدأ سريان التقادم من يوم دفعها. ولا تخل الأحكام السابقة باحكام النصوص الواردة في القوانين الخاصة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_311> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_311_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_311_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_311_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_311_19750926_OpEnact_ecf86181c7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_311_obligation_0_0d4a0f5a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_311_obligation_1_50691a8a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "311" ;
    dzdoc:position 324 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_319> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_3> ;
    dzdoc:eId "art_319" ;
    dzdoc:fullText "إذا انقطع التقادم بدأ تقادم جديد يسري من وقت انتهاء الاثر المترتب على سبب الانقطاع وتكون مدته هي مدة التقادم الأول . غير أنه إذا حكم بالدين وحاز الحكم قوة الشيء المقضي به أو إذا كان الدين يتقادم بسنة وانقطع تقادمه بإقرار المدين ، كانت مدة التقادم الجديد خمسة عشرة (15) سنة الا أن يكون الدين المحكوم به متضمنا لالتزامات دورية متجددة لا تستحق الاداء الا بعد صدور الحكم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_319> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_319_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_319_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_319_19750926_OpEnact_7559d6d327> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_319_obligation_0_fbcf9475>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_319_obligation_1_29168da3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "319" ;
    dzdoc:position 332 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_319_condition_0_c661df07>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_319_condition_1_3dbd3e9d> ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:limitation_period .

<https://legal.dz/resource/order/1975-09-26/75-58#art_345> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_5> ;
    dzdoc:eId "art_345" ;
    dzdoc:fullText "لا يجوز لمن وجه اليمين أو ردها أن يرجع في ذلك متى قبل خصمه حلف تلك اليمين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_345_permission_0_7fb70a81> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_345> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_345_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_345_19750926_OpEnact_ccfd5e0f6d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_345_obligation_0_217a2b30> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_345_prohibition_0_7fb70a81> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "345" ;
    dzdoc:position 369 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_353> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_353" ;
    dzdoc:fullText "إذا انعقد البيع بالعينة يجب أن يكون المبيع مطابقا لها وإذا تلفت العينة أو هلكت في يد أحد المتعاقدين ولو دون خطا كان على المتعاقد بائعا أو مشتريا، أن يثبت أن الشيء مطابق أو غير مطابق للعينة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_353> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_353_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_353_19750926_OpEnact_5eff0fcbc3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_353_obligation_0_3a3dfbbb>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_353_obligation_1_da603be7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 353" ;
    dzdoc:position 377 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_353_condition_0_b8c2f7a2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_353_condition_1_8c27c49d> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_378> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_378" ;
    dzdoc:fullText "يبقى البائع مسؤولا عن كل نزع يد ينشأ عن فعله ولو وقع الاتفاق على عدم الضمان ويقع باطلا كل اتفاق يقضي بغير ذلك. وإذا كان نزع اليد عن المبيع من فعل الغير فإن البائع يبقى مطالبا قبل المشتري برد قيمة المبيع وقت نزع اليد الا إذا اثبت أن المشتري كان يعلم وقت البيع سبب نزع اليد، أو انه اشتری تحت مسؤولیته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_378> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_378_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_378_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_378_19750926_OpEnact_c062d71b23> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_378_obligation_0_55983dff>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_378_obligation_1_a82db24f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 378" ;
    dzdoc:position 402 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_378_condition_0_87536315>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_378_condition_1_e5d476e0> ;
    dzdoc:usesTerm dzterm:buyer,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_379> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_379" ;
    dzdoc:fullText "يكون البائع ملزما للضمان إذا لم يشتمل المبيع على الصفات التي تعهد بوجودها وقت التسليم إلى المشتري أو إذا كان بالمبيع عيب ينقص من قيمته، أو من الانتفاع به بحسب الغاية المقصودة منه حسبما هو مذكور بعقد البيع، أو حسبما يظهر من طبيعته أو استعماله فيكون البائع ضامنا لهذه العيوب ولو لم يكن عالما بوجودها. غير أن البائع لا يكون ضامنا للعيوب التي كان المشتري على علم بها وقت البيع، أو كان في استطاعته أن يطلع عليها لو انه فحص المبيع بعناية الرجل العادي ، الا إذا اثبت المشتري أن البائع أكد له خلو المبيع من تلك العيوب أو أنه أخفاها غشا عنه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_379> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_379_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_379_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_379_19750926_OpEnact_ba04b1af80> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_379_obligation_0_9330a96b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 379" ;
    dzdoc:position 403 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_379_condition_0_ba42db09>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_379_condition_1_33ae4f95> ;
    dzdoc:usesTerm dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_39" ;
    dzdoc:fullText "يجوز اختيار موطن خاص لتنفيذ تصرف قانوني معين. يجب اثبات اختيار الموطن كتابة . الموطن المختار لتنفيذ تصرف قانوني يعد موطنا بالنسبة إلى كل ما يتعلق بهذا التصرف بما في ذلك اجراءات التنفيذ الجبري ما لم يشترط صراحة هذا الموطن على تصرفات معينة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_39_permission_0_86d653eb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_39> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_39_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_39_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_39_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_39_19750926_OpEnact_43c3347789> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_39_obligation_0_2bd4c213> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "39" ;
    dzdoc:position 45 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_400> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:disputed_right ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_400" ;
    dzdoc:fullText "إذا تنازل شخص عن حق متنازع فيه فللمتنازل ضده أن يتخلص من هذا الشخص برد ثمن البيع الحقيقي له والمصاريف الواجبة . ويعتبر الحق متنازعا فيه إذا رفعت من أجله دعوى أو كان محل نزاع جوهري ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_400_right_0_50cf86e3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_400> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_400_defocc_96d2b301155c> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_400_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_400_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_400_19750926_OpEnact_6f769114ef> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 400" ;
    dzdoc:position 424 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_400_condition_0_ed7058dd> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_408> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_408" ;
    dzdoc:fullText "إذا باع المريض مرض الموت لوارث فإن البيع لا يكون ناجزا الا إذا أقره باقي الورثة . أما إذا تم البيع للغير في نفس الظروف فإنه يعتبر غير مصادق عليه ومن أجل ذلك يكون قابلا للابطال."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_408> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_408_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_408_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_408_19750926_OpEnact_8be4c3609a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 408" ;
    dzdoc:position 432 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_408_condition_0_8f05a823>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_408_condition_1_9619b38c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_408_condition_2_1853cfce> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_445> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_5> ;
    dzdoc:eId "art_445" ;
    dzdoc:fullText "تتم التصفية عند الحاجة اما على يد جميع الشركاء، واما على يد مصف واحد أو أكثر تعينهم أغلبية الشركاء. وإذا لم يتفق الشركاء على تعيين المصفي ، فيعينه القاضي بناء على طلب أحدهم. وفي الحالات التي تكون فيها الشركة باطلة فإن المحكمة تعين المصفي وتحدد طريقة التصفية بناء على طلب كل من يهمه الأمر. وحتى يتم تعيين المصفي يعتبر المتصرفون بالنسبة إلى الغير في حكم المصفين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_445> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_445_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_445_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_445_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_445_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_445_19750926_OpEnact_6cf0cd071b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 445" ;
    dzdoc:position 469 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_445_condition_0_441176a9>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_445_condition_1_dd9ac98b> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_456> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_4> ;
    dzdoc:eId "art_456" ;
    dzdoc:fullText "يجوز لمؤسسات القرض التي تمنح قروضا قصد تشجيع النشاط الاقتصادي الوطني أن تأخذ فائدة يحدد قدرها بموجب قرار من الوزير المكلف بالمالية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_456_permission_0_3e352220> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_456_right_0_fe7c2305> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_456> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_456_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_456_19750926_OpEnact_a698efaffa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 456" ;
    dzdoc:position 480 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/order/1975-09-26/75-58#art_465> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_5_subsec_3> ;
    dzdoc:eId "art_465" ;
    dzdoc:fullText "لا يجوز الطعن في الصلح بسبب غلط في القانون ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_465_permission_0_360c6923> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_465> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_465_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_465_19750926_OpEnact_95aa88b388> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_465_obligation_0_73f907c9> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_465_prohibition_0_360c6923> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 465" ;
    dzdoc:position 489 ;
    dzdoc:usesTerm dzterm:settlement .

<https://legal.dz/resource/order/1975-09-26/75-58#art_476> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_476" ;
    dzdoc:fullText "يلتزم المؤجر بتسليم العين المؤجرة للمستأجر في حالة تصلح للاستعمال المعد لها تبعا لاتفاق الطرفين . تتم معاينة الأماكن وجاهيا بموجب محضر أو بيان وصفي يلحق بعقد الإيجار. غير أنه إذا تم تسليم العين المؤجرة دون محضر أو بيان وصفي ، يفترض في المستأجر أنه تسلمها في حالة حسنة ما لم يثبت العكس."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_476> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_476_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_476_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_476_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_476_19750926_OpEnact_d7c3ab8aa5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_476_obligation_0_d2b22e07> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 476" ;
    dzdoc:position 506 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_476_condition_0_90989152> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_488> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_488" ;
    dzdoc:fullText "يضمن المؤجر للمستأجر ، باستثناء العيوب التي جرى العرف على التسامح فيها، كل ما يوجد بالعين المؤجرة من عيوب تحول دون استعمالها أو تنقص من هذا الاستعمال نقصا محسوسا ، ما لم يوجد اتفاق على خلاف ذلك . ويكون كذلك مسؤولا عن الصفات التي تعهد بها صراحة. غير أن المؤجر لا يضمن العيوب التي أعلم بها المستأجر أو كان يعلم بها هذا الأخير وقت التعاقد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_488> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_488_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_488_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_488_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_488_19750926_OpEnact_56c77d33f2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_488_obligation_0_b4f8132a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 488" ;
    dzdoc:position 518 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_488_condition_0_c591866c> ;
    dzdoc:usesTerm dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_491> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_491" ;
    dzdoc:fullText "يلتزم المستأجر بأن يستعمل العين المؤجرة حسبما وقع الاتفاق عليه ، فإن لم يكن هناك اتفاق وجب على المستأجر أن يستعمل العين المؤجرة بحسب ما أعدت له ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_491> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_491_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_491_19750926_OpEnact_09ef7d6ef4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_491_obligation_0_40e8d49d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_491_obligation_1_b583c437> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 491" ;
    dzdoc:position 521 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_491_condition_0_54837922> ;
    dzdoc:usesTerm dzterm:lessee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_496> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_496" ;
    dzdoc:fullText "المستأجر مسؤول عن حريق العين المؤجرة الا إذا اثبت أن الحريق نشأ عن سبب ليس من فعله . فإذا تعدد المستأجرون لعقار واحد كان كل واحد منهم مسؤول عن الحريق بالنسبة للجزء الذي يشغله بما فيهم المؤجر أن كان يسكن العقار الا إذا ثبت أن الحريق بدأ نشوبه في الجزء الذي يشغله أحد المستأجرين فيكون وحده مسؤولا عن الحريق ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_496> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_496_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_496_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_496_19750926_OpEnact_bf203ed337> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_496_obligation_0_4270f543>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_496_obligation_1_714c79bf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 496" ;
    dzdoc:position 526 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_496_condition_0_c2e37f4e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_496_condition_1_bb45abfb>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_496_condition_2_7c97f04d> ;
    dzdoc:usesTerm dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_500> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_500" ;
    dzdoc:fullText "يمكن الأطراف الإتفاق على كفالة لضمان الوفاء ببدل الإيجار والتكاليف ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_500_permission_0_4de49127> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_500_right_0_c1bcfc9f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_500> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_500_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_500_19750926_OpEnact_6da9f7cbd4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 500" ;
    dzdoc:position 530 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_503> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_503" ;
    dzdoc:fullText "يجب على المستأجر أن يرد العين المؤجرة بالحالة التي كانت عليها وقت تسلمها ، ويحرر وجاهيا محضر أو بيان وصفي بذلك. إذا تم رد العين المؤجرة دون تحرير محضر أو دون بيان وصفها ، يفترض في المؤجر أنه استردها في حالة حسنة ما لم يثبت العكس. المستأجر مسؤول عما يلحق العين المؤجرة من هلاك أو تلف ما لم يثبت أنه لا ينسب إليه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_503> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_503_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_503_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_503_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_503_19750926_OpEnact_f4a0d69260> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_503_obligation_0_60d81cfb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 503" ;
    dzdoc:position 533 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_503_condition_0_ac266832> ;
    dzdoc:usesTerm dzterm:leased_property,
        dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_545> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_2_subsec_2> ;
    dzdoc:eId "art_545" ;
    dzdoc:fullText "متى انتهت العارية وجب على المستعير أن يرد الشيء الذي تسلمه بالحالة التي يكون عليها وذلك دون إخلال بمسؤوليته عن الهلاك أو التلف و يجب رد الشيء في المكان الذي يكون المستعير قد تسلمه فيه ما لم يوجد اتفاق يقضي بغير ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_545> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_545_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_545_19750926_OpEnact_788c7dae44> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_545_obligation_0_42f7ec92>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_545_obligation_1_fb5f651d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "545" ;
    dzdoc:position 572 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_545_condition_0_f8a22ab7>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_545_condition_1_a4ef3ed5> ;
    dzdoc:usesTerm dzterm:borrower,
        dzterm:loan_for_use .

<https://legal.dz/resource/order/1975-09-26/75-58#art_57> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:عقد_غرر ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_57" ;
    dzdoc:fullText "يكون العقد تبادليا متى التزم أحد الطرفين بمنح ، أو فعل شيء، يعتبر معادلا لما يمنح، أو يفعل له . إذا كان الشيء المعادل محتويا على حظ ربح، أو خسارة لكل واحد من الطرفين على حسب حادث غير محقق فإن العقد يعتبر عقد غرر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_57> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_57_defocc_c1ce19eb22cf> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_57_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_57_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_57_19750926_OpEnact_166926d8b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "57" ;
    dzdoc:position 63 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_57_condition_0_4711b8cf>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_57_condition_1_9ce0f314> ;
    dzdoc:usesTerm dzterm:العقد .

<https://legal.dz/resource/order/1975-09-26/75-58#art_578> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_2> ;
    dzdoc:eId "art_578" ;
    dzdoc:fullText "لا يجوز للوكيل أن يستعمل مال الموكل لصالح نفسه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_578_permission_0_1637e893> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_578> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_578_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_578_19750926_OpEnact_67f8718982> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_578_obligation_0_ae250546> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_578_prohibition_0_1637e893> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 578" ;
    dzdoc:position 615 ;
    dzdoc:usesTerm dzterm:agent,
        dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_579> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_2> ;
    dzdoc:eId "art_579" ;
    dzdoc:fullText "إذا تعدد الوكلاء كانوا مسؤولين بالتضامن متى كانت الوكالة غير قابلة للانقسام أو كان الضرر الذي أصاب الموكل نتيجة خطا مشترك على أن الوكلاء ولو كانوا متضامنين لا يسألون عما فعله أحدهم متجاوزا حدود الوكالة أو متعسفا في تنفيذها. وإذا عين الوكلاء في عقد واحد دون أن يرخص في انفرادهم في العمل كان عليهم أن يعملوا مجتمعين الا إذا كان العمل مما لا يحتاج فيه إلى تبادل الرأي كقبض الدين أو وفائه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_579_permission_0_4839a566> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_579> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_579_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_579_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_579_19750926_OpEnact_099f0198a5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_579_obligation_0_a451d338>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_579_obligation_1_c88f5d71> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 579" ;
    dzdoc:position 616 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_579_condition_0_d782da95>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_579_condition_1_70f29061> ;
    dzdoc:usesTerm dzterm:agency,
        dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_587> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_3> ;
    dzdoc:eId "art_587" ;
    dzdoc:fullText "يجوز للموكل في أي وقت أن ينهي الوكالة أو يقيدها ولو وجد اتفاق يخالف ذلك فإذا كانت الوكالة بأجر فإن الموكل يكون ملزما بتعويض الوكيل عن الضرر الذي لحقه من جراء عزله في وقت غير مناسب بغير عذر مقبول ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_587_permission_0_780956ff> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_587_right_0_0bdc4220> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_587> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_587_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_587_19750926_OpEnact_7a1d290427> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_587_obligation_0_4545a850> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "587" ;
    dzdoc:position 624 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_587_condition_0_b3d2442b> ;
    dzdoc:usesTerm dzterm:agency,
        dzterm:agent,
        dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_595> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_3_subsec_1> ;
    dzdoc:eId "art_595" ;
    dzdoc:fullText "إذا باع وارث المودع لديه الشيء المودع وهو عن حسن نية فليس عليه الا رد ما قبضه من الثمن لمالكه أو التنازل له عن حقوقه تجاه المشتري واما إذا تصرف فيه فإنه يلتزم بقيمته وقت التبرع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_595> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_595_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_595_19750926_OpEnact_b3476e87f0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_595_obligation_0_d2b50c90>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_595_obligation_1_6fe2b29b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 595" ;
    dzdoc:position 632 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_595_condition_0_a86235c9>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_595_condition_1_2f8f730f> ;
    dzdoc:usesTerm dzterm:bailee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_601> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_3_subsec_3> ;
    dzdoc:eId "art_601" ;
    dzdoc:fullText "يجب على المسافر أن يخطر صاحب الفندق أو النزل بسرقة الشيء أو ضياعه أو تلفه بمجرد علمه بوقوع شيء من ذلك فإن أبطأ في الاخطار دون مسوغ سقطت حقوقه . وتسقط بالتقادم دعوى المسافر تجاه صاحب الفندق أو النزل بانقضاء ستة (6) أشهر من اليوم الذي يغادر فيه الفندق أو النزل."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_601_right_0_21815827> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_601> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_601_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_601_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_601_19750926_OpEnact_b2a85e1b8d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_601_obligation_0_72e8309a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 601" ;
    dzdoc:position 638 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_601_condition_0_76aa2c07> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_603> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_4> ;
    dzdoc:eId "art_603" ;
    dzdoc:fullText "يجوز للقاضي أن يأمر بالحراسة : في الأحوال المشار إليها في المادة 602 إذا لم يتفق ذوو الشأن على الحراسة ، إذا كان صاحب المصلحة في منقول أو عقار قد تجمع لديه من الأسباب المعقولة ما يخشى معه خطرا عاجلا من بقاء المال تحت يد حائزه في الأحوال الأخرى المنصوص عليها في القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_603_permission_0_8a8f5c4e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_603> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_603_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_603_19750926_OpEnact_726dcd3632> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "603" ;
    dzdoc:position 640 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_602> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_602> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_603_condition_0_fcbfd870>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_603_condition_1_81820da2> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_607> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_4> ;
    dzdoc:eId "art_607" ;
    dzdoc:fullText "يلتزم الحارس بالمحافظة على الأموال المعهودة إليه حراستها، وبإدارة هذه الأموال مع القيام بها قيام الرجل المعتاد . ولا يجوز له بطريقة مباشرة أو غير مباشرة أن يحل محله في أداء مهمته كلها أو بعضها أحد من ذوي الشأن دون رضاء الآخرين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_607_permission_0_93101433> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_607> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_607_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_607_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_607_19750926_OpEnact_c1f28673f0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_607_obligation_0_20b42656> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "607" ;
    dzdoc:position 644 ;
    dzdoc:usesTerm dzterm:حارس .

<https://legal.dz/resource/order/1975-09-26/75-58#art_664> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_664" ;
    dzdoc:fullText "إذا تعدد الكفلاء لدين واحد، وبعقد واحد، وكانوا غير متضامنين فيما بينهم قسم الدين عليهم، ولا يجوز للدائن أن يطالب كل كفيل الا بقدر نصيبه في الكفالة. أما إذا كان الكفلاء قد التزموا بعقود متوالية ، فإن كل واحد منهم يكون مسؤولا عن الدين كله، الا إذا كان قد احتفظ لنفسه بحق التقسية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_664_permission_0_8c6942fc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_664> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_664_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_664_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_664_19750926_OpEnact_3bee9f9fdd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 664" ;
    dzdoc:position 701 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_664_condition_0_3fa241d4>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_664_condition_1_8c26f5db>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_664_condition_2_0f2b7abc> ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_683> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:immovable,
        dzterm:immovable_by_destination,
        dzterm:movable ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_683" ;
    dzdoc:fullText "كل شيء مستقر بحيزه وثابت فيه ولا يمكن نقله منه دون تلف فهو عقار ، وكل ما عدا ذلك من شيء فهو منقول . غير أن المنقول الذي يضعه صاحبه في عقار يملكه، رصدا على خدمة هذا العقار أو استغلاله يعتبر عقارا بالتخصيص ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_683_permission_0_19a226b7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_683> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_683_defocc_320b9396e625>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_683_defocc_42aa40ec10c3>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_683_defocc_d78305ad631e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_683_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_683_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_683_19750926_OpEnact_4cd21997eb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "683" ;
    dzdoc:position 723 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_689> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_689" ;
    dzdoc:fullText "لا يجوز التصرف في أموال الدولة، أو حجزها ، أو تملكها بالتقادم غير أن القوانين التي تخصص هذه الأموال لاحدى المؤسسات المشار إليها في المادة 688 ، تحدد شروط إداراتها، وعند الاقتضاء شروط عدم التصرف فيها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_689_permission_0_7216026c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_689> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_689_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_689_19750926_OpEnact_e7c7c497ac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_689_obligation_0_b4d6362c> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_689_prohibition_0_7216026c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "689" ;
    dzdoc:position 729 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_688> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_688> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_71> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_71" ;
    dzdoc:fullText "الاتفاق الذي يعد له كلا المتعاقدين أو أحدهما بإبرام عقد معين في المستقبل لا يكون له أثر الا إذا عينت جميع المسائل الجوهرية للعقد المراد إبرامه، والمدة التي يجب إبرامه فيها . وإذا اشترط القانون لتمام العقد استيفاء شكل معين فهذا الشكل يطبق أيضا على الاتفاق المتضمن الوعد بالتعاقد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_71> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_71_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_71_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_71_19750926_OpEnact_8bfd0f72a8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "71" ;
    dzdoc:position 77 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_71_condition_0_841b1914>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_71_condition_1_009e4c74> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_747> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_747" ;
    dzdoc:fullText "لا يجوز أن تكون الأجزاء المشتركة، أو الحقوق التابعة لها محلا لدعوى التقسيم، أو بيعا بالمزايدة بمعزل عن الأجزاء الخاصة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_747_permission_0_7a79511d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_747> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_747_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_747_19750926_OpEnact_e97c3d5423> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_747_obligation_0_2ef97bf7> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_747_prohibition_0_7a79511d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 747" ;
    dzdoc:position 787 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_750> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_750" ;
    dzdoc:fullText "تنقسم التكاليف المشتركة إلى نوعين : 1 - تكاليف من النوع الأول وهي تتعلق بالتسيير العادي للأجزاء المشتركة والترميمات الصغيرة الخاصة بها. يتولى هذه التكاليف مجموع الشاغلين فعليين كانوا أم لا . وتتوزع هذه التكاليف حسب حصص متساوية بين كل واحد من الشاغلين الذين يجب أن يوفوا بها لدى المتصرف ، وذلك وفقا للكيفيات التي حددتها الجمعية العامة. 2- تكاليف من النوع الثاني وهي تتعلق بالترميمات الكبرى للعقار وصيانته وكذا أمن الشركاء في الملكية والشاغلين لها. ويتكفل الشركاء في ملكية العقار بهذه التكاليف . ويتم توزيع هذه التكاليف على أساس حصة كل جزء مشترك من الأجزاء المتعلقة بكل قسمة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_750> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_750_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_750_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_750_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_19750926_OpEnact_3cb980eb39> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_750_obligation_0_8a6db327>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_750_obligation_1_781dc7f4>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_750_obligation_2_f2e51638> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 750" ;
    dzdoc:position 790 ;
    dzdoc:usesTerm dzterm:common_charges .

<https://legal.dz/resource/order/1975-09-26/75-58#art_767> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_767" ;
    dzdoc:fullText "لا يجوز للجمعية العامة مهما كانت أغلبية الأصوات أن تلزم أحد الشركاء في الملكية بتغيير الأجزاء الخاصة فيما أعدت له أو تغيير كيفية الانتفاع بها كما هو مقرر في نظام الملكية المشتركة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_767_permission_0_81dd8c9c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_767> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_767_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_767_19750926_OpEnact_220841dc5c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_767_obligation_0_67f7e091> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_767_prohibition_0_81dd8c9c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "767" ;
    dzdoc:position 818 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_782> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_782" ;
    dzdoc:fullText "كل ما على الأرض أو تحتها من غراس أو بناء أو منشآت أخرى يعتبر من عمل صاحب الأرض وأقامه على نفقته ويكون مملوكا له. غير أنه يجوز أن تقام البينة على أن أجنبيا أقام المنشآت على نفقته كما يجوز أن تقام البينة على أن صاحب الأرض قد خول أجنبيا ملكية منشآت كانت قائمة من قبل أو خوله الحق في إقامة هذه المنشآت وفي تملكها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_782_permission_0_ae66ddc9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_782> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_782_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_782_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_782_19750926_OpEnact_d6c2b6e279> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "782" ;
    dzdoc:position 833 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_783> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_783" ;
    dzdoc:fullText "يكون ملكا خالصا لصاحب الأرض ما يحدثه فيها من غراس أو بناء أو منشآت أخرى يقيمها بمواد مملوكة لغيره إذا لم يكن ممكنا نزع هذه المواد دون أن يلحق المنشآت ضرر جسيم أو كان ممكنا نزعها ولكن لم ترفع الدعوى بالاسترداد خلال سنة من اليوم الذي علم فيه مالك المواد أنها اندمجت في هذه المنشآت . إذا تملك صاحب الأرض المواد كان عليه أن يدفع قيمتها مع التعويض عن الضرر الحاصل إذا اقتضى الحال ذلك . وفي حالة استرداد المواد من صاحبها فإن نزعها يكون على نفقة مالك الأرض."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_783> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_783_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_783_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_783_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_783_19750926_OpEnact_613cd409ac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_783_obligation_0_fd3275a0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "783" ;
    dzdoc:position 834 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_783_condition_0_7f81020d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_783_condition_1_1b7c3acd> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_790> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_790" ;
    dzdoc:fullText "إذا أقام أجنبي منشآت بمواد مملوكة لغيره فليس لمالك المواد أن يطلب استردادها وإنما يكون له أن يرجع بالتعويض على هذا الاجنبي كما له أن يرجع على مالك الأرض بما لا يزيد على ما هو باق في ذمته من قيمة تلك المنشآت ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_790_right_0_3a80a356>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_790_right_1_35de3666> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_790> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_790_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_790_19750926_OpEnact_9dc0fd16ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 790" ;
    dzdoc:position 841 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_790_condition_0_2b401279> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_838> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_838" ;
    dzdoc:fullText "يكون الحائز سيئ النية مسؤولا عن جميع الثمار التي قبضها أو قصر في قبضها من الوقت الذي أصبح فيه سيئ النية . غير أنه يجوز له أن يسترد ما أنفقه في انتاجها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_838_permission_0_39197229> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_838_right_0_0da40f55> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_838> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_838_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_838_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_838_19750926_OpEnact_63b27de7c1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_838_obligation_0_69ab759c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "838" ;
    dzdoc:position 889 ;
    dzdoc:usesTerm dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_847> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_1> ;
    dzdoc:eId "art_847" ;
    dzdoc:fullText "على المنتفع أن يستعمل الشيء بحالته التي تسلمه بها وبحسب ما أعد له وأن يديره إدارة حسنة . وللمالك أن يعترض على أي استعمال غير مشروع أو غير متفق مع طبيعة الشيء فإذا أثبت أن حقوقه في خطر جاز له أن يطالب بتقديم تأمينات فإن لم يقدمها المنتفع أو استمر على الرغم من اعتراض المالك في استعمال الشيء استعمالا غير مشروع أو غير متفق مع طبيعة الشيء فللقاضي أن ينزع العين من تحت يده وأن يسلمها إلى الغير ليتولى إدارتها بل له تبعا لخطورة الحال أن يقرر انتهاء حق الانتفاع دون إخلال بحقوق الغير."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_847> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_847_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_847_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_847_19750926_OpEnact_b7605a5a85> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_847_obligation_0_9a672fda> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 847" ;
    dzdoc:position 898 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_847_condition_0_7d2ef453>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_847_condition_1_82e522d3> ;
    dzdoc:usesTerm dzterm:usufruct .

<https://legal.dz/resource/order/1975-09-26/75-58#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "يجوز إبطال العقد للتدليس إذا كانت الحيل التي لجأ إليها أحد المتعاقدين أو النائب عنه، من الجسامة بحيث لولاها لما ابرم الطرف الثاني العقد . ويعتبر تدليسا السكوت عمدا عن واقعة أو ملابسة إذا ثبت أن المدلس عليه ما كان ليبرم العقد لو علم بتلك الواقعة أو هذه الملابسة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_86_permission_0_d5f7b3a0> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_86_right_0_9e8f4975> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_86_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_86_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_86_19750926_OpEnact_6f0de57377> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 86" ;
    dzdoc:position 93 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_86_condition_0_f986c868> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_869> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_2> ;
    dzdoc:eId "art_869" ;
    dzdoc:fullText "يجوز أيضا في الارتفاقات الظاهرة أن ترتب بالتخصيص من المالك الأصلي. ويكون التخصيص من المالك الأصلي إذا تبين بأي طريقة من طرق الاثبات أن المالك العقارين منفصلين قد أقام بينهما علامة ظاهرة فانشأ بذلك علاقة تبعية بينهما من شأنها أن تدل على وجود ارفاق لو أن العقارين كانا مملوكين لمالكين مختلفين . ففي هذه الحالة إذا انتقل العقاران إلى ملاك مختلفين دون تغيير في حالتهما عد الارتفاق مرتبا بين العقارين لهما وعليهما ما لم يكن ثمة شرط صريح يخالف ذلك."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_869_permission_0_c68cc1ed> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_869> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_869_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_869_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_869_19750926_OpEnact_b50dbf2532> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "869" ;
    dzdoc:position 920 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_869_condition_0_b7d86552>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_869_condition_1_d21916a9> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_918> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_918" ;
    dzdoc:fullText "يجوز لكل دائن قيد حقه ولكل كفيل لحق مقيد أن يطلب بيع العقار المطلوب تطهيره ، ويكون ذلك في مدى ثلاثين (30) يوما من آخر إعلان رسمي يضاف إليها أجال المسافة ما بين الموطن الأصلي للدائن وموطنه المختار، على ألا تزيد آجال المسافة على ثلاثين (30) يوما أخرى."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_918_permission_0_61f1ad1e> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_918_right_0_de167330> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_918> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_918_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_918_19750926_OpEnact_22563d5b97> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "918" ;
    dzdoc:position 969 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_920> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_920" ;
    dzdoc:fullText "إذا طلب بيع العقار وجب اتباع الاجراءات المقررة في البيوع الجبرية ، ويتم البيع بناء على طلب صاحب المصلحة في التعجيل من طالب أو حائز ، وعلى من يباشر الاجراءات أن يذكر في إعلانات البيع المبلغ الذي قوم به العقار. ويلتزم الراسي عليه المزاد أن يرد إلى الحائز الذي نزعت ملكيته المصاريف التي انفقها في سند ملكيته، وفي تسجيل هذا السند وفيما قام به من الاعلانات ، وذلك إلى جانب التزاماته بالثمن الذي رسا به المزاد وبالمصاريف التي اقتضتها إجراءات التطهير."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_920> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_920_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_920_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_920_19750926_OpEnact_118d198095> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_920_obligation_0_d233447d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_920_obligation_1_56e84d74> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "920" ;
    dzdoc:position 971 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_920_condition_0_e8b91946> ;
    dzdoc:usesTerm dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_939> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_939" ;
    dzdoc:fullText "يجوز الحصول على حق تخصيص بناء على حكم يثبت صلحا أو اتفاقا تم بين الطرفين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_939_permission_0_ab6244e6> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_939_right_0_71d3f6a2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_939> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_939_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_939_19750926_OpEnact_a97685eaa6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 939" ;
    dzdoc:position 990 ;
    dzdoc:usesTerm dzterm:right_of_allocation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_941> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_941" ;
    dzdoc:fullText "على الدائن الذي يريد أخذ تخصيص على عقارات مدينة أن يقدم عريضة بذلك إلى رئيس المحكمة التي تقع في دائرتها العقارات التي يريد التخصيص بها . وهذه العريضة يجب أن تكون مصحوبة بصورة رسمية من الحكم أو بشهادة من قلم الكتاب مدون فيها منطوق الحكم، وأن تشمل البيانات الآتية : اسم الدائن ولقبه ومهنته وموطنه الأصلي والموطن المختار الذي يعينه في البلدة التي يقع فيها مقر المحكمة، اسم المدين ولقبه ومهنته وموطنه، تاريخ الحكم وبيان المحكمة التي أصدرته، مقدار الدين، فإن كان الدين المذكور في الحكم غير محدد المقدار، تولى رئيس المحكمة تقديره مؤقتا وعين المبلغ الذي يؤخذ به حق التخصيص ، تعيين العقارات تعيينا دقيقا وبيان موقعها مع تقديم الأوراق الدالة على قيمتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_941> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_941_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_941_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_941_19750926_OpEnact_11e5b94978> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_941_obligation_0_bba4b7de>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_941_obligation_1_fbfdd15a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 941" ;
    dzdoc:position 992 ;
    dzdoc:usesTerm dzterm:court_president,
        dzterm:creditor,
        dzterm:debtor,
        dzterm:right_of_allocation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_942> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_942" ;
    dzdoc:fullText "يدون رئيس المحكمة في ذيل العريضة أمره بالتخصيص. وعليه عند الترخيص به أن يراعي مقدار الدين وقيمة العقارات المبينة بالعريضة بوجه التقريب، عند الاقتضاء ويجعل الاختصاص مقصورا على بعض هذه العقارات أو على واحد منها فقط أو على جزء من أحدها إذا رأى أن ذلك كاف لتأمين دفع أصل الدين والمصاريف المستحقة للدائنين . الأمر الصادر بالتخصيص واجب التنفيذ بقطع النظر عن جميع طرق الطعن."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_942> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_942_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_942_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_942_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_942_19750926_OpEnact_4edd2895c5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_942_obligation_0_325f0a07> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 942" ;
    dzdoc:position 993 ;
    dzdoc:usesTerm dzterm:court_president .

<https://legal.dz/resource/order/1975-09-26/75-58#art_958> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_958" ;
    dzdoc:fullText "يتولى الدائن المرتهن إدارة الشيء المرهون وعليه أن يبذل في ذلك من العناية ما يبذله الرجل المعتاد ، وليس له أن يغير من طريقة استغلال الشيء المرهون إلا برضاء الراهن ، و يجب عليه أن يبادر بإخطار الراهن عن كل أمر بمقتضى تدخله . فإذا أساء الدائن استعمال هذا الحق أو أدار الشيء إدارة سيئة أو ارتكب في ذلك إهمالا جسيما ، كان للراهن الحق في أن يطلب وضع الشيء تحت الحراسة أو أن يسترده مقابل دفع ما عليه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_958_right_0_18e0dc2c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_958> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_958_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_958_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_958_19750926_OpEnact_c041c20564> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_958_obligation_0_406bc677>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_958_obligation_1_bd7d957f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "958" ;
    dzdoc:position 1009 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_958_condition_0_fdc3e65f> ;
    dzdoc:usesTerm dzterm:دائن,
        dzterm:دائن_مرتهن,
        dzterm:راهن .

<https://legal.dz/resource/order/1975-09-26/75-58#art_985> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_1> ;
    dzdoc:eId "art_985" ;
    dzdoc:fullText "لا يحتج بحق الامتياز على من حاز المنقول بحسن نية. ويعتبر حائزا بحكم هذه المادة مؤجر العقار بالنسبة إلى المنقولات الموجودة في العين المؤجرة، وصاحب الفندق بالنسبة إلى الأمتعة التي يودعها النزلاء في فندقه. وإذا خشي الدائن لأسباب معقولة، تبديد المنقول المترتب عليه حق امتياز لمصلحته جاز له أن يطلب وضعه تحت الحراسة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_985_right_0_d01c5be6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_985> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_985_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_985_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_985_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_985_19750926_OpEnact_451bb6a7f9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "985" ;
    dzdoc:position 1036 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_985> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_985> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_985_condition_0_fc7cc985> ;
    dzdoc:usesTerm dzterm:privilege .

<https://legal.dz/resource/order/1975-09-26/75-58#art_994> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_994" ;
    dzdoc:fullText "المبالغ المترتبة على البذر والسماد وغيره من مواد التخصيب والمواد المقاومة للحشرات، والمبالغ المترتبة على أعمال الزراعة والحصاد، يكون لها امتياز على المحصول الذي صرفت في انتاجه وتكون لها جميعا مرتبة واحدة. وتستوفى هذه المبالغ من ثمن المحصول مباشرة بعد الحقوق المتقدمة الذكر. وكذلك يكون للمبالغ المستحقة في مقابل آلات الزراعة حق امتياز في نفس المرتبة على هذه الآلات ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_994_right_0_3535c9de>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_994_right_1_62dae960> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_994> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_994_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_994_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_994_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_994_19750926_OpEnact_df841f022a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "994" ;
    dzdoc:position 1045 .

