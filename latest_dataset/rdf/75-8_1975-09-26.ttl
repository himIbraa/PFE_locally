<https://legal.dz/resource/order/1975-09-26/75-58#art_322_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_322> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يجوز التنازل عن التقادم قبل ثبوت الحق فيه، كما لا يجوز الاتفاق على أن يتم التقادم في مدة تختلف عن المدة التي عينها القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_322_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_322> ;
