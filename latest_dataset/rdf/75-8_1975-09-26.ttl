<https://legal.dz/resource/order/1975-09-26/75-58#version_art_575> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الوكيل ملزم بتنفيذ الوكالة دون أن يجاوز الحدود المرسومة . لكن يسوغ له أن يتجاوز الحدود إذا تعذر عليه إخطار الموكل سلفا وكانت الظروف يغلب معها الظن بأنه ما كان يسع الموكل الا الموافقة على هذا التصرف و على الوكيل في هذه الحالة أن يخبر الموكل حالا بتجاوزه حدود الوكالة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_575_19750926_OpEnact_66c766779e> ;
    dzdoc:replacementText "الوكيل ملزم بتنفيذ الوكالة دون أن يجاوز الحدود المرسومة . لكن يسوغ له أن يتجاوز الحدود إذا تعذر عليه إخطار الموكل سلفا وكانت الظروف يغلب معها الظن بأنه ما كان يسع الموكل الا الموافقة على هذا التصرف و على الوكيل في هذه الحالة أن يخبر الموكل حالا بتجاوزه حدود الوكالة ."@ar ;
