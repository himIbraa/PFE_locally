    dzdoc:number "المادة 704" ;
    dzdoc:position 744 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_704_condition_0_4d86aa50> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_706> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_706" ;
    dzdoc:fullText "يمكن للجار الذي لم يسهم في نفقات التعلية أن يصبح شريكا في الجزء المعلي إذا هو دفع نصف ما انفق عليه وقيمة نصف الأرض التي تقوم عليها زيادة السمك إن كانت هناك زيادة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_706_permission_0_279d07f8> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_706_right_0_3cf01488> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_706> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_706_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_706_19750926_OpEnact_caf0515bfb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 706" ;
    dzdoc:position 746 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_706_condition_0_599d8f7c> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_708> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_708" ;
    dzdoc:fullText "ليس لجار أن يجبر جاره على تحويط ملكه ولا على التنازل عن جزء من حائط أو من الأرض التي يقوم عليها الحائط إلا في الحالة المذكورة في المادة 697 . غير أنه ليس لمالك الحائط أن يهدمه مختارا دون عذر قانوني إن كان هذا يضر الجار الذي يستتر ملكه بالحائط ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_708> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_708_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_708_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_708_19750926_OpEnact_081f7ea6f0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_708_obligation_0_68aed59d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_708_obligation_1_46b64f3a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 708" ;
    dzdoc:position 748 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_697> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_697> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_708_condition_0_72aa3539> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_716> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_716" ;
    dzdoc:fullText "يكون ملزما للجميع كل ما يستقر عليه رأي أغلبية الشركاء في أعمال الادارة المعتادة ، وتحسب الأغلبية على أساس قيمة الأنصباء. فإن لم توجد أغلبية فللمحكمة بناء على طلب أحد الشركاء، أن تتخذ التدابير اللازمة، ولها أن تعين عند الحاجة من يدير المال الشائع. وللأغلبية أيضا أن تختار مديرا ، كما أن لها أن تضع للادارة ولحسن الانتفاع بالمال الشائع نظاما يسري حتى على خلفاء الشركاء جميعا سواء أكان الخلف عاما، أو خاصا. وإذا تولى أحد الشركاء الادارة دون اعتراض من الباقين عد وكيلا عنهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_716> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_716_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_716_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_716_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_716_19750926_OpEnact_62a9c35f88> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_716_obligation_0_fee6c01c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 716" ;
    dzdoc:position 756 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_716_condition_0_d9fd4a6f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_716_condition_1_6f86e5b8> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_720> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_720" ;
    dzdoc:fullText "للشركاء الذين يملكون على الأقل ثلاثة أرباع (3/4) المال الشائع أن يقرروا التصرف فيه إذا استندوا في ذلك إلى أسباب قوية على أن يعلنوا بعقد غير قضائي قراراتهم إلى باقي الشركاء ولمن خالف من هؤلاء حق الرجوع إلى المحكمة خلال شهرين من وقت الاعلان ، وللمحكمة عندما تكون قسمة المال الشائع ضارة بمصالح الشركاء ، أن تقدر تبعا للظروف ما إذا كان التصرف واجبا."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_720_right_0_b7d4c371> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_720> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_720_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_720_19750926_OpEnact_292805edc6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_720_obligation_0_4269e555> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 720" ;
    dzdoc:position 760 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_720_condition_0_de1546b3>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_720_condition_1_c85975c7> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_744> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_744" ;
    dzdoc:fullText "تعتبر أجزاء خاصة ، أجزاء العقارات المبنية، أو غير المبنية والمملوكة بالتقسيم لكل واحد من الملاك الشركاء بغرض الاستعمال الشخصي والخاص. وتعد أجزاء خاصة : كل من تبليط الأرض والأرضية، والتغطية، الأسقف والاحواش باستثناء الجدران الأساسية في البناء، الحواجز الداخلية وأبوابها، أبواب المساطح والنوافذ والأبواب النافذة ومغالق الشبابيك والمصارع أو الستائر وتوابعها، قضبان النوافذ والدرابيز الحديدية للشرفات الطلاء الداخلي للحيطان والحواجز مهما كانت، الأنابيب الداخلية، ومنحنيات التوصيل الخاصة بالأجهزة من مجموع الحنفيات واللوازم المتصلة بها، إطار وأعلى المداخن والخزائن، والخزائن المموهة، الأدوات الصحية للحمامات والمغسلة والمرحاض، أدوات المطبخ، الأدوات الخاصة للتدفئة والماء الساخن التي يمكن أن توجد داخل المحل الخاص. وتعتبر مشتركة بين الشركاء المتجاورين الحواجز أو الحيطان الفاصلة في المحلات الخاصة دون الجدران الأساسية في البناء."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_744_permission_0_46644e79> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_744> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_744_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_744_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_744_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_744_19750926_OpEnact_4611f6707c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 744" ;
    dzdoc:position 784 ;
    dzdoc:usesTerm dzterm:private_parts .

<https://legal.dz/resource/order/1975-09-26/75-58#art_745> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_745" ;
    dzdoc:fullText "تعتبر أجزاء مشتركة أجزاء العقارات المبنية وغير المبنية التي يملكها على الشيوع كافة الملاكين المشتركين بالنسبة لنصيب كل واحد منهم في كل حصة لاستعمال أو منفعة جميع الملاكين المشتركين أو لأكبر عدد منهم. وتعد أجزاء مشتركة ما يلي : الأرض والأفنية، والبساتين، والجنائن، والمداخل، الجدران الأساسية في البناء، وأدوات التجهيز المشتركة بما فيها أجزاء الأنابيب التابعة لها والتي تمر على المحلات الخاصة الخزائن وغلاف ورؤوس المداخل المعدة للاستعمال المشترك، الرواق الخارجي، والدرابيز والأسطح ولو خصصت كلها أو بعضها للاستعمال الخاص من طرف شريك واحد، المحلات المستعملة للمصالح المشتركة، القاعات الكبرى وممرات الدخول والدرج والمصاعد. وتعد حقوق بالتبعية للأجزاء المشتركة ما يلي : حق تعلية العمارة المعدة للاستعمال المشترك، أو المحتوية على عدة محلات تكون أجزاء خاصة مختلفة ، الحق في بناء عمارات جديدة بالأفنية، والبساتين، أو الجنائن التي تكون أجزاء مشتركة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_745_right_0_a554f660>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_745_right_1_728a3fac> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_745> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_745_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_745_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_745_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_745_19750926_OpEnact_76fbb8628a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 745" ;
    dzdoc:position 785 ;
    dzdoc:usesTerm dzterm:common_parts .

<https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_750_bis_1" ;
    dzdoc:fullText "في حالة امتناع الأشخاص المعنيين عن دفع التكاليف المستحقة عليهم بصدد النوع الأول أو الثاني ، يمكن للمتصرف أن يلجأ إلى اجراءات التحصيل الجبري ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_1_permission_0_bc828951> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_1_right_0_d0463503> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_bis_1_19750926_OpEnact_12a3b1a4fc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 750 مكرر 1" ;
    dzdoc:position 792 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_1_condition_0_723e5abf> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_756_bis_1" ;
    dzdoc:fullText "إذا حدث هدم كلي أو جزئي فإنه يمكن للشركاء المالكين للاجزاء المتكون منها المبنى المهدم أن يقرروا بأغلبية الاصوات تجديد المبنى أو إصلاح الجزء الذي لحقه الضرر. وتخصص بالدرجة الاولى التعويضات الواجبة للعقار المهدم لتجديد البناء وذلك مع مراعاة حقوق الدائنين المسجلين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_1_permission_0_0a1e3d87> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_1_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_1_19750926_OpEnact_9219e414c2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_1_obligation_0_b03367a6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 756 مكرر 1" ;
    dzdoc:position 801 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_1_condition_0_70ec1000> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_756_bis_3" ;
    dzdoc:fullText "ينتخب المتصرف من طرف الجمعية التي يجوز لها أن تفصله عند الاقتضاء. وفي حالة التقصير يعين المتصرف تلقائيا من طرف رئيس المجلس الشعبي البلدي للمكان الذي يوجد فيه العقار ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_3_permission_0_4c3c2d7a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_3_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_3_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_3_19750926_OpEnact_3aba82d2f4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_3_obligation_0_ff7bc656> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 756 مكرر 3" ;
