    dznorm:conditionText "إذا تبين أن قدر الشيء المبيع يزيد على ما ذكر بالعقد، وكان الثمن مقدرا بحسب الوحدة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_365> ;
