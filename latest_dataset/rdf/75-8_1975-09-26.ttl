    dznorm:conditionText "بشرط أن لا تكون قد تمت ولم ينقض عام واحد على البدء في العمل الذي يكون من شأنه أن يحدث الضرر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_821> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_821_condition_0_475da818_role_381c9ce7c8> a dznorm:Role ;
    rdfs:label "البدء في العمل الذي"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "بشرط أن لا تكون قد تمت ولم ينقض عام واحد على البدء في العمل الذي يكون من شأنه أن يحدث الضرر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_821> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_821_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_821> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز لمن حاز عقارا واستمر حائزا له مدة سنة كاملة وخشي لأسباب معقولة التعرض له من جراء أعمال جديدة تهدد حيازته أن يرفع الأمر إلى القاضي طالبا وقف هذه الأعمال بشرط أن لا تكون قد تمت ولم ينقض عام واحد على البدء في العمل الذي يكون من شأنه أن يحدث الضرر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_821_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_821> ;
    dzdoc:position 1 ;
    dzdoc:text "وللقاضي أن يمنع استمرار الأعمال أو أن يأذن في استمرارها وفي كلتا الحالتين يجوز للقاضي أن يأمر بتقديم كفالة مناسبة تكون في حالة صدور الحكم بالوقف ضمانا لإصلاح الضرر الناشئ من هذا الوقف إذا تبين بحكم نهائي أن الاعتراض على استمرار الأعمال كان على غير أساس وتكون في حالة الحكم باستمرار الأعمال ضمانا لازالة هذه الأعمال كلها أو بعضها للتعويض عن الضرر الذي يصيب الحائز إذا حصل على حكم نهائي في مصلحته."@ar .

