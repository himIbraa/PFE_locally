<https://legal.dz/resource/order/1975-09-26/75-58#version_art_316> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يسري التقادم كلما وجد مانع مبررا شرعا يمنع الدائن من المطالبة بحقه كما لا يسري فيما بين الأصيل و النائب . ولا يسري التقادم الذي تنقضي مدته عن خمس (5) سنوات في حق عديمي الأهلية و الغائبين و المحكوم عليهم بعقوبات جنائية إذا لم يكن لهم نائب قانوني . ولا يسري التقادم الذي تزيد مدته على خمس (5) سنوات في حق الأشخاص المذكورين في الفقرة السابقة ولو كان لهم نائب قانوني طيلة مدة عدم أهليتهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_316_19750926_OpEnact_376788a0eb> ;
    dzdoc:replacementText "لا يسري التقادم كلما وجد مانع مبررا شرعا يمنع الدائن من المطالبة بحقه كما لا يسري فيما بين الأصيل و النائب . ولا يسري التقادم الذي تنقضي مدته عن خمس (5) سنوات في حق عديمي الأهلية و الغائبين و المحكوم عليهم بعقوبات جنائية إذا لم يكن لهم نائب قانوني . ولا يسري التقادم الذي تزيد مدته على خمس (5) سنوات في حق الأشخاص المذكورين في الفقرة السابقة ولو كان لهم نائب قانوني طيلة مدة عدم أهليتهم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_316> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
