<https://legal.dz/resource/order/1975-09-26/75-58#art_999_condition_0_0d20ffa6> a dznorm:Condition ;
    dznorm:conditionText "إذا وقع التقييد في ظرف شهرين من تاريخ البيع"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_999> ;
