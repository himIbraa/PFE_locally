    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_755> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_19750926_OpEnact_6a0f4c2b9e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_756> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_756> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تضمن جميع الديون المستحقة للجمعية على كل شريك في الملكية برهن قانوني على قسمته وتستفيد هذه الديون بالاضافة إلى ذلك من الامتيازات الخاصة بمؤجر العقار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_19750926_OpEnact_3c7c3761aa> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "للشركاء الحق في طلب التعويض إذا حصل لهم ضرر بسبب القيام بالبناءات سواء كان القيام بهذه الأعمال قد أدى إلى نقصان من قيمة أملاكهم أو أدت هذه الأعمال إلى منعهم من الانتفاع بأملاكهم منعا بليغا ولو مؤقتا أو حصل لهم من جراء هذه الأعمال إصابات فيما يملكون . وهذا التعويض يترتب على جميع الشركاء في الملكية و يوزع بقدر حقوق كل واحد في الأجزاء المشتركة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_1_19750926_OpEnact_9219e414c2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_1> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا حدث هدم كلي أو جزئي فإنه يمكن للشركاء المالكين للاجزاء المتكون منها المبنى المهدم أن يقرروا بأغلبية الاصوات تجديد المبنى أو إصلاح الجزء الذي لحقه الضرر. وتخصص بالدرجة الاولى التعويضات الواجبة للعقار المهدم لتجديد البناء وذلك مع مراعاة حقوق الدائنين المسجلين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_2_19750926_OpEnact_0ee2cf6a73> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_2> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تشكل جماعة الشركاء في الملكية أو الشاغلين لها جمعية تتمتع بالشخصية المدنية . تتولى الجمعية إدارة العقار والمحافظة عليه وكذا تسيير الأجزاء المشتركة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_3_19750926_OpEnact_3aba82d2f4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_3> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_3> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_3> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينتخب المتصرف من طرف الجمعية التي يجوز لها أن تفصله عند الاقتضاء. وفي حالة التقصير يعين المتصرف تلقائيا من طرف رئيس المجلس الشعبي البلدي للمكان الذي يوجد فيه العقار ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_757_19750926_OpEnact_7ced3216fe> a dzdoc:ArticleVersion ;
