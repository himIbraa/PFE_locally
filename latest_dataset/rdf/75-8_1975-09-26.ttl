<https://legal.dz/resource/order/1975-09-26/75-58#version_art_291> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يترتب على التجديد انقضاء الالتزام الأصلي بتوابعه، وانشاء التزام جديد مكانه. ولا تنتقل التأمينات التي تكفل تنفيذ الالتزام الأصلي الا بنص في القانون أو الا إذا تبين من الاتفاق أو من الظروف أن نية المتعاقدين انصرفت إلى غير ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_291_19750926_OpEnact_0435d4a041> ;
    dzdoc:replacementText "يترتب على التجديد انقضاء الالتزام الأصلي بتوابعه، وانشاء التزام جديد مكانه. ولا تنتقل التأمينات التي تكفل تنفيذ الالتزام الأصلي الا بنص في القانون أو الا إذا تبين من الاتفاق أو من الظروف أن نية المتعاقدين انصرفت إلى غير ذلك."@ar ;
