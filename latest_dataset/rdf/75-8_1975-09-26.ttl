<https://legal.dz/resource/order/1975-09-26/75-58#art_35_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_35> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر أقارب أحد الزوجين في نفس القرابة والدرجة بالنسبة إلى الزوج الآخر."@ar .

