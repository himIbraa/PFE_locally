<https://legal.dz/resource/order/1975-09-26/75-58#art_422_condition_1_89fa6e5e> a dznorm:Condition ;
    dznorm:conditionText "إذا كانت الحصة مجرد انتفاع بالمال"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_422> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_422_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_422> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كانت حصة الشريك حق ملكية أو حق منفعة أو أي حق عيني آخر فإن أحكام البيع هي التي تسري فيما يخص ضمان الحصة إذا هلكت أو استحقت أو ظهر فيها عيب أو نقص أما إذا كانت الحصة مجرد انتفاع بالمال فإن أحكام الإيجار هي التي تسري في ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_423_condition_0_3adb78b2> a dznorm:Condition ;
