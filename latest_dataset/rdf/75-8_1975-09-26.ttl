<https://legal.dz/resource/order/1975-09-26/75-58#version_art_568> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا هلك الشيء بسبب حادث مفاجئ قبل تسليمه ل رب العمل فليس ل المقاول أن يطالب لا بثمن عمله ولا برد نفقاته، ويكون هلاك المادة على من قام بتوريدها من الطرفين. أما إذا كان المقاول قد أعذر بتسليم الشيء أو كان هلاك الشيء أو تلفه قبل التسليم راجعا إلى خطئه ، وجب عليه أن يعوض رب العمل . فإذا كان رب العمل هو الذي أعذر بأن يتسلم الشيء أو كان هلاك الشيء أو تلفه راجعا إلى خطإ منه أو إلى عيب في المادة التي قام بتوريدها كان هلاك المادة عليه وكان ل لمقاول الحق في الأجر وفي إصلاح الضرر عند الاقتضاء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_568_19750926_OpEnact_f8a937d3ba> ;
    dzdoc:replacementText "إذا هلك الشيء بسبب حادث مفاجئ قبل تسليمه ل رب العمل فليس ل المقاول أن يطالب لا بثمن عمله ولا برد نفقاته، ويكون هلاك المادة على من قام بتوريدها من الطرفين. أما إذا كان المقاول قد أعذر بتسليم الشيء أو كان هلاك الشيء أو تلفه قبل التسليم راجعا إلى خطئه ، وجب عليه أن يعوض رب العمل . فإذا كان رب العمل هو الذي أعذر بأن يتسلم الشيء أو كان هلاك الشيء أو تلفه راجعا إلى خطإ منه أو إلى عيب في المادة التي قام بتوريدها كان هلاك المادة عليه وكان ل لمقاول الحق في الأجر وفي إصلاح الضرر عند الاقتضاء ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_568> ;
