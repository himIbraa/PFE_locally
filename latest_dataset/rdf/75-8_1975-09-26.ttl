<https://legal.dz/resource/order/1975-09-26/75-58#art_18_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_18> ;
    dzdoc:position 3 ;
