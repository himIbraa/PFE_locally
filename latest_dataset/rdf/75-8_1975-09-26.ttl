    skos:prefLabel "العقد"@ar,
        "عقد المقاولة"@ar .

dzterm:guarantor a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الكفيل"@ar,
        "للكفيل"@ar,
        "للكفيل المتضامن"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_145> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_145" ;
    dzdoc:fullText "لا يمكن لـ الدائن أن يطالب بحق مؤجل قبل حلول أجله أما إذا تم الوفاء معجلا فلا يجوز استرداد ما دفع حتى ولو كان المدين يجهل الأجل. وفي هذه الحالة يجوز للمدين أن يطالب في حدود الضرر اللاحق به برد مبلغ الاثراء الذي حصل عليه الدائن بسبب هذا الوفاء المعجل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_145_permission_0_ea0c314f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_145_permission_1_db3c665e> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_145_right_0_fb9d49e1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_145> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_145_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_145_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_145_19750926_OpEnact_5b6aa50710> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "145" ;
    dzdoc:position 157 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_145_condition_0_523befc5> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_244> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_244" ;
    dzdoc:fullText "إذا كانت الحوالة بعوض فلا يضمن المحيل الا وجود الحق المحال به وقت الحوالة ، ما لم يكن هناك اتفاق يقضي بغير ذلك . أما إذا كانت الحوالة بغير عوض فلا يكون المحيل ضامنا لوجود الحق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_244> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_244_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_244_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_244_19750926_OpEnact_1784f76eb8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 244" ;
    dzdoc:position 257 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_244_condition_0_c01c233f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_244_condition_1_b3781d98>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_244_condition_2_5953a7ae> ;
    dzdoc:usesTerm dzterm:assignment,
        dzterm:assignor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_253> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_2> ;
    dzdoc:eId "art_253" ;
    dzdoc:fullText "ما دام الدائن لم يحدد موقفه من الحوالة اقرارا أو رفضا ، كان المحال عليه ملزما قبل المدين الأصلي بالوفاء للدائن في الوقت المناسب ما لم يكن هناك اتفاق يقضي بغير ذلك، ويسري هذا الحكم ولو رفض الدائن الحوالة. غير أنه لا يجوز للمدين الأصلي أن يطالب المحال عليه بالوفاء للدائن ما دام لم يقم هو بما التزم به قبل المحال عليه بمقتضى عقد الحوالة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_253_permission_0_349abdaf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_253> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_253_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_253_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_253_19750926_OpEnact_4ca49f23fa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_253_obligation_0_a21fccd1> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_253_prohibition_0_349abdaf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "253" ;
    dzdoc:position 266 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_253_condition_0_0c852834>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_253_condition_1_900f3c3c> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_349> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_5> ;
    dzdoc:eId "art_349" ;
    dzdoc:fullText "لا يجوز للخصم الذي وجه إليه القاضي اليمين المتممة أن يردها على خصمه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_349_permission_0_8f657596> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_349> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_349_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_349_19750926_OpEnact_d83dc200a1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_349_obligation_0_9b6745ec> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_349_prohibition_0_8f657596> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "349" ;
    dzdoc:position 373 ;
    dzdoc:usesTerm dzterm:supplementary_oath .

<https://legal.dz/resource/order/1975-09-26/75-58#art_350> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_5> ;
    dzdoc:eId "art_350" ;
    dzdoc:fullText "لا يجوز للقاضي أن يوجه إلى المدعي اليمين المتممة لتحديد قيمة المدعى به إلا إذا استحال تحديد هذه القيمة بطريقة أخرى . ويحدد القاضي حتى في هذه الحالة حدا أقصى للقيمة التي يصدق فيه المدعي بيمينه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_350_permission_0_801ae28a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_350> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_350_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_350_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_350_19750926_OpEnact_88d896bb1a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_350_obligation_0_776e1952>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_350_obligation_1_9d6a3958> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_350_prohibition_0_801ae28a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "350" ;
    dzdoc:position 374 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_350_condition_0_fa44c7da> ;
    dzdoc:usesTerm dzterm:supplementary_oath .

<https://legal.dz/resource/order/1975-09-26/75-58#art_380> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_380" ;
    dzdoc:fullText "إذا تسلم المشتري المبيع وجب عليه التحقق من حالته عندما يتمكن من ذلك حسب قواعد التعامل الجارية ، فإذا كشف عيبا يضمنه البائع وجب عليه أن يخبر هذا الأخير في أجل مقبول عادة فإن لم يفعل اعتبر راضيا بالبيع. غير أنه إذا كان العيب مما لا يظهر بطريق الاستعمال العادي وجب على المشتري بمجرد ظهور العيب أن يخبر البائع بذلك والا اعتبر راضيا بالمبيع بما فيه من عيوب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_380> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_380_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_380_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_380_19750926_OpEnact_f375fce722> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_380_obligation_0_fd9068e2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_380_obligation_1_73a574a8>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_380_obligation_2_ca267d78> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 380" ;
    dzdoc:position 404 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_380_condition_0_798d51eb>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_380_condition_1_2d6529eb>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_380_condition_2_4c5548a1> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_410> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_410" ;
    dzdoc:fullText "لا يجوز لمن ينوب عن غيره بمقتضى اتفاق أو نص قانوني أو أمر من السلطة المختصة أن يشتري باسمه مباشرة أو باسم مستعار ولو بطريق المزاد العلني ما كلف ببيعه بموجب النيابة كل ذلك ما لم تاذن به السلطة القضائية مع مراعاة الأحكام الخاصة والواردة في نصوص قانونية أخرى."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_410_permission_0_7f8a1bd7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_410> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_410_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_410_19750926_OpEnact_504f8bf7ef> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_410_obligation_0_0b25b46d> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_410_prohibition_0_7f8a1bd7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 410" ;
    dzdoc:position 434 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_410_condition_0_5b2caaea> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_432> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_3> ;
    dzdoc:eId "art_432" ;
    dzdoc:fullText "على الشريك أن يمتنع من أي نشاط يلحق ضررا بـ الشركة أو يعاكس الغاية التي انشئت لاجلها . وعليه أن يسهر ويحافظ على مصالح الشركة مثلما يفعله في تدبير مصالحه الخاصة ، الا إذا كان منتدبا للادارة مقابل أجرة وفي هذه الحالة يجب أن لا يقل حرصه عن عناية الرجل المعتاد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_432> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_432_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_432_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_432_19750926_OpEnact_13c72fe48e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_432_obligation_0_e4c3c2ec>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_432_obligation_1_7af4d9b3>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_432_obligation_2_6b0e54fa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "432" ;
    dzdoc:position 456 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_432_condition_0_65563ee5> ;
    dzdoc:usesTerm dzterm:company,
        dzterm:partner .

<https://legal.dz/resource/order/1975-09-26/75-58#art_436> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_3> ;
    dzdoc:eId "art_436" ;
    dzdoc:fullText "إذا كان لأحد الشركاء دائنون شخصيون ، فليس لهم أثناء قيام الشركة أن يتقاضوا ديونهم الا من نصيب ذلك الشريك في الارباح دون نصيبه في رأس المال، ولكن لهم أن يتقاضوا ديونهم من نصيب مدينهم في أموال الشركة بعد تصفيتها وطرح ديونها على انه يجوز لهم قبل التصفية توقيع الحجز التحفظي على نصيب مدينهم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_436_permission_0_fb081d9b> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_436_right_0_9685cb09>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_436_right_1_dda4796a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_436> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_436_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_436_19750926_OpEnact_be79dd543a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "436" ;
    dzdoc:position 460 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_436_condition_0_9f31c890> ;
    dzdoc:usesTerm dzterm:company,
        dzterm:partner,
        dzterm:partners .

<https://legal.dz/resource/order/1975-09-26/75-58#art_468> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_468" ;
    dzdoc:fullText "لا يجوز لمن لا يملك الا حق القيام بأعمال الإدارة أن يعقد ايجارا تزيد مدته على ثلاث (3) سنوات ما لم يوجد نص يقضي بخلاف ذلك. إذا عقد الإيجار لمدة أطول من ذلك تخفض المدة إلى ثلاث (3) سنوات."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_468_permission_0_908aba13> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_468> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_468_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_468_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_468_19750926_OpEnact_8cbb46213a> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_468_prohibition_0_908aba13> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 468" ;
    dzdoc:position 493 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_468_condition_0_66b0fe4a> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_469_bis" ;
    dzdoc:fullText "لا يجوز لصاحب حق الاستعمال وحق السكن أن يعقد إيجارا ما لم ينص العقد المنشئ لحقه صراحة على ذلك . ينتهي الإيجار بقوة القانون بانقضاء حق الاستعمال وحق السكن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_permission_0_81339676> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_para_0>,
