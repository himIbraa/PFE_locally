<https://legal.dz/resource/order/1975-09-26/75-58#art_257_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_257> ;
    dzdoc:position 0 ;
    dzdoc:text "تتم حوالة الدين باتفاق بين الدائن والمحال عليه على أن يتقرر فيه أن هذا الأخير يحل محل المدين الأصلي في التزامه، وفي هذه الحالة تسري أحكام المادتين 254 و 256."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_258_condition_0_6914eb2c> a dznorm:Condition ;
