<https://legal.dz/resource/order/1975-09-26/75-58#version_art_935> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يترتب على بيع عقار مرهون انتقال الدين إلى المشتري إلا إذا وجد اتفاق صريح على ذلك . وإذا اتفق البائع والمشتري على تحويل الدين وكان عقد البيع مقيدا ، وجب على الدائن، بعد الاعلان الموجه إليه بذلك بطريقة قانونية، أن يوافق على التحويل أو يرفضه في أجل لا يتجاوز ستة (6) أشهر و إذا سكت إلى انقضاء الأجل ، كان سكوته بمثابة تصديق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_935_19750926_OpEnact_12aa32dd16> ;
    dzdoc:replacementText "لا يترتب على بيع عقار مرهون انتقال الدين إلى المشتري إلا إذا وجد اتفاق صريح على ذلك . وإذا اتفق البائع والمشتري على تحويل الدين وكان عقد البيع مقيدا ، وجب على الدائن، بعد الاعلان الموجه إليه بذلك بطريقة قانونية، أن يوافق على التحويل أو يرفضه في أجل لا يتجاوز ستة (6) أشهر و إذا سكت إلى انقضاء الأجل ، كان سكوته بمثابة تصديق."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_935> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_935> ;
