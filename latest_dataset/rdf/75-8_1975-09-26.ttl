<https://legal.dz/resource/order/1975-09-26/75-58#art_886_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_886> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يجوز أن ينعقد الرهن إلا على عقار ما لم يوجد نص يقضي بغير ذلك."@ar .

