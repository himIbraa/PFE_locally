<https://legal.dz/resource/order/1975-09-26/75-58#version_art_990> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المصاريف القضائية التي انفقت لمصلحة جميع الدائنين في حفظ أموال المدين وبيعها، لها امتياز على ثمن هذه الأموال . وتستوفى هذه المصاريف قبل أي حق آخر ولو كان ممتازا أو مضمونا برهان رسمي بما في ذلك حقوق الدائنين الذين انفقت المصاريف في مصلحتهم. وتتقدم المصاريف التي انفقت في بيع الأموال على تلك التي أنفقت في اجراءات التوزيع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_990_19750926_OpEnact_601850ab73> ;
    dzdoc:replacementText "المصاريف القضائية التي انفقت لمصلحة جميع الدائنين في حفظ أموال المدين وبيعها، لها امتياز على ثمن هذه الأموال . وتستوفى هذه المصاريف قبل أي حق آخر ولو كان ممتازا أو مضمونا برهان رسمي بما في ذلك حقوق الدائنين الذين انفقت المصاريف في مصلحتهم. وتتقدم المصاريف التي انفقت في بيع الأموال على تلك التي أنفقت في اجراءات التوزيع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_990> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
