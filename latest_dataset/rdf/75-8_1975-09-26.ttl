<https://legal.dz/resource/order/1975-09-26/75-58#version_art_204> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يكون الالتزام قائما إذا علق على شرط غير ممكن، أو على شرط مخالف للآداب أو النظام العام ، هذا إذا كان الشرط واقفا اما إذا كان الشرط فاسخا فهو نفسه الذي يعتبر غير قائم. غير أنه لا يقوم الالتزام الذي علق على شرط فاسخ مخالف للآداب أو النظام العام، إذا كان هذا الشرط هو السبب الموجب للالتزام ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_204_19750926_OpEnact_c23729b8fe> ;
    dzdoc:replacementText "لا يكون الالتزام قائما إذا علق على شرط غير ممكن، أو على شرط مخالف للآداب أو النظام العام ، هذا إذا كان الشرط واقفا اما إذا كان الشرط فاسخا فهو نفسه الذي يعتبر غير قائم. غير أنه لا يقوم الالتزام الذي علق على شرط فاسخ مخالف للآداب أو النظام العام، إذا كان هذا الشرط هو السبب الموجب للالتزام ."@ar ;
