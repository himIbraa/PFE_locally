<https://legal.dz/resource/order/1975-09-26/75-58#version_art_969> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يشترط لنفاذ رهن المنقول في حق الغير إلى جانب انتقال الحيازة إلى الدائن ، أن يدون العقد في ورقة ثابتة التاريخ يبين فيها المبلغ المضمون بالرهن والعين المرهونة بيانا كافيا ، ويحدد هذا التاريخ الثابت مرتبة الدائن المرتهن ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_969_19750926_OpEnact_7fdaa93bde> ;
