<https://legal.dz/resource/order/1975-09-26/75-58#version_art_71> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الاتفاق الذي يعد له كلا المتعاقدين أو أحدهما بإبرام عقد معين في المستقبل لا يكون له أثر الا إذا عينت جميع المسائل الجوهرية للعقد المراد إبرامه، والمدة التي يجب إبرامه فيها . وإذا اشترط القانون لتمام العقد استيفاء شكل معين فهذا الشكل يطبق أيضا على الاتفاق المتضمن الوعد بالتعاقد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_71_19750926_OpEnact_8bfd0f72a8> ;
    dzdoc:replacementText "الاتفاق الذي يعد له كلا المتعاقدين أو أحدهما بإبرام عقد معين في المستقبل لا يكون له أثر الا إذا عينت جميع المسائل الجوهرية للعقد المراد إبرامه، والمدة التي يجب إبرامه فيها . وإذا اشترط القانون لتمام العقد استيفاء شكل معين فهذا الشكل يطبق أيضا على الاتفاق المتضمن الوعد بالتعاقد ."@ar ;
