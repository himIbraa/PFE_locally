<https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للشركاء الحق في طلب التعويض إذا حصل لهم ضرر بسبب القيام بالبناءات سواء كان القيام بهذه الأعمال قد أدى إلى نقصان من قيمة أملاكهم أو أدت هذه الأعمال إلى منعهم من الانتفاع بأملاكهم منعا بليغا ولو مؤقتا أو حصل لهم من جراء هذه الأعمال إصابات فيما يملكون . وهذا التعويض يترتب على جميع الشركاء في الملكية و يوزع بقدر حقوق كل واحد في الأجزاء المشتركة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_19750926_OpEnact_3c7c3761aa> ;
    dzdoc:replacementText "للشركاء الحق في طلب التعويض إذا حصل لهم ضرر بسبب القيام بالبناءات سواء كان القيام بهذه الأعمال قد أدى إلى نقصان من قيمة أملاكهم أو أدت هذه الأعمال إلى منعهم من الانتفاع بأملاكهم منعا بليغا ولو مؤقتا أو حصل لهم من جراء هذه الأعمال إصابات فيما يملكون . وهذا التعويض يترتب على جميع الشركاء في الملكية و يوزع بقدر حقوق كل واحد في الأجزاء المشتركة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
