<https://legal.dz/resource/order/1975-09-26/75-58#art_574_obligation_0_e8cae5b8> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_574> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا بد من وكالة خاصة في كل عمل ليس من أعمال الادارة"@ar ;
    dznorm:sourceArticle "art_574" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_574_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_574> ;
    dzdoc:position 0 ;
    dzdoc:text "لا بد من وكالة خاصة في كل عمل ليس من أعمال الادارة لا سيما في البيع والرهن والتبرع والصلح والاقرار والتحكيم وتوجيه اليمين والمرافعة أمام القضاء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_574_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_574> ;
    dzdoc:position 1 ;
    dzdoc:text "الوكالة الخاصة في نوع معين من أنواع الأعمال القانونية تصح ولو لم يعين محل هذا العمل على وجه التخصيص، الا إذا كان العمل من التبرعات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_574_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_574> ;
    dzdoc:position 2 ;
    dzdoc:text "الوكالة الخاصة لا تخول للوكيل الا القدرة على مباشرة الأمور المحددة فيها وما تقتضيه هذه الأمور من توابع ضرورية وفقا لطبيعة كل أمر وللعرف الجاري."@ar .

