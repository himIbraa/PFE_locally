<https://legal.dz/resource/order/1975-09-26/75-58#art_791> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_791" ;
    dzdoc:fullText "إذا التصق منقولان لمالكين مختلفين بحيث لا يمكن فصلهما دون تلف قضت المحكمة أن لم يكن هناك اتفاق بين المالكين مسترشدة بقواعد العدالة ومراعية في ذلك الضرر الذي حدث وحالة الطرفين وحسن نية كل منهما."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_791_permission_0_2ebeba81> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_791> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_791_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_791_19750926_OpEnact_9ba49ff9be> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 791" ;
    dzdoc:position 842 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_791_condition_0_141bdd35>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_791_condition_1_49e3e2dc> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_804> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_804" ;
    dzdoc:fullText "يحل الشفيع بالنسبة إلى البائع محل المشتري في جميع حقوقه والتزاماته الا أنه لا يمكن له الانتفاع بالأجل المضروب للمشتري عن دفع الثمن الا برضاء البائع ، ولا يرجع الشفيع على البائع إذا ما استرد الغير العقار بعد الشفعة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_804_permission_0_ddadaa27> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_804> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_804_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_804_19750926_OpEnact_b88f720c65> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "804" ;
    dzdoc:position 855 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_804_condition_0_3ed62e11> ;
    dzdoc:usesTerm dzterm:preemptor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_805> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_805" ;
    dzdoc:fullText "إذا بنى المشتري في العقار المشفوع أو غرس فيه أشجارا قبل الاعلان بالرغبة في الشفعة كان الشفيع ملزما تبعا لما يختاره المشتري أن يدفع له إما المبلغ الذي انفقه أو مقدار ما زاد في قيمة العقار بسبب البناء أو الغراس . أما إذا حصل البناء أو الغراس بعد الاعلان بالرغبة في الشفعة كان للشفيع أن يطلب الازالة وإذا اختار أن يستبقي البناء أو الغراس فلا يلزم الا بدفع قيمة أدوات البناء وأجرة العمل أو نفقات الغراس."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_805_right_0_748159dd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_805> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_805_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_805_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_805_19750926_OpEnact_d3b6463d02> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_805_obligation_0_87b9a03e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "805" ;
    dzdoc:position 856 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_805_condition_0_bc53e85e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_805_condition_1_55b4f60c> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_812> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_812" ;
    dzdoc:fullText "يجوز نقل الحيازة دون تسليم مادي إذا استمر الحائز واضعا يده لحساب من يخلفه في الحيازة أو استمر الخلف واضعا يده ولكن لحساب نفسه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_812_permission_0_5e027a63> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_812_right_0_8ccd3476> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_812> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_812_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_812_19750926_OpEnact_f1258aca8c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 812" ;
    dzdoc:position 863 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_812_condition_0_d49b9b12> ;
    dzdoc:usesTerm dzterm:possession .

<https://legal.dz/resource/order/1975-09-26/75-58#art_849> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_1> ;
    dzdoc:eId "art_849" ;
    dzdoc:fullText "يجب على المنتفع أن يبذل من العناية في المحافظة على الشيء ما يبذله الشخص العادي ، وهو مسؤول عن هلاك الشيء ولو بسبب لا ينسب إليه أن تأخر عن رده إلى مالكه بعد انتهاء حق الانتفاع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_849> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_849_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_849_19750926_OpEnact_37ffe7788d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_849_obligation_0_7f371920> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 849" ;
    dzdoc:position 900 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_849_condition_0_b18ae67b> ;
    dzdoc:usesTerm dzterm:usufruct .

<https://legal.dz/resource/order/1975-09-26/75-58#art_876> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_2> ;
    dzdoc:eId "art_876" ;
    dzdoc:fullText "إذا جزئ العقار المرتفق بقي الارتفاق مستحقا لكل جزء منه ما لم يزد ذلك عبء تكاليف العقار المرتفق به . غیر أنه إذا كان الارتفاق لا يفيد في الواقع الا جزءا من هذه الأجزاء جاز لمالك العقار المرتفق به أن يطلب زوال هذا الارتفاق عن الأجزاء الأخرى ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_876_right_0_651757e6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_876> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_876_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_876_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_876_19750926_OpEnact_7d3467df02> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_876_obligation_0_7c0128cb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "876" ;
    dzdoc:position 927 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_876_condition_0_3d691bbf>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_876_condition_1_32a847a1> ;
    dzdoc:usesTerm dzterm:property .

<https://legal.dz/resource/order/1975-09-26/75-58#art_882> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:mortgage ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1> ;
    dzdoc:eId "art_882" ;
    dzdoc:fullText "الرهن الرسمي عقد يكسب به الدائن حقا عينيا، على عقار لوفاء دينه ، يكون له بمقتضاه أن يتقدم على الدائنين التالين له في المرتبة في استيفاء حقه من ثمن ذلك العقار في أي يد كان ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_882_right_0_93242647>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_882_right_1_1a3f0e93> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_882> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_882_defocc_41df9183279f> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_882_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_882_19750926_OpEnact_9444717442> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "882" ;
    dzdoc:position 933 ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_884> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_1> ;
    dzdoc:eId "art_884" ;
    dzdoc:fullText "يجوز أن يكون الراهن هو المدين نفسه أو شخصا آخر يقدم رهنا لمصلحة المدين. وفي كلتا الحالتين يجب أن يكون الراهن مالكا للعقار المرهون وأهلا للتصرف فيه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_884_permission_0_65b4119b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_884> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_884_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_884_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_884_19750926_OpEnact_7e4f34ed6d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_884_obligation_0_fc98222b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 884" ;
    dzdoc:position 935 ;
    dzdoc:usesTerm dzterm:mortgagor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_894> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_894" ;
    dzdoc:fullText "يجوز للراهن أن يتصرف في العقار المرهون ، على أن أي تصرف يصدر منه لا يؤثر في حق الدائن المرتهن ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_894_permission_0_95f1c677> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_894_right_0_3451f0b8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_894> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_894_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_894_19750926_OpEnact_d6155609d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 894" ;
    dzdoc:position 945 ;
    dzdoc:usesTerm dzterm:mortgaged_property,
        dzterm:mortgagee,
        dzterm:mortgagor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_904> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_904" ;
    dzdoc:fullText "لا يكون الرهن نافذا في حق الغير إلا إذا قيد العقد أو الحكم المثبت للرهن قبل أن يكسب هذا الغير حقا عينيا على العقار ، وذلك دون إخلال بالأحكام المقررة في الافلاس. لا يصح التمسك تجاه الغير بتحويل حق مضمون بقيد، ولا التمسك بالحق الناشئ من حلول شخص محل الدائن في هذا الحق بحكم القانون أو بالاتفاق، ولا التمسك كذلك بالتنازل عن مرتبة القيد لمصلحة دائن آخر إلا إذا حصل التأشير بذلك في هامش القيد الأصلي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_904> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_904_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_904_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_904_19750926_OpEnact_70c732631c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 904" ;
    dzdoc:position 955 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_904_condition_0_b0e54eaf> ;
    dzdoc:usesTerm dzterm:mortgage .

<https://legal.dz/resource/order/1975-09-26/75-58#art_915> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_915" ;
    dzdoc:fullText "يجوز للحائز إذا سجل سند ملكيته أن يطهر العقار من كل رهن تم قيده قبل تسجيل هذا السند . و للحائز أن يستعمل هذا الحق حتى قبل أن يوجه الدائنون المرتهنون التنبيه إلى الدائن أو الانذار إلى هذا الحائز ، ويبقى هذا الحق قائما إلى يوم إيداع قائمة شروط البيع."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_915_permission_0_fedd9f0c> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_915_right_0_45c5734a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_915_right_1_0c88e70f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_915> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_915_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_915_19750926_OpEnact_ce0ce1a1cf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "915" ;
    dzdoc:position 966 ;
    dzdoc:usesTerm dzterm:mortgagee_creditors,
        dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_923> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_923" ;
    dzdoc:fullText "إذا لم يختر الحائز أن يقضي الديون المقيدة أو يطهر العقار من الرهن أو يتخلى عن هذا العقار ، فلا يجوز للدائن المرتهن أن يتخذ في مواجهته نزع الملكية وفقا لأحكام قانون الاجراءات المدنية إلا بعد انذاره بدفع الدين المستحق أو تخلية العقار ، ويكون الانذار بعد التنبيه على المدين بنزع الملكية أو مع هذا التنبيه في وقت واحد."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_923_permission_0_6994cfe2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_923> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_923_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_923_19750926_OpEnact_13ff89f1f4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "923" ;
    dzdoc:position 974 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_923_condition_0_6de3f766>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_923_condition_1_b3cf1434> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_962> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_962" ;
    dzdoc:fullText "يخول الرهن الدائن المرتهن الحق في حبس الشيء المرهون على الناس كافة ، دون إخلال بما للغير من حقوق تم حفظها وفقا للقانون. وإذا خرج الشيء من يد الدائن دون إرادته أو دون علمه كان له الحق في استرداد حيازته من الغير وفقا لأحكام الحيازة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_962_right_0_788eb174>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_962_right_1_adb48b58> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_962> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_962_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_962_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_962_19750926_OpEnact_38d24f4118> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 962" ;
    dzdoc:position 1013 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_962_condition_0_9105d6e4> ;
    dzdoc:usesTerm dzterm:pledge,
        dzterm:pledged_item,
        dzterm:pledgee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_971> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_5> ;
    dzdoc:eId "art_971" ;
    dzdoc:fullText "إذا كان الشيء مهددا بالهلاك أو التلف أو نقص القيمة بحيث يخشى أن يصبح غير كاف لضمان حق الدائن ولم يطلب الراهن رده إليه مقابل شيء آخر يقدم بدله ، جاز للدائن أو للراهن أن يطلب من القاضي الترخيص له في بيعه بالمزاد العلني أو بسعره في السوق . ويفصل القاضي في أمر إيداع الثمن عند الترخيص في البيع وينتقل حق الدائن في هذه الحالة من الشيء إلى الثمن."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_971_right_0_2860889a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_971> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_971_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_971_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_971_19750926_OpEnact_13108adf2e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 971" ;
    dzdoc:position 1022 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_971_condition_0_682d1366> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:pledgor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_990> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_990" ;
    dzdoc:fullText "المصاريف القضائية التي انفقت لمصلحة جميع الدائنين في حفظ أموال المدين وبيعها، لها امتياز على ثمن هذه الأموال . وتستوفى هذه المصاريف قبل أي حق آخر ولو كان ممتازا أو مضمونا برهان رسمي بما في ذلك حقوق الدائنين الذين انفقت المصاريف في مصلحتهم. وتتقدم المصاريف التي انفقت في بيع الأموال على تلك التي أنفقت في اجراءات التوزيع."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_990_right_0_a62631db> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_990> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_990_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_990_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_990_19750926_OpEnact_601850ab73> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "990" ;
    dzdoc:position 1041 ;
    dzdoc:usesTerm dzterm:judicial_expenses .

<https://legal.dz/resource/order/1975-09-26/75-58#art_996> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_996" ;
    dzdoc:fullText "المبالغ المستحقة لصاحب الفندق في ذمة النزيل عن أجرة الاقامة والمؤونة وكل ما صرف لحسابه، يكون لها امتياز على الأمتعة التي أحضرها النزيل إلى الفندق أو ملحقاته. ويقع الامتياز على الأمتعة ولو كانت غير مملوكة للنزيل إلا إذا أثبت أن صاحب الفندق كان يعلم وقت إدخالها عنده بحق الغير عليها بشرط الا تكون تلك الأمتعة مسروقة أو ضائعة ، ولصاحب الفندق أن يعارض في نقل الأمتعة من فندقه ما دام لم يستوف حقه كاملا ، فإذا نقلت الأمتعة رغم معارضته أو دون علمه ، فإن حق الامتياز يبقى قائما عليها دون إخلال بالحقوق التي كسبها الغير بحسن النية. ولامتياز صاحب الفندق نفس المرتبة التي تكون لامتياز المؤجر، فإذا تزاحم الحقان قدم من سبق في التاريخ، ما لم يكن غير نافذ بالنسبة للآخر."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_996_right_0_5b00b4b6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_996> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_996_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_996_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_996_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_996_19750926_OpEnact_b6479a2b75> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "996" ;
    dzdoc:position 1047 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_996_condition_0_dcd48574>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_996_condition_1_8b190f8d> ;
    dzdoc:usesTerm dzterm:privilege .

<https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_4_art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
