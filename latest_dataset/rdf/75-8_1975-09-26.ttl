<https://legal.dz/resource/order/1975-09-26/75-58#version_art_294> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتم الانابة إذا حصل المدين على رضاء الدائن بشخص أجنبي يلتزم بوفاء الدين مكان المدين. ولا تقتضي الانابة أن تكون هناك حتما مديونية سابقة بين المدين والغير."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_294_19750926_OpEnact_2f03b2d278> ;
    dzdoc:replacementText "تتم الانابة إذا حصل المدين على رضاء الدائن بشخص أجنبي يلتزم بوفاء الدين مكان المدين. ولا تقتضي الانابة أن تكون هناك حتما مديونية سابقة بين المدين والغير."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_294> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
