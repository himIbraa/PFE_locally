    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنتهي الوكالة بإتمام العمل الموكل فيه أو بانتهاء الأجل المعين للوكالة وتنتهي أيضا بموت الموكل أو الوكيل . كما تنتهي الوكالة أيضا بعزل الوكيل أو بعدول الموكل ."@ar ;
