dzterm:architect a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المهندس المعماري"@ar .

dzterm:deposit a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوديعة"@ar .

dzterm:discharge a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الابراء"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_305_defocc_a17b75d314e6> .

dzterm:insurance_contract a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التأمين عقد يلتزم المؤمن بمقتضاه أن يؤدي إلى المؤمن له أو إلى المستفيد الذي اشترط التأمين لصالحه مبلغا من المال أو ايرادا أو أي عوض مالي آخر في حالة وقوع الحادث أو تحقق الخطر المبين بالعقد وذلك مقابل قسط أو أية دفعة مالية أخرى يؤديها المؤمن له للمؤمن."@ar,
        "عقد التأمين"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_619_defocc_1c0c918736e0> .

dzterm:insured a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المؤمن له"@ar .

dzterm:judicial_expenses a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المصاريف القضائية"@ar .

dzterm:lender a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المعير"@ar,
        "للمعير"@ar .

dzterm:managed_property a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الملك المسير"@ar .

dzterm:mixed_economy_company a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الشركة المختلطة الاقتصاد"@ar .

dzterm:mortgaged_property a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "العقار المرهون"@ar .

dzterm:owner a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المالك"@ar,
        "المالك السابق"@ar,
        "مالك البناء"@ar .

dzterm:public_economic_enterprise a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المؤسسة العمومية الاقتصادية"@ar .

dzterm:right_of_way a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "حق المرور"@ar .

dzterm:settlement a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الصلح"@ar,
        "صلح"@ar .

dzterm:state_property a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تعتبر أموالا للدولة العقارات والمنقولات التي تخصص بالفعل أو بمقتضى نص قانوني لمصلحة عامة، أو لادارة، أو لمؤسسة عمومية أو لهيئة لها طابع إداري، أو لمؤسسة اشتراكية، أو لوحدة مسيرة ذاتيا أو لتعاونية داخلة في نطاق الثورة الزراعية"@ar,
        "تعتبر ملكا من أملاك الدولة جميع الاموال الشاغرة التي ليس لها مالك، وكذلك أموال الاشخاص الذين يموتون عن غير وارث أو الذين تهمل تركتهم"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_688_defocc_83300e30f944>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_773_defocc_a1f20797129d> .

