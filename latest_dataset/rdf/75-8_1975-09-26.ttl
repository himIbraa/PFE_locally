<https://legal.dz/resource/order/1975-09-26/75-58#version_art_75_19750926_OpEnact_d8df9337da> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_75> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_75> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_75> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا لم يعلن المتعاقد وقت إبرام العقد أنه يتعاقد بصفته نائبا ، فإن أثر العقد لا يضاف إلى الأصيل دائنا أو مدينا، إلا إذا كان من المفروض حتما أن من تعاقد معه النائب يعلم بوجود النيابة أو كان يستوي عنده أن يتعامل مع الأصيل أو النائب."@ar .

