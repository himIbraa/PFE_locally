<https://legal.dz/resource/order/1975-09-26/75-58#version_art_440> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنتهي الشركة بانسحاب أحد الشركاء، إذا كانت مدتها غير معينة، على شرط أن يعلن الشريك سلفا عن إرادته في الانسحاب قبل حصوله إلى جميع الشركاء وان لا يكون صادرا عن غش أو في وقت غير لائق. وتنتهي الشركة أيضا بإجماع الشركاء على حلها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_440_19750926_OpEnact_911be29dce> ;
