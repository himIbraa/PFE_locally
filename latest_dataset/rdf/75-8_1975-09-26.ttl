<https://legal.dz/resource/order/1975-09-26/75-58#version_art_303> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا حول الدائن حقه للغير وقبل المدين الحوالة دون تحفظ فلا يجوز لهذا الأخير أن يتمسك قبل المحال له بالمقاصة التي كان تمسك بها قبل قبوله للحوالة وليس له الا الرجوع بحقه على المحيل. أما إذا كان المدين لم يقبل الحوالة ولكن أعلن بها فلا تمنعه هذه الحوالة من أن يتمسك بالمقاصة ."@ar ;
