<https://legal.dz/resource/order/1975-09-26/75-58#version_art_223> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للدائن مطالبة المدينين المتضامنين مجتمعين أو منفردين على أن يراعى في ذلك ما يلحق رابطة كل مدين من وصف. ولا يجوز للمدين إذا طالبه أحد الدائنين بالوفاء أن يعارض بأوجه الدفع الخاصة بغيره من المدينين ولكن يجوز له أن يعارض بأوجه الدفع الخاصة به وبالتي يشترك فيها جميع المدينين."@ar ;
