<https://legal.dz/resource/order/1975-09-26/75-58#version_art_542> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ليس للمستعير أن يستعمل الشيء المعار إلا على الوجه المعين وبالقدر المحدد، وذلك طبقا لما يبينه العقد أو تقتضيه طبيعة الشيء أو يجري به العرف و لا يجوز له دون إذن المعير أن يتنازل عن الاستعمال للغير ولو تبرعا . ولا يكون مسؤولا عما يلحق الشيء من تغيير أو تلف يسببه الاستعمال الذي تبيحه العارية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_542_19750926_OpEnact_f74c301782> ;
