<https://legal.dz/resource/order/1975-09-26/75-58#art_847_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_847> ;
    dzdoc:position 0 ;
    dzdoc:text "على المنتفع أن يستعمل الشيء بحالته التي تسلمه بها وبحسب ما أعد له وأن يديره إدارة حسنة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_847_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_847> ;
    dzdoc:position 1 ;
    dzdoc:text "وللمالك أن يعترض على أي استعمال غير مشروع أو غير متفق مع طبيعة الشيء فإذا أثبت أن حقوقه في خطر جاز له أن يطالب بتقديم تأمينات فإن لم يقدمها المنتفع أو استمر على الرغم من اعتراض المالك في استعمال الشيء استعمالا غير مشروع أو غير متفق مع طبيعة الشيء فللقاضي أن ينزع العين من تحت يده وأن يسلمها إلى الغير ليتولى إدارتها بل له تبعا لخطورة الحال أن يقرر انتهاء حق الانتفاع دون إخلال بحقوق الغير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_848_condition_0_233bfd2f> a dznorm:Condition ;
    dznorm:conditionText "وإذا كان المنتفع هو الذي قام بالانفاق"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_848> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_848_obligation_0_68872b8b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
