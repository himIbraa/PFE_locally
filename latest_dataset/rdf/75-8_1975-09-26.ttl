<https://legal.dz/resource/order/1975-09-26/75-58#art_1000_obligation_0_5dde0a28_action_0d191d1e11> a dznorm:Action ;
    rdfs:label "أن يقيد الامتياز"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "ويجب أن يقيد الامتياز"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_1000> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_1000_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_1000> ;
    dzdoc:position 0 ;
    dzdoc:text "المبالغ المستحقة للمقاولين والمهندسين المعماريين الذين عهد إليهم بتشييد أبنية أو منشآت أخرى في إعادة تشييدها أو في ترميمها أو في صيانتها، يكون لها امتياز على هذه المنشآت، ولكن بقدر ما يكون زائدا بسبب هذه الأعمال في قيمة العقار وقت بيعه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_1000_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_1000> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجب أن يقيد الامتياز، وتكون مرتبته من وقت القيد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_1001_obligation_0_b0b64282> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-58#art_1001_obligation_0_b0b64282_action_610c2b7d4a> ;
