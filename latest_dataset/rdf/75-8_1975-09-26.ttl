<https://legal.dz/resource/order/1975-09-26/75-58#version_art_322> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز التنازل عن التقادم قبل ثبوت الحق فيه ، كما لا يجوز الاتفاق على أن يتم التقادم في مدة تختلف عن المدة التي عينها القانون . وإنما يجوز لكل شخص يملك التصرف في حقوقه أن يتنازل ولو ضمنا عن التقادم بعد ثبوت الحق فيه غير أن هذا التنازل لا ينفذ في حق الدائنين إذا صدر اضرارا بهم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
