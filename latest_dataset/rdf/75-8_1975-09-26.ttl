    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_344_condition_0_6ee39ee6> ;
    dzdoc:usesTerm dzterm:decisive_oath .

<https://legal.dz/resource/order/1975-09-26/75-58#art_356> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_356" ;
    dzdoc:fullText "يجوز أن يقتصر تقدير ثمن البيع على بيان الاسس التي يحدد بمقتضاها فيما بعد . وإذا وقع الاتفاق على أن الثمن هو سعر السوق وجب عند الشك الرجوع إلى سعر السوق الذي يقع فيه تسليم المبيع للمشتري في الزمان والمكان ، فإذا لم يكن في مكان التسليم سوق وجب الرجوع إلى سعر السوق في المكان الذي يقضي العرف أن تكون أسعاره هي السارية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_356_permission_0_f53e1196> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_356_right_0_8372ff84> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_356> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_356_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_356_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_356_19750926_OpEnact_6eae72f5b2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_356_obligation_0_caf3aff5>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_356_obligation_1_0d9305b7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 356" ;
    dzdoc:position 380 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_356_condition_0_e68c2111>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_356_condition_1_53bf33ae> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_363> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_363" ;
    dzdoc:fullText "إذا كان ثمن البيع مؤجلا جاز للبائع أن يشترط أن يكون نقل الملكية إلى المشتري موقوفا على دفع الثمن كله ولو تم تسليم الشيء المبيع . فإذا كان الثمن يدفع أقساطا جاز للمتعاقدين أن يتفقا على أن يستبقي البائع جزءا منه على سبيل التعويض في حالة ما إذا وقع فسخ البيع بسبب عدم استيفاء جميع الاقساط. ومع ذلك يجوز للقاضي تبعا للظروف أن يخفض التعويض المتفق عليه وفقا للفقرة الثانية من المادة 184 . وإذا وفي المشتري جميع الاقساط يعتبر انه تملك الشيء المبيع من يوم البيع. تسري أحكام الفقرات الثلاثة السابقة حتى ولو أعطى المتعاقدان للبيع صفة الإيجار."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_363_permission_0_eb12ffe9> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_363_right_0_0cd92479> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_363> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_363_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_363_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_363_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_363_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_363_19750926_OpEnact_f8546b4b1d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 363" ;
    dzdoc:position 387 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_184> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_184> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_363_condition_0_39d7b491>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_363_condition_1_bb1b5665>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_363_condition_2_47b4bb89> ;
    dzdoc:usesTerm dzterm:buyer,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_442> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_4> ;
    dzdoc:eId "art_442" ;
    dzdoc:fullText "يجوز لكل شريك أن يطلب من السلطة القضائية فصل أي شريك يكون وجوده سببا أثار اعتراضا على مد أجلها أو تكون تصرفاته سببا مقبولا لحل الشركة على شرط أن تستمر الشركة قائمة بين الشركاء الباقين. ويجوز أيضا لأي شريك إذا كانت الشركة معينة لأجل أن يطلب من السلطة القضائية إخراجه من الشركة متى استند في ذلك إلى أسباب معقولة ، وفي هذه الحالة تنحل الشركة ما لم يتفق الشركاء على استمرارها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_442_permission_0_610c4526> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_442_right_0_b1686f92>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_442_right_1_0e5ab5fe> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_442> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_442_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_442_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_442_19750926_OpEnact_24a675e421> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "442" ;
    dzdoc:position 466 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_442_condition_0_f5a6b93a> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_492> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_492" ;
    dzdoc:fullText "لا يجوز للمستأجر أن يحدث بالعين المؤجرة أي تغيير بدون إذن مكتوب من المؤجر . إذا أحدث المستأجر تغييرا في العين المؤجرة يلزم بإرجاعها إلى الحالة التي كانت عليها ويعوض الضرر عند الاقتضاء . وإذا أحدث المستأجر ، بإذن المؤجر ، تغييرات في العين المؤجرة زادت في قيمتها ، وجب على المؤجر عند انتهاء الإيجار، أن يرد للمستأجر المصاريف التي أنفقها أو قيمة ما زاد في العين المؤجرة ، ما لم يوجد اتفاق يقضي بخلاف ذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_492_permission_0_6007c6fc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_492> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_492_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_492_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_492_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_492_19750926_OpEnact_5081d935f5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_492_obligation_0_5b885878>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_492_obligation_1_e24babd1> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_492_prohibition_0_6007c6fc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 492" ;
    dzdoc:position 522 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_492_condition_0_ee03043c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_492_condition_1_5e165f23>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_492_condition_2_162e78fd> ;
    dzdoc:usesTerm dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_550> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_1> ;
    dzdoc:eId "art_550" ;
    dzdoc:fullText "يجوز للمقاول أن يقتصر على التعهد بتقديم عمله فحسب على أن يقدم رب العمل المادة التي يستخدمها أو يستعين بها في القيام بعمله. كما يجوز أن يتعهد المقاول بتقديم العمل والمادة معا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_550_permission_0_6ce34c2e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_550_permission_1_e8490867> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_550_right_0_be8cfaa9>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_550_right_1_8fe73b65> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_550> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_550_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_550_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_550_19750926_OpEnact_0a204eac30> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "550" ;
    dzdoc:position 577 ;
    dzdoc:usesTerm dzterm:contractor,
        dzterm:employer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_561> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_2> ;
    dzdoc:eId "art_561" ;
    dzdoc:fullText "إذا أبرم العقد بأجر جزافي على أساس تصميم اتفق عليه مع رب العمل فليس للمقاول أن يطالب بأية زيادة في الأجر ولو حدث في هذا التصميم تعديل أو إضافة الا أن يكون ذلك راجعا إلى خطا من رب العمل أو يكون مأذونا به منه واتفق مع المقاول على أجره . ويجب أن يحصل هذا الاتفاق كتابة ، الا إذا كان العقد الأصلي ذاته قد اتفق عليه مشافهة . على أنه إذا انهار التوازن الاقتصادي بين التزامات كل من رب العمل و المقاول بسبب حوادث استثنائية عامة لم تكن في الحسبان وقت التعاقد، وتداعى بذلك الأساس الذي قام عليه التقدير المالي لعقد المقاولة ، جاز للقاضي أن يحكم بزيادة الأجرة أو بفسخ العقد ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_561_right_0_488b6e91> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_561> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_561_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_561_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_561_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_561_19750926_OpEnact_e284cb37da> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_561_obligation_0_7b041313> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "561" ;
    dzdoc:position 588 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_561_condition_0_b3e55dd1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_561_condition_1_cabb41d5>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_561_condition_2_e01b65d7>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_561_condition_3_5e4943b3> ;
    dzdoc:usesTerm dzterm:contractor,
        dzterm:employer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_733> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:partition_of_usufruct ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_733" ;
    dzdoc:fullText "يتفق الشركاء في قسمة المهايأة على أن يختص كل منهم بجزء مفرز يساوي حصته في المال الشائع متنازلا لشركائه في مقابل ذلك عن الانتفاع بباقي الأجزاء و لا يصح هذا الاتفاق لمدة تزيد على خمس (5) سنوات . فإذا لم تشترط لها مدة أو انتهت المدة المتفق عليها ولم يحصل اتفاق جديد كانت مدتها سنة واحدة تتجدد إذا لم يعلن الشريك إلى شركائه قبل انتهاء السنة الجارية بثلاثة (3) أشهر أنه لا يرغب في التحديد . وإذا دامت قسمة المهايأة خمسة عشرة سنة انقلبت إلى قسمة نهائية ما لم يتفق الشركاء على غير ذلك. وإذا حاز الشريك على الشيوع جزءا مفرزا من المال الشائع مدة خمسة عشرة (15) سنة ، افترض أن حيازته لهذا الجزء تستند إلى قسمة مهايأة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_733> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_733_defocc_e3ba34cd59d9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_733_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_733_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_733_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_733_19750926_OpEnact_2cf519bf53> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_733_obligation_0_f5be31a2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "733" ;
    dzdoc:position 773 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_733_condition_0_ad8e37e7>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_733_condition_1_8a671033>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_733_condition_2_5d5f61f5>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_733_condition_3_d5698487> ;
    dzdoc:usesTerm dzterm:partition_of_usufruct .

<https://legal.dz/resource/order/1975-09-26/75-58#art_754> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_754" ;
    dzdoc:fullText "في حالة نقل ملكية إحدى القسمات ، يبقى المالك السابق ملزما بدفع جميع الديون المترتبة عليه من الملكية المشتركة والمستحقة عند تاريخ انتقال الملكية ، والواجب دفعها نقدا سواء تعلق الأمر بأرصدة أو بدفع نهائي. يجب على الشريك في الملكية الذي يتخلى عن قسمته بعرض أن يسلم للموثق شهادة تقل عن مدة شهر تثبت أنه غير مطالب بأي حق إزاء جماعة الشركاء في الملكية ، و يجب إخطار المتصرف بهذا التخلي برسالة مضمنة مع الاشعار بالوصول و يجوز للمتصرف بطلب من المشتري أن يعترض، في مدة خمسة عشر (15) يوما ابتداءا من إعلان التخلي، على دفع مبالغ البيع ليتسنى له الحصول على المبالغ الباقية في ذمة البائع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_754_right_0_bbd151ec> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_754> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_754_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_754_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_754_19750926_OpEnact_145acd9694> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_754_obligation_0_a005a19a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_754_obligation_1_937f4633>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_754_obligation_2_b8f0fc1a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 754" ;
    dzdoc:position 797 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_754_condition_0_fff429ec> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_784> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_784" ;
    dzdoc:fullText "إذا أقام شخص المنشآت بمواد من عنده على أرض يعلم أنها ملك لغيره دون رضاء صاحبها فلصاحب الأرض أن يطلب في أجل سنة من اليوم الذي علم فيه بإقامة المنشآت إزالة المنشآت على نفقة من أقامها مع التعويض عن الضرر إذا اقتضى الحال ذلك، أو أن يطلب استبقاءها مقابل دفع قيمتها أو قيمتها في حالة الهدم أو دفع مبلغ يساوي ما زاد في ثمن الأرض بسبب وجود المنشآت بها. ويجوز لمن أقام المنشآت أن يطلب نزعها أن كان ذلك لا يلحق بالأرض ضررا الا إذا اختار صاحب الأرض استبقاءها طبقا لأحكام الفقرة السابقة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_784> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_784_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_784_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_784_19750926_OpEnact_3a32cd128c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "784" ;
    dzdoc:position 835 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_784_condition_0_dea3526e> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_785> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_785" ;
    dzdoc:fullText "إذا كان من أقام المنشآت المشار إليها في المادة 784 يعتقد بحسن نية أن له الحق في إقامتها فليس لصاحب الأرض أن يطلب الازالة وإنما يخير بين أن يدفع قيمة المواد وأجرة العمل أو مبلغا يساوي ما زاد في قيمة الأرض بسبب هذه المنشآت هذا ما لم يطلب صاحب المنشآت نزعها. غير أنه إذا كانت المنشآت قد بلغت حدا من الأهمية وكان تسديدها مرهقا لصاحب الأرض جاز له أن يطلب تمليك الأرض لمن أقام المنشآت نظير تعويض عادل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_785> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_785_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_785_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_785_19750926_OpEnact_5e000b448a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "785" ;
    dzdoc:position 836 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_784> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_784> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_785_condition_0_6481d8de>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_785_condition_1_04d87e43> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_886> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_1> ;
    dzdoc:eId "art_886" ;
    dzdoc:fullText "لا يجوز أن ينعقد الرهن إلا على عقار ما لم يوجد نص يقضي بغير ذلك. ويجب أن يكون العقار المرهون مما يصح التعامل فيه وبيعه بالمزاد العلني، وأن يكون معينا بالذات تعيينا دقيقا من حيث طبيعته وموقعه، وأن يرد هذا التعيين إما في عقد الرهن ذاته أو في عقد رسمي لاحق ، وإلا كان الرهن باطلا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_886_permission_0_ad2c173a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_886> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_886_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_886_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_886_19750926_OpEnact_4a93c45d7b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_886_obligation_0_9d5bae09>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_886_obligation_1_11d154f7> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_886_prohibition_0_ad2c173a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 886" ;
    dzdoc:position 937 ;
    dzdoc:usesTerm dzterm:mortgage .

<https://legal.dz/resource/order/1975-09-26/75-58#art_938> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_938" ;
    dzdoc:fullText "لا يجوز الحصول على حق تخصيص بناء على حكم صادر من محكمة أجنبية أو على قرار صادر من محكمتين إلا إذا أصبح حكم القرار واجب التنفيذ ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_938_permission_0_7bca82d2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_938> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_938_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_938_19750926_OpEnact_f696b786a4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_938_obligation_0_59057e96> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_938_prohibition_0_7bca82d2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 938" ;
    dzdoc:position 989 ;
    dzdoc:usesTerm dzterm:right_of_allocation .

dzterm:agency a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوكالة"@ar,
        "الوكالة أو الانابة هو عقد بمقتضاه يفوض شخص شخصا آخر للقيام بعمل شيء لحساب الموكل وباسمه"@ar,
        "بالوكالة"@ar,
        "للوكالة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_571_defocc_8dd5ad30f493> .

dzterm:possessor a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الحائز"@ar,
        "حائز"@ar,
        "لحائز الشيء"@ar,
        "للحائز"@ar,
        "ويعتبر حائزا للعقار المرهون كل من انتقلت إليه بأي سبب من الأسباب ملكية هذا العقار أو أي حق عيني آخر قابل للرهن، دون أن يكون مسؤولا مسؤولية شخصية عن الدين المضمون بالرهن"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_911_defocc_59a0a2dbf3f3> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_352> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_352" ;
    dzdoc:fullText "يجب أن يكون المشتري عالما بالمبيع علما كافيا ويعتبر العلم كافيا إذا اشتمل العقد على بيان المبيع وأوصافه الاساسية بحيث يمكن التعرف عليه . وإذا ذكر في عقد البيع أن المشتري عالم بالمبيع سقط حق هذا الأخير في طلب إبطال البيع بدعوى عدم العلم به الا إذا أثبت غش البائع ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_352_permission_0_d88521a9> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_352_right_0_07dc0777> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_352> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_352_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_352_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_352_19750926_OpEnact_ec58b3e5bf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_352_obligation_0_f1c6c84d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 352" ;
    dzdoc:position 376 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_352_condition_0_7044bd4a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_352_condition_1_ef9cf031>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_352_condition_2_b7cf6130> ;
    dzdoc:usesTerm dzterm:buyer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_430> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_2> ;
    dzdoc:eId "art_430" ;
    dzdoc:fullText "يمنع الشركاء غير المديرين من الادارة ولكن يجوز لهم أن يطلعوا بانفسهم على دفاتر ووثائق الشركة ويقع باطلا كل اتفاق يخالف ذلك."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_430_permission_0_df3307bb> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_430_right_0_2a3992d6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_430> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_430_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_430_19750926_OpEnact_3c4886805c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_430_obligation_0_e2852f5e> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_430_prohibition_0_df3307bb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "430" ;
    dzdoc:position 454 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_447> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_5> ;
    dzdoc:eId "art_447" ;
    dzdoc:fullText "تقسم أموال الشركة بين سائر الشركاء بعد استيفاء الدائنين لدينهم، وبعد طرح المبالغ اللازمة لقضاء الديون التي لم يحل أجلها أو الديون المتنازع فيها، وبعد رد المصاريف أو القروض التي يكون أحد الشركاء قيد باشرها في مصلحة الشركة . ويسترد كل واحد من الشركاء مبلغا يعادل قيمة الحصة التي قدمها في رأس المال ، كما هي مبينة في العقد أو يعادل قيمة هذه الحصة وقت تسليمها إذا لم تبين تلك القيمة في العقد، ما لم يكن الشريك قد اقتصر على تقديم عمله أو اقتصر فيما قدمه من شيء على حق المنفعة فيه أو على مجرد الانتفاع به . إذا بقي شيء وجبت قسمته بين الشركاء بنسبة نصيب كل واحد في الارباح. وإذا لم يف رأس المال الصافي للوفاء بحصص الشركاء فإن الخسارة توزع على الشركاء جميعا بحسب النسبة المتفق عليها في توزيع الخسائر والا كان ذلك حسب أحكام المادة 425 ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_447_right_0_88517078> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_447> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_447_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_447_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_447_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_447_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_447_19750926_OpEnact_94f0c6a307> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_447_obligation_0_93e70379>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_447_obligation_1_5afdd4be> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 447" ;
    dzdoc:position 471 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_425> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_425> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_447_condition_0_eb6d464c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_447_condition_1_9e024d93>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_447_condition_2_c19fc1b4> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_461> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_5_subsec_1> ;
    dzdoc:eId "art_461" ;
    dzdoc:fullText "لا يجوز الصلح في المسائل المتعلقة بالحالة الشخصية أو بالنظام العام ولكن يجوز الصلح على المصالح المالية الناجمة عن الحالة الشخصية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_461_permission_0_d851b4da> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_461_right_0_0d62f032> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_461> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_461_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_461_19750926_OpEnact_8ddbf50821> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_461_obligation_0_6999a8cc> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_461_prohibition_0_d851b4da> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 461" ;
    dzdoc:position 485 ;
    dzdoc:usesTerm dzterm:صلح .

<https://legal.dz/resource/order/1975-09-26/75-58#art_482> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_482" ;
    dzdoc:fullText "لا يجوز للمستأجر أن يمنع المؤجر من إجراء الترميمات المستعجلة الضرورية لحفظ العين المؤجرة . غير أنه إذا ترتب على إجراء هذه الترميمات إخلال كلي أو جزئي في الانتفاع بالعين المؤجرة ، جاز للمستأجر ، حسب الحالة، طلب فسخ العقد أو إنقاص بدل الإيجار . إذا بقي المستأجر في العين المؤجرة بعد إتمام الترميمات فليس له حق طلب الفسخ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_482_permission_0_4ebc3503> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_482_right_0_e380fcdc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_482> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_482_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_482_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_482_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_482_19750926_OpEnact_16bcdacc9c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_482_obligation_0_b0022ae6> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_482_prohibition_0_4ebc3503> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 482" ;
    dzdoc:position 512 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_482_condition_0_715ad9e5>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_482_condition_1_3ea9ca68> ;
    dzdoc:usesTerm dzterm:leased_property,
        dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_493> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_493" ;
    dzdoc:fullText "يجوز للمستأجر أن يضع بالعين المؤجرة أجهزة لتوصيل المياه والكهرباء والغاز، والتلفون وما يشبه ذلك على شرط أن لا تخالف طريقة وضع هذه الاجهزة القواعد المعمول بها ، الا إذا أثبت المؤجر أن وضع هذه الاجهزة تهدد سلامة العقار . فإذا كان تدخل المؤجر لازما لذلك جاز للمستأجر أن يطلب منه هذا التدخل على أن يتكفل المستأجر برد ما ينفقه المؤجر من مصاريف ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_493_permission_0_b0a85976> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_493_right_0_dc42c823>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_493_right_1_5473a512> ;
