<https://legal.dz/resource/order/1975-09-26/75-58#art_941_obligation_1_fbfdd15a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-58#art_941_obligation_1_fbfdd15a_action_91cb42b2ad> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_941> ;
    dznorm:position 1 ;
    dznorm:provisionText "وهذه العريضة يجب أن تكون مصحوبة بصورة رسمية من الحكم أو بشهادة من قلم الكتاب مدون فيها منطوق الحكم، وأن تشمل البيانات الآتية"@ar ;
    dznorm:sourceArticle "art_941" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_941_obligation_1_fbfdd15a_action_91cb42b2ad> a dznorm:Action ;
