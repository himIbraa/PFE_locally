<https://legal.dz/resource/order/1975-09-26/75-58#art_107> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_107" ;
    dzdoc:fullText "يجب تنفيذ العقد طبقا لما اشتمل عليه وبحسن نية . ولا يقتصر العقد على الزام المتعاقد بما ورد فيه فحسب، بل يتناول أيضا ما هو من مستلزماته وفقا للقانون، والعرف، والعدالة، بحسب طبيعة الالتزام. غير أنه إذا طرأت حوادث استثنائية عامة لم يكن في الوسع توقعها وترتب على حدوثها أن تنفيذ الالتزام التعاقدي، وإن لم يصبح مستحيلا، صار مرهقا للمدين بحيث يهدده بخسارة فادحة جاز للقاضي تبعا للظروف وبعد مراعاة لمصلحة الطرفين أن يرد الالتزام المرهق إلى الحد المعقول ، ويقع باطلا كل اتفاق على خلاف ذلك."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_107_right_0_9c909859> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_107> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_107_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_107_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_107_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_107_19750926_OpEnact_62687f4b74> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_107_obligation_0_e46fe913> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 107" ;
    dzdoc:position 114 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_107_condition_0_c87caaa7> ;
    dzdoc:usesTerm dzterm:contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_119> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_4> ;
    dzdoc:eId "art_119" ;
    dzdoc:fullText "في العقود الملزمة للجانبين ، إذا لم يوف أحد المتعاقدين بالتزامه جاز للمتعاقد الآخر بعد اعذاره المدين أن يطالب بتنفيذ العقد أو فسخه، مع التعويض في الحالتين إذا اقتضى الحال ذلك . ويجوز للقاضي أن يمنح المدين أجلا حسب الظروف، كما يجوز له أن يرفض الفسخ إذا كان ما لم يوف به المدين قليل الأهمية بالنسبة إلى كامل الالتزامات ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_119_permission_0_d9dc642e> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_119_right_0_0a20cd39> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_119> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_119_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_119_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_119_19750926_OpEnact_d14087e7ae> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 119" ;
    dzdoc:position 126 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_119_condition_0_d75dfc92>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_119_condition_1_683fd2be> ;
    dzdoc:usesTerm dzterm:bilateral_contracts .

<https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_bis> ;
    dzdoc:eId "art_123_bis_1" ;
    dzdoc:fullText "( جديدة) من وعد الجمهور بجائزة يعطيها عن عمل معين يلزم بإعطائها لمن قام بالعمل ، ولو قام به دون نظر إلى الوعد بالجائزة أو دون علم بها. وإذا لم يعين الواعد أجلا لإنجاز العمل جاز له الرجوع في وعده بإعلان الجمهور، على ألا يؤثر ذلك في حق من أتم العمل قبل الرجوع في الوعد . يمارس حق المطالبة بالجائزة تحت طائلة السقوط في أجل ستة (6) أشهر من تاريخ إعلان العدول للجمهور ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1_right_0_17c6616b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1_right_1_246c1b33> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_123_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_123_bis_1_19750926_OpEnact_2478d2837f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1_obligation_0_3adb11b4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 123 مكرر 1" ;
    dzdoc:position 132 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1_condition_0_6a5de8c3>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1_condition_1_c267a70e> ;
    dzdoc:usesTerm dzterm:promise_of_reward .

<https://legal.dz/resource/order/1975-09-26/75-58#art_143> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_143" ;
    dzdoc:fullText "كل من تسلم على سبيل الوفاء ما ليس مستحقا له وجب عليه رده . غير أنه لا محل للرد إذا كان من قام بالوفاء يعلم أنه غير ملزم بما دفعه ، الا أن يكون ناقص الأهلية ، أو يكون قد أكره على هذا الوفاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_143> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_143_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_143_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_143_19750926_OpEnact_354ddc4408> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_143_obligation_0_1e7ab351> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "143" ;
    dzdoc:position 155 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_143_condition_0_3a21a59c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_143_condition_1_88289847>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_143_condition_2_0a944e99> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_147> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_147" ;
    dzdoc:fullText "إذا كان من تسلم غير مستحق حسن النية فلا يلزم أن يرد إلا ما تسلم . أما إذا كان سيئ النية فإنه يلزم أيضا برد الأرباح التي جناها، أو التي قصر في جنيها من الشيء الذي تسلمه بغير حق ، وذلك من يوم الوفاء، أو من اليوم الذي أصبح فيه سيئ النية. وعلى أي حال يلزم من تسلم غير المستحق برد الثمرات من يوم رفع الدعوى ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_147> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_147_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_147_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_147_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_147_19750926_OpEnact_632c41a67d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_147_obligation_0_905d094b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_147_obligation_1_2a56bd0d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_147_obligation_2_8634b89c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "147" ;
    dzdoc:position 159 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_147_condition_0_eb5c88d6>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_147_condition_1_1f92e66a> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_164> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_164" ;
    dzdoc:fullText "يجبر المدين بعد اعذاره طبقا للمادتين 180 و 181 على تنفيذ التزامه تنفيذا عينيا، متى كان ذلك ممكنا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_164> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_164_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_164_19750926_OpEnact_6986df8f91> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_164_obligation_0_7f5348ce> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 164" ;
    dzdoc:position 176 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_180>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_181> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_180>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_181> ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_168> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_168" ;
    dzdoc:fullText "إذا كان المدين الملزم بالقيام بعمل يقتضي تسليم شيء ولم يسلمه بعد الاعذار فإن الاخطار تكون على حسابه ولو كانت قبل الاعذار على حساب الدائن. غير أن هذه الاخطار لا تتعدى إلى المدين رغم الاعذار إذا أثبت المدين أن الشيء قد يضيع عند الدائن لو سلم له، ما لم يكن المدين قد قبل أن يتحمل تبعية الحوادث المفاجئة . على أن الشيء المسروق إذا هلك أو ضاع بأية صورة كانت فإن تبعية الهلاك تقع على السارق ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_168> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_168_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_168_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_168_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_168_19750926_OpEnact_d0dc29ff3b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_168_obligation_0_dab57082> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 168" ;
    dzdoc:position 180 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_168_condition_0_3578a55e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_168_condition_1_b2d4eca7> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_170> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_170" ;
    dzdoc:fullText "في الالتزام بعمل، إذا لم يقم المدين بتنفيذ التزامه جاز للدائن أن يطلب ترخيصا من القاضي في تنفيذ الالتزام على نفقة المدين إذا كان هذا التنفيذ ممكنا ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_170_right_0_f37456d0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_170> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_170_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_170_19750926_OpEnact_0a87b09bfb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 170" ;
    dzdoc:position 182 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_170_condition_0_5be53c1a> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_181> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_181" ;
    dzdoc:fullText "لا ضرورة لاعذار المدين في الحالات الآتية : إذا تعذر تنفيذ الالتزام أو أصبح غير مجد بفعل المدين ، إذا كان محل الالتزام تعويضا ترتب عن عمل مضر، إذا كان محل الالتزام رد شيء يعلم المدين انه مسروق، أو شيء تسلمه دون حق وهو عالم بذلك، إذا صرح المدين كتابة أنه لا ينوي تنفيذ التزامه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_181> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_181_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_181_19750926_OpEnact_6a5b0739d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "181" ;
    dzdoc:position 193 ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_200> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_200" ;
    dzdoc:fullText "لكل من التزم بأداء شيء أن يمتنع عن الوفاء به ما دام الدائن لم يعرض الوفاء بالتزام ترتب عليه وله علاقة سببية وارتباط بالتزام المدين . أو مادام الدائن لم يقم بتقديم تأمين كاف للوفاء بالتزامه هذا . ويكون ذلك بوجه خاص لحائز الشيء أو محرزه ، إذا هو انفق عليه مصروفات ضرورية أو نافعة ، فإن له أن يمتنع عن رد هذا الشيء حتى يستوفي ما هو مستحق له ، الا أن يكون الالتزام بالرد ناشئا عن عمل غير مشروع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_200_right_0_755d3e16>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_200_right_1_297472eb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_200> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_200_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_200_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_200_19750926_OpEnact_3a116136b8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "200" ;
    dzdoc:position 213 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_200_condition_0_c4c7a50b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_200_condition_1_1f50eb56>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_200_condition_2_10ab506f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_200_condition_3_e9786499> ;
    dzdoc:usesTerm dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_214> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_214" ;
    dzdoc:fullText "إذا كان الخيار للمدين وامتنع عن الاختيار، أو تعدد المدينون ولم يتفقوا فيما بينهم ، جاز للدائن أن يطلب من القاضي تعيين أجل يختار فيه المدين أو يتفق فيه المدينون ، فإذا لم يتم ذلك تولى القاضي بنفسه تعيين محل الالتزام . أما إذا كان الخيار للدائن وامتنع عن الاختيار أو تعدد الدائنون ولم يتفقوا فيما بينهم عين القاضي أجلا إن طلب المدين ذلك، فإذا انقضى الأجل انتقل الخيار إلى المدين ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_214_right_0_0e5ca39b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_214> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_214_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_214_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_214_19750926_OpEnact_400f285411> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_214_obligation_0_a55e6b60> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 214" ;
    dzdoc:position 227 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_214_condition_0_d66746ff>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_214_condition_1_b643b5db>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_214_condition_2_ed210090>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_214_condition_3_9bfae297> ;
    dzdoc:usesTerm dzterm:الخيار,
        dzterm:المدين .

<https://legal.dz/resource/order/1975-09-26/75-58#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "لا يجوز تطبيق القانون الأجنبي بموجب النصوص السابقة إذا كان مخالفا للنظام العام أو الآداب العامة في الجزائر، أو ثبت له الاختصاص بواسطة الغش نحو القانون . يطبق القانون الجزائري محل القانون الأجنبي المخالف للنظام العام أو الآداب العامة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_24_permission_0_0b3e85f7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_24_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_24_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_24_19750926_OpEnact_f03ec52853> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_24_obligation_0_b44ba697> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_24_prohibition_0_0b3e85f7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "24" ;
    dzdoc:position 30 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_24_condition_0_070d1556> ;
    dzdoc:usesTerm dzterm:algerian_law .

<https://legal.dz/resource/order/1975-09-26/75-58#art_241> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_241" ;
    dzdoc:fullText "لا يحتج بالحوالة قبل المدين ، أو قبل الغير الا إذا رضي بها المدين، أو أخبر بها بعقد غير قضائي ، غير أن قبول المدين لا يجعلها نافذة قبل الغير الا إذا كان هذا القبول ثابت التاريخ ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_241> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_241_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_241_19750926_OpEnact_51db567c04> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 241" ;
    dzdoc:position 254 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_241_condition_0_904535dc>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_241_condition_1_ac00d4ff> ;
    dzdoc:usesTerm dzterm:assignment,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_256> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_2> ;
    dzdoc:eId "art_256" ;
    dzdoc:fullText "يتمسك المحال عليه قبل الدائن بالدفوع التي كان للمدين الأصلي أن يتمسك بها ، كما يجوز له أن يتمسك بالدفوع المستمدة من عقد الحوالة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_256_permission_0_6e8bb5ca> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_256_right_0_3db2a668>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_256_right_1_9803c77b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_256> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_256_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_256_19750926_OpEnact_d7b72ce380> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "256" ;
    dzdoc:position 269 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_263> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_263" ;
    dzdoc:fullText "يجوز أيضا للمدين إذا اقترض مالا وفي به الدين أن يحل المقرض محل الدائن الذي استوفي حقه ، ولو دون رضا هذا الأخير، على أن يذكر في عقد القرض أن المال قد خصص للوفاء، وفي المخالصة أن الوفاء كان من هذا المال الذي اقرضه الدائن الجديد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_263_permission_0_7f88e236> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_263_right_0_3ae5fb6d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_263> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_263_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_263_19750926_OpEnact_ac26ae835e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 263" ;
    dzdoc:position 276 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_263_condition_0_9303dbd6> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_298> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_3> ;
    dzdoc:eId "art_298" ;
    dzdoc:fullText "يجوز للمدين التمسك بالمقاصة ولو اختلف مكان الوفاء في الدينين ولكن يجب عليه في هذه الحالة تعويض الدائن ما لحقه من ضرر لعدم تمكنه بسبب المقاصة من استيفاء ما له من حق أو الوفاء بما عليه من دين في المكان الذي عين لذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_298_permission_0_dfe36778> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_298_right_0_efe1be0f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_298> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_298_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_298_19750926_OpEnact_90b55d6b24> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_298_obligation_0_c07fca91> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "298" ;
    dzdoc:position 311 ;
    dzdoc:usesTerm dzterm:مقاصة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_372> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_372" ;
    dzdoc:fullText "إذا رفعت على المشتري دعوى استحقاق المبيع كان على البائع حسب الأحوال ووفقا لقانون الاجراءات المدنية أن يتدخل في الخصومة إلى جانب المشتري أو أن يحل فيها محله إذا أعلم البائع في الوقت المناسب ولم يتدخل في الخصام وجب عليه الضمان الا إذا اثبت أن الحكم الصادر في الدعوى كان نتيجة تدليس، أو خطأ. جسیم صادر من المشتري. فإذا لم يخبر المشتري البائع بدعوى الاستحقاق من الوقت المناسب وصدر عليه حكم حاز قوة الشيء المقضي به فإنه يفقد حق الرجوع بالضمان إذا اثبت البائع أن التدخل في الدعوى كان يؤدي إلى رفض دعوى الاستحقاق."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_372_right_0_62bf90c4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_372> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_372_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_372_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_372_19750926_OpEnact_e5159f003c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_372_obligation_0_8d31f3d2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 372" ;
    dzdoc:position 396 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_372_condition_0_2db3fec3>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_372_condition_1_456af0b0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_372_condition_2_9af53f4b> ;
    dzdoc:usesTerm dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_388> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_388" ;
    dzdoc:fullText "يكون ثمن المبيع مستحقا في الوقت الذي يقع فيه تسليم المبيع، ما لم يوجد اتفاق أو عرف يقضي بخلاف ذلك. فإذا تعرض أحد للمشتري مستندا إلى حق سابق أو آل من البائع ، أو إذا خيف على المبيع أن ينزع من يد المشتري جاز له أن لم يمنعه شرط في العقد أن يمسك الثمن إلى أن ينقطع التعرض أو يزول الخطر ، ومع ذلك يجوز للبائع أن يطالب باستيفاء الثمن إذا ظهر للمشتري عيب في الشيء المبيع."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_388_permission_0_8d1494c6> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_388_right_0_286ae68c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_388> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_388_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_388_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_388_19750926_OpEnact_1955d048d1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 388" ;
    dzdoc:position 412 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_388_condition_0_ad5c8884> ;
    dzdoc:usesTerm dzterm:buyer,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_402> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_402" ;
    dzdoc:fullText "لا يجوز للقضاة، ولا للمدافعين القضائيين، ولا للمحامين ولا للموثقين ولا لكتاب الضبط، أن يشتروا بانفسهم مباشرة ولا بواسطة اسم مستعار الحق المتنازع فيه كله أو بعضه إذا كان النظر في النزاع يدخل في اختصاص المحكمة التي يباشرون أعمالهم في دائرتها والا كان البيع باطلا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_402_permission_0_76deaf89> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_402> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_402_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_402_19750926_OpEnact_2c02e5563f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_402_obligation_0_dc8e398d> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_402_prohibition_0_76deaf89> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 402" ;
    dzdoc:position 426 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_402_condition_0_4ac92066> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_403> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_403" ;
    dzdoc:fullText "لا يجوز للمحامين ولا للمدافعين القضائيين أن يتعاملوا مع موكليهم في الحقوق المتنازع فيها سواء كان التعامل بأسمائهم أو بأسماء مستعارة إذا كانوا هم الذين تولوا الدفاع عنها والا كانت المعاملة باطلة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_403_permission_0_8ba8b4f1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_403> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_403_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_403_19750926_OpEnact_9030115532> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_403_obligation_0_a9e823ec> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_403_prohibition_0_8ba8b4f1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 403" ;
    dzdoc:position 427 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_403_condition_0_1fce06ce> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_417> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3> ;
    dzdoc:eId "art_417" ;
    dzdoc:fullText "تعتبر الشركة بمجرد تكوينها شخصا معنويا غير أن هذه الشخصية لا تكون حجة على الغير الا بعد استيفاء اجراءات الشهر التي ينص عليها القانون ومع ذلك إذا لم تقم الشركة بالاجراءات المنصوص عليها في القانون فإنه يجوز للغير بأن يتمسك بتلك الشخصية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_417_permission_0_67dc2ef7> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_417_right_0_248d5c42> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_417> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_417_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_417_19750926_OpEnact_dcdd9d1a66> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 417" ;
    dzdoc:position 441 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_417_condition_0_9a2ef204>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_417_condition_1_caffe8e0> ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-58#art_431> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:management_presumption ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_2> ;
    dzdoc:eId "art_431" ;
    dzdoc:fullText "إذا لم يوجد نص خاص على طريقة الادارة اعتبر كل شريك مفوضا من طرف الآخرين لادارة الشركة و يسوغ له أن يباشر أعمال الشركة دون الرجوع إلى غيره على أن يكون للشركاء الحق في رفض هذا الاعتراض على أي عمل قبل انجازه و لا غلبية الشركاء الحق في رفض هذا الاعتراض ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_431_right_0_e05cdab2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_431_right_1_0025ef9d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_431_right_2_bcb13830> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_431> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_431_defocc_7d7453716b43> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_431_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_431_19750926_OpEnact_ad47cbb74f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "431" ;
    dzdoc:position 455 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_431_condition_0_9b4bd377> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_467> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:lease_contract ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_467" ;
    dzdoc:fullText "الإيجار عقد يمكن المؤجر بمقتضاه المستأجر من الانتفاع بشيء لمدة محددة مقابل بدل إيجار معلوم. يجوز أن يحدد بدل الإيجار نقدا أو بتقديم أي عمل آخر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_467_permission_0_cc50490f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_467_permission_1_6762c400> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_467> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_467_defocc_74baee08cd8c> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_467_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_467_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_467_19750926_OpEnact_1df69d094e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 467" ;
    dzdoc:position 491 ;
    dzdoc:usesTerm dzterm:lease,
        dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_481> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_481" ;
    dzdoc:fullText "إذا هلكت العين المؤجرة أثناء مدة الإيجار هلاكا كليا يفسخ الإيجار بحكم القانون. إذا كان هلاك العين المؤجرة جزئيا، أو إذا أصبحت في حالة لا تصلح للاستعمال الذي أعدت من أجله، أو نقص هذا الاستعمال نقصا معتبرا ولم يكن ذلك بفعل المستأجر ، يجوز لهذا الأخير، إذا لم يقم المؤجر في الوقت المناسب برد العين المؤجرة إلى الحالة التي كانت عليها، أن يطلب حسب الحالة، إما إنقاص بدل الإيجار أو فسخ الإيجار ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_481_permission_0_8c5df845> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_481_right_0_b4ebbba0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_481> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_481_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_481_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_481_19750926_OpEnact_a1834e49ba> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 481" ;
    dzdoc:position 511 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_481_condition_0_a240d759>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_481_condition_1_987177db> ;
    dzdoc:usesTerm dzterm:leased_property,
        dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_498> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_498" ;
    dzdoc:fullText "يجب على المستأجر أن يقوم بدفع بدل الإيجار في المواعيد المتفق عليها ، فإذا لم يكن هناك اتفاق وجب الوفاء ببدل الإيجار في المواعيد المعمول بها الجهة . ويكون دفع بدل الإيجار في موطن المستأجر ما لم يكن اتفاق أو عرف يقضي بخلاف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_498> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_498_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_498_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_498_19750926_OpEnact_57f87b6965> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_498_obligation_0_1cb5164d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_498_obligation_1_0db444ef> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 498" ;
    dzdoc:position 528 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_498_condition_0_1a9b4a6a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_498_condition_1_a69566fe> ;
    dzdoc:usesTerm dzterm:lessee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_547> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_2_subsec_3> ;
    dzdoc:eId "art_547" ;
    dzdoc:fullText "يجوز للمعير أن يطلب في أي وقت إنهاء العارية في الأحوال الآتية : إذا عرضت له حاجة عاجلة للشيء لم تكن متوقعة ، إذا أساء المستعير استعمال الشيء أو قصر في الاحتياط الواجب للمحافظة عليه ، إذا أعسر المستعير بعد انعقاد العارية أو كان معسرا قبل ذلك دون علم من المعير ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_547_permission_0_386730d0> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_547_right_0_8799f8d7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_547> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_547_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_547_19750926_OpEnact_103e36c58e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 547" ;
    dzdoc:position 574 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_547_condition_0_fda663fc>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_547_condition_1_9bd36e50>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_547_condition_2_294f2a14> ;
    dzdoc:usesTerm dzterm:borrower,
        dzterm:lender,
        dzterm:loan_for_use .

<https://legal.dz/resource/order/1975-09-26/75-58#art_568> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_4> ;
    dzdoc:eId "art_568" ;
    dzdoc:fullText "إذا هلك الشيء بسبب حادث مفاجئ قبل تسليمه ل رب العمل فليس ل المقاول أن يطالب لا بثمن عمله ولا برد نفقاته، ويكون هلاك المادة على من قام بتوريدها من الطرفين. أما إذا كان المقاول قد أعذر بتسليم الشيء أو كان هلاك الشيء أو تلفه قبل التسليم راجعا إلى خطئه ، وجب عليه أن يعوض رب العمل . فإذا كان رب العمل هو الذي أعذر بأن يتسلم الشيء أو كان هلاك الشيء أو تلفه راجعا إلى خطإ منه أو إلى عيب في المادة التي قام بتوريدها كان هلاك المادة عليه وكان ل لمقاول الحق في الأجر وفي إصلاح الضرر عند الاقتضاء ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_568_right_0_195c9102> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_568> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_568_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_568_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_568_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_568_19750926_OpEnact_f8a937d3ba> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_568_obligation_0_72fa5a75> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 568" ;
    dzdoc:position 595 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_568_condition_0_610bb35f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_568_condition_1_04ed7f52>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_568_condition_2_2b863702> ;
    dzdoc:usesTerm dzterm:contractor,
        dzterm:employer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_575> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_2> ;
    dzdoc:eId "art_575" ;
    dzdoc:fullText "الوكيل ملزم بتنفيذ الوكالة دون أن يجاوز الحدود المرسومة . لكن يسوغ له أن يتجاوز الحدود إذا تعذر عليه إخطار الموكل سلفا وكانت الظروف يغلب معها الظن بأنه ما كان يسع الموكل الا الموافقة على هذا التصرف و على الوكيل في هذه الحالة أن يخبر الموكل حالا بتجاوزه حدود الوكالة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_575_right_0_6518bc72> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_575> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_575_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_575_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_575_19750926_OpEnact_66c766779e> ;
