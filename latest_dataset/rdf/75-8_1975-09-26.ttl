<https://legal.dz/resource/order/1975-09-26/75-58#version_art_123_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "( جديدة) يجوز أن يتم التصرف بالإرادة المنفردة للمتصرف ما لم يلزم الغير. ويسري على التصرف بالإرادة المنفردة ما يسري على العقد من الأحكام باستثناء أحكام القبول."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
