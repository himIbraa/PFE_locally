<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1_obligation_0_9b3be95b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب، تحت طائلة البطلان، تحرير العقود التي تتضمن نقل ملكية عقار أو حقوق عقارية أو محلات تجارية أو صناعية أو كل عنصر من عناصرها، أو التنازل عن أسهم من شركة أو حصص فيها، أو عقود إيجار زراعية أو تجارية أو عقود تسيير محلات تجارية أو مؤسسات صناعية في شكل رسمي"@ar ;
    dznorm:sourceArticle "art_324_bis_1" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1_obligation_1_c7531d51> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
