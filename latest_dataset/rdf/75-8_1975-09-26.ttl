<https://legal.dz/resource/order/1975-09-26/75-58#version_art_992> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المبالغ التي صرفت في حفظ المنقول وفيما يلزم له من ترميم يكون لها امتياز عليه كله . وتستوفى هذه المبالغ من ثمن هذا المنقول المثقل بحق الامتياز بعد المصاريف القضائية والمبالغ المستحقة للخزينة العامة مباشرة. أما فيما بينها فيقدم بعضها على بعض بحسب الترتيب العكسي لتواريخ صرفها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_992_19750926_OpEnact_b3ea5c9258> ;
    dzdoc:replacementText "المبالغ التي صرفت في حفظ المنقول وفيما يلزم له من ترميم يكون لها امتياز عليه كله . وتستوفى هذه المبالغ من ثمن هذا المنقول المثقل بحق الامتياز بعد المصاريف القضائية والمبالغ المستحقة للخزينة العامة مباشرة. أما فيما بينها فيقدم بعضها على بعض بحسب الترتيب العكسي لتواريخ صرفها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_992> ;
