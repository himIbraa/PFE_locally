<https://legal.dz/resource/order/1975-09-26/75-58#version_art_193> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا ادعى الدائن عسر المدين فليس عليه إلا أن يثبت مقدار ما في ذمته من ديون. و على المدين نفسه أن يثبت أن له مالا يساوي قيمة الديون أو يزيد عليها ."@ar ;
