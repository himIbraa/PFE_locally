<https://legal.dz/resource/order/1975-09-26/75-58#version_art_296> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون التزام المناب تجاه المناب لديه صحيحا ولو كان التزامه تجاه المنيب باطلا أو كان خاضعا لدفع من الدفوع ما لم يرجع المناب على المنيب ، وما لم يوجد اتفاق يقضي بغير ذلك ."@ar ;
