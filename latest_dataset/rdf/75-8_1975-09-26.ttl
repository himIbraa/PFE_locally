    dznorm:sourceArticle "art_745" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_746_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_746> ;
    dzdoc:position 0 ;
    dzdoc:text "تتناسب الحصة في الأجزاء المشتركة الخاصة لكل قسمة مع المساحة النافعة بالنسبة للمساحة الاجمالية النافعة لمجموع القسمات التي تشكل الوحدة العقارية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_747_obligation_0_2ef97bf7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
