<https://legal.dz/resource/order/1975-09-26/75-58#version_art_885> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يبقى صحيحا لمصلحة الدائن المرتهن الرهن الصادر من المالك الذي تقرر إبطال سند ملكيته، أو فسخه، أو إلغاؤه أو زواله لأي سبب آخر، إذا ثبت أن الدائن كان حسن النية وقت إبرام عقد الرهن ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_885_19750926_OpEnact_9b8e4be1c6> ;
