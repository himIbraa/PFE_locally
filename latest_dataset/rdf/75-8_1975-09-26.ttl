<https://legal.dz/resource/order/1975-09-26/75-58#art_795_extref_93812849> a dzdoc:ExternalReference ;
    rdfs:label "الأمر المتعلق بالثورة الزراعية"@ar ;
    dzdoc:frbrUri "/akn/dz/act/order/unknown/unknown"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/order/unknown/unknown"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/order/unknown/unknown" ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/unknown/unknown> ;
    dzdoc:resolutionReason "canonical_document_uri" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/order/unknown/unknown"^^xsd:anyURI .

<https://legal.dz/resource/order/1975-09-26/75-58#art_795_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_795> ;
    dzdoc:position 0 ;
    dzdoc:text "يثبت حق الشفعة وذلك مع مراعاة الأحكام التي ينص عليها الأمر المتعلق بالثورة الزراعية : لمالك الرقبة إذا بيع الكل أو البعض من حق الانتفاع المناسب للرقبة، للشريك في الشيوع إذا بيع جزء من العقار المشاع إلى أجنبي، لصاحب حق الانتفاع إذا بيعت الرقبة كلها أو بعضها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_795_right_0_11d1ea9c> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_795> ;
    dznorm:position 0 ;
    dznorm:provisionText "يثبت حق الشفعة"@ar ;
    dznorm:sourceArticle "art_795" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_796_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_796> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا تعدد الشفعاء يكون استعمال حق الشفعة حسب الترتيب المنصوص عليه في الفقرات التالية : إذا كان الشفعاء من طبقة واحدة استحق كل منهم الشفعة بقدر نصيبه، وإذا كان المشتري قد توفرت فيه الشروط التي تجعله شفيعا بمقتضى المادة 795 فإنه يفضل على الشفعاء من طبقته أو من طبقة أدنى ولكن يتقدمه الذين هم من طبقة أعلى."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_797_condition_0_1675f1db> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-58#art_797_condition_0_1675f1db_ref_77db5479b1c3> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_801> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_801> ;
    dznorm:conditionText "إذا اشترى شخص عقارا تجوز الشفعة فيه ثم باعه قبل أن تعلن أي رغبة في الأخذ بالشفعة أو قبل تسجيل هذه الرغبة طبقا للمادة 801"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_797> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_797_condition_0_1675f1db_ref_77db5479b1c3> a dzdoc:Reference ;
    rdfs:label "للمادة 801"@ar ;
    dzdoc:frbrUri "#art_801"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/order/1975-09-26/75-58#art_801> ;
    dzdoc:sourceEId "art_797" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "إذا اشترى شخص عقارا تجوز الشفعة فيه ثم باعه قبل أن تعلن أي رغبة في الأخذ بالشفعة أو قبل تسجيل هذه الرغبة طبقا للمادة 801"@ar ;
    dzdoc:targetEId "art_801" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_797_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_797> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا اشترى شخص عقارا تجوز الشفعة فيه ثم باعه قبل أن تعلن أي رغبة في الأخذ بالشفعة أو قبل تسجيل هذه الرغبة طبقا للمادة 801 فلا يجوز الأخذ بالشفعة الا من المشتري الثاني وحسب الشروط التي اشترى بها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_797_permission_0_842a33b9> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
