<https://legal.dz/resource/order/1975-09-26/75-58#version_art_145> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن لـ الدائن أن يطالب بحق مؤجل قبل حلول أجله أما إذا تم الوفاء معجلا فلا يجوز استرداد ما دفع حتى ولو كان المدين يجهل الأجل. وفي هذه الحالة يجوز للمدين أن يطالب في حدود الضرر اللاحق به برد مبلغ الاثراء الذي حصل عليه الدائن بسبب هذا الوفاء المعجل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_145_19750926_OpEnact_5b6aa50710> ;
    dzdoc:replacementText "لا يمكن لـ الدائن أن يطالب بحق مؤجل قبل حلول أجله أما إذا تم الوفاء معجلا فلا يجوز استرداد ما دفع حتى ولو كان المدين يجهل الأجل. وفي هذه الحالة يجوز للمدين أن يطالب في حدود الضرر اللاحق به برد مبلغ الاثراء الذي حصل عليه الدائن بسبب هذا الوفاء المعجل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_145> ;
