<https://legal.dz/resource/order/1975-09-26/75-58#version_art_870> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا فرضت قيود معينة تحد من حق مالك العقار في البناء عليه كيف شاء كان يمنع من تجاوز حد معين في الارتفاق بالبناء أو في مساحة رقعته فإن هذه القيود تكون حقوق ارفاق على هذا العقار لفائدة العقارات المجاورة التي فرضت لمصلحتها هذه القيود هذا ما لم يكن هناك اتفاق يخالف ذلك. وكل مخالفة لهذه القيود قد تجعل محلا للمطالبة بإصلاحها عينا الا انه يجوز الاقتصار على الحكم بالتعويض إذا اقتضى رأي المحكمة اختيار هذه الطريقة للتعويض."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_870_19750926_OpEnact_b58db98a4c> ;
    dzdoc:replacementText "إذا فرضت قيود معينة تحد من حق مالك العقار في البناء عليه كيف شاء كان يمنع من تجاوز حد معين في الارتفاق بالبناء أو في مساحة رقعته فإن هذه القيود تكون حقوق ارفاق على هذا العقار لفائدة العقارات المجاورة التي فرضت لمصلحتها هذه القيود هذا ما لم يكن هناك اتفاق يخالف ذلك. وكل مخالفة لهذه القيود قد تجعل محلا للمطالبة بإصلاحها عينا الا انه يجوز الاقتصار على الحكم بالتعويض إذا اقتضى رأي المحكمة اختيار هذه الطريقة للتعويض."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_870> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
