<https://legal.dz/resource/order/1975-09-26/75-58#version_art_732> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز نقض القسمة الحاصلة بالتراضي إذا أثبت أحد المتقاسمين أنه لحقه منها غبن يزيد على الخمس (1/5) ، على أن تكون العبرة في التقدير بقيمة الشيء وقت القسمة. ويجب أن ترفع الدعوى خلال السنة التالية للقسمة و للمدعى عليه أن يوقف سيرها ويمنع القسمة من جديد إذا أكمل للمدعى نقدا أو عينا ما نقص من حصته ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_732_19750926_OpEnact_eab39588e6> ;
    dzdoc:replacementText "يجوز نقض القسمة الحاصلة بالتراضي إذا أثبت أحد المتقاسمين أنه لحقه منها غبن يزيد على الخمس (1/5) ، على أن تكون العبرة في التقدير بقيمة الشيء وقت القسمة. ويجب أن ترفع الدعوى خلال السنة التالية للقسمة و للمدعى عليه أن يوقف سيرها ويمنع القسمة من جديد إذا أكمل للمدعى نقدا أو عينا ما نقص من حصته ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_732> ;
