<https://legal.dz/resource/order/1975-09-26/75-58#version_art_941> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "على الدائن الذي يريد أخذ تخصيص على عقارات مدينة أن يقدم عريضة بذلك إلى رئيس المحكمة التي تقع في دائرتها العقارات التي يريد التخصيص بها . وهذه العريضة يجب أن تكون مصحوبة بصورة رسمية من الحكم أو بشهادة من قلم الكتاب مدون فيها منطوق الحكم، وأن تشمل البيانات الآتية : اسم الدائن ولقبه ومهنته وموطنه الأصلي والموطن المختار الذي يعينه في البلدة التي يقع فيها مقر المحكمة، اسم المدين ولقبه ومهنته وموطنه، تاريخ الحكم وبيان المحكمة التي أصدرته، مقدار الدين، فإن كان الدين المذكور في الحكم غير محدد المقدار، ت"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_941_19750926_OpEnact_11e5b94978> ;
    dzdoc:replacementText "على الدائن الذي يريد أخذ تخصيص على عقارات مدينة أن يقدم عريضة بذلك إلى رئيس المحكمة التي تقع في دائرتها العقارات التي يريد التخصيص بها . وهذه العريضة يجب أن تكون مصحوبة بصورة رسمية من الحكم أو بشهادة من قلم الكتاب مدون فيها منطوق الحكم، وأن تشمل البيانات الآتية : اسم الدائن ولقبه ومهنته وموطنه الأصلي والموطن المختار الذي يعينه في البلدة التي يقع فيها مقر المحكمة، اسم المدين ولقبه ومهنته وموطنه، تاريخ الحكم وبيان المحكمة التي أصدرته، مقدار الدين، فإن كان الدين المذكور في الحكم غير محدد المقدار، تولى رئيس المحكمة تقديره مؤقتا وعين المبلغ الذي يؤخذ به حق التخصيص ، تعيين العقارات تعيينا دقيقا وبيان موقعها مع تقديم الأوراق الدالة على قيمتها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_941> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_941> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_942> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يدون رئيس المحكمة في ذيل العريضة أمره بالتخصيص. وعليه عند الترخيص به أن يراعي مقدار الدين وقيمة العقارات المبينة بالعريضة بوجه التقريب، عند الاقتضاء ويجعل الاختصاص مقصورا على بعض هذه العقارات أو على واحد منها فقط أو على جزء من أحدها إذا رأى أن ذلك كاف لتأمين دفع أصل الدين والمصاريف المستحقة للدائنين . الأمر الصادر بالتخصيص واجب التنفيذ بقطع النظر عن جميع طرق الطعن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_942_19750926_OpEnact_4edd2895c5> ;
    dzdoc:replacementText "يدون رئيس المحكمة في ذيل العريضة أمره بالتخصيص. وعليه عند الترخيص به أن يراعي مقدار الدين وقيمة العقارات المبينة بالعريضة بوجه التقريب، عند الاقتضاء ويجعل الاختصاص مقصورا على بعض هذه العقارات أو على واحد منها فقط أو على جزء من أحدها إذا رأى أن ذلك كاف لتأمين دفع أصل الدين والمصاريف المستحقة للدائنين . الأمر الصادر بالتخصيص واجب التنفيذ بقطع النظر عن جميع طرق الطعن."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_942> ;
