<https://legal.dz/resource/order/1975-09-26/75-58#version_art_967> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للدائن المرتهن لعقار أن يؤجر العقار إلى الراهن دون أن يمنع ذلك من نفاذ الرهن في حق الغير . فإذا اتفق على الإيجار في عقد الرهن وجب ذكر ذلك في العقد ذاته . وإذا اتفق عليه بعد الرهن وجب أن يؤشر به في هامش القيد . ولا يكون هذا التأشير ضروريا إذا جدد الإيجار تجديدا ضمنيا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_967_19750926_OpEnact_bb42ff2c83> ;
    dzdoc:replacementText "يجوز للدائن المرتهن لعقار أن يؤجر العقار إلى الراهن دون أن يمنع ذلك من نفاذ الرهن في حق الغير . فإذا اتفق على الإيجار في عقد الرهن وجب ذكر ذلك في العقد ذاته . وإذا اتفق عليه بعد الرهن وجب أن يؤشر به في هامش القيد . ولا يكون هذا التأشير ضروريا إذا جدد الإيجار تجديدا ضمنيا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_967> ;
