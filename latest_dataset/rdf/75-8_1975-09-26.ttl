<https://legal.dz/resource/order/1975-09-26/75-58#version_art_104> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان العقد في شق منه باطلا أو قابلا للابطال ، فهذا الشق وحده هو الذي يبطل، الا إذا تبين أن العقد ما كان ليتم بغير الشق الذي وقع باطلا، أو قابلا للابطال فيبطل العقد كله."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
