<https://legal.dz/resource/order/1975-09-26/75-58#version_art_72_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمنح دفع العربون وقت إبرام العقد لكل من المتعاقدين الحق في العدول عنه خلال المدة المتفق عليها ، إلا إذا قضى الاتفاق بخلاف ذلك. فإذا عدل من دفع العربون فقدة. وإذا عدل من قبضه رده ومثله ولو لم يترتب على العدول أي ضرر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_72_bis_19750926_OpEnact_cac27d5eac> ;
