<https://legal.dz/resource/order/1975-09-26/75-58#art_1001> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_1001" ;
    dzdoc:fullText "أن للشركاء الذين اقتسموا عقارا، حق امتياز عليه تأمينا لما تخوله القسمة من حق في رجوع كل منهم على الآخرين ، بما في ذلك حق المطالبة بمعدل القسمة، و يجب أن يقيد هذا الامتياز وتكون مرتبته مماثلة لشروط امتياز البائع المشار إليه في المادة 999 ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_1001_right_0_82d232b2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1001> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_1001_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1001_19750926_OpEnact_755ded89ed> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_1001_obligation_0_b0b64282> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "1001" ;
    dzdoc:position 1052 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_999> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_999> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_103> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2_bis> ;
    dzdoc:eId "art_103" ;
    dzdoc:fullText "يعاد المتعاقدان إلى الحالة التي كانا عليها قبل العقد في حالة بطلان العقد أو إبطاله، فإن كان هذا مستحيلا جاز الحكم بتعويض معادل. غير أنه لا يلزم ناقص الأهلية، إذا أبطل العقد لنقص أهليته، إلا برد ما عاد عليه من منفعة بسبب تنفيذ العقد . يحرم من الاسترداد في حالة بطلان العقد من تسبب في عدم مشروعيته أو كان عالما به."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_103> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_103_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_103_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_103_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_103_19750926_OpEnact_22206f3f97> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_103_obligation_0_a1f98284>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_103_obligation_1_c5650344> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "103" ;
    dzdoc:position 110 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_113> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_113" ;
    dzdoc:fullText "لا يرتب العقد التزاما في ذمة الغير، و لكن يجوز أن يكسبه حقا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_113_permission_0_36610021> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_113_right_0_43208da6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_113> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_113_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_113_19750926_OpEnact_3f095855ba> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 113" ;
    dzdoc:position 120 ;
    dzdoc:usesTerm dzterm:contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_134> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_134" ;
    dzdoc:fullText "كل من يجب عليه قانونا أو اتفاقا رقابة شخص في حاجة إلى الرقابة بسبب قصره أو بسبب حالته العقلية أو الجسمية، يكون ملزما بتعويض الضرر الذي يحدثه ذلك الشخص للغير بفعله الضار . ويستطيع المكلف بالرقابة أن يتخلص من المسؤولية إذا أثبت أنه قام بواجب الرقابة أو أثبت أن الضرر كان لابد من حدوثه ولو قام بهذا الواجب بما ينبغي من العناية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_134> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_134_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_134_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_134_19750926_OpEnact_bf5c50a398> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_134_obligation_0_c685ae2b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "134" ;
    dzdoc:position 144 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_134_condition_0_8b8e6ce3> ;
    dzdoc:usesTerm dzterm:supervisor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_136> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:subordination_relationship ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_136" ;
    dzdoc:fullText "يكون المتبوع مسؤولا عن الضرر الذي يحدثه تابعه بفعله الضار متى كان واقعا منه في حالة تأدية وظيفته أو بسببها أو بمناسبتها . وتتحقق علاقة التبعية ولو لم يكن المتبوع حرا في اختيار تابعه متى كان هذا الأخير يعمل لحساب المتبوع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_136> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_136_defocc_ffe2e3a7bc34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_136_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_136_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_136_19750926_OpEnact_1ad169f33b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "136" ;
    dzdoc:position 146 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_136_condition_0_572fc265>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_136_condition_1_040291ee> ;
    dzdoc:usesTerm dzterm:principal,
        dzterm:subordinate .

<https://legal.dz/resource/order/1975-09-26/75-58#art_138> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_3> ;
    dzdoc:eId "art_138" ;
    dzdoc:fullText "كل من تولى حراسة شيء وكانت له قدرة الاستعمال والتسيير، والرقابة ، يعتبر مسؤولا عن الضرر الذي يحدثه ذلك الشيء . ويعفي من هذه المسؤولية الحارس للشيء إذا أثبت أن ذلك الضرر حدث بسبب لم يكن يتوقعه مثل عمل الضحية، أو عمل الغير ، أو الحالة الطارئة، أو القوة القاهرة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_138> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_138_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_138_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_138_19750926_OpEnact_c70ec20960> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_138_obligation_0_6e9af65d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "138" ;
    dzdoc:position 148 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_138_condition_0_840a923f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_138_condition_1_776bcd13> ;
    dzdoc:usesTerm dzterm:guardian .

<https://legal.dz/resource/order/1975-09-26/75-58#art_146> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_146" ;
    dzdoc:fullText "لا محل لاسترداد غير المستحق إذا حصل الوفاء من غير المدين وترتب عليه أن الدائن، وهو حسن النية، قد تجرد من سند الدين أو مما حصل عليه من التأمينات أو ترك دعواه تسقط بالتقادم قبل المدين الحقيقي و يلتزم المدين الحقيقي في هذه الحالة بتعويض الغير الذي قام بالوفاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_146> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_146_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_146_19750926_OpEnact_75f1e76aa6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_146_obligation_0_fbcadac2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "146" ;
    dzdoc:position 158 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_146_condition_0_dcafa6c3> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_156> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_156" ;
    dzdoc:fullText "إذا مات الفضولي التزم ورثته بما يلزم به ورثة الوكيل طبقا لاحكام المادة 589 فقرة 2 . وإذا مات رب العمل بقي الفضولي ملتزما نحو الورثة بما كان ملزما به نحو مورثهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_156> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_156_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_156_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_156_19750926_OpEnact_730306a1b0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_156_obligation_0_aa85ec62> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 156" ;
    dzdoc:position 168 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_589> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_589> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_156_condition_0_172d7340>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_156_condition_1_8daf7b26> ;
    dzdoc:usesTerm dzterm:فضولي .

<https://legal.dz/resource/order/1975-09-26/75-58#art_160> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2> ;
    dzdoc:eId "art_160" ;
    dzdoc:fullText "المدين ملزم بتنفيذ ما تعهد به . غير أنه لا يجبر على التنفيذ إذا كان الالتزام طبيعيا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_160> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_160_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_160_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_160_19750926_OpEnact_733cc0551e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_160_obligation_0_da10a9f3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "160" ;
    dzdoc:position 172 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_160_condition_0_cbb000cf> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_185> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_185" ;
    dzdoc:fullText "إذا جاوز الضرر قيمة التعويض المحدد في الاتفاق فلا يجوز للدائن أن يطالب بأكثر من هذه القيمة إلا إذا أثبت أن المدين قد ارتكب غشا، أو خطأ جسيما ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_185_permission_0_2c4d0985> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_185> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_185_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_185_19750926_OpEnact_9ef5b97a4b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 185" ;
    dzdoc:position 198 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_185_condition_0_9a1935da>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_185_condition_1_20e055bd> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_188> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_3> ;
    dzdoc:eId "art_188" ;
    dzdoc:fullText "أموال المدين جميعها ضامنة لوفاء ديونه . وفي حالة عدم وجود حق أفضلية مكتسب طبقا للقانون فإن جميع الدائنين متساوون تجاه هذا الضمان ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_188_right_0_d5501b1c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_188> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_188_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_188_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_188_19750926_OpEnact_1618bfb2a2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_188_obligation_0_1b812d13> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "188" ;
    dzdoc:position 201 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_188_condition_0_be3e6d45> ;
    dzdoc:usesTerm dzterm:debtor_assets .

<https://legal.dz/resource/order/1975-09-26/75-58#art_202> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_202" ;
    dzdoc:fullText "ينقضي الحق في الحبس بخروج الشيء من يد حائزه أو محرزه. غير انه لحابس الشيء إذا خرج من يده بغير علمه أو بالرغم من معارضته أن يطلب استرداده ، إذا هو قام بهذا الطلب خلال ثلاثين يوما من الوقت الذي علم فيه بخروج الشيء من يده ما لم تنقض سنة من وقت خروجه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_202_right_0_b60d34fc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_202> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_202_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_202_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_202_19750926_OpEnact_a84471a8e3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "202" ;
    dzdoc:position 215 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_202_condition_0_025a7106> ;
    dzdoc:usesTerm dzterm:right_of_retention .

<https://legal.dz/resource/order/1975-09-26/75-58#art_207> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_207" ;
    dzdoc:fullText "يزول الالتزام إذا تحقق الشرط الفاسخ ، و يكون الدائن ملزما برد ما أخذه فإذا استحال الرد لسبب هو مسؤول عنه وجب عليه تعويض الضرر . غير أن أعمال الادارة التي تصدر من الدائن تبقى نافذة رغم تحقق الشرط."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_207> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_207_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_207_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_207_19750926_OpEnact_abf53e6bf9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_207_obligation_0_4a7211b6>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_207_obligation_1_f0c2d70b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "207" ;
    dzdoc:position 220 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_207_condition_0_326301be> ;
    dzdoc:usesTerm dzterm:obligation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_225> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_225" ;
    dzdoc:fullText "لا يجوز للمدين المتضامن التمسك بـ المقاصة التي تقع بين الدائن ومدين متضامن آخر الا بقدر حصة هذا المدين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_225_permission_0_85223a48> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_225> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_225_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_225_19750926_OpEnact_c2b8a583e7> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_225_prohibition_0_85223a48> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "225" ;
    dzdoc:position 238 ;
    dzdoc:usesTerm dzterm:set-off .

<https://legal.dz/resource/order/1975-09-26/75-58#art_235> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_235" ;
    dzdoc:fullText "إذا أعسر أحد المدينين المتضامنين تحمل هذا الاعسار من وفي الدين وسائر المدينين الموسرين كل بقدر حصته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_235> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_235_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_235_19750926_OpEnact_dd50f4bb9c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_235_obligation_0_807a40f0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 235" ;
    dzdoc:position 248 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_235_condition_0_fdcb70b1> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_236> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_2> ;
    dzdoc:eId "art_236" ;
    dzdoc:fullText "لا يقبل الالتزام الانقسام : إذا ورد على محل لا يقبل الانقسام بطبيعته ، إذا تبين من غرض الطرفين أن تنفيذ الالتزام لا ينقسم، أو إذا انصرفت نيتهم إلى ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_236> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_236_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_236_19750926_OpEnact_87283d9ff3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_236_obligation_0_e5c0da83> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 236" ;
    dzdoc:position 249 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_236_condition_0_174c86c9>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_236_condition_1_5dac40de> ;
    dzdoc:usesTerm dzterm:obligation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_23_bis_1" ;
    dzdoc:fullText "إذا تقرر أن قانونا أجنبيا هو الواجب التطبيق فلا تطبق منه إلا أحكامه الداخلية دون تلك الخاصة بتنازع القوانين من حيث المكان. غير أنه يطبق القانون الجزائري إذا أحالت عليه قواعد تنازع القوانين في القانون الأجنبي المختص ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_23_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_1_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_23_bis_1_19750926_OpEnact_b3b6c5cb5f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_1_obligation_0_61bb1866> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "23 مكرر 1" ;
    dzdoc:position 28 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_1_condition_0_04d720a1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_1_condition_1_b382e195> ;
    dzdoc:usesTerm dzterm:algerian_law .

<https://legal.dz/resource/order/1975-09-26/75-58#art_254> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_2> ;
    dzdoc:eId "art_254" ;
    dzdoc:fullText "يحال الدين بكامل ضماناته. غير انه لا يبقى للكفيل عينيا كان أو شخصيا، التزام تجاه الدائن الا إذا رضي بالحوالة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_254> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_254_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_254_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_254_19750926_OpEnact_b5a3a09884> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "254" ;
    dzdoc:position 267 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_254_condition_0_44ae6cc1> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_26> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_26" ;
    dzdoc:fullText "تثبت الولادة والوفاة بالسجلات المعدة لذلك. وإذا لم يوجد هذا الدليل، أو تبين عدم صحة ما أدرج بالسجلات ، يجوز الاثبات بأية طريقة حسب الاجراءات التي ينص عليها قانون الحالة المدنية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_26_permission_0_1211ad91> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_26> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_26_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_26_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_26_19750926_OpEnact_ed4ea28aa2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "26" ;
    dzdoc:position 32 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_26_condition_0_1a4b90fd> ;
    dzdoc:usesTerm dzterm:civil_status_law .

<https://legal.dz/resource/order/1975-09-26/75-58#art_270> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_270" ;
    dzdoc:fullText "إذا تم اعذار الدائن فإنه يتحمل تبعة هلاك الشيء، أو تلفه ويصبح للمدين الحق في ايداع الشيء على نفقة الدائن ، والمطالبة بتعويض، ما أصابه من ضرر ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_270_right_0_a9c65a69> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_270> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_270_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_270_19750926_OpEnact_ecaa8b4763> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_270_obligation_0_08886ad3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "270" ;
    dzdoc:position 283 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_270_condition_0_3641ef80> ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_279> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_2> ;
    dzdoc:eId "art_279" ;
    dzdoc:fullText "إذا تعددت الديون في ذمة المدين ، وكانت لدائن واحد ومن جنس واحد وكان ما أداه لا يفي بهذه الديون جميعا، جاز للمدين عند الوفاء تعيين الدين الذي يريد الوفاء به ما لم يوجد مانع قانوني، أو تعاقدي يحول دون هذا التعيين ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_279_right_0_332299c9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_279> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_279_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_279_19750926_OpEnact_2aa4a943cb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 279" ;
    dzdoc:position 292 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_279_condition_0_1ea447ad> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_296> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_2> ;
    dzdoc:eId "art_296" ;
    dzdoc:fullText "يكون التزام المناب تجاه المناب لديه صحيحا ولو كان التزامه تجاه المنيب باطلا أو كان خاضعا لدفع من الدفوع ما لم يرجع المناب على المنيب ، وما لم يوجد اتفاق يقضي بغير ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_296> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_296_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_296_19750926_OpEnact_220a7ce971> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_296_obligation_0_41e97740> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 296" ;
    dzdoc:position 309 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_296_condition_0_66edfb5d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_296_condition_1_a20386b1> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_300> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_3> ;
    dzdoc:eId "art_300" ;
    dzdoc:fullText "لا تقع المقاصة الا إذا تمسك بها من له مصلحة فيها ، ولا يجوز النزول عنها قبل ثبوت الحق فيها. ويترتب عليها انقضاء الدينين بقدر الاقل منهما منذ الوقت الذي يصبحان فيه صالحين للمقاصة ويكون تعيين جهة الدفع في المقاصة كتعيينها في الوفاء."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_300_permission_0_9e14e41d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_300> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_300_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_300_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_300_19750926_OpEnact_681c5892ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "300" ;
    dzdoc:position 313 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_300_condition_0_7492959f> ;
    dzdoc:usesTerm dzterm:مقاصة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_302> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_3> ;
    dzdoc:eId "art_302" ;
    dzdoc:fullText "لا تقع المقاصة اضرارا بحقوق كسبها الغير. فإذا اوقع الغير حجزا تحت يد المدين ثم أصبح هذا الأخير دائنا لدائنه فلا يجوز له أن يتمسك بالمقاصة اضرارا للحاجز."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_302_permission_0_a780e7d8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_302> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_302_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_302_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_302_19750926_OpEnact_6548ee8115> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "302" ;
    dzdoc:position 315 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_302_condition_0_e9ff64f8> ;
    dzdoc:usesTerm dzterm:مقاصة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_305> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:discharge ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_1> ;
    dzdoc:eId "art_305" ;
    dzdoc:fullText "ينقضي الالتزام إذا برأ الدائن مدينه اختياريا ويتم الابراء متى وصل إلى علم المدين ولكن يصبح باطلا إذا رفضه المدين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_305> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_305_defocc_a17b75d314e6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_305_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_305_19750926_OpEnact_9fe2b50717> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_305_obligation_0_ec5fcc2d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 305" ;
    dzdoc:position 318 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_305_condition_0_e0616974>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_305_condition_1_b594ec93> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor,
        dzterm:obligation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_309> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_3> ;
    dzdoc:eId "art_309" ;
    dzdoc:fullText "يتقادم بخمس (5) سنوات كل حق دوري متجدد ولو أقر به المدين كأجرة المباني، والديون المتأخرة، والمرتبات والاجور، والمعاشات. غير أنه لا يسقط الريع المستحق في ذمة الحائز سيئ النية، ولا الريع الواجب أداؤه على متصرف المال المشاع للمستحقين الا بانقضاء خمسة عشرة (15) سنة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_309> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_309_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_309_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_309_19750926_OpEnact_660ef95573> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_309_obligation_0_fbf05ef2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "309" ;
    dzdoc:position 322 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_315> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_3> ;
    dzdoc:eId "art_315" ;
    dzdoc:fullText "لا يبدأ سريان التقادم فيما لم يرد فيه نص خاص الا من اليوم الذي يصبح فيه الدين مستحق الأداء. وخصوصا لا يسري التقادم بالنسبة إلى دين معلق على شرط واقف الا من اليوم الذي يتحقق فيه الشرط وبالنسبة إلى ضمان الاستحقاق الا من الوقت الذي يثبت فيه الاستحقاق، وبالنسبة إلى الدين المؤجل الا من الوقت الذي ينقضي فيه الأجل. وإذا كان تحديد ميعاد الوفاء متوقفا على إرادة الدائن سرى التقادم من الوقت الذي يتمكن فيه الدائن من إعلان إرادته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_315> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_315_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_315_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_315_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_315_19750926_OpEnact_cb36f4f318> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "315" ;
    dzdoc:position 328 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_315_condition_0_944505bc> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_323> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_323" ;
    dzdoc:fullText "على الدائن اثبات الالتزام و على المدين اثبات التخلص منه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_323> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_323_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_323_19750926_OpEnact_c5cd6b6395> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_323_obligation_0_66b1581f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_323_obligation_1_e21b4d69> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 323" ;
    dzdoc:position 336 ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_324_bis_7" ;
    dzdoc:fullText "يعتبر العقد الرسمي حجة بين الاطراف حتى ولو لم يعبر فيه الا ببيانات على سبيل الاشارة، شريطة أن يكون لذلك علاقة مباشرة مع الاجراء . ولا يمكن استعمال البيانات التي ليست لها صلة بالاجراء سوى كبداية للثبوت."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_7_permission_0_b904ae43> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_7_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_7_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_7_19750926_OpEnact_c48cd0b10d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "324 مكرر 7" ;
    dzdoc:position 346 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_7_condition_0_c7178368> ;
    dzdoc:usesTerm dzterm:authentic_act .

<https://legal.dz/resource/order/1975-09-26/75-58#art_325> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_325" ;
    dzdoc:fullText "إذا كان أصل الورقة الرسمية موجودا ، فإن صورتها الرسمية خطية كانت أو فوتوغرافية تكون حجة بالقدر الذي تكون فيه مطابقة للأصل. وتعتبر الصورة مطابقة للأصل ما لم ينازع في ذلك أحد الطرفين، فإن وقع تنازع ففي هذه الحالة تراجع الصورة على الأصل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_325> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_325_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_325_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_325_19750926_OpEnact_bdc71faf67> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "325" ;
    dzdoc:position 347 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_325_condition_0_ad24a214>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_325_condition_1_6ca8f77a> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_329> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_329" ;
    dzdoc:fullText "تكون للرسائل الموقع عليها قيمة الاوراق العرفية من حيث الاثبات. وتكون للبرقيات هذه القيمة أيضا إذا كان أصلها المودع في مكتب التصدير موقعا عليه من مرسلها ، وتعتبر البرقية مطابقة لأصلها حتى يقوم الدليل على عكس ذلك. وإذا تلف أصل البرقية فلا تعتبر نسختها الا لمجرد الاستئناس."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_329> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_329_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_329_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_329_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_329_19750926_OpEnact_c605cb74ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "329" ;
    dzdoc:position 353 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_329_condition_0_68b58ec0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_329_condition_1_c0e505be> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_336> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_2> ;
    dzdoc:eId "art_336" ;
    dzdoc:fullText "يجوز الإثبات بالشهود أيضا فيما كان يجب إثباته بالكتابة : إذا وجد مانع مادي أو أدبي يحول دون الحصول على دليل كتابي، إذا فقد الدائن سنده الكتابي لسبب أجنبي خارج عن إرادته."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_336_permission_0_6b487514> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_336> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_336_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_336_19750926_OpEnact_7ff2b866f7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 336" ;
    dzdoc:position 360 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_340> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_3> ;
    dzdoc:eId "art_340" ;
    dzdoc:fullText "يترك لتقدير القاضي استنباط كل قرينة لم يقررها القانون و لا يجوز الاثبات بهذه القرائن الا في الأحوال التي يجيز فيها القانون الاثبات بالبينة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_340_permission_0_9084bbde> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_340> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_340_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_340_19750926_OpEnact_fd1d671e0a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "340" ;
    dzdoc:position 364 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_340_condition_0_c4c01708> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_348> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_5> ;
    dzdoc:eId "art_348" ;
    dzdoc:fullText "للقاضي أن يوجه اليمين تلقائيا إلى أي من الخصمين ليبني على ذلك حكمه في موضوع الدعوى أو في ما يحكم به . ويشترط في توجيه هذه اليمين الا يكون في الدعوى دليل كامل، والا تكون الدعوى خالية من أي دليل ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_348_right_0_0c3dd851> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_348> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_348_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_348_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_348_19750926_OpEnact_b5123f5d21> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "348" ;
    dzdoc:position 372 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_348_condition_0_c8c384c6> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_354> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_354" ;
    dzdoc:fullText "يتعين على المشتري في البيع بشرط المذاق أن يقبل المبيع كيفما شاء غير انه يجب عليه أن يعلن بقبوله في الأجل المحدد بعقد الاتفاق أو العرف ، ولا ينعقد البيع الا من يوم هذا الاعلان."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_354> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_354_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_354_19750926_OpEnact_a9b327e351> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_354_obligation_0_e89651cb>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_354_obligation_1_74efacaa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 354" ;
    dzdoc:position 378 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_359> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_359" ;
    dzdoc:fullText "تسقط بالتقادم دعوى تكملة الثمن بسبب الغبن إذا انقضت ثلاث سنوات من يوم وبالنسبة لعديمي الأهلية فمن يوم انقطاع سبب العجز . ولا تلحق هذه الدعوى ضررا بالغير الحسن النية إذا كسب حقا عينيا على العقار المبيع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_359> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_359_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_359_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_359_19750926_OpEnact_42e215f065> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 359" ;
    dzdoc:position 383 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_359_condition_0_0edef52d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_359_condition_1_8c0e5ea2> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_360> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_360" ;
    dzdoc:fullText "لا يجوز الطعن بالغبن في بيع تم بطريق المزاد العلني بمقتضى القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_360_permission_0_332a8b04> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_360> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_360_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_360_19750926_OpEnact_66ad74e5ae> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_360_prohibition_0_332a8b04> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 360" ;
    dzdoc:position 384 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_367> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:delivery ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_367" ;
    dzdoc:fullText "يتم التسليم بوضع المبيع تحت تصرف المشتري بحيث يتمكن من حيازته والانتفاع به دون عائق ولو لم يتسلمه تسلما ماديا ما دام البائع قد أخبره بانه مستعد لتسليمه بذلك ويحصل التسليم على النحو الذي يتفق مع طبيعة الشيء المبيع. وقد يتم التسليم بمجرد تراضي الطرفين على البيع إذا كان المبيع موجودا تحت يد المشتري قبل البيع أو كان البائع قد استبقى المبيع في حيازته بعد البيع لسبب آخر لا علاقة له بالملكية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_367> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_367_defocc_78df0880677e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_367_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_367_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_367_19750926_OpEnact_6e493deabf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 367" ;
    dzdoc:position 391 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_367_condition_0_470c5018>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_367_condition_1_f17987ff> ;
    dzdoc:usesTerm dzterm:buyer,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_373> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_373" ;
    dzdoc:fullText "أن الرجوع بالضمان هو حق يثبت للمشتري ولو اعترف عن حسن نية بحق الغير أو تصالح معه دون أن ينتظر حكما قضائيا متى أخبر البائع بالدعوى في الوقت المناسب ودعاه يحل محله فيها دون جدوى ، كل ذلك ما لم يثبت البائع أن الغير لم يكن على حق في دعواه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_373_right_0_cab8ca26> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_373> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_373_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_373_19750926_OpEnact_be4b04f46c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 373" ;
    dzdoc:position 397 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_373_condition_0_8044c485> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_375> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_375" ;
    dzdoc:fullText "في حالة نزع اليد الكلي عن المبيع فللمشتري أن يطلب من البائع : قيمة المبيع وقت نزع اليد، قيمة الثمار التي ألزم المشتري بردها إلى الملاك الذي نزع يد المشتري عن المبيع، المصاريف النافعة التي يمكنه أن يطلبها من صاحب المبيع وكذلك المصاريف الكمالية إذا كان البائع سيئ النية، جميع مصاريف دعوى الضمان ودعوى الاستحقاق باستثناء ما كان المشتري يستطيع أن يتقيه منها لو أعلم البائع بهذه الدعوى الاخيرة طبقا للمادة 373 ، وبوجه عام تعويضه عما لحقه من الخسائر وما فاته من كسب بسبب نزع اليد عن المبيع. كل ذلك ما لم يقم المشتري دعواه على طلب فسخ البيع أو ابطاله."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_375> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_375_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_375_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_375_19750926_OpEnact_3c0be1e335> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 375" ;
    dzdoc:position 399 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_373> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_373> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_375_condition_0_1750199f> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_386> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_386" ;
    dzdoc:fullText "إذا ضمن البائع صلاحية المبيع للعمل لمدة معلومة ثم ظهر خلل فيها فعلى المشتري أن يعلم البائع في أجل شهر من يوم ظهوره وان يرفع دعواه في مدة ستة (6) أشهر من يوم الاعلام ، كل هذا ما لم يتفق الطرفان على خلافه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_386> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_386_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_386_19750926_OpEnact_4aa66386f2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_386_obligation_0_6c732f8c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 386" ;
    dzdoc:position 410 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_386_condition_0_a4ac03ca> ;
    dzdoc:usesTerm dzterm:buyer,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_387> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_387" ;
    dzdoc:fullText "يدفع ثمن البيع من مكان تسليم المبيع ما لم يوجد اتفاق أو عرف يقضي بغير ذلك. فإذا لم يكن ثمن المبيع مستحقا وقت تسلم المبيع وجب الوفاء به في المكان الذي يوجد فيه موطن للمشتري وقت استحقاقه الثمن ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_387> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_387_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_387_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_387_19750926_OpEnact_aa81667975> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_387_obligation_0_09891469>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_387_obligation_1_471013d5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 387" ;
    dzdoc:position 411 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_387_condition_0_089fb879> ;
    dzdoc:usesTerm dzterm:buyer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:age_of_majority ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "كل شخص بلغ سن الرشد متمتعا بقواه العقلية، ولم يحجر عليه ، يكون كامل الأهلية لمباشرة حقوقه المدنية . وسن الرشد تسعة عشر (19) سنة كاملة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_40_right_0_fc0d5e39> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_40> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_40_defocc_ca4813cbece7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_40_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_40_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_40_19750926_OpEnact_063d4761f2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 40" ;
    dzdoc:position 46 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_40_condition_0_a86c8c42> ;
    dzdoc:usesTerm dzterm:full_capacity .

<https://legal.dz/resource/order/1975-09-26/75-58#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:non_discernment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "لا يكون أهلا لمباشرة حقوقه المدنية من كان فاقد التمييز لصغر في السن، أو عته، أو جنون . يعتبر غير مميز من لم يبلغ ثلاث عشرة سنة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_42> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_42_defocc_5db87d66f140> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_42_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_42_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_42_19750926_OpEnact_2d558e5f6e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_42_obligation_0_36a0b2e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 42" ;
    dzdoc:position 48 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_42_condition_0_387dbdb4> ;
    dzdoc:usesTerm dzterm:lack_of_discernment .

<https://legal.dz/resource/order/1975-09-26/75-58#art_453> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_4> ;
    dzdoc:eId "art_453" ;
    dzdoc:fullText "إذا ظهر في الشيء عيب خفي واختار المقترض استيفاء الشيء فلا يلزمه أن يرد الا قيمة الشيء المعيب. أما إذا كان المقرض قد تعمد اخفاء العيب ، فللمقترض أن يطلب إما اصلاح العيب واما استبدال الشيء المعيب بشيء خال من العيوب ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_453_right_0_f36c8198> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_453> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_453_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_453_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_453_19750926_OpEnact_0a7662ed47> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 453" ;
    dzdoc:position 477 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_453_condition_0_a43df3df>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_453_condition_1_a76e68d9> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_455> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_4> ;
    dzdoc:eId "art_455" ;
    dzdoc:fullText "يجوز لمؤسسات القرض في حالة إيداع أموال لديها أن تمنح فائدة يحدد قدرها بموجب قرار من الوزير المكلف بالمالية لتشجيع الادخار."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_455_permission_0_5ebc30ab> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_455_right_0_d5f06f4d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_455> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_455_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_455_19750926_OpEnact_a934ebe01a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 455" ;
    dzdoc:position 479 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/order/1975-09-26/75-58#art_505> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_505" ;
    dzdoc:fullText "لا يجوز للمستأجر أن يتنازل عن حقه في الإيجار أو يجري إيجارا من الباطن دون موافقة المؤجر كتابيا ما لم يوجد نص قانوني يقضي بخلاف ذلك."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_505_permission_0_05e4eee1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_505> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_505_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_505_19750926_OpEnact_84346c4a4c> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_505_prohibition_0_05e4eee1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 505" ;
    dzdoc:position 535 ;
    dzdoc:usesTerm dzterm:lease,
        dzterm:lessee,
        dzterm:lessor,
        dzterm:sublease .

<https://legal.dz/resource/order/1975-09-26/75-58#art_507> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_507" ;
    dzdoc:fullText "يكون المستأجر الفرعي ملتزما مباشرة تجاه المؤجر بالقدر الذي يكون بذمته للمستأجر الأصلي وذلك في الوقت الذي أنذره المؤجر . ولا يجوز للمستأجر الفرعي أن يحتج تجاه المؤجر بما سبقه من بدل الإيجار إلى المستأجر الأصلي الا إذا تم ذلك قبل الإنذار طبقا للعرف، أو للاتفاق الثابت والمبرم وقت انعقاد الإيجار الفرعي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_507_permission_0_61740fc5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_507> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_507_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_507_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_507_19750926_OpEnact_1ba1e3a856> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 507" ;
    dzdoc:position 537 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_507_condition_0_bed48261> ;
    dzdoc:usesTerm dzterm:lease,
        dzterm:lessor,
        dzterm:original_lessee,
        dzterm:sublease,
        dzterm:sublessee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_54> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:العقد ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_54" ;
    dzdoc:fullText "العقد اتفاق يلتزم بموجبه شخص أو عدة أشخاص نحو شخص أو عدة أشخاص آخرين بمنح أو فعل أو عدم فعل شيء ما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_54> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_54_defocc_bc6a7a7687fc> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_54_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_54_19750926_OpEnact_6c74091ce1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_54_obligation_0_7915f3ef> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "54" ;
    dzdoc:position 60 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_540> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_2_subsec_1> ;
    dzdoc:eId "art_540" ;
    dzdoc:fullText "إذا اضطر المستعير إلى الانفاق للمحافظة على الشيء أثناء العارية فالمعير ملزم برد ما أنفقه المستعير من مصاريف . أما المصاريف النافعة فتجري عليها الأحكام الخاصة بالمصاريف التي ينفقها حائز الشيء وهو سيئ النية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_540> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_540_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_540_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_540_19750926_OpEnact_0dd268607e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_540_obligation_0_9ef30740> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 540" ;
    dzdoc:position 567 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_540_condition_0_521ab0ae> ;
    dzdoc:usesTerm dzterm:bailee,
        dzterm:loan_for_use .

<https://legal.dz/resource/order/1975-09-26/75-58#art_554> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_1> ;
    dzdoc:eId "art_554" ;
    dzdoc:fullText "يضمن المهندس المعماري و المقاول متضامنين ما يحدث خلال عشر سنوات من تهدم كلي أو جزئي فيما شيداه من مبان أو أقاماه من منشآت ثابتة أخرى ولو كان التهدم ناشئا عن عيب في الأرض ويشمل الضمان المنصوص عليه في الفقرة السابقة ما يوجد في المباني والمنشآت من عيوب يترتب عليها تهديد متانة البناء وسلامته. وتبدأ مدة السنوات (10) العشر من وقت تسلم العمل نهائيا. ولا تسري هذه المادة على ما قد يكون للمقاول من حق الرجوع على المقاولين الفرعيين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_554> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_554_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_554_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_554_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_554_19750926_OpEnact_a5fe58992d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_554_obligation_0_6f2da017> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "554" ;
    dzdoc:position 581 ;
    dzdoc:usesTerm dzterm:architect,
        dzterm:contractor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_558> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_2> ;
    dzdoc:eId "art_558" ;
    dzdoc:fullText "عندما يتم المقاول العمل ويضعه تحت تصرف رب العمل ، وجب على هذا الأخير أن يبادر إلى تسلمه في أقرب وقت ممكن بحسب ما هو جار في المعاملات ، فإذا امتنع دون سبب مشروع عن التسلم رغم دعوته إلى ذلك بإنذار رسمي اعتبر أن العمل قد سلم إليه، ويتحمل كل ما يترتب على ذلك من آثار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_558> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_558_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_558_19750926_OpEnact_f4f2da6c15> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_558_obligation_0_d02cf8b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "558" ;
    dzdoc:position 585 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_558_condition_0_1735d57e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_558_condition_1_6d10da52> ;
    dzdoc:usesTerm dzterm:contractor,
        dzterm:employer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_563> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_2> ;
    dzdoc:eId "art_563" ;
    dzdoc:fullText "يستحق المهندس المعماري أجرا مستقلا عن وضع التصميم وعمل المقايسة وآخر عن إدارة الأعمال . وتحدد الأجرة وفقا للعقد. غير أنه إذا لم يتم العمل بمقتضى التصميم الذي وضعه المهندس وجب تقدير الأجر بحسب الزمن الذي استغرقه وضع التصميم مع مراعاة طبيعة هذا العمل ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_563_right_0_23bad127> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_563> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_563_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_563_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_563_19750926_OpEnact_981299e8ef> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_563_obligation_0_a5dd5cfa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "563" ;
    dzdoc:position 590 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_563_condition_0_f2130bfc> ;
    dzdoc:usesTerm dzterm:architect .

<https://legal.dz/resource/order/1975-09-26/75-58#art_569> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_4> ;
    dzdoc:eId "art_569" ;
    dzdoc:fullText "ينقضي عقد المقاولة بموت المقاول إذا أخذت بعين الاعتبار مؤهلاته الشخصية وقت التعاقد وإن كان الأمر خلاف ذلك فإن العقد لا ينتهي تلقائيا ولا يجوز ل رب العمل فسخه في غير الحالات التي تطبق فيها المادة 552 الفقرة الثانية الا إذا لم تتوفر في ورثة المقاول الضمانات الكافية لحسن تنفيذ العمل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_569_permission_0_d9049a7a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_569> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_569_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_569_19750926_OpEnact_a46901d3a2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 569" ;
    dzdoc:position 596 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_552> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_552> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_569_condition_0_4778892a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_569_condition_1_bf61f236> ;
    dzdoc:usesTerm dzterm:contract,
        dzterm:contractor,
        dzterm:employer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_574> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_1> ;
    dzdoc:eId "art_574" ;
    dzdoc:fullText "لا بد من وكالة خاصة في كل عمل ليس من أعمال الادارة لا سيما في البيع والرهن والتبرع والصلح والاقرار والتحكيم وتوجيه اليمين والمرافعة أمام القضاء. الوكالة الخاصة في نوع معين من أنواع الأعمال القانونية تصح ولو لم يعين محل هذا العمل على وجه التخصيص، الا إذا كان العمل من التبرعات . الوكالة الخاصة لا تخول للوكيل الا القدرة على مباشرة الأمور المحددة فيها وما تقتضيه هذه الأمور من توابع ضرورية وفقا لطبيعة كل أمر وللعرف الجاري."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_574> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_574_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_574_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_574_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_574_19750926_OpEnact_d78335cb81> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_574_obligation_0_e8cae5b8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "574" ;
    dzdoc:position 611 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_574_condition_0_f712887e> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_591> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_3_subsec_1> ;
    dzdoc:eId "art_591" ;
    dzdoc:fullText "على المودع لديه أن يتسلم الوديعة . وليس له أن يستعملها دون أن يأذن له المودع في ذلك صراحة أو ضمنيا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_591> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_591_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_591_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_591_19750926_OpEnact_8a83b2226f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_591_obligation_0_134165b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 591" ;
    dzdoc:position 628 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_591_condition_0_8d1b95d7> ;
    dzdoc:usesTerm dzterm:bailee,
        dzterm:bailor,
        dzterm:deposit .

<https://legal.dz/resource/order/1975-09-26/75-58#art_596> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_3_subsec_2> ;
    dzdoc:eId "art_596" ;
    dzdoc:fullText "الأصل في الوديعة أن تكون بغير أجر فإذا اتفق على أجر وجب على المودع أن يؤديه وقت انتهاء الوديعة ما لم يوجد اتفاق يقضي بغير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_596> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_596_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_596_19750926_OpEnact_5ee091e05c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_596_obligation_0_598665dc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 596" ;
    dzdoc:position 633 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_596_condition_0_f70bb509> ;
    dzdoc:usesTerm dzterm:deposit .

<https://legal.dz/resource/order/1975-09-26/75-58#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_1> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "تسري القوانين المتعلقة ب الأهلية على جميع الأشخاص الذين تتوفر فيهم الشروط المنصوص عليها . وإذا صار شخص توفرت فيه الأهلية بحسب النص القديم ناقص الأهلية طبقا للنص الجديد ، فلا يؤثر ذلك على تصرفاته السابقة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_6_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_6_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_6_19750926_OpEnact_c2ef561061> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_6_obligation_0_9e5e3ba3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "6" ;
    dzdoc:position 5 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_6_condition_0_e3e4d608> ;
    dzdoc:usesTerm dzterm:capacity .

<https://legal.dz/resource/order/1975-09-26/75-58#art_614> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_10_sec_2> ;
    dzdoc:eId "art_614" ;
    dzdoc:fullText "يجوز أن يكون المرتب مقررا مدى حياة الملتزم له أو مدى حياة شخص آخر. ويعتبر المرتب مقررا مدى حياة الملتزم له إذا لم يوجد اتفاق يقضي بغير ذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_614_permission_0_437ff546> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_614> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_614_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_614_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_614_19750926_OpEnact_8c53173e98> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 614" ;
    dzdoc:position 651 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_614_condition_0_7d0a7a45> ;
    dzdoc:usesTerm dzterm:pension .

<https://legal.dz/resource/order/1975-09-26/75-58#art_618> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_10_sec_2> ;
    dzdoc:eId "art_618" ;
    dzdoc:fullText "إذا لم يقم المدين بتنفيذ التزامه كان للمستحق أن يطلب تنفيذ العقد . فإن كان العقد بعوض جاز له أيضا أن يطلب فسخه مع إصلاح الضرر إن كان له محل ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_618_right_0_fb68ac02>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_618_right_1_ff59609f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_618> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_618_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_618_19750926_OpEnact_406dbf4d71> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 618" ;
    dzdoc:position 655 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_618_condition_0_5be53c1a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_618_condition_1_77408ebb> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_623> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_10_sec_3_subsec_1> ;
    dzdoc:eId "art_623" ;
    dzdoc:fullText "لا يلتزم المؤمن في تعويض المؤمن له الا عن الضرر الناتج من وقوع الخطر المؤمن منه بشرط الا يجاوز ذلك قيمة التأمين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_623> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_623_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_623_19750926_OpEnact_db066dc039> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_623_obligation_0_37d5931b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "623" ;
    dzdoc:position 660 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_623_condition_0_606302af> ;
    dzdoc:usesTerm dzterm:insured,
        dzterm:insurer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_63> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_63" ;
    dzdoc:fullText "إذا عين أجل للقبول التزم الموجب بالبقاء على ايجابه إلى انقضاء هذا الأجل . وقد يستخلص الأجل من ظروف الحال، أو من طبيعة المعاملة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_63> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_63_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_63_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_63_19750926_OpEnact_4c44eba389> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_63_obligation_0_ea439d10> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 63" ;
    dzdoc:position 69 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_63_condition_0_12e77b24> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_650> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_الاول> ;
    dzdoc:eId "art_650" ;
    dzdoc:fullText "تجوز الكفالة في الدين المستقبل إذا حدد مقدما المبلغ المكفول ، كما تجوز الكفالة في الدين المشروط. غير أنه إذا كان الكفيل في الدين المستقبل لم يعين مدة الكفالة ، كان له أن يراجع فيها في أي وقت ما دام الدين المكفول لم ينشأ ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_650_right_0_e195fa46> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_650> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_650_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_650_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_650_19750926_OpEnact_af7b3dd360> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "650" ;
    dzdoc:position 687 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_650_condition_0_f1f1a915>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_650_condition_1_3a896677> ;
    dzdoc:usesTerm dzterm:كفالة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_657> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_657" ;
    dzdoc:fullText "لا تبرأ ذمة الكفيل بسبب تأخر الدائن في اتخاذ الاجراءات أو لمجرد أنه يتخذها. غير أن ذمة الكفيل تبرأ إذا لم يقم الدائن باتخاذ الاجراءات ضد المدين خلال ستة (6) أشهر من انذار الكفيل للدائن ما لم يقدم المدين للكفيل ضمانا كافيا ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_657_right_0_284ab2f0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_657> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_657_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_657_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_657_19750926_OpEnact_2a5c0c89e4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 657" ;
    dzdoc:position 694 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_657_condition_0_6ef9379f> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_665> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_665" ;
    dzdoc:fullText "لا يجوز للكفيل المتضامن مع المدين أن يطلب التجريد."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_665_permission_0_e64f2ee6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_665> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_665_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_665_19750926_OpEnact_d8bb17ee9a> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_665_prohibition_0_e64f2ee6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 665" ;
    dzdoc:position 702 ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_666> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_666" ;
    dzdoc:fullText "يجوز للكفيل المتضامن أن يتمسك بما يتمسك به الكفيل غير المتضامن من دفوع متعلقة بالدين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_666_permission_0_fad69c88> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_666_right_0_31fb1bae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_666> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_666_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_666_19750926_OpEnact_a30469cb4e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 666" ;
    dzdoc:position 703 ;
    dzdoc:usesTerm dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_675> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_675" ;
    dzdoc:fullText "مالك الشيء يملك كل ما يعد من عناصرها الجوهرية بحيث لا يمكن فصله عنه دون أن يفسد أو يتلف أو يتغير. وتشمل ملكية الأرض ما فوقها وما تحتها إلى الحد المفيد في التمتع بها علوا وعمقا. ويجوز بمقتضى القانون أو الاتفاق أن تكون ملكية سطح الأرض منفصلة عن ملكية ما فوقها أو ما تحتها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_675_permission_0_fdca753f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_675> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_675_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_675_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_675_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_675_19750926_OpEnact_866d0a3b4f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 675" ;
    dzdoc:position 712 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_690> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_690" ;
    dzdoc:fullText "يجب على المالك أن يراعي في استعمال حقه ما تقضي به التشريعات الجاري بها العمل والمتعلقة بالمصلحة العامة، أو المصلحة الخاصة . وعليه أيضا مراعاة الأحكام الآتية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_690> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_690_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_690_19750926_OpEnact_a41e9b73f7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_690_obligation_0_2229529b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_690_obligation_1_5859321d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "690" ;
    dzdoc:position 730 ;
    dzdoc:usesTerm dzterm:owner .

<https://legal.dz/resource/order/1975-09-26/75-58#art_698> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_698" ;
    dzdoc:fullText "إن القاعدة والكيفية التي يتم بهما ارتفاق حق المرور بسبب الحصر تحددان بـ تقادم خمسة عشرة (15) سنة فإذا اكتملت هذه المدة فلا يجوز لصاحب العقار المحصور تغيير قاعدة الارتفاق، ولا تحويلها أو نقلها من طرف صاحب العقار المرتفق به دون إذن من صاحب العقار المحصور."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_698_permission_0_b453dea6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_698> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_698_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_698_19750926_OpEnact_1346fda2d4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "698" ;
    dzdoc:position 738 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_698_condition_0_bae26756> ;
    dzdoc:usesTerm dzterm:easement .

<https://legal.dz/resource/order/1975-09-26/75-58#art_713> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:joint_owners ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_713" ;
    dzdoc:fullText "إذا ملك اثنان أو أكثر شيئا وكانت حصة كل منهم فيه غير مقررة فهم شركاء على الشيوع وتعتبر الحصص متساوية إذا لم يقم دليل على غير ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_713> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_713_defocc_366bbd6aaab1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_713_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_713_19750926_OpEnact_2c1696c0d2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 713" ;
    dzdoc:position 753 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_713_condition_0_3f0c673e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_713_condition_1_d65caec5> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_717> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_717" ;
    dzdoc:fullText "للشركاء الذين يملكون على الأقل ثلاثة أرباع (3/4) المال الشائع، يقرروا في سبيل تحسين الانتفاع بهذا المال من التغييرات الأساسية والتعديل في الغرض الذي أعد له ما يخرج عن حدود الادارة المعتادة على أن يعلنوا قراراتهم إلى باقي الشركاء ولمن خالف من هؤلاء حق الرجوع إلى المحكمة خلال شهرين من وقت الاعلان . وللمحكمة عند الرجوع إليها إذا وافقت على قرار تلك الأغلبية، أن تقرر مع هذا كل ما تراه مناسبا من التدابير ولها بوجه خاص أن تأمر باعطاء المخالف من الشركاء كفالة تضمن له الوفاء بما قد يستحق من التعويضات."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_717_right_0_b7d4c371> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_717> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_717_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_717_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_717_19750926_OpEnact_6af0639415> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_717_obligation_0_56a85e89> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 717" ;
    dzdoc:position 757 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_721> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_721" ;
    dzdoc:fullText "للشريك في المنقول الشائع أو في المجموع من المال المنقول، أو العقار أن يسترد قبل القسمة الحصة الشائعة التي باعها شريك غيره لأجنبي عن طريق التراضي ، وذلك خلال شهر من تاريخ علمه بالبيع أو من تاريخ إعلامه ، ويتم الاسترداد بواسطة تصريح يبلغ إلى كل من البائع والمشتري، ويحل المسترد محل المشتري في جميع حقوقه والتزاماته إذا هو عوضه عن كل ما انفقه. وإذا تعدد المستردون فلكل منهم أن يسترد بنسبة حصته."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_721_right_0_c9f9cb69> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_721> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_721_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_721_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_721_19750926_OpEnact_618c5de8f1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 721" ;
    dzdoc:position 761 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_721_condition_0_d269d7a9> ;
    dzdoc:usesTerm dzterm:immovable_property,
        dzterm:movable_property .

<https://legal.dz/resource/order/1975-09-26/75-58#art_729> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_729" ;
    dzdoc:fullText "لدائني كل شريك أن يعارضوا في أن تتم القسمة عينا أو أن يباع المال بالمزاد بغير تداخلهم . وتوجه المعارضة إلى كل الشركاء ويترتب عليها الزامهم أن يدخلوا من عارض من الدائنين في جميع الاجراءات ، وإلا كانت القسمة غير نافذة في حقهم ويجب على كل حال إدخال الدائنين المقيدة حقوقهم قبل رفع دعوى القسمة. أما إذا تمت القسمة فليس للدائنين الذين لم يتدخلوا فيها أن يطعنوا فيها الا في حالة الغش."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_729_right_0_2f78ff8d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_729> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_729_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_729_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_729_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_729_19750926_OpEnact_1bced3cd57> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_729_obligation_0_94feb2f6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 729" ;
    dzdoc:position 769 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_737> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_737" ;
    dzdoc:fullText "ليس للشركاء في مال شائع أن يطلبوا قسمته إذا تبين من الغرض الذي أعد له هذا المال، أنه يجب أن يبقى دائما على الشيوع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_737> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_737_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_737_19750926_OpEnact_a6ef8410e2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_737_obligation_0_801bc674> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "737" ;
    dzdoc:position 777 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_737_condition_0_976b3908> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_750_bis" ;
    dzdoc:fullText "يجب على المجموعات والمصالح والهيئات العمومية أن تدرج في ميزانيتها الاعتمادات الضرورية لدفع التكاليف الملزمة بدفعها بصفتها شريكة في الملكية أو شاغلة لها . 2 - حقوق وواجبات الشركاء في الملكية / أو الشاغلين لها"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_bis_19750926_OpEnact_ea123c94c1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_obligation_0_e52196f7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 750 مكرر" ;
    dzdoc:position 791 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_802> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_802" ;
    dzdoc:fullText "يجب رفع دعوى الشفعة على البائع والمشتري أمام المحكمة الواقع في دائرتها العقار في أجل ثلاثين (30) يوما من تاريخ الاعلان المنصوص عليه في المادة 801 والا سقط الحق ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_802> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_802_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_802_19750926_OpEnact_f0e7fc0ee7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_802_obligation_0_ef94451b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 802" ;
    dzdoc:position 853 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_801> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_801> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_809> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_809" ;
    dzdoc:fullText "يجوز لغير المميز أن يكسب الحيازة عن طريق من ينوب عنه نيابة قانونية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_809_permission_0_9d44202c> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_809_right_0_2ea0ec37> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_809> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_809_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_809_19750926_OpEnact_d0f55c1f3f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 809" ;
    dzdoc:position 860 ;
    dzdoc:usesTerm dzterm:possession .

<https://legal.dz/resource/order/1975-09-26/75-58#art_814> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_814" ;
    dzdoc:fullText "تنتقل الحيازة إلى الخلف العام بجميع صفاتها غير أنه إذا كان السلف سيئ النية وأثبت الخلف أنه كان في حيازته حسن النية جاز له أن يتمسك بحسن نيته ، و يجوز للخلف الخاص أن يضم إلى حيازته حيازة سلفه ليبلغ التقادم ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_814_right_0_f7cba52c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_814_right_1_03893119> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_814> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_814_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_814_19750926_OpEnact_56bfc6680f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 814" ;
    dzdoc:position 865 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_814_condition_0_2665f5a6> ;
    dzdoc:usesTerm dzterm:possession .

<https://legal.dz/resource/order/1975-09-26/75-58#art_816> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_816" ;
    dzdoc:fullText "لا تزول الحيازة إذا حال مانع وقتي دون مباشرة الحائز للسيطرة الفعلية على الحق . غير أن الحيازة تزول إذا استمر المانع سنة كاملة وكان ناشئا عن حيازة جديدة وقعت رغم إرادة الحائز أو دون علمه وتحسب السنة من الوقت الذي بدأت فيه الحيازة الجديدة إذا بدأت علنا أو من يوم علم الحائز الأول بها إذا بدأت خفية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_816> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_816_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_816_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_816_19750926_OpEnact_463536c0af> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 816" ;
    dzdoc:position 867 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_816_condition_0_0bb4da4d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_816_condition_1_99ed9048> ;
    dzdoc:usesTerm dzterm:possession .

<https://legal.dz/resource/order/1975-09-26/75-58#art_824> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:good_faith ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_824" ;
    dzdoc:fullText "يفرض حسن النية لمن يحوز حقا وهو يجهل انه يتعدى على حق الغير الا إذا كان هذا الجهل ناشئا عن خطأ جسيم . وإذا كان الحائز شخصا معنويا فالعبرة بنية من يمثله. ويفترض حسن النية دائما حتى يقوم الدليل على العكس."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_824> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_824_defocc_13256e8fa823> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_824_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_824_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_824_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_824_19750926_OpEnact_e55b0f5c61> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "824" ;
    dzdoc:position 875 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_824_condition_0_1b5e6a5d> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_834> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_834" ;
    dzdoc:fullText "ينقطع التقادم المكسب إذا تخلى الحائز عن حيازته أو فقدها ولو بفعل الغير . غیر أن التقادم لا ينقطع بفقد الحيازة إذا استردها الحائز خلال سنة أو رفع دعوى باستردادها في هذا الميعاد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_834> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_834_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_834_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_834_19750926_OpEnact_f2f349edec> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 834" ;
    dzdoc:position 885 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_834_condition_0_d7f73fdf>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_834_condition_1_838b8d77> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_851> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_1> ;
    dzdoc:eId "art_851" ;
    dzdoc:fullText "إذا كان المال المقرر عليه حق الانتفاع منقولا وجب جرده ولزم المنتفع تقديم كفالة به فإن لم يقدمها بيع المال ووظف ثمنه في شراء سندات عامة يستولي المنتفع على أرباحها، وللمنتفع الذي قدم الكفالة أن يستعمل الأشياء القابلة للاستهلاك بشرط أن يرد بدلها عند انتهاء حقه في الانتفاع ، وله نتاج المواشي بعد أن يعرض منها ما هلك من الأصل بسبب حادث مفاجئ أو قوة قاهرة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_851> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_851_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_851_19750926_OpEnact_6ecfe90468> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_851_obligation_0_a9f64a9f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 851" ;
    dzdoc:position 902 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_851_condition_0_747f67e5>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_851_condition_1_462f0a2f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_851_condition_2_7e481177> ;
    dzdoc:usesTerm dzterm:usufruct .

<https://legal.dz/resource/order/1975-09-26/75-58#art_890> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_1> ;
    dzdoc:eId "art_890" ;
    dzdoc:fullText "يبقى نافذا الرهن الصادر من جميع الملاكين لعقار شائع، أيا كانت النتيجة التي تترتب على قسمة العقار فيما بعد أو على بيعه لعدم إمكان قسمته. وإذا رهن أحد الشركاء حصته الشائعة في العقار أو جزءا مفرزا من هذا العقار، ثم وقع في نصيبه عند القسمة أعيان غير التي رهنها انتقل الرهن بمرتبته إلى الأعيان المخصصة له بقدر يعادل قيمة العقار الذي كان مرهونا في الأصل، ويبين هذا القدر بأمر على عريضة. ويقوم الدائن المرتهن بإجراء قيد جديد يبين فيه القدر الذي انتقل إليه الرهن خلال تسعين يوما من الوقت الذي يخطره فيه أي ذي شأن بتسجيل القسمة ولا يضر انتقال الرهن على هذا الوجه برهن صدر من جميع الشركاء ولا بامتياز المتقاسمين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_890> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_890_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_890_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_890_19750926_OpEnact_1240303241> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_890_obligation_0_519a9495> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 890" ;
    dzdoc:position 941 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_890_condition_0_0dfb388c> ;
    dzdoc:usesTerm dzterm:mortgage,
        dzterm:mortgagee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_900> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_900" ;
    dzdoc:fullText "إذا هلك العقار المرهون أو تلف لأي سبب كان ، انتقل الرهن بمرتبه إلى الحق الذي يترتب على ذلك من مبلغ التعويض عن الضرر أو مبلغ التأمين أو الثمن المقرر مقابل نزع ملكيته للمنفعة العامة. 2 - بالنسبة إلى الدائن المرتهن"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_900> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_900_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_900_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_900_19750926_OpEnact_c9b58179ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 900" ;
    dzdoc:position 951 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_900_condition_0_34bd8772> ;
    dzdoc:usesTerm dzterm:mortgage .

<https://legal.dz/resource/order/1975-09-26/75-58#art_930> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_930" ;
    dzdoc:fullText "ينبغي على الحائز أن يرد ثمار العقار من وقت انذاره بالدفع أو التخلية . فإذا تركت الاجراءات مدة ثلاث (3) سنوات ، فلا يرد الثمار إلا من وقت أن يوجه إليه انذار جديد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_930> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_930_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_930_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_930_19750926_OpEnact_79f31ab6ab> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_930_obligation_0_cfc5f46c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "930" ;
    dzdoc:position 981 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_930_condition_0_5b142c82> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_949> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_1> ;
    dzdoc:eId "art_949" ;
    dzdoc:fullText "لا يكون محلا للرهن الحيازي إلا ما يمكن بيعه استقلالا بالمزاد العلني من منقول وعقار."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_949_permission_0_04b6f860> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_949> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_949_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_949_19750926_OpEnact_8a5eaea452> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 949" ;
    dzdoc:position 1000 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_949_condition_0_04b6f860> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_953> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_953" ;
    dzdoc:fullText "يضمن الراهن سلامة الرهن ونفاذه ، وليس له أن يأتي عملا ينقص من قيمة الشيء المرهون أو يحول دون استعمال الدائن لحقوقه المستمدة من العقد. و للدائن المرتهن في حالة الاستعجال أن يتخذ على نفقة الراهن كل الوسائل التي تلزم للمحافظة على الشيء المرهون ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_953_right_0_5bf906b0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_953> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_953_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_953_19750926_OpEnact_2e79f15bbe> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_953_obligation_0_ac52fc0d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "953" ;
    dzdoc:position 1004 ;
    dzdoc:usesTerm dzterm:دائن,
        dzterm:راهن .

<https://legal.dz/resource/order/1975-09-26/75-58#art_956> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_956" ;
    dzdoc:fullText "ليس للدائن أن ينتفع بالشيء المرهون دون مقابل. وعليه أن يستثمره استثمارا كاملا ما لم يتفق على غير ذلك . وما حصل عليه الدائن من صافي الريع وما استفاده من استعمال الشيء يخصم من المبلغ المضمون بالرهن ولو لم يكن قد حل أجله، على أن يكون الخصم أولا من قيمة ما انفقه في المحافظة والاصلاحات على الشيء ثم من المصاريف ثم من أجل الدين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_956> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_956_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_956_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_956_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_956_19750926_OpEnact_640d4438bb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_956_obligation_0_c4213874> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "956" ;
    dzdoc:position 1007 ;
    dzdoc:usesTerm dzterm:دائن .

<https://legal.dz/resource/order/1975-09-26/75-58#art_957> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_957" ;
    dzdoc:fullText "إذا لم يعين الطرفان أجلا لحلول الدين المضمون فلا يجوز للدائن أن يطالب باستيفاء حقه إلا عن طريق استنزاله من قيمة الثمار، دون إخلال بحق المدين في الوفاء بالدين في أي وقت أراد."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_957_permission_0_43598208> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_957> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_957_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_957_19750926_OpEnact_1b445f75f5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "957" ;
    dzdoc:position 1008 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_957_condition_0_d3ab250e> ;
    dzdoc:usesTerm dzterm:دائن,
        dzterm:مدين .

<https://legal.dz/resource/order/1975-09-26/75-58#art_972> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_5> ;
    dzdoc:eId "art_972" ;
    dzdoc:fullText "يجوز للراهن إذا عرضت فرصة لبيع الشيء المرهون وكان البيع صفقة رابحة، أن يطلب من القاضي الترخيص في بيع هذا الشيء، ولو كان ذلك قبل حلول أجل الدين ، ويحدد القاضي عند الترخيص شروط البيع ويفصل في أمر إيداع الثمن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_972_permission_0_71a0f8af> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_972_right_0_e809562f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_972> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_972_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_972_19750926_OpEnact_5d7b02a83f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 972" ;
    dzdoc:position 1023 ;
    dzdoc:usesTerm dzterm:pledgor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_977> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_5> ;
    dzdoc:eId "art_977" ;
    dzdoc:fullText "إذا كان الدين غير قابل للحوالة أو للحجز فلا يجوز رهنه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_977_permission_0_4462b9ce> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_977> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_977_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_977_19750926_OpEnact_327b68c8bd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 977" ;
    dzdoc:position 1028 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_977_condition_0_95e85aee> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_997> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_997" ;
    dzdoc:fullText "ما يستحق لبائع المنقول من الثمن وملحقاته، يكون له امتياز على الشيء المبيع، ويبقى الامتياز قائما ما دام المبيع محتفظا بذاتيته وهذا دون إخلال بالحقوق التي كسبها الغير بحسن النية، مع مراعاة الأحكام الخاصة بالمسائل التجارية. ويكون هذا الامتياز تاليا في المرتبة لما تقدم ذكره من حقوق الامتياز الواقعة على منقول، إلا أنه يسري في حق المؤجر وصاحب الفندق إذا ثبت أنهما كانا يعلمان به وقت وضع المبيع في العين المؤجرة أو الفندق ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_997> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_997_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_997_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_997_19750926_OpEnact_33497bf880> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "997" ;
    dzdoc:position 1048 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_997_condition_0_7ca0ba03> ;
    dzdoc:usesTerm dzterm:privilege .

<https://legal.dz/resource/order/1975-09-26/75-58#art_998> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_998" ;
    dzdoc:fullText "للشركاء الذين اقتسموا منقولا، حق امتياز عليه تأمينا لحق كل منهم في الرجوع على الآخرين بسبب القسمة، وفي استيفاء ما تقرر لهم فيها من معدل . وتكون لامتياز المتقاسم نفس المرتبة التي تكون لامتياز البائع ، فإذا تزاحم الحقان قدم من سبق في التاريخ ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_998_right_0_cedfb041> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_998> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_998_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_998_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_998_19750926_OpEnact_75acededee> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "998" ;
    dzdoc:position 1049 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_998_condition_0_9740042d> ;
    dzdoc:usesTerm dzterm:privilege_of_partitioner,
        dzterm:privilege_of_seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_الاولى> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:عقد_التسيير ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_bis_subsec_1> ;
    dzdoc:eId "art_الاولى" ;
    dzdoc:fullText "عقد التسيير هو العقد الذي يلتزم بموجبه متعامل يتمتع بشهرة معترف بها، يسمى مسيرا ، إزاء مؤسسة عمومية اقتصادية أو شركة مختلطة الاقتصاد ، بتسيير كل أملاكها أو بعضها باسمها ولحسابها مقابل أجر فيضفي عليها علامته حسب مقایسه ومعاييره، ويجعلها تستفيد من شبكاته الخاصة بالترويج والبيع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_الاولى> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_الاولى_defocc_f826c6f7ea1a> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_الاولى_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_19750926_OpEnact_7ea5fc81df> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_الاولى_obligation_0_ff3eea98> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة الاولى" ;
    dzdoc:position 598 ;
    dzdoc:usesTerm dzterm:شركة_مختلطة_الاقتصاد,
        dzterm:مؤسسة_عمومية_اقتصادية,
        dzterm:مسير .

<https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_bis_subsec_3> ;
    dzdoc:eId "book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_6" ;
    dzdoc:fullText "تسري القوانين المتعلقة ب الأهلية على جميع الأشخاص الذين تتوفر فيهم الشروط المنصوص عليها . وإذا صار شخص توفرت فيه الأهلية بحسب النص القديم ناقص الأهلية طبقا للنص الجديد ، فلا يؤثر ذلك على تصرفاته السابقة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_6> ;
