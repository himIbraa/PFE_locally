<https://legal.dz/resource/order/1975-09-26/75-58#version_art_806> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تكون حجة على الشفيع، الرهون والاختصاصات المأخوذة ضد المشتري وكذلك كل بيع صدر منه وكل حق عيني رتبه المشتري أو ترتب عليه إذا كان ذلك قد تم بعد تاريخ شهر الاعلان بالرغبة في الشفعة على أنه يبقى للدائنين المسجلة ديونهم مالهم من حقوق الأفضلية فيما آل للمشتري من ثمن العقار."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_806_19750926_OpEnact_817f58bfc8> ;
