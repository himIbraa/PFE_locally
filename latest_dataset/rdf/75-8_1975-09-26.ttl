    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 449" ;
    dzdoc:position 473 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_454> a dzdoc:Article ;
