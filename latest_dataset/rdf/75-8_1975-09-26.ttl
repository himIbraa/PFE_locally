<https://legal.dz/resource/order/1975-09-26/75-58#version_art_816> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تزول الحيازة إذا حال مانع وقتي دون مباشرة الحائز للسيطرة الفعلية على الحق . غير أن الحيازة تزول إذا استمر المانع سنة كاملة وكان ناشئا عن حيازة جديدة وقعت رغم إرادة الحائز أو دون علمه وتحسب السنة من الوقت الذي بدأت فيه الحيازة الجديدة إذا بدأت علنا أو من يوم علم الحائز الأول بها إذا بدأت خفية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_816_19750926_OpEnact_463536c0af> ;
    dzdoc:replacementText "لا تزول الحيازة إذا حال مانع وقتي دون مباشرة الحائز للسيطرة الفعلية على الحق . غير أن الحيازة تزول إذا استمر المانع سنة كاملة وكان ناشئا عن حيازة جديدة وقعت رغم إرادة الحائز أو دون علمه وتحسب السنة من الوقت الذي بدأت فيه الحيازة الجديدة إذا بدأت علنا أو من يوم علم الحائز الأول بها إذا بدأت خفية."@ar ;
