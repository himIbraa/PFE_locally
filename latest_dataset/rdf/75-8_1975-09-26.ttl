<https://legal.dz/resource/order/1975-09-26/75-58#version_art_808> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تقوم الحيازة على عمل يأتيه الغير على أنه مجرد رخصة أو على عمل يتحمله على سبيل التسامح. إذا اقترنت الحيازة بإكراه أو حصلت خفية أو كان فيها التباس فلا يكون لها أثر تجاه من وقع عليه الاكراه أو أخفيت عنه الحيازة أو إلتبس عليه أمرها الا من الوقت الذي تزول فيه هذه العيوب."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_808_19750926_OpEnact_6f77e74285> ;
    dzdoc:replacementText "لا تقوم الحيازة على عمل يأتيه الغير على أنه مجرد رخصة أو على عمل يتحمله على سبيل التسامح. إذا اقترنت الحيازة بإكراه أو حصلت خفية أو كان فيها التباس فلا يكون لها أثر تجاه من وقع عليه الاكراه أو أخفيت عنه الحيازة أو إلتبس عليه أمرها الا من الوقت الذي تزول فيه هذه العيوب."@ar ;
