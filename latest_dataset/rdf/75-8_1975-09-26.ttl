<https://legal.dz/resource/order/1975-09-26/75-58#version_art_813> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسليم السندات المعطاة عن البضائع المعهود بها إلى أمين النقل أو المودعة في المخازن يقوم مقام تسليم البضائع ذاتها. غير أنه إذا تسلم شخص السندات وتسلم آخر البضائع ذاتها وكان كلاهما حسن النية فإن الأفضلية تكون لمن تسلم البضائع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_813_19750926_OpEnact_12216fa933> ;
