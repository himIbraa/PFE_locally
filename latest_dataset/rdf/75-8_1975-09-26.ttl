    dznorm:provisionText "وجب اتباع الاجراءات المقررة في البيوع الجبرية"@ar ;
    dznorm:sourceArticle "art_920" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_920_obligation_1_56e84d74> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-58#art_920_obligation_1_56e84d74_action_96d2219594> ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-58#art_920_obligation_1_56e84d74_role_f8305cf998> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_920> ;
    dznorm:position 1 ;
    dznorm:provisionText "ويلتزم الراسي عليه المزاد أن يرد إلى الحائز الذي نزعت ملكيته المصاريف التي انفقها في سند ملكيته، وفي تسجيل هذا السند وفيما قام به من الاعلانات"@ar ;
    dznorm:sourceArticle "art_920" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_920_obligation_1_56e84d74_action_96d2219594> a dznorm:Action ;
