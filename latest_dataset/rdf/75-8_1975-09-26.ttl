<https://legal.dz/resource/order/1975-09-26/75-58#version_art_434> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا استغرقت الديون أموال الشركة ، كان الشركاء مسؤولين عن هذه الديون في أموالهم الخاصة، كل منهم بنسبة نصيبه في خسائر الشركة ، ما لم يوجد اتفاق يقضي بنسبة أخرى ويقع باطلا كل اتفاق يعفي الشريك من المسؤولية عن ديون الشركة . وعلى كل حال يكون لدائني الشركة الحق في مطالبة الشركاء كل بقدر الحصة التي تخصصت له في أرباح الشركة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_434_19750926_OpEnact_0899fa3bdf> ;
    dzdoc:replacementText "إذا استغرقت الديون أموال الشركة ، كان الشركاء مسؤولين عن هذه الديون في أموالهم الخاصة، كل منهم بنسبة نصيبه في خسائر الشركة ، ما لم يوجد اتفاق يقضي بنسبة أخرى ويقع باطلا كل اتفاق يعفي الشريك من المسؤولية عن ديون الشركة . وعلى كل حال يكون لدائني الشركة الحق في مطالبة الشركاء كل بقدر الحصة التي تخصصت له في أرباح الشركة ."@ar ;
