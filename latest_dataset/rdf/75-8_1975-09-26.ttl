<https://legal.dz/resource/order/1975-09-26/75-58#version_art_887> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يشمل الرهن ملحقات العقار المرهون التي تعتبر عقارا، ويشمل بوجه خاص حقوق الارتفاق والعقارات بالتخصيص وكافة التحسينات والانشاءات التي تعود بالمنفعة على المالك، ما لم يتفق على غير ذلك، مع عدم الاخلال بامتياز المبالغ المستحقة للمقاولين والمهندسين المعماريين المنصوص عليه في المادة 997 ."@ar ;
    dzdoc:isAuthoritative true ;
