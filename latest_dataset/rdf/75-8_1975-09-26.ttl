<https://legal.dz/resource/order/1975-09-26/75-58#version_art_999> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ما يستحق لبائع العقار من الثمن وملحقاته ، يكون له امتياز على العقار المبيع. ويجب أن يقيد الامتياز ولو كان البيع مسجلا ، وتكون مرتبته من تاريخ البيع إذا وقع التقييد في ظرف شهرين من تاريخ البيع . فإذا انقضى هذا الأجل أصبح الامتياز رهنا رسميا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_999_19750926_OpEnact_266cb2c73d> ;
    dzdoc:replacementText "ما يستحق لبائع العقار من الثمن وملحقاته ، يكون له امتياز على العقار المبيع. ويجب أن يقيد الامتياز ولو كان البيع مسجلا ، وتكون مرتبته من تاريخ البيع إذا وقع التقييد في ظرف شهرين من تاريخ البيع . فإذا انقضى هذا الأجل أصبح الامتياز رهنا رسميا ."@ar ;
