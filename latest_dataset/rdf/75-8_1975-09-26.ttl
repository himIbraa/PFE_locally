<https://legal.dz/resource/order/1975-09-26/75-58#version_art_868> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينشأ حق الارتفاق عن الموقع الطبيعي للأمكنة، أو يكسب بعقد شرعي أو بالميراث الا أنه لا تكسب بالتقادم الا الارتفاقات الظاهرة بما فيها حق المرور ."@ar ;
