    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_777> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_777_condition_1_3cfbbe8a> a dznorm:Condition ;
    dznorm:conditionText "ما لم يكن هناك دليل يخالف ذلك"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_777> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_777_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_777> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر التصرف وصية وتجري عليه أحكامها إذا تصرف شخص لأحد ورثته واستثنى لنفسه بطريقة ما حيازة الشيء المتصرف فيه والانتفاع به مدة حياته ما لم يكن هناك دليل يخالف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_778_para_0> a dzdoc:Paragraph ;
