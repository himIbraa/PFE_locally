    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_153" ;
    dzdoc:fullText "يجب على الفضولي أن يمضي في العمل الذي بدأه إلى أن يتمكن رب العمل من مباشرته بنفسه كما يجب عليه أن يخطر بتدخله رب العمل متى استطاع ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_153> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_153_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_153_19750926_OpEnact_222cd12b2b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_153_obligation_0_9e05517f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_153_obligation_1_a80eb1f2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 153" ;
    dzdoc:position 165 ;
    dzdoc:usesTerm dzterm:فضولي .

<https://legal.dz/resource/order/1975-09-26/75-58#art_173> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_173" ;
    dzdoc:fullText "إذا التزم المدين بالامتناع عن عمل وأخل بهذا الالتزام جاز للدائن أن يطالب إزالة ما وقع مخالفا للالتزام و يمكنه أن يحصل من القضاء على ترخيص للقيام بهذه الازالة على نفقة المدين ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_173_right_0_85b82b26>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_173_right_1_eda63b11> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_173> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_173_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_173_19750926_OpEnact_42e3d5099e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 173" ;
    dzdoc:position 185 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_173_condition_0_19386d38> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_196> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_196" ;
    dzdoc:fullText "إذا لم يقصد بالغش إلا تفضيل دائن على آخر دون حق فلا يترتب عليه إلا حرمان الدائن من هذه الميزة. وإذا وفي المدين المعسر أحد دائنيه قبل حلول الأجل المضروب أصلا للوفاء ، فلا يسري هذا الوفاء في حق باقي الدائنين وكذلك لا يسري في حقهم الوفاء ولو حصل بعد حلول هذا الأجل، إذا كان قد تم نتيجة تواطؤ بين المدين والدائن الذي استوفي حقه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_196> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_196_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_196_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_196_19750926_OpEnact_c5881548f3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 196" ;
    dzdoc:position 209 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_196_condition_0_f3e1d61c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_196_condition_1_a11ac51f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_196_condition_2_4b20697c> ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_20" ;
    dzdoc:fullText "يسري على الالتزامات غير التعاقدية، قانون البلد الذي وقع فيه الفعل المنشئ للالتزام . غير أنه فيما يتعلق بالالتزامات الناشئة عن الفعل الضار ، لا تسري أحكام الفقرة السابقة على الوقائع التي تحدث في الخارج وتكون مشروعة في الجزائر وإن كانت تعد غير مشروعة في البلد الذي وقعت فيه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_20> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_20_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_20_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_20_19750926_OpEnact_01e885fb7f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_20_obligation_0_0d719b92>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_20_obligation_1_22994afd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "20" ;
    dzdoc:position 22 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_204> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_204" ;
    dzdoc:fullText "لا يكون الالتزام قائما إذا علق على شرط غير ممكن، أو على شرط مخالف للآداب أو النظام العام ، هذا إذا كان الشرط واقفا اما إذا كان الشرط فاسخا فهو نفسه الذي يعتبر غير قائم. غير أنه لا يقوم الالتزام الذي علق على شرط فاسخ مخالف للآداب أو النظام العام، إذا كان هذا الشرط هو السبب الموجب للالتزام ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_204> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_204_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_204_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_204_19750926_OpEnact_c23729b8fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "204" ;
    dzdoc:position 217 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_204_condition_0_aff71148>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_204_condition_1_4e9ee282> ;
    dzdoc:usesTerm dzterm:obligation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_211> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_211" ;
    dzdoc:fullText "يسقط حق المدين في الأجل : إذا شهر افلاسه وفقا لنصوص القانون ، إذا انقص بفعله إلى حد كبير ما أعطى الدائن من تأمين خاص ، ولو كان هذا التأمين قد أعطي بعقد لاحق أو بمقتضى القانون، هذا ما لم يفضل الدائن أن يطالب بتكملة التأمين، اما إذا كان انقاص التأمين يرجع إلى سبب لا دخل للمدين فيه فإن الأجل يسقط ما لم يقدم المدين للدائن ضمانا كافيا ، إذا لم يقدم للدائن ما وعد في العقد بتقديمه من تأمينات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_211> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_211_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_211_19750926_OpEnact_d9d9cb9358> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "211" ;
    dzdoc:position 224 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_211_condition_0_c05fb01b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_211_condition_1_197d0852>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_211_condition_2_fa129687>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_211_condition_3_2f0d2bb1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_211_condition_4_c3c97344> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_230> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_230" ;
    dzdoc:fullText "إذا انقضى الدين بالتقادم بالنسبة إلى أحد المدينين المتضامنين فلا يستفيد من ذلك باقي المدينين الا بقدر حصة هذا المدين. إذا انقطعت مدة التقادم أو وقف سريانه بالنسبة لأحد المدينين المتضامنين ، فلا يجوز للدائن أن يتمسك بذلك قبل باقي المدينين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_230_permission_0_f27f1d8f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_230> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_230_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_230_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_230_19750926_OpEnact_b7e8db8235> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 230" ;
    dzdoc:position 243 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_230_condition_0_6959a5a1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_230_condition_1_eedb1b6c> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_232> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_232" ;
    dzdoc:fullText "لا يسري اقرار أحد المدينين المتضامنين بالدين في حق الباقين. وإذا نكل أحد المدينين المتضامنين عن اليمين الموجهة إليه، أو إذا وجه هذه اليمين إلى الدائن وأداها هذا الأخير فلا يضار بذلك باقي المدينين. وإذا اقتصر الدائن على توجيه اليمين إلى أحد المدينين المتضامنين وحلفها المدين فيستفيد منها الباقون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_232> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_232_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_232_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_232_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_232_19750926_OpEnact_fdbbf8a1e0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 232" ;
    dzdoc:position 245 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_232_condition_0_525e0a3b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_232_condition_1_895cfe2b> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_239> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_239" ;
    dzdoc:fullText "يجوز للدائن أن يحول حقه إلى شخص آخر الا إذا منع ذلك نص القانون، أو اتفاق المتعاقدين، أو طبيعة الالتزام وتتم الحوالة دون حاجة إلى رضا المدين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_239_permission_0_27701d8f> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_239_right_0_00a4a6c7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_239> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_239_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_239_19750926_OpEnact_ea56f0c701> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 239" ;
    dzdoc:position 252 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_239_condition_0_9515598c> ;
    dzdoc:usesTerm dzterm:assignment,
        dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_248> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_248" ;
    dzdoc:fullText "يتمسك المدين قبل المحال له بالدفوع التي يعترض بها قبل المحيل وقت نفاذ الحوالة في حقه كما يجوز له أن يتمسك بالدفوع المستمدة من عقد الحوالة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_248_permission_0_9b9c45b5> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_248_right_0_c3bca9fc>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_248_right_1_cf3ba247> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_248> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_248_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_248_19750926_OpEnact_a8e52ee238> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 248" ;
    dzdoc:position 261 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_271> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_271" ;
    dzdoc:fullText "إذا كان محل الوفاء شيئا معينا بالذات جاز للمدين أن يحصل على ترخيص من القضاء في ايداعه ، فإذا كان هذا الشيء عقارا أو ما هو معد للبقاء حيث وجد جاز للمدين أن يطلب وضعه تحت الحراسة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_271_right_0_5262aef0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_271_right_1_1835b101> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_271> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_271_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_271_19750926_OpEnact_9242e3470d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "271" ;
    dzdoc:position 284 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_271_condition_0_76520591>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_271_condition_1_9770f2db> ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_275> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_275" ;
    dzdoc:fullText "إذا عرض المدين على الدائن وأتبع هذا العرض بايداع أو باجراء مماثل جاز له الرجوع في عرضه ما دام الدائن لم يقبله أو لم يصدر حكم نهائي بصحته ، وفي هذه الحالة لا تبرأ ذمة الشركاء في الدين ولا ذمة الضامنين. ولكن إذا رجع المدين في عرضه بعد قبوله من الدائن أو بعد صحته بعد الحكم، وقبل الدائن منه هذا الرجوع ، لم يكن لهذا الدائن أن يتمسك بما يكفل حظه من تأمينات وتبرأ ذمة الشركاء في الدين، وذمة الضامنين."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_275_right_0_a08680c0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_275> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_275_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_275_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_275_19750926_OpEnact_21dd65bc92> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "275" ;
    dzdoc:position 288 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_275_condition_0_60ba1a59>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_275_condition_1_e1efefa0> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "يجب أن يكون لكل شخص لقب واسم فأكثر ولقب الشخص يلحق أولاده. يجب أن تكون الأسماء جزائرية وقد يكون خلاف ذلك بالنسبة للاطفال المولودين من أبوين غير مسلمين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_28_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_28_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_28_19750926_OpEnact_ab1c324a09> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_28_obligation_0_ae0f6f3e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_28_obligation_1_f68434f8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "28" ;
    dzdoc:position 34 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_284> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_2> ;
    dzdoc:eId "art_284" ;
    dzdoc:fullText "يكون لمن قام بالوفاء بجزء من الدين الحق في مطالبة مخالصة بما وفاه مع التأشير على سند الدين بحصول هذا الوفاء وله أيضا الحق في مطالبة رد السند أو إلغائه إذا وفي بكل الدين وإذا ضاع السند كان له أن يطلب من الدائن اشهادا على ضياع هذا السند فإذا رفض الدائن القيام بما فرضته عليه الفقرة السابقة جاز للمدين إيداع الشيء المستحق ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_284_right_0_9d45c8c7>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_284_right_1_4dca057f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_284_right_2_f24a4e6f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_284> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_284_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_284_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_284_19750926_OpEnact_360885dec3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 284" ;
    dzdoc:position 297 ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_297> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_3> ;
    dzdoc:eId "art_297" ;
    dzdoc:fullText "للمدين حق المقاصة بين ما هو مستحق عليه لدائنه وما هو مستحق له تجاهه ولو اختلف سبب الدينين إذا كان موضوع كل منهما نقودا أو مثليات متحدة النوع والجودة وكان كل منها ثابتا وخاليا من النزاع ومستحق الاداء صالحا للمطالبة به قضاء . ولا يمنع المقاصة تأخر ميعاد الوفاء لمهلة منحها القاضي أو تبرع بها الدائن."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_297_right_0_ba4ec83a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_297> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_297_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_297_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_297_19750926_OpEnact_5dd808c8b8> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_297_prohibition_0_0484d3d3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "297" ;
    dzdoc:position 310 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_297_condition_0_5beec47e> ;
    dzdoc:usesTerm dzterm:مقاصة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_312> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_3> ;
    dzdoc:eId "art_312" ;
    dzdoc:fullText "تتقادم بسنة (1) واحدة الحقوق الآتية : حقوق التجار، والصناع عن أشياء وردوها لاشخاص لا يتجرون فيها، وحقوق أصحاب الفنادق والمطاعم عن أجر الاقامة، وثمن الطعام وكل ما صرفوه لحساب عملائهم، المبالغ المستحقة للعمال والاجراء الآخرون مقابل عملهم. يجب على من يتمسك بالتقادم السنة، أن يحلف اليمين على انه أدى الدين فعلا وهذه اليمين توجه تلقائيا من القاضي إلى ورثة المدين أو إلى أوصيائهم أن كان الورثة قاصرين على انهم لا يعلمون بوجود الدين أو يعلمون بحصول الوفاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_312> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_312_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_312_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_312_19750926_OpEnact_4454c48b24> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_312_obligation_0_3ef91985> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "312" ;
    dzdoc:position 325 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_324_bis_1" ;
    dzdoc:fullText "زيادة عن العقود التي يأمر القانون باخضاعها إلى شكل رسمي يجب، تحت طائلة البطلان، تحرير العقود التي تتضمن نقل ملكية عقار أو حقوق عقارية أو محلات تجارية أو صناعية أو كل عنصر من عناصرها، أو التنازل عن أسهم من شركة أو حصص فيها، أو عقود إيجار زراعية أو تجارية أو عقود تسيير محلات تجارية أو مؤسسات صناعية في شكل رسمي ، و يجب دفع الثمن لدى الضابط العمومي الذي حرر العقد . كما يجب، تحت طائلة البطلان، اثبات العقود المؤسسة أو المعدلة للشركة بعقد رسمي . وتودع الأموال الناتجة عن هذه العمليات لدى الضابط العمومي المحرر للعقد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_1_19750926_OpEnact_d4f25447e8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1_obligation_0_9b3be95b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1_obligation_1_c7531d51>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1_obligation_2_c4460b12> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 324 مكرر 1" ;
    dzdoc:position 340 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_324_bis_6" ;
    dzdoc:fullText "يعتبر العقد الرسمي حجة لمحتوى الاتفاق المبرم بين الاطراف المتعاقدة وورثتهم وذوي الشأن. غير أنه في حالة شكوى بسبب تزوير في الأصل ، يوقف تنفيذ العقد محل الاحتجاج بتوجيه الاتهام، و عند رفع دعوى فرعية بالتزوير ، يمكن للمحاكم، حسب الظروف، ايقاف تنفيذ العقد مؤقتا."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_6_permission_0_d034fccc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_6_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_6_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_6_19750926_OpEnact_19a7021693> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 324 مكرر 6" ;
    dzdoc:position 345 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_6_condition_0_2bc8d767>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_6_condition_1_cf7c05e7> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_335> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:proof_by_writing ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_2> ;
    dzdoc:eId "art_335" ;
    dzdoc:fullText "يجوز الإثبات بالشهود فيما كان يجب إثباته بالكتابة إذا وجد مبدأ ثبوت بالكتابة . وكل كتابة تصدر من الخصم ويكون من شأنها أن تجعل وجود التصرف المدعى به قريب الاحتمال، تعتبر مبدأ ثبوت بالكتابة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_335_permission_0_81fb1169> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_335> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_335_defocc_4a60840a3dc7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_335_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_335_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_335_19750926_OpEnact_eb6bd6aa46> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 335" ;
    dzdoc:position 359 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_335_condition_0_2a8c1070> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_337> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_3> ;
    dzdoc:eId "art_337" ;
    dzdoc:fullText "القرينة القانونية تغني من تقررت لمصلحته عن أية طريقة أخرى من طرف الاثبات، على انه يجوز نقض هذه القرينة بالدليل العكسي ما لم يوجد نص يقضي بغير ذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_337_permission_0_f15b5773> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_337> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_337_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_337_19750926_OpEnact_902bb46c8c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "337" ;
    dzdoc:position 361 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_337_condition_0_7a083ba4> ;
    dzdoc:usesTerm dzterm:legal_presumption .

<https://legal.dz/resource/order/1975-09-26/75-58#art_358> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_358" ;
    dzdoc:fullText "إذا بيع عقار بغبن يزيد عن (1/5) الخمس فللبائع الحق في طلب تكملة الثمن إلى أربعة أخماس(4/5) ثمن المثل . ويجب لتقدير ما إذا كان الغبن يزيد عن الخمس (1/5) أن يقوم العقار بحسب قيمته وقت البيع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_358_right_0_915b3bff> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_358> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_358_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_358_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_358_19750926_OpEnact_add36b0ba6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_358_obligation_0_997e173d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 358" ;
    dzdoc:position 382 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_358_condition_0_6b3969ac> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:domicile ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "موطن كل جزائري هو المحل الذي يوجد فيه سكناه الرئيسي ، وعند عدم وجود سكنى يقوم محل الإقامة العادي مقام المواطن. ولا يجوز أن يكون للشخص أكثر من موطن واحد في نفس الوقت."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_36_permission_0_8616fc73> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_36> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_36_defocc_cf41cd6bc9cd> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_36_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_36_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_36_19750926_OpEnact_a9fec6dde3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "36" ;
    dzdoc:position 42 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_36_condition_0_4d9ceb10> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_384> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_384" ;
    dzdoc:fullText "يجوز للمتعاقدين بمقتضى اتفاق خاص أن يزيدا في الضمان أو أن ينقصا منه وان يسقطا هذا الضمان غير أن كل شرط يسقط الضمان أو ينقصه يقع باطلا إذا تعمد البائع اخفاء العيب في المبيع غشا منه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_384_permission_0_01b90043> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_384_right_0_b95d857c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_384> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_384_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_384_19750926_OpEnact_7f9e4affb1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 384" ;
    dzdoc:position 408 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_384_condition_0_ea60cb66> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_413> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:barter_contract ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_2> ;
    dzdoc:eId "art_413" ;
    dzdoc:fullText "المقايضة عقد يلتزم به كل من المتعاقدين أن ينقل إلى الآخر على سبيل التبادل ملكية مال غير النقود ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_413> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_413_defocc_e67a8052b589> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_413_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_413_19750926_OpEnact_f4be9d4d0e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_413_obligation_0_53ca04c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 413" ;
    dzdoc:position 437 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_423> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_1> ;
    dzdoc:eId "art_423" ;
    dzdoc:fullText "إذا كانت حصة الشريك عملا يقدمه للشركة وجب عليه أن يقوم بالخدمات التي تعهد بها و أن يقدم حسابا عما يكون قد كسبه من وقت قيام الشركة بمزاولته العمل الذي قدم كحصة لها . غير أنه لا يكون ملزما بأن يقدم للشركة ما يكون قد حصل عليه من حق اختراع إلا إذا وجد اتفاق يقضي بخلاف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_423> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_423_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_423_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_423_19750926_OpEnact_08d8c56f1a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_423_obligation_0_1987f77b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_423_obligation_1_ba603ac5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 423" ;
    dzdoc:position 447 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_423_condition_0_3adb78b2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_423_condition_1_f630955e> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_426> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_1> ;
    dzdoc:eId "art_426" ;
    dzdoc:fullText "إذا وقع الاتفاق على أن أحد الشركاء لا يسهم في أرباح الشركة ولا في خسائرها كان عقد الشركة باطلا. ويجوز الاتفاق على إعفاء الشريك الذي لم يقدم سوى عمله من كل مساهمة في الخسائر على شرط ألا يكون قد قررت له أجرة ثمن عمله ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_426> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_426_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_426_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_426_19750926_OpEnact_573915a1ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 426" ;
    dzdoc:position 450 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_426_condition_0_30b2dc99>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_426_condition_1_3ded903e> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_434> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_3> ;
    dzdoc:eId "art_434" ;
    dzdoc:fullText "إذا استغرقت الديون أموال الشركة ، كان الشركاء مسؤولين عن هذه الديون في أموالهم الخاصة، كل منهم بنسبة نصيبه في خسائر الشركة ، ما لم يوجد اتفاق يقضي بنسبة أخرى ويقع باطلا كل اتفاق يعفي الشريك من المسؤولية عن ديون الشركة . وعلى كل حال يكون لدائني الشركة الحق في مطالبة الشركاء كل بقدر الحصة التي تخصصت له في أرباح الشركة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_434_right_0_705682ba> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_434> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_434_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_434_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_434_19750926_OpEnact_0899fa3bdf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_434_obligation_0_bd006951> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "434" ;
    dzdoc:position 458 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_434_condition_0_14764399>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_434_condition_1_d13cac42> ;
    dzdoc:usesTerm dzterm:company,
        dzterm:partner,
        dzterm:partners .

<https://legal.dz/resource/order/1975-09-26/75-58#art_435> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_3> ;
    dzdoc:eId "art_435" ;
    dzdoc:fullText "لا تضامن بين الشركاء فيما هم مسؤولون عنه من ديون الشركة ، الا إذا وجد اتفاق يقضي بخلاف ذلك . غير انه إذا أعسر أحد الشركاء ، وزعت حصته في الدين على الآخرين كل بقدر نصيبه في تحمل الخسارة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_435> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_435_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_435_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_435_19750926_OpEnact_a9bd6652a3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_435_obligation_0_2a7394f0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "435" ;
    dzdoc:position 459 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_435_condition_0_6f2b71ec>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_435_condition_1_7cbab323> ;
    dzdoc:usesTerm dzterm:company,
        dzterm:partners .

<https://legal.dz/resource/order/1975-09-26/75-58#art_446> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_5> ;
    dzdoc:eId "art_446" ;
    dzdoc:fullText "ليس للمصفي أن يباشر أعمالا جديدة للشركة الا إذا كانت لازمة لاتمام أعمال سابقة . ويجوز له أن يبيع مال الشركة منقولا أو عقارا اما بالمزاد، واما بالتراضي ما لم يقيد قرار تعيينه هذه السلطة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_446_right_0_b46c9fa0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_446> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_446_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_446_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_446_19750926_OpEnact_3a0fa64114> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_446_obligation_0_ab49189c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 446" ;
    dzdoc:position 470 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_446_condition_0_3d7d1606> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_450> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:قرض_الاستهلاك ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_4> ;
    dzdoc:eId "art_450" ;
    dzdoc:fullText "قرض الاستهلاك هو عقد يلتزم به المقرض أن ينقل إلى المقترض ملكية مبلغ من النقود أو أي شيء مثلي آخر ، على أن يرد إليه المقترض عند نهاية القرض نظيره في النوع، والقدر، والصفة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_450> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_450_defocc_0d34b348f31f> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_450_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_450_19750926_OpEnact_2c2a92a2de> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_450_obligation_0_1ff25800>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_450_obligation_1_acea522b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 450" ;
    dzdoc:position 474 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_486> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_486" ;
    dzdoc:fullText "إذا ترتب على عمل قامت به السلطة الادارية بمقتضى القانون نقص كبير في الانتفاع بالعين المؤجرة جاز للمستأجر حسب الظروف أن يطلب فسخ الإيجار أو انقاص ثمنه وله أن يطالب بتعويضه إذا كان عمل السلطة الادارية قد صدر بسبب يكون المؤجر مسؤولا عنه كل هذا ما لم يوجد اتفاق يقضي بخلاف ذلك ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_486_right_0_45400080>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_486_right_1_f879edcc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_486> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_486_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_486_19750926_OpEnact_3e0c90be2d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 486" ;
    dzdoc:position 516 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_486_condition_0_4c06fcbd>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_486_condition_1_162e78fd> ;
    dzdoc:usesTerm dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_494> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_494" ;
    dzdoc:fullText "يلتزم المستأجر بالقيام بالترميمات الخاصة بالإيجار والجاري بها العمل ما لم يوجد اتفاق على خلاف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_494> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_494_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_494_19750926_OpEnact_ac0330d37d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_494_obligation_0_6a21d87a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 494" ;
    dzdoc:position 524 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_494_condition_0_c591866c> ;
    dzdoc:usesTerm dzterm:lessee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_495> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_495" ;
    dzdoc:fullText "يجب على المستأجر أن يعتني بالعين المؤجرة وان يحافظ عليها مثلما يبذله الرجل العادي . وهو مسؤول عما يلحق العين أثناء انتفاعه بها من فساد أو هلاك غير ناشيء عن استعمالها استعمالا عاديا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_495> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_495_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_495_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_495_19750926_OpEnact_3576cb632f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_495_obligation_0_10b79106>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_495_obligation_1_3452cdd3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 495" ;
    dzdoc:position 525 ;
    dzdoc:usesTerm dzterm:lessee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "يتمتع الشخص الاعتباري بجميع الحقوق الا ما كان منها ملازما لصفة الانسان ، وذلك في الحدود التي يقررها القانون . يكون لها خصوصا : ذمة مالية، أهلية في الحدود التي يعينها عقد انشائها أو التي يقررها القانون ، موطن وهو المكان الذي يوجد فيه مركز إدارتها، الشركات التي يكون مركزها الرئيسي في الخارج ولها نشاط في الجزائر يعتبر مركزها، في نظر القانون الداخلي في الجزائر، نائب يعبر عن إرادتها، حق التقاضي"@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_50_right_0_20b638ff>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_50_right_1_68c1697e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_50> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_50_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_50_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_50_19750926_OpEnact_3612afe94f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "50" ;
    dzdoc:position 56 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_50_condition_0_6ba172ec>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_50_condition_1_4d9c54ba> ;
    dzdoc:usesTerm dzterm:juridical_person .

<https://legal.dz/resource/order/1975-09-26/75-58#art_502> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_502" ;
    dzdoc:fullText "يجب على المستأجر أن يرد العين المؤجرة عند انتهاء مدة الإيجار فإذا أبقاها تحت يده دون حق وجب عليه أن يدفع للمؤجر تعويضا باعتبار القيمة الإيجارية للعين وباعتبار ما لحق المؤجر من ضرر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_502> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_502_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_502_19750926_OpEnact_86cb6f7031> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_502_obligation_0_8d29c199>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_502_obligation_1_c3313dae> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 502" ;
    dzdoc:position 532 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_502_condition_0_f0e4e040> ;
    dzdoc:usesTerm dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_541> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_2_subsec_1> ;
    dzdoc:eId "art_541" ;
    dzdoc:fullText "لا ضمان على المعير في استحقاق الشيء المعار إلا أن يكون هناك اتفاق على الضمان أو يكون المعير قد تعمد إخفاء سبب نزع اليد . ولا ضمان عليه كذلك في العيوب الخفية، غير أنه إذا تعمد إخفاء العيب أو إذا ضمن سلامة الشيء منه ، لزمه تعويض المستعير عن كل ضرر يسببه ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_541> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_541_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_541_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_541_19750926_OpEnact_4a3cc1a01f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_541_obligation_0_bef9c062> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 541" ;
    dzdoc:position 568 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_541_condition_0_94fc1e7a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_541_condition_1_e58363c4> ;
    dzdoc:usesTerm dzterm:bailee,
        dzterm:bailor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_582> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_2> ;
    dzdoc:eId "art_582" ;
    dzdoc:fullText "على الموكل أن يرد للوكيل ما أنفقه في تنفيذ الوكالة تنفيذا معتادا وذلك مهما كان حظ الوكيل من النجاح في تنفيذ الوكالة فإذا اقتضى تنفيذ الوكالة أن يقدم الموكل للوكيل مبالغ للانفاق منها في شؤون الوكالة وجب على الموكل أن يقدم هذه المبالغ إذا طلب الوكيل ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_582> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_582_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_582_19750926_OpEnact_f4dbb3d12c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_582_obligation_0_6fba72c4>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_582_obligation_1_b7b8aff0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 582" ;
    dzdoc:position 619 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_582_condition_0_04ddb7e2> ;
    dzdoc:usesTerm dzterm:agency,
        dzterm:agent,
        dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_608> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_4> ;
    dzdoc:eId "art_608" ;
    dzdoc:fullText "لا يجوز للحارس في غير أعمال الادارة أن يتصرف الا برضاء ذوي الشأن جميعا أو بترخيص من القضاء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_608_permission_0_987cf79c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_608> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_608_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_608_19750926_OpEnact_4f7e8b20ec> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_608_prohibition_0_987cf79c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "608" ;
    dzdoc:position 645 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_608_condition_0_a95f18b2> ;
    dzdoc:usesTerm dzterm:حارس .

<https://legal.dz/resource/order/1975-09-26/75-58#art_617> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_10_sec_2> ;
    dzdoc:eId "art_617" ;
    dzdoc:fullText "لا يكون للمستحق حق في المرتب الا عن الأيام التي عاشها منذ قرر المرتب مدى حياته . على أنه اشترط الدفع مقدما كان للمستحق حق في القسط الذي حل أجله ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_617_right_0_689c9616>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_617_right_1_d14efef6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_617> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_617_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_617_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_617_19750926_OpEnact_e0832e10d8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 617" ;
    dzdoc:position 654 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_617_condition_0_8cb992c6> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "إذا صدر الايجاب في مجلس العقد لشخص حاضر دون تحديد أجل القبول فإن الموجب يتحلل من ايجابه إذا لم يصدر القبول فورا وكذلك إذا صدر الايجاب من شخص إلى آخر بطريق الهاتف أو بأي طريق مماثل. غير أن العقد يتم، ولو لم يصدر القبول فورا، إذا لم يوجد ما يدل على أن الموجب قد عدل عن ايجابه في الفترة ما بين الايجاب والقبول، وكان القبول صدر قبل أن ينفض مجلس العقد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_64_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_64_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_64_19750926_OpEnact_b8a28ba2fb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 64" ;
    dzdoc:position 70 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_64_condition_0_a64a9d39>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_64_condition_1_c046a34e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_64_condition_2_cd22bee3> ;
    dzdoc:usesTerm dzterm:contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_654> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_654" ;
    dzdoc:fullText "يبرأ الكفيل بمجرد براءة المدين ، وله أن يتمسك بجميع الأوجه التي يحتج بها المدين . غير أنه إذا كان الوجه الذي يحتج به المدين يتمثل في نقص أهليته وكان الكفيل عالما بذلك وقت التعاقد ، فليس له أن يحتج بهذا الوجه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_654_right_0_25fc4a80> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_654> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_654_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_654_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_654_19750926_OpEnact_66405cb9de> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 654" ;
    dzdoc:position 691 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_654_condition_0_9ee280d3> ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_656> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:guarantees ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_656" ;
    dzdoc:fullText "تبرأ ذمة الكفيل بالقدر الذي أضاعه الدائن بخطئه من الضمانات . ويقصد بالضمانات في هذه المادة كل التأمينات المخصصة لضمان الدين ولو تقررت بعد الكفالة وكذلك كل التأمينات المقررة بحكم القانون ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_656_right_0_9d90fa96> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_656> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_656_defocc_b777009f4e0e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_656_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_656_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_656_19750926_OpEnact_dc5898e462> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 656" ;
    dzdoc:position 693 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_656> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_656> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_661> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_661" ;
    dzdoc:fullText "إذا طلب الكفيل التجريد ، وجب عليه أن يقوم على نفقته بارشاد الدائن إلى أموال المدين تفي بالدين كله . ولا يؤخذ بعين الاعتبار الأموال التي يدل عليها الكفيل إذا كانت هذه الأموال تقع خارج الأراضي الجزائرية، أو كانت متنازعا فيها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_661> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_661_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_661_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_661_19750926_OpEnact_f327bc2bc9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_661_obligation_0_9089f564> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 661" ;
    dzdoc:position 698 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_661_condition_0_8985d551>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_661_condition_1_c5520ba8> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_663> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_663" ;
    dzdoc:fullText "إذا كان هناك تأمين عيني خصص قانونا أو اتفاقا لضمان الدين وقدمت كفالة بعد هذا التأمين أو معه ولم يكن الكفيل متضامنا مع المدين ، فلا يجوز التنفيذ على أموال الكفيل الا بعد التنفيذ على الأموال التي خصصت لهذا التأمين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_663_permission_0_06576851> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_663> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_663_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_663_19750926_OpEnact_164ae20821> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 663" ;
    dzdoc:position 700 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_663_condition_0_737338df> ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "إذا كانت طبيعة المعاملة، أو العرف التجاري، أو غير ذلك من الظروف، تدل على أن الموجب لم يكن لينتظر تصريحا بالقبول فإن العقد يعتبر قد تم إذا لم يرفض الايجاب في وقت مناسب . ويعتبر السكوت في الرد قبولا ، إذا اتصل الايجاب بتعامل سابق بين المتعاقدين، أو إذا كان الايجاب لمصلحة من وجه إليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_68_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_68_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_68_19750926_OpEnact_12b4917e2a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 68" ;
    dzdoc:position 74 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_68_condition_0_4c511d05>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_68_condition_1_c82e8f2e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_68_condition_2_94056a83> ;
    dzdoc:usesTerm dzterm:contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_681_bis_2" ;
    dzdoc:fullText "يحدد تعويض الاستيلاء باتفاق بين الأطراف. وفي حالة عدم الاتفاق يحدد مبلغ التعويض عن طريق القضاء مع مراعاة ظروف وغرض الاستيلاء دون أن يتضرر المستفيد. كما يمكن منح التعويض في حالة تسبب المستفيد من الاستيلاء في نقص القيمة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2_permission_0_119088ef> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_bis_2_19750926_OpEnact_22102b411d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 681 مكرر 2" ;
    dzdoc:position 720 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2_condition_0_6e2c819c> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_692> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:land_ownership,
        dzterm:water_resources ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_692" ;
    dzdoc:fullText "الأرض ملك لمن يخدمها وتعتبر جميع موارد المياه ملكا للجماعة الوطنية . تحدد اجراءات تطبيق هذه المادة بالنصوص الخاصة بالثورة الزراعية والنصوص المتعلقة بالبحث والتوزيع، واستعمال، واستغلال المياه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_692> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_692_defocc_e5ea5201f7f4>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_692_defocc_f6927318eaf1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_692_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_692_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_692_19750926_OpEnact_62e4e571cf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "692" ;
    dzdoc:position 732 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_692> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_692> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_704> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_704" ;
    dzdoc:fullText "لمالك الحائط المشترك أن يستعمله بحسب الغرض الذي أعد له وأن يضع فوقه عوارض ليسند عليها السقف دون أن يحمل الحائط فوق طاقته . فإذا لم يعد الحائط المشترك صالحا للغرض الذي خصص له فإن نفقة ترميمه، وإعادة بنائه تكون على الشركاء كل بنسبة حصته فيه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_704_right_0_41b5bb8a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_704> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_704_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_704_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_704_19750926_OpEnact_b98171b513> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_704_obligation_0_941b27e3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
