<https://legal.dz/resource/order/1975-09-26/75-58#art_772> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_772" ;
    dzdoc:fullText "تتقادم بعشرة (10) أعوام الدعاوى الشخصية التي تنشأ عن تطبيق نظام الملكية المشتركة بين الشاغلين وبين أحد الشاغلين والمتصرف . أما الدعاوى التي يكون من شأنها معارضة قرار الجمعية فيجب أن تقدم من طرف الشاغلين المعارضين منهم أو الغائبين في مدة شهرين ابتداءا من يوم إعلانها من طرف المتصرف وإلا سقطت الدعوى ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_772> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_772_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_772_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_772_19750926_OpEnact_be936395c3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_772_obligation_0_4efc8468>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_772_obligation_1_22cb1f4e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
