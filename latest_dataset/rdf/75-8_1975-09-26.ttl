dzterm:الاقرار a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الاقرار"@ar,
        "الاقرار هو اعتراف الخصم أمام القضاء بواقعة قانونية مدعى بها عليه ذلك أثناء السير في الدعوى المتعلقة بها الواقعة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_341_defocc_554bd17ee507> .

dzterm:المدين a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المدين"@ar .

dzterm:حراسة_اتفاقية a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الحراسة الاتفاقية"@ar,
        "الحراسة الاتفاقية هو إيداع شيء متنازع فيه من طرف شخص أو عدة أشخاص بين أيدي شخص آخر يلتزم بإعادته بعد فض المنازعة إلى الشخص الذي يثبت له الحق فيه"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_602_defocc_deb761953f40> .

dzterm:حوالة_الدين a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تتم حوالة الدين باتفاق بين المدين وشخص آخر يتحمل عنه الدين."@ar,
        "حوالة الدين"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_251_defocc_afab1eaa8325> .

dzterm:دائن_مرتهن a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الدائن المرتهن"@ar .

