<https://legal.dz/resource/order/1975-09-26/75-58#version_art_321> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للمحكمة أن تقتضي تلقائيا بالتقادم بل يجب أن يكون ذلك بناء على طلب المدين أو من أحد دائنيه، أو أي شخص له مصلحة فيه ولو لم يتمسك المدين به . ويجوز التمسك بالتقادم في أية حالة من حالات الدعوى ولو امام المحكمة الاستئنافية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_321_19750926_OpEnact_3330a1b388> ;
