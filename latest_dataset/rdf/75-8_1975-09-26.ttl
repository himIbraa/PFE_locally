<https://legal.dz/resource/order/1975-09-26/75-58#version_art_878> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنتهي حقوق الارتفاق بانقضاء الأجل المحدد، وبهلاك العقار المرتفق به هلاكا تاما أو باجتماع العقار المرتفق به و العقار المرتفق في يد مالك واحد ، و يعود حق الارتفاق إذا زال اجتماع العقارين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_878_19750926_OpEnact_8fd620ab4b> ;
    dzdoc:replacementText "تنتهي حقوق الارتفاق بانقضاء الأجل المحدد، وبهلاك العقار المرتفق به هلاكا تاما أو باجتماع العقار المرتفق به و العقار المرتفق في يد مالك واحد ، و يعود حق الارتفاق إذا زال اجتماع العقارين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
