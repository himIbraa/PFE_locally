<https://legal.dz/resource/order/1975-09-26/75-58#version_art_841> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للقاضي بناء على طلب المالك أن يختار ما يراه مناسبا للوفاء بالمصاريف المنصوص عليها في المادتين 839 و 840 وله أيضا أن يقدر بأن يكون الوفاء على أقساط دورية بشرط تقديم الضمانات اللازمة ، وللمالك أن يتحلل من هذا الالتزام إذا سبق مبلغا يساوي قيمة هذه الاقساط ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
