    dznorm:provisionText "حق امتياز عليه تأمينا لما تخوله القسمة من حق في رجوع كل منهم على الآخرين"@ar ;
    dznorm:sourceArticle "art_1001" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_1001_right_0_82d232b2_role_b900823af0> a dznorm:Role ;
    rdfs:label "الآخرين"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "حق امتياز عليه تأمينا لما تخوله القسمة من حق في رجوع كل منهم على الآخرين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_1001> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_1002_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_1002> ;
    dzdoc:position 0 ;
    dzdoc:text "لا تطبق مدة التقادم المحددة في هذا القانون إلا على الوقائع التي ترد بعد نشر هذا الأمر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_1003_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_1003> ;
    dzdoc:position 0 ;
    dzdoc:text "يسري مفعول هذا الأمر ابتداء من تاريخ 25 جمادى الثانية عام 1395 الموافق 5 يوليو 1975"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_1003_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_1003> ;
    dzdoc:position 1 ;
    dzdoc:text "وينشر في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_1003_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_1003> ;
    dzdoc:position 2 ;
    dzdoc:text "وحرر بالجزائر في 20 رمضان عام 1395 الموافق 26 سبتمبر سنة 1975."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_1003_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_1003> ;
    dzdoc:position 3 ;
    dzdoc:text "هواري بومدين"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_100_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_100> ;
    dzdoc:position 0 ;
    dzdoc:text "يزول حق إبطال العقد بالاجازة الصريحة أو الضمنية وتستند الاجازة إلى التاريخ الذي تم فيه العقد، دون إخلال بحقوق الغير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_100_right_0_6f7e51b2> a dznorm:Right ;
