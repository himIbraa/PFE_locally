    dznorm:conditionText "إذا تسلم شخص السندات وتسلم آخر البضائع ذاتها وكان كلاهما حسن النية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_813> ;
