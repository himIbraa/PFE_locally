<https://legal.dz/resource/order/1975-09-26/75-58#version_art_931> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرجع الحائز بدعوى الضمان على المالك السابق في الحدود التي يرجع بها الخلف على من تلقى منه الملكية معاوضة أو تبرعا . ويرجع الحائز أيضا على المدين بما دفعه زيادة على ما هو مستحق في ذمته بمقتضى سند ملكية أيا كان السبب في دفع هذه الزيادة ، و يحل محل الدائنين الذين وفاهم حقوقهم ، وبوجه خاص فيما لهم من تأمينات قدمها المدين دون التأمينات التي قدمها شخص آخر غير المدين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_931_19750926_OpEnact_cfdcce8d53> ;
    dzdoc:replacementText "يرجع الحائز بدعوى الضمان على المالك السابق في الحدود التي يرجع بها الخلف على من تلقى منه الملكية معاوضة أو تبرعا . ويرجع الحائز أيضا على المدين بما دفعه زيادة على ما هو مستحق في ذمته بمقتضى سند ملكية أيا كان السبب في دفع هذه الزيادة ، و يحل محل الدائنين الذين وفاهم حقوقهم ، وبوجه خاص فيما لهم من تأمينات قدمها المدين دون التأمينات التي قدمها شخص آخر غير المدين ."@ar ;
