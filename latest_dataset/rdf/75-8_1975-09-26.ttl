<https://legal.dz/resource/order/1975-09-26/75-58#art_221_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_221> ;
    dzdoc:position 0 ;
    dzdoc:text "كل ما يستوفيه أحد الدائنين المتضامنين من الدين يصير ملكا لجميع الدائنين وتقسم بينهم حسب وتكون القسمة : بينهم بالتساوي ما لم يوجد اتفاق أو نص قانوني يقضي بغير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_222_condition_0_ce914f7b> a dznorm:Condition ;
    dznorm:conditionText "إذا كان التضامن بين المدينين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_222> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_222_obligation_0_71f15a22> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_222> ;
    dznorm:position 0 ;
    dznorm:provisionText "وفاء أحدهم للدين مبرئ ذمة الباقين"@ar ;
    dznorm:sourceArticle "art_222" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_222_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_222> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان التضامن بين المدينين فإن وفاء أحدهم للدين مبرئ ذمة الباقين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_223_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_223> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز للدائن مطالبة المدينين المتضامنين مجتمعين أو منفردين على أن يراعى في ذلك ما يلحق رابطة كل مدين من وصف."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_223_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_223> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا يجوز للمدين إذا طالبه أحد الدائنين بالوفاء أن يعارض بأوجه الدفع الخاصة بغيره من المدينين ولكن يجوز له أن يعارض بأوجه الدفع الخاصة به وبالتي يشترك فيها جميع المدينين."@ar .

