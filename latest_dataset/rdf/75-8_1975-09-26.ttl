<https://legal.dz/resource/order/1975-09-26/75-58#version_art_196> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يقصد بالغش إلا تفضيل دائن على آخر دون حق فلا يترتب عليه إلا حرمان الدائن من هذه الميزة. وإذا وفي المدين المعسر أحد دائنيه قبل حلول الأجل المضروب أصلا للوفاء ، فلا يسري هذا الوفاء في حق باقي الدائنين وكذلك لا يسري في حقهم الوفاء ولو حصل بعد حلول هذا الأجل، إذا كان قد تم نتيجة تواطؤ بين المدين والدائن الذي استوفي حقه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_196_19750926_OpEnact_c5881548f3> ;
    dzdoc:replacementText "إذا لم يقصد بالغش إلا تفضيل دائن على آخر دون حق فلا يترتب عليه إلا حرمان الدائن من هذه الميزة. وإذا وفي المدين المعسر أحد دائنيه قبل حلول الأجل المضروب أصلا للوفاء ، فلا يسري هذا الوفاء في حق باقي الدائنين وكذلك لا يسري في حقهم الوفاء ولو حصل بعد حلول هذا الأجل، إذا كان قد تم نتيجة تواطؤ بين المدين والدائن الذي استوفي حقه ."@ar ;
