    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_292> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا قدم المدين تأمينات حقيقية لكفالة الالتزام القديم فإن الاتفاق على نقل هذه التأمينات إلى الالتزام الجديد تراعى فيه الأحكام الآتية : إذا كان التجديد بتغيير الدين جاز للدائن وللمدين الاتفاق على انتقال التأمينات للالتزام الجديد، في الحدود التي لا تلحق ضررا بالغير، إذا كان التجديد بتغيير المدين جاز للدائن وللمدين الجديد الاتفاق على استبقاء التأمينات العينية دون حاجة إلى رضا المدين القديم، إذا كان التجديد بتغيير الدائن جاز للاطراف الثلاثة المتعاقدين الاتفاق على استبقاء التأمينات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_292_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_292> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا يكون الاتفاق على انتقال التأمينات العينية نافذا في حق الغير، الا إذا تم مع التجديد في وقت واحد، مع مراعاة الأحكام المتعلقة بالتسجيل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_293_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_293> ;
    dzdoc:position 0 ;
    dzdoc:text "لا تنتقل الكفالة العينية، أو الشخصية، ولا التضامن إلى الالتزام الجديد الا إذا رضي بذلك الكفلاء والمدينون المتضامنون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_294_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_294> ;
    dzdoc:position 1 ;
    dzdoc:text "ولا تقتضي الانابة أن تكون هناك حتما مديونية سابقة بين المدين والغير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_295_condition_0_78bd843c> a dznorm:Condition ;
    dznorm:conditionText "إذا اتفق المتعاقدون في الانابة أن يستبدلوا بالتزام سابق التزاما جديدا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_295> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_295_condition_1_29b944c7> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-58#art_295_condition_1_29b944c7_role_19284b6898> ;
    dznorm:conditionText "على أن يكون الالتزام الجديد الذي ارتضاه المناب صحيحا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_295> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_295_condition_1_29b944c7_role_19284b6898> a dznorm:Role ;
