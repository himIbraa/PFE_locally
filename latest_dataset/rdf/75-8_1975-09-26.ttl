    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_115> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_115_para_0> ;
