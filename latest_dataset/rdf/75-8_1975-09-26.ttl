<https://legal.dz/resource/order/1975-09-26/75-58#version_art_431> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يوجد نص خاص على طريقة الادارة اعتبر كل شريك مفوضا من طرف الآخرين لادارة الشركة و يسوغ له أن يباشر أعمال الشركة دون الرجوع إلى غيره على أن يكون للشركاء الحق في رفض هذا الاعتراض على أي عمل قبل انجازه و لا غلبية الشركاء الحق في رفض هذا الاعتراض ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_431_19750926_OpEnact_ad47cbb74f> ;
    dzdoc:replacementText "إذا لم يوجد نص خاص على طريقة الادارة اعتبر كل شريك مفوضا من طرف الآخرين لادارة الشركة و يسوغ له أن يباشر أعمال الشركة دون الرجوع إلى غيره على أن يكون للشركاء الحق في رفض هذا الاعتراض على أي عمل قبل انجازه و لا غلبية الشركاء الحق في رفض هذا الاعتراض ."@ar ;
