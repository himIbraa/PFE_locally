<https://legal.dz/resource/order/1975-09-26/75-58#version_art_319> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا انقطع التقادم بدأ تقادم جديد يسري من وقت انتهاء الاثر المترتب على سبب الانقطاع وتكون مدته هي مدة التقادم الأول . غير أنه إذا حكم بالدين وحاز الحكم قوة الشيء المقضي به أو إذا كان الدين يتقادم بسنة وانقطع تقادمه بإقرار المدين ، كانت مدة التقادم الجديد خمسة عشرة (15) سنة الا أن يكون الدين المحكوم به متضمنا لالتزامات دورية متجددة لا تستحق الاداء الا بعد صدور الحكم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_319_19750926_OpEnact_7559d6d327> ;
    dzdoc:replacementText "إذا انقطع التقادم بدأ تقادم جديد يسري من وقت انتهاء الاثر المترتب على سبب الانقطاع وتكون مدته هي مدة التقادم الأول . غير أنه إذا حكم بالدين وحاز الحكم قوة الشيء المقضي به أو إذا كان الدين يتقادم بسنة وانقطع تقادمه بإقرار المدين ، كانت مدة التقادم الجديد خمسة عشرة (15) سنة الا أن يكون الدين المحكوم به متضمنا لالتزامات دورية متجددة لا تستحق الاداء الا بعد صدور الحكم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_319> ;
