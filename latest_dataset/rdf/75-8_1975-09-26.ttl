        <https://legal.dz/resource/order/1975-09-26/75-58#art_344_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_344_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_344_19750926_OpEnact_85479e581f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_344_obligation_0_d16044f0> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_344_prohibition_0_219af711> ;
