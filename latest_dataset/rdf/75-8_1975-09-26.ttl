<https://legal.dz/resource/order/1975-09-26/75-58#version_art_15> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسري على الشروط الموضوعية الخاصة بالولاية والوصاية والقوامة وغيرها من النظم المقررة لحماية القصر وعديمي الأهلية والغائبين قانون الشخص الذي تجب حمايته. غير أنه يطبق القانون الجزائري بالنسبة للتدابير المستعجلة إذا كان القصر وعديمو الأهلية والغائبون موجودين في الجزائر وقت اتخاذ هذه التدابير ، أو تعلقت بأموالهم الموجودة في الجزائر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_15_19750926_OpEnact_b0d51ab310> ;
    dzdoc:replacementText "يسري على الشروط الموضوعية الخاصة بالولاية والوصاية والقوامة وغيرها من النظم المقررة لحماية القصر وعديمي الأهلية والغائبين قانون الشخص الذي تجب حمايته. غير أنه يطبق القانون الجزائري بالنسبة للتدابير المستعجلة إذا كان القصر وعديمو الأهلية والغائبون موجودين في الجزائر وقت اتخاذ هذه التدابير ، أو تعلقت بأموالهم الموجودة في الجزائر ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
