<https://legal.dz/resource/order/1975-09-26/75-58#version_art_800> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يشتمل الانذار المنصوص عليه في المادة 799 على البيانات التالية والا كان باطلا : بيان العقار الجائز أخذه بالشفعة بيانا كافيا، بيان الثمن والمصاريف الرسمية وشروط البيع واسم كل من البائع والمشتري ولقبه ومهنته وموطنه والأجل الذي قدره ثلاثون (30) يوما للإعلان المنصوص عليه في المادة 799 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_800_19750926_OpEnact_fc37b77ae2> ;
    dzdoc:replacementText "يجب أن يشتمل الانذار المنصوص عليه في المادة 799 على البيانات التالية والا كان باطلا : بيان العقار الجائز أخذه بالشفعة بيانا كافيا، بيان الثمن والمصاريف الرسمية وشروط البيع واسم كل من البائع والمشتري ولقبه ومهنته وموطنه والأجل الذي قدره ثلاثون (30) يوما للإعلان المنصوص عليه في المادة 799 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
