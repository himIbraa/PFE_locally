<https://legal.dz/resource/order/1975-09-26/75-58#version_art_98> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل التزام مفترض أن له سببا مشروعا، ما لم يقم الدليل على غير ذلك. ويعتبر السبب المذكور في العقد هو السبب الحقيقي حتى يقوم الدليل على ما يخالف ذلك، فاذا قام الدليل على صورية السبب فعلى من يدعي أن للالتزام سببا آخر مشروعا أن يثبت ما يدعيه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_98_19750926_OpEnact_8127028907> ;
    dzdoc:replacementText "كل التزام مفترض أن له سببا مشروعا، ما لم يقم الدليل على غير ذلك. ويعتبر السبب المذكور في العقد هو السبب الحقيقي حتى يقوم الدليل على ما يخالف ذلك، فاذا قام الدليل على صورية السبب فعلى من يدعي أن للالتزام سببا آخر مشروعا أن يثبت ما يدعيه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_98> ;
