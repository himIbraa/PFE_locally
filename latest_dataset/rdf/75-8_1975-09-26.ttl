<https://legal.dz/resource/order/1975-09-26/75-58#art_62_condition_0_41e0c65c> a dznorm:Condition ;
    dznorm:conditionText "إذا مات من صدر منه التعبير عن الارادة أو فقد أهليته قبل أن ينتج التعبير أثره"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_62> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_62_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_62> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا مات من صدر منه التعبير عن الارادة أو فقد أهليته قبل أن ينتج التعبير أثره، فإن ذلك لا يمنع من ترتب هذا الأثر عند اتصال التعبير بعلم من وجه اليه، هذا ما لم يتبين العكس من التعبير أو من طبيعة التعامل."@ar .

