<https://legal.dz/resource/order/1975-09-26/75-58#art_165_obligation_0_bc6af369> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_165> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_165_obligation_0_bc6af369_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "الالتزام بنقل الملكية، أو أي حق عيني آخر من شأنه أن ينقل بحكم القانون الملكية أو الحق العيني، إذا كان محل الالتزام شيئا معينا بالذات يملكه الملتزم، وذلك مع مراعاة الأحكام المتعلقة بالاشهار العقاري"@ar ;
    dznorm:sourceArticle "art_165" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_170_right_0_f37456d0> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
