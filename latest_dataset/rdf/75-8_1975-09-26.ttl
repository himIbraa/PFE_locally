<https://legal.dz/resource/order/1975-09-26/75-58#version_art_708> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ليس لجار أن يجبر جاره على تحويط ملكه ولا على التنازل عن جزء من حائط أو من الأرض التي يقوم عليها الحائط إلا في الحالة المذكورة في المادة 697 . غير أنه ليس لمالك الحائط أن يهدمه مختارا دون عذر قانوني إن كان هذا يضر الجار الذي يستتر ملكه بالحائط ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_708_19750926_OpEnact_081f7ea6f0> ;
    dzdoc:replacementText "ليس لجار أن يجبر جاره على تحويط ملكه ولا على التنازل عن جزء من حائط أو من الأرض التي يقوم عليها الحائط إلا في الحالة المذكورة في المادة 697 . غير أنه ليس لمالك الحائط أن يهدمه مختارا دون عذر قانوني إن كان هذا يضر الجار الذي يستتر ملكه بالحائط ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
