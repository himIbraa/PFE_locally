<https://legal.dz/resource/order/1975-09-26/75-58#version_art_64> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا صدر الايجاب في مجلس العقد لشخص حاضر دون تحديد أجل القبول فإن الموجب يتحلل من ايجابه إذا لم يصدر القبول فورا وكذلك إذا صدر الايجاب من شخص إلى آخر بطريق الهاتف أو بأي طريق مماثل. غير أن العقد يتم، ولو لم يصدر القبول فورا، إذا لم يوجد ما يدل على أن الموجب قد عدل عن ايجابه في الفترة ما بين الايجاب والقبول، وكان القبول صدر قبل أن ينفض مجلس العقد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_64_19750926_OpEnact_b8a28ba2fb> ;
    dzdoc:replacementText "إذا صدر الايجاب في مجلس العقد لشخص حاضر دون تحديد أجل القبول فإن الموجب يتحلل من ايجابه إذا لم يصدر القبول فورا وكذلك إذا صدر الايجاب من شخص إلى آخر بطريق الهاتف أو بأي طريق مماثل. غير أن العقد يتم، ولو لم يصدر القبول فورا، إذا لم يوجد ما يدل على أن الموجب قد عدل عن ايجابه في الفترة ما بين الايجاب والقبول، وكان القبول صدر قبل أن ينفض مجلس العقد ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_64> ;
