<https://legal.dz/resource/order/1975-09-26/75-58#version_art_439> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنتهي الشركة بموت أحد الشركاء أو الحجر عليه أو باعساره أو بافلاسه. إلا أنه يجوز الاتفاق في حالة ما إذا مات أحد الشركاء أن تستمر الشركة مع ورثته ولو كانوا قصرا. ويجوز أيضا الاتفاق على انه إذا مات أحد الشركاء أو حجر عليه أو أفلس أو انسحب من الشركة وفقا ل المادة 440 ، أن تستمر الشركة بين الشركاء الباقين وفي هذه الحالة لا يكون لهذا الشريك أو لورثته الا نصيبه في أموال الشركة، ويقدر هذا النصيب بحسب قيمته يوم وقوع الحادث الذي أدى إلى خروجه من الشركة ويدفع له نقدا ولا يكون له نصيب فيما يستجد بعد ذلك من "@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_439_19750926_OpEnact_2c6dc5037b> ;
    dzdoc:replacementText "تنتهي الشركة بموت أحد الشركاء أو الحجر عليه أو باعساره أو بافلاسه. إلا أنه يجوز الاتفاق في حالة ما إذا مات أحد الشركاء أن تستمر الشركة مع ورثته ولو كانوا قصرا. ويجوز أيضا الاتفاق على انه إذا مات أحد الشركاء أو حجر عليه أو أفلس أو انسحب من الشركة وفقا ل المادة 440 ، أن تستمر الشركة بين الشركاء الباقين وفي هذه الحالة لا يكون لهذا الشريك أو لورثته الا نصيبه في أموال الشركة، ويقدر هذا النصيب بحسب قيمته يوم وقوع الحادث الذي أدى إلى خروجه من الشركة ويدفع له نقدا ولا يكون له نصيب فيما يستجد بعد ذلك من حقوق الا بقدر الحقوق الناتجة من أعمال سابقة على ذلك الحادث."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_439> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_439> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
