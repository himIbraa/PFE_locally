<https://legal.dz/resource/order/1975-09-26/75-58#art_960> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_960" ;
    dzdoc:fullText "تسري على رهن الحيازة أحكام المادة 901 المتعلقة بمسؤولية الراهن غير المدين وأحكام المادة 903 المتعلقة بشرط التملك عند عدم الوفاء وشرط البيع دون إجراءات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_960> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_960_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_960_19750926_OpEnact_9380656cb0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "960" ;
    dzdoc:position 1011 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_901>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_903> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_901>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_903> ;
    dzdoc:usesTerm dzterm:راهن,
        dzterm:مدين .

<https://legal.dz/resource/order/1975-09-26/75-58#art_963> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_963" ;
    dzdoc:fullText "لا يقتصر الرهن الحيازي على ضمان أصل الحق وإنما يضمن أيضا وفي نفس المرتبة ما يلي : المصاريف الضرورية التي أنفقت للمحافظة على الشيء، التعويضات عن الاضرار الناشئة عن عيوب الشيء، مصاريف العقد الذي أنشأ الدين ومصاريف عقد الرهن الحيازي وقيده عند الاقتضاء، المصاريف التي اقتضاها تنفيذ الرهن الحيازي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_963> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_963_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_963_19750926_OpEnact_6f7f853271> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 963" ;
    dzdoc:position 1014 ;
    dzdoc:usesTerm dzterm:possessory_pledge .

<https://legal.dz/resource/order/1975-09-26/75-58#art_974> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_5> ;
    dzdoc:eId "art_974" ;
    dzdoc:fullText "تسري الأحكام السابقة إذا لم تتعارض مع أحكام القوانين التجارية والأحكام الخاصة بالمنشآت المرخص لها بالتسليف على الرهن وأحكام القوانين واللوائح المتعلقة بأحوال خاصة في رهن المنقول ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_974> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_974_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
