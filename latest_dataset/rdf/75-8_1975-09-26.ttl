<https://legal.dz/resource/order/1975-09-26/75-58#version_art_332> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "التأشير على سند بما يستفاد منه براءة ذمة المدين حجة على الدائن إلى أن يثبت العكس ولو لم يكن التأشير موقعا منه ما دام السند لم يخرج قط من حيازته. وكذلك يكون الحكم إذا اثبت الدائن بخطه دون توقيع ما يستفاد منه براءة ذمة المدين في نسخة أصلية أخرى، أو في مخالصة وكانت النسخة أو المخالصة في يد المدين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_332_19750926_OpEnact_5a13162b91> ;
    dzdoc:replacementText "التأشير على سند بما يستفاد منه براءة ذمة المدين حجة على الدائن إلى أن يثبت العكس ولو لم يكن التأشير موقعا منه ما دام السند لم يخرج قط من حيازته. وكذلك يكون الحكم إذا اثبت الدائن بخطه دون توقيع ما يستفاد منه براءة ذمة المدين في نسخة أصلية أخرى، أو في مخالصة وكانت النسخة أو المخالصة في يد المدين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_332> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_332> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_333> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في غير المواد التجارية إذا كان التصرف القانوني تزيد قيمته على 100.000 دينار جزائري أو كان غير محدد القيمة فلا يجوز الإثبات بالشهود في وجوده أو انقضائه ما لم يوجد نص يقضي بغير ذلك. ويقدر الالتزام باعتبار قيمته وقت صدور التصرف القانوني ويجوز الإثبات بالشهود إذا كانت زيادة الإلتزام على 100.000 دينار جزائري لم تأت إلا من ضم الملحقات إلى الأصل . وإذا اشتملت الدعوى على طلبات متعددة ناشئة عن مصادر متعددة جاز الإثبات بالشهود في كل طلب لا تزيد قيمته على 100.000 دينار جزائري ولو كانت هذه الطلبات في مجموعه"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_333_19750926_OpEnact_bd3aa4f7ac> ;
    dzdoc:replacementText "في غير المواد التجارية إذا كان التصرف القانوني تزيد قيمته على 100.000 دينار جزائري أو كان غير محدد القيمة فلا يجوز الإثبات بالشهود في وجوده أو انقضائه ما لم يوجد نص يقضي بغير ذلك. ويقدر الالتزام باعتبار قيمته وقت صدور التصرف القانوني ويجوز الإثبات بالشهود إذا كانت زيادة الإلتزام على 100.000 دينار جزائري لم تأت إلا من ضم الملحقات إلى الأصل . وإذا اشتملت الدعوى على طلبات متعددة ناشئة عن مصادر متعددة جاز الإثبات بالشهود في كل طلب لا تزيد قيمته على 100.000 دينار جزائري ولو كانت هذه الطلبات في مجموعها تزيد على هذه القيمة، ولو كان منشؤها علاقات بين الخصوم أنفسهم أو تصرفات قانونية من طبيعة واحدة، وكذلك الحكم في كل وفاء لا تزيد قيمته على 100.000 دينار جزائري."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_333> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_333> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_334> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز الإثبات بالشهود ولو لم تزد القيمة على 100.000 دينار جزائري : فيما يخالف أو يجاوز ما اشتمل عليه مضمون عقد رسمي، إذا كان المطلوب هو الباقي، أو هو جزء من حق لا يجوز إثباته إلا بالكتابة، إذا طلب أحد الخصوم في الدعوى بما تزيد قيمته على 100.000 دينار جزائري ثم عدل عن طلبه إلى ما لا يزيد على هذه القيمة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_334_19750926_OpEnact_1a50e1217b> ;
    dzdoc:replacementText "لا يجوز الإثبات بالشهود ولو لم تزد القيمة على 100.000 دينار جزائري : فيما يخالف أو يجاوز ما اشتمل عليه مضمون عقد رسمي، إذا كان المطلوب هو الباقي، أو هو جزء من حق لا يجوز إثباته إلا بالكتابة، إذا طلب أحد الخصوم في الدعوى بما تزيد قيمته على 100.000 دينار جزائري ثم عدل عن طلبه إلى ما لا يزيد على هذه القيمة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_334> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
