<https://legal.dz/resource/order/1975-09-26/75-58#version_art_480> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة عدم تنفيذ المؤجر لالتزامه بالصيانة وبعد إعذاره بموجب محرر غير قضائي ، يجوز للمستأجر المطالبة بفسخ العقد أو إنقاص بدل الإيجار، دون الإخلال بحقه في التعويض . إذا كانت الترميمات مستعجلة ، جاز للمستأجر أن يقوم بتنفيذها على حساب المعني بها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_480_19750926_OpEnact_87672078f6> ;
    dzdoc:replacementText "في حالة عدم تنفيذ المؤجر لالتزامه بالصيانة وبعد إعذاره بموجب محرر غير قضائي ، يجوز للمستأجر المطالبة بفسخ العقد أو إنقاص بدل الإيجار، دون الإخلال بحقه في التعويض . إذا كانت الترميمات مستعجلة ، جاز للمستأجر أن يقوم بتنفيذها على حساب المعني بها ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
