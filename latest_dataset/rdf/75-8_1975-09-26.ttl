<https://legal.dz/resource/order/1975-09-26/75-58#version_art_503> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المستأجر أن يرد العين المؤجرة بالحالة التي كانت عليها وقت تسلمها ، ويحرر وجاهيا محضر أو بيان وصفي بذلك. إذا تم رد العين المؤجرة دون تحرير محضر أو دون بيان وصفها ، يفترض في المؤجر أنه استردها في حالة حسنة ما لم يثبت العكس. المستأجر مسؤول عما يلحق العين المؤجرة من هلاك أو تلف ما لم يثبت أنه لا ينسب إليه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_503_19750926_OpEnact_f4a0d69260> ;
    dzdoc:replacementText "يجب على المستأجر أن يرد العين المؤجرة بالحالة التي كانت عليها وقت تسلمها ، ويحرر وجاهيا محضر أو بيان وصفي بذلك. إذا تم رد العين المؤجرة دون تحرير محضر أو دون بيان وصفها ، يفترض في المؤجر أنه استردها في حالة حسنة ما لم يثبت العكس. المستأجر مسؤول عما يلحق العين المؤجرة من هلاك أو تلف ما لم يثبت أنه لا ينسب إليه."@ar ;
