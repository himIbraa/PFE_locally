<https://legal.dz/resource/order/1975-09-26/75-58#version_art_101> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسقط الحق في إبطال العقد إذا لم يتمسك به صاحبه خلال خمس (5) سنوات . ويبدأ سريان هذه المدة، في حالة نقص الأهلية من اليوم الذي يزول فيه هذا السبب، وفي حالة الغلط أو التدليس من اليوم الذي يكشف فيه، وفي حالة الإكراه من يوم انقطاعه، غير أنه لا يجوز التمسك بحق الإبطال لغلط أو تدليس أو إكراه إذا انقضت عشرة (10) سنوات من وقت تمام العقد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_101_19750926_OpEnact_6337935ea1> ;
    dzdoc:replacementText "يسقط الحق في إبطال العقد إذا لم يتمسك به صاحبه خلال خمس (5) سنوات . ويبدأ سريان هذه المدة، في حالة نقص الأهلية من اليوم الذي يزول فيه هذا السبب، وفي حالة الغلط أو التدليس من اليوم الذي يكشف فيه، وفي حالة الإكراه من يوم انقطاعه، غير أنه لا يجوز التمسك بحق الإبطال لغلط أو تدليس أو إكراه إذا انقضت عشرة (10) سنوات من وقت تمام العقد ."@ar ;
